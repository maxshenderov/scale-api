Функция ПолучитьВалютуЦеновойГруппыПоНоменклатуре(Организация,МассивНоменклатур) Экспорт  
		
УстановитьПривилегированныйРежим(Истина);	
	МассивЦГ = Новый Массив();
	
	Для каждого Номенклатура Из  МассивНоменклатур Цикл
		
		МассивЦГ.Добавить(?(ТипЗнч(Номенклатура)=Тип("СправочникСсылка.Номенклатура"),Номенклатура.ЦеноваяГруппа,Номенклатура)); 
		 	  		
	КонецЦикла;
		  
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	Лико_СтоимостьЦеновыхГруппСрезПоследних.Валюта КАК Валюта,
	 |	Лико_СтоимостьЦеновыхГруппСрезПоследних.ЦеноваяГруппа КАК ЦеноваяГруппа
	 |ИЗ
	 |	РегистрСведений.Лико_СтоимостьЦеновыхГрупп.СрезПоследних(
	 |			,
	 |			Организация = &Организация
	 |				И ЦеноваяГруппа В (&МассивЦГ)) КАК Лико_СтоимостьЦеновыхГруппСрезПоследних";
	 Запрос.УстановитьПараметр("Организация", Организация); 
	  Запрос.УстановитьПараметр("МассивЦГ", МассивЦГ);

	 тзВалютаЦеновыхГрупп = Запрос.Выполнить().Выгрузить();
	 Соответствие = Новый Соответствие; 
	 
	 Для каждого Номенклатура Из МассивНоменклатур Цикл
		 
		 НС=тзВалютаЦеновыхГрупп.Найти(Номенклатура.ЦеноваяГруппа,"ЦеноваяГруппа");
		 
		 Если НС<>Неопределено И  Соответствие.Получить(Номенклатура)=Неопределено Тогда
			 
			 Соответствие.Вставить(Номенклатура,НС.Валюта);
			 
		 КонецЕсли;    
		 
		 
	 КонецЦикла;

	 Возврат Соответствие;
	 
