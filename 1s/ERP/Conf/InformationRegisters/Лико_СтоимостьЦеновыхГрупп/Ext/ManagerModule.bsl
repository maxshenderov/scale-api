Функция РассчитатьСреденеВзвешеннуюЦену(МассивЦен, Валюта, Дата)

	УстановитьПривилегированныйРежим(Истина);	
	Структура = Новый Структура;
	Структура.Вставить("Цена",0);
	Структура.Вставить("Валюта",Неопределено);
	Соответствие = Новый Соответствие;

	ЦенаКоличество=0;
	КоличествоВсего=0;

	Для каждого СтруктураЦены Из МассивЦен Цикл

		Если СтруктураЦены.Валюта<>Валюта Тогда

			Цена =	РаботаСКурсамиВалют.ПересчитатьВВалюту(СтруктураЦены.Цена, СтруктураЦены.Валюта,Валюта,Дата );

			Если  СтруктураЦены.Валюта.Лико_Рейтинг>=Валюта.Лико_Рейтинг Тогда
				КроссКурс=СтруктураЦены.Цена/Цена;
			Иначе
				КроссКурс=Цена/СтруктураЦены.Цена;							
			КонецЕсли; 
			КросЦена=Цена;	
		Иначе
			Цена=СтруктураЦены.Цена;
			КроссКурс=1;
			КросЦена=СтруктураЦены.Цена;
		КонецЕсли;

		Если Соответствие.Получить(СтруктураЦены.Валюта)= Неопределено Тогда
			Соответствие.Вставить(СтруктураЦены.Валюта,Новый Структура("КроссКурс,КросЦена",КроссКурс,КросЦена));
		КонецЕсли;

		ЦенаКоличество=ЦенаКоличество+(Цена*СтруктураЦены.Количество);
		КоличествоВсего=КоличествоВсего+СтруктураЦены.Количество;

	КонецЦикла;

	Если КоличествоВсего<>0 Тогда
		Структура.Цена= ЦенаКоличество/КоличествоВсего;
	КонецЕсли;

	Структура.Валюта=Соответствие;

	Возврат Структура; 
КонецФункции

