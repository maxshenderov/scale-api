 Процедура УдалитьЗаписиВРегистреЛико_ЦеныГруппНоменклатурыПоОснованию(Основание)
	 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЦеныГруппНоменклатуры.Период КАК Период,
	|	Лико_ЦеныГруппНоменклатуры.ТипЦен КАК ТипЦен,
	|	Лико_ЦеныГруппНоменклатуры.ЦеноваяГруппа КАК ЦеноваяГруппа,
	|	Лико_ЦеныГруппНоменклатуры.Площадка КАК Площадка
	|ИЗ
	|	РегистрСведений.Лико_ЦеныГруппНоменклатуры КАК Лико_ЦеныГруппНоменклатуры
	|ГДЕ
	|	Лико_ЦеныГруппНоменклатуры.Основание = &Основание";
	Запрос.УстановитьПараметр("Основание", Основание);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.Лико_ЦеныГруппНоменклатуры.СоздатьНаборЗаписей();
		НаборЗаписей.отбор.Период.Установить(Выборка.Период);
		НаборЗаписей.отбор.ТипЦен.Установить(Выборка.ТипЦен);
		НаборЗаписей.отбор.ЦеноваяГруппа.Установить(Выборка.ЦеноваяГруппа);
		НаборЗаписей.отбор.Площадка.Установить(Выборка.Площадка); 
		
		НаборЗаписей.Записать(Истина);
	КонецЦикла; 
	
	 

КонецПроцедуры 

