Процедура ДобавитьВОчередь(МассивСсылок,ИмяОперации="",Параметр="",Потоки=1)Экспорт //+Лико m.shenderov 11.02.2022
	
	Потоки=?(Потоки=0,1,Потоки);
	
	НачатьТранзакцию();
	Для каждого Ссылка Из МассивСсылок Цикл 
		
		НаборЗаписей = РегистрыСведений.Лико_ЗаписьОбъектов.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Ссылка.Установить(Ссылка);
		НаборЗаписей.Отбор.ИмяОперации.Установить(ИмяОперации);
		НаборЗаписей.Отбор.Параметр.Установить(Параметр);
		
		Запись              = НаборЗаписей.Добавить();
		
		Запись.Ссылка		= Ссылка;   
		Запись.ИмяОперации	= ИмяОперации;
		Запись.Параметр		= Параметр;
		Запись.Потоки		= Потоки;
		
		НаборЗаписей.Записать(Истина);
		
		
		
	КонецЦикла;
	ЗафиксироватьТранзакцию();
	
	
	
КонецПроцедуры //-Лико m.shenderov 11.02.2022

Процедура ВыполнитьОперацииИзОчереди() Экспорт  //+Лико m.shenderov 11.02.2022
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗаписьОбъектов.Ссылка КАК Ссылка,
	|	Лико_ЗаписьОбъектов.ИмяОперации КАК ИмяОперации,
	|	Лико_ЗаписьОбъектов.Параметр КАК Параметр,
	|	Лико_ЗаписьОбъектов.Потоки КАК Потоки,
	|	Лико_ЗаписьОбъектов.Порядок КАК Порядок,
	|	1 КАК Количество
	|ИЗ
	|	РегистрСведений.Лико_ЗаписьОбъектов КАК Лико_ЗаписьОбъектов
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок
	|ИТОГИ
	|	МАКСИМУМ(Параметр),
	|	МАКСИМУМ(Потоки),
	|	СУММА(Количество)
	|ПО
	|	ИмяОперации";
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаИмяОперации = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаИмяОперации.Следующий() Цикл
		Потоки=ВыборкаИмяОперации.Потоки;
		Количество=ВыборкаИмяОперации.Количество;
		Партия=Цел(Количество/Потоки);
		ТекущаяПартия=Партия;
		Выборка = ВыборкаИмяОперации.Выбрать();
		Сч=Выборка.Количество();
		МассивПараметров = Новый Массив();
		МассивСсылок = Новый Массив();
		Пока Выборка.Следующий() Цикл 
			ТекущаяПартия = ТекущаяПартия-1;
			Сч            = Сч-1;
			МассивСсылок.Добавить(Выборка.Ссылка);
			
			Если ТекущаяПартия=0 Или Сч=0 Тогда
				МассивПараметров.Добавить(МассивСсылок);
				МассивПараметров.Добавить(ВыборкаИмяОперации.ИмяОперации);
				МассивПараметров.Добавить(ВыборкаИмяОперации.Параметр);
				
				ИмяМетода = ПолучитьИмяМетода(ВыборкаИмяОперации.Параметр);
				ФЗ        = ФоновыеЗадания.Выполнить(ИмяМетода,МассивПараметров,,ВыборкаИмяОперации.ИмяОперации);
				
							
				Для каждого Ссылка Из МассивСсылок Цикл
					
					НаборЗаписей = РегистрыСведений.Лико_ЗаписьОбъектов.СоздатьНаборЗаписей();
					
					НаборЗаписей.Отбор.Ссылка.Установить(Ссылка);
					НаборЗаписей.Отбор.ИмяОперации.Установить(ВыборкаИмяОперации.ИмяОперации);
					НаборЗаписей.Отбор.Параметр.Установить(ВыборкаИмяОперации.Параметр);
					НаборЗаписей.Прочитать();
					
					Для каждого Запись Из НаборЗаписей Цикл
						Запись.УидФЗ= ФЗ.УникальныйИдентификатор;
					КонецЦикла;
					
					НаборЗаписей.Записать(Истина);
					
					
					
				КонецЦикла;
					МассивСсылок		=	Новый Массив;
					МассивПараметров	=	Новый Массив;
				
				
			КонецЕсли;
			
		КонецЦикла;	
	КонецЦикла; 
	
	
	
	
КонецПроцедуры //-Лико m.shenderov 11.02.2022



Процедура ПроведениеВыполнить(МассивСсылок,ИмяОперации="",Параметр="")Экспорт  //+Лико m.shenderov 11.02.2022
	
	Для каждого Ссылка Из МассивСсылок Цикл
		Попытка
			НачатьТранзакцию();
			
			Объект=Ссылка.ПолучитьОбъект();
			Объект.Записать(РежимЗаписиДокумента.Проведение); 
			НаборЗаписей = РегистрыСведений.Лико_ЗаписьОбъектов.СоздатьНаборЗаписей();
			
			НаборЗаписей.Отбор.Ссылка.Установить(Ссылка);
			НаборЗаписей.Отбор.ИмяОперации.Установить(ИмяОперации);
			НаборЗаписей.Отбор.Параметр.Установить(Параметр);
			НаборЗаписей.Записать(Истина);
			
			ЗафиксироватьТранзакцию();
			
			
		Исключение  
			НаборЗаписей = РегистрыСведений.Лико_ЗаписьОбъектов.СоздатьНаборЗаписей();
			
			НаборЗаписей.Отбор.Ссылка.Установить(Ссылка);
			НаборЗаписей.Отбор.ИмяОперации.Установить(ИмяОперации);
			НаборЗаписей.Отбор.Параметр.Установить(Параметр);
			НаборЗаписей.Прочитать();
			
			Для каждого Запись Из НаборЗаписей Цикл
				Запись.Ошибка= ОписаниеОшибки()
			КонецЦикла;
			
			НаборЗаписей.Записать(Истина);
			
			
			//ОписаниеОшибки()
		КонецПопытки;
		
	КонецЦикла;	
КонецПроцедуры //-Лико m.shenderov 11.02.2022



