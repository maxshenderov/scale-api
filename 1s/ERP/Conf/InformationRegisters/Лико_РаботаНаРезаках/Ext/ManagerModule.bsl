Процедура РегистрацияНачалаРаботыСотрудника(РабочийЦентр,Сотрудник) Экспорт  //+Лико m.shenderov 19.08.2022
	Период=ТекущаяДата();
	
	Если Сотрудник <> ТекущийСотрудникНаРЦ(РабочийЦентр) Тогда
		НаборЗаписей = РегистрыСведений.Лико_РаботаНаРезаках.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.РабочийЦентр.Установить(РабочийЦентр);
		НаборЗаписей.Отбор.Период.Установить(Период);
		Запись=НаборЗаписей.Добавить();
		Запись.Период=Период;
		Запись.РабочийЦентр=РабочийЦентр;
		Запись.Сотрудник=Сотрудник;
		НаборЗаписей.Записать(); 		
	КонецЕсли;
	
КонецПроцедуры //-Лико m.shenderov 19.08.2022


Функция ТекущийСотрудникНаРЦ(РабочийЦентр) //+Лико m.shenderov 19.08.2022
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_РаботаНаРезакахСрезПоследних.Сотрудник КАК Сотрудник
	|ИЗ
	|	РегистрСведений.Лико_РаботаНаРезаках.СрезПоследних(, РабочийЦентр = &РабочийЦентр) КАК Лико_РаботаНаРезакахСрезПоследних";
	Запрос.УстановитьПараметр("РабочийЦентр", РабочийЦентр);
	РезультатЗапроса = Запрос.Выполнить(); 
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Сотрудник;
	КонецЦикла; 
	
	
КонецФункции //-Лико m.shenderov 19.08.2022 
