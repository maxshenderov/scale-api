Процедура СерииПоПриходномуОрдеру(РегистраторОбъект,МассивСерий) 
	
	Если ТипЗнч(РегистраторОбъект)<> Тип("ДокументОбъект.ПриходныйОрдерНаТовары") 
		Или ЭтоРаспоряжениеДляЗаписиСерий(РегистраторОбъект.Распоряжение) = Ложь Тогда
		
		Возврат;
		
	КонецЕсли;	
	//РегистраторОбъект = Документы.ПриходныйОрдерНаТовары.СоздатьДокумент(); 
	МассивСерий = Новый Массив();
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЯССМ_ОбъектыНоменклатуры.Серия КАК Серия
	|ИЗ
	|	Справочник.ЯССМ_ОбъектыНоменклатуры КАК ЯССМ_ОбъектыНоменклатуры
	|ГДЕ
	|	ЯССМ_ОбъектыНоменклатуры.Серия В(&МассивСерий)
	|	И ЯССМ_ОбъектыНоменклатуры.Уникальный";
	Запрос.УстановитьПараметр("МассивСерий",РегистраторОбъект.Товары.Выгрузить().ВыгрузитьКолонку("Серия"));
	
	МассивСерий = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Серия"); 
	
	//СформироватьНаборЗаписей(РегистраторОбъект,МассивСерий);
	
КонецПроцедуры 

Процедура СерииПоЗакрытиюБланка(РегистраторОбъект,МассивСерий)
	
	Если ТипЗнч(РегистраторОбъект)<> Тип("ДокументОбъект.Лико_БланкЭтапа")   Тогда
		
		Возврат;
		
	КонецЕсли;
	
	//РегистраторОбъект = Документы.Лико_БланкЭтапа.СоздатьДокумент(); 
	Если РегистраторОбъект.ДополнительныеСвойства.Свойство("ЭтоНовый") Тогда
		
		тзТоварыНаСкладах = РегистраторОбъект.Движения.ТоварыНаСкладах.Выгрузить(); 
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыНаСкладах.Период КАК Период,
		|	ТоварыНаСкладах.Регистратор КАК Регистратор,
		|	ТоварыНаСкладах.НомерСтроки КАК НомерСтроки,
		|	ТоварыНаСкладах.Активность КАК Активность,
		|	ТоварыНаСкладах.ВидДвижения КАК ВидДвижения,
		|	ТоварыНаСкладах.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладах.Характеристика КАК Характеристика,
		|	ТоварыНаСкладах.Назначение КАК Назначение,
		|	ТоварыНаСкладах.Склад КАК Склад,
		|	ТоварыНаСкладах.Помещение КАК Помещение,
		|	ТоварыНаСкладах.Серия КАК Серия,
		|	ТоварыНаСкладах.ВНаличии КАК ВНаличии,
		|	ТоварыНаСкладах.КОтгрузке КАК КОтгрузке,
		|	ТоварыНаСкладах.КонтролироватьОстатки КАК КонтролироватьОстатки,
		|	ТоварыНаСкладах.Сторно КАК Сторно
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах КАК ТоварыНаСкладах
		|ГДЕ
		|	ТоварыНаСкладах.Регистратор = &Регистратор";
		
		Запрос.УстановитьПараметр("Регистратор",РегистраторОбъект.Ссылка );
		
		тзТоварыНаСкладах = Запрос.Выполнить().Выгрузить();		
		
	КонецЕсли;
	
	МассивСерий = Новый Массив();
	
	Для каждого Выпуск Из РегистраторОбъект.Выпуск Цикл
		
		Структура = Новый Структура;
		Структура.Вставить("Серия",Выпуск.Серия);
		
		Если тзТоварыНаСкладах.НайтиСтроки(Структура).Количество() > 0 Тогда
			
			МассивСерий.Добавить(Выпуск.Серия);
			
		КонецЕсли;
		
	КонецЦикла;
	
	//СформироватьНаборЗаписей(РегистраторОбъект,МассивСерий);
	
КонецПроцедуры 

Процедура СерииПоЛико_ВозвратТоваров(РегистраторОбъект,МассивСерий)
	
	Если  ТипЗнч(РегистраторОбъект)<> Тип("ДокументОбъект.Лико_ВозвратТоваров") Тогда
		
