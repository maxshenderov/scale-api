	КонецЕсли;
	
	//РегистраторОбъект = Документы.Лико_БланкЭтапа.СоздатьДокумент(); 
	Если РегистраторОбъект.ДополнительныеСвойства.Свойство("ЭтоНовый") Тогда
		
		тзТоварыНаСкладах = РегистраторОбъект.Движения.ТоварыНаСкладах.Выгрузить(); 
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыНаСкладах.Период КАК Период,
		|	ТоварыНаСкладах.Регистратор КАК Регистратор,
		|	ТоварыНаСкладах.НомерСтроки КАК НомерСтроки,
		|	ТоварыНаСкладах.Активность КАК Активность,
		|	ТоварыНаСкладах.ВидДвижения КАК ВидДвижения,
		|	ТоварыНаСкладах.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладах.Характеристика КАК Характеристика,
		|	ТоварыНаСкладах.Назначение КАК Назначение,
		|	ТоварыНаСкладах.Склад КАК Склад,
		|	ТоварыНаСкладах.Помещение КАК Помещение,
		|	ТоварыНаСкладах.Серия КАК Серия,
		|	ТоварыНаСкладах.ВНаличии КАК ВНаличии,
		|	ТоварыНаСкладах.КОтгрузке КАК КОтгрузке,
		|	ТоварыНаСкладах.КонтролироватьОстатки КАК КонтролироватьОстатки,
		|	ТоварыНаСкладах.Сторно КАК Сторно
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах КАК ТоварыНаСкладах
		|ГДЕ
		|	ТоварыНаСкладах.Регистратор = &Регистратор";
		
		Запрос.УстановитьПараметр("Регистратор",РегистраторОбъект.Ссылка );
		
		тзТоварыНаСкладах = Запрос.Выполнить().Выгрузить();		
		
	КонецЕсли;
	
	МассивСерий = Новый Массив();
	
	Для каждого Товар Из РегистраторОбъект.Товары Цикл
		
		Структура = Новый Структура;
		Структура.Вставить("Серия",Товар.Серия);
		
		Если тзТоварыНаСкладах.НайтиСтроки(Структура).Количество() > 0 Тогда
			
			МассивСерий.Добавить(Товар.Серия);
			
		КонецЕсли;
		
	КонецЦикла;
	
	//СформироватьНаборЗаписей(РегистраторОбъект,МассивСерий);
	
КонецПроцедуры 

Процедура СерииПоФормированиюПаллета(РегистраторОбъект,МассивСерий) 
	
	Если ТипЗнч(РегистраторОбъект)<> Тип("ДокументОбъект.Лико_ФормированиеПаллета2_0")  Тогда
		
		Возврат;
		
	КонецЕсли;	
	МассивСерий = Новый Массив();
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лико_СерииНоменклатурыДоп.Серия) КАК КоличествоСерий,
	|	Лико_ФормированиеПаллета2_0Товары.Серия КАК Серия
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	Документ.Лико_ФормированиеПаллета2_0.Товары КАК Лико_ФормированиеПаллета2_0Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_СерииНоменклатурыДоп КАК Лико_СерииНоменклатурыДоп
	|		ПО (Лико_СерииНоменклатурыДоп.Серия = Лико_ФормированиеПаллета2_0Товары.Серия)
	|			И (Лико_СерииНоменклатурыДоп.Регистратор <> &Ссылка)
	|ГДЕ
	|	Лико_ФормированиеПаллета2_0Товары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ФормированиеПаллета2_0Товары.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблица.Серия КАК Серия
	|ИЗ
	|	ВременнаяТаблица КАК ВременнаяТаблица
	|ГДЕ
	|	ВременнаяТаблица.КоличествоСерий = 0";
	Запрос.УстановитьПараметр("Ссылка",РегистраторОбъект.Ссылка);
	
	МассивСерий = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Серия"); 
	
	//СформироватьНаборЗаписей(РегистраторОбъект,МассивСерий);
	
КонецПроцедуры 



Процедура СформироватьНаборЗаписей(РегистраторОбъект,МассивСерий)
	
	Если МассивСерий.Количество()=0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	
	Организация = Организация(РегистраторОбъект);
	ВидЗапаса = ВидЗапаса(РегистраторОбъект);

	

	
	НаборЗаписей = РегистрыСведений.Лико_СерииНоменклатурыДоп.СоздатьНаборЗаписей();

	
	Для каждого Серия Из МассивСерий Цикл
		
		НаборЗаписей.Отбор.Регистратор.Установить(РегистраторОбъект.Ссылка);
		//НаборЗаписей.Отбор.Серия.Установить(Серия); 
		//НаборЗаписей.Отбор.Период.Установить(РегистраторОбъект.Дата); 
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Регистратор = РегистраторОбъект.Ссылка; 
		НоваяЗапись.Серия = Серия;
		НоваяЗапись.Период = РегистраторОбъект.Дата;
		НоваяЗапись.Организация = Организация;
		НоваяЗапись.ВидЗапаса = ВидЗапаса;
		
	КонецЦикла;
   НаборЗаписей.Записать();

КонецПроцедуры 

Функция ЭтоРаспоряжениеДляЗаписиСерий(Распоряжение) 
	
	Массив = Новый Массив(); 
	
	Массив.Добавить(Тип("ДокументСсылка.ЗаказДавальца"));
	Массив.Добавить(Тип("ДокументСсылка.ЗаказДавальца2_5"));
	Массив.Добавить(Тип("ДокументСсылка.ЗаказПереработчику"));
	Массив.Добавить(Тип("ДокументСсылка.ЗаказПереработчику2_5"));
	Массив.Добавить(Тип("ДокументСсылка.ЗаказПоставщику")); 
	Массив.Добавить(Тип("ДокументСсылка.ПриобретениеТоваровУслуг"));
	Массив.Добавить(Тип("ДокументСсылка.ПрочееОприходованиеТоваров"));
	
	Возврат Массив.Найти(ТипЗнч(Распоряжение))<>Неопределено;
	
КонецФункции  

Процедура ДополнитьЗапросРаспоряжениямиДляЗаписиСерий(Запрос) 
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "	ГДЕ
	|		ВложенныйЗапрос.Регистратор.Распоряжение ССЫЛКА Документ.ЗаказПоставщику",
	"	ГДЕ 
	|		ВложенныйЗапрос.Регистратор.Распоряжение ССЫЛКА Документ.ЗаказПоставщику
	|		ИЛИ ВложенныйЗапрос.Регистратор.Распоряжение ССЫЛКА Документ.ЗаказДавальца
	|		ИЛИ ВложенныйЗапрос.Регистратор.Распоряжение ССЫЛКА Документ.ЗаказДавальца2_5
	|		ИЛИ ВложенныйЗапрос.Регистратор.Распоряжение ССЫЛКА Документ.ЗаказПереработчику
	|		ИЛИ ВложенныйЗапрос.Регистратор.Распоряжение ССЫЛКА Документ.ЗаказПереработчику2_5
	|		ИЛИ ВложенныйЗапрос.Регистратор.Распоряжение ССЫЛКА Документ.ПриобретениеТоваровУслуг
	|		ИЛИ ВложенныйЗапрос.Регистратор.Распоряжение ССЫЛКА Документ.ПрочееОприходованиеТоваров");


КонецПроцедуры 




Функция ВидЗапаса(РегистраторОбъект)
	
	ВидЗапаса = Неопределено;
	ВидЗапасаПоПриходномуОрдеру(РегистраторОбъект, ВидЗапаса);
	ВидЗапасаПоЗакрытиюБланка(РегистраторОбъект, ВидЗапаса);
	
	
	Возврат ВидЗапаса;
	
	
КонецФункции

Процедура ВидЗапасаПоПриходномуОрдеру(РегистраторОбъект, ВидЗапаса)
	
	Если ВидЗапаса<>Неопределено 
		Или  ТипЗнч(РегистраторОбъект) <> Тип("ДокументОбъект.ПриходныйОрдерНаТовары") Тогда 
		
		Возврат;
		
	КонецЕсли;
	
	Распоряжение = РегистраторОбъект.Распоряжение;
	
	Массив = Новый Массив(); 
	
	Массив.Добавить(Тип("ДокументСсылка.ЗаказДавальца"));
	Массив.Добавить(Тип("ДокументСсылка.ЗаказДавальца2_5"));
	
	Если Массив.Найти(ТипЗнч(Распоряжение))=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыЗапасов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыЗапасов КАК ВидыЗапасов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказДавальца КАК ЗаказДавальца
	|		ПО ВидыЗапасов.Договор = ЗаказДавальца.Договор
	|			И ВидыЗапасов.Организация = ЗаказДавальца.Организация
	|			И ВидыЗапасов.ВладелецТовара = ЗаказДавальца.Партнер
	|ГДЕ
	|	ВидыЗапасов.ТипЗапасов = &ТипЗапасов
	|	И ЗаказДавальца.Ссылка = &Распоряжение";
	Запрос.УстановитьПараметр("ТипЗапасов", Перечисления.ТипыЗапасов.МатериалДавальца); 
	Запрос.УстановитьПараметр("Распоряжение", РегистраторОбъект.Распоряжение);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ВидЗапаса = Выборка.Ссылка;
	КонецЦикла;
	
КонецПроцедуры  

Процедура ВидЗапасаПоЗакрытиюБланка(РегистраторОбъект, ВидЗапаса)
	
	Если ВидЗапаса<>Неопределено 
		Или  ТипЗнч(РегистраторОбъект) <> Тип("ДокументОбъект.Лико_БланкЭтапа") Тогда 
		
		Возврат;
		
	КонецЕсли;
	
	ВидЗапасаПоЭтапуПроизводства(РегистраторОбъект.Распоряжение, ВидЗапаса);
	
	
КонецПроцедуры  

Процедура ВидЗапасаПоЭтапуПроизводства(Этап, ВидЗапаса)
	
	Если ВидЗапаса<>Неопределено 
		Или  ТипЗнч(Этап) <> Тип("ДокументСсылка.ЭтапПроизводства2_2") Тогда 
		
		Возврат;
		
	КонецЕсли;
	
			
				
			
		РеквизитыВидаЗапасов= Новый Структура;
		РеквизитыВидаЗапасов.Вставить("Договор",Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
		РеквизитыВидаЗапасов.Вставить("ВладелецТовара",Справочники.Патенты.ПустаяСсылка());
		РеквизитыВидаЗапасов.Вставить("Контрагент",Справочники.Контрагенты.ПустаяСсылка());
		РеквизитыВидаЗапасов.Вставить("Организация",Справочники.Организации.ПустаяСсылка());
		РеквизитыВидаЗапасов.Вставить("ХозяйственнаяОперация",Перечисления.ХозяйственныеОперации.ПустаяСсылка());
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭтапПроизводства2_2.Партнер КАК ВладелецТовара,
		|	ЭтапПроизводства2_2.Договор КАК Договор,
		|	ЭтапПроизводства2_2.Договор.Контрагент КАК Контрагент,
		|	ЭтапПроизводства2_2.Организация КАК Организация,
		|	ЭтапПроизводства2_2.ХозяйственнаяОперация КАК ХозяйственнаяОперация
		|ИЗ
		|	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
		|ГДЕ
		|	ЭтапПроизводства2_2.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка",Этап );
		РезультатЗапроса = Запрос.Выполнить(); 
		
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(РеквизитыВидаЗапасов,Выборка);
		
		КонецЦикла;
		
		ВидЗапаса = Справочники.ВидыЗапасов.ВидЗапасовДокумента(РеквизитыВидаЗапасов.Организация,
		РеквизитыВидаЗапасов.ХозяйственнаяОперация,
		РеквизитыВидаЗапасов);		
		
	
	
	
КонецПроцедуры  



Функция Организация(РегистраторОбъект) 
	
	Организация = Неопределено;
	
	ОрганизацияПоПриходномуОрдеру(РегистраторОбъект, Организация);
	ОрганизацияПоЗакрытиюБланка(РегистраторОбъект, Организация); 
	ОрганизацияПоЛико_ВозвратТоваров(РегистраторОбъект, Организация); 
	ОрганизацияПоФормированиюПаллета(РегистраторОбъект, Организация);

	
	Возврат Организация;
	
КонецФункции 

Процедура ОрганизацияПоПриходномуОрдеру(РегистраторОбъект, Организация) 
	
		
	Если Организация <> Неопределено 
		Или ТипЗнч(РегистраторОбъект) <> Тип("ДокументОбъект.ПриходныйОрдерНаТовары") Тогда 
		
		Возврат;
		
	КонецЕсли; 
	
Распоряжение = РегистраторОбъект.Распоряжение;
Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Распоряжение,"Организация");

КонецПроцедуры 

Процедура ОрганизацияПоЛико_ВозвратТоваров(РегистраторОбъект, Организация) 
	
		
	Если Организация <> Неопределено 
		Или ТипЗнч(РегистраторОбъект) <> Тип("ДокументОбъект.Лико_ВозвратТоваров") Тогда 
		
		Возврат;
		
	КонецЕсли; 
	

Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РегистраторОбъект.Ссылка,"Организация");

КонецПроцедуры 


Процедура ОрганизацияПоЗакрытиюБланка(РегистраторОбъект, Организация) 
	
		
	Если Организация <> Неопределено 
		Или ТипЗнч(РегистраторОбъект) <> Тип("ДокументОбъект.Лико_БланкЭтапа") Тогда 
		
		Возврат;
		
	КонецЕсли; 
	

	Если ЗначениеЗаполнено(РегистраторОбъект.ЗаказНаРаскрой) Тогда
		
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РегистраторОбъект.ЗаказНаРаскрой,"Организация");
		
	ИначеЕсли ЗначениеЗаполнено(РегистраторОбъект.Распоряжение) Тогда
		
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РегистраторОбъект.Распоряжение,"Организация");

	Иначе
		
		Организация = РегистраторОбъект.Организация;
		
	КонецЕсли;

КонецПроцедуры 


Процедура ОрганизацияПоФормированиюПаллета(РегистраторОбъект, Организация) 
	
		
	Если Организация <> Неопределено 
		Или ТипЗнч(РегистраторОбъект) <> Тип("ДокументОбъект.Лико_ФормированиеПаллета2_0") Тогда 
		
		Возврат;
		
	КонецЕсли; 
	

Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РегистраторОбъект.АдресХранения,"Лико_Организация");

КонецПроцедуры 


#КонецОбласти

#КонецЕсли