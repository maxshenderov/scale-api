#Область ПрограммныйИнтерфейс

Процедура Записать(Регистратор) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	РегистраторОбъект = ?(ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Регистратор)),Регистратор.ПолучитьОбъект(),Регистратор);
	
	МассивСерий = Новый Массив();
	
	СерииПоПриходномуОрдеру(РегистраторОбъект,МассивСерий); 
	СерииПоЗакрытиюБланка(РегистраторОбъект,МассивСерий);
	СерииПоЛико_ВозвратТоваров(РегистраторОбъект,МассивСерий);
	СерииПоФормированиюПаллета(РегистраторОбъект,МассивСерий); 
	
	СформироватьНаборЗаписей(РегистраторОбъект,МассивСерий);

	
КонецПроцедуры 

Функция РегистраторПоСерии(Серия, Период=Неопределено) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Период = ?(Период = Неопределено, ТекущаяДата(), Период);
	
	Результат = Неопределено;		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(ТоварыНаСкладах.Период) КАК Период,
	|	ТоварыНаСкладах.Серия КАК Серия,
	|	ТоварыНаСкладах.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ВтРегистратор
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах КАК ТоварыНаСкладах
	|ГДЕ
	|	ТоварыНаСкладах.Серия = &Серия
	|	И ТоварыНаСкладах.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ТоварыНаСкладах.Период <= &Период
	|	И (ТоварыНаСкладах.Регистратор ССЫЛКА Документ.ПриходныйОрдерНаТовары
	|			ИЛИ ТоварыНаСкладах.Регистратор ССЫЛКА Документ.Лико_БланкЭтапа
	|			ИЛИ ТоварыНаСкладах.Регистратор ССЫЛКА Документ.Лико_ВозвратТоваров)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладах.Серия,
	|	ТоварыНаСкладах.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВложенныйЗапрос.Период) КАК Период,
	|	ВложенныйЗапрос.Серия КАК Серия
	|ПОМЕСТИТЬ ВтМаксПериодСерии
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВложенныйЗапрос.Период КАК Период,
	|		ВложенныйЗапрос.Серия КАК Серия
	|	ИЗ
	|		(ВЫБРАТЬ
	|			ВтРегистратор.Период КАК Период,
	|			ВтРегистратор.Серия КАК Серия,
	|			ВЫРАЗИТЬ(ВтРегистратор.Регистратор КАК Документ.ПриходныйОрдерНаТовары) КАК Регистратор
	|		ИЗ
	|			ВтРегистратор КАК ВтРегистратор
	|		ГДЕ
	|			ВтРегистратор.Регистратор ССЫЛКА Документ.ПриходныйОрдерНаТовары) КАК ВложенныйЗапрос
	|	ГДЕ
	|		ВложенныйЗапрос.Регистратор.Распоряжение ССЫЛКА Документ.ЗаказПоставщику
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВтРегистратор.Период,
	|		ВтРегистратор.Серия
	|	ИЗ
	|		ВтРегистратор КАК ВтРегистратор
	|	ГДЕ
	|		(ВтРегистратор.Регистратор ССЫЛКА Документ.Лико_БланкЭтапа
	|				ИЛИ ВтРегистратор.Регистратор ССЫЛКА Документ.Лико_ВозвратТоваров)) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ТоварыНаСкладах.Регистратор) КАК Регистратор
	|ИЗ
	|	ВтМаксПериодСерии КАК ВтМаксПериодСерии
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах КАК ТоварыНаСкладах
	|		ПО ВтМаксПериодСерии.Серия = ТоварыНаСкладах.Серия
	|			И ВтМаксПериодСерии.Период = ТоварыНаСкладах.Период";
	
	
	 ДополнитьЗапросРаспоряжениямиДляЗаписиСерий(Запрос);	
	
	Запрос.УстановитьПараметр("Серия",Серия );
	Запрос.УстановитьПараметр("Период",Период );

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл 
		
		Результат = выборка.Регистратор;
	
	КонецЦикла; 
	
   Возврат Результат;
КонецФункции

Функция ОрганизацияВладельцаТовара(Серия, Период = Неопределено) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Неопределено;
	Период = ?(Период = Неопределено, ТекущаяДата(), Период);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Лико_СерииНоменклатурыДопСрезПоследних.ВидЗапаса.ТипЗапасов В (&МассивТиповзапаса)
	|			ТОГДА Лико_СерииНоменклатурыДопСрезПоследних.ВидЗапаса.ВладелецТовара
	|		ИНАЧЕ Лико_СерииНоменклатурыДопСрезПоследних.Организация
	|	КОНЕЦ КАК ВладелецТовара
	|ИЗ
	|	РегистрСведений.Лико_СерииНоменклатурыДоп.СрезПоследних(&Период, Серия = &Серия) КАК Лико_СерииНоменклатурыДопСрезПоследних";
	Запрос.УстановитьПараметр("Серия",Серия ); 
	Запрос.УстановитьПараметр("Период",Период );
	
	МассивТиповзапаса= Новый Массив;
	МассивТиповзапаса.Добавить(Перечисления.ТипыЗапасов.МатериалДавальца);
	МассивТиповзапаса.Добавить(Перечисления.ТипыЗапасов.ПродукцияДавальца);
	
	Запрос.УстановитьПараметр("МассивТиповзапаса",МассивТиповзапаса );
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.ВладелецТовара;
	КонецЦикла; 

	Если ТипЗнч(Результат) = Тип("СправочникСсылка.Партнеры") Тогда
		
		Результат = УправлениеСвойствами.ЗначениеСвойства(Результат,"Лико_СобственнаяОрганизация");
		
	КонецЕсли;
	
	
	Возврат Результат;
	
КонецФункции  



