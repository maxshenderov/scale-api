&НаКлиенте
Процедура ИзменитьЦветоделителя(Команда)
	
	Если Команда.Имя = "ИзменитьЦветоделителя" Тогда
		
		Если Элементы.СписокВерсия2.ВыделенныеСтроки.Количество() > 0 Тогда
			
			ПараметрыЗаказа = Новый Структура("ВыделенныеСтроки,ИмяКоманды", Элементы.СписокВерсия2.ВыделенныеСтроки,Команда.Имя);

			ПараметрыФормыВыбора = Новый Структура;    
			ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
			ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Истина); 
			// <-- Начало Лико Яцун С. В. 17.02.2023
			ПараметрыФормыВыбора.Вставить("ТекущаяСтрока", Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Справочники.Лико_ПредопределенныеЗначения.ГруппаПользователейОДП.ЗначениеПараметра"));
			//ПараметрыФормыВыбора.Вставить("СкрываемыеПользователи", ОтборПользователейПоРолям("Лико_ПланОДП"));
			// <-- Конец Лико Яцун С. В. 17.02.2023
			ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыФормыВыбора,,,,, Новый ОписаниеОповещения("ВыбранЦветоделитель", ЭтотОбъект, ПараметрыЗаказа));
			
		КонецЕсли;
	// <-- Начало Лико Яцун С. В. 17.02.2023	
	ИначеЕсли Команда.Имя = "ИзменитьЦветоделителяЦДП" Тогда
		
		Если Элементы.СписокВерсия3.ВыделенныеСтроки.Количество() > 0 Тогда
			
			ПараметрыЗаказа = Новый Структура("ВыделенныеСтроки,ИмяКоманды", Элементы.СписокВерсия3.ВыделенныеСтроки,Команда.Имя);
			
			ПараметрыФормыВыбора = Новый Структура;    
			ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
			ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе", Истина); 
			ПараметрыФормыВыбора.Вставить("СкрываемыеПользователи", ОтборПользователейПоРолям("Лико_ПланЦДП"));
			
			
			ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыФормыВыбора,,,,, Новый ОписаниеОповещения("ВыбранЦветоделитель", ЭтотОбъект, ПараметрыЗаказа));
			
		КонецЕсли;
		
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 17.02.2023
КонецПроцедуры

&НаСервере
Функция ОтборПользователейПоРолям(ИмяРоли) // <-- Начало Лико Яцун С. В. 17.02.2023
	
	УстановитьПривилегированныйРежим(Истина);
	
	СкрываемыеПользователи = Новый СписокЗначений;
	ПлощадкиТекПользователя = Новый СписокЗначений();
	Для Каждого Пл Из ПользователиКлиентСервер.ТекущийПользователь().Лико_Площадки Цикл
		ПлощадкиТекПользователя.Добавить(Пл.Площадка);		
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПрофилиГруппДоступаРоли.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Профили
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
	|ГДЕ
	|	ВЫРАЗИТЬ(ПрофилиГруппДоступаРоли.Роль КАК Справочник.ИдентификаторыОбъектовМетаданных).Имя = &Роль
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрофилиГруппДоступаРоли.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГруппыДоступа.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Группы
	|ИЗ
	|	Справочник.ГруппыДоступа КАК ГруппыДоступа
	|ГДЕ
	|	ГруппыДоступа.Профиль В
	|			(ВЫБРАТЬ
	|				ВТ_Профили.Ссылка
	|			ИЗ
	|				ВТ_Профили)
	|
	|СГРУППИРОВАТЬ ПО
	|	ГруппыДоступа.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ГруппыДоступаПользователи.Пользователь КАК Справочник.Пользователи) КАК Пользователь
	|ПОМЕСТИТЬ ВТ_НужныеПользователи
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	|ГДЕ
	|	ГруппыДоступаПользователи.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_Группы.Ссылка
	|			ИЗ
	|				ВТ_Группы)
	|	И ВЫРАЗИТЬ(ГруппыДоступаПользователи.Пользователь КАК Справочник.Пользователи).Лико_Площадки.Площадка В (&ПлощадкиТекущегоПользователя)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(ГруппыДоступаПользователи.Пользователь КАК Справочник.Пользователи)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Пользователь
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	НЕ Пользователи.Ссылка В
	|				(ВЫБРАТЬ
	|					ВТ_НужныеПользователи.Пользователь КАК Пользователь
	|				ИЗ
	|					ВТ_НужныеПользователи КАК ВТ_НужныеПользователи)";
	
	Запрос.УстановитьПараметр("Роль",ИмяРоли);
	Запрос.УстановитьПараметр("ПлощадкиТекущегоПользователя",ПлощадкиТекПользователя);

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СкрываемыеПользователи.Добавить(ВыборкаДетальныеЗаписи.Пользователь);
	КонецЦикла;
	
	Возврат СкрываемыеПользователи;
	
КонецФункции // <-- Конец Лико Яцун С. В. 17.02.2023

&НаКлиенте
Процедура ВыбранЦветоделитель(Результат, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ДопПараметры.Вставить("НовыйЦветоделитель", Результат);
		ИзменитьЦветоделителяНаСервере(ДопПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьЦветоделителяНаСервере(ПараметрыЗаказа)
	
	Для каждого КлючЗаписи из ПараметрыЗаказа.ВыделенныеСтроки Цикл
		ЗаказКлиента = КлючЗаписи.Заказ;
		СтрокаЦветоделения = ЗаказКлиента.Цветоделение.Найти(КлючЗаписи.Идентификатор, "КлючСтроки");
		Если СтрокаЦветоделения = Неопределено Тогда
			Сообщить("Не найдена строка цветоделения в заказе по указанному ключу строки (" + ЗаказКлиента + " " + КлючЗаписи.Идентификатор + ")");
		Иначе
			ТекущийЦветоделитель = СтрокаЦветоделения.ЦветоделительПлан;
			Если ТекущийЦветоделитель = ПараметрыЗаказа.НовыйЦветоделитель Тогда
				Сообщить("Для заказа " + ЗаказКлиента.НомерБезПрефикса + " вы выбрали того же самого цветоделителя");
			Иначе
				ЗаказОбъект = ЗаказКлиента.ПолучитьОбъект();
				СтрокаЦветоделения = ЗаказОбъект.Цветоделение[СтрокаЦветоделения.НомерСтроки-1];
				СтрокаЦветоделения.ЦветоделительПлан = ПараметрыЗаказа.НовыйЦветоделитель;
				Попытка
					ЗаказОбъект.Записать(?(ЗаказОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
					Сообщить("Для заказа " + ЗаказОбъект.НомерБезПрефикса + ?(ЗначениеЗаполнено(СтрокаЦветоделения.Переделка), " (переделка №" + СтрокаЦветоделения.Переделка + ")", "") + ?(ЗначениеЗаполнено(ТекущийЦветоделитель), " цветоделитель успешно изменен с """ + ТекущийЦветоделитель + """ на """, " цветоделителем успешно установлен """) + ПараметрыЗаказа.НовыйЦветоделитель + """");
					Если ПараметрыЗаказа.ИмяКоманды = "ИзменитьЦветоделителя" Тогда
						Элементы.СписокВерсия2.Обновить();
					ИначеЕсли ПараметрыЗаказа.ИмяКоманды = "ИзменитьЦветоделителяЦДП" Тогда
						Элементы.СписокВерсия3.Обновить();
					КонецЕсли;	
				Исключение
					Сообщить("Не удалось изменить цветоделителя: " + ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НаправитьНаПроизводствоНаСервере(Заказ,ИмяКоманды)
	
	Лико_Планирование.ПеренестиЗаказ(Заказ, Справочники.Лико_ЭтапыВыполненияЗаказа.Производство);
	Если ИмяКоманды = "НаправитьНаПроизводство" Тогда 
		Элементы.СписокВерсия2.Обновить();
	ИначеЕсли ИмяКоманды = "НаправитьНаПроизводствоЦДП" Тогда
		Элементы.СписокВерсия3.Обновить();
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура НаправитьНаПроизводство(Команда)
	
	Если Команда.Имя = "НаправитьНаПроизводство" Тогда
		текстр = Элементы.СписокВерсия2.ТекущиеДанные;
		Если текстр <> Неопределено Тогда 
			НаправитьНаПроизводствоНаСервере(текстр.Заказ,Команда.Имя);
		КонецЕсли;
	// <-- Начало Лико Яцун С. В. 
	ИначеЕсли Команда.Имя = "НаправитьНаПроизводствоЦДП" Тогда
		текстр = Элементы.СписокВерсия3.ТекущиеДанные;
		Если текстр <> Неопределено Тогда 
			НаправитьНаПроизводствоНаСервере(текстр.Заказ,Команда.Имя);
		КонецЕсли;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В.
	
КонецПроцедуры
