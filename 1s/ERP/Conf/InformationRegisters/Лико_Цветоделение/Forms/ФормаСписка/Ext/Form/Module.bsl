&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Заказ") Тогда
		Заказ = Параметры.Заказ;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Заказ", Заказ, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(Заказ));	
	КонецЕсли;
	
	Если НЕ РольДоступна("ПолныеПрава") 
		И ПользователиКлиентСервер.ТекущийПользователь().Лико_Площадки.НайтиСтроки(Новый Структура ("Площадка",Справочники.Лико_Площадки.Ликофлекс)).Количество() = 0 Тогда
		Если НЕ РольДоступна("Лико_ПланОДП") Тогда
			Элементы.СтраницаСписокВерсия2.Видимость = Ложь;
		КонецЕсли;
		Если НЕ РольДоступна("Лико_ПланЦДП") Тогда
			Элементы.СтраницаСписокВерсия3.Видимость = Ложь;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;	
	текстр = Элемент.ТекущиеДанные;
	Если текстр<> Неопределено Тогда 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ",текстр.Заказ);
		ПараметрыФормы.Вставить("Идентификатор",текстр.НомерЗаявки);	
		ОткрытьФорму("Документ.ЗаказКлиента.Форма.Лико_ФормаЗаявкиНаЦветоделение", ПараметрыФормы);
	КонецЕсли;	

КонецПроцедуры

