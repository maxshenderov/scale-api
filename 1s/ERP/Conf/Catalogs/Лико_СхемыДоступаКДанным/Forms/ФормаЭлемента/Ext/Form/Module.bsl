&НаКлиенте
Процедура ИмяИсточникаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Структура = Новый Структура;
	Структура.Вставить("Источник",Объект.Источник);
	СтандартнаяОбработка=Ложь;
	ОписаниеОповещения= Новый ОписаниеОповещения("ВыборОбъектаЗавершение",ЭтаФорма,Структура);
	ОткрытьФорму("Справочник.Лико_СхемыДоступаКДанным.Форма.ФормаВыбораОбъекта",Структура,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	
КонецПроцедуры

Процедура ВыборОбъектаЗавершение (Результат,Параметры) Экспорт
	
	Если ТипЗнч(Результат)=Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Объект,Результат);
	КонецЕсли;
	
	
КонецПроцедуры 


&НаКлиенте
Процедура ОткрытьФайл(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Файлы XML (*.xml) |*.xml";
	Если НЕ Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	
	Попытка
		ЧтениеXML.ОткрытьФайл(Диалог.ПолноеИмяФайла);
	Исключение
		Сообщить("Невозможно открыть xml-файл");
		Возврат;
	КонецПопытки;
	
	
	АдресВременногоХранилища = "";
	ПоместитьФайл(АдресВременногоХранилища, Диалог.ПолноеИмяФайла,,Ложь, ЭтаФорма.УникальныйИдентификатор); // помещаем наш файл во временное хранилище (для его передачи на сервер)
	
	ВыгрузитьВXMLНаСервере(АдресВременногоХранилища);
	
	СформироватьНадписьЗагрузкиСхемы();
	
	
КонецПроцедуры



&НаСервере
Функция  ВыгрузитьВXMLНаСервере(АдресВременногоХранилища)
	
	ДД = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);  // вытаскиваем на сервере из временного хранилища как двоичные данные
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".xml"); // получаем имя временного файла на сервере
	ДД.Записать(ИмяВременногоФайла);                        // записываем двоичные данные  
	//перенос файла с клиента на сервер завершен, на сервере создался файл с путем в переменной - "ИмяВременногоФайла"
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
	//ЧтениеXML.УстановитьСтроку(НайтиСтрокуЗапроса.СхемаКомпоновкиДанныхТаблицы); - если чтение не из файла, а из строки
	ТекОбъект = РеквизитФормыВЗначение("Объект"); 
	//ТекОбъект.схемаДанных=Новый ХранилищеЗначения(ЧтениеXML);
	СКД = СериализаторXDTO.ПрочитатьXML(ЧтениеXML, Тип("СхемаКомпоновкиДанных")); 
	ТекОбъект.схемаДанных=Новый ХранилищеЗначения(СКД);
	
	ИнициализироватьКомпоновкуДанных(СКД);
	Объект.ДатаЗагрузки=ТекущаяДата();
	Объект.Загрузил= ПользователиКлиентСервер.ТекущийПользователь(); 
  
	
КонецФункции

