	Сообщение.Сообщить();
#КонецЕсли	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ИсточникВыбора) = Тип("КонструкторСхемыКомпоновкиДанных") Тогда
		СКД = ИсточникВыбора.ПолучитьСхему(); 		
		ИнициализироватьКомпоновкуДанных(СКД);
		СформироватьНадписьЗагрузкиСхемы();
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНадписьЗагрузкиСхемы() //+Лико m.shenderov 17.03.2019

	Если ЗначениеЗаполнено(Объект.Загрузил) Тогда
		НадписьЗагрузкиСхемы="Загрузил: "+Объект.Загрузил+" дата: "+Формат(Объект.ДатаЗагрузки,"ДЛФ=DT");
	Иначе
		НадписьЗагрузкиСхемы="Схема не загружена";
		
	КонецЕсли;
	
	
КонецПроцедуры  //-Лико m.shenderov 17.03.2019

