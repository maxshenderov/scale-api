

Функция ОпределитьНормативРезки(Номенклатура,КоличествоНожей,Метры,Правило=Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	НормативРезки=0;
	Если Правило=Неопределено Тогда
		Правило=ОпределитьПравило(Номенклатура); 
	КонецЕсли;
	Если ЗначениеЗаполнено(Правило) ТОгда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лико_ПараметрыРасчетаРаскрояМатериаловТаблицаПараметров.НормативРезки КАК НормативРезки
		|ИЗ
		|	Справочник.Лико_ПараметрыРасчетаРаскрояМатериалов.ТаблицаПараметров КАК Лико_ПараметрыРасчетаРаскрояМатериаловТаблицаПараметров
		|ГДЕ
		|	Лико_ПараметрыРасчетаРаскрояМатериаловТаблицаПараметров.Ссылка = &Правило
		|	И Лико_ПараметрыРасчетаРаскрояМатериаловТаблицаПараметров.КоличествоНожей = &КоличествоНожей
		|	И Лико_ПараметрыРасчетаРаскрояМатериаловТаблицаПараметров.Метры <= &Метры
		|
		|УПОРЯДОЧИТЬ ПО
		|	Лико_ПараметрыРасчетаРаскрояМатериаловТаблицаПараметров.Метры УБЫВ";
		Запрос.УстановитьПараметр("Правило",Правило );
		Запрос.УстановитьПараметр("КоличествоНожей",КоличествоНожей );
		Запрос.УстановитьПараметр("Метры",Метры );
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
		     НормативРезки=Выборка.НормативРезки;                  
		КонецЦикла;                                               
		КонецЕсли;	
	Возврат НормативРезки;
КонецФункции



Функция ОпределитьПравило(Номенклатура,ДокументРасхода=Неопределено,ЗаказНаРаскрой=Неопределено) Экспорт 
	Если ТипЗнч(Номенклатура)=Тип("СправочникСсылка.ЦеновыеГруппы") Тогда
		Ном=Номенклатура.ОсновнаяНоменклатура;
	Иначе
		Ном=Номенклатура;
	КонецЕсли;
	
	Если ДокументРасхода=Неопределено Тогда
		ДокументРасхода=Документы.Лико_БланкЭтапа.ПустаяСсылка();
	КонецЕсли;
	Если ЗаказНаРаскрой=Неопределено Тогда
		ЗаказНаРаскрой=Документы.Лико_ЗаказНаРаскрой.ПустаяСсылка();
	КонецЕсли;



	Запрос = Новый Запрос;
	Запрос.Текст=ТекстЗапросаПравилПоВидуНоменклатуры(); 
	Запрос.УстановитьПараметр("ВидНоменклатуры",Ном.ВидНоменклатуры );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл 		
		ИспользоватьЭтоПравило=Истина;	
		Если Выборка.СложнаяНастройка Тогда 
			ИспользоватьЭтоПравило= ИспользоватьПравилоСКД(Выборка,Ном,ДокументРасхода,ЗаказНаРаскрой);		

		Иначе
			Для каждого ДопРеквизит Из Выборка.Ссылка.ДополнительныеРеквизиты Цикл			
				Если ЗначениеЗаполнено(ДопРеквизит.Значение) ТОгда
					Структура = Новый Структура;
					Структура.Вставить("Свойство",ДопРеквизит.Свойство);
					Структура.Вставить("Значение",ДопРеквизит.Значение);
					НайденоСвойство=Ном.ДополнительныеРеквизиты.НайтиСтроки(Структура).Количество()>0;
					ЕСли  НайденоСвойство и ДопРеквизит.Исключить ТОгда
						ИспользоватьЭтоПравило=Ложь;
						Прервать;
					ИначеЕсли НЕ НайденоСвойство и НЕ  ДопРеквизит.Исключить ТОгда
						ИспользоватьЭтоПравило=Ложь; 
						Прервать;				
					КонецЕсли;				
				КонецЕсли;
			КонецЦикла; 
		КонецЕсли;

		Если ИспользоватьЭтоПравило Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;			

	КонецЦикла;


КонецФункции


Функция ТекстЗапросаПравилПоВидуНоменклатуры()
	
	Возврат 
	"ВЫБРАТЬ
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.Ссылка КАК Ссылка,
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.ВерсияДанных КАК ВерсияДанных,
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.ПометкаУдаления КАК ПометкаУдаления,
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.Код КАК Код,
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.Наименование КАК Наименование,
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.Выключить КАК Выключить,
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.Организация КАК Организация,
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.ВидНоменклатуры КАК ВидНоменклатуры,
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.Описание КАК Описание,
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.Предопределенный КАК Предопределенный,
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.СложнаяНастройка КАК СложнаяНастройка,
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.ОтборНастройки КАК ОтборНастройки,
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.Приоритет КАК Приоритет
		|ИЗ
	|	Справочник.Лико_ПараметрыРасчетаРаскрояМатериалов КАК Лико_ПараметрыРасчетаРаскрояМатериалов
	|ГДЕ
	//|	Лико_ПараметрыРасчетаРаскрояМатериалов.ВидНоменклатуры = &ВидНоменклатуры
	|	 НЕ Лико_ПараметрыРасчетаРаскрояМатериалов.ПометкаУдаления
	|	И НЕ Лико_ПараметрыРасчетаРаскрояМатериалов.Выключить
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	
КонецФункции

Процедура УстановитьЗначениеПараметраНастроек(Настройки, ИмяПараметра, Значение)
	
	Параметр = Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = Значение;
		Параметр.Использование = Истина;
	КонецЕсли;
	
КонецПроцедуры


Функция ИспользоватьПравилоСКД(Выборка,Номенклатура,ДокументРасхода,ЗаказНаРаскрой) //+Лико m.shenderov 30.12.2018
	ОтборНастройки= Новый КомпоновщикНастроекКомпоновкиДанных;
    СхемаКомпоновкиДанных = Справочники.Лико_ПараметрыРасчетаРаскрояМатериалов.ПолучитьМакет("ОтборПоУсловию");
	//URLСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, Новый УникальныйИдентификатор());
   ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных);
   ОтборНастройки.Инициализировать(ИсточникНастроек);
   	ТекНастройки = Выборка.ОтборНастройки.Получить();
	
	Если ТекНастройки = Неопределено Тогда
		ОтборНастройки.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Иначе
		ОтборНастройки.ЗагрузитьНастройки(ТекНастройки);
	КонецЕсли;
	//ОтборНастройки.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	УстановитьЗначениеПараметраНастроек(ОтборНастройки.Настройки, "Номенклатура" , Номенклатура);
	УстановитьЗначениеПараметраНастроек(ОтборНастройки.Настройки, "ДокументРасхода" , ДокументРасхода); 
	УстановитьЗначениеПараметраНастроек(ОтборНастройки.Настройки, "ЗаказНаРаскрой" , ЗаказНаРаскрой);


	                                                                  

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ОтборНастройки.ПолучитьНастройки(),,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;

	Если 	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных).Количество()>0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли; 	
КонецФункции //-Лико m.shenderov 30.12.2018 













Функция ПолучитьПриоритетМакс(ВидНоменклатуры) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(Лико_ПараметрыРасчетаРаскрояМатериалов.Приоритет) КАК Приоритет
	|ИЗ
	|	Справочник.Лико_ПараметрыРасчетаРаскрояМатериалов КАК Лико_ПараметрыРасчетаРаскрояМатериалов
	|ГДЕ
	|	Лико_ПараметрыРасчетаРаскрояМатериалов.ВидНоменклатуры = &ВидНоменклатуры";
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
	Если ЗначениеЗаполнено(Выборка.Приоритет) Тогда
		Возврат Выборка.Приоритет;
	КонецЕсли;
	
	КонецЦикла; 
	
	Возврат 0;	
КонецФункции //-Лико m.shenderov 28.12.2018 

Процедура ПереместитьПоПриоритету(Ссылка,Шаг) Экспорт 
	
	
	ТекущийПриоритет	=	Ссылка.Приоритет;
	НовыйПриоритет		=	ТекущийПриоритет+Шаг;
	
	Если НовыйПриоритет=0 Или НовыйПриоритет=ПолучитьПриоритетМакс(Ссылка.ВидНоменклатуры)+1 Тогда
		Возврат;
	КонецЕсли;
	
	ПравилоКонкурент=ПолучитьПравилоПоПриоритету(Ссылка.ВидНоменклатуры,НовыйПриоритет);
	
	НачатьТранзакцию();
	
	СправочникОбъект			=Ссылка.ПолучитьОбъект();
	СправочникОбъект.Приоритет	=НовыйПриоритет; 	
	СправочникОбъект.Записать();
	Если ЗначениеЗаполнено(ПравилоКонкурент) Тогда
		
		СправочникОбъект			 =ПравилоКонкурент.ПолучитьОбъект();
		СправочникОбъект.Приоритет	 =СправочникОбъект.Приоритет-Шаг; 	
		СправочникОбъект.Записать();
	КонецЕсли;
	
	
	
	
	ЗафиксироватьТранзакцию();
	
	
	
КонецПроцедуры //-Лико m.shenderov 28.12.2018

Функция ПолучитьПравилоПоПриоритету(ВидНоменклатуры,Приоритет) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка ИЗ Справочник.Лико_ПараметрыРасчетаРаскрояМатериалов КАК Док
	|ГДЕ Док.ВидНоменклатуры = &ВидНоменклатуры И Док.Приоритет = &Приоритет";
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры);
	Запрос.УстановитьПараметр("Приоритет",Приоритет);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Возврат Выборка.Ссылка;	
		
	КонецЦикла; 
	
	
КонецФункции //-Лико m.shenderov 29.12.2018 
