
Процедура ПередЗаписью(Отказ)
	
	РЦСвернуты = РабочиеЦентры.Выгрузить(, "РабочийЦентр");
	РЦСвернуты.Свернуть("РабочийЦентр");
	Если РЦСвернуты.Количество() <> РабочиеЦентры.Количество() Тогда
		Сообщить("В таблица рабочих центров есть дубли. Запись невозможна");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Доступ.Количество() = 0 Тогда
		НоваяСтрока = Доступ.Добавить();
	КонецЕсли;
	
КонецПроцедуры
