Процедура ДобавлениеИзменениеТопологииСклада(Стеллаж) Экспорт
	
	
	
	
	//Стеллаж=Справочники.Лико_Стеллажи.СоздатьЭлемент();
	
	Структура = Новый Структура;
	Структура.Вставить("Склад", Стеллаж.Склад);
	Структура.Вставить("Родитель", Стеллаж.КаталогСкладскихЯчеек);
	
	КоличествоМест=Стеллаж.КоличествоСекций*Стеллаж.КоличествоЯчеекВСекции;
	Структура.Вставить("КоличествоМест", КоличествоМест);
	Структура.Вставить("Ряд", Стеллаж.Код); 
	Структура.Вставить("РядДоп", Стеллаж.КодДоп);
	Структура.Вставить("СМест", 1); 
	Структура.Вставить("ПОМест", КоличествоМест); 
	КоличествоЭтажей = Стеллаж.Этажи.Количество();
	Структура.Вставить("КоличествоЭтажей", КоличествоЭтажей);
	Структура.Вставить("СЭтажей", 1);
	Структура.Вставить("ПоЭтажей", КоличествоЭтажей);
	Структура.Вставить("НаименованиеМеста", "Место");
	Структура.Вставить("НаименованиеЭтажа", "Этаж");

	
	НачатьТранзакцию();	
	СоздатьТопологиюЯчеек(Структура);
	СоздатьТопологиюСекций(Стеллаж);
	СоздатьТопологиюЗоныПриемкиИОтгрузки(Стеллаж,Структура);
	ЗафиксироватьТранзакцию();	
	
	
	
КонецПроцедуры
 
Функция ЦветаСтелажей(Склад)Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_Стеллажи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Лико_Стеллажи КАК Лико_Стеллажи
	|ГДЕ
	|	Лико_Стеллажи.Склад = &Склад";
	Запрос.УстановитьПараметр("Склад",Склад );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Соответствие = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		ДопНастройки=Выборка.Ссылка.ДопНастройки.Получить();  
		
		Если   ТипЗнч(ДопНастройки)=Тип("Структура") Тогда
			
			ДопНастройки.Свойство("ЦветСтеллажа");		   
			Соответствие.Вставить(Выборка.Ссылка, ДопНастройки.ЦветСтеллажа);
			
			
		КонецЕсли;
		
		
	КонецЦикла; 
	
	
	Возврат Соответствие;
	
	
КонецФункции  


