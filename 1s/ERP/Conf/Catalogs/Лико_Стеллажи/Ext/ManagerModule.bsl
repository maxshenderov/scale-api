Процедура СоздатьТопологиюЯчеек(СтруктураПараметров)
	НачатьТранзакцию();	
	Ряд=СоздатьПолучитьРяд(СтруктураПараметров);
	ОбработатьМеста(Ряд,СтруктураПараметров);
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Процедура СоздатьТопологиюСекций(Стеллаж) 
	
	Справочники.Лико_СкладскиеСекции.ДобавлениеИзменениеСекций(Стеллаж);
	
КонецПроцедуры 

Процедура СоздатьТопологиюЗоныПриемкиИОтгрузки(Стеллаж,СтруктураПараметров)
	
	Ряд=СоздатьПолучитьРяд(СтруктураПараметров);
	
	
	СтеллажОбъект =  Стеллаж.ПолучитьОбъект();
	СтеллажОбъект.ЗоныПриемкиОтгрузки.Очистить();
	
	НомерПола=1;

	ПолМесто = СозатьРедактироватьПолМесто(Ряд,СтруктураПараметров);

	Пока НомерПола<= Стеллаж.КоличествоЗонПриемкиОтгрузки Цикл
		
				ПолАдрес = СоздатьРедактироватьПолАдрес(ПолМесто,СтруктураПараметров,НомерПола);
		
		НоваяЗона = 	СтеллажОбъект.ЗоныПриемкиОтгрузки.Добавить();
		
		НоваяЗона.АдресХранения=ПолАдрес;		
		НомерПола=НомерПола+1;

	КонецЦикла;	
	
	СтеллажОбъект.Записать();
	 
КонецПроцедуры



Функция СозатьРедактироватьПолМесто(Ряд,Объект)
	
	КодУПП = "99";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СкладскиеЯчейки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
	|ГДЕ
	|	СкладскиеЯчейки.Родитель = &Родитель
	|	И СкладскиеЯчейки.Лико_КодУПП = &КодУПП
	|	И СкладскиеЯчейки.ЭтоГруппа";
	Запрос.УстановитьПараметр("Родитель",Ряд ); 
	Запрос.УстановитьПараметр("КодУПП",КодУПП );
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Возврат  Выборка.Ссылка;
		
	КонецЦикла; 
	
	
	
	Место=Справочники.СкладскиеЯчейки.СоздатьГруппу();
	Код=СокрЛП(Ряд.Наименование)+", ПОЛ";
	
	СпрОбъект=Место;
	СпрОбъект.Родитель=Ряд;
	СпрОбъект.Владелец		=Объект.Склад;
	СпрОбъект.Наименование	=Код;
	СпрОбъект.Код			=Код;
	СпрОбъект.Лико_КодУПП	=КодУПП;
	СпрОбъект.Лико_ИдУПП	=Код;
	СпрОбъект.Лико_ПолноеНаименованиеУПП=СокрЛП(Ряд.Наименование)+", "+Код;
	СпрОбъект.ОбменДанными.Загрузка=Истина;
	СпрОбъект.Записать();
	
	Возврат Место.Ссылка;
	
КонецФункции

Функция СоздатьРедактироватьПолАдрес(ПолМесто,Объект,НомерПола)
	
	КодУПП = Формат(НомерПола,"ЧЦ=2; ЧВН=");
	
	   Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СкладскиеЯчейки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
	|ГДЕ
	|	СкладскиеЯчейки.Родитель = &Родитель
	|	И СкладскиеЯчейки.Лико_КодУПП = &КодУПП
	|	И НЕ СкладскиеЯчейки.ЭтоГруппа";
	Запрос.УстановитьПараметр("Родитель",ПолМесто ); 
	Запрос.УстановитьПараметр("КодУПП",КодУПП );
	
	РезультатЗапроса = Запрос.Выполнить(); 
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Возврат  Выборка.Ссылка;
		
	КонецЦикла; 

	
	
			Ячейка=Справочники.СкладскиеЯчейки.СоздатьЭлемент();
		//Номер=Формат(м, "ЧЦ=2; ЧДЦ=0; ЧВН=; ЧГ=");
	Наименование=СтрШаблон("%1-%2",ПолМесто.Код,НомерПола);
	Код=Наименование;
	
	
	СпрОбъект=Ячейка;
	СпрОбъект.Типоразмер=Справочники.ТипоразмерыЯчеек.НайтиПоНаименованию("Ячейка");
	СпрОбъект.ТипСкладскойЯчейки=Перечисления.ТипыСкладскихЯчеек.Хранение;
	СпрОбъект.Родитель		=ПолМесто;
	СпрОбъект.Владелец		=Объект.Склад;
	СпрОбъект.УровеньДоступности=1;
	СпрОбъект.МаксимальныйКоэффициентНаполненностиПоВесу=100;
	СпрОбъект.МаксимальныйКоэффициентНаполненностиПоОбъему=100;
	СпрОбъект.Наименование	=Наименование;
	СпрОбъект.Код			=Код;
	СпрОбъект.Лико_КодУПП	=КодУПП;
	СпрОбъект.Лико_ИдУПП	=Код;
	СпрОбъект.Лико_ПолноеНаименованиеУПП=Код;
	СпрОбъект.Записать();
	Возврат СпрОбъект.Ссылка; 
	
КонецФункции





Процедура ОбработатьМеста(Ряд, Объект)
	
	МассивМестПред=ПолучитьМеста(Ряд);
	МассивМест=ОбработатьМассив(МассивМестПред);
	ОбходМассиваМест=Истина;
	м=1;
	Создано=0;

	Пока м<=Объект.КоличествоМест Цикл
		
		Если ОбходМассиваМест Тогда	
			ОбходМассиваМест=Ложь;	
			Для каждого Место Из МассивМест Цикл				
				Если м <=Объект.КоличествоМест Тогда
					Если м >=Объект.СМест и м<=Объект.ПОМест Тогда
						СоздатьРедактироватьМесто(Объект,Ряд,м,Место);
						Создано=Создано+1;

					КонецЕсли;
				Иначе
					Прервать;
				КонецЕсли; 
				м=м+1;					
			КонецЦикла;
			Если м=1 Тогда
				Если м >=Объект.СМест и м<=Объект.ПОМест Тогда
					
					СоздатьРедактироватьМесто(Объект,Ряд,м); 
					Создано=Создано+1;

				КонецЕсли;
				м=2;				
			КонецЕсли;			
		Иначе
			Если м >=Объект.СМест и м<=Объект.ПОМест Тогда
				
				СоздатьРедактироватьМесто(Объект,Ряд,м); 
				Создано=Создано+1;

			КонецЕсли;
			м=м+1;			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


Функция ОбработатьМассив(МассивМест)
	Массив = Новый Массив();
	
	Сч=1;
	Для каждого СтрМассив Из МассивМест Цикл
		Дельта=Число(СтрМассив.Лико_КодУПП)-Сч;
		Если Дельта<>0 Тогда
			
			Для Сч2=1 По Дельта Цикл 
				Массив.Добавить(Неопределено);
				Сч=Сч+1;
			КонецЦикла;
		КонецЕсли;
		Массив.Добавить(СтрМассив);
		Сч=Сч+1;
		
	КонецЦикла;
	Возврат Массив;	
КонецФункции


Функция ПолучитьМеста(Ряд)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СкладскиеЯчейки.Ссылка КАК Ссылка,
	|	СкладскиеЯчейки.Лико_КодУПП КАК Лико_КодУПП
	|ИЗ
	|	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
	|ГДЕ
	|	СкладскиеЯчейки.Родитель = &Родитель
	|	И СкладскиеЯчейки.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	СкладскиеЯчейки.Лико_КодУПП";
	Запрос.УстановитьПараметр("Родитель",Ряд );
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	
	
КонецФункции


Функция ПолучитьЯчейку(Этаж)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СкладскиеЯчейки.Ссылка КАК Ссылка,
	|	СкладскиеЯчейки.Лико_КодУПП КАК Лико_КодУПП
	|ИЗ
	|	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
	|ГДЕ
	|	СкладскиеЯчейки.Родитель = &Родитель
	|
	|УПОРЯДОЧИТЬ ПО
	|	СкладскиеЯчейки.Лико_КодУПП";
	Запрос.УстановитьПараметр("Родитель",Этаж );
	РезультатЗапроса= Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла; 
	
	
	
	
	
КонецФункции



Процедура СоздатьРедактироватьМесто(Объект,Ряд,м,Место=Неопределено)
	Если Место=Неопределено Тогда
		Место=Справочники.СкладскиеЯчейки.СоздатьГруппу();
	Иначе
		Место=Место.ПолучитьОбъект();
	КонецЕсли;
	Номер=Формат(м, "ЧЦ=2; ЧДЦ=0; ЧВН=; ЧГ=");
	Наименование=СокрЛП(Объект.НаименованиеМеста)+" №"+Номер;
	Код=СокрЛП(Ряд.Наименование)+", "+СокрЛП(Объект.НаименованиеМеста)+" №"+Номер+"("+Номер+")";
	КодУПП=Номер;
	
	СпрОбъект=Место;
	СпрОбъект.Родитель=Ряд;
	СпрОбъект.Владелец		=Объект.Склад;
	СпрОбъект.Наименование	=Наименование;
	СпрОбъект.Код			=Код;
	СпрОбъект.Лико_КодУПП	=КодУПП;
	СпрОбъект.Лико_ИдУПП	=Код;
	СпрОбъект.Лико_ПолноеНаименованиеУПП=СокрЛП(Ряд.Наименование)+", "+Наименование;
	СпрОбъект.ОбменДанными.Загрузка=Истина;
	СпрОбъект.Записать();
	
	ОбработатьЭтажи(Объект,Место.Ссылка,Ряд);	
	
КонецПроцедуры


Процедура СоздатьРедактироватьЭтаж(Объект,Ряд,Место,м,Этаж=Неопределено)
	Если Этаж=Неопределено Тогда
		Этаж=Справочники.СкладскиеЯчейки.СоздатьГруппу();
	Иначе
		Этаж=Этаж.ПолучитьОбъект();
	КонецЕсли;
	Номер=Формат(м, "ЧЦ=2; ЧДЦ=0; ЧВН=; ЧГ=");
	Наименование=СокрЛП(Объект.НаименованиеЭтажа)+" №"+Номер;
	Код=СокрЛП(Ряд.Наименование)+", "+СокрЛП(Место.Наименование)+", " +Наименование+"("+Номер+")";
	КодУПП=Номер;
	
	СпрОбъект=Этаж;
	СпрОбъект.Родитель		=Место;
	СпрОбъект.Владелец		=Объект.Склад;
	СпрОбъект.Наименование	=Наименование;
	СпрОбъект.Код			=Код;
	СпрОбъект.Лико_КодУПП	=КодУПП;
	СпрОбъект.Лико_ИдУПП	=Код;
	СпрОбъект.Лико_ПолноеНаименованиеУПП=СокрЛП(Ряд.Наименование)+", "+СокрЛП(Место.Наименование)+", "+Наименование;
	СпрОбъект.Записать();
	ОбработатьЯчейки(Объект,СпрОбъект.Ссылка);
	
КонецПроцедуры


Процедура ОбработатьЯчейки(Объект,Этаж)
	
	МассивЯчеек=ПолучитьЯчейку(Этаж);
	СоздатьРедактироватьЯчейку(Объект,Этаж,ПолучитьЯчейку(Этаж)); 
	
	
КонецПроцедуры



Процедура СоздатьРедактироватьЯчейку(Объект,Этаж,Ячейка)
	Если Ячейка=Неопределено Тогда
		Ячейка=Справочники.СкладскиеЯчейки.СоздатьЭлемент();
	Иначе
		Ячейка=Ячейка.ПолучитьОбъект();
	КонецЕсли;
	//Номер=Формат(м, "ЧЦ=2; ЧДЦ=0; ЧВН=; ЧГ=");
	Наименование=ПолучитьКодПоРодителю(Объект,Этаж);
	Код=Наименование;
	КодУПП="01";
	
	СпрОбъект=Ячейка;
	СпрОбъект.Типоразмер=Справочники.ТипоразмерыЯчеек.НайтиПоНаименованию("Ячейка");
	СпрОбъект.ТипСкладскойЯчейки=Перечисления.ТипыСкладскихЯчеек.Хранение;
	СпрОбъект.Родитель		=Этаж;
	СпрОбъект.Владелец		=Объект.Склад;
	СпрОбъект.УровеньДоступности=1;
	СпрОбъект.МаксимальныйКоэффициентНаполненностиПоВесу=100;
	СпрОбъект.МаксимальныйКоэффициентНаполненностиПоОбъему=100;
	СпрОбъект.Наименование	=Наименование;
	СпрОбъект.Код			=Код;
	СпрОбъект.Лико_КодУПП	=КодУПП;
	СпрОбъект.Лико_ИдУПП	=СокрЛП(Этаж.Лико_ПолноеНаименованиеУПП)+", "+Код+"(01)";
	СпрОбъект.Лико_ПолноеНаименованиеУПП=СокрЛП(Этаж.Лико_ПолноеНаименованиеУПП)+", "+Код;
	СпрОбъект.Записать();
	
КонецПроцедуры
	
Функция ПолучитьКодПоРодителю(Объект,Родитель);
	Код=Родитель.Лико_ПолноенаименованиеУПП;
	Код=СтрЗаменить(Код,"Ряд","Р");
	Код=СтрЗаменить(Код,"№0","");
	Код=СтрЗаменить(Код,"№","");
	Код=СтрЗаменить(Код,",","");
	Код=СтрЗаменить(Код," ","");
	//Код=СтрЗаменить(Код,"0","");	
	Код=СтрЗаменить(Код,СокрЛП(Объект.НаименованиеМеста),Лев(Объект.НаименованиеМеста,1));
	Код=СтрЗаменить(Код,СокрЛП(Объект.НаименованиеЭтажа),Лев(Объект.НаименованиеЭтажа,1));
	
	Возврат Код;
	
	
	
КонецФункции




Процедура ОбработатьЭтажи(Объект,Место,Ряд)
	МассивЭтажей=ПолучитьМеста(Место);
	ОбходМассиваЭтажей=Истина;
	м=1;
	Создано=0;
	Пока м<= Объект.КоличествоЭтажей Цикл
		Если ОбходМассиваЭтажей Тогда	
			ОбходМассиваЭтажей=Ложь;	
			Для каждого Этаж Из МассивЭтажей Цикл
				Если м <=Объект.КоличествоЭтажей Тогда
					Если м >=Объект.СЭтажей и м<=Объект.ПоЭтажей Тогда
						
						СоздатьРедактироватьЭтаж(Объект,Ряд,Место,м,Этаж);
						Создано=Создано+1;
					КонецЕсли;
					
				Иначе
					Прервать;
				КонецЕсли;
				м=м+1;	
				
			КонецЦикла;
			Если м=1 ТОгда
				Если м >=Объект.СЭтажей и м<=Объект.ПоЭтажей Тогда
					
					СоздатьРедактироватьЭтаж(Объект,Ряд,Место,м);
					Создано=Создано+1;
				КонецЕсли;
				м=2;
			КонецЕсли;
			
			
		Иначе
			Если м >=Объект.СЭтажей и м<=Объект.ПоЭтажей Тогда
				
				СоздатьРедактироватьЭтаж(Объект,Ряд,Место,м);
				Создано=Создано+1;
			КонецЕсли;
			м=м+1;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры



Функция СоздатьПолучитьРяд(Объект)
	РядПолный = Объект.Ряд+Объект.РядДоп;
	РядПолныйДлина = СтрДлина(РядПолный);
	РядНаименование="Ряд №"+Формат(Объект.Ряд+Объект.РядДоп, "ЧЦ="+РядПолныйДлина+"; ЧДЦ=0; ЧВН=; ЧГ=");
	РядКод=РядНаименование+"("+Формат(Объект.Ряд+Объект.РядДоп,  "ЧЦ="+РядПолныйДлина+"; ЧДЦ=0; ЧВН=; ЧГ=")+")";
	КодУПП=Формат(Объект.Ряд,  "ЧЦ=2; ЧДЦ=0; ЧВН=; ЧГ=");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СкладскиеЯчейки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
	|ГДЕ
	|	СкладскиеЯчейки.Лико_ПолноеНаименованиеУПП = &КодУПП
	|	И СкладскиеЯчейки.Родитель = &Родитель";
	Запрос.УстановитьПараметр("КодУПП",РядНаименование );
	Запрос.УстановитьПараметр("Родитель",Объект.Родитель );

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла;
			СпрОбъект=Справочники.СкладскиеЯчейки.СоздатьГруппу();
		СпрОбъект.Родитель= Объект.Родитель;
		СпрОбъект.Владелец		=Объект.Склад;
		СпрОбъект.Наименование	=РядНаименование;
		СпрОбъект.Код			=РядКод;
		СпрОбъект.Лико_КодУПП	=КодУПП;
		СпрОбъект.Лико_ИдУПП	=РядКод;
		СпрОбъект.Лико_ПолноеНаименованиеУПП=РядНаименование;
		СпрОбъект.Записать();
		Возврат СпрОбъект.Ссылка;
		
КонецФункции


