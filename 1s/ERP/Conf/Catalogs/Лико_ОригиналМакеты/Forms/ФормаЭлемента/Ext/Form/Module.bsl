		Возврат;
	КонецПопытки;
	Сообщить("Файл удален из базы данных оригинал-макетов");
	//НайденныеСтроки = Объект.Файлы.НайтиСтроки(Новый Структура("НомерСтроки", текстр.номерстроки));	
	//Для Каждого Строка из НайденныеСтроки Цикл	
	//	Объект.Файлы.Удалить(Строка);		
	//КонецЦикла;
	Объект.Файлы.Удалить(Объект.Файлы[текстр.номерстроки-1]);
	АдресКартинки="";

