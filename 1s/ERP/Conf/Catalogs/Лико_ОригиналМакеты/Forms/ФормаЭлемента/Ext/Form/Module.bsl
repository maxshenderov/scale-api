	//Command.CommandText = "DELETE FROM [" + ИмяТаблицы + "] WHERE GUID = '" + ИДСсылки + "' AND GUIDMaket  = '" + ИДСсылкиМакета + "'";
	Command.CommandText = "DELETE FROM [" + ИмяТаблицы + "] WHERE GUIDOM = '" + ИДСсылки + "' AND GUIDRow  = '" + ИДСсылкиМакета + "'";

