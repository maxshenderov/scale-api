&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	
	Если не ЗначениеЗаполнено(ТекущийОбъект.ссылка) или  не Модифицированность Тогда 
		Возврат
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.Ссылка КАК Ссылка,
		|	ЗаказКлиентаТовары.Ссылка.Площадка КАК Площадка,
		|	ЗаказКлиентаТовары.Ссылка.НомерБезПрефикса КАК НомерБезПрефикса
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.ОригиналМакет = &ОригиналМакет
		|	И ЗаказКлиентаТовары.Ссылка.ДатаОтправкиВРаботу <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)";
	
	Запрос.УстановитьПараметр("ОригиналМакет", ТекущийОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	ЕстьЗаказыВПечати = Ложь;  
	СтрокаЗаказы = "";
	
	Пока Выборка.Следующий() Цикл  
		
		Если Лико_Планирование.ЕстьЭтапыНеДоПечати(Выборка.Ссылка) Тогда   			
			//ЕстьЗаказыВПечати = Истина;
			//СтрокаЗаказы = Выборка.НомерБезПрефикса + символы.ПС;						
		Иначе 
			ЗаказОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ЗаказОбъект.Версия = ЗаказОбъект.Версия + 1;
			ЗаказОбъект.ДатаОтправкиВРаботу = ТекущаяДата();
			
			НомерВерсии = 0;
			для каждого стр из ЗаказОбъект.ПричиныЗамены цикл
				НомерВерсии = Макс(НомерВерсии, стр.НомерВерсии); 
			конеццикла; 
			
			НомерВерсии = НомерВерсии + 1;
			
			
			НовСтрПричиныЗамены = ЗаказОбъект.ПричиныЗамены.Добавить();
			НовСтрПричиныЗамены.ПричинаЗамены = Справочники.Лико_ПричиныЗамены.Макет;  
			НовСтрПричиныЗамены.НомерВерсии = НомерВерсии; 
			НовСтрПричиныЗамены.Комментарий = "Замена ОМ. Создан автоматически";  
			НовСтрПричиныЗамены.Автор = ПользователиКлиентСервер.ТекущийПользователь();  
			НовСтрПричиныЗамены.Дата = ТекущаяДата(); 
			
			Попытка
				ЗаказОбъект.ОбменДанными.Загрузка = Истина;
				ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись,); 
				
				Лико_Планирование.ПеренестиЗаказ(Выборка.Ссылка, Справочники.Лико_ЭтапыВыполненияЗаказа.ОПП,,,,,Истина); 
				
				Если Выборка.Площадка = Справочники.Лико_Площадки.Ликофлекс Тогда 
					СписокПолучателей = "OPP@okil-sato.ru";				
					Лико_Планирование.ОтправитьПисьмо("", СтрШаблон( "оригинал макет обновлен, версия поднята в заказе %1", Выборка.Ссылка ), СписокПолучателей);   
				КонецЕсли;
				
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;  
			
		КонецЕсли;    
		
			
	КонецЦикла; 

	
	
КонецПроцедуры


	 

