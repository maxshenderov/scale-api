&НаКлиенте
Процедура ПросмотрКартинки()
	Попытка
		ЕСли ИмяФайлаИсточник=Адрескартинки Тогда
			Возврат;
		КонецЕсли;
		
		HTML=Неопределено;
		ИмяФайлаИсточник	=Адрескартинки;
		ИмяФайла			=Неопределено;
		Расширение			=Неопределено;
		
		ПолучитьИмяРасширение(ИмяФайлаИсточник, ИмяФайла,Расширение);
		
		Если ВРег(Расширение)="PDF" Тогда
			Элементы.PDF.Видимость		=Истина;
			Элементы.JPG.Видимость	=Ложь;
			HTML=Адрескартинки;
			
		Иначе
			
			Элементы.PDF.Видимость		=Ложь;
			Элементы.JPG.Видимость	=Истина;
			
			ЕстьСкан = ЗначениеЗаполнено(ИмяФайлаИсточник);
			Если ЕстьСкан Тогда
				/// Проверяем физическое наличие скана
				Фл = Новый Файл(ИмяФайлаИсточник);
				Если Не Фл.Существует() Тогда
					ЕстьСкан = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			Если ЕстьСкан Тогда
				Картинка = Новый Картинка(ИмяФайлаИсточник); 
				Предпросмотр = ПоместитьВоВременноеХранилище(Картинка, ЭтаФорма.УникальныйИдентификатор);
			Иначе
				Предпросмотр = "";
			КонецЕсли; 	
		КонецЕсли;
		
	Исключение
		//ОписаниеОшибки()
	КонецПопытки;
	
	
КонецПроцедуры


// Процедура разделяет имя и расширение файла
&НаКлиенте 
Процедура ПолучитьИмяРасширение(ИмяРасширение, Имя, Расширение) Экспорт
	МассивЧастей = РазложитьСтрокуВМассивПодстрок(ИмяРасширение, ".");
	Если МассивЧастей.Количество()=0 Тогда
		Имя = "";
		Расширение = "";
	Иначе
		Имя = "";
		Для й=0 По МассивЧастей.Количество()-2 Цикл
			Имя = Имя+?(й=0,"",".")+МассивЧастей[й];
		КонецЦикла;
		Расширение = МассивЧастей[МассивЧастей.Количество()-1];
	КонецЕсли;
КонецПроцедуры

// Разбивает строку на несколько строк по разделителю. Разделитель может иметь любую длину.
//
// Параметры:
//  Строка                 - Строка - текст с разделителями;
//  Разделитель            - Строка - разделитель строк текста, минимум 1 символ;
//  ПропускатьПустыеСтроки - Булево - признак необходимости включения в результат пустых строк.
//    Если параметр не задан, то функция работает в режиме совместимости со своей предыдущей версией:
//     - для разделителя-пробела пустые строки не включаются в результат, для остальных разделителей пустые строки
//       включаются в результат.
//     - если параметр Строка не содержит значащих символов или не содержит ни одного символа (пустая строка), то в
//       случае разделителя-пробела результатом функции будет массив, содержащий одно значение "" (пустая строка), а
//       при других разделителях результатом функции будет пустой массив.
//
//
// Возвращаемое значение:
//  Массив - массив строк.
//
// Примеры:
//  РазложитьСтрокуВМассивПодстрок(",один,,два,", ",") - возвратит массив из 5 элементов, три из которых  - пустые строки;
//  РазложитьСтрокуВМассивПодстрок(",один,,два,", ",", Истина) - возвратит массив из двух элементов;
//  РазложитьСтрокуВМассивПодстрок(" один   два  ", " ") - возвратит массив из двух элементов;
//  РазложитьСтрокуВМассивПодстрок("") - возвратит пустой массив;
//  РазложитьСтрокуВМассивПодстрок("",,Ложь) - возвратит массив с одним элементом "" (пустой строкой);
//  РазложитьСтрокуВМассивПодстрок("", " ") - возвратит массив с одним элементом "" (пустой строкой);
//
&НаКлиенте  
Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",", Знач ПропускатьПустыеСтроки = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	// для обеспечения обратной совместимости
	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
		Если ПустаяСтрока(Строка) Тогда 
			Если Разделитель = " " Тогда
				Результат.Добавить("");
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	//
	
	Позиция = Найти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
			Результат.Добавить(Подстрока);
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Строка, Разделитель);
	КонецЦикла;
	
	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
		Результат.Добавить(Строка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 


&НаКлиенте
Процедура Сохранить(Команда)
	текстр= Элементы.Файлы.ТекущиеДанные;

	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	
	ДиалогВыбораФайла.Заголовок = "Укажите имя файла";
	ДиалогВыбораФайла.ПредварительныйПросмотр = Ложь;
	ДиалогВыбораФайла.Расширение = "*";
	ДиалогВыбораФайла.ПолноеИмяФайла = текстр.имяфайла;
	
	// Сохранить файл на диске
	Если ДиалогВыбораФайла.Выбрать() Тогда
		ПараметрыСоединения = Лико_ДополнительноКлиент.УстановитьСоединениеССервером();
		Подключение = ПараметрыСоединения.ADOConnection;

	Если Подключение = Неопределено Тогда
		#Если Клиент Тогда
			Предупреждение("Отсутствует подключение к SQL серверу! Обратитесь, пожалуйста, в IT - отдел.");
		#КонецЕсли	
		Возврат;
	КонецЕсли;
	
	Файл = Неопределено;
	ИмяТаблицы = "FileStore";
	Замещать = Истина;
	
	ИДСсылки = ЗначениеВСтрокуВнутрНаСервере(Объект.Ссылка);
	ИДСсылкиМакета = ЗначениеВСтрокуВнутрНаСервере(текстр.ИдентификаторФайла);

	
	Stream = Новый COMОбъект("ADODB.Stream");
	Stream.Type = 1;
	Stream.Open();
	
	RecordSet = Новый COMОбъект("ADODB.RecordSet");
	RecordSet.CursorLocation = 3;
	RecordSet.LockType = 2;
	
	//Запрос = "SELECT Data FROM [" + ИмяТаблицы + "] WHERE GUID = '" + ИДСсылки + "' AND GUIDMaket  = '" + ИДСсылкиМакета + "'";
	Запрос = "SELECT Data FROM [" + ИмяТаблицы + "] WHERE GUIDOM = '" + ИДСсылки + "' AND GUIDRow  = '" + ИДСсылкиМакета + "'";

	RecordSet.Open(Запрос,Подключение);
	
	//Попытка
		RecordSet.MoveFirst();
		Stream.Write(RecordSet.Fields("Data").Value);
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		Stream.SaveToFile(ИмяВременногоФайла);

		Stream.Close();
		RecordSet.Close();
		Файл = Новый ДвоичныеДанные(ИмяВременногоФайла);
		УдалитьФайлы(ИмяВременногоФайла);

		//Возврат Файл;
		Если Файл<> Неопределено Тогда
			Файл.Записать(ДиалогВыбораФайла.ПолноеИмяФайла);	
		КонецЕсли;	
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

