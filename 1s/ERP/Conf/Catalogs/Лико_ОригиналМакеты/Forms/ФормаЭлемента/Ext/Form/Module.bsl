&НаКлиенте  
Перем ИмяФайлаИсточник;

&НаСервере	
Функция ПолучитьИмяФайла(ИмяКаталога, ИмяФайла) Экспорт

	Если Не ПустаяСтрока(ИмяФайла) Тогда
		
		Возврат ИмяКаталога + ?(Прав(ИмяКаталога, 1) = "\", "", "\") + ИмяФайла;	
		
	Иначе
		
		Возврат ИмяКаталога;
		
	КонецЕсли;

КонецФункции 

&НаСервере
Функция РазобратьСтроку(_Строка, _Разделитель, _УдалятьПустые = Истина)
	Результат = Новый СписокЗначений;
	_т = СтрЗаменить(_Строка, _Разделитель, Символы.ПС);
	
	Для Строк = 1 по СтрЧислоСтрок(_т) Цикл
		Если СтрДлина(СтрПолучитьСтроку(_т, Строк)) > 0 ИЛИ не _УдалятьПустые Тогда
			Результат.Добавить(СтрПолучитьСтроку(_т, Строк));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ЗначениеВСтрокуВнутрНаСервере(Значение)
	возврат  ЗначениеВСтрокуВнутр(Значение)
КонецФункции	


&НаКлиенте
Процедура ДобавитьКартинкуВSQL(стр)
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	ДиалогОткрытияФайла.Фильтр = "(*.*)|*.*";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите файл оригинал-макета";
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		ПараметрыСоединения =  Лико_ДополнительноКлиент.УстановитьСоединениеССервером();

		Подключение = ПараметрыСоединения.ADOConnection;
		ИмяТаблицы = "FileStore";
		Замещать = Истина;
		ИмяФайла = СокрЛП(ДиалогОткрытияФайла.ВыбранныеФайлы[0]);
		
		ИДСсылки = ЗначениеВСтрокуВнутрНаСервере(Объект.ссылка);
		ИДСсылкиМакета = ЗначениеВСтрокуВнутрНаСервере(стр.идентификаторфайла);

		Stream = Новый COMОбъект("ADODB.Stream");
		Stream.Type = 1;
		Stream.Open();
		Stream.LoadFromFile(ИмяФайла);
		
		RecordSet = Новый COMОбъект("ADODB.RecordSet");
		RecordSet.CursorLocation = 3;
		RecordSet.LockType = 2;
		
		Имяр = РазобратьСтроку(ИмяФайла, "\");
		Имяр = Имяр[Имяр.Количество() - 1].Значение;
		
		//Запрос = "select [GUID], [GUIDMaket],[Data], [FileName], [UserName], [DateTime] from [" + ИмяТаблицы + "] where [GUID]='" + ИДСсылки + "' AND [GUIDMaket]='" +ИДСсылкиМакета + "'";
		Запрос = "select [GUID],[GUIDMaket], [GUIDOM], [GUIDRow],[Data], [FileName], [UserName], [DateTime] from [" + ИмяТаблицы + "] where [GUIDOM]='" + ИДСсылки + "' AND [GUIDRow]='" +ИДСсылкиМакета + "'";

		
		Попытка		
			RecordSet.Open(Запрос, Подключение );
		Исключение	
			Сообщить("Ошибка выполнения SQL запроса (" + ОписаниеОшибки() + ")", СтатусСообщения.ОченьВажное);	
			Возврат ;
		КонецПопытки;
		
		Если RecordSet.RecordCount > 0 И Замещать = Ложь Тогда
			RecordSet.AddNew();
			Имяр = Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy hh-mm-ss'") + " " + Имяр;
		ИначеЕсли RecordSet.RecordCount = 0 Тогда
			RecordSet.AddNew();
		Иначе		
			RecordSet.MoveFirst();
		КонецЕсли;
		
		RecordSet.Fields("Data").Value = Stream.Read(-1);
		RecordSet.Fields("GUID").Value = ИДСсылки;
		RecordSet.Fields("GUIDOM").Value = ИДСсылки;
		RecordSet.Fields("GUIDRow").Value = ИДСсылкиМакета;
		RecordSet.Fields("GUIDMaket").Value = ИДСсылкиМакета;
		RecordSet.Fields("FileName").Value = Имяр;
		RecordSet.Fields("UserName").Value = СокрЛП(Строка(ПользователиКлиентСервер.ТекущийПользователь()));
		RecordSet.Fields("DateTime").Value = ТекущаяДата();
		RecordSet.Update();	
		
		Stream.Close();
		RecordSet.Close();
		стр.ИмяФайла  = СтрЗаменить(ДиалогОткрытияФайла.ПолноеИмяФайла,ДиалогОткрытияФайла.Каталог, "");
		Лико_ДополнительноКлиент.ЗакрытьСоединениеССервером(ПараметрыСоединения);
		//АдресКартинки=ПоместитьВоВременноеХранилище(Новый Картинка(ИмяФайла, Истина), УникальныйИдентификатор);
   		этаформа.Записать();
		
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ДобавитьФайл(Команда)
	Если Не значениеЗаполнено(Объект.Ссылка) Тогда 
		Сообщить("Сначала нужно записать элемент!");
		Возврат;
	КонецЕсли;
	текстр = Объект.Файлы.Добавить();
	текстр.идентификаторфайла = Новый УникальныйИдентификатор;
	ДобавитьКартинкуВSQL(текстр);
