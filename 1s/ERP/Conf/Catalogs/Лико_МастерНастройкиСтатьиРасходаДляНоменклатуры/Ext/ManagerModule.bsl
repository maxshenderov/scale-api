Функция ОпределитьСтатьюРасходов(Номенклатура,ДокументРасхода=Неопределено) Экспорт
	Если ДокументРасхода=Неопределено Тогда
		ДокументРасхода=Документы.Лико_ПередачаТоваров.ПустаяСсылка();
	КонецЕсли;
	СтатьяРасходов=Неопределено;	
	Запрос = Новый Запрос;
	Запрос.Текст=ТекстЗапросаПравилПоВидуНоменклатуры(); 
	Запрос.УстановитьПараметр("ВидНоменклатуры",Номенклатура.ВидНоменклатуры );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл 		
		ИспользоватьЭтоПравило=Истина;	
		Если Выборка.СложнаяНастройка Тогда 
		ИспользоватьЭтоПравило= ИспользоватьПравилоСКД(Выборка,Номенклатура,ДокументРасхода);		
			
		Иначе
			Для каждого ДопРеквизит Из Выборка.Ссылка.ДополнительныеРеквизиты Цикл			
				Если ЗначениеЗаполнено(ДопРеквизит.Значение) ТОгда
					Структура = Новый Структура;
					Структура.Вставить("Свойство",ДопРеквизит.Свойство);
					Структура.Вставить("Значение",ДопРеквизит.Значение);
					НайденоСвойство=Номенклатура.ДополнительныеРеквизиты.НайтиСтроки(Структура).Количество()>0;
					ЕСли  НайденоСвойство и ДопРеквизит.Исключить ТОгда
						ИспользоватьЭтоПравило=Ложь;
						Прервать;
					ИначеЕсли НЕ НайденоСвойство и НЕ  ДопРеквизит.Исключить ТОгда
						ИспользоватьЭтоПравило=Ложь; 
						Прервать;				
					КонецЕсли;				
				КонецЕсли;
			КонецЦикла; 
		КонецЕсли;
		
		Если ИспользоватьЭтоПравило Тогда
			Возврат Выборка.СтатьяРасхода;
		КонецЕсли;			
		
	КонецЦикла;
	
	Возврат ПланыВидовХарактеристик.СтатьиРасходов.ПустаяСсылка();
КонецФункции
Процедура УстановитьЗначениеПараметраНастроек(Настройки, ИмяПараметра, Значение)
	
	Параметр = Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = Значение;
		Параметр.Использование = Истина;
	КонецЕсли;
	
КонецПроцедуры


Функция ИспользоватьПравилоСКД(Выборка,Номенклатура,ДокументРасхода) //+Лико m.shenderov 30.12.2018
	ОтборНастройки= Новый КомпоновщикНастроекКомпоновкиДанных;
    СхемаКомпоновкиДанных = Справочники.Лико_МастерНастройкиСтатьиРасходаДляНоменклатуры.ПолучитьМакет("ОтборПоУсловию");
	//URLСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, Новый УникальныйИдентификатор());
   ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных);
   ОтборНастройки.Инициализировать(ИсточникНастроек);
   	ТекНастройки = Выборка.ОтборНастройки.Получить();
	
	Если ТекНастройки = Неопределено Тогда
		ОтборНастройки.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Иначе
		ОтборНастройки.ЗагрузитьНастройки(ТекНастройки);
	КонецЕсли;
	//ОтборНастройки.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
    УстановитьЗначениеПараметраНастроек(ОтборНастройки.Настройки, "Номенклатура" , Номенклатура);
	УстановитьЗначениеПараметраНастроек(ОтборНастройки.Настройки, "ДокументРасхода", ДокументРасхода);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ОтборНастройки.ПолучитьНастройки(),,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;

	Если 	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных).Количество()>0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли; 	
КонецФункции //-Лико m.shenderov 30.12.2018 



Функция ТекстЗапросаПравилПоВидуНоменклатуры()
	
	Возврат 
	"ВЫБРАТЬ
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.Ссылка КАК Ссылка,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.ВерсияДанных КАК ВерсияДанных,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.ПометкаУдаления КАК ПометкаУдаления,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.Код КАК Код,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.Наименование КАК Наименование,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.Выключить КАК Выключить,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.СтатьяРасхода КАК СтатьяРасхода,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.Организация КАК Организация,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.ВидНоменклатуры КАК ВидНоменклатуры,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.Описание КАК Описание,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.Предопределенный КАК Предопределенный,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.СложнаяНастройка КАК СложнаяНастройка,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.ОтборНастройки КАК ОтборНастройки,
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.Приоритет КАК Приоритет
	|ИЗ
	|	Справочник.Лико_МастерНастройкиСтатьиРасходаДляНоменклатуры КАК ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры
	|ГДЕ
	|	ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры
	|	И НЕ ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.ПометкаУдаления
	|	И НЕ ЛикоМастерНастройкиСтатьиРасходаДляНоменклатуры.Выключить
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	
КонецФункции

