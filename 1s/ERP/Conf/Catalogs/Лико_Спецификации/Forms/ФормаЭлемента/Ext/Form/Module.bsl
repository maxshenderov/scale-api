&НаСервере
Функция ПолучитьГрамматуруВала(Номенклатура)
	Грамматура = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПараметрыШтампа.ГрамматураВала КАК ГрамматураВала,
	|	Лико_ПараметрыШтампа.ПроцентЗаливки КАК ПроцентЗаливки
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|ГДЕ
	|	Лико_ПараметрыШтампа.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.ГрамматураВала) Тогда
			Если Объект.Площадка = Справочники.Лико_Площадки.ИксПак Тогда 
				Грамматура =  Результат.ГрамматураВала ;
			Иначе
				Грамматура = Результат.ГрамматураВала*0.5;
			КонецЕсли;
			ПроцентЗаливки = Результат.ПроцентЗаливки;
		КонецЕсли;
	КонецЕсли;
	ПараметрыВала = Новый Структура("Грамматура,ПроцентЗаливки", Грамматура, ПроцентЗаливки);
	Возврат ПараметрыВала;
КонецФункции

