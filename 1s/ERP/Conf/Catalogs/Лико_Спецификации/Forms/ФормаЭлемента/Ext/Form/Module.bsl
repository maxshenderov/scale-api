				НоваяСтрокаГТ.ТипКраски	 = ЗначениеРеквизита(стр.клей, "ЦеноваяГруппа") ;
				НоваяСтрокаГТ.Номенклатура = стр.клей;
			КонецЕсли;  
			НоваяСтрокаГТ.РабочийЦентр   = стр.РабочийЦентр;  
