&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	Если Объект.Площадка = Справочники.Лико_Площадки.ИксПак Тогда
		Элементы.СтоимостьВес.Видимость = Истина;
		Элементы.ТоварыВес.Видимость = Истина;
		Элементы.СтоимостьСтоимость1Кг.Видимость = Истина;
	Иначе
		Элементы.СтоимостьВес.Видимость = Ложь;
		Элементы.ТоварыВес.Видимость = Ложь;
		Элементы.СтоимостьСтоимость1Кг.Видимость = Ложь;
	КонецЕсли;    
	
	Если Объект.Площадка <> Справочники.Лико_Площадки.Урал Тогда
		Элементы.ДлинаЭтикетки.Заголовок = "Высота этикетки"
	Иначе
		Элементы.ДлинаЭтикетки.Заголовок = "Длина этикетки";
	КонецЕсли;	
	
КонецПроцедуры

