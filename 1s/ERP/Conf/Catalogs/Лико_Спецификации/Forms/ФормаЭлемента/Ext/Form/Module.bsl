//Цвета
&НаКлиенте
Процедура ЦветаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.Цвета.ТекущиеДанные;	
	Если НоваяСтрока Тогда 
		Элемент.ТекущиеДанные.КлючСтроки = Новый УникальныйИдентификатор;
		Если НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.номерпроката) Тогда
			Элемент.ТекущиеДанные.номерпроката =1; 
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.НомерРаботы) Тогда
			Элемент.ТекущиеДанные.НомерРаботы =1;
		КонецЕсли;
		Элемент.ТекущиеДанные.НомерВарианта = 1; 
	КонецЕсли;
	Если Копирование И ТекущиеДанные.ВидСекции <> ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Цифровая") Тогда
		ТекущиеДанные.Форма = Неопределено;
	КонецЕсли;
	Если Копирование Тогда
		ДобавитьУсловноеОформлениеЦветаВидОснастка();
		ДобавитьУсловноеОформлениеЦветаВалФорма();
	КонецЕсли;
КонецПроцедуры

