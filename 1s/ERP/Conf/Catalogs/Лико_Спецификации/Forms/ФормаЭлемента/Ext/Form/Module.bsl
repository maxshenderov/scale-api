КонецПроцедуры


#КонецОбласти

&НаКлиенте
Процедура ЗаписатьЦветаВРаботы()   
	
	Объект.ВидыРабот.Очистить();
	
	Для каждого стр Из объект.Цвета Цикл 
		ВидРабот =   ЗначениеРеквизита(стр.ВидСекции, "ВидРабот");
		Если стр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ГорячееТиснениеПлоское")  Тогда 
			Если стр.направлениепротяжки = ПредопределенноеЗначение("Перечисление.Лико_НаправленияПротяжки.Поперечное") Тогда 
				ВидРабот = ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПоперечное");
			Иначе
				ВидРабот = ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПродольное");
			КонецЕсли;
		КонецЕсли;
		
		Отбор = Новый Структура("ВидРабот", ВидРабот); 
		Отбор.Вставить("НомерПроката", стр.НомерПроката);  
		Отбор.Вставить( "НомерРаботы", стр.НомерРаботы);
		Отбор.Вставить( "НомерВарианта", стр.НомерВарианта);
		
		строкиРабот = Объект.ВидыРабот.НайтиСтроки(Отбор);
		Если строкиРабот.Количество() = 0 Тогда    
			стрработа = Объект.ВидыРабот.Добавить();
			ЗаполнитьЗначенияСвойств(стрработа, стр);
			Если Не ВидРабот = ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.Печать") Тогда 
				стрработа.Клей = стр.типкраски;  
			КонецЕсли;
			стрработа.видработ = видработ;
			Если стр.видсекции =  ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Нумератор")  Тогда 
				стрработа.дополнительно = стр.количестворучьевнумератора;
			Иначе
				стрработа.дополнительно = стр.подача;    
			Конецесли;
			//стрработа.подача = стр.подачафакт;                                 
			Если стр.видсекции =  ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Инкджет") Тогда 
				стрработа.расходкраски = объект.расходкраски;       
			КонецЕсли;  
			Если стр.видсекции =  ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Цифровая") Тогда 
				стрработа.клей = ЗначениеРеквизита(объект.Праймер, "ЦеноваяГруппа");      
			КонецЕсли;  
		КонецЕсли;
	КонецЦикла;
	
	ПроставитьВидВырубкиНаСервере() ;
	
	//ИзмененитьДоступностиПолейНаСервере(Объект.ВидВырубки);
	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьЦенуБезНДС()
	Для каждого стр из Объект.Стоимость Цикл
		Если ЗначениеЗаполнено(стр.цена) И ЗначениеЗаполнено(стр.ставкаНДС) Тогда 
			ТекПроцентНДС = стр.СтавкаНДС.Ставка;
			стр.ЦенаБезНДС = стр.цена/(1+ТекПроцентНДС/100);
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры	


&НаСервереБезКонтекста
Функция ЗначениеРеквизита(Объект,ИмяРеквизита)
	Если ЗначениеЗаполнено(Объект) Тогда 
 		Возврат Объект[ИмяРеквизита];
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

&НаСервере
Процедура РассчитатьНаСервере(Спецификация, Отказ= Истина)
	Лико_Планирование.РассчитатьСебестоимость_НормативыСпецификации(Спецификация, Отказ);
	Прочитать();
	ЗаполнитьЦенуБезНДС();
	Если Объект.Площадка = Справочники.Лико_Площадки.ИксПак Тогда
		Для каждого Стр Из Объект.Стоимость Цикл
			Если НЕ ЗначениеЗаполнено(Стр.Вес) И ЗначениеЗаполнено(Стр.Количество) Тогда
				ПересчитатьКоличествоВесНаСервере(Стр.ПолучитьИдентификатор(),"СтоимостьКоличество");
			ИначеЕсли ЗначениеЗаполнено(Стр.Вес) И ЗначениеЗаполнено(Стр.Количество) И ЗначениеЗаполнено(Стр.Стоимость) Тогда
				Стр.Стоимость1Кг = Стр.Стоимость/стр.Вес
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли; 
КонецПроцедуры

&НаСервереБезКонтекста
Функция РассчитатьТиражНаСервере(ПогонныйМетраж, ЭтикетокНаЛисте,ШагПечати, Z)
	Тираж = Лико_Планирование.РассчитатьТираж(ПогонныйМетраж,ЭтикетокНаЛисте,Z, ШагПечати );
	Возврат Тираж;
КонецФункции	

&НаСервере
Процедура	ЗаполнитьНаименованиеНаСервере();
	Таб = Объект.Товары.Выгрузить();
	Таб.Свернуть("Номенклатура");
	Объект.Наименование = "";
	Для каждого стр из Таб Цикл
		 Объект.Наименование = Объект.Наименование+?(ЗначениеЗаполнено(Объект.Наименование), ", ", "")+СокрЛП(стр.Номенклатура.Наименование);
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВариантПоЗаказуНаСервере(Док)
	
	Объект.Цвета.Очистить();
	Объект.ВидыРабот.Очистить();
	
	Для каждого стрЦвета Из Док.Цвета Цикл
		НоваяСтрЦвета =  Объект.Цвета.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрЦвета, стрЦвета);
		НоваяСтрЦвета.КлючСтроки = Новый УникальныйИдентификатор;
		СтрокиФорм = Док.Формы.НайтиСтроки(Новый Структура("КлючСтроки", СтрЦвета.КлючСтроки)) ;
		Для Каждого стрФорм из СтрокиФорм Цикл
			новаястрформ = Объект.Формы.добавить();
			ЗаполнитьЗначенияСвойств(новаястрформ, стрформ);
			новаястрформ.КлючСтроки = НоваяСтрЦвета.ключстроки;
		КонецЦикла;
		
	КонецЦикла;
	Для каждого стрРаботы Из Док.ВидыРабот Цикл
		НоваяСтрРаботы = Объект.ВидыРабот.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрРаботы, стрРаботы);
		НоваяСтрРаботы.КлючСтроки = Новый УникальныйИдентификатор;
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(Объект, Док, "ШиринаЭтикетки,ДлинаЭтикетки,ЭтМЭР,Нарезка,ПлощадьКлише,ДопускМинус,ДопускПлюс,Раппорт,ШтампВырубной,
	|Ручьи,ЭтикетокНаЛисте,ШагПечати,Z,РучьиПечати,ЭтикетокНаЛистеПечати,ДлинаПечати,КоличествоЭтПоДлинеПечати,
	|КоличествоЛистовКнижки,КоличествоКликов,РучьиПечатиИндиго,ЭтикетокНаЛистеИндиго,ДлинаПечатиИндиго,
