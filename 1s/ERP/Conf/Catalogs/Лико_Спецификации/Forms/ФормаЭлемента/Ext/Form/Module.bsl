&НаСервере
Функция ПолучитьНомерПервойИПоследнейСтрокиВТЧСОтбором(НомерВарианта, Цвета)
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	Лико_СпецификацииЦвета.НомерВарианта КАК НомерВарианта,
	 |	МИНИМУМ(Лико_СпецификацииЦвета.НомерСтроки) КАК НомерСтрокиПервая,
	 |	МАКСИМУМ(Лико_СпецификацииЦвета.НомерСтроки) КАК НомерСтрокиПоследняя
	 |ИЗ
	 |	Справочник.Лико_Спецификации.Цвета КАК Лико_СпецификацииЦвета
	 |ГДЕ
	 |	Лико_СпецификацииЦвета.НомерВарианта = &НомерВарианта
	 |	И Лико_СпецификацииЦвета.Ссылка = &Спецификация
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	Лико_СпецификацииЦвета.НомерВарианта
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	НомерСтрокиПервая";
	 
	 Если Не Цвета Тогда 
		 Запрос.Текст = СтрЗаменить(Запрос.Текст, "Цвета", "ВидыРабот");
	 КонецЕсли;
	 
	 Запрос.УстановитьПараметр("НомерВарианта",НомерВарианта);
	 Запрос.УстановитьПараметр("Спецификация",Объект.Ссылка); 
	 Результат = Запрос.Выполнить().Выгрузить();
	 Если Результат.Количество()> 0 Тогда
		 НомераСтрок = Новый Соответствие;
		 НомераСтрок.Вставить("НомерПервойСтроки", Результат[0].НомерСтрокиПервая);
		 НомераСтрок.Вставить("НомерПоследнейСтроки", Результат[0].НомерСтрокиПоследняя);
		 
		 Возврат НомераСтрок
	 Иначе
		 Возврат Неопределено;
	 КонецЕсли;
КонецФункции

