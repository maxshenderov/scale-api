&НаКлиенте
Процедура РучьиПечатиПриИзменении(Элемент)
	
	Если Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда	
		Заказ = Объект;
		ЗаполнитьПараметрыПечати(Заказ, Объект.ВидВырубки);	
	КонецЕсли;
	
	Заказ = Объект;
	ЭтикеткиИТиражМетражНаКлиенте(Заказ, Объект.ВидВырубки);

	Если Объект.ВидВырубки = 1 Тогда
		Объект.ЭтМЭР = ПолучитьЭтМЭРНаСервере();	
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.ШтампВырубной) И Объект.ВидВырубки = 0 И ВидРЦИндиго(Объект.РабочийЦентр) И ОмегаСНумератором() Тогда
		ЗаполнитьПараметрыПечатиИВырубкиОмегаСНумератором();
	КонецЕсли; 
	
КонецПроцедуры

