	|		ПО Лико_ВидыСекций.Ссылка = Лико_ВидыСекций1.Родитель
	|ГДЕ
	|	Лико_ВидыСекций.Ссылка <> ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Печать)
	|	И Лико_ВидыСекций1.Ссылка ЕСТЬ NULL";

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка")    
		
КонецФункции  

&НаКлиенте
Процедура ЦветаВидСекцииПриИзменении(Элемент)
	
	стр = Элементы.Цвета.ТекущиеДанные;	 
	//стр.ВидПечати = ПолучитьВидПечатиПеречисление(стр.ВидСекции); 
	
	Если стр.ВидСекции =  ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ГлубокаяПечать") Тогда
		Элементы.ЦветаГрамматура.Доступность = Ложь;
	Иначе
		Элементы.ЦветаГрамматура.Доступность = Истина;		
	КонецЕсли;
	
	реквизитыТЧ = ПолучитьМассивРеквизитовТЧ();
	
	для Каждого текРек из реквизитыТЧ цикл
		
		Если текРек = "ВидСекции"  ИЛИ  текРек = "КлючСтроки" ИЛИ  текРек = "НомерПроката" ИЛИ  текРек = "НомерВарианта" ИЛИ  текРек = "РабочийЦентр" ИЛИ  текРек = "НомерРаботы" Тогда 
			Продолжить; 
		ИначеЕсли 
			ЗначениеРеквизита(стр.ВидСекции,"Печать") И текРек = "ВидТМЦ" ИЛИ текРек = "ТипЦвета1"  ИЛИ  текРек = "Название" Тогда 
			стр.ТипЗаливка = стр.ТипЦвета1;
			Продолжить				
		Иначе
			стр[текРек] = неопределено;
		КонецЕсли;
		Если текРек = "Оснастка" И ЗначениеРеквизита(стр.ВидСекции,"Оснастка") Тогда
			Стр.ВидОснастка = стр[текРек];
		КонецЕсли;
	КонецЦикла; 
	
	стр.ВидПечати = ПолучитьВидПечатиПеречисление(стр.ВидСекции);
	
	ВидТМЦ = ЗначениеРеквизита(стр.ВидСекции, "ВидТМЦ");
	Если ЗначениеЗаполнено(ВидТМЦ) Тогда
		Если стр.ВидТМЦ <> ВидТМЦ Тогда 
			стр.ВидТМЦ = ВидТМЦ;
			стр.ТипЦвета1 = Неопределено;
			стр.Название = Неопределено;
			стр.ТипЗаливка =Неопределено;
		КонецЕсли;	
	КонецЕсли; 

	ВидЗаливки = ПолучитьВидЗаливкиПоУмолчанию(стр.ВидСекции, стр.ВидТМЦ);
	Если ЗначениеЗаполнено(ВидЗаливки) Тогда 

		стр.ВидЗаливки = ВидЗаливки;
		стр.ТипЗаливка = ВидЗаливки;  
	КонецЕсли;
	
	Если ЗначениеРеквизита(стр.ВидСекции,"Оснастка") И (НЕ ЗначениеЗаполнено(стр.ВидОснастка) ИЛИ ТипЗнч(стр.ВидОснастка) <> Тип("СправочникСсылка.Номенклатура")) Тогда
		стр.ВидОснастка = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");	
	ИначеЕсли ЗначениеРеквизита(стр.ВидСекции,"ИспользоватьВидТМЦ") И ТипЗнч(стр.ВидОснастка) <> Тип("СправочникСсылка.Лико_ВидыТМЦ") 
		ИЛИ (НЕ ЗначениеРеквизита(стр.ВидСекции,"Оснастка") И НЕ ЗначениеРеквизита(стр.ВидСекции,"ИспользоватьВидТМЦ")) Тогда 
		стр.ВидОснастка = Неопределено;
	КонецЕсли;	
	
	ЗаписатьЦветаВРаботы();   

КонецПроцедуры

&НаСервереБезКонтекста 
Функция ПолучитьВидЗаливкиПоУмолчанию(ВидСекции, ВидТМЦ) 
	
	
	СтрокаЗаливки = ВидСекции.ВидыЗаливки.найтиСтроки(новый структура("ВидТМЦ", ВидТМЦ));	
	Если СтрокаЗаливки.Количество() <> 0 Тогда 
		Возврат СтрокаЗаливки[0].ВидЗаливки 
	Иначе
		Возврат Неопределено
	КонецЕсли;
	
КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьВидПечатиПеречисление(ВидСекции) 
	
	ВидПечати = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ВидыСекций.ВидПечати.ВидПечати КАК ВидПечати
		|ИЗ
		|	Справочник.Лико_ВидыСекций КАК Лико_ВидыСекций
		|ГДЕ
		|	Лико_ВидыСекций.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ВидСекции);
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Выборка.Следующий();  
		
	ВидПечати = Выборка.ВидПечати;
	 
	Возврат ВидПечати 

	
	
КонецФункции

&НаКлиенте
Процедура ЦветаВидСекцииАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	ТекстПоиска = ВРег(Текст);
	
	Пока СтрНайти(ТекстПоиска, "  ") > 0 Цикл
		ТекстПоиска = СтрЗаменить(ТекстПоиска, "  ", " ");
	КонецЦикла;
	
	ТекстПоиска = СокрЛП(ТекстПоиска);
	
	ДлинаТекста = СтрДлина(ТекстПоиска);
	Если ДлинаТекста = 0 Тогда
		Возврат
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Шрифт = Новый Шрифт(,,Истина);
	Цвет = WebЦвета.Зеленый;
	
	ДанныеВыбора = Новый СписокЗначений;
	
	МассивПодстрок = СтрРазделить(ТекстПоиска, " ");
	
	СП = Новый СписокЗначений;
	СП.ЗагрузитьЗначения(ПолучитьВидыРаботЦвета());	
	
	//Для Каждого Стр Из Элемент.СписокВыбора Цикл 
	Для Каждого Стр Из СП Цикл
		
		Строка = Стр.Значение;
		СтрокаВРег = ВРег(Строка);
		
		ВхожденияНайдены = Истина;
		
		Для Каждого Подстрока Из МассивПодстрок Цикл
			Если Найти(СтрокаВРег, Подстрока) = 0 Тогда
				ВхожденияНайдены = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ВхожденияНайдены Тогда
			Продолжить
		КонецЕсли;
		
		ДлинаСтроки = СтрДлина(Строка);
		Массив = Новый Массив(ДлинаСтроки);
		
		Для Каждого Подстрока Из МассивПодстрок Цикл
			ДлинаПодстроки = СтрДлина(Подстрока);
			НачалоПоиска = 1;			
			Пока Истина Цикл
				ПозицияПодстроки = СтрНайти(СтрокаВРег, Подстрока, , НачалоПоиска);
				Если ПозицияПодстроки = 0 Тогда
					Прервать;
				КонецЕсли;
				
				НачалоПоиска = ПозицияПодстроки + ДлинаПодстроки;
				
				Для Сч = ПозицияПодстроки По НачалоПоиска - 1 Цикл
					Массив[Сч - 1] = Истина;
				КонецЦикла;				
				
				Если НачалоПоиска > ДлинаСтроки Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;			
		КонецЦикла;
		
		МассивСтрок = Новый Массив;		
		Для Сч = 0 По Массив.ВГраница() Цикл
			Символ = Сред(Строка, Сч + 1, 1);
			Если Массив[Сч] = Неопределено Тогда
				МассивСтрок.Добавить(Символ);
			Иначе
				МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Символ, Шрифт, Цвет));
			КонецЕсли;
		КонецЦикла;
		
		ДанныеВыбора.Добавить(Строка, Новый ФорматированнаяСтрока(МассивСтрок));
		
		Если ДанныеВыбора.Количество() = 50 Тогда
			Прервать
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЦветаТипЦвета1ПриИзменении(Элемент)
	
	стр = Элементы.Цвета.ТекущиеДанные; 
	
	Если стр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ЛаминацияСамоклейкой") тогда 		
		стр.ВидТМЦ = ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.ПустаяСсылка");  		
	Иначе 		
		стр.ВидТМЦ = ЗначениеРеквизита( стр.ТипЦвета1, "ВидТМЦ") ;     
	КонецЕсли;  
	
	Если стр.ТипЦвета1 = ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.ПустаяСсылка") Тогда
		стр.ТипЗаливка = Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(стр.ВидТМЦ) И ТипЗнч(стр.ВидОснастка) = Тип("СправочникСсылка.Лико_ВидыТМЦ") Тогда
		стр.ВидОснастка = ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.ПустаяСсылка");  		
	КонецЕсли;

