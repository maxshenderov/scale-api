&НаСервере
Функция ОмегаСНумератором()
	
	текНайденныеСтрокиНумератор = Объект.Цвета.НайтиСтроки(Новый Структура("ВидСекции",Справочники.Лико_ВидыСекций.Нумератор));
	Для Каждого ТекСтрока Из текНайденныеСтрокиНумератор Цикл
		Если ВидРЦОмега(ТекСтрока.РабочийЦентр) Тогда
        	Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВидРЦОмега(РабочийЦентр)
	
	ВидРЦентра = ЗначениеРеквизита(РабочийЦентр, "ВидРабочегоЦентра");     	
	
	Возврат ВидРЦентра = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.Omega") 
	
КонецФункции 

&НаКлиенте
Процедура ЗаполнитьПараметрыПечатиИВырубкиОмегаСНумератором(иЭтМЭР = Неопределено) 
	
	Объект.ЭтМЭР = ?(ЗначениеЗаполнено(иЭтМЭР),иЭтМЭР,0.4826 / Цел(0.4826/(Объект.ШиринаЭтикетки / 1000 + 0.0027)));
	Если ЗначениеРеквизита(Объект.РабочийЦентр,"ВидРабочегоЦентра") = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.Indigo") Тогда
		Объект.ЭтикетокНаЛистеИндиго = Объект.КоличествоЭтПоДлинеПечатиИндиго * Объект.РучьиПечатиИндиго;
		Объект.ДлинаПечатиИндиго = Объект.КоличествоЭтПоДлинеПечатиИндиго * Объект.ЭтМЭР
	ИначеЕсли Объект.Ручьи <> 0 Тогда
		Объект.ЭтикетокНаЛистеПечати = Объект.ЭтикетокНаЛисте * Объект.РучьиПечати/Объект.Ручьи;
	КонецЕсли;
	Объект.ШагПечати = Объект.ЭтикетокНаЛисте / Объект.Ручьи * Объект.ЭтМЭР;
	Объект.ПлощадьКлише = (Объект.ШагПечати*100 + 2)*(ЗначениеРеквизита(Объект.Нарезка,"Размер")/10 + 2);
	РасчитатьТиражМетраж(Объект.ВидВырубки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыПечати(Заказ, текВидВырубки = Неопределено, СпецификацияСсылка = Неопределено, ПересчетПараметров = Ложь, ПересчитатьНарезку = Истина) Экспорт // --> Начало Лико Митюшин МФМ 18.05.2021

	Если текВидВырубки = 0 ИЛИ (РазрешеноМенятьПараметрыШтампа И ОмегаСНумератором()) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПересчетПараметров Тогда
		Лико_ТиражМетраж.ОчиститьНеИспользуемыПараметрыШтампа(Заказ, текВидВырубки)
	КонецЕсли;
	
	ДлинаСПрипуском = Неопределено;
	КоличествоПоДлинеРапорта = Неопределено;
	Если НЕ (текВидВырубки = 5 И ПересчетПараметров = Ложь ИЛИ текВидВырубки = 18 ИЛИ текВидВырубки = 19) Тогда
		Объект.ДлинаПечати 				= Лико_ТиражМетраж.ПолучитьДлинуПечати(Объект, Объект.ВидВырубки);
	КонецЕсли;
	Если текВидВырубки = 18 ИЛИ текВидВырубки = 19 Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ДопускМинус) И НЕ ЗначениеЗаполнено(Объект.ДопускПлюс) Тогда
			ВариантыДопусков = Неопределено;		
		КонецЕсли;
		ЗаполнитьРаппорт();
		Если ПересчитатьНарезку Тогда
			Если текВидВырубки = 18 Тогда
				РасчетнаяНарезкаБезОкругления = (Объект.ДлинаЭтикетки/1000) * Объект.РучьиПечати + 0.02;
			ИначеЕсли текВидВырубки = 19 Тогда
				РасчетнаяНарезкаБезОкругления = (Объект.ШиринаЭтикетки/1000) * Объект.РучьиПечати + 0.025;
			КонецЕсли;
			РасчетнаяНарезка = ЗарплатаКадрыКлиентСервер.Округлить(Цел(РасчетнаяНарезкаБезОкругления*1000), 5,ПредопределенноеЗначение("Перечисление.ПравилаОкругленияПриРасчетеЗарплаты.ВБольшуюСторону"));
			Объект.Нарезка = Справочники.ЯССМ_Нарезки.НайтиПоНаименованию(РасчетнаяНарезка + 5);
			ЗаполнитьРаппорт();
		КонецЕсли;
		Если текВидВырубки = 18 Тогда
			Объект.КоличествоЭтПоДлинеПечати = Окр(Объект.ДлинаПечати/(Объект.ШиринаЭтикетки/1000)); 
		ИначеЕсли текВидВырубки = 19 Тогда
			Объект.КоличествоЭтПоДлинеПечати = Окр(Объект.ДлинаПечати/(Объект.ДлинаЭтикетки/1000)); 
		КонецЕсли;
		Объект.ПлощадьКлише = Лико_ТиражМетраж.ПолучитьПлощадьКлише(Объект, текВидВырубки);
	КонецЕсли;
	Объект.ЭтикетокНаЛистеПечати = ПолучитьЭтикетокНаЛистеПечатиНаСервере();
	
КонецПроцедуры // <-- Конец Лико Митюшин МФМ 18.05.2021

&НаСервере
Процедура ЗаполнитьРаппорт()
	//Если Объект.РаппортМеняли Тогда
	//	Возврат;	
	//КонецЕсли;
	РаппортДлинаПечати = Лико_ТиражМетраж.ПолучитьДлинуПечати(Объект, Объект.ВидВырубки);
	Если РаппортДлинаПечати <> Неопределено Тогда
		Объект.Раппорт = РаппортДлинаПечати.Раппорт;
		Объект.ДлинаПечати = РаппортДлинаПечати.ДлинаПечати;
	Иначе
		Объект.Раппорт = Неопределено;
		Объект.ДлинаПечати = 0;
		Объект.КоличествоЭтПоДлинеПечати = 0;
		Объект.ЭтикетокНаЛистеПечати = 0;
		Объект.ПлощадьКлише = 0; 
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЭтикетокНаЛистеПечатиНаСервере(ВидВырубкиДляРасчета = Неопределено)
	Если ВидВырубкиДляРасчета = Неопределено Тогда
		Возврат Лико_ТиражМетраж.ПолучитьЭтикетокНаЛистеПечати(Объект, Объект.ВидВырубки);
	Иначе
		Возврат Лико_ТиражМетраж.ПолучитьЭтикетокНаЛистеПечати(Объект, ВидВырубкиДляРасчета);
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ШиринаЭтикеткиПриИзменении(Элемент)
	
	Если Объект.ВидВырубки = 5 ИЛИ (Объект.ВидВырубки = 6 И Объект.ТипЗаказа <> ПредопределенноеЗначение("Перечисление.Лико_ТипыЗаказов.Термоусадка"))  Тогда
		Заказ = Объект;
		ЗаполнитьЭтМЭР();
		ЭтикеткиИТиражМетражНаКлиенте(Заказ, Объект.ВидВырубки);
		ЗаполнитьДлинаПечатиНаСервере();
	ИначеЕсли Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда	
		Заказ = Объект;
		ЗаполнитьПараметрыПечати(Заказ, Объект.ВидВырубки);	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ШтампВырубной) И Объект.ВидВырубки = 0 И ОмегаСНумератором() Тогда
		ЗаполнитьПараметрыПечатиИВырубкиОмегаСНумератором();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзмененитьДоступностиПолейНаСервере(текВидВырубки = 0) 
 	//Изменение доступности полей, если Добавлен в Массив значит Только просмотр.
	//МассивЭлементов = ЗаполнениеМассиваЭллементов(текВидВырубки);
	
	текЭлемент = Элементы.ЭтикетокНаЛистеПечати;
	Если Не ЗначениеЗаполнено(Объект.ШтампВырубной) Тогда
		Если текВидВырубки = 5 Тогда
			текЭлемент.ОтображениеПредупрежденияПриРедактировании 	= ОтображениеПредупрежденияПриРедактировании.Отображать;
			текЭлемент.ПредупреждениеПриРедактировании				= "Изменение данного параметра может повлиять на расчеты!";
		Иначе 
			текЭлемент.ОтображениеПредупрежденияПриРедактировании 	= ОтображениеПредупрежденияПриРедактировании.НеОтображать;	
		КонецЕсли;
	ИначеЕсли текЭлемент.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать Тогда 
		текЭлемент.ОтображениеПредупрежденияПриРедактировании 	= ОтображениеПредупрежденияПриРедактировании.НеОтображать;	
	КонецЕсли;
	
	
	//ИзменитьДоступностьОбъектаДляВидаВырубки(МассивЭлементов);
	ВыделениеЦветомПараметровВырубкиВЗависимостиОтТехнологии(текВидВырубки);
	ИзменитьДоступностьОбъектаПоЦвету();
	СделатьПараметрыШтампаНадписьюЕслиТолькоПросмотр();
КонецПроцедуры 

&НаСервере
Процедура ВыделениеЦветомПараметровВырубкиВЗависимостиОтТехнологии(ВидВырубки)
	
	Синий 		= WebЦвета.ГолубойСоСтальнымОттенком;
	Желтый 		= WebЦвета.Лимонный;
	Зеленый 	= WebЦвета.СветлоЗеленый;
	Коричневый 	= WebЦвета.Золотистый;
	НейтральноЗеленый 	= WebЦвета.НейтральноЗеленый;	
	ЦветАвто 	= Новый Цвет();

	//Если нет Вырубного штампа, но есть вид работ вырубка – доступны все параметры печати/вырубки
	Если НЕ ЗначениеЗаполнено(Объект.ШтампВырубной) ИЛИ РазрешеноМенятьПараметрыШтампа Тогда 
		текПараметрыОтбора = Новый Структура;
		текПараметрыОтбора.Вставить("ВидСекции", Справочники.Лико_ВидыСекций.Вырубка);	
		текНайденныеСтроки = Объект.Цвета.НайтиСтроки(текПараметрыОтбора);

		Если текНайденныеСтроки.Количество() <> 0 Тогда
			ВыделениеЦветомГруппаШтампа(Зеленый, Зеленый, Зеленый, Зеленый);
			ВыделениеЦветомГруппаПараметрыВырубки(Зеленый, Зеленый, Зеленый, Зеленый); 
			ВыделениеЦветомГруппаПараметрыПечати(Зеленый, Зеленый, Зеленый, Зеленый, Зеленый, Зеленый); 
			ВыделениеЦветомГруппаПараметрыПечатиИндиго(Зеленый, Зеленый, Зеленый, Зеленый, Зеленый, Зеленый);
			Если ВидВырубки = 18 ИЛИ ВидВырубки = 19 Тогда
				ВыделениеЦветомГруппаПараметрыПечатиОмет(Зеленый, Зеленый, Зеленый, Зеленый);
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если ВидВырубки = 1 Тогда		   		
		ВыделениеЦветомГруппаШтампа(Синий, Синий, Коричневый, Зеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечати(Синий, Зеленый, Коричневый, Коричневый, ЦветАвто, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 2 Тогда
		ВыделениеЦветомГруппаШтампа(Синий, Синий, Коричневый, Зеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, Синий); 
		ВыделениеЦветомГруппаПараметрыПечати(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(Зеленый, Зеленый, Коричневый, Коричневый, Зеленый,  ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 3 Тогда
		ВыделениеЦветомГруппаШтампа(Синий, Синий, Коричневый, Зеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, Синий); 
		ВыделениеЦветомГруппаПараметрыПечати(Желтый, Зеленый, Коричневый, Коричневый, Зеленый, ЦветАвто);  
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 4 Тогда
		ВыделениеЦветомГруппаШтампа(Синий, Синий, ЦветАвто, Зеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, Синий); 
		ВыделениеЦветомГруппаПараметрыПечати(Коричневый, Зеленый, Коричневый, Зеленый, ЦветАвто, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 5 Тогда		
		ВыделениеЦветомГруппаШтампа(Желтый, Желтый, Коричневый, Желтый);
		ВыделениеЦветомГруппаПараметрыВырубки(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечати(Коричневый, Желтый, Коричневый, Желтый, ЦветАвто, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 6 Тогда		
		ВыделениеЦветомГруппаШтампа(Желтый, Желтый, ?(Лико_ТиражМетраж.ЭтоТермоусадка(Объект), Коричневый, Зеленый), Желтый);
		ВыделениеЦветомГруппаПараметрыВырубки(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечати(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(Зеленый, Желтый, Коричневый, Коричневый, Зеленый, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 7 Тогда	
		ВыделениеЦветомГруппаШтампа(Синий, Синий, Коричневый, Зеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, Синий); 
		ВыделениеЦветомГруппаПараметрыПечати(Синий, Зеленый, Зеленый, Синий, ЦветАвто, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 8 Тогда
		ВыделениеЦветомГруппаШтампа(Синий, Синий, Коричневый, Зеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, Синий); 
		ВыделениеЦветомГруппаПараметрыПечати(ЦветАвто, Зеленый, Зеленый, ЦветАвто, ЦветАвто, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 9 Тогда
		ВыделениеЦветомГруппаШтампа(Синий, Синий, Коричневый, Зеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, Синий); 
		ВыделениеЦветомГруппаПараметрыПечати(Желтый, Зеленый, Коричневый, Коричневый, Зеленый, ЦветАвто);  
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(Зеленый, Зеленый, Коричневый, Коричневый, Зеленый, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 10 Тогда
		ВыделениеЦветомГруппаШтампа(Синий, Синий, ЦветАвто, Зеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Зеленый, Синий); 
		ВыделениеЦветомГруппаПараметрыПечати(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(Зеленый, Зеленый, Коричневый, Зеленый, ЦветАвто,  Зеленый);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 11 Тогда		
		ВыделениеЦветомГруппаШтампа(Синий, Синий, Коричневый, Зеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, Синий); 
		ВыделениеЦветомГруппаПараметрыПечати(Коричневый, Зеленый, Коричневый, Желтый, Зеленый, ЦветАвто);  
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 12 Тогда
		ВыделениеЦветомГруппаШтампа(Синий, Синий, Коричневый, Зеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, Синий); 
		ВыделениеЦветомГруппаПараметрыПечати(Коричневый, Зеленый, Коричневый, Желтый, Зеленый, ЦветАвто);  
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(Зеленый, Зеленый, Коричневый, Коричневый, Зеленый, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 13 Тогда
		ВыделениеЦветомГруппаШтампа(Синий, Синий, Коричневый, Зеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечати(Синий, Коричневый, Коричневый, Коричневый, ЦветАвто, Желтый); 
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 14 Тогда
		ВыделениеЦветомГруппаШтампа(Синий, Синий, Коричневый, Зеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, Синий); 
		ВыделениеЦветомГруппаПараметрыПечати(ЦветАвто, Зеленый, Коричневый, Желтый, Зеленый, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	ИначеЕсли ВидВырубки = 15 Тогда
		ВыделениеЦветомГруппаШтампа(Синий, Синий, Коричневый, Зеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, Синий); 
		ВыделениеЦветомГруппаПараметрыПечати(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	// <-- Начало Лико Яцун С. В. 13.06.2023	
	//ИначеЕсли ВидВырубки = 16 Тогда
	//	ВыделениеЦветомГруппаШтампа(Синий, Синий, Коричневый, Зеленый);
	//	ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, Коричневый); 
	//	ВыделениеЦветомГруппаПараметрыПечати(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	//	ВыделениеЦветомГруппаПараметрыПечатиИндиго(Зеленый, Зеленый, Коричневый, Коричневый, Зеленый,  ЦветАвто);
	//	ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	//ИначеЕсли ВидВырубки = 17 Тогда
	//	ВыделениеЦветомГруппаШтампа(Синий, Синий, НейтральноЗеленый, Зеленый);
	//	ВыделениеЦветомГруппаПараметрыВырубки(Желтый, Синий, Синий, Коричневый); 
	//	ВыделениеЦветомГруппаПараметрыПечати(ЦветАвто, Зеленый, Зеленый, ЦветАвто, ЦветАвто, ЦветАвто); 
	//	ВыделениеЦветомГруппаПараметрыПечатиИндиго(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	//	ВыделениеЦветомГруппаПараметрыПечатиОмет(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
	// <-- Конец Лико Яцун С. В. 13.06.2023	
	ИначеЕсли ВидВырубки = 18 Тогда		
		ВыделениеЦветомГруппаШтампа(Желтый, Желтый, ЦветАвто, НейтральноЗеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечати(ЦветАвто, Желтый, Коричневый, Коричневый, Коричневый, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(Коричневый, Коричневый, Коричневый, Желтый);
	ИначеЕсли ВидВырубки = 19 Тогда		
		ВыделениеЦветомГруппаШтампа(Желтый, Желтый, ЦветАвто, НейтральноЗеленый);
		ВыделениеЦветомГруппаПараметрыВырубки(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечати(ЦветАвто, Желтый, Коричневый, Коричневый, Коричневый, ЦветАвто); 
		ВыделениеЦветомГруппаПараметрыПечатиИндиго(ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто, ЦветАвто);
		ВыделениеЦветомГруппаПараметрыПечатиОмет(Коричневый, Коричневый, Коричневый, Желтый);
	КонецЕсли;		
	
	Если ВидВырубки = 6 Тогда 
		Элементы.ДлинаПечатиВидимостьИндиго.Видимость = Истина;
	ИначеЕсли Элементы.ДлинаПечатиВидимостьИндиго.Видимость Тогда
		Элементы.ДлинаПечатиВидимостьИндиго.Видимость = Ложь;	
	КонецЕсли;
	
	Если (ВидВырубки = 3 ИЛИ ВидВырубки = 8 ИЛИ ВидВырубки = 11 ИЛИ ВидВырубки = 12) И 
		Объект.Ручьи = Объект.ЭтикетокНаЛисте Тогда 
		Элементы.ШагПечати.ЦветФона = Зеленый;
	КонецЕсли;
КонецПроцедуры  

&НаСервере
Процедура ВыделениеЦветомГруппаШтампа(пШиринаЭтикетки, пДлинаЭтикетки, пЭтМЭР, пНарезка)
	Элементы.ШиринаЭтикетки.ЦветФона	= пШиринаЭтикетки;
	Элементы.ДлинаЭтикетки.ЦветФона		= пДлинаЭтикетки;
	Элементы.ЭтМЭР.ЦветФона				= пЭтМЭР;
	Элементы.Нарезка.ЦветФона			= пНарезка;
КонецПроцедуры	

&НаСервере
Процедура ВыделениеЦветомГруппаПараметрыВырубки(пШтампВырубнойАртикул, пРучьи, пЭтикетокНаЛисте, пШагПечати)
	Элементы.ШтампВырубнойАртикул.ЦветФона	= пШтампВырубнойАртикул;
	Элементы.Ручьи.ЦветФона					= пРучьи;
	Элементы.ЭтикетокНаЛисте.ЦветФона		= пЭтикетокНаЛисте;
	Элементы.ШагПечати.ЦветФона				= пШагПечати;
КонецПроцедуры

&НаСервере
Процедура ВыделениеЦветомГруппаПараметрыПечати(пZ, пРучьиПечати, пЭтикетокНаЛистеПечати, пДлинаПечати, пКоличествоЭтПоДлинеПечати, пКоличествоЛистовКнижки)
	Элементы.Z.ЦветФона							= пZ;
	Элементы.РучьиПечати.ЦветФона				= пРучьиПечати;
	Элементы.ЭтикетокНаЛистеПечати.ЦветФона		= пЭтикетокНаЛистеПечати;
	Элементы.ДлинаПечати.ЦветФона				= пДлинаПечати;
	Элементы.КоличествоЭтПоДлинеПечати.ЦветФона	= пКоличествоЭтПоДлинеПечати;
	Элементы.КоличествоЛистовКнижки.ЦветФона	= пКоличествоЛистовКнижки;	
КонецПроцедуры

&НаСервере
Процедура ВыделениеЦветомГруппаПараметрыПечатиИндиго(пКоличествоКликов, пРучьиПечати, пЭтикетокНаЛисте, пДлинаПечати, пКоличествоЭтПоДлинеПечати, пКоличествоШтамповПоДлинеПечати)
	Элементы.КоличествоКликов.ЦветФона						= пКоличествоКликов;
	Элементы.РучьиПечатиИндиго.ЦветФона						= пРучьиПечати;
	Элементы.ЭтикетокНаЛистеИндиго.ЦветФона					= пЭтикетокНаЛисте;
	Элементы.ДлинаПечатиИндиго.ЦветФона						= пДлинаПечати;
	Элементы.КоличествоЭтПоДлинеПечатиИндиго.ЦветФона		= пКоличествоЭтПоДлинеПечати;
	Элементы.КоличествоШтамповПоДлинеПечатиИндиго.ЦветФона	= пКоличествоШтамповПоДлинеПечати;		
КонецПроцедуры

&НаСервере
Процедура ВыделениеЦветомГруппаПараметрыПечатиОмет(пРаппорт, пДопускМинус, пДопускПлюс, пВариантыДопусков) // <-- Начало Лико Яцун С. В. 05.07.2023
	Элементы.Раппорт.ЦветФона		= пРаппорт;
	Элементы.ДопускМинус.ЦветФона	= пДопускМинус;
	Элементы.ДопускПлюс.ЦветФона	= пДопускПлюс;
	Элементы.ВариантыДопусков.ЦветФона	= пВариантыДопусков;
КонецПроцедуры // <-- Конец Лико Яцун С. В. 05.07.2023

&НаСервере
Процедура ИзменитьДоступностьОбъектаПоЦвету()
	Если Объект.ВидВырубки = 0 Тогда
		Возврат;
	КонецЕсли;
	//Синий = WebЦвета.ГолубойСоСтальнымОттенком;
	Желтый = WebЦвета.Лимонный;
	Зеленый = WebЦвета.СветлоЗеленый;
	НейтральноЗеленый = WebЦвета.НейтральноЗеленый;
	//Коричневый = WebЦвета.Золотистый;
	ЦветАвто = Новый Цвет();
	
	Для Каждого элМассива Из МассивПараметровШтампа() Цикл
		Если элМассива.ЦветФона = Желтый ИЛИ элМассива.ЦветФона = Зеленый ИЛИ элМассива.ЦветФона = НейтральноЗеленый Тогда
			ЭлМассива.ТолькоПросмотр = Ложь;
		Иначе
			ЭлМассива.ТолькоПросмотр = Истина;
			// --> Начало Лико Митюшин МФМ 23.07.2021
			Если элМассива.ЦветФона = ЦветАвто Тогда
				Если элМассива = Элементы.ШтампВырубнойАртикул Тогда 
					Продолжить;
				КонецЕсли;
				ТекРеквизит = СтрЗаменить(элМассива.ПутьКДанным, "Объект.", "");
				Если ЗначениеЗаполнено(Объект[ТекРеквизит]) Тогда
					Если ТекРеквизит =  "ДлинаПечати" И Элементы.ДлинаПечатиВидимостьИндиго.Видимость Тогда 
						Продолжить;
					КонецЕсли;
					Если ТекРеквизит =  "Z" И Объект.РабочийЦентр.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Weigang Тогда 
						Продолжить;
					КонецЕсли;
					Объект[ТекРеквизит] = Неопределено;
				КонецЕсли;
			КонецЕсли;
			// <-- Конец Лико Митюшин МФМ 23.07.2021
		КонецЕсли;
	КонецЦикла;
	
	//Если Объект.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПолныйПовтор ИЛИ Объект.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПовторСИзменением Тогда
	//	Элементы.ДлинаЭтикетки.ТолькоПросмотр = Истина;
	//	Элементы.ШиринаЭтикетки.ТолькоПросмотр = Истина;
	//КонецЕсли;
	
	ВидимостьГрупппараметровПечати(ЦветАвто, Элементы.ГруппаПараметрыВырубки);
	ВидимостьГрупппараметровПечати(ЦветАвто, Элементы.ГруппаПараметрыПечати);
	ВидимостьГрупппараметровПечати(ЦветАвто, Элементы.ГруппаПараметрыПечатиИндиго);
	ВидимостьГрупппараметровПечати(ЦветАвто, Элементы.ГруппаПараметрыПечатиОмет);

КонецПроцедуры

&НаСервере
Функция МассивПараметровШтампа()
	МассивЭлементовПараметровШтампа = Новый Массив;
	МассивЭлементовПараметровШтампа.Добавить(Элементы.ШтампВырубнойАртикул);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.ДлинаЭтикетки);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.ШиринаЭтикетки);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.Нарезка);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.Z);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.Ручьи);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.РучьиПечати);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.ЭтикетокНаЛисте);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.ЭтикетокНаЛистеПечати);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.ШагПечати);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.ДлинаПечати);
	
	МассивЭлементовПараметровШтампа.Добавить(Элементы.ДлинаПечатиИндиго);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.ЭтикетокНаЛистеИндиго);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.ЭтМЭР);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.ЭтикетокНаЛистеИндиго);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.КоличествоЭтПоДлинеПечати);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.КоличествоЭтПоДлинеПечатиИндиго);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.КоличествоШтамповПоДлинеПечатиИндиго);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.КоличествоЛистовКнижки);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.РучьиПечатиИндиго);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.Раппорт);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.ДопускМинус);
	МассивЭлементовПараметровШтампа.Добавить(Элементы.ДопускПлюс);
	Если Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда
		МассивЭлементовПараметровШтампа.Добавить(Элементы.ВариантыДопусков);
	КонецЕсли;	
	Возврат МассивЭлементовПараметровШтампа;	
	
КонецФункции

&НаСервере
Процедура ВидимостьГрупппараметровПечати(ЦветАвто, текГруппа)
	ЭтоВсеБелые = Истина;
	
	Для Каждого текЭлемент из текГруппа.ПодчиненныеЭлементы Цикл
		Если текЭлемент.ЦветФона <> ЦветАвто Тогда
			ЭтоВсеБелые = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если текГруппа.Видимость <> (Не ЭтоВсеБелые) Тогда
		текГруппа.Видимость = (Не ЭтоВсеБелые);
	КонецЕсли;
КонецПроцедуры	    

&НаСервере
Процедура СделатьПараметрыШтампаНадписьюЕслиТолькоПросмотр()

	Для Каждого ЭлМассива Из МассивПараметровШтампа() Цикл
		ТекШирина = ЭлМассива.Ширина; 
		ТекЦвет = ЭлМассива.ЦветФона;
		Если ЭлМассива.ТолькоПросмотр И НЕ РазрешеноМенятьПараметрыШтампа Тогда
			ЭлМассива.Вид = ВидПоляФормы.ПолеНадписи;
			ЭлМассива.Рамка 	= Новый Рамка(ТипРамкиЭлементаУправления.Одинарная);
			ЭлМассива.Ширина 	= ?(ЭлМассива = Элементы.Z, 13, ТекШирина);
			ЭлМассива.ЦветФона 	= ТекЦвет;
		Иначе
			Если ЭлМассива.Вид <> ВидПоляФормы.ПолеВвода Тогда
				ЭлМассива.Вид = ВидПоляФормы.ПолеВвода;
				Если РазрешеноМенятьПараметрыШтампа И ЭлМассива.ТолькоПросмотр Тогда 
					ЭлМассива.ТолькоПросмотр = Ложь;
				КонецЕсли;
				ЭлМассива.Ширина 	= ?(ЭлМассива = Элементы.Z, 9, ТекШирина);
				ЭлМассива.ЦветФона 	= ТекЦвет;
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦветаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Текстр = Элементы.Цвета.ТекущиеДанные;	
	Если ЗначениеЗаполнено(Текстр.Материал) Тогда 
 		Текстр.КодМатериала = ЗначениеРеквизита(Текстр.Материал, "Код");
	КонецЕсли;
	
	СпецификацияОбъект = Объект;
	ПроверитьВырубнойШтамп();
	ПроставитьВидВырубки(СпецификацияОбъект,,Истина);
	ИзмененитьДоступностиПолейНаСервере(СпецификацияОбъект.ВидВырубки);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВырубнойШтамп()
	Если ЗначениеЗаполнено(Объект.ШтампВырубной) Тогда 
		строки = Объект.Цвета.НайтиСтроки(Новый Структура("Оснастка", Объект.ШтампВырубной));
		Если строки.количество() = 0 Тогда 
			Объект.ШтампВырубной = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
			//ОчиститьВсеПараметрыШтампа();		
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЦветаПослеУдаления(Элемент)
	
	СпецификацияОбъект = Объект;
	ПроверитьВырубнойШтамп();
	ПроставитьВидВырубки(СпецификацияОбъект,,Истина);
	ИзмененитьДоступностиПолейНаСервере(СпецификацияОбъект.ВидВырубки);

	ЗаписатьЦветаВРаботы();

КонецПроцедуры

&НаКлиенте
Процедура ДлинаЭтикеткиПриИзменении(Элемент)
	Если Объект.ВидВырубки = 5 ИЛИ (Объект.ВидВырубки = 6 И Объект.ТипЗаказа = ПредопределенноеЗначение("Перечисление.Лико_ТипыЗаказов.Термоусадка")) Тогда
		ЗаполнитьЭтМЭР();
		Заказ = Объект;
		ЭтикеткиИТиражМетражНаКлиенте(Заказ, Объект.ВидВырубки);
		ЗаполнитьДлинаПечатиНаСервере();
	ИначеЕсли Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда	
		Заказ = Объект;
		ЗаполнитьПараметрыПечати(Заказ, Объект.ВидВырубки);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЭтМЭРПриИзменении(Элемент)
	текВидВырубки = Объект.ВидВырубки;
	Если текВидВырубки = 6 Тогда
		ЗаполнитьДлинуПечатиИндиго();		
	КонецЕсли;	
	Если текВидВырубки = 2 ИЛИ текВидВырубки = 6 ИЛИ текВидВырубки = 9 ИЛИ текВидВырубки = 12 Тогда
		текКоличествоЭтПоДлинеПечатиИндиго = ПолучитьЭтикетокПоДлинеПечатиИндигоНаСервере(текВидВырубки);
		Если текКоличествоЭтПоДлинеПечатиИндиго <> Объект.КоличествоЭтПоДлинеПечатиИндиго Тогда 
			Объект.КоличествоЭтПоДлинеПечатиИндиго = текКоличествоЭтПоДлинеПечатиИндиго;	
		КонецЕсли;
	КонецЕсли; 
	Если НЕ ЗначениеЗаполнено(Объект.ШтампВырубной) И текВидВырубки = 0 И ОмегаСНумератором() Тогда
		ЗаполнитьПараметрыПечатиИВырубкиОмегаСНумератором(Объект.ЭтМЭР);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДопускМинусПриИзменении(Элемент)
	Если Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда	
		Заказ = Объект;
		ЗаполнитьПараметрыПечати(Заказ, Объект.ВидВырубки);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДопускПлюсПриИзменении(Элемент)
	Если Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда	
		Заказ = Объект;
		ЗаполнитьПараметрыПечати(Заказ, Объект.ВидВырубки);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВариантыДопусковПриИзменении(Элемент)
	
	Если ВариантыДопусков <> 0 Тогда 
		Если ВариантыДопусков = 1 Тогда
			Объект.ДопускМинус = 1;
			Объект.ДопускПлюс = 0;
		ИначеЕсли ВариантыДопусков = 2 Тогда
			Объект.ДопускМинус = 0.5;
			Объект.ДопускПлюс = 0.5;
		ИначеЕсли ВариантыДопусков = 3 Тогда
			Объект.ДопускМинус = 0;
			Объект.ДопускПлюс = 1;
		КонецЕсли;
	Иначе	
		Объект.ДопускМинус = 0;
		Объект.ДопускПлюс = 0;
	КонецЕсли;
	Если Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда	
		Заказ = Объект;
		ЗаполнитьПараметрыПечати(Заказ, Объект.ВидВырубки);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаппортПриИзменении(Элемент)
	
	текВидВырубки = ?(Объект.ТипЗаказа = ПредопределенноеЗначение("Перечисление.Лико_ТипыЗаказов.Термоусадка"),19,18);
	
	Объект.ДлинаПечати = ЗначениеРеквизита(Объект.Раппорт, "ДлинаПечати") / 1000;
	Если текВидВырубки = 19 Тогда
		Объект.КоличествоЭтПоДлинеПечати = Окр(Объект.ДлинаПечати/(Объект.ДлинаЭтикетки/1000));
	ИначеЕсли текВидВырубки = 18 Тогда
		Объект.КоличествоЭтПоДлинеПечати = Окр(Объект.ДлинаПечати/(Объект.ШиринаЭтикетки/1000)); 
	КонецЕсли;

	ЗаполнитьПлощадьКлишеНаСервере(текВидВырубки);
	Объект.ЭтикетокНаЛистеПечати = ПолучитьЭтикетокНаЛистеПечатиНаСервере(текВидВырубки);
	Объект.РаппортМеняли = Истина;

КонецПроцедуры

