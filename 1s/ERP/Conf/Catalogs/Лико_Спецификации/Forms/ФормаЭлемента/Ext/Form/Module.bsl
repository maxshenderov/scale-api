
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если РольДоступна("Лико_ИзменениеПараметровВырубкиПечати") ИЛИ РольДоступна("ПолныеПрава") И ЭтаФорма.Элементы.Найти("ГруппаШтамп1") <> Неопределено Тогда 
		Команда = ЭтаФорма.Команды.Добавить("Лико_РедактироватьПараметрыШтампов");
		Команда.Заголовок = "Редактировать параметры штампов";
		Команда.Действие = "Лико_РедактироватьПараметрыШтампов";

		Элемент = ЭтаФорма.Элементы.Вставить("Лико_РедактироватьПараметрыШтампов", Тип("ДекорацияФормы"), ЭтаФорма.Элементы.ГруппаПараметрыШтампа,ЭтаФорма.Элементы.ГруппаШтамп1);
		Элемент.Вид = ВидДекорацииФормы.Надпись;
		Элемент.Гиперссылка = Истина;
		Элемент.Заголовок = "Редактировать параметры";
		Элемент.Шрифт = Новый Шрифт(,11);
		Элемент.ЦветТекста = WebЦвета.ТемноСерый;
		Элемент.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;  
		Элемент.УстановитьДействие("Нажатие", "Лико_РедактироватьПараметрыШтампов");
		//Элемент.ИмяКоманды = "Лико_РедактироватьПараметрыШтампов";
	КонецЕсли;
	
	Если НЕ РольДоступна("ПолныеПрава") Тогда 
		Элементы.ВидВырубки.Видимость = Ложь;
	КонецЕсли;	
	
	УстановитьУсловноеОформление();
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Объект.Менеджер = Пользователи.ТекущийПользователь();
		Объект.Дата = ТекущаяДата();                                                                                                                
	КонецЕсли;	
	НомерВарианта = 1;
	//Элементы.Цвета.ОтборСтрок = Новый ФиксированнаяСтруктура("НомерВарианта", НомерВарианта); 

	Для каждого стр из Объект.Товары Цикл
		Если ЗначениеЗаполнено(стр.цена) И ЗначениеЗаполнено(стр.ставкаНДС) Тогда 
			ТекПроцентНДС = стр.СтавкаНДС.Ставка;
			стр.ЦенаБезНДС = стр.цена/(1+ТекПроцентНДС/100);
		КонецЕсли;	
	КонецЦикла;	
	
	ЗаполнитьЦенуБезНДС();
	
	ПоказатьКодМатериала();
	Для каждого стр из Объект.ВидыРабот Цикл
		Если ЗначениеЗаполнено(стр.материал) Тогда 
			стр.кодматериала = стр.материал.Код;
		КонецЕсли;
		Если ЗначениеЗаполнено(стр.клей) Тогда 
			стр.кодКлея = стр.клей.Код;
		КонецЕсли;	
	КонецЦикла;
	
	Объект.ТипРасчета = 2;
	
	// --> Начало Лико Субботин 23.05.2023 	 
	СоответствиеВС = Новый Соответствие;
	Для каждого стр из Объект.Цвета Цикл

		
		стрРаботы = Объект.ВидыРабот.найтистроки(новый структура("НомерПроката", стр.НомерПроката)); 
		Если стрРаботы.Количество() > 0 Тогда
			стр.Рабочийцентр = стрРаботы[0].РабочийЦентр;
		КонецЕсли;
		ОтображатьВТЧРаботы = ЗначениеРеквизита(стр.ВидСекции, "ОтображатьВТЧРаботы") ;
		Если  ОтображатьВТЧРаботы <> Неопределено Тогда
			Если ОтображатьВТЧРаботы  Тогда 
				Если СоответствиеВС.Получить(стр.ВидСекции) = Неопределено Тогда 
					стр.НомерРаботы = 1;
					СоответствиеНомерПроката = Новый Соответствие; 
					СоответствиеНомерПроката.Вставить(стр.номерпроката, 1);
					СоответствиеВС.Вставить(стр.ВидСекции,СоответствиеНомерПроката);
				Иначе 
					Если СоответствиеВС[стр.ВидСекции].Получить(стр.НомерПроката)= Неопределено Тогда 
						стр.НомерРаботы = 1; 
						СоответствиеНомерПроката = Новый Соответствие;
						СоответствиеНомерПроката.Вставить(стр.номерпроката, 1);
						СоответствиеВС.Вставить(стр.ВидСекции,СоответствиеНомерПроката);
					Иначе
						стр.НомерРаботы = СоответствиеВС[стр.ВидСекции][стр.номерпроката] +1;
						СоответствиеВС[стр.ВидСекции][стр.номерпроката] = стр.НомерРаботы;       
					КонецЕсли;
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли;
		
		
	КонецЦикла; 
	
   // <-- Конец Лико Субботин 23.05.2023 
   
   ИзмененитьДоступностиПолейНаСервере(Объект.ВидВырубки);
   
   ЦветаРаботы(Истина);
   
   Если Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда
	   Элементы.ВариантыДопусков.КнопкаВыпадающегоСписка = Истина;
	   Если НЕ ЗначениеЗаполнено(Элементы.ВариантыДопусков.СписокВыбора) Тогда
		   Элементы.ВариантыДопусков.СписокВыбора.Добавить(1,"1 : 0"); 
		   Элементы.ВариантыДопусков.СписокВыбора.Добавить(2,"0,5 : 0,5");
		   Элементы.ВариантыДопусков.СписокВыбора.Добавить(3,"0 : 1");  
	   КонецЕсли;
   КонецЕсли;
   
   Если Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда
	   Если Объект.ДопускМинус = 1 И Объект.ДопускПлюс = 0 Тогда
		   ВариантыДопусков = 1;		
	   ИначеЕсли Объект.ДопускМинус = 0.5 И Объект.ДопускПлюс = 0.5 Тогда
		   ВариантыДопусков = 2;		
	   ИначеЕсли Объект.ДопускМинус = 0 И Объект.ДопускПлюс = 1 Тогда
		   ВариантыДопусков = 3;		
	   КонецЕсли;
   КонецЕсли;
   УстановитьВидимостьЭлементов();
   ЗаполнитьТипЗаливка(); 
   ЗаполнитьВидОснастка();
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	//ПоказатьВариант();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ЗначениеЗаполнено(Объект.Наименование) Тогда 
		ЗаполнитьНаименованиеНаСервере();
	КонецЕсли;
	Для каждого Стр Из Объект.Цвета Цикл
		Если Стр.НомерВарианта = 1 Тогда
			Если Стр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Книжка") Тогда
				Объект.КнижныйМодуль = Истина;
			Иначе
				Объект.КнижныйМодуль = Ложь;
			КонецЕсли;
			Если ЗначениеЗаполнено(Стр.РабочийЦентр) Тогда 
				Если Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Стр.РабочийЦентр,"ВидРабочегоЦентра") = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.Indigo") Тогда  
					Объект.Цифровой = Истина;
				Иначе	
					Объект.Цифровой = Ложь;
				КонецЕсли;			
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла; 
	
	// <-- Начало Лико Яцун С. В. 18.03.2024
	НоменклатураDatamatrix = Ложь;
	Для Каждого Стр из Объект.Товары Цикл
		Если Найти(НРег(Строка(Стр.Номенклатура)),"datamatrix") <> 0 Тогда
			НоменклатураDatamatrix = Истина;	
		КонецЕсли;
	КонецЦикла; 
	Если НоменклатураDatamatrix Тогда
		Объект.Datamatrix = Истина;
	Иначе
		Объект.Datamatrix = Ложь;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 18.03.2024 
	// <-- Начало Лико Яцун С. В. 28.10.2024 
	Если Объект.ЧестныйЗнак И НЕ Объект.ЧЗ И Объект.ШиринаЭтикетки <= 25 И Объект.ДлинаЭтикетки <= 25 Тогда
		НайденныеСтроки = Объект.Цвета.НайтиСтроки(Новый Структура("ВидТМЦ",ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Краска")));
		Если НайденныеСтроки.Количество() = 1 Тогда
			Объект.ЧЗ = Истина; 	
		КонецЕсли;
	ИначеЕсли Объект.ЧЗ Тогда
		НайденныеСтроки = Объект.Цвета.НайтиСтроки(Новый Структура("ВидТМЦ",ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Краска")));
		Если НЕ Объект.ЧестныйЗнак ИЛИ Объект.ШиринаЭтикетки > 25 ИЛИ Объект.ДлинаЭтикетки > 25 ИЛИ НайденныеСтроки.Количество() <> 1 Тогда
			Объект.ЧЗ = Ложь; 	
		КонецЕсли;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 28.10.2024
	
	РасчитатьТиражМетраж(Объект.ВидВырубки);
	ЗаписатьЦветаВРаботы();
	
КонецПроцедуры

 &НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ЭтаФорма.Прочитать();
	
	ПоказатьКодМатериала();
	Для каждого стр из Объект.Товары Цикл
		Если ЗначениеЗаполнено(стр.цена) И ЗначениеЗаполнено(стр.ставкаНДС) Тогда 
			ТекПроцентНДС =  ЗначениеРеквизита(стр.СтавкаНДС, "Ставка");

			стр.ЦенаБезНДС = стр.цена/(1+ТекПроцентНДС/100);
		КонецЕсли;	
	КонецЦикла;	
	ЗаполнитьЦенуБезНДС();

КонецПроцедуры

