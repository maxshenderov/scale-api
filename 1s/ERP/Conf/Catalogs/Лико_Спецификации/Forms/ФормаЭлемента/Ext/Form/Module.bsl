&НаКлиенте
Процедура ЦветаТипКодаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
		
	ТекСтр = Элементы.Цвета.ТекущиеДанные; 
	Если ЗначениеЗаполнено(текстр.ТипНумератора) Тогда 
		Элемент.СписокВыбора.ЗагрузитьЗначения(ПолучитьТипыКодов(текстр.ТипНумератора))  ;   
	Иначе
		Сообщить("Необходимо сначала заполнить Тип нумератора в этой строке");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦветаКоличествоРучьевНумератораПриИзменении(Элемент)
		
	ТекСтр = Элементы.Цвета.ТекущиеДанные;   
	
	Если не ЗначениеЗаполнено(ТекСтр.ВидСекции) и не ЗначениеЗаполнено(ТекСтр.РабочийЦентр) Тогда		
		Сообщить("Необходимо сперва заполнить Вид работ и Рабочий центр");
		ТекСтр.КоличествоРучьевНумератора = 0;
		Возврат		
	КонецЕсли;
	
	Если ТекСтр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Нумератор") Тогда
						
		Если  Не ЭтоЦифра(ТекСтр.РабочийЦентр)  Тогда  
			Если не ЗначениеЗаполнено(ТекСтр.ТипНумератора) Тогда  
	
				Сообщить( "Необходимо заполнить Тип нумератора");
				ТекСтр.КоличествоРучьевНумератора  = 0 ;

				Возврат
			КонецЕсли;

			МаксКолРучьев =  ПолучитьКоличествоРучьев(текстр.ТипНумератора, текстр.РабочийЦентр); 
			Если МаксКолРучьев = 0 Тогда  
				Сообщить(СтрШаблон("в спр ""Типы нумераторов"" для нумератора %1 не заполнено максимальное количество ручьев для рабочего цетнра %2",  
				текстр.ТипНумератора,  текстр.РабочийЦентр ));   
				ТекСтр.КоличествоРучьевНумератора  = 0 ;
				Возврат
			КонецЕсли; 
			
			Если  ТекСтр.КоличествоРучьевНумератора > МаксКолРучьев	Тогда 
				ТекСтр.КоличествоРучьевНумератора  = МаксКолРучьев;
				Сообщить(СтрШаблон("Максимум ручьев для РЦ %2 при нумераторе %3 - %1", МаксКолРучьев, текстр.РабочийЦентр, текстр.ТипНумератора ));			
			КонецЕсли; 				
		КонецЕсли;  
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЦМИК(Команда)
	
	ТекСтр = Элементы.Цвета.ТекущиеДанные;
	
	Если ТекСтр <> Неопределено Тогда
		
		ТекСтр.ТипЦвета1 = ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.C"); 
		ТекСтр.ТипЗаливка = ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.C");
		ВидСекции = ТекСтр.ВидСекции;
		НомерПроката = ТекСтр.НомерПроката;
		ВидПечати = ТекСтр.ВидПечати;
		ВидТМЦ = ТекСтр.ВидТМЦ; 
		ТекСтрРабочийЦентр = ТекСтр.РабочийЦентр;
		
		
		МассивЦМИК = новый Массив;
		МассивЦМИК.Добавить(ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.M")); 
		МассивЦМИК.Добавить(ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.Y"));
		МассивЦМИК.Добавить(ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.K"));
		
		
		Для сч = 0 По МассивЦМИК.ВГраница() Цикл
			
			Нстр = Объект.Цвета.Добавить();
			Нстр.НомерВарианта = 1;
			Нстр.НомерПроката = НомерПроката;
			КлючСтроки = Новый УникальныйИдентификатор;
			Нстр.КлючСтроки = КлючСтроки;
			Нстр.ВидСекции = ВидСекции;
			Нстр.ВидПечати = ВидПечати;
			Нстр.ВидТМЦ     = ВидТМЦ;
			Нстр.РабочийЦентр = ТекСтрРабочийЦентр;
			Нстр.ВидОснастка = ВидТМЦ;

			Нстр.ТипЦвета1 = МассивЦМИК[сч];
			Нстр.ТипЗаливка = МассивЦМИК[сч]; 
			
			
		КонецЦикла;
	Иначе
