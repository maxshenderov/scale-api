	ТекСтр = Элементы.Цвета.ТекущиеДанные;  
	Номенклатура = ПолучитьОсновныеЧернила(ВыбранноеЗначение) ;
	Если Номенклатура <> 0 Тогда
		ТекСтр.Номенклатура = Номенклатура;   
