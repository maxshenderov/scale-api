&НаКлиенте
Процедура ПараметрыШтампаПриИзменении()
	Если ЗначениеЗаполнено(Объект.Z) И 
		НЕ (ЗначениеЗаполнено(Объект.ШтампВырубной) И ЗначениеЗаполнено(Объект.ШагПечати)) Тогда
		текКоличествоЗубьев = ПолучитьКоличествоЗубьев(Объект.Z) * 3.175 / 1000;
		Если Объект.ШагПечати <> текКоличествоЗубьев Тогда
			текПараметрыОтбора = Новый Структура;
			текПараметрыОтбора.Вставить("ВидСекции", ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Вырубка"));	
			текНайденныеСтроки = Объект.Цвета.НайтиСтроки(текПараметрыОтбора);
			Если текНайденныеСтроки.Количество() = 0 Тогда
				Объект.ШагПечати =  текКоличествоЗубьев;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	РасчитатьТиражМетраж(Объект.ВидВырубки);
	ЗаполнитьПлощадьКлишеНаСервере(Объект.ВидВырубки);
	//ПоказатьДоходностьРентабельность();
	Если Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда	
		ЗаполнитьПлощадьКлишеНаСервере(Объект.ВидВырубки);
		Заказ = Объект;
		ЗаполнитьПараметрыПечати(Заказ, Объект.ВидВырубки,,,Ложь);	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ШтампВырубной) И Объект.ВидВырубки = 0 И ОмегаСНумератором() Тогда
		ЗаполнитьПараметрыПечатиИВырубкиОмегаСНумератором();
	КонецЕсли;
	
КонецПроцедуры 

