&НаКлиенте
Процедура ЗаполнитьИзРабот(Команда)
	
	Для каждого стр из объект.ВидыРабот Цикл 
		
		Если стр.ВидРабот = ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.Печать") Тогда  
			Продолжить				
		КонецЕсли;  
		
		Если стр.ВидРабот = ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.Ламинация") Тогда  
			Если ЗначениеРеквизита(стр.РабочийЦентр, "ПорядковыйНомер") = 300 Тогда
				СтрокиЛаминация = объект.Цвета.НайтиСтроки(новый структура("НомерПроката, НомерВарианта", стр.НомерПроката, стр.НомерВарианта)); 
				Если СтрокиЛаминация.Количество() <> 0 Тогда
					СтрокаЛаминация = СтрокиЛаминация[0]; 
					СтрокаЛаминация.Нарезка = стр.нарезка;
					СтрокаЛаминация.материал = стр.материал; 
					СтрокаЛаминация.ПроцентЗаливки = стр.ПроцентЗаливки; 
					Если не ЗначениеЗаполнено( СтрокаЛаминация.ТипКраски) Тогда
						Если ТипЗнч(стр.клей) = Тип("СправочникСсылка.ЦеновыеГруппы") Тогда
							СтрокаЛаминация.ТипКраски	 = стр.клей; 
							СтрокаЛаминация.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка") 
						Иначе
							СтрокаЛаминация.ТипКраски	 = ЗначениеРеквизита(стр.клей, "ЦеноваяГруппа");
							СтрокаЛаминация.Номенклатура = стр.клей;
						КонецЕсли; 
					КонецЕсли;
				КонецЕсли;

			Иначе 
				СтрокиЛаминация = объект.Цвета.НайтиСтроки(новый структура("НомерПроката, НомерВарианта, ВидСекции", стр.НомерПроката, стр.НомерВарианта, ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ЛаминацияФлексо")));
				Если СтрокиЛаминация.Количество() = 0 Тогда  
					НоваяСтрока = объект.Цвета.Добавить();
					НоваяСтрока.Нарезка 	   = стр.нарезка;
					НоваяСтрока.материал	   = стр.материал; 
					НоваяСтрока.ПроцентЗаливки = стр.ПроцентЗаливки; 
					НоваяСтрока.НомерВарианта  = стр.НомерВарианта; 

					Если ТипЗнч(стр.клей) = Тип("СправочникСсылка.ЦеновыеГруппы") Тогда
						НоваяСтрока.ТипКраски	 = стр.клей; 
						НоваяСтрока.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка") 
					Иначе
						НоваяСтрока.ТипКраски	 = стр.клей.ЦеноваяГруппа;
						НоваяСтрока.Номенклатура = стр.клей;
					КонецЕсли;	
				
                    НоваяСтрока.ТипКраски 	   = стр.Клей;    
					НоваяСтрока.ВидСекции	   = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ЛаминацияФлексо");  
					НоваяСтрока.РабочийЦентр   = стр.РабочийЦентр;  
					НоваяСтрока.НомерПроката   = стр.НомерПроката;  
					НоваяСтрока.КлючСтроки 	   = новый УникальныйИдентификатор;
				Иначе
					СтрокаЛаминация = СтрокиЛаминация[0]; 
					СтрокаЛаминация.Нарезка = стр.нарезка;
					СтрокаЛаминация.материал = стр.материал; 
					СтрокаЛаминация.ПроцентЗаливки = стр.ПроцентЗаливки; 
					Если не ЗначениеЗаполнено( СтрокаЛаминация.ТипКраски) Тогда
						Если ТипЗнч(стр.клей) = Тип("СправочникСсылка.ЦеновыеГруппы") Тогда
							СтрокаЛаминация.ТипКраски	 = стр.клей; 
							СтрокаЛаминация.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка") 
						Иначе
							СтрокаЛаминация.ТипКраски	 = ЗначениеРеквизита(стр.клей, "ЦеноваяГруппа");
							СтрокаЛаминация.Номенклатура = стр.клей;
						КонецЕсли; 
					КонецЕсли;
					
				КонецЕсли;

	        КонецЕсли;
			
		ИначеЕсли стр.ВидРабот = ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПродольное") или стр.ВидРабот = ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПоперечное") Тогда	
			
			НоваяСтрокаГТ = объект.Цвета.Добавить();
			НоваяСтрокаГТ.Нарезка 	   	 = стр.нарезка;
			НоваяСтрокаГТ.материал	   	 = стр.материал; 
			НоваяСтрокаГТ.ПроцентЗаливки = стр.ПроцентЗаливки;   
			НоваяСтрокаГТ.НомерВарианта  = стр.НомерВарианта; 

