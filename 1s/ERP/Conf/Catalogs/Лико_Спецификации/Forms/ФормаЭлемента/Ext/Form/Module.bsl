&НаКлиенте
Процедура ЦветаТипКраскиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекСтр = Элементы.Цвета.ТекущиеДанные; 
	
	Если текстр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Нумератор")  Тогда 
		ВыполняемаяОбработка = НайтиВПФ("Обработка ""лк СхемаМашины""");
		
		Если ВыполняемаяОбработка.Пустая() Тогда
			Возврат;
		КонецЕсли;
		ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВыполняемаяОбработка);
			
		СтандартнаяОбработка = ложь;
		
		текПараметрыВыбора = Новый Структура;		
		текПараметрыВыбора.Вставить("ВидТМЦ", ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Чернила"));	
		текПараметрыВыбора.Вставить("Площадка", Объект.Площадка);	
		текПараметрыВыбора.Вставить("ВидСекции", ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Нумератор"));
		текПараметрыВыбора.Вставить("ЭлементИмя", "ТипПродукта"); 
		текПараметрыВыбора.Вставить("ТипНумератора", ТекСтр.ТипНумератора); 
		
		ОбработкаВыбора = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбораЦГ", ЭтаФорма);                      	
		ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.ФормаВыбораЦГ", текПараметрыВыбора, ЭтаФорма,,,,ОбработкаВыбора);
		
		
	КонецЕсли;    
	
КонецПроцедуры

