	ТекСтр = Элементы.Цвета.ТекущиеДанные;   
	Если ТекСтр.НовыйВал Тогда
		ТекСтр.Вал = Неопределено;			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦветаФормаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Цвета.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Форма) Тогда
		Если ЗначениеРеквизита(ТекущиеДанные.ВидСекции,"Родитель") = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Глубокая") Тогда
			Грамматура = ЗначениеРеквизита(ТекущиеДанные.Форма,"Грамматура");
			ПроцентЗаливки = ЗначениеРеквизита(ТекущиеДанные.Форма,"ПроцентЗаливки");
			Если ЗначениеЗаполнено(Грамматура) Тогда
				ТекущиеДанные.Грамматура = Грамматура * 0.5;
			Иначе
				
			КонецЕсли;
			Если ЗначениеЗаполнено(ПроцентЗаливки) Тогда
				ТекущиеДанные.ПроцентЗаливки = ПроцентЗаливки;
			Иначе
				
			КонецЕсли;
			ВалСвязанныйСФормой = ПолучитьВалСвязанныйСФормой(ТекущиеДанные.Форма); 
			Если ЗначениеЗаполнено(ВалСвязанныйСФормой) И ТипЗнч(ВалСвязанныйСФормой) = Тип("СправочникСсылка.Номенклатура") Тогда
				ТекущиеДанные.Вал = ВалСвязанныйСФормой;
				Элементы.Цвета.ЗакончитьРедактированиеСтроки(Ложь);	
			ИначеЕсли ЗначениеЗаполнено(ВалСвязанныйСФормой) И ТипЗнч(ВалСвязанныйСФормой) = Тип("Массив") Тогда
				ПараметыФормы = Новый Структура("Заголовок,ФормаОтбор","Выберие Вал",ТекущиеДанные.Форма);
				ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораВала", ЭтаФорма);
				ОткрытьФорму("РегистрСведений.Лико_ВалыФормы.Форма.ФормаВыбораВала",ПараметыФормы,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ДобавитьУсловноеОформлениеЦветаВалФорма();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВалСвязанныйСФормой(ФормаСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	//"ВЫБРАТЬ
	//|	Лико_ВалыФормыСрезПоследних.Период КАК ДатаПрихода,
	//|	Лико_ВалыФормыСрезПоследних.Вал.Артикул КАК ВалАртикул,
	//|	Лико_ВалыФормыСрезПоследних.Вал КАК Вал
	//|ИЗ
	//|	РегистрСведений.Лико_ВалыФормы.СрезПоследних(, Форма = &Форма) КАК Лико_ВалыФормыСрезПоследних";
	"ВЫБРАТЬ
	|	Лико_ЗаявкиНаГравировкуВаловОстатки.Вал КАК Вал
	|ПОМЕСТИТЬ ВТВалыПерегравировкаВсе
	|ИЗ
	|	РегистрНакопления.Лико_ЗаявкиНаГравировкуВалов.Остатки КАК Лико_ЗаявкиНаГравировкуВаловОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(, НЕ Ячейка.Помещение.Лико_ПомещениеБрака) КАК ТоварыВЯчейкахОстатки
	|		ПО Лико_ЗаявкиНаГравировкуВаловОстатки.Вал = ТоварыВЯчейкахОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДАТАВРЕМЯ(3999, 12, 31) КАК ДатаПрихода,
	|	Лико_ЗаявкиНаГравировкуВаловОстатки.Вал.Артикул КАК ВалАртикул,
	|	Лико_ЗаявкиНаГравировкуВаловОстатки.Вал КАК Вал
	|ПОМЕСТИТЬ ВТВалыПерегравировка
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(, НЕ Ячейка.Помещение.Лико_ПомещениеБрака) КАК ТоварыВЯчейкахОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ЗаявкиНаГравировкуВалов.Остатки(, Форма = &Форма) КАК Лико_ЗаявкиНаГравировкуВаловОстатки
	|		ПО ТоварыВЯчейкахОстатки.Номенклатура = Лико_ЗаявкиНаГравировкуВаловОстатки.Вал
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_ВалыФормыСрезПоследних.Период КАК ДатаПрихода,
	|	Лико_ВалыФормыСрезПоследних.Вал.Артикул КАК ВалАртикул,
	|	Лико_ВалыФормыСрезПоследних.Вал КАК Вал
	|ПОМЕСТИТЬ ВТВалы
	|ИЗ
	|	РегистрСведений.Лико_ВалыФормы.СрезПоследних(, Форма = &Форма) КАК Лико_ВалыФормыСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
	|				,
	|				НЕ Ячейка.Помещение.Лико_ПомещениеБрака
	|					И НЕ Номенклатура В
	|							(ВЫБРАТЬ
	|								ВТВалыПерегравировка.Вал КАК Вал
	|							ИЗ
	|								ВТВалыПерегравировка КАК ВТВалыПерегравировка)
	|					И НЕ Номенклатура В
	|							(ВЫБРАТЬ
	|								ВТВалыПерегравировкаВсе.Вал КАК Вал
	|							ИЗ
	|								ВТВалыПерегравировкаВсе КАК ВТВалыПерегравировкаВсе)) КАК ТоварыВЯчейкахОстатки
	|		ПО Лико_ВалыФормыСрезПоследних.Вал = ТоварыВЯчейкахОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТВалы.ДатаПрихода КАК ДатаПрихода,
	|	ВТВалы.ВалАртикул КАК ВалАртикул,
	|	ВТВалы.Вал КАК Вал
	|ПОМЕСТИТЬ ВТВсеВалы
	|ИЗ
	|	ВТВалы КАК ВТВалы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТВалыПерегравировка.ДатаПрихода,
	|	ВТВалыПерегравировка.ВалАртикул,
	|	ВТВалыПерегравировка.Вал
	|ИЗ
	|	ВТВалыПерегравировка КАК ВТВалыПерегравировка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТВсеВалы.ДатаПрихода КАК ДатаПрихода,
	|	ВТВсеВалы.ВалАртикул КАК ВалАртикул,
	|	ВТВсеВалы.Вал КАК Вал
	|ИЗ
	|	ВТВсеВалы КАК ВТВсеВалы
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПрихода";
	
	Запрос.УстановитьПараметр("Форма", ФормаСсылка);
	
	ТЗВалы = Запрос.Выполнить().Выгрузить();
	
	МассивВалы = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТЗВалы);
	Если МассивВалы.Количество() = 1 Тогда
		Возврат МассивВалы[0].Вал;
	ИначеЕсли МассивВалы.Количество() > 1 Тогда
		Возврат МассивВалы;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
					
КонецФункции

&НаКлиенте
Процедура ПослеВыбораВала(Результат, Параметры) Экспорт  
	
	текстр = Элементы.Цвета.ТекущиеДанные;
	Если Результат <> Неопределено И текстр <> Неопределено Тогда 
		текстр.Вал = Результат;
		Элементы.Цвета.ЗакончитьРедактированиеСтроки(Ложь);	
	Иначе
		Элементы.Цвета.ЗакончитьРедактированиеСтроки(Ложь);	
	КонецЕсли;
	
	ДобавитьУсловноеОформлениеЦветаВалФорма();
	
КонецПроцедуры

