	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ТипыЦвета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Лико_ТипыЦвета КАК Лико_ТипыЦвета";
	

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка") 		
	
	
КонецФункции

&НаКлиенте
Процедура ЦветаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Заголовок = "Ред." Тогда  
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуРедактированияПараметровЦвета(Элемент);  
	КонецЕсли;

КонецПроцедуры

 &НаКлиенте
Процедура ОткрытьФормуРедактированияПараметровЦвета(Элемент)

	ВыполняемаяОбработка = НайтиВПФ("Обработка ""лк СхемаМашины""");	
	Если ВыполняемаяОбработка.Пустая() Тогда
		Возврат
	КонецЕсли;
	ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВыполняемаяОбработка);

	ТекСтр = Элемент.ТекущиеДанные; 
	
	РеквизитыЦвета = ПолучитьМассивРеквизитовТЧ();
	
	СтруктураПраметрыСекции = Новый Структура;

	Для каждого рек из РеквизитыЦвета Цикл  
		СтруктураПраметрыСекции.Вставить(рек, ТекСтр[рек]); 	
	КонецЦикла;
	
	СтруктураПраметрыСекции.Вставить("ТипЦвета",	 	ТекСтр.ТипЦвета1); 

	СтруктураПраметрыСекции.Вставить("ТипПродукта", 	ЗначениеРеквизита(текстр.Номенклатура,"ЦеноваяГруппа"));   


 
	СтруктураРедактирования = Новый Структура;
	СтруктураРедактирования.Вставить("РежимВыбора", Истина);
	СтруктураРедактирования.Вставить("Секция", ТекСтр.ВидСекции); 
	СтруктураРедактирования.Вставить("ИмяСекции", ТекСтр.НомерСекции);
	СтруктураРедактирования.Вставить("ПараметрыСекцииЦвета", СтруктураПраметрыСекции);  
	СтруктураРедактирования.Вставить("РабочийЦентр", ТекСтр.РабочийЦентр); 
	СтруктураРедактирования.Вставить("Ссылка", Объект.Ссылка); 
	СтруктураРедактирования.Вставить("Площадка", Объект.Площадка); 



	допПараметры = Новый Структура;
	допПараметры.Вставить("КлючСтроки",  ТекСтр.КлючСтроки);
	допПараметры.Вставить("НомерПроката", ТекСтр.НомерПроката);

	ОбработкаЗакрытия = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированиеПараметровЦвета", ЭтаФорма, допПараметры);

	ФормаРедактированияСтрока =  ЗначениеРеквизита(ТекСтр.ВидСекции, "ИмяФормыРедактированияПараметров");

	ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.РедактированиеПараметровСекции" + ФормаРедактированияСтрока, СтруктураРедактирования, ЭтаФорма, , , , ОбработкаЗакрытия);


КонецПроцедуры 

&НаКлиенте
Процедура ПриЗакрытииФормыРедактированиеПараметровЦвета(Результат, ДопПараметры) Экспорт 
	
	Если Не ЗначениеЗаполнено(Результат) Тогда 
		Возврат
	КонецЕсли;
	
	СтруктураПараметров = Результат;
	
	ТекСтр = Объект.Цвета.НайтиСтроки(новый Структура("КлючСтроки", ДопПараметры.КлючСтроки));
	
	Если ТекСтр.Количество() > 0 Тогда   		
		
		ЗаполнитьЗначенияСвойств(ТекСтр[0], СтруктураПараметров); 
		
		ВидРабот = ЗначениеРеквизита(ТекСтр[0].ВидСекции, "ВидРабот");
		Если НЕ (ЗначениеРеквизита(ТекСтр[0].ВидСекции,"ОтображатьВТЧЦвета") И НЕ ЗначениеРеквизита(ТекСтр[0].ВидСекции,"ОтображатьВТЧРаботы")) Тогда  
			ЗаписатьЦветаВРаботы();
			Если ТекСтр[0].ВидСекции =  ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Вырубка") Тогда 
				Если ЗначениеЗаполнено(текстр[0].Оснастка) Тогда 
					ДопПараметры =  текстр[0].Оснастка;
					Режим = РежимДиалогаВопрос.ДаНет;
					Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗаполненииПараметровШтампа", ЭтаФорма, ДопПараметры);
					ПоказатьВопрос(Оповещение, НСтр("ru = 'Заполнить параметры основного вырубного штампа?'"), Режим,0);
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЕсли;
		
		
	КонецЕсли;    
	
КонецПроцедуры  

Функция ПолучитьМассивРеквизитовТЧ()
	
	реквизитыТЧ = новый массив;
	
	Для каждого ТекПараметр из Метаданные.Справочники.Лико_Спецификации.ТабличныеЧасти.Цвета.Реквизиты Цикл

		 реквизитыТЧ.Добавить(ТекПараметр.Имя);
		
	 КонецЦикла;		
	 
	 возврат реквизитыТЧ

 КонецФункции

&НаКлиенте
Процедура ЦветаРабочийЦентрПриИзменении(Элемент)
	
	текстр = Элементы.Цвета.ТекущиеДанные;	
	Для каждого стр из Объект.Цвета Цикл
		Если стр.номерпроката =текстр.номерпроката и  стр.рабочийЦентр <> текстр.рабочийЦентр Тогда 
			стр.рабочийЦентр = текстр.рабочийЦентр;
		КонецЕсли;
	КонецЦикла;
	
	ЗаписатьЦветаВРаботы() ;
	 
	Если текстр.НомерПроката = 1 Тогда 			
		Объект.РабочийЦентр = текстр.РабочийЦентр;			
	КонецЕсли;
	 
КонецПроцедуры

&НаКлиенте
Процедура ЦветаОснасткаПриИзменении(Элемент)

	текстр = Элементы.Цвета.ТекущиеДанные;
	Если ЗначениеЗаполнено(текстр.Оснастка) Тогда 
		ДопПараметры = текстр.Оснастка;
		Если ЗначениеЗаполнено(Текстр.ВидСекции) Тогда 
		ЭтоТиснение = ЗначениеРеквизита(текстр.ВидСекции, "Тиснение");
			Если текстр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Вырубка") Тогда 
				Режим = РежимДиалогаВопрос.ДаНет;
				Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗаполненииПараметровШтампа", ЭтаФорма, ДопПараметры);
				ПоказатьВопрос(Оповещение, НСтр("ru = 'Заполнить параметры основного вырубного штампа?'"), Режим,0);
		ИначеЕсли ЭтоТиснение ИЛИ текстр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Конгрев") Тогда	
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Оснастка", текстр.Оснастка);
			ДопПараметры.Вставить("Идентификатор", текстр.ПолучитьИдентификатор() );
			ЗаполнитьПараметрыШтампаТиснения(ДопПараметры);	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ТекСтр.ВидОснастка = ТекСтр.Оснастка;
	ДобавитьУсловноеОформлениеЦветаВидОснастка();
	ИзмененитьДоступностиПолейНаСервере(Объект.ВидВырубки)
	 
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьПараметрыШтампаТиснения(ДопПараметры)
	текстр = Объект.Цвета.НайтиПоИдентификатору(ДопПараметры.Идентификатор);
	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	Лико_ПараметрыШтампа.Номенклатура КАК Номенклатура,
	|	Лико_ПараметрыШтампа.Нарезка КАК Нарезка,
	|	ВЫБОР
	|		КОГДА Лико_ПараметрыШтампа.Подача = 0
	|			ТОГДА Лико_ПараметрыШтампа.ШагПечати
	|		ИНАЧЕ Лико_ПараметрыШтампа.Подача
	|	КОНЕЦ КАК Подача,
	|	ВЫБОР
	|		КОГДА Лико_ПараметрыШтампа.ЭтикетокВПодаче = 0
	|			ТОГДА Лико_ПараметрыШтампа.ЭтикетокНаЛисте
	|		ИНАЧЕ Лико_ПараметрыШтампа.ЭтикетокВПодаче
	|	КОНЕЦ КАК ЭтикетокВПодаче
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|ГДЕ
	|	Лико_ПараметрыШтампа.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", ДопПараметры.Оснастка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		текстр.Нарезка = Выборка.Нарезка;
		текстр.Подача = Выборка.Подача;
		Если Лико_ТиражМетраж.ЭтоКомлект(Объект.Ссылка) Тогда 
			текстр.ЭтикетокВПодаче = Выборка.ЭтикетокВПодаче/2;
		Иначе
			текстр.ЭтикетокВПодаче = Выборка.ЭтикетокВПодаче;
		КонецЕсли;
	КонецЦикла;	 

КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьЭтМЭР()
	
	текЭтМЭР = ПолучитьЭтМЭРНаСервере();
	Если Объект.ЭтМЭР <> текЭтМЭР Тогда
		Объект.ЭтМЭР = текЭтМЭР;		
	КонецЕсли;

	текВидВырубки = Объект.ВидВырубки;
	
	Если текВидВырубки = 2 ИЛИ текВидВырубки = 6 ИЛИ текВидВырубки = 9 ИЛИ текВидВырубки = 12 Тогда
		текКоличествоЭтПоДлинеПечатиИндиго = ПолучитьЭтикетокПоДлинеПечатиИндигоНаСервере(текВидВырубки);
		Если текКоличествоЭтПоДлинеПечатиИндиго <> Объект.КоличествоЭтПоДлинеПечатиИндиго Тогда 
			Объект.КоличествоЭтПоДлинеПечатиИндиго = текКоличествоЭтПоДлинеПечатиИндиго;	
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьЭтикетокПоДлинеПечатиИндигоНаСервере(текВидВырубки)
	Возврат Лико_ТиражМетраж.ПолучитьЭтикетокПоДлинеПечатиИндиго(Объект, текВидВырубки);
