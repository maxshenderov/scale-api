Функция ПолучитьСтруктуруПантонаСервер(Площадка,ЦеноваяГруппа) //+Лико m.shenderov 24.08.2021
	Структура = Новый Структура;
	Структура.Вставить("ФормулаПантона");
	Структура.Вставить("Номенклатура");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ФормулыПантонов.Ссылка КАК ФормулаПантона,
	|	Лико_ФормулыПантонов.Номенклатура КАК Номенклатура
	|ИЗ
	|	Справочник.Лико_ФормулыПантонов КАК Лико_ФормулыПантонов
	|ГДЕ
	|	Лико_ФормулыПантонов.Площадка = &Площадка
	|	И Лико_ФормулыПантонов.ЦеноваяГруппа = &ЦеноваяГруппа";
	Запрос.УстановитьПараметр("ЦеноваяГруппа",ЦеноваяГруппа );
	Запрос.УстановитьПараметр("Площадка",Площадка);
	
	РезультатЗапроса = Запрос.Выполнить();
