&НаКлиенте
Процедура ЦветаНоменклатураПриИзменении(Элемент)
	
	текстр = Элементы.Цвета.ТекущиеДанные;
	Если ЗначениеЗаполнено(текстр.номенклатура) Тогда
		//20230531 Проверяем соответствие реквизитов  
		ЦеноваяГруппа =  ЗначениеРеквизита(текстр.Номенклатура,"ЦеноваяГруппа");
		Если ЗначениеРеквизита(ЦеноваяГруппа, "Лико_ВидТМЦ") <> текстр.ВидТМЦ Тогда 
			Сообщить("Выбранная номенклатура не соответствует указанному Виду ТМЦ"); 
			текстр.номенклатура = Неопределено;  
			Возврат;
		КонецЕсли;	
		//20190715 - меняем не "Тип краски", а "Тип краски факт"  
		//20230317 - убираем тип краски Факт из конфигурации, меняем Тип краски
		текстр.типкраски = ЦеноваяГруппа; 
		//20181213 - Оля Артамонова и В. Ли просили сделать так
		//текстр.Название = ЗначениеРеквизита(текстр.ТипКраски, "Наименование");
		Если Объект.Площадка = ГлЛико_Площадки.ИксПак Тогда
			текстр.Название = ЗначениеРеквизита(текстр.Номенклатура, "Артикул");
		КонецЕсли;	
	КонецЕсли;
