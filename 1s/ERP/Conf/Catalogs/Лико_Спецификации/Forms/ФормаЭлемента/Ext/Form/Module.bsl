&НаКлиенте
Процедура ПОслеВыбораНамотки(Результат, Параметры) Экспорт
	Если Результат<>Неопределено Тогда 
		Если ТипЗнч(Результат) = Тип("СправочникСсылка.Лико_Перемотка") ТОгда 
			текстр = Элементы.Товары.ТекущиеДанные;
			Если Текстр<>Неопределено Тогда 
				текстр.перемотка = результат;
				ЗаполнитьНамоткуНаСервере(текстр.ПолучитьИдентификатор());
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидыРаботОснасткаПриИзменении(Элемент)
	текстр = Элементы.ВидыРабот.ТекущиеДанные;
	Если ЗначениеЗаполнено(текстр.Оснастка) Тогда 
		ДопПараметры =  текстр.Оснастка;
		Если ЗначениеЗаполнено(Текстр.ВидРабот) Тогда 
			Если текстр.ВидРабот = ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.Вырубка") Тогда 
				Режим = РежимДиалогаВопрос.ДаНет;
				Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗаполненииПараметровШтампа", ЭтаФорма, ДопПараметры);
				ПоказатьВопрос(Оповещение, НСтр("ru = 'Заполнить параметры основного вырубного штампа?'"), Режим,0);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОЗаполненииПараметровШтампа(Результат, ДопПараметры)  Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда 
		ЗаполнитьПараметрыШтампа(ДопПараметры); 
		РасчитатьТиражМетраж(Объект.ВидВырубки); 
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыШтампа(Оснастка)
	
	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	Лико_ПараметрыШтампа.Номенклатура,
	|	Лико_ПараметрыШтампа.ТипШтампа,
	|	Лико_ПараметрыШтампа.ЭтикетокНаЛисте,
	|	Лико_ПараметрыШтампа.Нарезка,
	|	Лико_ПараметрыШтампа.ШагПечати,
	|	Лико_ПараметрыШтампа.Ручьи,
	|	Лико_ПараметрыШтампа.Z,
	|	Лико_ПараметрыШтампа.ДлинаЭтикетки,
	|	Лико_ПараметрыШтампа.ШиринаЭтикетки,
	|	Лико_ПараметрыШтампа.Цена,
	|	Лико_ПараметрыШтампа.Артикул
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|ГДЕ
	|	Лико_ПараметрыШтампа.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Оснастка);
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект.ШтампВырубной = Оснастка;
		Объект.ЭтикетокНаЛисте = Выборка.ЭтикетокНаЛисте;
		Объект.Нарезка = Выборка.Нарезка;
		Объект.Ручьи = Выборка.Ручьи;
		Объект.Z = Выборка.Z;
		Объект.ДлинаЭтикетки = Выборка.ДлинаЭтикетки;
		Объект.ШиринаЭтикетки = Выборка.ШиринаЭтикетки;
		Объект.ШагПечати = Выборка.ШагПечати;
		// --> Начало Лико Митюшин МФМ 07.04.2021
		//Автоматическая замена ручьёв Печати при изменение параметров Штампа
		Объект.РучьиПечати = Выборка.Ручьи;
		// <-- Конец Лико Митюшин МФМ  07.04.2021
	КонецЦикла;	
	// --> Начало Лико Митюшин МФМ 31.03.2021
	ПроставитьВидВырубки(Объект,,Ложь);
	текВидВырубки = Объект.ВидВырубки;
	Лико_ТиражМетраж.ОчиститьНеИспользуемыПараметрыШтампа(Объект ,текВидВырубки);	
	
	Если текВидВырубки = 1 ИЛИ текВидВырубки = 2 ИЛИ текВидВырубки = 4 ИЛИ текВидВырубки = 7 ИЛИ текВидВырубки = 8 ИЛИ текВидВырубки = 10 Тогда  
		ТекКоэфДеления = ?(Лико_ТиражМетраж.ЭтоКомлект(Объект), 0.5, 1);
		Объект.ЭтикетокНаЛисте = Объект.ЭтикетокНаЛисте * ТекКоэфДеления;
	КонецЕсли;
		
	Объект.ДлинаПечати 				= Лико_ТиражМетраж.ПолучитьДлинуПечати(Объект, текВидВырубки);

	// <-- Конец Лико Митюшин МФМ 31.03.2021
	Если Лико_ТиражМетраж.ЭтоПечатьНаИндиго(Объект, текВидВырубки) Тогда
		Объект.РучьиПечатиИндиго 	= Объект.РучьиПечати;
		Если Не(текВидВырубки = 9 ИЛИ текВидВырубки = 12) Тогда 
			Объект.РучьиПечати 			= 0;
		КонецЕсли;
	КонецЕсли;
	
	Если текВидВырубки = 13 Тогда 
		Объект.РучьиПечати 			= 	Объект.Ручьи * Объект.КоличествоЛистовКнижки;
	КонецЕсли;
	
	Если Не (текВидВырубки = 2 ИЛИ текВидВырубки = 6 ИЛИ текВидВырубки = 10 ИЛИ текВидВырубки = 15) Тогда
		Объект.ЭтикетокНаЛистеПечати 	= Лико_ТиражМетраж.ПолучитьЭтикетокНаЛистеПечати(Объект, текВидВырубки);
	КонецЕсли;
	
	//Если текВидВырубки <> 13 Тогда
		Объект.ЭтМЭР = Лико_ТиражМетраж.ПолучитьМежэтикеточноеРасстояние(Объект, текВидВырубки);
	//КонецЕсли;
	
	Если текВидВырубки = 3 ИЛИ текВидВырубки = 9 ИЛИ текВидВырубки = 11 ИЛИ текВидВырубки = 12  ИЛИ текВидВырубки = 14 Тогда
		Объект.КоличествоЭтПоДлинеПечати = Лико_ТиражМетраж.ПолучитьЭтикетокНаЛистеПечатиФлексо(Объект);
	КонецЕсли;
	
	
	//Если текВидВырубки = 13 Тогда
	//	Объект.ЭтМЭР = Лико_ТиражМетраж.ПолучитьМежэтикеточноеРасстояние(Объект, текВидВырубки);
	//КонецЕсли;
	
	Если текВидВырубки = 2 ИЛИ текВидВырубки = 6 ИЛИ текВидВырубки = 9 ИЛИ текВидВырубки = 12 Тогда
		Объект.КоличествоЭтПоДлинеПечатиИндиго = Лико_ТиражМетраж.ПолучитьЭтикетокПоДлинеПечатиИндиго(Объект, текВидВырубки);
	КонецЕсли;	
	
	Если текВидВырубки = 10 Тогда  
		Объект.КоличествоШтамповПоДлинеПечатиИндиго = ?(Объект.ШагПечати = 0, 0, Цел(0.98 / Объект.ШагПечати));
	КонецЕсли;	
	
	Если текВидВырубки = 2 ИЛИ текВидВырубки = 6 ИЛИ текВидВырубки = 9 ИЛИ текВидВырубки = 10 ИЛИ текВидВырубки = 12 Тогда 
		Объект.ДлинаПечатиИндиго =  Лико_ТиражМетраж.ПолучитьДлинуПечатиИндиго(Объект, текВидВырубки)
	КонецЕсли;
	
	Если Не (текВидВырубки = 1 ИЛИ текВидВырубки = 3 ИЛИ текВидВырубки = 4 ИЛИ текВидВырубки = 5
		ИЛИ текВидВырубки = 7 ИЛИ текВидВырубки = 8 ИЛИ текВидВырубки = 11 ИЛИ текВидВырубки = 13 ИЛИ текВидВырубки = 14 ИЛИ текВидВырубки = 15) Тогда
		Объект.ЭтикетокНаЛистеИндиго 	= Лико_ТиражМетраж.ПолучитьЭтикетокНаЛистеИндиго(Объект, текВидВырубки);
	КонецЕсли;

	Объект.ПлощадьКлише = Лико_ТиражМетраж.ПолучитьПлощадьКлише(Объект, текВидВырубки); 
	
	ИзмененитьДоступностиПолейНаСервере(текВидВырубки);
		
КонецПроцедуры	

&НаСервере 
Процедура ПроставитьВидВырубки(Заказ,  СпецификацияСсылка = Неопределено, ПересчетПараметров)		// --> Начало Лико Митюшин МФМ 28.05.2021
	
	текВидВырубки = Лико_ТиражМетраж.ПолучитьВидВырубки(Заказ);
	Если Объект.ВидВырубки <> текВидВырубки Тогда
		Объект.ВидВырубки = текВидВырубки;
		ЗаполнитьПараметрыИРасчитатьМетражНаСервере(текВидВырубки, ПересчетПараметров);
		Сообщить("Изменен вид вырубки, проверьте параметры вырубки / печати", СтатусСообщения.Информация); 
		// <-- Начало Лико Яцун С. В. 08.12.2023
		Если РазрешеноМенятьПараметрыШтампа И Объект.ВидВырубки <> 0 Тогда
			РазрешеноМенятьПараметрыШтампа = Ложь;
			Элементы.Лико_РедактироватьПараметрыШтампов.ЦветТекста = WebЦвета.ТемноСерый;
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 08.12.2023
	КонецЕсли; 
	
КонецПроцедуры 		// <-- Конец Лико Митюшин МФМ 28.05.2021 

&НаКлиенте
Процедура Лико_РедактироватьПараметрыШтампов()
	РазрешеноМенятьПараметрыШтампа = Не РазрешеноМенятьПараметрыШтампа;
	Если РазрешеноМенятьПараметрыШтампа Тогда  
		Объект.ВидВырубки = 0;
		Элементы.Лико_РедактироватьПараметрыШтампов.ЦветТекста = WebЦвета.Зеленый;
	Иначе
		СпецификацияОбъект = Объект;
		ПроставитьВидВырубки(СпецификацияОбъект,,Ложь);
		Элементы.Лико_РедактироватьПараметрыШтампов.ЦветТекста = WebЦвета.ТемноСерый;
	КонецЕсли;
	ИзмененитьДоступностиПолейНаСервере(Объект.ВидВырубки);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыИРасчитатьМетражНаСервере(текВидВырубки, ПересчетПараметров, ВРежимеРедактированияПараметров = Ложь)
	ЗаполнитьПараметрыПечати(Объект, текВидВырубки,, ПересчетПараметров,НЕ ВРежимеРедактированияПараметров);
	//Лико_ТиражМетраж.РассчитатьМетражСВидомВырубки(Объект.Тираж*1000, Объект, текВидВырубки);
	
	РасчитатьТиражМетраж(текВидВырубки);
	
КонецПроцедуры   
	
&НаСервере
Процедура РасчитатьТиражМетраж(текВидВырубки)
	
	Для Каждого стр из Объект.Стоимость Цикл 
		ВыполнитьрасчетТиражМетраж(Стр,текВидВырубки);
	КонецЦикла;  
	
КонецПроцедуры
	
&НаСервере
Процедура ВыполнитьрасчетТиражМетраж(ТекСтр,текВидВырубки,ИмяТаблицы = "")

	Если ТипЗнч(ТекСтр) = Тип("Число") Тогда
		Если Найти(ИмяТаблицы, "Товары") > 0 Тогда
			Стр = Объект.Товары.НайтиПоИдентификатору(ТекСтр); 
		ИначеЕсли Найти(ИмяТаблицы, "Стоимость") > 0 Тогда
			Стр = Объект.Стоимость.НайтиПоИдентификатору(ТекСтр); 
		КонецЕсли;
	Иначе
		Стр = ТекСтр
	КонецЕсли;	
		
	стр.ПогонныйМетраж = Лико_ТиражМетраж.РассчитатьМетражСВидомВырубки(Стр.Количество*1000, Объект, текВидВырубки);
	Если ЗначениеЗаполнено(Объект.Нарезка) Тогда 
		стр.КвадратныйМетраж =стр.погонныйметраж*Объект.Нарезка.Размер/1000;
		ТекШтКВМ = Лико_ТиражМетраж.РассчитатьКВМ(Стр.ШТКВМ, Стр.КвадратныйМетраж, Стр.Количество);
		Если ТекШтКВМ <> Неопределено Тогда 
			Стр.ШтКВМ = ТекШтКВМ;
		КонецЕсли;
	КонецЕсли;
	//Только Омега с нумератором в режиме редактирования параметров (Вид вырубки = 0)
	ОбъекттекВидВырубки = Объект.ВидВырубки;
	Если НЕ ЗначениеЗаполнено(Объект.ШтампВырубной) И ОбъекттекВидВырубки = 0 И ОмегаСНумератором() Тогда
		//Предопределенные значения
		МассивЛико_Предопределенные = Лико_ТиражМетраж.ПолучитьМассивЛико_Предопределенные();
		Нарезка = Объект.Нарезка.Размер/1000;
		Если Объект.Товары[0].Номенклатура.ЕдиницаИзмерения = МассивЛико_Предопределенные[0] Тогда
			Количество = стр.Количество*1000;
			Если ВидРЦИндиго(Объект.РабочийЦентр) Тогда
				Если Объект.Ручьи = 0 ИЛИ Объект.ЭтикетокНаЛисте = 0  Тогда
					стр.ПогонныйМетраж = 0;
				ИначеЕсли Объект.РучьиПечатиИндиго = 0 Тогда
					стр.ПогонныйМетраж = Количество /Объект.ЭтикетокНаЛисте*Объект.ШагПечати;
				Иначе 
					стр.ПогонныйМетраж = Количество /(Объект.ЭтикетокНаЛисте*Объект.РучьиПечатиИндиго/Объект.Ручьи)*Объект.ШагПечати;
				КонецЕсли;	
			Иначе
				Если Объект.Ручьи = 0 ИЛИ Объект.ЭтикетокНаЛисте = 0  Тогда
					стр.ПогонныйМетраж = 0;
				ИначеЕсли Объект.РучьиПечати = 0 Тогда
					стр.ПогонныйМетраж = Количество / Объект.ЭтикетокНаЛисте*Объект.ШагПечати;
				Иначе 
					стр.ПогонныйМетраж = Количество /(Объект.ЭтикетокНаЛисте*Объект.РучьиПечати/Объект.Ручьи)*Объект.ШагПечати;
				КонецЕсли;
			КонецЕсли;
			стр.КвадратныйМетраж = стр.ПогонныйМетраж*Нарезка;
		ИначеЕсли Объект.Товары[0].Номенклатура.ЕдиницаИзмерения = МассивЛико_Предопределенные[1] Тогда
			стр.ПогонныйМетраж = стр.Количество;
			стр.КвадратныйМетраж  = стр.ПогонныйМетраж*Нарезка;
			Количество = стр.ПогонныйМетраж; 
		ИначеЕсли  Объект.Товары[0].Номенклатура.ЕдиницаИзмерения = МассивЛико_Предопределенные[2]  Тогда
			стр.КвадратныйМетраж  = стр.Количество;
			стр.ПогонныйМетраж = стр.Количество/Нарезка;
			Количество = стр.КвадратныйМетраж;
		КонецЕсли;
		ТекШтКВМ = Лико_ТиражМетраж.РассчитатьКВМ(Стр.ШТКВМ, Стр.КвадратныйМетраж, Стр.Количество);
		Если ТекШтКВМ <> Неопределено Тогда 
			Стр.ШтКВМ = ТекШтКВМ;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере 
Функция СоздатьНоменклатуруНаСервере (Текст, ТипЭтикетки)
	НоваяНоменклатура = Лико_Планирование.СоздатьНоменклатуруНаСервере (Текст, ТипЭтикетки, Объект.Регион, Объект.Партнер);	
	Возврат НоваяНоменклатура;		
КонецФункции

&НаКлиенте
Процедура ТоварыНоменклатураСоздание(Элемент, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Сообщить("Сначала необходимо записать заказ!");
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	индексстроки =  ТекущиеДанные.НомерСтроки - 1;
	Наименование = Элемент.ТекстРедактирования;
	//Ном = ПолучитьНоменклатуруПоНазванию(Наименование);
	//Если Не ЗначениеЗаполнено(Ном) тогда
	Если Не ЗначениеЗаполнено(Объект.ссылка) Тогда 
		Сообщить("Необходимо записать заказ") ;
		Возврат;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Список.Добавить(ПредопределенноеЗначение("Перечисление.Лико_ТипыЭтикеток.ЭТ"));
	Список.Добавить(ПредопределенноеЗначение("Перечисление.Лико_ТипыЭтикеток.КЭ"));
	Список.Добавить(ПредопределенноеЗначение("Перечисление.Лико_ТипыЭтикеток.Кльр"));
	ДопПараметры = Новый Структура("ТекущиеДанные, Элемент, Текст", ТекущиеДанные, Элемент, Наименование); 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораТипаЭтикетки", ЭтотОбъект, ДопПараметры);
	//Сообщение = Новый СообщениеПользователю;
	//Сообщение.Текст = "Выберите тип создаваемого товара (эт, контр или колье)";
	//Сообщение.Поле ="Объект.Товары["+ИндексСтроки+"]Номенклатура";
	//Сообщение.УстановитьДанные(ЭтотОбъект);
	//Сообщение.Сообщить();
	//ПоказатьВыборИзСписка(ОписаниеОповещения, Список );
	ОткрытьФорму("Документ.ЗаказКлиента.Форма.Лико_ФормаВыбораТипаЭтикетки",,, Новый УникальныйИдентификатор,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораТипаЭтикетки(Знач ВыбранныйЭлемент, ДопПараметры) Экспорт
	Если ВыбранныйЭлемент <> Неопределено Тогда    
		типЭтикетки = ВыбранныйЭлемент.Значение;
		Номенклатура = СоздатьНоменклатуруНаСервере(ДопПараметры.Текст, типэтикетки);
		ДопПараметры.ТекущиеДанные.Номенклатура = Номенклатура;
	КонецЕсли; 		

КонецПроцедуры

&НаСервере 
Процедура УстановитьЦенуБезНДС(Идентификатор, ИмяТЧ)
	стр = Объект[ИмяТЧ].НайтиПоИдентификатору(Идентификатор);
	ТекПроцентНДС = стр.СтавкаНДС.Ставка;
	стр.ЦенаБезНДС = стр.цена/(1+ТекПроцентНДС);
КонецПроцедуры

&НаСервере 
Процедура УстановитьЦенуСНДС(Идентификатор, ИмяТЧ)
	стр = Объект[ИмяТЧ].НайтиПоИдентификатору(Идентификатор);
	ТекПроцентНДС = стр.СтавкаНДС.Ставка;
	стр.Цена = стр.ценаБезНДС*(1+ТекПроцентНДС/100);
КонецПроцедуры

