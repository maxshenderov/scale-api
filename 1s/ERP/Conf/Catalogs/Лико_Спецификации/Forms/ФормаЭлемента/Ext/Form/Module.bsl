&НаСервере
Процедура ЗаполнитьПеремоткуНаСервере()
	Если ЭтаФорма.Модифицированность Тогда
		Сообщить("Необходимо записать документ!");
		Возврат;
	Иначе
		Объект.Перемотка.Очистить();
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаТовары.Ссылка.Партнер КАК Партнер,
		|	ТаблицаТовары.Номенклатура КАК Номенклатура,
		|	ТаблицаТовары.Направление КАК Направление,
		|	ТаблицаТовары.МаксимальныйДиаметрРулона КАК МаксимальныйДиаметрРулона,
		|	ТаблицаТовары.ВнутреннийДиаметр КАК ВнутреннийДиаметр,
		|	ТаблицаТовары.ПродольнаяРезка КАК ПродольнаяРезка,
		|	ТаблицаТовары.ПоперечнаяРезка КАК ПоперечнаяРезка,
		|	ТаблицаТовары.Кромка КАК Кромка,
		|	ТаблицаТовары.ПодрезкаКромки КАК ПодрезкаКромки,
		|	ТаблицаТовары.Город КАК Город,
		|	Лико_Перемотка.Ссылка КАК Перемотка,
		|	ТаблицаТовары.КоличествоЭтикетокВРолике КАК КоличествоЭтикетокВРолике
		|ИЗ
		|	Справочник.Лико_Спецификации.Товары КАК ТаблицаТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_Перемотка КАК Лико_Перемотка
		|		ПО ТаблицаТовары.Ссылка.Партнер = Лико_Перемотка.Партнер
		|			И ТаблицаТовары.Номенклатура = Лико_Перемотка.Номенклатура
		|			И ТаблицаТовары.Направление = Лико_Перемотка.Направление
		|			И ТаблицаТовары.МаксимальныйДиаметрРулона = Лико_Перемотка.МаксимальныйДиаметрРулона
		|			И ТаблицаТовары.ВнутреннийДиаметр = Лико_Перемотка.ВнутреннийДиаметр
		|			И ТаблицаТовары.КоличествоЭтикетокВРолике = Лико_Перемотка.КоличествоЭтикетокВРолике
		|			И ТаблицаТовары.ПродольнаяРезка = Лико_Перемотка.ПродольнаяРезка
		|			И ТаблицаТовары.ПоперечнаяРезка = Лико_Перемотка.ПоперечнаяРезка
		|			И ТаблицаТовары.Кромка = Лико_Перемотка.Кромка
		|			И ТаблицаТовары.ПодрезкаКромки = Лико_Перемотка.ПодрезкаКромки
		|			И ТаблицаТовары.Город = Лико_Перемотка.Город
		|ГДЕ
		|	ТаблицаТовары.Ссылка = &Заказ";
		Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.Перемотка) Тогда 
				СпрОбъект = Справочники.Лико_Перемотка.СоздатьЭлемент();
				СпрОбъект.Партнер 					= Выборка.Партнер;
				СпрОбъект.Номенклатура				= Выборка.Номенклатура;
				СпрОбъект.Направление				= Выборка.Направление;
				СпрОбъект.МаксимальныйДиаметрРулона	= Выборка.МаксимальныйДиаметрРулона;
				СпрОбъект.ВнутреннийДиаметр			= Выборка.ВнутреннийДиаметр;
				СпрОбъект.КоличествоЭтикетокВРолике = Выборка.КоличествоЭтикетокВРОлике;
				СпрОбъект.ПродольнаяРезка 			= Выборка.ПродольнаяРезка;
				СпрОбъект.ПоперечнаяРезка 			= Выборка.ПоперечнаяРезка;
				СпрОбъект.Кромка 					= Выборка.Кромка;
				СпрОбъект.ПодрезкаКромки 			= Выборка.ПодрезкаКромки;
				СпрОбъект.Город 					= Выборка.Город;
				СпрОбъект.Записать();
				спрПеремотка = СпрОбъект.Ссылка;
			Иначе
				СпрПеремотка = Выборка.Перемотка;
			КонецЕсли;
			//Отбор = Новый Структура("Наименование", спрПеремотка);
			//МассивСтрок = Объект.Перемотка.НайтиСтроки(Отбор);
			//Если МассивСтрок.количество()=0 Тогда 
				стр = Объект.Перемотка.Добавить();
				стр.наименование = спрперемотка;
			//КонецЕсли;
		КонецЦикла;		
	КонецЕсли;

КонецПроцедуры

