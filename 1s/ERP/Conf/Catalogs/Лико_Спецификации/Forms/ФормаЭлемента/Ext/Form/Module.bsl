&НаКлиенте
Процедура ЦветаВидОснасткаПриИзменении(Элемент)

	стр = Элементы.Цвета.ТекущиеДанные;
	Если ТипЗнч(стр.ВидОснастка) = Тип("СправочникСсылка.Лико_ВидыТМЦ") И ЗначениеРеквизита(стр.ВидСекции,"ИспользоватьВидТМЦ") И ЗначениеЗаполнено(стр.ВидОснастка) Тогда 
    	стр.ВидТМЦ = стр.ВидОснастка;
		стр.Оснастка = Неопределено;
	
		реквизитыТЧ = ПолучитьМассивРеквизитовТЧ();
		//очистка строки
		для Каждого текРек из реквизитыТЧ цикл
			
			Если текРек = "РабочийЦентр" ИЛИ текРек = "Номерработы" ИЛИ текРек = "ВидПечати" ИЛИ  текРек = "ВидСекции" ИЛИ текРек = "ВидТМЦ" ИЛИ  текРек = "КлючСтроки" ИЛИ  текРек = "НомерПроката" ИЛИ  текРек = "НомерВарианта" Тогда 
				Продолжить;
			Иначе
				стр[текРек] = неопределено;
			КонецЕсли;
			//Если текРек = "Вал" ИЛИ текРек = "Форма" Тогда
			//	Стр.ВалФорма = стр[текРек];
			//КонецЕсли;
		КонецЦикла;
		
		ВидЗаливки = ПолучитьВидЗаливкиПоУмолчанию(стр.ВидСекции, стр.ВидТМЦ);
		
		стр.ВидЗаливки = ВидЗаливки;
		стр.ТипЗаливка = ВидЗаливки;
		
	ИначеЕсли ТипЗнч(стр.ВидОснастка) = Тип("СправочникСсылка.Номенклатура") И ЗначениеРеквизита(стр.ВидСекции,"Оснастка") И ЗначениеЗаполнено(стр.ВидОснастка) Тогда
		стр.Оснастка = стр.ВидОснастка;
		стр.ВидТМЦ = Неопределено;
		ДобавитьУсловноеОформлениеЦветаВидОснастка();
		ЗаписатьЦветаВРаботы();
		ЗаполнениеПараметровОснастки(); 
	Иначе
		стр.ВидОснастка = Неопределено;
		стр.Оснастка = Неопределено;  
		стр.ВидТМЦ = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеПараметровОснастки()
	текстр = Элементы.Цвета.ТекущиеДанные;   
	Если ЗначениеЗаполнено(текстр.Оснастка) Тогда 
		//Если ЗначениеЗаполнено(Текстр.ВидРабот) Тогда 
		//	РезультатПроверки = ПоверитьСоответствиеОснасткиВидыРабот(текстр.Оснастка, Текстр.ВидРабот);
		//	Если Не РезультатПроверки Тогда 
		//		текстр.Оснастка =  ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
		//Иначе		
		ЭтоТиснение = ЗначениеРеквизита(текстр.ВидСекции, "Тиснение");
		Если текстр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Вырубка") Тогда 
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗаполненииПараметровШтампа", ЭтаФорма, текстр.Оснастка);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Заполнить параметры основного вырубного штампа?'"), Режим,0);
		ИначеЕсли ЭтоТиснение ИЛИ текстр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Конгрев") Тогда	
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Оснастка", текстр.Оснастка);
			ДопПараметры.Вставить("Идентификатор", текстр.ПолучитьИдентификатор() );
			ЗаполнитьПараметрыШтампаТиснения(ДопПараметры);	
					
		КонецЕсли;

	Иначе
		ПроверитьВырубнойШтамп();
		РасчитатьТиражМетраж(Объект.ВидВырубки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЦветаВидОснасткаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ТекСтр = Элементы.Цвета.ТекущиеДанные; 
	Если ЗначениеЗаполнено(ТекСтр.ВидСекции) Тогда
		Если ЗначениеРеквизита(ТекСтр.ВидСекции,"Оснастка") Тогда   
			Обработка = НайтиВПФ("Обработка ""Штампер""");
			Если Обработка <> Неопределено Тогда 
				ПараметрыОткрытия = Новый Структура;
				ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
				ПараметрыОткрытия.Вставить("ВидРабот",ЗначениеРеквизита(текстр.ВидСекции, "ВидРабот"));
				Если ЗначениеЗаполнено(текстр.Рабочийцентр) Тогда 
					ПараметрыОткрытия.Вставить("РабочийЦентр", текстр.Рабочийцентр);
				КонецЕсли;
				Если ЗначениеЗаполнено(Объект.Площадка) Тогда 
					ПараметрыОткрытия.Вставить("Площадка", Объект.Площадка);
				КонецЕсли;
				Если ЗначениеЗаполнено(текстр.Оснастка) Тогда 
					ПараметрыОткрытия.Вставить("Оснастка",текстр.Оснастка );
				КонецЕсли;
				ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(Обработка);
				ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.ФормаУпр", ПараметрыОткрытия,Элементы.ЦветаОснастка ,,,, Новый ОписаниеОповещения("ВыборЗавершение", ЭтотОбъект),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			КонецЕсли;	
		ИначеЕсли ЗначениеРеквизита(ТекСтр.ВидСекции,"ИспользоватьВидТМЦ") Тогда    
			ДанныеВыбора = Новый СписокЗначений;
			ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Краска"));
			ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Лак")); 
			ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Клей"));
			ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Праймер"));
			ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.БесцветнаяМасса"));
			ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Чернила"));
		ИначеЕсли НЕ ЗначениеРеквизита(ТекСтр.ВидСекции,"Оснастка") И НЕ ЗначениеРеквизита(ТекСтр.ВидСекции,"ИспользоватьВидТМЦ") Тогда
			ТекСтр.ВидОснастка = Неопределено;
		КонецЕсли;  
	Иначе
		Сообщить("Заполните Вид работ");
	КонецЕсли;

КонецПроцедуры   

&НаКлиенте
Процедура ВыборЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	текстр = Элементы.Цвета.ТекущиеДанные;
    ВидРабот = ЗначениеРеквизита(текстр.ВидСекции, "ВидРабот");
	Если РезультатЗакрытия <> Неопределено Тогда
		текстр.оснастка = РезультатЗакрытия;
		текстр.ВидОснастка = РезультатЗакрытия;
		ЗаписатьЦветаВРаботы(); 
		Если текстр.ВидСекции =  ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Вырубка")
			ИЛИ текстр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ГорячееТиснениеПлоское")
			ИЛИ текстр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ГорячееТиснениеСНумератором")
			ИЛИ текстр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Конгрев") Тогда 
			ЗаполнениеПараметровОснастки();
		КонецЕсли;
    КонецЕсли;
    
КонецПроцедуры

