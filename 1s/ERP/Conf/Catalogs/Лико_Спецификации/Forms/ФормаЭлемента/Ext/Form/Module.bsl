&НаКлиенте
Процедура ПереместитьНаКлиенте(ТЧДляСдвига,текСтрока,Вниз,Цвета)
	Если Вниз Тогда
		Сдвиг = 1
	Иначе
		Сдвиг = -1;
	КонецЕсли;
	
	НомерПервойИПоследнейСтроки = ПолучитьНомерПервойИПоследнейСтрокиВТЧСОтбором(текСтрока.НомерВарианта, Цвета);
	Если НомерПервойИПоследнейСтроки.Количество()>0 Тогда
		Если (Вниз И текСтрока.НомерСтроки < (НомерПервойИПоследнейСтроки.Получить("НомерПоследнейСтроки"))) ИЛИ (Не Вниз И текСтрока.НомерСтроки > (НомерПервойИПоследнейСтроки.Получить("НомерПервойСтроки")))Тогда 
        		ТЧДляСдвига.Сдвинуть(текСтрока.НомерСтроки-1,Сдвиг);
		КонецЕсли;
    КонецЕсли;  
КонецПроцедуры

&НаКлиенте
Процедура Переместить(Команда)
	Если Прав(Команда.Имя,5) = "Цвета" Тогда
		текСтрока = Элементы.Цвета.ТекущиеДанные;
		ТЧДляСдвига = Объект.Цвета;
		Цвета = Истина;
	Иначе
		текСтрока = Элементы.ВидыРабот.ТекущиеДанные;
		ТЧДляСдвига = Объект.ВидыРабот;
		Цвета = Ложь;
	КонецЕсли;
	
	Если Лев(Команда.Имя,4) = "Вниз" Тогда
		ПереместитьНаКлиенте(ТЧДляСдвига,текСтрока,Истина, Цвета)
	Иначе
		ПереместитьНаКлиенте(ТЧДляСдвига,текСтрока,Ложь,Цвета);
	КонецЕсли;
		
КонецПроцедуры
