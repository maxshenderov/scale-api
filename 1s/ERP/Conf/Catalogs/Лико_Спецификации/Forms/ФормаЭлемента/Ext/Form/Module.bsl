&НаСервере
Процедура ПересчитатьКоличествоВесНаСервере(Идентификатор,Имя) 
	
	Если Найти(Имя, "Товары") > 0 Тогда
		стр = Объект.Товары.НайтиПоИдентификатору(Идентификатор); 
	ИначеЕсли Найти(Имя, "Стоимость") > 0 Тогда
		стр = Объект.Стоимость.НайтиПоИдентификатору(Идентификатор); 
	КонецЕсли;
	
	Если Объект.Площадка = Справочники.Лико_Площадки.ИксПак Тогда
		Если Объект.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Пакеты Тогда
			ШагПечати = Объект.ЭтМЭР;
			ШиринаН = Объект.ДлинаЭтикетки*2/1000 + Объект.ГлубинаДнаПакета*2/1000
		ИначеЕсли Объект.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Термоусадка Тогда
			ШагПечати = Объект.ЭтМЭР;
			ШиринаН = Объект.ШиринаЭтикетки/1000;
		Иначе
			ШагПечати = Объект.ЭтМЭР;
			ШиринаН = Объект.ДлинаЭтикетки/1000;
		КонецЕсли;
		
		лРучьи = ?(ЗначениеЗаполнено(Объект.РучьиПечати),Объект.РучьиПечати,Объект.РучьиПечатиИндиго);
		
		Если ЗначениеЗаполнено(ШиринаН) И ЗначениеЗаполнено(ШагПечати) И ЗначениеЗаполнено(лРучьи) Тогда
			Если Имя = "ТоварыКоличество" ИЛИ Имя = "СтоимостьКоличество" Тогда
				Если ЗначениеЗаполнено(стр.Количество) Тогда
					МетражПМПоКоличеству = стр.Количество*1000*ШагПечати/лРучьи;
					МетражКвМПоКоличеству = МетражПМПоКоличеству*(ШиринаН)*лРучьи;
					стр.Вес = Окр(МетражКвМПоКоличеству*((((УдельныйВесПоЦеновымГруппамЗаказа() + УдельныйВесКраскиЗаказа())/1000)+ ВесЗиппера(ШагПечати))),3);
					//ШтукВОдномМетреКвадратном = ШагПечати * ШиринаН;
					//ВесОдногоИзделия = ((УдельныйВесПоЦеновымГруппамЗаказа() + УдельныйВесКраскиЗаказа())/1000) * ШтукВОдномМетреКвадратном;
					//стр.Вес = Окр(ВесОдногоИзделия * стр.Количество * 1000,3);
					Если Имя = "СтоимостьКоличество" И ЗначениеЗаполнено(Стр.Стоимость) И ЗначениеЗаполнено(стр.Вес) Тогда
						Стр.Стоимость1Кг = Стр.Стоимость/стр.Вес
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Имя = "ТоварыВес" ИЛИ Имя = "СтоимостьВес" Тогда
				Если ЗначениеЗаполнено(стр.Вес) Тогда
					МетражКвМПоВесу = МетражКвМПоУдельномуВесу(стр.Вес,ШагПечати);
					МетражПМПоВесу = МетражКвМПоВесу/((ШиринаН)*лРучьи);
					КоличествоПоВесу = Окр(МетражПМПоВесу/ШагПечати*лРучьи,3);
					стр.Количество = КоличествоПоВесу/1000;
					Если Имя = "СтоимостьКоличество" И ЗначениеЗаполнено(Стр.Стоимость) И ЗначениеЗаполнено(стр.Вес) Тогда
						Стр.Стоимость1Кг = Стр.Стоимость/стр.Вес
					КонецЕсли;
					//стр.КоличествоУпаковок = КоличествоПоВесу/1000;
				КонецЕсли;                                                      
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция УдельныйВесПоЦеновымГруппамЗаказа()
	УдельныйВесОсновногоМатериала = 0;
	УдельныйВесМатериалаВидовРабот = 0;
	УдельныйВес = 0;
	Если ЗначениеЗаполнено(Объект.ОсновнойМатериал) Тогда
		Если ТипЗнч(Объект.ОсновнойМатериал) = ТИП("СправочникСсылка.ЦеновыеГруппы") Тогда
			ОсновнойМатериал = Объект.ОсновнойМатериал
		Иначе
			ОсновнойМатериал = Объект.ОсновнойМатериал.ЦеноваяГруппа;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОсновнойМатериал.Лико_УдельныйВес) Тогда
			УдельныйВесОсновногоМатериала = ОсновнойМатериал.Лико_УдельныйВес;
			УдельныйВесМатериалаВидовРабот = 0;
			Для каждого стр Из Объект.Цвета Цикл
				Если ЗначениеЗаполнено(стр.Материал) И стр.НомерВарианта = 1 Тогда
					МатериалВидовРабот = стр.Материал;
					Если ТипЗнч(МатериалВидовРабот) = ТИП("СправочникСсылка.ЦеновыеГруппы") И ЗначениеЗаполнено(МатериалВидовРабот.Лико_УдельныйВес) Тогда
						УдельныйВесМатериалаВидовРабот = УдельныйВесМатериалаВидовРабот + МатериалВидовРабот.Лико_УдельныйВес;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	УдельныйВес = УдельныйВесОсновногоМатериала + УдельныйВесМатериалаВидовРабот; 
	Возврат УдельныйВес;
КонецФункции

&НаСервере
Функция УдельныйВесКраскиЗаказа()
	
	УдельныйВесКраски = 0;
	Для каждого стрЦвета Из Объект.Цвета Цикл
		Если стрЦвета.НомерВарианта = 1 Тогда 
			Если ЗначениеЗаполнено(стрЦвета.Грамматура) Тогда
				Грамматура = стрЦвета.Грамматура
			Иначе
				Грамматура = 1;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(стрЦвета.ПроцентЗаливки) Тогда
				ПроцентЗаливки = стрЦвета.ПроцентЗаливки/100;
			Иначе
				ПроцентЗаливки = 100/100;
			КонецЕсли;
			
			Если стрЦвета.ВидСекции = Справочники.Лико_ВидыСекций.ГлубокаяПечать ИЛИ стрЦвета.ВидСекции = Справочники.Лико_ВидыСекций.ГлубокаяЛаминация Тогда	
				Если ЗначениеЗаполнено(стрЦвета.ТипКраски.Лико_УдельныйВес) Тогда
					УдельныйВесКраски = УдельныйВесКраски + (стрЦвета.ТипКраски.Лико_УдельныйВес * ПроцентЗаливки);
				КонецЕсли;
				Продолжить;
			ИначеЕсли стрЦвета.ВидСекции = Справочники.Лико_ВидыСекций.ФлексоПечать Тогда
				КоэффициентКраскопереносаФлексоКраскиДляВеса = РегистрыСведений.Лико_ЗначенияКоэффициентовПереноса.СрезПоследних(ТекущаяДата(),Новый Структура("Площадка,Коэффициент",Объект.Площадка.Организация,Справочники.Лико_КоэффициентыДляРасчетов.КоэффициентКраскопереносаФлексоКраскиДляВеса));
				Если КоэффициентКраскопереносаФлексоКраскиДляВеса.Количество() > 0 Тогда
					КоэффициентКраскопереносаФлексоКраскиДляВеса = КоэффициентКраскопереносаФлексоКраскиДляВеса[0].Значение;
				Иначе
					Сообщить("Для организации " + Объект.Площадка.Организация + " не установлено значение ""Коэффициент краскопереноса флексо краски для веса""");
				КонецЕсли;
				УдельныйВесКраски = УдельныйВесКраски + (Грамматура * ПроцентЗаливки * КоэффициентКраскопереносаФлексоКраскиДляВеса);
				Продолжить;
			ИначеЕсли стрЦвета.ВидСекции = Справочники.Лико_ВидыСекций.ОфсетнаяПечать ИЛИ стрЦвета.ВидСекции = Справочники.Лико_ВидыСекций.БессольвентнаяЛаминация Тогда	
				УдельныйВесКраски = УдельныйВесКраски + (Грамматура * ПроцентЗаливки);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат УдельныйВесКраски;
	
КонецФункции

&НаСервере
Функция ВесЗиппера(ШагПечати)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Лико_СпецификацииЦвета.Ссылка КАК Ссылка,
	               |	Лико_СпецификацииЦвета.ВидСекции КАК ВидРабот
	               |ИЗ
	               |	Справочник.Лико_Спецификации.Цвета КАК Лико_СпецификацииЦвета
	               |ГДЕ
	               |	Лико_СпецификацииЦвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.УстановкаЗиппера)
	               |	И Лико_СпецификацииЦвета.Ссылка = &Заказ";
	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	Результат = Запрос.Выполнить().Выгрузить();
	КоличествоЗип = Результат.Количество();
	Вес = КоличествоЗип*(4*Объект.Ручьи/1000)*ШагПечати;
	Возврат Вес;
КонецФункции

&НаСервере
Функция МетражКвМПоУдельномуВесу(стрВес,ШагПечати)
	УдельныйВес = УдельныйВесПоЦеновымГруппамЗаказа();
	УдельныйВесКраски = УдельныйВесКраскиЗаказа();
	МетражКвМ = 0;
	Если ЗначениеЗаполнено(стрВес) И УдельныйВес <> 0 Тогда
		МетражКвМ = стрВес/(((УдельныйВес + УдельныйВесКраски)/1000)+ ВесЗиппера(ШагПечати));
	КонецЕсли;
	
	Возврат МетражКвМ;
КонецФункции

