			Иначе
				СтрокаЦвета = СтрокиЦвета[0]; 
				ЗаполнитьЗначенияСвойств(НоваяСтрока, стр);

				Если не ЗначениеЗаполнено(СтрокаЦвета.ТипКраски) Тогда
					Если ТипЗнч(стр.клей) = Тип("СправочникСсылка.ЦеновыеГруппы") Тогда
						СтрокаЦвета.ТипКраски	 = стр.клей; 
