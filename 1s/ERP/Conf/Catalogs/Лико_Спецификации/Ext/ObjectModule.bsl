
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если  ТипЗнч(ДанныеЗаполнения)= Тип("ДокументСсылка.ЗаказКлиента") Тогда
		ЗаполнитьНаОснованииЗаказаКлиента(ДанныеЗаполнения);
	КонецЕсли;	
КонецПроцедуры

Процедура  ЗаполнитьНаОснованииЗаказаКлиента(Знач Основание)
	Заказ = Основание;
	//стрВариант = ВариантыСпецификации.Добавить();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Заказ);

	Для каждого стрТовары Из Заказ.товары Цикл
		стр = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(стр, стрТовары);
	КонецЦикла;
	Для каждого стрЦвета Из Заказ.Цвета Цикл
		НоваяСтрЦвета =  Цвета.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрЦвета, стрЦвета);
		НоваяСтрЦвета.номерВарианта = 1;
		НоваяСтрЦвета.КлючСтроки = Новый УникальныйИдентификатор;
		СтрокиФорм = Заказ.Формы.НайтиСтроки(Новый Структура("КлючСтроки", СтрЦвета.КлючСтроки)) ;
		Для Каждого стрФорм из СтрокиФорм Цикл
			новаястрформ = Формы.добавить();
			ЗаполнитьЗначенияСвойств(новаястрформ, стрформ);
			новаястрформ.КлючСтроки = НоваяСтрЦвета.ключстроки;
		КонецЦикла;
		
	КонецЦикла;
	Для каждого стрРаботы Из Заказ.ВидыРабот Цикл
		НоваяСтрРаботы = ВидыРабот.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрРаботы, стрРаботы);
		НоваяСтрРаботы.номерВарианта = 1;
		НоваяСтрРаботы.КлючСтроки = Новый УникальныйИдентификатор;
	
	КонецЦикла;
	//СтрШтамп = ПараметрыШтампа.Добавить();
	//ЗаполнитьЗначенияСвойств(стрШтамп, Заказ);
	//СтрШтамп.НомерВарианта = 1;
		
КонецПроцедуры

