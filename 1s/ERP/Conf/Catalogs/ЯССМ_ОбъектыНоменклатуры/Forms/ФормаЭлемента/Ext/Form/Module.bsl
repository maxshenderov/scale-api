&НаКлиенте
 Процедура СрокГодностиПриИзменении(Элемент)
		УстановитьСрокГодности();

 КонецПроцедуры

&НаКлиенте
 Процедура ДатаПроизводстваПриИзменении(Элемент)
		УстановитьСрокГодности();

 КонецПроцедуры



 

Процедура УстановитьСрокГодности()
	
	
	СрокКодности=Объект.Номенклатура.Лико_СрокГодности;
	
	
	Если   ЗначениеЗаполнено(СрокКодности) Тогда
		
		
		Объект.УпотребитьДо=Объект.ДатаПроизводства+СрокКодности*24*60*60;
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ХарактеристикиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
	Элемент.ТекущиеДанные.Дата=ТекущаяДата();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеТаблицыК2() //+Лико m.shenderov 14.12.2022
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_БракСерий.Регистратор КАК Регистратор,
	|	Лико_БракСерий.Серия КАК Серия,
	|	Лико_БракСерий.Дефект КАК Дефект,
	|	Лико_БракСерий.ОписаниеДефекта КАК ОписаниеДефекта,
	|	Лико_БракСерий.Решение КАК Решение,
	|	Лико_БракСерий.КомментарийКРешению КАК КомментарийКРешению
	|ИЗ
	|	РегистрСведений.Лико_БракСерий КАК Лико_БракСерий
	|ГДЕ
	|	Лико_БракСерий.ОбъектНоменклатуры = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка );
	ПричиныК2.Загрузить(Запрос.Выполнить().Выгрузить());
	
	
КонецПроцедуры  //-Лико m.shenderov 14.12.2022


