Функция НайтиЗаказ(Наименование) //+Лико m.shenderov 06.02.2018
	Заказ=Неопределено;
	НомерСимвола=0;
	Для н=1 По СтрДлина(Наименование) Цикл
		
		Если  Сред(Наименование,н,1)="№" Тогда
			НомерСимвола=н; 
			Прервать;
		КонецЕсли;
		
		
		
		
	КонецЦикла;	
	
	Если НомерСимвола<>0 Тогда
		НомерЗаказа=Сред(Наименование,НомерСимвола+1,7);
		Заказ=Документы.ЗаказКлиента.НайтиПоРеквизиту("НомерБезПрефикса",НомерЗаказа);
		
	КонецЕсли;
	
	Возврат Заказ;
	
	
КонецФункции //-Лико m.shenderov 06.02.2018 


