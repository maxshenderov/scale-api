//Заполняет Коллекция по найденым штрихкодам
// Описание:
//
//
// Параметры Коллекция -Коллекция-
// Параметры ШтрихКоды -Массив- 
//
Процедура ЗаполнениеКоллекциюПоШтрихКоду(Коллекция,ШтрихКоды) Экспорт
	
	
	
	МассивКодов = Новый Массив();
	
	
	
	Для каждого ШК Из ШтрихКоды Цикл
		
		Результат=Лико_Дополнительно.РасшифроватьШК(ШК);
		
		Если Не ЗначениеЗаполнено(Результат.Ошибка) и
			Результат.ВидШК=Перечисления.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры_Короткий Тогда	
			МассивКодов.Добавить(Число(Сред(ШК, 8, 7)));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Результат.Ошибка) и
			Результат.ВидШК=Перечисления.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры Тогда	
			МассивКодов.Добавить(Число(Сред(ШК, 18, 7)));
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивКодов.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЯССМ_ОбъектыНоменклатуры.Номенклатура,
	|	ЯССМ_ОбъектыНоменклатуры.Количество,
	|	ЯССМ_ОбъектыНоменклатуры.БазоваяЕдиницаИзмерения КАК Упаковка,
	|	ЯССМ_ОбъектыНоменклатуры.ЕдиницаИзмеренияУУ КАК ЕдиницаИзмерения,
	|	ЯССМ_ОбъектыНоменклатуры.Серия,
	|	ЯССМ_ОбъектыНоменклатуры.Характеристика,
	|	ЯССМ_ОбъектыНоменклатуры.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	ВЫБОР
	|		КОГДА ЯССМ_ОбъектыНоменклатуры.Номенклатура.ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ХарактеристикиИспользуются,
	|	ЕСТЬNULL(ВариантыКомплектацииНоменклатуры.ВариантРасчетаЦеныНабора, ЗНАЧЕНИЕ(Перечисление.ВариантыРасчетаЦенНаборов.ПустаяСсылка)) КАК ВариантРасчетаЦеныНабора,
	|	ЯССМ_ОбъектыНоменклатуры.Ссылка
	|ИЗ
	|	Справочник.ЯССМ_ОбъектыНоменклатуры КАК ЯССМ_ОбъектыНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры КАК ВариантыКомплектацииНоменклатуры
	|		ПО ЯССМ_ОбъектыНоменклатуры.Номенклатура = ВариантыКомплектацииНоменклатуры.Владелец
	|			И ЯССМ_ОбъектыНоменклатуры.Характеристика = ВариантыКомплектацииНоменклатуры.Характеристика
	|			И (ВариантыКомплектацииНоменклатуры.Основной)
	|ГДЕ
	|	ЯССМ_ОбъектыНоменклатуры.Код В(&Коды)";
	Запрос.УстановитьПараметр("Коды",МассивКодов );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ТекДанные = Коллекция[ВРег(СокрЛП(ПолучитьКороткийШтрихКод(Выборка.Ссылка)))];
		Если ТекДанные=Неопределено Тогда
			ТекДанные = Коллекция[ВРег(СокрЛП(ПолучитьШтрихКод(Выборка.Ссылка)))];
			
		КонецЕсли;
		Если ТекДанные=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТекДанные.Номенклатура                    = Выборка.Номенклатура;
		ТекДанные.ТипНоменклатуры                 = Выборка.ТипНоменклатуры;
		ТекДанные.Характеристика                  = Выборка.Характеристика;
		ТекДанные.Упаковка                        = Выборка.Упаковка; 		
		Если ТипЗнч(ТекДанные)=Тип("Структура") И Не ТекДанные.Свойство("Серия") Тогда
			
			ТекДанные.Вставить("Серия",Выборка.Серия);
			
		КонецЕсли;
		
		ТекДанные.Серия                     	  = Выборка.Серия;
		
		ТекДанные.КоличествоУпаковок              = Выборка.Количество;
		//ТекДанные.ПодакцизныйТовар                = Выборка.ПодакцизныйТовар;
		//ТекДанные.МаркируемаяАлкогольнаяПродукция = Выборка.МаркируемаяАлкогольнаяПродукция;
		ТекДанные.ХарактеристикиИспользуются      = Выборка.ХарактеристикиИспользуются;
		ТекДанные.Коэффициент                     = Выборка.Упаковка.Числитель;
		ТекДанные.ЕдиницаИзмерения                = Выборка.ЕдиницаИзмерения;
		//ТекДанные.ЕдиничнаяУпаковка               = ?(Выборка.КоличествоЕдиничныхУпаковок = 1 И Выборка.Коэффициент = 1,
		//Выборка.ЕдиничнаяУпаковка,
		//Неопределено);
		//ТекДанные.НесколькоЕдиничныхУпаковок      = ?(Выборка.КоличествоЕдиничныхУпаковок > 1, Истина, Ложь);
		ТекДанные.НесколькоЕдиничныхУпаковок      = Ложь;
		
		ТекДанные.НеизвестныйШтрихкод             = Ложь;
		ТекДанные.ВариантРасчетаЦеныНабора        = Выборка.ВариантРасчетаЦеныНабора;
		
		
	КонецЦикла; 
	
	
	
	
КонецПроцедуры //ЗаполнениеКоллекцииПоШтрихКоду


Функция НайтиНеУникальныйОбъектНоменклатуры(Номенклатура,Знач Характеристика=Неопределено);
	Характеристика=?(Характеристика=Неопределено,Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(),Характеристика);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЯССМ_ОбъектыНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЯССМ_ОбъектыНоменклатуры КАК ЯССМ_ОбъектыНоменклатуры
	|ГДЕ
	|	ЯССМ_ОбъектыНоменклатуры.Номенклатура = &Номенклатура
	|	И НЕ ЯССМ_ОбъектыНоменклатуры.Уникальный
	|	И НЕ ЯССМ_ОбъектыНоменклатуры.ПометкаУдаления
	|	И ЯССМ_ОбъектыНоменклатуры.Характеристика = &Характеристика";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("Характеристика",Характеристика);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла; 
	
	Возврат Неопределено;
	
	
