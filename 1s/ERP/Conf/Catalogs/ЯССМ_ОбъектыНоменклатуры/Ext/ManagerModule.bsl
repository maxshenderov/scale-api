// Создает элемент справочника объекта номенклатуры и возвращает ссылку .
//
// Параметры: 
// СтруктураПараметров 			- Структура
// 				*Номенклатура    	-  СправочникСсылка.Номенклатура
// 				*Родитель        	-  СправочникСсылка.ЯССМ_ОбъектНоменклатуры  
// 				*Характеристика  	-  СправочникСсылка.ХарактеристикаНоменклатуры  
// 				*Нарезка         	-  СправочникСсылка.ЯССМ_Нарезки                 
// 				*Втулка          	-  СправочникСсылка.Лико_Втулка                  
// 				*Количество      	-  Число                                    
// 				*Упаковка       	-  СправочникСсылка.УпаковкиЕдиницыИзмерения
// 				*Уникальный     	-  Булево
// 				*Серия           	-  СправочникСсылка.Серия 
// 				*Рулонный           -  Булево 
// 				*НомерЗаказаКлиента -  Число 
// 				*НомерБланка        -  Число 
// 				*СерийныйНомер      -  Строка 
//              *Комментарий        -  Строка 
//              *Ответственный      -  СправочникСсылка.ФизическиеЛица. 
// Возвращаемое значение:  
//  СправочникСсылка - СправочникСсылка.ЯССМОбъектНоменклатуры
Функция СоздатьОбъектНоменклатуры(СтруктураПараметров) Экспорт
	//СтруктураПараметров = Новый Структура;

	//Номенклатура,Характеристика,Нарезка,Втулка,Количество,Упаковка,Уникальный=Ложь,Серия)
	Если СтруктураПараметров.Свойство("Серия") и 
		ЗначениеЗаполнено(СтруктураПараметров.Серия.ЯССМ_ОбъектНоменклатуры)
		И  СтруктураПараметров.Серия.ЯССМ_ОбъектНоменклатуры.Код<>0  Тогда
		ОбъектНоменклатуры=СтруктураПараметров.Серия.ЯССМ_ОбъектНоменклатуры.ПолучитьОбъект() ;
	Иначе 		
		ОбъектНоменклатуры =Справочники.ЯССМ_ОбъектыНоменклатуры.СоздатьЭлемент();
		Если СтруктураПараметров.Свойство("Организация") Тогда
			ОбъектНоменклатуры.Организация=СтруктураПараметров.Организация;		
		КонецЕсли;	
	КонецЕсли; 	

	Если СтруктураПараметров.Свойство("Номенклатура") Тогда
		ОбъектНоменклатуры.Номенклатура	=СтруктураПараметров.Номенклатура;
		ОбъектНоменклатуры.ЕдиницаИзмеренияУУ =СтруктураПараметров.Номенклатура.ЕдиницаИзмерения;
	КонецЕсли;

	Если СтруктураПараметров.Свойство("Родитель") Тогда
		ОбъектНоменклатуры.Родитель	=СтруктураПараметров.Родитель;		
	КонецЕсли;	
	Если СтруктураПараметров.Свойство("Характеристика") Тогда

		ОбъектНоменклатуры.Характеристика =СтруктураПараметров.Характеристика;
	КонецЕсли;
	Если СтруктураПараметров.Свойство("Нарезка") Тогда

		ОбъектНоменклатуры.Нарезка	=СтруктураПараметров.Нарезка;
	КонецЕсли;
	Если СтруктураПараметров.Свойство("Втулка") Тогда

		ОбъектНоменклатуры.Втулка	=СтруктураПараметров.Втулка;
	КонецЕсли;
	Если СтруктураПараметров.Свойство("Количество") Тогда

		ОбъектНоменклатуры.Количество	=СтруктураПараметров.Количество;
	КонецЕсли;
	Если СтруктураПараметров.Свойство("Упаковка") Тогда

		Если  НЕ  ЗначениеЗаполнено(ОбъектНоменклатуры.БазоваяЕдиницаИзмерения) Тогда
			ОбъектНоменклатуры.БазоваяЕдиницаИзмерения	=СтруктураПараметров.Упаковка;
		КонецЕсли;
	КонецЕсли;
	Если СтруктураПараметров.Свойство("Уникальный") Тогда

		ОбъектНоменклатуры.Уникальный=СтруктураПараметров.Уникальный;
	КонецЕсли;

	Если СтруктураПараметров.Свойство("Серия") Тогда

		ОбъектНоменклатуры.Серия=СтруктураПараметров.Серия;
	КонецЕсли; 

	Если СтруктураПараметров.Свойство("Комментарий") Тогда

		ОбъектНоменклатуры.Комментарий=СтруктураПараметров.Комментарий;
	КонецЕсли;
	Если СтруктураПараметров.Свойство("Ответственный") Тогда

		ОбъектНоменклатуры.Ответственный=СтруктураПараметров.Ответственный;
	КонецЕсли;
	Если СтруктураПараметров.Свойство("Рулонный") Тогда

		ОбъектНоменклатуры.Рулонный=СтруктураПараметров.Рулонный;
	КонецЕсли;

	Если СтруктураПараметров.Свойство("ЗаказКлиента") Тогда

		ОбъектНоменклатуры.ЗаказКлиента= СтруктураПараметров.ЗаказКлиента;

	КонецЕсли;

	Если СтруктураПараметров.Свойство("НомерЗаказаКлиента") Тогда

		ОбъектНоменклатуры.НомерЗаказаКлиента=СтруктураПараметров.НомерЗаказаКлиента;
		НомерЗаказаСтрока=Формат(СтруктураПараметров.НомерЗаказаКлиента,"ЧЦ=7; ЧГ=");
		Если  Не ЗначениеЗаполнено(ОбъектНоменклатуры.ЗаказКлиента) Тогда
			ОбъектНоменклатуры.ЗаказКлиента=Документы.ЗаказКлиента.НайтиПоРеквизиту("НомерБезПрефикса",НомерЗаказаСтрока);
		КонецЕсли;
	КонецЕсли;

	Если СтруктураПараметров.Свойство("НомерБланка") Тогда

		ОбъектНоменклатуры.НомерБланка=СтруктураПараметров.НомерБланка;
	КонецЕсли;

	Если СтруктураПараметров.Свойство("СерийныйНомер") Тогда 		
		ОбъектНоменклатуры.СерийныйНомер=СтруктураПараметров.СерийныйНомер;
	КонецЕсли;

	Если СтруктураПараметров.Свойство("НомерСетки") Тогда 		
		ОбъектНоменклатуры.НомерСетки=СтруктураПараметров.НомерСетки;
	КонецЕсли;

	Если СтруктураПараметров.Свойство("Z") Тогда 		
		ОбъектНоменклатуры.Z=СтруктураПараметров.Z;
	КонецЕсли;

	Если СтруктураПараметров.Свойство("Тип") Тогда 		
		ОбъектНоменклатуры.Тип=СтруктураПараметров.Тип;
	КонецЕсли;

	Если СтруктураПараметров.Свойство("ПроцентСетки") Тогда 		
		ОбъектНоменклатуры.ПроцентСетки=СтруктураПараметров.ПроцентСетки;
	КонецЕсли;

	Если СтруктураПараметров.Свойство("ДлинаСетки") Тогда 		
		ОбъектНоменклатуры.ДлинаСетки=СтруктураПараметров.ДлинаСетки;
	КонецЕсли;

	Если СтруктураПараметров.Свойство("УпотребитьДо") Тогда 		
		ОбъектНоменклатуры.УпотребитьДо=СтруктураПараметров.УпотребитьДо;
	КонецЕсли;
	Если СтруктураПараметров.Свойство("ДатаПроизводства") Тогда 		
		ОбъектНоменклатуры.ДатаПроизводства=СтруктураПараметров.ДатаПроизводства;
	КонецЕсли;
	Если СтруктураПараметров.Свойство("ВидКонтактаСПищевойПродукцией") Тогда 		
		ОбъектНоменклатуры.ВидКонтактаСПищевойПродукцией=СтруктураПараметров.ВидКонтактаСПищевойПродукцией;
	КонецЕсли;

	Если СтруктураПараметров.Свойство("НомерПартииИзготовления") Тогда 		
		ОбъектНоменклатуры.НомерПартииИзготовления=СтруктураПараметров.НомерПартииИзготовления;
	КонецЕсли;   
	
	Если СтруктураПараметров.Свойство("ПричинаОтсутствияНомераПартииИзготовления") Тогда 		
		ОбъектНоменклатуры.ПричинаОтсутствияНомераПартииИзготовления=СтруктураПараметров.ПричинаОтсутствияНомераПартииИзготовления;
	КонецЕсли;   
	Если СтруктураПараметров.Свойство("ПричинаОтсутствияДатыИзготовления") Тогда 		
		ОбъектНоменклатуры.ПричинаОтсутствияДатыИзготовления=СтруктураПараметров.ПричинаОтсутствияДатыИзготовления;
	КонецЕсли; 
	// --> Начало Лико Ефимов ЕВВ
	Если СтруктураПараметров.Свойство("СтатусРоликаПослеПеремотки") Тогда 		
		ОбъектНоменклатуры.СтатусРоликаПослеПеремотки=СтруктураПараметров.СтатусРоликаПослеПеремотки;
	КонецЕсли;   
	Если СтруктураПараметров.Свойство("КоличествоВРоликеПослеПеремотки") Тогда 		
		ОбъектНоменклатуры.КоличествоВРоликеПослеПеремотки=СтруктураПараметров.КоличествоВРоликеПослеПеремотки;
	КонецЕсли; 
	Если СтруктураПараметров.Свойство("НомерСтрокиЗаказаВРоликеПослеПеремотки") Тогда 		
		ОбъектНоменклатуры.НомерСтрокиЗаказаВРоликеПослеПеремотки=СтруктураПараметров.НомерСтрокиЗаказаВРоликеПослеПеремотки;
	КонецЕсли; 
	Если СтруктураПараметров.Свойство("РабочийЦентрВыпускаВРоликеПослеПеремотки") Тогда 		
		ОбъектНоменклатуры.РабочийЦентрВыпускаВРоликеПослеПеремотки=СтруктураПараметров.РабочийЦентрВыпускаВРоликеПослеПеремотки;
	КонецЕсли; 
	Если СтруктураПараметров.Свойство("СоставРоликаПослеПеремотки") Тогда
		Для каждого ЭлементМассива из СтруктураПараметров.СоставРоликаПослеПеремотки Цикл 
			ЗаполнитьЗначенияСвойств(ОбъектНоменклатуры.СоставРоликаПослеПеремотки.Добавить(), ЭлементМассива);
		КонецЦикла;
	КонецЕсли;
	Если СтруктураПараметров.Свойство("СтруктураРастарки") И СтруктураПараметров.СтруктураРастарки <> Неопределено Тогда
		ОбъектНоменклатуры.РаспоряжениеНаРастарку = СтруктураПараметров.СтруктураРастарки.Документ;	
		ОбъектНоменклатуры.НомерЦепочкиВРаспоряженииНаРастарку = СтруктураПараметров.СтруктураРастарки.НомерЦепочки;	
		ОбъектНоменклатуры.НомерСтрокиВРаспоряженииНаРастарку = СтруктураПараметров.СтруктураРастарки.НомерСтроки;
	КонецЕсли; 
	Если СтруктураПараметров.Свойство("РодительОбъектаНоменклатуры") Тогда
		ОбъектНоменклатуры.РодительОбъектаНоменклатуры = СтруктураПараметров.РодительОбъектаНоменклатуры;
	КонецЕсли;
	Если СтруктураПараметров.Свойство("Длина") Тогда
		ОбъектНоменклатуры.Длина = СтруктураПараметров.Длина;
	КонецЕсли;
	Если СтруктураПараметров.Свойство("Ширина") Тогда
		ОбъектНоменклатуры.Ширина = СтруктураПараметров.Ширина;
	КонецЕсли;
    // <-- Конец Лико Ефимов ЕВВ
	
	Если   Не ОбъектНоменклатуры.Уникальный Тогда  		
		НеУникальныйОбъектНоменклатуры=НайтиНеУникальныйОбъектНоменклатуры(ОбъектНоменклатуры.Номенклатура,ОбъектНоменклатуры.Характеристика);
		Если ЗначениеЗаполнено(НеУникальныйОбъектНоменклатуры) Тогда
			Возврат НеУникальныйОбъектНоменклатуры;			
		КонецЕсли;
	КонецЕсли;	

	УстановитьПривилегированныйРежим(Истина); 	

	ОбъектНоменклатуры.Записать();
	Если ОбъектНоменклатуры.Номенклатура.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра Тогда
		Если ОбъектНоменклатуры.Характеристика.Владелец<>ОбъектНоменклатуры.Номенклатура Тогда
			ОбъектНоменклатуры.Характеристика=ХарактеристикаНП(ОбъектНоменклатуры.Номенклатура);
		КонецЕсли; 		
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ОбъектНоменклатуры.Серия)и  ОбъектНоменклатуры.Уникальный  Тогда 		
		НоваяСерия=Справочники.СерииНоменклатуры.СоздатьЭлемент();
		НоваяСерия.ЯССМ_ОбъектНоменклатуры =ОбъектНоменклатуры.Ссылка;
		НоваяСерия.ВидНоменклатуры=ОбъектНоменклатуры.Номенклатура.ВидНоменклатуры;
		НоваяСерия.Наименование=ОбъектНоменклатуры.Наименование; 
		НоваяСерия.Записать();
		ОбъектНоменклатуры.Серия=НоваяСерия.Ссылка;
		ОбъектНоменклатуры.Записать();		
	КонецЕсли;

	Если  ЗначениеЗаполнено(ОбъектНоменклатуры.Серия) И
		ОбъектНоменклатуры.Серия.Наименование<>ОбъектНоменклатуры.Наименование Тогда
		СерияОбъект=ОбъектНоменклатуры.Серия.ПолучитьОбъект();
		СерияОбъект.ЯССМ_ОбъектНоменклатуры=ОбъектНоменклатуры.Ссылка;
		СерияОбъект.Записать();
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);


	Возврат ОбъектНоменклатуры.Ссылка; 

КонецФункции

// Функция получает 30-значный штрихкод Объекта номенклатуры
// управл.символ	вид информации		код номенклатуры     нарезка     количество     код элемента спр.  серийный номер     контр.символ
//      6                01                 1234567            123         1234             1234567            12345               N
Функция ПолучитьШтрихКод(Ссылка,ШКСтрокой="", лКоличество=0) Экспорт
	Перем ШК;
	Перем КодНоменклатуры7; // 7 символов справа
	ЭтотОбъект=Ссылка;	
	
	КодНоменклатуры7 = Прав(ЭтотОбъект.Номенклатура.Код, 7);
	
	ВидИнформации = ?(Ссылка.Уникальный, 1, 2);
	
	//=--------- ШК с пробелами и без -----
	// так было
	//ШК = "6"+ Формат(ВидИнформации, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0")
	//		+ Формат(КодНоменклатуры7, "ЧЦ=7; ЧН=0000000; ЧВН=; ЧГ=0")   // 7 правых символов кода номенклатуры
	//		+ Формат(ЭтотОбъект.Нарезка.Размер, "ЧЦ=3; ЧН=000; ЧВН=; ЧГ=0") // 3 символа нарезки
	//		+ Формат(ЭтотОбъект.Количество, "ЧЦ=4; ЧН=0000; ЧВН=; ЧГ=0") // 4 символа количества в поставке (вес банки, количество пог.метров)
	//		
	//		//+ Формат(ЭтотОбъект.НомерПоставки, "ЧЦ=12; ЧН=000000000000; ЧВН=; ЧГ=0"); // 12 символов серийного номера
	//		+ Формат(ЭтотОбъект.Код, "ЧЦ=7; ЧН=0000000; ЧВН=; ЧГ=0") // 7 символов код объекта номенклатуры
	//		+ Формат(ЭтотОбъект.НомерПоставки, "ЧЦ=5; ЧН=00000; ЧВН=; ЧГ=0"); // 5 символов серийного номера
	//		//+ Формат(ЭтотОбъект.Код,"ЧЦ="+ЭтотОбъект.Метаданные().ДлинаКода+"; ЧВН=; ЧГ=0");
	// так есть
	
	КоличествоВШтрихКоде = ?(лКоличество=0, ЭтотОбъект.Количество, лКоличество);
	
	ФВидИнформации = Формат(ВидИнформации, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");
	ФКодНоменклатуры7 = Формат(КодНоменклатуры7, "ЧЦ=7; ЧН=0000000; ЧВН=; ЧГ=0");   // 7 правых символов кода номенклатуры
	ФНарезка = Формат(ЭтотОбъект.Нарезка.Размер, "ЧЦ=3; ЧН=000; ЧВН=; ЧГ=0"); // 3 символа нарезки
	ФКоличество = Формат(КоличествоВШтрихКоде, "ЧЦ=4; ЧН=0000; ЧВН=; ЧГ=0"); // 4 символа количества в поставке (вес банки, количество пог.метров)Формат(ЭтотОбъект.Количество, "ЧЦ=4; ЧН=0000; ЧВН=; ЧГ=0") // 4 символа количества в поставке (вес банки, количество пог.метров)
	ФКод = Формат(ЭтотОбъект.Код, "ЧЦ=7; ЧН=0000000; ЧВН=; ЧГ=0"); // 7 символов код объекта номенклатуры
	ФНомерПоставки = Формат(ЭтотОбъект.НомерПоставки, "ЧЦ=5; ЧН=00000; ЧВН=; ЧГ=0"); // 5 символов серийного номера
	
	Разделитель = " ";
	
	ШК = "6"+ ФВидИнформации
	+ ФКодНоменклатуры7
	+ ФНарезка
	+ ФКоличество
	+ ФКод
	+ ФНомерПоставки;
	
	ШКСтрокой = "6"+ ФВидИнформации + Разделитель
	+ ФКодНоменклатуры7 + Разделитель
	+ ФНарезка + Разделитель
	+ ФКоличество + Разделитель
	+ ФКод + Разделитель
	+ ФНомерПоставки;
	
	КонтольныйСимвол = Лико_Дополнительно.ПосчитатьКонтрольнуюСуммуШК(ШК);
	ШК = ШК + КонтольныйСимвол;
	ШКСтрокой = ШКСтрокой + Разделитель + КонтольныйСимвол;
	
	Возврат ШК;
КонецФункции //ПолучитьШтрихКод Экспорт

// Функция получает 15-значный штрихкод Объекта номенклатуры
// управл.символ	вид информации		количество     код элемента спр.  контр.символ
//      6                05                 1234           1234567             N
Функция ПолучитьКороткийШтрихКод(Ссылка,ШКСтрокой="", лКоличество=0) Экспорт
	
	Перем ШК;
	Перем КодНоменклатуры7; // 7 символов справа
	ЭтотОбъект=Ссылка;	
	ВидИнформации = 5;
	
	КоличествоВШтрихКоде = ?(лКоличество=0, ЭтотОбъект.Количество, лКоличество);
	
	ФВидИнформации = Формат(ВидИнформации, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");
	ФКоличество = Формат(КоличествоВШтрихКоде, "ЧЦ=4; ЧН=0000; ЧВН=; ЧГ=0"); // 4 символа количества в поставке (вес банки, количество пог.метров)Формат(ЭтотОбъект.Количество, "ЧЦ=4; ЧН=0000; ЧВН=; ЧГ=0") // 4 символа количества в поставке (вес банки, количество пог.метров)
	ФКод = Формат(ЭтотОбъект.Код, "ЧЦ=7; ЧН=0000000; ЧВН=; ЧГ=0"); // 7 символов код объекта номенклатуры
	
	Разделитель = " ";
	
	ШК = "6"+ ФВидИнформации
	+ ФКоличество
	+ ФКод;
	
	ШКСтрокой = "6"+ ФВидИнформации + Разделитель
	+ ФКоличество + Разделитель
	+ ФКод;
	
	КонтольныйСимвол = Лико_Дополнительно.ПосчитатьКонтрольнуюСуммуШК(ШК);
	ШК = ШК + КонтольныйСимвол;
	ШКСтрокой = ШКСтрокой + Разделитель + КонтольныйСимвол;
	
	Возврат ШК;
КонецФункции //ПолучитьКороткийШтрихКод Экспорт

