		Если ТипЗнч(Документ)=Тип("ДокументСсылка.Лико_БланкЭтапа")  Тогда
			
			Если ЗначениеЗаполнено(Документ.ЗаказПокупателя) Тогда
				Возврат Документ;
			Иначе
				НоваяСерия=ПолучитьСериюРодителяСерии(Документ);
				Возврат ОпределеитьДокументЗакрытияБланкаСНомеромЗаказа(НоваяСерия);
			КонецЕсли;
			
			
			
		КонецЕсли;	
	КонецЕсли;
	
		Возврат Документы.Лико_БланкЭтапа.ПустаяСсылка();

