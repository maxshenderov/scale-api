	Если ЗначениеЗаполнено(Резерв) И Не ЗначениеЗаполнено(Партнер) Тогда
		Партнер = Резерв;
	КонецЕсли; 

	Если Не ЗначениеЗаполнено(Резерв)  Тогда
		Резерв = Справочники.Партнеры.ПустаяСсылка();
	КонецЕсли; 



	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Категория2 И Не Ссылка.Категория2 Тогда
		ДополнительныеСвойства.Вставить("Категория2");
	КонецЕсли; 	
	Если Не Рулонный и Не ЗначениеЗаполнено(БазоваяЕдиницаИзмерения) Или Не ЗначениеЗаполнено(БазоваяЕдиницаИзмерения.ЕдиницаИзмерения) Тогда
		Упаковка=Неопределено;
		Если Количество=0 Тогда
			Количество=1;
		КонецЕсли;		
		Лико_Дополнительно.ПроверитьНаличиеУпаковки(Номенклатура,Упаковка,Количество); 		
		БазоваяЕдиницаИзмерения=Упаковка;
	КонецЕсли;	
	Если Не ЭтоГруппа Тогда
		Если ЭтоНовый() Тогда			
			ОбработкаЗаполнения(Отказ);			
			Если Отказ Тогда
				Возврат;
			КонецЕсли;

			Если Не ЗначениеЗаполнено(НомерПоставки) Тогда
				ПоследнийНомерПоставки = ОпределитьПоследнийНомерПоставкиДляНоменклатуры(Номенклатура);				
				НомерПоставки =  ?(Уникальный,ПоследнийНомерПоставки+ 1, 0);
			КонецЕсли; 			
			ДатаФормирования = ТекущаяДата();
		КонецЕсли; 		
		СформироватьНаименованиеОбъекта();		
		КодНоменклатуры = Номенклатура.Код;		
	КонецЕсли;	
	Если ЗначениеЗаполнено(НомерЗаказаКлиента) И Не ЗначениеЗаполнено(ЗаказКлиента) ТОгда
		НомерЗаказаСтрока=Формат(НомерЗаказаКлиента,"ЧЦ=7; ЧГ=");
		Если СтрДлина(НомерЗаказаСтрока) = Метаданные.Документы.ЗаказКлиента.Реквизиты.НомерБезПрефикса.Тип.КвалификаторыСтроки.Длина Тогда // --> Начало Лико Ефимов ЕВВ 15.12.2021
			ЗаказКлиента=Документы.ЗаказКлиента.НайтиПоРеквизиту("НомерБезПрефикса",НомерЗаказаСтрока);
		КонецЕсли;       

	КонецЕсли;


	Если Не ЗначениеЗаполнено(Серия) Тогда
		НоваяСерия=Справочники.СерииНоменклатуры.СоздатьЭлемент();		
		Если ЭтоНовый() Тогда
			НоваяСсылка=Справочники.ЯССМ_ОбъектыНоменклатуры.ПолучитьСсылку();
			УстановитьСсылкуНового(НоваяСсылка);
		КонецЕсли;

		НоваяСерия.ЯССМ_ОбъектНоменклатуры 	=НоваяСсылка;
		НоваяСерия.ВидНоменклатуры			=Номенклатура.ВидНоменклатуры;
		НоваяСерия.Наименование				=Наименование; 
		Попытка   			
			НоваяСерия.Записать();
			Серия								=НоваяСерия.Ссылка;
		Исключение
			//ОписаниеОшибки()
		КонецПопытки;



	КонецЕсли; 	

	Если Рулонный Тогда
		//ЗакрытиеБланка =Справочники.ЯССМ_ОбъектыНоменклатуры.ОпределеитьДокументЗакрытияБланкаСНомеромЗаказа(Серия);
		//ЗаказКлиента   =ЗакрытиеБланка.ЗаказПокупателя;
	КонецЕсли;
	BRC_БлокировкаВК=Ложь;


	Если Не  ЗначениеЗаполнено(ВидКонтактаСПищевойПродукцией) Тогда
		ВидКонтактаСПищевойПродукцией=Номенклатура.Лико_ВидКонтактаСПищевойПродукцией;
	КонецЕсли;


	Если ДатаПроизводства=УпотребитьДо Тогда
		ОстаточныйСрокГодности=0;
	ИначеЕсли ЗначениеЗаполнено(ДатаПроизводства) и ЗначениеЗаполнено(УпотребитьДо)   Тогда

		ОстаточныйСрокГодности= (УпотребитьДо-ДатаФормирования)/(УпотребитьДо-ДатаПроизводства)*100;
	КонецЕсли;
	Массив = Новый Массив();
	Массив.Добавить(Справочники.Лико_ВидыКонтактовСПищевойПродукцией.ПрямойКонтакт);
	Массив.Добавить(Справочники.Лико_ВидыКонтактовСПищевойПродукцией.НепрямойКонтакт);



	Если ЗначениеЗаполнено(ОстаточныйСрокГодности)И
		ПриходныйОрдер.BRC_РешениеОПриемке<>Перечисления.BRC_РешенияОПриемке.ПринятьСЗамечаниями И
		Массив.Найти(ВидКонтактаСПищевойПродукцией)<>Неопределено И
		ОстаточныйСрокГодности<50  Тогда
		BRC_БлокировкаВК=Истина;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВидКонтактаСПищевойПродукцией)И
		Номенклатура.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра Тогда

		ВидКонтактаСПищевойПродукцией=ЗакрытиеБланка.ЗаказПокупателя.ВидКонтактаСПищевойПродукцией;
		Если Не ЗначениеЗаполнено(Номенклатура.Лико_ВидКонтактаСПищевойПродукцией) И ЗначениеЗаполнено(ВидКонтактаСПищевойПродукцией) Тогда
			НоменклатураОбъект= Номенклатура.ПолучитьОбъект();
			НоменклатураОбъект.Лико_ВидКонтактаСПищевойПродукцией=ВидКонтактаСПищевойПродукцией;
			НоменклатураОбъект.Записать();
		КонецЕсли;
	КонецЕсли;



	Если ЗначениеЗаполнено(ВидКонтактаСПищевойПродукцией)И
		Номенклатура.ВидНоменклатуры<>Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_КритерииВходногоКонтроляВидыКонтактов.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВтКритерии
		|ИЗ
		|	Справочник.Лико_КритерииВходногоКонтроля.ВидыКонтактов КАК Лико_КритерииВходногоКонтроляВидыКонтактов
		|ГДЕ
		|	Лико_КритерииВходногоКонтроляВидыКонтактов.ВидКонтакта = &ВидКонтакта
		|	И Лико_КритерииВходногоКонтроляВидыКонтактов.Блокировать 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВтКритерии.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЯССМ_ОбъектыНоменклатуры.Лико_ПараметрыВходногоКонтроля КАК ЯССМ_ОбъектыНоменклатурыЛико_ПараметрыВходногоКонтроля
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтКритерии КАК ВтКритерии
		|		ПО ЯССМ_ОбъектыНоменклатурыЛико_ПараметрыВходногоКонтроля.Критерий = ВтКритерии.Ссылка
		|ГДЕ
		|	ЯССМ_ОбъектыНоменклатурыЛико_ПараметрыВходногоКонтроля.Ссылка = &Ссылка
		|	И НЕ ЯССМ_ОбъектыНоменклатурыЛико_ПараметрыВходногоКонтроля.НесоответствиеНеВыявлено
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВтКритерии.Ссылка
		|ИЗ
		|	Документ.ПриходныйОрдерНаТовары.Лико_ПараметрыВходногоКонтроля КАК ПриходныйОрдерНаТоварыЛико_ПараметрыВходногоКонтроля
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтКритерии КАК ВтКритерии
		|		ПО ПриходныйОрдерНаТоварыЛико_ПараметрыВходногоКонтроля.Критерий = ВтКритерии.Ссылка
		|ГДЕ
		|	ПриходныйОрдерНаТоварыЛико_ПараметрыВходногоКонтроля.Ссылка = &ПриходныйОрдер
		|	И НЕ ПриходныйОрдерНаТоварыЛико_ПараметрыВходногоКонтроля.НесоответствиеНеВыявлено";
		Запрос.УстановитьПараметр("Ссылка",Ссылка );
		Запрос.УстановитьПараметр("ПриходныйОрдер",ПриходныйОрдер );
		Запрос.УстановитьПараметр("ВидКонтакта",ВидКонтактаСПищевойПродукцией);

		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() И ЗначениеЗаполнено(ПриходныйОрдер) И ПриходныйОрдер.BRC_РешениеОПриемке<>Перечисления.BRC_РешенияОПриемке.ПринятьСЗамечаниями Тогда
			BRC_БлокировкаВК=Истина;  
		КонецЕсли;
	КонецЕсли;

   
	Если (ЗначениеЗаполнено(НомерПартииИзготовления) Или ЗначениеЗаполнено(ПричинаОтсутствияНомераПартииИзготовления)) И 
		(ЗначениеЗаполнено(ДатаПроизводства) Или ЗначениеЗаполнено(ПричинаОтсутствияДатыИзготовления)) Тогда
		ЕстьПартияПроизводства=Истина;
	Иначе
		ЕстьПартияПроизводства=Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаПроизводства) И ЗначениеЗаполнено(УпотребитьДо) Тогда
		
		
		Площадка=ПриходныйОрдер.Склад.Лико_Площадка;
		Если Не ЗначениеЗаполнено(Площадка) Тогда
			Площадка=ЗакрытиеБланка.Склад.Лико_Площадка;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Площадка) Тогда 
			СрокГодности = РегистрыСведений.Лико_СрокиГодностиНоменклатуры. Контролировать(Площадка, Номенклатура, ТекущаяДата());
			
			Если ЗначениеЗаполнено(СрокГодности) Тогда
				ДатаПроизводства = УпотребитьДо -(60*60*24*СрокГодности); 
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	

КонецПроцедуры



// 
Процедура ОбработкаЗаполнения(Отказ)
Если Не Рулонный Тогда	
	Возврат;
КонецЕсли;

	
	//=--------- Проверка на уникальность/неуникальность -----
	Если ЗначениеЗаполнено(Номенклатура)  Тогда
		ЗапросНаУникальность = Новый Запрос;
		ЗапросНаУникальность.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ВложенныйЗапрос.КоличествоУникальных, 0) КАК КоличествоУникальных,
		|	ЕСТЬNULL(ВложенныйЗапрос.КоличествоНеуникальных, 0) КАК КоличествоНеуникальных
		|ИЗ
		|	(ВЫБРАТЬ
		|		СУММА(ВЫБОР
		|				КОГДА ЯССМ_ОбъектыНоменклатуры.Уникальный
		|					ТОГДА 1
		|				ИНАЧЕ 0
		|			КОНЕЦ) КАК КоличествоУникальных,
		|		СУММА(ВЫБОР
		|				КОГДА НЕ ЯССМ_ОбъектыНоменклатуры.Уникальный
		|					ТОГДА 1
		|				ИНАЧЕ 0
		|			КОНЕЦ) КАК КоличествоНеуникальных
		|	ИЗ
		|		Справочник.ЯССМ_ОбъектыНоменклатуры КАК ЯССМ_ОбъектыНоменклатуры
		|	ГДЕ
		|		ЯССМ_ОбъектыНоменклатуры.Номенклатура = &Номенклатура
		|		И НЕ ЯССМ_ОбъектыНоменклатуры.ПометкаУдаления
		|		И ЯССМ_ОбъектыНоменклатуры.Тип = &Тип) КАК ВложенныйЗапрос";
		
		ЗапросНаУникальность.УстановитьПараметр("Номенклатура", Номенклатура);
		ЗапросНаУникальность.УстановитьПараметр("Тип", Справочники.ЯССМ_ТипыОбъектаНоменклатуры.ПустаяСсылка());

		
		// Если создаем уникальный объект, то в базе не должно быть ни одного неуникального.
		// Если создаем НЕуникальный объект, то в базе не должно быть ни одного вообще (кроме создаваемого).
		
		РезультатЗапросаНаУникальность = ЗапросНаУникальность.Выполнить().Выбрать();
		
		Если РезультатЗапросаНаУникальность.Следующий() Тогда
			ТекстСообщенияДляКлиента = "";
			
			Если Не Уникальный И РезультатЗапросаНаУникальность.КоличествоУникальных>0 Тогда
				ТекстСообщенияДляКлиента = "Нельзя создать объект!" + Символы.ПС + "Для номенклатуры (код номенкл. " +Номенклатура.Код+ ") """ + Номенклатура+ """ можно создать только уникальный объект!";
			ИначеЕсли Не Уникальный И РезультатЗапросаНаУникальность.КоличествоНеуникальных>0 Тогда
				ТекстСообщенияДляКлиента = "Нельзя создать объект!" + Символы.ПС + "Для номенклатуры (код номенкл. " +Номенклатура.Код+ ") """ + Номенклатура+ """ уже создан неуникальный объект!";
			ИначеЕсли Уникальный И РезультатЗапросаНаУникальность.КоличествоНеуникальных И Не ЗначениеЗаполнено(Тип) Тогда
				ТекстСообщенияДляКлиента = "Нельзя создать объект!" + Символы.ПС + "Для номенклатуры (код номенкл. " +Номенклатура.Код+ ") """ + Номенклатура+ """ уже создан неуникальный объект!";
			КонецЕсли;
			
			Если ТекстСообщенияДляКлиента<>"" Тогда
				Лико_ДополнительноКлиентСервер.СообщитьДляКлиента(ТекстСообщенияДляКлиента, СтатусСообщения.Важное);
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//---------=
	
КонецПроцедуры //ОбработкаЗаполнения

