Процедура ПриЗаписи(Отказ)
	УстановитьПривилегированныйРежим(Истина);

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если  ЗначениеЗаполнено(Серия) И
		Серия.Наименование<>Наименование Тогда
		СерияОбъект=Серия.ПолучитьОбъект();
		СерияОбъект.ЯССМ_ОбъектНоменклатуры=Ссылка;
		СерияОбъект.Записать();
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если НЕ Отказ и ДополнительныеСвойства.Свойство("Категория2") Тогда
		Попытка
			ОтправитьСообщениеПоОСнастке(); 
		Исключение
			//ОписаниеОшибки()
		КонецПопытки;
		
	КонецЕсли;
	
	
КонецПроцедуры


Процедура ОтправитьСообщениеПоОСнастке()
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказКлиентаВидыРабот.Оснастка КАК Оснастка,
	|	МАКСИМУМ(ЗаказКлиентаВидыРабот.Ссылка.Дата) КАК Дата
	|ПОМЕСТИТЬ ВТДаты
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Оснастка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаВидыРабот.Оснастка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДаты.Оснастка КАК Оснастка,
	|	ЗаказКлиентаВидыРабот.ВидРабот КАК ВидРабот,
	|	ЗаказКлиентаВидыРабот.Ссылка КАК Заказ
	|ПОМЕСТИТЬ ВТЗаказ
	|ИЗ
	|	ВТДаты КАК ВТДаты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|		ПО ВТДаты.Оснастка = ЗаказКлиентаВидыРабот.Оснастка
	|			И ВТДаты.Дата = ЗаказКлиентаВидыРабот.Ссылка.Дата,
	|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТДаты.Оснастка,
	|	ЗаказКлиентаВидыРабот.ВидРабот,
	|	ЗаказКлиентаВидыРабот.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЗаказ.Заказ КАК Заказ,
	|	ВТЗаказ.Оснастка КАК Оснастка,
	|	СУММА(ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.МетражДляРЦ, 0)) КАК Метраж,
	|	ВТЗаказ.Заказ.ШагПечати КАК ШагПечати,
	|	ВТЗаказ.Заказ.Z КАК Z,
	|	Лико_ЗаказыНаОснасткуСрезПоследних.ЗаказНаОснастку КАК ЗаказНаОснастку,
	|	ВТЗаказ.ВидРабот КАК ВидРабот
	|ПОМЕСТИТЬ ВТПлан
	|ИЗ
	|	ВТЗаказ КАК ВТЗаказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|		ПО ВТЗаказ.Заказ = Лико_ПараметрыПроизводстваЗаказа.Заказ
	|			И ВТЗаказ.Заказ.РабочийЦентр = Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр
	|			И (Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1)
	|			И (ВТЗаказ.Заказ.Состояние = ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаказов.ВключенВПлан))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЗаказыНаОснастку.СрезПоследних КАК Лико_ЗаказыНаОснасткуСрезПоследних
	|		ПО ВТЗаказ.Оснастка = Лико_ЗаказыНаОснасткуСрезПоследних.Номенклатура
	|			И (Лико_ЗаказыНаОснасткуСрезПоследних.Статус <> ЗНАЧЕНИЕ(Перечисление.Лико_СтатусыЗаказовНаОснастку.Поступил))
	|			И (Лико_ЗаказыНаОснасткуСрезПоследних.Статус <> ЗНАЧЕНИЕ(Перечисление.Лико_СтатусыЗаказовНаОснастку.Отменен))
	|ГДЕ
	|	Лико_ЗаказыНаОснасткуСрезПоследних.ЗаказНаОснастку ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТЗаказ.Заказ,
	|	ВТЗаказ.Заказ.ШагПечати,
	|	ВТЗаказ.Заказ.Z,
	|	Лико_ЗаказыНаОснасткуСрезПоследних.ЗаказНаОснастку,
	|	ВТЗаказ.Оснастка,
	|	ВТЗаказ.ВидРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПлан.Оснастка КАК Оснастка,
	|	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры КАК СерияЯССМ_ОбъектНоменклатуры,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК КоличествоОстаток,
	|	Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбщаяНаработка КАК ОбщаяНаработка,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА ВТПлан.Z <> ЗНАЧЕНИЕ(Справочник.Лико_ZКоличествоЗубьев.ПустаяСсылка)
	|				ТОГДА Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбщаяНаработка / (ВТПлан.Z.КоличествоЗубьев * 3.175 / 1000)
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ВТПлан.ШагПечати <> 0
	|						ТОГДА Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбщаяНаработка / ВТПлан.ШагПечати
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		КОНЕЦ КАК ЧИСЛО(15, 0)) КАК КоличествоУдаровФакт
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	ВТПлан КАК ВТПлан
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_НаработкиОбъектовНоменклатуры.СрезПоследних КАК Лико_НаработкиОбъектовНоменклатурыСрезПоследних
	|		ПО ВТПлан.Оснастка = Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбъектНоменклатуры.Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки КАК ТоварыВЯчейкахОстатки
	|		ПО ВТПлан.Оснастка = ТоварыВЯчейкахОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОстатки.Оснастка КАК Оснастка,
	|	СУММА(ВТОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	|	СУММА(ВТОстатки.КоличествоУдаровФакт) КАК КоличествоУдаровФакт
	|ПОМЕСТИТЬ ВТОстаткиИтог
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТОстатки.Оснастка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПлан.Оснастка КАК Оснастка,
	|	ВТПлан.Оснастка.Артикул КАК Артикул,
	|	ВТПлан.ВидРабот КАК ВидРабот,
	|	ВТПлан.Заказ КАК Заказ,
	|	ВТПлан.Заказ.Менеджер КАК Менеджер,
	|	ВТОстаткиИтог.КоличествоОстаток КАК КоличествоОстаток,
	|	ВТОстаткиИтог.КоличествоУдаровФакт КАК КоличествоУдаровФакт,
	|	ВТПлан.ЗаказНаОснастку КАК ЗаказНаОснастку,
	|	ВТПлан.Заказ.Этикетки КАК Этикетки
	|ИЗ
	|	ВТПлан КАК ВТПлан
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстаткиИтог КАК ВТОстаткиИтог
	|		ПО ВТПлан.Оснастка = ВТОстаткиИтог.Оснастка
	|ГДЕ
	|	(ВТОстаткиИтог.КоличествоОстаток ЕСТЬ NULL
	|			ИЛИ (ВЫРАЗИТЬ(ВЫБОР
	|					КОГДА ВТПлан.Z <> ЗНАЧЕНИЕ(Справочник.Лико_ZКоличествоЗубьев.ПустаяСсылка)
	|						ТОГДА ВТПлан.Метраж / (ВТПлан.Z.КоличествоЗубьев * 3.175 / 1000)
	|					ИНАЧЕ ВЫБОР
	|							КОГДА ВТПлан.ШагПечати <> 0
	|								ТОГДА ВТПлан.Метраж / ВТПлан.ШагПечати
	|							ИНАЧЕ 0
	|						КОНЕЦ
	|				КОНЕЦ КАК ЧИСЛО(15, 0))) + ВТОстаткиИтог.КоличествоУдаровФакт > 3000000)
	|ИТОГИ ПО
	|	Менеджер";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	ВыборкаМенеджер = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Менеджер");
	ОтветственныйЗаОснастку = Справочники.Лико_ПредопределенныеЗначения.ПользовательОтветственныйЗаОснастку.ЗначениеПараметра;
	Пока ВыборкаМенеджер.Следующий() Цикл
		СтрОснастки = "";
		Выборка = ВыборкаМенеджер.Выбрать();
		Пока Выборка.Следующий() Цикл
			стрОснастки = СтрОснастки+ " Штамп "+Выборка.Оснастка.Артикул+ " использовался в заказе N" +Выборка.Заказ.НомерБезПрефикса+" для печати этикеток "+ Выборка.Этикетки+";  "+Символы.ПС ;	
			стрОснастки = "Для штампа "+Выборка.Оснастка.Артикул+ " установлена ""Категория 2""" ;	
			
		КонецЦикла;
		
		
		Адресат = Новый  СписокЗначений;
		Адресат.Добавить(ВыборкаМенеджер.Менеджер);
		Адресат.Добавить(ОтветственныйЗаОснастку);
		текст = стрОснастки+":          "+ Символы.ПС+стрОснастки;
		Тема = стрОснастки;
		Лико_Планирование.ОтправитьПисьмо(текст, Тема, Адресат) ;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры
