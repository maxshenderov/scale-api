// Определяет запросом последний порядковый номер для данной номенклатуры
Функция ОпределитьПоследнийНомерПоставкиДляНоменклатуры(Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(ЯССМ_ОбъектыНоменклатуры.НомерПоставки) КАК НомерПоставки
	               |ИЗ
	               |	Справочник.ЯССМ_ОбъектыНоменклатуры КАК ЯССМ_ОбъектыНоменклатуры
	               |ГДЕ
	               |	ЯССМ_ОбъектыНоменклатуры.Номенклатура = &Номенклатура
	               |	И НЕ ЯССМ_ОбъектыНоменклатуры.ПометкаУдаления";
	Запрос.УстановитьПараметр("Номенклатура", ЭтотОбъект.Номенклатура);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаРезультата = РезультатЗапроса.Выбрать();
		ВыборкаРезультата.Следующий();
		
		Если ВыборкаРезультата.НомерПоставки=NULL Тогда
			Возврат 0; // первый объект данной номенклатуры
		Иначе
			Возврат ВыборкаРезультата.НомерПоставки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции //ОпределитьПоследнийНомерПоставкиДляНоменклатуры

Процедура ПриКопировании(ОбъектКопирования)
	
