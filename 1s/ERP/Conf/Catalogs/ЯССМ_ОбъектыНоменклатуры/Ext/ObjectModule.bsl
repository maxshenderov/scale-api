// Формирует наименование объекта как номенклатура + нарезка + втулка + номер поставки
Процедура СформироватьНаименованиеОбъекта() Экспорт
	
	НовоеНаименование = СокрЛП(Номенклатура.Наименование)
	+ ?(ЗначениеЗаполнено(Номенклатура.Артикул), ", ("+Номенклатура.Артикул+")", "")
	// {{ DGavrilov 20150930
	//+ ?(ЗначениеЗаполнено(НомерБланка), ", бл."+НомерБланка, "")
	+ ?(Номенклатура.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыПолуфабрикат.ЗначениеПараметра,
	?(ЗначениеЗаполнено(НомерБланка), ", бл."+НомерБланка, ""),
	"")
	// }} DGavrilov 20150930
	+ ?(ЗначениеЗаполнено(Нарезка), ", Ø"+Нарезка+" ", "")
	+ ?(ЗначениеЗаполнено(Втулка), ?(ЗначениеЗаполнено(Нарезка), "", ", ")+"("+Втулка+")", "")
	+ ?(СокрЛП(Комментарий)="", "", ", " + СокрЛП(Комментарий))
	// --> Начало Лико Ефимов ЕВВ 03.03.2026 
	//+ ?(Уникальный И Количество<>0, ", "+Количество+" "+БазоваяЕдиницаИзмерения, "")
	// Если заполнена Длина, то выведем размер остатка
	+ ?(ЗначениеЗаполнено(Длина) И ЗначениеЗаполнено(Ширина), ", " + БазоваяЕдиницаИзмерения + " " + Длина + "см*" + Ширина + "см",
	// иначе оставим как было
	?(Уникальный И Количество<>0, ", "+Количество+" "+БазоваяЕдиницаИзмерения, ""))
	// <-- Конец Лико Ефимов ЕВВ 03.03.2026
	+ ?(НомерПоставки=0, "", ", #"+Формат(НомерПоставки, "ЧГ=0"))
	// --> Начало Лико Ефимов ЕВВ 06.04.2026
	// Добавлю уникальный номер родителя
	+ ?(ЗначениеЗаполнено(РодительОбъектаНоменклатуры), " (из #" + РодительОбъектаНоменклатуры.НомерПоставки + ")", "") 
	// <-- Конец Лико Ефимов ЕВВ 06.04.2026
	;
	
	НовоеНаименованиеКороткое="";					
	НовоеНаименованиеКороткое=	 ?(Номенклатура.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыПолуфабрикат.ЗначениеПараметра,
	?(ЗначениеЗаполнено(НомерБланка), ", бл."+НомерБланка, ""),	"")
	// }} DGavrilov 20150930
	+ ?(ЗначениеЗаполнено(Нарезка), ", Ø"+Нарезка+" ", "")
	+ ?(ЗначениеЗаполнено(Втулка), ?(ЗначениеЗаполнено(Нарезка), "", ", ")+"("+Втулка+")", "")
	+ ?(СокрЛП(Комментарий)="", "", ", " + СокрЛП(Комментарий))
	// --> Начало Лико Ефимов ЕВВ 03.03.2026 
	//+ ?(Уникальный И Количество<>0, ", "+Количество+" "+БазоваяЕдиницаИзмерения, "")
	// Если заполнены Длина и Ширина, то выведем размер остатка
	+ ?(ЗначениеЗаполнено(Длина) И ЗначениеЗаполнено(Ширина), ", " + БазоваяЕдиницаИзмерения + " " + Длина + "см*" + Ширина + "см",
	// иначе оставим как было
	?(Уникальный И Количество<>0, ", "+Количество+" "+БазоваяЕдиницаИзмерения, ""))
	// <-- Конец Лико Ефимов ЕВВ 03.03.2026
	+ ?(НомерПоставки=0, "", ", #"+Формат(НомерПоставки, "ЧГ=0"));
	
	Если СтрДлина(НовоеНаименованиеКороткое)>0 Тогда
		НовоеНаименованиеКороткое=Прав(НовоеНаименованиеКороткое, СтрДлина(НовоеНаименованиеКороткое)-1);	
	КонецЕсли;			
	//// добавление номера бланка
	//Если ЗначениеЗаполнено(НомерБланка) И Номенклатура.ВидНоменклатуры=Перечисления.видыноме Тогда
	//	НовоеНаименование = СтрЗаменить(НовоеНаименование, " (", " / "+НомерБланка+" ("
	//КонецЕсли;
	
	Если СокрЛП(Наименование)<>СокрЛП(НовоеНаименование) Тогда
		Наименование = НовоеНаименование;
	КонецЕсли;
	
	Если СокрЛП(НаименованиеКороткое)<>СокрЛП(НовоеНаименованиеКороткое) Тогда
		НаименованиеКороткое = НовоеНаименованиеКороткое;
	КонецЕсли;
	
	
