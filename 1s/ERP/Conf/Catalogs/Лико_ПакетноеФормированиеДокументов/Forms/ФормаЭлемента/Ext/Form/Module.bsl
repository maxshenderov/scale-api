&НаКлиенте
Процедура СписокДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	ОписаниеОповещение=Новый ОписаниеОповещения("СписокДокументовВыборЗавершение",ЭтотОбъект);
	//ПоказатьВыборИзСписка(ОписаниеОповещение,СписокДокументов(),Элементы.ДокументОснование); 
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДокументОснование",Объект.Наименование);
	СтруктураПараметров.Вставить("Документ",Объект.СписокДокументов.НайтиПоИдентификатору(ВыбраннаяСтрока).ДокументИмя);
	СтруктураПараметров.Вставить("Реквизиты",СписокРеквизитов(Объект.СписокДокументов.НайтиПоИдентификатору(ВыбраннаяСтрока).ДокументИмя));	
	ОткрытьФорму("Справочник.Лико_ПакетноеФормированиеДокументов.Форма.ФормаРеквизитовДокумента",СтруктураПараметров,ЭтаФорма,,,,ОписаниеОповещение);
	
КонецПроцедуры
&НаКлиенте 
Процедура СписокДокументовВыборЗавершение(РезультатФормы,ПараметрыФормы) Экспорт //+Лико m.shenderov 08.09.2017
	ИмяТекущегоДокумента=Объект.СписокДокументов.НайтиПоИдентификатору(Элементы.СписокДокументов.ТекущаяСтрока).ДокументИмя;
	
	Если    РезультатФормы<>Неопределено Тогда
		Объект.РеквизитыДокументов.НайтиСтроки(Новый Структура("ДокументИмя",ИмяТекущегоДокумента)).Очистить();
		
		Для каждого ВыбРекДок Из РезультатФормы Цикл
			НоваяСтрока=Объект.РеквизитыДокументов.Добавить();
			НоваяСтрока.ДокументИмя=ИмяТекущегоДокумента;
			НоваяСтрока.РеквизитИмя=ВыбРекДок.Имя;
			НоваяСтрока.РеквизитСиноним=ВыбРекДок.Синоним;
			НоваяСтрока.Формула=ВыбРекДок.Формула;
			
		КонецЦикла;
	КонецЕсли 	
КонецПроцедуры //СписокДокументовВыборЗавершение -Лико m.shenderov 08.09.2017

&НаСервере
Функция СписокРеквизитов(ДокументИмя) //+Лико m.shenderov 08.09.2017
	Массив = Новый Массив();
	НайденыеСтроки=Объект.РеквизитыДокументов.НайтиСтроки(Новый Структура("ДокументИмя",ДокументИмя));  		 
	
	Для каждого НСтрока Из НайденыеСтроки Цикл
		Структура = Новый Структура;
		Структура.Вставить("Имя",НСтрока.РеквизитИмя);
		Структура.Вставить("Формула",НСтрока.Формула);	
		Массив.Добавить(Структура);		
	КонецЦикла;
	Возврат Массив;
	
КонецФункции //СписокРеквизитов -Лико m.shenderov 08.09.2017


