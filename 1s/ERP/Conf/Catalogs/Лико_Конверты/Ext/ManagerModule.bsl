 // Функция получает 15-значный штрихкод Объекта номенклатуры
// управл.символ	вид информации		код конверта     нарезка     количество     серийный номер     контр.символ
//      6                01                 1234567            123         1234          123456789012           N
Функция ПолучитьШтрихКод(ЭтотОбъект,ШКСтрокой="") Экспорт
	
	Перем ШК;
	
	ВидИнформации = 4;
	
	//=--------- ШК с пробелами и без -----
	// так было
	//ШК = "6"+ Формат(ВидИнформации, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0")
	//		+ Формат(КодНоменклатуры7, "ЧЦ=7; ЧН=0000000; ЧВН=; ЧГ=0")   // 7 правых символов кода номенклатуры
	//		+ Формат(ЭтотОбъект.Нарезка.Размер, "ЧЦ=3; ЧН=000; ЧВН=; ЧГ=0") // 3 символа нарезки
	//		+ Формат(ЭтотОбъект.Количество, "ЧЦ=4; ЧН=0000; ЧВН=; ЧГ=0") // 4 символа количества в поставке (вес банки, количество пог.метров)
	//		
	//		//+ Формат(ЭтотОбъект.НомерПоставки, "ЧЦ=12; ЧН=000000000000; ЧВН=; ЧГ=0"); // 12 символов серийного номера
	//		+ Формат(ЭтотОбъект.Код, "ЧЦ=7; ЧН=0000000; ЧВН=; ЧГ=0") // 7 символов код объекта номенклатуры
	//		+ Формат(ЭтотОбъект.НомерПоставки, "ЧЦ=5; ЧН=00000; ЧВН=; ЧГ=0"); // 5 символов серийного номера
	//		//+ Формат(ЭтотОбъект.Код,"ЧЦ="+ЭтотОбъект.Метаданные().ДлинаКода+"; ЧВН=; ЧГ=0");
	// так есть
	
	ФВидИнформации = Формат(ВидИнформации, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");
	ФКод = ЭтотОбъект.Код;
	
	Разделитель = " ";
	
	ШК = "6"+ ФВидИнформации
			+ ФКод;
	
	ШКСтрокой = "6"+ ФВидИнформации + Разделитель
			+ ФКод + Разделитель;
			
	КонтольныйСимвол = Лико_Дополнительно.ПосчитатьКонтрольнуюСуммуШК(ШК);
	ШК = ШК + КонтольныйСимвол;
	ШКСтрокой = ШКСтрокой + КонтольныйСимвол;
	
	Возврат ШК;
КонецФункции //ПолучитьШтрихКод Экспорт
 
Функция ПечатьКонверта(Конверт) Экспорт 
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Конверт);
	
	Возврат ПечатьЗадания(МассивОбъектов, Неопределено);

КонецФункции // ПечатьКонверта()

Процедура СоздатьРаспечататьКонверт(ГруппаКонвертов, Тип, Индекс,ТабличныйДокумент, Конверт) Экспорт
	
	Префикс = ГруппаКонвертов.ПрефиксГруппы;
	
	ПолныйКод = "" + СокрЛП(Префикс) + Формат(Индекс, "ЧЦ=7; ЧН=0000000; ЧВН=; ЧГ=0") + "/" + Формат(Тип, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");
	
	Конверт = Справочники.Лико_Конверты.НайтиПоКоду(ПолныйКод);
	
	Если Не ЗначениеЗаполнено(Конверт) Тогда
		НовыйКонверт = Справочники.Лико_Конверты.СоздатьЭлемент();
		НовыйКонверт.Код = ПолныйКод;
		НовыйКонверт.Наименование = ПолучитьБезПрефикса(ПолныйКод);
		НовыйКонверт.ТипКонверта = Тип;
		НовыйКонверт.Родитель = ГруппаКонвертов;
		НовыйКонверт.Организация = ГруппаКонвертов.Организация;
		НовыйКонверт.Площадка = ГруппаКонвертов.Площадка;
		НовыйКонверт.Записать();
		
		КонвертОбъект = НовыйКонверт;
		Конверт = НовыйКонверт.Ссылка;
		
	Иначе
		
		КонвертОбъект = Конверт.ПолучитьОбъект();
		
	КонецЕсли;
	
	КоличествоКопий = 1;
	ТабличныйДокумент = ПечатьКонверта(Конверт);
	
	
	
КонецПроцедуры //СоздатьРаспечататьКонверт

Функция ПолучитьБезПрефикса(Знач КодНомер, УдалятьВедущиеНули=Истина) Экспорт
	
	КодНомер = СокрЛП(КодНомер);
	
	// удаление ведущих букв
	Завершили = Ложь;
	Пока Не Завершили Цикл
		
		Если СтрДлина(КодНомер)=0 Тогда
			Завершили = Истина;
		КонецЕсли;
		
		Символ1 = Лев(КодНомер, 1);
		Если Символ1="0" Или Символ1="1" Или Символ1="2" Или Символ1="3" Или Символ1="4"
			Или Символ1="5"Или Символ1="6" Или Символ1="7" Или Символ1="8" Или Символ1="9" Тогда
			Завершили = Истина;
		КонецЕсли;
		
		Если Не Завершили Тогда
			КодНомер = Сред(КодНомер, 2);
		КонецЕсли;
		
	КонецЦикла;
	
	// удаление ведущих нулей
	Если УдалятьВедущиеНули Тогда
		
		Пока Лев(КодНомер, 1)="0" Цикл
			КодНомер = Сред(КодНомер, 2);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат КодНомер;

КонецФункции // ПолучитьБезПрефиксов()

Функция МаксимальныйНомерКонверта(ТипКонверта, ГруппаКонвертов) Экспорт 
	Результат=0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(Лико_Конверты.Код) КАК Код
	|ПОМЕСТИТЬ ВтИтог
	|ИЗ
	|	Справочник.Лико_Конверты КАК Лико_Конверты
	|ГДЕ
	|	Лико_Конверты.ТипКонверта = &ТипКонверта
	|	И Лико_Конверты.Родитель = &Родитель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтИтог.Код КАК Код
	|ИЗ
	|	ВтИтог КАК ВтИтог
	|ГДЕ
	|	НЕ ВтИтог.Код ЕСТЬ NULL";
	Запрос.УстановитьПараметр("ТипКонверта",ТипКонверта ); 
	Запрос.УстановитьПараметр("Родитель",ГруппаКонвертов );

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Результат = ЧислоПоКоду(Выборка.Код);
	
	КонецЦикла; 
	
	//Если ЗначениеЗаполнено(Результат) Тогда
	//	Результат =  ЧислоПоКоду(Результат);
	//КонецЕсли;
	//
	
   Возврат Результат;


КонецФункции 

Функция НомерКонверта(Конверт) Экспорт 
	
	Возврат ЧислоПоКоду(Конверт.Код); 
	
	
	
КонецФункции  


