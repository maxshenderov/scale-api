Функция РасходыПоВиду(Организация,ВидРасхрда) Экспорт  //+Лико m.shenderov 12.02.2024
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Лико_ВидыДопРасходовНаПоступлениеМатериаловОрганизации.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВтРасходыПоОрганизации
	|ИЗ
	|	Справочник.Лико_ВидыДопРасходовНаПоступлениеМатериалов.Организации КАК Лико_ВидыДопРасходовНаПоступлениеМатериаловОрганизации
	|ГДЕ
	|	Лико_ВидыДопРасходовНаПоступлениеМатериаловОрганизации.Организация = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_ВидыДопРасходовНаПоступлениеМатериаловДопРасходы.Валюта КАК Валюта,
	|	Лико_ВидыДопРасходовНаПоступлениеМатериаловДопРасходы.ДопРасход КАК Расход,
	|	Лико_ВидыДопРасходовНаПоступлениеМатериаловДопРасходы.Сумма КАК Сумма,
	|	Лико_ВидыДопРасходовНаПоступлениеМатериаловДопРасходы.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВтРасходыПоОрганизации КАК ВтРасходыПоОрганизации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ВидыДопРасходовНаПоступлениеМатериалов.ДопРасходы КАК Лико_ВидыДопРасходовНаПоступлениеМатериаловДопРасходы
	|		ПО ВтРасходыПоОрганизации.Ссылка = Лико_ВидыДопРасходовНаПоступлениеМатериаловДопРасходы.Ссылка
	|ГДЕ
	|	Лико_ВидыДопРасходовНаПоступлениеМатериаловДопРасходы.Ссылка = &ВидРасхрда
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Организация",Организация );
	Запрос.УстановитьПараметр("ВидРасхрда",ВидРасхрда );
	
	Возврат Запрос.Выполнить().Выгрузить();
	
	
	
	
КонецФункции //-Лико m.shenderov 12.02.2024 
