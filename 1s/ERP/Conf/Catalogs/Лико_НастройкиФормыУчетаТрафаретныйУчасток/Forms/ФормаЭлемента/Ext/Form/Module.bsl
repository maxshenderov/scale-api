&НаСервере
Функция ПолучитьСписок() //+Лико m.shenderov 29.04.2019  
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеновыеГруппы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЦеновыеГруппы КАК ЦеновыеГруппы
	|ГДЕ
	|	ЦеновыеГруппы.Наименование ПОДОБНО ""%Сетка%""";
	
	Массив= Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	СписокЗначений = Новый СписокЗначений;
	Для каждого М Из Массив Цикл
		СписокЗначений.Добавить(М);
	КонецЦикла;
	Возврат СписокЗначений;
КонецФункции  //-Лико m.shenderov 29.04.2019
