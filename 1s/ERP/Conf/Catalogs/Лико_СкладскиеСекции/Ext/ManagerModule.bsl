Функция ДобавлениеИзменениеСекции(Стеллаж, Этаж, НомерСекции) 
	
	Место=(НомерСекции - 1) * 3 + 1;

	Код = КодСекции( Стеллаж.КодПолный,Место,Этаж.НомерСтроки);
	
	Секция =Секция( Стеллаж, Этаж.НомерСтроки, Код);
	
	Если ЗначениеЗаполнено(Секция) Тогда 
		
		Секция = Секция.ПолучитьОбъект();
		
	Иначе
		Секция = Справочники.Лико_СкладскиеСекции.СоздатьЭлемент();
		
	КонецЕсли;
	
	Секция.ПометкаУдаления=Ложь;

	Секция.Стеллаж           = Стеллаж;
	Секция.Склад             = Стеллаж.Склад;
	Секция.Этаж              = Этаж.НомерСтроки;
	Секция.Типоразмер        = Этаж.Типоразмер;
	Секция.Ряд               = Стеллаж.КодПолный;
	Секция.Место             = Место;
	Секция.Места             = СтрШаблон("%1-%2-%3", Секция.Место, Секция.Место + 1, Секция.Место + 2);
	Секция.Адрес1            = АдресХранения(Секция.Ряд,Секция.Место,Секция.Этаж);
	Секция.Адрес2            = АдресХранения(Секция.Ряд,Секция.Место+1,Секция.Этаж);
	Секция.Адрес3            = АдресХранения(Секция.Ряд,Секция.Место+2,Секция.Этаж);
	Секция.АдресЦентр        = Секция.Адрес2;
	Секция.КоличествоАдресов = 3; 
	
	Секция.МинимальнаяГлубинаНеОграничена 	=  Этаж.МинимальнаяГлубинаНеОграничена; 
	Секция.МаксимальнаяГлубинаНеОграничена 	=  Этаж.МаксимальнаяГлубинаНеОграничена;
	Секция.МаксимальныйВесПодъёмаНаЭтаж 	=  Этаж.МаксимальныйВесПодъёмаНаЭтаж;
	Секция.ЗазорПоШирине 					=  Этаж.ЗазорПоШирине;

	
	Секция.Записать();
	
	ЗаписатьСекциюВАдрес(Секция.Ссылка);
	
	

КонецФункции

Функция Секция(Стеллаж, Этаж, НомерСекции) 
	Результат=Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_СкладскиеСекции.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
	|ГДЕ
	|	Лико_СкладскиеСекции.Стеллаж = &Стеллаж
	|	И Лико_СкладскиеСекции.Код = &НомерСекции
	|	И Лико_СкладскиеСекции.Этаж = &Этаж";
	Запрос.УстановитьПараметр("Стеллаж",Стеллаж );
	Запрос.УстановитьПараметр("Этаж",Этаж );
	Запрос.УстановитьПараметр("НомерСекции",НомерСекции);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.Ссылка;
	КонецЦикла; 
	
	
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьСекциюВАдрес(Секция) 
	
	СпрОбъект =  Секция.Адрес1.ПолучитьОбъект();
	СпрОбъект.Лико_Секция =Секция;
	СпрОбъект.ПометкаУдаления=Ложь;
	СпрОбъект.Записать(); 
	
	СпрОбъект =  Секция.Адрес2.ПолучитьОбъект();
	СпрОбъект.Лико_Секция =Секция;
	СпрОбъект.ПометкаУдаления=Ложь;
	СпрОбъект.Записать();

	
	СпрОбъект =  Секция.Адрес3.ПолучитьОбъект();
	СпрОбъект.Лико_Секция =Секция;
	СпрОбъект.ПометкаУдаления=Ложь;
	СпрОбъект.Записать();


КонецПроцедуры 

Функция АдресХранения(Ряд, Место, Этаж) 
	
	 Результат = Неопределено;
	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СкладскиеЯчейки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
	|ГДЕ
	|	НЕ СкладскиеЯчейки.ЭтоГруппа
	|	И СкладскиеЯчейки.Код = &Код";
	
	Код = СтрШаблон("Р%1М%2Э%3",Ряд,Место,Этаж);

	Запрос.УстановитьПараметр("Код",Код );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл  
		
		Результат = Выборка.Ссылка;
	
	КонецЦикла; 
	
	
	
	Возврат Результат;

КонецФункции

Функция КодСекции(Ряд, Место, Этаж) Экспорт  	
	
	Места = СтрШаблон("%1-%2-%3", Место, Место + 1, Место + 2);
	Код   = СтрШаблон("Р%1-М(%2-%3-%4)-Э%5"
		,Ряд
		,Формат(Место,"ЧЦ=2; ЧВН=")
		,Формат(Место+1,"ЧЦ=2; ЧВН=")
		,Формат(Место+2,"ЧЦ=2; ЧВН=")
		,Формат(Этаж,"ЧЦ=2; ЧВН=")); 
		
		Возврат Код;
	
КонецФункции  


