			//Возврат Массив;
		КонецЕсли;
		
		// 1a.Проверка: На секции установлен запрет размещения (синхронизировано с ПодобратьЯчейку)
		Если Секция.ЗапретРазмещения Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: на секции """ + Строка(Секция.Код) + """ установлен запрет размещения. Выберите другую секцию.");
			Иначе
				Массив.Добавить("Ошибка: на данной секции установлен запрет размещения.");
