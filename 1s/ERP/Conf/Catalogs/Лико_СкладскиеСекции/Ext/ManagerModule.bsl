	|							ИЛИ ВтСекцииСОстатками.Паллет3 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка))
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Ширина > ВтСекцииСОстатками.Типоразмер.Ширина / 2
	|				ТОГДА ВтСекцииСОстатками.Адрес2
	|			КОГДА &Ширина > ВтСекцииСОстатками.Типоразмер.Ширина / 3
	|				ТОГДА ВЫБОР
	|						КОГДА ВтСекцииСОстатками.Паллет1 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|							ТОГДА ВтСекцииСОстатками.Адрес1
	|						ИНАЧЕ ВтСекцииСОстатками.Адрес3
	|					КОНЕЦ
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ВтСекцииСОстатками.Паллет1 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|						ТОГДА ВтСекцииСОстатками.Адрес1
	|					КОГДА ВтСекцииСОстатками.Паллет2 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|							И ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер1.Ширина, 0) <= ВтСекцииСОстатками.Типоразмер.Ширина / 3
	|							И (ВтСекцииСОстатками.Паллет3 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|								ИЛИ ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер3.Ширина, 0) <= ВтСекцииСОстатками.Типоразмер.Ширина / 3)
	|						ТОГДА ВтСекцииСОстатками.Адрес2
	|					КОГДА ВтСекцииСОстатками.Паллет3 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|						ТОГДА ВтСекцииСОстатками.Адрес3
	|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
	|				КОНЕЦ
	|		КОНЕЦ <> ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_ИТОГ.Секция КАК Секция,
	|	ВТ_ИТОГ.ВерсияДанных КАК ВерсияДанных,
	|	ВТ_ИТОГ.ПометкаУдаления КАК ПометкаУдаления,
	|	ВТ_ИТОГ.Код КАК Код,
	|	ВТ_ИТОГ.Наименование КАК Наименование,
	|	ВТ_ИТОГ.Стеллаж КАК Стеллаж,
	|	ВТ_ИТОГ.Ряд КАК Ряд,
	|	ВТ_ИТОГ.Место КАК Место,
	|	ВТ_ИТОГ.Этаж КАК Этаж,
	|	ВТ_ИТОГ.Адрес1 КАК Адрес1,
	|	ВТ_ИТОГ.Адрес2 КАК Адрес2,
	|	ВТ_ИТОГ.Адрес3 КАК Адрес3,
	|	ВТ_ИТОГ.Типоразмер КАК Типоразмер,
	|	ВТ_ИТОГ.Склад КАК Склад,
	|	ВТ_ИТОГ.АдресЦентр КАК АдресЦентр,
	|	ВТ_ИТОГ.КоличествоАдресов КАК КоличествоАдресов,
	|	ВТ_ИТОГ.Места КАК Места,
	|	ВТ_ИТОГ.ВремяДоступа КАК ВремяДоступа,
	|	ВТ_ИТОГ.Паллет1 КАК Паллет1,
	|	ВТ_ИТОГ.Паллет2 КАК Паллет2,
	|	ВТ_ИТОГ.Паллет3 КАК Паллет3,
	|	ВТ_ИТОГ.Типоразмер1 КАК Типоразмер1,
	|	ВТ_ИТОГ.Типоразмер2 КАК Типоразмер2,
	|	ВТ_ИТОГ.Типоразмер3 КАК Типоразмер3,
	|	ВТ_ИТОГ.ОстатокШирина КАК ОстатокШирина,
	|	ВТ_ИТОГ.ОстатокВес КАК ОстатокВес,
	|	ВТ_ИТОГ.ОстатокВысота КАК ОстатокВысота,
	|	ВТ_ИТОГ.УровеньДоступа КАК УровеньДоступа,
	|	ВТ_ИТОГ.Адрес КАК Адрес,
	|	ВТ_ИТОГ.ПотенциалСекции КАК ПотенциалСекции,
	|	ВТ_ИТОГ.МаксимальнаяШиринаПаллетаВРяду КАК МаксимальнаяШиринаПаллетаВРяду,
	|	ВТ_ИТОГ.НомерРяда КАК НомерРяда,
	|	ВТ_ИТОГ.ДельтаГрузоподъемности КАК ДельтаГрузоподъемности,
	|	ВТ_ИТОГ.МаксКоличествоТекПаллетаВСекции КАК МаксКоличествоТекПаллетаВСекции,
	|	ВТ_ИТОГ.ГрузоподъемностьЯчейки КАК ГрузоподъемностьЯчейки,
	|	ВТ_ИТОГ.ОстатокВесЯчейка КАК ОстатокВесЯчейка,
	|	ВТ_ИТОГ.Узкопроходный КАК Узкопроходный,
	|	ВТ_ИТОГ.МинимальнаяГлубинаНеОграничена КАК МинимальнаяГлубинаНеОграничена,
	|	ВТ_ИТОГ.ТипоразмерВес КАК ТипоразмерВес,
	|	ВТ_ИТОГ.ПотенциалПоВесу КАК ПотенциалПоВесу,
	|	ВЫБОР
	|		КОГДА ВТ_ИТОГ.ПотенциалПоВесу - ВТ_ИТОГ.ПотенциалСекции >= 0
	|			ТОГДА ВТ_ИТОГ.ПотенциалСекции
	|		ИНАЧЕ ВТ_ИТОГ.ПотенциалПоВесу
	|	КОНЕЦ КАК ПотенциалИтого,
	|	ВТ_ИТОГ.ТипПотенциала КАК ТипПотенциала
	|ИЗ
	|	ВТ_ИТОГ КАК ВТ_ИТОГ
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ВТ_ИТОГ.КоличествоПаллетВСекции = 1
	|				ТОГДА ВТ_ИТОГ.ОстатокШирина - &Ширина - 150 >= 0
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА ВТ_ИТОГ.КоличествоПаллетВСекции = 2
	|				ТОГДА ВТ_ИТОГ.ОстатокШирина - &Ширина - 200 >= 0
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Узкопроходный УБЫВ,
	|	МинимальнаяГлубинаНеОграничена,
	|	ПотенциалИтого УБЫВ,
	|	ОстатокВысота,
	|	ДельтаГрузоподъемности,
	|	ПотенциалСекции УБЫВ,
	|	ПотенциалПоВесу УБЫВ,
	|	ОстатокВесЯчейка,
	|	ТипоразмерВес,
	|	ОстатокШирина,
	|	ОстатокВес,
	|	УровеньДоступа УБЫВ,
	|	ВремяДоступа УБЫВ";
	
	
	// Если параметр ОбратныйПорядокВремени = Истина, то меняем сортировку по времени на убывающую
	Если Не ОбратныйПорядокВремени Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"	ВремяДоступа УБЫВ",
		"	ВремяДоступа"); 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"	УровеньДоступа УБЫВ",
		"	УровеньДоступа"); 
		
			
			
	КонецЕсли;
	
	Если Не Потенциал3ПаллетаВСекции Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"	ПотенциалСекции УБЫВ",
			"	ПотенциалСекции");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"	ПотенциалПоВесу УБЫВ",
			"	ПотенциалПоВесу");
        	Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"	ПотенциалИтого УБЫВ",
			"	ПотенциалИтого");


	Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"_Приоритет4_ПотенцилаСекции_Убыв",
			"_Приоритет4_ПотенцилаСекции"); 
	
	КонецЕсли;
	
	Если Все Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ВЫБРАТЬ ПЕРВЫЕ 1",
			"ВЫБРАТЬ");
	
		
	КонецЕсли;
	
	
	
	Запрос.УстановитьПараметр("Склад",Склад );
	Запрос.УстановитьПараметр("Высота",  Высота );
	Запрос.УстановитьПараметр("Ширина",  Ширина );
	Запрос.УстановитьПараметр("Глубина", Глубина);
	Запрос.УстановитьПараметр("Вес",Вес );
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Все Тогда
		
		Результат = РезультатЗапроса.Выгрузить();
		
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Результат = Выборка.Адрес; 
			
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции  


Функция ПодобратьЯчейкуРейтинг(Склад, Высота,Ширина,Глубина,Вес,ОбратныйПорядокВремени=Ложь,Все=Ложь) Экспорт 
	
// ----------------------------------------------------------------------------
// НАЗНАЧЕНИЕ:
//   Подбирает складскую ячейку (адрес) для размещения одного паллета заданных
//   габаритов и веса. Занятость мест берётся из регистра Лико_ПаллетыВСекциях.
//
// ПАРАМЕТРЫ:
//   Склад                  - СправочникСсылка. Склад поиска.
//   Высота, Ширина,
//   Глубина, Вес           - Число. Габариты и вес паллета.
//   ОбратныйПорядокВремени - Булево (Ложь). Ложь = ближние/быстрые ячейки первыми;
//                            Истина = дальние/медленные первыми.
//   Все                    - Булево (Ложь). Ложь = одна лучшая ячейка (ПЕРВЫЕ 1);
//                            Истина = ТЗ всех подходящих ячеек в порядке приоритета.
//
// ВОЗВРАТ:
//   - Все = Ложь: СправочникСсылка.СкладскиеЯчейки (адрес) либо пустая ссылка.
//   - Все = Истина: ТаблицаЗначений подходящих ячеек.
//
// ----------------------------------------------------------------------------
// ФИЛЬТРЫ (жёсткие условия отбора):
//
//   Уровень секции (ВТСекции.ГДЕ):
//     - не помечена на удаление, нет ЗапретРазмещения, принадлежит &Склад;
//     - Типоразмер: Глубина >= &Глубина, Высота >= &Высота;
//     - по весу: НеОграниченаПоГрузоподъемности ИЛИ Типоразмер.Вес >= &Вес;
//     - МаксимальныйВесПодъёмаНаЭтаж = 0 ИЛИ >= &Вес;
//     - мин/макс ширина и глубина стеллажа (0 = ограничение снято, плюс
//       флаги Минимальная/МаксимальнаяГлубинаНеОграничена).
//
//   Уровень секции с остатками (ВТ_ИТОГ.ГДЕ):
//     - есть свободное место (Паллет1/2/3 = ПустаяСсылка);
//     - свободной ширины >= Ширина_секции / 3;
//     - хватает свободного веса секции (или секция безлимитна);
//     - средняя ячейка (Паллет2) занята только узким паллетом (<= Ш/3);
//     - конфигурация свободных мест допускает паллет заданной ширины
//       (правила для >Ш/2, >Ш/3, <=Ш/3);
//     - вычисленный Адрес размещения не пустой.
//
//   Финальный фильтр монтажных зазоров (итоговый запрос, ГДЕ):
//     - если в секции 1 паллет: ОстатокШирина - &Ширина - 150 >= 0;
//     - если в секции 2 паллета: ОстатокШирина - &Ширина - 200 >= 0;
//     - иначе (пустая секция) — без доп. зазора.
//
// ----------------------------------------------------------------------------
// ПРИОРИТЕТЫ (УПОРЯДОЧИТЬ ПО) — строго в порядке кода:
//
//   1. Узкопроходные стеллажи первыми        Узкопроходный УБЫВ
//   2. Ограничение глубины первыми           МинимальнаяГлубинаНеОграничена ASC
//        Ложь (с бортиками) раньше, Истина (с дном) — в конец.
//   3. Итоговый потенциал секции             ПотенциалИтого УБЫВ
//        ПотенциалИтого = МИН(ПотенциалСекции, ПотенциалПоВесу):
//          - ПотенциалСекции  — сколько паллет ещё влезет по ширине (0/2/3),
//            с поправкой -50 мм к порогу Ш/3 для паллет 800..900 мм;
//          - ПотенциалПоВесу  — ЦЕЛ(Вес_секции / &Вес), безлимит = 3.
//        Направление зависит от Потенциал3ПаллетаВСекции (узкий паллет <= Ш/3):
//          узкий  → УБЫВ (пустые/гибкие секции первыми);
//          широкий→ ASC  (секции с исчерпанным потенциалом первыми).
//   4. Best-fit по высоте                    ОстатокВысота ASC
//   5. Best-fit по грузоподъёмности секции   ДельтаГрузоподъемности ASC
//        Дельта = Типоразмер.Вес - &Вес; безлимит = 999999 (в конец).
//   6. Потенциал по ширине                   ПотенциалСекции УБЫВ (см. п.3 по напр.)
//   7. Потенциал по весу                     ПотенциалПоВесу УБЫВ (см. п.3 по напр.)
//   8. Best-fit по весу ячейки               ОстатокВесЯчейка ASC
//        = Типоразмер.Вес / макс_паллетов_в_секции - &Вес.
//   9. Полная грузоподъёмность секции        ТипоразмерВес ASC
//  10. Остаток ширины секции                 ОстатокШирина ASC
//  11. Остаток веса секции                   ОстатокВес ASC
//  12. Горизонтальная зона доступа           УровеньДоступа
//        1 — ближняя зона, 2 — дальняя.
//        ОбратныйПорядокВремени = Ложь → ASC (ближние первыми);
//        Истина → УБЫВ (дальние первыми).
//  13. Время доступа                         ВремяДоступа
//        Ложь → ASC (быстрый первым); Истина → УБЫВ (медленный первым).
//
// ПРИМЕЧАНИЕ по управлению порядком (СтрЗаменить):
//   По умолчанию поля 12 и 13 записаны с УБЫВ; при ОбратныйПорядокВремени = Ложь
//   они заменяются на ASC. При Потенциал3ПаллетаВСекции = Ложь поля
//   ПотенциалИтого / ПотенциалСекции / ПотенциалПоВесу меняются с УБЫВ на ASC.
// ============================================================================

// ============================================================================	Результат = Справочники.СкладскиеЯчейки.ПустаяСсылка();
	
	ШиринаЯчейки = Справочники.Лико_ПредопределенныеЗначения.ШиринаСкладскойСекции.ЗначениеПараметра/3;
	
	Потенциал3ПаллетаВСекции=Ширина<=ШиринаЯчейки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_СкладскиеСекции.Ссылка КАК Ссылка,
	|	Лико_СкладскиеСекции.ВерсияДанных КАК ВерсияДанных,
	|	Лико_СкладскиеСекции.ПометкаУдаления КАК ПометкаУдаления,
	|	Лико_СкладскиеСекции.Код КАК Код,
	|	Лико_СкладскиеСекции.Наименование КАК Наименование,
	|	Лико_СкладскиеСекции.Стеллаж КАК Стеллаж,
	|	Лико_СкладскиеСекции.Ряд КАК Ряд,
	|	Лико_СкладскиеСекции.Место КАК Место,
	|	Лико_СкладскиеСекции.Этаж КАК Этаж,
	|	Лико_СкладскиеСекции.Адрес1 КАК Адрес1,
	|	Лико_СкладскиеСекции.Адрес2 КАК Адрес2,
	|	Лико_СкладскиеСекции.Адрес3 КАК Адрес3,
	|	Лико_СкладскиеСекции.Типоразмер КАК Типоразмер,
	|	Лико_СкладскиеСекции.Склад КАК Склад,
	|	Лико_СкладскиеСекции.АдресЦентр КАК АдресЦентр,
	|	Лико_СкладскиеСекции.КоличествоАдресов КАК КоличествоАдресов,
	|	Лико_СкладскиеСекции.Места КАК Места,
	|	Лико_СкладскиеСекции.ВремяДоступа КАК ВремяДоступа,
	|	ВЫБОР
	|		КОГДА (Лико_СкладскиеСекции.Место - 1) / 3 + 1 <= Лико_СкладскиеСекции.Стеллаж.КоличествоСекций / 2
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК УровеньДоступа
	|ПОМЕСТИТЬ ВТСекции
	|ИЗ
	|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
	|ГДЕ
	|	НЕ Лико_СкладскиеСекции.ПометкаУдаления
	|	И Лико_СкладскиеСекции.Типоразмер.Глубина >= &Глубина
	|	И ВЫБОР
	|			КОГДА Лико_СкладскиеСекции.Типоразмер.НеОграниченаПоГрузоподъемности
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Лико_СкладскиеСекции.Типоразмер.Вес >= &Вес
	|		КОНЕЦ
	|	И Лико_СкладскиеСекции.Типоразмер.Высота >= &Высота
	|	И Лико_СкладскиеСекции.Склад = &Склад
	|	И (Лико_СкладскиеСекции.МаксимальныйВесПодъёмаНаЭтаж = 0
	|			ИЛИ Лико_СкладскиеСекции.МаксимальныйВесПодъёмаНаЭтаж >= &Вес)
	|	И НЕ Лико_СкладскиеСекции.ЗапретРазмещения
	|	И (Лико_СкладскиеСекции.Стеллаж.МинШиринаПаллета = 0
