Процедура ДобавлениеИзменениеСекций(Стеллаж) Экспорт   
	
	//Стеллаж = Справочники.Лико_Стеллажи.СоздатьЭлемент();
	Для каждого Этаж Из Стеллаж.Этажи Цикл
		НомерСекции=1;
		Пока НомерСекции<= Стеллаж.КоличествоСекций Цикл 
			
			ДобавлениеИзменениеСекции(Стеллаж, Этаж, НомерСекции);
		 
		 НомерСекции = НомерСекции+1;
	КонецЦикла;
		
		
	КонецЦикла;
	
	
	
	

КонецПроцедуры


Функция ПодобратьЯчейкуПоПаллету(Склад,Паллет,Типоразмер=Неопределено,УровеньДоступа=1,Все=Ложь) Экспорт 
	
	
	Если Типоразмер= Неопределено Тогда
		
		Структура = Справочники.Лико_Паллеты2_0.ТипоразмерПаллета(Паллет);
	Иначе
		Структура = Новый Структура;
		Структура.Вставить("Высота",Типоразмер.Высота);
		Структура.Вставить("Ширина",Типоразмер.Ширина);
		Структура.Вставить("Глубина",Типоразмер.Глубина);
		Структура.Вставить("Вес",Типоразмер.Вес);
	КонецЕсли;
	Результат = ПодобратьЯчейку(Склад, Структура.Высота,Структура.Ширина,Структура.Глубина,Структура.Вес,УровеньДоступа<>1,Все);
	
			
	Возврат Результат; 
	
КонецФункции  


Функция ПодобратьЯчейку(Склад, Высота,Ширина,Глубина,Вес,ОбратныйПорядокВремени=Ложь,Все=Ложь) Экспорт 
	
// ----------------------------------------------------------------------------
// НАЗНАЧЕНИЕ:
//   Подбирает складскую ячейку (адрес) для размещения одного паллета заданных
//   габаритов и веса. Занятость мест берётся из регистра Лико_ПаллетыВСекциях.
//
// ПАРАМЕТРЫ:
//   Склад                  - СправочникСсылка. Склад поиска.
//   Высота, Ширина,
//   Глубина, Вес           - Число. Габариты и вес паллета.
//   ОбратныйПорядокВремени - Булево (Ложь). Ложь = ближние/быстрые ячейки первыми;
//                            Истина = дальние/медленные первыми.
//   Все                    - Булево (Ложь). Ложь = одна лучшая ячейка (ПЕРВЫЕ 1);
//                            Истина = ТЗ всех подходящих ячеек в порядке приоритета.
//
// ВОЗВРАТ:
//   - Все = Ложь: СправочникСсылка.СкладскиеЯчейки (адрес) либо пустая ссылка.
//   - Все = Истина: ТаблицаЗначений подходящих ячеек.
//
// ----------------------------------------------------------------------------
// ФИЛЬТРЫ (жёсткие условия отбора):
//
//   Уровень секции (ВТСекции.ГДЕ):
//     - не помечена на удаление, нет ЗапретРазмещения, принадлежит &Склад;
//     - Типоразмер: Глубина >= &Глубина, Высота >= &Высота;
//     - по весу: НеОграниченаПоГрузоподъемности ИЛИ Типоразмер.Вес >= &Вес;
//     - МаксимальныйВесПодъёмаНаЭтаж = 0 ИЛИ >= &Вес;
//     - мин/макс ширина и глубина стеллажа (0 = ограничение снято, плюс
//       флаги Минимальная/МаксимальнаяГлубинаНеОграничена).
//
//   Уровень секции с остатками (ВТ_ИТОГ.ГДЕ):
//     - есть свободное место (Паллет1/2/3 = ПустаяСсылка);
//     - свободной ширины >= Ширина_секции / 3;
//     - хватает свободного веса секции (или секция безлимитна);
//     - средняя ячейка (Паллет2) занята только узким паллетом (<= Ш/3);
//     - конфигурация свободных мест допускает паллет заданной ширины
//       (правила для >Ш/2, >Ш/3, <=Ш/3);
//     - вычисленный Адрес размещения не пустой.
//
//   Финальный фильтр монтажных зазоров (итоговый запрос, ГДЕ):
//     - если в секции 1 паллет: ОстатокШирина - &Ширина - 150 >= 0;
//     - если в секции 2 паллета: ОстатокШирина - &Ширина - 200 >= 0;
//     - иначе (пустая секция) — без доп. зазора.
//
// ----------------------------------------------------------------------------
// ПРИОРИТЕТЫ (УПОРЯДОЧИТЬ ПО) — строго в порядке кода:
//
//   1. Узкопроходные стеллажи первыми        Узкопроходный УБЫВ
//   2. Ограничение глубины первыми           МинимальнаяГлубинаНеОграничена ASC
//        Ложь (с бортиками) раньше, Истина (с дном) — в конец.
//   3. Итоговый потенциал секции             ПотенциалИтого УБЫВ
//        ПотенциалИтого = МИН(ПотенциалСекции, ПотенциалПоВесу):
//          - ПотенциалСекции  — сколько паллет ещё влезет по ширине (0/2/3),
//            с поправкой -50 мм к порогу Ш/3 для паллет 800..900 мм;
//          - ПотенциалПоВесу  — ЦЕЛ(Вес_секции / &Вес), безлимит = 3.
//        Направление зависит от Потенциал3ПаллетаВСекции (узкий паллет <= Ш/3):
//          узкий  → УБЫВ (пустые/гибкие секции первыми);
//          широкий→ ASC  (секции с исчерпанным потенциалом первыми).
//   4. Best-fit по высоте                    ОстатокВысота ASC
//   5. Best-fit по грузоподъёмности секции   ДельтаГрузоподъемности ASC
//        Дельта = Типоразмер.Вес - &Вес; безлимит = 999999 (в конец).
//   6. Потенциал по ширине                   ПотенциалСекции УБЫВ (см. п.3 по напр.)
//   7. Потенциал по весу                     ПотенциалПоВесу УБЫВ (см. п.3 по напр.)
//   8. Best-fit по весу ячейки               ОстатокВесЯчейка ASC
//        = Типоразмер.Вес / макс_паллетов_в_секции - &Вес.
//   9. Полная грузоподъёмность секции        ТипоразмерВес ASC
//  10. Остаток ширины секции                 ОстатокШирина ASC
//  11. Остаток веса секции                   ОстатокВес ASC
//  12. Горизонтальная зона доступа           УровеньДоступа
//        1 — ближняя зона, 2 — дальняя.
//        ОбратныйПорядокВремени = Ложь → ASC (ближние первыми);
//        Истина → УБЫВ (дальние первыми).
//  13. Время доступа                         ВремяДоступа
//        Ложь → ASC (быстрый первым); Истина → УБЫВ (медленный первым).
//
// ПРИМЕЧАНИЕ по управлению порядком (СтрЗаменить):
//   По умолчанию поля 12 и 13 записаны с УБЫВ; при ОбратныйПорядокВремени = Ложь
//   они заменяются на ASC. При Потенциал3ПаллетаВСекции = Ложь поля
//   ПотенциалИтого / ПотенциалСекции / ПотенциалПоВесу меняются с УБЫВ на ASC.
// ============================================================================

// ============================================================================	Результат = Справочники.СкладскиеЯчейки.ПустаяСсылка();
	
	ШиринаЯчейки = Справочники.Лико_ПредопределенныеЗначения.ШиринаСкладскойСекции.ЗначениеПараметра/3;
	
	Потенциал3ПаллетаВСекции=Ширина<=ШиринаЯчейки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_СкладскиеСекции.Ссылка КАК Ссылка,
	|	Лико_СкладскиеСекции.ВерсияДанных КАК ВерсияДанных,
	|	Лико_СкладскиеСекции.ПометкаУдаления КАК ПометкаУдаления,
	|	Лико_СкладскиеСекции.Код КАК Код,
	|	Лико_СкладскиеСекции.Наименование КАК Наименование,
	|	Лико_СкладскиеСекции.Стеллаж КАК Стеллаж,
	|	Лико_СкладскиеСекции.Ряд КАК Ряд,
	|	Лико_СкладскиеСекции.Место КАК Место,
	|	Лико_СкладскиеСекции.Этаж КАК Этаж,
	|	Лико_СкладскиеСекции.Адрес1 КАК Адрес1,
	|	Лико_СкладскиеСекции.Адрес2 КАК Адрес2,
	|	Лико_СкладскиеСекции.Адрес3 КАК Адрес3,
	|	Лико_СкладскиеСекции.Типоразмер КАК Типоразмер,
	|	Лико_СкладскиеСекции.Склад КАК Склад,
	|	Лико_СкладскиеСекции.АдресЦентр КАК АдресЦентр,
	|	Лико_СкладскиеСекции.КоличествоАдресов КАК КоличествоАдресов,
	|	Лико_СкладскиеСекции.Места КАК Места,
	|	Лико_СкладскиеСекции.ВремяДоступа КАК ВремяДоступа,
	|	ЕСТЬNULL(Этажи.ЗазорПоШирине, 50) КАК ЗазорПоШирине,
	|	ВЫБОР
	|		КОГДА (Лико_СкладскиеСекции.Место - 1) / 3 + 1 <= Лико_СкладскиеСекции.Стеллаж.КоличествоСекций / 2
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК УровеньДоступа
	|ПОМЕСТИТЬ ВТСекции
	|ИЗ
	|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_Стеллажи.Этажи КАК Этажи
	|		ПО (Этажи.Ссылка = Лико_СкладскиеСекции.Стеллаж
	|				И Этажи.НомерСтроки = Лико_СкладскиеСекции.Этаж)
	|ГДЕ
	|	НЕ Лико_СкладскиеСекции.ПометкаУдаления
	|	И Лико_СкладскиеСекции.Типоразмер.Глубина >= &Глубина
	|	И ВЫБОР
	|			КОГДА Лико_СкладскиеСекции.Типоразмер.НеОграниченаПоГрузоподъемности
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Лико_СкладскиеСекции.Типоразмер.Вес >= &Вес
	|		КОНЕЦ
	|	И Лико_СкладскиеСекции.Типоразмер.Высота >= &Высота
	|	И Лико_СкладскиеСекции.Склад = &Склад
	|	И (Лико_СкладскиеСекции.МаксимальныйВесПодъёмаНаЭтаж = 0
	|			ИЛИ Лико_СкладскиеСекции.МаксимальныйВесПодъёмаНаЭтаж >= &Вес)
	|	И НЕ Лико_СкладскиеСекции.ЗапретРазмещения
	|	И (Лико_СкладскиеСекции.Стеллаж.МинШиринаПаллета = 0
	|			ИЛИ Лико_СкладскиеСекции.Стеллаж.МинШиринаПаллета <= &Ширина)
	|	И (Лико_СкладскиеСекции.Стеллаж.МаксШиринаПаллета = 0
	|			ИЛИ Лико_СкладскиеСекции.Стеллаж.МаксШиринаПаллета >= &Ширина)
	|	И (Лико_СкладскиеСекции.МинимальнаяГлубинаНеОграничена
	|			ИЛИ Лико_СкладскиеСекции.Стеллаж.МинГлубинаПаллета = 0
	|			ИЛИ Лико_СкладскиеСекции.Стеллаж.МинГлубинаПаллета <= &Глубина)
	|	И (Лико_СкладскиеСекции.МаксимальнаяГлубинаНеОграничена
	|			ИЛИ Лико_СкладскиеСекции.Стеллаж.МаксГлубинаПаллета = 0
	|			ИЛИ Лико_СкладскиеСекции.Стеллаж.МаксГлубинаПаллета >= &Глубина)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_ПаллетыВСекцияхОстатки.Секция КАК Секция,
	|	Лико_ПаллетыВСекцияхОстатки.Паллет КАК Паллет,
	|	Лико_ПаллетыВСекцияхОстатки.Адрес КАК Адрес,
	|	Лико_ПаллетыВСекцияхОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	Лико_ПаллетыВСекцияхОстатки.ЗаблокированОстаток КАК ЗаблокированОстаток,
	|	Лико_ПараметрыПаллетСрезПоследних.Типоразмер КАК Типоразмер,
	|	ВТСекции.ЗазорПоШирине КАК ЗазорПоШирине
	|ПОМЕСТИТЬ ВтОстатки
	|ИЗ
	|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(, ) КАК Лико_ПаллетыВСекцияхОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних КАК Лико_ПараметрыПаллетСрезПоследних
	|		ПО Лико_ПаллетыВСекцияхОстатки.Паллет = Лико_ПараметрыПаллетСрезПоследних.Паллет
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСекции КАК ВТСекции
	|		ПО Лико_ПаллетыВСекцияхОстатки.Секция = ВТСекции.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтОстатки.Секция КАК Секция,
	|	ВтОстатки.Паллет КАК Паллет,
	|	МАКСИМУМ(ВтОстатки.Адрес) КАК Адрес,
	|	ВтОстатки.Типоразмер КАК Типоразмер,
	|	ВтОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ВтОстатки.ЗаблокированОстаток КАК ЗаблокированОстаток,
	|	ВтОстатки.ЗазорПоШирине КАК ЗазорПоШирине
	|ПОМЕСТИТЬ ВтОстаткиИтог
	|ИЗ
	|	ВтОстатки КАК ВтОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтОстатки.Секция,
	|	ВтОстатки.Паллет,
	|	ВтОстатки.Типоразмер,
	|	ВтОстатки.КоличествоОстаток,
	|	ВтОстатки.ЗаблокированОстаток
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСекции.Ссылка КАК Ссылка,
	|	ВТСекции.ВерсияДанных КАК ВерсияДанных,
	|	ВТСекции.ПометкаУдаления КАК ПометкаУдаления,
	|	ВТСекции.Код КАК Код,
	|	ВТСекции.Наименование КАК Наименование,
	|	ВТСекции.Стеллаж КАК Стеллаж,
	|	ВТСекции.Ряд КАК Ряд,
	|	ВТСекции.Место КАК Место,
	|	ВТСекции.Этаж КАК Этаж,
	|	ВТСекции.Адрес1 КАК Адрес1,
	|	ВТСекции.Адрес2 КАК Адрес2,
	|	ВТСекции.Адрес3 КАК Адрес3,
	|	ВТСекции.Типоразмер КАК Типоразмер,
	|	ВТСекции.Склад КАК Склад,
	|	ВТСекции.АдресЦентр КАК АдресЦентр,
	|	ВТСекции.КоличествоАдресов КАК КоличествоАдресов,
	|	ВТСекции.Места КАК Места,
	|	ВТСекции.ВремяДоступа КАК ВремяДоступа,
	|	ЕСТЬNULL(ВтОстаткиИтог.Паллет, ЗНАЧЕНИЕ(Справочник.Лико_паллеты2_0.ПустаяСсылка)) КАК Паллет1,
	|	ЕСТЬNULL(ВтОстаткиИтог1.Паллет, ЗНАЧЕНИЕ(Справочник.Лико_паллеты2_0.ПустаяСсылка)) КАК Паллет2,
	|	ЕСТЬNULL(ВтОстаткиИтог2.Паллет, ЗНАЧЕНИЕ(Справочник.Лико_паллеты2_0.ПустаяСсылка)) КАК Паллет3,
	|	ЕСТЬNULL(ВтОстаткиИтог.Типоразмер, ЗНАЧЕНИЕ(Справочник.Лико_ТипоразмерыПаллет.ПустаяСсылка)) КАК Типоразмер1,
	|	ЕСТЬNULL(ВтОстаткиИтог1.Типоразмер, ЗНАЧЕНИЕ(Справочник.Лико_ТипоразмерыПаллет.ПустаяСсылка)) КАК Типоразмер2,
	|	ЕСТЬNULL(ВтОстаткиИтог2.Типоразмер, ЗНАЧЕНИЕ(Справочник.Лико_ТипоразмерыПаллет.ПустаяСсылка)) КАК Типоразмер3,
	|	ВТСекции.УровеньДоступа КАК УровеньДоступа,
	|	ВТСекции.ЗазорПоШирине КАК ЗазорПоШирине
	|ПОМЕСТИТЬ ВтСекцииСОстатками
	|ИЗ
	|	ВТСекции КАК ВТСекции
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтОстаткиИтог КАК ВтОстаткиИтог
	|		ПО ВТСекции.Адрес1 = ВтОстаткиИтог.Адрес
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтОстаткиИтог КАК ВтОстаткиИтог1
	|		ПО ВТСекции.Адрес2 = ВтОстаткиИтог1.Адрес
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтОстаткиИтог КАК ВтОстаткиИтог2
	|		ПО ВТСекции.Адрес3 = ВтОстаткиИтог2.Адрес
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтСекцииСОстатками.Ссылка КАК Секция,
	|	ВтСекцииСОстатками.ВерсияДанных КАК ВерсияДанных,
	|	ВтСекцииСОстатками.ПометкаУдаления КАК ПометкаУдаления,
	|	ВтСекцииСОстатками.Код КАК Код,
	|	ВтСекцииСОстатками.Наименование КАК Наименование,
	|	ВтСекцииСОстатками.Стеллаж КАК Стеллаж,
	|	ВтСекцииСОстатками.Ряд КАК Ряд,
	|	ВтСекцииСОстатками.Место КАК Место,
	|	ВтСекцииСОстатками.Этаж КАК Этаж,
	|	ВтСекцииСОстатками.Адрес1 КАК Адрес1,
	|	ВтСекцииСОстатками.Адрес2 КАК Адрес2,
	|	ВтСекцииСОстатками.Адрес3 КАК Адрес3,
	|	ВтСекцииСОстатками.Типоразмер КАК Типоразмер,
