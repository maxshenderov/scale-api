	|	КОНЕЦ КАК ДельтаГрузоподъемности,
	|	ВтСекцииСОстатками.Типоразмер.Высота - &Высота КАК _Приоритет3_ОсатокПоВысоте,
	|	ВЫБОР
	|		КОГДА ВтСекцииСОстатками.Паллет1 <> ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|				И ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер1.Ширина, 0) > ВтСекцииСОстатками.Типоразмер.Ширина / 3
	|				И ВтСекцииСОстатками.Паллет3 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|			ТОГДА 2
	|		КОГДА ВтСекцииСОстатками.Паллет3 <> ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|				И ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер3.Ширина, 0) > ВтСекцииСОстатками.Типоразмер.Ширина / 3
	|				И ВтСекцииСОстатками.Паллет1 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|			ТОГДА 2
	|		КОГДА (ВтСекцииСОстатками.Паллет1 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|				ИЛИ ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер1.Ширина, 0) <= ВтСекцииСОстатками.Типоразмер.Ширина / 3)
	|				И (ВтСекцииСОстатками.Паллет3 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|					ИЛИ ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер3.Ширина, 0) <= ВтСекцииСОстатками.Типоразмер.Ширина / 3)
	|			ТОГДА 3
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК _Приоритет4_ПотенцилаСекции_Убыв,
	|	ВтСекцииСОстатками.Типоразмер.Вес / ЦЕЛ(ВтСекцииСОстатками.Стеллаж.ШиринаСекции / &Ширина) - &Вес КАК _Приоритет5_ОстатокПоВесуЯчейки,
	|	ВтСекцииСОстатками.Типоразмер.Вес КАК _Приоритет6_ГрузоподъемностьСекции,
	|	ВтСекцииСОстатками.Типоразмер.Ширина - (ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер1.Ширина, 0) + ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер2.Ширина, 0) + ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер3.Ширина, 0)) КАК _Приоритет7_ОстатокПоШиринеСекции,
	|	ВтСекцииСОстатками.Типоразмер.Вес - (ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер1.Вес, 0) + ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер2.Вес, 0) + ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер3.Вес, 0)) КАК _Приоритет8_ОстатокПоВесуСекции,
	|	ВтСекцииСОстатками.УровеньДоступа КАК _Приоритет9_УровеньДоступаКСекции_Убыв,
	|	ВтСекцииСОстатками.ВремяДоступа КАК _Приоритет10_Времядоступа_Убыв,
	|	ЦЕЛ(ВтСекцииСОстатками.Стеллаж.ШиринаСекции / &Ширина) КАК МаксКоличествоТекПаллетаВСекции,
	|	ВЫБОР
	|		КОГДА ВтСекцииСОстатками.Типоразмер.Вес / ЦЕЛ(ВтСекцииСОстатками.Стеллаж.ШиринаСекции / &Ширина) - &Вес < 0
	|			ТОГДА 10000 - (ВтСекцииСОстатками.Типоразмер.Вес / ЦЕЛ(ВтСекцииСОстатками.Стеллаж.ШиринаСекции / &Ширина) - &Вес)
	|		ИНАЧЕ ВтСекцииСОстатками.Типоразмер.Вес / ЦЕЛ(ВтСекцииСОстатками.Стеллаж.ШиринаСекции / &Ширина) - &Вес
	|	КОНЕЦ КАК ГрузоподъемностьЯчейки,
	|	ВтСекцииСОстатками.Типоразмер.Вес / ЦЕЛ(ВтСекцииСОстатками.Стеллаж.ШиринаСекции / &Ширина) - &Вес КАК ОстатокВесЯчейка
	|ИЗ
	|	ВтСекцииСОстатками КАК ВтСекцииСОстатками
	|ГДЕ
	|	(ВтСекцииСОстатками.Паллет1 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|			ИЛИ ВтСекцииСОстатками.Паллет2 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|			ИЛИ ВтСекцииСОстатками.Паллет3 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка))
	|	И ВтСекцииСОстатками.Типоразмер.Ширина - (ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер1.Ширина, 0) + ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер2.Ширина, 0) + ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер3.Ширина, 0)) >= ВтСекцииСОстатками.Типоразмер.Ширина / 3
	|	И ВЫБОР
	|			КОГДА ВтСекцииСОстатками.Типоразмер.НеОграниченаПоГрузоподъемности
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ВтСекцииСОстатками.Типоразмер.Вес - (ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер1.Вес, 0) + ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер2.Вес, 0) + ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер3.Вес, 0)) >= &Вес
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА ВтСекцииСОстатками.Паллет2 <> ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|				ТОГДА ВтСекцииСОстатками.Типоразмер2.Ширина <= ВтСекцииСОстатками.Типоразмер.Ширина / 3
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Ширина > ВтСекцииСОстатками.Типоразмер.Ширина / 2
	|				ТОГДА ВтСекцииСОстатками.Паллет1 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|						И ВтСекцииСОстатками.Паллет2 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|						И ВтСекцииСОстатками.Паллет3 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|			КОГДА &Ширина > ВтСекцииСОстатками.Типоразмер.Ширина / 3
	|				ТОГДА ВтСекцииСОстатками.Паллет2 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|						И (ВтСекцииСОстатками.Паллет1 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|							ИЛИ ВтСекцииСОстатками.Паллет3 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка))
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Ширина > ВтСекцииСОстатками.Типоразмер.Ширина / 2
	|				ТОГДА ВтСекцииСОстатками.Адрес2
	|			КОГДА &Ширина > ВтСекцииСОстатками.Типоразмер.Ширина / 3
	|				ТОГДА ВЫБОР
	|						КОГДА ВтСекцииСОстатками.Паллет1 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|							ТОГДА ВтСекцииСОстатками.Адрес1
	|						ИНАЧЕ ВтСекцииСОстатками.Адрес3
	|					КОНЕЦ
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ВтСекцииСОстатками.Паллет1 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|						ТОГДА ВтСекцииСОстатками.Адрес1
	|					КОГДА ВтСекцииСОстатками.Паллет2 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|							И ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер1.Ширина, 0) <= ВтСекцииСОстатками.Типоразмер.Ширина / 3
	|							И (ВтСекцииСОстатками.Паллет3 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|								ИЛИ ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер3.Ширина, 0) <= ВтСекцииСОстатками.Типоразмер.Ширина / 3)
	|						ТОГДА ВтСекцииСОстатками.Адрес2
	|					КОГДА ВтСекцииСОстатками.Паллет3 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|						ТОГДА ВтСекцииСОстатками.Адрес3
	|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
	|				КОНЕЦ
	|		КОНЕЦ <> ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВтСекцииСОстатками.Стеллаж.Узкопроходный УБЫВ,
	|	ДельтаГрузоподъемности,
	|	ВтСекцииСОстатками.Ссылка.МинимальнаяГлубинаНеОграничена,
	|	ОстатокВысота,
	|	ПотенциалСекции УБЫВ,
	|	ОстатокВесЯчейка,
	|	ВтСекцииСОстатками.Типоразмер.Вес,
	|	ОстатокШирина,
	|	ОстатокВес,
	|	УровеньДоступа УБЫВ,
	|	ВремяДоступа УБЫВ";
	
	
	
	// Если параметр ОбратныйПорядокВремени = Истина, то меняем сортировку по времени на убывающую
	Если Не ОбратныйПорядокВремени Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"	ВремяДоступа УБЫВ",
		"	ВремяДоступа"); 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"	УровеньДоступа УБЫВ",
		"	УровеньДоступа"); 
		
			
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"_Приоритет8_УровеньДоступаКСекции_Убыв",
		"_Приоритет8_УровеньДоступаКСекции");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
		" _Приоритет9_Времядоступа_Убыв",
		" _Приоритет9_Времядоступа");		
		
	КонецЕсли;
	
	Если Не Потенциал3ПаллетаВСекции Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"	ПотенциалСекции УБЫВ",
			"	ПотенциалСекции");

	Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"_Приоритет4_ПотенцилаСекции_Убыв",
			"_Приоритет4_ПотенцилаСекции"); 
	
	КонецЕсли;
	
	Если Все Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ВЫБРАТЬ ПЕРВЫЕ 1",
			"ВЫБРАТЬ");
	
		
	КонецЕсли;
	
	
	
	Запрос.УстановитьПараметр("Склад",Склад );
	Запрос.УстановитьПараметр("Высота",  Высота );
	Запрос.УстановитьПараметр("Ширина",  Ширина );
	Запрос.УстановитьПараметр("Глубина", Глубина);
	Запрос.УстановитьПараметр("Вес",Вес );
	запрос.УстановитьПараметр("ТзОперативнаяПамять",ТЗОперативнаяПамять);
	РезультатЗапроса = Запрос.Выполнить();
	Если Все Тогда
		
		Результат = РезультатЗапроса.Выгрузить();
		
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Результат = Выборка.Адрес; 
			
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции  


Функция ОшибкиРазмещенияПаллетаВАдресСтарый(Ячейка, Паллет, Типоразмер = Неопределено, ПолныйОтвет = Ложь) Экспорт
	
	Если Типоразмер= Неопределено Тогда
		
		Структура = Справочники.Лико_Паллеты2_0.ТипоразмерПаллета(Паллет);
	Иначе
		Структура = Новый Структура;
		Структура.Вставить("Высота",Типоразмер.Высота);
		Структура.Вставить("Ширина",Типоразмер.Ширина);
		Структура.Вставить("Глубина",Типоразмер.Глубина);
		Структура.Вставить("Вес",Типоразмер.Вес);
	КонецЕсли;

	
	
	Возврат ОшибкиРазмещенияВАдрес(Ячейка,Структура.Высота,Структура.Ширина,Структура.Глубина,Структура.Вес,ПолныйОтвет);

КонецФункции 

Функция ОшибкиРазмещенияВАдресСтарый(Ячейка,Высота,Ширина,Глубина,Вес,ПолныйОтвет = Ложь) Экспорт

	// У секции есть 3 адреса
	// В секцию можно устанавливать 1, 2 или 3 паллета
	// 1. Если ширина паллета больше половины ширины секции, то в секцию можно установить только один паллет и только в средний (2) адрес
	// 2. Если ширина паллета больше 1/3 ширины секции, то в секцию можно установить 2 паллета в крайние адреса (1 и 3)
	// 3. Если ширина паллета меньше или равна 1/3 ширины секции, можно установить 3 паллета в три адреса

	
	Массив = Новый Массив();
	
	// Валидация входных параметров
	Если Не ЗначениеЗаполнено(Ячейка) Тогда
		Массив.Добавить("Ошибка: не указан адрес для размещения.");
		Возврат Массив;
	КонецЕсли;
	
	
	
	Секция = Ячейка.Лико_Секция;
	
			Структура = Новый Структура;
		Структура.Вставить("Высота", Высота);
		Структура.Вставить("Ширина", Ширина);
		Структура.Вставить("Глубина", Глубина);
		Структура.Вставить("Вес", Вес);
		
	// Получаем остатки паллетов по адресам секции
	Попытка
		СооАдресовСекции = РегистрыНакопления.Лико_ПаллетыВСекциях.ОстаткиПоАдресамСекции(Секция);
	Исключение
		Массив.Добавить("Ошибка: не удалось получить информацию об остатках паллетов в секции.");
		Возврат Массив;
	КонецПопытки;
	
	Адрес1 = СооАдресовСекции[Секция.Адрес1];
	Адрес2 = СооАдресовСекции[Секция.Адрес2];
	Адрес3 = СооАдресовСекции[Секция.Адрес3]; 
	
	// 
	ЭтоАдрес1 = Секция.Адрес1 = Ячейка;
	ЭтоАдрес2 = Секция.Адрес2 = Ячейка;
	ЭтоАдрес3 = Секция.Адрес3 = Ячейка;

	// 1.Проверка: Адрес уже занят
	Если ЗначениеЗаполнено(СооАдресовСекции[Ячейка]) Тогда
		Если ПолныйОтвет Тогда
			ДанныеАдреса = СооАдресовСекции[Ячейка];
			Массив.Добавить("Ошибка: выбранный адрес уже занят паллетом """
				+ Строка(ДанныеАдреса.Паллет) + """ ("
				+ ДанныеАдреса.Ширина + "x" + ДанныеАдреса.Глубина + "x" + ДанныеАдреса.Высота + " мм, "
				+ ДанныеАдреса.Вес + " кг). Выберите другой адрес в секции.");
		Иначе
			Массив.Добавить("Ошибка: выбранный адрес уже занят. Выберите другой адрес в секции.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;
	
	// 2.Проверка: Крайний адрес 1 конфликтует с занятым средним адресом
	Если ЭтоАдрес1 И ЗначениеЗаполнено(Адрес2) И Секция.Типоразмер.Ширина / 3 < Адрес2.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: невозможно разместить паллет в адрес 1. В среднем адресе (2) уже установлен паллет шириной "
				+ Адрес2.Ширина + " мм, что > 1/3 ширины секции (" + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм). Выберите адрес 3 или другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: невозможно разместить паллет в адрес 1. В среднем адресе (2) уже установлен паллет большого размера (>1/3 ширины секции). Выберите адрес 3 или другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 3.Проверка: Крайний адрес 3 конфликтует с занятым средним адресом
	Если ЭтоАдрес3 И ЗначениеЗаполнено(Адрес2) И Секция.Типоразмер.Ширина / 3 < Адрес2.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: невозможно разместить паллет в адрес 3. В среднем адресе (2) уже установлен паллет шириной "
				+ Адрес2.Ширина + " мм, что > 1/3 ширины секции (" + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм). Выберите адрес 1 или другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: невозможно разместить паллет в адрес 3. В среднем адресе (2) уже установлен паллет большого размера (>1/3 ширины секции). Выберите адрес 1 или другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 4.Проверка: Средний адрес конфликтует с занятым крайним адресом 1
	Если ЭтоАдрес2 И ЗначениеЗаполнено(Адрес1) И Секция.Типоразмер.Ширина / 3 < Адрес1.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: невозможно разместить паллет в средний адрес (2). В адресе 1 уже установлен паллет шириной "
				+ Адрес1.Ширина + " мм, что > 1/3 ширины секции (" + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм), что блокирует размещение в центре. Используйте адрес 3 или выберите другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: невозможно разместить паллет в средний адрес (2). В адресе 1 уже установлен паллет большого размера, что блокирует размещение в центре. Используйте адрес 3 или выберите другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 5.Проверка: Средний адрес конфликтует с занятым крайним адресом 3
	Если ЭтоАдрес2 И ЗначениеЗаполнено(Адрес3) И Секция.Типоразмер.Ширина / 3 < Адрес3.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: невозможно разместить паллет в средний адрес (2). В адресе 3 уже установлен паллет шириной "
				+ Адрес3.Ширина + " мм, что > 1/3 ширины секции (" + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм), что блокирует размещение в центре. Используйте адрес 1 или выберите другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: невозможно разместить паллет в средний адрес (2). В адресе 3 уже установлен паллет большого размера, что блокирует размещение в центре. Используйте адрес 1 или выберите другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 6.Проверка: Средний адрес не подходит для крупного паллета при занятом адресе 1
	Если ЭтоАдрес2 И ЗначениеЗаполнено(Адрес1) И Секция.Типоразмер.Ширина / 3 < Структура.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: паллет слишком широк ("
				+ Структура.Ширина + " мм > 1/3 ширины секции = " + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм) для размещения в среднем адресе (2), так как адрес 1 уже занят. Используйте адрес 3 или выберите другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: паллет слишком широк (>1/3 ширины секции) для размещения в среднем адресе (2), так как адрес 1 уже занят. Используйте адрес 3 или выберите другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 7.Проверка: Средний адрес не подходит для крупного паллета при занятом адресе 3
	Если ЭтоАдрес2 И ЗначениеЗаполнено(Адрес3) И Секция.Типоразмер.Ширина / 3 < Структура.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: паллет слишком широк ("
				+ Структура.Ширина + " мм > 1/3 ширины секции = " + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм) для размещения в среднем адресе (2), так как адрес 3 уже занят. Используйте адрес 1 или выберите другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: паллет слишком широк (>1/3 ширины секции) для размещения в среднем адресе (2), так как адрес 3 уже занят. Используйте адрес 1 или выберите другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;
	
	// 8.Проверка: Крайний адрес 1 не подходит для крупного паллета
	Если ЭтоАдрес1 И Секция.Типоразмер.Ширина / 2 < Структура.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: паллет слишком широк ("
				+ Структура.Ширина + " мм > 1/2 ширины секции = " + Секция.Типоразмер.Ширина + "/2 = "
				+ Окр(Секция.Типоразмер.Ширина / 2) + " мм) для размещения в адресе 1. Используйте средний адрес (2) или выберите другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: паллет слишком широк (>1/2 ширины секции) для размещения в адресе 1. Используйте средний адрес (2) или выберите другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 9.Проверка: Крайний адрес 3 не подходит для крупного паллета
	Если ЭтоАдрес3 И Секция.Типоразмер.Ширина / 2 < Структура.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: паллет слишком широк ("
				+ Структура.Ширина + " мм > 1/2 ширины секции = " + Секция.Типоразмер.Ширина + "/2 = "
				+ Окр(Секция.Типоразмер.Ширина / 2) + " мм) для размещения в адресе 3. Используйте средний адрес (2) или выберите другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: паллет слишком широк (>1/2 ширины секции) для размещения в адресе 3. Используйте средний адрес (2) или выберите другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 10.Проверка: Ширина паллета превышает ширину секции
	Если Секция.Типоразмер.Ширина < Структура.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: ширина паллета " + Структура.Ширина
				+ " мм превышает максимальную ширину секции " + Секция.Типоразмер.Ширина
				+ " мм (превышение на " + (Структура.Ширина - Секция.Типоразмер.Ширина)
				+ " мм). Паллет не может быть размещен в данной секции.");
		Иначе
			Массив.Добавить("Ошибка: ширина паллета превышает максимальную ширину секции. Паллет не может быть размещен в данной секции.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 11.Проверка: Высота паллета превышает высоту секции
	Если Секция.Типоразмер.Высота < Структура.Высота Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: высота паллета " + Структура.Высота
				+ " мм превышает максимальную высоту секции " + Секция.Типоразмер.Высота
				+ " мм (превышение на " + (Структура.Высота - Секция.Типоразмер.Высота)
				+ " мм). Паллет не может быть размещен в данной секции.");
		Иначе
			Массив.Добавить("Ошибка: высота паллета превышает максимальную высоту секции. Паллет не может быть размещен в данной секции.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 12.Проверка: Глубина паллета превышает глубину секции
	Если Секция.Типоразмер.Глубина < Структура.Глубина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: глубина паллета " + Структура.Глубина
				+ " мм превышает максимальную глубину секции " + Секция.Типоразмер.Глубина
				+ " мм (превышение на " + (Структура.Глубина - Секция.Типоразмер.Глубина)
				+ " мм). Паллет не может быть размещен в данной секции.");
		Иначе
			Массив.Добавить("Ошибка: глубина паллета превышает максимальную глубину секции. Паллет не может быть размещен в данной секции.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;
	
	// 13.Проверка: Общий вес превышает грузоподъемность секции
	ВесТекущий = ?(ЗначениеЗаполнено(Адрес1), Адрес1.Вес, 0)
		+ ?(ЗначениеЗаполнено(Адрес2), Адрес2.Вес, 0)
		+ ?(ЗначениеЗаполнено(Адрес3), Адрес3.Вес, 0);
	ВесВсего = ВесТекущий + Структура.Вес;

	Если Не Секция.Типоразмер.НеОграниченаПоГрузоподъемности
		И Секция.Типоразмер.Вес < ВесВсего Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: общий вес " + ВесВсего
				+ " кг (текущий: " + ВесТекущий + " кг + новый: " + Структура.Вес
				+ " кг) превышает грузоподъемность секции " + Секция.Типоразмер.Вес
				+ " кг (превышение на " + (ВесВсего - Секция.Типоразмер.Вес) + " кг).");
		Иначе
			Массив.Добавить("Ошибка: общий вес паллетов в секции превышает максимальную грузоподъемность секции.");
		КонецЕсли;
	КонецЕсли;

	

		// 15.Проверка: Вес паллета превышает максимальный вес подъёма на этаж
		Если Секция.МаксимальныйВесПодъёмаНаЭтаж > 0 И Секция.МаксимальныйВесПодъёмаНаЭтаж < Структура.Вес Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: вес паллета " + Структура.Вес
					+ " кг превышает максимальный вес подъёма на этаж "
					+ Секция.МаксимальныйВесПодъёмаНаЭтаж + " кг (превышение на "
					+ (Структура.Вес - Секция.МаксимальныйВесПодъёмаНаЭтаж) + " кг).");
			Иначе
				Массив.Добавить("Ошибка: вес паллета превышает максимальный вес подъёма на этаж.");
			КонецЕсли;
		КонецЕсли;

		// 14.Проверки габаритов по стеллажу (применяются только если значение ≠ 0)
		Стеллаж = Секция.Стеллаж;
		Если Стеллаж.МинШиринаПаллета <> 0 И Структура.Ширина < Стеллаж.МинШиринаПаллета Тогда
			Массив.Добавить("Ошибка: ширина паллета меньше минимально допустимой для стеллажа.");
		КонецЕсли;
		Если Стеллаж.МаксШиринаПаллета <> 0 И Структура.Ширина > Стеллаж.МаксШиринаПаллета Тогда
			Массив.Добавить("Ошибка: ширина паллета больше максимально допустимой для стеллажа.");
		КонецЕсли;
		// 14c. Мин глубина стеллажа (пропускается если МинимальнаяГлубинаНеОграничена)
		Если Не Секция.МинимальнаяГлубинаНеОграничена И Стеллаж.МинГлубинаПаллета <> 0 И Структура.Глубина < Стеллаж.МинГлубинаПаллета Тогда
			Массив.Добавить("Ошибка: глубина паллета меньше минимально допустимой для стеллажа.");
		КонецЕсли;
		// 14d. Макс глубина стеллажа (пропускается если МаксимальнаяГлубинаНеОграничена)
		Если Не Секция.МаксимальнаяГлубинаНеОграничена И Стеллаж.МаксГлубинаПаллета <> 0 И Структура.Глубина > Стеллаж.МаксГлубинаПаллета Тогда
			Массив.Добавить("Ошибка: глубина паллета больше максимально допустимой для стеллажа.");
		КонецЕсли;

		Возврат Массив;
	КонецФункции

	
Функция ОшибкиРазмещенияПаллетаВАдрес(Ячейка, Паллет, Типоразмер = Неопределено, ПолныйОтвет = Ложь, ВиртуальноеСостояние = Неопределено) Экспорт
	
	Если Типоразмер= Неопределено Тогда
		
		Структура = Справочники.Лико_Паллеты2_0.ТипоразмерПаллета(Паллет);
	Иначе
		Структура = Новый Структура;
		Структура.Вставить("Высота",Типоразмер.Высота);
		Структура.Вставить("Ширина",Типоразмер.Ширина);
		Структура.Вставить("Глубина",Типоразмер.Глубина);
		Структура.Вставить("Вес",Типоразмер.Вес);
	КонецЕсли;

	
	
	Возврат ОшибкиРазмещенияВАдрес(Ячейка,Структура.Высота,Структура.Ширина,Структура.Глубина,Структура.Вес,ПолныйОтвет,ВиртуальноеСостояние);

КонецФункции 

Функция ОшибкиРазмещенияВАдрес2(Ячейка,Высота,Ширина,Глубина,Вес,ПолныйОтвет = Ложь, ВиртуальноеСостояние = Неопределено) Экспорт

	// У секции есть 3 адреса
	// В секцию можно устанавливать 1, 2 или 3 паллета
	// 1. Если ширина паллета больше половины ширины секции, то в секцию можно установить только один паллет и только в средний (2) адрес
	// 2. Если ширина паллета больше 1/3 ширины секции, то в секцию можно установить 2 паллета в крайние адреса (1 и 3)
	// 3. Если ширина паллета меньше или равна 1/3 ширины секции, можно установить 3 паллета в три адреса

	
	Массив = Новый Массив();
	
	// Валидация входных параметров
	Если Не ЗначениеЗаполнено(Ячейка) Тогда
		Массив.Добавить("Ошибка: не указан адрес для размещения.");
		Возврат Массив;
	КонецЕсли;
	
	
	
	Секция = Ячейка.Лико_Секция;
	
			Структура = Новый Структура;
		Структура.Вставить("Высота", Высота);
		Структура.Вставить("Ширина", Ширина);
		Структура.Вставить("Глубина", Глубина);
		Структура.Вставить("Вес", Вес);
		
		Если ВиртуальноеСостояние <> Неопределено Тогда
			//+Лико m.shenderov 24.06.2026
			СооАдресовСекции = Новый Соответствие;
			ПаллетА1 = ВиртуальноеСостояние.Получить(Секция.Адрес1);
			Если ЗначениеЗаполнено(ПаллетА1) Тогда
				СтруктураП = Справочники.Лико_Паллеты2_0.ТипоразмерПаллета(ПаллетА1);
				СооАдресовСекции.Вставить(Секция.Адрес1, СтруктураП);
			КонецЕсли;
			ПаллетА2 = ВиртуальноеСостояние.Получить(Секция.Адрес2);
			Если ЗначениеЗаполнено(ПаллетА2) Тогда
				СтруктураП = Справочники.Лико_Паллеты2_0.ТипоразмерПаллета(ПаллетА2);
				СооАдресовСекции.Вставить(Секция.Адрес2, СтруктураП);
			КонецЕсли;
			ПаллетА3 = ВиртуальноеСостояние.Получить(Секция.Адрес3);
			Если ЗначениеЗаполнено(ПаллетА3) Тогда
				СтруктураП = Справочники.Лико_Паллеты2_0.ТипоразмерПаллета(ПаллетА3);
				СооАдресовСекции.Вставить(Секция.Адрес3, СтруктураП);
			КонецЕсли;
		Иначе
			// Получаем остатки паллетов по адресам секции
			Попытка
				СооАдресовСекции = РегистрыНакопления.Лико_ПаллетыВСекциях.ОстаткиПоАдресамСекции(Секция);
			Исключение
				Массив.Добавить("Ошибка: не удалось получить информацию об остатках паллетов в секции.");
				Возврат Массив;
			КонецПопытки;
		КонецЕсли;	
	Адрес1 = СооАдресовСекции[Секция.Адрес1];
	Адрес2 = СооАдресовСекции[Секция.Адрес2];
	Адрес3 = СооАдресовСекции[Секция.Адрес3]; 
	
	// 
	ЭтоАдрес1 = Секция.Адрес1 = Ячейка;
	ЭтоАдрес2 = Секция.Адрес2 = Ячейка;
	ЭтоАдрес3 = Секция.Адрес3 = Ячейка;

	// 1.Проверка: Адрес уже занят
	Если ЗначениеЗаполнено(СооАдресовСекции[Ячейка]) Тогда
		Если ПолныйОтвет Тогда
			ДанныеАдреса = СооАдресовСекции[Ячейка];
			Массив.Добавить("Ошибка: выбранный адрес уже занят паллетом """
				+ Строка(ДанныеАдреса.Паллет) + """ ("
				+ ДанныеАдреса.Ширина + "x" + ДанныеАдреса.Глубина + "x" + ДанныеАдреса.Высота + " мм, "
				+ ДанныеАдреса.Вес + " кг). Выберите другой адрес в секции.");
		Иначе
			Массив.Добавить("Ошибка: выбранный адрес уже занят. Выберите другой адрес в секции.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;
	
	// 2.Проверка: Крайний адрес 1 конфликтует с занятым средним адресом
	Если ЭтоАдрес1 И ЗначениеЗаполнено(Адрес2) И Секция.Типоразмер.Ширина / 3 < Адрес2.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: невозможно разместить паллет в адрес 1. В среднем адресе (2) уже установлен паллет шириной "
				+ Адрес2.Ширина + " мм, что > 1/3 ширины секции (" + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм). Выберите адрес 3 или другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: невозможно разместить паллет в адрес 1. В среднем адресе (2) уже установлен паллет большого размера (>1/3 ширины секции). Выберите адрес 3 или другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 3.Проверка: Крайний адрес 3 конфликтует с занятым средним адресом
	Если ЭтоАдрес3 И ЗначениеЗаполнено(Адрес2) И Секция.Типоразмер.Ширина / 3 < Адрес2.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: невозможно разместить паллет в адрес 3. В среднем адресе (2) уже установлен паллет шириной "
				+ Адрес2.Ширина + " мм, что > 1/3 ширины секции (" + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм). Выберите адрес 1 или другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: невозможно разместить паллет в адрес 3. В среднем адресе (2) уже установлен паллет большого размера (>1/3 ширины секции). Выберите адрес 1 или другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 4.Проверка: Средний адрес конфликтует с занятым крайним адресом 1
	Если ЭтоАдрес2 И ЗначениеЗаполнено(Адрес1) И Секция.Типоразмер.Ширина / 3 < Адрес1.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: невозможно разместить паллет в средний адрес (2). В адресе 1 уже установлен паллет шириной "
				+ Адрес1.Ширина + " мм, что > 1/3 ширины секции (" + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм), что блокирует размещение в центре. Используйте адрес 3 или выберите другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: невозможно разместить паллет в средний адрес (2). В адресе 1 уже установлен паллет большого размера, что блокирует размещение в центре. Используйте адрес 3 или выберите другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 5.Проверка: Средний адрес конфликтует с занятым крайним адресом 3
	Если ЭтоАдрес2 И ЗначениеЗаполнено(Адрес3) И Секция.Типоразмер.Ширина / 3 < Адрес3.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: невозможно разместить паллет в средний адрес (2). В адресе 3 уже установлен паллет шириной "
				+ Адрес3.Ширина + " мм, что > 1/3 ширины секции (" + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм), что блокирует размещение в центре. Используйте адрес 1 или выберите другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: невозможно разместить паллет в средний адрес (2). В адресе 3 уже установлен паллет большого размера, что блокирует размещение в центре. Используйте адрес 1 или выберите другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 6.Проверка: Средний адрес не подходит для крупного паллета при занятом адресе 1
	Если ЭтоАдрес2 И ЗначениеЗаполнено(Адрес1) И Секция.Типоразмер.Ширина / 3 < Структура.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: паллет слишком широк ("
				+ Структура.Ширина + " мм > 1/3 ширины секции = " + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм) для размещения в среднем адресе (2), так как адрес 1 уже занят. Используйте адрес 3 или выберите другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: паллет слишком широк (>1/3 ширины секции) для размещения в среднем адресе (2), так как адрес 1 уже занят. Используйте адрес 3 или выберите другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 7.Проверка: Средний адрес не подходит для крупного паллета при занятом адресе 3
	Если ЭтоАдрес2 И ЗначениеЗаполнено(Адрес3) И Секция.Типоразмер.Ширина / 3 < Структура.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: паллет слишком широк ("
				+ Структура.Ширина + " мм > 1/3 ширины секции = " + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм) для размещения в среднем адресе (2), так как адрес 3 уже занят. Используйте адрес 1 или выберите другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: паллет слишком широк (>1/3 ширины секции) для размещения в среднем адресе (2), так как адрес 3 уже занят. Используйте адрес 1 или выберите другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;
	
	// 8.Проверка: Крайний адрес 1 не подходит для крупного паллета
	Если ЭтоАдрес1 И Секция.Типоразмер.Ширина / 2 < Структура.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: паллет слишком широк ("
				+ Структура.Ширина + " мм > 1/2 ширины секции = " + Секция.Типоразмер.Ширина + "/2 = "
				+ Окр(Секция.Типоразмер.Ширина / 2) + " мм) для размещения в адресе 1. Используйте средний адрес (2) или выберите другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: паллет слишком широк (>1/2 ширины секции) для размещения в адресе 1. Используйте средний адрес (2) или выберите другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 9.Проверка: Крайний адрес 3 не подходит для крупного паллета
	Если ЭтоАдрес3 И Секция.Типоразмер.Ширина / 2 < Структура.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: паллет слишком широк ("
				+ Структура.Ширина + " мм > 1/2 ширины секции = " + Секция.Типоразмер.Ширина + "/2 = "
				+ Окр(Секция.Типоразмер.Ширина / 2) + " мм) для размещения в адресе 3. Используйте средний адрес (2) или выберите другую секцию.");
		Иначе
			Массив.Добавить("Ошибка: паллет слишком широк (>1/2 ширины секции) для размещения в адресе 3. Используйте средний адрес (2) или выберите другую секцию.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 10.Проверка: Ширина паллета превышает ширину секции
	Если Секция.Типоразмер.Ширина < Структура.Ширина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: ширина паллета " + Структура.Ширина
				+ " мм превышает максимальную ширину секции " + Секция.Типоразмер.Ширина
				+ " мм (превышение на " + (Структура.Ширина - Секция.Типоразмер.Ширина)
				+ " мм). Паллет не может быть размещен в данной секции.");
		Иначе
			Массив.Добавить("Ошибка: ширина паллета превышает максимальную ширину секции. Паллет не может быть размещен в данной секции.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 11.Проверка: Высота паллета превышает высоту секции
	Если Секция.Типоразмер.Высота < Структура.Высота Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: высота паллета " + Структура.Высота
				+ " мм превышает максимальную высоту секции " + Секция.Типоразмер.Высота
				+ " мм (превышение на " + (Структура.Высота - Секция.Типоразмер.Высота)
				+ " мм). Паллет не может быть размещен в данной секции.");
		Иначе
			Массив.Добавить("Ошибка: высота паллета превышает максимальную высоту секции. Паллет не может быть размещен в данной секции.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;

	// 12.Проверка: Глубина паллета превышает глубину секции
	Если Секция.Типоразмер.Глубина < Структура.Глубина Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: глубина паллета " + Структура.Глубина
				+ " мм превышает максимальную глубину секции " + Секция.Типоразмер.Глубина
				+ " мм (превышение на " + (Структура.Глубина - Секция.Типоразмер.Глубина)
				+ " мм). Паллет не может быть размещен в данной секции.");
		Иначе
			Массив.Добавить("Ошибка: глубина паллета превышает максимальную глубину секции. Паллет не может быть размещен в данной секции.");
		КонецЕсли;
		//Возврат Массив;
	КонецЕсли;
	
	// 13.Проверка: Общий вес превышает грузоподъемность секции
	ВесТекущий = ?(ЗначениеЗаполнено(Адрес1), Адрес1.Вес, 0)
		+ ?(ЗначениеЗаполнено(Адрес2), Адрес2.Вес, 0)
		+ ?(ЗначениеЗаполнено(Адрес3), Адрес3.Вес, 0);
	ВесВсего = ВесТекущий + Структура.Вес;

	Если Не Секция.Типоразмер.НеОграниченаПоГрузоподъемности
		И Секция.Типоразмер.Вес < ВесВсего Тогда
		Если ПолныйОтвет Тогда
			Массив.Добавить("Ошибка: общий вес " + ВесВсего
				+ " кг (текущий: " + ВесТекущий + " кг + новый: " + Структура.Вес
				+ " кг) превышает грузоподъемность секции " + Секция.Типоразмер.Вес
				+ " кг (превышение на " + (ВесВсего - Секция.Типоразмер.Вес) + " кг).");
		Иначе
			Массив.Добавить("Ошибка: общий вес паллетов в секции превышает максимальную грузоподъемность секции.");
		КонецЕсли;
	КонецЕсли;

	

		// 15.Проверка: Вес паллета превышает максимальный вес подъёма на этаж
		Если Секция.МаксимальныйВесПодъёмаНаЭтаж > 0 И Секция.МаксимальныйВесПодъёмаНаЭтаж < Структура.Вес Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: вес паллета " + Структура.Вес
					+ " кг превышает максимальный вес подъёма на этаж "
					+ Секция.МаксимальныйВесПодъёмаНаЭтаж + " кг (превышение на "
					+ (Структура.Вес - Секция.МаксимальныйВесПодъёмаНаЭтаж) + " кг).");
			Иначе
				Массив.Добавить("Ошибка: вес паллета превышает максимальный вес подъёма на этаж.");
			КонецЕсли;
		КонецЕсли;

		// 14.Проверки габаритов по стеллажу (применяются только если значение ≠ 0)
		Стеллаж = Секция.Стеллаж;
		Если Стеллаж.МинШиринаПаллета <> 0 И Структура.Ширина < Стеллаж.МинШиринаПаллета Тогда
			Массив.Добавить("Ошибка: ширина паллета меньше минимально допустимой для стеллажа.");
		КонецЕсли;
		Если Стеллаж.МаксШиринаПаллета <> 0 И Структура.Ширина > Стеллаж.МаксШиринаПаллета Тогда
			Массив.Добавить("Ошибка: ширина паллета больше максимально допустимой для стеллажа.");
		КонецЕсли;
		// 14c. Мин глубина стеллажа (пропускается если МинимальнаяГлубинаНеОграничена)
		Если Не Секция.МинимальнаяГлубинаНеОграничена И Стеллаж.МинГлубинаПаллета <> 0 И Структура.Глубина < Стеллаж.МинГлубинаПаллета Тогда
			Массив.Добавить("Ошибка: глубина паллета меньше минимально допустимой для стеллажа.");
		КонецЕсли;
		// 14d. Макс глубина стеллажа (пропускается если МаксимальнаяГлубинаНеОграничена)
		Если Не Секция.МаксимальнаяГлубинаНеОграничена И Стеллаж.МаксГлубинаПаллета <> 0 И Структура.Глубина > Стеллаж.МаксГлубинаПаллета Тогда
			Массив.Добавить("Ошибка: глубина паллета больше максимально допустимой для стеллажа.");
		КонецЕсли;

		Возврат Массив;
	КонецФункции

Функция ОшибкиРазмещенияВАдрес(Ячейка,Высота,Ширина,Глубина,Вес,ПолныйОтвет = Ложь, ВиртуальноеСостояние = Неопределено) Экспорт
		
		// НАЗНАЧЕНИЕ:
		//   Проверяет возможность размещения паллета заданных габаритов и веса в
		//   КОНКРЕТНЫЙ адрес (ячейку) секции и возвращает массив строк-ошибок.
		//   Пустой массив = размещение допустимо. Функция НЕ прерывается на первой
		//   ошибке — собирает ВСЕ причины отказа за один вызов.
		//
		//   Является "зеркалом" правил подбора из ПодобратьЯчейку: те же пороги
		//   ширины (1/2 и 1/3 секции), тот же монтажный зазор (150/200 мм),
		//   те же ограничения стеллажа и грузоподъёмности.
		//
		// ГЕОМЕТРИЧЕСКИЙ ПРИНЦИП СЕКЦИИ (3 адреса: 1 — левый, 2 — центр, 3 — правый):
		//   - паллет шире 1/2 секции  → только 1 паллет и только в центр (адрес 2);
		//   - паллет шире 1/3 секции  → до 2 паллет в крайние адреса (1 и 3);
		//   - паллет <= 1/3 секции    → до 3 паллет во все адреса.
		//
		// ПАРАМЕТРЫ:
		//   Ячейка               - СправочникСсылка.СкладскиеЯчейки. Целевой адрес.
		//   Высота, Ширина,
		//   Глубина, Вес         - Число. Габариты (мм) и вес (кг) размещаемого паллета.
		//   ПолныйОтвет          - Булево (Ложь). Ложь = краткие тексты ошибок;
		//                          Истина = развёрнутые с числами и расчётами.
		//   ВиртуальноеСостояние - Соответствие (Неопределено). Карта "Адрес → ПаллетСсылка"
		//                          с планируемой (ещё не проведённой) занятостью секции.
		//                          Если Неопределено — занятость берётся из регистра
		//                          Лико_ПаллетыВСекциях (ОстаткиПоАдресамСекции).
		//
		// ВОЗВРАТ:
		//   Массив строк с описаниями ошибок. Пустой массив — размещение разрешено.
		//
		// ----------------------------------------------------------------------------
		// ПОРЯДОК ПРОВЕРОК (все выполняются, ошибки накапливаются):
		//
		//   0.  Валидация: Ячейка заполнена (иначе — единственная ошибка, выход).
		//   1.  Целевой адрес уже занят паллетом.
		//   2.  На секции установлен ЗапретРазмещения.
		//   3.  Адрес 1 ↔ занятый центр (2): в центре паллет > 1/3 секции — крайний недоступен.
		//   4.  Адрес 3 ↔ занятый центр (2): аналогично для правого крайнего.
		//   5.  Центр (2) ↔ занятый адрес 1 шире 1/3 — центр заблокирован.
		//   6.  Центр (2) ↔ занятый адрес 3 шире 1/3 — центр заблокирован.
		//   7.  Центр (2) + занятый адрес 1: сам НОВЫЙ паллет шире 1/3 — не влезет в центр.
		//   8.  Центр (2) + занятый адрес 3: сам НОВЫЙ паллет шире 1/3 — не влезет в центр.
		//   9.  Адрес 1: новый паллет шире 1/2 секции — допустим только центр.
		//   10. Адрес 3: новый паллет шире 1/2 секции — допустим только центр.
		//   11. Ширина паллета > ширины секции (типоразмер).
		//   12. Высота паллета > высоты секции.
		//   13. Глубина паллета > глубины секции.
		//   14. Суммарный вес (занятые + новый) > грузоподъёмности секции
		//       (пропускается, если Типоразмер.НеОграниченаПоГрузоподъемности).
		//   15. Монтажный зазор при дозаполнении: остаток ширины - ширина паллета -
		//       зазор < 0, где зазор = 150 мм (в секции 1 паллет) или 200 мм (2 паллета).
		//   16. Вес паллета > МаксимальныйВесПодъёмаНаЭтаж (если задан, > 0).
		//   17. Габариты по стеллажу (только при значении ограничения <> 0):
		//         - Мин/Макс ширина паллета стеллажа;
		//         - Мин глубина (пропуск при МинимальнаяГлубинаНеОграничена);
		//         - Макс глубина (пропуск при МаксимальнаяГлубинаНеОграничена).
		//
		// ПРИМЕЧАНИЯ:
		//   - Порог 1/3 и 1/2 берутся от Секция.Типоразмер.Ширина.
		//   - Функция не прерывается на первой ошибке (закомментированные Возврат),
		//     поэтому для одного адреса возможны несколько связанных сообщений.
		//   - Числа в текстах при ПолныйОтвет рекомендуется форматировать
		//     через Формат(Значение, "ЧГ=0"), чтобы избежать разделителей разрядов.
		// ============================================================================
		
		Массив = Новый Массив();
		
		// Валидация входных параметров
		Если Не ЗначениеЗаполнено(Ячейка) Тогда
			Массив.Добавить("Ошибка: не указан адрес для размещения.");
			Возврат Массив;
		КонецЕсли;
		
		
		
		Секция = Ячейка.Лико_Секция;
		
		Структура = Новый Структура;
		Структура.Вставить("Высота", Высота);
		Структура.Вставить("Ширина", Ширина);
		Структура.Вставить("Глубина", Глубина);
		Структура.Вставить("Вес", Вес);
		
		Если ВиртуальноеСостояние <> Неопределено Тогда
			//+Лико m.shenderov 24.06.2026
			СооАдресовСекции = Новый Соответствие;
			ПаллетА1 = ВиртуальноеСостояние.Получить(Секция.Адрес1);
			Если ЗначениеЗаполнено(ПаллетА1) Тогда
				СтруктураП = Справочники.Лико_Паллеты2_0.ТипоразмерПаллета(ПаллетА1);
				СооАдресовСекции.Вставить(Секция.Адрес1, СтруктураП);
			КонецЕсли;
			ПаллетА2 = ВиртуальноеСостояние.Получить(Секция.Адрес2);
			Если ЗначениеЗаполнено(ПаллетА2) Тогда
				СтруктураП = Справочники.Лико_Паллеты2_0.ТипоразмерПаллета(ПаллетА2);
				СооАдресовСекции.Вставить(Секция.Адрес2, СтруктураП);
			КонецЕсли;
			ПаллетА3 = ВиртуальноеСостояние.Получить(Секция.Адрес3);
			Если ЗначениеЗаполнено(ПаллетА3) Тогда
				СтруктураП = Справочники.Лико_Паллеты2_0.ТипоразмерПаллета(ПаллетА3);
				СооАдресовСекции.Вставить(Секция.Адрес3, СтруктураП);
			КонецЕсли;
		Иначе
			// Получаем остатки паллетов по адресам секции
			Попытка
				СооАдресовСекции = РегистрыНакопления.Лико_ПаллетыВСекциях.ОстаткиПоАдресамСекции(Секция);
