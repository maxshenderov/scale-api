		КонецЕсли;
		
		// 2.Проверка: Крайний адрес 1 конфликтует с занятым средним адресом
		Если ЭтоАдрес1 И ЗначениеЗаполнено(Адрес2) И Секция.Типоразмер.Ширина / 3 < Адрес2.Ширина Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: невозможно разместить паллет в адрес 1. В среднем адресе (2) уже установлен паллет шириной "
				+ Адрес2.Ширина + " мм, что > 1/3 ширины секции (" + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм). Выберите адрес 3 или другую секцию.");
			Иначе
				Массив.Добавить("Ошибка: невозможно разместить паллет в адрес 1. В среднем адресе (2) уже установлен паллет большого размера (>1/3 ширины секции). Выберите адрес 3 или другую секцию.");
			КонецЕсли;
			//Возврат Массив;
		КонецЕсли;
		
		// 3.Проверка: Крайний адрес 3 конфликтует с занятым средним адресом
		Если ЭтоАдрес3 И ЗначениеЗаполнено(Адрес2) И Секция.Типоразмер.Ширина / 3 < Адрес2.Ширина Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: невозможно разместить паллет в адрес 3. В среднем адресе (2) уже установлен паллет шириной "
				+ Адрес2.Ширина + " мм, что > 1/3 ширины секции (" + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм). Выберите адрес 1 или другую секцию.");
			Иначе
				Массив.Добавить("Ошибка: невозможно разместить паллет в адрес 3. В среднем адресе (2) уже установлен паллет большого размера (>1/3 ширины секции). Выберите адрес 1 или другую секцию.");
			КонецЕсли;
			//Возврат Массив;
		КонецЕсли;
		
		// 4.Проверка: Средний адрес конфликтует с занятым крайним адресом 1
		Если ЭтоАдрес2 И ЗначениеЗаполнено(Адрес1) И Секция.Типоразмер.Ширина / 3 < Адрес1.Ширина Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: невозможно разместить паллет в средний адрес (2). В адресе 1 уже установлен паллет шириной "
				+ Адрес1.Ширина + " мм, что > 1/3 ширины секции (" + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм), что блокирует размещение в центре. Используйте адрес 3 или выберите другую секцию.");
			Иначе
				Массив.Добавить("Ошибка: невозможно разместить паллет в средний адрес (2). В адресе 1 уже установлен паллет большого размера, что блокирует размещение в центре. Используйте адрес 3 или выберите другую секцию.");
			КонецЕсли;
			//Возврат Массив;
		КонецЕсли;
		
		// 5.Проверка: Средний адрес конфликтует с занятым крайним адресом 3
		Если ЭтоАдрес2 И ЗначениеЗаполнено(Адрес3) И Секция.Типоразмер.Ширина / 3 < Адрес3.Ширина Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: невозможно разместить паллет в средний адрес (2). В адресе 3 уже установлен паллет шириной "
				+ Адрес3.Ширина + " мм, что > 1/3 ширины секции (" + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм), что блокирует размещение в центре. Используйте адрес 1 или выберите другую секцию.");
			Иначе
				Массив.Добавить("Ошибка: невозможно разместить паллет в средний адрес (2). В адресе 3 уже установлен паллет большого размера, что блокирует размещение в центре. Используйте адрес 1 или выберите другую секцию.");
			КонецЕсли;
			//Возврат Массив;
		КонецЕсли;
		
		// 6.Проверка: Средний адрес не подходит для крупного паллета при занятом адресе 1
		Если ЭтоАдрес2 И ЗначениеЗаполнено(Адрес1) И Секция.Типоразмер.Ширина / 3 < Структура.Ширина Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: паллет слишком широк ("
				+ Структура.Ширина + " мм > 1/3 ширины секции = " + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм) для размещения в среднем адресе (2), так как адрес 1 уже занят. Используйте адрес 3 или выберите другую секцию.");
			Иначе
				Массив.Добавить("Ошибка: паллет слишком широк (>1/3 ширины секции) для размещения в среднем адресе (2), так как адрес 1 уже занят. Используйте адрес 3 или выберите другую секцию.");
			КонецЕсли;
			//Возврат Массив;
		КонецЕсли;
		
		// 7.Проверка: Средний адрес не подходит для крупного паллета при занятом адресе 3
		Если ЭтоАдрес2 И ЗначениеЗаполнено(Адрес3) И Секция.Типоразмер.Ширина / 3 < Структура.Ширина Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: паллет слишком широк ("
				+ Структура.Ширина + " мм > 1/3 ширины секции = " + Секция.Типоразмер.Ширина + "/3 = "
				+ Окр(Секция.Типоразмер.Ширина / 3) + " мм) для размещения в среднем адресе (2), так как адрес 3 уже занят. Используйте адрес 1 или выберите другую секцию.");
			Иначе
				Массив.Добавить("Ошибка: паллет слишком широк (>1/3 ширины секции) для размещения в среднем адресе (2), так как адрес 3 уже занят. Используйте адрес 1 или выберите другую секцию.");
			КонецЕсли;
			//Возврат Массив;
		КонецЕсли;
		
		// 8.Проверка: Крайний адрес 1 не подходит для крупного паллета
		Если ЭтоАдрес1 И Секция.Типоразмер.Ширина / 2 < Структура.Ширина Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: паллет слишком широк ("
				+ Структура.Ширина + " мм > 1/2 ширины секции = " + Секция.Типоразмер.Ширина + "/2 = "
				+ Окр(Секция.Типоразмер.Ширина / 2) + " мм) для размещения в адресе 1. Используйте средний адрес (2) или выберите другую секцию.");
			Иначе
				Массив.Добавить("Ошибка: паллет слишком широк (>1/2 ширины секции) для размещения в адресе 1. Используйте средний адрес (2) или выберите другую секцию.");
			КонецЕсли;
			//Возврат Массив;
		КонецЕсли;
		
		// 9.Проверка: Крайний адрес 3 не подходит для крупного паллета
		Если ЭтоАдрес3 И Секция.Типоразмер.Ширина / 2 < Структура.Ширина Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: паллет слишком широк ("
				+ Структура.Ширина + " мм > 1/2 ширины секции = " + Секция.Типоразмер.Ширина + "/2 = "
				+ Окр(Секция.Типоразмер.Ширина / 2) + " мм) для размещения в адресе 3. Используйте средний адрес (2) или выберите другую секцию.");
			Иначе
				Массив.Добавить("Ошибка: паллет слишком широк (>1/2 ширины секции) для размещения в адресе 3. Используйте средний адрес (2) или выберите другую секцию.");
			КонецЕсли;
			//Возврат Массив;
		КонецЕсли;
		
		// 10.Проверка: Ширина паллета превышает ширину секции
		Если Секция.Типоразмер.Ширина < Структура.Ширина Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: ширина паллета " + Структура.Ширина
				+ " мм превышает максимальную ширину секции " + Секция.Типоразмер.Ширина
				+ " мм (превышение на " + (Структура.Ширина - Секция.Типоразмер.Ширина)
				+ " мм). Паллет не может быть размещен в данной секции.");
			Иначе
				Массив.Добавить("Ошибка: ширина паллета превышает максимальную ширину секции. Паллет не может быть размещен в данной секции.");
			КонецЕсли;
			//Возврат Массив;
		КонецЕсли;
		
		// 11.Проверка: Высота паллета превышает высоту секции
		Если Секция.Типоразмер.Высота < Структура.Высота Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: высота паллета " + Структура.Высота
				+ " мм превышает максимальную высоту секции " + Секция.Типоразмер.Высота
				+ " мм (превышение на " + (Структура.Высота - Секция.Типоразмер.Высота)
				+ " мм). Паллет не может быть размещен в данной секции.");
			Иначе
				Массив.Добавить("Ошибка: высота паллета превышает максимальную высоту секции. Паллет не может быть размещен в данной секции.");
			КонецЕсли;
			//Возврат Массив;
		КонецЕсли;
		
		// 12.Проверка: Глубина паллета превышает глубину секции
		Если Секция.Типоразмер.Глубина < Структура.Глубина Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: глубина паллета " + Структура.Глубина
				+ " мм превышает максимальную глубину секции " + Секция.Типоразмер.Глубина
				+ " мм (превышение на " + (Структура.Глубина - Секция.Типоразмер.Глубина)
				+ " мм). Паллет не может быть размещен в данной секции.");
			Иначе
				Массив.Добавить("Ошибка: глубина паллета превышает максимальную глубину секции. Паллет не может быть размещен в данной секции.");
			КонецЕсли;
			//Возврат Массив;
		КонецЕсли;
		
		// 13.Проверка: Общий вес превышает грузоподъемность секции
		ВесТекущий = ?(ЗначениеЗаполнено(Адрес1), Адрес1.Вес, 0)
		+ ?(ЗначениеЗаполнено(Адрес2), Адрес2.Вес, 0)
		+ ?(ЗначениеЗаполнено(Адрес3), Адрес3.Вес, 0);
		ВесВсего = ВесТекущий + Структура.Вес;
		
		Если Не Секция.Типоразмер.НеОграниченаПоГрузоподъемности
			И Секция.Типоразмер.Вес < ВесВсего Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: общий вес " + ВесВсего
				+ " кг (текущий: " + ВесТекущий + " кг + новый: " + Структура.Вес
				+ " кг) превышает грузоподъемность секции " + Секция.Типоразмер.Вес
				+ " кг (превышение на " + (ВесВсего - Секция.Типоразмер.Вес) + " кг).");
			Иначе
				Массив.Добавить("Ошибка: общий вес паллетов в секции превышает максимальную грузоподъемность секции.");
			КонецЕсли;
		КонецЕсли;
		
		// 13a.Проверка: Монтажный зазор при дозаполнении секции (синхронизировано с ПодобратьЯчейку)
		ШиринаЗанятая = ?(ЗначениеЗаполнено(Адрес1), Адрес1.Ширина, 0)
		+ ?(ЗначениеЗаполнено(Адрес2), Адрес2.Ширина, 0)
		+ ?(ЗначениеЗаполнено(Адрес3), Адрес3.Ширина, 0);
		ОстатокШиринаСекции = Секция.Типоразмер.Ширина - ШиринаЗанятая;
		КоличествоПаллетВСекции = ?(ЗначениеЗаполнено(Адрес1), 1, 0)
		+ ?(ЗначениеЗаполнено(Адрес2), 1, 0)
		+ ?(ЗначениеЗаполнено(Адрес3), 1, 0);
		
		Если КоличествоПаллетВСекции >= 1 Тогда
			ТребуемыйЗазор = ?(КоличествоПаллетВСекции = 1, 150, 200);
			Если ОстатокШиринаСекции - Структура.Ширина - ТребуемыйЗазор < 0 Тогда
				Если ПолныйОтвет Тогда
					Массив.Добавить("Ошибка: недостаточно монтажного зазора. В секции уже " + КоличествоПаллетВСекции
					+ " паллет(а), остаток ширины " + ОстатокШиринаСекции + " мм, требуется зазор " + ТребуемыйЗазор
					+ " мм сверх ширины паллета (" + Структура.Ширина + " мм). Не хватает "
					+ (Структура.Ширина + ТребуемыйЗазор - ОстатокШиринаСекции) + " мм. Выберите другую секцию.");
				Иначе
					Массив.Добавить("Ошибка: недостаточно монтажного зазора для размещения паллета в данной секции. Выберите другую секцию.");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// 15.Проверка: Вес паллета превышает максимальный вес подъёма на этаж
		Если Секция.МаксимальныйВесПодъёмаНаЭтаж > 0 И Секция.МаксимальныйВесПодъёмаНаЭтаж < Структура.Вес Тогда
			Если ПолныйОтвет Тогда
				Массив.Добавить("Ошибка: вес паллета " + Структура.Вес
				+ " кг превышает максимальный вес подъёма на этаж "
				+ Секция.МаксимальныйВесПодъёмаНаЭтаж + " кг (превышение на "
				+ (Структура.Вес - Секция.МаксимальныйВесПодъёмаНаЭтаж) + " кг).");
			Иначе
				Массив.Добавить("Ошибка: вес паллета превышает максимальный вес подъёма на этаж.");
			КонецЕсли;
		КонецЕсли;
		
		// 14.Проверки габаритов по стеллажу (применяются только если значение ≠ 0)
		Стеллаж = Секция.Стеллаж;
		Если Стеллаж.МинШиринаПаллета <> 0 И Структура.Ширина < Стеллаж.МинШиринаПаллета Тогда
			Массив.Добавить("Ошибка: ширина паллета меньше минимально допустимой для стеллажа.");
		КонецЕсли;
		Если Стеллаж.МаксШиринаПаллета <> 0 И Структура.Ширина > Стеллаж.МаксШиринаПаллета Тогда
			Массив.Добавить("Ошибка: ширина паллета больше максимально допустимой для стеллажа.");
		КонецЕсли;
		// 14c. Мин глубина стеллажа (пропускается если МинимальнаяГлубинаНеОграничена)
		Если Не Секция.МинимальнаяГлубинаНеОграничена И Стеллаж.МинГлубинаПаллета <> 0 И Структура.Глубина < Стеллаж.МинГлубинаПаллета Тогда
			Массив.Добавить("Ошибка: глубина паллета меньше минимально допустимой для стеллажа.");
		КонецЕсли;
		// 14d. Макс глубина стеллажа (пропускается если МаксимальнаяГлубинаНеОграничена)
		Если Не Секция.МаксимальнаяГлубинаНеОграничена И Стеллаж.МаксГлубинаПаллета <> 0 И Структура.Глубина > Стеллаж.МаксГлубинаПаллета Тогда
			Массив.Добавить("Ошибка: глубина паллета больше максимально допустимой для стеллажа.");
		КонецЕсли;
		
		Возврат Массив;
КонецФункции
	
	

Процедура ЗаполнитьВремяДоступаКСекциям(Склад) Экспорт 
	
	НомерСтроки=1;
	Для каждого Стеллаж Из Склад.Лико_Стеллажи Цикл 
		
		ВремяДоступаСтеллажа = Склад.Лико_ВремяСтеллажа*НомерСтроки;
		
		СпрОбъект = Стеллаж.Стеллаж.ПолучитьОбъект();
		СпрОбъект.ВремяДоступа=Склад.Лико_ВремяСтеллажа*НомерСтроки;
		СпрОбъект.Записать();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_СкладскиеСекции.Ссылка КАК Ссылка,
		|	Лико_СкладскиеСекции.Код КАК Код
		|ИЗ
		|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
		|ГДЕ
		|	Лико_СкладскиеСекции.Стеллаж = &Стеллаж
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код";
		Запрос.УстановитьПараметр("Стеллаж",Стеллаж.Стеллаж );
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл 
			 СпрОбъект= Выборка.Ссылка.ПолучитьОбъект();
			 
			СпрОбъект.ВремяДоступа= ВремяДоступаСтеллажа+(СпрОбъект.Место*Склад.Лико_ВремяМеста)+(СпрОбъект.Этаж*Склад.Лико_ВремяЭтажа);
		   СпрОбъект.Записать();
		КонецЦикла; 
		
		
	НомерСтроки=НомерСтроки+1;	
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавлениеИзменениеСекцийПоСкладу(Склад) Экспорт 
	
	НомерСтроки=1;
	Для каждого Стеллаж Из Склад.Лико_Стеллажи Цикл 
		
			
				
					
			Справочники.Лико_СкладскиеСекции.ДобавлениеИзменениеСекций(Стеллаж.Стеллаж);
			
			
		
	НомерСтроки=НомерСтроки+1;	
	КонецЦикла;
	
КонецПроцедуры


