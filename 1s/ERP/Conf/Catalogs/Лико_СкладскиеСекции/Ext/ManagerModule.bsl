	|		КОГДА ВтСекцииСОстатками.Паллет1 <> ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|				И ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер1.Ширина, 0) > ВтСекцииСОстатками.Типоразмер.Ширина / 3 - ВЫБОР
	|					КОГДА &Ширина > 800
	|							И &Ширина <= 900
	|						ТОГДА 50
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|			ТОГДА 2
	|		КОГДА ВтСекцииСОстатками.Паллет3 <> ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|				И ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер3.Ширина, 0) > ВтСекцииСОстатками.Типоразмер.Ширина / 3 - ВЫБОР
	|					КОГДА &Ширина > 800
	|							И &Ширина <= 900
	|						ТОГДА 50
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|			ТОГДА 3
	|		КОГДА ВтСекцииСОстатками.Паллет2 <> ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|				И ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер1.Ширина, 0) > ВтСекцииСОстатками.Типоразмер.Ширина / 3 - ВЫБОР
	|					КОГДА &Ширина > 800
	|							И &Ширина <= 900
	|						ТОГДА 50
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|			ТОГДА 4
	|		КОГДА (ВтСекцииСОстатками.Паллет1 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|				ИЛИ ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер1.Ширина, 0) <= ВтСекцииСОстатками.Типоразмер.Ширина / 3 - ВЫБОР
	|					КОГДА &Ширина > 800
	|							И &Ширина <= 900
	|						ТОГДА 50
	|					ИНАЧЕ 0
	|				КОНЕЦ)
	|				И (ВтСекцииСОстатками.Паллет3 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|					ИЛИ ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер3.Ширина, 0) <= ВтСекцииСОстатками.Типоразмер.Ширина / 3 - ВЫБОР
	|						КОГДА &Ширина > 800
	|								И &Ширина <= 900
	|							ТОГДА 50
	|						ИНАЧЕ 0
	|					КОНЕЦ)
	|			ТОГДА 5
	|		ИНАЧЕ 6
	|	КОНЕЦ КАК ТипПотенциала
	|ПОМЕСТИТЬ ВТ_ИТОГ
	|ИЗ
	|	ВтСекцииСОстатками КАК ВтСекцииСОстатками
	|ГДЕ
	|	(ВтСекцииСОстатками.Паллет1 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|			ИЛИ ВтСекцииСОстатками.Паллет2 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|			ИЛИ ВтСекцииСОстатками.Паллет3 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка))
	|	И ВЫБОР
	|			КОГДА ВтСекцииСОстатками.Типоразмер.НеОграниченаПоГрузоподъемности
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ВтСекцииСОстатками.Типоразмер.Вес - (ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер1.Вес, 0) + ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер2.Вес, 0) + ЕСТЬNULL(ВтСекцииСОстатками.Типоразмер3.Вес, 0)) >= &Вес
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Ширина > ВтСекцииСОстатками.Типоразмер.Ширина * 2 / 3
	|				ТОГДА ВтСекцииСОстатками.Паллет1 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|						И ВтСекцииСОстатками.Паллет2 = ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ИТОГ.Секция КАК Секция,
	|	ВЫБОР
	|		КОГДА ВТ_ИТОГ.КоличествоПаллетВСекции = 0
	|			ТОГДА ЦЕЛ(ВТ_ИТОГ.Типоразмер.Ширина / &Ширина) / 3
	|		КОГДА ВТ_ИТОГ.КоличествоПаллетВСекции = 1
	|			ТОГДА ВЫБОР
	|					КОГДА ВТ_ИТОГ.ОстатокШирина - &Ширина >= 800
	|						ТОГДА 3 / 3
	|					ИНАЧЕ 2 / 3
	|				КОНЕЦ
	|		КОГДА ВТ_ИТОГ.КоличествоПаллетВСекции = 1
	|			ТОГДА 3 / 3
	|		ИНАЧЕ 1 / 3
	|	КОНЕЦ КАК ПлотностьПоШирине,
	|	ВЫБОР
	|		КОГДА ВТ_ИТОГ.Секция.МаксимальныйВесПодъёмаНаЭтаж = 0
	|			ТОГДА 0.3
	|		ИНАЧЕ &Вес / ВТ_ИТОГ.Секция.МаксимальныйВесПодъёмаНаЭтаж
	|	КОНЕЦ КАК ЗагузкаПоВесу,
	|	&Высота / ВТ_ИТОГ.Типоразмер.Высота КАК ЗагрузкаПоВысоте,
	|	ВЫБОР
	|		КОГДА ВТ_ИТОГ.Типоразмер.НеОграниченаПоГрузоподъемности
	|			ТОГДА 3 / 3
	|		КОГДА ВТ_ИТОГ.КоличествоПаллетВСекции = 0
	|			ТОГДА &Вес / (ВТ_ИТОГ.Типоразмер.Вес / 3)
	|		КОГДА ВТ_ИТОГ.КоличествоПаллетВСекции = 1
	|			ТОГДА ВЫБОР
	|					КОГДА ВТ_ИТОГ.ОстатокВес - &Вес >= ВТ_ИТОГ.Типоразмер.Вес / 3
	|						ТОГДА 3 / 3
	|					ИНАЧЕ 2 / 3
	|				КОНЕЦ
	|		КОГДА ВТ_ИТОГ.КоличествоПаллетВСекции = 1
	|			ТОГДА 3 / 3
	|		ИНАЧЕ 1 / 3
	|	КОНЕЦ КАК ПлотностьПоВесу
	|ПОМЕСТИТЬ ПоказателиПоСекции
	|ИЗ
	|	ВТ_ИТОГ КАК ВТ_ИТОГ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_ИТОГ.Секция КАК Секция,
	|	ВТ_ИТОГ.ВерсияДанных КАК ВерсияДанных,
	|	ВТ_ИТОГ.ПометкаУдаления КАК ПометкаУдаления,
	|	ВТ_ИТОГ.Код КАК Код,
	|	ВТ_ИТОГ.Наименование КАК Наименование,
	|	ВТ_ИТОГ.Стеллаж КАК Стеллаж,
	|	ВТ_ИТОГ.Ряд КАК Ряд,
	|	ВТ_ИТОГ.Место КАК Место,
	|	ВТ_ИТОГ.Этаж КАК Этаж,
	|	ВТ_ИТОГ.Адрес1 КАК Адрес1,
	|	ВТ_ИТОГ.Адрес2 КАК Адрес2,
	|	ВТ_ИТОГ.Адрес3 КАК Адрес3,
	|	ВТ_ИТОГ.Типоразмер КАК Типоразмер,
	|	ВТ_ИТОГ.Склад КАК Склад,
	|	ВТ_ИТОГ.АдресЦентр КАК АдресЦентр,
	|	ВТ_ИТОГ.КоличествоАдресов КАК КоличествоАдресов,
	|	ВТ_ИТОГ.Места КАК Места,
	|	ВТ_ИТОГ.ВремяДоступа КАК ВремяДоступа,
	|	ВТ_ИТОГ.Паллет1 КАК Паллет1,
	|	ВТ_ИТОГ.Паллет2 КАК Паллет2,
	|	ВТ_ИТОГ.Паллет3 КАК Паллет3,
	|	ВТ_ИТОГ.Типоразмер1 КАК Типоразмер1,
	|	ВТ_ИТОГ.Типоразмер2 КАК Типоразмер2,
	|	ВТ_ИТОГ.Типоразмер3 КАК Типоразмер3,
	|	ВТ_ИТОГ.ОстатокШирина КАК ОстатокШирина,
	|	ВТ_ИТОГ.ОстатокВес КАК ОстатокВес,
	|	ВТ_ИТОГ.ОстатокВысота КАК ОстатокВысота,
	|	ВТ_ИТОГ.УровеньДоступа КАК УровеньДоступа,
	|	ВТ_ИТОГ.Адрес КАК Адрес,
	|	ВТ_ИТОГ.ПотенциалСекции КАК ПотенциалСекции,
	|	ВТ_ИТОГ.МаксимальнаяШиринаПаллетаВРяду КАК МаксимальнаяШиринаПаллетаВРяду,
	|	ВТ_ИТОГ.НомерРяда КАК НомерРяда,
	|	ВТ_ИТОГ.ДельтаГрузоподъемности КАК ДельтаГрузоподъемности,
	|	ВТ_ИТОГ.МаксКоличествоТекПаллетаВСекции КАК МаксКоличествоТекПаллетаВСекции,
	|	ВТ_ИТОГ.ГрузоподъемностьЯчейки КАК ГрузоподъемностьЯчейки,
	|	ВТ_ИТОГ.ОстатокВесЯчейка КАК ОстатокВесЯчейка,
	|	ВТ_ИТОГ.Узкопроходный КАК Узкопроходный,
	|	ВТ_ИТОГ.МинимальнаяГлубинаНеОграничена КАК МинимальнаяГлубинаНеОграничена,
	|	ВТ_ИТОГ.ТипоразмерВес КАК ТипоразмерВес,
	|	ВТ_ИТОГ.ПотенциалПоВесу КАК ПотенциалПоВесу,
	|	ВЫБОР
	|		КОГДА ВТ_ИТОГ.ПотенциалПоВесу - ВТ_ИТОГ.ПотенциалСекции >= 0
	|			ТОГДА ВТ_ИТОГ.ПотенциалСекции
	|		ИНАЧЕ ВТ_ИТОГ.ПотенциалПоВесу
	|	КОНЕЦ КАК ПотенциалИтого,
	|	ВТ_ИТОГ.ТипПотенциала КАК ТипПотенциала,
	|	ПоказателиПоСекции.ПлотностьПоШирине КАК ПлотностьПоШирине,
	|	ПоказателиПоСекции.ЗагузкаПоВесу КАК ЗагузкаПоВесу,
	|	ПоказателиПоСекции.ПлотностьПоВесу КАК ПлотностьПоВесу,
	|	ПоказателиПоСекции.ЗагрузкаПоВысоте КАК ЗагрузкаПоВысоте,
	|	ПоказателиПоСекции.ПлотностьПоШирине * 0.25 + ПоказателиПоСекции.ЗагузкаПоВесу * 0.25 + ПоказателиПоСекции.ПлотностьПоВесу * 0.25 + ПоказателиПоСекции.ЗагрузкаПоВысоте * 0.25 КАК Рейтинг
	|ИЗ
	|	ВТ_ИТОГ КАК ВТ_ИТОГ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоказателиПоСекции КАК ПоказателиПоСекции
	|		ПО ВТ_ИТОГ.Секция = ПоказателиПоСекции.Секция
	|ГДЕ
	|	ВТ_ИТОГ.ОстатокШирина - &Ширина - (ВТ_ИТОГ.КоличествоПаллетВСекции + 1 + 1) * ВТ_ИТОГ.Секция.ЗазорПоШирине >= 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Узкопроходный УБЫВ,
	|	МинимальнаяГлубинаНеОграничена,
	|	Рейтинг,
	|	УровеньДоступа УБЫВ,
	|	ВремяДоступа УБЫВ";
	
	
	// Если параметр ОбратныйПорядокВремени = Истина, то меняем сортировку по времени на убывающую
	Если Не ОбратныйПорядокВремени Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"	ВремяДоступа УБЫВ",
		"	ВремяДоступа"); 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"	УровеньДоступа УБЫВ",
		"	УровеньДоступа"); 
		
			
			
	КонецЕсли;
	
	Если Не Потенциал3ПаллетаВСекции Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"	ПотенциалСекции УБЫВ",
			"	ПотенциалСекции");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"	ПотенциалПоВесу УБЫВ",
			"	ПотенциалПоВесу");
        	Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"	ПотенциалИтого УБЫВ",
			"	ПотенциалИтого");


	Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"_Приоритет4_ПотенцилаСекции_Убыв",
			"_Приоритет4_ПотенцилаСекции"); 
	
	КонецЕсли;
	
	Если Все Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ВЫБРАТЬ ПЕРВЫЕ 1",
			"ВЫБРАТЬ");
	
		
	КонецЕсли;
	
	
	
	Запрос.УстановитьПараметр("Склад",Склад );
	Запрос.УстановитьПараметр("Высота",  Высота );
	Запрос.УстановитьПараметр("Ширина",  Ширина );
	Запрос.УстановитьПараметр("Глубина", Глубина);
	Запрос.УстановитьПараметр("Вес",Вес );
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Все Тогда
		
		Результат = РезультатЗапроса.Выгрузить();
		
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Результат = Выборка.Адрес; 
			
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции  


Функция ПодобратьЯчейкуОперативнаяПамять(Склад, Высота,Ширина,Глубина,Вес,ОбратныйПорядокВремени=Ложь,Все=Ложь,ТЗОперативнаяПамять=Неопределено) Экспорт 
	
// ============================================================================
// ПОДБОР ЯЧЕЙКИ ДЛЯ РАЗМЕЩЕНИЯ ПАЛЛЕТА
// ============================================================================
//
// ПРИОРИТЕТЫ ПОДБОРА (ORDER BY):
//
// 0. Узкопроходные стеллажи (Узкопроходный УБЫВ)
//    Стеллажи 1-7, 10 (узкопроходные) получают приоритет перед 8А, 9 (широкопроходные).
//    Все паллеты, которые помещаются в узкопроходные, идут туда в первую очередь.
//
// 1. Best-fit по дельте грузоподъемности (ДельтаГрузоподъемности ASC)
//    Дельта = Типоразмер.Вес - ВесПаллета (для безлимитных = 999999).
//    Меньшая дельта = секция впритык по весу → не занимаем тяжёлые секции лёгкими паллетами.
//    Безлимитные секции уходят в конец (дельта 999999).
//
// 2. Ограничение глубины (МинимальнаяГлубинаНеОграничена ASC)
//    False (0) — секции с ограничением глубины (с бортиками) первыми.
//    True (1) — секции с дном (без ограничения глубины) — в конец.
//
// 3. Best-fit по высоте (ОстатокВысота ASC)
//    Меньший остаток = паллет ближе к предельной высоте → меньше пустого.
//
// 4. Потенциал секции (ПотенциалСекции)
//    Оценивает максимальное кол-во паллет, которое поместится в секцию
//    после размещения текущего паллета:
//      3 — оба края пусты или заняты узкими (≤ W/3) → максимум гибкости
//      2 — один край занят широким (> W/3) → ограничение
//      0 — оба края заняты → потенциал исчерпан
//    Направление зависит от Потенциал3ПаллетаВСекции:
//      - узкий паллет (≤ W/3): УБЫВ → предпочтение пустых секций (потенциал 3)
//      - широкий паллет (> W/3): ASC → предпочтение секций с ограничением (0-2)
//
// 5. Best-fit по весу ячейки (ОстатокВесЯчейка ASC)
//    Остаток грузоподъемности одной ячейки (секция / макс_паллетов - вес_паллета).
//    Меньший остаток = ячейка использована эффективнее.
//
// 6. Грузоподъемность секции (Типоразмер.Вес ASC)
//    Минимально достаточная полная грузоподъёмность секции.
//    Например: паллет 500кг → секция 2.5т предпочтительнее секции 6т при равном потенциале.
//
// 7. Остаток ширины (ОстатокШирина)
//    Свободная ширина секции после размещения.
//
// 8. Остаток веса (ОстатокВес)
//    Свободная грузоподъемность секции после размещения.
//
// 9. Горизонтальная зона доступа (УровеньДоступа)
//    Зоны делят склад по удалённости от точки комплектации:
//      1 — ближняя зона (первая половина секций стеллажа)
//      2 — дальняя зона (вторая половина секций стеллажа)
//    Направление зависит от ОбратныйПорядокВремени:
//      - Ложь (по умолчанию): ASC → ближние зоны первыми
//      - Истина: УБЫВ → дальние зоны первыми
//
// 10. Время доступа (ВремяДоступа)
//    Время, необходимое для доступа к ячейке (сек/мин).
//    Направление зависит от ОбратныйПорядокВремени:
//      - Ложь (по умолчанию): ASC → быстрый доступ первым
//      - Истина: УБЫВ → медленный доступ первым
//
// ============================================================================	Результат = Справочники.СкладскиеЯчейки.ПустаяСсылка();

Если ТЗОперативнаяПамять=Неопределено Тогда
	
	ТЗОперативнаяПамять = Новый ТаблицаЗначений;
	ТЗОперативнаяПамять.Колонки.Добавить("Секция",Новый ОписаниеТипов("СправочникСсылка.Лико_СкладскиеСекции"));
	ТЗОперативнаяПамять.Колонки.Добавить("Паллет",Новый ОписаниеТипов("СправочникСсылка.Лико_Паллеты2_0"));
    ТЗОперативнаяПамять.Колонки.Добавить("Адрес",Новый ОписаниеТипов("СправочникСсылка.СклдскиеЯчейки")); 
