 #Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
			   
#Область ПрограммныйИнтерфейс  
			   
			   
			   
#КонецОбласти
			   
#Область ОбработчикиСобытий
			   
			   
Процедура ПередЗаписью(Отказ)
	
		Код = СтрШаблон("Р%1-М(%2-%3-%4)-Э%5"
		,Ряд
		,Формат(Место,"ЧЦ=2; ЧВН=")
		,Формат(Место+1,"ЧЦ=2; ЧВН=")
		,Формат(Место+2,"ЧЦ=2; ЧВН=")
		,Формат(Этаж,"ЧЦ=2; ЧВН=")); 
		
		Наименование = СтрШаблон("Р%1-М(%2)-Э%3",Ряд,Места,Этаж); 
		
		// При любом изменении секции (кроме первого создания) — инкремент версии
	Если НЕ ЭтоНовый() Тогда

		// Проверяем, изменились ли критичные поля
		ЕстьИзменения = Ложь;

		Попытка
			// Получаем текущие данные из базы
			СтарыеДанные = Ссылка.ПолучитьОбъект();

			// Критичные поля для snapshot'а:
			Если СтарыеДанные.Типоразмер <> Типоразмер
				ИЛИ СтарыеДанные.ЗапретРазмещения <> ЗапретРазмещения
				ИЛИ СтарыеДанные.МаксимальныйВесПодъёмаНаЭтаж <> МаксимальныйВесПодъёмаНаЭтаж
				ИЛИ СтарыеДанные.ЗазорПоШирине <> ЗазорПоШирине Тогда

				ЕстьИзменения = Истина;
			КонецЕсли;

		Исключение
			// Если не удалось получить старые данные — инкрементируем на всякий случай
			ЕстьИзменения = Истина;
		КонецПопытки;

		Если ЕстьИзменения Тогда
			Версия = Версия + 1;
		КонецЕсли;

	Иначе
		// Первое создание — версия 1
		Если НЕ ЗначениеЗаполнено(Версия) Тогда
			Версия = 1;
		КонецЕсли;
	КонецЕсли;
	
// ═══════════════════════════════════════════════════════════════════════════
// ПРИМЕЧАНИЕ:
// ═══════════════════════════════════════════════════════════════════════════
//
// Версия инкрементируется только при изменении полей, влияющих на размещение:
// - Типоразмер (ширина/высота/глубина/вес)
// - ЗапретРазмещения
// - МаксимальныйВесПодъёмаНаЭтаж
// - ЗазорПоШирине
//
// НЕ инкрементируется при изменении:
// - Наименование, Код (административные поля)
// - ВремяДоступа, УровеньДоступа (приоритизация, не физика)
// - Адрес1/2/3 (они меняются через документы перемещения паллет)

		

КонецПроцедуры
			   
#КонецОбласти
			   
#Область СлужебныеПроцедурыИФункции
			   
#КонецОбласти
			   
			   
#Иначе

ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.';
			   |en = 'Invalid object call on the client.'");

#КонецЕсли
		   
		   
		   
