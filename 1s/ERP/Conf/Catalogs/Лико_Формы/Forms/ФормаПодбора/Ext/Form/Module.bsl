&НаСервере
Процедура УстановитьПараметрыНаСервере() //+Лико m.shenderov 26.01.2018   
	
	СписокФорм.Параметры.УстановитьЗначениеПараметра("КодФормыОтборДляПриоритета", КодФормыОтбор);
	СписокФорм.Параметры.УстановитьЗначениеПараметра("КодФормыОтбор", ?(ЗначениеЗаполнено(КодФормыОтбор),"%"+КодФормыОтбор+"%",""));
	СписокФорм.Параметры.УстановитьЗначениеПараметра("НоменклатураОтбор", ?(ЗначениеЗаполнено(НоменклатураОтбор),"%"+НоменклатураОтбор+"%",""));
	СписокФорм.Параметры.УстановитьЗначениеПараметра("КонтрагентОтбор",?(ЗначениеЗаполнено(КонтрагентОтбор), "%"+КонтрагентОтбор+"%",""));
	СписокФорм.Параметры.УстановитьЗначениеПараметра("ПоРасположению",Ложь);
	СписокФорм.Параметры.УстановитьЗначениеПараметра("Расположение",Конверт); 
	СписокФорм.Параметры.УстановитьЗначениеПараметра("ИспользоватьРЦ",Ложь); 
	СписокФорм.Параметры.УстановитьЗначениеПараметра("ЗаказКлиента",ЗаказКлиента); 
	СписокФорм.Параметры.УстановитьЗначениеПараметра("ЕстьЗаказКлиента",ЗначениеЗаполнено(ЗаказКлиента)); 
	СписокФорм.Параметры.УстановитьЗначениеПараметра("ВидПечати",ВидПечати); 
	СписокФорм.Параметры.УстановитьЗначениеПараметра("ЕстьВидПечати",ЗначениеЗаполнено(ВидПечати)); 

	СписокФорм.Параметры.УстановитьЗначениеПараметра("Организация",Организация); 
	СписокФорм.Параметры.УстановитьЗначениеПараметра("ЕстьОрганизация",ЗначениеЗаполнено(Организация)); 


	
	
	Если ЗначениеЗаполнено(Конверт) Тогда
		СписокФорм.Параметры.УстановитьЗначениеПараметра("Расположение",Конверт); 
		СписокФорм.Параметры.УстановитьЗначениеПараметра("ПоРасположению",Истина);
		
	КонецЕсли;
	УстановитьПараметрВыбранныхФормСервер();	
	//Если Не (ЗначениеЗаполнено(КодФормыОтбор) Или
	//	ЗначениеЗаполнено(НоменклатураОтбор) Или 
	//	ЗначениеЗаполнено(КонтрагентОтбор)Или
	//	ЗначениеЗаполнено(Конверт)) Тогда
	//	СписокФорм.Параметры.УстановитьЗначениеПараметра("Расположение",Неопределено);
	//	СписокФорм.Параметры.УстановитьЗначениеПараметра("ПоРасположению",Истина);
	//	
	//КонецЕсли;
	
	
	
	Если ИспользоватьРЦ Тогда
		СписокФорм.Параметры.УстановитьЗначениеПараметра("ИспользоватьРЦ",Истина); 
		
		СписокФорм.Параметры.УстановитьЗначениеПараметра("Расположение",РабочийЦентр);
		СписокФорм.Параметры.УстановитьЗначениеПараметра("ПоРасположению",Истина);
		
	КонецЕсли;  	
	
КонецПроцедуры  //-Лико m.shenderov 26.01.2018
