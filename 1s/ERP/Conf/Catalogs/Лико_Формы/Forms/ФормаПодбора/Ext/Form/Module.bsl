КонецПроцедуры 

&НаКлиенте
Процедура ДобавитьВДокумент(Команда)
	Соответствие = Новый Соответствие;
	Массив = Новый Массив();
	
	ВыбранныеФормы=ФормыДляПодбора.НайтиСтроки(Новый Структура("Выбрана",Истина));
	Для каждого Форма Из ФормыДляПодбора Цикл
		Массив.Добавить(Форма.Форма);
		Если ИспользоватьРЦ Тогда
			Соответствие.Вставить(Форма.Форма,Форма.Конверт);
		Иначе
			Соответствие.Вставить(Форма.Форма,Форма.Расположение);
			
		КонецЕсли;
		
		
	КонецЦикла;
	Структура = Новый Структура;
	Структура.Вставить("Массив",Массив);
	Структура.Вставить("Соответствие",Соответствие);
	Закрыть(Структура);
КонецПроцедуры

