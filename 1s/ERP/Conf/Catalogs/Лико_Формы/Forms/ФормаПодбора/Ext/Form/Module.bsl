

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 		
	Если Параметры.Свойство("РабочийЦентр") Тогда
		РабочийЦентр					=Параметры.РабочийЦентр;
		Элементы.РабочийЦентр.Видимость			=Истина;
		Элементы.Конверт.Видимость				=Ложь;
		Элементы.ГруппаФильтр.Видимость			=Ложь;
		ИспользоватьРЦ							=Истина;
		Элементы.ТаблицаФормКонверт.Видимость	=Истина;
	Иначе
		
		Элементы.РабочийЦентр.Видимость			=Ложь;
		Элементы.Конверт.Видимость				=Истина;
		Элементы.ГруппаФильтр.Видимость			=Истина;
		Элементы.ТаблицаФормКонверт.Видимость	=Ложь;
		
		
	КонецЕсли;
	
	Если Параметры.Свойство("ЗаявкаНаИзготовлениеФорм") Тогда
		Элементы.ЗаказКлиента.Видимость=Истина;		
	КонецЕсли;
	
	
	Если Параметры.Свойство("ВидПечати") Тогда
		ВидПечати=Параметры.ВидПечати;		
	КонецЕсли;
	
	Если Параметры.Свойство("ЗаказКлиента") Тогда
		ЗаказКлиента=Параметры.ЗаказКлиента;		
	КонецЕсли;
	
	Если Параметры.Свойство("Организация") Тогда
		Организация=Параметры.Организация;
	КонецЕсли;
	

	
	
	
	
	
	
	
	Если Параметры.Свойство("Конверт") Тогда
		Конверт=Параметры.Конверт;
	КонецЕсли;
	

	
	//ЗаполнитьТаблицуФорм();
	УстановитьПараметрыНаСервере();
	УправлениеЭлементамиФормы();
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	
КонецПроцедуры


