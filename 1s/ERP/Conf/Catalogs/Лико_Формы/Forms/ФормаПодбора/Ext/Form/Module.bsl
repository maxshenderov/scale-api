&НаСервере
Процедура ВыбратьВсеНаСервере()
	Если ФормыДляПодбора.Количество()>0 Тогда	
		ФормыДляПодбора.Очистить();
	Иначе
		Тз= Получить_ТЗ_Из_ДинамическогоСписка();
		Если Тз.Количество()>100 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Слишком большой список форм!. Установите отбор форм.";
		Сообщение.Сообщить();	
			Возврат;	
		КонецЕсли;
		
		Для каждого Форма Из Тз Цикл
			Структура = Новый Структура;
			Структура.Вставить("Форма",Форма.Форма);
			НайденныеСтроки= ФормыДляПодбора.НайтиСтроки(Структура);
			Если НайденныеСтроки.Количество()=0 Тогда
				
				НоваяФыбраннаяФорма=ФормыДляПодбора.Добавить();
				ЗаполнитьЗначенияСвойств( НоваяФыбраннаяФорма,Форма);
			КонецЕсли;
					
		КонецЦикла;
	КонецЕсли;
		КоличествоВыбранныхФорм=ФормыДляПодбора.Количество();	

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	ВыбратьВсеНаСервере();
	УстановитьПараметрВыбранныхФорм();	
	
КонецПроцедуры



&НаСервере
Функция Получить_ТЗ_Из_ДинамическогоСписка()
	
	Схема = Элементы.СписокФорм.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы.СписокФорм.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ТЗ = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(ТЗ); 
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	Возврат ТЗ;
	
КонецФункции


&НаКлиенте
Процедура ТаблицаФормПересветПриИзменении(Элемент)
	
	ТД=Элементы.ТаблицаФорм.ТекущиеДанные;
	
	Если ТД<>Неопределено Тогда
		УстановитьПересветСервер(Тд.Форма,ТД.Пересвет);		
	КонецЕсли;
	
	

КонецПроцедуры

