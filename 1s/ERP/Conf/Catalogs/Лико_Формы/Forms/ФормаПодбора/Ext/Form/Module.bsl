&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если  ИмяСобытия="АвторизацияОператора" Тогда
		Оператор=ГлЛико_Оператор;   
	КонецЕсли;
	
	
	// ПодключаемоеОборудование
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" Тогда
			ОбработатьШтрихкоды(ПодключаемоеОборудованиеУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр));
		КонецЕсли;
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
	
	
КонецПроцедуры



&НаКлиенте
Процедура ОбработатьШтрихкоды(ДанныеШтрихкода)
	
	
	
	Результат = Лико_ДополнительноКлиент.ОбработатьШтрихКодНеТовара(ДанныеШтрихкода.Штрихкод);
	Если Результат.Ошибка <> "" Тогда
		Сообщить(Результат.Ошибка);
	Иначе
		Если Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Конверта") Тогда
			
			Конверт= Результат.Конверт;
			//ЗаполнитьТаблицуФорм();
			УправлениеЭлементамиФормы();
			УстановитьПараметрыНаСервере();
			
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры


&НаКлиенте
Процедура ВыбратьПриИзменении(Элемент)
	
	Для каждого Товар Из ФормыДляПодбора Цикл
		Товар.Выбрана=Выбрать;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СписокФормВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	ТекФорма=Элементы.СписокФорм.ТекущиеДанные;
	Структура = Новый Структура;
	Структура.Вставить("Форма",ТекФорма.Форма);
	НайденныеСтроки= ФормыДляПодбора.НайтиСтроки(Структура);
	Если НайденныеСтроки.Количество()=0 Тогда
		
		НоваяФыбраннаяФорма=ФормыДляПодбора.Добавить();
		ЗаполнитьЗначенияСвойств( НоваяФыбраннаяФорма,ТекФорма);
	Иначе
		Для каждого НайденаяСтрока Из НайденныеСтроки Цикл
			ФормыДляПодбора.Удалить(ФормыДляПодбора.Индекс(НайденаяСтрока));
			
		КонецЦикла;
		
	КонецЕсли;
	КоличествоВыбранныхФорм=ФормыДляПодбора.Количество();	
	УстановитьПараметрВыбранныхФорм();	
КонецПроцедуры

