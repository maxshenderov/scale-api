
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ФормаОтбор") Тогда
		Для каждого Стр Из Параметры.ФормаОтбор Цикл
			НС = Список.Добавить();
			НС.ВысотаЭтикетки = Окр(Стр.Раппорт.ДлинаПечати,2)/Стр.КоличествоЭтикеток;
			НС.Раппорт = Стр.Раппорт
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.Заголовок) Тогда
		Заголовок = Параметры.Заголовок;
		АвтоЗаголовок = Ложь;
	КонецЕсли;
	
	Если Параметры.Свойство("Заказ") Тогда
		Если Параметры.Заказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПолныйПовтор ИЛИ Параметры.Заказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПовторСИзменением Тогда
			Элементы.ДекорацияСообщение.Заголовок = Элементы.ДекорацияСообщение.Заголовок + "(* Вид заказа изменится с " + """" + Параметры.Заказ.ВидЗаказа + """" + " на ""Новый"")";	
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные; 
	ДанныеВыбора = Новый Структура("ВысотаЭтикетки,Раппорт",ТекущиеДанные.ВысотаЭтикетки,ТекущиеДанные.Раппорт);
	Закрыть(ДанныеВыбора);
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные; 
	ДанныеВыбора = Новый Структура("ВысотаЭтикетки,Раппорт",ТекущиеДанные.ВысотаЭтикетки,ТекущиеДанные.Раппорт);
	Закрыть(ДанныеВыбора);
КонецПроцедуры
