Функция ПолучитьПриоритетМакс(ВидНоменклатуры) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(Лико_КонтрольПартийПоризводстваНоменклатуры.Приоритет) КАК Приоритет
	|ИЗ
	|	Справочник.Лико_КонтрольПартийПоризводстваНоменклатуры КАК Лико_КонтрольПартийПоризводстваНоменклатуры
	|ГДЕ
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры";
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Возврат ?(ЗначениеЗаполнено(Выборка.Приоритет),Выборка.Приоритет,0);
		
	КонецЦикла; 
	
	Возврат 0;	
КонецФункции //-Лико m.shenderov 28.12.2018 

Процедура ПереместитьПоПриоритету(Ссылка,Шаг) Экспорт 
	
	
	ТекущийПриоритет	=	Ссылка.Приоритет;
	НовыйПриоритет		=	ТекущийПриоритет+Шаг;
	
	Если НовыйПриоритет=0 Или НовыйПриоритет=ПолучитьПриоритетМакс(Ссылка.ВидНоменклатуры)+1 Тогда
		Возврат;
	КонецЕсли;
	
	ПравилоКонкурент=ПолучитьПравилоПоПриоритету(Ссылка.ВидНоменклатуры,НовыйПриоритет);
	
	НачатьТранзакцию();
	
	СправочникОбъект			=Ссылка.ПолучитьОбъект();
	СправочникОбъект.Приоритет	=НовыйПриоритет; 	
	СправочникОбъект.Записать();
	Если ЗначениеЗаполнено(ПравилоКонкурент) Тогда
		
		СправочникОбъект			 =ПравилоКонкурент.ПолучитьОбъект();
		СправочникОбъект.Приоритет	 =СправочникОбъект.Приоритет-Шаг; 	
		СправочникОбъект.Записать();
	КонецЕсли;
	
	
	
	
	ЗафиксироватьТранзакцию();
	
	
	
КонецПроцедуры //-Лико m.shenderov 28.12.2018

Функция ПолучитьПравилоПоПриоритету(ВидНоменклатуры,Приоритет) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Лико_КонтрольПартийПоризводстваНоменклатуры КАК Лико_КонтрольПартийПоризводстваНоменклатуры
	|ГДЕ
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры
	|	И Лико_КонтрольПартийПоризводстваНоменклатуры.Приоритет = &Приоритет";
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры);
	Запрос.УстановитьПараметр("Приоритет",Приоритет);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Возврат Выборка.Ссылка;	
		
	КонецЦикла; 
	
	
КонецФункции //-Лико m.shenderov 29.12.2018 

Функция СформироватьИмяПартии(Номенклатура,Серия,ПрослеживаемостьТоваров) Экспорт  //+Лико m.shenderov 27.03.2023
	Имя="Не требуется";
	Если ПрослеживаемостьТоваров Тогда 
		ОН=Серия.ЯССМ_ОбъектНоменклатуры;
		
		Если  Номенклатура.Лико_КонтрольПартииПроизводстваТовара Или Не ОН.Уникальный  Тогда 
			Если Не ОН.ЕстьПартияПроизводства И РегистрыСведений.Лико_ПартииПроизводства.ПартияНаследуется(Серия) Тогда 
				Имя="Наследуется";
			Иначе
				Имя=СтрШаблон("%1; %2 ; %3",
				?(ЗначениеЗаполнено(ОН.ПричинаОтсутствияНомераПартииИзготовления),ОН.ПричинаОтсутствияНомераПартииИзготовления,ОН.НомерПартииИзготовления),
				?(ЗначениеЗаполнено(ОН.ПричинаОтсутствияДатыИзготовления),ОН.ПричинаОтсутствияДатыИзготовления,?(ЗначениеЗаполнено(ОН.ДатаПроизводства),Формат(ОН.ДатаПроизводства,"ДЛФ=D"),"")),
				?(ЗначениеЗаполнено(ОН.УпотребитьДо),Формат(ОН.УпотребитьДо,"ДЛФ=D"),""));
			КонецЕсли;
		Иначе
			Имя="Не требуется";
		КонецЕсли;
	КонецЕсли;
	
	Возврат  Имя;	
КонецФункции  //-Лико m.shenderov 27.03.2023

Функция ТребоватьПартию(ОбъектНоменклатуры) Экспорт  //+Лико m.shenderov 30.03.2023

	
	Если ОбъектНоменклатуры.Номенклатура.Лико_КонтрольПартииПроизводстваТовара И  
		Не ЕстьПартияПроизводства(ОбъектНоменклатуры) И
		Не РегистрыСведений.Лико_ПартииПроизводства.ПартияНаследуется(ОбъектНоменклатуры.Серия) Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
	
	
	
	
КонецФункции //-Лико m.shenderov 30.03.2023 

Функция ЕстьПартияПроизводства(ОбъектНоменклатуры) Экспорт  //+Лико m.shenderov 30.03.2023
	
	Если (ЗначениеЗаполнено(ОбъектНоменклатуры.НомерПартииИзготовления) Или ЗначениеЗаполнено(ОбъектНоменклатуры.ПричинаОтсутствияНомераПартииИзготовления)) И 
		(ЗначениеЗаполнено(ОбъектНоменклатуры.ДатаПроизводства) Или ЗначениеЗаполнено(ОбъектНоменклатуры.ПричинаОтсутствияДатыИзготовления)) Тогда
		ЕстьПартияПроизводства=Истина;
	Иначе
		ЕстьПартияПроизводства=Ложь;
	КонецЕсли;
	 Возврат   ЕстьПартияПроизводства;
КонецФункции //-Лико m.shenderov 30.03.2023 
