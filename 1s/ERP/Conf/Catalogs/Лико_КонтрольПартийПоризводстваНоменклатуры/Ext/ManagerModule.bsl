Функция Старт()  Экспорт //+Лико m.shenderov 29.03.2023
	ДатаНачалаКонтроляПартииПроизводстваТовара=Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаКонтроляПартииПроизводстваТовара.ЗначениеПараметра;
	
	Если ЗначениеЗаполнено(ДатаНачалаКонтроляПартииПроизводстваТовара) И ДатаНачалаКонтроляПартииПроизводстваТовара< ТекущаяДата() Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь; 
	
КонецФункции //-Лико m.shenderov 29.03.2023 

Функция ЕстьКонтроль(Номенклатура,ДокументРасхода=Неопределено) Экспорт
	
	ЕстьКонтроль=Ложь;	
	Запрос = Новый Запрос;
	Запрос.Текст=ТекстЗапросаПравилПоВидуНоменклатуры(); 
	Запрос.УстановитьПараметр("ВидНоменклатуры",Номенклатура.ВидНоменклатуры );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл 		
		ИспользоватьЭтоПравило=Истина;	
		Если Выборка.СложнаяНастройка Тогда 
		ИспользоватьЭтоПравило= ИспользоватьПравилоСКД(Выборка,Номенклатура,Истина);		
			
		Иначе
			Для каждого ДопРеквизит Из Выборка.Ссылка.ДополнительныеРеквизиты Цикл			
				Если ЗначениеЗаполнено(ДопРеквизит.Значение) ТОгда
					Структура = Новый Структура;
					Структура.Вставить("Свойство",ДопРеквизит.Свойство);
					Структура.Вставить("Значение",ДопРеквизит.Значение);
					НайденоСвойство=Номенклатура.ДополнительныеРеквизиты.НайтиСтроки(Структура).Количество()>0;
					ЕСли  НайденоСвойство и ДопРеквизит.Исключить ТОгда
						ИспользоватьЭтоПравило=Ложь;
						Прервать;
					ИначеЕсли НЕ НайденоСвойство и НЕ  ДопРеквизит.Исключить ТОгда
						ИспользоватьЭтоПравило=Ложь; 
						Прервать;				
					КонецЕсли;				
				КонецЕсли;
			КонецЦикла; 
		КонецЕсли;
		
		Если ИспользоватьЭтоПравило Тогда
			Возврат Истина;
		КонецЕсли;			
		
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции

Процедура УстановитьЗначениеПараметраНастроек(Настройки, ИмяПараметра, Значение)
	
	Параметр = Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = Значение;
		Параметр.Использование = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ИспользоватьПравилоСКД(Выборка,Номенклатура,ПоНоменклатуре) Экспорт  //+Лико m.shenderov 30.12.2018
	ОтборНастройки= Новый КомпоновщикНастроекКомпоновкиДанных;
    СхемаКомпоновкиДанных = Справочники.Лико_КонтрольПартийПоризводстваНоменклатуры.ПолучитьМакет("ОтборПоУсловию");
	//URLСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, Новый УникальныйИдентификатор());
   ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных);
   ОтборНастройки.Инициализировать(ИсточникНастроек);
   	ТекНастройки = Выборка.ОтборНастройки.Получить();
	
	Если ТекНастройки = Неопределено Тогда
		ОтборНастройки.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Иначе
		ОтборНастройки.ЗагрузитьНастройки(ТекНастройки);
	КонецЕсли;
	//ОтборНастройки.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
    УстановитьЗначениеПараметраНастроек(ОтборНастройки.Настройки, "Номенклатура"  , Номенклатура);
	УстановитьЗначениеПараметраНастроек(ОтборНастройки.Настройки, "ПоНоменклатуре", ПоНоменклатуре);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ОтборНастройки.ПолучитьНастройки(),,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	Если Не ПоНоменклатуре Тогда
		Возврат ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных).ВыгрузитьКолонку("Номенклатура");
	КонецЕсли;
	
	Если 	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных).Количество()>0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли; 	
КонецФункции //-Лико m.shenderov 30.12.2018 

Функция ТекстЗапросаПравилПоВидуНоменклатуры()
	
	Возврат 
	"ВЫБРАТЬ
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.Ссылка КАК Ссылка,
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.ВерсияДанных КАК ВерсияДанных,
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.ПометкаУдаления КАК ПометкаУдаления,
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.Код КАК Код,
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.Наименование КАК Наименование,
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.Выключить КАК Выключить,
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.Организация КАК Организация,
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.ВидНоменклатуры КАК ВидНоменклатуры,
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.Описание КАК Описание,
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.Предопределенный КАК Предопределенный,
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.СложнаяНастройка КАК СложнаяНастройка,
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.ОтборНастройки КАК ОтборНастройки,
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.Приоритет КАК Приоритет
	|ИЗ
	|	Справочник.Лико_КонтрольПартийПоризводстваНоменклатуры КАК Лико_КонтрольПартийПоризводстваНоменклатуры
	|ГДЕ
	|	Лико_КонтрольПартийПоризводстваНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры
	|	И НЕ Лико_КонтрольПартийПоризводстваНоменклатуры.ПометкаУдаления
	|	И НЕ Лико_КонтрольПартийПоризводстваНоменклатуры.Выключить
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	
