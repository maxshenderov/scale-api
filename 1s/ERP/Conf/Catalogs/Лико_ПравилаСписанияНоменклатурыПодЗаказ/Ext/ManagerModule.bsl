Функция ОпределитьПравило2(Номенклатура,ДокументРасхода=Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
		
	Если ДокументРасхода=Неопределено Тогда
		ДокументРасхода=Документы.Лико_ПередачаТоваров.ПустаяСсылка();
	КонецЕсли;
	
	НастройкаПравил= ПолучитьНастройкуПравил(Номенклатура.ВидНоменклатуры, ДокументРасхода.Организация);
	Если Не ЗначениеЗаполнено(НастройкаПравил) ИЛИ не ЗначениеЗаполнено(НастройкаПравил.ТекстЗапроса) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = НастройкаПравил.ТекстЗапроса;
	
	Для каждого Параметр Из НастройкаПравил.ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ,Параметр.Значение); 		
	КонецЦикла;
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Запрос.УстановитьПараметр("ДокументРасхода",ДокументРасхода);




	
	ПакетЗапроса = Запрос.ВыполнитьПакет();
	Ном =0;
	Для каждого Пакет Из ПакетЗапроса Цикл
		Если Не Пакет.Пустой() ТОгда
			Возврат НастройкаПравил.СоответствиеПравил[Ном];
		КонецЕсли;
		
	Ном=Ном+1;		
КонецЦикла;

КонецФункции

Процедура СохранитьНастройкуПравил(ВидНоменклатуры, Организация) Экспорт

	СоответствиеПравил= Новый Соответствие;

		Запрос = Новый Запрос;
	Запрос.Текст=ТекстЗапросаПравилПоВидуНоменклатуры(); 
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры );
	Запрос.УстановитьПараметр("Организация",Организация );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	ТекстЗапроса="";
	НомерЗапроса=1;
	ПараметрыЗапроса=Новый Структура;
	Ном=0;
	Пока Выборка.Следующий() Цикл 		
		СоответствиеПравил.Вставить(Ном,Выборка.Ссылка);
		СформироватьЗапросИзСКД(Выборка,ТекстЗапроса,ПараметрыЗапроса,НомерЗапроса);		
		НомерЗапроса=НомерЗапроса+1;		 
		Ном=Ном+1;	
	КонецЦикла;
	
	Структура=Новый Структура;
	Структура.Вставить("СоответствиеПравил",СоответствиеПравил);
	Структура.Вставить("ТекстЗапроса",ТекстЗапроса);
	Структура.Вставить("ПараметрыЗапроса",ПараметрыЗапроса);


	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПравилаСписанияНоменклатурыПодЗаказ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Лико_ПравилаСписанияНоменклатурыПодЗаказ КАК Лико_ПравилаСписанияНоменклатурыПодЗаказ
	|ГДЕ
	|	Лико_ПравилаСписанияНоменклатурыПодЗаказ.ВидНоменклатуры = &ВидНоменклатуры
	|	И Лико_ПравилаСписанияНоменклатурыПодЗаказ.ЭтоГруппа
	|	И Лико_ПравилаСписанияНоменклатурыПодЗаказ.Организация = &Организация";
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры );
	Запрос.УстановитьПараметр("Организация",Организация );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СпрОбъект=Выборка.Ссылка.ПолучитьОбъект();
		СпрОбъект.НастройкаПравил=Новый ХранилищеЗначения(Структура);
	СпрОбъект.Записать();		
	КонецЦикла; 
	
	
	



		
КонецПроцедуры //-Лико m.shenderov 08.07.2020

Функция ПолучитьПриоритетМакс(ВидНоменклатуры, Организация) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(Лико_ПравилаСписанияНоменклатурыПодЗаказ.Приоритет) КАК Приоритет
	|ИЗ
	|	Справочник.Лико_ПравилаСписанияНоменклатурыПодЗаказ КАК Лико_ПравилаСписанияНоменклатурыПодЗаказ
	|ГДЕ
	|	Лико_ПравилаСписанияНоменклатурыПодЗаказ.ВидНоменклатуры = &ВидНоменклатуры
	|	И Лико_ПравилаСписанияНоменклатурыПодЗаказ.Организация = &Организация";
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры );
	Запрос.УстановитьПараметр("Организация",Организация );

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Приоритет) Тогда
			Возврат Выборка.Приоритет;
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат 0;	
КонецФункции //-Лико m.shenderov 28.12.2018 

Процедура ПереместитьПоПриоритету(Ссылка,Шаг) Экспорт 
	
	
	ТекущийПриоритет	=	Ссылка.Приоритет;
	НовыйПриоритет		=	ТекущийПриоритет+Шаг;
	
	Если НовыйПриоритет=0 Или НовыйПриоритет=ПолучитьПриоритетМакс(Ссылка.ВидНоменклатуры, Ссылка.Организация)+1 Тогда
		Возврат;
	КонецЕсли;
	
	ПравилоКонкурент=ПолучитьПравилоПоПриоритету(Ссылка.ВидНоменклатуры,НовыйПриоритет);
	
	НачатьТранзакцию();
	
	СправочникОбъект			=Ссылка.ПолучитьОбъект();
	СправочникОбъект.Приоритет	=НовыйПриоритет; 	
	СправочникОбъект.Записать();
	Если ЗначениеЗаполнено(ПравилоКонкурент) Тогда
		
		СправочникОбъект			 =ПравилоКонкурент.ПолучитьОбъект();
		СправочникОбъект.Приоритет	 =СправочникОбъект.Приоритет-Шаг; 	
		СправочникОбъект.Записать();
	КонецЕсли;
	
	
	
	
	ЗафиксироватьТранзакцию();
	
	
	
КонецПроцедуры //-Лико m.shenderov 28.12.2018

Функция ПолучитьПравилоПоПриоритету(ВидНоменклатуры,Приоритет) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка ИЗ Справочник.Лико_ПравилаСписанияНоменклатурыПодЗаказ КАК Док
	|ГДЕ Док.ВидНоменклатуры = &ВидНоменклатуры И Док.Приоритет = &Приоритет";
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры);
	Запрос.УстановитьПараметр("Приоритет",Приоритет);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Возврат Выборка.Ссылка;	
		
	КонецЦикла; 
	
	
КонецФункции //-Лико m.shenderov 29.12.2018 

 
