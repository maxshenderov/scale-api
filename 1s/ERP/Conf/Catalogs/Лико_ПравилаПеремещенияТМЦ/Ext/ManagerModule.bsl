Функция ПараметрыЗапроса(Товар,ДокументОбъект)
	
	Структура = Новый Структура;
	Структура.Вставить("Документ",ДокументОбъект.Ссылка);
	Структура.Вставить("Дата",ДокументОбъект.Дата); 
	Структура.Вставить("Номенклатура",Товар.Номенклатура);
	Структура.Вставить("ВидОперации",Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПустаяСсылка());
	Структура.Вставить("РабочийЦентр",Справочники.РабочиеЦентры.ПустаяСсылка()); 
	Структура.Вставить("Серия",Товар.Серия); 
	Структура.Вставить("ТипДокумента",ТипДокументаПередачи(ДокументОбъект));
	Структура.Вставить("МетодДвиженияМеждуСкладами",Товар.МетодДвиженияМеждуСкладами);
	Структура.Вставить("НеИспользоватьПравило",Ложь); 
	Структура.Вставить("РабочееМесто",ДокументОбъект.РабочееМесто); 
	
	Если ТипЗнч(ДокументОбъект.Ссылка)=Тип("ДокументСсылка.Лико_ЗаявкаНаСклад") Тогда
		
		Структура.НеИспользоватьПравило =ДокументОбъект.НеИспользоватьПравило; 
		
	КонецЕсли;
	
	
	ЗаполнитьЗначенияСвойств(Структура,ДокументОбъект); 
	ПараметрыЗапросаПередачаТоваровПереопеделяемый(Структура,ДокументОбъект);
	
	Возврат Структура;
	
		
КонецФункции 

Функция ТипДокументаПередачи(ДокументОбъект)
	
	Если ТипЗнч(ДокументОбъект.Ссылка)=Тип("ДокументСсылка.Лико_БланкЭтапа") Тогда
		Возврат "ЗакрытиеБланка";
	КонецЕсли;
	
	Если ТипЗнч(ДокументОбъект.Ссылка)=Тип("ДокументСсылка.Лико_ЗаявкаНаСклад") Тогда
		Возврат "ЗаявкаНаСклад";
	КонецЕсли;
	
	Если ТипЗнч(ДокументОбъект.Ссылка)=Тип("ДокументСсылка.Лико_ПередачаТоваров") Тогда
		Возврат "ПередачаТоваров";
	КонецЕсли;
	
	Возврат "";
	
	
