Процедура  СтратегияЗаблокировать(тзТовары,ДокументОбъект,Отказ, Ответ)
	Индекс = 0;	
	
	Для каждого тзТовар Из ТзТовары Цикл 
		Индекс=Индекс+1;
		
		
		Если тзТовар.Правило=Перечисления.Лико_СтратегииПеремещенияТМЦ.Заблокировать Тогда
			
			Отказ = Истина;
			
			
			Сообщение = Новый СообщениеПользователю;
			
			Текст=СтрШаблон("Объекта номенклатуры: %1 заблокирован! Правило № %2  (%3)! ",тзТовар.Серия,тзТовар.Правило.Код,тзТовар.Правило.ТекстСообщения);
			Сообщение.Текст = Текст;
			
			
			Сообщение.Поле = "Товары["+(Индекс-1)+"].Номенклатура";
			Сообщение.УстановитьДанные(ДокументОбъект);
			Сообщение.Сообщить();   			 
			
		КонецЕсли; 				
	КонецЦикла;
	
КонецПроцедуры  
 
Процедура СтратегияЗаполнитьПоПравилу(ТзТовары,ДокументОбъект, Отказ, Ответ)
	
	ЗаполнитьПоПравилу=Ложь;
	тзНеИспользоватьПравило=Неопределено;
	
	Для каждого Товар Из ТзТовары Цикл 
		
		Если Товар.Правило.Действие=Перечисления.Лико_ДействияПоПравилуПеремещенияТМЦ.ЗаполнитьПоПравилу Тогда 
			
			ЗаполнитьПоПравилу = Истина;
			Прервать;
		КонецЕсли;	
		
	КонецЦикла;
	
	
	Если Отказ Или Не ЗаполнитьПоПравилу Тогда
		
		Возврат;
		
	КонецЕсли;

	ТзТовары				= ТаблицаТоварыСДопСвойствамиСвернуто(ДокументОбъект, ТзТовары); 
	
	СоответствиеПравил		= СоответсвиеПравилоНоменклатура(ТзТовары);					 
	
	СооПравилоВыборка = Новый Соответствие;	
	СооПравилоВыборка = СоответсвиеПравилоВыборкаДанных(СоответствиеПравил,ДокументОбъект);	

	
	Правило 				= Неопределено;
	ТекНоменклатура 		= Неопределено;
	ТекСклад 			    = Неопределено;
	ТекПомещение 			= Неопределено;
	КоличествоВУпаковке 	= 0;
	
	Индекс=0;
	
	ДокументОбъектТовары=ДокументОбъект.Товары.Выгрузить();
	
	ДокументОбъектТовары.Очистить();
	
	НеИспользоватьПравило = НеИспользоватьПравило(ДокументОбъект);
	тзНеИспользоватьПравило = ТзТовары.Скопировать();
	тзНеИспользоватьПравило.Очистить();
	
	Для каждого тзТовар Из ТзТовары Цикл 
		Индекс=Индекс+1;
		
		
		
		
		
		
		
		КоличествоОсталось = ТзТовар.КоличествоУпаковок;
		
		
		
		Если ЗначениеЗаполнено(тзТовар.Правило) Тогда
			
			Если НеИспользоватьПравило Тогда
				
				НовыйТовар = ДокументОбъектТовары.Добавить();
				ЗаполнитьЗначенияСвойств( НовыйТовар, тзТовар);  
				
				НовыйТовар = тзНеИспользоватьПравило.Добавить();
				ЗаполнитьЗначенияСвойств( НовыйТовар, тзТовар); 

			
			КоличествоОсталось =0;

				
				
				Иначе
			
			
			Если  тзТовар.Правило <> Правило Тогда
				
				Правило 			= тзТовар.Правило;
				РезультатЗапроса 	= СооПравилоВыборка[Правило];
				
				ТекНоменклатура 		= Неопределено;
				ТекПомещение 			= Неопределено;
				КоличествоВУпаковке 	= 0; 
				
				
				
			КонецЕсли;	
			
			Если ТекНоменклатура 		<> 	тзТовар.Номенклатура Тогда  
				ТекНоменклатура 		= 	тзТовар.Номенклатура;
				
				ТекПомещение 			= 	Неопределено;
				КоличествоВУпаковке 	=	Неопределено;
				
				ВыборкаНоменклатур 	= РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока  ВыборкаНоменклатур.Следующий() Цикл
					
					Если ВыборкаНоменклатур.Номенклатура= ТекНоменклатура Тогда
						
						Прервать;
						
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;
			
			
			
			Если Не (ТекПомещение 		= 	тзТовар.Помещение
				И КоличествоВУпаковке 	=	тзТовар.КоличествоВУпаковке) Тогда
				
				ТекПомещение 			= 	тзТовар.Помещение;
				КоличествоВУпаковке 	=	тзТовар.КоличествоВУпаковке;
				Выборка = ВыборкаНоменклатур.Выбрать(); 
				
			КонецЕсли;
			
			
			Пока Выборка.Следующий() Цикл
				
				Если Выборка.Номенклатура 			= тзТовар.Номенклатура
					И   Выборка.Помещение 			= тзТовар.Помещение
					И  Выборка.КоличествоВУпаковке 	= тзТовар.КоличествоВУпаковке Тогда
					
					НовыйТовар = ДокументОбъектТовары.Добавить();
					ЗаполнитьЗначенияСвойств( НовыйТовар, Выборка);
					КоличествоОсталось=КоличествоОсталось-НовыйТовар.КоличествоУпаковок; 					
					
				КонецЕсли;
				
				Если КоличествоОсталось<=0 Тогда
					
					Прервать;					
				КонецЕсли;				
			КонецЦикла; 
			
		КонецЕсли;	
			
		Иначе 
			
			НовыйТовар = ДокументОбъектТовары.Добавить();
			ЗаполнитьЗначенияСвойств( НовыйТовар, тзТовар); 
			
			КоличествоОсталось =0;
			
			
		КонецЕсли; 
		
		
		Если КоличествоОсталось > 0 Тогда
			
			Отказ = Истина;
			
			Сообщение 		= 	Новый СообщениеПользователю;
			Сообщение.Текст =	СтрШаблон("На складе не хватает номенклатуры : (%1)-%2-(%3) в количестве: %4",
			тзТовар.Номенклатура.Код,
			тзТовар.Номенклатура,
			тзТовар.Упаковка,
			КоличествоОсталось);  
			Сообщение.Сообщить();
			
			Отказ = Истина;
			
		КонецЕсли;
		
		
	КонецЦикла;
	
	Ответ.Вставить("ЗаполнитьПоПравилу", ДокументОбъектТовары);
	Если ЗначениеЗаполнено(тзНеИспользоватьПравило) 
		И ТипЗнч(тзНеИспользоватьПравило)=Тип("ТаблицаЗначений") 
		И тзНеИспользоватьПравило.Количество()>0 Тогда
		
		Ответ.Вставить("НеИспользоватьПравило", тзНеИспользоватьПравило);
		
	КонецЕсли;
КонецПроцедуры  

Процедура СтратегияКонтроляВыдачиПоЗаявке(ТзТовары,ДокументОбъект, Отказ, Ответ) 

	Если ТипЗнч(ДокументОбъект.Ссылка)=Тип("ДокументСсылка.Лико_ЗаявкаНаСклад") Тогда
		Возврат;
	КонецЕсли;
	
	
	ИндексСтроки =0;
	
	Для каждого Товар Из ТзТовары Цикл	
		
		Если  ЗначениеЗаполнено(Товар.Правило)  Тогда
			
			КонтрольВыдачиПоЗаявке = Товар.Правило.Действие=Перечисления.Лико_ДействияПоПравилуПеремещенияТМЦ.КонтрольВыдачиПоЗаявке;
			
			
			Если КонтрольВыдачиПоЗаявке Тогда
				
				Если ДокументОбъект.ЗаявкаНаСклад.Товары.Найти(Товар.Серия,"Серия")=Неопределено Тогда
					Отказ = Истина;
					
					
					Сообщение = Новый СообщениеПользователю;
					
					Текст=СтрШаблон("Объекта номенклатуры: %1 нет в заявке! ",Товар.Серия);
					Сообщение.Текст = Текст;
					
					
					Сообщение.Поле = "Товары["+(ИндексСтроки)+"].Номенклатура";
					Сообщение.УстановитьДанные(ДокументОбъект);
					Сообщение.Сообщить();
				КонецЕсли;
				
				
			КонецЕсли;
			
			
		КонецЕсли;
		
		
		ИндексСтроки=ИндексСтроки+1;
	КонецЦикла;

	
КонецПроцедуры 

Процедура СтратегияПроверитьПравило(тзТовары,ДокументОбъект,Отказ, Ответ)
	
	МассивСерийБезПравил=СерииБезПравил(ДокументОбъект);
	
	ТЗОтвет = Новый ТаблицаЗначений;
	ТЗОтвет.Колонки.Добавить("Серия",Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	ТЗОтвет.Колонки.Добавить("СерияПоПравилу",Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	ТЗОтвет.Колонки.Добавить("ОбъектНоменклатуры",Новый ОписаниеТипов("СправочникСсылка.ЯССМ_ОбъектыНоменклатуры"));
	ТЗОтвет.Колонки.Добавить("ОбъектНоменклатурыПоПравилу",Новый ОписаниеТипов("СправочникСсылка.ЯССМ_ОбъектыНоменклатуры"));
	
	ТЗОтвет.Колонки.Добавить("Правило",Новый ОписаниеТипов("СправочникСсылка.Лико_ПравилаПеремещенияТМЦ")); 
	ТЗОтвет.Колонки.Добавить("АдресХранения",Новый ОписаниеТипов("СправочникСсылка.СкладскиеЯчейки"));
	ТЗОтвет.Колонки.Добавить("АдресХраненияНовый",Новый ОписаниеТипов("СправочникСсылка.СкладскиеЯчейки"));
	
	ТЗОтвет.Колонки.Добавить("Стратегия",Новый ОписаниеТипов("ПеречислениеСсылка.Лико_СтратегииПеремещенияТМЦ"));
	ТЗОтвет.Колонки.Добавить("Комментарий",Новый ОписаниеТипов("Строка", ,
	Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	
	
	
	ГруппыТоваров= тзТовары.Скопировать();
	ГруппыТоваров.Свернуть("Правило,Номенклатура,Характеристика,Склад,Помещение,ВидНастроечногоМатериала,КоличествоВУпаковке"); 
	
	Запрос = Новый Запрос;
	МассивГрупп = Новый Массив();	
	
	НомерГруппы=0;  
	
	ВыполнитьПроверкуПравил = Ложь;
	
	Для каждого ГруппаТоваров Из ГруппыТоваров Цикл
		
		
		НомерГруппы=НомерГруппы+1;
		
		Стратегия = ГруппаТоваров.Правило.Стратегия;
		Если  (Стратегия= Перечисления.Лико_СтратегииПеремещенияТМЦ.ФИФО
			ИЛИ  Стратегия= Перечисления.Лико_СтратегииПеремещенияТМЦ.ЛИФО) Тогда
			ВыполнитьПроверкуПравил = Истина; 
		Иначе
			Продолжить;
		КонецЕсли;
		
		//тзТовары = Новый ТаблицаЗначений;
		
		
		СтруктураПоиска = Новый Структура;
		
		СтруктураПоиска.Вставить("Правило",ГруппаТоваров.Правило);
		СтруктураПоиска.Вставить("Номенклатура",ГруппаТоваров.Номенклатура);
		СтруктураПоиска.Вставить("Характеристика",ГруппаТоваров.Характеристика);
		СтруктураПоиска.Вставить("Склад",ГруппаТоваров.Склад);
		СтруктураПоиска.Вставить("Помещение",ГруппаТоваров.Помещение);
		СтруктураПоиска.Вставить("КоличествоВУпаковке",ГруппаТоваров.КоличествоВУпаковке);
		СтруктураПоиска.Вставить("ВидНастроечногоМатериала",ГруппаТоваров.ВидНастроечногоМатериала);
		
		
		НайденныеСтроки = тзТовары.НайтиСтроки(СтруктураПоиска);
		
		ТзНоменклатурыПоПравилу = тзТовары.Скопировать();
		ТзНоменклатурыПоПравилу.Очистить();
		
		Индекс=0; 
		
		
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			
			НоваяСтрока = ТзНоменклатурыПоПравилу.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,НайденнаяСтрока);
			Индекс=Индекс+1;
			
		КонецЦикла;
		
		МассивГрупп.Добавить(ТзНоменклатурыПоПравилу);
		ИмяТзВЗапросе=СтрШаблон("ТзНоменклатурыПоПравилу%1",НомерГруппы);
		ТекстЗапросПроверкаПравил(Запрос,ИмяТзВЗапросе,Индекс,Стратегия);
		Запрос.УстановитьПараметр(ИмяТзВЗапросе,ТзНоменклатурыПоПравилу);
		
		
	КонецЦикла; 
	
	Если Не ВыполнитьПроверкуПравил Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дата",ДокументОбъект.Дата);
	Пакет = Запрос.ВыполнитьПакет();
	
	Индекс = 0; 
	ИндексОстатки =2;
	Для каждого Тз Из МассивГрупп Цикл 
		
		Стратегия = Тз[0].Правило.Стратегия;
		
		Если Стратегия = перечисления.Лико_СтратегииПеремещенияТМЦ.ФИФО Тогда
			Тз.Сортировать("ДатаФормирования");
		КонецЕсли; 
		
		Если Стратегия = перечисления.Лико_СтратегииПеремещенияТМЦ.ЛИФО Тогда
			ТЗ.Сортировать("ДатаФормирования Убыв");
		КонецЕсли;
		
		
		
		Остатки =Пакет [ИндексОстатки].Выгрузить();
		Индекс=Индекс+1;
		ИндексОстатки=ИндексОстатки+3;
		КоличествоОстатков =Остатки.Количество();
		КоличествоТЗ = Тз.Количество();
		
		КоличествоПроверяем=Мин(КоличествоОстатков,КоличествоТЗ);
		
		Если  КоличествоПроверяем = 0 Тогда		
			
			Продолжить;
			
		КонецЕсли;
		
		
		НомерСтроки=0;
		Смещение=0;
		Пока КоличествоПроверяем>0 Цикл 
			ТзСтрока =    Тз[НомерСтроки];
			СтрокаОСтатки = Остатки[НомерСтроки-Смещение];
			
			Если Стратегия = Перечисления.Лико_СтратегииПеремещенияТМЦ.ФИФО Тогда 
				Если МассивСерийБезПравил.Найти(ТзСтрока.Серия)=Неопределено Тогда
					
					Если НачалоДня(ТзСтрока.ДатаФормирования)>НачалоДня(СтрокаОСтатки.ДатаФормирования) Тогда
						
						НоваяСтрокаОтвета	= ТЗОтвет.Добавить();  
						
						ЗаполнитьЗначенияСвойств(НоваяСтрокаОтвета,ТзСтрока);
						
						НоваяСтрокаОтвета.Серия = ТзСтрока.Серия;
						НоваяСтрокаОтвета.СерияПоПравилу = СтрокаОСтатки.Серия;
						НоваяСтрокаОтвета.Правило = ТзСтрока.Правило;
						НоваяСтрокаОтвета.Стратегия = Стратегия;
						НоваяСтрокаОтвета.Комментарий = ТекстОшибкиПоПравилу(НоваяСтрокаОтвета.Правило,ТзСтрока.ОбъектНоменклатуры,СтрокаОСтатки.ОбъектНоменклатуры);
						
					КонецЕсли;
				Иначе
					Смещение = Смещение+1;
				КонецЕсли;
				
				
			КонецЕсли; 
			
			Если Стратегия = Перечисления.Лико_СтратегииПеремещенияТМЦ.ЛИФО  Тогда 
				
				Если МассивСерийБезПравил.Найти(ТзСтрока.Серия)=Неопределено Тогда
					
					Если НачалоДня(ТзСтрока.ДатаФормирования)<НачалоДня(СтрокаОСтатки.ДатаФормирования) Тогда 
						
						НоваяСтрокаОтвета	= ТЗОтвет.Добавить();
						
						ЗаполнитьЗначенияСвойств(НоваяСтрокаОтвета,ТзСтрока);

						НоваяСтрокаОтвета.Серия = ТзСтрока.Серия;
						НоваяСтрокаОтвета.СерияПоПравилу = СтрокаОСтатки.Серия;
						НоваяСтрокаОтвета.Правило = ТзСтрока.Правило;
						НоваяСтрокаОтвета.Стратегия = Стратегия;
						НоваяСтрокаОтвета.Комментарий = ТекстОшибкиПоПравилу(НоваяСтрокаОтвета.Правило,ТзСтрока.ОбъектНоменклатуры,СтрокаОСтатки.ОбъектНоменклатуры);
						
						
						
					КонецЕсли;
					
				Иначе
					Смещение = Смещение+1;
				КонецЕсли;
				
				
				
			КонецЕсли;
			
			
			
			КоличествоПроверяем=КоличествоПроверяем-1;
			НомерСтроки=НомерСтроки+1	
		КонецЦикла;		
