Функция СоответсвиеПравилоВыборкаДанных(СоответствиеПравил, ДокументОбъект) 		

	
	СооПравилоВыборка = Новый Соответствие;
	
	 
	 
	 Для каждого СооПравило Из СоответствиеПравил Цикл
		 
		 ТЗ = Новый ТаблицаЗначений;
		 ТЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		 ТЗ.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		 ТЗ.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
		 ТЗ.Колонки.Добавить("Помещение", Новый ОписаниеТипов("СправочникСсылка.СкладскиеПомещения")); 
		 ТЗ.Колонки.Добавить("КоличествоВУпаковке",Новый ОписаниеТипов("Число",
												   Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
												   
												   

		 
		Правило = СооПравило.Ключ;
		МассивНоменклатур =  СооПравило.Значение; 
		
		Для каждого Номенклатура  Из МассивНоменклатур  Цикл 
			
			  НайденныеСтроки = ДокументОбъект.Товары.НайтиСтроки( Новый Структура("Номенклатура",Номенклатура));
			  
			  Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
				  
				   НоваяЗапись =  Тз.Добавить();
				   НоваяЗапись.Номенклатура =  НайденнаяСтрока.Номенклатура;
				   НоваяЗапись.Характеристика =  НайденнаяСтрока.Номенклатура;
				   НоваяЗапись.Склад =  НайденнаяСтрока.АдресХранения.Владелец;
				   НоваяЗапись.Помещение =  НайденнаяСтрока.АдресХранения.Помещение;
				   НоваяЗапись.КоличествоВУпаковке =  НайденнаяСтрока.Упаковка.Числитель;
					   			  	
			  КонецЦикла;
			
		КонецЦикла;
		
	Тз.Свернуть("Номенклатура, Характеристика, Склад, Помещение, КоличествоВУпаковке");  	
				
		СооПравилоВыборка.Вставить(Правило,ВыборкаОстаткиПоПравилу(ДокументОбъект,Правило,ТЗ)); 
		
	КонецЦикла; 
	

	
	Возврат СооПравилоВыборка;

