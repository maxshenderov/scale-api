Процедура ОпределеитьМетодДвиженияМеждуСкладами(ТзТовары, ДокументОбъект) 
	
	
	Для каждого Товар Из ТзТовары Цикл 
		
		Если ТипЗнч(ДокументОбъект.Ссылка) =Тип("ДокументСсылка.Лико_БланкЭтапа") Тогда
			Товар.МетодДвиженияМеждуСкладами="ФИФО";
		ИначеЕсли ДокументОбъект.ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство Тогда
			Товар.АдресХраненияНовый =  ДокументОбъект.Получатель.ЛикоЯчейка;
			Товар.МетодДвиженияМеждуСкладами="ФИФО"; 
		ИначеЕсли ДокументОбъект.ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение Тогда
			
			ИерархияОтправителя =  0;
			ИерархияПолучателя = 0; 
			
			Если ТипЗнч(ДокументОбъект.Ссылка) =Тип("ДокументССылка.Лико_ЗаявкаНаСклад") Тогда
				
				Товар.АдресХраненияНовый = ДокументОбъект.Адрес;
				ИерархияОтправителя =  ИерархияСкладаПоЯчейки(Товар.АдресХранения);
				ИерархияПолучателя =  ИерархияСкладаПоЯчейки(ДокументОбъект.Адрес);
				
				
			КонецЕсли;
			
			Если ТипЗнч(ДокументОбъект.Ссылка) =Тип("ДокументСсылка.Лико_ПередачаТоваров") Тогда
				
				ИерархияОтправителя =  ИерархияСкладаПоЯчейки(Товар.АдресХранения); 
				Товар.АдресХраненияНовый = ?(ЗначениеЗаполнено(Товар.АдресХраненияНовый),Товар.АдресХраненияНовый,ДокументОбъект.АдресХранения); 
					
		
				
				ИерархияПолучателя =  ИерархияСкладаПоЯчейки(Товар.АдресХраненияНовый);
				
				
				
				
			КонецЕсли;
			
			Результат = ИерархияПолучателя-ИерархияОтправителя;
			
			Если Результат<0 Тогда
				Товар.МетодДвиженияМеждуСкладами="ФИФО";
			ИначеЕсли Результат>0 Тогда
				Товар.МетодДвиженияМеждуСкладами="ЛИФО";
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	
 КонецПроцедуры 
 
