Функция ОпределитьПравило(Номенклатура,Документ=Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
		
	Если Документ=Неопределено Тогда 
		
		Документ=Документы.Лико_ЗаявкаНаСклад.ПустаяСсылка();
		
	КонецЕсли;
	
	НастройкаПравил= ПолучитьНастройкуПравил(Номенклатура.ВидНоменклатуры, Документ.Организация);
	Если Не ЗначениеЗаполнено(НастройкаПравил) ИЛИ не ЗначениеЗаполнено(НастройкаПравил.ТекстЗапроса) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ПараметрыТовара = Новый Структура;
	ПараметрыТовара.Вставить("Номенклатура",Номенклатура);
	ПараметрыТовара.Вставить("Серия",Справочники.СерииНоменклатуры.ПустаяСсылка());
	
	ПараметрыЗапроса = ПараметрыЗапроса(ПараметрыТовара,Документ);
	
	Запрос = Новый Запрос;
	Запрос.Текст = НастройкаПравил.ТекстЗапроса;
	
	Для каждого Параметр Из НастройкаПравил.ПараметрыЗапроса Цикл
		
		Запрос.УстановитьПараметр(Параметр.Ключ,Параметр.Значение);
		
	КонецЦикла;
	
	Для каждого Параметр Из ПараметрыЗапроса  Цикл
		
			Запрос.УстановитьПараметр(Параметр.Ключ,Параметр.Значение); 
	 	
	 КонецЦикла;
	
	
	ПакетЗапроса = Запрос.ВыполнитьПакет();
	Ном =0;
	Для каждого Пакет Из ПакетЗапроса Цикл
		Если Не Пакет.Пустой() ТОгда
			Возврат НастройкаПравил.СоответствиеПравил[Ном];
		КонецЕсли;
		
	Ном=Ном+1;
	
КонецЦикла;

КонецФункции

Процедура ОпределитьПравилаДляТоваров(Товары,Документ=Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Документ=Неопределено Тогда 
		
		Документ=Документы.Лико_ЗаявкаНаСклад.ПустаяСсылка();
		
	КонецЕсли;
	
	ТекстЗапроса="";
	
	НомерСтроки = 0;
	
	ЗапросИтог = Новый Запрос; 
	МассивИсключений 	= Новый Массив();
	СоответствиеШага 	= Новый Соответствие;
	СоответсвиеПравил 	= Новый Соответствие; 
	
	Для каждого Товар Из Товары Цикл
		
		НомерСтроки=НомерСтроки+1;
		
		ПрефиксПараметра=СтрШаблон("Парам_%1_",НомерСтроки);
		
		НастройкаПравил= ПолучитьНастройкуПравил(Товар.Номенклатура.ВидНоменклатуры, Документ.Организация);
		Если Не ЗначениеЗаполнено(НастройкаПравил) ИЛИ не ЗначениеЗаполнено(НастройкаПравил.ТекстЗапроса) Тогда
			
			МассивИсключений.Добавить(НомерСтроки);
			Продолжить;
			
		КонецЕсли;
		
		СоответствиеШага.Вставить(Товар.Номенклатура,НастройкаПравил.СоответствиеПравил.Количество());
		СоответсвиеПравил.Вставить(Товар.Номенклатура,НастройкаПравил);
		
		Запрос = Новый Запрос;	
		ПараметрыЗапроса = ПараметрыЗапроса(Товар,Документ);
		
		Запрос.Текст = НастройкаПравил.ТекстЗапроса;
		
		Для каждого Параметр Из НастройкаПравил.ПараметрыЗапроса Цикл
			
			Запрос.УстановитьПараметр(Параметр.Ключ,Параметр.Значение);
			
		КонецЦикла;
		
		Для каждого Параметр Из ПараметрыЗапроса  Цикл
			
			Запрос.УстановитьПараметр(Параметр.Ключ,Параметр.Значение); 
			
		КонецЦикла;
		
		ТекстЗапроса = СтрЗаменить(Запрос.Текст,"&",СтрШаблон("&%1",ПрефиксПараметра));  
		
		СтруктураПараметров = Новый Структура;
		Для каждого Параметр Из Запрос.Параметры Цикл
			
			СтруктураПараметров.Вставить(СтрШаблон("%1%2",ПрефиксПараметра,Параметр.Ключ), Параметр.Значение);
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ЗапросИтог.Текст) Тогда
			
			ЗапросИтог.Текст = ЗапросИтог.Текст+";"+ТекстЗапроса;
		Иначе
			ЗапросИтог.Текст = ТекстЗапроса;
			
		КонецЕсли;
		
		Для каждого ПараметрЗапроса  Из СтруктураПараметров Цикл
			
			ЗапросИтог.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ЗапросИтог.Текст) Тогда
		Возврат;
	КонецЕсли;
	
	
	ПакетЗапроса = ЗапросИтог.ВыполнитьПакет();
	//Шаг = НастройкаПравил.СоответствиеПравил.Количество();
	НомерСтроки=0;
	ИндексПакета=0;
	ИндекСтокиСправилом =0;
	Для каждого Товар Из Товары Цикл
		
		Шаг = СоответствиеШага[Товар.Номенклатура];
		
		НомерСтроки=НомерСтроки+1;
		
		Если МассивИсключений.Найти(НомерСтроки)=Неопределено Тогда
			
		Иначе
			Продолжить;
			
		КонецЕсли;
		
		ТекШаг=1;
		ИндексПравила =0;
		ИндексПакета = ИндекСтокиСправилом;
		ИндекСтокиСправилом = ИндекСтокиСправилом+Шаг;
		Пока ТекШаг<=Шаг	Цикл
			 ТекШаг=ТекШаг+1;
			 
			 Пакет = ПакетЗапроса[ИндексПакета];
			ИндексПакета=ИндексПакета+1;
			Если Не Пакет.Пустой() ТОгда
				Товар.Правило = СоответсвиеПравил[Товар.Номенклатура].СоответствиеПравил[ИндексПравила];
				Прервать;
			КонецЕсли;
			
			
			ИндексПравила=ИндексПравила+1;
			
		КонецЦикла;
		
		
			
	КонецЦикла;
	
	
КонецПроцедуры

Процедура СохранитьНастройкуПравил(ВидНоменклатуры, Организация) Экспорт

	СоответствиеПравил= Новый Соответствие;

		Запрос = Новый Запрос;
	Запрос.Текст=ТекстЗапросаПравилПоВидуНоменклатуры(); 
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры );
	Запрос.УстановитьПараметр("Организация",Организация );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	ТекстЗапроса="";
	НомерЗапроса=1;
	ПараметрыЗапроса=Новый Структура;
	Ном=0;
	Пока Выборка.Следующий() Цикл 		
		СоответствиеПравил.Вставить(Ном,Выборка.Ссылка);
		СформироватьЗапросИзСКД(Выборка,ТекстЗапроса,ПараметрыЗапроса,НомерЗапроса);		
		НомерЗапроса=НомерЗапроса+1;		 
		Ном=Ном+1;	
	КонецЦикла;
	
	Структура=Новый Структура;
	Структура.Вставить("СоответствиеПравил",СоответствиеПравил);
	Структура.Вставить("ТекстЗапроса",ТекстЗапроса);
	Структура.Вставить("ПараметрыЗапроса",ПараметрыЗапроса);


	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПравилаПеремещенияТМЦ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Лико_ПравилаПеремещенияТМЦ КАК Лико_ПравилаПеремещенияТМЦ
	|ГДЕ
	|	Лико_ПравилаПеремещенияТМЦ.ВидНоменклатуры = &ВидНоменклатуры
	|	И Лико_ПравилаПеремещенияТМЦ.ЭтоГруппа
	|	И Лико_ПравилаПеремещенияТМЦ.Организация = &Организация";
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры );
	Запрос.УстановитьПараметр("Организация",Организация );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СпрОбъект=Выборка.Ссылка.ПолучитьОбъект();
		СпрОбъект.НастройкаПравил=Новый ХранилищеЗначения(Структура);
	СпрОбъект.Записать();		
	КонецЦикла; 
	
	
	



		
КонецПроцедуры 

Функция ПолучитьПриоритетМакс(ВидНоменклатуры, Организация) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(Лико_ПравилаПеремещенияТМЦ.Приоритет) КАК Приоритет
	|ИЗ
	|	Справочник.Лико_ПравилаПеремещенияТМЦ КАК Лико_ПравилаПеремещенияТМЦ
	|ГДЕ
	|	Лико_ПравилаПеремещенияТМЦ.ВидНоменклатуры = &ВидНоменклатуры
	|	И Лико_ПравилаПеремещенияТМЦ.Организация = &Организация";
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры );
	Запрос.УстановитьПараметр("Организация",Организация );

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Приоритет) Тогда
			Возврат Выборка.Приоритет;
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат 0;	
КонецФункции //-Лико m.shenderov 28.12.2018 

Процедура ПереместитьПоПриоритету(Ссылка,Шаг) Экспорт 
	
	
	ТекущийПриоритет	=	Ссылка.Приоритет;
	НовыйПриоритет		=	ТекущийПриоритет+Шаг;
	
	Если НовыйПриоритет=0 Или НовыйПриоритет=ПолучитьПриоритетМакс(Ссылка.ВидНоменклатуры, Ссылка.Организация)+1 Тогда
		Возврат;
	КонецЕсли;
	
	ПравилоКонкурент=ПолучитьПравилоПоПриоритету(Ссылка.ВидНоменклатуры,НовыйПриоритет,Ссылка.Организация);
	
	НачатьТранзакцию();
	
	СправочникОбъект			=Ссылка.ПолучитьОбъект();
	СправочникОбъект.Приоритет	=НовыйПриоритет; 	
	СправочникОбъект.Записать();
	Если ЗначениеЗаполнено(ПравилоКонкурент) Тогда
		
		СправочникОбъект			 =ПравилоКонкурент.ПолучитьОбъект();
		СправочникОбъект.Приоритет	 =СправочникОбъект.Приоритет-Шаг; 	
		СправочникОбъект.Записать();
	КонецЕсли;
	
	
	
	
	ЗафиксироватьТранзакцию();
	
	
	
КонецПроцедуры //-Лико m.shenderov 28.12.2018

Функция ПолучитьПравилоПоПриоритету(ВидНоменклатуры,Приоритет,Организация) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Лико_ПравилаПеремещенияТМЦ КАК Док
	|ГДЕ
	|	Док.ВидНоменклатуры = &ВидНоменклатуры
	|	И Док.Приоритет = &Приоритет
	|	И Док.Организация = &Организация";
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры);
	Запрос.УстановитьПараметр("Приоритет",Приоритет);
	Запрос.УстановитьПараметр("Организация",Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Возврат Выборка.Ссылка;	
		
	КонецЦикла; 
	
	
КонецФункции //-Лико m.shenderov 29.12.2018 

Процедура ВыполнитьПроверку(ДокументОбъект, Отказ, Ответ=Неопределено) Экспорт  
УстановитьПривилегированныйРежим(Истина);	
	Попытка 
		
		Если СтартСистемы(ДокументОбъект.Дата) Тогда	
			
			Ответ = СформироватьОтвет(ДокументОбъект, Отказ);
			
			Если Ответ.Свойство("ЗаполнитьПоПравилу") Тогда
				
				ДокументОбъект.Товары.Загрузить(Ответ.ЗаполнитьПоПравилу);
				
			КонецЕсли;
			Если Ответ.Свойство("НеИспользоватьПравило") Тогда
				
				
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		//ОписаниеОшибки()
	КонецПопытки;
	
			
КонецПроцедуры  

Функция СформироватьОтвет(ДокументОбъект, Отказ) Экспорт  

		
	ТзТовары				= ТаблицаТоварыСДопСвойствами(ДокументОбъект);
	
			
	Ответ = Новый Структура;
	
	// Стратегии проверки документа
	СтратегияЗаблокировать(ТзТовары,ДокументОбъект, Отказ, Ответ); 
	СтратегияКонтроляВыдачиПоЗаявке(ТзТовары, ДокументОбъект, Отказ, Ответ);	
	СтратегияПроверитьПравило(ТзТовары,ДокументОбъект, Отказ, Ответ);
	
	
	

	// Стратегии заполнения документа. ОЧЕНЬ ОСТОРОЖНО!!! (Только заяка на склад)!!!

	СтратегияЗаполнитьПоПравилу(ТзТовары,ДокументОбъект, Отказ, Ответ);
		
	Возврат Ответ;
	
КонецФункции  

Функция СтартСистемы(Дата=Неопределено)Экспорт
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		
		Дата = ТекущаяДата();
		
	КонецЕсли;
	
	Результат = Ложь;
	
	ДатаНачала = Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаУчетаПравилПеремещенияТМЦ.ЗначениеПараметра;
	
	
	Если ЗначениеЗаполнено(ДатаНачала) И ТипЗнч(ДатаНачала)=Тип("Дата") И ДатаНачала<Дата Тогда
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции  

