Процедура ПараметрыЗапросаПередачаТоваровПереопеделяемый(Структура,ДокументОбъект)
	
	Если ТипЗнч(ДокументОбъект.Ссылка)<>Тип("ДокументСсылка.Лико_ПередачаТоваров") Тогда
		
		Возврат;
		
	КонецЕсли;
	

	Структура.РабочийЦентр = ДокументОбъект.Получатель;
	
	
	
	
	
