Процедура СформироватьЗапросИзСКД(Выборка,ТекстЗапроса="",ПараметрыЗапроса,НомерЗапроса) //+Лико m.shenderov 30.12.2018
	ОтборНастройки= Новый КомпоновщикНастроекКомпоновкиДанных;
	СхемаКомпоновкиДанных = Справочники.Лико_ПравилаПеремещенияТМЦ.ПолучитьМакет("ОтборПоУсловию");
	
	МассивПараметров = Новый Массив;
	
	Для каждого Параметр Из СхемаКомпоновкиДанных.Параметры  Цикл
		
		МассивПараметров.Добавить(Параметр.Имя); 
		
	КонецЦикла;
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных);
	ОтборНастройки.Инициализировать(ИсточникНастроек);
	ТекНастройки = Выборка.ОтборНастройки.Получить();
	
	Если ТекНастройки = Неопределено Тогда
		ОтборНастройки.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Иначе
		ОтборНастройки.ЗагрузитьНастройки(ТекНастройки);
	КонецЕсли;
		КоличествоПараметров=СхемаКомпоновкиДанных.Параметры.Количество();
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, ОтборНастройки.ПолучитьНастройки(),,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	Запрос=МакетКомпоновки.НаборыДанных.НаборДанных1.Запрос;
	ПрефиксПараметра="_"+Формат(НомерЗапроса,"ЧДЦ=0; ЧГ=0");

	Для каждого Параметр Из МакетКомпоновки.ЗначенияПараметров Цикл
		КоличествоПараметров=КоличествоПараметров-1;
		Если МассивПараметров.Найти(Параметр.Имя) <> Неопределено ТОгда
			ПараметрыЗапроса.Вставить(Параметр.Имя,Параметр.Значение);
			
		Иначе 
			
			НовоеИмяПараметра=СтрЗаменить(Параметр.Имя,"П","П"+ПрефиксПараметра);

			ПараметрыЗапроса.Вставить(НовоеИмяПараметра,Параметр.Значение);
			
		КонецЕсли;
	КонецЦикла;
	Запрос=СтрЗаменить(Запрос,"&П","&П"+ПрефиксПараметра);

	Если ТекстЗапроса="" Тогда
		ТекстЗапроса=Запрос;
	Иначе
		ТекстЗапроса=ТекстЗапроса+"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|"+Запрос; 		
	КонецЕсли; 	
КонецПроцедуры 

Функция  ТаблицаТоварыСДопСвойствамиСвернуто(ДокументОбъект, ТзТовары) //+Лико m.shenderov 28.01.2026
	
	СоответствиеПравил = Новый Соответствие; 
	Соответствие = Новый Соответствие;
	
	
	Для каждого Товар Из ТзТовары Цикл  	  
		
		
		
		
		
		
		
		Если ЗначениеЗаполнено(Товар.Правило) И Не ЗначениеЗаполнено( Товар.Правило.Стратегия) Тогда
			
			Товар.Правило = Неопределено;
			
		КонецЕсли;
		
		Товар.Помещение =  Товар.АдресХранения.Помещение;
		Товар.Склад =   Товар.АдресХранения.Владелец;
		Товар.КоличествоВУпаковке =  Товар.Упаковка.Числитель;
		
		Правило = Товар.Правило;
		
		Если ЗначениеЗаполнено(Правило) Тогда
			
			МассивНоменклатур = СоответствиеПравил[Правило];
			
			Если МассивНоменклатур = Неопределено Тогда
				
				МассивНоменклатур = Новый Массив;
				МассивНоменклатур.Добавить(Товар.Номенклатура);
				
				
				СоответствиеПравил.Вставить(Правило, МассивНоменклатур);
				
			ИначеЕсли МассивНоменклатур.Найти(Товар.Номенклатура) = Неопределено Тогда 
				
				МассивНоменклатур.Добавить(Товар.Номенклатура);
				
				
			КонецЕсли;
			
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	ТзТовары.Сортировать("Правило, Склад, Помещение, Номенклатура, КоличествоВУпаковке");	 
	
	ТзТоварыНовый = ТзТовары.Скопировать();
	
	ТзТоварыНовый.Очистить(); 
	
	Правило					=	Неопределено;
	Номенклатура			=	Неопределено;
	Помещение				=	Неопределено;
	КоличествоВУпаковке		=	Неопределено;
	
	
	
	Для каждого  Товар Из ТзТовары Цикл
		
		Если Не ЗначениеЗаполнено(Товар.Правило) Или Товар.Правило.Действие<>Перечисления.Лико_ДействияПоПравилуПеремещенияТМЦ.ЗаполнитьПоПравилу Тогда			
			
			НоваяЗапись = ТзТоварыНовый.Добавить();			
			ЗаполнитьЗначенияСвойств(НоваяЗапись,Товар);			
			
		Иначе 
			
			Если   Правило = Товар.Правило
				И Номенклатура = Товар.Номенклатура
				И Помещение	= Товар.Помещение 
				И КоличествоВУпаковке = Товар.КоличествоВУпаковке Тогда
				
				НоваяЗапись.Количество = НоваяЗапись.Количество+Товар.Количество;
				НоваяЗапись.КоличествоУпаковок = НоваяЗапись.КоличествоУпаковок+Товар.КоличествоУпаковок;
				
			Иначе
				
				Правило = Товар.Правило;
				Номенклатура = Товар.Номенклатура;
				Помещение	= Товар.Помещение; 
				КоличествоВУпаковке = Товар.КоличествоВУпаковке;
				
				НоваяЗапись = ТзТоварыНовый.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяЗапись,Товар);				
				
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;  
	
	Возврат  ТзТоварыНовый;
	
КонецФункции //-Лико m.shenderov 28.01.2026 

