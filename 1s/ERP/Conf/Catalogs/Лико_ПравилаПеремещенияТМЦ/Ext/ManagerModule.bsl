Функция СоответсвиеПравилоНоменклатура(ТзТовары) //+Лико m.shenderov 28.01.2026
	
	СоответствиеПравил = Новый Соответствие; 
	 	  
	  Для каждого Товар Из ТзТовары Цикл
		  
				 
		 Правило = Товар.Правило;
		 
		 Если ЗначениеЗаполнено(Правило) И Правило.Стратегия<>Перечисления.Лико_СтратегииПеремещенияТМЦ.Заблокировать Тогда
			 
			 МассивНоменклатур = СоответствиеПравил[Правило];
			 
			 Если МассивНоменклатур = Неопределено Тогда
				 
				 МассивНоменклатур = Новый Массив;
				 МассивНоменклатур.Добавить(Товар.Номенклатура);
				 
				 
				 СоответствиеПравил.Вставить(Правило, МассивНоменклатур);
				 
			 ИначеЕсли МассивНоменклатур.Найти(Товар.Номенклатура) = Неопределено Тогда 
				 
				  МассивНоменклатур.Добавить(Товар.Номенклатура);

				 
			 КонецЕсли;
			 
			 
		 КонецЕсли;
		 
	 КонецЦикла;
	 
   Возврат  СоответствиеПравил;
	
