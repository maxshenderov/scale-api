		//Объект.Номенклатура=Справочники.Лико_ФормулыПантонов.СодатьНоменклатуруСмеси(Объект.Ссылка,Объект.ВидТМЦ,Объект.ВидПечати,Объект.Состав[0].Номенклатура);
	
	  Объект.Номенклатура=
