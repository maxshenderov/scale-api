Функция ПолучитьАртикулИзDFM() //+Лико m.shenderov 28.04.2021
	СпрОбъект=Справочники.Лико_ПредопределенныеЗначения.счНоменклатураАртикул.ПолучитьОбъект();
	СпрОбъект.ЗначениеПараметра=СпрОбъект.ЗначениеПараметра+1;
	СпрОбъект.Записать(); 	
	Возврат Формат(СпрОбъект.ЗначениеПараметра,"ЧЦ=8; ЧВН=; ЧГ="); 	
КонецФункции //-Лико m.shenderov 28.04.2021 

Функция ПроверкаЗаполненияПолей() //+Лико m.shenderov 28.04.2021
	Результат=Истина;
	Если Полуфабрикат Тогда
		СообщитьПользователю(НаименованиеНоменклатуры,"НаименованиеНоменклатуры","Наименование",Результат);
		СообщитьПользователю(НаименованиеНоменклатуры,"Артикул","Артикул",Результат);
	Иначе
		
		Если Не (ЗначениеЗаполнено(Номенклатура) И Справочники.Лико_ВерсииНоменклатуры.ЕстьВерсияНоменклатуры(Номенклатура)) Тогда
			СообщитьПользователю(НаименованиеНоменклатуры,"НаименованиеНоменклатуры","Наименование номенклатуры",Результат);
			СообщитьПользователю(ТипЭтикетки,"ТипЭтикетки","Тип этикетки",Результат);
			СообщитьПользователю(Клиент,"Клиент","Клиент",Результат);
			//СообщитьПользователю(Контрагент,"Контрагент","Контрагент",Результат);
			//СообщитьПользователю(Регион,"Регион","Регион",Результат);
			СообщитьПользователю(Менеджер,"Менеджер","Менеджер",Результат);
			//СообщитьПользователю(Дизайнер,"Дизайнер","Дизайнер",Результат);
			//СообщитьПользователю(Технология,"Технология","Технология",Результат);

		Иначе
				//СообщитьПользователю(НоваяТехнология,"НоваяТехнология","НоваяТехнология",Результат);

		КонецЕсли;
	Если ОтправитьУведомление Тогда
		СообщитьПользователю(Дизайнер,"Дизайнер","Дизайнер",Результат); 

		Если Результат И Не ЕстьПочта Тогда
			Результат=Ложь;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("У сотрудника: %1 не заведена почта в 1С . Обратитесь в отдел ИТ.",Дизайнер);
			Сообщение.Поле = "Дизайнер"; //имя реквизита 
			Сообщение.Сообщить();  			
		КонецЕсли;
		
	КонецЕсли;
	
	
	КонецЕсли;
	Возврат Результат;	
КонецФункции //-Лико m.shenderov 28.04.2021 

Процедура СообщитьПользователю(Поле,РеквизитПоля,Текст,Результат)
	Если Не ЗначениеЗаполнено(Поле) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("Не заполнено: %1",Текст);
		Сообщение.Поле = РеквизитПоля; //имя реквизита 
		//Сообщение.УстановитьДанные(); //Ссылка на объект ИБ
		Сообщение.Сообщить(); 		
		Результат=Ложь;	
	КонецЕсли;
КонецПроцедуры

