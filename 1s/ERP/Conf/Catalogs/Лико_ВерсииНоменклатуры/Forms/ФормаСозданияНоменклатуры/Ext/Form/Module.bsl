&НаКлиенте
Процедура СуществующиеВерсииВыборПриИзменении(Элемент)
	ТД=Элементы.СуществующиеВерсии.ТекущиеДанные;
	Выбор=ТД.Выбор;
	СуществующиеВерсииВыборПриИзмененииНаСервере(); 
	ТД.Выбор=Выбор;  
	
КонецПроцедуры

&НаКлиенте
Процедура НоваяВерсия(Команда)
	СуществующиеВерсии.Очистить();
	УстановитьВидимость();
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьСуществующуюВерсию(Команда)
	Для каждого СтрВерсия Из  СуществующиеВерсии Цикл
		
		Если СтрВерсия.Выбор Тогда
			
			Структура = Новый Структура;
				Структура.Вставить("Номенклатура",Номенклатура);
				Структура.Вставить("ВерсияНоменклатуры",СтрВерсия.ВерсияНоменклатуры);
				Закрыть(Структура);
	            Возврат;
			
		КонецЕсли;
		

		
		
	КонецЦикла;

	ПредупреждениеАсинх("Не выбрана версия!");
		

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура СуществующиеВерсииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
		СтандартнаяОбработка=Ложь;
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ЗаказКлиента) Тогда
		//ПоказатьЗначение(,Элемент.ТекущиеДанные.ЗаказКлиента); 
		ОткрытьФорму("Документ.ЗаказКлиента.Форма.Лико_ФормаДокумента",Новый Структура("Ключ",Элемент.ТекущиеДанные.ЗаказКлиента),ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПоискПоКодуЛинксПриИзмененииНаСервере()
	Номен = Справочники.Номенклатура.НайтиПоРеквизиту("Лико_КодЛинкс", Формат(КодЛинкс, "ЧЦ=7; ЧВН=; ЧГ=")); 
	
	Если Номен.ВидНоменклатуры.Лико_НоменклатураЭтикеток Тогда
		Номенклатура = Номен;
	Иначе
		Номенклатура = Неопределено;
	КонецЕсли;
	
	
	
	СуществующиеВерсии.Загрузить(Справочники.Лико_ВерсииНоменклатуры.ПолучитьВерсии(Номенклатура));
	 
	НаименованиеНоменклатуры=Номенклатура.Наименование; 
	ТипЭтикетки=Номенклатура.Лико_ТипЭтикетки;
	
	
	
	УкажитеДействие=1;
	Элементы.КомментарийДизайнер.Заголовок=
	"Указанному сотруднику будет отправлено уведомление о новом артикуле";
	//Элементы.СоздатьНоменклатуру.Заголовок="Создать версию номенклатуры";
	Если ЗначениеЗаполнено(ВерсияНоменклатуры) Тогда 
		ВерсияНоменклатурыАртикул=ВерсияНоменклатуры.Артикул;
	Иначе
		ВерсияНоменклатурыАртикул=Номенклатура.Артикул;
		АртикулDFM=Справочники.Лико_ВерсииНоменклатуры.ПолучитьАртикул();
		
	КонецЕсли;
    ПриВыбореДействия();

	УстановитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура ПоискПоКодуЛинксПриИзменении(Элемент)
	ПоискПоКодуЛинксПриИзмененииНаСервере();
КонецПроцедуры





