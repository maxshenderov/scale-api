Процедура ПолучитьМассивТехнологий(ИсключитьТехнологию=Неопределено) //+Лико m.shenderov 21.05.2021
	ИксПак=Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра=Заказ.Площадка.Организация;
	
	МассивИксПак= Новый СписокЗначений; 
	МассивИксПак.Добавить(Справочники.Лико_ТехнологияПечати.Офсет_Глубокая);
	МассивИксПак.Добавить(Справочники.Лико_ТехнологияПечати.Офсет_Флексо);
	МассивИксПак.Добавить(Справочники.Лико_ТехнологияПечати.Офсет_Флексо_Глубокая);
	МассивИксПак.Добавить(Справочники.Лико_ТехнологияПечати.Флексо_Глубокая); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ТехнологияПечати.Ссылка КАК Ссылка,
	|	Лико_ТехнологияПечати.Код КАК Код
	|ИЗ
	|	Справочник.Лико_ТехнологияПечати КАК Лико_ТехнологияПечати
	|ГДЕ
	|	Лико_ТехнологияПечати.Ссылка <> &ИсключитьТехнологию
	|	И Лико_ТехнологияПечати.Ссылка В(&МассивИксПак)
	|	И &ИксПак
	|	И Лико_ТехнологияПечати.Код <> 6
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Лико_ТехнологияПечати.Ссылка,
	|	Лико_ТехнологияПечати.Код
	|ИЗ
	|	Справочник.Лико_ТехнологияПечати КАК Лико_ТехнологияПечати
	|ГДЕ
	|	Лико_ТехнологияПечати.Ссылка <> &ИсключитьТехнологию
	|	И НЕ Лико_ТехнологияПечати.Ссылка В (&МассивИксПак)
	|	И НЕ &ИксПак
	|	И Лико_ТехнологияПечати.Код <> 6
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	Запрос.УстановитьПараметр("ИсключитьТехнологию",ИсключитьТехнологию);
	Запрос.УстановитьПараметр("МассивИксПак",МассивИксПак);
	Запрос.УстановитьПараметр("ИксПак",ИксПак);
	
	МассивТехнологий = Новый СписокЗначений;
	МассивТехнологий.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	
	
	
КонецПроцедуры //-Лико m.shenderov 21.05.2021

