
&НаСервере
Функция СоздатьНоменклатуруНаСервере()
	
	//Артикул=ПолучитьАртикулИзDFM();
	//НачатьТранзакцию();
	//Номенклатура=Лико_Планирование.СоздатьНоменклатуруНаСервере(НаименованиеНоменклатуры,ТипЭтикетки,Регион,Клиент,Артикул,ЗначениеЗаполнено(Артикул));
	//ВерсияНоменклатуры=Справочники.Лико_ВерсииНоменклатуры.СоздатьВерсиюНоменкатуры(Номенклатура,Технология);
	//ЗафиксироватьТранзакцию();

	НачатьТранзакцию();
	НоменклатураDFM=?(ЗначениеЗаполнено(Номенклатура),Номенклатура,Неопределено);
	
	// <-- Начало Лико Яцун С. В. 09.01.2025
	Если ЗначениеЗаполнено(КодЛинкс) И Не НайтиПродукт Тогда
		фКодЛинкс = Формат(КодЛинкс,"ЧЦ=7; ЧВН=; ЧГ=0");
		Номен = Справочники.Номенклатура.НайтиПоРеквизиту("Лико_КодЛинкс",фКодЛинкс);
		Если ЗначениеЗаполнено(Номен) Тогда 
			Текст = СтрШаблон("Номенклатура с такми кодом Линкс уже существует!");
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Текст;
			Сообщение.Поле = "КодЛинкс"; //имя реквизита 
			//Сообщение.УстановитьДанные(); //Ссылка на объект ИБ
			Сообщение.Сообщить();
			Сообщить(СтрШаблон("Номенклатура:%1 %2",Номен.Артикул,Номен.Наименование));
			Возврат Ложь;
		Иначе
			
			АртикулDFM = "011"+ Сред(фКодЛинкс,3,5);
			НоваяВерсия = ЛинксВерсия;
		КонецЕсли;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 09.01.2025
	
	СтруктураНоменклатуры=Справочники.Лико_ВерсииНоменклатуры.СоздатьНоменклатуру
	(НаименованиеНоменклатуры,
	ТипЭтикетки,
	НоваяВерсия,
	Регион,
	Клиент,
	Менеджер,
	Дизайнер,
	Истина,
	НоменклатураDFM,
	?(ЗначениеЗаполнено(АртикулDFM),АртикулDFM,Неопределено)
	,
	,Заказ
	,Комментарий);
	
	
	Если ЗначениеЗаполнено(СтруктураНоменклатуры.Ошибка) Тогда
		Сообщить(СтруктураНоменклатуры.Ошибка);
		Возврат Ложь;
	КонецЕсли;
	
	// <-- Начало Лико Яцун С. В. 09.01.2025
	Если ЗначениеЗаполнено(КодЛинкс) И Не НайтиПродукт Тогда
		НоменклатурыОбъект = СтруктураНоменклатуры.Номенклатура.ПолучитьОбъект();
		НоменклатурыОбъект.Лико_КодЛинкс = Формат(КодЛинкс,"ЧЦ=7; ЧВН=; ЧГ=0");
		НоменклатурыОбъект.Лико_АртикулЛинкс = АртикулЛинкс;
		НоменклатурыОбъект.ОбменДанными.Загрузка = Истина;
		НоменклатурыОбъект.Записать();
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 09.01.2025
	
	Номенклатура      =СтруктураНоменклатуры.Номенклатура;
	Версия            =СтруктураНоменклатуры.Версия;
	ВерсияНоменклатуры  =СтруктураНоменклатуры.ВерсияНоменклатуры;
	//Результат=Справочники.Лико_ВерсииНоменклатуры.СоздатьНоменклатуруВDFM(Клиент,ТипЭтикетки,Номенклатура,НоваяТехнология,НоваяВерсия,Менеджер,Дизайнер);
	ЗафиксироватьТранзакцию();
	Возврат Истина;
КонецФункции

&НаКлиенте
Асинх Процедура СоздатьНоменклатуру(Команда)
	
	Если ПроверкаЗаполненияПолей()Тогда
		Если Полуфабрикат ТОгда
			
			Номенклатура=СоздатьПолуфабрикат(НаименованиеНоменклатуры,Артикул);
			Структура = Новый Структура;
			Структура.Вставить("Номенклатура",Номенклатура);
			Структура.Вставить("ВерсияНоменклатуры",ПредопределенноеЗначение("Справочник.Лико_ВерсииНоменклатуры.ПустаяСсылка"));
			Закрыть(Структура);
			
			
		Иначе
			
			//Режим = РежимДиалогаВопрос.ДаНет;
			//	Ответ = Ждать ВопросАсинх(СтрШаблон("Отправить уведомление дизайнеру :%1?",Дизайнер), Режим, 0);
			//	Если Ответ = КодВозвратаДиалога.Нет Тогда
			//		Дизайнер=Неопределено;
			//	Иначе
			//		ПроверкаЗаполненияПоляДизайнер=Истина;
			//		СообщитьПользователю(Дизайнер,"Дизайнер","Дизайнер",ПроверкаЗаполненияПоляДизайнер); 
			//     Если Не ПроверкаЗаполненияПоляДизайнер Тогда
			//		  Возврат;
			//	КонецЕсли;
			//КонецЕсли;
			
			Если Не ОтправитьУведомление Тогда
				Дизайнер=Неопределено;
			КонецЕсли;
			НоменклатураБылаЗаполнена= ЗначениеЗаполнено(Номенклатура);
			
			Если Не ЗначениеЗаполнено(Номенклатура) Тогда
				Номенклатура=НайтиНоменклатуруКлиентаНаСервере();
				//НоваяТехнология=Технология;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Номенклатура) И
				ЗначениеЗаполнено(НайтиВерсиюНаСервере()) Тогда 
				
				НайденнаяВерсия=НайтиВерсиюНаСервере(); 
				
				Режим = РежимДиалогаВопрос.ДаНет;
				Ответ = Ждать ВопросАсинх(СтрШаблон("Данный продукт : %1 уже существует. Перенести  в  заказ?",Лико_Дополнительно.ЗначениеРеквизитаОбъекта(НайденнаяВерсия,"Артикул")), Режим, 0);
				Если Ответ = КодВозвратаДиалога.Нет Тогда
					Если Не НоменклатураБылаЗаполнена Тогда
						Номенклатура=Неопределено;
					КонецЕсли;
					
					Возврат;
				КонецЕсли;
              КонецЕсли;
				
			Если СоздатьНоменклатуруНаСервере() Тогда 
				
				Структура = Новый Структура;
				Структура.Вставить("Номенклатура",Номенклатура);
				Структура.Вставить("ВерсияНоменклатуры",ВерсияНоменклатуры);
				Закрыть(Структура);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

