Функция СоздатьВерсиюНоменкатуры (Номенклатура,Версия) Экспорт//+Лико m.shenderov 26.04.2021  
	
	ВерсияНоменклатуры=Неопределено;
	Если  Версия<>Неопределено Тогда
		ВерсияНоменклатуры=НайтиВерсиюНоменклатуры(Номенклатура,Версия);
				
	КонецЕсли;
		
	 Если ВерсияНоменклатуры=Неопределено Тогда
		СпрОбъект =Справочники.Лико_ВерсииНоменклатуры.СоздатьЭлемент();
	Иначе
		СпрОбъект =ВерсияНоменклатуры.ПолучитьОбъект();	
	КонецЕсли;

	
	СпрОбъект.Номенклатура			=Номенклатура;
	СпрОбъект.АртикулНоменклатуры	=Номенклатура.Артикул;
	СпрОбъект.Версия				=?(Версия=Неопределено,ПолучитьНовуюВерсиюНоменклатуры(Номенклатура),Версия);
	СпрОбъект.Артикул               =СтрШаблон("%1-%2",СпрОбъект.АртикулНоменклатуры,Строка(СпрОбъект.Версия));
	
	СпрОбъект.Записать();
	
	Возврат СпрОбъект.Ссылка;
	
КонецФункции  //-Лико m.shenderov 26.04.2021

Функция СоздатьВерсиюНоменкатуры22012024 (Номенклатура,Технология,Версия) Экспорт//+Лико m.shenderov 26.04.2021  
	
	ВерсияНоменклатуры=Неопределено;
	Если  Версия<>Неопределено Тогда
		ВерсияНоменклатуры=НайтиВерсиюНоменклатуры(Номенклатура,Версия);
				
	КонецЕсли;
		
	 Если ВерсияНоменклатуры=Неопределено Тогда
		СпрОбъект =Справочники.Лико_ВерсииНоменклатуры.СоздатьЭлемент();
	Иначе
		СпрОбъект =ВерсияНоменклатуры.ПолучитьОбъект();	
	КонецЕсли;

	
	СпрОбъект.Номенклатура			=Номенклатура;
	СпрОбъект.АртикулНоменклатуры	=Номенклатура.Артикул;
	СпрОбъект.Версия				=?(Версия=Неопределено,ПолучитьНовуюВерсиюНоменклатуры(Номенклатура),Версия);
	СпрОбъект.Технология            =Технология.Код;
	СпрОбъект.ТехнологияПечати      =Технология;
	СпрОбъект.Артикул               =СтрШаблон("%1-%2-%3",СпрОбъект.АртикулНоменклатуры,Строка(СпрОбъект.Версия),Строка(Технология.Код));
	
