Функция ПолучитьНовуюВерсиюНоменклатуры(Номенклатура) Экспорт //+Лико m.shenderov 26.04.2021
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ВерсииНоменклатуры.Версия КАК Версия
	|ИЗ
	|	Справочник.Лико_ВерсииНоменклатуры КАК Лико_ВерсииНоменклатуры
	|ГДЕ
	|	Лико_ВерсииНоменклатуры.Номенклатура = &Номенклатура
	|	И НЕ Лико_ВерсииНоменклатуры.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Версия УБЫВ";
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Возврат Выборка.Версия+1;
		
	КонецЦикла; 	
	Возврат 0;	
КонецФункции //-Лико m.shenderov 26.04.2021 

Функция СоздатьНоменклатуру(НаименованиеНоменклатуры,ТипЭтикетки,Версия=Неопределено,Регион,Клиент,Менеджер,Дизайнер,DFM,Номенклатура=Неопределено,Артикул=Неопределено,СоздатьDFM=Истина,Заказ,Комментарий="") Экспорт
	Структура = Новый Структура;
	Структура.Вставить("Номенклатура");
	Структура.Вставить("Артикул");
	Структура.Вставить("Ошибка","");
	
	НовыйАртикул=ПолучитьАртикул();

	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	
	Если Номенклатура=Неопределено Тогда
		Если Артикул=Неопределено Тогда 
			Артикул       =НовыйАртикул;
		КонецЕсли;
		
		
		
		#Если ВнешнееСоединение Тогда
			
		#Иначе 
			// <-- Начало Лико Яцун С. В. 31.07.2025 
			Если ЗначениеЗаполнено(Заказ) Тогда
				ТипЗаказа = Заказ.ТипЗаказа;	
			Иначе
				ТипЗаказа = Неопределено;	
			КонецЕсли;
			// <-- Конец Лико Яцун С. В. 31.07.2025
			Номенклатура  =Лико_Планирование.СоздатьНоменклатуруНаСервере(НаименованиеНоменклатуры,ТипЭтикетки,Регион,Клиент,Артикул,DFM,ТипЗаказа);
		#КонецЕсли	
	КонецЕсли;
	Если ЗначениеЗаполнено(Номенклатура) И Не Номенклатура.Лико_DFM Тогда 
		СпрОбъект=Номенклатура.ПолучитьОбъект();
		СпрОбъект.Лико_DFM=Истина;
		СпрОбъект.Лико_АртикулСтарый=СпрОбъект.Артикул;
		СпрОбъект.Артикул=НовыйАртикул;
		СпрОбъект.Записать();
	КонецЕсли;
	
	ВерсияНоменклатуры=Справочники.Лико_ВерсииНоменклатуры.СоздатьВерсиюНоменкатуры(Номенклатура,Версия);
	Структура.Вставить("Версия",ВерсияНоменклатуры.Версия);
	Структура.Вставить("ВерсияНоменклатуры",ВерсияНоменклатуры);
	Артикул=ВерсияНоменклатуры.АртикулНоменклатуры;
	Если Не ОтправитьВDFM(ВерсияНоменклатуры,ТипЭтикетки,Регион,Клиент,Менеджер,Дизайнер,Заказ,Комментарий) Тогда
		ВызватьИсключение "Отправка версии номенклатуры в DFM не выполнена!";
	КонецЕсли;
	
		
	Если СоздатьDFM Тогда
		СоздатьНоменклатуруДфМ=СоздатьНоменклатуруВDFM(Клиент,ТипЭтикетки,Номенклатура,Версия,Менеджер,Дизайнер,Заказ,Комментарий);
	КонецЕсли;
	Структура.Номенклатура =Номенклатура;	
	Структура.Артикул      =Артикул;
	
	ЗафиксироватьТранзакцию();
	Возврат Структура;
	
КонецФункции

Функция СоздатьНоменклатуру22012014(НаименованиеНоменклатуры,ТипЭтикетки,Технология,Версия=Неопределено,Регион,Клиент,Менеджер,Дизайнер,DFM,Номенклатура=Неопределено,Артикул=Неопределено,СоздатьDFM=Истина,Заказ,Комментарий="") Экспорт
	Структура = Новый Структура;
	Структура.Вставить("Номенклатура");
	Структура.Вставить("Артикул");
	Структура.Вставить("Ошибка","");
	
	НовыйАртикул=ПолучитьАртикул();

	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	
	Если Номенклатура=Неопределено Тогда
		Если Артикул=Неопределено Тогда 
			Артикул       =НовыйАртикул;
		КонецЕсли;
		
		
		
		#Если ВнешнееСоединение Тогда
			
		#Иначе
			Номенклатура  =Лико_Планирование.СоздатьНоменклатуруНаСервере(НаименованиеНоменклатуры,ТипЭтикетки,Регион,Клиент,Артикул,DFM);
		#КонецЕсли	
	КонецЕсли;
	Если ЗначениеЗаполнено(Номенклатура) И Не Номенклатура.Лико_DFM Тогда 
		СпрОбъект=Номенклатура.ПолучитьОбъект();
		СпрОбъект.Лико_DFM=Истина;
		СпрОбъект.Лико_АртикулСтарый=СпрОбъект.Артикул;
		СпрОбъект.Артикул=НовыйАртикул;
		СпрОбъект.Записать();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Технология) Или ЗначениеЗаполнено(Версия) Тогда 
		ВерсияНоменклатуры=Справочники.Лико_ВерсииНоменклатуры.СоздатьВерсиюНоменкатуры(Номенклатура,Технология,Версия);
		Структура.Вставить("Версия",ВерсияНоменклатуры.Версия);
		Структура.Вставить("ВерсияНоменклатуры",ВерсияНоменклатуры);
		Артикул=ВерсияНоменклатуры.АртикулНоменклатуры;
		Если Не ОтправитьВDFM(ВерсияНоменклатуры,ТипЭтикетки,Регион,Клиент,Менеджер,Дизайнер,Заказ,Комментарий) Тогда
			ВызватьИсключение "Отправка версии номенклатуры в DFM не выполнена!";
		КонецЕсли;
		
		
	КонецЕсли;
	Если СоздатьDFM Тогда
		СоздатьНоменклатуруДфМ=СоздатьНоменклатуруВDFM(Клиент,ТипЭтикетки,Номенклатура,Версия,Менеджер,Дизайнер,Заказ,Комментарий);
	КонецЕсли;
	Структура.Номенклатура =Номенклатура;	
	Структура.Артикул      =Артикул;
	
	ЗафиксироватьТранзакцию();
	Возврат Структура;
	
КонецФункции


