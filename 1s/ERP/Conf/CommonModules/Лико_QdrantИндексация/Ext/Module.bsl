// Определяет КАТЕГОРИЮ ПРОДУКЦИИ по наименованию (шампунь, пиво, масла...)
// Параметры:
//   Наименование — Строка
// Возвращает: Строка — категория
Функция ОпределитьКатегориюПродукцииДляQdrant(Наименование) Экспорт

	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Возврат "прочее";
	КонецЕсли;

	НаименованиеВерх = ВРег(СокрЛП(Наименование));

	// Косметика (шампунь ДО шампанского!)
	Если СтрНайти(НаименованиеВерх, "ШАМПУН") > 0 Тогда Возврат "шампунь"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "КОНДИЦИОНЕР") > 0 Тогда Возврат "кондиционер_для_волос"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "МАСК") > 0 И СтрНайти(НаименованиеВерх, "ВОЛОС") > 0 Тогда Возврат "маска_для_волос"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "КРЕМ") > 0 И (СтрНайти(НаименованиеВерх, "ЛИЦА") > 0 ИЛИ СтрНайти(НаименованиеВерх, "РУК") > 0 ИЛИ СтрНайти(НаименованиеВерх, "ТЕЛА") > 0) Тогда Возврат "крем_косметический"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ЛОСЬОН") > 0 Тогда Возврат "лосьон"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "СКРАБ") > 0 Тогда Возврат "скраб"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ДЕЗОДОРАНТ") > 0 ИЛИ СтрНайти(НаименованиеВерх, "АНТИПЕРСПИРАНТ") > 0 Тогда Возврат "дезодорант"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ПАРФЮМ") > 0 ИЛИ СтрНайти(НаименованиеВерх, "ТУАЛЕТН") > 0 Тогда Возврат "парфюмерия"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "МЫЛО") > 0 Тогда Возврат "мыло"; КонецЕсли;

	// Алкоголь
	Если СтрНайти(НаименованиеВерх, "ШАМПАНСК") > 0 ИЛИ СтрНайти(НаименованиеВерх, "ПРОСЕККО") > 0 ИЛИ СтрНайти(НаименованиеВерх, "АСТИ") > 0 Тогда Возврат "шампанское_игристые_вина"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ВИНО") > 0 ИЛИ СтрНайти(НаименованиеВерх, "МУСКАТ") > 0 ИЛИ СтрНайти(НаименованиеВерх, "КАБЕРНЕ") > 0 ИЛИ СтрНайти(НаименованиеВерх, "МЕРЛО") > 0 Тогда Возврат "вина"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ПИВО") > 0 ИЛИ СтрНайти(НаименованиеВерх, "ЛАГЕР") > 0 ИЛИ СтрНайти(НаименованиеВерх, "АЛЕ") > 0 ИЛИ СтрНайти(НаименованиеВерх, "СТАУТ") > 0 Тогда Возврат "пиво"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ВОДК") > 0 Тогда Возврат "водка"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "КОНЬЯК") > 0 ИЛИ СтрНайти(НаименованиеВерх, "БРЕНДИ") > 0 Тогда Возврат "коньяк_бренди"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ЛИКЕР") > 0 Тогда Возврат "ликеры"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "НАСТОЙК") > 0 Тогда Возврат "настойки"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ДЖИН") > 0 Тогда Возврат "джин"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "РОМ") > 0 Тогда Возврат "ром"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ТЕКИЛА") > 0 Тогда Возврат "текила"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ВИСКИ") > 0 Тогда Возврат "виски"; КонецЕсли;

	// Безалкогольные напитки
	Если СтрНайти(НаименованиеВерх, "СОК") > 0 ИЛИ СтрНайти(НаименованиеВерх, "НЕКТАР") > 0 ИЛИ СтрНайти(НаименованиеВерх, "МОРС") > 0 Тогда Возврат "соки_нектары"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ВОДА") > 0 ИЛИ СтрНайти(НаименованиеВерх, "МИНЕРАЛЬН") > 0 Тогда Возврат "вода"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ГАЗИРОВК") > 0 ИЛИ СтрНайти(НаименованиеВерх, "ЛИМОНАД") > 0 ИЛИ СтрНайти(НаименованиеВерх, "КОЛА") > 0 ИЛИ СтрНайти(НаименованиеВерх, "СПРАЙТ") > 0 Тогда Возврат "газированные_напитки"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ЭНЕРГЕТИК") > 0 Тогда Возврат "энергетики"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ЧАЙ") > 0 Тогда Возврат "чай"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "КОФЕ") > 0 Тогда Возврат "кофе"; КонецЕсли;

	// Масла и автохимия
	Если СтрНайти(НаименованиеВерх, "МАСЛ") > 0 ИЛИ СтрНайти(НаименованиеВерх, "МОТОРН") > 0 ИЛИ СтрНайти(НаименованиеВерх, "SINTEC") > 0 ИЛИ СтрНайти(НаименованиеВерх, "MOBIL") > 0 ИЛИ СтрНайти(НаименованиеВерх, "SHELL") > 0 ИЛИ СтрНайти(НаименованиеВерх, "CASTROL") > 0 ИЛИ СтрНайти(НаименованиеВерх, "ЛУКОЙЛ") > 0 Тогда Возврат "масла_автохимия"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "АНТИФРИЗ") > 0 Тогда Возврат "антифриз"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ТОРМОЗН") > 0 Тогда Возврат "тормозная_жидкость"; КонецЕсли;

	// БАДы/лекарства
	Если СтрНайти(НаименованиеВерх, "БАД") > 0 ИЛИ СтрНайти(НаименованиеВерх, "ТАБЛЕТК") > 0 ИЛИ СтрНайти(НаименованиеВерх, "КАПСУЛ") > 0 ИЛИ СтрНайти(НаименованиеВерх, "ВИТАМИН") > 0 ИЛИ СтрНайти(НаименованиеВерх, "СИРОП") > 0 Тогда Возврат "бады_лекарства"; КонецЕсли;

	// Бытовая химия
	Если СтрНайти(НаименованиеВерх, "СТИРАН") > 0 ИЛИ СтрНайти(НаименованиеВерх, "ПРАН") > 0 Тогда Возврат "средства_для_стирки"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ПОСУД") > 0 Тогда Возврат "средства_для_посуды"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "УБОРК") > 0 ИЛИ СтрНайти(НаименованиеВерх, "УБИРАН") > 0 Тогда Возврат "средства_для_уборки"; КонецЕсли;

	// Продукты питания
	Если СтрНайти(НаименованиеВерх, "МОЛОК") > 0 ИЛИ СтрНайти(НаименованиеВерх, "КЕФИР") > 0 ИЛИ СтрНайти(НаименованиеВерх, "СМЕТАН") > 0 ИЛИ СтрНайти(НаименованиеВерх, "ЙОГУРТ") > 0 Тогда Возврат "молочные_продукты"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "СЫР") > 0 Тогда Возврат "сыры"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "МЯС") > 0 ИЛИ СтрНайти(НаименованиеВерх, "КОЛБАС") > 0 ИЛИ СтрНайти(НаименованиеВерх, "СОСИС") > 0 Тогда Возврат "мясные_продукты"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "СОУС") > 0 ИЛИ СтрНайти(НаименованиеВерх, "КЕТЧУП") > 0 ИЛИ СтрНайти(НаименованиеВерх, "МАЙОНЕЗ") > 0 Тогда Возврат "соусы"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ПРИПРАВ") > 0 ИЛИ СтрНайти(НаименованиеВерх, "СПЕЦИ") > 0 ИЛИ СтрНайти(НаименованиеВерх, "СОЛЬ") > 0 Тогда Возврат "приправы_специи"; КонецЕсли;

	// Строительные
	Если СтрНайти(НаименованиеВерх, "БЕТОН") > 0 ИЛИ СтрНайти(НаименованиеВерх, "ЦЕМЕНТ") > 0 ИЛИ СтрНайти(НаименованиеВерх, "КРАСК") > 0 ИЛИ СтрНайти(НаименованиеВерх, "ЛАК") > 0 ИЛИ СтрНайти(НаименованиеВерх, "ШТУКАТУР") > 0 Тогда Возврат "строительные_материалы"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "КЛЕЙ") > 0 Тогда Возврат "клей"; КонецЕсли;
	Если СтрНайти(НаименованиеВерх, "ГЕРМЕТИК") > 0 Тогда Возврат "герметик"; КонецЕсли;

	Возврат "прочее";

КонецФункции

