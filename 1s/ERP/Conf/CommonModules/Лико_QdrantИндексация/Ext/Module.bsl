
//+Лико m.shenderov 12.05.2026
// Серверный общий модуль: формирование данных для индексации заказов в Qdrant
// Источники данных:
//   1. ЗаказСсылка  — реквизиты документа ЗаказКлиента
//   2. ПараметрыМакета (Структура, необязательно) — результат Vision-анализа файла макета,
//      содержит поля: label{width_mm, height_mm, shape}, layout{across, along},
//      colors{count, list[]}, label_type, technology, material_hint, finishing{varnish, foil, embossing}

#Область ПубличныеФункции

//+Лико m.shenderov 12.05.2026
// Основная функция: формирует полные данные заказа для индексации в Qdrant
// Параметры:
//   ЗаказСсылка    — ДокументСсылка.ЗаказКлиента
//   ПараметрыМакета — Структура (необязательно) результат анализа макета Vision-моделью
//     Поля: label{width_mm, height_mm, shape}, layout{across, along, total_per_sheet},
//           colors{count, list[]}, label_type, technology, material_hint, confidence,
//           finishing{varnish, foil, embossing}
// Возвращает:
//   Структура с полями: success, error, order_id, text_for_embedding, payload
Функция СформироватьДанныеДляИндексации(ЗаказСсылка, ПараметрыМакета = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("success",            Ложь);
	Результат.Вставить("error",              "");
	Результат.Вставить("order_id",           "");
	Результат.Вставить("text_for_embedding", "");
	Результат.Вставить("payload",            Неопределено);

	Попытка
		Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда
			Результат.error = "Не указана ссылка на заказ";
			Возврат Результат;
		КонецЕсли;

		ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
		Если ЗаказОбъект = Неопределено Тогда
			Результат.error = "Заказ не найден: " + Строка(ЗаказСсылка);
			Возврат Результат;
		КонецЕсли;

		Результат.order_id           = Строка(ЗаказСсылка.УникальныйИдентификатор());
		Результат.payload            = СформироватьPayloadЗаказа(ЗаказОбъект, ПараметрыМакета);
		Результат.text_for_embedding = СформироватьТекстДляЭмбеддинга(Результат.payload);
		Результат.payload.Вставить("text_for_embedding", Результат.text_for_embedding);

		Результат.success = Истина;

	Исключение
		Результат.error = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

//+Лико m.shenderov 12.05.2026
// Формирует payload (~30+ полей + массив colors) для Qdrant из объекта заказа
// и обогащает его данными из Vision-анализа макета (ПараметрыМакета)
// Параметры:
//   ЗаказОбъект    — ДокументОбъект.ЗаказКлиента
//   ПараметрыМакета — Структура (необязательно) — результат Vision LLM
// Возвращает: Структура — payload для Qdrant
Функция СформироватьPayloadЗаказа(ЗаказОбъект, ПараметрыМакета = Неопределено) Экспорт

	Payload = Новый Структура;

	// ── Основные реквизиты ─────────────────────────────────────────────────
	Payload.Вставить("order_id",     Строка(ЗаказОбъект.Ссылка.УникальныйИдентификатор()));
	Payload.Вставить("order_number", ЗаказОбъект.Номер);
	Payload.Вставить("order_date",   ЗаказОбъект.Дата);

	КлиентПредставление = "";
	Если ЗначениеЗаполнено(ЗаказОбъект.Контрагент) Тогда
		КлиентПредставление = Строка(ЗаказОбъект.Контрагент);
	КонецЕсли;
	Payload.Вставить("client", КлиентПредставление);

	НазваниеЭтикетки = "";
	Если ЗаказОбъект.Товары.Количество() > 0 Тогда
		НазваниеЭтикетки = Строка(ЗаказОбъект.Товары[0].Номенклатура);
	КонецЕсли;
	Payload.Вставить("label_name", НазваниеЭтикетки);

	// ── Тип заказа ─────────────────────────────────────────────────────────
	ТипЗаказаСтр = "";
	Если ЗначениеЗаполнено(ЗаказОбъект.ТипЗаказа) Тогда
		ТипЗаказаСтр = НРег(СтрЗаменить(Строка(ЗаказОбъект.ТипЗаказа), " ", "_"));
	КонецЕсли;
	Payload.Вставить("order_type", ТипЗаказаСтр);

	// ── Тип этикетки: сначала из макета, затем из документа ───────────────
	ТипЭтикетки = "";
	Если ПараметрыМакетаЗаданы(ПараметрыМакета) И ПараметрыМакета.Свойство("label_type")
			И ЗначениеЗаполнено(ПараметрыМакета.label_type) Тогда
		ТипЭтикетки = ПараметрыМакета.label_type;
	КонецЕсли;
	Payload.Вставить("label_type", ТипЭтикетки);
	Payload.Вставить("label_type_source", ?(ЗначениеЗаполнено(ТипЭтикетки), "vision", ""));

	//+Лико m.shenderov 13.05.2026
	// ── Текст этикетки из Vision (label_text) ────────────────────────────────
	ТекстБренд    = "";
	ТекстПродукт  = "";
	ТекстОбъём    = "";
	ТекстПолный   = "";
	ТекстИсточник = "";
	Если ПараметрыМакетаЗаданы(ПараметрыМакета) И ПараметрыМакета.Свойство("label_text")
			И ТипЗнч(ПараметрыМакета.label_text) = Тип("Структура") Тогда
		ТекстМакета = ПараметрыМакета.label_text;
		Если ТекстМакета.Свойство("brand") И ЗначениеЗаполнено(ТекстМакета.brand) Тогда
			ТекстБренд = Строка(ТекстМакета.brand);
		КонецЕсли;
		Если ТекстМакета.Свойство("product_name") И ЗначениеЗаполнено(ТекстМакета.product_name) Тогда
			ТекстПродукт = Строка(ТекстМакета.product_name);
		КонецЕсли;
		Если ТекстМакета.Свойство("volume_weight") И ЗначениеЗаполнено(ТекстМакета.volume_weight) Тогда
			ТекстОбъём = Строка(ТекстМакета.volume_weight);
		КонецЕсли;
		Если ТекстМакета.Свойство("full_text") И ЗначениеЗаполнено(ТекстМакета.full_text) Тогда
			ТекстПолный = Строка(ТекстМакета.full_text);
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекстПолный) Тогда
			ТекстИсточник = "vision";
		КонецЕсли;
	КонецЕсли;
	Payload.Вставить("label_text_brand",    ТекстБренд);
	Payload.Вставить("label_text_product",  ТекстПродукт);
	Payload.Вставить("label_text_volume",   ТекстОбъём);
	Payload.Вставить("label_text_full",     ТекстПолный);
	Payload.Вставить("label_text_source",   ТекстИсточник);

	// ── Категория продукции: улучшенная — приоритет label_text.full_text ───
	ТекстДляКатегории = НазваниеЭтикетки;
	Если ЗначениеЗаполнено(ТекстПолный) Тогда
		// full_text с макета даёт больше ключевых слов чем техническое имя номенклатуры
		ТекстДляКатегории = ТекстПолный;
	ИначеЕсли ЗначениеЗаполнено(ТекстПродукт) Тогда
		ТекстДляКатегории = ТекстПродукт;
	КонецЕсли;
	Payload.Вставить("product_category", ОпределитьКатегориюПродукцииДляQdrant(ТекстДляКатегории));

	// ── Размеры: сначала из макета (точнее), затем из документа ───────────
	РазмерШирина  = ЗаказОбъект.ШиринаЭтикетки;
	РазмерВысота  = ЗаказОбъект.ДлинаЭтикетки;
	РазмерИсточник = "document";
	ФормаЭтикетки  = "";

	Если ПараметрыМакетаЗаданы(ПараметрыМакета) И ПараметрыМакета.Свойство("label") Тогда
		ДанныеЭтикетки = ПараметрыМакета.label;
		Если ДанныеЭтикетки.Свойство("width_mm") И ЗначениеЗаполнено(ДанныеЭтикетки.width_mm)
				И ДанныеЭтикетки.width_mm > 0 Тогда
			РазмерШирина   = ДанныеЭтикетки.width_mm;
			РазмерИсточник = "vision";
		КонецЕсли;
		Если ДанныеЭтикетки.Свойство("height_mm") И ЗначениеЗаполнено(ДанныеЭтикетки.height_mm)
				И ДанныеЭтикетки.height_mm > 0 Тогда
			РазмерВысота   = ДанныеЭтикетки.height_mm;
			РазмерИсточник = "vision";
		КонецЕсли;
		Если ДанныеЭтикетки.Свойство("shape") И ЗначениеЗаполнено(ДанныеЭтикетки.shape) Тогда
			ФормаЭтикетки = ДанныеЭтикетки.shape;
		КонецЕсли;
	КонецЕсли;

	Payload.Вставить("size_width_mm",    РазмерШирина);
	Payload.Вставить("size_height_mm",   РазмерВысота);
	Payload.Вставить("size_source",      РазмерИсточник);
	Payload.Вставить("label_shape",      ФормаЭтикетки);
	Payload.Вставить("rapport_mm",       ЗаказОбъект.ШагПечати);

	// ── Раскладка: сначала из макета, затем из документа ──────────────────
	ЛистовПоПерек = ЗаказОбъект.ЭтикетокНаЛисте;
	ЛистовПоДлине = ЗаказОбъект.Ручьи;
	ВсегоНаЛисте  = 0;
	РаскладкаИсточник = "document";

	Если ПараметрыМакетаЗаданы(ПараметрыМакета) И ПараметрыМакета.Свойство("layout") Тогда
		Раскладка = ПараметрыМакета.layout;
		Если Раскладка.Свойство("across") И ЗначениеЗаполнено(Раскладка.across)
				И Раскладка.across > 0 Тогда
			ЛистовПоПерек    = Раскладка.across;
			РаскладкаИсточник = "vision";
		КонецЕсли;
		Если Раскладка.Свойство("along") И ЗначениеЗаполнено(Раскладка.along)
				И Раскладка.along > 0 Тогда
			ЛистовПоДлине    = Раскладка.along;
			РаскладкаИсточник = "vision";
		КонецЕсли;
		Если Раскладка.Свойство("total_per_sheet") И ЗначениеЗаполнено(Раскладка.total_per_sheet)
				И Раскладка.total_per_sheet > 0 Тогда
			ВсегоНаЛисте = Раскладка.total_per_sheet;
		КонецЕсли;
	КонецЕсли;

	Если ВсегоНаЛисте = 0 И ЛистовПоПерек > 0 И ЛистовПоДлине > 0 Тогда
		ВсегоНаЛисте = ЛистовПоПерек * ЛистовПоДлине;
	КонецЕсли;

	Payload.Вставить("lanes_print",       ЛистовПоПерек);
	Payload.Вставить("labels_per_lane",   ЛистовПоДлине);
	Payload.Вставить("labels_per_sheet",  ВсегоНаЛисте);
	Payload.Вставить("layout_source",     РаскладкаИсточник);

	// ── Технология: сначала из макета, затем из документа (нет прямого реквизита) ─
	ТехнологияСтр = "";
	ТехнологияИсточник = "";

	Если ПараметрыМакетаЗаданы(ПараметрыМакета) И ПараметрыМакета.Свойство("technology")
			И ЗначениеЗаполнено(ПараметрыМакета.technology) Тогда
		ТехнологияСтр     = НРег(ПараметрыМакета.technology);
		ТехнологияИсточник = "vision";
	КонецЕсли;

	Payload.Вставить("technology",        ТехнологияСтр);
	Payload.Вставить("technology_source", ТехнологияИсточник);

	// ── Детальные цвета из ТЧ Цвета ──────────────────────────────────────
	МассивЦветов      = Новый Массив;
	КоличествоКрасок  = 0;
	СуммарнаяГрамматура = 0;
	ТипыЦветов        = Новый Соответствие;

	Для Каждого СтрокаЦвет Из ЗаказОбъект.Цвета Цикл
		Цвет = Новый Структура;
		Цвет.Вставить("name",             Строка(СтрокаЦвет.Название));
		Цвет.Вставить("type",             ?(ЗначениеЗаполнено(СтрокаЦвет.ТипЦвета1), Строка(СтрокаЦвет.ТипЦвета1), ""));
		Цвет.Вставить("ink_type",         ?(ЗначениеЗаполнено(СтрокаЦвет.ТипКраски), Строка(СтрокаЦвет.ТипКраски), ""));
		Цвет.Вставить("section",          ?(ЗначениеЗаполнено(СтрокаЦвет.ВидСекции), Строка(СтрокаЦвет.ВидСекции), ""));
		Цвет.Вставить("fill_pct",         СтрокаЦвет.ПроцентЗаливки);
		Цвет.Вставить("gsm",              СтрокаЦвет.Грамматура);
		Цвет.Вставить("roll_number",      СтрокаЦвет.НомерПроката);
		Цвет.Вставить("color_separation", СтрокаЦвет.Цветоделение);
		МассивЦветов.Добавить(Цвет);

		Если ЗначениеЗаполнено(Цвет.name) Тогда
			КоличествоКрасок = КоличествоКрасок + 1;
		КонецЕсли;
		СуммарнаяГрамматура = СуммарнаяГрамматура + Цвет.gsm;

		Если ЗначениеЗаполнено(Цвет.type) Тогда
			Текущее = ТипыЦветов.Получить(Цвет.type);
			Если Текущее = Неопределено Тогда
				ТипыЦветов.Вставить(Цвет.type, 1);
			Иначе
				ТипыЦветов.Вставить(Цвет.type, Текущее + 1);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Обогащение цветов из Vision: если ТЧ пустая — берём список цветов из макета
	ЦветаИзМакета = Ложь;
	Если КоличествоКрасок = 0 И ПараметрыМакетаЗаданы(ПараметрыМакета)
			И ПараметрыМакета.Свойство("colors") Тогда
		ДанныеЦветов = ПараметрыМакета.colors;
		Если ДанныеЦветов.Свойство("list") И ТипЗнч(ДанныеЦветов.list) = Тип("Массив")
				И ДанныеЦветов.list.Количество() > 0 Тогда
			Для Каждого ИмяЦвета Из ДанныеЦветов.list Цикл
				Цвет = Новый Структура;
				Цвет.Вставить("name",             Строка(ИмяЦвета));
				Цвет.Вставить("type",             "vision");
				Цвет.Вставить("ink_type",         "");
				Цвет.Вставить("section",          "");
				Цвет.Вставить("fill_pct",         0);
				Цвет.Вставить("gsm",              0);
				Цвет.Вставить("roll_number",      0);
				Цвет.Вставить("color_separation", 0);
				МассивЦветов.Добавить(Цвет);
				КоличествоКрасок = КоличествоКрасок + 1;
			КонецЦикла;
			ЦветаИзМакета = Истина;
		КонецЕсли;
		Если КоличествоКрасок = 0 И ДанныеЦветов.Свойство("count")
				И ЗначениеЗаполнено(ДанныеЦветов.count) И ДанныеЦветов.count > 0 Тогда
			// Только количество известно
			КоличествоКрасок = ДанныеЦветов.count;
			ЦветаИзМакета = Истина;
		КонецЕсли;
	КонецЕсли;

	Payload.Вставить("colors",           МассивЦветов);
	Payload.Вставить("colors_count",     КоличествоКрасок);
	Payload.Вставить("colors_total_gsm", СуммарнаяГрамматура);
	Payload.Вставить("colors_from_vision", ЦветаИзМакета);

	СтатистикаТипов = Новый Структура;
	Для Каждого ЭлементТип Из ТипыЦветов Цикл
		СтатистикаТипов.Вставить(ЭлементТип.Ключ, ЭлементТип.Значение);
	КонецЦикла;
	Payload.Вставить("colors_by_type", СтатистикаТипов);

	// ── Материал: из реквизита шапки, может дополняться из макета ─────────
	Материал = "";
	Если ЗначениеЗаполнено(ЗаказОбъект.ОсновнойМатериал) Тогда
		Материал = Строка(ЗаказОбъект.ОсновнойМатериал);
	КонецЕсли;
	МатериалИсточник = ?(ЗначениеЗаполнено(Материал), "document", "");

	Если НЕ ЗначениеЗаполнено(Материал) И ПараметрыМакетаЗаданы(ПараметрыМакета)
			И ПараметрыМакета.Свойство("material_hint")
			И ЗначениеЗаполнено(ПараметрыМакета.material_hint) Тогда
		Материал       = ПараметрыМакета.material_hint;
		МатериалИсточник = "vision";
	КонецЕсли;

	Payload.Вставить("material",        Материал);
	Payload.Вставить("material_source", МатериалИсточник);

	// ── Операции (ламинация, тиснение, трафарет) ──────────────────────────
	ЕстьЛаминация = ЗаказОбъект.Ламинация;
	ЕстьТиснение  = ЗаказОбъект.Тиснение;
	ЕстьТрафарет  = ЗаказОбъект.Трафарет;
	ЕстьЛак       = Ложь;
	ЕстьФольга    = Ложь;

	// Обогащение отделкой из макета
	Если ПараметрыМакетаЗаданы(ПараметрыМакета) И ПараметрыМакета.Свойство("finishing") Тогда
		Отделка = ПараметрыМакета.finishing;
		Если Отделка.Свойство("varnish") И ЗначениеЗаполнено(Отделка.varnish) Тогда
			ЕстьЛак = (Отделка.varnish = Истина ИЛИ НРег(Строка(Отделка.varnish)) = "true");
		КонецЕсли;
		Если Отделка.Свойство("foil") И ЗначениеЗаполнено(Отделка.foil) Тогда
			ЕстьФольга = (Отделка.foil = Истина ИЛИ НРег(Строка(Отделка.foil)) = "true");
		КонецЕсли;
		Если Отделка.Свойство("embossing") И ЗначениеЗаполнено(Отделка.embossing)
				И НЕ ЕстьТиснение Тогда
			ЕстьТиснение = (Отделка.embossing = Истина ИЛИ НРег(Строка(Отделка.embossing)) = "true");
		КонецЕсли;
	КонецЕсли;

	Payload.Вставить("has_lamination", ЕстьЛаминация);
	Payload.Вставить("has_embossing",  ЕстьТиснение);
	Payload.Вставить("has_screen",     ЕстьТрафарет);
	Payload.Вставить("has_varnish",    ЕстьЛак);
	Payload.Вставить("has_foil",       ЕстьФольга);

	// ── Рабочий центр ──────────────────────────────────────────────────────
	РабочийЦентр = "";
	Если ЗначениеЗаполнено(ЗаказОбъект.РабочийЦентр) Тогда
		РабочийЦентр = Строка(ЗаказОбъект.РабочийЦентр);
	КонецЕсли;
	Payload.Вставить("work_center", РабочийЦентр);

	// ── Тираж и метраж ─────────────────────────────────────────────────────
	Тираж  = 0;
	Метраж = 0;
	Если ЗаказОбъект.Товары.Количество() > 0 Тогда
		Тираж = ЗаказОбъект.Товары.Итог("Количество");
	КонецЕсли;
	Метраж = ЗаказОбъект.МетражПМ;
	Payload.Вставить("circulation_thousands", Окр(Тираж / 1000, 1));
	Payload.Вставить("linear_meters",         Метраж);

	// ── Цена за 1000 ───────────────────────────────────────────────────────
	ЦенаЗа1000 = 0;
	Если Тираж > 0 И ЗаказОбъект.Товары.Количество() > 0 Тогда
		Сумма      = ЗаказОбъект.Товары.Итог("Сумма");
		ЦенаЗа1000 = Окр((Сумма / Тираж) * 1000, 2);
	КонецЕсли;
	Payload.Вставить("price_per_thousand_eur", ЦенаЗа1000);

	// ── Рентабельность ─────────────────────────────────────────────────────
	Рентабельность = 0;
	Если ЗаказОбъект.СуммаДокумента > 0 И ЗаказОбъект.ДоходПлан <> 0 Тогда
		Рентабельность = Окр((ЗаказОбъект.ДоходПлан / ЗаказОбъект.СуммаДокумента) * 100, 1);
	КонецЕсли;
	Payload.Вставить("profitability_pct", Рентабельность);

	// ── Прочее ─────────────────────────────────────────────────────────────
	Payload.Вставить("production_time_min", ЗаказОбъект.ВремяИзготовления);
	Payload.Вставить("is_repeated_order",   Ложь);
	Payload.Вставить("order_repeat_count",  0);
	Payload.Вставить("is_test_order",       (Тираж < 1000));
	Payload.Вставить("is_posted",           ЗаказОбъект.Проведен);

	// ── Мета-данные об источнике Vision-анализа ────────────────────────────
	ЕстьМакет = ПараметрыМакетаЗаданы(ПараметрыМакета);
	Уверенность = 0;
	Если ЕстьМакет И ПараметрыМакета.Свойство("confidence")
			И ЗначениеЗаполнено(ПараметрыМакета.confidence) Тогда
		Уверенность = ПараметрыМакета.confidence;
	КонецЕсли;
	Payload.Вставить("vision_analyzed",    ЕстьМакет);
	Payload.Вставить("vision_confidence",  Уверенность);

	Возврат Payload;

КонецФункции

