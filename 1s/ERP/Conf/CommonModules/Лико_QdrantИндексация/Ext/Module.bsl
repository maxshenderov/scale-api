// Формирует текст для векторизации из payload заказа
// Параметры:
//   Payload — Структура — результат СформироватьPayloadЗаказа
// Возвращает: Строка
Функция СформироватьТекстДляЭмбеддинга(Payload) Экспорт

	ЧастиТекста = Новый Массив;

	//+Лико m.shenderov 13.05.2026
	// Текст с самой этикетки (самый семантически богатый сигнал — приоритет в начале)
	Если Payload.Свойство("label_text_brand") И ЗначениеЗаполнено(Payload.label_text_brand) Тогда
		ЧастьБренд = Payload.label_text_brand;
		Если Payload.Свойство("label_text_product") И ЗначениеЗаполнено(Payload.label_text_product) Тогда
			ЧастьБренд = ЧастьБренд + " " + Payload.label_text_product;
		КонецЕсли;
		Если Payload.Свойство("label_text_volume") И ЗначениеЗаполнено(Payload.label_text_volume) Тогда
			ЧастьБренд = ЧастьБренд + " " + Payload.label_text_volume;
		КонецЕсли;
		ЧастиТекста.Добавить(СокрЛП(ЧастьБренд));
	ИначеЕсли Payload.Свойство("label_text_product") И ЗначениеЗаполнено(Payload.label_text_product) Тогда
		ЧастиТекста.Добавить(Payload.label_text_product);
	КонецЕсли;
	Если Payload.Свойство("label_text_full") И ЗначениеЗаполнено(Payload.label_text_full) Тогда
		ЧастиТекста.Добавить("Текст этикетки: " + Лев(Payload.label_text_full, 300));
	КонецЕсли;

	// Название + тип продукции (из документа 1С)
	Если ЗначениеЗаполнено(Payload.label_name) Тогда
		ТипПродукции = "";
		Если Payload.Свойство("inferred_product_type") Тогда
			ТипПродукции = Payload.inferred_product_type;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТипПродукции) И ТипПродукции <> "неопределено" Тогда
			ЧастиТекста.Добавить(СтрШаблон("%1 - %2", Payload.label_name, ТипПродукции));
		Иначе
			ЧастиТекста.Добавить(Payload.label_name);
		КонецЕсли;
	КонецЕсли;

	// Технология
	Если ЗначениеЗаполнено(Payload.technology) Тогда
		ЧастиТекста.Добавить(СтрШаблон("%1 печать", Payload.technology));
	КонецЕсли;

	// Тип этикетки
	Если Payload.Свойство("label_type") И ЗначениеЗаполнено(Payload.label_type) Тогда
		ЧастиТекста.Добавить(СтрШаблон("Тип: %1", Payload.label_type));
	КонецЕсли;

	// Форма этикетки
	Если Payload.Свойство("label_shape") И ЗначениеЗаполнено(Payload.label_shape) Тогда
		ЧастиТекста.Добавить(СтрШаблон("Форма: %1", Payload.label_shape));
	КонецЕсли;

	// Цвета
	Если Payload.Свойство("colors") И ТипЗнч(Payload.colors) = Тип("Массив") Тогда
		МассивЦветов = Payload.colors;
		Если МассивЦветов.Количество() > 0 Тогда
			Названия = Новый Массив;
			Для Каждого Цвет Из МассивЦветов Цикл
				Если ЗначениеЗаполнено(Цвет.name) Тогда
					Названия.Добавить(Цвет.name);
				КонецЕсли;
			КонецЦикла;
			Если Названия.Количество() > 0 Тогда
				ЧастиТекста.Добавить(СтрШаблон("Цвета: %1", СтрСоединить(Названия, ", ")));
			КонецЕсли;

			УникТипы = Новый Соответствие;
			Для Каждого Цвет Из МассивЦветов Цикл
				Если ЗначениеЗаполнено(Цвет.type) И Цвет.type <> "vision" Тогда
					УникТипы.Вставить(Цвет.type, Истина);
				КонецЕсли;
			КонецЦикла;
			КлючиТипов = Новый Массив;
			Для Каждого Ключ Из УникТипы Цикл
				КлючиТипов.Добавить(Ключ.Ключ);
			КонецЦикла;
			Если КлючиТипов.Количество() > 0 Тогда
				ЧастиТекста.Добавить(СтрСоединить(КлючиТипов, ", "));
			КонецЕсли;

			ЧастиТекста.Добавить(СтрШаблон("%1 красок", МассивЦветов.Количество()));
		КонецЕсли;
	ИначеЕсли Payload.Свойство("colors_count") И Payload.colors_count > 0 Тогда
		ЧастиТекста.Добавить(СтрШаблон("%1 красок", Payload.colors_count));
	КонецЕсли;

	// Материал
	Если ЗначениеЗаполнено(Payload.material) Тогда
		ЧастиТекста.Добавить(СтрШаблон("Материал: %1", Payload.material));
	КонецЕсли;

	// Отделка
	Если Payload.Свойство("has_lamination") И Payload.has_lamination Тогда
		ЧастиТекста.Добавить("ламинация");
	КонецЕсли;
	Если Payload.Свойство("has_embossing") И Payload.has_embossing Тогда
		ЧастиТекста.Добавить("тиснение");
	КонецЕсли;
	Если Payload.Свойство("has_screen") И Payload.has_screen Тогда
		ЧастиТекста.Добавить("трафарет");
	КонецЕсли;
	Если Payload.Свойство("has_varnish") И Payload.has_varnish Тогда
		ЧастиТекста.Добавить("лак");
	КонецЕсли;
	Если Payload.Свойство("has_foil") И Payload.has_foil Тогда
		ЧастиТекста.Добавить("фольга");
	КонецЕсли;

	// Размер
	Если Payload.size_width_mm > 0 И Payload.size_height_mm > 0 Тогда
		ЧастиТекста.Добавить(СтрШаблон("Размер: %1×%2 мм", Payload.size_width_mm, Payload.size_height_mm));
	КонецЕсли;

	// Раскладка
	Если Payload.Свойство("lanes_print") И Payload.Свойство("labels_per_lane")
			И Payload.lanes_print > 0 И Payload.labels_per_lane > 0 Тогда
		ЧастиТекста.Добавить(СтрШаблон("Раскладка: %1×%2", Payload.lanes_print, Payload.labels_per_lane));
	КонецЕсли;

	// Рабочий центр
	Если ЗначениеЗаполнено(Payload.work_center) Тогда
		ЧастиТекста.Добавить(СтрШаблон("Рабочий центр: %1", Payload.work_center));
	КонецЕсли;

	// Тираж
	Если Payload.circulation_thousands > 0 Тогда
		ЧастиТекста.Добавить(СтрШаблон("Тираж: %1K шт", Payload.circulation_thousands));
	КонецЕсли;

	// Клиент
	Если ЗначениеЗаполнено(Payload.client) Тогда
		ЧастиТекста.Добавить(СтрШаблон("Клиент: %1", Payload.client));
	КонецЕсли;

	Возврат СтрСоединить(ЧастиТекста, ". ");

КонецФункции

