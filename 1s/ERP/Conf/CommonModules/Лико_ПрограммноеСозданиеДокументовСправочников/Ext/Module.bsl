	|	И ДоговорыКонтрагентов.ТипДоговора = Значение(Перечисление.ТипыДоговоров.СПереработчиком)
	|	И ДоговорыКонтрагентов.ВалютаВзаиморасчетов = &Валюта
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДоговорыКонтрагентов.Ссылка,
	|	ДоговорыКонтрагентов.ТипДоговора
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Организация = &Организация
	|	И ДоговорыКонтрагентов.Контрагент = &Контрагент
	|	И ДоговорыКонтрагентов.ТипДоговора = Значение(Перечисление.ТипыДоговоров.СДавальцем)";
	
	
	ОрганизацияЗаказаПереработчика 	=  	Лико_Дополнительно.ПолучитьОрганизациюПоКонтрагенту(Заказ.Контрагент);
	КонтрагентЗаказаПереработчика 	= 	УправлениеСвойствами.ЗначениеСвойства(Заказ.площадка.Организация,"КонтрагентОрганизации_8e3f712fdca94791a890e1aa7853a0d2") ;
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("ОрганизацияЗаказаПереработчика", ОрганизацияЗаказаПереработчика);  
	Запрос.УстановитьПараметр("КонтрагентЗаказаПереработчика", КонтрагентЗаказаПереработчика); 
	Запрос.УстановитьПараметр("Валюта", Заказ.ВалютаДляДокументов);
	Запрос.УстановитьПараметр("Контрагент", Заказ.Контрагент); 
	
	
	Запрос.УстановитьПараметр("Организация", Заказ.площадка.Организация);
	Запрос.УстановитьПараметр("ПлощадкаЛикофлекс", Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра);
	
