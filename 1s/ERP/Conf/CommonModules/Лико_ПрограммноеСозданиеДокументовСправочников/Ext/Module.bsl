

Функция СоздатьРедактироватьЗаказПереработчику(Заказ,МассивДанных,Отказ) Экспорт //+Лико m.shenderov 01.12.2022

	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(МассивДанных) Тогда
		МассивДанных=ПодготовитьДанныеДляПереработкиПоЗаказу(Заказ);
	КонецЕсли;
	
	
	
	
	
	//Заказ Переработчику
	ОрганизацияЗаказаПереработчика =  Лико_Дополнительно.ПолучитьОрганизациюПоКонтрагенту(Заказ.Контрагент);
	ЖелаемаяДатаОтгрузки =  ?(Заказ.датаОтгрузки>=ТекущаяДата(),Заказ.датаОтгрузки,ТекущаяДата()) ;
	
		
	
	Результат =МассивДанных[0].Выбрать();
	Результат.Следующий();
	
	Если  Не ЗначениеЗаполнено(ОрганизацияЗаказаПереработчика) Тогда
		
		Если ЗначениеЗаполнено(Результат.Ссылка) Тогда			
			
			ЗаказПереработчику = Результат.ссылка.ПолучитьОбъект();
			ЗаказПереработчику.ПометкаУдаления=Истина; 
			
			Попытка 
				
				ЗаказПереработчику.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Возврат ЗаказПереработчику.Ссылка;
				
			Исключение
				
				Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось создать заказы давальца и переработчику. Заказ не отправлен в работу. " + ОписаниеОшибки());
				ОтменитьТранзакцию();
				Отказ = Истина;
				Возврат Неопределено;
				
			КонецПопытки;
			
		КонецЕсли;
		
		Возврат Неопределено;
		
	КонецЕсли;
	

	Если ЗначениеЗаполнено(Результат.Ссылка) Тогда 
		ЗаказПереработчику = Результат.ссылка.ПолучитьОбъект();
		ЗаказПереработчику.ПометкаУдаления = Ложь;
	Иначе
		ЗаказПереработчику = Документы.ЗаказПереработчику.СоздатьДокумент();
		ЗаказПереработчику.Дата = Заказ.Дата;
	КонецЕсли;
	стрэт = Заказ.Товары[0];
	АдресПриемки = УправлениеСвойствами.ЗначениеСвойства(ОрганизацияЗаказаПереработчика,"Лико_ЗонаПриемкиСИМ");
	
	ОсновнойСклад =  АдресПриемки.Владелец;

	
	//ОсновнойСклад 								= Справочники.Склады.НайтиПоНаименованию("ЛК Основной");
	ЗаказПереработчику.Организация 				= ОрганизацияЗаказаПереработчика;
	Контрагент 									= УправлениеСвойствами.ЗначениеСвойства(Заказ.Площадка.Организация, Справочники.Лико_ПредопределенныеЗначения.ДопРеквизитОрганизацииКонтрагентОрганизации.ЗначениеПараметра); 	
	ЗаказПереработчику.Партнер 					= Контрагент.Партнер;
	ЗаказПереработчику.Контрагент 				= Контрагент;
	ЗаказПереработчику.ДокументОснование 		= Заказ;
	ЗаказПереработчику.УслугиПоПереработке 		= Перечисления.ВариантыОформленияУслугДокументовПереработки.УказываютсяВЗаказеОтчете;
	ЗаказПереработчику.ГруппировкаЗатрат 		= Перечисления.ГруппировкиЗатратВЗаказеПереработчику.БезГруппировки;
	ЗаказПереработчику.СпособРаспределенияЗатратНаВыходныеИзделия = Перечисления.СпособыРаспределенияЗатратНаВыходныеИзделия.ПоДолямСтоимости;
	ЗаказПереработчику.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.ПроизводствоУПереработчика;
	
	//Договор 									= Справочники.Лико_ПредопределенныеЗначения.ДоговоСПереработчикомЛикофлексИксПак.ЗначениеПараметра;
	Договор										= ПолучитьДоговорПереработки(МассивДанных[4].Выгрузить(),Перечисления.ТипыДоговоров.СПереработчиком);	
	
	ЗаказПереработчику.Договор 					= Договор;
	ЗаказПереработчику.Автор					= Пользователи.ТекущийПользователь();
	ЗаказПереработчику.Валюта 					= Договор.ВалютаВзаиморасчетов;
	ЗаказПереработчику.ЖелаемаяДатаПоступления 	= ЖелаемаяДатаОтгрузки;
	ЗаказПереработчику.ЗакупкаПодДеятельность 	= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	ЗаказПереработчику.Менеджер 				= Заказ.Менеджер;
	ЗаказПереработчику.подразделение 			= УправлениеСвойствами.ЗначениеСвойства(Заказ.Площадка.Организация, Справочники.Лико_ПредопределенныеЗначения.ДопРеквизитОрганизацииПодразделениеПроизводство.ЗначениеПараметра); 	
	ЗаказПереработчику.ПорядокРасчетов 			= Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	ЗаказПереработчику.ОплатаВВалюте 			= Договор.ОплатаВВалюте;
	ЗаказПереработчику.Статус 					= Перечисления.СтатусыЗаказовПереработчикам.КИсполнению;
	ЗаказПереработчику.Приоритет 				= Справочники.Приоритеты.НайтиПоНаименованию("Средний");
	НоменклатураУслуги 							= Справочники.Лико_ПредопределенныеЗначения.НоменклатураУслугиОбработки.ЗначениеПараметра;
	ЗаказПереработчику.Номенклатура 			= НоменклатураУслуги;
	ЗаказПереработчику.ГруппаФинансовогоУчета 	= НоменклатураУслуги.ВидНоменклатуры.ГруппаФинансовогоУчета;
	ЗаказПереработчику.СтатьяКалькуляции 		= Справочники.Лико_ПредопределенныеЗначения.СтатьяУслугиОбработки.ЗначениеПараметра;
	ЗаказПереработчику.СпособДоставки 			= перечисления.СпособыДоставки.Самовывоз;
	ЗаказПереработчику.ВариантПриемкиТоваров 	= Константы.ВариантПриемкиТоваров.Получить(); 
	
	
	ЗаказПереработчику.Материалы.Очистить();
	
	Результат = МассивДанных[2].Выбрать();
	Результат.Следующий();
	стрмат 						= ЗаказПереработчику.Материалы.Добавить();
	стрмат.номенклатура 		= Заказ.ОсновнойМатериал;
	стрмат.характеристика 		= Справочники.ЯССМ_Нарезки.ХарактеристикаПоНарезке(Заказ.Нарезка);
	стрмат.упаковка 			= Заказ.ОсновнойМатериал.ЕдиницаИзмерения;
	стрмат.КоличествоУпаковок 	= Результат.МетражКВМ;
	стрмат.количество 			= Результат.МетражКВМ;
	стрмат.Цена 				= Результат.Цена;
	стрмат.сумма 				= стрэт.КоличествоУпаковок* стрмат.Цена;
	стрмат.Склад 				= ОсновнойСклад;
	стрмат.ВариантОбеспечения 	= Перечисления.ВариантыОбеспечения.КОбеспечению;
	стрмат.СтатьяКалькуляции 	= Справочники.Лико_ПредопределенныеЗначения.СтатьяКалькуляцииПечати.ЗначениеПараметра;
	стрмат.ДатаОтгрузки 		= ЖелаемаяДатаОтгрузки; 
	
	
	ВыборкаДоп = МассивДанных[3].Выбрать();
	Пока ВыборкаДоп.Следующий() Цикл 
		
		стрмат 						= ЗаказПереработчику.Материалы.Добавить();
		стрмат.номенклатура			= ВыборкаДоп.Материал;
		стрмат.характеристика 		= Справочники.ЯССМ_Нарезки.ХарактеристикаПоНарезке(ВыборкаДоп.Нарезка);
		стрмат.упаковка 			= ВыборкаДоп.Материал.ЕдиницаИзмерения;
		стрмат.КоличествоУпаковок 	= Результат.МетражДляРЦ*ВыборкаДоп.НарезкаРазмер/1000;
		стрмат.количество 			= стрмат.КоличествоУпаковок;
		стрмат.Цена 				= ВыборкаДоп.Цена;
		стрмат.сумма 				= стрэт.КоличествоУпаковок* стрмат.Цена;
		стрмат.Склад 				= ОсновнойСклад;
		стрмат.ВариантОбеспечения 	= Перечисления.ВариантыОбеспечения.КОбеспечению;
		стрмат.СтатьяКалькуляции 	= Справочники.Лико_ПредопределенныеЗначения.СтатьяКалькуляцииПечати.ЗначениеПараметра;
		стрмат.ДатаОтгрузки 		= ЖелаемаяДатаОтгрузки;
		
	КонецЦикла;
	
	
	
	ЗаказПереработчику.Продукция.Очистить();
	
	стр 						= ЗаказПереработчику.Продукция.Добавить();
	стр.Номенклатура 			= стрэт.Номенклатура;
	стр.Характеристика 			= стрэт.Характеристика;
	стр.Упаковка 				= стрэт.Упаковка;
	стр.КоличествоУпаковок 		= стрэт.КоличествоУпаковок;
	стр.Количество 				= стрэт.Количество;
	стр.КоличествоУпаковок 		= стрэт.КоличествоУпаковок;
	стр.ДоляСтоимости 			= 1;
	стр.Лико_Втулка 			= стрэт.внутреннийдиаметр;
	стр.ДатаПоступления 		= ЖелаемаяДатаОтгрузки;
	стр.Получатель 				= ОсновнойСклад;//Лико_Дополнительно.НайтиСкладРегиона(Заказ.Регион);
	
	//стр.Лико_КолРоликов = стрэт.;
	
	ЗаказПереработчику.СтавкаНДС 		= стрэт.СтавкаНДС;
	ЗаказПереработчику.СуммаНДС 		= стрэт.СуммаНДС;
	ЗаказПереработчику.Сумма 			= стрэт.Сумма-стрэт.СуммаНДС;		
	ЗаказПереработчику.СуммаСНДС 		= стрэт.СуммаСНДС;
	ЗаказПереработчику.СуммаДокумента 	= стрэт.СуммаСНДС;
	
	ЗаказПереработчику.Услуги.Очистить();
	
	Попытка 
		ЗаказПереработчику.Записать(РежимЗаписиДокумента.Проведение);
		Возврат ЗаказПереработчику.Ссылка;	
	Исключение
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось создать заказы давальца и переработчику. Заказ не отправлен в работу. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		Отказ = Истина;
		Возврат Неопределено;
	КонецПопытки;	
	
КонецФункции //-Лико m.shenderov 01.12.2022 

Функция СоздатьРедактироватьЗаказДавальца(Заказ,МассивДанных,Отказ ) Экспорт //+Лико m.shenderov 01.12.2022
	
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(МассивДанных) Тогда
		МассивДанных=ПодготовитьДанныеДляПереработкиПоЗаказу(Заказ);
	КонецЕсли;
	

	
	ЖелаемаяДатаОтгрузки =  ?(Заказ.датаОтгрузки>=ТекущаяДата(),Заказ.датаОтгрузки,ТекущаяДата()) ;
	НоменклатураУслуги 							= Справочники.Лико_ПредопределенныеЗначения.НоменклатураУслугиОбработки.ЗначениеПараметра;
	
	
	АдресПриемки = УправлениеСвойствами.ЗначениеСвойства(Заказ.площадка.Организация,"Лико_ЗонаПриемкиСИМ");
	
	ОсновнойСклад =  АдресПриемки.Владелец;

	
	//ОсновнойСклад 								= Справочники.Склады.НайтиПоНаименованию("ЛК Основной");

	
	Результат = МассивДанных[1].Выбрать();
	
	Результат.Следующий();
	Если ЗначениеЗаполнено(Результат.Ссылка) Тогда 
		ЗаказДавальца = Результат.ссылка.ПолучитьОбъект();
		ЗаказДавальца.ПометкаУдаления = ЛОжь;
	Иначе
		ЗаказДавальца = Документы.ЗаказДавальца.СоздатьДокумент();
		ЗаказДавальца.Лико_ЗаказКлиента = Заказ;
		ЗаказДавальца.Дата = Заказ.Дата;
	КонецЕсли;
	
	ЗаказДавальца.автор 							= Пользователи.ТекущийПользователь();
	ЗаказДавальца.Партнер 							= Заказ.Партнер;
	ЗаказДавальца.Контрагент 						= Заказ.Контрагент;
	ЗаказДавальца.Организация 						= Заказ.площадка.Организация;
	ЗаказДавальца.склад 							= ОсновнойСклад;
	ЗаказДавальца.складПоступления 					= ОсновнойСклад;
	//ДоговорДавальца 								= НайтиСоздатьДоговорПереработчикаДавальца(Заказ.площадка, Заказ.Контрагент, Перечисления.ТипыДоговоров.СДавальцем);  
	ДоговорДавальца									= ПолучитьДоговорПереработки(МассивДанных[4].Выгрузить(),Перечисления.ТипыДоговоров.СДавальцем);
	ЗаказДавальца.Договор 							= ДоговорДавальца;
	ЗаказДавальца.Валюта 							= ДоговорДавальца.ВалютаВзаиморасчетов;
	ЗаказДавальца.Менеджер 							= Заказ.Менеджер;
	ЗаказДавальца.ЦенаВключаетНДС 					= Заказ.ЦенаВключаетНДС;
	ЗаказДавальца.Статус 							= Перечисления.СтатусыЗаказовДавальцев.КПроизводству;
	ЗаказДавальца.ЖелаемаяДатаПоступления 			= ЖелаемаяДатаОтгрузки;
	ЗаказДавальца.согласован 						= Истина;
	ЗаказДавальца.ХозяйственнаяОперация 			= Перечисления.ХозяйственныеОперации.ПроизводствоИзДавальческогоСырья;
	ЗаказДавальца.Номенклатура 						= НоменклатураУслуги;
	ЗаказДавальца.ГруппаФинансовогоУчета  			= НоменклатураУслуги.ВидНоменклатуры.ГруппаФинансовогоУчета;
	ЗаказДавальца.приоритет 						= Справочники.Приоритеты.НайтиПоНаименованию("Средний");
	ЗаказДавальца.СпособДоставки 					= перечисления.СпособыДоставки.Самовывоз;
	ЗаказДавальца.подразделение 					= УправлениеСвойствами.ЗначениеСвойства(Заказ.Площадка.Организация, Справочники.Лико_ПредопределенныеЗначения.ДопРеквизитОрганизацииПодразделениеПроизводство.ЗначениеПараметра); 	
	ЗаказДавальца.ТипПроизводственногоПроцесса 		= Перечисления.ТипыПроизводственныхПроцессов.Сборка;
	ЗаказДавальца.НалогообложениеНДС 				= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	ЗаказДавальца.Содержание 						= "Изготовление полуфабриката из материала заказчика";
	ЗаказДавальца.ВариантПриемкиТоваров 			= Перечисления.ВариантыПриемкиТоваров.МожетПроисходитьБезЗаказовИНакладных;
	ЗаказДавальца.УправлениеПроизводством2_2 		= Истина;
	
	стрэт = Заказ.Товары[0];
	ЗаказДавальца.ставкаНДС = стрЭт.СтавкаНДС;
	
	
	ЗаказДавальца.Материалы.Очистить(); 
	
	Результат = МассивДанных[2].Выбрать();
	Результат.Следующий();

	
	стрмат 						= ЗаказДавальца.Материалы.Добавить();
	стрмат.номенклатура 		= Заказ.ОсновнойМатериал;
	стрмат.характеристика 		= Справочники.ЯССМ_Нарезки.ХарактеристикаПоНарезке(Заказ.Нарезка);
	//стрмат.упаковка 			= Справочники.ЯССМ_Нарезки.УпаковкаПоНарезке(Заказ.Нарезка);
	стрмат.КоличествоУпаковок 	= Результат.МетражКВМ;
	стрмат.количество 			= Результат.МетражКВМ;
	стрмат.Цена 				= Результат.Цена;
	стрмат.сумма 				= стрэт.КоличествоУпаковок* стрмат.Цена;
	стрмат.Склад 				= ОсновнойСклад;
	стрмат.ДатаПоступления      = ЖелаемаяДатаОтгрузки;
	
	
	
	ВыборкаДоп = МассивДанных[3].Выбрать();
	Пока ВыборкаДоп.Следующий() Цикл
		
		стрмат 								= ЗаказДавальца.Материалы.Добавить();
		стрмат.номенклатура 				= ВыборкаДоп.Материал;
		стрмат.характеристика 				= Справочники.ЯССМ_Нарезки.ХарактеристикаПоНарезке(ВыборкаДоп.Нарезка);
		стрмат.упаковка 					= стрмат.упаковка 	= ВыборкаДоп.Материал.ЕдиницаИзмерения;
		стрмат.КоличествоУпаковок 			= Результат.МетражДляРЦ*ВыборкаДоп.НарезкаРазмер/1000;
		стрмат.количество 					= стрмат.КоличествоУпаковок;
		стрмат.Цена 						= ВыборкаДоп.Цена;
		стрмат.сумма 						= стрэт.КоличествоУпаковок* стрмат.Цена;
		стрмат.Склад 						= ОсновнойСклад;
		стрмат.ДатаПоступления 				= ЖелаемаяДатаОтгрузки;
	КонецЦикла;
	
	
	
	
	ЗаказДавальца.Продукция.Очистить();
	
	стр 								= ЗаказДавальца.Продукция.Добавить();
	стр.Номенклатура 					= стрэт.Номенклатура;
	стр.Характеристика 					= стрэт.Характеристика;
	стр.Упаковка 						= стрэт.Упаковка;
	стр.КоличествоУпаковок 				= стрэт.КоличествоУпаковок;
	стр.Количество 						= стрэт.Количество;
	стр.КоличествоУпаковок 				= стрэт.КоличествоУпаковок;
	стр.ДатаОтгрузки 					= ЖелаемаяДатаОтгрузки;
	стр.склад 							= ЗаказДавальца.склад;
	стр.ВариантОбеспечения 				= Перечисления.ВариантыОбеспечения.НеТребуется;
	стр.Цена 							= стрэт.цена;
	стр.СуммаСобственныхМатериалов 		= 0;//стрмат.сумма;
	стр.суммауслуги 					= стрэт.Сумма;
	стр.сумма 							= стр.СуммаСобственныхМатериалов+стр.суммауслуги;
	стр.СуммаНДС  						= стрэт.СуммаНДС;
	стр.СуммаСНДС 						= стрэт.СуммаСНДС;
	
	
	
	ЗаказДавальца.СуммаДокумента =стр.СуммаСНДС;
	
	Попытка 
		ЗаказДавальца.Записать(РежимЗаписиДокумента.Проведение);
		Возврат ЗаказДавальца.Ссылка; 
	Исключение
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось создать заказы давальца и переработчику. Заказ не отправлен в работу. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		Отказ = Истина;
		Возврат Неопределено;
	КонецПопытки;	
	
	
	
КонецФункции //-Лико m.shenderov 01.12.2022 

Функция СоздатьРедактироватьЗаказНаПроизводство(Заказ,ЗаказДавальца,Отказ) Экспорт  //+Лико m.shenderov 01.12.2022
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли; 
			
	
	//Проверяем, есть ли Заказ на производство
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаПроизводство2_2.Ссылка КАК ЗаказНаПроизводство
	|ИЗ
	|	Документ.ЗаказНаПроизводство2_2 КАК ЗаказНаПроизводство2_2
	|ГДЕ
	|	ЗаказНаПроизводство2_2.ДокументОснование = &Заказ";
	Запрос.УстановитьПараметр("Заказ", ЗаказДавальца.Ссылка);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	
	Если  ЗначениеЗаполнено(Результат.ЗаказНаПроизводство) Тогда 
		ЗаказПрОбъект = Результат.ЗаказНаПроизводство.ПолучитьОбъект();
	Иначе
		ЗаказПРОбъект = Документы.ЗаказНаПроизводство2_2.СоздатьДокумент();
	КонецЕсли;
	
	Лико_Планирование.ЗаполнитьПоЗаказуКлиента(ЗаказПрОбъект, Заказ, ЗаказДавальца.ссылка);
	
	Если Не Отказ Тогда 
		Возврат ЗаказПрОбъект.Ссылка;
	Иначе 
		Возврат  Неопределено;
	КонецЕсли;
	
КонецФункции //-Лико m.shenderov 01.12.2022 



Функция ПолучитьДоговорПереработки(ТзДоговоров,ТипДоговора) //+Лико m.shenderov 11.12.2022
	
	
	стрДоговора=ТзДоговоров.Найти(ТипДоговора,"ТипДоговора");
	Если стрДоговора<>Неопределено Тогда
		 Возврат стрДоговора.Ссылка;
	КонецЕсли;

КонецФункции //-Лико m.shenderov 11.12.2022 

 Функция ПодготовитьДанныеДляПереработкиПоЗаказу(Заказ) //+Лико m.shenderov 01.12.2022
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПереработчику.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПереработчику КАК ЗаказПереработчику
	|ГДЕ
	|	ЗаказПереработчику.ДокументОснование = &Заказ
	//|	И ЗаказПереработчику.Организация = &ОрганизацияПереработчика		
	|;
	|
	|//////////////////////////////////////////////////////////////////////////////// 
	|ВЫБРАТЬ
