Функция РассчитатьКВМ(ШТКВМ, МетражКВМ, КоличествоОбщее)	Экспорт

	Если МетражКВМ = 0 Тогда
		Возврат 0;
	Иначе
		Если ШТКВМ <> Окр(КоличествоОбщее/МетражКВМ,8) Тогда 
			Возврат Окр(КоличествоОбщее/МетражКВМ,8) 
		КонецЕсли;
	КонецЕсли;

