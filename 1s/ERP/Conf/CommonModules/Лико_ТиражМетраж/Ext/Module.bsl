Функция РасчетКоличестваПеремотки(Заказ, ВидВырубки = 0, ИскатьВидВырубки = Истина, СпецификацияСсылка = Неопределено) Экспорт // --> Начало Лико Митюшин МФМ 29.04.2021
	
	Если ИскатьВидВырубки Тогда
		ВидВырубки = Лико_ТиражМетраж.ПолучитьВидВырубки(Заказ, СпецификацияСсылка); 
	КонецЕсли;
	
	Если ВидВырубки = 0 ИЛИ ВидВырубки = 4 Тогда 
		Возврат 0;		
	ИначеЕсли ВидВырубки = 1 ИЛИ ВидВырубки = 13 Тогда 
		Если Заказ.ДлинаПечати = 0 ИЛИ Заказ.ЭтикетокНаЛистеПечати = 0 ИЛИ Заказ.РучьиПечати = 0 Тогда 
			Возврат 0;
		Иначе 
			Возврат Заказ.ДлинаПечати / (Заказ.ЭтикетокНаЛистеПечати / Заказ.РучьиПечати);
		КонецЕсли;
	ИначеЕсли ВидВырубки = 2 ИЛИ ВидВырубки = 3 ИЛИ ВидВырубки = 7 ИЛИ ВидВырубки = 8 ИЛИ ВидВырубки = 11 ИЛИ ВидВырубки = 14 ИЛИ ВидВырубки = 15 Тогда
		Если Заказ.ШагПечати = 0 ИЛИ Заказ.ЭтикетокНаЛисте = 0 ИЛИ Заказ.Ручьи = 0 Тогда 
			Возврат 0;
		Иначе 
			Возврат Заказ.ШагПечати / (Заказ.ЭтикетокНаЛисте / Заказ.Ручьи);
		КонецЕсли;
	ИначеЕсли ВидВырубки = 5 ИЛИ ВидВырубки = 6 ИЛИ ВидВырубки = 18 ИЛИ ВидВырубки = 19 Тогда 
		Возврат ПолучитьДлиннуИлиШиринуЭтикетки(Заказ, СпецификацияСсылка) * 0.001;
	Иначе 
		Возврат Заказ.ЭтМЭР; 	
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Митюшин МФМ 29.04.2021

Функция ИзменитьПриСменеВидаВырубки(Заказ, ПересчитыватьМетраж = Истина, ПересчитатьПоля = Ложь, СпецификацияСсылка = Неопределено) Экспорт
	текВидВырубки = ПолучитьВидВырубки(Заказ, СпецификацияСсылка);
	текБылиИзменения = Ложь;
	Если текВидВырубки <> Заказ.ВидВырубки ИЛИ ПересчитатьПоля Тогда 
		Заказ.ВидВырубки = текВидВырубки;
		текБылиИзменения = ПроверкаИзмененияВидВырубки(Заказ, ПересчитыватьМетраж);
	КонецЕсли;
	
	Возврат текБылиИзменения;
КонецФункции

Функция ПроверкаИзмененияВидВырубки(Заказ, ПересчитыватьМетраж = Истина) Экспорт
	// --> Начало Лико Митюшин МФМ 19.05.2021
	текБылиИзменения = Ложь;
	
	текЭтикетокНаЛистеПечати =  Лико_ТиражМетраж.ПолучитьЭтикетокНаЛистеПечати(Заказ, Заказ.ВидВырубки);
	Если текЭтикетокНаЛистеПечати <> Заказ.ЭтикетокНаЛистеПечати Тогда
		Заказ.ЭтикетокНаЛистеПечати 	= текЭтикетокНаЛистеПечати;
		текБылиИзменения = Истина;
	КонецЕсли;
	
	текДлинаПечати = Лико_ТиражМетраж.ПолучитьДлинуПечати(Заказ, Заказ.ВидВырубки);
	Если текДлинаПечати <> Заказ.ДлинаПечати Тогда
		Заказ.ДлинаПечати 				= текДлинаПечати;
		текБылиИзменения = Истина;
	КонецЕсли;
	
	Возврат текБылиИзменения;
	// <-- Конец Лико Митюшин МФМ 19.05.2021
КонецФункции

Функция ПолучитьПлощадьКлише(Заказ, ВидВырубки = 0, СпецификацияСсылка = Неопределено) Экспорт
	
	//Заказ.Z.КоличествоЗубьев
	Если ВидВырубки = 0 Тогда
		Если ЗначениеЗаполнено(Заказ.Z) Тогда
			Возврат ((Заказ.Z.КоличествоЗубьев*3.175*0.1) + 2)*(Заказ.Нарезка.Размер/10 + 2);
		Иначе
			Возврат (Заказ.ШагПечати*100+ 2)*(Заказ.Нарезка.Размер/10 + 2); 	
		КонецЕсли;
	ИначеЕсли ВидВырубки = 2 ИЛИ ВидВырубки = 8 ИЛИ ВидВырубки = 15 Тогда
		Возврат (Заказ.ШагПечати*100 + 2)*(Заказ.Нарезка.Размер/10 + 2);
	Иначе 	
		Возврат (Заказ.ДлинаПечати*100 + 2)*(Заказ.Нарезка.Размер/10 + 2);	
	КонецЕсли;
	
	Возврат 0;
	
