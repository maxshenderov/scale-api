Функция ЭтоПечатьНаИндиго(Заказ, текВидПечать = 0) Экспорт
	
	текПараметрыОтбораПечать = Новый Структура;
	текПараметрыОтбораПечать.Вставить("ВидРабот",  Справочники.ВидыРаботСотрудников.Печать);
	//текПараметрыОтбораПечать.Вставить("НомерПроката", 1);
	текПараметрыОтбораПечать.Вставить("НомерВарианта", 1);

	текНайденныеСтрокиПечать = Заказ.ВидыРабот.НайтиСтроки(текПараметрыОтбораПечать);
	Если текНайденныеСтрокиПечать.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	ВидРЦIndigo 	= Справочники.ВидыРабочихЦентров.Indigo;
	Для Каждого текСтрокаПечати из текНайденныеСтрокиПечать Цикл
		Если ВидРЦIndigo = текСтрокаПечати.РабочийЦентр.ВидРабочегоЦентра Тогда
			Возврат Истина;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьЭтикетокНаЛистеИндиго(Заказ, текВидВырубки, СпецификацияСсылка = Неопределено) Экспорт
	
	// <-- Начало Лико Яцун С. В. 13.06.2023
	//Если текВидВырубки = 2 ИЛИ текВидВырубки = 6 ИЛИ текВидВырубки = 9 ИЛИ текВидВырубки = 12 Тогда 
	Если текВидВырубки = 2 ИЛИ текВидВырубки = 6 ИЛИ текВидВырубки = 9 ИЛИ текВидВырубки = 12 Тогда 
	// <-- Конец Лико Яцун С. В. 13.06.2023	
		Возврат Заказ.КоличествоЭтПоДлинеПечатиИндиго * Заказ.РучьиПечатиИндиго;
	ИначеЕсли текВидВырубки = 10 Тогда 
		Возврат ?(Заказ.Ручьи = 0, 0, Заказ.КоличествоШтамповПоДлинеПечатиИндиго * Заказ.ЭтикетокНаЛисте *  Заказ.РучьиПечатиИндиго / Заказ.Ручьи);	
	КонецЕсли;                                                                                                       

	Возврат 0;
КонецФункции

Функция ПолучитьЭтикетокПоДлинеПечатиИндиго(Заказ, текВидВырубки, СпецификацияСсылка = Неопределено) Экспорт
	
	Если текВидВырубки = 2 ИЛИ текВидВырубки = 6 ИЛИ текВидВырубки = 9 ИЛИ текВидВырубки = 12 Тогда 
		Если НЕ ЭтоТермоусадка(Заказ, СпецификацияСсылка) И текВидВырубки = 6 Тогда 
			текКоэфДеления = ?(ЭтоКомлект(Заказ, СпецификацияСсылка), 0.5, 1);
		Иначе
			текКоэфДеления = 1;
		КонецЕсли;
		Возврат ?(Заказ.ЭтМЭР = 0, 0, Цел(0.98 / Заказ.ЭтМЭР)*текКоэфДеления);			
	КонецЕсли;	
		
КонецФункции

Функция ПолучитьZ(Заказ, текВидВырубки, СпецификацияСсылка = Неопределено) Экспорт
	
	Если текВидВырубки = 4 ИЛИ текВидВырубки = 5 ИЛИ текВидВырубки = 11 ИЛИ текВидВырубки = 12 Тогда 
		текЗ = Заказ.ДлинаПечати/3.175*1000;
		Разница = Цел(текЗ) - текЗ;
		Если Не (Макс(Разница, -Разница) > 0.001) Тогда
 			Возврат Справочники.Лико_ZКоличествоЗубьев.НайтиПоРеквизиту("КоличествоЗубьев", Цел(текЗ));
		КонецЕсли;
	КонецЕсли;	
	
КонецФункции

