	//	НайденныеСтроки = ДокОбъект.ЗаказыНаОтгрузку.НайтиСтроки(Отбор);
	//КонецЕсли;
	//Если НайденныеСтроки.Количество() = 0 Тогда
	//	// Попробуем убрать намотку
	//	Отбор.Удалить("Намотка");
	//	НайденныеСтроки = ДокОбъект.ЗаказыНаОтгрузку.НайтиСтроки(Отбор);
	//КонецЕсли;
	//Если НайденныеСтроки.Количество() = 0 Тогда
	//	// Попробуем убрать КодЭтикеткиЗаказчика
	//	Отбор.Удалить("КодЭтикеткиЗаказчика");
	//	НайденныеСтроки = ДокОбъект.ЗаказыНаОтгрузку.НайтиСтроки(Отбор);
	//КонецЕсли;
	//Если НайденныеСтроки.Количество() = 0 Тогда
	//	// Попробуем убрать НомерПоставки
	//	Отбор.Удалить("НомерПоставки");
	//	НайденныеСтроки = ДокОбъект.ЗаказыНаОтгрузку.НайтиСтроки(Отбор);
	//КонецЕсли;
	
	НоваяСтрока = ДокОбъект.Продукция.Добавить();
