Функция СформироватьОснованиеРеализацииПоДоговору(Договор, Дата, БезСчета = Ложь) Экспорт // --> Начало Лико Ефимов ЕВВ 26.10.2017
	
	СтруктураОснования = Новый Структура("ТекстОснования,Номер,Дата");
	РеальныйДоговор = Неопределено;
	
	Если ЗначениеЗаполнено(Договор.Лико_СсылкаНаРеальныйДоговор) Тогда
		РеальныйДоговор = Договор.Лико_СсылкаНаРеальныйДоговор;
	Иначе
		// Попробуем найти реальный договор по периоду действия
		РеальныйДоговор = НайтиРеальныйДоговор(Договор.Организация, Договор.Контрагент, Дата, Договор.ВалютаВзаиморасчетов);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтруктураОснования, Договор);
	Если ЗначениеЗаполнено(РеальныйДоговор) Тогда
		СтруктураОснования.ТекстОснования = РеальныйДоговор.Наименование +
		?(БезСчета, "", " | СЧ" + Договор.Номер + " от " + Формат(Договор.Дата, "ДЛФ=DD"));
		СтруктураОснования.Номер = РеальныйДоговор.Номер;
		СтруктураОснования.Дата = РеальныйДоговор.Дата;
	Иначе
		СтруктураОснования.ТекстОснования = "СЧ" + Договор.Номер + ?(БезСчета, "", " от " + Формат(Договор.Дата, "ДЛФ=DD"));
	КонецЕсли;
	
	// --> Начало Лико Ефимов ЕВВ 27.01.2020
	Если Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(,Договор.Партнер,"ДобавлятьВОснованиеДляПечатиНомерКонтракта_394daa6d0633429fa5765738cd882580", Ложь) Тогда
		ДлинаНомераЗаказа = Метаданные.Документы.ЗаказКлиента.Реквизиты.НомерБезПрефикса.Тип.КвалификаторыСтроки.Длина;
		НомерДоговора = СокрЛП(Договор.Номер);
		Если СтрДлина(НомерДоговора) > ДлинаНомераЗаказа Тогда
			НомерДоговора = Лев(НомерДоговора, ДлинаНомераЗаказа);
		КонецЕсли;
		ЗаказСсылка = Документы.ЗаказКлиента.НайтиПоРеквизиту("НомерБезПрефикса", НомерДоговора);
		Если ЗначениеЗаполнено(ЗаказСсылка) И ЗаказСсылка.Товары.Количество() > 0 И ЗначениеЗаполнено(ЗаказСсылка.Товары[0].NКонтракта) Тогда
			СтруктураОснования.ТекстОснования = СтруктураОснования.ТекстОснования + " | " + ЗаказСсылка.Товары[0].NКонтракта;
		КонецЕсли;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 27.01.2020
	
	Возврат СтруктураОснования;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 26.10.2017

Функция НайтиРеальныйДоговор(Организация, Контрагент, Дата, Валюта = Неопределено) Экспорт // --> Начало Лико Ефимов ЕВВ 15.11.2018
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
	|	И ДоговорыКонтрагентов.Организация = &Организация
	|	И ДоговорыКонтрагентов.Контрагент = &Контрагент
	|	И ДоговорыКонтрагентов.ДатаНачалаДействия <= &Дата
	|	И ВЫБОР
	|			КОГДА ДоговорыКонтрагентов.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ДоговорыКонтрагентов.ДатаОкончанияДействия >= &Дата
	|		КОНЕЦ
	|	И ДоговорыКонтрагентов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует)
	|	И ДоговорыКонтрагентов.Лико_ЭтоРеальныйДоговор
	|	И ВЫБОР
	|			КОГДА &Валюта = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ДоговорыКонтрагентов.ВалютаВзаиморасчетов = &Валюта
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорыКонтрагентов.Дата УБЫВ,
	|	ДоговорыКонтрагентов.ДатаОкончанияДействия УБЫВ,
	|	ДоговорыКонтрагентов.ДатаНачалаДействия УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	ИначеЕсли ЗначениеЗаполнено(Валюта) Тогда
		// Обнулим валюту и выполним запрос еще раз
		Запрос.УстановитьПараметр("Валюта", Неопределено);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Иначе		
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 15.11.2018

Функция ТаблицаВМассивСтруктур(ТаблицаЗначений) Экспорт // --> Начало Лико Ефимов ЕВВ 21.11.2017 
	
	Результат = Новый Массив;
	
	ИменаКолонок = "";
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		ИменаКолонок = ИменаКолонок + "," + Колонка.Имя;
	КонецЦикла;
	ИменаКолонок = Сред(ИменаКолонок, 2);
	
	Для Каждого Строка Из ТаблицаЗначений Цикл
		СтруктураСтроки = Новый Структура(ИменаКолонок);
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, Строка);
		Результат.Добавить(СтруктураСтроки);
	КонецЦикла;
	
	Возврат Результат;
	
