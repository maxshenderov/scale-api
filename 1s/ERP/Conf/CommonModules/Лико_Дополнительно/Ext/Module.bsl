Функция ПроверитьИспользованиеСерийНаТачпаде(МассивПроверяемыхСерий, ВернутьСтруктуруСерийСРЦ = Ложь) Экспорт // --> Начало Лико Ефимов ЕВВ 24.10.2019 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_БланкЭтапа.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_СлужебныеБланкиВРаботе
	|ИЗ
	|	Документ.Лико_БланкЭтапа КАК Лико_БланкЭтапа
	|ГДЕ
	|	Лико_БланкЭтапа.Дата >= &ДатаНачалаПроверки
	|	И НЕ Лико_БланкЭтапа.ПометкаУдаления
	|	И НЕ Лико_БланкЭтапа.Проведен
	|	И Лико_БланкЭтапа.ЭтоСлужебныйДокументДляТачпадов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_БланкЭтапаТовары.Серия КАК Серия,
	|	МАКСИМУМ(Лико_БланкЭтапаТовары.Ссылка.РабочийЦентр) КАК РЦ
	|ИЗ
	|	ВТ_СлужебныеБланкиВРаботе КАК ВТ_СлужебныеБланкиВРаботе
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
	|		ПО ВТ_СлужебныеБланкиВРаботе.Ссылка = Лико_БланкЭтапаТовары.Ссылка
	|			И (Лико_БланкЭтапаТовары.Списать)
	|			И (Лико_БланкЭтапаТовары.Серия В (&МассивПроверяемыхСерий))
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_БланкЭтапаТовары.Серия";
	
	Запрос.УстановитьПараметр("МассивПроверяемыхСерий", МассивПроверяемыхСерий);
	Запрос.УстановитьПараметр("ДатаНачалаПроверки", ТекущаяДата() - 30*86400); // последние 30 дней
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивСерийВРаботе = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВернутьСтруктуруСерийСРЦ Тогда
			МассивСерийВРаботе.Добавить(Новый Структура("Серия,РЦ", ВыборкаДетальныеЗаписи.Серия, ВыборкаДетальныеЗаписи.РЦ));
		Иначе
			МассивСерийВРаботе.Добавить(ВыборкаДетальныеЗаписи.Серия);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивСерийВРаботе;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 24.10.2019 

Процедура ЗакрытьЭтапыИЗаказ(Заказ, Дата, УбиратьИзПлана = Истина) Экспорт// --> Начало Лико Ефимов ЕВВ 08.01.2018
	
	УстановитьПривилегированныйРежим(Истина);
	// Сначала закроем все этапы
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭтапПроизводства2_2.Ссылка КАК Ссылка,
	|	ЭтапПроизводства2_2.Статус КАК СтатусЭтапа,
	|	ЕСТЬNULL(ПооперационноеРасписание2_2.Этап, НЕОПРЕДЕЛЕНО) КАК Этап,
	|	ПооперационноеРасписание2_2.Операция КАК Операция,
	|	ПооперационноеРасписание2_2.ИдентификаторОперации КАК ИдентификаторОперации,
	|	ПооперационноеРасписание2_2.НомерПартии КАК НомерПартии,
	|	ПооперационноеРасписание2_2.РабочийЦентр КАК РабочийЦентр,
	|	ПооперационноеРасписание2_2.МодельРасписания КАК МодельРасписания,
	|	ПооперационноеРасписание2_2.МодельПланирования КАК МодельПланирования,
	|	ПооперационноеРасписание2_2.ЭтоУдалениеОперации КАК ЭтоУдалениеОперации,
	|	ПооперационноеРасписание2_2.Начало КАК Начало,
	|	ПооперационноеРасписание2_2.Окончание КАК Окончание,
	|	ПооперационноеРасписание2_2.ТактПараллельнойЗагрузки КАК ТактПараллельнойЗагрузки,
	|	ПооперационноеРасписание2_2.Моделирование КАК Моделирование
	|ИЗ
	|	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2
	|		ПО ЭтапПроизводства2_2.Ссылка = ПооперационноеРасписание2_2.Этап
	|			И (НЕ ПооперационноеРасписание2_2.ЭтоУдалениеОперации)
	|			И (ПооперационноеРасписание2_2.Выполнено = 0)
	|ГДЕ
	|	ЭтапПроизводства2_2.Лико_ЗаказКлиента = &ДокументОснование
	|	И ЭтапПроизводства2_2.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Завершен)
	|	И НЕ ЭтапПроизводства2_2.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ДокументОснование", Заказ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.СтатусЭтапа <> Перечисления.СтатусыЭтаповПроизводства2_2.Завершен Тогда
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Этап) И НЕ УбиратьИзПлана Тогда
				// Этап еще стоит в плане, и убирать его оттуда не нужно, поэтому и статус менять у него не будем
				Продолжить;
			КонецЕсли;
			ЭтапОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ЭтапОбъект.Статус = Перечисления.СтатусыЭтаповПроизводства2_2.Завершен;
			МассивСтрокДляУдаления = ЭтапОбъект.ВыходныеИзделия.НайтиСтроки(Новый Структура("Произведено", Ложь));
			Для каждого Строка из МассивСтрокДляУдаления Цикл
				ЭтапОбъект.ВыходныеИзделия.Удалить(Строка);
			КонецЦикла;
			Попытка
				ЭтапОбъект.Записать();
			Исключение
				Сообщить("Не удалось изменить статус документа """ + ЭтапОбъект + """ на ""Завершен"": " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Этап) Тогда
			Лико_Дополнительно.ОтметитьВыполнениеЭтапаПлана(ВыборкаДетальныеЗаписи);
		КонецЕсли;
	КонецЦикла;
	
	Если Заказ.ДатаЗакрытия <> Дата ИЛИ Заказ.Статус <> Перечисления.СтатусыЗаказовКлиентов.Закрыт ИЛИ Заказ.Состояние <> Перечисления.Лико_СостоянияЗаказов.Закрыт Тогда
		ЗаказОбъект = Заказ.ПолучитьОбъект();
		ЗаказОбъект.ДатаЗакрытия = Дата;
		ЗаказОбъект.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт;
		ЗаказОбъект.Состояние = Перечисления.Лико_СостоянияЗаказов.Закрыт;
		Попытка
			ЗаказОбъект.Записать();
		Исключение
			Сообщить("Не удалось изменить статус документа """ + ЗаказОбъект + """ на ""Завершен"": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 08.01.2018

Функция ПолучитьМатериалыДляБиркиЧерезСлэш (Заказ,ИспользоватьАльтернативноеНаименованиеМатериалаДляСертификата = Ложь) Экспорт
	
	// --> Начало Лико Ефимов ЕВВ 06.11.2020  Функцию писала Ольга Пухова для обработки Выпуск продукции. Перенес сюда, т.к. использую ее в паспорте качества для ИксПак
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 
	//ПЕРВЫЕ 2 Убрал по согласованию с Анной
	|	ВЫБОР
	|		КОГДА ЗаказКлиентаВидыРабот.Материал ССЫЛКА Справочник.Номенклатура
	|			ТОГДА ЗаказКлиентаВидыРабот.Материал.ЦеноваяГруппа.Лико_НаименованиеДляБирки
	|		ИНАЧЕ ЗаказКлиентаВидыРабот.Материал.Лико_НаименованиеДляБирки
	|	КОНЕЦ КАК Материал,
	|	ЗаказКлиентаВидыРабот.Ссылка.АльтернативноеНаименованиеМатериалаДляСертификата КАК АльтернативноеНаименованиеМатериала
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	НЕ ЗаказКлиентаВидыРабот.Материал ЕСТЬ NULL
	|	И ЗаказКлиентаВидыРабот.Материал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И ЗаказКлиентаВидыРабот.Материал <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка) 
	// --> Начало Лико Ефимов ЕВВ 17.07.2023
	// Почему-то на ТЧ Цвета незаполненных материал - неопределено, а не NULL. Хотя может быть на ВидыРабот было также, просто Оля зря проверяла на NULL
	|	И ЗаказКлиентаВидыРабот.Материал <> НЕОПРЕДЕЛЕНО
	// <-- Конец Лико Ефимов ЕВВ 17.07.2023
	|	И ЗаказКлиентаВидыРабот.Ссылка = &Заказ";
		
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Результат = Запрос.Выполнить().Выгрузить();
	СтрокаМатериалов = ?(ИспользоватьАльтернативноеНаименованиеМатериалаДляСертификата И ЗначениеЗаполнено(Заказ.АльтернативноеНаименованиеМатериалаДляСертификата),Заказ.АльтернативноеНаименованиеМатериалаДляСертификата,
	?(ТипЗнч(Заказ.ОсновнойМатериал) = Тип("СправочникСсылка.Номенклатура"),Заказ.ОсновнойМатериал.ЦеноваяГруппа.Лико_НаименованиеДляБирки,Заказ.ОсновнойМатериал.Лико_НаименованиеДляБирки)) + ?(Результат.Количество() = 0, ""," / "); //Нужно будет поменять наименование на необходимый реквизит
	ИдПоследнейСтроки = Результат.Количество() - 1;
	Для каждого СтрМатериал Из Результат Цикл
		Если Результат.Индекс(СтрМатериал) < ИдПоследнейСтроки Тогда 
			СтрокаМатериалов = СтрокаМатериалов + СтрМатериал.Материал + "/ ";
		Иначе
			СтрокаМатериалов = СтрокаМатериалов + СтрМатериал.Материал;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрокаМатериалов;
	
КонецФункции

Процедура ЗаписатьДопРеквизитВОбъект(Ссылка, ИмяДопРеквизита, Значение) Экспорт // --> Начало Лико Ефимов ЕВВ 12.04.2021
	
	УстановитьПривилегированныйРежим(Истина);
	
