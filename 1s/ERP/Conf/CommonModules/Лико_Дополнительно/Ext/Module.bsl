		ЗакрытиеБланкаОбъект.Записать(?(ЗакрытиеБланкаОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
		ЗафиксироватьТранзакцию();
	Исключение
		Попытка
		ЗакрытиеБланкаОбъект =  ЗакрытиеБланкаСсылка.ПолучитьОбъект();
		ЗакрытиеБланкаОбъект.ДатаПроведенияПоОбязательнымРегистрам = Неопределено;
		ЗакрытиеБланкаОбъект.ДополнительныеСвойства.Вставить("ЭтоТачПадРЦ");
		ЗакрытиеБланкаОбъект.Записать(?(ЗакрытиеБланкаОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
		ЗафиксироватьТранзакцию();
		Исключение
			Попытка
		ЗакрытиеБланкаОбъект =  ЗакрытиеБланкаСсылка.ПолучитьОбъект();
		ЗакрытиеБланкаОбъект.ДатаПроведенияПоОбязательнымРегистрам = Неопределено;
		ЗакрытиеБланкаОбъект.ДополнительныеСвойства.Вставить("ЭтоТачПадРЦ");
		ЗакрытиеБланкаОбъект.Записать(?(ЗакрытиеБланкаОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
		ЗафиксироватьТранзакцию();
			Исключение
				Попытка
		ЗакрытиеБланкаОбъект =  ЗакрытиеБланкаСсылка.ПолучитьОбъект();
		ЗакрытиеБланкаОбъект.ДатаПроведенияПоОбязательнымРегистрам = Неопределено;
		ЗакрытиеБланкаОбъект.ДополнительныеСвойства.Вставить("ЭтоТачПадРЦ");
		ЗакрытиеБланкаОбъект.Записать(?(ЗакрытиеБланкаОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
		ЗафиксироватьТранзакцию();
				Исключение
					ОтменитьТранзакцию();
					СобытиеЖурналаРегистрации = НСтр(
					"ru = 'Проведение закрытия бланка в фоне'",
					ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
					ЗаписьЖурналаРегистрации(
					СобытиеЖурналаРегистрации,
					УровеньЖурналаРегистрации.Ошибка,
					ЗакрытиеБланкаСсылка.Метаданные(),
					ЗакрытиеБланкаСсылка,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					ВызватьИсключение;
				КонецПопытки;
			КонецПопытки;
		КонецПопытки;
	КонецПопытки;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 09.12.2021

Процедура ДопровестиФормированияПаллетаВФоне(ПараметрыВыборки) Экспорт // --> Начало Лико Ефимов ЕВВ 03.11.2023
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураПараметров = Новый Структура;
	Если ПараметрыВыборки.ВыпускИзРастарки Тогда 
		СтруктураПараметров.Вставить("Лико_НомерЦепочкиВРаспоряженииНаРастарку", ПараметрыВыборки.НомерЦепочкиВРаспоряженииНаРастарку);
		СтруктураПараметров.Вставить("Лико_РаспоряжениеНаРастарку", ПараметрыВыборки.РаспоряжениеНаРастарку);
		
		ЗапросДвижений = Новый Запрос;
		ЗапросДвижений.Текст = 
		"ВЫБРАТЬ
		|	ТоварыВЯчейках.Характеристика.Лико_ЗаказНоменклатуры КАК Заказ,
		|	ТоварыВЯчейках.ВНаличии КАК Количество,
		|	ТоварыВЯчейках.Серия.Лико_НомерЦепочкиВРаспоряженииНаРастарку КАК Лико_НомерЦепочкиВРаспоряженииНаРастарку,
		|	ТоварыВЯчейках.Серия.Лико_РаспоряжениеНаРастарку КАК Лико_РаспоряжениеНаРастарку,
		|	ТоварыВЯчейках.Номенклатура КАК Номенклатура,
		|	ТоварыВЯчейках.Серия КАК Серия,
		|	ТоварыВЯчейках.Упаковка КАК Упаковка,
		|	ТоварыВЯчейках.Характеристика КАК Характеристика,
		|	ТоварыВЯчейках.ВидДвижения КАК ВидДвижения
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
		|ГДЕ
		|	ТоварыВЯчейках.Регистратор = &Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Заказ КАК Заказ,
		|	ВТ.Количество КАК Количество,
		|	ВТ.Лико_НомерЦепочкиВРаспоряженииНаРастарку КАК Лико_НомерЦепочкиВРаспоряженииНаРастарку,
		|	ВТ.Лико_РаспоряжениеНаРастарку КАК Лико_РаспоряжениеНаРастарку,
		|	ВТ.Номенклатура КАК Номенклатура,
		|	ВТ.Серия КАК Серия,
		|	ВТ.Упаковка КАК Упаковка,
		|	ВТ.Характеристика КАК Характеристика
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	ВТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Заказ КАК Заказ,
		|	ВТ.Количество КАК Количество,
		|	ВТ.Лико_НомерЦепочкиВРаспоряженииНаРастарку КАК Лико_НомерЦепочкиВРаспоряженииНаРастарку,
		|	ВТ.Лико_РаспоряжениеНаРастарку КАК Лико_РаспоряжениеНаРастарку,
		|	ВТ.Номенклатура КАК Номенклатура,
		|	ВТ.Серия КАК Серия,
		|	ВТ.Упаковка КАК Упаковка,
		|	ВТ.Характеристика КАК Характеристика
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	ВТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)";
		
		ЗапросДвижений.УстановитьПараметр("Регистратор", ПараметрыВыборки.КорректировкаРегистров);
		РезультатЗапросаДвижений = ЗапросДвижений.ВыполнитьПакет();
		
		СтруктураПараметров.Вставить("ТаблицаСерийВыпускаПоРаспоряжению", РезультатЗапросаДвижений[1].Выгрузить());
		СтруктураПараметров.Вставить("ТаблицаСерийРастаркиПоРаспоряжению", РезультатЗапросаДвижений[2].Выгрузить());
		
	Иначе
		СтруктураПараметров.Вставить("Заказ", ПараметрыВыборки.Заказ);	
	КонецЕсли; 
	
	МенеджерЗаписи = РегистрыСведений.Лико_СвязиСТиповымиДокументами.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ПараметрыВыборки);
	МенеджерЗаписи.Документ = ПараметрыВыборки.ФормированиеПаллета;
	МенеджерЗаписи.ТиповойДокумент = ПараметрыВыборки.КорректировкаРегистров;
	МенеджерЗаписи.Прочитать();
	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Лико_Планирование.ОтправитьПисьмо("Ошибка при чтении РС для установки ДатаНачалаОбработки. Запись не выбрана. " + ПараметрыВыборки.ФормированиеПаллета, "Допроведение формирований паллет", "vefimov@okil.ru",,,,,, Ложь);
		Возврат;
	КонецЕсли;
	Если МенеджерЗаписи.ДатаНачалаОбработки >= ПараметрыВыборки.ДатаОбработки Тогда
		//Лико_Планирование.ОтправитьПисьмо("Ошибка при проверке ДатаНачалаОбработки " + ПараметрыВыборки.ФормированиеПаллета + ОписаниеОшибки(), "Допроведение формирований паллет", "vefimov@okil.ru",,,,,, Ложь);
		Возврат;
	Иначе
		МенеджерЗаписи.ДатаНачалаОбработки = ТекущаяДата(); // Установим дату начала обработки, чтобы другие потоки не пытались ее изменить
		Попытка
			МенеджерЗаписи.Записать();
		Исключение
			Лико_Планирование.ОтправитьПисьмо("Ошибка при установке ДатаНачалаОбработки " + ПараметрыВыборки.ФормированиеПаллета + ": " + ОписаниеОшибки(), "Допроведение формирований паллет", "vefimov@okil.ru",,,,,, Ложь);
			Возврат;
		КонецПопытки;
	КонецЕсли;
	НачатьТранзакцию();
	МассивДокументовКУдалению = Новый Массив;
	МассивДокументовКУдалению.Добавить(ПараметрыВыборки.КорректировкаРегистров);
	Лико_Дополнительно.ПометитьНаУдалениеДокументыМассива(МассивДокументовКУдалению, Неопределено);
	ФормированиеПаллетаОбъект = ПараметрыВыборки.ФормированиеПаллета.ПолучитьОбъект();
	ТаблицаНовыхДокументов = ФормированиеПаллетаОбъект.СоздатьТиповыеДокументы(СтруктураПараметров);
	
	Если ТипЗнч(ТаблицаНовыхДокументов) = Тип("Булево") И ТаблицаНовыхДокументов = Ложь Тогда
		// Что-то не получилось
		//Лико_Планирование.ОтправитьПисьмо("Ошибка при допроведении " + ПараметрыВыборки.ФормированиеПаллета, "Допроведение формирований паллет", "vefimov@okil.ru",,,,,, Ложь);
		ОчиститьДатуОбработкиВСвязяхСТиповымиДокументамиПриОшибке(ПараметрыВыборки);
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.Лико_СвязиСТиповымиДокументами.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ПараметрыВыборки);
	МенеджерЗаписи.Документ = ПараметрыВыборки.ФормированиеПаллета;
	МенеджерЗаписи.ТиповойДокумент = ПараметрыВыборки.КорректировкаРегистров;
	МенеджерЗаписи.Прочитать();
	Попытка
		МенеджерЗаписи.Удалить();	
	Исключение
		ОтменитьТранзакцию();
		Лико_Планирование.ОтправитьПисьмо("Ошибка при удалении записи о корректировке " + ПараметрыВыборки.ФормированиеПаллета + ": " + ОписаниеОшибки(), "Допроведение формирований паллет", "vefimov@okil.ru",,,,,, Ложь);
		ОчиститьДатуОбработкиВСвязяхСТиповымиДокументамиПриОшибке(ПараметрыВыборки);
		Возврат;	
	КонецПопытки;
	
	// Удалим документ корректировки 
	КорректировкаОбъект = ПараметрыВыборки.КорректировкаРегистров.ПолучитьОбъект();
	Попытка
		КорректировкаОбъект.Удалить();
	Исключение
		ОтменитьТранзакцию();
		//Лико_Планирование.ОтправитьПисьмо("Ошибка при удалении документа корректировки " + ПараметрыВыборки.КорректировкаРегистров + ": " + ОписаниеОшибки(), "Допроведение формирований паллет", "vefimov@okil.ru",,,,,, Ложь);
		ОчиститьДатуОбработкиВСвязяхСТиповымиДокументамиПриОшибке(ПараметрыВыборки);
		Возврат;	
	КонецПопытки; 

	СчНовыхДокументов = 0;
	Для каждого НовыйДокумент из ТаблицаНовыхДокументов Цикл
		МенеджерЗаписи = РегистрыСведений.Лико_СвязиСТиповымиДокументами.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ПараметрыВыборки); // Здесь заполнятся старые данные
		МенеджерЗаписи.Документ = ПараметрыВыборки.ФормированиеПаллета;
		МенеджерЗаписи.ТиповойДокумент = НовыйДокумент.Документ;
		МенеджерЗаписи.НомерВЦепочке = МенеджерЗаписи.НомерВЦепочке + СчНовыхДокументов;
		Попытка
			МенеджерЗаписи.Записать();	
		Исключение
			ОтменитьТранзакцию();
