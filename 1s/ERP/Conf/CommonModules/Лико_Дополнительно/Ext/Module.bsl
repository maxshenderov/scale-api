	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.РастариваемыйЗаказ) Тогда
			Результат.Вставить("РастариваемыйЗаказ", Выборка.РастариваемыйЗаказ);
		Иначе
			Если ЗначениеЗаполнено(Выборка.ПеремещениеПаллета) Тогда
