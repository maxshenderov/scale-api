Процедура ЗаполнитьЦеныДокументаПередачаТоваровМеждуОрганизациями(ТЧ, СтруктураПараметров) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	//+ Лико m.shenderov 23.05.2018
	Если СтруктураПараметров.ОрганизацияПолучатель=Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра Тогда
		ЗаполнитьЦеныДокументаПередачаТоваровМеждуОрганизациямиИксПак(ТЧ, СтруктураПараметров);
		Возврат;
	КонецЕсли;
	//- Лико m.shenderov 23.05.2018

	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.ОрганизацияПолучатель) Тогда
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Необходимо выбрать организацию-получатель");
		Возврат;
	КонецЕсли;

	ВалютаДокумента = СтруктураПараметров.Валюта;
	ВалютаЕвро = Константы.ВалютаУправленческогоУчета.Получить();
	ВалютаРуб = Константы.ВалютаРегламентированногоУчета.Получить();

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Товары.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(Товары.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_ТоварыСгруппированы
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Товары.Номенклатура,
	|	ВТ_Товары.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТоварыСгруппированы.Номенклатура КАК Номенклатура,
	|	ВТ_ТоварыСгруппированы.Характеристика КАК Характеристика,
	|	СУММА(ЕСТЬNULL(ВыручкаИСебестоимостьПродажОбороты.КоличествоОборот, 0)) КАК Количество,
	|	СУММА(ЕСТЬNULL(ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиРеглОборот, 0)) КАК СуммаРегл,
	|	СУММА(ЕСТЬNULL(ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиБезНДСОборот, 0)) КАК СуммаУпр
	|ПОМЕСТИТЬ ВТ_ТоварыСВыручкойИКоличеством
	|ИЗ
	|	ВТ_ТоварыСгруппированы КАК ВТ_ТоварыСгруппированы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				Регистратор,
	|				(АналитикаУчетаНоменклатуры.Номенклатура, АналитикаУчетаНоменклатуры.Характеристика) В
	|						(ВЫБРАТЬ
	|							Т.Номенклатура,
	|							Т.Характеристика
	|						ИЗ
	|							ВТ_ТоварыСгруппированы КАК Т)
	|					И АналитикаУчетаПоПартнерам.Организация = &Организация) КАК ВыручкаИСебестоимостьПродажОбороты
	|		ПО ВТ_ТоварыСгруппированы.Номенклатура = ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура
	|			И ВТ_ТоварыСгруппированы.Характеристика = ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Характеристика
	|ГДЕ
	|	((ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|				ИЛИ ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.ПередачаТоваровМеждуОрганизациями)
	|				И ВЫРАЗИТЬ(ВыручкаИСебестоимостьПродажОбороты.Регистратор КАК Документ.РеализацияТоваровУслуг).Валюта = &Валюта
	|			ИЛИ ВЫРАЗИТЬ(ВыручкаИСебестоимостьПродажОбороты.Регистратор КАК Документ.ПередачаТоваровМеждуОрганизациями).Валюта = &Валюта)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТоварыСгруппированы.Номенклатура,
	|	ВТ_ТоварыСгруппированы.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТоварыСВыручкойИКоличеством.Номенклатура КАК Номенклатура,
	|	ВТ_ТоварыСВыручкойИКоличеством.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ВТ_ТоварыСВыручкойИКоличеством.Характеристика.Лико_ЗаказНоменклатуры.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.Пробник)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоПробник,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА ВТ_ТоварыСВыручкойИКоличеством.Количество = 0
	|				ТОГДА 0
	|			ИНАЧЕ ВТ_ТоварыСВыручкойИКоличеством.СуммаРегл / ВТ_ТоварыСВыручкойИКоличеством.Количество
	|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК ЦенаРегл,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА ВТ_ТоварыСВыручкойИКоличеством.Количество = 0
	|				ТОГДА 0
	|			ИНАЧЕ ВТ_ТоварыСВыручкойИКоличеством.СуммаУпр / ВТ_ТоварыСВыручкойИКоличеством.Количество
	|		КОНЕЦ КАК ЧИСЛО(15, 2)) КАК ЦенаУпр
	|ИЗ
	|	ВТ_ТоварыСВыручкойИКоличеством КАК ВТ_ТоварыСВыручкойИКоличеством";

	Запрос.УстановитьПараметр("КонецПериода", ?(ЗначениеЗаполнено(СтруктураПараметров.КонецПериода), КонецДня(СтруктураПараметров.КонецПериода), Дата('39991231')));
	Запрос.УстановитьПараметр("НачалоПериода", СтруктураПараметров.НачалоПериода);
	Запрос.УстановитьПараметр("Организация", СтруктураПараметров.ОрганизацияПолучатель);
	Запрос.УстановитьПараметр("Валюта", ВалютаДокумента);
	Запрос.УстановитьПараметр("Товары", ТЧ.Выгрузить(,"Номенклатура,Характеристика"));

	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	Если ВалютаДокумента = ВалютаЕвро Тогда
		ПолеЦены = "ЦенаУпр";
	Иначе
		ПолеЦены = "ЦенаРегл";
	КонецЕсли;

	Если СтруктураПараметров.Свойство("БезОчистки") И НЕ СтруктураПараметров.БезОчистки Тогда
		// Перед заполнением очистим цены
		Для каждого СтрокаТовары ИЗ ТЧ Цикл
			Если СтрокаТовары.Сумма <> 0 ИЛИ СтрокаТовары.Цена <> 0 Тогда
				СтрокаТовары.Цена = 0;
				СтруктураДействий = Новый Структура;
				СтруктураДействий.Вставить("ПересчитатьСумму");
				СтруктураДействий.Вставить("ПересчитатьСуммуНДС", Новый Структура("ЦенаВключаетНДС,СтавкаНДС", СтруктураПараметров.ЦенаВключаетНДС, СтрокаТовары.СтавкаНДС));
				СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
				СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
				ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, Неопределено);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	//ПроцентУменьшенияЦеныПродажиОкилДляПередач = Справочники.Лико_ПредопределенныеЗначения.ПроцентУменьшенияЦеныПродажиОкилДляПередач.ЗначениеПараметра;
	ПроцентУменьшенияЦеныПродажиОкилДляПередач = ПолучитьНаценкуЦенуПерепродажи(СтруктураПараметров.Дата, СтруктураПараметров.Организация, СтруктураПараметров.ОрганизацияПолучатель, ВалютаДокумента, "ГП", "Наценка");
	Если НЕ ЗначениеЗаполнено(ПроцентУменьшенияЦеныПродажиОкилДляПередач) Тогда
		//Сообщить("Не задано предопределенно значение ""ПроцентУменьшенияЦеныПродажиОкилДляПередач""");
		Возврат;
	КонецЕсли;
	//ЦенаПерепродажиПробниковМеждуОрганизациямиВЕвро = Справочники.Лико_ПредопределенныеЗначения.ЦенаПерепродажиПробниковМеждуОрганизациямиВЕвро.ЗначениеПараметра;

	// Для пробников цену берем в евро всегда, а потом переводим по текущему курсу, если необходимо
	ЦенаПерепродажиПробниковМеждуОрганизациямиВЕвро = ПолучитьНаценкуЦенуПерепродажи(СтруктураПараметров.Дата, СтруктураПараметров.Организация, СтруктураПараметров.ОрганизацияПолучатель, ВалютаЕвро, "ГП_Пробники", "Цена");
	Если НЕ ЗначениеЗаполнено(ЦенаПерепродажиПробниковМеждуОрганизациямиВЕвро) Тогда
		//Сообщить("Не задано предопределенно значение ""ЦенаПерепродажиПробниковМеждуОрганизациямиВЕвро""");
		Возврат;
	КонецЕсли;
	ДатаДокумента = ?(ЗначениеЗаполнено(СтруктураПараметров.Дата), СтруктураПараметров.Дата, ТекущаяДата());
	КурсЕвро = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаЕвро, ДатаДокумента).Курс;
	КурсВалютыДокумента = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаДокумента, ДатаДокумента).Курс;
	ЦенаПерепродажиПробниковМеждуОрганизациямиВРуб = ЦенаПерепродажиПробниковМеждуОрганизациямиВЕвро * КурсЕвро;
	СтавкаПоУмолчанию = ТЧ[0].СтавкаНДС;
	РазмерСтавкиПоУмолчанию = СтавкаПоУмолчанию.Ставка;

	КоэффициентЦены = (100 - ПроцентУменьшенияЦеныПродажиОкилДляПередач) / 100;
	Отбор = Новый Структура("Номенклатура,Характеристика");
	Пока Выборка.Следующий() Цикл
		Если Выборка[ПолеЦены] <> 0 Тогда
			ЗаполнитьЗначенияСвойств(Отбор, Выборка);
			НайденныеСтроки = ТЧ.НайтиСтроки(Отбор);
			Для каждого СтрокаТовары из НайденныеСтроки Цикл
				НужноПересчитыватьЦену = Ложь;
				Если Выборка.ЭтоПробник Тогда
					Цена = ?(ПолеЦены = "ЦенаУпр", ЦенаПерепродажиПробниковМеждуОрганизациямиВЕвро, ЦенаПерепродажиПробниковМеждуОрганизациямиВРуб);
					// --> Начало Лико Ефимов ЕВВ 22.11.2018
					// По согласованию с Капкиным: теперь если количество <= 1, то цена = ЦенаПерепродажиПробниковМеждуОрганизациями, а если > 1, то сумма = ЦенаПерепродажиПробниковМеждуОрганизациями
					Если СтрокаТовары.КоличествоУпаковок > 1 Тогда
						СтрокаТовары.Сумма = Цена;
						НужноПересчитыватьЦену = Истина;
					КонецЕсли;
					// <-- Конец Лико Ефимов ЕВВ 22.11.2018
				Иначе
					Цена = КоэффициентЦены * Выборка[ПолеЦены];
					// --> Начало Лико Ефимов ЕВВ 03.05.2024
					// В запросе выше поменял ресурсы регистра ВыручкаИСебестоимостьПродаж. Были с НДС, стали без НДС
					// Добавим к цене НДС, письмо от Капикина и Мурашовой от 03.05.24
					Цена = Цена * (100 + ?(СтрокаТовары.СтавкаНДС = СтавкаПоУмолчанию, РазмерСтавкиПоУмолчанию, СтрокаТовары.СтавкаНДС.Ставка)) / 100;
					// <-- Конец Лико Ефимов ЕВВ 03.05.2024
				КонецЕсли;
				Если ПолеЦены = "ЦенаРегл" И ВалютаДокумента <> ВалютаРуб Тогда
					// Цена вывелась в рублях, хотя валюта документа не рубли, нужно пересчитать ее в валюту документа (например, доллары)
					Цена = Цена / КурсВалютыДокумента;						
				КонецЕсли;
				СтрокаТовары.Цена = Цена;
				СтруктураДействий = Новый Структура;
				Если НужноПересчитыватьЦену Тогда
					СтруктураДействий.Вставить("ПересчитатьЦенуСкидкуПоСуммеВПродажах");
				Иначе
					СтруктураДействий.Вставить("ПересчитатьСумму");
				КонецЕсли;
				//СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", СтруктураПараметров.НалогообложениеНДС);
				СтруктураДействий.Вставить("ПересчитатьСуммуНДС", Новый Структура("ЦенаВключаетНДС,СтавкаНДС", СтруктураПараметров.ЦенаВключаетНДС, СтрокаТовары.СтавкаНДС));
				СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
				СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
				ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, Неопределено);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьНаценкуЦенуПерепродажи(Дата, ОрганизацияОтправитель, ОрганизацияПолучатель, Валюта, Тип, НаценкаИлиЦена) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_НаценкиНаТоварыПриПередачеМеждуОрганизациямиСрезПоследних.Период КАК Период,
	|	Лико_НаценкиНаТоварыПриПередачеМеждуОрганизациямиСрезПоследних.Организация КАК Организация,
	|	Лико_НаценкиНаТоварыПриПередачеМеждуОрганизациямиСрезПоследних.ОрганизацияПолучатель КАК ОрганизацияПолучатель,
	|	Лико_НаценкиНаТоварыПриПередачеМеждуОрганизациямиСрезПоследних.Валюта КАК Валюта,
	|	Лико_НаценкиНаТоварыПриПередачеМеждуОрганизациямиСрезПоследних.Тип КАК Тип,
	|	Лико_НаценкиНаТоварыПриПередачеМеждуОрганизациямиСрезПоследних.Наценка КАК Наценка,
	|	Лико_НаценкиНаТоварыПриПередачеМеждуОрганизациямиСрезПоследних.Сумма КАК Сумма
	|ИЗ
	|	РегистрСведений.Лико_НаценкиНаТоварыПриПередачеМеждуОрганизациями.СрезПоследних(
	|			&Дата,
	|			Организация = &ОрганизацияОтправитель
	|				И ОрганизацияПолучатель = &ОрганизацияПолучатель
	|				И Тип = &Тип
	|				И Валюта = &Валюта) КАК Лико_НаценкиНаТоварыПриПередачеМеждуОрганизациямиСрезПоследних";
	
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ОрганизацияОтправитель", ОрганизацияОтправитель);
	Запрос.УстановитьПараметр("ОрганизацияПолучатель", ОрганизацияПолучатель);
	Запрос.УстановитьПараметр("Тип", Тип);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если НаценкаИлиЦена = "Наценка" Тогда
			Возврат ВыборкаДетальныеЗаписи.Наценка;
		ИначеЕсли НаценкаИлиЦена = "Цена" Тогда
			Возврат ВыборкаДетальныеЗаписи.Сумма;
		Иначе
			Сообщить("Тип НаценкаИлиЦена = " + НаценкаИлиЦена + " не определен");
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Сообщить("Не найдена """ + НаценкаИлиЦена + """ для следующих параметров: Дата = " + Дата + ", ОрганизацияОтправитель = " + ОрганизацияОтправитель + ", ОрганизацияПолучатель = " + ОрганизацияПолучатель + ", Валюта = " + Валюта + ", Тип = " + Тип); 
		Возврат Неопределено;	
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьЦеныДокументаПередачаТоваровМеждуОрганизациямиИксПак(ТЧ, СтруктураПараметров) Экспорт//+ Лико m.shenderov 23.05.2018
	
	
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.ОрганизацияПолучатель) Тогда
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Необходимо выбрать организацию-получатель");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
