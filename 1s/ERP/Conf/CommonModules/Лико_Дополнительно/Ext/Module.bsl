Процедура ПереместитьЭлементыМассиваИзНачалаВКонец(Массив) Экспорт // --> Начало Лико Ефимов ЕВВ 06.12.2017
	
	Если ТипЗнч(Массив) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	НовыйМассив = Новый Массив;
	
	КоличествоЭлементовВМассиве = Массив.Количество();
	Для сч = 1 по КоличествоЭлементовВМассиве Цикл
		НовыйМассив.Добавить(Массив[КоличествоЭлементовВМассиве-сч]);
	КонецЦикла;
	Массив = НовыйМассив;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 06.12.2017

Функция ПолучитьТехнологическуюОперациюИРабочийЦентрЭтапа(Этап) Экспорт // --> Начало Лико Ефимов ЕВВ 07.12.2017
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭтапПроизводства2_2.Ссылка КАК Ссылка,
	|	ЭтапПроизводства2_2.МаршрутнаяКарта КАК МаршрутнаяКарта
	|ПОМЕСТИТЬ ВТ_МаршрутнаяКарта
	|ИЗ
	|	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	|ГДЕ
	|	ЭтапПроизводства2_2.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТехнологическиеОперации.Ссылка КАК ТехнологическаяОперация
	|ИЗ
	|	Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
	|ГДЕ
	|	ТехнологическиеОперации.Владелец В
	|			(ВЫБРАТЬ
	|				ВТ_МаршрутнаяКарта.МаршрутнаяКарта
	|			ИЗ
	|				ВТ_МаршрутнаяКарта)
	|	И НЕ ТехнологическиеОперации.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТехнологическиеОперации.НомерОперации";
	
	Запрос.УстановитьПараметр("Ссылка", Этап);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ТехнологическаяОперация;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 07.12.2017

Функция ПолучитьТехнологическуюОперациюДляРабочегоЦентра(РабочийЦентр, Подразделение = Неопределено) Экспорт // --> Начало Лико Ефимов ЕВВ 07.12.2017

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТехнологическиеОперации.Ссылка КАК ТехнологическаяОперация
	|ИЗ
	|	Справочник.ТехнологическиеОперации КАК ТехнологическиеОперации
	|ГДЕ
	|	НЕ ТехнологическиеОперации.ПометкаУдаления
	|	И ТехнологическиеОперации.РабочийЦентр = &РабочийЦентр
	|	И ТехнологическиеОперации.Владелец.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыМаршрутныхКарт.Действует)
	|	И ТехнологическиеОперации.Владелец.Подразделение = &Подразделение
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТехнологическиеОперации.Владелец.Код УБЫВ,
	|	ТехнологическиеОперации.НомерОперации";
	
	Запрос.УстановитьПараметр("РабочийЦентр", РабочийЦентр);
	Если Подразделение = Неопределено Тогда
		Запрос.УстановитьПараметр("Подразделение", РабочийЦентр.Лико_Площадка.ПодразделениеПроизводство);
	Иначе
		Запрос.УстановитьПараметр("Подразделение", Подразделение);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ТехнологическаяОперация;
	Иначе
		// Создаем новую маршрутную карту
		МаршрутнаяКартаОбъект = Справочники.МаршрутныеКарты.СоздатьЭлемент();
		МаршрутнаяКартаОбъект.Наименование = РабочийЦентр.Наименование;
		// --> Начало Лико Ефимов ЕВВ 24.06.2024
		// В типовой конфе не дает создать тех операцию, если статус маршрутной карты = действует. Поэтому поставим пока "в разработке", а потом поменяем на "Действует"
		//МаршрутнаяКартаОбъект.Статус = Перечисления.СтатусыМаршрутныхКарт.Действует 
		МаршрутнаяКартаОбъект.Статус = Перечисления.СтатусыМаршрутныхКарт.ВРазработке; 
		// <-- Конец Лико Ефимов ЕВВ 24.06.2024
		МаршрутнаяКартаОбъект.Подразделение = Подразделение;
		МаршрутнаяКартаОбъект.ЕдиницаИзмеренияПредварительногоБуфера = Перечисления.ЕдиницыИзмеренияВремени.День;
		МаршрутнаяКартаОбъект.ЕдиницаИзмеренияЗавершающегоБуфера = Перечисления.ЕдиницыИзмеренияВремени.День;
		МаршрутнаяКартаОбъект.ИспользоватьОперации = Истина;
		МаршрутнаяКартаОбъект.ИспользоватьВыходныеИзделия = Ложь;
		МаршрутнаяКартаОбъект.ИспользоватьМатериалы = Ложь;
		МаршрутнаяКартаОбъект.ИспользоватьТрудозатраты = Ложь;
		Попытка
			МаршрутнаяКартаОбъект.Записать();
		Исключение
			Сообщить("Не удалось создать маршрутную карту для РЦ " + РабочийЦентр + ": " + ОписаниеОшибки());
			Возврат Неопределено;
		КонецПопытки;
		
		// Создаем технологическую операцию
		ТехнологическаяОперацияОбъект = Справочники.ТехнологическиеОперации.СоздатьЭлемент();
		ТехнологическаяОперацияОбъект.Владелец = МаршрутнаяКартаОбъект.Ссылка;
		ТехнологическаяОперацияОбъект.Наименование = МаршрутнаяКартаОбъект.Наименование;
		ТехнологическаяОперацияОбъект.НомерОперации = 1;
		ТехнологическаяОперацияОбъект.НомерСледующейОперации = 0;
		ТехнологическаяОперацияОбъект.РабочийЦентр = РабочийЦентр;
		ТехнологическаяОперацияОбъект.ВремяШтучное = 60;
		ТехнологическаяОперацияОбъект.ВремяШтучноеЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.Минута;
		ТехнологическаяОперацияОбъект.ВремяПЗЕдИзм = Перечисления.ЕдиницыИзмеренияВремени.Минута;
		ТехнологическаяОперацияОбъект.Количество = 1;
		ТехнологическаяОперацияОбъект.Идентификатор = 1;
		Попытка
			ТехнологическаяОперацияОбъект.Записать();
		Исключение
			Сообщить("Не удалось создать технологическую операцию для РЦ " + РабочийЦентр + ": " + ОписаниеОшибки());
			Возврат Неопределено;
		КонецПопытки;
		
		// --> Начало Лико Ефимов ЕВВ 24.06.2024
		// поменяем статус маршрутной карты на "Действует
		МаршрутнаяКартаОбъект.Статус = Перечисления.СтатусыМаршрутныхКарт.Действует;
		Попытка
			МаршрутнаяКартаОбъект.Записать();
		Исключение
			Сообщить("Не удалось изменить статус маршрутной карты для РЦ " + РабочийЦентр + ": " + ОписаниеОшибки());
			Возврат Неопределено;
		КонецПопытки;
		// <-- Конец Лико Ефимов ЕВВ 24.06.2024
		
		Возврат ТехнологическаяОперацияОбъект.Ссылка;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 07.12.2017

Функция ПолучитьПараметрыКомандыВнешнегоОтчета(ИмяДопОтчетаВПредопределенныхДанных = "", НаименованиеОтчета = "", ИмяОбъектаОтчета = "") Экспорт // --> Начало Лико Ефимов ЕВВ 22.12.2017 
	
	Если ЗначениеЗаполнено(ИмяДопОтчетаВПредопределенныхДанных) Тогда 
		ДополнительныйОтчет = Справочники.Лико_ПредопределенныеЗначения[ИмяДопОтчетаВПредопределенныхДанных].ЗначениеПараметра;
	ИначеЕсли ЗначениеЗаполнено(ИмяОбъектаОтчета) Тогда
		ДополнительныйОтчет = НайтиДополнительнуюОбработкуПоИмениОбъекта(ИмяОбъектаОтчета);
	ИначеЕсли ЗначениеЗаполнено(НаименованиеОтчета) Тогда
		ДополнительныйОтчет = НайтиДополнительнуюОбработкуПоНаименованию(НаименованиеОтчета);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДополнительныйОтчет) Тогда
		Сообщить("Не заполнено предопределенное значение """ + ИмяДопОтчетаВПредопределенныхДанных + """.");
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(ДополнительныйОтчет) <> Тип("СправочникСсылка.ДополнительныеОтчетыИОбработки") ИЛИ ДополнительныйОтчет.Вид <> Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет Тогда
		Сообщить("В предопределеннм значении """ + ИмяДопОтчетаВПредопределенныхДанных + """ выбраны некорректные данные.");
		Возврат Неопределено;
	КонецЕсли;
	Если ДополнительныйОтчет.Команды.Количество() = 0 Тогда
		Сообщить("В дополниельном отчете """ + ИмяДопОтчетаВПредопределенныхДанных + """ не найдено ни одной команды");
		Возврат Неопределено;
	КонецЕсли;
	Структура = Новый Структура;
	Структура.Вставить("ДополнительнаяОбработкаСсылка", ДополнительныйОтчет);
	Структура.Вставить("ИдентификаторКоманды", ДополнительныйОтчет.Команды[0].Идентификатор);
	Возврат Структура;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 22.12.2017 

Функция ПолучитьПараметрыКомандыВнешнейОбработки(ИмяДопОбработкиВПредопределенныхДанных = "", НаименованиеОбработки = "", ИмяОбъектаОбработки = "") Экспорт // --> Начало Лико Ефимов ЕВВ 22.12.2017 
	
	Если ЗначениеЗаполнено(ИмяДопОбработкиВПредопределенныхДанных) Тогда 
		ДополнительнаяОбработка = Справочники.Лико_ПредопределенныеЗначения[ИмяДопОбработкиВПредопределенныхДанных].ЗначениеПараметра;
	ИначеЕсли ЗначениеЗаполнено(ИмяОбъектаОбработки) Тогда
		ДополнительнаяОбработка = НайтиДополнительнуюОбработкуПоИмениОбъекта(ИмяОбъектаОбработки);
	ИначеЕсли ЗначениеЗаполнено(НаименованиеОбработки) Тогда
		ДополнительнаяОбработка = НайтиДополнительнуюОбработкуПоНаименованию(НаименованиеОбработки);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДополнительнаяОбработка) Тогда
		Сообщить("Не заполнено предопределенное значение """ + ИмяДопОбработкиВПредопределенныхДанных + """.");
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(ДополнительнаяОбработка) <> Тип("СправочникСсылка.ДополнительныеОтчетыИОбработки") ИЛИ ДополнительнаяОбработка.Вид <> Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка Тогда
		Сообщить("В предопределеннм значении """ + ИмяДопОбработкиВПредопределенныхДанных + """ выбраны некорректные данные.");
		Возврат Неопределено;
	КонецЕсли;
	Если ДополнительнаяОбработка.Команды.Количество() = 0 Тогда
		Сообщить("В дополниельной обработке """ + ИмяДопОбработкиВПредопределенныхДанных + """ не найдено ни одной команды");
		Возврат Неопределено;
	КонецЕсли;
	
	Структура = Новый Структура;
	Структура.Вставить("Ссылка", ДополнительнаяОбработка);
	Структура.Вставить("Идентификатор", ДополнительнаяОбработка.Ссылка.Команды[0].Идентификатор);
	Структура.Вставить("ЭтоОтчет", ДополнительнаяОбработка.Ссылка.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет);
	
	Возврат Структура;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 22.12.2017 

Функция ПолучитьПараметрыОткрытияПечатнойФормы(ИмяДопОбработкиВПредопределенныхДанных = "", НаименованиеОбработки = "", ИмяОбъектаОбработки = "", СсылкаНаОбъект) Экспорт // --> Начало Лико Ефимов ЕВВ 17.10.2018  
	
	Если ЗначениеЗаполнено(ИмяДопОбработкиВПредопределенныхДанных) Тогда 
		ДополнительнаяОбработка = Справочники.Лико_ПредопределенныеЗначения[ИмяДопОбработкиВПредопределенныхДанных].ЗначениеПараметра;
	ИначеЕсли ЗначениеЗаполнено(ИмяОбъектаОбработки) Тогда
		ДополнительнаяОбработка = НайтиДополнительнуюОбработкуПоИмениОбъекта(ИмяОбъектаОбработки);
	ИначеЕсли ЗначениеЗаполнено(НаименованиеОбработки) Тогда
		ДополнительнаяОбработка = НайтиДополнительнуюОбработкуПоНаименованию(НаименованиеОбработки);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДополнительнаяОбработка) Тогда
		Сообщить("Не заполнено предопределенное значение """ + ИмяДопОбработкиВПредопределенныхДанных + """.");
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(ДополнительнаяОбработка) <> Тип("СправочникСсылка.ДополнительныеОтчетыИОбработки") ИЛИ ДополнительнаяОбработка.Вид <> Перечисления.ВидыДополнительныхОтчетовИОбработок.ПечатнаяФорма Тогда
		Сообщить("В предопределеннм значении """ + ИмяДопОбработкиВПредопределенныхДанных + """ выбраны некорректные данные.");
		Возврат Неопределено;
	КонецЕсли;
	Если ДополнительнаяОбработка.Команды.Количество() = 0 Тогда
		Сообщить("В дополниельной обработке """ + ИмяДопОбработкиВПредопределенныхДанных + """ не найдено ни одной команды");
		Возврат Неопределено;
	КонецЕсли;
	
	ИдентификаторКоманды = ДополнительнаяОбработка.Команды[0].Идентификатор;
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(СсылкаНаОбъект);
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ИсточникДанных", ДополнительнаяОбработка);
	ПараметрыОткрытия.Вставить("ПараметрыИсточника", Новый Структура("ИдентификаторКоманды,ОбъектыНазначения", ИдентификаторКоманды, МассивОбъектов));
	ПараметрыОткрытия.Вставить("ПараметрыПечати", Неопределено);
	
	Возврат ПараметрыОткрытия;	
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 17.10.2018  

Функция ПолучитьТаблицуКоробокПоНакладной(Распоряжение, СвернутьПоНоменклатуре = Ложь, ПервыйЗаход = Истина) Экспорт // --> Начало Лико Ефимов ЕВВ 25.10.2017
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка КАК Ссылка,
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Номенклатура КАК Номенклатура,
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Характеристика КАК Характеристика,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия КАК Серия,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия.Лико_ВесКоробки КАК ВесКоробки,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия.Лико_КодЭтикеткиЗаказчика КАК КодЭтикеткиЗаказчика,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия.Лико_НомерПоставки КАК NКонтракта,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия.Лико_ЧестныйЗнак КАК ЧестныйЗнак,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия.Лико_НаправлениеНамотки КАК Намотка,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия.Лико_ДатаУпаковки КАК ДатаУпаковки,
	|	РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия.Лико_КоличествоКоробок КАК КоличествоКоробок
	|ПОМЕСТИТЬ ВТ_ОтгруженныеСерии
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерНаТовары.ОтгружаемыеТовары КАК РасходныйОрдерНаТоварыОтгружаемыеТовары
	|		ПО РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка = РасходныйОрдерНаТоварыОтгружаемыеТовары.Ссылка
	|			И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Номенклатура = РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура
	|			И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Характеристика = РасходныйОрдерНаТоварыОтгружаемыеТовары.Характеристика
	|ГДЕ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка.Проведен
	|	И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыРасходныхОрдеров.Отгружен)
	|	И (ВЫРАЗИТЬ(РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение КАК Документ.РеализацияТоваровУслуг)) = &Распоряжение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОтгруженныеСерии.Ссылка КАК Ссылка,
	|	ВТ_ОтгруженныеСерии.Номенклатура КАК Номенклатура,
	|	ВТ_ОтгруженныеСерии.Номенклатура.Код КАК НоменклатураКод,
	//--> Маковеева А.Ю.
	|" + ?(СвернутьПоНоменклатуре, "", "ВТ_ОтгруженныеСерии.Характеристика КАК Характеристика,") + "
	//<-- Маковеева А.Ю.
	|	СУММА(ВТ_ОтгруженныеСерии.КоличествоКоробок) КАК КоличествоКоробок,
	|	МАКСИМУМ(ВТ_ОтгруженныеСерии.КодЭтикеткиЗаказчика) КАК КодЭтикеткиЗаказчика,
	|	МАКСИМУМ(ВТ_ОтгруженныеСерии.NКонтракта) КАК NКонтракта,
	|	МАКСИМУМ(ВТ_ОтгруженныеСерии.ДатаУпаковки) КАК МаксимальнаяДатаУпаковки,
	|	МАКСИМУМ(ВТ_ОтгруженныеСерии.ЧестныйЗнак) КАК ЧестныйЗнак,
	|	МАКСИМУМ(ВТ_ОтгруженныеСерии.Намотка) КАК Намотка,
	|	МИНИМУМ(ВТ_ОтгруженныеСерии.ДатаУпаковки) КАК МинимальнаяДатаУпаковки,
	|	СУММА(ВТ_ОтгруженныеСерии.ВесКоробки) КАК ВесКоробок
	|ИЗ
	|	ВТ_ОтгруженныеСерии КАК ВТ_ОтгруженныеСерии
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОтгруженныеСерии.Ссылка,
	|	ВТ_ОтгруженныеСерии.Номенклатура,
	|	ВТ_ОтгруженныеСерии.Номенклатура.Код
	//--> Маковеева А.Ю.
	|	" + ?(СвернутьПоНоменклатуре, "", ",ВТ_ОтгруженныеСерии.Характеристика");
	//<-- Маковеева А.Ю.
	
	Запрос.УстановитьПараметр("Распоряжение", Распоряжение);
	Если ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг", "ПеремещениеТоваров");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	// --> Начало Лико Ефимов ЕВВ 14.10.2019
	Если РезультатЗапроса.Пустой() И ПервыйЗаход И ТипЗнч(Распоряжение) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		// Может быть это Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуЧерезСкладРегиона, попробуем найти для этой реализации связанное перемещение, а потом для перемещения выполнить запрос еще раз	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_СвязиСТиповымиДокументамиРеализация.Документ КАК ЗаявкаНаТр,
		|	Лико_СвязиСТиповымиДокументамиРеализация.ТиповойДокумент КАК Реализация,
		|	Лико_СвязиСТиповымиДокументамиПеремещение.ТиповойДокумент КАК Перемещение
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	РегистрСведений.Лико_СвязиСТиповымиДокументами КАК Лико_СвязиСТиповымиДокументамиРеализация
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_СвязиСТиповымиДокументами КАК Лико_СвязиСТиповымиДокументамиПеремещение
		|		ПО ((ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументамиРеализация.Документ КАК Документ.Лико_ЗаявкаНаТранспортировку)) = (ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументамиПеремещение.Документ КАК Документ.Лико_ЗаявкаНаТранспортировку)))
		|			И (Лико_СвязиСТиповымиДокументамиПеремещение.ТиповойДокумент ССЫЛКА Документ.ПеремещениеТоваров)
		|ГДЕ
		|	(ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументамиРеализация.ТиповойДокумент КАК Документ.РеализацияТоваровУслуг)) = &Реализация
		|	И Лико_СвязиСТиповымиДокументамиРеализация.Документ ССЫЛКА Документ.Лико_ЗаявкаНаТранспортировку
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЧ.Характеристика КАК Характеристика,
		|	СУММА(ТЧ.КоличествоУпаковок) КАК КоличествоУпаковок
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК ТЧ
		|		ПО ВТ.Реализация = ТЧ.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ТЧ.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТЧ.Характеристика КАК Характеристика,
		|	СУММА(ТЧ.КоличествоУпаковок) КАК КоличествоУпаковок
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПеремещениеТоваров.Товары КАК ТЧ
		|		ПО ВТ.Перемещение = ТЧ.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ТЧ.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ЗаявкаНаТр КАК ЗаявкаНаТр,
		|	ВТ.Реализация КАК Реализация,
		|	ВТ.Перемещение КАК Перемещение
		|ИЗ
		|	ВТ КАК ВТ";
		
		Запрос.УстановитьПараметр("Реализация", Распоряжение);
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		КоличествоПакетов = РезультатыЗапроса.Количество();
		ВыборкаДокументы = РезультатыЗапроса[КоличествоПакетов-1].Выбрать();
		Если ВыборкаДокументы.Следующий() Тогда
			// Перемещение найдено. На всякий случай проверим, совпадают ли таблицы товаров по количеству
			ТаблицаТоваровПеремещения = РезультатыЗапроса[КоличествоПакетов-2].Выгрузить();
			ТаблицаТоваровРеализации = РезультатыЗапроса[КоличествоПакетов-3].Выгрузить();
			Если НЕ СравнениеДвухОдинаковыхТаблицЗначенийПоСодержимому(ТаблицаТоваровПеремещения, ТаблицаТоваровРеализации) Тогда
				// Таблицы товаров совпадают по количеству
				Возврат ПолучитьТаблицуКоробокПоНакладной(ВыборкаДокументы.Перемещение, СвернутьПоНоменклатуре, Ложь);
			КонецЕсли;				
		КонецЕсли;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 14.10.2019
	
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 25.10.2017

Процедура ОтметитьВыполнениеЭтапаПлана(СтруктураИзмерений, Источник = Неопределено) Экспорт // --> Начало Лико Ефимов ЕВВ 21.01.2018
	
	УстановитьПривилегированныйРежим(Истина);
	// Установим Выполнено = 1
	МенеджерЗаписи = РегистрыСведений.ПооперационноеРасписание2_2.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураИзмерений);
	МенеджерЗаписи.Прочитать();
	МенеджерЗаписи.Выполнено = 1;
	МенеджерЗаписи.МожноВыполнять = 0;
	МенеджерЗаписи.Выполняется = 0;
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		Если Источник = Неопределено Тогда
			Сообщить("Не удалось отметить выполнение плана для документа """ + СтруктураИзмерений.Этап + """: " + ОписаниеОшибки());
		Иначе
			Сообщить("" + Источник + """ - не удалось отметить выполнение плана для документа """ + СтруктураИзмерений.Этап + """: " + ОписаниеОшибки());
		КонецЕсли;
		Возврат;
	КонецПопытки;
	
	Лико_Дополнительно.ИзменитьСтатусЭтапаПроизводстваВФоне(СтруктураИзмерений.Этап, Перечисления.СтатусыЭтаповПроизводства2_2.Завершен);
	
	Если НЕ (ЗначениеЗаполнено(Источник) И ТипЗнч(Источник) = Тип("ДокументСсылка.Лико_ЗакрытиеЗаказа")) И НЕ МенеджерЗаписи.Моделирование Тогда
		ДействияПослеВыполненияЭтапаПлана(СтруктураИзмерений);
	КонецЕсли;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 21.01.2018

Процедура ДействияПослеВыполненияЭтапаПлана(СтруктураИзмерений, ПересчитыватьМассивРЦ = Истина) Экспорт // --> Начало Лико Ефимов ЕВВ 21.01.2018

	УстановитьПривилегированныйРежим(Истина);
	
	НомерПроката = СтруктураИзмерений.Этап.НомерПроката;
	НужноСоздаватьЗапись = Ложь;
	Если НомерПроката = 1 Тогда
		ПриОкончании1ПрокатаАвтоматическиСтавить2ПрокатНаРЦИзЗаказа = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, СтруктураИзмерений.РабочийЦентр, "ПриОкончании1ПрокатаАвтоматическиСтавить2ПрокатНаРЦИзЗаказа", Ложь);
		ПриОкончании1ПрокатаАвтоматическиСтавить2ПрокатНаРЦИзВида = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, СтруктураИзмерений.РабочийЦентр, "ПриОкончании1ПрокатаАвтоматическиСтавить2ПрокатНаРЦИзВида_50aea5f3d5ab4aaa8f8cc54b1c38b29a", Ложь);
		Если ПриОкончании1ПрокатаАвтоматическиСтавить2ПрокатНаРЦИзЗаказа Тогда
			ЗаказКлиента = НайтиЗаказКлиентаПоЭтапу(СтруктураИзмерений.Этап);
			РабочийЦентр = НайтиРабочийЦентрВЗаказеКлиентаПоПрокату(ЗаказКлиента, НомерПроката + 1);
			Если ЗначениеЗаполнено(РабочийЦентр) Тогда
				Этап = НайтиЭтапВСвободныхПоЗаказуИНомеруПроката(ЗаказКлиента, НомерПроката + 1);
				Если ЗначениеЗаполнено(Этап) Тогда
