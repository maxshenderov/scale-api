		//Начало изменений Иванова А.В. 20171009
	ИначеЕсли ТипИсточника = Тип("ДокументОбъект.ЗаказКлиента") Тогда
		Лико_Планирование.ПередЗаписьюДокументов_ЗаказКлиента(Источник, Отказ, РежимЗаписи, РежимПроведения);
