Функция ПлощадкаПользователяПоУмолчанию() Экспорт
	Если ПараметрыСеанса.ТекущийПользователь.Лико_Площадки.Количество() > 0 Тогда
		Возврат ПараметрыСеанса.ТекущийПользователь.Лико_Площадки[0].Площадка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Функция ПолучитьЗаполнитьТекущуюСменуОтветственногоЛица(ТекОператор, СменаОтветственного = Ложь, Ответственный = Неопределено, ТипОтвЛица = "Технолог") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	ПлощадкаПользователя = ПлощадкаПользователяПоУмолчанию();
	Если НЕ ЗначениеЗаполнено(ПлощадкаПользователя) Тогда
		Сообщить("Для вашего пользователя не заполнена площадка. Обратитесь к программистам");
		Возврат "";
	КонецЕсли;

	МассивНазванийДолжностей = Новый Массив;
	Если ТипОтвЛица = "Технолог" Тогда
		СинонимОтвЛица = "технолог";
		МассивНазванийДолжностей.Добавить("ДолжностьТехнолог");
		МассивНазванийДолжностей.Добавить("ДолжностьЗамГлТехнолога");
	ИначеЕсли ТипОтвЛица = "НачальникСменыОсновнойЦех" Тогда
		СинонимОтвЛица = "начальник смены";
		МассивНазванийДолжностей.Добавить("ДолжностьНачальникСмены");
	ИначеЕсли ТипОтвЛица = "НачальникСменыЦУ" Тогда
		СинонимОтвЛица = "начальник смены ЦУ";
		МассивНазванийДолжностей.Добавить("ДолжностьНачальникСмены");
	Иначе
		Сообщить("Тип ответственного лица """ + ТипОтвЛица + """ не предусмотрен. Обратитесь к программистам");
		Возврат "";
	КонецЕсли;
	СинонимОтвЛицаСБольшойБуквы = ВРег(Лев(СинонимОтвЛица, 1)) + Сред(СинонимОтвЛица, 2);
	
	Если ПлощадкаПользователя <> Справочники.Лико_Площадки.Ликофлекс Тогда
		Сообщить("Для площадки """ + ПлощадкаПользователя + """ заполнение " + ПолучитьСклоненияСтроки(СинонимОтвЛица,, "ПД=Родительный")[0] + " не предусмотрено");
		Возврат "";
	КонецЕсли;
	
	ТекущаяДата = ТекущаяДата();
	ДневнаяСмена = Час(ТекущаяДата) >= 9 И Час(ТекущаяДата) < 21;
	ДатаНачалаСмены = НачалоДня(?(Час(ТекущаяДата) < 9, ТекущаяДата - 86400, ТекущаяДата));
	
	Ответственный = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_СоответствиеСменИКлючевыхСотрудников.Период КАК Период,
		|	Лико_СоответствиеСменИКлючевыхСотрудников.ДневнаяСмена КАК ДневнаяСмена,
		|	Лико_СоответствиеСменИКлючевыхСотрудников.Площадка КАК Площадка,
		|	Лико_СоответствиеСменИКлючевыхСотрудников.Технолог КАК Технолог,
		|	Лико_СоответствиеСменИКлючевыхСотрудников.НачальникСменыОсновнойЦех КАК НачальникСменыОсновнойЦех,
		|	Лико_СоответствиеСменИКлючевыхСотрудников.НачальникСменыЦУ КАК НачальникСменыЦУ
		|ИЗ
		|	РегистрСведений.Лико_СоответствиеСменИКлючевыхСотрудников КАК Лико_СоответствиеСменИКлючевыхСотрудников
		|ГДЕ
		|	Лико_СоответствиеСменИКлючевыхСотрудников.Период = &Период
		|	И Лико_СоответствиеСменИКлючевыхСотрудников.ДневнаяСмена = &ДневнаяСмена
		|	И Лико_СоответствиеСменИКлючевыхСотрудников.Площадка = &Площадка";
	
	Запрос.УстановитьПараметр("ДневнаяСмена", ДневнаяСмена);
	Запрос.УстановитьПараметр("Период", ДатаНачалаСмены);
	Запрос.УстановитьПараметр("Площадка", ПлощадкаПользователя);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи[ТипОтвЛица]) Тогда
		Ответственный = ВыборкаДетальныеЗаписи[ТипОтвЛица];	
	КонецЕсли;
	
	Если (НЕ ЗначениеЗаполнено(Ответственный) И ЗначениеЗаполнено(ТекОператор))
		ИЛИ СменаОтветственного Тогда
		ДолжностьОператора = Лико_Дополнительно.НайтиДолжностьФизЛица(ТекОператор, Неопределено);
		МассивНеобходимыхДолжностей = Новый Массив;
		Для каждого НазваниеДолжности из МассивНазванийДолжностей Цикл
			ТекДолжность = Справочники.Лико_ПредопределенныеЗначения[НазваниеДолжности].ЗначениеПараметра;
			Если ЗначениеЗаполнено(ТекДолжность) Тогда
				МассивНеобходимыхДолжностей.Добавить(ТекДолжность);
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеЗаполнено(ДолжностьОператора) И МассивНеобходимыхДолжностей.Найти(ДолжностьОператора) <> Неопределено Тогда
			ВремяДоступностиИзмененияОтветственного = 9; // часов
			Если СменаОтветственного
				И ЗначениеЗаполнено(Ответственный)
				И ТекущаяДата > ДатаНачалаСмены + ?(ДневнаяСмена, 9, 21)*60*60 + ВремяДоступностиИзмененияОтветственного*60*60 Тогда
				Сообщить("Запрещено изменять ответственного в последние 3 часа смены. Для изменения обратитесь к программистам");
			Иначе
				// Добавим запись
				СтруктураИзмерений = Новый Структура("Период,Площадка,ДневнаяСмена", ДатаНачалаСмены, Запрос.Параметры.Площадка, ДневнаяСмена);
				МенеджерЗаписи = РегистрыСведений.Лико_СоответствиеСменИКлючевыхСотрудников.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураИзмерений);
				МенеджерЗаписи.Прочитать();
				Если НЕ МенеджерЗаписи.Выбран() Тогда
					ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураИзмерений);
				КонецЕсли;
				МенеджерЗаписи[ТипОтвЛица] = ТекОператор;
				МенеджерЗаписи.Записать(Истина);
				Если СменаОтветственного Тогда
					Сообщить(СинонимОтвЛицаСБольшойБуквы + " " + ?(ЗначениеЗаполнено(Ответственный), "изменен с " + Ответственный + " на " + ТекОператор, "установлен"));
				КонецЕсли;
				Ответственный = МенеджерЗаписи[ТипОтвЛица];
			КонецЕсли;
		Иначе
			Если СменаОтветственного Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Нужно ввести табельный номер сотрудника с одной из следующих должностей:";
				сч = 0;
				Для каждого ТекДолжность из МассивНеобходимыхДолжностей Цикл
					Сообщение.Текст = Сообщение.Текст + ?(сч = 0, " ", ", ") + ТекДолжность;
					сч = сч + 1;
				КонецЦикла;
				Сообщение.Сообщить();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Надпись = "Текущая смена - " + Формат(ДатаНачалаСмены, "ДФ='д ММММ'");
	Если ДневнаяСмена Тогда
		Надпись = Надпись + " с 9:00 по 21:00.";
	Иначе
		Надпись = Надпись + " с 21:00 по 9:00.";
	КонецЕсли;
	
	Надпись = Надпись + " " + СинонимОтвЛицаСБольшойБуквы + ?(ЗначениеЗаполнено(Ответственный), " - " + Ответственный, " не заполнен");
	
	Возврат Надпись;
	
КонецФункции

Функция ПолучитьТабличныйДокументВариантаОтчета(ВариантОтчета, ДопПараметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Структура = Новый Структура;
	Структура.Вставить("СсылкаВарианта", ВариантОтчета); 
	Структура.Вставить("СсылкаОтчета", ВариантОтчета.Отчет);
	Структура.Вставить("КлючВарианта", ВариантОтчета.КлючВарианта);    				  
	Структура.Вставить("СхемаМодифицирована", Истина);
	ПользовательскиеНастройкиОтчета = ВариантОтчета.Настройки.Получить();
	Если ПользовательскиеНастройкиОтчета <> Неопределено Тогда
		ОтборНастройки = Новый КомпоновщикНастроекКомпоновкиДанных;
		ОтборНастройки.ЗагрузитьНастройки(ПользовательскиеНастройкиОтчета);
		Структура.Вставить("НастройкиКД", ОтборНастройки.Настройки);
		Структура.Вставить("ПользовательскиеНастройкиКД", ОтборНастройки.ПользовательскиеНастройки);
	КонецЕсли;
	Структура.Вставить("Лико_ДопПараметры", ДопПараметры);
	
	Отчет = ВариантыОтчетов.СформироватьОтчет(Структура, Ложь, Ложь);  	
	
	Возврат Отчет.ТабличныйДокумент;
	
КонецФункции
 
