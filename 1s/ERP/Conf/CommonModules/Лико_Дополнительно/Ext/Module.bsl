	Если ТипЗнч(Источник)=Тип("СправочникМенеджер.СерииНоменклатуры")Тогда
		Если ВидФормы = "ФормаОбъекта" Тогда 		
			Если Параметры.Свойство("Ключ") И ЗначениеЗаполнено(Параметры.Ключ.ЯССМ_ОбъектНоменклатуры) Тогда
				СтандартнаяОбработка = Ложь; 
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Ключ",Параметры.Ключ.ЯССМ_ОбъектНоменклатуры);
				Параметры.Ключ=Параметры.Ключ.ЯССМ_ОбъектНоменклатуры;
				ВыбраннаяФорма=Метаданные.Справочники.ЯССМ_ОбъектыНоменклатуры.Формы.ФормаЭлемента;			
			КонецЕсли; 	
		КонецЕсли;
	КонецЕсли; 
	Если ТипЗнч(Источник)=Тип("ОбработкаМенеджер.ПодборСерийВДокументы") Тогда
		
	КонецЕсли;
	
	
	
