	Если Не ЗначениеЗаполнено(Свойство) Тогда
		Сообщить("Не найден доп. реквизит с именем """ + ИмяДопРеквизита + """");
		Возврат;
	КонецЕсли;
	
	ТаблицаСвойств = Новый ТаблицаЗначений;
	ТаблицаСвойств.Колонки.Добавить("Свойство");
	ТаблицаСвойств.Колонки.Добавить("Значение");
	НоваяСтрока = ТаблицаСвойств.Добавить();
	НоваяСтрока.Свойство = Свойство;
	НоваяСтрока.Значение = Значение;
	УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(Ссылка, ТаблицаСвойств);
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 12.04.2021

Функция ЯчейкаПринадлежитРЦ(Ячейка, ПроверятьТолькоНаРЦСТачпадамиСоСчетчиками = Ложь) Экспорт// --> Начало Лико Ефимов ЕВВ 24.08.2021 
	
	Если НЕ ЗначениеЗаполнено(Ячейка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РабочиеЦентры.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Лико_РабочиеМеста.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьТачпадСоСчетчиком
	|ИЗ
	|	Справочник.РабочиеЦентры КАК РабочиеЦентры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_РабочиеМеста КАК Лико_РабочиеМеста
	|		ПО РабочиеЦентры.Ссылка = Лико_РабочиеМеста.ТСРабочийЦентр
	|			И (Лико_РабочиеМеста.ТСНомерПортаOwen <> 0)
	|			И (НЕ Лико_РабочиеМеста.ПометкаУдаления)
	|ГДЕ
	|	РабочиеЦентры.ЛикоЯчейка = &ЛикоЯчейка
	|	И НЕ РабочиеЦентры.ВидРабочегоЦентра В (&ВидыРЦИсключения)
	|	И РабочиеЦентры.ЛикоЯчейка <> ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	РабочиеЦентры.Ссылка,
	|	ВЫБОР
	|		КОГДА Лико_РабочиеМеста.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("ЛикоЯчейка", Ячейка);
	Запрос.УстановитьПараметр("ВидыРЦИсключения", Лико_Дополнительно.СформироватьМассивИсключенийВидовРЦДляПоискаЯчеекРЦ());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Если ПроверятьТолькоНаРЦСТачпадамиСоСчетчиками И НЕ Выборка.ЕстьТачпадСоСчетчиком Тогда
				Возврат Неопределено;
			Иначе
				Возврат Выборка.Ссылка;
			КонецЕсли;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 24.08.2021 

Функция СформироватьМассивИсключенийВидовРЦДляПоискаЯчеекРЦ() Экспорт // --> Начало Лико Ефимов ЕВВ 27.08.2021
	
	Массив = Новый Массив;
	Массив.Добавить(Справочники.ВидыРабочихЦентров.Прочее);
	Массив.Добавить(Справочники.ВидыРабочихЦентров.ГравировальныйУчасток);
	
	Возврат Массив;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 27.08.2021 

