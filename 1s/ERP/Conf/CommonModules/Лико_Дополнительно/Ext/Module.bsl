Процедура ДобавитьЭтапПроизводстваВКонецПлана(Этап, РабочийЦентр, ЗаказКлиента, НомерПроката = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Если НомерПроката = Неопределено Тогда
		НомерПроката = Этап.НомерПроката;
	КонецЕсли;
	
	Подразделение = РабочийЦентр.ВидРабочегоЦентра.Подразделение;
	РеквизитыРЦ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РабочийЦентр, "ВидРабочегоЦентра,КоэффициентВремениРаботы,Лико_КоэффициентВремениПодготовки");
	Если РеквизитыРЦ.Лико_КоэффициентВремениПодготовки = 0 Тогда
		РеквизитыРЦ.Лико_КоэффициентВремениПодготовки = РеквизитыРЦ.КоэффициентВремениРаботы;
	КонецЕсли;
	//+ Лико m.shenderov 13.09.2021
	//Пока для гравировального участка ставим 60 мин.
	Если РеквизитыРЦ.ВидРабочегоЦентра=Справочники.ВидыРабочихЦентров.ГравировальныйУчасток Тогда 
		ПродолжительностьМинут=60;
		ПродолжительностьПодготовкиМинут = ПродолжительностьМинут;
	Иначе
	//- Лико m.shenderov 13.09.2021
		ПараметрыРЦ = Лико_Планирование.ПараметрыПоРЦ(Этап, РабочийЦентр, ЗаказКлиента, НомерПроката);
		Если ЗначениеЗаполнено(ПараметрыРЦ) Тогда
			ПродолжительностьМинут = ПараметрыРЦ.Время * РеквизитыРЦ.КоэффициентВремениРаботы;
			ПродолжительностьПодготовкиМинут = ПараметрыРЦ.Время * РеквизитыРЦ.Лико_КоэффициентВремениПодготовки;
		Иначе
			ПродолжительностьМинут = Этап.КоэффициентМаршрутнойКарты * 60;
			ПродолжительностьПодготовкиМинут = ПродолжительностьМинут;
		КонецЕсли;
	КонецЕсли;
	
	// Проверим, что этапа сейчас нет в плане
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПооперационноеРасписание2_2.Этап КАК Этап
		|ИЗ
		|	РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2
		|ГДЕ
		|	ПооперационноеРасписание2_2.Этап = &Этап";
	Запрос.УстановитьПараметр("Этап", Этап);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		// Этап производства уже есть в плане, ничего не делаем
		Возврат;
	КонецЕсли;

	СтруктураОкончанийПредыдущейСтроки = НайтиОкончаниеПоследнейЗаписиПланаПоРЦ(РабочийЦентр);
	МенеджерЗаписи = РегистрыСведений.ПооперационноеРасписание2_2.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Этап = Этап;
	МенеджерЗаписи.Операция = ПолучитьТехнологическуюОперациюДляРабочегоЦентра(РабочийЦентр, Подразделение);
	МенеджерЗаписи.ИдентификаторОперации = 1;
	МенеджерЗаписи.НомерПартии = 1;
	МенеджерЗаписи.РабочийЦентр = РабочийЦентр;
	МенеджерЗаписи.ЭтоУдалениеОперации = Ложь;
	МенеджерЗаписи.Начало = СтруктураОкончанийПредыдущейСтроки.Окончание;
	МенеджерЗаписи.Окончание = МенеджерЗаписи.Начало + ПродолжительностьМинут * 60;
	МенеджерЗаписи.ВремяПлан = МенеджерЗаписи.Окончание - МенеджерЗаписи.Начало;
	МенеджерЗаписи.КоличествоПартии = 1;
	МенеджерЗаписи.Коэффициент = 1;
	МенеджерЗаписи.МожноВыполнять = 1;
	МенеджерЗаписи.Подразделение = Подразделение;
	МенеджерЗаписи.ЛеваяГраница = СтруктураОкончанийПредыдущейСтроки.ПраваяГраница;
	МенеджерЗаписи.ПраваяГраница = МенеджерЗаписи.ЛеваяГраница + ПродолжительностьПодготовкиМинут * 60;
	МенеджерЗаписи.ДлительностьИнтервала = МенеджерЗаписи.ПраваяГраница - МенеджерЗаписи.ЛеваяГраница;
	МенеджерЗаписи.Моделирование = Ложь;
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		Сообщить("Не удалось добавить в план этап """ + Этап + """: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Функция НайтиЭтапВСвободныхПоЗаказуИНомеруПроката(Заказ, НомерПроката) Экспорт // --> Начало Лико Ефимов ЕВВ 21.01.2018
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭтапПроизводства2_2.Ссылка КАК Этап,
	|	ВЫБОР
	|		КОГДА ПооперационноеРасписание2_2ИщемЭтап.Этап ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтапЕстьВПлане
	|ИЗ
	|	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2ИщемЭтап
	|		ПО ЭтапПроизводства2_2.Ссылка = ПооперационноеРасписание2_2ИщемЭтап.Этап
	|ГДЕ
	|	ЭтапПроизводства2_2.Лико_ЗаказКлиента = &Заказ
	|	И ЭтапПроизводства2_2.НомерПроката = &НомерПроката
	|	И ЭтапПроизводства2_2.Проведен";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если НЕ ВыборкаДетальныеЗаписи.ЭтапЕстьВПлане Тогда
			Возврат ВыборкаДетальныеЗаписи.Этап;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 21.01.2018

Функция НайтиОкончаниеПоследнейЗаписиПланаПоРЦ(РабочийЦентр) Экспорт // --> Начало Лико Ефимов ЕВВ 21.01.2018

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПооперационноеРасписание2_2.Окончание КАК Окончание,
	|	ПооперационноеРасписание2_2.ПраваяГраница КАК ПраваяГраница
	|ИЗ
	|	РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2
	|ГДЕ
	|	ПооперационноеРасписание2_2.РабочийЦентр = &РабочийЦентр
	|	И НЕ ПооперационноеРасписание2_2.ЭтоУдалениеОперации
	|
	|УПОРЯДОЧИТЬ ПО
	|	Окончание УБЫВ";
	
	Запрос.УстановитьПараметр("РабочийЦентр", РабочийЦентр);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ТекущаяДата = ТекущаяДата();
	СтруктураВозврата = Новый Структура("Окончание,ПраваяГраница", ТекущаяДата, ТекущаяДата);
	
	Если Выборка.Следующий() Тогда
		СтруктураВозврата.Окончание = Макс(Выборка.Окончание, ТекущаяДата);
		СтруктураВозврата.ПраваяГраница = Макс(Выборка.ПраваяГраница, ТекущаяДата);
		Возврат СтруктураВозврата;
	Иначе
		Возврат СтруктураВозврата;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 21.01.2018

Процедура ПересчитатьМассивРЦВПлане(МассивРЦ) Экспорт
	
	Попытка
		Если МассивРЦ.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		ИмяФайла = ПолучитьИмяВременногоФайла();
		ВнОбработка = Лико_Дополнительно.НайтиДополнительнуюОбработкуПоИмениОбъекта("Лико_ПланированиеРабочихЦентровЕРП");
		ДвоичныеДанные = ВнОбработка.ХранилищеОбработки.Получить();
		ДвоичныеДанные.Записать(ИмяФайла);
		ВнешняяОбработкаПлан = ВнешниеОбработки.Создать(ИмяФайла, Ложь);
		ВнешняяОбработкаПлан.ПересчитатьМассивРЦВПлане(МассивРЦ);
		УдалитьФайлы(ИмяФайла);
		а=0;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Функция УдалитьЭтапПроизводстваИзПлана(Этап, Комментарий = "", ПересчитыватьРЦ = Истина, ЭтоАннулированиеЗаказа = Ложь, ДобавитьВКонецПлана = Ложь, ИзОчередиКУдалению = Ложь, ОтметитьВыполнение = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		НовыйСтатус = Неопределено;
		Если НЕ ЭтоАннулированиеЗаказа И Этап.Статус = Перечисления.СтатусыЭтаповПроизводства2_2.Завершен И НЕ ОтметитьВыполнение Тогда
			НовыйСтатус = Перечисления.СтатусыЭтаповПроизводства2_2.Начат;
		ИначеЕсли (ЭтоАннулированиеЗаказа ИЛИ ОтметитьВыполнение)
			И Этап.Статус <> Перечисления.СтатусыЭтаповПроизводства2_2.Завершен Тогда
			НовыйСтатус = Перечисления.СтатусыЭтаповПроизводства2_2.Завершен;
		КонецЕсли;
			
		Если ЗначениеЗаполнено(НовыйСтатус) Тогда	
			ЭтапОбъект = Этап.ПолучитьОбъект();
			ЭтапОбъект.Статус = НовыйСтатус;
			ЭтапОбъект.Комментарий = ?(ЗначениеЗаполнено(ЭтапОбъект.Комментарий), Символы.ПС, "") + "При удалении этапа из плана у документа изменен статус";
			ЭтапОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПооперационноеРасписание2_2.Этап КАК Этап,
	|	ПооперационноеРасписание2_2.Операция КАК Операция,
	|	ПооперационноеРасписание2_2.ИдентификаторОперации КАК ИдентификаторОперации,
	|	ПооперационноеРасписание2_2.НомерПартии КАК НомерПартии,
	|	ПооперационноеРасписание2_2.РабочийЦентр КАК РабочийЦентр,
	|	ПооперационноеРасписание2_2.МодельРасписания КАК МодельРасписания,
	|	ПооперационноеРасписание2_2.МодельПланирования КАК МодельПланирования,
	|	ПооперационноеРасписание2_2.ЭтоУдалениеОперации КАК ЭтоУдалениеОперации,
	|	ПооперационноеРасписание2_2.Начало КАК Начало,
	|	ПооперационноеРасписание2_2.Окончание КАК Окончание,
	|	ПооперационноеРасписание2_2.ТактПараллельнойЗагрузки КАК ТактПараллельнойЗагрузки,
	|	ПооперационноеРасписание2_2.Моделирование КАК Моделирование
	|ИЗ
	|	РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2
	|ГДЕ
	|	ПооперационноеРасписание2_2.Этап = &Этап
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПооперационноеРасписание2_2.Моделирование УБЫВ";
	
	Запрос.УстановитьПараметр("Этап", Этап);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.Моделирование Тогда
			// В данный момент идет планирование, удалять записи нельзя. Нужно добавить запись в очередь к удалению
			МенеджерЗаписи = РегистрыСведений.Лико_ОчередьЭтаповДляУдаленияИзПлана.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Этап = Этап;
			МенеджерЗаписи.Комментарий = Комментарий;
			МенеджерЗаписи.ДобавитьВКонецПлана = ДобавитьВКонецПлана;
			МенеджерЗаписи.ОтметитьВыполнение = ОтметитьВыполнение;
			Попытка
				МенеджерЗаписи.Записать(Истина);
			Исключение
			КонецПопытки;
			
			Возврат Ложь;
		ИначеЕсли ОтметитьВыполнение Тогда
			ОтметитьВыполнениеЭтапаПлана(ВыборкаДетальныеЗаписи);
		Иначе
			// Убираем запись
			МенеджерЗаписи = РегистрыСведений.ПооперационноеРасписание2_2.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи);
			МенеджерЗаписи.Прочитать();
			Попытка
				МенеджерЗаписи.Удалить();	
			Исключение
			КонецПопытки;
			Если ДобавитьВКонецПлана Тогда
				ДобавитьЭтапПроизводстваВКонецПлана(Этап, ВыборкаДетальныеЗаписи.РабочийЦентр, Этап.Лико_ЗаказКлиента);
			КонецЕсли;
			МассивРЦ = Новый Массив;
			МассивРЦ.Добавить(ВыборкаДетальныеЗаписи.РабочийЦентр);
			Если ПересчитыватьРЦ Тогда
				ПересчитатьМассивРЦВПлане(МассивРЦ);
			КонецЕсли;
			
			Если ЭтоАннулированиеЗаказа И НЕ ДобавитьВКонецПлана И НЕ ИзОчередиКУдалению Тогда
				// Несмотря на то, что запись получилось убрать, все равно добавим ее в регистр очереди к удалению (были случаи, когда заказ не уходил из плана)
				МенеджерЗаписи = РегистрыСведений.Лико_ОчередьЭтаповДляУдаленияИзПлана.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Этап = Этап;
				МенеджерЗаписи.Комментарий = Комментарий;
				МенеджерЗаписи.ДобавитьВКонецПлана = ДобавитьВКонецПлана;
				Попытка
					МенеджерЗаписи.Записать(Истина);
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Сюда заходит обработка "Планирование рабочих центров" в момент сохранения плана в регистр в том случае, если поменялся рабочий центр
//
// Параметры:
//  Заказ - Документ.ЗаказКлиента - Заказ, на основании которого создан этап
//  Этап - Документ.ЭтапПроизводства2_2 - Этап производства, для которого поменялся рабочий центр
//  НомерПроката - Число - реквизит НомерПроката из документа Этап
//  РЦНовый - СправочникСсылка.РабочиеЦентры, Строка - Новый рабочий центр. Может быть равен строке "Свободный" или "Снятый" - это значит, что он удаляется из регистра ПооперационноеРасписание2_2
//  РЦСтарый - СправочникСсылка.РабочиеЦентры, Неопределено - Старый рабочий центр. Если этап поставили из свободных или снятых, то равен Неопределено
//
Процедура ДействияПослеИзмененияРабочегоЦентраЭтапа(Заказ, Этап, НомерПроката, РЦНовый, РЦСтарый = Неопределено) Экспорт // --> Начало Лико Ефимов ЕВВ 06.02.2018
	Структура = Новый Структура;
	Структура.Вставить("ЗаказКлиента",Заказ);
	Структура.Вставить("НомерПроката",НомерПроката);
	Структура.Вставить("РабочийЦентр",РЦНовый);
	
	Документы.Лико_ПодготовкаМатериалов.ФормированиеДокументаПодготовкаМатериаловПриПланированииРЦ(Структура);
	
	//+ Лико m.shenderov 15.02.2018
	АктуализацияРезерваМатериаловПоЗаказу(Заказ);
	//- Лико m.shenderov 15.02.2018
	
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 06.02.2018

