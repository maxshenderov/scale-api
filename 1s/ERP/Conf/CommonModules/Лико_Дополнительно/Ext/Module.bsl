//Функция проверяет значение свойства у родителей справочника.
//
//Параметры:
//  СправочникСсылка 	- СправочникСсылка 	- Ссылка, для которой необходимо проверить значение свойства у родителя.
//  ИмяСвойства 		- Строка 			- Имя свойства.
//  ЗначениеСвойства 	- Булево 			- Значение свойства. 
//
//  Возвращаемое значение:
//     Булево. 
//
Функция ПроверкаЗначенияСвойстваУРодителей(Справочникссылка,ИмяСвойства,ЗначениеСвойства=Истина)  Экспорт 
	ИмяСправочника=Справочникссылка.метаданные().Имя;
	Если  Не ЗначениеЗаполнено(СправочникСсылка) Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	Уровень = СправочникСсылка.Уровень();
	Объединить 	= "";
	Родитель 	= "";
	Текст 		= "";
	// --> Начало Лико Ефимов ЕВВ 30.08.2017
	// Уровень у элемента, у которого нет родителя = 0, поэтому код не отрабатывал
	//Для Номер = 1 По Уровень Цикл
	//Родитель = Родитель + ".Родитель";
	//Если Номер <> 1 Тогда
	Для Номер = 0 По Уровень Цикл
		Родитель = Родитель + ".Родитель";
		Если Номер <> 0 Тогда
			// <-- Конец Лико Ефимов ЕВВ 30.08.2017
			Объединить = "
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|";
		КонецЕсли;
		Текст = Текст + Объединить + "
		|ВЫБРАТЬ "+
		ИмяСправочника + Родитель + " КАК Родитель
		|	ИЗ
		|		Справочник."+ИмяСправочника+" КАК "+ИмяСправочника+"
		|	ГДЕ "+
		ИмяСправочника+ Родитель+"."+ИмяСвойства+"=&ЗначениеСвойства и "+
		ИмяСправочника+".Ссылка = &Элемент";
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	База.Родитель КАК Родитель
	|ИЗ
	|	(" + Текст + ") КАК База";
	Запрос.УстановитьПараметр("Элемент", Справочникссылка);
	Запрос.УстановитьПараметр("ЗначениеСвойства", ЗначениеСвойства);
	
	
	Возврат Не Запрос.Выполнить().Пустой();
	
	
КонецФункции //ПроверкаНаличияСвойстваУРодителей

Процедура АктуализацияРезерваМатериаловПоЗаказу(Заказ) Экспорт //+Лико m.shenderov 15.02.2018
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПодготовкаМатериалов.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лико_ПодготовкаМатериалов КАК Лико_ПодготовкаМатериалов
	|ГДЕ
	|	Лико_ПодготовкаМатериалов.ЗаказКлиента = &Заказ
	|	И Лико_ПодготовкаМатериалов.Проведен
	|	И НЕ Лико_ПодготовкаМатериалов.ПометкаУдаления";
	Запрос.УстановитьПараметр("Заказ",Заказ );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ДокОбъект=Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		КонецПопытки;
	КонецЦикла; 
	
	УстановитьПривилегированныйРежим(Ложь);
	
	
	
КонецПроцедуры //-Лико m.shenderov 15.02.2018




