Функция ТабельныйНомерФизЛица(ФизЛицо, Организация = Неопределено) Экспорт //+Лико m.shenderov 04.05.2018

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПОДСТРОКА(Сотрудники.Код, 5, 6) КАК ТабельныйНомер,
	|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	НЕ Сотрудники.ВАрхиве
	|	И НЕ Сотрудники.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА &Организация = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Сотрудники.ГоловнаяОрганизация = &Организация
	|		КОНЕЦ
	|	И Сотрудники.ФизическоеЛицо = &ФизическоеЛицо
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТабельныйНомер УБЫВ";
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизЛицо);
	Если ЗначениеЗаполнено(Организация) Тогда
		Запрос.УстановитьПараметр("Организация", Организация);
	Иначе
		Запрос.УстановитьПараметр("Организация", Неопределено);
	КонецЕсли;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Формат(Число(Выборка.ТабельныйНомер),"ЧГ=");	
	Иначе
		Запрос.УстановитьПараметр("Организация", Неопределено);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Формат(Число(Выборка.ТабельныйНомер),"ЧГ=");
		Иначе
			Возврат Неопределено;
		КонецЕсли; 
	КонецЕсли; 
	
	
