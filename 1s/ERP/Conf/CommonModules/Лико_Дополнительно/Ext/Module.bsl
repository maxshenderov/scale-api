	//глКонтрагент-продавец
	Организация=Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОрганизацииДополнительныеРеквизиты.Ссылка КАК Организация
	|ИЗ
	|	Справочник.Организации.ДополнительныеРеквизиты КАК ОрганизацииДополнительныеРеквизиты
	|ГДЕ
	|	ОрганизацииДополнительныеРеквизиты.Значение = &Контрагент
	|	И ОрганизацииДополнительныеРеквизиты.Свойство.Имя = &Имя";
	Запрос.УстановитьПараметр("Имя","КонтрагентОрганизации_8e3f712fdca94791a890e1aa7853a0d2" );
	Запрос.УстановитьПараметр("Контрагент",глКонтрагент );                                                                            
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Организация=Выборка.Организация; 
	КонецЦикла;	
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Контрагент=УправлениеСвойствами.ЗначениеСвойства(глОрганизация,"КонтрагентОрганизации_8e3f712fdca94791a890e1aa7853a0d2");
