	КонецЕсли;
	
	Отбор = Новый Структура("Номенклатура,Характеристика");
	Пока Выборка.Следующий() Цикл
		Если Выборка[ПолеЦены] <> 0 Тогда
			ЗаполнитьЗначенияСвойств(Отбор, Выборка);
			НайденныеСтроки = ТЧ.НайтиСтроки(Отбор);
			Для каждого СтрокаТовары из НайденныеСтроки Цикл
				СтрокаТовары.Цена = 1.01 * Выборка[ПолеЦены];
				
				СтруктураДействий = Новый Структура;
