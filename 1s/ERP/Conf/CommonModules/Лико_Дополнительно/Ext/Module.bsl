Функция УстановитьПараметрСеансаЛико_РабочееМесто(ИмяПараметра, УстановленныеПараметры, ИмяКомпьютера = Неопределено) Экспорт // --> Начало Лико Ефимов ЕВВ 31.08.2017
	
	Если ИмяПараметра = "Лико_РабочееМесто" Тогда
		
		Лико_РабочееМесто = Неопределено;
		Если ИмяКомпьютера = Неопределено Тогда
			ИмяКомпьютера = ИмяКомпьютера();
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_РабочиеМеста.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Лико_РабочиеМеста КАК Лико_РабочиеМеста
		|ГДЕ
		|	НЕ Лико_РабочиеМеста.ПометкаУдаления
		|	И Лико_РабочиеМеста.ИмяКомпьютера = &ИмяКомпьютера
		|	И Лико_РабочиеМеста.Пользователь = &Пользователь
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Лико_РабочиеМеста.Ссылка
		|ИЗ
		|	Справочник.Лико_РабочиеМеста КАК Лико_РабочиеМеста
		|ГДЕ
		|	НЕ Лико_РабочиеМеста.ПометкаУдаления
		|	И Лико_РабочиеМеста.ИмяКомпьютера = """"
		|	И Лико_РабочиеМеста.Пользователь = &Пользователь
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Лико_РабочиеМеста.Ссылка
		|ИЗ
		|	Справочник.Лико_РабочиеМеста КАК Лико_РабочиеМеста
		|ГДЕ
