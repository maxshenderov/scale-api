// Печатает стикер объекта номенклатуры
// Параметр Количество используется в том случае, когда необходимо распечатать стикер с количеством, отличным от актуального
// К примеру, если длина роля 2 000, а печать необходима для 1 500.
Функция ПараметрыПечатиОбъектаНоменклатуры(ОбъектНоменклатуры, КоличествоЭкземпляров=1, БыстраяПечать=Ложь, ПечатьОтветственногоИНомерЗаказа=Истина, Количество=0,ИнфоКамф=Неопределено,ОбъектНабораПараметров=Неопределено,ИмяПринтера="") Экспорт
     УстановитьПривилегированныйРежим(Истина);
	//!ЯССМ_ПечататьКороткийШтрихКодОбъекта = ЯС_Общие.ПолучитьСвойствоОбъекта("ЯССМ_ПечататьКороткийШтрихКодОбъекта",ОбъектНабораПараметров , Ложь);
	ЯССМ_ПечататьКороткийШтрихКодОбъекта=Истина;

	ШКСТрокой = "";

	//!Объект = ОбъектНоменклатуры.ПолучитьОбъект();
	//!КоличествоНаПечать = ?(Количество=0, Объект.Количество, Количество);
	//!КоличествоУУНаПечать = ЯССМ_ОбщийМодуль.РассчитатьКоличествоУУ(ОбъектНоменклатуры, КоличествоНаПечать);

	КоличествоНаПечать = ?(Количество=0, ОбъектНоменклатуры.Количество, Количество);
	// начало Лико Ефимов
	Если Количество = -1 Тогда
		КоличествоНаПечать = 0;
	КонецЕсли;
	// конец Лико Ефимов
	КоличествоУУНаПечать=КоличествоНаПечать*ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель;

	Если ЯССМ_ПечататьКороткийШтрихКодОбъекта Тогда
		ШК = Справочники.ЯССМ_ОбъектыНоменклатуры.ПолучитьКороткийШтрихКод(ОбъектНоменклатуры,ШКСтрокой, КоличествоНаПечать); //длина штрихкода - 15
	Иначе
		ШК = Справочники.ЯССМ_ОбъектыНоменклатуры.ПолучитьКороткийШтрихКод(ОбъектНоменклатуры,ШКСтрокой, КоличествоНаПечать); //длина штрихкода - 30
	КонецЕсли;

	НоменклатураОбъект = ОбъектНоменклатуры.Номенклатура;

	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("Ответственный", ?(ПечатьОтветственногоИНомерЗаказа,ФамилияИнициалыФизЛица(ОбъектНоменклатуры.Ответственный), ""));
	//ПараметрыПечати.Вставить("Ответственный",  "");

	Если ЗначениеЗаполнено(ОбъектНоменклатуры.Ответственный) Тогда
		//ДанныеОтветственного = ПолучитьДанныеПоРаботнику(Объект.Ответственный.Ссылка, ТекущаяДата());
		ПараметрыПечати.Вставить("ТабельныйНомерОтветственного", ?(ПечатьОтветственногоИНомерЗаказа, ТабельныйНомерФизЛица(ОбъектНоменклатуры.Ответственный), ""));
	КонецЕсли;
	ВидКонтакта="";
	Попытка
		ВидКонтакта=СтрЗаменить(ОбъектНоменклатуры.ВидКонтактаСПищевойПродукцией.Наименование,"Категория","Кат");
		Если ЗначениеЗаполнено(ВидКонтакта) Тогда
			ВидКонтакта=" ("+ВидКонтакта+")";
		КонецЕсли;

	Исключение
		//ОписаниеОшибки()
	КонецПопытки;
	ПараметрыПечати.Вставить("НомерЗаказа", ""+Формат(ОбъектНоменклатуры.НомерЗаказаКлиента, "ЧГ=0")+?(ОбъектНоменклатуры.НомерБланка<>0, "/"+ОбъектНоменклатуры.НомерБланка, ""));
