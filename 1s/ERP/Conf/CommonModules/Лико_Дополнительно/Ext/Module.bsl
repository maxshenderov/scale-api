Функция НайтиСерииПоШтрихкоду(Штрихкод) Экспорт // --> Начало Лико Ефимов ЕВВ 27.04.2017
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ШтрихкодыНоменклатуры.Лико_Серия КАК Серия,
	|	ШтрихкодыНоменклатуры.Лико_Серия.Лико_ВладелецКомплекта КАК ВладелецКомплекта
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод";
	
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Новый Массив;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Серия = Выборка.Серия;
		Если ЗначениеЗаполнено(Выборка.ВладелецКомплекта) Тогда
			// Нужно найти остальные серии
			МассивСерий = НайтиСерииПоВладельцуКомплекта(Выборка.ВладелецКомплекта);
		Иначе
			МассивСерий = Новый Массив;
			МассивСерий.Добавить(Серия);
		КонецЕсли;
		Возврат МассивСерий;			
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 27.04.2017

