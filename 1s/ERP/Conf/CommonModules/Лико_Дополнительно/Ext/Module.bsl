	|	Лико_ПараметрыШтампа.ШиринаЭтикетки КАК ШиринаЭтикетки,
	|	Лико_ПараметрыШтампа.ДлинаКольеретки КАК ДлинаКольеретки,
	|	Лико_ПараметрыШтампа.ШиринаКонтрЭтикетки КАК ШиринаКонтрЭтикетки,
	|	Лико_ПараметрыШтампа.ШиринаКольеретки КАК ШиринаКольеретки,
	|	Лико_ПараметрыШтампа.НаправлениеНамотки КАК НаправлениеНамотки,
	|	Лико_ПараметрыШтампа.Цена КАК Цена,
	|	Лико_ПараметрыШтампа.ПорядковыйНомерШтанцыНаВалу КАК ПорядковыйНомерШтанцыНаВалу,
	|	Лико_ПараметрыШтампа.ШиринаПоНожам КАК ШиринаПоНожам,
	|	Лико_ПараметрыШтампа.ИнтервалМеждуРучьями КАК ИнтервалМеждуРучьями,
	|	Лико_ПараметрыШтампа.ИнтервалМеждуЭтикетками КАК ИнтервалМеждуЭтикетками
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|		ПО ЗаказКлиента.ШтампВырубной = Лико_ПараметрыШтампа.Номенклатура
	|ГДЕ
	|	ЗаказКлиента.Ссылка = &ЗаказКлиента";



	Запрос.УстановитьПараметр("ЗаказКлиента", Спецификация);
	Выборка = Запрос.Выполнить().Выбрать();


	//180-33022						- артикул монтажа, соответствует имени TXT файла
	//314.325						- раппорт (флексо) без сжатия
	//308.265						- раппорт (флексо) со сжатием
	//4								- количество ручьев
	//2								- количество этикет в ручье(по развертке)
	//70							- размер этикеты поперёк полотна
	//155							- размер этикеты вдоль полотна
	//3								- шаг по ножам поперёк полотна(расстояние между ручьями)
	//2.162							- шаг по ножам вдоль полотна
	//стар.211-99/133				- текстовое поле информации для нанесения на рельсу(может быть любой) номер штампа + линиатура печати(из 1С)
	//[forms]						- обозначение начала списка форм
	//Yellow-L40489					- элемент списка форм [используемая краска]-[номер формы]
	//Magenta-L40490				- элемент списка форм
	//Cyan-L40491					- элемент списка форм
	//Pn Purple-F40492				- элемент списка форм
	//Холодное тиснение-40482		- элемент списка форм
	//Black-L40493					- элемент списка форм
	//[articles]					- обозначение начала списка артиклей
	//180-3759						- элемент списка артиклей №1 (соответствует имени дизайнерского и поделеного файла)
	//180-3713						- элемент списка артиклей №2
	//180-33185						- элемент списка артиклей №3
	//180-16965						- элемент списка артиклей №4
	//[montage]						- обозначение начала монтажной схемы
	//1,2,3,4						- монтажная схема ввиде номеров списка артиклей через запятую
	//1,2,3,4						- ручьи в схеме идут вертикально

	Если Выборка.Следующий() Тогда

		//Текст = Текст + Формат(НомерЗаказа, "ЧГ=0"); // номер заказа, соответствует имени TXT файла
		Текст = Текст + Спецификация.НомерБезПрефикса; // код спецификации, соответствует имени TXT файла

		Если ЗначениеЗаполнено(Выборка.Z) Тогда

			Z = Выборка.Z;

			Текст = Текст + Символы.ПС + Выборка.Z.Рапорт; // раппорт (флексо) без сжатия
			Текст = Текст + Символы.ПС + Выборка.Z.РапортВ; // раппорт (флексо) со сжатием
		Иначе

			//Если Не ЗначениеЗаполнено(Выборка.ШагПечати) Тогда
			//	РасшифровкаОтказа = РасшифровкаОтказа + Выборка.Штамп+": У штампа не задан шаг печати.";
			//КонецЕсли;
			//Если Не ЗначениеЗаполнено(Выборка.ЭтикетокНаЛисте) Тогда
			//	РасшифровкаОтказа = РасшифровкаОтказа + Выборка.Штамп+": У штампа не задано количество этикеток на листе.";
			//КонецЕсли;
			//
			//ДлинаЭтикеткиСПрипуском = Выборка.ШагПечати/(Выборка.ЭтикетокНаЛисте/Выборка.Ручьи);
			//ZРапорт = Окр(Цел(0.45/ДлинаЭтикеткиСПрипуском)*ДлинаЭтикеткиСПрипуском,3); // длина печати
			ZРапорт = 0;

			Текст = Текст + Символы.ПС + ZРапорт; // раппорт (флексо) без сжатия
			Текст = Текст + Символы.ПС + ZРапорт; // раппорт (флексо) со сжатием
		КонецЕсли;

		////Текст = Текст + Символы.ПС + Выборка.Ручьи; // количество ручьев
		////Текст = Текст + Символы.ПС + Выборка.ЭтикетокНаЛисте; // количество этикет в ручье(по развертке)
		////
		_ручьиПечати=?(Спецификация.РучьиПечатиИндиго,Спецификация.РучьиПечатиИндиго,
		?(ЗначениеЗаполнено(Спецификация.РучьиПечати),Спецификация.РучьиПечати,Спецификация.Ручьи));
		
		_ручьи=Выборка.Ручьи;
		
	
	Если ЗначениеЗаполнено(Спецификация.ЭтикетокНаЛистеИндиго) Тогда
		лЭтикетокНаЛисте = Спецификация.ЭтикетокНаЛистеИндиго;
	Иначе
		лЭтикетокНаЛисте = ?(ЗначениеЗаполнено(Спецификация.ЭтикетокНаЛистеПечати), Спецификация.ЭтикетокНаЛистеПечати, Спецификация.ЭтикетокНаЛисте);
	КонецЕсли;

		
		
		
		//_ручьи=?(_ручьи=Null,0,_ручьи);
		//_ряды=?(Не ЗначениеЗаполнено(Выборка.Ручьи),0,Выборка.ЭтикетокНаЛисте/Выборка.Ручьи);
		_ряды=?(Не ЗначениеЗаполнено(Выборка.Ручьи),0,Выборка.ЭтикетокНаЛисте/Выборка.Ручьи);

		
		Текст = Текст + Символы.ПС + _ручьиПечати; // количество ручьев
		Текст = Текст + Символы.ПС + ?(Не ЗначениеЗаполнено(Выборка.Ручьи),"",_ряды*_ручьиПечати); // количество этикет в ручье(по развертке)



		Текст = Текст + Символы.ПС + Выборка.ШиринаЭтикетки; // размер этикетки поперёк полотна
		Текст = Текст + Символы.ПС + Выборка.ДлинаЭтикетки; // размер этикетки вдоль полотна
		Текст = Текст + Символы.ПС + Выборка.ИнтервалМеждуРучьями; // шаг по ножам поперёк полотна(расстояние между ручьями)
		Текст = Текст + Символы.ПС + Выборка.ИнтервалМеждуЭтикетками; // шаг по ножам вдоль полотна

		Текст = Текст + Символы.ПС + Выборка.Штамп.Артикул; // текстовое поле информации для нанесения на рельсу(может быть любой) номер штампа + линиатура печати(из 1С)

		Текст = Текст + Символы.ПС + "[forms]"; // обозначение начала списка форм

		Для Каждого СтрокаЦвета Из Цвета Цикл
			Если ЗначениеЗаполнено(СтрокаЦвета.Форма) Тогда
				Если СтрокаЦвета.ВидСекции = Справочники.Лико_ВидыСекций.ОфсетнаяПечать Тогда
					Текст = Текст + Символы.ПС 
					+ ?(ЗначениеЗаполнено(СтрокаЦвета.ТипЦвета1), Строка(СтрокаЦвета.ТипЦвета1)+ " ", "") 
					+ ?(ЗначениеЗаполнено(СтрокаЦвета.ТипКраски), Строка(СтрокаЦвета.ТипКраски)+ " ", "") 
					+ ?(ЗначениеЗаполнено(СтрокаЦвета.Название), Строка(СтрокаЦвета.Название), "") 
					+ "-" + СтрокаЦвета.Форма.Код;
				Иначе
					Текст = Текст + Символы.ПС + СтрЗаменить(СтрокаЦвета.Форма.Наименование, "-", "") + "-" + СтрокаЦвета.Форма.Код;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		Текст = Текст + Символы.ПС + "[articles]"; // обозначение начала списка артиклей

		//Если Товары.Количество()>1 Тогда
		//	
		//	Для Каждого СтрокаТовары Из Товары Цикл
		//		Текст = Текст + Символы.ПС + СтрокаТовары.Номенклатура.Артикул; // элемент списка артиклей
		//	КонецЦикла;
		//	
		//	Текст = Текст + Символы.ПС + "[montage]"; // обозначение начала монтажной схемы
		//	
		//	Текст = Текст + Символы.ПС + СформироватьСхемуМонтажаЭтикеток();
		//КонецЕсли;

		Если НомерМонтажа>0 Тогда

			Для Каждого СтрокаСоответствие Из Соответствия Цикл
				Текст = Текст + Символы.ПС + СтрокаСоответствие.Номенклатура.Артикул; // элемент списка артиклей
			КонецЦикла;

			Текст = Текст + Символы.ПС + "[montage]"; // обозначение начала монтажной схемы

			Текст = Текст + Символы.ПС + СформироватьСхемуМонтажаЭтикеток(Схема, НомерМонтажа);

		КонецЕсли;

	Иначе

		Отказ = Истина;

	КонецЕсли;

	Возврат Текст;
	
КонецФункции //СформироватьТекстДляСкрипта Экспорт

Функция СформироватьСхемуМонтажаЭтикеток(Схема, НомерТекущегоМонтажа)
	
	НомерТекущейСтроки = 1;
	СтрокаМонтаж = "";
	
	Для Каждого СтрокаСхемы Из Схема Цикл
		
		ИндексСтроки = СтрокаСхемы.ИндексСтроки;
		
		НомерМонтажа = Цел(ИндексСтроки/1000000);
		ИндексСтроки = ИндексСтроки - НомерМонтажа*1000000; // индекс без монтажа
		
		Если НомерМонтажа<>НомерТекущегоМонтажа Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтрокиМонтажа = Цел(ИндексСтроки/1000);
		ИндексСтроки = ИндексСтроки - НомерСтрокиМонтажа*1000; // индекс без строки
		
		НомерКолонкиМонтажа = ИндексСтроки;
		
		Если НомерТекущейСтроки<>НомерСтрокиМонтажа Тогда
			
			// удалим запятую
			СтрокаМонтаж = Лев(СтрокаМонтаж, СтрДлина(СтрокаМонтаж)-1);
			
			// перейдем на новую строку
			СтрокаМонтаж = СтрокаМонтаж + Символы.ПС;
			НомерТекущейСтроки = НомерСтрокиМонтажа;
			
		КонецЕсли;
		
		СтрокаМонтаж = СтрокаМонтаж + СтрокаСхемы.ИндексНоменклатуры + ",";
		
	КонецЦикла;
	
	Возврат Лев(СтрокаМонтаж, СтрДлина(СтрокаМонтаж)-1);
	
КонецФункции //СформироватьСхемуМонтажаЭтикеток

Функция НайтиИлиСоздатьДоговорНаОтветственноеХранение(Дата, Контрагент, Организация, ВалютаВзаиморасчетов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
	|	И ДоговорыКонтрагентов.Контрагент = &Контрагент
	|	И ДоговорыКонтрагентов.Организация = &Организация
	|	И ДоговорыКонтрагентов.ХозяйственнаяОперация = &ХозяйственнаяОперация
	|	И ДоговорыКонтрагентов.ТипДоговора = &ТипДоговора
	|	И ДоговорыКонтрагентов.ВалютаВзаиморасчетов = &ВалютаВзаиморасчетов
	|	И ДоговорыКонтрагентов.Статус = &Статус";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыДоговоровКонтрагентов.Действует);
	Запрос.УстановитьПараметр("ТипДоговора", Перечисления.ТипыДоговоров.СПоклажедателем);
	Запрос.УстановитьПараметр("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.ПриемНаХранениеСПравомПродажи);
	Запрос.УстановитьПараметр("ВалютаВзаиморасчетов", ВалютаВзаиморасчетов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		НовыйДоговор.Наименование = "Договор с поклажедателем";
		НовыйДоговор.ВалютаВзаиморасчетов = ВалютаВзаиморасчетов;
		НовыйДоговор.Организация = Организация;
		НовыйДоговор.Контрагент = Контрагент;
		НовыйДоговор.НаименованиеДляПечати = НовыйДоговор.Наименование;
		НовыйДоговор.Партнер = НовыйДоговор.Контрагент.Партнер;
		//НовыйДоговор.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВРубляхОплатаВРублях;
		НовыйДоговор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
		НовыйДоговор.Согласован = Истина;
		НовыйДоговор.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
		НовыйДоговор.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПриемНаХранениеСПравомПродажи;
		НовыйДоговор.ТипДоговора = Перечисления.ТипыДоговоров.СПоклажедателем;
		НовыйДоговор.ГруппаФинансовогоУчета = Лико_Дополнительно.НайтиГруппуФинУчетаПоВалютеИНалогообложению(НовыйДоговор.ВалютаВзаиморасчетов, Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);
		НовыйДоговор.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПоставщику;
		Если Дата >= Дата('20260101') Тогда
			НовыйДоговор.СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС22);
		ИначеЕсли Дата >= Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияСтавкиНДС20.ЗначениеПараметра Тогда
			НовыйДоговор.СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС20);
		Иначе
			НовыйДоговор.СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС18);
		КонецЕсли;
		НовыйДоговор.ВариантОформленияЗакупок = Перечисления.ВариантыОформленияЗакупок.НеРазделять;
		НовыйДоговор.НалогообложениеНДСОпределяетсяВДокументе = Истина;
		НовыйДоговор.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.ПоДоговорамБезЗаказовИНакладных;
		Попытка
			НовыйДоговор.Записать();
			Возврат НовыйДоговор.Ссылка;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	
КонецФункции

Функция НайтиИлиСоздатьВидЦеныПоставщика(Партнер, Валюта, ЦенаВключаетНДС) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыЦенПоставщиков.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыЦенПоставщиков КАК ВидыЦенПоставщиков
	|ГДЕ
	|	ВидыЦенПоставщиков.Владелец = &Партнер
	|	И ВидыЦенПоставщиков.Валюта = &Валюта
	|	И ВидыЦенПоставщиков.ЦенаВключаетНДС = &ЦенаВключаетНДС
	|	И НЕ ВидыЦенПоставщиков.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.УстановитьПараметр("ЦенаВключаетНДС", ЦенаВключаетНДС);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		НовыйВидЦенПоставщика = Справочники.ВидыЦенПоставщиков.СоздатьЭлемент();
		НовыйВидЦенПоставщика.Владелец = Партнер;
		НовыйВидЦенПоставщика.Валюта = Валюта;
		НовыйВидЦенПоставщика.ЦенаВключаетНДС = ЦенаВключаетНДС;
		НовыйВидЦенПоставщика.Наименование = "" + НовыйВидЦенПоставщика.Владелец + " " + НовыйВидЦенПоставщика.Валюта + ?(НовыйВидЦенПоставщика.ЦенаВключаетНДС, " цена включает НДС", " цена не включает НДС");
		Попытка
			НовыйВидЦенПоставщика.Записать();
			Возврат НовыйВидЦенПоставщика.Ссылка;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьОрганизациюВладельцаТовара(Номенклатура, Характеристика, Склад, Дата, Ссылка = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТоварыОрганизаций.Период КАК Период,
		|	ТоварыОрганизаций.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	ТоварыОрганизаций.Организация КАК Организация
		|ИЗ
		|	РегистрНакопления.ТоварыОрганизаций КАК ТоварыОрганизаций
		|ГДЕ
		|	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
		|	И ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Характеристика = &Характеристика
		|	И ТоварыОрганизаций.АналитикаУчетаНоменклатуры.СкладскаяТерритория = &Склад
		|	И ТоварыОрганизаций.Период <= &Дата
		|	И ТоварыОрганизаций.Регистратор <> &Регистратор
		//|	И ТоварыОрганизаций.Организация <> &ОрганизацияЛикофлекс
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	//Запрос.УстановитьПараметр("ОрганизацияЛикофлекс", Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра); // Ликофлекс не рассматриваем, т.к. продажа с ЛК на ОКИЛ создается позже
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Организация) Тогда
		Возврат ВыборкаДетальныеЗаписи.Организация;
	Иначе                                                                                    
		//// Раз ничего не нашлось, значит скорее всего владелец ОКИЛ, т.к. продажа с ЛК на ОКИЛ еще не создана. Если будут ошибки, то буду менять этот костыль
		//Возврат Справочники.Лико_ПредопределенныеЗначения.ОрганизацияОкил.ЗначениеПараметра; 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура ДобавитьЗаписьВДокументЛико_ДвиженияЗаказаПоЭтапам(ЗаказКлиента,
															ИмяТЧ,
															Количество,
															ИдСтроки,
															Автор,
															Дата,
															Растарка,
															НомерБланка,
															Материал = Неопределено,
															ВидРабочегоМеста = "",
															НомерПриложения = 0,
															ОткудаПередано = "",
															ПараметрыДляВыработкиПеремотки = Неопределено
															) Экспорт 

	УстановитьПривилегированныйРежим(Истина);

	ПлощадкаЗаказа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказКлиента, "Площадка");
	Если НЕ (ПлощадкаЗаказа = Справочники.Лико_Площадки.Ликофлекс 
			ИЛИ ПлощадкаЗаказа = Справочники.Лико_Площадки.Линкс
			ИЛИ ПлощадкаЗаказа = Справочники.Лико_Площадки.ИксПак
			)
		Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросДЗПЭ = Новый Запрос;
	ЗапросДЗПЭ.Текст = 
	"ВЫБРАТЬ
	|	Лико_ДвиженияЗаказаПоЭтапам.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лико_ДвиженияЗаказаПоЭтапам КАК Лико_ДвиженияЗаказаПоЭтапам
	|ГДЕ
	|	Лико_ДвиженияЗаказаПоЭтапам.ЗаказКлиента = &ЗаказКлиента
	|	И НЕ Лико_ДвиженияЗаказаПоЭтапам.ПометкаУдаления";
	
	ЗапросДЗПЭ.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	ВыборкаДЗПЭ = ЗапросДЗПЭ.Выполнить().Выбрать();
	Если ВыборкаДЗПЭ.Следующий() Тогда
		ДокОбъектДЗПЭ = ВыборкаДЗПЭ.Ссылка.ПолучитьОбъект();
	Иначе
		ДокОбъектДЗПЭ = Документы.Лико_ДвиженияЗаказаПоЭтапам.СоздатьДокумент();
		ДокОбъектДЗПЭ.Дата = Дата;
		ДокОбъектДЗПЭ.ЗаказКлиента = ЗаказКлиента;
		ДокОбъектДЗПЭ.Автор = Автор;
	КонецЕсли;
	НоваяСтрокаДЗПЭ = ДокОбъектДЗПЭ[ИмяТЧ].Добавить();
	НоваяСтрокаДЗПЭ.Дата = Дата;
	НоваяСтрокаДЗПЭ.Автор = Автор;
	НоваяСтрокаДЗПЭ.Количество = Количество;
	НоваяСтрокаДЗПЭ.ИдентификаторСтроки = ИдСтроки;
	НоваяСтрокаДЗПЭ.Растарка = Растарка;
	НоваяСтрокаДЗПЭ.НомерБланка = НомерБланка;
	НоваяСтрокаДЗПЭ.НомерПриложения = НомерПриложения;
	НоваяСтрокаДЗПЭ.Материал = Материал;
	НоваяСтрокаДЗПЭ.ВидРабочегоМеста = ВидРабочегоМеста;
	Если ДокОбъектДЗПЭ.Метаданные().ТабличныеЧасти[ИмяТЧ].Реквизиты.Найти("ОткудаПередано") <> Неопределено Тогда
		НоваяСтрокаДЗПЭ.ОткудаПередано = ОткудаПередано;
	КонецЕсли;
	
	// <-- Начало Лико Яцун С. В. 19.08.2025 
	Если ПараметрыДляВыработкиПеремотки <> Неопределено Тогда
		НоваяСтрокаДЗПЭ.Сотрудник = ПараметрыДляВыработкиПеремотки.Сотрудник;	
		НоваяСтрокаДЗПЭ.Смена = ПараметрыДляВыработкиПеремотки.Смена;	
		НоваяСтрокаДЗПЭ.ТипОперации = ПараметрыДляВыработкиПеремотки.ТипОперацииПеремотки;	
		НоваяСтрокаДЗПЭ.ДвойнаяНика = ПараметрыДляВыработкиПеремотки.ДвойнаяНика;	
		НоваяСтрокаДЗПЭ.КоличествоРучьевПереворота = ПараметрыДляВыработкиПеремотки.КоличествоРучьевПереворота;	
		Если ПараметрыДляВыработкиПеремотки.Свойство("ДокументОснование") Тогда
			НоваяСтрокаДЗПЭ.ДокументОснование = ПараметрыДляВыработкиПеремотки.ДокументОснование;	
			НоваяСтрокаДЗПЭ.РабочийЦентр = ПараметрыДляВыработкиПеремотки.РабочийЦентр;
			//Первая перемотка на РЦ должна быть с настройкой
			Если НЕ ЗначениеЗаполнено(ДокОбъектДЗПЭ.Ссылка) Тогда
				ПараметрыДляВыработкиПеремотки.КоличествоНастроек = 1;
			Иначе
				ПеремоткаНаРЦ = ДокОбъектДЗПЭ.Перемотка.НайтиСтроки(Новый Структура("РабочийЦентр",ПараметрыДляВыработкиПеремотки.РабочийЦентр));
				Если ПеремоткаНаРЦ.Количество() = 1 Тогда
					ПараметрыДляВыработкиПеремотки.КоличествоНастроек = 1;	
				Иначе
					МинимальнаяДатаПеремотки = Дата('39991231235959');
					Для каждого СтрНаРЦ	из ПеремоткаНаРЦ Цикл
						Если СтрНаРЦ.Дата > Дата И СтрНаРЦ.КоличествоНастроек = 1 Тогда
							СтрНаРЦ.КоличествоНастроек = 0;
							Документы.Лико_ДвиженияЗаказаПоЭтапам.ПересчитатьВыработкуПеремотки(ЗаказКлиента,СтрНаРЦ);
						КонецЕсли;
						Если СтрНаРЦ.ИдентификаторСтроки <> ИдСтроки Тогда
							МинимальнаяДатаПеремотки = ?(МинимальнаяДатаПеремотки > СтрНаРЦ.Дата, СтрНаРЦ.Дата, МинимальнаяДатаПеремотки);
						КонецЕсли;
					КонецЦикла;
					Если МинимальнаяДатаПеремотки > Дата Тогда
						ПараметрыДляВыработкиПеремотки.КоличествоНастроек = 1;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		НоваяСтрокаДЗПЭ.КоличествоНастроек = ПараметрыДляВыработкиПеремотки.КоличествоНастроек;
		
		РезультатыРасчетаВыработкиПеремотчиков = Документы.Лико_ДвиженияЗаказаПоЭтапам.РассчитатьВыработкуПеремотчиков(ЗаказКлиента,ПараметрыДляВыработкиПеремотки);
		
		НоваяСтрокаДЗПЭ.КоличествоПМ = РезультатыРасчетаВыработкиПеремотчиков.КоличествоПМ;	
		НоваяСтрокаДЗПЭ.КоличествоКВМ = РезультатыРасчетаВыработкиПеремотчиков.КоличествоКВМ;	
		НоваяСтрокаДЗПЭ.ВремяНастройки = РезультатыРасчетаВыработкиПеремотчиков.ВремяНастройки;	
		НоваяСтрокаДЗПЭ.ВремяОперации = РезультатыРасчетаВыработкиПеремотчиков.ВремяОперации;	
		НоваяСтрокаДЗПЭ.Время = РезультатыРасчетаВыработкиПеремотчиков.Время;
		Если ЗначениеЗаполнено(ПараметрыДляВыработкиПеремотки.ТипОперацииПеремотки) Тогда
			НоваяСтрокаДЗПЭ.Количество = РезультатыРасчетаВыработкиПеремотчиков.КоличествоТысШт;
		КонецЕсли;
		ДокОбъектДЗПЭ[ИмяТЧ].Сортировать("Дата");
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 19.08.2025
	
	Попытка
		ДокОбъектДЗПЭ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Сообщить("Не удалось провести документ Лико_ДвиженияЗаказаПоЭтапам: " + ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры 

