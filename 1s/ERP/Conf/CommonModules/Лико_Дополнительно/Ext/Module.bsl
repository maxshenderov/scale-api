//
Функция ПолучитьЗонуОтгрузкиПоСкладу(Склад) Экспорт // --> Начало Лико Ефимов ЕВВ 18.04.2017 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СкладскиеЯчейки.Ссылка
	|ИЗ
	|	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
	|ГДЕ
	|	СкладскиеЯчейки.Владелец = &Склад
	|	И СкладскиеЯчейки.ТипСкладскойЯчейки = ЗНАЧЕНИЕ(Перечисление.ТипыСкладскихЯчеек.Отгрузка)
	|	И НЕ СкладскиеЯчейки.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	СкладскиеЯчейки.ПорядокОбхода";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 18.04.2017 

// Получает значение предопределенных данных. Использую ее, когда нужно получить значение предопределенных данных на клиенте. 
//
// Параметры:
//  ИмяПредопределенныхДанных - Строка - ровно такая же строка, которую бы писали для получения значения на сервере.
//  Объект - ПроизвольноеЗначение - Объект, из которого будут получать данные. Например, если ИмяПредопределенныхДанных = "Результат.АдресаХранения.Владелец", то системе необходим объект Результат.
//  ИмяОбъекта - Строка - Имя объекта. Для примера выше именем объекта будет строка "Результат".
//
//  Возвращаемое значение:
//      ПроизвольноеЗначение, Неопределено - Значение предопределенных данных. Неопрделено, если не удалось получить значение
//
Функция ПолучитьЗначениеПредопределенныхДанных(ИмяПредопределенныхДанных, Объект = Неопределено, ИмяОбъекта = "") Экспорт // --> Начало Лико Ефимов ЕВВ 17.04.2017
	Попытка
		Значение = Неопределено;
		Если ИмяОбъекта <> "" И Объект <> Неопределено Тогда
			Выполнить("" + ИмяОбъекта + " = Объект;
			|Значение = " + ИмяПредопределенныхДанных);
		Иначе
			Выполнить("Значение = " + ИмяПредопределенныхДанных);
		КонецЕсли;
		Возврат Значение;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции // <-- Конец Лико Ефимов ЕВВ 17.04.2017 

Функция ПолучитьЗначенияРеквизитовСсылки(СсылкаМассивСсылок, СтрокаРеквизитов) Экспорт
	
	Попытка
		МассивРеквизитов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(СтрокаРеквизитов, ",");
		МассивСтруктур = Новый Массив;
		ПереданМассив = ТипЗнч(СсылкаМассивСсылок) = Тип("Массив");
		Если ПереданМассив Тогда
			МассивСсылок = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(СсылкаМассивСсылок);
		Иначе
			МассивСсылок = Новый Массив;
			МассивСсылок.Добавить(СсылкаМассивСсылок);
		КонецЕсли;
		
		Для каждого Ссылка из МассивСсылок Цикл
			СтруктураРеквизитов = Новый Структура;
			Для каждого ИмяРеквизита из МассивРеквизитов Цикл
				СтруктураРеквизитов.Вставить(ИмяРеквизита, Ссылка[ИмяРеквизита]);
			КонецЦикла;
			СтруктураРеквизитов.Вставить("Ссылка", Ссылка);
			МассивСтруктур.Добавить(СтруктураРеквизитов);
		КонецЦикла;
		
		Если ПереданМассив Тогда
			Возврат МассивСтруктур;
		Иначе
			Возврат МассивСтруктур[0];
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

