	|			И ВТ.Реализация = ВТ_СДатойУпаковки.Реализация
	|			И ВТ.Номенклатура = ВТ_СДатойУпаковки.Номенклатура
	|			И ВТ.Характеристика = ВТ_СДатойУпаковки.Характеристика
