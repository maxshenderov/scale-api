// Находит обработку для открытия при начале работы системы
//
//  Возвращаемое значение:
//      Структура - Структура с данными для открытия обработки в типовом виде
//
Функция НайтиОбработкиРабочегоМестаДляОткрытияПриНачалеРаботыСистемы() Экспорт // --> Начало Лико Ефимов ЕВВ 05.05.2017
	
	Результат = Новый Массив; 
	
	Для каждого СтрокаТЧ из ПараметрыСеанса.Лико_РабочееМесто.ОбработкиДляОткрытияПриЗапуске1С Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.Обработка) Тогда
			Структура = Новый Структура;
			Структура.Вставить("Ссылка", СтрокаТЧ.Обработка);
			Если ТипЗнч(Структура.Ссылка) = Тип("СправочникСсылка.ДополнительныеОтчетыИОбработки") И Структура.Ссылка.Команды.Количество() > 0 Тогда
				Структура.Вставить("Идентификатор", ?(ЗначениеЗаполнено(СтрокаТЧ.ИмяКоманды), СтрокаТЧ.ИмяКоманды, СтрокаТЧ.Обработка.Ссылка.Команды[0].Идентификатор));
				Структура.Вставить("ЭтоОтчет", СтрокаТЧ.Обработка.Ссылка.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет);
			ИначеЕсли ТипЗнч(Структура.Ссылка) = Тип("Строка") Тогда
				// Для строки проверим, есть ли в конфе такая обработка
				Если Метаданные.Обработки.Найти(Структура.Ссылка) = Неопределено Тогда
					// В конфе такой обработки нет, пропустим строку 
					Сообщить("В базе не найдена обработка с именем """ + Структура.Ссылка + """. Обратитесь к программистам");
					Продолжить;
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
			Результат.Добавить(Структура);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 05.05.2017

// Создает новый элемент справочника Лико_Паллеты
//
// Параметры:
//  Автор - СправочникСсылка.ФизическиеЛица - Автор паллета
//
//  Возвращаемое значение:
//      СправочникСсылка.Лико_Паллеты, Неопределено - Ссылка на новый паллет. Неопределено, если не удалось создать
//
Функция СоздатьНовыйПаллет(Автор = Неопределено) Экспорт // --> Начало Лико Ефимов ЕВВ 10.05.2017
	Паллет = Справочники.Лико_Паллеты.СоздатьЭлемент();
	Паллет.Автор = Автор;
	Паллет.ДатаФормирования = ТекущаяДата();
	Попытка
		Паллет.Записать();
		Возврат Паллет.Ссылка;
	Исключение
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось создать новый паллет!");
		Возврат Неопределено;
	КонецПопытки;
КонецФункции // <-- Конец Лико Ефимов ЕВВ 10.05.2017 

// Находит последний созданный оператором паллет
//
// Параметры:
//  Оператор - СправочникСсылка.ФизическиеЛица - Автор паллета
//
//  Возвращаемое значение:
//      СправочникСсылка.Лико_Паллеты, Неопределено - Ссылка на последний паллет. Неопределено, если не удалось создать
//
Функция НайтиПоследнийПаллетОператора(Оператор) Экспорт // --> Начало Лико Ефимов ЕВВ 10.05.2017
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лико_Паллеты.Ссылка
	|ИЗ
	|	Справочник.Лико_Паллеты КАК Лико_Паллеты
	|ГДЕ
	|	Лико_Паллеты.Автор = &Автор
	|	И НЕ Лико_Паллеты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Лико_Паллеты.ДатаФормирования УБЫВ";
	
	Запрос.УстановитьПараметр("Автор", Оператор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 10.05.2017

// Проверяет текущее рабочее место. Если ТСД, то Истина, иначе Ложь
//
//  Возвращаемое значение:
//      Булево - Признак того, что работает на ТСД
//
Функция ВызовСТСД() Экспорт // --> Начало Лико Ефимов ЕВВ 25.05.2017 
	
	Если ПараметрыСеанса.Лико_РабочееМесто.ТипРабочегоМеста = Перечисления.Лико_ТипыРабочегоМеста.КПК Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 25.05.2017 

// Процедура запускается подпиской на событие и проверяет, чтобы в введенных в заказе характеристиках заказ клиента стоял равным документу-источнику 
//
Процедура ПроверитьХарактеристикиЗаказаКлиента(Источник, Отказ, РежимПроведения) Экспорт // --> Начало Лико Ефимов ЕВВ 29.03.2017 
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) <> Тип("ДокументОбъект.ЗаказКлиента") Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаТЧ из Источник.Товары Цикл
		//Начало изменений Иванова Анна 20180214
		Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) ТОгда 
			Если СтрокаТЧ.номенклатура.ВидНоменклатуры.Лико_НоменклатураЭтикеток Тогда 
				Если ЗначениеЗаполнено(СтрокаТЧ.Характеристика) Тогда
					Если СтрокаТЧ.Характеристика.Лико_ЗаказНоменклатуры <> Источник.Ссылка Тогда
						Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + Источник + """: в характеристике """ + СтрокаТЧ.Характеристика + """ выбран заказ клиента, отличный от документа.");
						Отказ = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 16.06.2017

// Возвращает паллет и ячейку, в которых хранится серия на заданную дату через регистр сведений лк Адресное хранение
//
// Параметры:
//  Серия - СправочникСсылка.СерииНоменклатуры - Серия коробки
//  Дата - Дата - Дата, на которую необходим срез информации
//
//  Возвращаемое значение:
//      Структура с ключами "Паллет" и "Ячейка"
//
Функция ПолучитьПаллетИЯчейкуКоробки(Серия, Дата) Экспорт // --> Начало Лико Ефимов ЕВВ 04.07.2017 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Лико_АдресноеХранение.Ячейка КАК Ячейка,
	|	Лико_АдресноеХранение.Паллет КАК Паллет
	|ИЗ
	|	РегистрСведений.Лико_АдресноеХранение.СрезПоследних(
	|			&Дата,
	|			Активность
	|				И Серия = &Серия) КАК Лико_АдресноеХранение";
	
	Запрос.УстановитьПараметр("Серия", Серия);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Структура = Новый Структура("Паллет,Ячейка");
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Структура, Выборка);
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 04.07.2017 

Функция ПолучитьСодержимоеПаллета(Паллет, Дата = Неопределено, Документ = Неопределено) Экспорт // --> Начало Лико Ефимов ЕВВ 26.12.2017
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(Лико_АдресноеХранениеСрезПоследних.Период) КАК Период,
	|	Лико_АдресноеХранениеСрезПоследних.Паллет
	|ПОМЕСТИТЬ ВТ_ПаллетСПоследнейДатой
	|ИЗ
	|	РегистрСведений.Лико_АдресноеХранение.СрезПоследних(
	|			&Дата,
	|			Паллет = &Паллет
	|				И Регистратор <> &Ссылка) КАК Лико_АдресноеХранениеСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_АдресноеХранениеСрезПоследних.Паллет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_АдресноеХранениеСрезПоследних.Период,
	|	Лико_АдресноеХранениеСрезПоследних.Паллет,
	|	Лико_АдресноеХранениеСрезПоследних.Ячейка,
	|	Лико_АдресноеХранениеСрезПоследних.ВыбылСоСклада,
	|	Лико_АдресноеХранениеСрезПоследних.Серия,
	|	Лико_АдресноеХранениеСрезПоследних.Склад
	|ПОМЕСТИТЬ ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр
	|ИЗ
	|	РегистрСведений.Лико_АдресноеХранение.СрезПоследних(
	|			&Дата,
	|			(Период, Паллет) В
	|					(ВЫБРАТЬ
	|						Т.Период,
	|						Т.Паллет
	|					ИЗ
	|						ВТ_ПаллетСПоследнейДатой КАК Т)
	|				И Регистратор <> &Ссылка) КАК Лико_АдресноеХранениеСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр.Период КАК Период,
	|	ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр.Паллет КАК Паллет,
	|	ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр.Ячейка,
	|	ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр.ВыбылСоСклада,
	|	ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр.Серия КАК Серия,
	|	ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр.Склад
	|ИЗ
	|	ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр КАК ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_АдресноеХранение.СрезПоследних(
	|				&Дата,
	|				Серия В
	|						(ВЫБРАТЬ
	|							Т.Серия
	|						ИЗ
	|							ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр КАК Т)
	|					И Регистратор <> &Ссылка) КАК Лико_АдресноеХранениеСрезПоследних
	|		ПО ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр.Период = Лико_АдресноеХранениеСрезПоследних.Период
	|			И ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр.Паллет = Лико_АдресноеХранениеСрезПоследних.Паллет
	|			И ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр.Серия = Лико_АдресноеХранениеСрезПоследних.Серия
	|			И ВТ_СодержимоеПаллетаВМоментЕгоПоследнейЗаписиВРегистр.Ячейка = Лико_АдресноеХранениеСрезПоследних.Ячейка
	|ГДЕ
	|	НЕ Лико_АдресноеХранениеСрезПоследних.Паллет ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Паллет", Паллет);
	Запрос.УстановитьПараметр("Дата", ?(НЕ ЗначениеЗаполнено(Дата) ИЛИ Дата = НачалоДня(ТекущаяДата()), ТекущаяДата(), Дата));
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Возврат РезультатЗапроса.Выгрузить();
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 26.12.2017

// Сравнивает две одинаковые (по составу колонок) таблицы значения на полное их совпадение по содержимому
//
// Параметры:
//  Таблица0 - ТаблицаЗначений - Первая таблица
//  Таблица1 - ТаблицаЗначений - Вторая таблица
//
//  Возвращаемое значение:
//      Булево - Ложь (полностью совпадают), Истина (не совпадают)
//
Функция СравнениеДвухОдинаковыхТаблицЗначенийПоСодержимому(Таблица0, Таблица1, ПроверятьПорядокСтрок = Ложь) Экспорт
	
	// взято с инфостарта
	ВсеКолонки = "";
	Для Каждого Колонка Из Таблица0.Колонки Цикл 
		ВсеКолонки = ВсеКолонки + "," + Колонка.Имя;
	КонецЦикла;
	
	ВсеКолонки = Сред(ВсеКолонки, 2);
	
	Таблица = Таблица1.Скопировать();    
	
	Таблица.Колонки.Добавить("Знак", Новый ОписаниеТипов("Число"));
	
	Таблица.ЗаполнитьЗначения(1, "Знак");
	
	Для Каждого Строка Из Таблица0 Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Строка);
	КонецЦикла;
	
	Таблица.Колонки.Добавить("Счёт");
	Таблица.ЗаполнитьЗначения(1, "Счёт");
	
	Таблица.Свернуть(ВсеКолонки, "Знак, Счёт");
	
	Ответ = Таблица.Скопировать(Новый Структура("Счёт", 1), ВсеКолонки + ", Знак");
	
	ТаблицыРазличаются = Ответ.Количество() > 0;
	
	Если НЕ ТаблицыРазличаются И ПроверятьПорядокСтрок Тогда
		Если Таблица0.Количество() <> Таблица1.Количество() ИЛИ Таблица0.Колонки.Количество() <> Таблица1.Колонки.Количество() Тогда
			Возврат Истина;
		Иначе
			Для сч = 0 По Таблица0.Количество()-1 Цикл
				Для каждого Колонка из Таблица0.Колонки Цикл 
					Если НЕ Таблица0[сч][Колонка.Имя] = Таблица1[сч][Колонка.Имя] Тогда
						Возврат Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТаблицыРазличаются;
	
КонецФункции

// Возвращает режим запуска основного окна в зависимости от рабочего места или других влияющих факторов
//
//  Возвращаемое значение:
//      РежимОсновногоОкнаКлиентскогоПриложения
//
Функция ПолучитьРежимОсновногоОкна() Экспорт // --> Начало Лико Ефимов ЕВВ 18.07.2017
	
	Режим = РежимОсновногоОкнаКлиентскогоПриложения.Обычный;
	Если ПараметрыСеанса.Лико_РабочееМесто.ТипРабочегоМеста = Перечисления.Лико_ТипыРабочегоМеста.КПК Тогда
		Режим = РежимОсновногоОкнаКлиентскогоПриложения.ПолноэкранноеРабочееМесто;
	КонецЕсли;
	Если ПараметрыСеанса.Лико_РабочееМесто.ТипРабочегоМеста = Перечисления.Лико_ТипыРабочегоМеста.Телевизор Тогда
		Режим = РежимОсновногоОкнаКлиентскогоПриложения.РабочееМесто;
	КонецЕсли;
	Возврат Режим;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 18.07.2017

// Работает аналогично функции НайтиСтроки, но возвращает не массив, а таблицу значений
//
//
// Параметры:
//  ТЗПоиска - ТаблицаЗначений - Таблица, в которой будем искать
//  Отбор - Структура - Задает условия поиска: ключ структуры определяет имя колонки, по которой будет осуществляться поиск, а значение структуры - искомое значение. 
//
//  Возвращаемое значение:
//      ТаблицаЗначений - Таблица с отбором. Если по отбору ничего не найдено, возвращается пустая таблица значений
//
Функция НайтиСтрокиВозвращаетТЗ(ТЗПоиска, Отбор) Экспорт // --> Начало Лико Ефимов ЕВВ 20.07.2017
	
	НайденныеСтроки = ТЗПоиска.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() <> 0 Тогда
		НоваяТЗ = ТЗПоиска.Скопировать(НайденныеСтроки);
	Иначе
		// если строки не нашлись, вернем пустую ТЗ
		НоваяТЗ = ТЗПоиска.СкопироватьКолонки();
	КонецЕсли;
	
	Возврат НоваяТЗ;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 20.07.2017

// Считает количество коробок в таблице значений
//
//
// Параметры:
//  ТаблицаЗначений - ТаблицаЗначений - Таблица с обязательной колонкой "Серия"
//
//  Возвращаемое значение:
//      Число - Количество коробок в таблица значений
//
Функция РассчитатьКоличествоКоробокВТЗ(ТаблицаЗначений) Экспорт // --> Начало Лико Ефимов ЕВВ 13.09.2017
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.Серия
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|ВЫБРАТЬ
	|	СУММА(ВТ.Серия.Лико_КоличествоКоробок) КАК КоличествоКоробок
	|ИЗ
	|	ВТ КАК ВТ";
	
	Запрос.УстановитьПараметр("ТЗ", ТаблицаЗначений);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоКоробок;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 13.09.2017

