		//Если ПредыдущийВид = Строка.Номенклатура.ВидНоменклатуры Тогда
		//	Строка.Упаковка = ПредыдущаяУпаковка;
		//Иначе
		//	Строка.Упаковка = Лико_Дополнительно.ПолучитьУпаковкуПоУмолчаниюДляВидаНоменклатуры(Строка.Номенклатура.ВидНоменклатуры);
		//КонецЕсли;
		//ПредыдущийВид = Строка.Номенклатура.ВидНоменклатуры;
		//ПредыдущаяУпаковка = Строка.Упаковка;
		Строка.Упаковка = УпаковкаТысШт;
	КонецЦикла;
	
КонецПроцедуры

// Приводит номер (код) к требуемой длине. При этом выделяется префикс
// и числовая часть номера, остальное пространство между префиксом и
// номером заполняется нулями.
// Функция может быть использована в обработчиках событий, программный код 
// которых хранится в правила обмена данными. Вызывается методом Выполнить()
// Сообщение "Не обнаружено ссылок на функцию" при проверке конфигурации 
// не является ошибкой проверки конфигурации
//
// Параметры:
//  Стр          - преобразовываемая строка;
//  Длина        - требуемая длина строки.
//
// Возвращаемое значение:
//  Строка       - код или номер, приведенная к требуемой длине.
// 
Функция ПривестиНомерКДлине(Знач Стр, Длина, ДобавлятьНулиЕслиДлинаНеМеньшеТекущейДлиныНомера = Истина, Префикс = "") Экспорт
	
	Стр             = СокрЛП(Стр);
	ВходящаяДлинаНомера = СтрДлина(Стр);
	
	ЧисловаяЧасть   = "";
	Результат       = ПолучитьПрефиксЧислоНомера(Стр, ЧисловаяЧасть);
	
	Результат = ?(ПустаяСтрока(Префикс), Результат, Префикс);
	
	СтрокаЧисловойЧасти = Формат(ЧисловаяЧасть, "ЧГ=0");
	ДлинаЧисловойЧасти = СтрДлина(СтрокаЧисловойЧасти);
	
	Если (Длина >= ВходящаяДлинаНомера И ДобавлятьНулиЕслиДлинаНеМеньшеТекущейДлиныНомера)
		ИЛИ (Длина < ВходящаяДлинаНомера) Тогда
		
		Для ВременнаяПеременная = 1 По Длина - СтрДлина(Результат) - ДлинаЧисловойЧасти Цикл
			
			Результат = Результат + "0";
			
		КонецЦикла;
		
	КонецЕсли;
	
	Результат = Результат + СтрокаЧисловойЧасти;
	
	Возврат(Результат);
	
КонецФункции // ПривестиНомерКДлине()

// Разбирает строку, выделяя из нее префикс и числовую часть.
//
// Параметры:
//  Стр            - Строка. Разбираемая строка;
//  ЧисловаяЧасть  - Число. Переменная, в которую возвратится числовая часть строки;
//  Режим          - Строка. Если "Число", то возвратит числовую часть, иначе - префикс.
//
// Возвращаемое значение:
//  Префикс строки
//
Функция ПолучитьПрефиксЧислоНомера(Знач Стр, ЧисловаяЧасть = "", Режим = "") Экспорт
	
	ЧисловаяЧасть = 0;
	Префикс = "";
	Стр = СокрЛП(Стр);
	Длина   = СтрДлина(Стр);
	
	СтроковойНомерБезПрефикса = ПолучитьСтроковыйНомерБезПрефиксов(Стр);
	ДлинаСтроковойЧасти = СтрДлина(СтроковойНомерБезПрефикса);
	Если ДлинаСтроковойЧасти > 0 Тогда
		ЧисловаяЧасть = Число(СтроковойНомерБезПрефикса);
		Префикс = Сред(Стр, 1, Длина - ДлинаСтроковойЧасти);
	Иначе
		Префикс = Стр;	
	КонецЕсли;
	
	Если Режим = "Число" Тогда
		Возврат(ЧисловаяЧасть);
	Иначе
		Возврат(Префикс);
	КонецЕсли;
	
КонецФункции // ПолучитьПрефиксЧислоНомера()

// Получает номер без префиксов по алгоритму: перебирает номер справа налево до тех пор, пока не наткнется на символ, отличный от цифры.
//
// Параметры:
//  Номер - Строка - Номер с цифрами и символами
//
//  Возвращаемое значение:
//      Строка - Строка с номером, состоящим только из цифр или пустая строка, если первый справа элемент переданного номера является не цифрой
//
Функция ПолучитьСтроковыйНомерБезПрефиксов(Номер) Экспорт
	
	Номер = СокрЛП(Номер);
	НомерБезПрефиксов = "";
	Сч = СтрДлина(Номер);
	
	Пока Сч > 0 Цикл
		
		Символ = Сред(Номер, Сч, 1);
		
		Если (Символ >= "0" И Символ <= "9") Тогда
			
			НомерБезПрефиксов = Символ + НомерБезПрефиксов;
			
		Иначе
			
			Возврат НомерБезПрефиксов;
			
		КонецЕсли;
		
		Сч = Сч - 1;
		
	КонецЦикла;
	
	Возврат НомерБезПрефиксов;
	
КонецФункции

// Получает имя значения перечисления, указанное в конфигураторе, на основании ссылки на это перечисление. 
//
// Параметры:
//  Ссылка - ПеречислениеСсылка - Ссылка на перечисление
//
//  Возвращаемое значение:
//      Строка - Имя значения перечисления
//
Функция ИмяПеречисления(Ссылка) Экспорт
	
	ИмяПеречисления = Ссылка.Метаданные().Имя;
	Индекс = Перечисления[ИмяПеречисления].Индекс(Ссылка);

	Возврат Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[Индекс].Имя;
	
КонецФункции // обИмяПеречисления()

// Печатает этикетку доп. стикера для паллета. 
//
// Параметры:
//  СтруктураПараметров - Структура - структура параметров, необходимых для заполнения табличного документа
//  ТабДокДопСтикеров - ТабличныйДокумент - табличный документ, в который будет выведен результат
//
Процедура ПечатьДопСтикера_Общий(СтруктураПараметров,ТабДокДопСтикеров) Экспорт
	
	ИнформацияОСерии = СтруктураПараметров.ИнформацияОСерии;
	
	Макет = ПолучитьОбщийМакет("ПФ_MXL_МакетДопСтикер_Общий");
	
	ОбластьШапки = Макет.ПолучитьОбласть("Шапка");
	
	ОбластьШапки.Параметры.Заполнить(СтруктураПараметров); 
	ОбластьШапки.Параметры.НаименованиеПродукции = ИнформацияОСерии.Наименование;
	ОбластьШапки.Параметры.КодЭтикеткиЗаказчика = ИнформацияОСерии.КодЭтикеткиЗаказчика;
	
	ТабДокДопСтикеров.Вывести(ОбластьШапки);
	ТабДокДопСтикеров.ВывестиГоризонтальныйРазделительСтраниц();
	
КонецПроцедуры

// Печатает этикетку доп. стикера для паллета или для этикетки на коробку. 
//
// Параметры:
//  ПараметрыПечати - Структура - структура параметров, необходимых для заполнения табличного документа
//  ТабДок - ТабличныйДокумент - табличный документ, в который будет выведен результат
//  СтикерПаллеты - Булево - признак того, для какого объекта печатается стикер (паллет или коробка)
//
Процедура ПечатьДопСтикера_PGs(ПараметрыПечати, ТабДок, СтикерПаллеты = Ложь) Экспорт
	
	Если ПараметрыПечати.ТипДопСтикераКоробки=Перечисления.ЯСГП_ТипыДополнительныхСтикеров.PG
		ИЛИ ПараметрыПечати.ТипДопСтикераКоробки=Перечисления.ЯСГП_ТипыДополнительныхСтикеров.PG_Дистрибьюторская
		ИЛИ ПараметрыПечати.ТипДопСтикераКоробки=Перечисления.ЯСГП_ТипыДополнительныхСтикеров.IML
		ИЛИ ПараметрыПечати.ТипДопСтикераКоробки=Перечисления.ЯСГП_ТипыДополнительныхСтикеров.Хенкель
		ИЛИ ПараметрыПечати.ТипДопСтикераКоробки=Перечисления.ЯСГП_ТипыДополнительныхСтикеров.КодЭтикеткиЗаказчика Тогда
		Макет = ПолучитьОбщийМакет("ПФ_MXL_МакетДопСтикер_PG");
	ИначеЕсли ПараметрыПечати.ТипДопСтикераКоробки=Перечисления.ЯСГП_ТипыДополнительныхСтикеров.PG_Plant Тогда
		Макет = ПолучитьОбщийМакет("ПФ_MXL_МакетДопСтикер_PG_Plant");
	Иначе
		Возврат;
	КонецЕсли;
	
	ИнформацияОСерии = ПараметрыПечати.ИнформацияОСерии;	
	
	ПараметрыПечати.Вставить("ОрганизацияПродавец", Справочники.Лико_ПредопределенныеЗначения.ОрганизацияОкил.ЗначениеПараметра);
	
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
	
	Если ПараметрыПечати.ТипДопСтикераКоробки=Перечисления.ЯСГП_ТипыДополнительныхСтикеров.IML
		ИЛИ ПараметрыПечати.ТипДопСтикераКоробки=Перечисления.ЯСГП_ТипыДополнительныхСтикеров.Хенкель
		ИЛИ ПараметрыПечати.ТипДопСтикераКоробки=Перечисления.ЯСГП_ТипыДополнительныхСтикеров.КодЭтикеткиЗаказчика Тогда
		ОбластьШапкаШК	= Макет.ПолучитьОбласть("ОбластьШкIML");
	ИначеЕсли ПараметрыПечати.ТипДопСтикераКоробки=Перечисления.ЯСГП_ТипыДополнительныхСтикеров.PG_Дистрибьюторская Тогда
		ОбластьШапкаШК	= Макет.ПолучитьОбласть("ОбластьШКДистрибьюторская");
	Иначе
		ОбластьШапкаШК	= Макет.ПолучитьОбласть("ОбластьШК");
	КонецЕсли;
	
	Если ПараметрыПечати.ТипДопСтикераКоробки = Перечисления.ЯСГП_ТипыДополнительныхСтикеров.КодЭтикеткиЗаказчика И НЕ СтикерПаллеты Тогда
		
		ШК = СокрЛП(ПараметрыПечати.ИнформацияОСерии.КодЭтикеткиЗаказчика);
		Если НЕ ЗначениеЗаполнено(ШК) Тогда
			Сообщить("Не указан код этикетки заказчика. Доп. стикер распечатан не будет");
			Возврат;
		КонецЕсли;
		ВШКТолькоЦифры = СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ШК);
		
		Рисунок = ОбластьШапкаШК.Рисунки["Штрихкод4"];
		ПараметрыШтрихкода = Новый Структура;
		ПараметрыШтрихкода.Вставить("Ширина",          Рисунок.Ширина);
		ПараметрыШтрихкода.Вставить("Высота",          Рисунок.Высота);
		//ПараметрыШтрихкода.Вставить("ТипКода",         ?(ВШКТолькоЦифры И СтрДлина(ШК) = 13, 1, 4));
		ПараметрыШтрихкода.Вставить("ТипКода",         ?(МенеджерОборудованияКлиентСервер.ОпределитьТипШтрихкода(ШК) = "EAN13", 1, 4));
		ПараметрыШтрихкода.Вставить("ОтображатьТекст", Ложь);
		ПараметрыШтрихкода.Вставить("РазмерШрифта",    18);
		ПараметрыШтрихкода.Вставить("Штрихкод",        СокрЛП(ШК));
		Рисунок.Картинка = МенеджерОборудованияВызовСервера.ПолучитьКартинкуШтрихкода(ПараметрыШтрихкода);
		ОбластьШапкаШК.Параметры["ТекстКода4"] = ШК;
		
		ТабДок.Вывести(ОбластьШапкаШК);
		ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		Возврат;
	КонецЕсли;

	Преф = "001";
	КодЗаказчика = "464001531";   //464001531
	Если СтикерПаллеты Тогда
		
		ШКкодП =  Формат(ПараметрыПечати.Паллет.Код, "ЧЦ=7; ЧВН=; ЧГ=0");
		// --> Начало Лико Ефимов ЕВВ 25.12.2018 
		//ШКконтр = Лико_Дополнительно.ПосчитатьКонтрольнуюСуммуШК(Преф + КодЗаказчика + ШКкодП);
		
		// Изменено по требованиям Mekaeva, Tatiana <mekaeva.tv@pg.com> письмо от 21, 12, 2018 14:21
		ШКконтр = Лико_Дополнительно.ПосчитатьКонтрольнуюСуммуШКВСистемеGS1_13(Преф + КодЗаказчика + ШКкодП);
		// <-- Конец Лико Ефимов ЕВВ 25.12.2018 
		
		ШК3Текст = "(00)1" + КодЗаказчика + ШККодП + ШКконтр; //длинна штрихкода - 20 знакомест (00 + 1 + КодЗаказчика + КодПаллеты + КонтрольнаяСумма)
		
		ШК3Код = Преф + КодЗаказчика + ШККодП + ШКконтр;
	Иначе	
		НомерПаллеты_4смвНомерЗаказа = Прав(Формат(ПараметрыПечати.НомерЗаказа, "ЧГ=0"), 4);
		// --> Начало Лико Ефимов ЕВВ 20.06.2018
		// номер коробки будем формировать исходя из количество строк в заказе. Если строк в заказе 2, то к коробкам второй строки заказа будем прибавлять 50.
		// Если строки 4, то к коробкам второй строки заказа будем прибавлять 25, к коробкам 3 строки 50, к коробкам 4 строки 75 и т.д. 
		КолСтрокВЗаказе = ПараметрыПечати.Заказ.Товары.Количество();
		НомерКоробки = ИнформацияОСерии.НомерКоробки;
		Если КолСтрокВЗаказе > 1 Тогда
			СтрокаЗаказа = ПараметрыПечати.Заказ.Товары.Найти(ИнформацияОСерии.Характеристика, "Характеристика");
			Если СтрокаЗаказа <> Неопределено Тогда
				НомерСтрокиЗаказа = СтрокаЗаказа.НомерСтроки;
				Если НомерСтрокиЗаказа <> 1 Тогда
					ДобавляемоеКоличество = (НомерСтрокиЗаказа-1) * Цел(100 / КолСтрокВЗаказе);
					НомерКоробки = ДобавляемоеКоличество + НомерКоробки;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		// <-- Конец Лико Ефимов ЕВВ 20.06.2018
		НомерПаллеты =  НомерПаллеты_4смвНомерЗаказа + Формат(НомерКоробки, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");
		
		ШК3КонтрСимв = Лико_Дополнительно.ПосчитатьКонтрольнуюСуммуШК(Преф + КодЗаказчика + НомерПаллеты);
		
		ШК3ТекстНеполный = "(00)1" + КодЗаказчика + НомерПаллеты + ШК3КонтрСимв; //длина штрихкода - 20 знакомест (00 + 1 + КодЗаказчика + КодПаллеты + КонтрольнаяСумма)
		ШК3КодНеполный = Преф + КодЗаказчика + НомерПаллеты + ШК3КонтрСимв;
		
		Попытка
			ЦифраПоследняя = 10-(((Число(Сред(ШК3КодНеполный,1,1))+Число(Сред(ШК3КодНеполный,3,1))+Число(Сред(ШК3КодНеполный,5,1))+Число(Сред(ШК3КодНеполный,7,1))+Число(Сред(ШК3КодНеполный,9,1))+Число(Сред(ШК3КодНеполный,11,1))+Число(Сред(ШК3КодНеполный,13,1))+Число(Сред(ШК3КодНеполный,15,1))+Число(Сред(ШК3КодНеполный,17,1))+Число(Сред(ШК3КодНеполный,19,1)))*3+(Число(Сред(ШК3КодНеполный,2,1))+Число(Сред(ШК3КодНеполный,4,1))+Число(Сред(ШК3КодНеполный,6,1))+Число(Сред(ШК3КодНеполный,8,1))+Число(Сред(ШК3КодНеполный,10,1))+Число(Сред(ШК3КодНеполный,12,1))+Число(Сред(ШК3КодНеполный,14,1))+Число(Сред(ШК3КодНеполный,16,1))+Число(Сред(ШК3КодНеполный,18,1))))%10);
			ШК3Текст = ШК3ТекстНеполный + СтрЗаменить(Строка(ЦифраПоследняя),"10","0");
			ШК3Код = Строка(ШК3КодНеполный) + СтрЗаменить(Строка(ЦифраПоследняя),"10","0");
		Исключение
			ШК3Текст = ШК3ТекстНеполный;
			ШК3Код = ШК3КодНеполный;
		КонецПопытки;
	КонецЕсли;
	
	КодЭтикеткиЗаказчика = СокрЛП(СтрЗаменить(ИнформацияОСерии.КодЭтикеткиЗаказчика, "code", ""));
	КодЭтикеткиЗаказчикаЧ = Лико_Дополнительно.ПривестиНомерКДлине(СокрЛП(СтрЗаменить(КодЭтикеткиЗаказчика, ":", "")), 8);
	
	КоличествоВУпаковке = ИнформацияОСерии.КоличествоВУпаковке;
	ПараметрыПечати.Вставить("КоличествоНаПаллете", КоличествоВУпаковке * 1000);
	
