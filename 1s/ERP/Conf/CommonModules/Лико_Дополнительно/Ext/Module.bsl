Функция ПолучитьДанныеПоНаработке(ОбъектНоменклатуры, МоментВремени) Экспорт
	
	ДанныеПоНаработке = Новый Структура;
	ДанныеПоНаработке.Вставить("ОбщаяНаработка", 0);
	ДанныеПоНаработке.Вставить("Примечание", "");
	
	ЗапросДанныеПоНаработке = Новый Запрос;
	ЗапросДанныеПоНаработке.Текст = 
	"ВЫБРАТЬ
	|	ЯССМ_НаработкиОбъектовНоменклатурыСрезПоследних.ОбщаяНаработка,
	|	ЯССМ_НаработкиОбъектовНоменклатурыСрезПоследних.Примечание
	|ИЗ
	|	РегистрСведений.Лико_НаработкиОбъектовНоменклатуры.СрезПоследних(&МоментВремени, ОбъектНоменклатуры = &ОбъектНоменклатуры) КАК ЯССМ_НаработкиОбъектовНоменклатурыСрезПоследних ";
	
	ЗапросДанныеПоНаработке.УстановитьПараметр("МоментВремени", МоментВремени);
	ЗапросДанныеПоНаработке.УстановитьПараметр("ОбъектНоменклатуры", ОбъектНоменклатуры);
	
	РезультатЗапросаДанныеПоНаработке = ЗапросДанныеПоНаработке.Выполнить();
	Если Не РезультатЗапросаДанныеПоНаработке.Пустой() Тогда
		ВыборкаЗапросаДанныеПоНаработке = РезультатЗапросаДанныеПоНаработке.Выбрать();
		ВыборкаЗапросаДанныеПоНаработке.Следующий();
		
		ДанныеПоНаработке.Вставить("ОбщаяНаработка", ВыборкаЗапросаДанныеПоНаработке.ОбщаяНаработка);
		ДанныеПоНаработке.Вставить("Примечание", ВыборкаЗапросаДанныеПоНаработке.Примечание);
	Иначе 	//запрос пуст!
	КонецЕсли;
	
	Возврат ДанныеПоНаработке;
	
КонецФункции //ПолучитьДанныеПоНаработке Экспорт

Функция ПолучитьПробегШтампаПоДаннымСчетчика(Серия, Дата = Неопределено, Ячейка, РучнойВызов = Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Серия) ИЛИ НЕ ЗначениеЗаполнено(Ячейка) Тогда
		Возврат 0;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	РабочийЦентр = ЯчейкаПринадлежитРЦ(Ячейка, Истина);
	Если НЕ ЗначениеЗаполнено(РабочийЦентр) Тогда
		Возврат 0;
	КонецЕсли;
	
	ОбъектНоменклатуры = Серия.ЯССМ_ОбъектНоменклатуры;
	Номенклатура = ОбъектНоменклатуры.Номенклатура;
	Артикул = Номенклатура.Артикул;
	Если НЕ ЗначениеЗаполнено(Артикул) ИЛИ Номенклатура.ВидНоменклатуры <> Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыОснастка.ЗначениеПараметра Тогда
		Возврат 0;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = Дата('39991231235959');
	КонецЕсли;
	
	Если НЕ РучнойВызов Тогда
		// Проверим дату начала
		ДатаНачалаУчетаПробегаШтамповПоСчетчику = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, РабочийЦентр.Лико_Площадка.Организация, "ДатаНачалаУчетаПробегаШтамповПоСчетчику", Дата('00010101'));
		Если НЕ ЗначениеЗаполнено(ДатаНачалаУчетаПробегаШтамповПоСчетчику) ИЛИ Дата < ДатаНачалаУчетаПробегаШтамповПоСчетчику Тогда
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
	
	// Найдем дату, когда штамп передали на эту машину
	ДатаПередачиНаМашину = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТоварыВЯчейкахОбороты.Период КАК Период
		|ИЗ
		|	РегистрНакопления.ТоварыВЯчейках.Обороты(
		|			,
		|			,
		|			Регистратор,
		|			Серия = &Серия
		|				И Ячейка = &Ячейка) КАК ТоварыВЯчейкахОбороты
		|ГДЕ
		|	ТоварыВЯчейкахОбороты.ВНаличииПриход <> 0
		|	И ТоварыВЯчейкахОбороты.Период <= &Дата
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Серия", Серия);
	Запрос.УстановитьПараметр("Ячейка", Ячейка);
	Запрос.УстановитьПараметр("Дата", Дата);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Период) Тогда
		ДатаПередачиНаМашину = ВыборкаДетальныеЗаписи.Период;
	Иначе
		Возврат 0;
	КонецЕсли;
	
	//Лико_Планирование.Лико_ОбновитьСтатистикуСкорости();
	
	// Получим данные по счетчикам
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТССтатистикаСкорости.РабочееМесто КАК РабочееМесто,
		|	ТССтатистикаСкорости.РабочийЦентр КАК РабочийЦентр,
		|	ТССтатистикаСкорости.Заказ КАК Заказ,
		|	ТССтатистикаСкорости.НомерБланка КАК НомерБланка,
		|	ТССтатистикаСкорости.ЭтапПроизводства КАК ЭтапПроизводства,
		|	ТССтатистикаСкорости.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ТССтатистикаСкорости.ПоказанияОбщегоСчетчика КАК ПоказанияОбщегоСчетчика,
		|	ТССтатистикаСкорости.ДатаНачала КАК ДатаНачала,
		|	ТССтатистикаСкорости.ДатаОкончания КАК ДатаОкончания
		|ПОМЕСТИТЬ ВТ_Статистика
		|ИЗ
		|	РегистрСведений.ТССтатистикаСкорости КАК ТССтатистикаСкорости
		|ГДЕ
		|	ТССтатистикаСкорости.РабочийЦентр = &РабочийЦентр
		|	И ТССтатистикаСкорости.ДатаНачала >= &ДатаНачала
		|	И ТССтатистикаСкорости.ДатаОкончания <= &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РабочиеЦентры.Ссылка КАК Ссылка,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ВТ_Статистика.РабочийЦентр ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК НетЗаписейВСтатистике
		|ПОМЕСТИТЬ ВТ_ПроверкаСтатистикиНаНаличие
		|ИЗ
		|	Справочник.РабочиеЦентры КАК РабочиеЦентры
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Статистика КАК ВТ_Статистика
		|		ПО РабочиеЦентры.Ссылка = ВТ_Статистика.РабочийЦентр
		|ГДЕ
		|	РабочиеЦентры.Ссылка = &РабочийЦентр
		|
		|СГРУППИРОВАТЬ ПО
		|	РабочиеЦентры.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Статистика.РабочееМесто КАК РабочееМесто,
		|	ВТ_Статистика.РабочийЦентр КАК РабочийЦентр,
		|	ВТ_Статистика.Заказ КАК Заказ,
		|	ВТ_Статистика.НомерБланка КАК НомерБланка,
		|	ВТ_Статистика.ЭтапПроизводства КАК ЭтапПроизводства,
		|	ВТ_Статистика.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ВТ_Статистика.ПоказанияОбщегоСчетчика КАК ПоказанияОбщегоСчетчика,
		|	ВТ_Статистика.ДатаНачала КАК ДатаНачала,
		|	ВТ_Статистика.ДатаОкончания КАК ДатаОкончания
		|ПОМЕСТИТЬ ВТ_СтатистикаПослеПроверки
		|ИЗ
		|	ВТ_Статистика КАК ВТ_Статистика
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.РабочееМесто,
		|	ВложенныйЗапрос.РабочийЦентр,
		|	ВложенныйЗапрос.Заказ,
		|	ВложенныйЗапрос.НомерБланка,
		|	ВложенныйЗапрос.ЭтапПроизводства,
		|	ВложенныйЗапрос.ПорядковыйНомер,
		|	ВложенныйЗапрос.ПоказанияОбщегоСчетчика,
		|	ВложенныйЗапрос.ДатаНачала,
		|	ВложенныйЗапрос.ДатаОкончания
		|ИЗ
		|	(ВЫБРАТЬ ПЕРВЫЕ 1
		|		ТСИсторияРабочегоСтолаОператора.РабочееМесто КАК РабочееМесто,
		|		ТСИсторияРабочегоСтолаОператора.РабочийЦентр КАК РабочийЦентр,
		|		ТСИсторияРабочегоСтолаОператора.Заказ КАК Заказ,
		|		ТСИсторияРабочегоСтолаОператора.НомерБланка КАК НомерБланка,
		|		ТСИсторияРабочегоСтолаОператора.ЭтапПроизводства КАК ЭтапПроизводства,
		|		ТСИсторияРабочегоСтолаОператора.ПорядковыйНомер КАК ПорядковыйНомер,
		|		0 КАК ПоказанияОбщегоСчетчика,
		|		ТСИсторияРабочегоСтолаОператора.Период КАК ДатаНачала,
		|		ТСИсторияРабочегоСтолаОператора.Период КАК ДатаОкончания
		|	ИЗ
		|		РегистрСведений.ТСИсторияРабочегоСтолаОператора КАК ТСИсторияРабочегоСтолаОператора
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПроверкаСтатистикиНаНаличие КАК ВТ_ПроверкаСтатистикиНаНаличие
		|			ПО ТСИсторияРабочегоСтолаОператора.РабочийЦентр = ВТ_ПроверкаСтатистикиНаНаличие.Ссылка
		|				И (ВТ_ПроверкаСтатистикиНаНаличие.НетЗаписейВСтатистике)
		|	ГДЕ
		|		ТСИсторияРабочегоСтолаОператора.РабочийЦентр = &РабочийЦентр
		|		И ТСИсторияРабочегоСтолаОператора.Период >= &ДатаНачала
		|		И ТСИсторияРабочегоСтолаОператора.Период <= &ДатаОкончания
		|	
		|	УПОРЯДОЧИТЬ ПО
		|		ДатаНачала) КАК ВложенныйЗапрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
