			КонецЕсли;
			Возврат;
		КонецЕсли;
		Результат.Вставить("Документ", Выборка.ПеремещениеПаллета);
	Иначе
		Результат.Ошибка = "Не найдена организация с префиксом """ + ДанныеШК.ПрефиксОрганизации + """";
		Возврат;
