// Получает имя дополнительного реквизита на форме, который сформировался "автоматически" типовым кодом, в виде строки из уникальных идентификаторов
//
// Параметры:
//  ИмяПредопределенногоЗначения - Строка - имя элемента предопределенных данных справочника "ЛикоПредопределенныеЗначения", в котором хранится ссылка на доп. ревизит
//  ЛеваяЧастьИмени - Строка - левая часть имени элемента.
//
//  Возвращаемое значение:
//      Строка - имя дополнительного реквизита на форме, к которому в дальнейшем можно обращаться через "Элементы[Имя]"
//
Функция ПолучитьИмяДопРеквизита(ИмяПредопределенногоЗначения, ЛеваяЧастьИмени) Экспорт // --> Начало Лико Ефимов ЕВВ 22.03.2017 9:39:30 

	
	ДопРеквизит = Справочники.Лико_ПредопределенныеЗначения[ИмяПредопределенногоЗначения].ЗначениеПараметра;
	ИмяРеквизита = ЛеваяЧастьИмени + "_" +
	СтроковыеФункцииКлиентСервер.ЗаменитьОдниСимволыДругими(
	"-", 
	ВРег("" + ДопРеквизит.НаборСвойств.УникальныйИдентификатор() + "_" + ДопРеквизит.УникальныйИдентификатор()),
	"x");
	Возврат ИмяРеквизита;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 22.03.2017 9:39:34 

// Рассчитывает вес коробки по формуле, использую площадь, введенную в номенклатуру
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - элемент номенклатуры, для коробки которой рассчитывается вес.
//  КоличествоВУпаковке - Число - количество единиц в упаковке.
//  КоробокВКомплекте - Число - используется в случае, когда в одной коробке находится несколько разных изделий.
//
//  Возвращаемое значение:
//      Число - вес коробки
//
Функция РассчитатьВесКоробки(Номенклатура, КоличествоВУпаковке, КоробокВКомплекте = 1, Заказ) Экспорт // --> Начало Лико Ефимов ЕВВ 29.03.2017 
	
	Если КоробокВКомплекте = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Для правильного расчета веса необходимо заполнить номенклатуру.");
	КонецЕсли;	
	Площадь = Номенклатура.ПлощадьЧислитель / ?(Номенклатура.ПлощадьЗнаменатель = 0, 1, Номенклатура.ПлощадьЗнаменатель);
	
	Плотность = Справочники.Лико_ПредопределенныеЗначения.ПлотностьДляРасчетаВеса.ЗначениеПараметра;
	Если Заказ.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Термоусадка Тогда
		Плотность = 65;
	ИначеЕсли Заказ.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.ВплавляемаяЭтикетка Тогда
		Плотность = 350;
	Иначе
		Плотность = 120;
	КонецЕсли;
	
	ОсновнойМатериал = Заказ.ОсновнойМатериал;
	Если ТипЗнч(ОсновнойМатериал) = Тип("СправочникСсылка.ЦеновыеГруппы") Тогда
		ОсновнойМатериалНом = ОсновнойМатериал.ОсновнаяНоменклатура;
		ПлотностьИзНоменклатуры = 0;
		Попытка
			ПлотностьИзНоменклатуры = ОсновнойМатериалНом.ВесЕдиницаИзмерения.Числитель / ОсновнойМатериалНом.ВесЕдиницаИзмерения.Знаменатель * 1000 * ОсновнойМатериалНом.ВесЧислитель / ОсновнойМатериалНом.ВесЗнаменатель;
		Исключение
		КонецПопытки;
		Если ПлотностьИзНоменклатуры > 0 И ПлотностьИзНоменклатуры < 1000 Тогда
			Плотность = ПлотностьИзНоменклатуры;
		Иначе
			ПлотностьИзЦГ = ОсновнойМатериал.Лико_УдельныйВес;
			Если ЗначениеЗаполнено(ПлотностьИзЦГ) Тогда
				Плотность = ПлотностьИзЦГ;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ОсновнойМатериал) = Тип("СправочникСсылка.Номенклатура") И НЕ ОсновнойМатериал.ВидНоменклатуры.Лико_НоменклатураЭтикеток Тогда
		ПлотностьИзНоменклатуры = 0;
		Попытка
			ПлотностьИзНоменклатуры = ОсновнойМатериал.ВесЕдиницаИзмерения.Числитель / ОсновнойМатериал.ВесЕдиницаИзмерения.Знаменатель * 1000 * ОсновнойМатериал.ВесЧислитель / ОсновнойМатериал.ВесЗнаменатель;
			Если ПлотностьИзНоменклатуры > 0 И ПлотностьИзНоменклатуры < 1000 Тогда
				Плотность = ПлотностьИзНоменклатуры;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Если ПлотностьИзНоменклатуры = 0 Тогда
			ПлотностьИзЦГ = ОсновнойМатериал.ЦеноваяГруппа.Лико_УдельныйВес;
			Если ЗначениеЗаполнено(ПлотностьИзЦГ) Тогда
				Плотность = ПлотностьИзЦГ;
			КонецЕсли;
		КонецЕсли;			
	КонецЕсли;
	//Если ЗначениеЗаполнено(ОсновнойМатериал) И НЕ ОсновнойМатериал.ВидНоменклатуры.Лико_НоменклатураЭтикеток Тогда
	//	Попытка
	//		ПлотностьИзНоменклатуры = ОсновнойМатериал.ВесЕдиницаИзмерения.Числитель / ОсновнойМатериал.ВесЕдиницаИзмерения.Знаменатель * 1000 * ОсновнойМатериал.ВесЧислитель / ОсновнойМатериал.ВесЗнаменатель;
	//		Если ПлотностьИзНоменклатуры > 0 И ПлотностьИзНоменклатуры < 1000 Тогда
	//			Плотность = ПлотностьИзНоменклатуры;
	//		КонецЕсли;
	//	Исключение
	//	КонецПопытки;
	//КонецЕсли;
	
	//формулу взял из УПП
	Коэффициент = Номенклатура.ПлощадьЕдиницаИзмерения.Числитель / ?(Номенклатура.ПлощадьЕдиницаИзмерения.Знаменатель = 0, 1, Номенклатура.ПлощадьЕдиницаИзмерения.Знаменатель);
	Если Коэффициент = 0 Тогда
		Сообщить("У номенклатуры """ + Номенклатура + """ (" + Номенклатура.Код + ") не заполнена площадь");
		Возврат 0;
	КонецЕсли;
	
	Вес = Окр(Площадь / Коэффициент * Плотность * КоличествоВУпаковке / 1000 + 1/КоробокВКомплекте, 1);
	
	Возврат Вес;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 29.03.2017 

// Получает значение дополнительного реквизита элемента
//
// Параметры:
//  ИмяДопРеквизитаВСправочникеПредопределенных - Строка - имя элемента предопределенных данных справочника "ЛикоПредопределенныеЗначения", в котором хранится ссылка на доп. ревизит
//  СсылкаНаЭлемент - Ссылка - ссылка на элемент, у которого нужно искать доп. реквзит.
//
//  Возвращаемое значение:
//      ПроизвольноеЗначение, Неопределено - значение дополнительного реквизита. Неопределено, если доп реквизит не найден или не заполне
//
Функция ПолучитьЗначениеДопРеквизитаЭлемента(ИмяДопРеквизитаВСправочникеПредопределенных = "", СсылкаНаЭлемент, УникальноеИмяДопРеквизитаДляРазрабочиков = "", ЗначениеПоУмолчанию = Неопределено) Экспорт // --> Начало Лико Ефимов ЕВВ 05.04.2017
	
	Попытка
		Если ТипЗнч(СсылкаНаЭлемент) = Тип("Строка") Тогда
			СсылкаНаЭлемент = ПолучитьЗначениеПредопределенныхДанных(СсылкаНаЭлемент);
		КонецЕсли;
		Если ЗначениеЗаполнено(ИмяДопРеквизитаВСправочникеПредопределенных) Тогда
			ДопРеквизит = Справочники.Лико_ПредопределенныеЗначения[ИмяДопРеквизитаВСправочникеПредопределенных].ЗначениеПараметра;
		ИначеЕсли ЗначениеЗаполнено(УникальноеИмяДопРеквизитаДляРазрабочиков) Тогда
			ДопРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", УникальноеИмяДопРеквизитаДляРазрабочиков);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ДопРеквизит) Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СсылкаНаЭлемент) Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕслИ;
		
		ИмяОбъекта = СсылкаНаЭлемент.Метаданные().ПолноеИмя();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Т.Значение
		|ИЗ
		|	" + ИмяОбъекта + ".ДополнительныеРеквизиты КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка
		|	И Т.Свойство = &Свойство";
		
		Запрос.УстановитьПараметр("Свойство", ДопРеквизит);
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаЭлемент);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Значение;
		Иначе
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 05.04.2017 

// Находит последний документ по номеру из 7 символов (правых). Тип документа задается. 
//
// Параметры:
//  НомерДокумента - Строка - номер документа из 7 символов.
//  ТипДокумента - Строка - название документа, по умолчанию "ЗаказНаПроизводство2_2".
//
//  Возвращаемое значение:
//      ДокументСсылка, Неопределено - Ссылка на документ или неопределено, если документ не найден.
//
Функция НайтиДокументПоНомеру7Символов(Знач НомерДокумента, ТипДокумента = "ЗаказНаПроизводство2_2") Экспорт // --> Начало Лико Ефимов ЕВВ 05.04.2017
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(НомерДокумента) = Тип("Число") Тогда
		НомерДокумента = Формат(НомерДокумента, "ЧЦ=7; ЧВН=; ЧГ=0");
	КонецЕсли;
	НомерДокумента = СокрЛП(НомерДокумента);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка,
	|	Т.Дата КАК Дата
	|ИЗ
	|	Документ.ЗаказНаПроизводство2_2 КАК Т
	|ГДЕ
	|	ПОДСТРОКА(Т.Номер, 5, 7) = &НомерЗаказа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("НомерЗаказа", НомерДокумента);
	Если ТипДокумента <> "ЗаказНаПроизводство2_2" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЗаказНаПроизводство2_2", ТипДокумента);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 05.04.2017

// Находит первую по порядку обхода зону приемки склада. 
//
// Параметры:
//  Склад - СправочникСсылка.Склады - склад, для которого происходит поиск зоны приемки.
//
//  Возвращаемое значение:
//      СправочникСсылка.СкладскиеЯчейки, Неопределено - Ссылка на складскую яччейку или неопределено, если для склада не найдена ни одна зона приемки.
//
Функция ПолучитьЗонуПриемкиПоСкладу(Склад) Экспорт // --> Начало Лико Ефимов ЕВВ 11.04.2017
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СкладскиеЯчейки.Ссылка
	|ИЗ
	|	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
	|ГДЕ
	|	СкладскиеЯчейки.Владелец = &Склад
	|	И НЕ СкладскиеЯчейки.ПометкаУдаления
	|	И СкладскиеЯчейки.ТипСкладскойЯчейки = ЗНАЧЕНИЕ(Перечисление.ТипыСкладскихЯчеек.Приемка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СкладскиеЯчейки.ПорядокОбхода";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 11.04.2017

// Находит первую по порядку обхода зону отгрузки склада. 
//
// Параметры:
//  Склад - СправочникСсылка.Склады - склад, для которого происходит поиск зоны отгрузки.
//
//  Возвращаемое значение:
