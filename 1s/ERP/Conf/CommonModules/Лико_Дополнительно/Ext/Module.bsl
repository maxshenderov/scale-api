#Область ВспомогательныеФункцииДляСозданияТиповыхДокументов

// Записывает типовые документы в регистр сведений Лико_СвязиСТиповымиДокументами. 
//
// Параметры:
//  ТаблицаНовыхДокументов - ТаблицаЗначений - Таблица с колонками "Заказ" и "Документ". Заказ может принимать значение Неопределено, а документ всегда должен быть заполнен
//  Ссылка - ДокументСсылка - Ссылка на НЕтиповой документ, к которому привязываются типовые документы
//
//  Возвращаемое значение:
//      Булево - результат выполнения записи.
//
Функция ЗаписатьТиповыеДокументыВРегистрЛико_СвязиСТиповымиДокументами(ТаблицаНовыхДокументов, Ссылка, ЗаказКлиента = Неопределено) Экспорт
	
	// регистр ЛикоСвязиСТиповымиДокументами
	НаборЗаписи = РегистрыСведений.Лико_СвязиСТиповымиДокументами.СоздатьНаборЗаписей();
	НаборЗаписи.Отбор.Документ.Установить(Ссылка);
	Если ЗаказКлиента = Неопределено Тогда
		НомерСтроки = 1;
	Иначе
		НаборЗаписи.Отбор.Заказ.Установить(ЗаказКлиента);
		НомерСтроки = НайтиМаксимальныйНомерВЦепочкеВРегистреСвязиСТиповымиДокументами(Ссылка) + 1;
	КонецЕсли;
	Для Каждого Строка Из ТаблицаНовыхДокументов Цикл
		Если Строка.Документ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = НаборЗаписи.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Документ = Ссылка;
		НоваяСтрока.ТиповойДокумент = Строка.Документ;
		// Для корректировок умножим НомерВЦепочке на 10, посколько вместо них скорее всего создадутся несколько других документов  (благодаря умножению для них останется "место")
		НоваяСтрока.НомерВЦепочке = НомерСтроки * ?(ТипЗнч(Строка.Документ) = Тип("ДокументСсылка.КорректировкаРегистров"), 10, 1); 
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	Попытка
		НаборЗаписи.Записать(Истина);
	Исключение
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось записать данные в регистр сведений ЛикоСвязиСТиповымиДокументами! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Функция НайтиМаксимальныйНомерВЦепочкеВРегистреСвязиСТиповымиДокументами(НеТиповойДокумент) Экспорт // --> Начало Лико Ефимов ЕВВ 28.05.2018 
	
	// Найдем максимальный номер строки
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.НомерВЦепочке КАК НомерВЦепочке
	|ИЗ
	|	РегистрСведений.Лико_СвязиСТиповымиДокументами КАК Т
	|ГДЕ
	|	Т.Документ = &Документ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерВЦепочке УБЫВ";
	Запрос.УстановитьПараметр("Документ", НеТиповойДокумент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НомерВЦепочке = Выборка.НомерВЦепочке;
	Иначе
		НомерВЦепочке = 0;
	КонецЕсли;
	Возврат НомерВЦепочке;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 28.05.2018 

// Находит в регистре сведений Лико_СвязиСТиповымиДокументами уже сформированные документы. 
//
// Параметры:
//  УдалятьВсеДокументы - Булево - Признак того, нужно ли распроводить и помечать на удаление найденные документы
//  Заказ - ДокументСсылка.ЗаказКлиента - Ссылка на документ ЗаказКлиента, для которого осуществляется поиск типовых документов (принадлежащих НЕтиповому документу Ссылка)
//  КлючиСтруктуры - Строка - Строка с названиями типовых документов, разделенных запятой, типы которых могут принимать типовые документы (подбробнее написано в самой функции)
//  Ссылка - ДокументСсылка - Ссылка на НЕтиповой документ, для которого осуществляется поиск типовых документов
//  ОтменятьПроведение - Булево - Признак того, нужно ли распроводить найденные документы
//
//  Возвращаемое значение:
//      Структура, Неопределено - Структура с типовыми документами, где ключом является тип документа из строки КлючиСтруктуры, а значением ссылка на типовой документ.
//					Если не удается распровести или пометить на удаление документы, то возвращается Неопределено.
//
Функция НайтиУжеСформированныеТиповыеДокументы(УдалятьВсеДокументы = Ложь, Отборы = Неопределено, КлючиСтруктуры, Ссылка, ОтменятьПроведение = Истина, ДополнительноеСвойство = Неопределено) Экспорт
	
	//Строка КлючиСтруктуры должна содержать через запятую названия всех типовых документов, которые должен создавать ЛикоФормированиеПаллета
	//причем в порядке их распроведения (т.е. сначала распроводиться последний документ в цепочке, чтобы отработала проверка доступности товаров на складах)
	//исходя из этой строки формируется СтруктураДокументов, а также МассивДопустимыхТипов для проверки принадлежности связанного документа
	//(если документ не пройдет проверку принадлежности, система проигнорирует его, и при записи регистра типовых документов он уже туда не попадет)
	МассивДопустимыхТипов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КлючиСтруктуры, ",",Истина,Истина);
	СтруктураДокументов = Новый Структура;
	Для каждого Тип из МассивДопустимыхТипов Цикл
		СтруктураДокументов.Вставить(Тип, Неопределено);
	КонецЦикла;
	Заказ = Неопределено;
	Контрагент = Неопределено;
	Валюта = Неопределено;
	Регион = Неопределено;
	Номенклатура = Неопределено;
	Склад = Неопределено;
	РаспоряжениеНаРастарку = Неопределено;
	НомерЦепочкиВРаспоряженииНаРастарку = Неопределено;
	Если Отборы <> Неопределено Тогда
		Отборы.Свойство("Заказ", Заказ);
		Отборы.Свойство("Контрагент", Контрагент);
		Отборы.Свойство("Валюта", Валюта);
		Отборы.Свойство("Регион", Регион);
		Отборы.Свойство("Номенклатура", Номенклатура);
		Отборы.Свойство("Склад", Склад);
		Отборы.Свойство("РаспоряжениеНаРастарку", РаспоряжениеНаРастарку);
		Отборы.Свойство("НомерЦепочкиВРаспоряженииНаРастарку", НомерЦепочкиВРаспоряженииНаРастарку);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_СвязиСТиповымиДокументами.ТиповойДокумент
	|ИЗ
	|	РегистрСведений.Лико_СвязиСТиповымиДокументами КАК Лико_СвязиСТиповымиДокументами
	|ГДЕ
	|	Лико_СвязиСТиповымиДокументами.Документ = &Документ
	|	И ВЫБОР
	|			КОГДА &Заказ = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Лико_СвязиСТиповымиДокументами.Заказ = &Заказ
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Контрагент = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Лико_СвязиСТиповымиДокументами.Контрагент = &Контрагент
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Валюта = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Лико_СвязиСТиповымиДокументами.Валюта = &Валюта
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Регион = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Лико_СвязиСТиповымиДокументами.Регион = &Регион
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Номенклатура = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Лико_СвязиСТиповымиДокументами.Номенклатура = &Номенклатура
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Склад = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Лико_СвязиСТиповымиДокументами.Склад = &Склад
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &РаспоряжениеНаРастарку = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Лико_СвязиСТиповымиДокументами.РаспоряжениеНаРастарку = &РаспоряжениеНаРастарку
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &НомерЦепочкиВРаспоряженииНаРастарку = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Лико_СвязиСТиповымиДокументами.НомерЦепочкиВРаспоряженииНаРастарку = &НомерЦепочкиВРаспоряженииНаРастарку
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Лико_СвязиСТиповымиДокументами.НомерВЦепочке УБЫВ";
	
	Запрос.УстановитьПараметр("Документ", Ссылка);
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("Регион", Регион);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("РаспоряжениеНаРастарку", РаспоряжениеНаРастарку);
	Запрос.УстановитьПараметр("НомерЦепочкиВРаспоряженииНаРастарку", НомерЦепочкиВРаспоряженииНаРастарку);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивДляУдаления = Новый Массив;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если УдалятьВсеДокументы Тогда
		// Отдельным циклом заполним массив для удаления, чтобы сохранить порядок колонки НомерВЦепочке
		Пока Выборка.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(Выборка.ТиповойДокумент) Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьДокументВМассивУдаленияВСоответсвтииСДопустимымиТипами(Выборка.ТиповойДокумент, МассивДляУдаления, МассивДопустимыхТипов);
			ДобавитьДокументВСтруктуру(СтруктураДокументов, Выборка.ТиповойДокумент, МассивДляУдаления, МассивДопустимыхТипов);
		КонецЦикла;
	Иначе
		Пока Выборка.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(Выборка.ТиповойДокумент) Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьДокументВСтруктуру(СтруктураДокументов, Выборка.ТиповойДокумент, МассивДляУдаления, МассивДопустимыхТипов);
		КонецЦикла;
		
		Если ОтменятьПроведение Тогда
			//распроведем найденные типовые документы
			Результат = РаспровестиДокументыСтруктуры(СтруктураДокументов, ДополнительноеСвойство);
			Если НЕ Результат Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Результат = ПометитьНаУдалениеДокументыМассива(МассивДляУдаления, ДополнительноеСвойство);
	Если НЕ Результат Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СтруктураДокументов;
	
КонецФункции

// Распроводит все документы структуры. 
//
// Параметры:
//  Структура - Структура - Структура, в значениях которой хранятся ссылки на документы, которые необходимо распровести
//
//  Возвращаемое значение:
//      Булево - Результат распроведения.
//
Функция РаспровестиДокументыСтруктуры(Структура, ДополнительноеСвойство)
	
	Для каждого Элемент из Структура Цикл
		Если Элемент.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДокОбъект = Элемент.Значение.ПолучитьОбъект();
		
		Если ТипЗнч(ДополнительноеСвойство) = Тип("Структура") Тогда
			Для каждого ЭлементСтруктуры из ДополнительноеСвойство Цикл
				ДокОбъект.ДополнительныеСвойства.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
			КонецЦикла;
		ИначеЕсли ДополнительноеСвойство <> Неопределено Тогда
			ДокОбъект.ДополнительныеСвойства.Вставить(ДополнительноеСвойство);
		КонецЕсли;
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Исключение
			Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось распровести документ """ + ДокОбъект + """. Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
			ОтменитьТранзакцию();
			ВызватьИсключение;
			Возврат Ложь;
		КонецПопытки;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Добавляет все документы структуры в массив. 
//
// Параметры:
//  Структура - Структура - Структура, в значениях которой хранятся ссылки на документы, которые необходимо добавить в массив
//  МассивДокументов - Массив - Массив, в который нужно добавить документы структуры
//
//  Возвращаемое значение:
//      Булево - Результат распроведения.
//
Функция ДобавитьДокументыСтруктурыВМассив(Структура, МассивДокументов)
	
	Для каждого Элемент из Структура Цикл
		Если Элемент.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МассивДокументов.Добавить(Элемент.Значение);
	КонецЦикла;
	
КонецФункции

// Помечает на удаление все документы массива. 
//
// Параметры:
//  Массив - Массив - Массив документов, которые необходимо пометить на удаление
//
//  Возвращаемое значение:
//      Булево - Результат пометки удаления.
//
Функция ПометитьНаУдалениеДокументыМассива(Массив, ДополнительноеСвойство) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);	
	Для каждого Документ из Массив Цикл
		Если Документ.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		ДокОбъект = Документ.ПолучитьОбъект();
		ДокОбъект.ПометкаУдаления = Истина;
		
		Если ТипЗнч(ДополнительноеСвойство) = Тип("Структура") Тогда
			Для каждого ЭлементСтруктуры из ДополнительноеСвойство Цикл
				ДокОбъект.ДополнительныеСвойства.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
			КонецЦикла;
		ИначеЕсли ДополнительноеСвойство <> Неопределено Тогда
			ДокОбъект.ДополнительныеСвойства.Вставить(ДополнительноеСвойство);
		КонецЕсли;
		
		Попытка
			Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КорректировкаРегистров") Тогда
				Для каждого СтрокаТЧ из ДокОбъект.ТаблицаРегистров Цикл
					ДокОбъект.Движения[СтрокаТЧ.Имя].Прочитать();
					ДокОбъект.Движения[СтрокаТЧ.Имя].Очистить();
					ДокОбъект.Движения[СтрокаТЧ.Имя].Записать();
				КонецЦикла;
				ДокОбъект.ТаблицаРегистров.Очистить();
				ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				//// Корректировку после записи удалим безвозвратно
				//ДокОбъект.Удалить();
			Иначе
				ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
		Исключение
			Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось распровести документ """ + ДокОбъект + """. Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецПопытки;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Добавляет документ в структуру по определенным правилам. 
//
// Параметры:
//  СтруктураДокументов - Структура - Структура, в которую необходимо добавить документы. В структуре уже должны быть определены ключи, соответствующие типам документов.
//										Если документ переданного типа уже есть в структуре, он добавляется в МассивДляУдаления
//  ТиповойДокумент - ДокументСсылка - Документ, который нужно добавить в структуру.
//  МассивДляУдаления - Массив - Массив документов, в который добавляются документы, типы которых уже содержаться в структуре
//								(например, если документ ПриходныйОрдерНаТовары уже содержит значение в структуре, второй такой документ будет помещен в массив).
//  МассивДопустимыхТипов - Массив - Массив, в котором содержаться допустимые типы. Если переданный документ не будет принадлежать этому массиву, он будет пропущен.
//									Примечание: для документа ОтборРазмещениеТоваров через нижнее подчеркивание добавляется ВидОперации этого документа. Сделано так, потому что
//									для одного заказа может быть несколько отборов размещения. Например, при перемещении паллета из ячейки одного склада в ячейку другого склада
//									создается 2 типовых документа ОтборРазмещениеТоваров - "Отбор" (со склада расхода) и "Размещение" (на склад прихода)
//
Процедура ДобавитьДокументВСтруктуру(СтруктураДокументов, ТиповойДокумент, МассивДляУдаления, МассивДопустимыхТипов)
	
	ТипДокумента = ТиповойДокумент.Метаданные().Имя;
	Если ТипДокумента = "ОтборРазмещениеТоваров" Тогда
		ТипДокумента = ТипДокумента + "_" + ТиповойДокумент.ВидОперации;
	КонецЕсли;
	
	Если МассивДопустимыхТипов.Найти(ТипДокумента) = Неопределено Тогда
		//тип не является допустимым - удаляем
		//хотя нет, просто пропустим его. При перезаполнении регистра ЛикоСвязиСТиповымиДокументами его уже не будет
		//МассивДляУдаления.Добавить(ТиповойДокумент);
	Иначе
		Если СтруктураДокументов[ТипДокумента] = Неопределено Тогда
			//данной тип документа еще не заполнен в структуре - заполним
			СтруктураДокументов[ТипДокумента] = ТиповойДокумент;
		ИначеЕсли ТипДокумента <> "Лико_ПередачаТоваровМеждуОрганизациями" Тогда
			//В структуре уже есть документ такого типа, поэтому остальные документы с таким типом удаляем
			МассивДляУдаления.Добавить(ТиповойДокумент);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьДокументВМассивУдаленияВСоответсвтииСДопустимымиТипами(ТиповойДокумент, МассивДляУдаления, МассивДопустимыхТипов)
	
	ТипДокумента = ТиповойДокумент.Метаданные().Имя;
	Если ТипДокумента = "ОтборРазмещениеТоваров" Тогда
		ТипДокумента = ТипДокумента + "_" + ТиповойДокумент.ВидОперации;
	КонецЕсли;
	
	Если МассивДопустимыхТипов.Найти(ТипДокумента) = Неопределено Тогда
		// не добавляем
	Иначе
		// добавляем
		МассивДляУдаления.Добавить(ТиповойДокумент);
	КонецЕсли;
	
КонецПроцедуры

// Находит первый проведенный заказ на производство, созданный на основании заказа клиента. 
//
// Параметры:
//  ЗаказКлиента - ДокументСсылка.ЗаказКлиента - Заказ клиента, на основании которого создан заказ на производство
//
//  Возвращаемое значение:
//      ДокументСсылка.ЗаказНаПроизводство2_2, Неопределено - Ссылка на документ "Заказ на производство". Неопределено, если документ не найден
//
Функция НайтиЗаказНаПроизводствоПоЗаказуКлиента(ЗаказКлиента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказНаПроизводство2_2.Ссылка
	|ИЗ
	|	Документ.ЗаказНаПроизводство2_2 КАК ЗаказНаПроизводство2_2
	|ГДЕ
	|	ЗаказНаПроизводство2_2.ДокументОснование = &ЗаказКлиента
	|	И НЕ ЗаказНаПроизводство2_2.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказНаПроизводство2_2.Проведен УБЫВ,
	|	ЗаказНаПроизводство2_2.Дата";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// !! Дописать описание функции. Функция не подберет ячейки, если товар находится в зоне отгрузки (типовое ограничение)
Функция СоздатьДокументОтборРазмещениеТоваровНаОснованииРасходногоОрдера(РасходныйОрдерНаТовары, УжеСозданныйДокумент = Неопределено, ОтключитьЧастьПроверок = Ложь, ОтгружатьИзЗоныОтгрузки = Ложь) Экспорт
	
	Отказ = Ложь;
	
	НовыйДокОбъект = Документы.ОтборРазмещениеТоваров.СоздатьДокумент();
	Если НЕ ОтгружатьИзЗоныОтгрузки Тогда
		// Ячейки должны подобраться автоматически при создании на основании
		НовыйДокОбъект.Заполнить(РасходныйОрдерНаТовары);
		НовыйДокОбъект.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.ВыполненоБезОшибок;
	Иначе
		// Товары лежат в зоне отгрузки, поэтому ячейки не смогут подобраться автоматически. Создаем документ вручную
		НовыйДокОбъект.ВидОперации = Перечисления.ВидыОперацийОтбораРазмещенияТоваров.Отбор;
		НовыйДокОбъект.ЗонаОтгрузки = Лико_Дополнительно.ПолучитьЗонуОтгрузкиПоСкладу(РасходныйОрдерНаТовары.Склад);
		НовыйДокОбъект.Исполнитель = ПараметрыСеанса.ТекущийПользователь;
		НовыйДокОбъект.Распоряжение = РасходныйОрдерНаТовары;
		НовыйДокОбъект.Склад = РасходныйОрдерНаТовары.Склад;
		
		Для каждого Строка из РасходныйОрдерНаТовары.ОтгружаемыеТовары Цикл
			НоваяСтрока = НовыйДокОбъект.ТоварыОтбор.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.КоличествоОтобрано = Строка.Количество;
			НоваяСтрока.КоличествоУпаковокОтобрано = Строка.КоличествоУпаковок;
			НоваяСтрока.Ячейка = НовыйДокОбъект.ЗонаОтгрузки;
		КонецЦикла;	
	КонецЕсли;
	НовыйДокОбъект.Дата = РасходныйОрдерНаТовары.Дата;
	НовыйДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	НовыйДокОбъект.Комментарий = РасходныйОрдерНаТовары.Комментарий;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	НовыйДокОбъект.ДополнительныеСвойства.Вставить("Лико_АвтоматическоеСоздание");
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция ПровестиДокументВДругомСтатусе(Документ, Статус) Экспорт
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	ДокОбъект = Документ.ПолучитьОбъект();
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда
		Для каждого Строка из ДокОбъект.ОтгружаемыеТовары Цикл
			Если Статус = Перечисления.СтатусыРасходныхОрдеров.Отгружен Тогда
				Строка.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить;
			Иначе
				Строка.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отобрать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ДокОбъект.Статус = Статус;
	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + ДокОбъект + """ не удалось провести в статусе """ + Статус + """! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат НЕ Отказ;
	
КонецФункции

Функция ЗаписатьДокументВДругомСтатусеБезПроведения(Документ, Статус) Экспорт
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	ДокОбъект = Документ.ПолучитьОбъект();
	ДокОбъект.Статус = Статус;
	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + ДокОбъект + """ не удалось провести в статусе """ + Статус + """! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат НЕ Отказ;
	
КонецФункции

Функция ПолучитьКлючиСтруктурыБезДокумента(КлючиСтруктуры, ИмяДокумента) Экспорт // --> Начало Лико Ефимов ЕВВ 26.07.2017
	Позиция = СтрНайти(КлючиСтруктуры, ИмяДокумента);
	Если Позиция = 0 Тогда
		Возврат КлючиСтруктуры;
	Иначе
		НовыйКлюч = Лев(КлючиСтруктуры, Позиция-1) + Прав(КлючиСтруктуры, СтрДлина(КлючиСтруктуры) - Позиция + 1 - СтрДлина(ИмяДокумента));
		Возврат НовыйКлюч;
	КонецЕсли;
КонецФункции // <-- Конец Лико Ефимов ЕВВ 26.07.2017

Функция НайтиСкладРегиона(Регион) Экспорт // --> Начало Лико Ефимов ЕВВ 09.08.2017
	
	// --> Начало Лико Ефимов ЕВВ 20.01.2021
