		// Очистим этапы графика оплаты, чтобы не было ошибок при отгрузке, когда в этапах стоит предоплата или аванс
		Источник.ЭтапыГрафикаОплаты.Очистить();
		// <-- Конец Лико Ефимов ЕВВ 21.05.2019
	КонецЕсли;
	
	// --> Начало Лико Ефимов ЕВВ 16.04.2020
	Если ТипИсточника = Тип("ДокументОбъект.РеализацияТоваровУслуг")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ВозвратТоваровОтКлиента")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.КорректировкаРеализации") Тогда
