Функция ПолучитьШкДопСтикераIML(Серия) Экспорт
	
	// шк состоит из 25 символов xxxxxxxxxxyyyyyyzzzzzwwww
	// xxxxxxxxxx (10 симоволов) - код дизайна (код этикетки заказчика)
	// yyyyyy (6 симв) - дата в формате ддммгг
	// zzzzz (5 симв) - количество этикеток
	// wwww (4 симв) - номер коробки
	КодДизайна = СокрЛП(Серия.Лико_КодЭтикеткиЗаказчика);
	Если СтрДлина(КодДизайна) > 10 Тогда
		КодДизайна = Лев(КодДизайна, 10);
	ИначеЕсли СтрДлина(КодДизайна) < 10 Тогда
		КодДизайна = Прав("0000000000", 10 - СтрДлина(КодДизайна)) + КодДизайна;
	КонецЕсли;
	ДатаУпаковкиСтрока = Формат(Серия.Лико_ДатаУпаковки, "ДФ=ddMMyy");
	КоличествоСтрока = Формат(Серия.Лико_КоличествоВУпаковке * 1000, "ЧЦ=5; ЧДЦ=; ЧВН=; ЧГ=0");
	НомерКоробкиСтрока = Формат(Серия.Лико_НомерКоробки, "ЧЦ=4; ЧДЦ=; ЧВН=; ЧГ=0");
	Штрихкод = "" + КодДизайна + ДатаУпаковкиСтрока + КоличествоСтрока + НомерКоробкиСтрока;
	Возврат Штрихкод;
	
КонецФункции

// Раскладывает строку без пробелов в строку с пробелами (например, "ЛикоЗаявкаНаТранспортировку" переделает в "Лико заявка на транспортировку"). 
//
// Параметры:
//  Строка - Строка - Строка без пробелов
//
//  Возвращаемое значение:
//      Строка - Строка с пробелами
//
Функция РазложитьСтрокуКакЭтоДелаетКонфигураторСНазваниямиОбъектовПереводяИхВСиноним(Строка) Экспорт
	
	НоваяСтрока = "";
	Для сч = 1 по СтрДлина(Строка) Цикл
		ТекСимвол = Сред(Строка, сч, 1);
		Если сч = 1 Тогда
			НоваяСтрока = ТекСимвол;
			Продолжить;
		КонецЕсли;
		Если ВРег(ТекСимвол) = ТекСимвол Тогда
			//Это большая буква
			НоваяСтрока = НоваяСтрока + " " + НРег(ТекСимвол);
		Иначе
			НоваяСтрока = НоваяСтрока + ТекСимвол;
		КонецЕсли;
	КонецЦикла;
	Возврат НоваяСтрока;
	
КонецФункции

// Вычисляет смену по переданному времени. 
//
// Параметры:
//  ТекВремя - Дата - Дата с временем
//
//  Возвращаемое значение:
//      Число - Номер смены
//
Функция ВычислитьСмену(ТекВремя) Экспорт
	Час1 = Час(ТекВремя);
	Мин1 = Минута(ТекВремя);
	Если (Час1 <= 9 и Мин1 < 30) ИЛИ (Час1 < 9) ИЛИ (Час1 >= 21 и Мин1 > 29) ИЛИ (Час1 >= 22) Тогда
		Возврат 2;
	Иначе
		Возврат 1;
	КонецЕсли;
КонецФункции

// Вспомогательная функция для отладки печатных форм при печати через форму обработки, чтобы печатные формы выводились в типовую форму печати, а не просто ТабДок.Показать()
//
// Параметры:
//  ТабличныеДокументы - Массив - массив с табличными документами, у которых обязательно должно быть заполнено свойство ИмяПараметровПечати
//  ЛеваяЧастьИмени - Строка - левая часть имени элемента.
//
//  Возвращаемое значение:
//      Структура - структура печатных форм в типовом виде
//
Функция ПодготовитьКоллекциюПечатныхФорм(ТабличныеДокументы) Экспорт
	КоллекцияПечатныхФорм = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(Новый Массив);
	Для каждого ТабличныйДокумент из ТабличныеДокументы Цикл
		ИмяМакета = ТабличныйДокумент.ИмяПараметровПечати;
		СинонимМакета = Лико_Дополнительно.РазложитьСтрокуКакЭтоДелаетКонфигураторСНазваниямиОбъектовПереводяИхВСиноним(ИмяМакета);
		Если КоллекцияПечатныхФорм.Найти(ВРЕГ(ТабличныйДокумент.ИмяПараметровПечати), "ИмяВРЕГ") = Неопределено Тогда
			НоваяПФ = КоллекцияПечатныхФорм.Добавить();
			НоваяПФ.ИмяВРЕГ = ВРег(ИмяМакета);
			НоваяПФ.ИмяМакета = ИмяМакета;
			НоваяПФ.Экземпляров = ТабличныйДокумент.КоличествоЭкземпляров;
		КонецЕсли;
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ТабличныйДокумент);
	КонецЦикла;
	Возврат КоллекцияПечатныхФорм;
КонецФункции

