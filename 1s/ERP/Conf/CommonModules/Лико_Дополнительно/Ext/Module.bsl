Функция ОбработатьШтрихКодНеТовараСервер(ШК) Экспорт // --> Начало Лико Ефимов ЕВВ 30.03.2017
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	
	Если СтрДлина(ШК) > 0 Тогда
		
		Результат = РасшифроватьШК(ШК);
		Если СтрДлина(Результат.Ошибка) > 0 Тогда
			Возврат Результат;
		КонецЕсли;
		
		Результат = ОбработкаШК(Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 30.03.2017 

Функция ОбработкаШК(ДанныеШК, ФормаКлиента=Неопределено, ГП = Ложь) Экспорт //AS
	
	Результат = ДанныеШК;
	Ош = "Штрихкод "+ДанныеШК.ШК+" не обработан.";
	
	Если ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_Сотрудника Тогда // работаем со справочником сотрудников
		
		ОбработкаШК_Сотрудник(ДанныеШК, ФормаКлиента, Результат);
		Возврат Результат;
		
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_ЗаказаСпецификации Тогда // Заказ-спецификация
		
		ОбработкаШК_ЗаказСпецификация(ДанныеШК, ФормаКлиента, Результат);
		
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_Заказа Тогда
		
		//Ничего делать не нужно, вся инфа уже лежит в результате
		
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_Паллета Тогда //AS 9-паллет
		
		ОбработкаШК_Паллет(ДанныеШК, ФормаКлиента, Результат, ГП);
		
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_Адреса Тогда //AS 18-АдресХранения
		
		ОбработкаШК_АдресХранения(ДанныеШК, ФормаКлиента, Результат);
		
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_Адреса_Короткий Тогда //AS 18-АдресХранения (краткий)
		
		ОбработкаШК_АдресХранения(ДанныеШК, ФормаКлиента, Результат);
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры_Короткий Тогда // ЯССМ Объекты номенклатуры короткий шк
		
		ОбработкаШК_ЯССМ_ОбъектНоменклатурыКороткий(ДанныеШК, ФормаКлиента, Результат);
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры Тогда
		
		ОбработкаШК_ЯССМ_ОбъектНоменклатуры(ДанныеШК, ФормаКлиента, Результат);
		
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_ЗаявкаНаСклад Тогда // ЯССМ заявка на склад шк
		
		ОбработкаШК_ЯССМ_ЗаявкаНаСклад(ДанныеШК, ФормаКлиента, Результат);
		
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_Конверта Тогда // ЯССМ заявка на склад шк
		
		ОбработкаШК_Конверт(ДанныеШК, ФормаКлиента, Результат);
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_РабочегоЦентра Тогда // работаем со справочником рабочих центров
		
		ОбработкаШК_РабочийЦентр(ДанныеШК, ФормаКлиента, Результат);
		
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_ВходящихДокументов Тогда // Входящий документ
		
		ОбработкаШК_ВходящихДокументов(ДанныеШК, ФормаКлиента, Результат);
		
		// --> Начало Лико Ефимов ЕВВ 27.07.2020
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_Растарки Тогда // Растарка
		
		ОбработкаШК_Растарки(ДанныеШК, Результат);
		
		// <-- Конец Лико Ефимов ЕВВ 27.07.2020
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_Тара Тогда // Растарка
		
		ОбработкаШК_Тара(ДанныеШК, Результат);
		
		// <-- Начало Лико Яцун С. В. 26.05.2025 
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_КартаСнятияПерерасхода Тогда // Растарка
		
		ОбработкаШК_КартаСнятияПерерасхода(ДанныеШК, Результат);
		// <-- Конец Лико Яцун С. В. 26.05.2025 
		
	//+ ---> Лико m.shenderov 24.02.2026
				
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_ТипоразмерПаллета Тогда // ТипоразмерПаллета
		
		ОбработкаШК_ТипоразмерПаллета(ДанныеШК, Результат);
		//- <--- Лико m.shenderov 24.02.2026
	ИначеЕсли ДанныеШК.ВидШК = Перечисления.ЯС_ВидыШК.ШК_Паллета2_0 Тогда // Паллет 2.0 
		ОбработкаШК_Паллет2_0(ДанныеШК, Результат);
		
	Иначе
		
		Результат.Ошибка = Ош;
	КонецЕсли; // обработка справочников
	
	Возврат Результат;
КонецФункции

// Функция расшифровывает ШК с проверкой контрольного символа и возвращает структуру,
// содержащую сам штрихкод, его вид, управляющий символ, вид информации.
//
// Параметры:
//  ШК				- <Строка>
//					штрихкод.
//  ТипШК			- <ПланВидовХарактеристикСсылка.ТипыШтрихкодов>
//					тип штрихкода.
//  ГУИДСканераШК	- <Строка>
//					уникальный идентификатор сканера штрихкодов.
//
// Возвращаемое значение:
//  <Структура> - Структура расшифрованных параметров.
//
Функция РасшифроватьШК(ШК, ТипШК=Неопределено, ГУИДСканераШК="") Экспорт //AS
	
	// видимо 14, 12 и 20 - это длинный ЛИКО - ШК
	
	// 12 символьное кодирование
	// УпрСимвол 		- 1 символ ШК (1 команда, 2 справочник)
	// ВидИнформации 	- 3 символа (код справочника,команды и т.п.)
	// КодИнформации;   - 7 символов Уникальный номер
	// Перем КонтрСумма - 1 символ
	
	// 14 символьное кодирование
	// УпрСимвол 		- 1 символ ШК (1 команда, 2 справочник)
	// ВидИнформации 	- 3 символа (код справочника,команды и т.п.)
	// НомерБланка		- 2 символа
	// КодИнформации;   - 7 символов Уникальный номер
	// Перем КонтрСумма - 1 символ
	
	///////////////////////////////////////////////////////
	// EPSMA штрихкоды (с примером)
	//
	// EPSMA Roll Number - Номер бобины (20 символов)
	// 00 x xxxxxx xxxxxxxxxx x       общий случай
	// 00 3 641578 9991570014 9       пример
	//  | |   |        |      |
	//  | |   |        |      |______ Контрольный символ
	//  | |   |        |_____________ Порядковый номер
	//  | |   |______________________ Индивидуальный ean-код продукта
	//  | |__________________________ Инликатор упаковщика
	//  |____________________________ Идентификатор приложения
	//
	//
	// EPSMA EAN Product Code - Код продукта (13 символов)
	// xxxxxxx xxxxx x                общий случай
	// 6415780 11589 1                пример
	//    |      |   |
	//    |      |   |_______________ Контрольный символ
	//    |      |___________________ Порядковый номер
	//    |__________________________ Индивидуальный ean-код продукта
	//
	//
	// EPSMA Roll Variables - Информация о продукте (18 символов)
	// 8001 0 xxx 0 xxxx xxx x x      общий случай
	// 8001 0 210 0 2400 076 0 0      пример
	//   |  |  |  |   |   |  | |
	//   |  |  |  |   |   |  | |_____ Количество склеек (0-7 - количество склеек, 8 - более 7, 9 - нет данных)
	//   |  |  |  |   |   |  |_______ Направление размотки (0 - лицом наружу, 1 - лицом внутрь, 9 - нет данных)
	//   |  |  |  |   |   |__________ Размер втулки
	//   |  |  |  |   |______________ Длина роля (мм)
	//   |  |  |  |__________________ [неизвестно]
	//   |  |  |_____________________ Ширина роля (мм)
	//   |  |________________________ [неизвестно]
	//   |___________________________ Идентификатор приложения (8 - управляющий символ, число(001) - вид информации)
	// 
	//
	// EPSMA Best Before Date - Употребить до (8 символов)
	// 15 xxxxxx                      общий случай
	// 15 120501                      пример
	//  |    |
	//  |    |_______________________ 2 символа - год, 2 символа - месяц, 2 символа - день
	//  |____________________________ Идентификатор приложения
	//
	//
	// EPSMA Customer Order Number - Номер заказа клиента (8 символов)     ПОПРАВИТЬ!!!!!!!!!
	// 40 xxxxxx                      общий случай
	// 40 013985                      пример
	//  |   |
	//  |   |________________________ Внутренний номер заказа клиента
	//  |____________________________ Идентификатор приложения
	//
	//
	// EPSMA Roll ID - порядковый номер бобины (12 символов) 
	//    [правая часть штрих-кода EPSMA Roll Number]
	// 
	// x xxxxxxxxxx x       общий случай
	// 8 9991570014 9       пример
	// |     |      |
	// |     |      |______ Контрольный символ
	// |     |_____________ Порядковый номер
	// |___________________ Один символ от ean-кода продукта (к примеру, 8 от 64157[8])
	// 
	///////////////////////////////////////////////////////
	
	///////////////////////////////////////////////////////
	// Штрих-код объекта номенклатуры (30 символов)
	//
	// 6 0x xxxxxxx xxx xxxx xxxxxxx xxxxx x     общий случай
	// 6 01 0000257 210 2000 0000075 00003 9     пример
	// |  |   |      |   |      |      |   |
	// |  |   |      |   |      |      |   |___ Контрольный символ
	// |  |   |      |   |      |      |_______ Серийный номер (#)
	// |  |   |      |   |      |______________ Код объекта номенклатуры (код элемента справочника)
	// |  |   |      |   |_____________________ Количественный показатель (количество килограмм, длина в метрах, количество штук в поставке)
	// |  |   |      |_________________________ Нарезка (ширина роля) - для рулонных материалов. Для остальных - 000.
	// |  |   |________________________________ Код номенклатуры (Код родительского элемента в справочнике Номенклатура)
	// |  |____________________________________ Вид информации (код справочника, документа и пр.). 01 или 02 - код справочника ЯССМ_ОбъектыНоменклатуры (уникальный и неуникальный)
	// |_______________________________________ Управляющий символ (6 для ячеистого склада сырья и материалов)
	//
	///////////////////////////////////////////////////////
	
	///////////////////////////////////////////////////////
	// Штрих-код заказа-спецификации (24 символов)
	//
	// 6 03 xx xxxxxxx xx xxxxxxxxx x     общий случай
	// 6 03 01 7212845 02 A00000108 0     пример
	// |  |  |    |    |      |     |
	// |  |  |    |    |      |     |__________ Контрольный символ
	// |  |  |    |    |      |________________ Код спецификации (код элемента справочника)
	// |  |  |    |    |_______________________ Номер передела
	// |  |  |    |____________________________ Номер заказа, 7 цифр
	// |  |  |_________________________________ Номер бланка, 2 цифры
	// |  |____________________________________ Вид информации (код справочника, документа и пр.). 03 - ШК заказа спецификации
	// |_______________________________________ Управляющий символ (6 для ячеистого склада сырья и материалов)
	//
	///////////////////////////////////////////////////////
	
	///////////////////////////////////////////////////////
	// Штрих-код конверта (13 символов)
	//
	// 6 04 xxxxxxxxx xx x     общий случай
	// 6 04 L00000001 01 0     пример
	// |  |     |     |  |
	// |  |     |     |  |_______ Контрольный символ
	// |  |     |     |__________ Тип конверта (тип по размеру)
	// |  |     |________________ Код коверта (код элемента справочника)
	// |  |______________________ Вид информации (код справочника, документа и пр.). 03 - ШК заказа спецификации
	// |_________________________ Управляющий символ (6 для ячеистого склада сырья и материалов)
	//
	///////////////////////////////////////////////////////
	
	///////////////////////////////////////////////////////
	// Короткий штрих-код объекта номенклатуры (15 символов)
	//
	// 6 05 хххх xxxxxxx x     общий случай
	// 6 05 2000 0000075 9     пример
	// |  |   |     |    |
	// |  |   |     |    |_____ Контрольный символ
	// |  |   |     |__________ Код объекта номенклатуры (код элемента справочника)
	// |  |   |________________ Количественный показатель (количество килограмм, длина в метрах, количество штук в поставке)	
	// |  |____________________ Вид информации (код справочника, документа и пр.). 01 или 02 - код справочника ЯССМ_ОбъектыНоменклатуры (уникальный и неуникальный)
	// |_______________________ Управляющий символ (6 для ячеистого склада сырья и материалов)
	//
	///////////////////////////////////////////////////////
	
	///////////////////////////////////////////////////////
	// Новый штрих-код сотрудника (14 символов)
	//
	// 6 06 хххxxxxxxx x     общий случай
	// 6 06 0000002975 9     пример
	// |  |     |   |
	// |  |     |   |_____ Контрольный символ
	// |  |     |_________ Код сотрудника (код элемента справочника)
	// |  |_______________ Вид информации (код справочника, документа и пр.). 06 - код справочника Сотрудники
	// |__________________ Управляющий символ (6 для ячеистого склада сырья и материалов)
	//
	///////////////////////////////////////////////////////
	
	///////////////////////////////////////////////////////
	// Штрих-код расширенного справочника "Расход[Приход] товароместа" (20 символов)
	//
	// 3 007 xxxxxxx xxxxxxxx x     общий случай [для Расход товароместа]
	// 3 007 0090813 00000002 3     пример
	// 3 008 xxxxxxx xxxxxxxx x     общий случай [для Приход товароместа]
	// 3 008 0090813 00000002 4     пример
	// |  |     |       |     |
	// |  |     |       |     |_________ Контрольный символ
	// |  |     |       |_______________ Серийный номер (#)
	// |  |     |_______________________ id упаковки товароместа
	// |  |_____________________________ Вид информации (код справочника). 7 - расход товароместа. 8 - приход товароместа.
	// |________________________________ Управляющий символ (3 - расширенные справочники
	//
	///////////////////////////////////////////////////////
	
	///////////////////////////////////////////////////////
	// Штрих-код расширенного справочника по товароместам + UID (20 символов)
	//
	// 3 004 xxxxxxx xxxxxxxx x     общий случай
	// 3 004 0175219 00000100 3     пример
	// |  |     |       |     |
	// |  |     |       |     |_________ Контрольный символ
	// |  |     |       |_______________ Серийный номер (#)
