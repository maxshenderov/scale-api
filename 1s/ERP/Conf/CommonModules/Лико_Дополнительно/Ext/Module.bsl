Функция ПравоДоступаКСсылке(Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Объект.Ссылка,
	|	Объект.ПометкаУдаления
	|
	|ИЗ
	|    " + Ссылка.Метаданные().ПолноеИмя() + " КАК Объект
	|ГДЕ
	|    Объект.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ОбновитьВЗаказеСреднееКоличествоВКоробкеИРолике(Заказ, ФормированиеПаллета = Неопределено, ЭтоОтменаПроведения = Ложь, ЗаписыватьВРежимеОбмена = Ложь) Экспорт // --> Начало Лико Ефимов ЕВВ 02.03.2021
	
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТЧДокумента.Серия КАК Серия
			|ПОМЕСТИТЬ ВТ_РастаренныеКоробки
			|ИЗ
			|	Документ.Лико_ФормированиеПаллета.СодержимоеРастарки КАК ТЧДокумента
			|ГДЕ
			|	ТЧДокумента.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры = &Заказ
			|	И (ТЧДокумента.Ссылка.Проведен
			|			ИЛИ ТЧДокумента.Ссылка = &ФормированиеПаллета)
			|	И ТЧДокумента.Ссылка.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыФормированияПаллет.ВыпускПродукции)
			|
			|СГРУППИРОВАТЬ ПО
			|	ТЧДокумента.Серия
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТЧДокумента.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры КАК Заказ,
			|	СУММА(ТЧДокумента.Серия.Лико_КоличествоВУпаковке) КАК Количество,
			|	СУММА(ТЧДокумента.Серия.Лико_КоличествоКоробок) КАК КоличествоКоробок,
			|	СУММА(ТЧДокумента.Серия.Лико_КоличествоРоликов) КАК КоличествоРоликов
			|ИЗ
			|	Документ.Лико_ФормированиеПаллета.Содержимое КАК ТЧДокумента
			|ГДЕ
			|	ТЧДокумента.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры = &Заказ
			|	И (ТЧДокумента.Ссылка.Проведен
			|			ИЛИ ТЧДокумента.Ссылка = &ФормированиеПаллета)
			|	И ТЧДокумента.Ссылка.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыФормированияПаллет.ВыпускПродукции)
			|	И НЕ ТЧДокумента.Серия В
			|				(ВЫБРАТЬ
			|					Т.Серия
			|				ИЗ
			|					ВТ_РастаренныеКоробки КАК Т)
			|
			|СГРУППИРОВАТЬ ПО
			|	ТЧДокумента.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры";
			
		Запрос.УстановитьПараметр("Заказ", Заказ);
		Запрос.УстановитьПараметр("ФормированиеПаллета", ФормированиеПаллета);
		
		Если ФормированиеПаллета = Неопределено Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТЧДокумента.Ссылка = &ФормированиеПаллета", "ЛОЖЬ");
		ИначеЕсли ЭтоОтменаПроведения Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЛИ ТЧДокумента.Ссылка = &ФормированиеПаллета", "И ТЧДокумента.Ссылка <> &ФормированиеПаллета");
		КонецЕсли;	
		
		Выборка = Запрос.Выполнить().Выбрать();
	
		СреднееКоличествоВКоробке = 0;
		СреднееКоличествоВРолике = 0;
			
		Если Выборка.Следующий() Тогда
			СреднееКоличествоВКоробке = Окр(Выборка.Количество / Выборка.КоличествоКоробок, Метаданные.Документы.ЗаказКлиента.Реквизиты.СреднееКоличествоВКоробке.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти);
			СреднееКоличествоВРолике = Окр(Выборка.Количество / Выборка.КоличествоРоликов, Метаданные.Документы.ЗаказКлиента.Реквизиты.СреднееКоличествоВРолике.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти);
		КонецЕсли;
		
		Если Заказ.СреднееКоличествоВКоробке <> СреднееКоличествоВКоробке ИЛИ Заказ.СреднееКоличествоВРолике <> СреднееКоличествоВРолике Тогда
			ЗаказОбъект = Заказ.ПолучитьОбъект();
			ЗаказОбъект.СреднееКоличествоВКоробке = СреднееКоличествоВКоробке;
			ЗаказОбъект.СреднееКоличествоВРолике = СреднееКоличествоВРолике;
			Если ЗаписыватьВРежимеОбмена Тогда
				ЗаказОбъект.ОбменДанными.Загрузка = Истина;
				ЗаказОбъект.Записать();
			Иначе
				ЗаказОбъект.Записать(?(ЗаказОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		Сообщить("Не удалось выполнить процедуру ""ОбновитьВЗаказеСреднееКоличествоВКоробкеИРолике"" для заказа " + Заказ.НомерБезПрефикса + ". Сообщите программистам");
	КонецПопытки;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 02.03.2021 

Процедура УдалитьЗаписиИзРегистраЛико_ЭтапыЗаказовПоДокументу(Документ) Экспорт
	
	Возврат; // пока возврат, т.к. измерение "Документ" оказалось плохой идеей, потому что теперь при выборке среза последних по заказу система возвращает все строки с разными документами
	
