//Заполняет Коллекция по найденым штрихкодам
// Описание:
// Параметры Коллекция -Соответствие-
// Параметры ШтрихКоды -Массив- 
//
Процедура ЗаполнениеКоллекцииОбъектовНоменклатурыПоШтрихКоду(Коллекция, ШтрихКоды) Экспорт //++ kit:mih web 16.07.21
	
	МассивКодов = Новый Массив();
	
	Для каждого ШК Из ШтрихКоды Цикл
		
		Результат=Лико_Дополнительно.РасшифроватьШК(ШК);
		
		Если Не ЗначениеЗаполнено(Результат.Ошибка) И
			Результат.ВидШК=Перечисления.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры_Короткий Тогда	
			МассивКодов.Добавить(Число(Сред(ШК, 8, 7)));
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Результат.Ошибка) И
			Результат.ВидШК=Перечисления.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры Тогда	
			МассивКодов.Добавить(Число(Сред(ШК, 18, 7)));	
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивКодов.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЯССМ_ОбъектыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ЯССМ_ОбъектыНоменклатуры.Количество КАК Количество,
	|	ЯССМ_ОбъектыНоменклатуры.Серия КАК Серия,
	|	ЯССМ_ОбъектыНоменклатуры.Ссылка КАК Ссылка,
	|	ЯССМ_ОбъектыНоменклатуры.БазоваяЕдиницаИзмерения.Числитель КАК Числитель,
	|	ЯССМ_ОбъектыНоменклатуры.Нарезка КАК Нарезка
	|ИЗ
	|	Справочник.ЯССМ_ОбъектыНоменклатуры КАК ЯССМ_ОбъектыНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры КАК ВариантыКомплектацииНоменклатуры
	|		ПО ЯССМ_ОбъектыНоменклатуры.Номенклатура = ВариантыКомплектацииНоменклатуры.Владелец
	|			И ЯССМ_ОбъектыНоменклатуры.Характеристика = ВариантыКомплектацииНоменклатуры.Характеристика
	|			И (ВариантыКомплектацииНоменклатуры.Основной)
	|ГДЕ
	|	ЯССМ_ОбъектыНоменклатуры.Код В(&Коды)";
	Запрос.УстановитьПараметр("Коды", МассивКодов);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Для Каждого Запись Из Коллекция Цикл	
			Запись.Значение.Вставить("ОШИБКА", "Ошибка обнаружения объекта номенклатуры");	
		КонецЦикла;
			
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекДанные = Коллекция.Получить(ВРег(СокрЛП(Справочники.ЯССМ_ОбъектыНоменклатуры.ПолучитьКороткийШтрихКод(Выборка.Ссылка))));
		Если ТекДанные = Неопределено Тогда
			ТекДанные = Коллекция.Получить(ВРег(СокрЛП(Справочники.ЯССМ_ОбъектыНоменклатуры.ПолучитьШтрихКод(Выборка.Ссылка))));
		КонецЕсли;		
		
		ТекДанные.Вставить("НОМЕНКЛАТУРА", Выборка.Номенклатура);
		ТекДанные.Вставить("КОЛИЧЕСТВО",   Выборка.Количество);
		ТекДанные.Вставить("СЕРИЯ",        Выборка.Серия);
		ТекДанные.Вставить("ЧИСЛИТЕЛЬ",    Выборка.Числитель); 		
		ТекДанные.Вставить("НАРЕЗКА",      Выборка.Нарезка);
		
	КонецЦикла; 

КонецПроцедуры //-- kit:mih web 16.07.21 

//Проверяет должность физ лица полученного после проверки пропуска, если это Технолог - Тогда Истина иначе Ложь
Функция ПроверкаДолжностиФизЛица(ФизЛицо) Экспорт //++ kit:mih web 12.07.21
	
	УстановитьПривилегированныйРежим(Истина);
	ДоступРазрешен = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность КАК ТекущаяДолжность
		|ИЗ
		|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
		|ГДЕ
		|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = &ФизЛицо";
	
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДоступРазрешен = Выборка.ТекущаяДолжность = Справочники.Должности.НайтиПоНаименованию("Технолог");
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Новый Структура("ДоступРазрешен,СотрудникПринявшийРешение", ДоступРазрешен, ФизЛицо);
	
