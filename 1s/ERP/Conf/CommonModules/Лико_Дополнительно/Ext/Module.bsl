Процедура УстановитьПризнакПолученныхДокументовПриНеобходимости(Источник)

	ТипИсточника = ТипЗнч(Источник);
	
	Если (ТипИсточника = Тип("ДокументОбъект.РеализацияТоваровУслуг")
			ИЛИ ТипИсточника = Тип("ДокументОбъект.ТранспортнаяНакладная")
			ИЛИ ТипИсточника = Тип("ДокументОбъект.ОтгрузкаТоваровСХранения"))
		И Источник.Сканы
		И ЗначениеЗаполнено(Источник.Ссылка)
		И НЕ Источник.Ссылка.Сканы
		Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		// Найдем связанную заявку на транспортировку и сразу проверим, есть ли по ней записи в РегистрСведений.Лико_РегистрацияОтправкиДокументов
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.Документ КАК Документ.Лико_ЗаявкаНаТранспортировку) КАК ЗаявкаНаТранспортировку,
			|	ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.Документ КАК Документ.Лико_ЗаявкаНаТранспортировку).ТипОтгрузки КАК ТипОтгрузки
			|ПОМЕСТИТЬ ВТ_ЗаявкаНаТранспортировку
			|ИЗ
			|	РегистрСведений.Лико_СвязиСТиповымиДокументами КАК Лико_СвязиСТиповымиДокументами
			|ГДЕ
			|	(ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК Документ.РеализацияТоваровУслуг)) = &ТиповойДокумент
			|
			|СГРУППИРОВАТЬ ПО
			|	ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.Документ КАК Документ.Лико_ЗаявкаНаТранспортировку).ТипОтгрузки,
			|	ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.Документ КАК Документ.Лико_ЗаявкаНаТранспортировку)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ЗаявкаНаТранспортировку.ЗаявкаНаТранспортировку КАК ЗаявкаНаТранспортировку,
			|	ВТ_ЗаявкаНаТранспортировку.ТипОтгрузки КАК ТипОтгрузки
			|ИЗ
			|	ВТ_ЗаявкаНаТранспортировку КАК ВТ_ЗаявкаНаТранспортировку
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_РегистрацияОтправкиДокументов КАК Лико_РегистрацияОтправкиДокументов
			|		ПО ВТ_ЗаявкаНаТранспортировку.ЗаявкаНаТранспортировку = Лико_РегистрацияОтправкиДокументов.Пакет
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_ЗаявкаНаТранспортировку.ЗаявкаНаТранспортировку,
			|	ВТ_ЗаявкаНаТранспортировку.ТипОтгрузки";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг", Источник.Метаданные().Имя);
		Запрос.УстановитьПараметр("ТиповойДокумент", Источник.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ЗаявкаНаТранспортировку) Тогда
			НужноУстановитьПризнак = Ложь;
			Если ВыборкаДетальныеЗаписи.ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуИСписаниеСОрганизацииПродавца
				И ТипИсточника = Тип("ДокументОбъект.ТранспортнаяНакладная") Тогда
				НужноУстановитьПризнак = Истина;
			ИначеЕсли (ВыборкаДетальныеЗаписи.ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуСоСкладаХранения
					ИЛИ ВыборкаДетальныеЗаписи.ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.СписаниеСоСкладаХранения)
				И ТипИсточника = Тип("ДокументОбъект.ОтгрузкаТоваровСХранения") Тогда
				НужноУстановитьПризнак = Истина;
			ИначеЕсли ТипИсточника = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
				НужноУстановитьПризнак = Истина;
			КонецЕсли;
			Если НужноУстановитьПризнак Тогда
				МенеджерЗаписи = РегистрыСведений.Лико_РегистрацияОтправкиДокументов.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Период = ТекущаяДата();
				МенеджерЗаписи.Пакет = ВыборкаДетальныеЗаписи.ЗаявкаНаТранспортировку;
				МенеджерЗаписи.Статус = Перечисления.Лико_СтатусыОтправкиДокументов.ПолученОтКонтрагента;
				//МенеджерЗаписи.Контрагент = Контрагент; // Пока не понимаю, кого сюда писать. Попробуем без контрагента
				МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
				МенеджерЗаписи.Комментарий = "Запись добавлена автоматически при создании скан-образа документа";
				Попытка
					МенеджерЗаписи.Записать(Истина);
				Исключение
					Лико_Планирование.ОтправитьПисьмо("Документ """ + Источник + """, пользователь """ + ПараметрыСеанса.ТекущийПользователь + """, описание ошибки: " + ОписаниеОшибки(),
						"Не удалось добавить запись в регистр Лико_РегистрацияОтправкиДокументов", "vefimov@okil.ru",,,,,, Ложь);
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;
	
