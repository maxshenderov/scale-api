Процедура ЗаполнитьИнформДляСмеси(ОбъектНоменклатуры,Структура) //+Лико m.shenderov 24.02.2021
//ОбъектНоменклатуры=Справочники.ЯССМ_ОбъектыНоменклатуры.СоздатьЭлемент();


Если  ЗначениеЗаполнено(ОбъектНоменклатуры.СоставСмеси) ТОгда 
	Номер=1;
	Для каждого СтрСостава Из ОбъектНоменклатуры.СоставСмеси Цикл
		
		Структура.Вставить("Компонента"+Строка(Номер),Прав(СтрСостава.Номенклатура.Код,7)+" "+ Прав(СтрСостава.Номенклатура.Артикул,10));
		Структура.Вставить("Процент"+Строка(Номер),Строка(СтрСостава.Доля*100));
		Структура.Вставить("вес"+Строка(Номер),Строка(СтрСостава.Доля*ОбъектНоменклатуры.Количество*ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель));
		Номер=Номер+1;
		Структура.Вставить("Макет","ПФ_MXL_ТСНаклейкаОбъектаНоменклатурыСмеси");
	КонецЦикла;
	
		
	
КонецЕсли


КонецПроцедуры  //-Лико m.shenderov 24.02.2021  

Процедура ОпределеитьОрганизациюОбъектаНоменклатуры131024(ОН,Структура=Неопределено) //+Лико m.shenderov 04.10.2021
	//ОН=Справочники.ЯССМ_ОбъектыНоменклатуры.СоздатьЭлемент();
	Если Структура=Неопределено тогда
		
		Структура = Новый Структура;
		Структура.Вставить("Организация");
		Структура.Вставить("Тип",0);
	КонецЕсли;
	Если НЕ ОН.Уникальный Тогда
		Возврат ;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Он.ДокументЗакупки) Тогда
		Структура.Организация=Он.ДокументЗакупки.Распоряжение.Организация;
		Структура.Тип=Структура.Тип+1;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Он.ЗакрытиеБланка) Тогда 
		
		Распоряжение=Он.ЗакрытиеБланка.Распоряжение;
		Если ТипЗнч (Распоряжение)=Тип("ДокументСсылка.СборкаТоваров") И Распоряжение.Проведен ТОгда
			Структура.Организация=Распоряжение.Организация;
		    Структура.Тип=Структура.Тип+1;
			Возврат;
	
		КонецЕсли;
		
			
		НовыйОн= ПолучитьПервыйОбъектНоменклатурыДляРасхода(Он.ЗакрытиеБланка);
		Если ЗначениеЗаполнено(НовыйОн) Тогда 
			Структура.Тип= Структура.Тип+1;
			Заказ=Он.ЗакрытиеБланка.ЗаказПокупателя;
			
			Если ЗначениеЗаполнено(Заказ) Тогда
				Если Заказ.ТипЗаказа=Перечисления.Лико_ТипыЗаказов.Полуфабрикат И(
					Заказ.ДавальческоеСырье Или  
					Заказ.ВидыРабот.НайтиСтроки(Новый Структура("ДавальческоеСырье",Истина)).Количество()>0) Тогда					
				Структура.Организация=УправлениеСвойствами.ЗначениеСвойства(Заказ.Партнер,"Лико_СобственнаяОрганизация");
				Иначе
	
				Структура.Организация=Заказ.Площадка.Организация;
				КонецЕсли;
				
				Возврат;
			Иначе
				
				ОпределеитьОрганизациюОбъектаНоменклатуры(НовыйОн,Структура);	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПриходныйОрдерНаТоварыТовары.Ссылка.Дата КАК Дата,
	|	ПриходныйОрдерНаТоварыТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходныйОрдерНаТовары.Товары КАК ПриходныйОрдерНаТоварыТовары
	|ГДЕ
	|	ПриходныйОрдерНаТоварыТовары.Серия = &Серия
	|	И ПриходныйОрдерНаТоварыТовары.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лико_ВозвратТоваровТовары.Ссылка.Дата,
	|	Лико_ВозвратТоваровТовары.Ссылка
	|ИЗ
	|	Документ.Лико_ВозвратТоваров.Товары КАК Лико_ВозвратТоваровТовары
	|ГДЕ
	|	Лико_ВозвратТоваровТовары.Серия = &Серия
	|	И Лико_ВозвратТоваровТовары.Ссылка.Проведен
	|	И Лико_ВозвратТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ВозвратНаСклад.ПриходИзпереработки)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лико_БланкЭтапаВыпуск.Ссылка.Дата,
	|	Лико_БланкЭтапаВыпуск.Ссылка
	|ИЗ
	|	Документ.Лико_БланкЭтапа.Выпуск КАК Лико_БланкЭтапаВыпуск
	|ГДЕ
	|	Лико_БланкЭтапаВыпуск.Серия = &Серия
	|	И Лико_БланкЭтапаВыпуск.Ссылка.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("Серия",Он.Серия );
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ТипЗнч(Выборка.Ссылка)= Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда 
			Структура.Организация=Выборка.Ссылка.Распоряжение.Организация;
			Структура.Тип= Структура.Тип+1;
			
			Возврат ;
		ИначеЕсли ТипЗнч(Выборка.Ссылка)= Тип("ДокументСсылка.Лико_ВозвратТоваров") Тогда 
			Структура.Организация=Выборка.Ссылка.Организация;
			Структура.Тип= Структура.Тип+1;
			
			Возврат ;
			
		ИначеЕсли ТипЗнч(Выборка.Ссылка)= Тип("ДокументСсылка.Лико_БланкЭтапа") ТОгда
			НовыйОн= ПолучитьПервыйОбъектНоменклатурыДляРасхода(Выборка.Ссылка);
			Если ЗначениеЗаполнено(НовыйОн) Тогда 
				ОпределеитьОрганизациюОбъектаНоменклатуры(НовыйОн,Структура);	
			КонецЕсли;	
		КонецЕсли; 		
	КонецЦикла; 
	
	Если Не ЗначениеЗаполнено(Структура.Организация) Тогда
		Структура.Организация=УправлениеСвойствами.ЗначениеСвойства(ПараметрыСеанса.ТекущийПользователь,"Организация_e4c9d825676549a1a5c19972efa7da0b");
		Структура.Тип= Структура.Тип+1;
	КонецЕсли;
	
	
КонецПроцедуры //-Лико m.shenderov 04.10.2021 

Процедура ОпределеитьОрганизациюОбъектаНоменклатуры(ОН,Структура=Неопределено) //+Лико m.shenderov 04.10.2021

	//ОН=Справочники.ЯССМ_ОбъектыНоменклатуры.СоздатьЭлемент();
	УстановитьПривилегированныйРежим(Истина);
	Если Структура=Неопределено тогда

		Структура = Новый Структура;
		Структура.Вставить("Организация");
		Структура.Вставить("Тип",0);
	КонецЕсли;
	Если НЕ ОН.Уникальный Тогда
		Возврат ;
	КонецЕсли;

	Если ЗначениеЗаполнено(Он.ДокументЗакупки) Тогда
		Структура.Организация=Он.ДокументЗакупки.Распоряжение.Организация;
		Структура.Тип=Структура.Тип+1;
		Возврат;
	КонецЕсли;
	
	ПлощадкаЗаказа =Он.ЗакрытиеБланка.ЗаказПокупателя.Площадка.Организация;
	Если ЗначениеЗаполнено(ПлощадкаЗаказа) Тогда
		Структура.Организация=ПлощадкаЗаказа;
		Структура.Тип=Структура.Тип+1;
		Возврат;
	КонецЕсли;

	
	Если ЗначениеЗаполнено(Он.ЗакрытиеБланка) Тогда 

		Распоряжение=Он.ЗакрытиеБланка.Распоряжение;
		Если ТипЗнч (Распоряжение)=Тип("ДокументСсылка.СборкаТоваров") И Распоряжение.Проведен ТОгда
			Структура.Организация=Распоряжение.Организация;
			Структура.Тип=Структура.Тип+1;
			Возврат;

		КонецЕсли;


		НовыйОн= ПолучитьПервыйОбъектНоменклатурыДляРасхода(Он.ЗакрытиеБланка);
		Если ЗначениеЗаполнено(НовыйОн) Тогда 
			Структура.Тип= Структура.Тип+1;
			Заказ=Он.ЗакрытиеБланка.ЗаказПокупателя;

			Если ЗначениеЗаполнено(Заказ) Тогда
				Если Заказ.ТипЗаказа=Перечисления.Лико_ТипыЗаказов.Полуфабрикат И(
					Заказ.ДавальческоеСырье Или  
					Заказ.ВидыРабот.НайтиСтроки(Новый Структура("ДавальческоеСырье",Истина)).Количество()>0) Тогда					
					Структура.Организация=УправлениеСвойствами.ЗначениеСвойства(Заказ.Партнер,"Лико_СобственнаяОрганизация");
				Иначе

					Структура.Организация=Заказ.Площадка.Организация;
				КонецЕсли;

				Возврат;
			Иначе

				ОпределеитьОрганизациюОбъектаНоменклатуры(НовыйОн,Структура);	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПриходныйОрдерНаТоварыТовары.Ссылка.Дата КАК Дата,
	|	ПриходныйОрдерНаТоварыТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходныйОрдерНаТовары.Товары КАК ПриходныйОрдерНаТоварыТовары
	|ГДЕ
	|	ПриходныйОрдерНаТоварыТовары.Серия = &Серия
	|	И ПриходныйОрдерНаТоварыТовары.Ссылка.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лико_ВозвратТоваровТовары.Ссылка.Дата,
	|	Лико_ВозвратТоваровТовары.Ссылка
	|ИЗ
	|	Документ.Лико_ВозвратТоваров.Товары КАК Лико_ВозвратТоваровТовары
	|ГДЕ
	|	Лико_ВозвратТоваровТовары.Серия = &Серия
	|	И Лико_ВозвратТоваровТовары.Ссылка.Проведен
	|	И Лико_ВозвратТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ВозвратНаСклад.ПриходИзпереработки)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лико_БланкЭтапаВыпуск.Ссылка.Дата,
	|	Лико_БланкЭтапаВыпуск.Ссылка
	|ИЗ
	|	Документ.Лико_БланкЭтапа.Выпуск КАК Лико_БланкЭтапаВыпуск
	|ГДЕ
	|	Лико_БланкЭтапаВыпуск.Серия = &Серия
	|	И Лико_БланкЭтапаВыпуск.Ссылка.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("Серия",Он.Серия );
	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл

		Если ТипЗнч(Выборка.Ссылка)= Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда 
			Структура.Организация=Выборка.Ссылка.Распоряжение.Организация;
			Структура.Тип= Структура.Тип+1;

			Возврат ;
		ИначеЕсли ТипЗнч(Выборка.Ссылка)= Тип("ДокументСсылка.Лико_ВозвратТоваров") Тогда 
			Структура.Организация=Выборка.Ссылка.Организация;
			Структура.Тип= Структура.Тип+1;

			Возврат ;

		ИначеЕсли ТипЗнч(Выборка.Ссылка)= Тип("ДокументСсылка.Лико_БланкЭтапа") ТОгда
			НовыйОн= ПолучитьПервыйОбъектНоменклатурыДляРасхода(Выборка.Ссылка);
			Если ЗначениеЗаполнено(НовыйОн) Тогда 
				ОпределеитьОрганизациюОбъектаНоменклатуры(НовыйОн,Структура);	
			КонецЕсли;	
		КонецЕсли; 		
	КонецЦикла; 

	Если Не ЗначениеЗаполнено(Структура.Организация) Тогда
		Структура.Организация=УправлениеСвойствами.ЗначениеСвойства(ПараметрыСеанса.ТекущийПользователь,"Организация_e4c9d825676549a1a5c19972efa7da0b");
		Структура.Тип= Структура.Тип+1;
	КонецЕсли;


