				СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
				СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
				ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, Неопределено);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры //- Лико m.shenderov 23.05.2018



Функция ПолучитьНомерДокументаПоРегиону(Источник, Регион, Префикс) // --> Начало Лико Ефимов ЕВВ 10.08.2017
	
	УстановитьПривилегированныйРежим(Истина);
	// Обычно типовой номер документа состоит из 11 символов: AABB-CCCCCC, где AA - префикс организации, BB - префикс информационной базы (вроде бы), CCCCCC - номер документа по порядку
	// Мы будем делать из него AABBRYCCCCC, где AA - префикс организации, BB - префикс информационной базы (вроде бы), R - код региона, Y - последняя цифра текущего года, CCCCC - номер документа по порядку  
	КодРегиона = Регион.КодРегиона;
	Если КодРегиона < 0 Тогда
		КодРегиона = - КодРегиона;
	КонецЕсли;
	// --> Начало Лико Ефимов ЕВВ 09.01.2020
	Если Источник.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияАвантаж.ЗначениеПараметра Тогда
		// Реализации Урала всегда будут начинаться на 4
		КодРегиона = 4;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 09.01.2020
	// --> Начало Лико Ефимов ЕВВ 14.12.2020 
	Если Источник.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЭкоФлекс.ЗначениеПараметра Тогда
		// Реализации Сибири всегда будут начинаться на 9
		КодРегиона = 9;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 14.12.2020 
	Префикс = Лев(Префикс, 4) + Формат(КодРегиона, "ЧЦ=1; ЧН=0") + Прав(Строка(Год(Источник.Дата)), 1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПОДСТРОКА(Документ.Номер, 7, 5) КАК Номер
	|ИЗ
	|	Документ." + Источник.Метаданные().Имя + " КАК Документ
	|ГДЕ
	|	ПОДСТРОКА(Документ.Номер, 1, 6) = &Префикс
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер УБЫВ";
	
	Запрос.УстановитьПараметр("Префикс", Префикс);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Попытка
			НомерЧислом = Число(Выборка.Номер);
		Исключение
			Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("В цифровой части номера документа """ + Источник + """ содержаться символы, отличные от цифр.");
			Возврат "";
		КонецПопытки;
		
		Возврат Префикс + Формат(НомерЧислом + 1, "ЧЦ=5; ЧВН=; ЧГ=0");
		
	Иначе
		Возврат Префикс + "00001";	
	КонецЕсли;
	
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 10.08.2017

Функция ПроверитьДоговорВДокументеЛико_СчетНаОплатуКлиенту(Счет, Договор)
	
	// Проверим, заполнен ли договор
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Сообщить("Не выбран договор.");
		Возврат Истина;
	КонецЕсли;
	
	НомерДоговора = СокрЛП(Договор.Номер);
	
	// Проверим, заполнен ли в договоре Номер
	Если НЕ ЗначениеЗаполнено(НомерДоговора) Тогда
		Сообщить("В выбранном договоре не заполнен номер.");
		Возврат Истина;
	КонецЕсли;
	
	// Проверим длину номера договора. Максимальный номер может быть вида "1710462/99"
	Если СтрДлина(НомерДоговора) > 10 Тогда
		Сообщить("Номер договора не может быть длиннее 10 символов.");
		Возврат Истина;
	КонецЕсли;
	
	// Проверим, нет ли в системе счетов на оплату с таким же номером договора. Проверка необходима для обеспечения уникальности номера документа
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка
	|ПОМЕСТИТЬ ВТ_ДоговорыСЗаданнымНаименованием
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
	|	И ДоговорыКонтрагентов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует)
	|	И ДоговорыКонтрагентов.Номер = &НомерДоговора
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_СчетНаОплатуКлиенту.Ссылка КАК Счет,
	|	ВТ_ДоговорыСЗаданнымНаименованием.Ссылка.Ссылка КАК Договор
	|ИЗ
	|	Документ.Лико_СчетНаОплатуКлиенту КАК Лико_СчетНаОплатуКлиенту
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДоговорыСЗаданнымНаименованием КАК ВТ_ДоговорыСЗаданнымНаименованием
	|		ПО Лико_СчетНаОплатуКлиенту.Договор = ВТ_ДоговорыСЗаданнымНаименованием.Ссылка
	|ГДЕ
	|	НЕ Лико_СчетНаОплатуКлиенту.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("НомерДоговора", НомерДоговора);
	Запрос.УстановитьПараметр("Ссылка", Счет);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Сообщить("Уже есть счет с договором номер """ + НомерДоговора + """: " + Выборка.Счет);
		Возврат Истина;
	КонецЕсли;	
	
КонецФункции

