		Если Источник[ИмяТЧ].Итог(ИмяРеквизита) = 0 Тогда
			Источник.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.Подготовлено;
		Иначе
			ВсеРазмещено = Истина;
			Для каждого Строка из Источник[ИмяТЧ] Цикл
