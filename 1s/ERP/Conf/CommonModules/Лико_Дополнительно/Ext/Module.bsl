			// Письмо Анны от 05.02.25 14:23
			Продолжить;
		КонецЕсли;
		
		Если ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуИСписаниеСОрганизацииПродавца Тогда
			Если Строка.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Пробник Тогда
				Продолжить;
			КонецЕсли;
			Строка.Цена = 0;
		КонецЕсли;
		
		НоменклатураКомплект = "";
		Если Строка.ПроверятьСредниеЦеныЗаказа И Строка.Цена <> 0 Тогда
			
			Если МассивПроверенныхЗаказовПоСреднимЦенам.Найти(Строка.ЗаказКлиента) <> Неопределено Тогда
				// Данный заказ уже проверили
				Продолжить;
			КонецЕсли;
			
			СуммаЗаказаИтог = 0;
			КоличествоЗаказаИтог = 0;
			Для каждого СтрокаТЧ из Строка.ЗаказКлиента.Товары Цикл
				СуммаЗаказаИтог = СуммаЗаказаИтог + СтрокаТЧ.Количество * СтрокаТЧ.Цена;
				КоличествоЗаказаИтог = КоличествоЗаказаИтог + СтрокаТЧ.Количество;
			КонецЦикла;
			Строка.ЦенаИзЗаказа = Окр(СуммаЗаказаИтог / КоличествоЗаказаИтог, 4);
			
			СуммаЗаказаИтог = 0;
			КоличествоЗаказаИтог = 0;
			НайденныеСтроки = Таблица.НайтиСтроки(Новый Структура("ЗаказКлиента", Строка.ЗаказКлиента));
			Для каждого СтрокаТЧ из НайденныеСтроки Цикл
				СуммаЗаказаИтог = СуммаЗаказаИтог + СтрокаТЧ.Количество * СтрокаТЧ.Цена;
				КоличествоЗаказаИтог = КоличествоЗаказаИтог + СтрокаТЧ.Количество;
				НоменклатураКомплект = НоменклатураКомплект + ?(НайденныеСтроки.Количество() = 1, СтрокаТЧ.Номенклатура, ?(ЗначениеЗаполнено(НоменклатураКомплект), ", ", "Комплект: ") + СтрокаТЧ.Номенклатура);
			КонецЦикла;
			Строка.Цена = СуммаЗаказаИтог / КоличествоЗаказаИтог;
			
			МассивПроверенныхЗаказовПоСреднимЦенам.Добавить(Строка.ЗаказКлиента);
		КонецЕсли;
		
		Если НЕ Строка.ЦенаДляДокументовВключаетНДС Тогда
			//ПроцентНДС = УчетНДСУПКлиентСервер.ПолучитьСтавкуНДС(Строка.СтавкаНДС);
			ПроцентНДС = Строка.СтавкаНДС.Ставка;
			Строка.ЦенаИзЗаказа = Окр(Строка.ЦенаИзЗаказа / (1 + ПроцентНДС / 100), 4);
		КонецЕсли;
		
		ЦенаРуб = Строка.Цена * Строка.Курс;
		ЦенаЕвро = Окр(ЦенаРуб / Строка.КурсЕвро, 4);
		
		
		РазностьЦенПроцент = (Строка.ЦенаИзЗаказа - ЦенаЕвро) / Строка.ЦенаИзЗаказа * 100; 
		Если РазностьЦенПроцент > 10 Тогда
			Сообщение = Сообщение + ?(ЗначениеЗаполнено(Сообщение), Символы.ПС, "") + "Цена в заказе " + Строка.ЗаказКлиента.НомерБезПрефикса + " (" + ?(Строка.ЦенаДляДокументовВключаетНДС, "с", "без") + " НДС) " + Строка.ЦенаИзЗаказа + " €, цена в документе " + ЦенаЕвро + " € (разница " + Окр(РазностьЦенПроцент) + "%)";
			МассивСтруктурДанных.Добавить(Новый Структура("Заказ,Номенклатура,ЦенаЗаказа,ЦенаДокумента,Процент,Количество", Строка.ЗаказКлиента, ?(ЗначениеЗаполнено(НоменклатураКомплект), НоменклатураКомплект, Строка.Номенклатура), Строка.ЦенаИзЗаказа, ЦенаЕвро, РазностьЦенПроцент, Строка.Количество)); 	
		КонецЕсли;		
		
	КонецЦикла;
	
	Результат = Новый Структура("Сообщение,МассивСтруктурДанных", Сообщение, МассивСтруктурДанных);
	
	Возврат Результат;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 02.06.2020

Процедура ЗаписатьПричинуИзмененияЦены(Ссылка, ПараметрыЗаписи) Экспорт // --> Начало Лико Ефимов ЕВВ 17.06.2020 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ ПараметрыЗаписи.Свойство("Причина") Тогда
		Если ПараметрыЗаписи.Свойство("НеУдалятьПредыдущуюПричину") Тогда
			// Проверка не пройдена, но причину уже не спрашиваем (проводят второй раз без изменения цен
			Возврат;
		Иначе
			// Проверка пройдена, удалим старые ответы
			УдалитьИзРегистраИсторииИзмененияЦенДанныеПоДокументу(Ссылка);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// Сначала удалим старые записи
	УдалитьИзРегистраИсторииИзмененияЦенДанныеПоДокументу(Ссылка);
	
	ЭтоЗаявкаНаОтгрузку = ТипЗнч(Ссылка) = Тип("ДокументСсылка.Лико_ЗаявкаНаОтгрузку");
	МассивКлиентов = Новый Массив;
	
	// Теперь запишем новые
	НаборЗаписей = РегистрыСведений.Лико_ИсторияДляРассылкиОтчетовПоИзменениюДанных.СоздатьНаборЗаписей();
	сч = 0;
	Для каждого СтруктураДанных ИЗ ПараметрыЗаписи.РезультатПроверки.МассивСтруктурДанных Цикл
		сч = сч + 1;
		НоваяЗапись = НаборЗаписей.Добавить();
		//МенеджерЗаписи = РегистрыСведений.Лико_ИсторияДляРассылкиОтчетовПоИзменениюДанных.СоздатьМенеджерЗаписи();
		НоваяЗапись.Период = ТекущаяДата();
		НоваяЗапись.ТипДанных = Перечисления.Лико_ТипыДанныхРегистраИсторииДляРассылкиОтчетов.УменьшениеЦеныПродажи;
		НоваяЗапись.НомерВЦепочке = сч;
		НоваяЗапись.Сообщение = ПараметрыЗаписи.РезультатПроверки.Сообщение;
		НоваяЗапись.ДопДанные1 = Ссылка;
		НоваяЗапись.ДопДанные2 = "" + ПараметрыЗаписи.Причина + ?(ЗначениеЗаполнено(ПараметрыЗаписи.Комментарий), " (" + ПараметрыЗаписи.Комментарий + ")", "");
		НоваяЗапись.ДопДанные3 = СтруктураДанных.Заказ;
		НоваяЗапись.ДопДанные4 = СтруктураДанных.Номенклатура;
		НоваяЗапись.ДопДанные5 = СтруктураДанных.ЦенаЗаказа;
		НоваяЗапись.ДопДанные6 = СтруктураДанных.ЦенаДокумента;
		НоваяЗапись.ДопДанные7 = СтруктураДанных.Процент;
		НоваяЗапись.ДопДанные8 = ПараметрыСеанса.ТекущийПользователь;
		
		СтруктураДанных.Вставить("Клиент", ?(ЭтоЗаявкаНаОтгрузку, СтруктураДанных.Заказ.Партнер, Ссылка.Партнер));
		Если МассивКлиентов.Найти(СтруктураДанных.Клиент) = Неопределено Тогда
			МассивКлиентов.Добавить(СтруктураДанных.Клиент);
		КонецЕсли;
	КонецЦикла;
	
	//Попытка
	НаборЗаписей.Записать(Ложь);	
	//Исключение
	//	Сообщить("Не удалось добавить данные в историю для рассылки писем: " + ОписаниеОшибки());
	//КонецПопытки;
	
	// Отправим письма
	Если ЭтоЗаявкаНаОтгрузку Тогда
		Менеджер = Ссылка.Ответственный;
	Иначе
		Менеджер = Ссылка.Менеджер;
	КонецЕсли;
	ДиректорРегиона = Неопределено;
	Если ЗначениеЗаполнено(Менеджер.Лико_Регион) Тогда
		ДиректорРегиона = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Менеджер.Лико_Регион, "Лико_Директор");
	КонецЕсли;
	
	Для каждого Клиент из МассивКлиентов Цикл
		Тема = "Зарегистрировано отклонение цены для " + Клиент + ", менеджер " + Менеджер;
		ТекстПисьма = "Добрый день" + "<br><br>" + Символы.ПС
		+ "Зарегистрировано отклонение цены продажи более, чем на 10% в документе " + Ссылка + "<br><br>" + Символы.ПС
		+ "Клиент " + Клиент + "<br>" + Символы.ПС
		+ "Менеджер " + Менеджер + "<br><br>" + Символы.ПС;
		Для каждого СтруктураДанных ИЗ ПараметрыЗаписи.РезультатПроверки.МассивСтруктурДанных Цикл
			Если СтруктураДанных.Клиент = Клиент Тогда
				ТекстПисьма = ТекстПисьма
				+ "Заказ " + СтруктураДанных.Заказ.НомерБезПрефикса + ", " + СтруктураДанных.Номенклатура + ":" + "<br>" + Символы.ПС
				+ "Было       " + СтруктураДанных.ЦенаЗаказа + " евро (сумма " + Формат(СтруктураДанных.ЦенаЗаказа * СтруктураДанных.Количество, "ЧДЦ=2; ЧГ=0") +")" + "<br>" + Символы.ПС
				+ "Стало      " + Символы.Таб + СтруктураДанных.ЦенаДокумента + " евро (сумма " + Формат(СтруктураДанных.ЦенаДокумента * СтруктураДанных.Количество, "ЧДЦ=2; ЧГ=0") +")" + "<br>" + Символы.ПС
				+ "Отклонение " + Окр(СтруктураДанных.Процент, 0) + " %" + "<br><br>" + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		ТекстПисьма = ТекстПисьма
		+ "Причина:" + "<br>" + Символы.ПС
		+ ПараметрыЗаписи.Причина + ?(ЗначениеЗаполнено(ПараметрыЗаписи.Комментарий), " (" + ПараметрыЗаписи.Комментарий + ")", "");
		
		СписокПолучателей = Новый СписокЗначений;
		СписокПолучателей.Добавить("den.okulov@gmail.com");
		СписокПолучателей.Добавить(Менеджер);
		СписокПолучателей.Добавить("aivanova@okil.ru");
		//СписокПолучателей.Добавить("vefimov@okil.ru");
		ДиректорИзКлиента = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Клиент, "Директор_8e9103f4138845d5a403d22f2f25c67c");
		Если ЗначениеЗаполнено(ДиректорИзКлиента) Тогда
			СписокПолучателей.Добавить(ДиректорИзКлиента);
		ИначеЕсли ЗначениеЗаполнено(ДиректорРегиона) Тогда
			СписокПолучателей.Добавить(ДиректорРегиона);
		КонецЕсли;
		Лико_Планирование.ОтправитьПисьмо(ТекстПисьма, Тема, СписокПолучателей);
	КонецЦикла;
	
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 17.06.2020 

Процедура УдалитьИзРегистраИсторииИзмененияЦенДанныеПоДокументу(СсылкаНаДокумент)
	
	Если НЕ ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат;
	КонецЕсли;
	
	// --> Начало Лико Ефимов ЕВВ 10.07.2020
	// Сейчас пишем пиьсма в момент проведения, а отчет уже не показываем, поэтому удалять смысла нет
	// Уберу удаление, чтобы оставалась история
	Возврат;
	// <-- Конец Лико Ефимов ЕВВ 10.07.2020 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ИсторияДляРассылкиОтчетовПоИзменениюДанных.Период КАК Период,
	|	Лико_ИсторияДляРассылкиОтчетовПоИзменениюДанных.ТипДанных КАК ТипДанных,
	|	Лико_ИсторияДляРассылкиОтчетовПоИзменениюДанных.НомерВЦепочке КАК НомерВЦепочке,
	|	Лико_ИсторияДляРассылкиОтчетовПоИзменениюДанных.СлужебнаяЗапись КАК СлужебнаяЗапись
	|ИЗ
	|	РегистрСведений.Лико_ИсторияДляРассылкиОтчетовПоИзменениюДанных КАК Лико_ИсторияДляРассылкиОтчетовПоИзменениюДанных
	|ГДЕ
	|	Лико_ИсторияДляРассылкиОтчетовПоИзменениюДанных.ДопДанные1 = &Ссылка
	|	И Лико_ИсторияДляРассылкиОтчетовПоИзменениюДанных.ТипДанных = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыДанныхРегистраИсторииДляРассылкиОтчетов.УменьшениеЦеныПродажи)";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.Лико_ИсторияДляРассылкиОтчетовПоИзменениюДанных.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи);
		МенеджерЗаписи.Прочитать();
		Попытка
			МенеджерЗаписи.Удалить();	
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

