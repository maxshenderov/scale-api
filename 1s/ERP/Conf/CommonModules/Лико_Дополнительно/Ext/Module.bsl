Функция НайтиСоглашениеИлиДоговорВРегистреЗаполненияРеглДок(ТипСправочника, ОрганизацияДоговора, КонтрагентДоговора, ТипДоговора = Неопределено, Валюта, ТипПродукции) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ЗаполениеРегламентированныхДокументов.Организация КАК Организация,
		|	Лико_ЗаполениеРегламентированныхДокументов.Контрагент КАК Контрагент,
		|	Лико_ЗаполениеРегламентированныхДокументов.Валюта КАК Валюта,
		|	Лико_ЗаполениеРегламентированныхДокументов.ТипОперации КАК ТипОперации,
		|	Лико_ЗаполениеРегламентированныхДокументов.ТипПродукции КАК ТипПродукции,
		|	Лико_ЗаполениеРегламентированныхДокументов.Договор КАК Договор,
		|	Лико_ЗаполениеРегламентированныхДокументов.Соглашение КАК Соглашение,
		|	Лико_ЗаполениеРегламентированныхДокументов.СпособДоставки КАК СпособДоставки
		|ИЗ
		|	РегистрСведений.Лико_ЗаполениеРегламентированныхДокументов КАК Лико_ЗаполениеРегламентированныхДокументов
		|ГДЕ
		|	Лико_ЗаполениеРегламентированныхДокументов.Организация = &Организация
		|	И Лико_ЗаполениеРегламентированныхДокументов.Контрагент = &Контрагент
		|	И Лико_ЗаполениеРегламентированныхДокументов.Валюта = &Валюта
		|	И Лико_ЗаполениеРегламентированныхДокументов.ТипПродукции = &ТипПродукции";
	
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("Контрагент", КонтрагентДоговора);
	Запрос.УстановитьПараметр("Организация", ОрганизацияДоговора);
	Запрос.УстановитьПараметр("ТипПродукции", ТипПродукции);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ТипСправочника = "ДоговорыКонтрагентов" Тогда
			Возврат ВыборкаДетальныеЗаписи.Договор;
		Иначе
			Возврат ВыборкаДетальныеЗаписи.Соглашение;
		КонецЕсли;
	КонецЕсли;
	
	// Если дошло сюда, значит в регистре Лико_ЗаполениеРегламентированныхДокументов данные не нашлись. Попробуем найти старым методом
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Справочник.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Справочник
		|ГДЕ
		|	Справочник.Организация = &Организация
		|	И Справочник.Контрагент = &Контрагент
		|	И Справочник.Статус = &Статус
		|	И &ДопУсловия
		|
		|УПОРЯДОЧИТЬ ПО
		|	Справочник.ДатаОкончанияДействия УБЫВ,
		|	Справочник.Наименование";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДоговорыКонтрагентов", ТипСправочника);
	Если ТипСправочника = "ДоговорыКонтрагентов" Тогда
		СтатусДоговора = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопУсловия", " ТипДоговора = &ТипДоговора И ВалютаВзаиморасчетов = &Валюта");
		Запрос.УстановитьПараметр("ТипДоговора", ТипДоговора);
	ИначеЕсли ТипСправочника = "СоглашенияСКлиентами" Тогда
		СтатусДоговора = Перечисления.СтатусыСоглашенийСКлиентами.Действует;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопУсловия", " Валюта = &Валюта");
	ИначеЕсли ТипСправочника = "СоглашенияСПоставщиками" Тогда
		СтатусДоговора = Перечисления.СтатусыСоглашенийСПоставщиками.Действует;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопУсловия", " Валюта = &Валюта");
	Иначе
		Сообщить("Тип справочника """ + ТипСправочника + """ не определен.");
		Возврат Неопределено
	КонецЕсли;
	Запрос.УстановитьПараметр("Организация", ОрганизацияДоговора);
	Запрос.УстановитьПараметр("Контрагент", КонтрагентДоговора);
	Запрос.УстановитьПараметр("Статус", СтатусДоговора);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Сообщить("Не найден " + ТипСправочника + " для организации """ + ОрганизацияДоговора + """ и контрагента """ + КонтрагентДоговора + """");
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции
    
Процедура ДопровестиБланкЭтапаВФоне(ЗакрытиеБланкаСсылка) Экспорт // --> Начало Лико Ефимов ЕВВ 09.12.2021
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ ЗначениеЗаполнено(ЗакрытиеБланкаСсылка.ДатаПроведенияПоОбязательнымРегистрам) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		ЗакрытиеБланкаОбъект =  ЗакрытиеБланкаСсылка.ПолучитьОбъект();
		ЗакрытиеБланкаОбъект.ДатаПроведенияПоОбязательнымРегистрам = Неопределено;
