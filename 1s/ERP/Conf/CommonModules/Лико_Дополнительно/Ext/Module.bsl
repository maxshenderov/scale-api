Процедура ЗаполнитьДатуПлатежаИЧислоДнейОтсрочкиПоЭтапамГрафикаОплаты(Источник) Экспорт // --> Начало Лико Ефимов ЕВВ 31.08.2021
	
	Источник.Лико_ДатаПлатежаПлан = Источник.Дата;
	Для каждого Строка из Источник.ЭтапыГрафикаОплаты Цикл
		Источник.Лико_ДатаПлатежаПлан = Макс(Источник.Лико_ДатаПлатежаПлан, Строка.ДатаПлатежа);
	КонецЦикла;
	
	Источник.Лико_ЧислоДнейОтсрочки = (НачалоДня(Источник.Лико_ДатаПлатежаПлан) - НачалоДня(Источник.Дата)) / 86400;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 31.08.2021

Процедура Подписка_ПередЗаписьюСправочников(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ТипИсточника = ТипЗнч(Источник);
	
	Если ТипИсточника = Тип("СправочникОбъект.Партнеры") Тогда
		Если Источник.Клиент Тогда
			Если СтрНайти(Источник.Наименование, """") <> 0 ИЛИ СтрНайти(Источник.Наименование, "«") <> 0 ИЛИ СтрНайти(Источник.Наименование, "»") <> 0 Тогда
				Отказ = Истина;
				Сообщить("В рабочем наименовании клиента запрещены кавычки");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// --> Начало Лико Ефимов ЕВВ 31.08.2021
	Если ТипИсточника = Тип("СправочникОбъект.СоглашенияСКлиентами") Тогда
		ЗаполнитьЧислоДнейОтсрочкиПоЭтапамГрафикаОплаты(Источник);
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 31.08.2021
	
КонецПроцедуры

Процедура ЗаполнитьЧислоДнейОтсрочкиПоЭтапамГрафикаОплаты(Источник) Экспорт // --> Начало Лико Ефимов ЕВВ 31.08.2021
	
	Источник.Лико_ЧислоДнейОтсрочки = 0;
	Для каждого Строка из Источник.ЭтапыГрафикаОплаты Цикл
		Если Строка.ВариантОплаты = Перечисления.ВариантыКонтроляОплатыКлиентом.КредитПослеОтгрузки
			ИЛИ Строка.ВариантОплаты = Перечисления.ВариантыКонтроляОплатыКлиентом.КредитСдвиг Тогда
			Источник.Лико_ЧислоДнейОтсрочки = Макс(Источник.Лико_ЧислоДнейОтсрочки, Строка.Сдвиг);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 31.08.2021

Функция ПолучитьДанныеПоЗаказамИКоличествуИзДокумента(Ссылка) Экспорт // --> Начало Лико Ефимов ЕВВ 31.10.2018
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЧТовары.Характеристика.Лико_ЗаказНоменклатуры КАК ЗаказКлиента,
	|	СУММА(ТЧТовары.СуммаСНДС) КАК Сумма,
	|	СУММА(ТЧТовары.Количество) КАК Количество
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК ТЧТовары
	|ГДЕ
	|	ТЧТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЧТовары.Характеристика.Лико_ЗаказНоменклатуры
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТЧТовары.Характеристика.Лико_ЗаказНоменклатуры.Номер";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг", Ссылка.Метаданные().Имя);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СуммаСНДС", "Лико_Сумма");
	КонецЕсли;
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 31.10.2018

Процедура Подписка_ПриУстановкеНовогоНомера(Источник, СтандартнаяОбработка, Префикс) Экспорт
	ТипИсточника = ТипЗнч(Источник);
	
	//Начало изменений Иванова А.В.
	Если ТипИсточника = Тип("ДокументОбъект.ЗаказКлиента") Тогда
		СтандартнаяОбработка = Ложь;
		Если ЗначениеЗаполнено(Источник.Ссылка) Тогда
			Источник.Номер = Источник.Ссылка.Номер;
			Источник.НомерБезПрефикса = Источник.Ссылка.НомерБезПрефикса;	
		Иначе	
			Источник.Номер = Лико_Планирование.ПолучитьНомерДляЗаказа(Источник.Организация, Источник.ТипЗаказа,Источник.ВидЗаказа, Источник.Регион);
			Источник.НомерБезПрефикса = Прав(Источник.Номер,7);	
		КонецЕсли	
	ИначеЕсли ТипИсточника = Тип("ДокументОбъект.ЗаказДавальца") Тогда
		Если ЗначениеЗаполнено(Источник.Лико_ЗаказКлиента) Тогда 
			Префикс = "0"+Источник.Лико_ЗаказКлиента.НомерБезПрефикса;
			ПрефиксацияОбъектовСобытия.УстановитьПрефиксОрганизации(Источник, СтандартнаяОбработка, Префикс);
		КонецЕсли;	
	ИначеЕсли
		ТипИсточника = Тип("ДокументОбъект.ЗаказНаПроизводство2_2") Тогда
		Если ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.ЗаказДавальца") Тогда 
			Если ЗначениеЗаполнено(Источник.ДокументОснование.Лико_ЗаказКлиента) Тогда
				Префикс = "0"+Источник.ДокументОснование.Лико_ЗаказКлиента.НомерБезПрефикса;
				ПрефиксацияОбъектовСобытия.УстановитьПрефиксОрганизации(Источник, СтандартнаяОбработка, Префикс);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	
	Если ТипИсточника = Тип("ДокументОбъект.Лико_НесоответствующаяПродукция") Тогда
		Если Источник.ВидОперации = Перечисления.Лико_ВидыОперацийНесоответствияЗаказу.ВнутреннийБрак Тогда 
			Префикс = "ВН";
		ИначеЕсли Источник.ВидОперации = Перечисления.Лико_ВидыОперацийНесоответствияЗаказу.РекламацияКлиента Тогда 
			Префикс = "РЕ";
		ИначеЕсли Источник.ВидОперации = Перечисления.Лико_ВидыОперацийНесоответствияЗаказу.Прочее Тогда 
			Префикс = "ПР";
			
		КонецЕсли;	
		
		УстановитьПрефиксОрганизации(Источник, Префикс, Ложь, Истина);  //+Лико o.pukhova 31.01.2020
		
	КонецЕсли;
	
	//Начало изменений Иванова А.В.
	
	
	
	
	Если ТипИсточника = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		Если Источник.Организация<>Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра
			И Источник.Организация<>Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра Тогда
			
			Если Источник.Товары.Количество() > 0 Тогда
				Регион = Источник.Товары[0].Характеристика.Лико_ЗаказНоменклатуры.Регион;
				Если ЗначениеЗаполнено(Регион) Тогда
					СтандартнаяОбработка = Ложь;
					Источник.Номер = ПолучитьНомерДокументаПоРегиону(Источник, Регион, Префикс);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипИсточника = Тип("ДокументОбъект.Лико_ФормированиеПаллета")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ПеремещениеПаллета")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ЗаявкаНаОтгрузку")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ЗаявкаНаТранспортировку")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_Инвентаризация")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_БланкЭтапа")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ПередачаТоваров")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ЗаказНаРаскрой")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_УстановкаВидаНастроечногоМатериала")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ЗаявкаНаДизайн")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ЗаявкаНаИзготовлениеФорм")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ЗаданиеНаУдалениеГП")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ПолучениеГПИзПроизводства")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ЗабраковкаМатериалов")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ВыполненныеРаботыМеждуОрганизациями")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ОтчетФормщика")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ФормированиеПаллета2_0")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.Лико_ПеремещениеПаллета2_0")

		
		Тогда
		ПрефиксацияОбъектовСобытия.УстановитьПрефиксИнформационнойБазыИОрганизации(Источник, СтандартнаяОбработка, Префикс);
	КонецЕсли;
	
	Если ТипИсточника = Тип("ДокументОбъект.Лико_СчетНаОплатуКлиенту") Тогда
		СтандартнаяОбработка = Ложь;
		Отказ = ПроверитьДоговорВДокументеЛико_СчетНаОплатуКлиенту(Источник.Ссылка, Источник.Договор);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		Источник.Номер = ПолучитьНомерДокументаДляСчетаНаОплатуКлиенту(Источник, Источник.Договор.Номер); 
	КонецЕсли;
	
	Если ТипИсточника = Тип("ДокументОбъект.ТС_ЗаявкаНаРемонтРабочихЦентров") Тогда
		Если ЗначениеЗаполнено(Источник.ПодразделениеПолучатель.ПрефиксДляНумерацииДокументов) Тогда
			Префикс = Источник.ПодразделениеПолучатель.ПрефиксДляНумерацииДокументов + "-"; 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьДвиженияПоНедоступностиРЦ(Источник, Отказ)
	
	// Сначала проверим, чтобы не было пересекающихся периодов доступности
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоступностьРабочихЦентровИнтервалыТекДокумент.Ссылка КАК Ссылка,
	|	ДоступностьРабочихЦентровИнтервалыТекДокумент.НомерСтроки КАК НомерСтроки,
	|	ДоступностьРабочихЦентровИнтервалыТекДокумент.РабочийЦентр КАК РабочийЦентр,
	|	НАЧАЛОПЕРИОДА(ДоступностьРабочихЦентровИнтервалыТекДокумент.ДатаГрафика, ДЕНЬ) КАК ДатаГрафика,
	|	ДоступностьРабочихЦентровИнтервалыТекДокумент.ВремяНачала КАК ВремяНачала,
	|	ДоступностьРабочихЦентровИнтервалыТекДокумент.ВремяОкончания КАК ВремяОкончания
	|ПОМЕСТИТЬ ВТ_ТекДокумент
	|ИЗ
	|	Документ.ДоступностьРабочихЦентров.Интервалы КАК ДоступностьРабочихЦентровИнтервалыТекДокумент
	|ГДЕ
	|	ДоступностьРабочихЦентровИнтервалыТекДокумент.Ссылка = &Ссылка
	|	И НЕ ДоступностьРабочихЦентровИнтервалыТекДокумент.РабочийЦентр = ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.ПустаяСсылка)
	|	И НЕ ДоступностьРабочихЦентровИнтервалыТекДокумент.ДатаГрафика = ДАТАВРЕМЯ(1, 1, 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТекДокумент.НомерСтроки КАК НомерСтроки,
	|	ВТ_ТекДокумент.РабочийЦентр КАК РабочийЦентр,
	|	ВТ_ТекДокумент.ДатаГрафика КАК ДатаГрафика,
	|	ВТ_ТекДокумент.ВремяНачала КАК ВремяНачала,
	|	ВТ_ТекДокумент.ВремяОкончания КАК ВремяОкончания,
	|	МАКСИМУМ(ВТ_ТекДокумент1.Ссылка) КАК ДокументПересечения
	|ИЗ
	|	ВТ_ТекДокумент КАК ВТ_ТекДокумент
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТекДокумент КАК ВТ_ТекДокумент1
	|		ПО ВТ_ТекДокумент.Ссылка = ВТ_ТекДокумент1.Ссылка
	|			И ВТ_ТекДокумент.НомерСтроки <> ВТ_ТекДокумент1.НомерСтроки
	|			И ВТ_ТекДокумент.РабочийЦентр = ВТ_ТекДокумент1.РабочийЦентр
	|			И ВТ_ТекДокумент.ДатаГрафика = ВТ_ТекДокумент1.ДатаГрафика
	|			И (ВТ_ТекДокумент.ВремяНачала МЕЖДУ ВТ_ТекДокумент1.ВремяНачала И ВТ_ТекДокумент1.ВремяОкончания
	|				ИЛИ ВТ_ТекДокумент.ВремяОкончания МЕЖДУ ВТ_ТекДокумент1.ВремяНачала И ВТ_ТекДокумент1.ВремяОкончания
	|				ИЛИ ВТ_ТекДокумент1.ВремяНачала МЕЖДУ ВТ_ТекДокумент.ВремяНачала И ВТ_ТекДокумент.ВремяОкончания
	|				ИЛИ ВТ_ТекДокумент1.ВремяОкончания МЕЖДУ ВТ_ТекДокумент.ВремяНачала И ВТ_ТекДокумент.ВремяОкончания)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТекДокумент.НомерСтроки,
	|	ВТ_ТекДокумент.РабочийЦентр,
	|	ВТ_ТекДокумент.ДатаГрафика,
	|	ВТ_ТекДокумент.ВремяНачала,
	|	ВТ_ТекДокумент.ВремяОкончания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТекДокумент.РабочийЦентр КАК РабочийЦентр,
	|	НАЧАЛОПЕРИОДА(ВТ_ТекДокумент.ДатаГрафика, ДЕНЬ) КАК ДатаГрафика,
	|	ВТ_ТекДокумент.ВремяНачала КАК ВремяНачала,
	|	ВТ_ТекДокумент.ВремяОкончания КАК ВремяОкончания,
	|	МАКСИМУМ(ДоступностьРабочихЦентровИнтервалыОстальные.Ссылка) КАК ДокументПересечения
	|ИЗ
	|	ВТ_ТекДокумент КАК ВТ_ТекДокумент
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ДоступностьРабочихЦентров.Интервалы КАК ДоступностьРабочихЦентровИнтервалыОстальные
	|		ПО ВТ_ТекДокумент.Ссылка <> ДоступностьРабочихЦентровИнтервалыОстальные.Ссылка
	|			И (ДоступностьРабочихЦентровИнтервалыОстальные.Ссылка.Проведен)
	|			И (НЕ ДоступностьРабочихЦентровИнтервалыОстальные.Ссылка.ПометкаУдаления)
	|			И ВТ_ТекДокумент.РабочийЦентр = ДоступностьРабочихЦентровИнтервалыОстальные.РабочийЦентр
	|			И (НАЧАЛОПЕРИОДА(ВТ_ТекДокумент.ДатаГрафика, ДЕНЬ) = НАЧАЛОПЕРИОДА(ДоступностьРабочихЦентровИнтервалыОстальные.ДатаГрафика, ДЕНЬ))
	|			И (ВТ_ТекДокумент.ВремяНачала МЕЖДУ ДоступностьРабочихЦентровИнтервалыОстальные.ВремяНачала И ДоступностьРабочихЦентровИнтервалыОстальные.ВремяОкончания
	|				ИЛИ ВТ_ТекДокумент.ВремяОкончания МЕЖДУ ДоступностьРабочихЦентровИнтервалыОстальные.ВремяНачала И ДоступностьРабочихЦентровИнтервалыОстальные.ВремяОкончания
	|				ИЛИ ДоступностьРабочихЦентровИнтервалыОстальные.ВремяНачала МЕЖДУ ВТ_ТекДокумент.ВремяНачала И ВТ_ТекДокумент.ВремяОкончания
	|				ИЛИ ДоступностьРабочихЦентровИнтервалыОстальные.ВремяОкончания МЕЖДУ ВТ_ТекДокумент.ВремяНачала И ВТ_ТекДокумент.ВремяОкончания)
	|ГДЕ
	|	НЕ ВТ_ТекДокумент.РабочийЦентр = ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.ПустаяСсылка)
	|	И НЕ ВТ_ТекДокумент.ДатаГрафика = ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТекДокумент.РабочийЦентр,
	|	НАЧАЛОПЕРИОДА(ВТ_ТекДокумент.ДатаГрафика, ДЕНЬ),
	|	ВТ_ТекДокумент.ВремяНачала,
	|	ВТ_ТекДокумент.ВремяОкончания";
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	Выборка = РезультатыЗапроса[РезультатыЗапроса.Количество()-2].Выбрать(); // документ пересекается сам с собой
	Пока Выборка.Следующий() Цикл
		Отказ = Истина;
		Сообщить("Не удалось провести документ """ + Источник.Ссылка + """: график """ + Выборка.РабочийЦентр + " / " + Выборка.ДатаГрафика + " / " + Формат(Выборка.ВремяНачала, "ДФ=HH:mm:ss") + " / " + Формат(Выборка.ВремяОкончания, "ДФ=HH:mm:ss") + """ пересекается с графиком документа """ + Выборка.ДокументПересечения + """");
	КонецЦикла;
	Выборка = РезультатыЗапроса[РезультатыЗапроса.Количество()-1].Выбрать(); // документ пересекается с другими документами
	Пока Выборка.Следующий() Цикл
		Отказ = Истина;
		Сообщить("Не удалось провести документ """ + Источник.Ссылка + """: график """ + Выборка.РабочийЦентр + " / " + Выборка.ДатаГрафика + " / " + Формат(Выборка.ВремяНачала, "ДФ=HH:mm:ss") + " / " + Формат(Выборка.ВремяОкончания, "ДФ=HH:mm:ss") + """ пересекается с графиком документа """ + Выборка.ДокументПересечения + """");
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоступностьРабочихЦентровИнтервалы.РабочийЦентр КАК РабочийЦентр,
	|	НАЧАЛОПЕРИОДА(ДоступностьРабочихЦентровИнтервалы.ДатаГрафика, ДЕНЬ) КАК ДатаГрафика,
	|	ДоступностьРабочихЦентровИнтервалы.ВремяНачала КАК ВремяНачала,
	|	ДоступностьРабочихЦентровИнтервалы.ВремяОкончания КАК ВремяОкончания
	|ИЗ
	|	Документ.ДоступностьРабочихЦентров.Интервалы КАК ДоступностьРабочихЦентровИнтервалы
	|ГДЕ
	|	ДоступностьРабочихЦентровИнтервалы.Ссылка = &Ссылка
	|	И НЕ ДоступностьРабочихЦентровИнтервалы.РабочийЦентр = ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.ПустаяСсылка)
	|	И НЕ ДоступностьРабочихЦентровИнтервалы.ДатаГрафика = ДАТАВРЕМЯ(1, 1, 1)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДоступностьРабочихЦентровИнтервалы.РабочийЦентр,
	|	ДоступностьРабочихЦентровИнтервалы.ДатаГрафика,
	|	ДоступностьРабочихЦентровИнтервалы.ВремяНачала,
	|	ДоступностьРабочихЦентровИнтервалы.ВремяОкончания
	|ИТОГИ ПО
	|	РабочийЦентр,
	|	ДатаГрафика";
	
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	
	ВыборкаРабочийЦентр = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВремяНачалоДня = Дата('00010101000000');
	ВремяКонецДня = Дата('00010101235959');
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("РабочийЦентр");
	Таблица.Колонки.Добавить("Начало");
	Таблица.Колонки.Добавить("Окончание");
	
	Пока ВыборкаРабочийЦентр.Следующий() Цикл
		ВыборкаДатаГрафика = ВыборкаРабочийЦентр.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДатаГрафика.Следующий() Цикл
			ВыборкаДетальныеЗаписи = ВыборкаДатаГрафика.Выбрать();
			СчетчикПериодовНедоступностиЗаДень = 0;
			СтруктураПредыдущейСтроки = Новый Структура("ВремяНачала,ВремяОкончания");
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Если СчетчикПериодовНедоступностиЗаДень > 0 Тогда
					// Первым делом нужно скорректировать предыдущую запись
					КорСтрока = Таблица[Таблица.Количество()-1];
					КорСтрока.Окончание = ВыборкаДетальныеЗаписи.ДатаГрафика + (ВыборкаДетальныеЗаписи.ВремяНачала - ВремяНачалоДня) - 1;
				КонецЕсли;
				
				Если ВыборкаДетальныеЗаписи.ВремяНачала <> ВремяНачалоДня И СчетчикПериодовНедоступностиЗаДень = 0 Тогда
					НоваяСтрока = Таблица.Добавить();
					НоваяСтрока.РабочийЦентр = ВыборкаДетальныеЗаписи.РабочийЦентр;
					НоваяСтрока.Начало = ВыборкаДетальныеЗаписи.ДатаГрафика;
					НоваяСтрока.Окончание = ВыборкаДетальныеЗаписи.ДатаГрафика + (ВыборкаДетальныеЗаписи.ВремяНачала - ВремяНачалоДня) - 1;
					СчетчикПериодовНедоступностиЗаДень = СчетчикПериодовНедоступностиЗаДень + 1;
				КонецЕсли;
				Если ВыборкаДетальныеЗаписи.ВремяОкончания = ВремяКонецДня Тогда
					
				Иначе
					НоваяСтрока = Таблица.Добавить();
					НоваяСтрока.РабочийЦентр = ВыборкаДетальныеЗаписи.РабочийЦентр;
					НоваяСтрока.Начало = ВыборкаДетальныеЗаписи.ДатаГрафика + (ВыборкаДетальныеЗаписи.ВремяОкончания - ВремяНачалоДня);
					НоваяСтрока.Окончание = КонецДня(ВыборкаДетальныеЗаписи.ДатаГрафика); // При необходимости скорректируем в следущей итерации
					СчетчикПериодовНедоступностиЗаДень = СчетчикПериодовНедоступностиЗаДень + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	//Если Таблица.Количество() = 0 Тогда
