				Если ЗначениеЗаполнено(РабочийЦентр) Тогда
					// Поищем второй прокат по этому заказу в свободных этапах и запланируем его на выбранный РЦ
					Этап = НайтиЭтапВСвободныхПоЗаказуИНомеруПроката(ЗаказКлиента, НомерПроката + 1);
					Если ЗначениеЗаполнено(Этап) Тогда
						// Этап в свободных. Поставим его в конец рабочего центра
						НужноСоздаватьЗапись = Истина;
					КонецЕсли;		
