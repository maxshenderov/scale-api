		|					ТОГДА ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Сумма / КурсыВалютСрезПоследних.Курс
		|				ИНАЧЕ ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Сумма
		|			КОНЕЦ КАК ЧИСЛО(15, 2))) КАК СуммаПлатежа
		|ПОМЕСТИТЬ ВТ_НеПроведенныеПлатежи
		|ИЗ
		|	Документ.ПоступлениеБезналичныхДенежныхСредств КАК ПоступлениеБезналичныхДенежныхСредств
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа
		|		ПО ПоступлениеБезналичныхДенежныхСредств.Ссылка = ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РасчетыПоПартнерамПросроченные КАК ВТ_РасчетыПоПартнерамПросроченные
		|		ПО (ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Партнер = ВТ_РасчетыПоПартнерамПросроченные.Партнер),
		|	РегистрСведений.КурсыВалют.СрезПоследних(, Валюта = &ВалютаУпр) КАК КурсыВалютСрезПоследних
		|ГДЕ
		|	ПоступлениеБезналичныхДенежныхСредств.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&ТекДата, ДЕНЬ, -2) И ДОБАВИТЬКДАТЕ(&ТекДата, ДЕНЬ, 1)
		|	И НЕ ПоступлениеБезналичныхДенежныхСредств.Проведен
		|	И НЕ ПоступлениеБезналичныхДенежныхСредств.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_РасчетыПоПартнерамПросроченные.Партнер КАК Партнер,
		|	ВТ_РасчетыПоПартнерамПросроченные.ДолгПлюсПредоплатаУпр КАК ДолгПлюсПредоплатаУпр,
		|	ЕСТЬNULL(ВТ_РасчетыПоПартнерам.ПредоплатаУпр, 0) КАК ПредоплатаУпр,
		|	ЕСТЬNULL(ВТ_НеПроведенныеПлатежи.СуммаПлатежа, 0) КАК НепроведеннаяПредоплатаУпр,
		|	ВТ_РасчетыПоПартнерамПросроченные.ДолгПлюсПредоплатаУпр - ЕСТЬNULL(ВТ_РасчетыПоПартнерам.ПредоплатаУпр, 0) - ЕСТЬNULL(ВТ_НеПроведенныеПлатежи.СуммаПлатежа, 0) КАК СуммаУпрДолгСУчетомПредоплаты
		|ИЗ
		|	ВТ_РасчетыПоПартнерамПросроченные КАК ВТ_РасчетыПоПартнерамПросроченные
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РасчетыПоПартнерам КАК ВТ_РасчетыПоПартнерам
		|		ПО ВТ_РасчетыПоПартнерамПросроченные.Партнер = ВТ_РасчетыПоПартнерам.Партнер
		|			И (ВТ_РасчетыПоПартнерам.Предоплата <> 0)
		|			И ВТ_РасчетыПоПартнерамПросроченные.Партнер = ВТ_РасчетыПоПартнерам.Партнер
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НеПроведенныеПлатежи КАК ВТ_НеПроведенныеПлатежи
		|		ПО ВТ_РасчетыПоПартнерамПросроченные.Партнер = ВТ_НеПроведенныеПлатежи.Партнер
		|			И (ВТ_НеПроведенныеПлатежи.СуммаПлатежа > 0)";
	КонецЕсли;
	
КонецФункции

Функция НайтиСотовыйНомерФизЛица(ФизЛицо) Экспорт // --> Начало Лико Ефимов ЕВВ 17.06.2022
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФизическиеЛицаКонтактнаяИнформация.Ссылка КАК Ссылка,
		|	ФизическиеЛицаКонтактнаяИнформация.Вид КАК Вид,
		|	ФизическиеЛицаКонтактнаяИнформация.НомерТелефона КАК НомерТелефона,
		|	ФизическиеЛицаКонтактнаяИнформация.Представление КАК Представление,
		|	ВЫБОР
		|		КОГДА ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица)
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК Порядок
		|ИЗ
		|	Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
		|ГДЕ
		|	ФизическиеЛицаКонтактнаяИнформация.Ссылка = &Ссылка
		|	И ФизическиеЛицаКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
		|	И (ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонМобильныйФизическиеЛица)
		|			ИЛИ ФизическиеЛицаКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";
	
	Запрос.УстановитьПараметр("Ссылка", ФизЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда	
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Телефон = ВыборкаДетальныеЗаписи.НомерТелефона;
			Если НЕ ЗначениеЗаполнено(Телефон) Тогда
				Телефон = ВыборкаДетальныеЗаписи.Представление;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Телефон) Тогда
				Продолжить;
			КонецЕсли;
			// Обработаем
			Телефон = ОставитьВСтрокеТолькоЧисла(Телефон);
			Если СтрДлина(Телефон) = 10 Тогда
				Телефон = "7" + Телефон;
			КонецЕсли;
			Если СтрДлина(Телефон) = 11 Тогда
				Если Лев(Телефон, 1) = "8" Тогда
					Телефон = "7" + Прав(Телефон, 10);
				КонецЕсли;
				Возврат Телефон;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции // <-- Конец Лико Ефимов ЕВВ 17.06.2022

Функция ОставитьВСтрокеТолькоЧисла(СтрокаРазличныеСимволы) Экспорт // --> Начало Лико Ефимов ЕВВ 17.06.2022

    Если СтрДлина(СтрокаРазличныеСимволы) = 0 Тогда
        Возврат "";
    КонецЕсли;

    РезультатЧисло = "";
    Для а = 1 по СтрДлина(СтрокаРазличныеСимволы) Цикл
        Символ = Сред(СтрокаРазличныеСимволы, а, 1);

        Если Найти("0123456789", Символ) = 0 Тогда
            Продолжить;
        КонецЕсли;

        РезультатЧисло = "" + РезультатЧисло + Символ;
    КонецЦикла;

    Возврат РезультатЧисло;

КонецФункции // <-- Конец Лико Ефимов ЕВВ 17.06.2022

Функция СформироватьНадписьЧасыМинуты(ЧислоСекунд, СтрокаВремяНоль = "00:00") Экспорт
	
	Если ЗначениеЗаполнено(ЧислоСекунд) Тогда
        ЧислоЧасов=Цел(ЧислоСекунд / 60 / 60);
		ЧислоМинут = Цел(ЧислоСекунд / 60);
		Если ЧислоЧасов = 0 И ЧислоМинут = 0 Тогда
			ЧислоМинут = 1;
		КонецЕсли;
        Возврат Прав("00"+Строка(ЧислоЧасов),Макс(2,СтрДлина(Строка(ЧислоЧасов)))) + ":" + Прав("00"+Строка(ЧислоМинут - ЧислоЧасов * 60),2); 
    Иначе    
        Возврат СтрокаВремяНоль;
	КонецЕсли;
	
КонецФункции

Функция СформироватьНадписьМесяцыДниЧасы(ЧислоСекунд, СтрокаВремяНоль = "00:00:00") Экспорт
	
	Если ЗначениеЗаполнено(ЧислоСекунд) Тогда
		ТекДата = ТекущаяДата();
        ЧислоЧасов=Цел(ЧислоСекунд / 60 / 60);
        ЧислоДней=Цел(ЧислоЧасов / 24);
        ЧислоМесяцев = Цел(ЧислоДней / 30);
		Если ЧислоМесяцев = 0 И ЧислоДней = 0 И ЧислоЧасов = 0 Тогда
			Возврат СтрокаВремяНоль;
		КонецЕсли;
        Возврат Прав("00"+Строка(ЧислоМесяцев),Макс(2,СтрДлина(Строка(ЧислоМесяцев)))) + ":" + Прав("00"+Строка(ЧислоДней - ЧислоМесяцев * 30),2) + ":" + Прав("00"+Строка(ЧислоЧасов - ЧислоДней * 24),2); 
    Иначе    
        Возврат СтрокаВремяНоль;
	КонецЕсли;
	
КонецФункции 

Процедура УдалитьПредыдущуюВерсиюФайла(ВладелецФайла,ИмяФайла) Экспорт // --> Начало Лико Яцун 13.12.2022
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаПрисоединенныеФайлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЗаказКлиентаПрисоединенныеФайлы КАК ЗаказКлиентаПрисоединенныеФайлы
		|ГДЕ
		|	ЗаказКлиентаПрисоединенныеФайлы.Наименование ПОДОБНО &ИмяФайла + ""%""
		|	И ЗаказКлиентаПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
		|	И НЕ ЗаказКлиентаПрисоединенныеФайлы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ВладелецФайла", ВладелецФайла);
	Запрос.УстановитьПараметр("ИмяФайла", Лев(ИмяФайла,8));

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Файл = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Файл.УстановитьПометкуУдаления(Истина);
		
	КонецЦикла;
	
	ОбластьПоиска = Новый Массив;
	
	ВключитьОбъекты = Новый Массив;
	ВключитьОбъекты.Добавить("Справочник.ЗаказКлиентаПрисоединенныеФайлы");
	
	НайденныеОбъекты = НайтиПомеченныеНаУдаление(ОбластьПоиска,ВключитьОбъекты);
	
	УдалитьОбъекты(НайденныеОбъекты);
	
КонецПроцедуры // <-- Конец Лико Яцун 13.12.2022

Процедура ИзменитьРеквизитыОбъектаВРежимеОбмена(Ссылка, СтруктураРеквизитов) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Объект = Ссылка.ПолучитьОбъект();
	Объект.ОбменДанными.Загрузка = Истина;
	Для каждого ЭлементСтруктуры из СтруктураРеквизитов Цикл
		Попытка
			Объект[ЭлементСтруктуры.Ключ] = ЭлементСтруктуры.Значение;
		Исключение
			Сообщить("В функции ИзменитьРеквизитыОбъектаВРежимеОбмена произошла ошика: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		Объект.Записать();
	Исключение
		Сообщить("В функции ИзменитьРеквизитыОбъектаВРежимеОбмена произошла ошика: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

// формирует ВНЕШНЮЮ ссылку объекта (с кокретной базой)
Функция СформироватьНавигационнуюСсылкуОбъекта(Ссылка) Экспорт // --> Начало Лико Ефимов ЕВВ 09.06.2023

	Попытка
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(Ссылка);
		
		СтрокаСоединения = СтрокаСоединенияИнформационнойБазы(); //Пример: Srvr="test-1c";Ref="erp_demo";
		ДлинаСтроки = СтрДлина(СтрокаСоединения);
		//Отрежем имя базы - справа до второй кавычки
		ИмяБазы = "";
		КолКавычек = 0;
		Для сч=1 По ДлинаСтроки Цикл
			ТекСимвол = Сред(СтрокаСоединения, ДлинаСтроки-сч+1, 1);
			Если КолКавычек = 1 И ТекСимвол <> Символ(34) Тогда
				ИмяБазы = ТекСимвол + ИмяБазы;
			КонецЕсли;
			
			Если ТекСимвол = Символ(34) Тогда
				КолКавычек = КолКавычек + 1;
			КонецЕсли;
			Если КолКавычек = 2 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		// А теперь отрежем имя сервера слева
		ИмяСервера = "";
		КолКавычек = 0;
		Для сч=1 По ДлинаСтроки Цикл
			ТекСимвол = Сред(СтрокаСоединения, сч, 1);
			Если КолКавычек = 1 И ТекСимвол <> Символ(34) Тогда
				ИмяСервера = ИмяСервера + ТекСимвол;
			КонецЕсли;
			
			Если ТекСимвол = Символ(34) Тогда
				КолКавычек = КолКавычек + 1;
			КонецЕсли;
			Если КолКавычек = 2 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		// А теперь соберем внешнюю ссылку
		НавигационнаяСсылкаВнешняя = "e1c://server/" + ИмяСервера + "/" + ИмяБазы + "?Z=%2B%2C%2B" + "#" + НавигационнаяСсылка;
		
		Возврат НавигационнаяСсылкаВнешняя;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 09.06.2023

Функция ПолучитьКоличествоЗасчитанныхЭтикетокПоЗаказу(ЗаказКлиента) Экспорт // --> Начало Лико Ефимов ЕВВ 07.07.2023

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_УчетГотовыхЭтикетокОбороты.ЗаказКлиента КАК ЗаказКлиента,
		|	Лико_УчетГотовыхЭтикетокОбороты.НомерБланка КАК НомерБланка,
		|	Лико_УчетГотовыхЭтикетокОбороты.НомерПриложения КАК НомерПриложения,
		|	ВЫБОР
		|		КОГДА Лико_УчетГотовыхЭтикетокОбороты.ЗаказКлиента.Площадка = ЗНАЧЕНИЕ(Справочник.Лико_Площадки.Линкс)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ПлощадкаЛинкс,
		|	СУММА(ВЫБОР
		|			КОГДА Лико_УчетГотовыхЭтикетокОбороты.Место = ЗНАЧЕНИЕ(Перечисление.Лико_МестаУчетаГотовыхЭтикеток.Перемотка)
		|				ТОГДА Лико_УчетГотовыхЭтикетокОбороты.КоличествоПриход
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КоличествоПеремотка,
		|	СУММА(ВЫБОР
		|			КОГДА Лико_УчетГотовыхЭтикетокОбороты.Место = ЗНАЧЕНИЕ(Перечисление.Лико_МестаУчетаГотовыхЭтикеток.ВыходнойКонтроль)
		|				ТОГДА Лико_УчетГотовыхЭтикетокОбороты.КоличествоПриход
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КоличествоВыходнойКонтроль,
		|	СУММА(ВЫБОР
		|			КОГДА Лико_УчетГотовыхЭтикетокОбороты.Место = ЗНАЧЕНИЕ(Перечисление.Лико_МестаУчетаГотовыхЭтикеток.Упаковка)
		|				ТОГДА Лико_УчетГотовыхЭтикетокОбороты.КоличествоПриход
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КоличествоУпаковка
		|ИЗ
		|	РегистрНакопления.Лико_УчетГотовыхЭтикеток.Обороты(, , , ЗаказКлиента = &ЗаказКлиента) КАК Лико_УчетГотовыхЭтикетокОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	Лико_УчетГотовыхЭтикетокОбороты.ЗаказКлиента,
		|	Лико_УчетГотовыхЭтикетокОбороты.НомерБланка,
		|	Лико_УчетГотовыхЭтикетокОбороты.НомерПриложения,
		|	ВЫБОР
		|		КОГДА Лико_УчетГотовыхЭтикетокОбороты.ЗаказКлиента.Площадка = ЗНАЧЕНИЕ(Справочник.Лико_Площадки.Линкс)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|ИТОГИ ПО
		|	НомерБланка";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	
	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаНомерБланка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СоответствиеБланков = Новый Соответствие;
	
	Пока ВыборкаНомерБланка.Следующий() Цикл
		СоответствиеПриложений = Новый Соответствие;
		ВыборкаДетальныеЗаписи = ВыборкаНомерБланка.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.ПлощадкаЛинкс Тогда
				Если ВыборкаДетальныеЗаписи.КоличествоУпаковка <> 0 Тогда
					ТекКоличество = ВыборкаДетальныеЗаписи.КоличествоУпаковка;
				Иначе
					ТекКоличество = ВыборкаДетальныеЗаписи.КоличествоПеремотка;
				КонецЕсли;
			Иначе
				ТекКоличество = ВыборкаДетальныеЗаписи.КоличествоВыходнойКонтроль;
			КонецЕсли;
			СоответствиеПриложений.Вставить(ВыборкаДетальныеЗаписи.НомерПриложения, ТекКоличество);
		КонецЦикла;
		СоответствиеБланков.Вставить(ВыборкаНомерБланка.НомерБланка, СоответствиеПриложений);
	КонецЦикла;

	Возврат СоответствиеБланков;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 07.07.2023

Функция НовыйМеханизмСозданияФорм(ПлощадкаОрганизация, Дата) Экспорт // --> Начало Лико Ефимов ЕВВ 24.07.2024

	Если ТипЗнч(ПлощадкаОрганизация) = Тип("СправочникСсылка.Лико_Площадки") Тогда
		Организация = ПлощадкаОрганизация.Организация;
	Иначе
		Организация = ПлощадкаОрганизация;
	КонецЕсли;
	
	ДатаНачалаНовогоМеханизмаСозданияФорм = Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаНовогоМеханизмаСозданияФорм.ЗначениеПараметра;

	Если НЕ ЗначениеЗаполнено(ДатаНачалаНовогоМеханизмаСозданияФорм)
		ИЛИ Дата < ДатаНачалаНовогоМеханизмаСозданияФорм Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра
		ИЛИ Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли; 
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 24.07.2024

Процедура ОтменитьЗаявкиНаФормыПриЗакрытииЗаказа(МассивЗаказов) Экспорт // --> Начало Лико Ефимов ЕВВ 30.08.2024
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТС_ЗаявкаНаРемонтРабочихЦентров.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ТС_ЗаявкаНаРемонтРабочихЦентров КАК ТС_ЗаявкаНаРемонтРабочихЦентров
		|ГДЕ
		|	НЕ ТС_ЗаявкаНаРемонтРабочихЦентров.ПометкаУдаления
		|	И ТС_ЗаявкаНаРемонтРабочихЦентров.ПодразделениеПолучатель = ЗНАЧЕНИЕ(Справочник.ТС_Подразделения.Формщики)
		|	И ТС_ЗаявкаНаРемонтРабочихЦентров.ТекущееСостояние В (ЗНАЧЕНИЕ(Перечисление.ТС_СостоянияРемонтныхРабот.ВключенВПлан), ЗНАЧЕНИЕ(Перечисление.ТС_СостоянияРемонтныхРабот.Подтвержден))
		|	И ТС_ЗаявкаНаРемонтРабочихЦентров.ЗаказКлиента В(&МассивЗаказов)";
	
	Запрос.УстановитьПараметр("МассивЗаказов", МассивЗаказов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Дата = ТекущаяДата();
		ЗавершитьЭтапЗаявкиНаРемонт(Выборка.Ссылка, Дата);
		ДобавитьЭтапЗаявкиНаРемонт(Выборка.Ссылка, Перечисления.ТС_СостоянияРемонтныхРабот.СнятИзПлана, Дата, ПараметрыСеанса.ТекущийПользователь);
		
		НаборЗаписей  = РегистрыСведений.ТС_ПланированиеРемонтныхРаботРЦ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЗаявкаНаРемонт.Установить(Выборка.Ссылка);
		НаборЗаписей.Записать(Истина);
	КонецЦикла;

КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 30.08.2024
 
Процедура ДобавитьЭтапЗаявкиНаРемонт(ЗаявкаНаРемонт, Этап = Неопределено, Дата, Сотрудник) Экспорт // --> Начало Лико Ефимов ЕВВ 30.08.2024	
	
	Если Этап=Неопределено Тогда
		Этап=Перечисления.ТС_СостоянияРемонтныхРабот.ВРаботе;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних.Состояние КАК Этап
		|ИЗ
		|	РегистрСведений.ТС_ЭтапыВыполненияРемонтныхРаботРЦ.СрезПоследних(, ЗаявкаНаРемонт = &ЗаявкаНаРемонт) КАК ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних";
		Запрос.УстановитьПараметр("ЗаявкаНаРемонт",ЗаявкаНаРемонт);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Этап=Выборка.Этап;
		КонецЦикла; 
		
	КонецЕсли;
	
	НачатьТранзакцию();	
	
	НаборЗаписей 				=РегистрыСведений.ТС_ЭтапыВыполненияРемонтныхРаботРЦ.СоздатьНаборЗаписей();
	НоваяЗапись					=НаборЗаписей.Добавить();
	НоваяЗапись.Период			=Дата;
	НоваяЗапись.ДатаНачала		=Дата;
	НоваяЗапись.ЗаявкаНаРемонт	=ЗаявкаНаРемонт;
	НоваяЗапись.Состояние		=Этап;
	НоваяЗапись.РабочийЦентр	=ЗаявкаНаРемонт.РабочийЦентр;
	НоваяЗапись.Сотрудник		=Сотрудник;
	НоваяЗапись.ЛожныйВызов		=ЗаявкаНаРемонт.ЛожныйВызов;
	НаборЗаписей.Записать(Ложь);
	
	Если Этап=Перечисления.ТС_СостоянияРемонтныхРабот.НеВыполнен Тогда
		РегистрыСведений.Лико_СтатусыЗаявокНаРемонтПоЗакупкамЗапчастей.НовыйСтатус(ЗаявкаНаРемонт,Перечисления.Лико_СтатусыЗакупкиЗапчастей.ВРаботеУИнженера);
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 30.08.2024

Процедура ЗавершитьЭтапЗаявкиНаРемонт(ЗаявкаНаРемонт,Дата) Экспорт // --> Начало Лико Ефимов ЕВВ 30.08.2024
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних.Период,
	|	ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних.ДатаНачала,
	|	ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних.ДатаОкончания,
	|	ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних.Состояние,
	|	ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних.ЗаявкаНаРемонт,
	|	ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних.РабочийЦентр,
	|	ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних.Сотрудник
	|ИЗ
	|	РегистрСведений.ТС_ЭтапыВыполненияРемонтныхРаботРЦ.СрезПоследних(, ЗаявкаНаРемонт = &ЗаявкаНаРемонт) КАК ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних";
	Запрос.УстановитьПараметр("ЗаявкаНаРемонт",ЗаявкаНаРемонт );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.ТС_ЭтапыВыполненияРемонтныхРаботРЦ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
		НаборЗаписей.Отбор.ЗаявкаНаРемонт.Установить(Выборка.ЗаявкаНаРемонт);
		//НаборЗаписей.Отбор.Состояние.Установить(Выборка.Состояние);
		НаборЗаписей.Прочитать();
		Для каждого Запись Из НаборЗаписей Цикл
			Запись.ДатаОкончания=Дата;
		КонецЦикла; 
		НаборЗаписей.Записать();
	КонецЦикла; 
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 30.08.2024

Процедура УдалитьИзПланаНаСервере(ЗаявкаНаРемонт,Этап,Сотрудник) Экспорт
	Если ЗаявкаНаРемонт.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	//Сотрудник	=ПараметрыСеанса.ТекущийПользователь.ФизЛицо;
	Дата		=ТекущаяДата();
	
	Этап		=Перечисления.ТС_СостоянияРемонтныхРабот[Этап];
	
	
	ЗавершитьЭтапЗаявкиНаРемонт(ЗаявкаНаРемонт,Дата);
	ДобавитьЭтапЗаявкиНаРемонт(ЗаявкаНаРемонт,Этап,Дата,Сотрудник);
	
	НаборЗаписей 					= РегистрыСведений.ТС_ПланированиеРемонтныхРаботРЦ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЗаявкаНаРемонт.Установить(ЗаявкаНаРемонт);
	НаборЗаписей.Записать(Истина);
	
	ОбновитьОчередьВПлане();
КонецПроцедуры

Процедура ДобавитьЭтапНаСервере(Исполнитель,ЗаявкаНаРемонт,Этап, Комментарий = Неопределено) Экспорт // из обработки УпралвениеЗаявкамиНаРемонт.ФормаДокумента
	
	Этап=Перечисления.ТС_СостоянияРемонтныхРабот[Этап];
	Дата=ТекущаяДата();
	ЗавершитьЭтапЗаявкиНаРемонт(ЗаявкаНаРемонт,Дата);
	ДобавитьЭтапЗаявкиНаРемонт(ЗаявкаНаРемонт,Этап,Дата,Исполнитель);
	
	// --> Начало Лико Ефимов ЕВВ 02.02.2021
	ПодразделениеМеханики = ЗаявкаНаРемонт.ПодразделениеПолучатель = Справочники.ТС_Подразделения.Механики
							ИЛИ ЗаявкаНаРемонт.ПодразделениеПолучатель = Справочники.ТС_Подразделения.МеханикиЦифра;
	Если Этап = Перечисления.ТС_СостоянияРемонтныхРабот.Выполнен
		И (ЗаявкаНаРемонт.ПодразделениеПолучатель = Справочники.ТС_Подразделения.Технологи
			ИЛИ ЗаявкаНаРемонт.ПодразделениеПолучатель = Справочники.ТС_Подразделения.Формщики
			ИЛИ ПодразделениеМеханики // --> Начало Лико Ефимов ЕВВ 10.05.2023 добавляем механиков
		) Тогда 
		НужноОповещение = Истина;
		Если ПодразделениеМеханики Тогда
			Если ЗначениеЗаполнено(ЗаявкаНаРемонт.МестоСозданияЗаявки)
				И ЗаявкаНаРемонт.МестоСозданияЗаявки <> "Тачпад" Тогда 
				// Нужно установить статус закрытия
				ЗаявкаОбъект = ЗаявкаНаРемонт.ПолучитьОбъект();
				ЗаявкаОбъект.СтатусЗакрытия = Перечисления.ТС_СтатусыЗаявокТехнологамПриЗакрытии.Авто; 
				ЗаявкаОбъект.ВыполненаПодтверждение = Истина;
				ЗаявкаОбъект.ОбменДанными.Загрузка = Истина;
				ЗаявкаОбъект.Записать(); 
				Если ЗначениеЗаполнено(Документы.ТС_ЗаявкаНаРемонтРабочихЦентров.РольМеханика(ЗаявкаНаРемонт.Автор)) Тогда
					// Заявка механику создана самими механиками. В этом случае оповещать никого не нужно
					НужноОповещение = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если НужноОповещение Тогда
			ОператорКоторомуНеобходимоПоказать = Неопределено;
			Если ЗаявкаНаРемонт.МестоСозданияЗаявки = "Тачпад"
				И Документы.ТС_ЗаявкаНаРемонтРабочихЦентров.ЗаявкаБылаВНевыполненных(ЗаявкаНаРемонт) Тогда
				// Заявка в невыполненных, нужно только одного печатника
				ОператорКоторомуНеобходимоПоказать = ЗаявкаНаРемонт.Автор;
			КонецЕсли;
			Документы.ТС_ЗаявкаНаРемонтРабочихЦентров.СформироватьОповещениеОВыполненииЗаявки(ЗаявкаНаРемонт, Комментарий,, ОператорКоторомуНеобходимоПоказать);
		КонецЕсли;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 02.02.2021
	
КонецПроцедуры

Процедура ОбновитьОчередьВПлане() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТС_ПланированиеРемонтныхРаботРЦ.РабочийЦентр,
	|	ТС_ПланированиеРемонтныхРаботРЦ.ЗаявкаНаРемонт,
	|	ТС_ПланированиеРемонтныхРаботРЦ.НомерОчереди КАК НомерОчереди
	|ИЗ
	|	РегистрСведений.ТС_ПланированиеРемонтныхРаботРЦ КАК ТС_ПланированиеРемонтныхРаботРЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерОчереди";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	НомерОчереди=1;
	Пока Выборка.Следующий() Цикл
		Если НомерОчереди<>Выборка.НомерОчереди Тогда
			НаборЗаписей = РегистрыСведений.ТС_ПланированиеРемонтныхРаботРЦ.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЗаявкаНаРемонт.Установить(Выборка.ЗаявкаНаРемонт);
			НаборЗаписей.Прочитать();
			Для каждого Запись Из НаборЗаписей  Цикл
				
				Запись.НомерОчереди=НомерОчереди;
			КонецЦикла;
			НаборЗаписей.Записать();
		КонецЕсли;
		НомерОчереди=НомерОчереди+1;
	КонецЦикла; 
	
КонецПроцедуры


Функция ПолучитьЗначенияДопРеквизитовКлиентаДляПечатиДокументов(Партнер = Неопределено, Контрагент = Неопределено) Экспорт // <-- Начало Лико Яцун С. В. 13.01.2025

	ДопДанные = Новый Структура();
	
	СНомеромКонтракта = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Партнер, "РеализацияКакХенкельИЮнилевер_c9569d7edf7e41eca11c538537ca726b", Ложь)
	ИЛИ Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Партнер, "ПечатьДокументовСНомеромКонтракта_2a029765662e4c61bb68bce57d313f98", Ложь)
	ИЛИ Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Контрагент, "ПечатьДокументовСНомеромКонтракта_a53e7e7bb4804cb991c655a007b2eda1", Ложь);
	СКодомЭтикеткиЗаказчика = НЕ Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Партнер, "ПечатьДокументовБезГалкиСКодомЭтикетки_af928073435546308edea7efb2fb4565", Ложь);
	
	ДопДанные.Вставить("СНомеромКонтракта",СНомеромКонтракта);
	ДопДанные.Вставить("СКодомЭтикеткиЗаказчика",СКодомЭтикеткиЗаказчика);
	
	Возврат ДопДанные;
	
КонецФункции // <-- Конец Лико Яцун С. В. 13.01.2025

Функция ЭтоСтрокаСплошнойФормы(СтрокаТчЦветаЗаказаКлиента) Экспорт // --> Начало Лико Ефимов ЕВВ 19.06.2025
	
	Если СтрокаТчЦветаЗаказаКлиента.ВидСекции.ВидПечати = Справочники.Лико_ВидыПечати.Флексо
		И (СтрокаТчЦветаЗаказаКлиента.ВидТМЦ = Справочники.Лико_ВидыТМЦ.Лак
			ИЛИ СтрокаТчЦветаЗаказаКлиента.ВидТМЦ = Справочники.Лико_ВидыТМЦ.Праймер
			ИЛИ СтрокаТчЦветаЗаказаКлиента.ВидТМЦ = Справочники.Лико_ВидыТМЦ.Клей)
		И СтрокаТчЦветаЗаказаКлиента.ВидЗаливки = Перечисления.Лико_ВидЗаливки.Сплошная
		Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 19.06.2025

Функция СоздатьНовуюФорму(ПараметрыДляСозданияНовойФормы) Экспорт
	
	// --> Начало Лико Ефимов ЕВВ 19.06.2025 Перенес эту функцию из формы заявки на цветоделение, чтобы вызывать ее из обработки тачпада при создании сплошной формы
	
	ВидПечати = ПараметрыДляСозданияНовойФормы.ВидСекции.ВидПечати;
	НоваяФормаЦвета = Справочники.Лико_Формы.СоздатьЭлемент();
	// --> Начало Лико Ефимов ЕВВ 16.06.2025
	Если ПараметрыДляСозданияНовойФормы.Свойство("Сплошная") И ПараметрыДляСозданияНовойФормы.Сплошная Тогда
		// Спрлошные формы создаем отдельно
		НоваяФормаЦвета.Сплошная = Истина;
		НоваяФормаЦвета.Заказ = ПараметрыДляСозданияНовойФормы.Ссылка;
		НоваяФормаЦвета.ВидПечати = ВидПечати;
		НоваяФормаЦвета.Длина = ПараметрыДляСозданияНовойФормы.Длина;
		НоваяФормаЦвета.ТолщинаПолимера = ПараметрыДляСозданияНовойФормы.ТолщинаПолимера;
		НоваяФормаЦвета.Ширина = ПараметрыДляСозданияНовойФормы.Ширина;
		НоваяФормаЦвета.Площадка = ПараметрыДляСозданияНовойФормы.Площадка;
		НоваяФормаЦвета.Наименование = "Сплошная " + НоваяФормаЦвета.Длина + " / " + НоваяФормаЦвета.Ширина + " / " + НоваяФормаЦвета.ТолщинаПолимера + " (длина / ширина / толщина полимера)";
	// <-- Конец Лико Ефимов ЕВВ 16.06.2025
	Иначе
		НоваяФормаЦвета.Контрагент = ПараметрыДляСозданияНовойФормы.Контрагент; 
		НоваяФормаЦвета.Заказ = ПараметрыДляСозданияНовойФормы.Ссылка;
		НоваяФормаЦвета.ВидПечати = ВидПечати; 
		НоваяФормаЦвета.ВидСекции = ПараметрыДляСозданияНовойФормы.ВидСекции;
		Если ВидПечати = Справочники.Лико_ВидыПечати.Флексо ИЛИ ВидПечати = Справочники.Лико_ВидыПечати.Трафарет ИЛИ ПараметрыДляСозданияНовойФормы.ВидСекции = Справочники.Лико_ВидыСекций.ГлубокаяПечать Тогда
			НоваяФормаЦвета.ТипЦвета = ПараметрыДляСозданияНовойФормы.ТипЦвета1; 
			НоваяФормаЦвета.ТипКраски = ПараметрыДляСозданияНовойФормы.ТипКраски; 
			НоваяФормаЦвета.Название = ПараметрыДляСозданияНовойФормы.Название;
			НоваяФормаЦвета.Наименование = ?(ЗначениеЗаполнено(ПараметрыДляСозданияНовойФормы.ТипЦвета1), Строка(ПараметрыДляСозданияНовойФормы.ТипЦвета1)+ " ", "")+?(ЗначениеЗаполнено(ПараметрыДляСозданияНовойФормы.ТипКраски), Строка(ПараметрыДляСозданияНовойФормы.ТипКраски)+ " ", "")+ ?(ЗначениеЗаполнено(ПараметрыДляСозданияНовойФормы.Название), Строка(ПараметрыДляСозданияНовойФормы.Название), "");
		ИначеЕсли ВидПечати = Справочники.Лико_ВидыПечати.Цифровая Тогда 
			НоваяФормаЦвета.Наименование = Строка(ПараметрыДляСозданияНовойФормы.ВидСекции) + " " + ПараметрыДляСозданияНовойФормы.НомерБезПрефикса;
		КонецЕсли;
		НоваяФормаЦвета.Площадка = ПараметрыДляСозданияНовойФормы.Площадка;
		НоваяФормаЦвета.Организация = НоваяФормаЦвета.Площадка.Организация;
		
		Для каждого Эт из ПараметрыДляСозданияНовойФормы.Товары Цикл
			стрЭт = НоваяФормаЦвета.Этикетки.Добавить();
			стрэт.Номенклатура =  Эт.Номенклатура;
		КонецЦикла;
		
		// --> Начало Лико Ефимов ЕВВ 29.07.2024 
		Если ПараметрыДляСозданияНовойФормы.Свойство("Дисторт") Тогда
			НоваяФормаЦвета.ДистортФлексо = ПараметрыДляСозданияНовойФормы.Дисторт;
			НоваяФормаЦвета.ВидПолимера = ПараметрыДляСозданияНовойФормы.ВидПолимера;
			Если НЕ ПараметрыДляСозданияНовойФормы.Цветоделение И ПараметрыДляСозданияНовойФормы.ДистортВидПолимера Тогда
				// Цветоеделение не установлено, ДистортВидПолимера установлен
				// Меняем заказ на тот, который установлен в старой форме
				НоваяФормаЦвета.Заказ = ПараметрыДляСозданияНовойФормы.СтараяФорма.Заказ;
				// Заполяем код по старому телу
				ПрефиксВидПолимера = Лев(СокрЛП(ПараметрыДляСозданияНовойФормы.ВидПолимера.Префикс), 1);
				ПрефиксДисторт = ПараметрыДляСозданияНовойФормы.Дисторт.Префикс;
				НоваяФормаЦвета.Код = Лев(ПараметрыДляСозданияНовойФормы.СтараяФорма.Код, 9) + ПрефиксВидПолимера + ПрефиксДисторт; 
			КонецЕсли;
		КонецЕсли;
		// <-- Конец Лико Ефимов ЕВВ 29.07.2024 
	КонецЕсли;
	
	НоваяФормаЦвета.Записать();  
	
	Возврат НоваяФормаЦвета.Ссылка	
	
КонецФункции

Функция ПолучитьПараметрыСплошнойФормы(ЗаказКлиента, РабочийЦентр)

	СтруктураВозврата = Новый Структура("Длина,ТолщинаПолимера,Ширина"); 
	
	ВидРЦ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РабочийЦентр, "ВидРабочегоЦентра");
	РевизитыВидаРЦ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидРЦ, "Лико_ТолщинаПолимераФлексоформ,лкМаксимальнаяНарезка");
	// Ширина = нарезка с округлением до целых сантиметров. Например, нарезка 200 - ширина 200, нарезка 205 - ширина 200, нарезка 210 - ширина 210 и т.д.
	ШиринаПоНарезке = Цел(ЗаказКлиента.Нарезка.Размер / 10) * 10;
	Если ВидРЦ = Справочники.ВидыРабочихЦентров.GallusGranitic 
		ИЛИ ВидРЦ = Справочники.ВидыРабочихЦентров.GallusInkjet
		ИЛИ ВидРЦ = Справочники.ВидыРабочихЦентров.Omet
		ИЛИ ВидРЦ = Справочники.ВидыРабочихЦентров.Comexi
		Тогда
		СтруктураВозврата.Ширина = ШиринаПоНарезке;
	ИначеЕсли ВидРЦ = Справочники.ВидыРабочихЦентров.Omega Тогда
		СтруктураВозврата.Ширина = 330;
	ИначеЕсли ЗначениеЗаполнено(РевизитыВидаРЦ.лкМаксимальнаяНарезка) Тогда
		СтруктураВозврата.Ширина = РевизитыВидаРЦ.лкМаксимальнаяНарезка; 
	Иначе
		СтруктураВозврата.Ширина = ШиринаПоНарезке;
	КонецЕсли;

	Длина = ?(ЗаказКлиента.Цифровой ИЛИ ВидРЦ = Справочники.ВидыРабочихЦентров.Omega, ЗаказКлиента.ШагПечати, ЗаказКлиента.ДлинаПечати) * 1000; // Переведем в мм
	СтруктураВозврата.Длина = ?(Длина - Цел(Длина) > 0, Цел(Длина) + 1, Длина); // Округлим всегда в большую сторону
	СтруктураВозврата.ТолщинаПолимера = РевизитыВидаРЦ.Лико_ТолщинаПолимераФлексоформ; 

	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПроверитьПодобратьСоздатьСплошнуюФорму(ЗаказОбъект, СтрокаТчЦветаЗаказаКлиента, ПараметрыДляСозданияНовойФормы) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураВозврата = Новый Структура("СозданаНоваяФорма,Модифицированность", Ложь, Ложь);
	
	ТекПараметрыСплошнойФормы = ПолучитьПараметрыСплошнойФормы(ЗаказОбъект, СтрокаТчЦветаЗаказаКлиента.РабочийЦентр);
	Если ЗначениеЗаполнено(СтрокаТчЦветаЗаказаКлиента.Форма) Тогда
		Если НЕ ПроверитьСплошнуюФормуНаСоответствиеПараметрамЗаказа(ЗаказОбъект, СтрокаТчЦветаЗаказаКлиента, ТекПараметрыСплошнойФормы) Тогда
			// Форма очистилась, поставим модифицированность
			СтруктураВозврата.Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТчЦветаЗаказаКлиента.Форма) Тогда
		// Попробуем найти форму по ключевым параметрам
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_Формы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Лико_Формы КАК Лико_Формы
		|ГДЕ
		|	НЕ Лико_Формы.ПометкаУдаления
		|	И Лико_Формы.Сплошная
		|	И Лико_Формы.Ширина = &Ширина
		|	И Лико_Формы.Длина = &Длина
		|	И Лико_Формы.ТолщинаПолимера = &ТолщинаПолимера
		|	И Лико_Формы.Площадка = &Площадка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Лико_Формы.Код";
		
		Запрос.УстановитьПараметр("Длина", ТекПараметрыСплошнойФормы.Длина);
		Запрос.УстановитьПараметр("ТолщинаПолимера", ТекПараметрыСплошнойФормы.ТолщинаПолимера);
		Запрос.УстановитьПараметр("Ширина", ТекПараметрыСплошнойФормы.Ширина);
		Запрос.УстановитьПараметр("Площадка", ЗаказОбъект.Площадка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			// Такая форма уже есть, подставим ее
			СтрокаТчЦветаЗаказаКлиента.Форма = Выборка.Ссылка;
			стрФ = ЗаказОбъект.Формы.Добавить();
			стрФ.Ключстроки = СтрокаТчЦветаЗаказаКлиента.ключстроки;
			стрФ.Значение = СтрокаТчЦветаЗаказаКлиента.Форма;  
			стрФ.Цветоделение = СтрокаТчЦветаЗаказаКлиента.Цветоделение;
			//Сообщить("Сплошная форма для строки №" + СтрокаТчЦветаЗаказаКлиента.НомерСтроки + " подобрана из уже существующих (" + СтрокаТчЦветаЗаказаКлиента.Форма + ")");
			СтруктураВозврата.Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаТчЦветаЗаказаКлиента.Форма) Тогда
		// Нужно создать новую сплошную форму
		ПараметрыДляСозданияНовойФормы.Вставить("Сплошная", Истина);
		ПараметрыДляСозданияНовойФормы.Вставить("Длина", ТекПараметрыСплошнойФормы.Длина);
		ПараметрыДляСозданияНовойФормы.Вставить("ТолщинаПолимера", ТекПараметрыСплошнойФормы.ТолщинаПолимера);
		ПараметрыДляСозданияНовойФормы.Вставить("Ширина", ТекПараметрыСплошнойФормы.Ширина);
		НоваяФорма = СоздатьНовуюФорму(ПараметрыДляСозданияНовойФормы);
		СтрокаТчЦветаЗаказаКлиента.форма = НоваяФорма;
		СтруктураВозврата.СозданаНоваяФорма = Истина;
		СтруктураВозврата.Модифицированность = Истина;
		//Необходимо записать значение в табличную часть "Формы"
		стрФ = ЗаказОбъект.Формы.Добавить();
		стрФ.Ключстроки = СтрокаТчЦветаЗаказаКлиента.ключстроки;
		стрФ.Значение = СтрокаТчЦветаЗаказаКлиента.Форма;  
		стрФ.Цветоделение = СтрокаТчЦветаЗаказаКлиента.Цветоделение;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ПроверитьСплошнуюФормуНаСоответствиеПараметрамЗаказа(ЗаказОбъект, СтрокаТчЦветаЗаказаКлиента, ПараметрыСплошнойФормы = Неопределено) Экспорт
	
	Если ПараметрыСплошнойФормы = Неопределено Тогда
		ПараметрыСплошнойФормы = ПолучитьПараметрыСплошнойФормы(ЗаказОбъект, СтрокаТчЦветаЗаказаКлиента.РабочийЦентр);
	КонецЕсли;
	
	// Проверим, соответствует ли форма параметрам строки
	Если НЕ СтрокаТчЦветаЗаказаКлиента.Форма.Сплошная
		ИЛИ СтрокаТчЦветаЗаказаКлиента.Форма.Ширина <> ПараметрыСплошнойФормы.Ширина  
		ИЛИ СтрокаТчЦветаЗаказаКлиента.Форма.Длина <> ПараметрыСплошнойФормы.Длина
		ИЛИ СтрокаТчЦветаЗаказаКлиента.Форма.ТолщинаПолимера <> ПараметрыСплошнойФормы.ТолщинаПолимера
		ИЛИ СтрокаТчЦветаЗаказаКлиента.Форма.Площадка <> ЗаказОбъект.Площадка
		Тогда
		// Форма не соответствует, очистим ее
		СтрокаТчЦветаЗаказаКлиента.Форма = Неопределено;
		// Удалим форму из ТЧ Формы
		МассивСтрокФормыКУдалению = ЗаказОбъект.Формы.НайтиСтроки(Новый Структура("КлючСтроки", СтрокаТчЦветаЗаказаКлиента.КлючСтроки));
		Для каждого СтрокаТЧФормы Из МассивСтрокФормыКУдалению Цикл
			ЗаказОбъект.Формы.Удалить(СтрокаТЧФормы);
		КонецЦикла;
		Возврат Ложь;
	Иначе              
		// Форма соответствует
		Возврат Истина;
	КонецЕсли; 
	
КонецФункции

Функция ЗаказСейчасНаТачпаде(Заказ) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТСИсторияРабочегоСтолаОператора.Заказ КАК Заказ,
		|	МАКСИМУМ(ТСИсторияРабочегоСтолаОператора.Период) КАК Период
		|ПОМЕСТИТЬ ВТ_ПоследняяЗаписьПоЗаказу
		|ИЗ
		|	РегистрСведений.ТСИсторияРабочегоСтолаОператора КАК ТСИсторияРабочегоСтолаОператора
		|ГДЕ
		|	ТСИсторияРабочегоСтолаОператора.Заказ = &Заказ
		|
		|СГРУППИРОВАТЬ ПО
		|	ТСИсторияРабочегоСтолаОператора.Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПоследняяЗаписьПоЗаказу.Заказ КАК Заказ,
		|	ВТ_ПоследняяЗаписьПоЗаказу.Период КАК Период,
		|	МАКСИМУМ(ТСИсторияРабочегоСтолаОператора.РабочийЦентр) КАК РабочийЦентр
		|ПОМЕСТИТЬ ВТ_ПоследняяЗаписьПоЗаказуСРабочимЦентром
		|ИЗ
		|	ВТ_ПоследняяЗаписьПоЗаказу КАК ВТ_ПоследняяЗаписьПоЗаказу
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТСИсторияРабочегоСтолаОператора КАК ТСИсторияРабочегоСтолаОператора
		|		ПО ВТ_ПоследняяЗаписьПоЗаказу.Период = ТСИсторияРабочегоСтолаОператора.Период
		|			И ВТ_ПоследняяЗаписьПоЗаказу.Заказ = ТСИсторияРабочегоСтолаОператора.Заказ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ПоследняяЗаписьПоЗаказу.Заказ,
		|	ВТ_ПоследняяЗаписьПоЗаказу.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПоследняяЗаписьПоЗаказуСРабочимЦентром.Заказ КАК Заказ,
		|	ВТ_ПоследняяЗаписьПоЗаказуСРабочимЦентром.Период КАК Период,
		|	ВТ_ПоследняяЗаписьПоЗаказуСРабочимЦентром.РабочийЦентр КАК РабочийЦентр,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТСИсторияРабочегоСтолаОператора.Заказ ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ЗаказСейчасНаМашине
		|ИЗ
		|	ВТ_ПоследняяЗаписьПоЗаказуСРабочимЦентром КАК ВТ_ПоследняяЗаписьПоЗаказуСРабочимЦентром
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТСИсторияРабочегоСтолаОператора КАК ТСИсторияРабочегоСтолаОператора
		|		ПО ВТ_ПоследняяЗаписьПоЗаказуСРабочимЦентром.Заказ <> ТСИсторияРабочегоСтолаОператора.Заказ
		|			И ВТ_ПоследняяЗаписьПоЗаказуСРабочимЦентром.Период < ТСИсторияРабочегоСтолаОператора.Период
		|			И ВТ_ПоследняяЗаписьПоЗаказуСРабочимЦентром.РабочийЦентр = ТСИсторияРабочегоСтолаОператора.РабочийЦентр
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ПоследняяЗаписьПоЗаказуСРабочимЦентром.Заказ,
		|	ВТ_ПоследняяЗаписьПоЗаказуСРабочимЦентром.Период,
		|	ВТ_ПоследняяЗаписьПоЗаказуСРабочимЦентром.РабочийЦентр";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() И ВыборкаДетальныеЗаписи.ЗаказСейчасНаМашине ТОГДА
		Возврат ВыборкаДетальныеЗаписи.РабочийЦентр;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция РассчитатьДатуПлатежа(ПартнерДокумента, ДатаДокумента) Экспорт // --> Маковеева А.Ю. 28.09.2018
											   
	СвойствоДнейОтсрочки = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "КоличествоДнейОтсрочкиОплаты");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПартнерыДополнительныеРеквизиты.Значение КАК Значение
	|ИЗ
	|	Справочник.Партнеры.ДополнительныеРеквизиты КАК ПартнерыДополнительныеРеквизиты
	|ГДЕ
	|	ПартнерыДополнительныеРеквизиты.Ссылка = &Партнер
	|	И ПартнерыДополнительныеРеквизиты.Свойство = &Свойство";
	
	Запрос.УстановитьПараметр("Партнер", 	ПартнерДокумента);
	Запрос.УстановитьПараметр("Свойство", 	СвойствоДнейОтсрочки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		СдвигДат = 0;
	Иначе
		ВыборкаДнейОтсрочки = РезультатЗапроса.Выбрать();
		Пока ВыборкаДнейОтсрочки.Следующий() Цикл
			СдвигДат = ВыборкаДнейОтсрочки.Значение;	
		КонецЦикла;
	КонецЕсли;
	
	НоваяДатаПлатежа = ДатаДокумента + СдвигДат*86400;    
	Возврат НоваяДатаПлатежа;
	
КонецФункции // <-- Маковеева А.Ю. 28.09.2018	



