Процедура ПроверитьНаличиеУпаковки(Номенклатура,Упаковка,КоличествоВУпаковке=1,ЕдиницаИзмерения=Неопределено) Экспорт //+Лико m.shenderov 24.10.2017  
	Если Номенклатура.ВидНоменклатуры.Лико_РулонныйМатериал Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЕдиницаИзмерения=Неопределено Тогда
		ЕдиницаИзмерения=Номенклатура.ЕдиницаИзмерения;
	КонецЕсли;
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УпаковкиЕдиницыИзмерения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|ГДЕ
	|	УпаковкиЕдиницыИзмерения.Владелец = &Владелец
	|	И УпаковкиЕдиницыИзмерения.Числитель = &Числитель
	|	И УпаковкиЕдиницыИзмерения.ЕдиницаИзмерения = &ЕдиницаИзмерения";
	
	Запрос.УстановитьПараметр("Владелец",Номенклатура);
	Запрос.УстановитьПараметр("Числитель",КоличествоВУпаковке);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",ЕдиницаИзмерения);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Упаковка=Выборка.Ссылка;
			Возврат;
		КонецЦикла;
	КонецЕсли;
	
	НоваяУпаковка=Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент(); 		
	НоваяУпаковка.Владелец						=	Номенклатура;		
	НоваяУпаковка.Числитель						=	КоличествоВУпаковке;
	НоваяУпаковка.Знаменатель						=	1;
	НоваяУпаковка.ЕдиницаИзмерения				=	ЕдиницаИзмерения;
	НоваяУпаковка.ЛинейныеРазмерыПредставление	=	"Безразмерная";
	НоваяУпаковка.СкладскаяГруппа					=	Справочники.СкладскиеГруппыУпаковок.НайтиПоНаименованию("Адресная");
	НоваяУпаковка.Типоразмер						=	Справочники.Лико_ПредопределенныеЗначения.ТипоразмерУпаковкиРулонногоМатериала.ЗначениеПараметра;
	НоваяУпаковка.ПоставляетсяВМногооборотнойТаре	=	Ложь;
	НоваяУпаковка.ТипИзмеряемойВеличины			=	Перечисления.ТипыИзмеряемыхВеличин.Упаковка;
	НоваяУпаковка.ТипУпаковки						=	Перечисления.ТипыУпаковокНоменклатуры.Конечная; 		
	НоваяУпаковка.Наименование     				=	СформироватьНаименование(ЕдиницаИзмерения,НоваяУпаковка.Числитель,НоваяУпаковка.Знаменатель,НоваяУпаковка.Владелец.ЕдиницаИзмерения); 
	
	НоваяУпаковка.Записать();	
	Упаковка=НоваяУпаковка.Ссылка;
	
	
	УстановитьПривилегированныйРежим(Ложь);
	
	
КонецПроцедуры  //-Лико m.shenderov 24.10.2017


Функция СформироватьНаименование(ВидУпаковки, Числитель, Знаменатель, ЕдиницаИзмеренияВладельца) Экспорт
	Возврат СокрЛП(СокрЛП(ВидУпаковки) + " (" + Формат(Числитель / Знаменатель,"ЧРД=.") + " " + СокрЛП(ЕдиницаИзмеренияВладельца) + ")");
	
КонецФункции



Функция ОбъектНоменклатурыДляПечати(Данные) Экспорт  //+Лико m.shenderov 30.12.2017
	Если ЗначениеЗаполнено(Данные.Серия.ЯССМ_ОбъектНоменклатуры) Тогда
		Возврат  Данные.Серия.ЯССМ_ОбъектНоменклатуры;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ЯССМ_ОбъектыНоменклатуры.Ссылка) КАК ОбъектНоменклатуры,
		|	СУММА(1) КАК Количество
		|ИЗ
		|	Справочник.ЯССМ_ОбъектыНоменклатуры КАК ЯССМ_ОбъектыНоменклатуры
		|ГДЕ
		|	ЯССМ_ОбъектыНоменклатуры.Номенклатура = &Номенклатура
		|	И НЕ ЯССМ_ОбъектыНоменклатуры.ПометкаУдаления";
		Запрос.УстановитьПараметр("Номенклатура",Данные.Номенклатура );
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() и Данные.Номенклатура.ВидНоменклатуры.ИспользоватьСерии=Ложь ТОгда
			Упаковка=Неопределено;
			ПроверитьНаличиеУпаковки(Данные.Номенклатура,Упаковка);
			Структура = Новый Структура;
			Структура.Вставить("Номенклатура",Данные.Номенклатура);
			Структура.Вставить("Уникальный",Ложь);
			Структура.Вставить("Количество",1);
			Структура.Вставить("Упаковка",Упаковка);
			Возврат Справочники.ЯССМ_ОбъектыНоменклатуры.СоздатьОбъектНоменклатуры(Структура);	 
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Количество>1 Тогда
				Возврат Неопределено;
			Иначе
				Возврат Выборка.ОбъектНоменклатуры;
			КонецЕсли;
			
			
		КонецЦикла; 
		
	КонецЕсли;
	
КонецФункции //-Лико m.shenderov 30.12.2017 


