Процедура ОбработкаШК_Растарки(ДанныеШК, Результат)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОрганизацииДополнительныеРеквизиты.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Организация
	|ИЗ
	|	Справочник.Организации.ДополнительныеРеквизиты КАК ОрганизацииДополнительныеРеквизиты
	|ГДЕ
	|	ОрганизацииДополнительныеРеквизиты.Свойство.Имя = ""ПрефиксЛатиницей_36a09ad955f14888a74852070619571d""
	|	И (ВЫРАЗИТЬ(ОрганизацииДополнительныеРеквизиты.Значение КАК СТРОКА(2))) = &Префикс
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Организация.Ссылка КАК Организация,
	|	МАКСИМУМ(ВТ_Организация.Ссылка.Префикс + ""00-"" + &НомерДокумента) КАК ПеремещениеПаллетаНомер,
	|	Лико_ПеремещениеПаллета.Ссылка КАК ПеремещениеПаллета
	|ПОМЕСТИТЬ ВТ_ОрганизацияСПеремещением
	|ИЗ
	|	ВТ_Организация КАК ВТ_Организация
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лико_ПеремещениеПаллета КАК Лико_ПеремещениеПаллета
	|		ПО (ВТ_Организация.Ссылка.Префикс + ""00-"" + &НомерДокумента = Лико_ПеремещениеПаллета.Номер)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Организация.Ссылка,
	|	Лико_ПеремещениеПаллета.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОрганизацияСПеремещением.Организация КАК Организация,
	|	ВТ_ОрганизацияСПеремещением.ПеремещениеПаллета КАК ПеремещениеПаллета,
	|	ВТ_ОрганизацияСПеремещением.ПеремещениеПаллетаНомер КАК ПеремещениеПаллетаНомер,
	|	МАКСИМУМ(Лико_ПеремещениеПаллетаЗаказыНаРастарку.Характеристика.Лико_ЗаказНоменклатуры) КАК РастариваемыйЗаказ
	|ИЗ
	|	ВТ_ОрганизацияСПеремещением КАК ВТ_ОрганизацияСПеремещением
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лико_ПеремещениеПаллета.ЗаказыНаРастарку КАК Лико_ПеремещениеПаллетаЗаказыНаРастарку
	|		ПО (Лико_ПеремещениеПаллетаЗаказыНаРастарку.НомерЦепочки = &НомерЦепочки)
	|			И (Лико_ПеремещениеПаллетаЗаказыНаРастарку.ЭтоИсходнаяСтрока)
	|			И ВТ_ОрганизацияСПеремещением.ПеремещениеПаллета = Лико_ПеремещениеПаллетаЗаказыНаРастарку.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОрганизацияСПеремещением.Организация,
	|	ВТ_ОрганизацияСПеремещением.ПеремещениеПаллета,
	|	ВТ_ОрганизацияСПеремещением.ПеремещениеПаллетаНомер";
	
	Запрос.УстановитьПараметр("Префикс", ДанныеШК.ПрефиксОрганизации);
	Запрос.УстановитьПараметр("НомерДокумента", ДанныеШК.НомерДокумента);
