Процедура ПровестиЗаказКлиентаВФоне(ЗаказКлиентаСсылка, МассивДопСвойств) Экспорт // --> Начало Лико Ефимов ЕВВ 04.12.2023

	ЗаказОбъект = ЗаказКлиентаСсылка.ПолучитьОбъект();
	Для каждого ТекСтруктураСвойства из МассивДопСвойств Цикл
		ЗаказОбъект.ДополнительныеСвойства.Вставить(ТекСтруктураСвойства.Имя, ТекСтруктураСвойства.Значение);
	КонецЦикла;

	Попытка
		ЗаказОбъект.Записать(?(ЗаказОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись), РежимПроведенияДокумента.Неоперативный);
	Исключение
		Лико_Планирование.ОтправитьПисьмо("" + ЗаказОбъект + ": " + ОписаниеОшибки(), "Не провелся заказ в фоне", "vefimov@okil.ru",,,,,, Ложь);
	КонецПопытки;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 04.12.2023

Процедура ОчиститьДатуУпрощенногоПроведенияВФормированииПаллета(ФормированиеПаллетаСсылка, ФормированиеПаллетаОбъект = Неопределено) Экспорт // --> Начало Лико Ефимов ЕВВ 23.11.2023

	Если НЕ ЗначениеЗаполнено(ФормированиеПаллетаСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ФормированиеПаллетаОбъект = Неопределено Тогда
		ФормированиеПаллетаОбъект = ФормированиеПаллетаСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	ДокументЗаблокирован = Ложь;
	ДатаНачалаБлокировки = ТекущаяДата();
	Попытка
		ФормированиеПаллетаОбъект.Заблокировать();
		ДокументЗаблокирован = Истина;
	Исключение
		//Лико_Планирование.ОтправитьПисьмо("Ошибка при блокировке (" + ДатаНачалаБлокировки + " - " + ТекущаяДата() + ") " + ФормированиеПаллетаСсылка + ": " + ОписаниеОшибки(), "Допроведение формирований паллет", "vefimov@okil.ru",,,,,, Ложь);
		Возврат;	
	КонецПопытки;
	Если ДокументЗаблокирован Тогда
		// Корректировок не осталось, можно убрать ДатаУпрощенногоПроведения
		ФормированиеПаллетаОбъект.ДатаУпрощенногоПроведения = Неопределено;
		ФормированиеПаллетаОбъект.ОбменДанными.Загрузка = Истина;
		Попытка
			ФормированиеПаллетаОбъект.Записать();
			ФормированиеПаллетаОбъект.Разблокировать();
		Исключение
			Лико_Планирование.ОтправитьПисьмо("Ошибка при очистке ДатаУпрощенногоПроведения " + ФормированиеПаллетаСсылка + ": " +  + ОписаниеОшибки(), "Допроведение формирований паллет", "vefimov@okil.ru",,,,,, Ложь);
			Возврат;	
		КонецПопытки; 
	КонецЕсли;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 23.11.2023

Процедура ОчиститьДатуОбработкиВСвязяхСТиповымиДокументамиПриОшибке(ПараметрыВыборки) // --> Начало Лико Ефимов ЕВВ 24.11.2023

	МенеджерЗаписи = РегистрыСведений.Лико_СвязиСТиповымиДокументами.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ПараметрыВыборки);
	МенеджерЗаписи.Документ = ПараметрыВыборки.ФормированиеПаллета;
	МенеджерЗаписи.ТиповойДокумент = ПараметрыВыборки.КорректировкаРегистров;
	МенеджерЗаписи.Прочитать(); 
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.ДатаНачалаОбработки = Неопределено;
		Попытка
			МенеджерЗаписи.Записать();
		Исключение
			Лико_Планирование.ОтправитьПисьмо("Ошибка при очистке ДатаНачалаОбработки " + ПараметрыВыборки.ФормированиеПаллета + ": " + ОписаниеОшибки(), "Допроведение формирований паллет", "vefimov@okil.ru",,,,,, Ложь);
			Возврат;
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 24.11.2023

Процедура ЗапуститьПерепроведениеЗаказаВФоне(ЗаказСсылка) Экспорт
	
	ИмяМетода = "Лико_Дополнительно.ПровестиЗаказКлиентаВФоне";
	
	ПараметрыПроцедуры = Новый Массив();
	ПараметрыПроцедуры.Добавить(ЗаказСсылка); 
	МассивДопСвойств = Новый Массив;
	МассивДопСвойств.Добавить(Новый Структура("Имя,Значение", "Лико_ЗаполнитьВыработку", Истина));
	ПараметрыПроцедуры.Добавить(МассивДопСвойств); 
	
	ПараметрыЗадания = Новый Массив();
	ПараметрыЗадания.Добавить(ИмяМетода);
	ПараметрыЗадания.Добавить(ПараметрыПроцедуры);
	
	КлючЗадания = "ПровестиЗаказКлиентаВФоне" + Строка(ЗаказСсылка.УникальныйИдентификатор());
	
	НаименованиеЗадания = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Проведение заказа клиента в фоне'"),
	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Представление"));
	
	Попытка
		ФоновыеЗадания.Выполнить(
		"ОбщегоНазначения.ВыполнитьМетодКонфигурации",
		ПараметрыЗадания,
		КлючЗадания,
		НаименованиеЗадания);
	Исключение
	КонецПопытки; 
	
КонецПроцедуры

