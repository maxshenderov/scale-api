//Функция получает организацию по переданному контрагенту (у организации есть доп. реквизит "Контрагент организации").
//
//Параметры:
//  Контрагент 	- СправочникСсылка.Контрагенты 	- Ссылка на контрагента.
//
//  Возвращаемое значение:
//     СправочникСсылка.Организации или Неопределено. 
//
Функция ПолучитьОрганизациюПоКонтрагенту(Контрагент) Экспорт // --> Начало Лико Ефимов ЕВВ 27.07.2017
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОрганизацииДополнительныеРеквизиты.Ссылка
	|ИЗ
	|	Справочник.Организации.ДополнительныеРеквизиты КАК ОрганизацииДополнительныеРеквизиты
	|ГДЕ
	|	ОрганизацииДополнительныеРеквизиты.Свойство = &ДопРеквизит
	|	И ОрганизацииДополнительныеРеквизиты.Значение = &Контрагент
	|	И НЕ ОрганизацииДополнительныеРеквизиты.Ссылка.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОрганизацииДополнительныеРеквизиты.Ссылка";
	
	Запрос.УстановитьПараметр("ДопРеквизит", Справочники.Лико_ПредопределенныеЗначения["ДопРеквизитОрганизацииКонтрагентОрганизации"].ЗначениеПараметра);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
