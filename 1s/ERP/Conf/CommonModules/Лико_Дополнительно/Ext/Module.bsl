	НоваяСтрока.Номенклатура = Номенклатура;
	НоваяСтрока.Серия = Серия;
	НоваяСтрока.Мест = 1;
	НоваяСтрока.Затреб = 0;
	НоваяСтрока.Паллет = Неопределено;
	НоваяСтрока.АдресХранения = Неопределено;
	НоваяСтрока.Количество = Серия.Лико_КоличествоВУпаковке;
	Если НайденныеСтроки.Количество() = 0 Тогда
