Функция ПолучитьМассивДоступныхЗаказовПользователя(МассивПроверяемыхЗаказов, Пользователь = Неопределено, МассивПлощадок = Неопределено) Экспорт // --> Начало Лико Ефимов ЕВВ 25.12.2019
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(Пользователь) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_НастройкаДоступаКЗаказу КАК Лико_НастройкаДоступаКЗаказу
		|		ПО (ВЫБОР
		|				КОГДА Лико_НастройкаДоступаКЗаказу.ДоступныЗаказыМенеджера ССЫЛКА Справочник.БизнесРегионы
		|					ТОГДА ВЫБОР
		|							КОГДА Лико_НастройкаДоступаКЗаказу.ДоступныЗаказыМенеджера = ЗНАЧЕНИЕ(Справочник.БизнесРегионы.ВсеРегионы)
		|								ТОГДА ИСТИНА
		|							ИНАЧЕ Лико_НастройкаДоступаКЗаказу.ДоступныЗаказыМенеджера = ЗаказКлиента.Регион
		|						КОНЕЦ
		|				КОГДА Лико_НастройкаДоступаКЗаказу.ДоступныЗаказыМенеджера ССЫЛКА Перечисление.Лико_ТипыЗаказов
		|					ТОГДА ЗаказКлиента.ТипЗаказа = Лико_НастройкаДоступаКЗаказу.ДоступныЗаказыМенеджера
		|				ИНАЧЕ ВЫБОР
		|						КОГДА Лико_НастройкаДоступаКЗаказу.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
		|							ТОГДА ЗаказКлиента.Менеджер = Лико_НастройкаДоступаКЗаказу.ДоступныЗаказыМенеджера
		|						ИНАЧЕ ЗаказКлиента.Менеджер = Лико_НастройкаДоступаКЗаказу.ДоступныЗаказыМенеджера
		|								И ЗаказКлиента.Партнер = Лико_НастройкаДоступаКЗаказу.Партнер
		|					КОНЕЦ
		|			КОНЕЦ)
		|ГДЕ
		|	ЗаказКлиента.Ссылка В(&МассивЗаказов)
		|	И ВЫБОР
		|			КОГДА &ОтбиратьПоПлощадке
		|				ТОГДА ЗаказКлиента.Площадка = &МассивПлощадок
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И Лико_НастройкаДоступаКЗаказу.Менеджер = &Пользователь";
		
		Запрос.УстановитьПараметр("ОтбиратьПоПлощадке", ЗначениеЗаполнено(МассивПлощадок));
		Запрос.УстановитьПараметр("МассивПлощадок", МассивПлощадок);
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
		Запрос.УстановитьПараметр("МассивЗаказов", МассивПроверяемыхЗаказов);
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	ИначеЕсли ЗначениеЗаполнено(МассивПлощадок) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Ссылка В(&МассивЗаказов)
		|	И ЗаказКлиента.Площадка В(&МассивПлощадок)";
		
		Запрос.УстановитьПараметр("МассивПлощадок", МассивПлощадок);
		Запрос.УстановитьПараметр("МассивЗаказов", МассивПроверяемыхЗаказов);
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	Иначе
		
		Возврат Новый Массив;
		
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 25.12.2019



