	|	ВТ.Количество * &ТекстЗапросаВесНоменклатуры,
	|	ВТ.Номенклатура.Код";

	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	Запрос.УстановитьПараметр("Тип", Тип);
	Запрос.УстановитьПараметр("Реализация", Реализация);
	Запрос.Текст = СтрЗаменить(
	Запрос.Текст, 
	"&ТекстЗапросаВесНоменклатуры",
	Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаВесУпаковки(
	"ВТ.Номенклатура.ЕдиницаИзмерения",
	"ВТ.Номенклатура"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяПоляХарактеристика", ИмяПоляХарактеристика);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	КоличествоРезультатов = РезультатыЗапроса.Количество();

	Если Тип <> "СчетНаПредоплату" И Реализация[ИмяПоляСклад].ИспользоватьОрдернуюСхемуПриОтгрузке И ТипЗнч(Реализация) <> Тип("ДокументСсылка.ПередачаТоваровМеждуОрганизациями") Тогда
		// данные из серий
		Если ВЗаказахМогутБытьОдинаковыеКодыЭтикетокЗаказчикаИлиНомераПоставки Тогда
			// По коду и номеру поставки сгруппировано
			Таблица = РезультатыЗапроса[КоличествоРезультатов-3].Выгрузить();
		Иначе
			// По коду и номеру поставки взят МАКСИМУМ из серий
			Таблица = РезультатыЗапроса[КоличествоРезультатов-2].Выгрузить();
		КонецЕсли;
	Иначе
		// данные из заказов
		Таблица = РезультатыЗапроса[КоличествоРезультатов-1].Выгрузить();
	КонецЕсли;
	Если Реализация = Неопределено Тогда
		ВыводитьВесВТОРГ12 = Ложь;
	Иначе
		ВыводитьВесВТОРГ12 = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(,Реализация[ИмяПоляСклад],"ВыводитьВесВТОРГ12", Ложь);
	КонецЕсли;

	Если СНомеромКонтракта Тогда
		// нужны и код этикетки заказчика и номер поставки
	ИначеЕсли СКодомЭтикеткиЗаказчикаТек Тогда
		// номер контракта не стоит, код этикетки стоит
		Таблица.Свернуть("Ссылка,НомерСтроки,Номенклатура,Характеристика,КодЭтикеткиЗаказчика,НоменклатураКод,МинимальнаяДатаУпаковки,МаксимальнаяДатаУпаковки,ЧестныйЗнак,Намотка", "ВесКоробок,КоличествоКоробок,КоличествоВУпаковке");
		Таблица.Колонки.Добавить("NКонтракта", Новый ОписаниеТипов("СправочникСсылка.Лико_НомераПоставок"));
	Иначе
		Таблица.Свернуть("Ссылка,НомерСтроки,Номенклатура,Характеристика,НоменклатураКод,МинимальнаяДатаУпаковки,МаксимальнаяДатаУпаковки,ЧестныйЗнак,Намотка", "ВесКоробок,КоличествоКоробок,КоличествоВУпаковке");
		Таблица.Колонки.Добавить("NКонтракта", Новый ОписаниеТипов("СправочникСсылка.Лико_НомераПоставок"));
		Таблица.Колонки.Добавить("КодЭтикеткиЗаказчика", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(40)));
	КонецЕсли;
	ТЗ.Колонки.Добавить("NКонтракта", Новый ОписаниеТипов("СправочникСсылка.Лико_НомераПоставок"));
	ТЗ.Колонки.Добавить("КодЭтикеткиЗаказчика", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(40)));
	ТЗ.Колонки.Добавить("ЧестныйЗнак", Новый ОписаниеТипов("СправочникСсылка.Лико_ЧестныйЗнак"));
	ТЗ.Колонки.Добавить("Намотка", Новый ОписаниеТипов("СправочникСсылка.Лико_Намотка"));
	Если ТЗ.Колонки.Найти("КоличествоМест") = Неопределено Тогда
		ТЗ.Колонки.Добавить("КоличествоМест", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,3)));
	КонецЕсли;
	Если ТЗ.Колонки.Найти("МассаБрутто") = Неопределено Тогда
		ТЗ.Колонки.Добавить("МассаБрутто", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,3)));
	КонецЕсли;
	Если ТЗ.Колонки.Найти("МассаНетто") = Неопределено Тогда
		ТЗ.Колонки.Добавить("МассаНетто", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,3)));
	КонецЕсли;
	Если ТЗ.Колонки.Найти("КоличествоВОдномМесте") = Неопределено Тогда
		ТЗ.Колонки.Добавить("КоличествоВОдномМесте", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,3)));
	КонецЕсли;
	Если ТЗ.Колонки.Найти("СуммаБезНДС") = Неопределено Тогда
		ТЗ.Колонки.Добавить("СуммаБезНДС", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,3)));
	КонецЕсли;
	Если ТЗ.Колонки.Найти("СуммаСНДС") = Неопределено Тогда
		ТЗ.Колонки.Добавить("СуммаСНДС", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,3)));
	КонецЕсли;
	Если ТЗ.Колонки.Найти("Сумма") = Неопределено Тогда
		ТЗ.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,3)));
	КонецЕсли;
	Если ТЗ.Колонки.Найти("СуммаБезСкидки") = Неопределено Тогда
		ТЗ.Колонки.Добавить("СуммаБезСкидки", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,3)));
	КонецЕсли;
	Если ТЗ.Колонки.Найти("СуммаСкидки") = Неопределено Тогда
		ТЗ.Колонки.Добавить("СуммаСкидки", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,3)));
	КонецЕсли;
	Если ТЗ.Колонки.Найти("МинимальнаяДатаУпаковки") = Неопределено Тогда
		ТЗ.Колонки.Добавить("МинимальнаяДатаУпаковки", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	КонецЕсли;
	Если ТЗ.Колонки.Найти("МаксимальнаяДатаУпаковки") = Неопределено Тогда
		ТЗ.Колонки.Добавить("МаксимальнаяДатаУпаковки", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	КонецЕсли;

	Отбор = Новый Структура("Ссылка,НомерСтроки,Номенклатура,Характеристика");
	КоличествоСтрокТЗ = ТЗ.Количество();

	// <-- Начало Лико Ефимов ЕВВ 09.09.2024
	ТаблицаКоробок = Неопределено;
	Если ТипЗнч(Реализация) = Тип("ДокументСсылка.РеализацияТоваровУслуг") И НЕ Реализация[ИмяПоляСклад].ИспользоватьОрдернуюСхемуПриОтгрузке Тогда
		ТаблицаКоробок = Лико_Дополнительно.ПолучитьТаблицуКоробокПоНакладной(Реализация);
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 09.09.2024

	сч = 0;
	Пока сч <= КоличествоСтрокТЗ-1 Цикл
		Строка = ТЗ[сч];
		сч = сч + 1;
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		Отбор.Характеристика = Строка[ИмяПоляХарактеристика];
		НайденныеСтроки = Таблица.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		ИначеЕсли НайденныеСтроки.Количество() = 1 Тогда
			// <-- Начало Лико Ефимов ЕВВ 09.09.2024
			//НайденнаяСтрока = НайденныеСтроки[0];
			// Попробуем найти данные из расходного ордера для отгрузок с типом РеализацияКлиентуЧерезСкладРегиона 
			НайденнаяСтрока = Неопределено;
			Если ТаблицаКоробок <> Неопределено И ТаблицаКоробок.Количество() > 0 Тогда
				ОтборТаблицыКоробок = Новый Структура("Номенклатура,Характеристика");
				ЗаполнитьЗначенияСвойств(ОтборТаблицыКоробок, Строка);
				НайденныеСтрокиТаблицыКоробок = ТаблицаКоробок.НайтиСтроки(ОтборТаблицыКоробок);
				Если НайденныеСтрокиТаблицыКоробок.Количество() = 1 Тогда
					НайденнаяСтрока = НайденныеСтрокиТаблицыКоробок[0];
				КонецЕсли;
			КонецЕсли;
			Если НайденнаяСтрока = Неопределено Тогда
				НайденнаяСтрока = НайденныеСтроки[0];
			КонецЕсли;
			// <-- Конец Лико Ефимов ЕВВ 09.09.2024
			Строка.NКонтракта = НайденнаяСтрока.NКонтракта;
			Строка.МинимальнаяДатаУпаковки = НайденнаяСтрока.МинимальнаяДатаУпаковки;
			Строка.МаксимальнаяДатаУпаковки = НайденнаяСтрока.МаксимальнаяДатаУпаковки;
			Строка.КодЭтикеткиЗаказчика = СокрЛП(НайденнаяСтрока.КодЭтикеткиЗаказчика);
			Если МенятьКодЭтикеткиЗаказчикаНаКодНоменклатурыПриОтсутствии И НЕ ЗначениеЗаполнено(Строка.КодЭтикеткиЗаказчика) И НЕ СвернутьПоНаименованиюНоменклатуры Тогда
				Строка.КодЭтикеткиЗаказчика = НайденнаяСтрока.НоменклатураКод;
			КонецЕсли; 
			Строка.ЧестныйЗнак = НайденнаяСтрока.ЧестныйЗнак;
			Строка.Намотка = НайденнаяСтрока.Намотка;
			Строка.КоличествоМест = НайденнаяСтрока.КоличествоКоробок;
			Если ВыводитьВесВТОРГ12 Тогда
				Строка.МассаБрутто = НайденнаяСтрока.ВесКоробок;
				Строка.МассаНетто = НайденнаяСтрока.ВесКоробок;
			Иначе
				Строка.МассаБрутто = 0;
				Строка.МассаНетто = 0;
			КонецЕсли;
		Иначе
			// Тут сложно: придется одну строку делить на несколько, т.е. делить пропорционально количество и все суммы
			а=0;
			КоличествоСтрок = НайденныеСтроки.Количество();
			ИндексСтрокиТЗ = ТЗ.Индекс(Строка);
			КоличествоВУпаковкеИтог = 0;
			Для каждого НайденнаяСтрока из НайденныеСтроки Цикл
				КоличествоВУпаковкеИтог = КоличествоВУпаковкеИтог + НайденнаяСтрока.КоличествоВУпаковке;
			КонецЦикла;
			КоличествоОсталосьРаспределить = Строка.Количество;
			СуммаБезНДСОсталосьРаспределить = Строка.СуммаБезНДС;
			СуммаНДСОсталосьРаспределить = Строка.СуммаНДС;
			СуммаСНДСОсталосьРаспределить = Строка.СуммаСНДС;
			СуммаОсталосьРаспределить = Строка.Сумма;
			СуммаБезСкидкиОсталосьРаспределить = Строка.СуммаБезСкидки;
			СуммаСкидкиОсталосьРаспределить = Строка.СуммаСкидки;
			Для каждого НайденнаяСтрока из НайденныеСтроки Цикл
				Пропорция = НайденнаяСтрока.КоличествоВУпаковке / КоличествоВУпаковкеИтог;
				Если НайденнаяСтрока = НайденныеСтроки[КоличествоСтрок-1] Тогда
					// Это последняя строка, будем править исходную строку
					Строка.Количество = КоличествоОсталосьРаспределить;
					Строка.КоличествоМест = НайденнаяСтрока.КоличествоКоробок;
					Строка.МассаБрутто = НайденнаяСтрока.ВесКоробок;
					Строка.МассаНетто = НайденнаяСтрока.ВесКоробок;
					Строка.СуммаБезНДС = СуммаБезНДСОсталосьРаспределить;
					Строка.СуммаНДС = СуммаНДСОсталосьРаспределить;
					Строка.СуммаСНДС = СуммаСНДСОсталосьРаспределить;
					Строка.Сумма = СуммаОсталосьРаспределить;
					Строка.СуммаБезСкидки = СуммаБезСкидкиОсталосьРаспределить;
					Строка.СуммаСкидки = СуммаСкидкиОсталосьРаспределить;
					Строка.NКонтракта = НайденнаяСтрока.NКонтракта;
					Строка.КодЭтикеткиЗаказчика = СокрЛП(НайденнаяСтрока.КодЭтикеткиЗаказчика);
					Строка.ЧестныйЗнак = СокрЛП(НайденнаяСтрока.ЧестныйЗнак);
					Строка.Намотка = НайденнаяСтрока.Намотка;
					Строка.МинимальнаяДатаУпаковки = НайденнаяСтрока.МинимальнаяДатаУпаковки;
					Строка.МаксимальнаяДатаУпаковки = НайденнаяСтрока.МаксимальнаяДатаУпаковки;
					Если МенятьКодЭтикеткиЗаказчикаНаКодНоменклатурыПриОтсутствии И НЕ ЗначениеЗаполнено(Строка.КодЭтикеткиЗаказчика) Тогда
						Строка.КодЭтикеткиЗаказчика = НайденнаяСтрока.НоменклатураКод;
					КонецЕсли;
				Иначе
					НоваяСтрокаТЗ = ТЗ.Вставить(ИндексСтрокиТЗ);
					сч = сч + 1;
					КоличествоСтрокТЗ = КоличествоСтрокТЗ + 1;
					ЗаполнитьЗначенияСвойств(НоваяСтрокаТЗ, Строка);
					НоваяСтрокаТЗ.Количество = Окр(Пропорция * Строка.Количество, 3);
					НоваяСтрокаТЗ.КоличествоМест = НайденнаяСтрока.КоличествоКоробок;
					НоваяСтрокаТЗ.МассаБрутто = НайденнаяСтрока.ВесКоробок;
					НоваяСтрокаТЗ.МассаНетто = НайденнаяСтрока.ВесКоробок;
					НоваяСтрокаТЗ.СуммаБезНДС = Окр(Пропорция * Строка.СуммаБезНДС, 2);
					НоваяСтрокаТЗ.СуммаНДС = Окр(Пропорция * Строка.СуммаНДС, 2);
					НоваяСтрокаТЗ.СуммаСНДС = Окр(Пропорция * Строка.СуммаСНДС, 2);
					НоваяСтрокаТЗ.Сумма = Окр(Пропорция * Строка.Сумма, 2);
					НоваяСтрокаТЗ.СуммаБезСкидки = Окр(Пропорция * Строка.СуммаБезСкидки, 2);
					НоваяСтрокаТЗ.СуммаСкидки = Окр(Пропорция * Строка.СуммаСкидки, 2);
					НоваяСтрокаТЗ.NКонтракта = НайденнаяСтрока.NКонтракта;
					НоваяСтрокаТЗ.КодЭтикеткиЗаказчика = СокрЛП(НайденнаяСтрока.КодЭтикеткиЗаказчика);
					НоваяСтрокаТЗ.ЧестныйЗнак = СокрЛП(НайденнаяСтрока.ЧестныйЗнак);
					НоваяСтрокаТЗ.Намотка = НайденнаяСтрока.Намотка;
					НоваяСтрокаТЗ.МинимальнаяДатаУпаковки = НайденнаяСтрока.МинимальнаяДатаУпаковки;
					НоваяСтрокаТЗ.МаксимальнаяДатаУпаковки = НайденнаяСтрока.МаксимальнаяДатаУпаковки;
					Если МенятьКодЭтикеткиЗаказчикаНаКодНоменклатурыПриОтсутствии И НЕ ЗначениеЗаполнено(НоваяСтрокаТЗ.КодЭтикеткиЗаказчика) Тогда
						НоваяСтрокаТЗ.КодЭтикеткиЗаказчика = НайденнаяСтрока.НоменклатураКод;
					КонецЕсли;

					КоличествоОсталосьРаспределить = КоличествоОсталосьРаспределить - НоваяСтрокаТЗ.Количество;
					СуммаБезНДСОсталосьРаспределить = СуммаБезНДСОсталосьРаспределить - НоваяСтрокаТЗ.СуммаБезНДС;
					СуммаНДСОсталосьРаспределить = СуммаНДСОсталосьРаспределить - НоваяСтрокаТЗ.СуммаНДС;
					СуммаСНДСОсталосьРаспределить = СуммаСНДСОсталосьРаспределить - НоваяСтрокаТЗ.СуммаСНДС;
					СуммаОсталосьРаспределить = СуммаОсталосьРаспределить - НоваяСтрокаТЗ.Сумма;
					СуммаБезСкидкиОсталосьРаспределить = СуммаБезСкидкиОсталосьРаспределить - НоваяСтрокаТЗ.СуммаБезСкидки;
					СуммаСкидкиОсталосьРаспределить = СуммаСкидкиОсталосьРаспределить - НоваяСтрокаТЗ.СуммаСкидки;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Если ТЗ.Колонки.Найти("ВидЦеныИсполнителя") <> Неопределено Тогда
		ТЗ.Колонки.Удалить("ВидЦеныИсполнителя");
		ТЗ.Колонки.Добавить("ВидЦеныИсполнителя", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	КонецЕсли;
	//Если ТЗ.Колонки.Найти("КодТНВЭД") <> Неопределено Тогда
	//	ТЗ.Колонки.Удалить("КодТНВЭД");
	//	ТЗ.Колонки.Добавить("КодТНВЭД", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	//КонецЕсли;
	// Проставим номер строки
	НомерСтроки = 0;
	Для каждого Строка из ТЗ Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			НомерСтроки = 0;
			Продолжить;
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
		Строка.НомерСтроки = НомерСтроки;
		Строка.КоличествоВОдномМесте = ?(ЗначениеЗаполнено(Строка.КоличествоМест), Строка.Количество / Строка.КоличествоМест, 0);
	КонецЦикла;
	
	Если ТипЗнч(РезультатПоТабличнойЧастиИлиТз) = Тип("ТаблицаЗначений") Тогда
		РезультатПоТабличнойЧастиИлиТз = ТЗ;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	*
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|ГДЕ
		|	НЕ ТЗ.Номенклатура ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	*
		|ИЗ
		|	ВТ КАК ВТ
		|";
		Если Тип = "СчетФактура" Тогда
			Запрос.Текст = Запрос.Текст + "
			|
			|УПОРЯДОЧИТЬ ПО ВТ.ЕдиницаИзмерения УБЫВ, ВТ.НомерСтроки
			|"
		КонецЕсли;
		Если НЕ (Тип = "СчетНаОплату" ИЛИ Тип = "СчетНаПредоплату") Тогда
			Запрос.Текст = Запрос.Текст + "
			|ИТОГИ ПО
			|	" + ИтоговоеПоле;
		КонецЕсли;

		Запрос.УстановитьПараметр("ТЗ", ТЗ);
		РезультатПоТабличнойЧастиИлиТз = Запрос.Выполнить();	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьАдресСклада(Склад) Экспорт // --> Начало Лико Ефимов ЕВВ 28.02.2018
	
	Структура = Новый Структура("Представление,ЗначенияПолей", "", "");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СкладыКонтактнаяИнформация.Представление КАК Представление,
	|	СкладыКонтактнаяИнформация.ЗначенияПолей КАК ЗначенияПолей
	|ИЗ
	|	Справочник.Склады.КонтактнаяИнформация КАК СкладыКонтактнаяИнформация
	|ГДЕ
	|	СкладыКонтактнаяИнформация.Ссылка = &Склад
	|	И СкладыКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресСклада)";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Структура, ВыборкаДетальныеЗаписи);
	КонецЕсли;
	Возврат Структура;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 28.02.2018

Процедура ОчиститьРегистрРезервыТоваровОрганизацийПоРегистратору(Ссылка) Экспорт // --> Начало Лико Ефимов ЕВВ 09.04.2018
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	
	ТипРегистра = "Накопления";
	ИмяРегистра = "РезервыТоваровОрганизаций";
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Регистр.Регистратор КАК Регистратор
	|ИЗ
	|	Регистр" + ТипРегистра + "." + ИмяРегистра + " КАК Регистр
	|ГДЕ
	|	ВЫБОР КОГДА &Регистратор = НЕОПРЕДЕЛЕНО ТОГДА НЕ Регистр.Регистратор.Проведен ИНАЧЕ Регистр.Регистратор = &Регистратор КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	Регистр.Регистратор";
	
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	НаборЗаписей = Неопределено;
	
	ВЫПОЛНИТЬ("НаборЗаписей = Регистры" + ТипРегистра + "[""" + ИмяРегистра + """].СоздатьНаборЗаписей()");
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	счЗаписей = 0;
	счДокументов = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Регистратор);
		
		НаборЗаписей.Прочитать();
		
		счЗаписей = счЗаписей + НаборЗаписей.количество();
		НаборЗаписей.Очистить();
		
		НаборЗаписей.Записать();
		счДокументов = счДокументов + 1;
	КонецЦикла;
	//Сообщить("Удалено " + счЗаписей + " записей по " + счДокументов + " документам");
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 09.04.2018

Функция ВернутьНаименованиеМатериалаИлиАльтернативноеНаименованиеПриНеобходимости(Материал, Заказ, Клиент, МестоВызова = "Сертификат") Экспорт // --> Начало Лико Ефимов ЕВВ 11.04.2018
	
	//Начало изменений Иванова А.В. 20211128  
	Если ЗначениеЗаполнено (Клиент) Тогда 
	     Если Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Клиент, "СтикерНеОтображатьМатериал", Ложь) Тогда 
		     Возврат "";  
		 КонецЕсли
	КонецЕсли;
	
	Если Заказ.НеПоказыватьКлиентуМатериал Тогда 
	    Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Материал) = Тип("СправочникСсылка.Номенклатура") Тогда
		ЦеноваяГруппа = Материал.ЦеноваяГруппа;
	ИначеЕсли ТипЗнч(Материал) = Тип("СправочникСсылка.ЦеновыеГруппы") Тогда
		ЦеноваяГруппа = Материал;
	Иначе
		Возврат "";
	КонецЕсли;
	
	Если Заказ.ПоказыватьКлиентуМатериалИзЗаказа Тогда 
