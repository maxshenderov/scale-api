Процедура Лико_ДополнитьРезультатПоТЧДополнительнымиДанными(РезультатПоТабличнойЧастиИлиТз, МассивОбъектов = Неопределено, СНомеромКонтракта = Ложь, СКодомЭтикеткиЗаказчика = Ложь, СвернутьПоНаименованиюНоменклатуры = Ложь, ВЗаказахМогутБытьОдинаковыеКодыЭтикетокЗаказчикаИлиНомераПоставки = Ложь, МенятьКодЭтикеткиЗаказчикаНаКодНоменклатурыПриОтсутствии = Истина) Экспорт // --> Начало Лико Ефимов ЕВВ 11.02.2018

	// СКодомЭтикеткиЗаказчика нужен всегда
	//СКодомЭтикеткиЗаказчикаТек = ?(СКодомЭтикеткиЗаказчика, Истина, Ложь);
	СКодомЭтикеткиЗаказчикаТек = Истина;
	
	Если ТипЗнч(РезультатПоТабличнойЧастиИлиТз) <> Тип("ТаблицаЗначений") Тогда
		ТЗ = РезультатПоТабличнойЧастиИлиТз.Выгрузить();
	Иначе
		ТЗ = РезультатПоТабличнойЧастиИлиТз;
	КонецЕсли;
	
	Если ТЗ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// Проставим номер строки
	НомерСтроки = 0;
	Для каждого Строка из ТЗ Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			НомерСтроки = 0;
			Продолжить;
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
		Строка.НомерСтроки = НомерСтроки;
	КонецЦикла;
	ПерваяСтрока = ТЗ[0];
	ИтоговоеПоле = "Ссылка";
	ИмяПоляСклад = "Склад";
	Если ТЗ.Колонки.Найти("ТранспортнаяНакладная") <> Неопределено Тогда
		// Скорее всего это ТранспортнаяНакладная, у нее итог по полю ПорядковыйНомер
		ПерваяСтрока = ТЗ[1];
		Тип = "ТранспортнаяНакладная";
		Реализация = ПерваяСтрока.Ссылка;
		ИмяПоляХарактеристика = "Характеристика";
		ИтоговоеПоле = "ПорядковыйНомер";
		Если ТипЗнч(Реализация) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
			ИмяПоляСклад = "СкладОтправитель";
		КонецЕсли;
	ИначеЕсли ТипЗнч(ПерваяСтрока.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Тип = "Реализация";
		Реализация = ПерваяСтрока.Ссылка;
		ИмяПоляХарактеристика = "Характеристика";
	ИначеЕсли ТипЗнч(ПерваяСтрока.Ссылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Тип = "СчетФактура";
		Реализация = ПерваяСтрока.Ссылка.ДокументОснование;
		Если ТипЗнч(Реализация) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Для каждого СтрокаОснования из ПерваяСтрока.Ссылка.ДокументыОснования Цикл
				Если ТипЗнч(СтрокаОснования.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
					Реализация = СтрокаОснования.ДокументОснование;
					Прервать;
				КонецЕсли;		
			КонецЦикла;
		КонецЕсли;
		Если ТипЗнч(Реализация) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Возврат;
		КонецЕсли;
		ИмяПоляХарактеристика = "Характеристика";
	ИначеЕсли ТипЗнч(ПерваяСтрока.Ссылка) = Тип("ДокументСсылка.СчетНаОплатуКлиенту") Тогда
		Если ТипЗнч(ПерваяСтрока.Ссылка.ДокументОснование) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Возврат;
		КонецЕсли;
		Тип = "СчетНаОплату";
		Реализация = ПерваяСтрока.Ссылка.ДокументОснование;
		ИмяПоляХарактеристика = "ХарактеристикаСсылка";
	ИначеЕсли ТипЗнч(ПерваяСтрока.Ссылка) = Тип("ДокументСсылка.Лико_СчетНаОплатуКлиенту") Тогда
		Тип = "СчетНаПредоплату";
		Реализация = Неопределено;
		ИмяПоляХарактеристика = "ХарактеристикаСсылка";
	ИначеЕсли ТипЗнч(ПерваяСтрока.Ссылка) = Тип("ДокументСсылка.ОтгрузкаТоваровСХранения") Тогда
		// В отгрузкеТоваровСХранения итог 2 уровня
		// <-- Начало Лико Яцун С. В. 13.01.2025
		//Если нет колонки "Склад" значит печать Паспорта качества иначе МХ3
		Если ТЗ.Колонки.Найти("Склад") <> Неопределено Тогда 
			// <-- Конец Лико Яцун С. В. 13.01.2025
			ПерваяСтрока = ТЗ[2];
			ИтоговоеПоле = "Ссылка,Склад";
		КонецЕсли;
		Тип = "Реализация";
		Реализация = ПерваяСтрока.Ссылка;
		ИмяПоляХарактеристика = "Характеристика";
