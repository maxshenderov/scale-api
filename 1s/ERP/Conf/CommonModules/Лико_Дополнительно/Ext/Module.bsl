//Поиск документа Забраковки материалов по ДокументуОснование
Функция ПоискДокументаЗабраковки(ДокументОснование) Экспорт //++ kit:mih web 16.07.21
	
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ЗабраковкаМатериалов.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Лико_ЗабраковкаМатериалов КАК Лико_ЗабраковкаМатериалов
		|ГДЕ
		|	Лико_ЗабраковкаМатериалов.ДокументОснование = &ДокументОснование
		|	И НЕ Лико_ЗабраковкаМатериалов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
КонецФункции

