Процедура ОбработкаШК_Сотрудник(ДанныеШК, ФормаКлиента, Результат)
	
	ФизЛицо = ОпределитьРаботникаПоТабНомеру(ДанныеШК.КодИнформации, ТекущаяДата());
	Если ФизЛицо = Неопределено Тогда
		Результат.Ошибка = "Не найден сотрудник с табельным номером " + ДанныеШК.КодИнформации + " (возможно в справочнике Сотрудники у работника при приеме не проставлен табельный номер).";
		Возврат;
	КонецЕсли;
	
	Результат.Вставить("Сотрудник", ФизЛицо);
	
	Если ФормаКлиента <> Неопределено Тогда
		Если ФормаКлиента.ЭлементыФормы.Найти("АвторДокумента") <> Неопределено Тогда
			ФормаКлиента.АвторДокумента = ФизЛицо;
		КонецЕсли;
		Попытка
			ФормаКлиента.ПриИзмененииОператора(Результат);
		Исключение
		КонецПопытки;
		ЗаполнитьЭлементыФормыИзСтруктуры(ФормаКлиента, Результат);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаШК_РабочийЦентр(ДанныеШК, ФормаКлиента, Результат)
	
	ДлинаКодаРабочегоЦентра = Метаданные.Справочники.РабочиеЦентры.ДлинаКода;
	РабочийЦентр = Справочники.РабочиеЦентры.НайтиПоРеквизиту("Лико_Код",Число(ДанныеШК.КодИнформации));
	
	Результат.Вставить("РабочийЦентр", РабочийЦентр);
	
	Если ФормаКлиента <> Неопределено Тогда
		ЗаполнитьЭлементыФормыИзСтруктуры(ФормаКлиента, Результат);
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьРаботникаПоТабНомеру(ТабНомер, НаДату = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = новый запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	Сотрудники.ФизическоеЛицо КАК ФизЛицо,
	|	МАКСИМУМ(Сотрудники.Код) КАК ТабельныйНомер
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Код = &ТабельныйНомер
	|	И Сотрудники.ПометкаУдаления = ЛОЖЬ
	|	И НЕ Сотрудники.ВАрхиве
	|
	|СГРУППИРОВАТЬ ПО
	|	Сотрудники.ФизическоеЛицо";
	Запрос.УстановитьПараметр("ТабельныйНомер", Формат(число(ТабНомер),"ЧЦ=10; ЧРД=.; ЧВН=; ЧГ=0"));
	Выборка = Запрос.Выполнить().Выбрать();
	
	
	МассивФиз = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ЕСли Выборка.Физлицо <> Справочники.ФизическиеЛица.ПустаяСсылка() тогда
			МассивФиз.Добавить(Выборка.Физлицо);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивФиз.Количество() = 1 Тогда
		Возврат МассивФиз.Получить(0);
		
	ИначеЕсли МассивФиз.Количество() = 0 Тогда
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не найден сотрудник с табельным номером "+ТабНомер+".", СтатусСообщения.Важное);
		
	Иначе
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Найдено "+МассивФиз.Количество()+" сотрудников с табельным номером "+ТабНомер+" нет возможности определить нужного.", СтатусСообщения.Важное);
		Для каждого элМассива Из МассивФиз Цикл
			Лико_ДополнительноКлиентСервер.СообщитьДляКлиента(""+элМассива+" ("+СокрЛП(элМассива.Код)+")", СтатусСообщения.Важное);
		КонецЦикла;
		
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Неопределено;
КонецФункции

Функция ОпределитьСотрудникаПоТабНомеру(ТабНомер, Организация = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, ПараметрыСеанса.ТекущийПользователь, "Организация_e4c9d825676549a1a5c19972efa7da0b", Справочники.Организации.ПустаяСсылка());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Для вашего пользователя не указана организация по умолчанию. Обратитесь к программистам");
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = новый запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	МАКСИМУМ(Сотрудники.Код) КАК ТабельныйНомер
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Код = &ТабельныйНомер
	|	И Сотрудники.ПометкаУдаления = ЛОЖЬ
	|	И НЕ Сотрудники.ВАрхиве
	|	И Сотрудники.ГоловнаяОрганизация = &ГоловнаяОрганизация
	|
	|СГРУППИРОВАТЬ ПО
	|	Сотрудники.Ссылка";
	
	Запрос.УстановитьПараметр("ТабельныйНомер", Формат(число(ТабНомер),"ЧЦ=10; ЧРД=.; ЧВН=; ЧГ=0"));
	Запрос.УстановитьПараметр("ГоловнаяОрганизация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивСотрудников = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ЕСли ЗначениеЗаполнено(Выборка.Сотрудник) Тогда
			МассивСотрудников.Добавить(Выборка.Сотрудник);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивСотрудников.Количество() = 1 Тогда
		Возврат МассивСотрудников.Получить(0);
		
	ИначеЕсли МассивСотрудников.Количество() = 0 Тогда
		Сообщить("В организации """ + Организация + """ не найден сотрудник с табельным номером " + ТабНомер);
	Иначе
		Сообщить("Найдено "+МассивСотрудников.Количество()+" сотрудников с табельным номером "+ТабНомер+", нет возможности определить нужного");
		Для каждого элМассива Из МассивСотрудников Цикл
			Сообщить(""+элМассива+" ("+СокрЛП(элМассива.Код)+")");
		КонецЦикла;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Неопределено;
КонецФункции

Функция ПолучитьСотрудникаПоФизЛицу(ФизЛицо, Организация = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(ФизЛицо) ИЛИ ТипЗнч(ФизЛицо) <> Тип("СправочникСсылка.ФизическиеЛица") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.ПометкаУдаления = ЛОЖЬ
	|	И НЕ Сотрудники.ВАрхиве
	|	И Сотрудники.ФизическоеЛицо = &ФизЛицо
	|	И ВЫБОР
	|			КОГДА &Организация = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Сотрудники.ГоловнаяОрганизация = &Организация
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Ссылка) Тогда
		Возврат Выборка.Ссылка;
	ИначеЕсли ЗначениеЗаполнено(Организация) Тогда
		// Попробуем без организации
		Возврат ПолучитьСотрудникаПоФизЛицу(ФизЛицо, Неопределено);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьЭлементыФормыИзСтруктуры(ФормаКлиента, Структура) Экспорт
	Для Каждого КаждыйИзСтруктура Из Структура Цикл
		ИмяКлюча = КаждыйИзСтруктура.Ключ;
		
		Попытка
			Если ФормаКлиента.ЭлементыФормы.Найти(ИмяКлюча)<>Неопределено Тогда // ищем в шапке
				ФормаКлиента.ЭлементыФормы[ИмяКлюча].Значение = КаждыйИзСтруктура.Значение;
				
				ОбработчикЭлементаПриИзменении = ФормаКлиента.ЭлементыФормы[ИмяКлюча].ПолучитьДействие("ПриИзменении");
				Если ОбработчикЭлементаПриИзменении<>Неопределено Тогда
					Выполнить("ФормаКлиента."+ОбработчикЭлементаПриИзменении+"();");
				КонецЕсли;
				
				//Иначе // ищем в табличных частях, и если находим - заполняем все найденные табличные части
				//	Для Каждого ТабличнаяЧасть Из ФормаКлиента.Метаданные().ТабличныеЧасти Цикл
				//		Если ФормаКлиента.ЭлементыФормы[ТабличнаяЧасть.Имя].Колонки.Найти(ИмяКлюча)<>Неопределено Тогда
				//			Выполнить("ФормаКлиента."+ТабличнаяЧасть.Имя+ИмяКлюча+"Добавление(КаждыйИзСтруктура.Значение);");
				//		КонецЕсли;
				//	КонецЦикла; 
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		//----- новая методика
		Попытка
