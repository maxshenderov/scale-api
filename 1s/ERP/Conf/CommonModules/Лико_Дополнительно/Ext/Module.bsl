Процедура Лико_БлокированиеСерийНаМашинахПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УправлениеСвойствами.ЗначениеСвойства(Источник.Организация,"Лико_БлокированиеСерийНаМашинах")) 
		и не Источник.ДополнительныеСвойства.Свойство("ЭтоТачПадРЦ")   Тогда
		Массив= Новый Массив; 		
		Если ТипЗнч(Источник)=Тип("ДокументОбъект.Лико_БланкЭтапа") Тогда		
			Для каждого Товар Из Источник.Выпуск Цикл
				Массив.Добавить(Товар.Серия);
			КонецЦикла;
			Для каждого Товар Из Источник.Ссылка.Выпуск Цикл
				Массив.Добавить(Товар.Серия);
			КонецЦикла;		
			
			Для каждого Товар Из Источник.Товары Цикл
				Если Товар.Списать Тогда
					Массив.Добавить(Товар.Серия);
				КонецЕсли;
			КонецЦикла;
			Для каждого Товар Из Источник.Ссылка.Товары Цикл
				Если Товар.Списать Тогда
					Массив.Добавить(Товар.Серия);
				КонецЕсли;
			КонецЦикла; 			
		Иначе 		
			Для каждого Товар Из Источник.Товары Цикл
				Массив.Добавить(Товар.Серия);
			КонецЦикла;
			Для каждого Товар Из Источник.Ссылка.Товары Цикл
				Массив.Добавить(Товар.Серия);
			КонецЦикла;		
		КонецЕсли;		
		
		МассивСерий=Лико_Дополнительно.ПроверитьИспользованиеСерийНаТачпаде(Массив, Истина);
		Если МассивСерий.Количество()>0 Тогда
			Отказ=Истина;
