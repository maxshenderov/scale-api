	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Ссылка КАК Ссылка,
	|	ВТ.Реализация КАК Реализация,
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ВТ.Номенклатура.Код КАК НоменклатураКод,
	|	ВТ.Характеристика КАК Характеристика,
	|	МАКСИМУМ(ЗаказКлиентаТовары.NКонтракта) КАК NКонтракта,
	|	МАКСИМУМ(ЗаказКлиентаТовары.КодЭтикеткиЗаказчика) КАК КодЭтикеткиЗаказчика,
	|	МАКСИМУМ(ЗаказКлиентаТовары.ЧестныйЗнак) КАК ЧестныйЗнак,
	|	МАКСИМУМ(ЗаказКлиентаТовары.Направление) КАК Намотка,
	|	МИНИМУМ(ЕСТЬNULL(Серии.Лико_ДатаУпаковки, ДАТАВРЕМЯ(1, 1, 1))) КАК МинимальнаяДатаУпаковки,
	|	МАКСИМУМ(ЕСТЬNULL(Серии.Лико_ДатаУпаковки, ДАТАВРЕМЯ(1, 1, 1))) КАК МаксимальнаяДатаУпаковки,
	|	ВТ.Количество * &ТекстЗапросаВесНоменклатуры КАК ВесКоробок,
	|	0 КАК КоличествоКоробок,
	|	0 КАК КоличествоВУпаковке
	|ИЗ
	|	ВТ_СРеализацией КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ПО ВТ.Характеристика.Лико_ЗаказНоменклатуры = ЗаказКлиентаТовары.Ссылка
	|			И ВТ.Характеристика = ЗаказКлиентаТовары.Характеристика
	|			И ВТ.Номенклатура = ЗаказКлиентаТовары.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры КАК Серии
	|		ПО ВТ.Характеристика = Серии.Лико_ХарактеристикаВладелец
	|			И (НЕ Серии.ПометкаУдаления
	|				И Серии.Лико_ДатаВыпуска <> ДАТАВРЕМЯ(1, 1, 1))
