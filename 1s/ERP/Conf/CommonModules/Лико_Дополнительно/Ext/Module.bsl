	// |  |      |      |           
	// |  |      |      |           
	// |  |      |      |             
	// |  |      |      | 
	// |  |      |      |________________________ Номер документа
	// |  |      |____________________________ Год документа
	// |  | 
	// |  |____________________________________ Вид информации (код справочника, документа и пр.). 12 -карта снятия, 13 - карта перерасхода
	// |_______________________________________ Управляющий символ (3 - документ)
	//
	///////////////////////////////////////////////////////
	// <-- Конец Лико Яцун С. В. 23.05.2025
	
	
	ПроверятьКонтрСумму = Истина;
	
	Шк = СокрЛП(ШК);
	РезультатОбработкиШК = Новый Структура;
	РезультатОбработкиШК.Вставить("ШК", ШК);
	РезультатОбработкиШК.Вставить("Ошибка", "Ошибка при обработке штрихкода " + ШК);
	РезультатОбработкиШК.Вставить("ДлинаШК", СтрДлина(ШК));
	
	Если РезультатОбработкиШК.ДлинаШК=0 Тогда
		Возврат РезультатОбработкиШК;
	КонецЕсли;
	
	Попытка
		УпрСимвол = Число(Лев(ШК,1));
	Исключение
		Возврат РезультатОбработкиШК;
	КонецПопытки;
	
	Попытка // вывалит исключение при обработке ШК EPSMA Customer Order Number
		ВидИнформации = Число(Сред(ШК,2,3));
	Исключение
		ВидИнформации = 0;
	КонецПопытки;
	// {{ DGavrilov 
	Попытка
		EPSMA_УпрСимвол = Число(Лев(ШК,2)); // два символа слева (используются в штрихкодах EPSMA)
		ВидИнформации_2символа = Число(Сред(ШК,2,2)); // Используется в ЯССМ. Двух достаточно, три - "роскошь".
	Исключение
		Возврат РезультатОбработкиШК;
	КонецПопытки;
	
	// }} DGavrilov
	
