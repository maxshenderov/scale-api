Функция ПолучитьПервыйОбъектНоменклатурыДляРасхода(ЗакрытиеБланка) //+Лико m.shenderov 04.10.2021
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лико_БланкЭтапаТовары.Серия.ЯССМ_ОбъектНоменклатуры КАК ОбъектНоменклатуры
	|ИЗ
	|	Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
	|ГДЕ
	|	Лико_БланкЭтапаТовары.Ссылка = &Ссылка
	|	И Лико_БланкЭтапаТовары.Списать
	|	И Лико_БланкЭтапаТовары.Серия.ЯССМ_ОбъектНоменклатуры.Уникальный
	|	И Лико_БланкЭтапаТовары.Ссылка.Проведен";
	Запрос.УстановитьПараметр("Ссылка",ЗакрытиеБланка );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Возврат Выборка.ОбъектНоменклатуры;	
		
	КонецЦикла;		
	
