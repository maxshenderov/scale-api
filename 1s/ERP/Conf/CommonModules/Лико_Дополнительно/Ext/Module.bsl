Функция НайтиЭлектронныйАдресОтветственногоПоСкладу(СсылкаНаОбъект, ВидАдреса, пИмяОбъекта = "Справочник.Склады", ЭтоНаименование = Истина) Экспорт // --> Начало Лико Ефимов ЕВВ 27.10.2020 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление КАК Адрес
	|ИЗ
	|	" + пИмяОбъекта + ".КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Ссылка = &Ссылка
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И ВЫБОР
	|			КОГДА &ЭтоНаименование
	|				ТОГДА КонтактнаяИнформация.Вид.Наименование = &ВидАдреса
	|			ИНАЧЕ КонтактнаяИнформация.Вид.ИдентификаторДляФормул = &ВидАдреса
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Адрес";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ВидАдреса", ВидАдреса);
	Запрос.УстановитьПараметр("ЭтоНаименование", ЭтоНаименование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Адрес) Тогда
		Возврат ВыборкаДетальныеЗаписи.Адрес;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
