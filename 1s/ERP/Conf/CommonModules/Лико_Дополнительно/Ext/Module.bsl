// Формирует строку лаков в формате цифровых заказов
//
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказКлиента, ДокументОбъект.ЗаказКлиента - документ заказа, можно передавать объект документа, а не ссылку. Сделано для случаев, когда нужно получить строку
//																		перед записью документа, в этом случае в ссылке данные могут отличаться от объекта
//  СЛаминацией - Булево - Ставим Истина, если нужно к строке добавить слово "ЛАМ" в тех случаях, когда Заказ.Ламинация = Истина
//
//  Возвращаемое значение:
//      Число - Количество коробок в таблица значений
//
Функция СтрокаЛакиПоЗаказу(Заказ, СЛаминацией = Ложь) Экспорт // --> Начало Лико Ефимов ЕВВ 30.05.2018 
	
	Лаки = "";
	ЗапросЛаки = Новый Запрос;
	ЗапросЛаки.Текст = 
	"ВЫБРАТЬ
	|	ТЧ.ТипЦвета КАК ТипЦвета,
	|	ТЧ.ТипКраски КАК ТипКраски,
	|	ТЧ.Название КАК Название,
	|	ТЧ.ВидПечати КАК ВидПечати
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	&ТЧ КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.ВыборочныйЛак)
	|				ИЛИ ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.ЛакБезОкна)
	|			ТОГДА ЗаказКлиентаЦвета.ТипКраски.Код
	|		КОГДА ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.Pmc)
	|				ИЛИ ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.PmcПоФотону)
	|				ИЛИ ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.PmcПоОбразцу)
	|			ТОГДА ЗаказКлиентаЦвета.Название
	|	КОНЕЦ КАК Код,
	|	ЗаказКлиентаЦвета.ТипЦвета КАК ТипЦвета
	|ИЗ
	|	ВТ_ТЧ КАК ЗаказКлиентаЦвета
	|ГДЕ
	|	(ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.ВыборочныйЛак)
	|			ИЛИ ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.ЛакБезОкна)
	|			ИЛИ ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.Pmc)
	|			ИЛИ ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.PmcПоФотону)
	|			ИЛИ ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.PmcПоОбразцу))
	|	И (ЗаказКлиентаЦвета.ВидПечати = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыПечати.Флексо)
	|			ИЛИ ЗаказКлиентаЦвета.ВидПечати = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыПечати.Траф))";
	
	ЗапросЛаки.УстановитьПараметр("ТЧ", Заказ.Цвета.Выгрузить(,"ТипЦвета,ТипКраски,Название,ВидПечати"));
	ВыборкаЛаки = ЗапросЛаки.Выполнить().Выбрать();
	Пока ВыборкаЛаки.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаЛаки.Код) Тогда 
			Лаки = Лаки + ?(ЗначениеЗаполнено(Лаки),",", "") + СокрЛП(ВыборкаЛаки.Код);
		КонецЕсли;	
	КонецЦикла;
	Если СЛаминацией И Заказ.Ламинация Тогда
		Лаки = Лаки + ?(ЗначениеЗаполнено(Лаки), ",", "") + "ЛАМ";
	КонецЕсли;
	Возврат Лаки;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 30.05.2018 

