Функция НайтиРабочийЦентрВЗаказеКлиентаПоПрокату(ЗаказКлиента, НомерПроката) Экспорт // --> Начало Лико Ефимов ЕВВ 27.09.2018
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр КАК РабочийЦентр
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|ГДЕ
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ = &Заказ
	|	И Лико_ПараметрыПроизводстваЗаказа.НомерПроката = &НомерПроката
	|
	|УПОРЯДОЧИТЬ ПО
	|	РабочийЦентр";
	
	Запрос.УстановитьПараметр("Заказ", ЗаказКлиента);
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.РабочийЦентр;
	Иначе
		Возврат Неопределено;
	КонецЕсли;		
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 27.09.2018

Функция ПодобратьДоговор(ЗаказКлиента, Основание, СоздаватьВсегдаНовый = Ложь) Экспорт // --> Начало Лико Ефимов ЕВВ 29.10.2018 
	
	НомерЗаказа = ЗаказКлиента.НомерБезПрефикса;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Договор
	|ПОМЕСТИТЬ ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	НАЧАЛОПЕРИОДА(ДоговорыКонтрагентов.Дата, ГОД) >= &НачалоГода
	|	И ДоговорыКонтрагентов.Номер = &НомерДоговора
	// --> Начало Лико Ефимов ЕВВ 20.11.2024
	// Прописал тип договора, чтобы не подбирались договоры закупки
	|	И ДоговорыКонтрагентов.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)
	// <-- Конец Лико Ефимов ЕВВ 20.11.2024
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор КАК Договор,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лико_СчетНаОплатуКлиенту.Ссылка) КАК КоличествоДокументов
	|ПОМЕСТИТЬ ВТ_ДоговорыСКоличествомДокументов
	|ИЗ
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием КАК ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лико_СчетНаОплатуКлиенту КАК Лико_СчетНаОплатуКлиенту
	|		ПО ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор = Лико_СчетНаОплатуКлиенту.Договор
	|			И (НЕ Лико_СчетНаОплатуКлиенту.ПометкаУдаления)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РеализацияТоваровУслуг.Ссылка)
	|ИЗ
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием КАК ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор = РеализацияТоваровУслуг.Договор
	|			И (НЕ РеализацияТоваровУслуг.ПометкаУдаления)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ АктВыполненныхРабот.Ссылка)
	|ИЗ
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием КАК ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктВыполненныхРабот КАК АктВыполненныхРабот
	|		ПО ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор = АктВыполненныхРабот.Договор
	|			И (НЕ АктВыполненныхРабот.ПометкаУдаления)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка)
	|ИЗ
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием КАК ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа
	|		ПО (ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор = (ВЫРАЗИТЬ(ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.ОснованиеПлатежа КАК Справочник.ДоговорыКонтрагентов)))
	|			И (НЕ ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.ПометкаУдаления)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор
	// --> Начало Лико Ефимов ЕВВ 14.06.2022
	// будем искать еще по вводам остатков
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВводОстатковРасчетыСПартнерами.Ссылка)
	|ИЗ
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием КАК ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводОстатков.РасчетыСПартнерами КАК ВводОстатковРасчетыСПартнерами
	|		ПО (ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор = (ВЫРАЗИТЬ(ВводОстатковРасчетыСПартнерами.ОбъектРасчетов КАК Справочник.ДоговорыКонтрагентов)))
	|			И (НЕ ВводОстатковРасчетыСПартнерами.Ссылка.ПометкаУдаления)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДоговорыКонтрагентаСЗаданнымНаименованием.Договор
	// <-- Конец Лико Ефимов ЕВВ 14.06.2022
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДоговорыСКоличествомДокументов.Договор КАК Договор,
	|	СУММА(ВТ_ДоговорыСКоличествомДокументов.КоличествоДокументов) КАК КоличествоДокументов
	|ИЗ
	|	ВТ_ДоговорыСКоличествомДокументов КАК ВТ_ДоговорыСКоличествомДокументов
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДоговорыСКоличествомДокументов.Договор
	|
	|УПОРЯДОЧИТЬ ПО
	|	КоличествоДокументов УБЫВ,
	|	ВТ_ДоговорыСКоличествомДокументов.Договор";
	
	НомерДоговора = НомерЗаказа;
	Запрос.УстановитьПараметр("НачалоГода", НачалоГода(ДобавитьМесяц(Основание.Дата, -9*12))); // последние 9 лет, т.к. для года у нас всего одна цифра
	//Запрос.УстановитьПараметр("Контрагент", Реализация.Контрагент);
	//Запрос.УстановитьПараметр("Организация", Основание.Организация);
	
	Для Счетчик = 1 по 10000 Цикл
		
		Запрос.УстановитьПараметр("НомерДоговора", НомерДоговора);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			Если Выборка.КоличествоДокументов > 0 Тогда
				НомерДоговора = НомерЗаказа + "/" + Формат(Счетчик,"ЧГ=");
			Иначе
				//Если ТипЗнч(Основание) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
				//	// для реализации вернем этот договор
				//	Возврат Выборка.Договор;
				//Иначе
				//	// для счета на предоплату все равно будем создавать новый договор с номером + 1
				//	НомерДоговора = НомерЗаказа + "/" + Формат(Счетчик,"ЧГ=");
				//	Продолжить;
				//КонецЕсли;
				Если СоздаватьВсегдаНовый Тогда
					// для счета на предоплату все равно будем создавать новый договор с номером + 1
					НомерДоговора = НомерЗаказа + "/" + Формат(Счетчик,"ЧГ=");
					Продолжить;
				Иначе
					// для реализации вернем этот договор
					Возврат Выборка.Договор;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Раз дошло до сюда, значит нужно создавать новый договор
	НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	НовыйДоговор.Наименование = "СЧ" + НомерДоговора;
	НовыйДоговор.НаименованиеДляПечати = "СЧ" + НомерДоговора;
	НовыйДоговор.Номер = НомерДоговора;
	НовыйДоговор.Контрагент = Основание.Контрагент;
	НовыйДоговор.Дата = Основание.Дата;
	НовыйДоговор.Организация = Основание.Организация;
	НовыйДоговор.Партнер = Основание.Партнер;
	НовыйДоговор.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
	НовыйДоговор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	НовыйДоговор.Согласован = Истина;
	НовыйДоговор.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	НовыйДоговор.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем;
	Если НовыйДоговор.Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		// не резидент, ставка НДС = 0
		НовыйДоговор.СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС0);
		НовыйДоговор.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНаЭкспорт;
	Иначе
		// резидент
		Если НовыйДоговор.Дата >= Дата('20260101') Тогда
			НовыйДоговор.СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС22);
		ИначеЕсли НовыйДоговор.Дата >= Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияСтавкиНДС20.ЗначениеПараметра Тогда
			НовыйДоговор.СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС20);
		Иначе
			НовыйДоговор.СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС18);
		КонецЕсли;
		НовыйДоговор.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	КонецЕсли;
	Если ТипЗнч(Основание) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		НовыйДоговор.ВалютаВзаиморасчетов = Основание.ВалютаВзаиморасчетов;
		//НовыйДоговор.ПорядокОплаты = Основание.ПорядокОплаты;
		НовыйДоговор.ГруппаФинансовогоУчета = Основание.ГруппаФинансовогоУчета;
		НовыйДоговор.Менеджер = Основание.Менеджер;
		НовыйДоговор.Подразделение = Основание.Подразделение;
		НовыйДоговор.БанковскийСчетКонтрагента = Основание.БанковскийСчетКонтрагента;
	ИначеЕсли ТипЗнч(Основание) = Тип("ДанныеФормыСтруктура") И (ТипЗнч(Основание.Ссылка) = Тип("ДокументСсылка.Лико_СчетНаОплатуКлиенту") ИЛИ ТипЗнч(Основание.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг")) Тогда
		НовыйДоговор.ВалютаВзаиморасчетов = Основание.Валюта;
		//Если НовыйДоговор.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчета.Получить() Тогда	
		//	НовыйДоговор.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВРубляхОплатаВРублях;
		//Иначе
		//	Если НовыйДоговор.Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент И Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, НовыйДоговор.Контрагент, "ОплатаВВалютедляНерезидентов", Ложь) Тогда
		//		НовыйДоговор.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВВалюте;
		//	Иначе
		//		НовыйДоговор.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВРублях;
		//	КонецЕсли;
		//КонецЕсли;
		НовыйДоговор.ГруппаФинансовогоУчета = НайтиГруппуФинУчетаПоВалютеИНалогообложению(НовыйДоговор.ВалютаВзаиморасчетов, НовыйДоговор.НалогообложениеНДС);
		НовыйДоговор.Менеджер = ЗаказКлиента.Менеджер;
		НовыйДоговор.Подразделение = ЗаказКлиента.Менеджер.Подразделение;
		НовыйДоговор.БанковскийСчетКонтрагента = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(НовыйДоговор.Контрагент, Константы.ВалютаРегламентированногоУчета.Получить());
	Иначе
		Сообщить("Основание для подбора договора неопределено");
		Возврат Неопределено;
	КонецЕсли;
	Если НовыйДоговор.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра
		ИЛИ НовыйДоговор.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра
		ИЛИ НовыйДоговор.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияАвантаж.ЗначениеПараметра Тогда
		НовыйДоговор.Подразделение = Справочники.Лико_ПредопределенныеЗначения.ПодразделениеПроизводство.ЗначениеПараметра;
	КонецЕсли;
	НовыйДоговор.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента;
	НовыйДоговор.Лико_Площадка = ЗаказКлиента.Площадка;
	НовыйДоговор.НалогообложениеНДСОпределяетсяВДокументе = Ложь;
	НовыйДоговор.СпособДоставки = Перечисления.СпособыДоставки.ОпределяетсяВРаспоряжении;
	НовыйДоговор.Лико_СсылкаНаРеальныйДоговор = НайтиРеальныйДоговор(НовыйДоговор.Организация, НовыйДоговор.Контрагент, НовыйДоговор.Дата, НовыйДоговор.ВалютаВзаиморасчетов);
	Если ЗначениеЗаполнено(НовыйДоговор.Лико_СсылкаНаРеальныйДоговор) И ЗначениеЗаполнено(НовыйДоговор.Лико_СсылкаНаРеальныйДоговор.БанковскийСчет) Тогда
		НовыйДоговор.БанковскийСчет = НовыйДоговор.Лико_СсылкаНаРеальныйДоговор.БанковскийСчет;
	Иначе
		НовыйДоговор.БанковскийСчет = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитОрганизацииБанковскийСчетПоУмолчанию", НовыйДоговор.Организация);
		Если НЕ ЗначениеЗаполнено(НовыйДоговор.БанковскийСчет) Тогда
			НовыйДоговор.БанковскийСчет = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(НовыйДоговор.Организация, Константы.ВалютаРегламентированногоУчета.Получить());
		КонецЕсли;
	КонецЕсли;
	// --> Начало Лико Ефимов ЕВВ 12.04.2022
	НовыйДоговор.ОплатаВВалюте = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, НовыйДоговор.Контрагент, "ОплатаВВалютедляНерезидентов", Ложь);
	// <-- Конец Лико Ефимов ЕВВ 12.04.2022
	// --> Начало Лико Ефимов ЕВВ 24.01.2025
	НовыйДоговор.Лико_ОсобыйПорядокРасчетаНДС = НовыйДоговор.Лико_СсылкаНаРеальныйДоговор.Лико_ОсобыйПорядокРасчетаНДС;
	// <-- Конец Лико Ефимов ЕВВ 24.01.2025
	
	Попытка
		НовыйДоговор.Записать();
		Возврат НовыйДоговор.Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 29.10.2018 

Функция НайтиГруппуФинУчетаПоВалютеИНалогообложению(Валюта, НалогообложениеНДС) Экспорт // --> Начало Лико Ефимов ЕВВ 01.03.2022 новая функция для 2.5
	
	РасчетыВВалюте = Валюта <> Константы.ВалютаРегламентированногоУчета.Получить();
	ПродажаНаЭкспорт = НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНаЭкспорт;
	ГруппаФинУчетаКлиентыЭкспортВалюта = Справочники.Лико_ПредопределенныеЗначения.ГруппаФинУчетаКлиентыЭкспортВалюта.ЗначениеПараметра;
	Если РасчетыВВалюте И ПродажаНаЭкспорт Тогда
		Возврат ГруппаФинУчетаКлиентыЭкспортВалюта;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ГруппыФинансовогоУчетаРасчетов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГруппыФинансовогоУчетаРасчетов КАК ГруппыФинансовогоУчетаРасчетов
		|ГДЕ
		|	НЕ ГруппыФинансовогоУчетаРасчетов.ПометкаУдаления
		|	И ГруппыФинансовогоУчетаРасчетов.Родитель = ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка)
		|	И НЕ ГруппыФинансовогоУчетаРасчетов.ЭтоГруппа
		|	И ГруппыФинансовогоУчетаРасчетов.РасчетыСКлиентами
		|	И ГруппыФинансовогоУчетаРасчетов.РасчетыВВалюте = &РасчетыВВалюте
		|	И ВЫБОР
		|			КОГДА &ПродажаНаЭкспорт
		|					И &РасчетыВВалюте
		|				ТОГДА ГруппыФинансовогоУчетаРасчетов.Ссылка = &ГруппаФинУчетаКлиентыЭкспортВалюта
		|			ИНАЧЕ ГруппыФинансовогоУчетаРасчетов.Ссылка <> &ГруппаФинУчетаКлиентыЭкспортВалюта
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("ПродажаНаЭкспорт", ПродажаНаЭкспорт);
	Запрос.УстановитьПараметр("РасчетыВВалюте", РасчетыВВалюте);
	Запрос.УстановитьПараметр("ГруппаФинУчетаКлиентыЭкспортВалюта", ГруппаФинУчетаКлиентыЭкспортВалюта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Ссылка) Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции  // <-- Конец Лико Ефимов ЕВВ 01.03.2022 

Функция ПолучитьКартинкуШтрихкодаDataMatrix(Штрихкод, SymbolSize = 5) Экспорт // --> Начало Лико Ефимов ЕВВ 14.11.2018
	
	ВнешняяКомпонента = ПодключитьВнешнююКомпонентуПечатиШтрихкодаDataMatrix();
	Если ВнешняяКомпонента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// ЕВВ: из Медицина. Больничные, редакция 2.0 (2.0.2.3)  
	
	// DataMatrix. РазмерыМатрицы:
	//   10x10 - 1
	//   12x12 - 2
	//   14x14 - 3
	//   16x16 - 4
	//   18x18 - 5
	//   20x20 - 6
	//   22x22 - 7
	//   24x24 - 8
	//   26x26 - 9
	//   32x32 - 10
	//   36x36 - 11
	//   40x40 - 12
	//   44x44 - 13
	//   48x48 - 14
	//   52x52 - 15
	//   64x64 - 16
	//   72x72 - 17
	//   80x80 - 18
	//   88x88 - 19
	//   96x96 - 20
	//   104x104 - 21
	//   120x120 - 22
	//   132x132 - 23
	//   144x144 - 24
	//   8x18 - 25
	//   8x32 - 26
	//   12x26 - 27
	//   12x36 - 28
	//   16x36 - 29
	//   16x48 - 30
	
	// DataMatrix. СхемыКодирования:
	//   AutoFast - 1
	//   AutoBest - 2
	//   Ascii - 3
	//   C40 - 4
	//   Text - 5
	//   X12 - 6
	//   Edifact - 7
	//   Base256 - 8
	
	
	// Сформируем картинку
	ВнешняяКомпонента.SymbolSize = 20;   // РазмерыМатрицы - 96x96
	ВнешняяКомпонента.EncodingScheme = 8;  // СхемыКодирования - SchemeBase256
	ВнешняяКомпонента.ModuleSize = 4;   // размер модуля в пикселях
	ВнешняяКомпонента.MarginSize = 2;   // отступ в пикселях
	
	// --> Начало Лико Ефимов ЕВВ 14.11.2018 
	//ДвоичныеДанныеКартинки = ВнешняяКомпонента.GetBarcode(Штрихкод);
	ВнешняяКомпонента.SymbolSize = SymbolSize;
	Попытка
		ДвоичныеДанныеКартинки = ВнешняяКомпонента.GetBarcode(Штрихкод);
	Исключение
		Если SymbolSize < 30 Тогда
			SymbolSize = SymbolSize + 1;
			Возврат ПолучитьКартинкуШтрихкодаDataMatrix(Штрихкод, SymbolSize);
		КонецЕсли;
	КонецПопытки;
	// <-- Конец Лико Ефимов ЕВВ 14.11.2018
	
	// Если картинка сформировалась
	Если ДвоичныеДанныеКартинки <> Неопределено Тогда
		// Формируем из двоичных данных
		Возврат Новый Картинка(ДвоичныеДанныеКартинки);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 14.11.2018 

Функция ПодключитьВнешнююКомпонентуПечатиШтрихкодаDataMatrix() // --> Начало Лико Ефимов ЕВВ 14.11.2018 
	
	// ЕВВ: из 1С Медицина. Больничные, редакция 2.0 (2.0.2.3) 
	
	// В зависимости от типа платформы подключим соответствующую внешнюю компоненту
	ПодключениеВыполнено = Неопределено;
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Если СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86 Тогда
		ПодключениеВыполнено = ПодключитьВнешнююКомпоненту("ОбщийМакет.КомпонентаПечатиШтрихкодовWindows32_DataMatrix", "КартинкаШтрихкодаDataMatrix", ТипВнешнейКомпоненты.Native);
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда
		ПодключениеВыполнено = ПодключитьВнешнююКомпоненту("ОбщийМакет.КомпонентаПечатиШтрихкодовWindows64_DataMatrix", "КартинкаШтрихкодаDataMatrix", ТипВнешнейКомпоненты.Native);
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86 Тогда
		ПодключениеВыполнено = ПодключитьВнешнююКомпоненту("ОбщийМакет.КомпонентаПечатиШтрихкодовLinux32_DataMatrix", "КартинкаШтрихкодаDataMatrix", ТипВнешнейКомпоненты.Native);
	Иначе
		ПодключениеВыполнено = ПодключитьВнешнююКомпоненту("ОбщийМакет.КомпонентаПечатиШтрихкодовLinux64_DataMatrix", "КартинкаШтрихкодаDataMatrix", ТипВнешнейКомпоненты.Native);
	КонецЕсли;
	
	// Создадим объект внешней компоненты
	Если ПодключениеВыполнено Тогда
		ВнешняяКомпонента = Новый("AddIn.КартинкаШтрихкодаDataMatrix.Barcode");
	Иначе
		Сообщить("Не удалось подключить компонент печати 2D-кода DataMatrix для платформы " + СистемнаяИнформация.ТипПлатформы + ". Обратитесь в отдел ИТ");
		Возврат Неопределено;
	КонецЕсли;
	
	// Если нет возможности рисовать
	Возврат ВнешняяКомпонента;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 14.11.2018 

Процедура ПроверитьНаличиеНулевыхСуммВРегистреСуммыДокументовВВалютеРеглИДобавитьНовоеЗаданиеКРасчетуПриНеобходимости(Документ, МенеджерВременныхТаблиц = Неопределено) Экспорт // --> Начало Лико Ефимов ЕВВ 15.01.2019

	УстановитьПривилегированныйРежим(Истина);

	Если ПолучитьФункциональнуюОпцию("НоваяАрхитектураВзаиморасчетов") Тогда
		Возврат;
	КонецЕсли;

	МассивДокументов = Новый Массив;
	Если Документ = Неопределено Тогда
		Если МенеджерВременныхТаблиц = Неопределено Тогда
			Возврат;
		КонецЕсли;

		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДанныхДокументов.Ссылка КАК Ссылка
		|ИЗ
		|	ТаблицаДанныхДокументов КАК ТаблицаДанныхДокументов
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаДанныхДокументов.Ссылка";
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивДокументов.Добавить(Выборка.Ссылка);	
		КонецЦикла;
	Иначе
		МассивДокументов.Добавить(Документ);
	КонецЕсли;

	Для каждого ТекДокумент ИЗ МассивДокументов Цикл
		ТипДокумента = ТипЗнч(ТекДокумент.Ссылка);
		Если НЕ (ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") ИЛИ ТипДокумента = Тип("ДокументСсылка.АктВыполненныхРабот")) Тогда
			Возврат;
		КонецЕсли;
		ДокументСсылка = ТекДокумент.Ссылка;

		Если ТекДокумент.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчета.Получить() Тогда
			Возврат;
		КонецЕсли;

		ДатаДокумента = ТекДокумент.Дата;

		// --> Начало Лико Ефимов ЕВВ 01.10.2019
		Если ДатаДокумента < Дата('20190101000000') Тогда
			Возврат;
		КонецЕсли;
		// <-- Конец Лико Ефимов ЕВВ 01.10.2019 

		// Проверим, есть ли уже запись в регистре в текущем месяце по данному документу
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданияКРаспределениюРасчетовСКлиентами.Документ КАК Документ
		|ИЗ
		|	РегистрСведений.ЗаданияКРаспределениюРасчетовСКлиентами КАК ЗаданияКРаспределениюРасчетовСКлиентами
		|ГДЕ
		|	(ВЫРАЗИТЬ(ЗаданияКРаспределениюРасчетовСКлиентами.Документ КАК Документ.РеализацияТоваровУслуг)) = &Документ
		|	И ЗаданияКРаспределениюРасчетовСКлиентами.Месяц = &Месяц";

		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг", ДокументСсылка.Метаданные().Имя);
		Запрос.УстановитьПараметр("Документ", ДокументСсылка);
		Запрос.УстановитьПараметр("Месяц", НачалоМесяца(ДатаДокумента));
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			// Запись уже есть
			Возврат;
		КонецЕсли;

		НужноДобавлятьЗапись = Ложь;

		Если НЕ НужноДобавлятьЗапись Тогда
			// Проверим, есть ли нулевые суммы
			// Проверим, сходится ли рублевая сумма у документов без предоплаты
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СуммыДокументовВВалютеРегл.Регистратор КАК Регистратор,
			|	СуммыДокументовВВалютеРегл.СуммаБезНДСРегл + СуммыДокументовВВалютеРегл.СуммаНДСРегл КАК СуммаРуб,
			|	СуммыДокументовВВалютеРегл.СуммаБезНДСРегл КАК СуммаБезНДСРегл
			|ПОМЕСТИТЬ ВТ_ДанныеРегистра
			|ИЗ
			// --> Начало Лико Ефимов ЕВВ 12.04.2022
			// Регистр переименовали в 2.5
			//|	РегистрСведений.СуммыДокументовВВалютеРегл КАК СуммыДокументовВВалютеРегл
			|	РегистрСведений.СуммыДокументовВВалютахУчета КАК СуммыДокументовВВалютеРегл 
			// <-- Конец Лико Ефимов ЕВВ 12.04.2022
			|ГДЕ
			|	(ВЫРАЗИТЬ(СуммыДокументовВВалютеРегл.Регистратор КАК Документ.РеализацияТоваровУслуг)) = &Регистратор
			//|
			//|СГРУППИРОВАТЬ ПО
			//|	СуммыДокументовВВалютеРегл.Регистратор,
			//|	СуммыДокументовВВалютеРегл.СуммаБезНДСРегл,
			//|	СуммыДокументовВВалютеРегл.СуммаБезНДСРегл + СуммыДокументовВВалютеРегл.СуммаНДСРегл
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ДанныеРегистра.Регистратор КАК Регистратор,
			|	СУММА(ВТ_ДанныеРегистра.СуммаРуб) КАК СуммаРуб
			|ИЗ
			|	ВТ_ДанныеРегистра КАК ВТ_ДанныеРегистра
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_ДанныеРегистра.Регистратор
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ДанныеРегистра.Регистратор КАК Регистратор,
			|	ВТ_ДанныеРегистра.СуммаБезНДСРегл КАК СуммаБезНДСРегл
			|ИЗ
			|	ВТ_ДанныеРегистра КАК ВТ_ДанныеРегистра
			|ГДЕ
			|	ВТ_ДанныеРегистра.СуммаБезНДСРегл = 0";

			Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг", ДокументСсылка.Метаданные().Имя);
			Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
			РезультатыЗапроса = Запрос.ВыполнитьПакет();
			РезультатыЗапросаНулевыеСуммы = РезультатыЗапроса[РезультатыЗапроса.Количество()-1];
			Если НЕ РезультатыЗапросаНулевыеСуммы.Пустой() Тогда
				// Есть нулевые строки
				НужноДобавлятьЗапись = Истина;
			КонецЕсли;

			Если НЕ НужноДобавлятьЗапись И НЕ ПоРеализацииЕстьПредоплата(ТекДокумент) Тогда
				ВыборкаСуммаРуб = РезультатыЗапроса[РезультатыЗапроса.Количество()-2].Выбрать();
				Если ВыборкаСуммаРуб.Следующий() Тогда
					Курс = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ТекДокумент.Валюта, ДатаДокумента).Курс;
					Если Окр(ТекДокумент.СуммаДокумента * Курс, 2, РежимОкругления.Окр15как20) <> ВыборкаСуммаРуб.СуммаРуб Тогда
						// Рублевая сумма в документе не сходится с суммой евро * курс
						НужноДобавлятьЗапись = Истина;
					КонецЕсли;
				Иначе
					// Записей в регистре вообще нет, нужно добавить задание
					НужноДобавлятьЗапись = Истина;
				КонецЕсли;			
			КонецЕсли;
		КонецЕсли;	

		Если НужноДобавлятьЗапись Тогда

			// --> Начало Лико Ефимов ЕВВ 26.04.2021
			// Сначала проверим дату запрета
			ШаблонЗапретаДанных = ДатыЗапретаИзменения.ШаблонДанныхДляПроверки();
			СтрокаШаблона = ШаблонЗапретаДанных.Добавить();
			СтрокаШаблона.Дата   = ДатаДокумента;
			СтрокаШаблона.Раздел = "РегламентныеОперации";
			Если ДатыЗапретаИзменения.НайденЗапретИзмененияДанных(ШаблонЗапретаДанных) Тогда
				Возврат;
			КонецЕсли;				
			// <-- Конец Лико Ефимов ЕВВ 26.04.2021

			// Получим АналитикаУчетаПоПартнерам (типовой механизм)
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	НАЧАЛОПЕРИОДА(Документ.Дата, МЕСЯЦ) КАК Месяц,
			|	Документ.Организация КАК Организация,
			|	РасчетыСКлиентами.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
			|	РасчетыСКлиентами.ОбъектРасчетов КАК ОбъектРасчетов,
			|	Документ.Ссылка КАК Документ
			|ИЗ
			|	РегистрНакопления.РасчетыСКлиентами КАК РасчетыСКлиентами
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Документ
			|		ПО РасчетыСКлиентами.Регистратор = Документ.Ссылка
			|ГДЕ
			|	Документ.Ссылка = &Ссылка
			|	И РасчетыСКлиентами.Активность
			|
			|СГРУППИРОВАТЬ ПО
			|	РасчетыСКлиентами.АналитикаУчетаПоПартнерам,
			|	Документ.Организация,
			|	РасчетыСКлиентами.ОбъектРасчетов,
			|	Документ.Ссылка,
			|	НАЧАЛОПЕРИОДА(Документ.Дата, МЕСЯЦ)";
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг", ДокументСсылка.Метаданные().Имя);
			Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			Если Выборка.Следующий() Тогда
				// --> Маковеева А.Ю. 11.06.2021
				Лико_УдалитьДублиЗаданийКРаспределениюРасчетов(Выборка, "ЗаданияКРаспределениюРасчетовСКлиентами");
				// <-- Маковеева А.Ю. 11.06.2021
				НаборЗаписей = РегистрыСведений.ЗаданияКРаспределениюРасчетовСКлиентами.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(НаборЗаписей, Выборка);			
				НаборЗаписей.НомерЗадания = Константы.НомерЗаданияКРаспределениюРасчетовСКлиентами.Получить();
				НаборЗаписей.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 15.01.2019

Функция ПоРеализацииЕстьПредоплата(Реализация) Экспорт // --> Начало Лико Ефимов ЕВВ 23.01.2019

	Запрос = Новый Запрос;
	Если ПолучитьФункциональнуюОпцию("НоваяАрхитектураВзаиморасчетов") Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчетыСКлиентамиПоСрокам.ДокументРегистратор КАК Регистратор,
		|	СУММА(РасчетыСКлиентамиПоСрокам.Предоплата) КАК Предоплата
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентамиПоСрокам КАК РасчетыСКлиентамиПоСрокам
		|ГДЕ
		|	РасчетыСКлиентамиПоСрокам.ДокументРегистратор = &Регистратор
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыСКлиентамиПоСрокам.ДокументРегистратор";
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчетыСКлиентамиПоДокументам.Регистратор КАК Регистратор,
		|	СУММА(РасчетыСКлиентамиПоДокументам.Предоплата) КАК Предоплата
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентамиПоДокументам КАК РасчетыСКлиентамиПоДокументам
		|ГДЕ
		|	РасчетыСКлиентамиПоДокументам.Регистратор = &Регистратор
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыСКлиентамиПоДокументам.Регистратор";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Регистратор", Реализация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() И ВыборкаДетальныеЗаписи.Предоплата <> 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 23.01.2019

Процедура ДополнитьТаблицуСерийДатойИФормированиемВыпуска(ТаблицаСерий) Экспорт // --> Начало Лико Ефимов ЕВВ 12.04.2019
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.Серия КАК Серия
	|ПОМЕСТИТЬ ВТ_ТаблицаСерий
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаСерий.Серия КАК Серия,
	|	МИНИМУМ(Лико_ФормированиеПаллетаСодержимое.Ссылка.Дата) КАК ДатаВыпуска
	|ПОМЕСТИТЬ Лико_СодержимоеРастаркиСДатамиВыпуска
	|ИЗ
	|	ВТ_ТаблицаСерий КАК ВТ_ТаблицаСерий
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лико_ФормированиеПаллета.Содержимое КАК Лико_ФормированиеПаллетаСодержимое
	|		ПО ВТ_ТаблицаСерий.Серия = Лико_ФормированиеПаллетаСодержимое.Серия
	|			И (Лико_ФормированиеПаллетаСодержимое.Ссылка.Проведен)
	|			И (Лико_ФормированиеПаллетаСодержимое.Ссылка.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыФормированияПаллет.ВыпускПродукции))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТаблицаСерий.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_СодержимоеРастаркиСДатамиВыпуска.Серия КАК Серия,
	|	МАКСИМУМ(ЕСТЬNULL(Лико_ФормированиеПаллетаСодержимое.Ссылка, ЗНАЧЕНИЕ(Документ.Лико_ФормированиеПаллета.ПустаяСсылка))) КАК ФормированиеПаллетаВыпуск
	|ПОМЕСТИТЬ Лико_СодержимоеРастаркиСФормированиями
	|ИЗ
	|	Лико_СодержимоеРастаркиСДатамиВыпуска КАК Лико_СодержимоеРастаркиСДатамиВыпуска
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лико_ФормированиеПаллета.Содержимое КАК Лико_ФормированиеПаллетаСодержимое
	|		ПО Лико_СодержимоеРастаркиСДатамиВыпуска.Серия = Лико_ФормированиеПаллетаСодержимое.Серия
	|			И Лико_СодержимоеРастаркиСДатамиВыпуска.ДатаВыпуска = Лико_ФормированиеПаллетаСодержимое.Ссылка.Дата
	|			И (Лико_ФормированиеПаллетаСодержимое.Ссылка.Проведен)
	|			И (Лико_ФормированиеПаллетаСодержимое.Ссылка.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыФормированияПаллет.ВыпускПродукции))
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_СодержимоеРастаркиСДатамиВыпуска.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_СодержимоеРастаркиСФормированиями.Серия КАК Серия,
	|	Лико_СодержимоеРастаркиСФормированиями.ФормированиеПаллетаВыпуск КАК ФормированиеПаллетаВыпуск,
	|	ВЫБОР
	|		КОГДА Лико_СодержимоеРастаркиСФормированиями.ФормированиеПаллетаВыпуск = ЗНАЧЕНИЕ(Документ.Лико_ФормированиеПаллета.ПустаяСсылка)
	|			ТОГДА МИНИМУМ(ТоварыВЯчейкахОбороты.Период)
	|		ИНАЧЕ Лико_СодержимоеРастаркиСФормированиями.ФормированиеПаллетаВыпуск.Дата
	|	КОНЕЦ КАК ДатаВыпуска
	|ИЗ
	|	Лико_СодержимоеРастаркиСФормированиями КАК Лико_СодержимоеРастаркиСФормированиями
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Обороты(
	|				,
	|				,
	|				Регистратор,
	|				Серия В
	|					(ВЫБРАТЬ
	|						Т.Серия
	|					ИЗ
	|						Лико_СодержимоеРастаркиСФормированиями КАК Т
	|					ГДЕ
	|						Т.ФормированиеПаллетаВыпуск = ЗНАЧЕНИЕ(Документ.Лико_ФормированиеПаллета.ПустаяСсылка))) КАК ТоварыВЯчейкахОбороты
	|		ПО Лико_СодержимоеРастаркиСФормированиями.Серия = ТоварыВЯчейкахОбороты.Серия
	|			И (ТоварыВЯчейкахОбороты.ВНаличииПриход <> 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_СодержимоеРастаркиСФормированиями.Серия,
	|	Лико_СодержимоеРастаркиСФормированиями.ФормированиеПаллетаВыпуск,
	|	Лико_СодержимоеРастаркиСФормированиями.ФормированиеПаллетаВыпуск.Дата";
	
	Запрос.УстановитьПараметр("Таблица", ТаблицаСерий);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаСДатами = РезультатЗапроса.Выгрузить();
	
	ТаблицаСерий.Колонки.Добавить("ФормированиеПаллетаВыпуск", Новый ОписаниеТипов("ДокументСсылка.Лико_ФормированиеПаллета"));
	ТаблицаСерий.Колонки.Добавить("ДатаВыпуска", Новый ОписаниеТипов("Дата",,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	
	Для каждого Строка из ТаблицаСерий Цикл
		НайденныеСтроки = ТаблицаСДатами.НайтиСтроки(Новый Структура("Серия", Строка.Серия));
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Строка, НайденныеСтроки[0]);
	КонецЦикла;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 12.04.2019

Функция ПолучитьХарактеристикуПоЗаказуИНоменклатуре(Номенклатура, Заказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Владелец = &Владелец
	|	И ХарактеристикиНоменклатуры.Лико_ЗаказНоменклатуры = &Лико_ЗаказНоменклатуры
	|
	|УПОРЯДОЧИТЬ ПО
	|	ХарактеристикиНоменклатуры.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Запрос.УстановитьПараметр("Лико_ЗаказНоменклатуры", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция НайтиИлиСоздатьОбщийВыпускающийЭтапНаМесяц(Организация, Дата, Подразделение, Характеристика = Неопределено, Склад = Неопределено) Экспорт
	
	// Нужно искать "общий" этап на текущий месяц
	ЭтапСсылка = НайтиОбщийВыпускающийЭтап(Организация, Подразделение, Дата);
	Если НЕ ЗначениеЗаполнено(ЭтапСсылка) Тогда
		// На этот месяц еще нет "общего" этапа, будем создавать
		// Сначала создадим заказ на производство
		ЗаказНаПроизводствоОбъект = Документы.ЗаказНаПроизводство2_2.СоздатьДокумент();
		ЗаказНаПроизводствоОбъект.Дата = НачалоМесяца(Дата);
		ЗаказНаПроизводствоОбъект.Подразделение = Подразделение;
		ЗаказНаПроизводствоОбъект.Организация = Организация;
		ЗаказНаПроизводствоОбъект.ЗаказПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		ЗаказНаПроизводствоОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		ЗаказНаПроизводствоОбъект.РазмещениеВыпуска = Перечисления.СпособыПривязкиОперацийПроизводства.КНачалу;
		ЗаказНаПроизводствоОбъект.ДатаПотребности = ЗаказНаПроизводствоОбъект.Дата;
		ЗаказНаПроизводствоОбъект.НачатьНеРанее = ЗаказНаПроизводствоОбъект.Дата;
		ЗаказНаПроизводствоОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СобственноеПроизводство;
		ЗаказНаПроизводствоОбъект.ВариантОбособления = Перечисления.ВариантыОбособленияМатериаловВПроизводстве.ЭтапПроизводства;
		ЗаказНаПроизводствоОбъект.Приоритет = Справочники.Приоритеты.ПолучитьПриоритетПоУмолчанию();
		ЗаказНаПроизводствоОбъект.Статус = Перечисления.СтатусыЗаказовНаПроизводство2_2.КПроизводству;
		ЗаказНаПроизводствоОбъект.Комментарий = "Заказ создан автоматически. Это ""общий"" заказ на производство для всех заказов клиентов, с момента начала печати которых прошло более 25 дней";
		ЗаказНаПроизводствоОбъект.ТипПроизводственногоПроцесса = Перечисления.ТипыПроизводственныхПроцессов.Сборка;
		Если Характеристика = Неопределено Тогда
			// Заказ создает Максим, серии у него нет. Нужно найти любую серию и вставить туда
			ЭтапСсылка = НайтиОбщийВыпускающийЭтап(Организация, Подразделение);
			Если ЭтапСсылка = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Если ЭтапСсылка.ВыходныеИзделия.Количество() = 0 Тогда
				Возврат Неопределено;
			КонецЕсли;
			Характеристика = ЭтапСсылка.ВыходныеИзделия[0].Характеристика;
			Склад = ЭтапСсылка.ВыходныеИзделия[0].Получатель;
		КонецЕсли;
		НоваяСтрока = ЗаказНаПроизводствоОбъект.Продукция.Добавить();
		НоваяСтрока.Характеристика = Характеристика;
		НоваяСтрока.Номенклатура = НоваяСтрока.Характеристика.Владелец;
		НоваяСтрока.КоличествоУпаковок = 1;
		НоваяСтрока.Количество = НоваяСтрока.КоличествоУпаковок;
		НоваяСтрока.Склад = Склад;
		ЗаказНаПроизводствоОбъект.Записать(РежимЗаписиДокумента.Проведение);
		// Теперь создаем этап
		ЭтапОбъект = Документы.ЭтапПроизводства2_2.СоздатьДокумент();
		ЭтапОбъект.Дата = ЗаказНаПроизводствоОбъект.Дата;
		ЭтапОбъект.Распоряжение = ЗаказНаПроизводствоОбъект.Ссылка;
		ЭтапОбъект.Статус = Перечисления.СтатусыЭтаповПроизводства2_2.Начат;
		ЭтапОбъект.ПартияПроизводства = Лико_Планирование.НайтиСоздатьПартиюПроизводства(ЭтапОбъект.Распоряжение);
		ЭтапОбъект.Подразделение = ЭтапОбъект.Распоряжение.Подразделение;
		ЭтапОбъект.Организация = Организация;
		ЭтапОбъект.ВыпускПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		ЭтапОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		ЭтапОбъект.Комментарий = "Этап создан автоматически. Это ""общий"" этап для всех заказов, с момента начала печати которых прошло более 25 дней";
		ЭтапОбъект.НаименованиеЭтапа = "Упаковка";
		ЭтапОбъект.КоличествоУпаковокПлан = 1;
		ЭтапОбъект.МаршрутнаяКарта = Справочники.Лико_ПредопределенныеЗначения.МаршрутнаяКартаУпаковка.ЗначениеПараметра;
		ЭтапОбъект.КоэффициентМаршрутнойКарты = 1;
		ЭтапОбъект.ВидЭтапа = Справочники.Лико_ВидыЭтаповПроизводства.Упаковка;
		ЭтапОбъект.СпособРаспределенияЗатратНаВыходныеИзделия = Перечисления.СпособыРаспределенияЗатратНаВыходныеИзделия.ПоДолямСтоимости;
		ЭтапОбъект.ЯвляетсяНазначениемПродукции = Истина;
		ЭтапОбъект.Лико_ЭтоОбщийЭтапНаМесяц = Истина;
		ЭтапОбъект.ТипПроизводственногоПроцесса = ЗаказНаПроизводствоОбъект.ТипПроизводственногоПроцесса;
		ЭтапОбъект.ЕдиницаИзмеренияДлительностиЭтапа = Перечисления.ЕдиницыИзмеренияВремени.День;
		ЭтапОбъект.ЕдиницаИзмеренияПредварительногоБуфера = Перечисления.ЕдиницыИзмеренияВремени.День;
		ЭтапОбъект.ЕдиницаИзмеренияЗавершающегоБуфера = Перечисления.ЕдиницыИзмеренияВремени.День;
		ЭтапОбъект.ХозяйственнаяОперация = ЗаказНаПроизводствоОбъект.ХозяйственнаяОперация;
		ЭтапОбъект.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
		ЭтапОбъект.Валюта = Константы.ВалютаУправленческогоУчета.Получить();
		//ЭтапОбъект.ЖелаемаяДатаОбеспечения = ЭтапОбъект.Дата;
		ЭтапОбъект.ДополнительныеСвойства.Вставить("Лико_НеРассчитыватьНормативныйГрафик", Истина);
		ЭтапОбъект.Записать(РежимЗаписиДокумента.Проведение);
		ЭтапСсылка = ЭтапОбъект.Ссылка;			
	КонецЕсли;
	Возврат ЭтапСсылка;
	
КонецФункции

Функция НайтиОбщийВыпускающийЭтап(Организация, Подразделение, Дата = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭтапПроизводства2_2.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	|ГДЕ
	|	ЭтапПроизводства2_2.Проведен
	|	И НЕ ЭтапПроизводства2_2.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА &НачалоМесяца = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ НАЧАЛОПЕРИОДА(ЭтапПроизводства2_2.Дата, МЕСЯЦ) = &НачалоМесяца
	|		КОНЕЦ
	|	И ЭтапПроизводства2_2.Лико_ЭтоОбщийЭтапНаМесяц
	|	И ЭтапПроизводства2_2.Подразделение = &Подразделение
	|	И ЭтапПроизводства2_2.Организация = &Организация
	|	И ВЫБОР
	|			КОГДА &НачалоМесяца = НЕОПРЕДЕЛЕНО
	|				ТОГДА ЭтапПроизводства2_2.ВыходныеИзделия.НомерСтроки = 1
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭтапПроизводства2_2.Дата УБЫВ,
	|	ЭтапПроизводства2_2.Номер";
	
	Запрос.УстановитьПараметр("НачалоМесяца", ?(ЗначениеЗаполнено(Дата), НачалоМесяца(Дата), Неопределено));
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("Организация", Организация);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПроверитьЭтоРабочаяБаза() Экспорт
	
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы(); //Пример: Srvr="test-1c";Ref="erp_demo";
	ДлинаСтроки = СтрДлина(СтрокаСоединения);
	//Отрежем имя базы - справа до второй кавычки
	ИмяБазы = "";
	КолКавычек = 0;
	Для сч=1 По ДлинаСтроки Цикл
		ТекСимвол = Сред(СтрокаСоединения, ДлинаСтроки-сч+1, 1);
		Если КолКавычек = 1 И ТекСимвол <> Символ(34) Тогда
			ИмяБазы = ТекСимвол + ИмяБазы;
		КонецЕсли;
		
		Если ТекСимвол = Символ(34) Тогда
			КолКавычек = КолКавычек + 1;
		КонецЕсли;
		Если КолКавычек = 2 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ВРег(ИмяБазы) = ВРег(Справочники.Лико_ПредопределенныеЗначения.ИмяРабочейБазы1с.ЗначениеПараметра) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

