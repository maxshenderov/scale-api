Функция ПроверитьВозможностьСчитыванияКраскиВЗаказ(ОбъектНоменклатурыСерияКодОбъектаНоменклатуры, Заказ, НомерПроката, МассивДоступныхКСписаниюКрасок = Неопределено) Экспорт
	
	Если ТипЗнч(ОбъектНоменклатурыСерияКодОбъектаНоменклатуры) = Тип("Число") Тогда
		// Найдем объект номенклатуры по коду
		ОбъектНоменклатуры = Справочники.ЯССМ_ОбъектыНоменклатуры.НайтиПоКоду(ОбъектНоменклатурыСерияКодОбъектаНоменклатуры);
	ИначеЕсли ТипЗнч(ОбъектНоменклатурыСерияКодОбъектаНоменклатуры) = Тип("СправочникСсылка.СерииНоменклатуры") Тогда
		ОбъектНоменклатуры = ОбъектНоменклатурыСерияКодОбъектаНоменклатуры.ЯССМ_ОбъектНоменклатуры;
	Иначе
		ОбъектНоменклатуры = ОбъектНоменклатурыСерияКодОбъектаНоменклатуры;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Заказ) ИЛИ НЕ ЗначениеЗаполнено(ОбъектНоменклатуры) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если МассивДоступныхКСписаниюКрасок = Неопределено Тогда
		МассивДоступныхКСписаниюКрасок = СформироватьМассивДоступныхКСписаниюКрасок(Заказ, НомерПроката);
	КонецЕсли;
	
	НайденнаяСтрока = МассивДоступныхКСписаниюКрасок.Найти(ОбъектНоменклатуры.Номенклатура);
	
	Возврат НайденнаяСтрока <> Неопределено;
	
КонецФункции

Функция ПроверитьВозможностьСчитыванияКраскиВЗаказМассив(МассивОбъектов, Заказ, НомерПроката) Экспорт
	
	МассивВозврата = Новый Массив;
	МассивДоступныхКСписаниюКрасок = СформироватьМассивДоступныхКСписаниюКрасок(Заказ, НомерПроката);
	
	Для каждого ЭлементМассива из МассивОбъектов Цикл
		Если НЕ ПроверитьВозможностьСчитыванияКраскиВЗаказ(ЭлементМассива, Заказ, НомерПроката, МассивДоступныхКСписаниюКрасок) Тогда
			МассивВозврата.Добавить(ЭлементМассива);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивВозврата;
	
КонецФункции

Функция СформироватьМассивДоступныхКСписаниюКрасок(Заказ, НомерПроката) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаЦвета.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
		|ГДЕ
		|	ЗаказКлиентаЦвета.Ссылка = &ЗаказКлиента
		|	И ЗаказКлиентаЦвета.НомерПроката = &НомерПроката
		|	И ЗаказКлиентаЦвета.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Лико_ПодготовкаМатериаловРезервирование.Номенклатура
		|ИЗ
		|	Документ.Лико_ПодготовкаМатериалов КАК Лико_ПодготовкаМатериалов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_ПодготовкаМатериалов.Резервирование КАК Лико_ПодготовкаМатериаловРезервирование
		|		ПО Лико_ПодготовкаМатериалов.Ссылка = Лико_ПодготовкаМатериаловРезервирование.Ссылка
		|			И (Лико_ПодготовкаМатериаловРезервирование.Номенклатура.ВидНоменклатуры = &ВидНоменклатурыКраска)
		|ГДЕ
		|	Лико_ПодготовкаМатериалов.ЗаказКлиента = &ЗаказКлиента
		|	И Лико_ПодготовкаМатериалов.НомерПроката = &НомерПроката
		|	И Лико_ПодготовкаМатериалов.Проведен
		|	И НЕ Лико_ПодготовкаМатериалов.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ.Номенклатура КАК Номенклатура
		|ИЗ
		|	ВТ КАК ВТ";
	
	Запрос.УстановитьПараметр("ВидНоменклатурыКраска", Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыКраска.ЗначениеПараметра);
	Запрос.УстановитьПараметр("ЗаказКлиента", Заказ);
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
	
КонецФункции

Функция НайтиСоздатьЧестныйЗнак(Gtin, ДатаЭмиссии, Создавать = Истина) Экспорт // --> Начало Лико Ефимов ЕВВ 14.05.2021 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ЧестныйЗнак.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Лико_ЧестныйЗнак КАК Лико_ЧестныйЗнак
		|ГДЕ
		|	Лико_ЧестныйЗнак.Gtin = &Gtin
		|	И Лико_ЧестныйЗнак.ДатаЭмиссии = &ДатаЭмиссии
		|	И НЕ Лико_ЧестныйЗнак.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Gtin", Gtin);
	Запрос.УстановитьПараметр("ДатаЭмиссии", ДатаЭмиссии);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	ИначеЕсли НЕ Создавать Тогда
		Возврат Неопределено;
	Иначе
		НовыйОбъект = Справочники.Лико_ЧестныйЗнак.СоздатьЭлемент();
		НовыйОбъект.Gtin = Gtin;
		НовыйОбъект.ДатаЭмиссии = ДатаЭмиссии;
		НовыйОбъект.Наименование = Лико_ДополнительноКлиентСервер.ПолучитьНаименованиеЧестногоЗнака(НовыйОбъект);
		НовыйОбъект.Записать();
		Возврат НовыйОбъект.Ссылка;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 14.05.2021 

Процедура ПроверитьНеобходимостьИОтправитьПисьмоПоЗабраковкеМатериалов(ДокументСсылка,СтрокаОснастки) Экспорт // --> Начало Лико Ефимов ЕВВ 25.10.2021 
	
	НужноОтправлять = Ложь;
	ТипСообщения = "";
	Если НЕ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Лико_ЗабраковкаОснастки") Тогда 
		Если ЗначениеЗаполнено(ДокументСсылка.Решение) И НЕ ДокументСсылка.ПисьмоПоРешениюОтправлено Тогда
			НужноОтправлять = Истина;
			ТипСообщения = "ПоРешению";
		КонецЕсли;
		Если ЗначениеЗаполнено(ДокументСсылка.ТипВозвратаПоставщику) И НЕ ДокументСсылка.ПисьмоКладовщикамОтправлено Тогда
			НужноОтправлять = Истина;
			ТипСообщения = "Кладовщикам";
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(СтрокаОснастки.Решение) И НЕ СтрокаОснастки.ПисьмоПоРешениюОтправлено Тогда
			НужноОтправлять = Истина;
			ТипСообщения = "ПоРешению";
		КонецЕсли;
	КонецЕсли;
	
	Если НужноОтправлять Тогда
		СтруктураДляЗаполненя = ПолучитьДанныеДляОтправкиПисьмаЗаброковкиМатериалов(ДокументСсылка,СтрокаОснастки);
		Если НЕ СтруктураДляЗаполненя = Неопределено Тогда
			Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Лико_ЗабраковкаОснастки") Тогда 
				Макет = Документы.Лико_ЗабраковкаОснастки.ПолучитьМакет("ФормаПисьмаДляЭлектроннойПочты");
			Иначе	
				Макет = Документы.Лико_ЗабраковкаМатериалов.ПолучитьМакет("ФормаПисьмаДляЭлектроннойПочты");
			КонецЕсли;
			ЗаполнениеТабличногоДокументаПисьмаИОтправка(СтруктураДляЗаполненя, ТипСообщения, ПараметрыСеанса.ТекущийПользователь, Макет);
			ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			Если НЕ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Лико_ЗабраковкаОснастки") Тогда 
				ДокументОбъект["Письмо" + ТипСообщения + "Отправлено"] = Истина; 
			Иначе
				ДокументОбъект.Товары.НайтиСтроки(Новый Структура("Серия",СтрокаОснастки.Серия))[0].ПисьмоПоРешениюОтправлено = Истина; 
			КонецЕсли;
			ДокументОбъект.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 25.10.2021

Функция ЭтоЗаявкаТехнологамНаЗабраковкуМатериалов(Заявка) Экспорт // --> Начало Лико Ефимов ЕВВ 26.10.2021
	
	Если ЗначениеЗаполнено(Заявка)
		И Заявка.Секции.Количество() > 0 И Заявка.Секции[0].Причина = Справочники.ТС_ПричиныРемонтаРабочихЦентров.ЗабраковкаМатериала
		И ЗначениеЗаполнено(Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаРаботыСЗабраковкойМатериалов.ЗначениеПараметра)
		И Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаРаботыСЗабраковкойМатериалов.ЗначениеПараметра <= Заявка.Дата
		Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 26.10.2021  

Функция ЭтоЗаявкаТехнологамНаЗабраковкуОснастки(Заявка) Экспорт // --> Начало Лико Яцун 24.08.2022
	
	Если ЗначениеЗаполнено(Заявка)
