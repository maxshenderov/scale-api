КонецФункции // <-- Конец Лико Ефимов ЕВВ 09.08.2017

Функция УдалитьИзЭтаповСтрокиВыпускаПоСвязанномуФормированиюПаллета(ФормированиеПаллета, ДопСвойстваДляОбъектаЭтапа = Неопределено, ЗаказКлиента = Неопределено) Экспорт // --> Начало Лико Ефимов ЕВВ 27.11.2017
	
	Отказ = Ложь;
	
	Если ФормированиеПаллета = Неопределено Тогда
		Сообщить("Не удалось удалить строки выпуска из этапа, т.к. переданный документ ""лк Формирование паллета"" не определен");
		Отказ = Истина;
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК ТиповойДокумент
		|ИЗ
		|	РегистрСведений.Лико_СвязиСТиповымиДокументами КАК Лико_СвязиСТиповымиДокументами
		|ГДЕ
		|	Лико_СвязиСТиповымиДокументами.Документ = &ФормированиеПаллета
		|	И Лико_СвязиСТиповымиДокументами.ТиповойДокумент ССЫЛКА Документ.ЭтапПроизводства2_2
		|	И ВЫБОР
		|			КОГДА &Заказ = НЕОПРЕДЕЛЕНО
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК Документ.ЭтапПроизводства2_2).ВыходныеИзделия.Характеристика.Лико_ЗаказНоменклатуры = &Заказ
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	Лико_СвязиСТиповымиДокументами.ТиповойДокумент";
		
		Запрос.УстановитьПараметр("ФормированиеПаллета", ФормированиеПаллета);
		Запрос.УстановитьПараметр("Заказ", ЗаказКлиента);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Этап = ВыборкаДетальныеЗаписи.ТиповойДокумент;
			
			ЭтапОбъект = Этап.ПолучитьОбъект();
			Если ДопСвойстваДляОбъектаЭтапа <> Неопределено Тогда
				Для каждого Свойство из ДопСвойстваДляОбъектаЭтапа Цикл
					ЭтапОбъект.ДополнительныеСвойства.Вставить(Свойство.Ключ, Свойство.Значение);
				КонецЦикла;
			КонецЕсли;
			НайденныеСтроки = ЭтапОбъект.ВыходныеИзделия.НайтиСтроки(Новый Структура("Лико_ФормированиеПаллета", ФормированиеПаллета));
			Если НайденныеСтроки.Количество() > 0 Тогда
				Для каждого Строка из НайденныеСтроки Цикл
					Если ЗначениеЗаполнено(ЗаказКлиента) И Строка.Характеристика.Лико_ЗаказНоменклатуры <> ЗаказКлиента Тогда
						Продолжить;
					КонецЕсли;
					ЭтапОбъект.ВыходныеИзделия.Удалить(Строка);
				КонецЦикла;
				Попытка
					Если ЭтапОбъект.Проведен Тогда
						ЭтапОбъект.Записать(РежимЗаписиДокумента.Проведение);
					Иначе
						ЭтапОбъект.Записать(РежимЗаписиДокумента.Запись);
					КонецЕсли;
				Исключение
					Сообщить("Не удалось удалить строки выпуска из документа " + Этап + ": " + ОписаниеОшибки());
					Отказ = Истина;
					Прервать;
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
	Если Отказ Тогда
		ОтменитьТранзакцию();
	КонецЕсли;
	
	Возврат НЕ Отказ;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 27.11.2017

Функция НайтиВыпускающийЭтапПоЗаказуНаПроизводство(ЗаказНаПроизводство, ОтменятьТранзакцию = Истина) Экспорт // --> Начало Лико Ефимов ЕВВ 27.11.2017 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭтапПроизводства2_2.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	|ГДЕ
	|	ЭтапПроизводства2_2.Распоряжение = &ЗаказНаПроизводство
	|	И ЭтапПроизводства2_2.Проведен
	|	И ЭтапПроизводства2_2.НомерСледующегоЭтапа = 0
	|	И НЕ ЭтапПроизводства2_2.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ЗаказНаПроизводство", ЗаказНаПроизводство);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Если Таблица.Количество() = 1 Тогда
		ЭтапСсылка = Таблица[0].Ссылка;
		Возврат ЭтапСсылка;
	Иначе
		Если Таблица.Количество() = 0 Тогда
			Сообщить("По документу " + ЗаказНаПроизводство + " не найдено ни одного выпускающего этапа.");
		Иначе
			Сообщить("По документу " + ЗаказНаПроизводство + " найдено несколько выпускающих этапов.");
		КонецЕсли;
		Если ОтменятьТранзакцию Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 27.11.2017

Функция НайтиВыпускающийЭтапПоЗаказуКлиента(ЗаказКлиента, Организация = Неопределено, ОтменятьТранзакцию = Истина) Экспорт // --> Начало Лико Ефимов ЕВВ 27.11.2017 

	Если НЕ ЗначениеЗаполнено(ЗаказКлиента) Тогда
		Сообщить("В функцию НайтиВыпускающийЭтапПоЗаказуКлиента не передан заказ клиента"); 
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ЗаказКлиента) <> Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Сообщить("В функцию НайтиВыпускающийЭтапПоЗаказуКлиента передан не заказ клиента"); 
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭтапПроизводства2_2.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	|ГДЕ
	|	ЭтапПроизводства2_2.Лико_ЗаказКлиента = &ЗаказКлиента
	|	И ЭтапПроизводства2_2.Проведен
	|	И НЕ ЭтапПроизводства2_2.ПометкаУдаления
	|	И ЭтапПроизводства2_2.НомерСледующегоЭтапа = 0
	|	И ВЫБОР
	|			КОГДА &Организация = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЭтапПроизводства2_2.Организация = &Организация
	|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Если Таблица.Количество() = 1 Тогда
		ЭтапСсылка = Таблица[0].Ссылка;
		Возврат ЭтапСсылка;
	Иначе
		Если Таблица.Количество() = 0 Тогда
			Сообщить("По документу " + ЗаказКлиента + " не найдено ни одного выпускающего этапа.");
		Иначе
			// Найдено несколько выпускающих этапов. Ограничим поиск по организации
			ОрганизацияПользователя = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитПользователяОрганизация", ПараметрыСеанса.ТекущийПользователь);
			Если Организация = Неопределено И ЗначениеЗаполнено(ОрганизацияПользователя) Тогда
				Возврат НайтиВыпускающийЭтапПоЗаказуКлиента(ЗаказКлиента, ОрганизацияПользователя);
			КонецЕсли;
			Сообщить("По документу " + ЗаказКлиента + " найдено несколько выпускающих этапов.");
		КонецЕсли;
		Если ОтменятьТранзакцию Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 27.11.2017

Функция ПолучитьДанныеВодУдостоверения(Водитель, Дата) Экспорт // --> Начало Лико Ефимов ЕВВ 19.12.2017 
	
	Параметры = Новый Структура;
	Параметры.Вставить("ВодительФИО");
	Параметры.Вставить("УдостоверениеСерия");
	Параметры.Вставить("УдостоверениеНомер");
	// --> Начало Лико Яцун 05.03.2022
	Параметры.Вставить("Лико_ДатаВыдачиУдостоверения");
    // <-- Конец Лико Яцун 05.03.2022 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ФизическиеЛица.Наименование КАК ВодительФИО,
	|	ДокументыФизическихЛиц.Серия КАК УдостоверениеСерия,
	|	ДокументыФизическихЛиц.Номер КАК УдостоверениеНомер,
	// --> Начало Лико Яцун 05.03.2022
	|	ДокументыФизическихЛиц.ДатаВыдачи КАК Лико_ДатаВыдачиУдостоверения
	// <-- Конец Лико Яцун 05.03.2022
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(&Период, ) КАК ДокументыФизическихЛиц
	|		ПО ФизическиеЛица.Ссылка = ДокументыФизическихЛиц.Физлицо
	|			И (ДокументыФизическихЛиц.ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение))
	|ГДЕ
	|	ФизическиеЛица.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Водитель);
	Запрос.УстановитьПараметр("Период", Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Параметры, Выборка);
	КонецЕсли;			
	
	Возврат Параметры;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 19.12.2017

Функция СоздатьРазмещениеТоваровНаОснованииПриходногоОрдера(ПриходныйОрдерНаТовары, УжеСозданныйДокумент, ЯчейкаПолучатель) Экспорт
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйДокОбъект = Документы.ОтборРазмещениеТоваров.СоздатьДокумент();
	
	НовыйДокОбъект.Заполнить(ПриходныйОрдерНаТовары);
	НовыйДокОбъект.Дата = ПриходныйОрдерНаТовары.Дата;
	НовыйДокОбъект.Ответственный = ПриходныйОрдерНаТовары.Ответственный;
	НовыйДокОбъект.Комментарий = ПриходныйОрдерНаТовары.Комментарий;
	
	//Система автоматом распределила товар по ячейкам, а нам нужно весть товар положить в ЯчейкаПолучатель
	Для каждого СтрокаТЧ из НовыйДокОбъект.ТоварыРазмещение Цикл
		СтрокаТЧ.Ячейка = ЯчейкаПолучатель;
	КонецЦикла;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		//чтобы отработали проверки при проведении отбора, его сперва нужно провести в статусе "В работе" или "Подготовлено", а уже потом в статусе "Выполнено без ошибок"
		//(если провести сразу в статусе "Выполнено без ошибок", то проверок не будет и документ без проблем проведется)
		//Если НЕ ОтключитьЧастьПроверок Тогда
		// С такими проверками невозможно перепровести документ задним числом (если коробки после этого имеют другие движения), закомментим пока
		//НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//КонецЕсли;
		//меняем статус и проводим еще раз
		НовыйДокОбъект.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.ВыполненоБезОшибок;
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//Лико_ДополнительноКлиентСервер.СообщитьДляКлиента(?(УжеСозданныйДокумент = Неопределено, "Создан", "Перезаполнен") + " документ """ + НовыйДокОбъект + """");
	Исключение
		Отказ = Истина;
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;	
	
КонецФункции

Функция СоздатьДокументРасходныйОрдерНаТоварыНаОснованииРаспоряжения(УжеСозданныйДокумент = Неопределено, ТаблицаСерий, Распоряжение) Экспорт
	
	// Протестировано на документах распоряжениях РеализацияТоваровУслуг, ОтгрузкаТоваровСХранения, ПеремещениеТоваров, ВнутреннееПотреблениеТоваров, СборкаТоваров
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	ТоварыБезСерий = ТаблицаСерий.Скопировать();
	ТоварыБезСерий.Свернуть("Номенклатура,Характеристика", "Количество");
	Если ТоварыБезСерий.Количество() = 0 Тогда
		ОтменитьТранзакцию();
		Возврат Неопределено;
	КонецЕсли;
	
	НовыйДокОбъект = Документы.РасходныйОрдерНаТовары.СоздатьДокумент();
	НовыйДокОбъект.Дата = Распоряжение.Дата;
	НовыйДокОбъект.ДатаОтгрузки = НовыйДокОбъект.Дата;
	НовыйДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	НовыйДокОбъект.Приоритет = Справочники.Приоритеты.ПолучитьПриоритетПоУмолчанию();
	Если ТипЗнч(Распоряжение) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		НовыйДокОбъект.Склад = Распоряжение.Склад;
		НовыйДокОбъект.Получатель = Распоряжение.Партнер;
		НовыйДокОбъект.СкладскаяОперация = Перечисления.СкладскиеОперации.ОтгрузкаКлиенту;
	ИначеЕсли ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ОтгрузкаТоваровСХранения") Тогда
		НовыйДокОбъект.Склад = Распоряжение.Склад;
		НовыйДокОбъект.Получатель = Распоряжение.Партнер;
		НовыйДокОбъект.СкладскаяОперация = Перечисления.СкладскиеОперации.ОтгрузкаПоВозвратуПоставщику;
	ИначеЕсли ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		НовыйДокОбъект.Склад = Распоряжение.СкладОтправитель;
		НовыйДокОбъект.Получатель = Распоряжение.СкладПолучатель;
		НовыйДокОбъект.СкладскаяОперация = Перечисления.СкладскиеОперации.ОтгрузкаПоПеремещению;
	ИначеЕсли ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ВнутреннееПотребление") Тогда
		НовыйДокОбъект.Склад = Распоряжение.Склад;
		НовыйДокОбъект.Получатель = Распоряжение.Подразделение;
		НовыйДокОбъект.СкладскаяОперация = Перечисления.СкладскиеОперации.ОтгрузкаНаВнутренниеНужды;
	ИначеЕсли ТипЗнч(Распоряжение) = Тип("ДокументСсылка.СборкаТоваров") Тогда
		НовыйДокОбъект.Склад = Распоряжение.Склад;
		НовыйДокОбъект.Получатель = НовыйДокОбъект.Склад;
		НовыйДокОбъект.СкладскаяОперация = Перечисления.СкладскиеОперации.ОтгрузкаКомплектующихДляСборки;
	Иначе
		// При необходимости дописать другие типы распоряжений
		Сообщить("Тип распоряжения """ + ТипЗнч(Распоряжение) + """ не предусмотрен разработчиками. Обратитесь к программистам");
	КонецЕсли;
	НовыйДокОбъект.ЗонаОтгрузки = Лико_Дополнительно.ПолучитьЗонуОтгрузкиПоСкладу(НовыйДокОбъект.Склад);
	НовыйДокОбъект.Комментарий = Распоряжение.Комментарий;
	Если НовыйДокОбъект.Склад.ИспользоватьАдресноеХранение Тогда
		НовыйДокОбъект.Статус = Перечисления.СтатусыРасходныхОрдеров.КОтбору;
	Иначе
		НовыйДокОбъект.Статус = Перечисления.СтатусыРасходныхОрдеров.Отгружен;
	КонецЕсли;
	
	Для каждого Строка из ТоварыБезСерий Цикл
		НоваяСтрокаТоварыПоРаспоряжениям = НовыйДокОбъект.ТоварыПоРаспоряжениям.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТоварыПоРаспоряжениям, Строка);
		НоваяСтрокаТоварыПоРаспоряжениям.Распоряжение = Распоряжение;
		
	КонецЦикла;
	
	Для каждого СтрокаСерии из ТаблицаСерий Цикл
		НоваяСтрокаОтгружаемыеТовары = НовыйДокОбъект.ОтгружаемыеТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаОтгружаемыеТовары, СтрокаСерии);
		Если НЕ ЗначениеЗаполнено(НоваяСтрокаОтгружаемыеТовары.СтатусУказанияСерий) Тогда
			НоваяСтрокаОтгружаемыеТовары.СтатусУказанияСерий = 8;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НоваяСтрокаОтгружаемыеТовары.КоличествоУпаковок) Тогда
			НоваяСтрокаОтгружаемыеТовары.КоличествоУпаковок = НоваяСтрокаОтгружаемыеТовары.Количество;
		КонецЕсли;
		
		Если НовыйДокОбъект.Склад.ИспользоватьАдресноеХранение Тогда
			НоваяСтрокаОтгружаемыеТовары.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отобрать;
		Иначе
			НоваяСтрокаОтгружаемыеТовары.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить;
		КонецЕсли;
	КонецЦикла;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;                  
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция СоздатьДокументВнутреннееПотребление(Таблица, УжеСозданныйДокумент = Неопределено, СтруктураПараметров) Экспорт
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйДокОбъект = Документы.ВнутреннееПотребление.СоздатьДокумент();
	НовыйДокОбъект.Дата = СтруктураПараметров.Дата;
	НовыйДокОбъект.Организация = СтруктураПараметров.Организация;
	НовыйДокОбъект.Склад = СтруктураПараметров.Склад;
	НовыйДокОбъект.Ответственный = СтруктураПараметров.Ответственный;
	НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + СтруктураПараметров.Основание + """";
	НовыйДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию;
	НовыйДокОбъект.Подразделение = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, НовыйДокОбъект.Склад, "Подразделение_8b6aafc5a2e14ba0889da315170788bd");
	НовыйДокОбъект.Статус = Перечисления.СтатусыВнутреннихПотреблений.Принято; 
	НовыйДокОбъект.ПотреблениеДляДеятельности = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	
	Если СтруктураПараметров.ЭтоСписаниеСПроизводителя Тогда
		СтатьяРасходов = Справочники.Лико_ПредопределенныеЗначения.СтатьяРасходовДляСписанияГП.ЗначениеПараметра;
	Иначе
		СтатьяРасходов = Справочники.Лико_ПредопределенныеЗначения.СтатьяРасходовДляСписанияГПСОрганизацииПродавца.ЗначениеПараметра;
		//НовыйДокОбъект.Дата = КонецМесяца(НовыйДокОбъект.Дата);
	КонецЕсли;
	//НовыйДокОбъект.ДатаРаспоряжения = НовыйДокОбъект.Дата; // в 2.5 этого реквизита нет
	
	Для каждого Строка из Таблица Цикл
		НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,, "Упаковка");
		НоваяСтрока.Количество = Строка.КоличествоОтгружено;
		НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		НоваяСтрока.СтатьяРасходов = СтатьяРасходов;
		Если СтатьяРасходов.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Партнеры") Тогда 
			НоваяСтрока.АналитикаРасходов = Строка.ЗаказКлиента.Партнер;
		ИначеЕсли СтатьяРасходов.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия") Тогда 
			НоваяСтрока.АналитикаРасходов = НовыйДокОбъект.Подразделение;
		Иначе
			Сообщить("Для статьи """ + СтатьяРасходов + """ указан тип аналитики """ + СтатьяРасходов.ТипЗначения + """, который не предусмотрен разработчиками");
		КонецЕсли;
	КонецЦикла;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция СоздатьДокументПриходныйОрдерНаТоварыНаОснованииРаспоряжения(Распоряжение, УжеСозданныйДокумент = Неопределено, ТаблицаСерий) Экспорт
	
	// Протестировано на документах распоряжениях ПриемкаТоваровНаХранение, ПеремещениеТоваров, СборкаТоваров
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйДокОбъект = Документы.ПриходныйОрдерНаТовары.СоздатьДокумент();
	
	Если ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ПриемкаТоваровНаХранение") Тогда
		НовыйДокОбъект.СкладскаяОперация = Перечисления.СкладскиеОперации.ПриемкаОтПоставщика;
		НовыйДокОбъект.Склад = Распоряжение.Склад;
		НовыйДокОбъект.Ответственный = Распоряжение.Менеджер;
		НовыйДокОбъект.Отправитель = Распоряжение.Партнер;
	ИначеЕсли ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		НовыйДокОбъект.СкладскаяОперация = Перечисления.СкладскиеОперации.ПриемкаПоПеремещению;
		НовыйДокОбъект.Склад = Распоряжение.СкладПолучатель;
		НовыйДокОбъект.Ответственный = Распоряжение.Ответственный;
		НовыйДокОбъект.Отправитель = Распоряжение.СкладОтправитель;
	ИначеЕсли ТипЗнч(Распоряжение) = Тип("ДокументСсылка.СборкаТоваров") Тогда
		НовыйДокОбъект.СкладскаяОперация = Перечисления.СкладскиеОперации.ПриемкаСобранныхКомплектов;
		НовыйДокОбъект.Склад = Распоряжение.Склад;
		НовыйДокОбъект.Ответственный = Распоряжение.Ответственный;
		НовыйДокОбъект.Отправитель = НовыйДокОбъект.Склад;
	Иначе
		// При необходимости дописать другие типы распоряжений
		Сообщить("Тип распоряжения """ + ТипЗнч(Распоряжение) + """ не предусмотрен разработчиками. Обратитесь к программистам");
	КонецЕсли;
	
	НовыйДокОбъект.Дата = Распоряжение.Дата;
	НовыйДокОбъект.Распоряжение = Распоряжение;
	НовыйДокОбъект.Статус = Перечисления.СтатусыПриходныхОрдеров.Принят;
	НовыйДокОбъект.Исполнитель = НовыйДокОбъект.Ответственный;
	Если НовыйДокОбъект.Склад.ИспользоватьАдресноеХранение Тогда
		НовыйДокОбъект.ЗонаПриемки = Лико_Дополнительно.ПолучитьЗонуПриемкиПоСкладу(НовыйДокОбъект.Склад);
	КонецЕсли;
	НовыйДокОбъект.Комментарий = Распоряжение.Комментарий;
	НовыйДокОбъект.ХозяйственнаяОперация = Распоряжение.ХозяйственнаяОперация;
	НовыйДокОбъект.Лико_АвторДокумента = НовыйДокОбъект.Исполнитель;
	НовыйДокОбъект.НомерВходящегоДокумента = Распоряжение.Номер;
	НовыйДокОбъект.ДатаВходящегоДокумента = Распоряжение.Дата;
	
	Для каждого Строка из ТаблицаСерий Цикл
		
		НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.СтатусУказанияСерий) Тогда
			НоваяСтрока.СтатусУказанияСерий = 8;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.КоличествоУпаковок) Тогда
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		КонецЕсли;
		
	КонецЦикла;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции 

Функция СформироватьТекстДляСкрипта(ЗаказКлиента,НомерМонтажа,Отказ, РасшифровкаОтказа="") Экспорт
	
	НомерЗаказа=ЗаказКлиента.НомерБезПрефикса;
	Товары=ЗаказКлиента.Товары.Выгрузить();
	Цвета=ЗаказКлиента.Цвета.Выгрузить();
	Соответствия=ЗаказКлиента.МонтажСоответствия.Выгрузить();
	Схема = ЗаказКлиента.МонтажСхема.Выгрузить();

	Текст = "";
	Спецификация=ЗаказКлиента;
	//СтрокаТовары = Номенклатура;
	//СтрокаТовары=ДокЗаявкаНаДизайн.ЗаказПокупателя.Товары[НомерСтроки-1];

	// параметры штампа
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказКлиента.ШтампВырубной КАК Штамп,
	|	Лико_ПараметрыШтампа.ВидРабот КАК ВидРабот,
