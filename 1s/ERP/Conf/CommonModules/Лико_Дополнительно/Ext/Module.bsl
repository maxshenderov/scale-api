					Если ЗначениеЗаполнено(СтрокаТЧ.Серия) Тогда
						НоваяСтрокаТЗ = ТЗСерий.Добавить();
						НоваяСтрокаТЗ.Серия = СтрокаТЧ.Серия;
					Иначе
