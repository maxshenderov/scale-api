		Если Источник.Товары.Количество() > 0 И ЗначениеЗаполнено(Источник.Товары[0].Характеристика.Лико_ЗаказНоменклатуры.Менеджер) Тогда
			Источник.Менеджер = Источник.Товары[0].Характеристика.Лико_ЗаказНоменклатуры.Менеджер;
