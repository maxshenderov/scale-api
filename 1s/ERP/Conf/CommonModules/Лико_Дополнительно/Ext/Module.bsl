Функция ПосчитатьКонтрольнуюСуммуШК(ШКбезКС) Экспорт
	
	КС = 0;
	Для Ц = 1 по СтрДлина(ШКбезКС) Цикл
		Попытка
			КС = КС + Число(Сред(ШКбезКС, Ц, 1));
		Исключение
		КонецПопытки;
	КонецЦикла;	
	
	Возврат Прав(СокрЛП(КС),1);
	
КонецФункции

Функция ПосчитатьКонтрольнуюСуммуШКВСистемеGS1_13(ШКбезКС) Экспорт
	
	Если НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ШКбезКС) Тогда
		Возврат "";
	КонецЕсли;
	
	ШтрихкодСПраваНалево = "";
	ДлинаШтрихкода = СтрДлина(ШКбезКС);
	Для сч = 0 по ДлинаШтрихкода - 1 Цикл
		ШтрихкодСПраваНалево = ШтрихкодСПраваНалево + Сред(ШКбезКС, ДлинаШтрихкода - сч, 1);
	КонецЦикла;
	СуммаЧетных = 0;
	СуммаНеЧетных = 0;
	Для сч = 1 по ДлинаШтрихкода Цикл
		ТекЦифра = Число(Сред(ШтрихкодСПраваНалево, сч, 1));
		Если сч % 2 = 0 Тогда
			СуммаЧетных = СуммаЧетных + ТекЦифра;
		Иначе
			СуммаНеЧетных = СуммаНеЧетных + ТекЦифра;
		КонецЕсли;
	КонецЦикла;
	СуммаЧетныхИУтроенныхНечетных = СуммаЧетных + 3*СуммаНеЧетных;
	ПоследнийСимвол = Прав(Формат(СуммаЧетныхИУтроенныхНечетных, "ЧДЦ=0; ЧН=0; ЧГ=0"), 1);
	Если ПоследнийСимвол = "0" Тогда
		КС = "0";
	Иначе
		КС = Строка(10 - Число(ПоследнийСимвол));
	КонецЕсли;
	
	Возврат КС;
	
КонецФункции

Функция ВычислитьКонтрольнуюСумму(ШК) Экспорт
	
	Возврат ШК + ПосчитатьКонтрольнуюСуммуШК(ШК);
	
КонецФункции

Процедура ОбработкаШК_Паллет(ДанныеШК, ФормаКлиента, Результат, ГП = Ложь)
	
