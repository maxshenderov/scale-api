			ЭтапОбъект.Записать(?(ЭтапОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
			ЗафиксироватьТранзакцию();
		Исключение
			Попытка
				ЭтапОбъект =  Этап.ПолучитьОбъект();
				ЭтапОбъект.Статус = НовыйСтатус;
				ЭтапОбъект.Записать(?(ЭтапОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
				ЗафиксироватьТранзакцию();
			Исключение
				Попытка
					ЭтапОбъект =  Этап.ПолучитьОбъект();
					ЭтапОбъект.Статус = НовыйСтатус;
					ЭтапОбъект.Записать(?(ЭтапОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
					ЗафиксироватьТранзакцию();
				Исключение
					ОтменитьТранзакцию();
					СобытиеЖурналаРегистрации = НСтр(
					"ru = 'Изменение статуса этапа производства из обработки планирования РЦ'",
					ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
					ЗаписьЖурналаРегистрации(
					СобытиеЖурналаРегистрации,
					УровеньЖурналаРегистрации.Ошибка,
					Этап.Метаданные(),
					Этап,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					ВызватьИсключение;
				КонецПопытки;
			КонецПопытки;
		КонецПопытки;
	КонецПопытки;
	
