	Иначе 
		ПараметрыПисьма = Неопределено;
	КонецЕсли;
	
	Если НЕ ПараметрыПисьма = Неопределено Тогда
		// --> Начало Лико Ефимов ЕВВ 10.12.2021
		//Идентификатор = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
		ПараметрыПисьма.Тело = СтрЗаменить(ПараметрыПисьма.Тело, "№", "N");
