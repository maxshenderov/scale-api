Функция ПолучитьНомерКоробкиДляНовойСерии(МассивХарактеристик) Экспорт
	
	Если ТипЗнч(МассивХарактеристик) = Тип("Массив") Тогда
		МассивХарактеристикПриведенный = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(МассивХарактеристик);		
	Иначе
		МассивХарактеристикПриведенный = Новый Массив;
		МассивХарактеристикПриведенный.Добавить(МассивХарактеристик);
	КонецЕсли;
	
	//получим последний номер коробки по данным характеристик
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СерииНоменклатуры.Ссылка,
		|	СерииНоменклатуры.Лико_НомерКоробки КАК НомерКоробки
		|ИЗ
		|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
		|ГДЕ
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец В (&Характеристики)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СерииНоменклатуры.Лико_НомерКоробки УБЫВ";
	
	Запрос.УстановитьПараметр("Характеристики", МассивХарактеристикПриведенный);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.НомерКоробки) Тогда
		НомерКоробки = Выборка.НомерКоробки + 1;
	Иначе
		НомерКоробки = 1;
	КонецЕсли;
	
	Возврат НомерКоробки;
	
КонецФункции

Функция ПолучитьШтрихКодЯчейки(Ячейка) Экспорт
	Перем ШК;
	
	Если СокрЛП(Ячейка.Лико_КодУПП) = "" Тогда
		Сообщить("У ячейки """ + Ячейка + """ не заполнен Лико_КодУПП");
		Возврат "";
	КонецЕсли;
	
	ШК = "8" + СобратьПолныйКодЯчейки(,Ячейка); //8-код штрих-кода Адреса хранения
	ШК = ШК + Лико_Дополнительно.ПосчитатьКонтрольнуюСуммуШК(ШК);
	
	Возврат ШК;
КонецФункции

Функция ПолучитьКраткийШтрихКодЯчейки(Ячейка) Экспорт
	Перем ШК;
	
	ОграничениеУровня = 4;
	
	ШК = "8" + СобратьПолныйКодЯчейки(ОграничениеУровня, Ячейка);
	ШК = ШК + Лико_Дополнительно.ПосчитатьКонтрольнуюСуммуШК(ШК);
	
	Возврат ШК;
КонецФункции

Функция СобратьПолныйКодЯчейки(ДоУровня=0, Ячейка) Экспорт
	Перем ПолныйКод;
	
	ПолныйКод = ""+Формат(Число(Ячейка.Лико_КодУПП), "ЧЦ=2; ЧВН=");
	
	времРодитель = Ячейка.Родитель;
	Для У=1 По Ячейка.Уровень() Цикл
		Если ДоУровня=0 Или У<=ДоУровня Тогда
			ПолныйКод = Формат(Число(времРодитель.Лико_КодУПП), "ЧЦ=2; ЧВН=") + ПолныйКод;
			времРодитель = времРодитель.Родитель;
		КонецЕсли;
	КонецЦикла;
	
	Если ДоУровня=0 Тогда
		ДлинаПолногоКода = 16;
	Иначе
		ДлинаПолногоКода = 2 * ДоУровня;
	КонецЕсли;
	
	НадоДобавитьНулей = ДлинаПолногоКода - СтрДлина(ПолныйКод);
	Для Ц=1 По НадоДобавитьНулей Цикл
		ПолныйКод = ПолныйКод + "0";
	КонецЦикла;
	
	Возврат ПолныйКод;
КонецФункции

Процедура ОбработкаШК_АдресХранения(ДанныеШК, ФормаКлиента, Результат)
	
	ПолныйКод = ПолучитьПолныйКодИзШКАдреса(ДанныеШК.КодИнформации);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СкладскиеЯчейки.Ссылка КАК Ячейка,
	|	ВЫБОР
	|		КОГДА СкладскиеЯчейки.Родитель.Родитель.Родитель.Родитель.Родитель <> &ПустаяЯчейка
	|			ТОГДА СкладскиеЯчейки.Родитель.Родитель.Родитель.Родитель.Родитель.Лико_КодУПП
	|		ИНАЧЕ """"
	|	КОНЕЦ + ВЫБОР
	|		КОГДА СкладскиеЯчейки.Родитель.Родитель.Родитель.Родитель <> &ПустаяЯчейка
	|			ТОГДА СкладскиеЯчейки.Родитель.Родитель.Родитель.Родитель.Лико_КодУПП
	|		ИНАЧЕ """"
	|	КОНЕЦ + ВЫБОР
	|		КОГДА СкладскиеЯчейки.Родитель.Родитель.Родитель <> &ПустаяЯчейка
	|			ТОГДА СкладскиеЯчейки.Родитель.Родитель.Родитель.Лико_КодУПП
	|		ИНАЧЕ """"
	|	КОНЕЦ + ВЫБОР
	|		КОГДА СкладскиеЯчейки.Родитель.Родитель <> &ПустаяЯчейка
	|			ТОГДА СкладскиеЯчейки.Родитель.Родитель.Лико_КодУПП
	|		ИНАЧЕ """"
	|	КОНЕЦ + ВЫБОР
	|		КОГДА СкладскиеЯчейки.Родитель <> &ПустаяЯчейка
	|			ТОГДА СкладскиеЯчейки.Родитель.Лико_КодУПП
	|		ИНАЧЕ """"
	|	КОНЕЦ + СкладскиеЯчейки.Лико_КодУПП КАК ПолныйКод
	|ПОМЕСТИТЬ ВТ_ЯчейкиСПолнымКодом
	|ИЗ
	|	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
	|ГДЕ
	|	НЕ СкладскиеЯчейки.ЭтоГруппа
	|	И НЕ СкладскиеЯчейки.Лико_КодУПП = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЯчейкиСПолнымКодом.Ячейка
	|ИЗ
	|	ВТ_ЯчейкиСПолнымКодом КАК ВТ_ЯчейкиСПолнымКодом
	|ГДЕ
	|	ВТ_ЯчейкиСПолнымКодом.ПолныйКод = &ПолныйКод";
	
	Запрос.УстановитьПараметр("ПустаяЯчейка", Справочники.СкладскиеЯчейки.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПолныйКод", ПолныйКод);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		АдресаХранения = Выборка.Ячейка;
	Иначе
		АдресаХранения = Неопределено;
	КонецЕсли;
	
	Если АдресаХранения = Неопределено ИЛИ АдресаХранения = Справочники.СкладскиеЯчейки.ПустаяСсылка() Тогда
		Результат.Ошибка = "Не найден Адрес хранения с кодом " + ДанныеШК.КодИнформации;
		Возврат;
	КонецЕсли;
	
	Результат.Вставить("АдресаХранения", АдресаХранения);
	
	//если есть на форме нужный реквизит или обработчик добавления, то 
	Если ФормаКлиента <> Неопределено Тогда
		Если ФормаКлиента.Элементы.Найти("АдресХранения") <> Неопределено Тогда
			ФормаКлиента.АдресХранения = Результат.АдресаХранения;
		КонецЕсли;		
		Попытка
			ФормаКлиента.ВыбратьАдрес(АдресаХранения);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПолныйКодИзШКАдреса(ШтрихКод)
	Перем ШК, Код, ПолныйКод;
	
	ПолныйКод = "";
	ШК = СокрЛП(ШтрихКод);
	Для Ц = 1 По СтрДлина(ШК) Цикл
		Код = Сред(ШК, Ц, 2);
		Если Число(Код) = 0 Тогда
			Прервать;
		Иначе 
			ПолныйКод = ПолныйКод + Код;
		КонецЕсли;
		Ц = Ц + 1;
	КонецЦикла;
	
	Возврат ПолныйКод;
КонецФункции // ПолучитьПолныйКодИзШК()

