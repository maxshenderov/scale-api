Процедура СформироватьПоЗакрытиюБланка(Документ,Отказ) Экспорт //+Лико m.shenderov 20.08.2018
	
	//Отказ=Ложь;
	//Если НЕ Документ.ЗаказПокупателя.ДавальческоеСырье Тогда 
	Если Не ЭтоЗаказНаПереработку(Документ.ЗаказПокупателя) Тогда
		Отказ=Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Заказ не является заказом на переработку!";
		Сообщение.Сообщить();
	КонецЕсли;
	
	Заказчик                             =ОпределитьЗаказчикаПереработки(Документ); 
	Если Заказчик= Неопределено  Тогда
		Отказ=Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не определен заказчик!";
		Сообщение.Сообщить();
	КонецЕсли;
	
	Переработчик =ОпределитьПереработчика(Документ);         
	Если Переработчик=Неопределено ТОгда
		
		Отказ=Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не определен переработчик!";
		Сообщение.Сообщить();                           
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Материалы       =ОпределяемДавальческоеСырье(Документ,Заказчик);
	Выпуск                =ОпределяемВыпуск(Документ,Заказчик);
	
	НайтиДокументИПометитьНаУдаление("ПередачаСырьяПереработчику","Лико_Документ",Документ,Отказ);
	НайтиДокументИПометитьНаУдаление("ПоступлениеСырьяОтДавальца","Лико_Документ",Документ,Отказ);
	НайтиДокументИПометитьНаУдаление("ПоступлениеОтПереработчика","Лико_Документ",Документ,Отказ);
	НайтиДокументИПометитьНаУдаление("ПередачаДавальцу","Лико_Документ",Документ,Отказ);
	
	
	
	Если Материалы.Количество()<>0 Тогда
		СоздатьРедактироватьПередачуСырьяПереработчику(Документ,Документ.ЗаказПокупателя, Заказчик,Материалы,Отказ); 
		СоздатьРедактироватьПоступлениеСырьяОтДавальца(Документ,Документ.ЗаказПокупателя, Заказчик,Материалы,Отказ);
		
	КонецЕсли;
	
	Если Выпуск.Количество()<>0 Тогда
		СоздатьРедактироватьПоступлениеОтПереработчика(Документ,Документ.ЗаказПокупателя, Заказчик,Выпуск,Отказ);
		СоздатьРедактироватьПередачаДавальцу(Документ,Документ.ЗаказПокупателя, Заказчик,Выпуск,Отказ);
		
	КонецЕсли;
	
	
	
