Процедура ВосстановитьПартии(Период=Неопределено)Экспорт //+Лико m.shenderov 18.03.2021
	Если Период=Неопределено Тогда 		
		Период=ОпределитьПериодВосстановления();
	КонецЕсли;
	
	Если Не  ЗначениеЗаполнено(Период) ТОгда
		Период=ПолучитьТекущийКвартал();
	КонецЕсли;
	
	Если Не  ЗначениеЗаполнено(Период) Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторТекущегоПользователя = СистемаВзаимодействия.ИдентификаторТекущегоПользователя();
	КлючОбсуждения = "ВосстановитьПартии " + ИдентификаторТекущегоПользователя;
	
	Обсуждение = СистемаВзаимодействия.ПолучитьОбсуждение(КлючОбсуждения);
	
	
	
	Метка			=ТекущаяДата();	
	ТекущийПериод	=НачалоМесяца(ТекущаяДата());
	
	УдалитьДвиженияЗаПериод(Период);
	
	Запрос 			=СформироватьЗапросВосстановленияЗаПериод(Период);
	Пакеты			=Запрос.ВыполнитьПакет();
	
	СооЗаказыПартии	=СформироватьСоответствиеЗаказыПартии(Пакеты[3]);
	СооЗаказыПоследняяПартия=СформироватьСоответствиеЗаказыПоследняяПартия(Пакеты[5]);
	
	РаспределеитьНаПартии(СооЗаказыПартии,Пакеты[4],СооЗаказыПоследняяПартия,Обсуждение);
	СборситьМетку(Метка);
	
	Если НачалоМесяца(Период)<ТекущийПериод Тогда
		ВосстановитьПартии(КонецМесяца(Период)+1);
	КонецЕсли;
	
