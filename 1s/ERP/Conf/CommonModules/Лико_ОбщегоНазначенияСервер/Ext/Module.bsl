	ДокументОбъект.Комментарий = "Создан автоматически на основании документа """ + Документ + """";

	ФизЛицо =         Документ.АвторДокумента;
	ДокументОбъект.Отпустил = ФизЛицо;
	ДокументОбъект.ОтпустилДолжность = Лико_Дополнительно.НайтиДолжностьФизЛица(ДокументОбъект.Отпустил, ДокументОбъект.Организация, ДокументОбъект.Дата);
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.ОтпустилДолжность) Тогда
		ДокументОбъект.ОтпустилДолжность = "Кладовщик";
	КонецЕсли;
	ДокументОбъект.Менеджер = ДокументОбъект.Автор;
	ДокументОбъект.Руководитель = Лико_Дополнительно.НайтиЛицоСПравомПодписи(ДокументОбъект.Организация, Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ДокументОбъект.Отпустил, ДокументОбъект.Дата); 
	ДокументОбъект.ГлавныйБухгалтер = Лико_Дополнительно.НайтиЛицоСПравомПодписи(ДокументОбъект.Организация, Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, ДокументОбъект.Отпустил, ДокументОбъект.Дата); 
	//Если ДокументОбъект.ВалютаВзаиморасчетов = ВалютаРуб Тогда
	//	// резидент
	//	Если ДокументОбъект.Валюта = ВалютаРуб Тогда
	//		ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВРубляхОплатаВРублях;
	//	Иначе
	//		ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВРублях;
	//	КонецЕсли;
	//Иначе
	//ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВРублях;
	//КонецЕслИ;
	//ДокументОбъект.ГруппаФинансовогоУчета = НайтиГруппуФинУчетаПоПорядкуОплату(Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВРублях);
	ДокументОбъект.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено;
	ДокументОбъект.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	ДокументОбъект.Лико_Документ=Документ;

	//Сумма=Лико_Планирование.СтоимостьЗаказаДляПередачиМеждуОрганизациями(ЗаказКлиента,Заказчик);  
	ДокументОбъект.Товары.Очистить();
	Для каждого Строка из Выпуск Цикл
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Склад      =             ДокументОбъект.Склад;
		
		ЕСли ДокументОбъект.Дата>=Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияСтавкиНДС20.ЗначениеПараметра ТОгда   
			Если Год(ДокументОбъект.Дата)>=2026 Тогда
				НоваяСтрока.СтавкаНДС   =    УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС22);
				
			Иначе
				НоваяСтрока.СтавкаНДС   =    УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС20);
			КонецЕсли;		
		Иначе
			НоваяСтрока.СтавкаНДС   =    УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС18); 
		КонецЕсли;


		//НоваяСтрока.Цена    =             Сумма/НоваяСтрока.Количество;
