// Процедура ЗаписатьРСЛико_ЭтапыЗаказа
//
/// Описание: Запись этапа выполнения заказа в регистр сведений   Лико этапы заказа
//
// Параметры: 
// Заказ                                     - ДокументСсылка.ЗаказКлиента                          - (обязательный). 
// Площадка                                  - СправочникСсылка.Огрнанизации                        - (обязательный). 
// Этап                                      - СправочникСсылка.Лико_ЭтапыВыполненияЗаказа          - (обязательный). 
// Дата                                       -Дата                                                 - (обязательный). 
// СтруктураПараметров                       - Структура                                            - (необязательный). 
Процедура ЗаписатьРСЛико_ЭтапыЗаказа(Заказ,Знач Площадка,Этап,Дата,СтруктураПараметров=Неопределено) Экспорт  //+Лико m.shenderov 07.09.2021
	
	Если ТипЗнч(Площадка)=Тип("СправочникСсылка.Организации") Тогда
		Площадка = Справочники.Лико_Площадки.ПлощадкаПоОрганизации(Площадка);
	КонецЕсли;
	
	
	
	НаборЗаписей = РегистрыСведений.Лико_ЭтапыЗаказа.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Период.Установить(Дата);
	НаборЗаписей.Отбор.Заказ.Установить(Заказ);
	НаборЗаписей.Отбор.Площадка.Установить(Площадка);
	
	Запись			=НаборЗаписей.Добавить();
	Запись.Период	=Дата;
	Запись.Заказ	=Заказ;
	Запись.Площадка	=Площадка;
	Запись.Этап     =Этап;

	
	Если ТипЗнч(СтруктураПараметров)=Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Запись,СтруктураПараметров);	
	КонецЕсли;
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры //-Лико m.shenderov 07.09.2021

Функция ПроверкаВозможностиОтправкиВРаботуЗаказаКлиента(ЗаказКлиента) Экспорт  //+Лико m.shenderov 07.02.2023
	УстановитьПривилегированныйРежим(Истина);	
	
	МассивОшибок = Новый Массив();
	
	Структура = Новый Структура;
	Структура.Вставить("Отказ",Ложь);
	Структура.Вставить("МассивОшибок",МассивОшибок);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаВидыРабот.НомерПроката КАК НомерПроката,
	|	МАКСИМУМ(1) КАК Количество
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &ЗаказКлиента
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаВидыРабот.НомерПроката
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Лико_БланкЭтапа.НомерПроката,
	|	МАКСИМУМ(-1)
	|ИЗ
	|	Документ.Лико_БланкЭтапа КАК Лико_БланкЭтапа
	|ГДЕ
	|	Лико_БланкЭтапа.Проведен
	|	И Лико_БланкЭтапа.ЗаказПокупателя = &ЗаказКлиента
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_БланкЭтапа.НомерПроката
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.НомерПроката КАК НомерПроката
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВременнаяТаблица.НомерПроката КАК НомерПроката,
	|		СУММА(ВременнаяТаблица.Количество) КАК Количество
	|	ИЗ
	|		ВременнаяТаблица КАК ВременнаяТаблица
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВременнаяТаблица.НомерПроката) КАК ВложенныйЗапрос
	|ГДЕ
	|	ВложенныйЗапрос.Количество < 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДвижениеПродукцииИМатериалов.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ДвижениеПродукцииИМатериалов КАК ДвижениеПродукцииИМатериалов
	|ГДЕ
	|	ДвижениеПродукцииИМатериалов.Распоряжение.Лико_ЗаказКлиента = &ЗаказКлиента
	|	И ДвижениеПродукцииИМатериалов.Проведен
	|	И ДвижениеПродукцииИМатериалов.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства)";
	
	Запрос.УстановитьПараметр("ЗаказКлиента",ЗаказКлиента);
	
	Пакеты = Запрос.ВыполнитьПакет();
	
	Выборка= Пакеты[1].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Структура.Отказ=Истина;
		МассивОшибок.Добавить( СтрШаблон("По №%1 проката есть складские операции!",Выборка.НомерПроката));
	КонецЦикла;
	
	Выборка= Пакеты[2].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Структура.Отказ=Истина;
		МассивОшибок.Добавить("По заказу есть выпуск продукции!");
		Прервать;
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции //-Лико m.shenderov 07.02.2023 




