Процедура ДобавитьЭтап(ЗаявкаНаРемонт,Дата,Сотрудник,Этап=Неопределено)  Экспорт
	Если Этап=Неопределено Тогда
		Этап=Перечисления.ТС_СостоянияРемонтныхРабот.ВРаботе;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|              ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних.Состояние КАК Этап
		|ИЗ
		|              РегистрСведений.ТС_ЭтапыВыполненияРемонтныхРаботРЦ.СрезПоследних(, ЗаявкаНаРемонт = &ЗаявкаНаРемонт) КАК ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних";
		Запрос.УстановитьПараметр("ЗаявкаНаРемонт",ЗаявкаНаРемонт);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Этап=Выборка.Этап;
		КонецЦикла; 
		
	КонецЕсли;
	
	НаборЗаписей                                                 =РегистрыСведений.ТС_ЭтапыВыполненияРемонтныхРаботРЦ.СоздатьНаборЗаписей();
	НоваяЗапись                                                                   =НаборЗаписей.Добавить();
	НоваяЗапись.Период                                  =Дата;
	НоваяЗапись.ДатаНачала                         =Дата;
	НоваяЗапись.ЗаявкаНаРемонт =ЗаявкаНаРемонт;
	НоваяЗапись.Состояние                            =Этап;
	НоваяЗапись.РабочийЦентр    =ЗаявкаНаРемонт.РабочийЦентр;
	НоваяЗапись.Сотрудник                            =Сотрудник;
	НаборЗаписей.Записать(Ложь);
	
КонецПроцедуры

Функция ПолучитьНомерОчереди()
	
	НомерОчереди=0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             МАКСИМУМ(ТС_ПланированиеРемонтныхРаботРЦ.НомерОчереди) КАК НомерОчереди
	|ИЗ
	|             РегистрСведений.ТС_ПланированиеРемонтныхРаботРЦ КАК ТС_ПланированиеРемонтныхРаботРЦ";
	Выборка=Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Если Выборка.НомерОчереди<>Null Тогда
		НомерОчереди=Выборка.НомерОчереди+1;
	КонецЕсли;
	Если  НомерОчереди=0 Тогда
		НомерОчереди=1;
	КонецЕсли;
	Возврат НомерОчереди;
	
	
КонецФункции

Функция ЭтоМеханик(Сотрудник) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             ТС_Механики.Сотрудник
	|ИЗ
	|             РегистрСведений.ТС_Механики КАК ТС_Механики
	|ГДЕ
	|             ТС_Механики.Сотрудник = &Сотрудник";
	Запрос.УстановитьПараметр("Сотрудник",Сотрудник );
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;             
	КонецЕсли;
	
