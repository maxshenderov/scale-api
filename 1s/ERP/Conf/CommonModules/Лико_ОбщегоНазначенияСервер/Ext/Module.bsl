#Область Печать

// Печатает стикер объекта номенклатуры
// Параметр Количество используется в том случае, когда необходимо распечатать стикер с количеством, отличным от актуального
// К примеру, если длина роля 2 000, а печать необходима для 1 500.
Функция ПараметрыПечатиСкладскойКарточкиОбъектаНоменклатуры(ОбъектНоменклатуры, КоличествоЭкземпляров=1, БыстраяПечать=Ложь, ПечатьОтветственногоИНомерЗаказа=Ложь, Количество=0,ИнфоКамф=Неопределено,ОбъектНабораПараметров=Неопределено,ИмяПринтера="") Экспорт
	
	//!ЯССМ_ПечататьКороткийШтрихКодОбъекта = ЯС_Общие.ПолучитьСвойствоОбъекта("ЯССМ_ПечататьКороткийШтрихКодОбъекта",ОбъектНабораПараметров , Ложь);
	ЯССМ_ПечататьКороткийШтрихКодОбъекта=Истина;
	
	ШКСТрокой = "";
	
	//!Объект = ОбъектНоменклатуры.ПолучитьОбъект();
	//!КоличествоНаПечать = ?(Количество=0, Объект.Количество, Количество);
	//!КоличествоУУНаПечать = ЯССМ_ОбщийМодуль.РассчитатьКоличествоУУ(ОбъектНоменклатуры, КоличествоНаПечать);
	
	КоличествоНаПечать = ?(Количество=0, ОбъектНоменклатуры.Количество, Количество);
	КоличествоУУНаПечать=КоличествоНаПечать*ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель;
	
	Если ЯССМ_ПечататьКороткийШтрихКодОбъекта Тогда
		ШК = Справочники.ЯССМ_ОбъектыНоменклатуры.ПолучитьКороткийШтрихКод(ОбъектНоменклатуры,ШКСтрокой, КоличествоНаПечать); //длина штрихкода - 15
	Иначе
		ШК = Справочники.ЯССМ_ОбъектыНоменклатуры.ПолучитьКороткийШтрихКод(ОбъектНоменклатуры,ШКСтрокой, КоличествоНаПечать); //длина штрихкода - 30
	КонецЕсли;
	
	НоменклатураОбъект = ОбъектНоменклатуры.Номенклатура;
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("Ответственный",  "");
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("КодНоменклатуры", НоменклатураОбъект.Код);
	ПараметрыПечати.Вставить("Код", Формат(ОбъектНоменклатуры.Код, "ЧГ=0"));
	ПараметрыПечати.Вставить("Наименование", ОбъектНоменклатуры.Наименование);
	ПараметрыПечати.Вставить("НомерПоставки", "#" + ОбъектНоменклатуры.НомерПоставки);
	ПараметрыПечати.Вставить("Дата", Формат(ОбъектНоменклатуры.ДатаФормирования, "ДФ=dd.MM.yyyy"));
	ПараметрыПечати.Вставить("Время", Формат(ОбъектНоменклатуры.ДатаФормирования, "ДЛФ=T"));
	ПараметрыПечати.Вставить("ШК",ШК);
	
	Объект = NULL;
	
	//Макет = Справочники.ЯССМ_ОбъектыНоменклатуры.ПолучитьМакет("НаклейкаОбъектаНоменклатуры");
	Макет = Справочники.ЯССМ_ОбъектыНоменклатуры.ПолучитьМакет("СкладскаяКарточка");
	
	
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ЯССМ_ПАРАМЕТРЫ_ПЕЧАТИ_СкладскаяКарточка";
	
	
	Рисунок = ОбластьШапка.Рисунки.Штрихкод;
	ПараметрыШтрихкода = Новый Структура;
	
	ПараметрыШтрихкода.Вставить("Ширина",          ОбластьШапка.Рисунки.Штрихкод.Ширина);
	ПараметрыШтрихкода.Вставить("Высота",          ОбластьШапка.Рисунки.Штрихкод.Высота);
	ПараметрыШтрихкода.Вставить("ТипКода",         4);
	ПараметрыШтрихкода.Вставить("ОтображатьТекст", Ложь);
	ПараметрыШтрихкода.Вставить("РазмерШрифта",    18);
	ПараметрыШтрихкода.Вставить("Штрихкод",        ПараметрыПечати.ШК);
	Рисунок.Картинка = МенеджерОборудованияВызовСервера.ПолучитьКартинкуШтрихкода(ПараметрыШтрихкода);     
	ОбластьШапка.Параметры.ШтрихКодСтрокой = ШКСТрокой;               
	ОбластьШапка.Параметры.Заполнить(ПараметрыПечати);
	ТабДокумент.Вывести(ОбластьШапка);
	
	
	//ОбъектВывода.Защита = Истина;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.ПолеСлева = 1;
	ТабДокумент.ПолеСправа = 0;
	ТабДокумент.ПолеСнизу = 0;
	ТабДокумент.ПолеСверху = 1;
	
	
	Если ИмяПринтера="" Тогда
		ИмяПринтера=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ИмяПринтераДляПечатиА4","");
		
	КонецЕсли;
	
	//-m.shenderov 03.10.2016        
	
	ТабДокумент.ИмяПринтера = ИмяПринтера;
	
	
	Возврат ТабДокумент;
КонецФункции


#КонецОбласти


