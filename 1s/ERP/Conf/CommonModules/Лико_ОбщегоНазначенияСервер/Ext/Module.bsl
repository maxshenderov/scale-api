	КонецЦикла;  
	
	
	Возврат Массив;             
КонецФункции //-Лико m.shenderov 18.10.2017 



Функция ПолучитьАдресХраненияПредыдущий(ОбъектНоменклатуры) Экспорт 
	УстановитьПривилегированныйРежим(Истина);
	Помещение=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ПомещениеДляАдресаХраненияПриВозврате");
	ГруппаНоменклатурыИсключение=Справочники.Лико_МастерНастройкиСтатьиРасходаДляНоменклатуры.НайтиПоКоду(21);
	Если ГруппаНоменклатурыИсключение=Справочники.Лико_МастерНастройкиСтатьиРасходаДляНоменклатуры.ОпределитьПравило(ОбъектНоменклатуры.Номенклатура)Тогда
		Возврат Неопределено;
	КонецЕсли;



	Если Не ЗначениеЗаполнено(Помещение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ячейка=Неопределено;
	Если не ЗначениеЗаполнено(ОбъектНоменклатуры) Тогда
		Возврат Ячейка;
	КонецЕсли;
	//ОбъектыНоменклатуры= Серия.ОбъектНоменклатуры;
	ТекстЗапроса= "ВЫБРАТЬ ПЕРВЫЕ 1
	|             ТоварыВЯчейках.Ячейка КАК Ячейка
	|ИЗ
	|             РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
	|ГДЕ
	|             ТоварыВЯчейках.Серия.ЯССМ_ОбъектНоменклатуры = &ОбъектНоменклатуры
	|             И ТоварыВЯчейках.Ячейка.Помещение = &Помещение
	|
	|УПОРЯДОЧИТЬ ПО
	|             ТоварыВЯчейках.Период УБЫВ"; 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТоварыВЯчейках.Ячейка КАК Ячейка,
	|	МАКСИМУМ(ТоварыВЯчейках.Период) КАК Период
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
	|ГДЕ
	|	ТоварыВЯчейках.Серия = &ОбъектНоменклатуры
	|	И ТоварыВЯчейках.Ячейка.Помещение = &Помещение
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВЯчейках.Ячейка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВременнаяТаблица.Ячейка КАК Ячейка,
	|	ВременнаяТаблица.Период КАК Период
	|ИЗ
	|	ВременнаяТаблица КАК ВременнаяТаблица
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;  

	//Запрос.УстановитьПараметр("ОбъектНоменклатуры",ОбъектНоменклатуры );
	Запрос.УстановитьПараметр("ОбъектНоменклатуры",ОбъектНоменклатуры.Серия );
	Запрос.УстановитьПараметр("Помещение",Помещение );

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл                       
		Возврат Выборка.Ячейка;
	КонецЦикла;    
	Возврат Ячейка;             
КонецФункции


