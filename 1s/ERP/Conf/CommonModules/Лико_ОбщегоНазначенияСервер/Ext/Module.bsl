#Область Номенклатура

Функция ПоискНоменклатурыПоСодержаниюТекста( Текст) Экспорт
	
	
	ДлинаКодаНоменклатуры = Метаданные.Справочники.Номенклатура.ДлинаКода;
	КодНоменклатуры = "n" + Строка(Формат(Число(Текст),"ЧЦ="+(ДлинаКодаНоменклатуры-1)+"; ЧДЦ=0; ЧВН=; ЧГ=0"));
	
	// ищем номенклатуру по артикулу, по наименованию, по коду
	ЗапросНоменклатура = Новый Запрос;
	ЗапросНоменклатура.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 20
	|             Номенклатура.Ссылка,
	|             1 КАК Приоритет
	|ИЗ
	|             Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|             Номенклатура.Код = &КодИзКраткогоКода
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|             Номенклатура.Ссылка,
	|             2
	|ИЗ
	|             Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|             Номенклатура.Код ПОДОБНО &ТекстПоиска
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|             Номенклатура.Ссылка,
	|             3
	|ИЗ
	|             Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|             Номенклатура.Артикул ПОДОБНО &ТекстПоиска
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|             Номенклатура.Ссылка,
	|             4
	|ИЗ
	|             Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|             Номенклатура.Наименование ПОДОБНО &ТекстПоиска
	|
	|УПОРЯДОЧИТЬ ПО
	|             Приоритет";
	
	ЗапросНоменклатура.УстановитьПараметр("ТекстПоиска", Текст);
	ЗапросНоменклатура.УстановитьПараметр("КодИзКраткогоКода", КодНоменклатуры);
	
	СписокНоменклатуры = Новый СписокЗначений;
	
	ВыборкаНоменклатура = ЗапросНоменклатура.Выполнить().Выбрать();
	Пока ВыборкаНоменклатура.Следующий() Цикл
		СписокНоменклатуры.Добавить(ВыборкаНоменклатура.Ссылка);
	КонецЦикла;
	
	Возврат СписокНоменклатуры;
	
	
	
КонецФункции //ПоискНоменклатурыПоСодержаниюТекста Экспорт


// Функция КоличествоПоСерии
//
/// Описание: НужноИзменить
//
// Параметры: 
// Серия                                                             - СправочникСсылка.СерияНоменклатуры                          - (обязательный). 
// Количество                                - Число                                                                                                                                                                              - (обязательный)
//
// Возвращаемое значение:
// Число
//
Функция КоличествоПоСерии(Серия,Количество,УУ=Ложь) Экспорт //+Лико m.shenderov 22.09.2017
	//Серия=Справочники.СерииНоменклатуры.СоздатьЭлемент();
	Если ЗначениеЗаполнено(Серия.ЯССМ_ОбъектНоменклатуры) Тогда
		Если УУ тогда
			Возврат Количество/Серия.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель;    
		Иначе
			Возврат Количество*Серия.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель;
		КонецЕсли;
		
	Иначе
		Возврат Количество;
	КонецЕсли;
	
	
КонецФункции //КоличествоПоСерии -Лико m.shenderov 22.09.2017


