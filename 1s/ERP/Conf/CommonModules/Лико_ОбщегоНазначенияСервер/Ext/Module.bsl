Процедура ПроверитьКоличествоОбъектаНоменклатуры(Массив) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры КАК Ссылка,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(, Серия В (&Массив)) КАК ТоварыВЯчейкахОстатки
	|ГДЕ
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток <> ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.Количество
	|	И (ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.Рулонный
	|			ИЛИ ТоварыВЯчейкахОстатки.Номенклатура.ВидНоменклатуры = &ВидНоменклатурыКраска)
	|	И ТоварыВЯчейкахОстатки.ВНаличииОстаток > 0";
	Запрос.УстановитьПараметр("Массив",Массив);
	Запрос.УстановитьПараметр("ВидНоменклатурыКраска",Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыКраска.ЗначениеПараметра);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		СпрОбъект=Выборка.Ссылка.ПолучитьОбъект();
		СпрОбъект.Количество=Выборка.Остаток;
		СпрОбъект.Записать();
	КонецЦикла; 
	
КонецПроцедуры


