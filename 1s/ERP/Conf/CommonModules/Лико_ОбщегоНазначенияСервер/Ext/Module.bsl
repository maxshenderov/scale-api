Процедура ЗаписьНачалаВыполненияРаботыПоЗаявкеНаРемонт (Сотрудник,ЗаявкаНаРемонт=Неопределено) Экспорт 
	Дата=ТекущаяДата();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             ТС_РаботыПоЗаявкамНаРемонтСрезПоследних.Период,
	|             ТС_РаботыПоЗаявкамНаРемонтСрезПоследних.Сотрудник,
	|             ТС_РаботыПоЗаявкамНаРемонтСрезПоследних.ЗаявкаНаРемонт,
	|             ТС_РаботыПоЗаявкамНаРемонтСрезПоследних.ДатаНачала,
	|             ТС_РаботыПоЗаявкамНаРемонтСрезПоследних.ДатаОкончания
	|ИЗ
	|             РегистрСведений.ТС_РаботыПоЗаявкамНаРемонт.СрезПоследних(, Сотрудник = &Сотрудник) КАК ТС_РаботыПоЗаявкамНаРемонтСрезПоследних";
	Запрос.УстановитьПараметр("Сотрудник",Сотрудник );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЗаявкаНаРемонт=ЗаявкаНаРемонт Тогда
			Возврат;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.ТС_РаботыПоЗаявкамНаРемонт.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
		НаборЗаписей.Отбор.Сотрудник.Установить(Сотрудник);
		НаборЗаписей.Прочитать();
		Для каждого Запись Из НаборЗаписей Цикл
			Запись.ДатаОкончания=Дата;                                
		КонецЦикла;
		
		НаборЗаписей.Записать();
		ПроверкаВеденияРаботПоЗаявки(Выборка.ЗаявкаНаРемонт);
	КонецЦикла;    
	
	НаборЗаписей = РегистрыСведений.ТС_РаботыПоЗаявкамНаРемонт.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(Дата);
	НаборЗаписей.Отбор.Сотрудник.Установить(Сотрудник);
	Запись=Наборзаписей.Добавить();
	Запись.Период=Дата;
	Запись.Сотрудник=Сотрудник;
	Запись.ДатаНачала=Дата;
	Запись.ЗаявкаНаРемонт=ЗаявкаНаРемонт;
	НаборЗаписей.Записать(); 
КонецПроцедуры

Процедура ПроверкаЗаявкиВРаботе(ЗаявкаНаРемонт) Экспорт          
	Состояние=Перечисления.ТС_СостоянияРемонтныхРабот.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних.Состояние,
	|             ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних.Сотрудник
	|ИЗ
	|             РегистрСведений.ТС_ЭтапыВыполненияРемонтныхРаботРЦ.СрезПоследних КАК ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних
	|ГДЕ
	|             ТС_ЭтапыВыполненияРемонтныхРаботРЦСрезПоследних.ЗаявкаНаРемонт = &ЗаявкаНаРемонт";
	Запрос.УстановитьПараметр("ЗаявкаНаРемонт",ЗаявкаНаРемонт );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Состояние=Выборка.Состояние;
		Сотрудник=Выборка.Сотрудник;
	КонецЦикла;
	
	Если Состояние<>Перечисления.ТС_СостоянияРемонтныхРабот.ВРаботе Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|              ТС_РаботыПоЗаявкамНаРемонтСрезПоследних.Сотрудник
		|ИЗ
		|              РегистрСведений.ТС_РаботыПоЗаявкамНаРемонт.СрезПоследних КАК ТС_РаботыПоЗаявкамНаРемонтСрезПоследних
		|ГДЕ
		|              ТС_РаботыПоЗаявкамНаРемонтСрезПоследних.ЗаявкаНаРемонт = &ЗаявкаНаРемонт";
		Запрос.УстановитьПараметр("ЗаявкаНаРемонт",ЗаявкаНаРемонт );
		РезультатЗапроса=Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаписьНачалаВыполненияРаботыПоЗаявкеНаРемонт(Выборка.Сотрудник);                   
		КонецЦикла;                    
	ИначеЕсли  Состояние=Перечисления.ТС_СостоянияРемонтныхРабот.ВРаботе Тогда             
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|              ТС_РаботыПоЗаявкамНаРемонтСрезПоследних.Сотрудник
		|ИЗ
		|              РегистрСведений.ТС_РаботыПоЗаявкамНаРемонт.СрезПоследних КАК ТС_РаботыПоЗаявкамНаРемонтСрезПоследних
		|ГДЕ
		|              ТС_РаботыПоЗаявкамНаРемонтСрезПоследних.ЗаявкаНаРемонт = &ЗаявкаНаРемонт";
		Запрос.УстановитьПараметр("ЗаявкаНаРемонт",ЗаявкаНаРемонт );
		Если Запрос.Выполнить().Пустой() Тогда
			
			ДобавитьВПлан(ЗаявкаНаРемонт,Сотрудник);
		КонецЕсли;
		
		
	КонецЕсли;
	
	
КонецПроцедуры

