					ФорматДлительности(ВыборкаДетальныеЗаписи.ВремяФакт);
				КонецЕсли; 
				
			КонецЕсли;
			
			Если Объект.ПоказыватьКомментарий Тогда
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Автор) Тогда
					
					ПодстрокиСтрокиСоединения  = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВыборкаДетальныеЗаписи.Автор, " ");
					
					КолСтрок=ПодстрокиСтрокиСоединения.Количество();
					
					Автор=ПодстрокиСтрокиСоединения[0]+
					?(КолСтрок>=2," "+Лев(ПодстрокиСтрокиСоединения[1],1)+".","")+
					?(КолСтрок>=3,Лев(ПодстрокиСтрокиСоединения[2],1)+".","");
					
					ПланировщикТД.Область(ЯчейкаЧ).Текст=ПланировщикТД.Область(ЯчейкаЧ).Текст+"  "+
					СокрЛП(Автор)+": "+СокрЛП(ВыборкаДетальныеЗаписи.Комментарий);
					
				КонецЕсли;
				
			КонецЕсли;			
			Если Цвет="НетФорм" Тогда
				ПланировщикТД.Область(ЯчейкаЧ).ЦветФона=ЦветОтсутствияФормы;
			ИначеЕсли Цвет="НетОснастки" тогда
				ПланировщикТД.Область(ЯчейкаЧ).ЦветФона=ЦветОтсутствияОснастки;
			Иначе
				ПланировщикТД.Область(ЯчейкаЧ).ЦветФона=ЦветНаличияМатериалов;				
			КонецЕсли;
			
			
			
			
			ПланировщикТД.Область(ЯчейкаЧ).ВысотаСтроки=ВысотаСтроки;			
			ПланировщикТД.Область(ЯчейкаЧ).РазмещениеТекста=ТипРазмещенияТекстаТабличногоДокумента.Переносить; 			
			ПланировщикТД.Область(ЯчейкаЧ).ЦветТекста =ЦветТекста;
			//ПланировщикТД.Область(ЯчейкаЧ).ЦветФона =ЦветФона;			
			Если ПоследнийЗаказ Тогда
				Прервать;
			КонецЕсли;			
		КонецЦикла;
	КонецЦикла;    
	
КонецПроцедуры
  
