Процедура УдалитьДокументДвиженияЭтапа(Распоряжение,УжеСозданныеДокументы)//+Лико m.shenderov 21.11.2017
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             ДвижениеПродукцииИМатериалов.Ссылка КАК Ссылка
	|ИЗ
	|             Документ.ДвижениеПродукцииИМатериалов КАК ДвижениеПродукцииИМатериалов
	|ГДЕ
	|             ДвижениеПродукцииИМатериалов.ХозяйственнаяОперация <> &ХозяйственнаяОперация И
	|             ДвижениеПродукцииИМатериалов.Лико_Документ = &Распоряжение";
	Запрос.УстановитьПараметр("Распоряжение",Распоряжение);
	//+ Лико m.shenderov 30.05.2019
	Запрос.УстановитьПараметр("ХозяйственнаяОперация",Перечисления.ХозяйственныеОперации.ПередачаМатериаловВКладовую);
	//- Лико m.shenderov 30.05.2019
	
	
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Документ=Выборка.Ссылка.ПолучитьОбъект();
		Документ.ПометкаУдаления=Истина;
		Документ.ДополнительныеСвойства.Вставить("ОтключитьКонтрольПриПроведении",Истина);
		Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		УжеСозданныеДокументы.Добавить(Выборка.Ссылка);
	КонецЦикла;    
КонецПроцедуры //-Лико m.shenderov 21.11.2017

Процедура СоздатьДокументВыпуска(Распоряжение,ЭтапПроизводства,УжеСозданныеДокументы) //+Лико m.shenderov 21.11.2017
	
	ОбъектыОснований = Новый Массив;
	ОбъектыОснований.Добавить(ЭтапПроизводства);    
	
	ПараметрыОткрытия = ПроизводствоВызовСервера.ПараметрыСозданияДвиженияПродукцииИМатериаловНаОсновании(
	ОбъектыОснований, Перечисления.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства);         
	
	НовыйДокОбъект = Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент();     
	НовыйДокОбъект.Заполнить(ПараметрыОткрытия.Основание);
	НовыйДокОбъект.Дата = Распоряжение.Дата;
	Если ЗначениеЗаполнено(Распоряжение.ДатаДляТиповыхДокументов) Тогда
		НовыйДокОбъект.Дата                                              = Распоряжение.ДатаДляТиповыхДокументов;                           
	КонецЕсли;
	
	НовыйДокОбъект.Статус = Перечисления.СтатусыДвиженияПродукцииИМатериалов.Принято;
	НовыйДокОбъект.Лико_Документ=Распоряжение;
	НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + Распоряжение + """";
	
	УжеСозданныйДокумент=Неопределено;
	Для каждого УжеСозданныйДокументОбъект Из УжеСозданныеДокументы Цикл
		
		Если УжеСозданныйДокументОбъект.ХозяйственнаяОперация=Перечисления.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства и
			УжеСозданныйДокументОбъект.Лико_ДОкумент=Распоряжение  Тогда                                       
			УжеСозданныйДокумент=Истина;                                      
			Прервать;
		КонецЕсли;
		
	КонецЦикла;    
	
	
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокументОбъект.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого     ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Если Распоряжение.ФиксироватьВыпуск Тогда
		ЗапросДляЗаполненияТабличнаяЧастьДокументаДвиженияВыпуск(Запрос,НовыйДокОбъект.Лико_Документ);
		
	Иначе
		ЗапросДляЗаполненияТабличнаяЧастьДокументаДвиженияВыпускПобочный(Запрос,НовыйДокОбъект.Лико_Документ);
	КонецЕсли;
	НовыйДокОбъект.Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	Если НовыйДокОбъект.Товары.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	
	Попытка 
		НовыйДокОбъект.ДополнительныеСвойства.Вставить("ПерезаполнитьВидыЗапасов",Истина);
		//НовыйДокОбъект.ДополнительныеСвойства.Вставить("ОтключитьКонтрольПриПроведении",Истина);
		
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);                 
	Исключение
		Отказ = Истина;
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
	КонецПопытки;              
	
	
	
КонецПроцедуры //-Лико m.shenderov 21.11.2017


