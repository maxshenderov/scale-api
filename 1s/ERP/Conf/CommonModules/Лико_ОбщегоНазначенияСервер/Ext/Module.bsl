Функция ПроверкаСвойствТМЦ(НоменклатураПроверки, ВидТМЦ, ВидСекции, ЦеноваяГруппа)  Экспорт  //+Лико m.shenderov 24.10.2023


	Результат				=	"";

	ЦеноваяГруппаПроверки	=	НоменклатураПроверки.ЦеноваяГруппа; 	
	ВидТМЦПроверки			=	НоменклатураПроверки.Лико_видТМЦ;  

	Если ЦеноваяГруппаПроверки=ЦеноваяГруппа Тогда

		Возврат Результат;

	КонецЕсли;


	Если  ВидТМЦПроверки<>ВидТМЦ Тогда

		Результат=Результат+СтрШаблон("Не соответствует вид ТМЦ, требуется : ""%1"". ",ВидТМЦ);

	КонецЕсли;	

	Если  ЦеноваяГруппа.Лико_ВидыСекций.Найти(ВидСекции)=Неопределено Тогда

		Результат=Результат+СтрШаблон("Не соответствует вид работ (для вида секции)  требуется : ""%1"". ",ВидСекции);

	КонецЕсли;

	Если ЗначениеЗаполнено(ЦеноваяГруппа.Лико_Глянцевость) и  ЦеноваяГруппа.Лико_Глянцевость<>ЦеноваяГруппаПроверки.Лико_Глянцевость Тогда

		Результат=Результат+СтрШаблон("Не соответствует Глянцевость, требуется:""%1"". ",ЦеноваяГруппа.Лико_Глянцевость);

	КонецЕсли;

	Если ЗначениеЗаполнено(ЦеноваяГруппа.Лико_Основа) и  ЦеноваяГруппа.Лико_Основа<>ЦеноваяГруппаПроверки.Лико_Основа Тогда

		Результат=Результат+СтрШаблон("Не соответствует Основа,  требуется : ""%1"". ",ЦеноваяГруппа.Лико_Основа);

	КонецЕсли;   

	Если  ЦеноваяГруппа.Лико_ТУ<>ЦеноваяГруппаПроверки.Лико_ТУ Тогда

		Результат=Результат+СтрШаблон("Не соответствует применение, %1 ""ТУ"". ",?(ЦеноваяГруппа.Лико_ТУ,"требуется","не требуется"))  ;

	КонецЕсли;

	Возврат Результат;

КонецФункции



#КонецОбласти


#Область ВосстановлениеЭтапов


Процедура ВосстановитьЭтапыАсинхронно(Документ) Экспорт
	ДатаЗапретаВосстановления=КонецДня(Справочники.Лико_ПредопределенныеЗначения.ПериодЗакрытияВосстановленияЭтапов.ЗначениеПараметра);
	Если ТипЗнч(Документ)=Тип("ДокументСсылка.Лико_БланкЭтапа") и Документ.Дата>ДатаЗапретаВосстановления Тогда
		НаборЗаписей = РегистрыСведений.Лико_ОшибкиЗакрытияБланков.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЗакрытиеБланка.Установить(Документ);
		НоваяЗапись= НаборЗаписей.Добавить();
		НоваяЗапись.ЗакрытиеБланка=Документ;
		НаборЗаписей.Записать(Истина);
	ИначеЕсли   ТипЗнч(Документ)=Тип("ДокументСсылка.ЗаказКлиента") ТОгда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|              Лико_БланкЭтапа.Ссылка КАК Ссылка
		|ИЗ
		|              Документ.Лико_БланкЭтапа КАК Лико_БланкЭтапа
		|ГДЕ
		|              Лико_БланкЭтапа.Дата > &Дата1 
		|              И Лико_БланкЭтапа.Проведен
		|              И НЕ Лико_БланкЭтапа.ПометкаУдаления
		|              И Лико_БланкЭтапа.Распоряжение ССЫЛКА Документ.ЭтапПроизводства2_2
		|              И Лико_БланкЭтапа.ЗаказПокупателя &Заказ
		|
		|УПОРЯДОЧИТЬ ПО
		|              Лико_БланкЭтапа.Дата";                          
		Запрос.УстановитьПараметр("Дата1",ДатаЗапретаВосстановления);
		Запрос.УстановитьПараметр("Заказ",Документ);                        
		РезультатЗапроса = Запрос.Выполнить();
		Выборка =РезультатЗапроса.Выбрать();
		Н=0;
		Пока Выборка.Следующий() Цикл
			НаборЗаписей = РегистрыСведений.Лико_ОшибкиЗакрытияБланков.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЗакрытиеБланка.Установить(Выборка.Ссылка);
			НоваяЗапись= НаборЗаписей.Добавить();
			НоваяЗапись.ЗакрытиеБланка=Выборка.Ссылка;
			НаборЗаписей.Записать(Истина);                                         
			Н=Н+1; 
		КонецЦикла;                   
	КонецЕсли;       
	
КонецПроцедуры


Процедура ВосстановлениеЭтапов(Ссылка=Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Если Ссылка.НеВосстанавливатьЭтап Тогда

		НаборЗаписей = РегистрыСведений.Лико_ОшибкиЗакрытияБланков.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЗакрытиеБланка.Установить(Ссылка);
		НаборЗаписей.Записать(Истина);

		НаборЗаписей = РегистрыСведений.Лико_ФоновыеЗадания.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Лико_Документ.Установить(Ссылка);
		НаборЗаписей.Записать(Истина);
		Возврат; 	

	КонецЕсли;


	Запрос = Новый Запрос;
	СформироватьТекстЗапросДляВосстановленияЭтапов(Запрос,Не ЗначениеЗаполнено(Ссылка));
	Если ЗначениеЗаполнено(Ссылка) Тогда 
		Запрос.Параметры.Вставить("ОтборПоРаспоряжению",Истина);
		Запрос.Параметры.Вставить("Распоряжение",Ссылка);
	Иначе
		Запрос.Параметры.Вставить("ОтборПоРаспоряжению",Ложь);
		Запрос.Параметры.Вставить("Распоряжение",Документы.Лико_БланкЭтапа.ПустаяСсылка());

	КонецЕсли;

	//Запрос.Параметры.Вставить("Дата1",ДатаНачала);
	//Запрос.Параметры.Вставить("Дата2",ДатаОкончания);


	РезультатЗапроса = Запрос.Выполнить();         
	ВыборкаЭтап = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	н=0;
	Если ВыборкаЭтап.Количество()=0 Тогда
		НайтиЭтапСБланками(Документы.ЭтапПроизводства2_2.ПустаяСсылка(),Ссылка);
		УжеСозданныеДокументы=Новый Массив;
		УдалитьДокументДвиженияЭтапа(Ссылка,УжеСозданныеДокументы);


		НаборЗаписей = РегистрыСведений.Лико_ОшибкиЗакрытияБланков.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЗакрытиеБланка.Установить(Ссылка);
		НаборЗаписей.Записать(Истина);
		НаборЗаписей = РегистрыСведений.Лико_ФоновыеЗадания.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Лико_Документ.Установить(Ссылка);
		НаборЗаписей.Записать(Истина);



	КонецЕсли;

	Пока ВыборкаЭтап.Следующий() Цикл
		н=н+1;
		МассивСкладов= Новый Массив;
		ЭтапПроизводства=ВыборкаЭтап.ЭтапПроизводства;
		Распоряжение=ВыборкаЭтап.Распоряжение;
		ЭтапПроизводстваОбъект=ЭтапПроизводства.ПолучитьОбъект();

		Если Не ЗначениеЗаполнено(ЭтапПроизводстваОбъект.ФактическоеНачалоЭтапа) Тогда
			ЭтапПроизводстваОбъект.ФактическоеНачалоЭтапа=ЭтапПроизводстваОбъект.Дата;
		КонецЕсли;

		НайтиЭтапСБланками(ЭтапПроизводства,Распоряжение);

		//ЭтапПроизводстваОбъект=Документы.ЭтапПроизводства2_2.СоздатьДокумент();
		//Удаляем из документа 
		КлючПоиска = Новый Структура;                           
		КлючПоиска.Вставить("Лико_Документ",Распоряжение);      
		НайденныеСтроки=ЭтапПроизводстваОбъект.ОбеспечениеМатериаламиИРаботами.НайтиСтроки(КлючПоиска);
		Для каждого НСтрока Из НайденныеСтроки Цикл
			ЭтапПроизводстваОбъект.ОбеспечениеМатериаламиИРаботами.Удалить(ЭтапПроизводстваОбъект.ОбеспечениеМатериаламиИРаботами.Индекс(НСтрока));
		КонецЦикла;                    
		НайденныеСтроки=ЭтапПроизводстваОбъект.РасходМатериаловИРабот.НайтиСтроки(КлючПоиска);
		Для каждого НСтрока Из НайденныеСтроки Цикл
			ЭтапПроизводстваОбъект.РасходМатериаловИРабот.Удалить(ЭтапПроизводстваОбъект.РасходМатериаловИРабот.Индекс(НСтрока));
		КонецЦикла;                    
		НайденныеСтроки=ЭтапПроизводстваОбъект.ПобочныеИзделия.НайтиСтроки(КлючПоиска);
		Для каждого НСтрока Из НайденныеСтроки Цикл
			ЭтапПроизводстваОбъект.ПобочныеИзделия.Удалить(ЭтапПроизводстваОбъект.ПобочныеИзделия.Индекс(НСтрока));
		КонецЦикла;    
		НайденныеСтроки=ЭтапПроизводстваОбъект.ВыходныеИзделия.НайтиСтроки(КлючПоиска);
		Для каждого НСтрока Из НайденныеСтроки Цикл
			ЭтапПроизводстваОбъект.ВыходныеИзделия.Удалить(ЭтапПроизводстваОбъект.ВыходныеИзделия.Индекс(НСтрока));
		КонецЦикла;                                   


		ЕстьВыпуск=Ложь;
		ЕстьРасход=Ложь;

		//Добавляем в документ                          
		Выборка=ВыборкаЭтап.Выбрать();
		Пока Выборка.Следующий() Цикл                                       
			Если Выборка.ВидОперации= Перечисления.Лико_ВидОперацииЗакрытияБланка.Выпуск Тогда 
				ЗаказКлиента=Документы.ЗаказКлиента.ПустаяСсылка();
				Попытка
					ЗаказКлиента=ЭтапПроизводстваОбъект.Распоряжение.ДокументОснование;          
				Исключение
					//ОписаниеОшибки()
				КонецПопытки;

				Если Выборка.Распоряжение.ФиксироватьВыпуск Тогда
					ФормированиеДвиженияПоВыпкскуЭтапа(ЭтапПроизводстваОбъект.ВыходныеИзделия,Выборка,ЗаказКлиента) ;

				Иначе
					ФормированиеДвиженияПоВыпкскуПобочныхИзделий(ЭтапПроизводстваОбъект.ПобочныеИзделия,Выборка,ЗаказКлиента)
				КонецЕсли;
				ЕстьВыпуск=Истина;
			КонецЕсли;

			Если Выборка.ВидОперации= Перечисления.Лико_ВидОперацииЗакрытияБланка.Расход Тогда
				ФормированиеДвиженияПоРасходуЭтапа( ЭтапПроизводстваОбъект.РасходМатериаловИРабот,Выборка);
				ФормированиеДвиженияПоОбеспечениюЭтапа(ЭтапПроизводстваОбъект.ОбеспечениеМатериаламиИРаботами,Выборка,МассивСкладов);
				ЕстьРасход=Истина;
			КонецЕсли;                                       

		КонецЦикла;
		НаборЗаписей = РегистрыСведений.Лико_ОшибкиЗакрытияБланков.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЗакрытиеБланка.Установить(ВыборкаЭтап.РАспоряжение);
		НаборЗаписей.Записать(Истина);
		НаборЗаписей = РегистрыСведений.Лико_ФоновыеЗадания.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Лико_Документ.Установить(ВыборкаЭтап.РАспоряжение);
		НаборЗаписей.Записать(Истина);

		Попытка
			УжеСозданныеДокументы=Новый Массив;
			УдалитьДокументДвиженияЭтапа(Распоряжение,УжеСозданныеДокументы);



			//ЭтапПроизводстваОбъект=Документы.ЭтапПроизводства2_2.СоздатьДокумент();
			#Область Формируем_Статус_Этапа

			Если ЭтапПроизводстваОбъект.Статус<> Перечисления.СтатусыЭтаповПроизводства2_2.Завершен Тогда
				ЭтапПроизводстваОбъект.Статус=Перечисления.СтатусыЭтаповПроизводства2_2.Начат;
				//ЭтапПроизводстваОбъект.Статус=Перечисления.СтатусыЭтаповПроизводства2_2.Завершен;                                                       
			КонецЕсли;
			#КонецОбласти

			//+ ---> Лико2.5 m.shenderov 01.04.2022

			#Область Определяем_Желаемую_Дату_Обеспечения

			//ЖелаемаяДатаОбеспечения=ЭтапПроизводстваОбъект.Дата;
			//Для каждого Обесп Из ЭтапПроизводстваОбъект.ОбеспечениеМатериаламиИРаботами Цикл
			//	ЖелаемаяДатаОбеспечения=Макс(Обесп.ДатаОтгрузки,ЖелаемаяДатаОбеспечения);         
			//КонецЦикла;
			//ЭтапПроизводстваОбъект.ЖелаемаяДатаОбеспечения=ЖелаемаяДатаОбеспечения;
			//Если Не ЗначениеЗаполнено(ЖелаемаяДатаОбеспечения) Тогда
			//	ЭтапПроизводстваОбъект.ЖелаемаяДатаОбеспечения=ТекущаяДата();
			//КонецЕсли;

			#КонецОбласти  
			//- <--- Лико2.5 m.shenderov 01.04.2022


			#Область Определяем_Фактическое_НачалоЭтапа

			ФактическоеНачалоЭтапа=Неопределено;
			Для каждого Обесп Из ЭтапПроизводстваОбъект.ОбеспечениеМатериаламиИРаботами Цикл
				//Если ФактическоеНачалоЭтапа=Неопределено И ЗначениеЗаполнено(Обесп.ДатаОтгрузки) Тогда
				//            ФактическоеНачалоЭтапа=Обесп.ДатаОтгрузки;
				//Иначе
				//                ФактическоеНачалоЭтапа=Мин(Обесп.ДатаОтгрузки,ФактическоеНачалоЭтапа);
				//КонецЕсли;
				Если  ФактическоеНачалоЭтапа=Неопределено И  ЗначениеЗаполнено(Обесп.ДатаОтгрузки) Тогда
					ФактическоеНачалоЭтапа= Обесп.ДатаОтгрузки;
				ИначеЕсли ЗначениеЗаполнено(Обесп.ДатаОтгрузки) Тогда
					ФактическоеНачалоЭтапа=Мин(Обесп.ДатаОтгрузки,ФактическоеНачалоЭтапа);                                                                       
				КонецЕсли;

			КонецЦикла;

			Для каждого Выход Из ЭтапПроизводстваОбъект.ВыходныеИзделия Цикл
				Если ФактическоеНачалоЭтапа=Неопределено И ЗначениеЗаполнено(Выход.ДатаПроизводства) Тогда
					ФактическоеНачалоЭтапа=Выход.ДатаПроизводства;
				ИначеЕсли ЗначениеЗаполнено(Выход.ДатаПроизводства) Тогда

					ФактическоеНачалоЭтапа=Мин(Выход.ДатаПроизводства,ФактическоеНачалоЭтапа);
				КонецЕсли;
			КонецЦикла;

			Для каждого Побоч Из ЭтапПроизводстваОбъект.ПобочныеИзделия Цикл
				Если ФактическоеНачалоЭтапа=Неопределено И ЗначениеЗаполнено(Побоч.ДатаПроизводства) Тогда
					ФактическоеНачалоЭтапа=Побоч.ДатаПроизводства;
				ИначеЕсли ЗначениеЗаполнено(Побоч.ДатаПроизводства) Тогда  
					ФактическоеНачалоЭтапа=Мин(Побоч.ДатаПроизводства,ФактическоеНачалоЭтапа);
				КонецЕсли;
			КонецЦикла;
			ЭтапПроизводстваОбъект.ФактическоеНачалоЭтапа=ФактическоеНачалоЭтапа;

			Если Не ЗначениеЗаполнено(ЭтапПроизводстваОбъект.ФактическоеНачалоЭтапа) Тогда
				ЭтапПроизводстваОбъект.ФактическоеНачалоЭтапа=ЭтапПроизводстваОбъект.Дата;
			КонецЕсли;



			#КонецОбласти

			#Область Определяем_Фактическое_Окончания_Этапа

			ФактическоеОкончаниеЭтапа=Неопределено;
			Для каждого Обесп Из ЭтапПроизводстваОбъект.ОбеспечениеМатериаламиИРаботами Цикл
				Если ФактическоеОкончаниеЭтапа=Неопределено И ЗначениеЗаполнено(Обесп.ДатаОтгрузки) Тогда
					ФактическоеОкончаниеЭтапа=Обесп.ДатаОтгрузки;
				ИначеЕсли ЗначениеЗаполнено(Обесп.ДатаОтгрузки) Тогда 
					ФактическоеОкончаниеЭтапа=Макс(Обесп.ДатаОтгрузки,ФактическоеНачалоЭтапа);
				КонецЕсли;
			КонецЦикла;

			Для каждого Выход Из ЭтапПроизводстваОбъект.ВыходныеИзделия Цикл
				Если ФактическоеОкончаниеЭтапа=Неопределено И ЗначениеЗаполнено(Выход.ДатаПроизводства) Тогда
					ФактическоеОкончаниеЭтапа=Выход.ДатаПроизводства;
				ИначеЕсли  ЗначениеЗаполнено(Выход.ДатаПроизводства) Тогда
					ФактическоеОкончаниеЭтапа=Макс(Выход.ДатаПроизводства,ФактическоеОкончаниеЭтапа);
				КонецЕсли;
			КонецЦикла;

			Для каждого Побоч Из ЭтапПроизводстваОбъект.ПобочныеИзделия Цикл
				Если ФактическоеОкончаниеЭтапа=Неопределено И ЗначениеЗаполнено(Побоч.ДатаПроизводства) Тогда
					ФактическоеОкончаниеЭтапа=Побоч.ДатаПроизводства;
				ИначеЕсли ЗначениеЗаполнено(Побоч.ДатаПроизводства) Тогда
					ФактическоеОкончаниеЭтапа=Макс(Побоч.ДатаПроизводства,ФактическоеОкончаниеЭтапа);
				КонецЕсли;
			КонецЦикла;
			//Если ЭтапПроизводстваОбъект.Статус=Перечисления.СтатусыЭтаповПроизводства2_2.Завершен Тогда
			ЭтапПроизводстваОбъект.ФактическоеОкончаниеЭтапа=ФактическоеОкончаниеЭтапа;
			//КонецЕсли;
			Если Не ЗначениеЗаполнено(ЭтапПроизводстваОбъект.ФактическоеОкончаниеЭтапа)И ЭтапПроизводстваОбъект.Статус=Перечисления.СтатусыЭтаповПроизводства2_2.Завершен Тогда
				ЭтапПроизводстваОбъект.ФактическоеНачалоЭтапа=ЭтапПроизводстваОбъект.Дата;
			КонецЕсли;

			Если Не ЗначениеЗаполнено(ЭтапПроизводстваОбъект.ФактическоеОкончаниеЭтапа)
				и ЭтапПроизводстваОбъект.Статус=Перечисления.СтатусыЭтаповПроизводства2_2.Завершен Тогда
				ЭтапПроизводстваОбъект.ФактическоеОкончаниеЭтапа=ТекущаяДата();
			КонецЕсли;


			#КонецОбласти


			Если  ЕстьВыпуск  и ЭтапПроизводстваОбъект.ПроизводствоОднойДатой Тогда

				ЭтапПроизводстваОбъект.ПроизводствоОднойДатой=Ложь;
			КонецЕсли;


			Для каждого ТЧВыпуск  Из ЭтапПроизводстваОбъект.ПобочныеИзделия  Цикл
				Если ЗначениеЗаполнено(ТЧВыпуск.Лико_Документ) И не ЗначениеЗаполнено(ТЧВыпуск.ДатаПроизводства) Тогда
					ТЧВыпуск.ДатаПроизводства=ТЧВыпуск.Лико_Документ.Дата;
				КонецЕсли;                       
			КонецЦикла; 

			Для каждого ТЧВыпуск  Из ЭтапПроизводстваОбъект.ВыходныеИзделия  Цикл
				Если ЗначениеЗаполнено(ТЧВыпуск.Лико_Документ) И не ЗначениеЗаполнено(ТЧВыпуск.ДатаПроизводства) Тогда
					ТЧВыпуск.ДатаПроизводства=ТЧВыпуск.Лико_Документ.Дата;
				КонецЕсли;                       
			КонецЦикла; 

			//+ Лико m.shenderov 04.04.2018
			//Удаление не произведенного выпуска
			//ЭтапПроизводстваОбъект=Документы.ЭтапПроизводства2_2.СоздатьДокумент();
			Структура = Новый Структура;
			Структура.Вставить("Произведено",Ложь);
			НайденыеСтроки=ЭтапПроизводстваОбъект.ВыходныеИзделия.НайтиСтроки(Структура);
			Для каждого НайденнаяСтрока Из НайденыеСтроки Цикл                                                    
				ЭтапПроизводстваОбъект.ВыходныеИзделия.Удалить(ЭтапПроизводстваОбъект.ВыходныеИзделия.Индекс(НайденнаяСтрока));                                                               
			КонецЦикла;

			//- Лико m.shenderov 04.04.2018




			ЭтапПроизводстваОбъект.ДополнительныеСвойства.Вставить("ПерезаполнитьВидыЗапасов",Истина);
			ЭтапПроизводстваОбъект.ДополнительныеСвойства.Вставить("ОтключитьКонтрольПриПроведении",Истина);

			//ЭтапПроизводстваОбъект.Записать();
			//Возврат;
			ЭтапПроизводстваОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Если ЕстьВыпуск Тогда
				СоздатьДокументВыпуска(Распоряжение,ЭтапПроизводстваОбъект.Ссылка,УжеСозданныеДокументы);
				Если ТипЗнч(ЗаказКлиента)=Тип("ДокументСсылка.ЗаказДавальца") ТОгда

					////СоздатьАктВыполненныхВнутреннихРабот(Распоряжение,ЭтапПроизводстваОбъект.Ссылка,УжеСозданныеДокументы);

				КонецЕсли;

			КонецЕсли;
			Если ЕстьРасход Тогда
				Для каждого Склад Из МассивСкладов Цикл
					СоздатьДокументРасхода(Распоряжение,ЭтапПроизводстваОбъект.Ссылка,УжеСозданныеДокументы,Склад);

				КонецЦикла;
			КонецЕсли;


		Исключение                                                    
			Сообщить(ОписаниеОшибки());            

		КонецПопытки;              
	КонецЦикла;



КонецПроцедуры


Процедура ФормированиеДвиженияПоВыпкскуЭтапа(ВыходныеИзделия,Выборка,ЗаказКлиента) //+Лико m.shenderov 21.11.2017
Если ТипЗнч(ЗаказКлиента)=Тип("ДокументСсылка.ЗаказДавальца") Тогда
		ДанныеДляПереработки=ПолучитьДанныеДляПереработки(ЗаказКлиента);
	КонецЕсли;
	
	Если Выборка.Количество>0 Тогда
		НоваяСтрока                                                                = ВыходныеИзделия.Добавить();             
		НоваяСтрока.Номенклатура                                                   = Выборка.Номенклатура;
		НоваяСтрока.Характеристика                                                 = Выборка.Характеристика;
		НоваяСтрока.КоличествоУпаковок                                             = Выборка.Количество;
		НоваяСтрока.Количество                                                     = Выборка.Количество;
		НоваяСтрока.Упаковка                                                       = НоваяСтрока.Номенклатура.ЕдиницаИзмерения;
		НоваяСтрока.Получатель                                                     = Выборка.Распоряжение.Склад;
		НоваяСтрока.Лико_Документ                                                  = Выборка.Распоряжение;
		НоваяСтрока.НомерБланка                                                    = Выборка.Распоряжение.НомерБланка;                                                            
		НоваяСтрока.Произведено                                                    = Истина;
		НоваяСтрока.ДатаПроизводства                                               = Выборка.Распоряжение.Дата;
		Если ЗначениеЗаполнено(Выборка.Распоряжение.ДатаДляТиповыхДокументов) Тогда
			НоваяСтрока.ДатаПроизводства                                           = Выборка.Распоряжение.ДатаДляТиповыхДокументов;                           
		КонецЕсли;
		НоваяСтрока.ДоляСтоимости                                                  = НоваяСтрока.Количество*1000; 
		
		Если ТипЗнч(ЗаказКлиента)=Тип("ДокументСсылка.ЗаказДавальца") Тогда 
			НоваяСтрока.Назначение                                                 =ДанныеДляПереработки.Назначение;
			НоваяСтрока.ОформитьОтчетДавальцу                                      =Истина;
			
		КонецЕсли;
		НоваяСтрока.Подразделение											  	   = Выборка.ЭтапПроизводства.Подразделение;
		
		
		

			КонецЕсли;
	КонецПроцедуры //-Лико m.shenderov 21.11.2017

Функция ПолучитьДанныеДляПереработки(ЗаказДавальца) //+Лико m.shenderov 21.08.2018
	Структура = Новый Структура;
	Структура.Вставить("Услуга");
	Структура.Вставить("ХарактеристикаУслуги");
	Структура.Вставить("Назначение");
	Структура.Вставить("Подразделение");
	
	Запрос = Новый Запрос;
	//Запрос.Текст = 
	//"ВЫБРАТЬ
	//|         Назначения.Ссылка КАК Назначение,
	//|         ЗаказДавальца.Подразделение КАК Подразделение,
	//|         ЗаказДавальца.Номенклатура КАК Номенклатура,
	//|         ЗаказДавальца.Характеристика КАК Характеристика
	//|ИЗ
	//|         Справочник.Назначения КАК Назначения
	//|                         ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказДавальца КАК ЗаказДавальца
	//|                         ПО Назначения.Договор = ЗаказДавальца.Договор
	//|ГДЕ
	//|         ЗаказДавальца.Ссылка = &ЗаказКлиента
	//|         И Назначения.Заказ.Ссылка ЕСТЬ NULL";
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             Назначения.Ссылка КАК Назначение,
	|             ЗаказДавальца.Подразделение КАК Подразделение,
	|             ЗаказДавальца.Номенклатура КАК Номенклатура,
	|             ЗаказДавальца.Характеристика КАК Характеристика
	|ИЗ
	|             Справочник.Назначения КАК Назначения
	|                             ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказДавальца КАК ЗаказДавальца
	|                             ПО Назначения.Заказ = ЗаказДавальца.Ссылка
	|                                             И Назначения.Договор = ЗаказДавальца.Договор
	|                                             И Назначения.Партнер = ЗаказДавальца.Партнер
	|ГДЕ
	|             ЗаказДавальца.Ссылка = &ЗаказКлиента";
	
	
	Запрос.УстановитьПараметр("ЗаказКлиента",ЗаказДавальца);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Структура.Услуга                                                                          =Выборка.Номенклатура;
		Структура.ХарактеристикаУслуги         =Выборка.Характеристика;
		Структура.Назначение                                               =Выборка.Назначение;
		Структура.Подразделение                                       =Выборка.Подразделение;
		
	КонецЦикла; 
	
	Возврат Структура; 
	
КонецФункции //-Лико m.shenderov 21.08.2018 
 
