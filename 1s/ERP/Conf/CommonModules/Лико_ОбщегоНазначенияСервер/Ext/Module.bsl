Процедура СоздатьРедактироватьПриходныйОрдер(Документ, ЗаказКлиента, Заказчик, Знач Выпуск, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ДокументСсылка=НайтиДокумент("ПриходныйОрдерНаТовары","Лико_Документ",Документ);
	
	ВхДокСсылка=НайтиДокумент("ПередачаСырьяПереработчику","Лико_Документ",Документ);
	Если Не ЗначениеЗаполнено(ВхДокСсылка) Тогда
		
		ВхДокСсылка=НайтиДокумент("ПередачаДавальцу","Лико_Документ",Документ);
	КонецЕсли;
	
	Если  ДокументСсылка<>Неопределено Тогда
		ДокументОбъект=ДокументСсылка.ПолучитьОбъект();
	Иначе
		ДокументОбъект= Документы.ПриходныйОрдерНаТовары.СоздатьДокумент();
	КонецЕсли;       
	
	Если Документ.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаДавальцу Тогда         
		Распоряжение=НайтиДокумент("ЗаказПереработчику","ДокументОснование",ЗаказКлиента);
	ИначеЕсли Документ.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Продажа Тогда    
		Распоряжение=ЗаказКлиента;
	Иначе
		Распоряжение=НайтиДокумент("ЗаказДавальца","Лико_ЗаказКлиента",ЗаказКлиента);
		
	КонецЕсли;
	
	Если Распоряжение=Неопределено Тогда
		Отказ=Истина;
		Возврат;
	КонецЕсли;
	
	
	
	Если ЗначениеЗаполнено(Распоряжение) Тогда          
		
		//Массив = Новый Массив();
		//Массив.Добавить(ЗаказДавальца);
		//Структура = Новый Структура;
		//Структура.Вставить("МассивЗаказов",Массив);
		Основание = Новый Структура;
		Основание.Вставить("Распоряжение"                ,Распоряжение);
		Основание.Вставить("Отправитель"                   ,Распоряжение.Партнер);
		Основание.Вставить("ЗакрыватьГрафикПоступления",Истина);
		//Основание.Вставить("Склад", Документ.Склад); 
		Основание.Вставить("Склад", Документ.АдресХранения.Владелец);

		Основание.Вставить("Помещение", Документ.АдресХранения.Помещение);
		Основание.Вставить("ЗонаПриемки", Документ.АдресХранения);
		Основание.Вставить("ДатаВходящегоДокумента", Документ.Дата);
