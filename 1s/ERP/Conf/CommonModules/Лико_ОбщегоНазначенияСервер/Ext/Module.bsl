		//            НоваяСтрока.Склад                                                     = УправлениеСвойствами.ЗначениеСвойства(Выборка.Распоряжение.Организация,"Лико_СкладОснастки");             
		//КонецЕсли;
		НоваяСтрока.Склад                                                     = Склад;
        НоваяСтрока.Подразделение											  = Выборка.ЭтапПроизводства.Подразделение;
