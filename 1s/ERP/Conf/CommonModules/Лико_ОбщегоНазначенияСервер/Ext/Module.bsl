функция ЗакрытиеОбъектовНоменклатурыВЗаказ(Структура) Экспорт //+Лико m.shenderov 08.03.2021
	
	Если ТипЗнч(Структура)<>Тип("Структура") Или 
		Не Структура.Свойство("МассивСерий") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокОбъект=Документы.Лико_БланкЭтапа.СоздатьДокумент();
	ДокОбъект.ВидОперации=Перечисления.Лико_ВидыОперацийЗакрытияБланка.ЗакрытиеБланка;
	ДокОбъект.РежимЗакрытия=перечисления.Лико_РежимЗакрытияЗаказа.ОставитьНаРабочемЦентре;
	   ЗаполнитьЗначенияСвойств(ДокОбъект,Структура);
	  ДокОбъект.Дата					  =ТекущаяДата();
	ТзСерии = Новый ТаблицаЗначений;
	ТзСерии.Колонки.Добавить("Серия",Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	ТзСерии.Колонки.Добавить("КоличествоРасходУУ",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
	Для каждого Массив Из Структура.МассивСерий Цикл
		НоваяСтрокаТз=ТзСерии.Добавить();
		НоваяСтрокаТз.Серия=Массив.Серия;
		НоваяСтрокаТз.КоличествоРасходУУ=Массив.Количество;
		
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТзСерии.Серия КАК Серия,
	|	ТзСерии.КоличествоРасходУУ КАК КоличествоРасходУУ
	|ПОМЕСТИТЬ ВтСерии
	|ИЗ
	|	&ТзСерии КАК ТзСерии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИСТИНА КАК Списать,
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.Характеристика КАК Характеристика,
	|	ТоварыВЯчейкахОстатки.Серия КАК Серия,
	|	ТоварыВЯчейкахОстатки.Упаковка КАК Упаковка,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК Количество,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток * ТоварыВЯчейкахОстатки.Упаковка.Числитель КАК КоличествоУУ,
	|	ВтСерии.КоличествоРасходУУ / ТоварыВЯчейкахОстатки.Упаковка.Числитель КАК КоличествоРасход,
	|	ВтСерии.КоличествоРасходУУ КАК КоличествоРасходУУ,
	|	ТоварыВЯчейкахОстатки.Ячейка КАК Адрес
	|ПОМЕСТИТЬ ВтОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Серия В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					ВтСерии.Серия КАК Серия
	|				ИЗ
	|					ВтСерии КАК ВтСерии)) КАК ТоварыВЯчейкахОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтСерии КАК ВтСерии
	|		ПО ТоварыВЯчейкахОстатки.Серия = ВтСерии.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтОстатки.Списать КАК Списать,
	|	ВтОстатки.Номенклатура КАК Номенклатура,
	|	ВтОстатки.Характеристика КАК Характеристика,
	|	ВтОстатки.Серия КАК Серия,
	|	ВтОстатки.Количество КАК Количество,
	|	ВтОстатки.КоличествоУУ КАК КоличествоУУ,
	|	ВтОстатки.КоличествоРасходУУ КАК КоличествоРасходУУ,
	|	ВтОстатки.КоличествоУУ - ВтОстатки.КоличествоРасходУУ КАК ВозвратКоличествоУУ,
	|	ВтОстатки.Количество - ВтОстатки.КоличествоРасход КАК ВозвратКоличество,
	|	ВтОстатки.КоличествоРасход КАК КоличествоРасход
	|ИЗ
	|	ВтОстатки КАК ВтОстатки";
	Запрос.УстановитьПараметр("ТзСерии",ТзСерии);
	РезультатЗапроса = Запрос.Выполнить();
	ДокОбъект.Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	
	//Пока Выборка.Следующий() Цикл 		
	//	НоваяСтрТовара					   =ДокОбъект.Товары.Добавить();
	//	НоваяСтрТовара.Номенклатура        =Выборка.Номенклатура;
	//	НоваяСтрТовара.Характеристика      =Выборка.Характеристика;
	//	НоваяСтрТовара.Серия               =Выборка.Серия;                           
	//	НоваяСтрТовара.Упаковка            =Выборка.Упаковка;
	//	НоваяСтрТовара.КоличествоУпаковок  =Выборка.КоличествоУпаковок;
	//	НоваяСтрТовара.Количество          =Выборка.Количество; 
	//	НоваяСтрТовара.АдресХранения       =Выборка.Адрес; 		
	//КонецЦикла; 
	
	
	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Структура = Новый Структура;
		Структура.Вставить("Ссылка",ДокОбъект.Ссылка);
		Структура.Вставить("Сообщение","Выполнено успешно!");

		Возврат Структура;
	Исключение
		Сообщение=ОписаниеОшибки();
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + ДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки()); 
		Структура = Новый Структура;
		Структура.Вставить("Ссылка",Ложь);
		Структура.Вставить("Сообщение",Сообщение);

		Возврат Структура;


	КонецПопытки;
	
	  
	
	
КонецФункции //-Лико m.shenderov 08.03.2021
 

Функция СписаниеОбъектовНоменклатурыСоСклада(Структура) Экспорт 

	Если ТипЗнч(Структура)<>Тип("Структура") Или 
		Не Структура.Свойство("МассивСерий") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокОбъект=Документы.Лико_ПередачаТоваров.СоздатьДокумент();
	СтруктураДокумента = Новый Структура;	
	ДокОбъект.Заполнить(СтруктураДокумента);
	Если Структура.Свойство("АвторДокумента") Тогда
		ДокОбъект.АвторДокумента=Структура.АвторДокумента; 	
	Иначе
		ДокОбъект.АвторДокумента=ПараметрыСеанса.ТекущийПользователь.ФизическоеЛицо;	
	КонецЕсли;
	
	
	
	ДокОбъект.Сотрудник	               =ДокОбъект.АвторДокумента;
	ДокОбъект.ВидОперации	           =Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Списание;
	
	ЗаполнитьЗначенияСвойств(ДокОбъект,Структура);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.Характеристика КАК Характеристика,
	|	ТоварыВЯчейкахОстатки.Упаковка КАК Упаковка,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК КоличествоУпаковок,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток * ТоварыВЯчейкахОстатки.Упаковка.Числитель КАК Количество,
	|	ТоварыВЯчейкахОстатки.Ячейка КАК Адрес,
	|	ТоварыВЯчейкахОстатки.Серия КАК Серия
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(, Серия В (&МассивСерий)) КАК ТоварыВЯчейкахОстатки";
	Запрос.УстановитьПараметр("МассивСерий",Структура.МассивСерий);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл 		
		НоваяСтрТовара					   =ДокОбъект.Товары.Добавить();
		НоваяСтрТовара.Номенклатура        =Выборка.Номенклатура;
		НоваяСтрТовара.Характеристика      =Выборка.Характеристика;
		НоваяСтрТовара.Серия               =Выборка.Серия;                           
		НоваяСтрТовара.Упаковка            =Выборка.Упаковка;
		НоваяСтрТовара.КоличествоУпаковок  =Выборка.КоличествоУпаковок;
		НоваяСтрТовара.Количество          =Выборка.Количество; 
		НоваяСтрТовара.АдресХранения       =Выборка.Адрес; 		
	КонецЦикла; 
	
		Если 	 Структура.Свойство("МассивОбъектов") Тогда 
		
		Для каждого Выборка Из Структура.МассивОбъектов Цикл 
			
			НоваяСтрТовара					   =ДокОбъект.Товары.Добавить();
			НоваяСтрТовара.Номенклатура        =Выборка.ОбъектНоменклатуры.Номенклатура;
			НоваяСтрТовара.Характеристика      =Выборка.ОбъектНоменклатуры.Характеристика;
			НоваяСтрТовара.Серия               =Выборка.Серия;                           
			НоваяСтрТовара.Упаковка            =Выборка.ОбъектНоменклатуры.БазоваяЕдиницаИзмерения;
			НоваяСтрТовара.КоличествоУпаковок  =Выборка.Количество;
			НоваяСтрТовара.Количество          =Выборка.Количество*НоваяСтрТовара.Упаковка.Числитель; 
			НоваяСтрТовара.АдресХранения       =Выборка.Адрес; 
			
			
		КонецЦикла;		
		
	КонецЕсли;

	
	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Возврат ДокОбъект.Ссылка;
	Исключение
		Возврат Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + ДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки()); 
	КонецПопытки;
	
	
	



КонецФункции



функция ПеремещениеОбъектовНоменклатуры(Структура) Экспорт  //+Лико m.shenderov 08.03.2021
	
	Если ТипЗнч(Структура)<>Тип("Структура") Или 
		Не Структура.Свойство("МассивСерий") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокОбъект=Документы.Лико_ПередачаТоваров.СоздатьДокумент();
	СтруктураДокумента = Новый Структура;	
	ДокОбъект.Заполнить(СтруктураДокумента);
	Если Структура.Свойство("АвторДокумента") Тогда
		ДокОбъект.АвторДокумента=Структура.АвторДокумента; 	
	Иначе
		ДокОбъект.АвторДокумента=ПараметрыСеанса.ТекущийПользователь.ФизическоеЛицо;	
	КонецЕсли;
	
	
	
	ДокОбъект.Сотрудник	               =ДокОбъект.АвторДокумента;
	ДокОбъект.ВидОперации	           =Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение;
	
	ЗаполнитьЗначенияСвойств(ДокОбъект,Структура);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.Характеристика КАК Характеристика,
	|	ТоварыВЯчейкахОстатки.Упаковка КАК Упаковка,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК КоличествоУпаковок,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток * ТоварыВЯчейкахОстатки.Упаковка.Числитель КАК Количество,
	|	ТоварыВЯчейкахОстатки.Ячейка КАК Адрес,
	|	ТоварыВЯчейкахОстатки.Серия КАК Серия
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(, Серия В (&МассивСерий)) КАК ТоварыВЯчейкахОстатки";
	Запрос.УстановитьПараметр("МассивСерий",Структура.МассивСерий);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл 		
		НоваяСтрТовара					   =ДокОбъект.Товары.Добавить();
		НоваяСтрТовара.Номенклатура        =Выборка.Номенклатура;
		НоваяСтрТовара.Характеристика      =Выборка.Характеристика;
		НоваяСтрТовара.Серия               =Выборка.Серия;                           
		НоваяСтрТовара.Упаковка            =Выборка.Упаковка;
		НоваяСтрТовара.КоличествоУпаковок  =Выборка.КоличествоУпаковок;
		НоваяСтрТовара.Количество          =Выборка.Количество; 
		НоваяСтрТовара.АдресХранения       =Выборка.Адрес; 		
	КонецЦикла; 
	
	Если 	 Структура.Свойство("МассивОбъектов") Тогда 
		
		Для каждого Выборка Из Структура.МассивОбъектов Цикл 
			
			НоваяСтрТовара					   =ДокОбъект.Товары.Добавить();
			НоваяСтрТовара.Номенклатура        =Выборка.ОбъектНоменклатуры.Номенклатура;
			НоваяСтрТовара.Характеристика      =Выборка.ОбъектНоменклатуры.Характеристика;
			НоваяСтрТовара.Серия               =Выборка.Серия;                           
			НоваяСтрТовара.Упаковка            =Выборка.ОбъектНоменклатуры.БазоваяЕдиницаИзмерения;
			НоваяСтрТовара.КоличествоУпаковок  =Выборка.Количество;
			НоваяСтрТовара.Количество          =Выборка.Количество*НоваяСтрТовара.Упаковка.Числитель; 
			НоваяСтрТовара.АдресХранения       =Выборка.Адрес; 
			
			
		КонецЦикла;		
		
	КонецЕсли;
	Если ДокОбъект.Товары.Количество()=0 Тогда
		Возврат "Нет данных!!!";
	КонецЕсли;
	
	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Возврат ДокОбъект.Ссылка;
	Исключение
		Ошибка="Документ """ + ДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки();
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента(Ошибка);
		Возврат Ошибка;
	КонецПопытки; 
	
	
КонецФункции //-Лико m.shenderov 08.03.2021



функция СоздатьРедактироватьДокументЛико_БланкЭтапа(Структура,Ссылка=Неопределено) Экспорт //+Лико m.shenderov 08.03.2021
	
	
	Если ТипЗнч(Структура)<>Тип("Структура") Или 
		Не Структура.Свойство("МассивСерийТовары") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Ссылка=Неопределено Тогда
		
		ДокОбъект				= Документы.Лико_БланкЭтапа.СоздатьДокумент();
		ДокОбъект.ВидОперации	= Перечисления.Лико_ВидыОперацийЗакрытияБланка.ЗакрытиеБланка;
		ДокОбъект.РежимЗакрытия	= Перечисления.Лико_РежимЗакрытияЗаказа.ОставитьНаРабочемЦентре;
		ДокОбъект.Дата		    = ТекущаяДата();
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДокОбъект,Структура);
		
	ДокОбъект.Товары.Загрузить(ЗаполнитьТЧТоварыПоСериям(Структура.МассивСерийТовары,ДокОбъект.РабочийЦентр.ЛикоЯчейка));
	
	Если Структура.Свойство("Выпуск") и ТипЗнч(Структура.Выпуск)=Тип("СправочникСсылка.Номенклатура") Тогда
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Номенклатура",Структура.Выпуск);
		СтруктураПараметров.Вставить("Количество",Структура.ВыпускКоличество);
		лУпаковка=ПолучитьУпаковку(Структура.ВыпускКоличество,Структура.Выпуск);
		
		СтруктураПараметров.Вставить("Упаковка",лУпаковка);
		СтруктураПараметров.Вставить("Рулонный",Ложь);
		СтруктураПараметров.Вставить("Уникальный",Истина);
		СправочникОбъект=СоздатьОбъектНаСервере(СтруктураПараметров);
		
		НоваяСтрВыпуск=ДокОбъект.Выпуск.Добавить();
		НоваяСтрВыпуск.Номенклатура		=СправочникОбъект.Номенклатура;
		НоваяСтрВыпуск.Характеристика	=СправочникОбъект.Характеристика;
		НоваяСтрВыпуск.Серия			=СправочникОбъект.Серия;
		НоваяСтрВыпуск.Упаковка			=СправочникОбъект.БазоваяЕдиницаИзмерения;
		НоваяСтрВыпуск.Количество		=СправочникОбъект.Количество;
		НоваяСтрВыпуск.КоличествоУУ		=СправочникОбъект.Количество*СправочникОбъект.БазоваяЕдиницаИзмерения.Числитель; 
	КонецЕсли;

	Если ДокОбъект.РабочийЦентр.ВидРабочегоЦентра=Справочники.ВидыРабочихЦентров.ГравировальныйУчасток Тогда
		 ДокОбъект.ДатаОкончания=ДокОбъект.Дата;
		 ДокОбъект.ДатаНачала=ПолучитьДатуНачалаЭтапаЗаказа(ДокОбъект.ЗаказПокупателя,Справочники.Лико_ЭтапыВыполненияЗаказа.Гравируется);
		 Если ЗначениеЗаполнено( ДокОбъект.ДатаНачала) И ЗначениеЗаполнено( ДокОбъект.ДатаОкончания) Тогда
		 ДокОбъект.Трудозатраты=(ДокОбъект.ДатаОкончания-ДокОбъект.ДатаНачала)/(60*60);
		 КонецЕсли;
	КонецЕсли;
	
	
	
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Структура = Новый Структура;
		Структура.Вставить("Ссылка",ДокОбъект.Ссылка);
		Структура.Вставить("Сообщение","Выполнено успешно!"); 
		Возврат Структура;
		
	Исключение
		Сообщение=ОписаниеОшибки();
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + ДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки()); 
		Структура = Новый Структура;
		Структура.Вставить("Ссылка",Ложь);
		Структура.Вставить("Сообщение",Сообщение);

		Возврат Структура;


	КонецПопытки;
	
	  
	
	
КонецФункции //-Лико m.shenderov 08.03.2021

Функция ПолучитьДатуНачалаЭтапаЗаказа( Заказ,Этап) //+Лико m.shenderov 16.09.2021
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(Лико_ЭтапыЗаказа.Период) КАК Период
		|ИЗ
		|	РегистрСведений.Лико_ЭтапыЗаказа КАК Лико_ЭтапыЗаказа
		|ГДЕ
		|	Лико_ЭтапыЗаказа.Заказ = &Заказ
		|	И Лико_ЭтапыЗаказа.Этап = &Этап";
		Запрос.УстановитьПараметр("Заказ",Заказ );
		Запрос.УстановитьПараметр("Этап",Этап );

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
		    Возврат Выборка.Период;
		КонецЦикла; 
		
		
КонецФункции //-Лико m.shenderov 16.09.2021 

Функция ЗаполнитьТЧТоварыПоСериям(МассивСерий,АдресРабочегоЦентра) //+Лико m.shenderov 08.09.2021
	
	ТзСерии = Новый ТаблицаЗначений;
	ТзСерии.Колонки.Добавить("Серия",Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	ТзСерии.Колонки.Добавить("КоличествоРасходУУ",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
	
	Для каждого Массив Из МассивСерий Цикл
		
		НоваяСтрокаТз                    = ТзСерии.Добавить();
		НоваяСтрокаТз.Серия              = Массив.Серия;
		НоваяСтрокаТз.КоличествоРасходУУ = Массив.Количество;
		
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТзСерии.Серия КАК Серия,
	|	ТзСерии.КоличествоРасходУУ КАК КоличествоРасходУУ
	|ПОМЕСТИТЬ ВтСерии
	|ИЗ
	|	&ТзСерии КАК ТзСерии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИСТИНА КАК Списать,
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.Характеристика КАК Характеристика,
	|	ТоварыВЯчейкахОстатки.Серия КАК Серия,
	|	ТоварыВЯчейкахОстатки.Упаковка КАК Упаковка,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК Количество,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток * ТоварыВЯчейкахОстатки.Упаковка.Числитель КАК КоличествоУУ,
	|	ВтСерии.КоличествоРасходУУ / ТоварыВЯчейкахОстатки.Упаковка.Числитель КАК КоличествоРасход,
	|	ВтСерии.КоличествоРасходУУ КАК КоличествоРасходУУ,
	|	ТоварыВЯчейкахОстатки.Ячейка КАК Адрес
	|ПОМЕСТИТЬ ВтОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Ячейка = &АдресРабочегоЦентра
	|				И Серия В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ВтСерии.Серия КАК Серия
	|					ИЗ
	|						ВтСерии КАК ВтСерии)) КАК ТоварыВЯчейкахОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтСерии КАК ВтСерии
	|		ПО ТоварыВЯчейкахОстатки.Серия = ВтСерии.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтОстатки.Списать КАК Списать,
	|	ВтОстатки.Номенклатура КАК Номенклатура,
	|	ВтОстатки.Характеристика КАК Характеристика,
	|	ВтОстатки.Серия КАК Серия,
	|	ВтОстатки.Количество КАК Количество,
	|	ВтОстатки.КоличествоУУ КАК КоличествоУУ,
	|	ВтОстатки.КоличествоРасходУУ КАК КоличествоРасходУУ,
	|	ВтОстатки.КоличествоУУ - ВтОстатки.КоличествоРасходУУ КАК ВозвратКоличествоУУ,
	|	ВтОстатки.Количество - ВтОстатки.КоличествоРасход КАК ВозвратКоличество,
	|	ВтОстатки.КоличествоРасход КАК КоличествоРасход
	|ИЗ
	|	ВтОстатки КАК ВтОстатки";
	Запрос.УстановитьПараметр("ТзСерии",ТзСерии);
	Запрос.УстановитьПараметр("АдресРабочегоЦентра",АдресРабочегоЦентра);

	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции //-Лико m.shenderov 08.09.2021 

