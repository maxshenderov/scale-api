Функция  ИмяЯчейки(Строка1,Колонка1,Строка2=Неопределено,Колонка2=Неопределено)
	
	Если Строка2=Неопределено Тогда
		Возврат "R"+Формат(Строка1,"ЧГ=")+"C"+Формат(Колонка1,"ЧГ=");
	Иначе
		Возврат "R"+Формат(Строка1,"ЧГ=")+"C"+Формат(Колонка1,"ЧГ=")+ ":R"+Формат(Строка2,"ЧГ=")+"C"+Формат(Колонка2,"ЧГ=");                  
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьПланировщикНаСервере(ПланировщикТД, Объект)
	лЗаказOnline=Неопределено;
	лПроцент=0;
	лОсталось=0;
	
	РазмерШрифта                                  =Объект.РазмерШрифта;
	Масштаб_Т                                     =Объект.Масштаб;       
	ЦветФона                                      =Объект.ЦветФона;
	ЦветОтсутствияОснастки                        =Объект.ЦветОтсутствияОснастки;
	ЦветОтсутствияФормы                           =Объект.ЦветОтсутствияФормы;
	ЦветНаличияМатериалов                         =Объект.ЦветНаличияМатериалов;
	ЦветТекста                                    =Объект.ЦветТекста;   
	ВысотаСтроки                                  =Объект.ВысотаСтроки;
	НачальныйЧас                                  =Час(Объект.НачалоПериода);
	КоличествоЧасов                               =Цел((Объект.КонецПериода-Объект.НачалоПериода)/(60*60));
	Линия                                         =Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
	ЛинияПунктир                                  =Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.ЧастыйПунктир,1);   
	НачалоПериода                                 =Объект.НачалоПериода;
	КонецПериода                                  =Объект.КонецПериода;
	
	РазмерШрифтаOnline                            =Объект.РазмерШрифтаOnline;
	ЦветФонаOnline                                =Объект.ЦветФонаOnline;
	ЦветТекстаOnline                              =Объект.ЦветТекстаOnline;
	СписокМашин                                   =Объект.СписокМашин;
	
	//КонецПериода= КонецПериода+20*24*60*60;
	
	ТЗ=ПланРаботЗпПериод(НачалоПериода,КонецПериода,СписокМашин);
	
	РезультатЗапроса          =ПланРаботЗпПериод2(ТЗ); 
	ВыборкаРабочийЦентр =РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	НачальнаяСтрока                          =4;
	НачальнаяКолонка       =9;         
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,2);
	
	ЗаказыOnline=ЗаказыOnline(СписокМашин);
	
	Пока ВыборкаРабочийЦентр.Следующий() Цикл                        
		НачальнаяСтрока=НачальнаяСтрока+1;
		
		
		ЯчейкаЧ=ИмяЯчейки(НачальнаяСтрока,1);
		ЯчейкаРц=ЯчейкаЧ;
		
		ПланировщикТД.Область(ЯчейкаЧ).Шрифт=Новый Шрифт(ПланировщикТД.Область(ЯчейкаЧ).Шрифт,,РазмерШрифтаOnline+2,Истина);
		ПланировщикТД.Область(ЯчейкаЧ).Обвести(Линия,Линия,Линия,Линия);
		ПланировщикТД.Область(ЯчейкаЧ).ГоризонтальноеПоложение=ГоризонтальноеПоложение.Центр;
		ПланировщикТД.Область(ЯчейкаЧ).ВертикальноеПоложение=ВертикальноеПоложение.Центр;
		ПланировщикТД.Область(ЯчейкаЧ).Текст=ВыборкаРабочийЦентр.РабочийЦентр.ПорядковыйНомер;
		ПланировщикТД.Область(ЯчейкаЧ).РазмещениеТекста=ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		ПланировщикТД.Область(ЯчейкаЧ).ЦветТекста =ЦветТекстаOnline;
		ПланировщикТД.Область(ЯчейкаЧ).ЦветФона =ЦветФонаOnline;                       
		//ЗаказыOnline = Новый ТаблицаЗначений;
		СтрокаЗаказ=ЗаказыOnline.Найти(ВыборкаРабочийЦентр.РабочийЦентр,"РабочийЦентр");
		Если СтрокаЗаказ<>Неопределено Тогда
			
			ЯчейкаЧ=ИмяЯчейки(НачальнаяСтрока,2);      
			ПланировщикТД.Область(ЯчейкаЧ).Шрифт=Новый Шрифт(ПланировщикТД.Область(ЯчейкаЧ).Шрифт,,РазмерШрифтаOnline,Истина);
			//ПланировщикТД.Область(ЯчейкаЧ).ШиринаКолонки=30;
			ПланировщикТД.Область(ЯчейкаЧ).Обвести(Линия,Линия,Линия,Линия);
			ПланировщикТД.Область(ЯчейкаЧ).ГоризонтальноеПоложение=ГоризонтальноеПоложение.Центр;
			ПланировщикТД.Область(ЯчейкаЧ).ВертикальноеПоложение=ВертикальноеПоложение.Центр;
			ПланировщикТД.Область(ЯчейкаЧ).РазмещениеТекста=ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			ПланировщикТД.Область(ЯчейкаЧ).ЦветТекста =ЦветТекстаOnline;
			ПланировщикТД.Область(ЯчейкаЧ).ЦветФона =ЦветФонаOnline;
			
			СтруктураРасшифровки = Новый  Структура;
			СтруктураРасшифровки.Вставить("РЦ",СтрокаЗаказ.РабочийЦентр);
			СтруктураРасшифровки.Вставить("Заказ",СтрокаЗаказ.Заказ);
			СтруктураРасшифровки.Вставить("ВремяВыполнения",ФорматДлительности(СтрокаЗаказ.Длительность));
			СтруктураРасшифровки.Вставить("ПроцентВыполнения",СтрокаЗаказ.Процент);
			СтруктураРасшифровки.Вставить("НаличиеФорм",СтрокаЗаказ.Форма);
