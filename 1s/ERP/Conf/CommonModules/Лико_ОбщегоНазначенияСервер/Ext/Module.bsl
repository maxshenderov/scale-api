		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|              ПередачаСырьяПереработчикуТовары.Цена КАК Цена
		|ИЗ
		|              Документ.ПередачаСырьяПереработчику.Товары КАК ПередачаСырьяПереработчикуТовары
		|ГДЕ
		|              ПередачаСырьяПереработчикуТовары.Номенклатура = &Номенклатура
		|              И ПередачаСырьяПереработчикуТовары.ЗаказПереработчику = &ЗаказПереработчику";
		Запрос.УстановитьПараметр("Номенклатура",СтрокаТовары.Номенклатура);
		Запрос.УстановитьПараметр("ЗаказПереработчику",ЗаказВПереработку);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Цена=Выборка.Цена;
		КонецЦикла; 
		
		
		//СтрокиЗаказа=ЗаказВПереработку.Материалы.НайтиСтроки(Структура);
		//Для каждого ЦенаВЗаказе Из  СтрокиЗаказа Цикл
		//            Цена= ЦенаВЗаказе.Цена;
		//КонецЦикла;
		
		СтрокаТовары.Цена = Цена;
		//СтруктураДействий = Новый Структура;
		//СтруктураДействий.Вставить("ПересчитатьСумму");
		//ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, Неопределено);
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСумму");
		//СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", ДокументОбъект.НалогообложениеНДС);
		//СтруктураДействий.Вставить("ПересчитатьСуммуНДС", Новый Структура("ЦенаВключаетНДС,СтавкаНДС", ДокументОбъект.ЦенаВключаетНДС, ДокументОбъект.СтавкаНДС));
		//СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, Неопределено);
		
	КонецЦикла;
	
