Функция  ПолучитьЦенуПоследнейЗакупкиЗакупкиНоменклатуры(Организация,Номенклатура,Характеристика,Дата,ВключаетНДС=Ложь,Управленческая=Ложь) Экспорт  //+Лико m.shenderov 18.08.2018
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             ВЫБОР
	|                             КОГДА Закупки.Количество = 0
	|                                             ТОГДА 0
	|                             ИНАЧЕ Закупки.Сумма / Закупки.Количество
	|             КОНЕЦ КАК цена,
	|             ВЫБОР
	|                             КОГДА Закупки.Количество = 0
	|                                             ТОГДА 0
	|                             ИНАЧЕ Закупки.СуммаБезНДС / Закупки.Количество
	|             КОНЕЦ КАК ЦенаБезНДС,
	|             ВЫБОР
	|                             КОГДА Закупки.Количество = 0
	|                                             ТОГДА 0
	|                             ИНАЧЕ Закупки.СуммаРегл / Закупки.Количество
	|             КОНЕЦ КАК ЦенаРегл,
	|             ВЫБОР
	|                             КОГДА Закупки.Количество = 0
	|                                             ТОГДА 0
	|                             ИНАЧЕ Закупки.СуммаРеглБезНДС / Закупки.Количество
	|             КОНЕЦ КАК ЦенаРеглБезНДС,
	|             ВЫБОР
	|                             КОГДА Закупки.Количество = 0
	|                                             ТОГДА 0
	|                             ИНАЧЕ Закупки.Стоимость / Закупки.Количество
	|             КОНЕЦ КАК ЦенаСтоимость,
	|             ВЫБОР
	|                             КОГДА Закупки.Количество = 0
	|                                             ТОГДА 0
	|                             ИНАЧЕ Закупки.СтоимостьБезНДС / Закупки.Количество
	|             КОНЕЦ КАК ЦенаСтоимостьБезНДС
	|ИЗ
	|             РегистрНакопления.Закупки КАК Закупки
	|ГДЕ
	|             Закупки.АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
	|             И Закупки.АналитикаУчетаНоменклатуры.Характеристика = &Характеристика
	|             И Закупки.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация",Организация );
	Запрос.УстановитьПараметр("Характеристика",Характеристика );
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура );
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл                       
		Если ВключаетНДС И Управленческая ТОгда
			Возврат Выборка.Цена;
		ИначеЕсли Не ВключаетНДС И Управленческая Тогда
			Возврат Выборка.ЦенаБезНДС;
			
		ИначеЕсли  ВключаетНДС И Не Управленческая Тогда
			Возврат Выборка.ЦенаРегл;
			
		ИначеЕсли Не ВключаетНДС И Не Управленческая Тогда
			
			Возврат Выборка.ЦенаРеглБезНДС;
		КонецЕсли;       
	КонецЦикла;  
	
