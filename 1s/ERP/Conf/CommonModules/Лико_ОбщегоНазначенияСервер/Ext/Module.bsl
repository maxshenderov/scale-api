Функция СформироватьСоответствиеЗаказыПартии(Пакет)//+Лико m.shenderov 18.03.2021
	
	Соответствие = Новый Соответствие;
	
	ВыборкаЗаказ=Пакет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЗаказ.Следующий() Цикл 		
		Заказ=ВыборкаЗаказ.Заказ;
		Соответствие.Вставить(Заказ);
		ВыборкаПартии=ВыборкаЗаказ.Выбрать();
		Тз=СформироватьТзПартий();
		
		Пока ВыборкаПартии.Следующий() Цикл			  
			НоваяСтрокаТз=Тз.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТз,ВыборкаПартии);			  
		КонецЦикла;		
		Соответствие[Заказ]=Тз;		  
	КонецЦикла;	
	Возврат Соответствие;
	
