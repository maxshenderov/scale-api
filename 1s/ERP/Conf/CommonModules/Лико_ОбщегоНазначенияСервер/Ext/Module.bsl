	Переработчик =ОпределитьПереработчика(Документ);         
	Если Переработчик=Неопределено ТОгда
		
		Отказ=Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не определен переработчик!";
		Сообщение.Сообщить();                           
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Материалы       =ОпределяемДавальческоеСырье(Документ,Заказчик);
	
	//НайтиДокументИПометитьНаУдаление("ПоступлениеОтПереработчика","Лико_Документ",Документ,Отказ);
	//НайтиДокументИПометитьНаУдаление("ПередачаДавальцу","Лико_Документ",Документ,Отказ);
	
	СтруктураСписанияБрака = Неопределено;
	
	Если Документ.ВозвратДавальцу Тогда
		Если Материалы.Количество()<>0 Тогда
			СоздатьРедактироватьВозвратСырьяДавальцу(Документ,Документ.ЗаказКлиента, Заказчик,Материалы,Отказ);  
			
			Если ЗначениеЗаполнено(Документ.ПодписьДокументаСотрудником) Тогда
				СтруктураСписанияБрака= Новый Структура;
				
				СтруктураСписанияБрака.Вставить("МассивСерий",Документ.Товары.ВыгрузитьКолонку("Серия"));
				СтруктураСписанияБрака.Вставить("Организация",Заказчик); 
				СтруктураСписанияБрака.Вставить("АвторДокумента",Документ.ПодписьДокументаСотрудником);
				СтруктураСписанияБрака.Вставить("Лико_Документ",Документ); 
				СтруктураСписанияБрака.Вставить("Дата",Документ.Дата+2); 
				
				ДокументСписания=НайтиДокумент("Лико_ПередачаТоваров","Лико_Документ",Документ);
				
				Если  ДокументСписания<>Неопределено  Тогда
					СтруктураСписанияБрака.Вставить("ДокументСписания",ДокументСписания);  
				КонецЕсли;				
			КонецЕсли;			
			//СоздатьРедактироватьВозвратСырьяОтПереработчика(Документ,Документ.ЗаказКлиента, Заказчик,Материалы,Отказ); 	
		КонецЕсли;	
	Иначе		
		Если Материалы.Количество()<>0 Тогда
			//СоздатьРедактироватьПоступлениеОтПереработчика(Документ,Документ.ЗаказКлиента, Заказчик,Материалы,Отказ); 
			СоздатьРедактироватьПередачаДавальцу(Документ,Документ.ЗаказКлиента, Заказчик,Материалы,Отказ);  
			Материалы      =ОпределяемДавальческоеСырье(Документ,Заказчик);
			СоздатьРедактироватьОтчетДавальцу(Документ,Документ.ЗаказКлиента, Заказчик,Материалы,Отказ);			
		КонецЕсли;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Лико_Дополнительно.ПолучитьОрганизациюПоКонтрагенту(Документ.Контрагент)) Тогда		
		СоздатьРедактироватьПриходныйОрдер(Документ,Документ.ЗаказКлиента, Заказчик,Материалы,Отказ); 		
		
		///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
		// ---> Создание документа списания давльческого брака
		Если СтруктураСписанияБрака<>Неопределено Тогда 		
			
			Если СтруктураСписанияБрака.Свойство("ДокументСписания") Тогда
				
				ДокОбъект=СтруктураСписанияБрака.ДокументСписания.ПолучитьОбъект();	
				
			Иначе		
				
				ДокОбъект=Документы.Лико_ПередачаТоваров.СоздатьДокумент();
				
			КонецЕсли;  
			
			ДокОбъект.ПометкаУдаления	=	Ложь;
			
			СтруктураДокумента = Новый Структура;	
			ДокОбъект.Заполнить(СтруктураДокумента);
			Если СтруктураСписанияБрака.Свойство("АвторДокумента") Тогда
				ДокОбъект.АвторДокумента=СтруктураСписанияБрака.АвторДокумента; 	
			Иначе
				ДокОбъект.АвторДокумента=ПараметрыСеанса.ТекущийПользователь.ФизическоеЛицо;	
			КонецЕсли;
			
			
			
			ДокОбъект.Сотрудник	               =ДокОбъект.АвторДокумента;
			ДокОбъект.ВидОперации	           =Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Списание;
			
			ЗаполнитьЗначенияСвойств(ДокОбъект,СтруктураСписанияБрака);
			
			Если СтруктураСписанияБрака.Свойство("Организация") Тогда
				ДокОбъект.Организация=СтруктураСписанияБрака.Организация;	
			КонецЕсли;
			
			ДокОбъект.Товары.Загрузить(Документ.Товары.Выгрузить());
			
			Для каждого Товар Из ДокОбъект.Товары Цикл				
				Товар.АдресХранения  =Документ.АдресХранения;				
			КонецЦикла;				
		    ДокОбъект.БракМатериала=Истина;
			ДокОбъект.Комментарий=СтрШаблон("Списание забракованного материала у переработчика. Документ переработчика : %1",Документ);
			Попытка
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + ДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки()); 
			КонецПопытки;			
		КонецЕсли;
		// <--- Создание документа списания давльческого брака
        ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	КонецЕсли;
	
КонецПроцедуры


#Область Доп_Функции


Функция ОпределитьПереработчика(Документ) Экспорт//+Лико m.shenderov 18.08.2018
	Если ТипЗнч(Документ)=Тип("ДокументСсылка.Лико_ПередачаТоваров") Тогда
		Заказ=Документ.ЗаказКлиента;
	ИначеЕсли  ТипЗнч(Документ)=Тип("ДокументСсылка.Лико_БланкЭтапа")ТОгда
		Заказ=Документ.ЗаказПокупателя;
	Иначе
		Заказ=Документы.ЗаказКлиента.ПустаяСсылка();
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             ЗаказДавальца.Организация КАК Организация
	|ИЗ
	|             Документ.ЗаказДавальца КАК ЗаказДавальца
	|ГДЕ
	|             ЗаказДавальца.Лико_ЗаказКлиента = &Лико_ЗаказКлиента";
	Запрос.УстановитьПараметр("Лико_ЗаказКлиента",Заказ );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Организация;            
	КонецЦикла; 
	
	
КонецФункции //-Лико m.shenderov 18.08.2018 


