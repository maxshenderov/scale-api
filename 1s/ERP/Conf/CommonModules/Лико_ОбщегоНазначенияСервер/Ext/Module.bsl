Процедура ОбновитьОчередьВПлане()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             ТС_ПланированиеРемонтныхРаботРЦ.РабочийЦентр,
	|             ТС_ПланированиеРемонтныхРаботРЦ.ЗаявкаНаРемонт,
	|             ТС_ПланированиеРемонтныхРаботРЦ.НомерОчереди КАК НомерОчереди
	|ИЗ
	|             РегистрСведений.ТС_ПланированиеРемонтныхРаботРЦ КАК ТС_ПланированиеРемонтныхРаботРЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|             НомерОчереди";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	НомерОчереди=1;
	Пока Выборка.Следующий() Цикл
		Если НомерОчереди<>Выборка.НомерОчереди Тогда
			НаборЗаписей = РегистрыСведений.ТС_ПланированиеРемонтныхРаботРЦ.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЗаявкаНаРемонт.Установить(Выборка.ЗаявкаНаРемонт);
			НаборЗаписей.Прочитать();
			Для каждого Запись Из НаборЗаписей  Цикл
				
				Запись.НомерОчереди=НомерОчереди;
			КонецЦикла;
			НаборЗаписей.Записать();
			
			
		КонецЕсли;
		
		НомерОчереди=НомерОчереди+1;
		
	КонецЦикла; 
	
	
	
КонецПроцедуры

Функция ВТранслит(Строка)Экспорт
	
	Алфавиты = Новый Соответствие;
	Алфавиты.Вставить("а",   "a"); Алфавиты.Вставить("А",   "A");
	Алфавиты.Вставить("б",   "b"); Алфавиты.Вставить("Б",   "B"); 
	Алфавиты.Вставить("в",   "v"); Алфавиты.Вставить("В",   "V"); 
	Алфавиты.Вставить("г",   "g"); Алфавиты.Вставить("Г",   "G"); 
	Алфавиты.Вставить("д",   "d"); Алфавиты.Вставить("Д",   "D"); 
	Алфавиты.Вставить("е",   "e"); Алфавиты.Вставить("Е",   "E"); 
	Алфавиты.Вставить("ё",   "e"); Алфавиты.Вставить("Ё",   "E"); 
	Алфавиты.Вставить("ж",   "j"); Алфавиты.Вставить("Ж",   "J"); 
	Алфавиты.Вставить("з",   "z"); Алфавиты.Вставить("З",   "Z"); 
	Алфавиты.Вставить("и",   "i"); Алфавиты.Вставить("И",   "I"); 
	Алфавиты.Вставить("й",   "y"); Алфавиты.Вставить("Й",   "Y"); 
	Алфавиты.Вставить("к",   "k"); Алфавиты.Вставить("К",   "K"); 
	Алфавиты.Вставить("л",   "l"); Алфавиты.Вставить("Л",   "L"); 
	Алфавиты.Вставить("м",   "m"); Алфавиты.Вставить("М",   "M"); 
	Алфавиты.Вставить("н",   "n"); Алфавиты.Вставить("Н",   "N"); 
	Алфавиты.Вставить("о",   "o"); Алфавиты.Вставить("О",   "O"); 
	Алфавиты.Вставить("п",   "p"); Алфавиты.Вставить("П",   "P"); 
	Алфавиты.Вставить("р",   "r"); Алфавиты.Вставить("Р",   "R"); 
	Алфавиты.Вставить("с",   "s"); Алфавиты.Вставить("С",   "S"); 
	Алфавиты.Вставить("т",   "t"); Алфавиты.Вставить("Т",   "T"); 
	Алфавиты.Вставить("у",   "u"); Алфавиты.Вставить("У",   "U"); 
	Алфавиты.Вставить("ф",   "f"); Алфавиты.Вставить("Ф",   "F"); 
	Алфавиты.Вставить("х",   "h"); Алфавиты.Вставить("Х",   "H"); 
	Алфавиты.Вставить("ц",  "tc"); Алфавиты.Вставить("Ц",  "Tc"); 
	Алфавиты.Вставить("ч",  "ch"); Алфавиты.Вставить("Ч",  "Ch"); 
	Алфавиты.Вставить("ш",  "sh"); Алфавиты.Вставить("Ш",  "Sh"); 
	Алфавиты.Вставить("щ", "sch"); Алфавиты.Вставить("Щ", "Sch"); 
	Алфавиты.Вставить("ъ",   "'"); Алфавиты.Вставить("Ъ",   "'"); 
	Алфавиты.Вставить("ы",   "y"); Алфавиты.Вставить("Ы",   "Y"); 
	Алфавиты.Вставить("ь",   "'"); Алфавиты.Вставить("Ь",   "'"); 
	Алфавиты.Вставить("э",   "e"); Алфавиты.Вставить("Э",   "E"); 
	Алфавиты.Вставить("ю",   "u"); Алфавиты.Вставить("Ю",   "U"); 
	Алфавиты.Вставить("я",  "ya"); Алфавиты.Вставить("Я",  "Ya"); 
	Алфавиты.Вставить("»",  """"); Алфавиты.Вставить("«",  """");
	Алфавиты.Вставить("№",	 "N");
	
	СтрокаВозврат = "";
	
	Для НомСимвола = 1 По СтрДлина(Строка) Цикл
		
		Символ = Сред(Строка, НомСимвола, 1);
		СимволВТранслите = Алфавиты.Получить(Символ);
		
		Если СимволВТранслите<>Неопределено Тогда
			СтрокаВозврат = СтрокаВозврат + СимволВТранслите;
		Иначе
			// добавим символ без преобразования
			СтрокаВозврат = СтрокаВозврат + Символ;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрокаВозврат;
	
