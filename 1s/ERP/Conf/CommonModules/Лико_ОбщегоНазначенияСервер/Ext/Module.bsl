Функция ОпределяемДавальческоеСырье(Документ,Заказчик) Экспорт //+Лико m.shenderov 17.08.2018
	Товары=Новый ТаблицаЗначений;
	Если ТипЗнч(Документ)=Тип("ДокументСсылка.Лико_БланкЭтапа") Тогда    
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|              Лико_БланкЭтапаТовары.Номенклатура КАК Номенклатура,
		|              Лико_БланкЭтапаТовары.Характеристика КАК Характеристика,
		|              Лико_БланкЭтапаТовары.Серия КАК Серия,
		|              Лико_БланкЭтапаТовары.КоличествоРасходУУ КАК Количество,
		|              ЛОЖЬ КАК ДавальческоеСырье,
		|              Лико_БланкЭтапаТовары.Серия.ЯССМ_ОбъектНоменклатуры КАК ОбъектНоменклатуры,
		|              Лико_БланкЭтапаТовары.Количество КАК КоличествоУпаковок,
		|              Лико_БланкЭтапаТовары.Номенклатура.ЕдиницаИзмерения КАК Упаковка
		|ИЗ
		|              Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
		|ГДЕ
		|              Лико_БланкЭтапаТовары.Ссылка = &Ссылка
		|              И Лико_БланкЭтапаТовары.Списать";
		Запрос.УстановитьПараметр("Ссылка",Документ );
		
		Товары = Запрос.Выполнить().Выгрузить();
		
		Для каждого Товар Из Товары Цикл
			
			ОбъектНоменклатуры=Товар.ОбъектНоменклатуры;
			Товар.ДавальческоеСырье=ЕстьДавальческоеСырье(ОбъектНоменклатуры,Заказчик);
			
		КонецЦикла;
		
		Товары.Свернуть("Номенклатура,Характеристика,Упаковка,ДавальческоеСырье","Количество,КоличествоУпаковок");
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ДавальческоеСырье",Ложь);
		НеДавальческоеСырье= Товары.НайтиСтроки(СтруктураОтбора);
		Для каждого Номен Из НеДавальческоеСырье  Цикл
			Товары.Удалить(Номен);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Документ)=Тип("ДокументСсылка.Лико_ПередачаТоваров") ТОгда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|              Лико_ПередачаТоваровТовары.Номенклатура КАК Номенклатура,
		|              Лико_ПередачаТоваровТовары.Характеристика КАК Характеристика,
		|              Лико_ПередачаТоваровТовары.Номенклатура.ЕдиницаИзмерения КАК Упаковка,
		|              СУММА(Лико_ПередачаТоваровТовары.Количество) КАК Количество,
		|              СУММА(Лико_ПередачаТоваровТовары.Количество) КАК КоличествоУпаковок,
		|              ЕСТЬNULL(Лико_ПередачаТоваровЦеныНоменклатуры.Цена, 0) КАК Цена
		|ИЗ
		|              Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
		|                             ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лико_ПередачаТоваров.ЦеныНоменклатуры КАК Лико_ПередачаТоваровЦеныНоменклатуры
		|                             ПО Лико_ПередачаТоваровТовары.Номенклатура = Лико_ПередачаТоваровЦеныНоменклатуры.Номенклатура
		|                                             И Лико_ПередачаТоваровТовары.Ссылка = Лико_ПередачаТоваровЦеныНоменклатуры.Ссылка
		|ГДЕ
		|              Лико_ПередачаТоваровТовары.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|              Лико_ПередачаТоваровТовары.Номенклатура,
		|              Лико_ПередачаТоваровТовары.Характеристика,
		|              Лико_ПередачаТоваровТовары.Упаковка,
		|              Лико_ПередачаТоваровТовары.Номенклатура.ЕдиницаИзмерения,
		|              ЕСТЬNULL(Лико_ПередачаТоваровЦеныНоменклатуры.Цена, 0)";
		Запрос.УстановитьПараметр("Ссылка",Документ );
		
		Товары = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;       
	
	
	Возврат Товары;
	
КонецФункции //-Лико m.shenderov 17.08.2018 


Функция ОпределяемВыпуск(Документ,Заказчик)Экспорт //+Лико m.shenderov 17.08.2018
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             Лико_БланкЭтапаВыпуск.Номенклатура КАК Номенклатура,
	|             Лико_БланкЭтапаВыпуск.Характеристика КАК Характеристика,
	|             Лико_БланкЭтапаВыпуск.Номенклатура.ЕдиницаИзмерения КАК Упаковка,
	|             СУММА(Лико_БланкЭтапаВыпуск.Количество) КАК Количество,
	|             СУММА(Лико_БланкЭтапаВыпуск.Количество) КАК КоличествоУпаковок
	|ИЗ
	|             Документ.Лико_БланкЭтапа.Выпуск КАК Лико_БланкЭтапаВыпуск
	|ГДЕ
	|             Лико_БланкЭтапаВыпуск.Ссылка = &Ссылка
	|             И НЕ Лико_БланкЭтапаВыпуск.ПромежуточныйВыпуск
	|
	|СГРУППИРОВАТЬ ПО
	|             Лико_БланкЭтапаВыпуск.Номенклатура,
	|             Лико_БланкЭтапаВыпуск.Характеристика,
	|             Лико_БланкЭтапаВыпуск.Номенклатура.ЕдиницаИзмерения";
	Запрос.УстановитьПараметр("Ссылка",Документ );
	
	Возврат  Запрос.Выполнить().Выгрузить();
	
КонецФункции //-Лико m.shenderov 17.08.2018 


Функция ЕстьДавальческоеСырье(ОбъектНоменклатуры,Заказчик)Экспорт//+Лико m.shenderov 18.08.2018
	
	Если Не ОбъектНоменклатуры.Уникальный Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             МИНИМУМ(ТоварыВЯчейках.Период) КАК Период,
	|             ТоварыВЯчейках.Серия КАК Серия
	|ПОМЕСТИТЬ Вт
	|ИЗ
	|             РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
	|ГДЕ
	|             ТоварыВЯчейках.Серия.ЯССМ_ОбъектНоменклатуры = &ОбъектНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|             ТоварыВЯчейках.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|             ТоварыВЯчейках.Регистратор КАК Регистратор
	|ИЗ
	|             Вт КАК Вт
	|                             ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
	|                             ПО Вт.Серия = ТоварыВЯчейках.Серия
	|                                             И Вт.Период = ТоварыВЯчейках.Период";
	Запрос.УстановитьПараметр("ОбъектНоменклатуры",ОбъектНоменклатуры );
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий(); 
	
	Если ТипЗнч(Выборка.Регистратор)=Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
		
		Возврат Выборка.Регистратор.Распоряжение.Организация=Заказчик;
		
		
	ИначеЕсли ТипЗнч(Выборка.Регистратор)=Тип("ДокументСсылка.Лико_БланкЭтапа") Тогда
		Распоряжение=Выборка.Регистратор.Распоряжение;
		Если ТипЗнч(Распоряжение)=Тип("ДокументСсылка.ЭтапПроизводства2_2")Тогда                                                  
			Возврат  Распоряжение.Организация=Заказчик;
		ИначеЕсли ТипЗнч(Распоряжение)=Тип("ДокументСсылка.СборкаТоваров")Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|             Лико_БланкЭтапаТовары.Серия.ЯССМ_ОбъектНоменклатуры КАК ОбъектНоменклатуры
			|ИЗ
			|             Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
			|ГДЕ
			|             Лико_БланкЭтапаТовары.Ссылка = &Ссылка
			|             И Лико_БланкЭтапаТовары.Списать";
			Запрос.УстановитьПараметр("Ссылка",Распоряжение );
			РезультатЗапроса = Запрос.Выполнить();
			Если РезультатЗапроса.Пустой() Тогда
				Возврат Ложь;
			Иначе
				Выборка = РезультатЗапроса.Выбрать();
				Выборка.Следующий();
				ЕстьДавальческоеСырье(Выборка.ОбъектНоменклатуры,Заказчик);                                
				
			КонецЕсли;                                       
		Иначе
			Возврат Ложь;
