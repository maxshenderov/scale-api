Функция СтруктураЦеныПоЦенновойГрупе(ЦеноваяГруппа,Площадка) Экспорт //+Лико m.shenderov 27.08.2018
	СтруктураЦены = Новый Структура;
	СтруктураЦены.Вставить("Цена",0);
	СтруктураЦены.Вставить("Дата");
	СтруктураЦены.Вставить("ЦенаПоставщика",0);
	СтруктураЦены.Вставить("ДатаЦеныПоставщика");
	СтруктураЦены.Вставить("Наценка",0);
	СтруктураЦены.Вставить("ВалюТаЦеныПоставщика",0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             ЦеновыеГруппы.Ссылка КАК Ссылка,
	|             Лико_ЦеныГруппНоменклатурыСрезПоследних.Цена КАК Цена,
	|             Лико_ЦеныГруппНоменклатурыСрезПоследних.Период КАК Период,
	|             Лико_ЦеныГруппНоменклатурыСрезПоследних1.Цена КАК ЦенаПоставщика,
	|             Лико_ЦеныГруппНоменклатурыСрезПоследних1.Период КАК ПериодПоставщика,
	|             Лико_ЦеныГруппНоменклатурыСрезПоследних1.Наценка КАК Наценка,
	|             Лико_ЦеныГруппНоменклатурыСрезПоследних1.Валюта КАК Валюта
	|ИЗ
	|             Справочник.ЦеновыеГруппы КАК ЦеновыеГруппы
	|                             ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
	|                                                             ,
	|                                                             ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ОсновнаяЕвро)
	|                                                                            И Площадка = &Площадка) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних
	|                             ПО ЦеновыеГруппы.Ссылка = Лико_ЦеныГруппНоменклатурыСрезПоследних.ЦеноваяГруппа
	|                             ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
	|                                                             ,
	|                                                             ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ЦенаПоставщика)
	|                                                                            И Площадка = &Площадка) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних1
	|                             ПО ЦеновыеГруппы.Ссылка = Лико_ЦеныГруппНоменклатурыСрезПоследних1.ЦеноваяГруппа
	|ГДЕ
	|             ЦеновыеГруппы.Ссылка = &ЦГ";
	Запрос.УстановитьПараметр("ЦГ", ЦеноваяГруппа);
	Запрос.УстановитьПараметр("Площадка", Площадка);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Если ЗначениеЗаполнено(Результат.Цена) Тогда 
		СтруктураЦены.Цена = Результат.Цена;
		СтруктураЦены.Дата = Результат.Период;
	КонецЕсли;
	Если ЗначениеЗаполнено(Результат.ЦенаПоставщика) Тогда 
		СтруктураЦены.ЦенаПоставщика = Результат.ЦенаПоставщика;
		СтруктураЦены.ДатаЦеныПоставщика = Результат.ПериодПоставщика;
		СтруктураЦены.Наценка = Результат.Наценка;
		СтруктураЦены.ВалюТаЦеныПоставщика = Результат.Валюта;
	КонецЕсли;
	
	Возврат СтруктураЦены;           
КонецФункции //-Лико m.shenderov 27.08.2018 

