Процедура РаспределеитьНаПартии(СооЗаказыПартии,Пакет,СооЗаказыПоследняяПартия,Обсуждение=Неопределено) //+Лико m.shenderov 18.03.2021
	
	ВыборкаРегистратор		=Пакет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	 
	ВсегоДокументов			=ВыборкаРегистратор.Количество();
	КоличествоДокументов	=0;
	
	Пока ВыборкаРегистратор.Следующий() Цикл		 
		КоличествоДокументов=КоличествоДокументов+1;
		Регистратор=ВыборкаРегистратор.Регистратор; 
		НаборЗаписей = РегистрыНакопления.Лико_ОтгрузкиПродажи.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);		
		Выборка=ВыборкаРегистратор.Выбрать();		
		Пока Выборка.Следующий() Цикл			
			ТзЗаказПартии=СооЗаказыПартии[Выборка.Заказ];
			Если  ТзЗаказПартии=Неопределено Тогда 
				ТзЗаказПартии=СформироватьТзПартий();
				СооЗаказыПартии[Выборка.Заказ]=ТзЗаказПартии;
			КонецЕсли;
			
			
			Если Выборка.Количество<0 Тогда
				ПоследняяПартияПоЗаказу	=СооЗаказыПоследняяПартия[Выборка.Заказ];
				Структура 				=Новый Структура;
				Структура.Вставить("Партия",ПоследняяПартияПоЗаказу);
				
				НайденныеСтроки			=ТзЗаказПартии.НайтиСтроки(Структура);
				
				Если  НайденныеСтроки.Количество()=0 Тогда
					
					НоваяСтрТз                    =ТзЗаказПартии.Добавить();
					НоваяСтрТз.Дата               =ВыборкаРегистратор.Период;
					НоваяСтрТз.Заказ              =Выборка.Заказ;
					НоваяСтрТз.Партия             =ПоследняяПартияПоЗаказу;
					НоваяСтрТз.КоличествоОстаток  =Выборка.Количество*-1;
					
					ТзЗаказПартии.Сортировать("Дата");
				КонецЕсли;
				
				
				Запись			         	=НаборЗаписей.Добавить();
				Запись.Период            	=ВыборкаРегистратор.Период;
				Запись.ВидДвижения       	=ВидДвиженияНакопления.Расход;
				Запись.Заказ             	=Выборка.Заказ;
				Запись.Отгрузка          	=ПоследняяПартияПоЗаказу;
				Запись.Количество        	=Выборка.Количество;						
			Иначе 				
				
				Если  ТзЗаказПартии=Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Для каждого Партия Из ТзЗаказПартии Цикл
					
					Если Партия.КоличествоОстаток=0 Тогда
						Продолжить;
					КонецЕсли;		
					
					ОсталосьСписать           =Выборка.Количество;			
					Списать                   =Мин(Партия.КоличествоОстаток,ОсталосьСписать);
					Запись                    =НаборЗаписей.Добавить();
					Запись.Период             =ВыборкаРегистратор.Период;
					Запись.ВидДвижения        =ВидДвиженияНакопления.Расход;
					Запись.Заказ              =Выборка.Заказ;
					Запись.Отгрузка           =Партия.Партия;
					Запись.Количество         =Списать;
					ОсталосьСписать           =ОсталосьСписать-Списать;
					Партия.КоличествоОстаток  =Партия.КоличествоОстаток-Списать; 				
					Если ОсталосьСписать=0 Тогда 
						Прервать;
					КонецЕсли;
				КонецЦикла; 			
			КонецЕсли;	
			
		КонецЦикла;		
		НаборЗаписей.Записать(); 
		Если Обсуждение<>Неопределено Тогда
			Данные           = Новый Структура("Счетчик,ПериодВосстановления", ?(ВсегоДокументов=0,0,КоличествоДокументов/ВсегоДокументов),НачалоМесяца(ВыборкаРегистратор.Период)); 		
			Сообщение        = СистемаВзаимодействия.СоздатьСообщение(Обсуждение.Идентификатор);
			Сообщение.Данные = Данные;			
			Сообщение.Записать();  			
		КонецЕсли;
		
	КонецЦикла;	
КонецПроцедуры //-Лико m.shenderov 18.03.2021

Процедура СборситьМетку(Метка) //+Лико m.shenderov 18.03.2021
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_МеткаВосстановленияПартийОтгрузкиПродажа.Период КАК Период,
	|	Лико_МеткаВосстановленияПартийОтгрузкиПродажа.Документ КАК Документ,
	|	Лико_МеткаВосстановленияПартийОтгрузкиПродажа.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.Лико_МеткаВосстановленияПартийОтгрузкиПродажа КАК Лико_МеткаВосстановленияПартийОтгрузкиПродажа
	|ГДЕ
	|	Лико_МеткаВосстановленияПартийОтгрузкиПродажа.Период > &Метка";
	Запрос.УстановитьПараметр("Метка",Метка);
	РезультатЗапроса = Запрос.Выполнить(); 	
	НаборЗаписей = РегистрыСведений.Лико_МеткаВосстановленияПартийОтгрузкиПродажа.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());
	НаборЗаписей.Записать(); 	
КонецПроцедуры //-Лико m.shenderov 18.03.2021

Функция СформироватьТзПартий() //+Лико m.shenderov 19.03.2021
	
	ТЗ = Новый ТаблицаЗначений;
	Тз.Колонки.Добавить("Партия",Новый ОписаниеТипов("ДокументСсылка.ПеремещениеТоваров"));
	Тз.Колонки.Добавить("Заказ",Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"));
	Тз.Колонки.Добавить("КоличествоОстаток",Новый ОписаниеТипов("Число",
	Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
	Тз.Колонки.Добавить("Дата",Новый ОписаниеТипов("Дата", , ,
	Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));							   
	Возврат ТЗ;		
