Функция ФормыПечатьСкладскойОперации(Ссылка, ПараметрыПечати, ПечататьОтправителя, КоличествоКопий, СразуНаПринтер) Экспорт
    УстановитьПривилегированныйРежим(Истина);
	Формы= Ссылка.Формы.Выгрузить();
	Если Ссылка.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПеремещениеФорм Тогда
		ПечататьОтправителя=Истина;
		Формы.Колонки["Конверт"].Имя = "КонвертОтправитель";
		Формы.Колонки["КонвертПолучатель"].Имя = "Конверт";

	КонецЕсли;


	ТабДок = Новый ТабличныйДокумент;             
	Запрос = Новый Запрос;
	Если ПечататьОтправителя Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|              ВнешнийИсточник.Конверт,
		|              ВнешнийИсточник.КонвертОтправитель КАК КонвертОтправитель,
		|              ВнешнийИсточник.Форма
		|ПОМЕСТИТЬ Формы
		|ИЗ
		|              &ВнешнийИсточник КАК ВнешнийИсточник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|              Формы.Конверт КАК Конверт,
		|              Формы.КонвертОтправитель КАК КонвертОтправитель,
		|              ПОДСТРОКА(Формы.Форма.Код, 1, 7) КАК ОбщийКод,
		|              1 КАК КоличествоФорм,
		|              Формы.Форма
		|ИЗ
		|              Формы КАК Формы
		|ИТОГИ
		|              СУММА(КоличествоФорм)
		|ПО
		|              Конверт,
		|              КонвертОтправитель,
		|              ОбщийКод";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		|              ВнешнийИсточник.Конверт,
		|              Значение(Справочник.Лико_Конверты.ПустаяСсылка) КАК КонвертОтправитель,
		|              ВнешнийИсточник.Форма
		|ПОМЕСТИТЬ Формы
		|ИЗ
		|              &ВнешнийИсточник КАК ВнешнийИсточник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|              Формы.Конверт КАК Конверт,
		|              Формы.КонвертОтправитель КАК КонвертОтправитель,
		|              ПОДСТРОКА(Формы.Форма.Код, 1, 7) КАК ОбщийКод,
		|              1 КАК КоличествоФорм,
		|              Формы.Форма
		|ИЗ
		|              Формы КАК Формы
		|ИТОГИ
		|              СУММА(КоличествоФорм)
		|ПО
		|              Конверт,
		|              КонвертОтправитель,
		|              ОбщийКод";
	КонецЕсли;

	Запрос.УстановитьПараметр("ВнешнийИсточник", Формы);
	Запрос.УстановитьПараметр("ПечататьОтправителя", ПечататьОтправителя);

	ИмяПринтера = СокрЛП(Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ИмяПринтераЭтикеток", ""));
	Макет = ПолучитьОбщийМакет("Лико_ФормыКарточкаСкладскойОперации");
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");

	ВыборкаПоКонверту = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоКонверту.Следующий() Цикл

		ВыборкаПоКонвертуОтправителю = ВыборкаПоКонверту.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоКонвертуОтправителю.Следующий() Цикл

			ВыборкаПоГруппеФорм = ВыборкаПоКонвертуОтправителю.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			НомерКонверта=0;
			Пока ВыборкаПоГруппеФорм.Следующий() Цикл

				// параметры
				ПараметрыПечати.Вставить("КоличествоЕдиницаИзмерения", " " + ВыборкаПоГруппеФорм.КоличествоФорм + " форм.");
				ПараметрыПечати.Вставить("КодФормы", ВыборкаПоГруппеФорм.ОбщийКод);
				ПараметрыПечати.Вставить("Контрагент", Документы.ЗаказКлиента.НайтиПоРеквизиту("НомерБезПрефикса", ВыборкаПоГруппеФорм.ОбщийКод).Контрагент);
				//ПараметрыПечати.Вставить("Получатель", ?(ЗначениеЗаполнено(ПредопределенныйПолучатель), ПредопределенныйПолучатель, ВыборкаПоГруппеФорм.Конверт));
				Если ПараметрыПечати.Свойство("ОбщийПолучатель") Тогда
					ПараметрыПечати.Вставить("Получатель", "" + ПараметрыПечати.ОбщийПолучатель);
				Иначе
					ПараметрыПечати.Вставить("Получатель", "" + ВыборкаПоГруппеФорм.Конверт);
				КонецЕсли;
				Если ЗначениеЗаполнено(ВыборкаПоГруппеФорм.КонвертОтправитель) Тогда
					ПараметрыПечати.Вставить("Получатель", Строка(ВыборкаПоГруппеФорм.Конверт) + " << "+ВыборкаПоГруппеФорм.КонвертОтправитель);
				КонецЕсли;
				ПараметрыПечати.Вставить("Дополнительное", "");

				// название всех форм общего кода одной строкой
				НазванияФормСтрокой = "";
				Выборка = ВыборкаПоГруппеФорм.Выбрать(ОбходРезультатаЗапроса.Прямой);
				Пока Выборка.Следующий() Цикл
					НазванияФормСтрокой = НазванияФормСтрокой + ", " + СокрЛП(Выборка.Форма.Наименование);
				КонецЦикла;
				НазванияФормСтрокой = Сред(НазванияФормСтрокой, 3);
				ПараметрыПечати.Вставить("Формы", НазванияФормСтрокой);

				// формирование печати
				Если НомерКонверта>0 Тогда
					ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
				КонецЕсли;


				ТабДокумент =ТабДок;
				ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Лико_ФормыКарточкаСкладскойОперации";

				ОбластьШапка.Параметры.Заполнить(ПараметрыПечати);
				ТабДокумент.Вывести(ОбластьШапка);

				ТабДокумент.АвтоМасштаб = Истина;
				ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
				ТабДокумент.ПолеСлева = 1;
				ТабДокумент.ПолеСправа = 0;
				ТабДокумент.ПолеСнизу = 0;
				ТабДокумент.ПолеСверху = 1;

				ТабДокумент.ИмяПринтера = ИмяПринтера;

				НомерКонверта=НомерКонверта+1;

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;
	Возврат ТабДокумент; 
КонецФункции



Функция ПечатьСкладскойОперации(ПараметрыПечати, КоличествоЭкземпляров=1, БыстраяПечать=Ложь) Экспорт
	
	Макет = ПолучитьОбщийМакет("Лико_КарточкаСкладскойОперации");
	
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ЯССМ_ПАРАМЕТРЫ_ПЕЧАТИ_КарточкаСкладскойОперации";
	
	ОбластьШапка.Параметры.Заполнить(ПараметрыПечати);
	ТабДокумент.Вывести(ОбластьШапка);
	
	//ОбъектВывода.Защита = Истина;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ПолеСлева = 1;
	ТабДокумент.ПолеСправа = 0;
	ТабДокумент.ПолеСнизу = 0;
	ТабДокумент.ПолеСверху = 1;
	
	ИмяПринтера =СокрЛП(Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ИмяПринтераЭтикеток", ""));
	
	ТабДокумент.ИмяПринтера = ИмяПринтера;
	
	// Получить необходимое количество копий
	Если КоличествоЭкземпляров > 0 Тогда
		ТабДокумент.КоличествоЭкземпляров = КоличествоЭкземпляров;
	КонецЕсли;
	
	Возврат ТабДокумент; 
КонецФункции

