	|                                             ПО ВТСтатистикаСкоростиЕРП.Заказ = ОснасткаКорр.ЗаказПокупателя
	|                                                             И ВТСтатистикаСкоростиЕРП.РабочийЦентр = ОснасткаКорр.РабочийЦентр
	|                             ПО Лико_ОтображениеРабочихЦентровРабочиеЦентры.РабочийЦентр = ВТСтатистикаСкоростиЕРП.РабочийЦентр
	|ГДЕ
	|             Лико_ОтображениеРабочихЦентровРабочиеЦентры.Ссылка = &ОтображениеРабочихЦентров
	|
	|СГРУППИРОВАТЬ ПО
	|             ЕСТЬNULL(ОснасткаКорр.Наличие, ВЫБОР
	|                                             КОГДА ЕСТЬNULL(ВтНоменклатураРЦ.Количество, 0) = 0
	|                                                             ТОГДА ИСТИНА
	|                                             ИНАЧЕ ЛОЖЬ
	|                             КОНЕЦ),
	|             ЕСТЬNULL(ФормаКорр.Наличие, ВЫБОР
	|                                             КОГДА ВТСтатистикаСкоростиЕРП.ФормыСтрокой = """"
	|                                                                            ИЛИ ПОДСТРОКА(ВТСтатистикаСкоростиЕРП.ФормыСтрокой, 1, 11) = ""Цвет индиго""
	|                                                             ТОГДА ИСТИНА
	|                                             ИНАЧЕ ВЫБОР
	|                                                                            КОГДА Лико_ПередачаТоваров.Ссылка ЕСТЬ NULL
	|                                                                                            ТОГДА ЛОЖЬ
	|                                                                            ИНАЧЕ ИСТИНА
	|                                                             КОНЕЦ
	|                             КОНЕЦ),
	|             Лико_ОтображениеРабочихЦентровРабочиеЦентры.НомерСтроки,
	|             ВТСтатистикаСкоростиЕРП.Заказ,
	|             ВТСтатистикаСкоростиЕРП.НомерЗаказа,
	|             ВТСтатистикаСкоростиЕРП.РабочийЦентр,
	|             ВТСтатистикаСкоростиЕРП.МетрыФакт / ВТСтатистикаСкоростиЕРП.МетрыПлан * 100,
	|             ВТСтатистикаСкоростиЕРП.ДатаНачала,
	|             ВТСтатистикаСкоростиЕРП.СтатусЗаказа,
	|             ВЫБОР
	|                             КОГДА ВТСтатистикаСкоростиЕРП.ВремяЗаказаПлан - ВТСтатистикаСкоростиЕРП.ВремяЗаказаПлан * (ВТСтатистикаСкоростиЕРП.МетрыФакт / ВТСтатистикаСкоростиЕРП.МетрыПлан) = 0
	|                                             ТОГДА 0
	|                             ИНАЧЕ ВТСтатистикаСкоростиЕРП.ВремяЗаказаПлан - ВТСтатистикаСкоростиЕРП.ВремяЗаказаПлан * (ВТСтатистикаСкоростиЕРП.МетрыФакт / ВТСтатистикаСкоростиЕРП.МетрыПлан)
	|             КОНЕЦ,
	|             ВТСтатистикаСкоростиЕРП.ДлительностьФакт / 60";
	Запрос.УстановитьПараметр("ТССтатистикаСкоростиЕРП",ТССтатистикаСкорости);
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.ТекущийПользователь); 
	Запрос.УстановитьПараметр("ВидОперации",Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаФорм);
	//Запрос.УстановитьПараметр("ОтображениеРабочихЦентров",УправлениеСвойствами.ЗначениеСвойства(
	//ПараметрыСеанса.ТекущийПользователь,
	//Справочники.Лико_ПредопределенныеЗначения.ДопРеквизитПользователяОтображениеРабочихЦентров.ЗначениеПараметра));
	Запрос.УстановитьПараметр("ОтображениеРабочихЦентров",ОтображениеРабочихЦентров);
	
	Запрос.УстановитьПараметр("ПомещениеПроизводство",Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ПомещениеПроизводство"));
	
	
	
	Возврат               Запрос.Выполнить().Выгрузить();
	
	
КонецФункции


Функция ПланРаботЗпПериод(НачалоПериода, КонецПериода, СписокМашин)
	
	УстановитьПривилегированныйРежим(Истина);
	СписокНомеровМашин= Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(СписокМашин) Тогда
		ОтображениеРабочихЦентров=СписокМашин;
	Иначе
		ОтображениеРабочихЦентров=УправлениеСвойствами.ЗначениеСвойства(ПараметрыСеанса.ТекущийПользователь,Справочники.Лико_ПредопределенныеЗначения.ДопРеквизитПользователяОтображениеРабочихЦентров.ЗначениеПараметра);
	КонецЕсли;
	
	СписокНомеровМашин= Новый СписокЗначений;
	//ОтображениеРабочихЦентров=УправлениеСвойствами.ЗначениеСвойства(ПараметрыСеанса.ТекущийПользователь,Справочники.Лико_ПредопределенныеЗначения.ДопРеквизитПользователяОтображениеРабочихЦентров.ЗначениеПараметра);
	Если ЗначениеЗаполнено(ОтображениеРабочихЦентров) Тогда
		Для каждого РЦ Из ОтображениеРабочихЦентров.РабочиеЦентры Цикл
			СписокНомеровМашин.Добавить(Рц.РабочийЦентр.ПорядковыйНомер);
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|             ЗаказКлиента.НомерБезПрефикса КАК НомерЗаказа
	|ИЗ
	|             РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2
	|                             ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
	|                             ПО ПооперационноеРасписание2_2.Этап.Распоряжение.ДокументОснование = ЗаказКлиента.Ссылка
	|                             ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ОтображениеРабочихЦентров.РабочиеЦентры КАК Лико_ОтображениеРабочихЦентровРабочиеЦентры
	|                             ПО ПооперационноеРасписание2_2.РабочийЦентр = Лико_ОтображениеРабочихЦентровРабочиеЦентры.РабочийЦентр
	|ГДЕ
	|             Лико_ОтображениеРабочихЦентровРабочиеЦентры.Ссылка = &ОтображениеРабочихЦентров
	|И          ПооперационноеРасписание2_2.Выполнено = 0
	|И НЕ ПооперационноеРасписание2_2.Моделирование 
	//|         И НЕ(ПооперационноеРасписание2_2.Начало > &Дата2
	|             И                                            ПооперационноеРасписание2_2.Окончание < &Дата1";
	Запрос.УстановитьПараметр("Дата1",НачалоПериода );
	Запрос.УстановитьПараметр("Дата2",КонецПериода+20*24*60*60 );
	Запрос.УстановитьПараметр("ОтображениеРабочихЦентров",ОтображениеРабочихЦентров);
	
	
	НомераЗаказов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НомерЗаказа");
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             ТССтатистикаСкорости.РабочийЦентр КАК РабочийЦентр,
	|             МАКСИМУМ(ТССтатистикаСкорости.ДатаНачала) КАК ДатаНачала
	|ПОМЕСТИТЬ ВТ_ДатыПоследнихЗаписейМашин
	|ИЗ
	|             РегистрСведений.ТССтатистикаСкорости КАК ТССтатистикаСкорости
	|ГДЕ
	|             ТССтатистикаСкорости.РабочийЦентр <> ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|             ТССтатистикаСкорости.РабочийЦентр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|             ТССтатистикаСкорости.РабочийЦентр КАК РабочийЦентр,
	|             ТССтатистикаСкорости.ДатаНачала КАК ДатаНачала,
	|             МАКСИМУМ(ТССтатистикаСкорости.ПорядковыйНомер) КАК ПорядковыйНомер
	|ПОМЕСТИТЬ ВТ_ДатыПоследнихЗаписейМашинСПорядковымНомером
	|ИЗ
	|             ВТ_ДатыПоследнихЗаписейМашин КАК ВТ_ДатыПоследнихЗаписейМашин
	|                             ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ТССтатистикаСкорости КАК ТССтатистикаСкорости
	|                             ПО ВТ_ДатыПоследнихЗаписейМашин.РабочийЦентр = ТССтатистикаСкорости.РабочийЦентр
	|                                             И ВТ_ДатыПоследнихЗаписейМашин.ДатаНачала = ТССтатистикаСкорости.ДатаНачала
	|
	|СГРУППИРОВАТЬ ПО
	|             ТССтатистикаСкорости.РабочийЦентр,
	|             ТССтатистикаСкорости.ДатаНачала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|             ТССтатистикаСкорости.РабочийЦентр КАК РабочийЦентр,
	|             ТССтатистикаСкорости.Заказ КАК Заказ,
	|             ТССтатистикаСкорости.НомерБланка КАК НомерБланка,
	|             ТССтатистикаСкорости.ЭтапПроизводства КАК ЭтапПроизводства,
	|             ТССтатистикаСкорости.ДатаНачала КАК ДатаНачала,
	|             ТССтатистикаСкорости.ПорядковыйНомер КАК ПорядковыйНомер,
