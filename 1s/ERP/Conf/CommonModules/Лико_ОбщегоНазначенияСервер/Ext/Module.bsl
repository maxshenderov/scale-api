Функция ПолучитьУпаковку(лКоличество,лНоменклатура) //+Лико m.shenderov 24.10.2017  
	Если ЗначениеЗаполнено(лНоменклатура.ВидНоменклатуры.Лико_УпаковкаПоУмолчанию) Тогда
		ВидУпаковки=лНоменклатура.ВидНоменклатуры.Лико_УпаковкаПоУмолчанию;
	Иначе
		ВидУпаковки=лНоменклатура.ЕдиницаИзмерения;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УпаковкиЕдиницыИзмерения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|ГДЕ
	|	УпаковкиЕдиницыИзмерения.Владелец = &Владелец
	|	И УпаковкиЕдиницыИзмерения.Числитель = &Числитель
	|	И УпаковкиЕдиницыИзмерения.ЕдиницаИзмерения = &ЕдиницаИзмерения";
	//НаименованиеВидаУпаковки=СокрЛП(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ВидУпаковки,"Наименование"));
	
	
	Запрос.УстановитьПараметр("Владелец",лНоменклатура);
	Запрос.УстановитьПараметр("Числитель",лКоличество);
	//Запрос.УстановитьПараметр("Длина",СтрДлина(НаименованиеВидаУпаковки));
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",ВидУпаковки);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			БазоваяЕдиницаИзмерения=Выборка.Ссылка;
			//ПроверитьНоменклатуру();			
		КонецЦикла;
		Возврат БазоваяЕдиницаИзмерения;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидУпаковки) и лКоличество>0  Тогда
		НоваяУпаковка=Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
		
		
		НоваяУпаковка.Владелец							=	лНоменклатура;		
		НоваяУпаковка.Числитель							=	лКоличество;
		НоваяУпаковка.Знаменатель						=	1;
		НоваяУпаковка.ЕдиницаИзмерения					=	ВидУпаковки;
		НоваяУпаковка.ЛинейныеРазмерыПредставление		=	"Безразмерная";
		НоваяУпаковка.СкладскаяГруппа					=	Справочники.СкладскиеГруппыУпаковок.НайтиПоНаименованию("Адресная");
		НоваяУпаковка.Типоразмер						=	Справочники.Лико_ПредопределенныеЗначения.ТипоразмерУпаковкиРулонногоМатериала.ЗначениеПараметра;
		НоваяУпаковка.ПоставляетсяВМногооборотнойТаре	=	Ложь;
		НоваяУпаковка.ТипИзмеряемойВеличины				=	Перечисления.ТипыИзмеряемыхВеличин.Упаковка;
		НоваяУпаковка.ТипУпаковки						=	Перечисления.ТипыУпаковокНоменклатуры.Конечная; 		
		НоваяУпаковка.Наименование     					=	СформироватьНаименование( ВидУпаковки,НоваяУпаковка.Числитель,НоваяУпаковка.Знаменатель,НоваяУпаковка.Владелец.ЕдиницаИзмерения); 
		
		НоваяУпаковка.Записать();	
		БазоваяЕдиницаИзмерения=НоваяУпаковка.Ссылка;
		
		
	КонецЕсли;
	
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат БазоваяЕдиницаИзмерения;
	
КонецФункции  //-Лико m.shenderov 24.10.2017

&НаСервере
Функция СформироватьНаименование(ВидУпаковки, Числитель, Знаменатель, ЕдиницаИзмеренияВладельца) Экспорт
	Возврат СокрЛП(СокрЛП(ВидУпаковки) + " (" + Формат(Числитель / Знаменатель,"ЧРД=.") + " " + СокрЛП(ЕдиницаИзмеренияВладельца) + ")");
	
КонецФункции

