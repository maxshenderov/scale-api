Функция ПолучитьСтруктуруЦеныНоменклатуры(Организация,Номенклатура,Дата,Серия=Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Структура = Новый Структура;
	Структура.Вставить("ЦенаИзПоставкиУпр"                 ,0);
	Структура.Вставить("ЦенаИзПоставкиУпрБезНДС"           ,0);
	Структура.Вставить("ЦенаИзПоставкиРегл"                                       ,0);
	Структура.Вставить("ЦенаИзПоставкиРеглБезНДС"                       ,0);
	
	Структура.Вставить("ЦенаИзПоследнейПоставкиУпр"        ,0);
	Структура.Вставить("ЦенаИзПоследнейПоставкиУпрБезНДС"  ,0);
	Структура.Вставить("ЦенаИзПоследнейПоставкиРегл"       ,0);
	Структура.Вставить("ЦенаИзПоследнейПоставкиРеглБезНДС" ,0);
	
	Структура.Вставить("ЦенаСредняяУпрБезНДС"              ,0);
	Структура.Вставить("ЦенаСредняяРеглБезНДС"             ,0);
	Структура.Вставить("ЦенаСредняяУпр"                    ,0);
	Структура.Вставить("ЦенаСредняяРегл"                   ,0);
	
	Структура.Вставить("НДС"                               ,0);
	
	ДокументПоступления=Документы.ПриобретениеТоваровУслуг.ПустаяСсылка();
	
	Если Серия<>Неопределено и Серия.ЯССМ_ОбъектНоменклатуры.Уникальный Тогда
		
		НайтиДокументПоступления(ДокументПоступления,Организация,Серия,Дата);
		
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|             Закупки.Сумма / Закупки.Количество КАК ЦенаИзПоставкиУпр,
	|             Закупки.СуммаБезНДС / Закупки.Количество КАК ЦенаИзПоставкиУпрБезНДС,
	|             Закупки.СуммаРегл / Закупки.Количество КАК ЦенаИзПоставкиРегл,
	|             Закупки.СуммаРеглБезНДС / Закупки.Количество КАК ЦенаИзПоставкиРеглБезНДС,
	|             0 КАК ЦенаИзПоследнейПоставкиУпр,
	|             0 КАК ЦенаИзПоследнейПоставкиУпрБезНДС,
	|             0 КАК ЦенаИзПоследнейПоставкиРегл,
	|             0 КАК ЦенаИзПоследнейПоставкиРеглБезНДС,
	|             0 КАК ЦенаСредняяУпрБезНДС,
	|             0 КАК ЦенаСредняяРеглБезНДС,
	|             0 КАК НДС,
	|             0 КАК ЦенаСредняяУпр,
	|             0 КАК ЦенаСредняяРегл,
	|             NULL КАК Стоимость,
	|             NULL КАК СтоимостьБезНДС,
	|             NULL КАК Регистратор
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|             РегистрНакопления.Закупки КАК Закупки
	|ГДЕ
	|             Закупки.Регистратор = &ДокументПоступления
	|             И Закупки.АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|             0,
	|             0,
	|             0,
	|             0,
	|             Закупки.Сумма / Закупки.Количество,
	|             Закупки.СуммаБезНДС / Закупки.Количество,
	|             Закупки.СуммаРегл / Закупки.Количество,
	|             Закупки.СуммаРеглБезНДС / Закупки.Количество,
	|             0,
	|             0,
	|             0,
	|             0,
	|             0,
	|             NULL,
	|             NULL,
	|             Закупки.Регистратор
	|ИЗ
	|             (ВЫБРАТЬ
	|                             МАКСИМУМ(Закупки.Период) КАК Период
	|             ИЗ
	|                             РегистрНакопления.Закупки КАК Закупки
	|             ГДЕ
	|                             Закупки.Регистратор ССЫЛКА Документ.ПриобретениеТоваровУслуг
	|                             И Закупки.Период < &Дата
	|                             И Закупки.Организация = &Организация
	|                             И Закупки.АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура) КАК ВложенныйЗапрос
	|                             ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Закупки КАК Закупки
	|                             ПО ВложенныйЗапрос.Период = Закупки.Период
	|ГДЕ
	|             Закупки.Регистратор ССЫЛКА Документ.ПриобретениеТоваровУслуг
	|             И Закупки.АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
	|             И Закупки.Период < &Дата
	|             И Закупки.Организация = &Организация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|             0,
	|             0,
	|             0,
	|             0,
	|             0,
	|             0,
	|             0,
	|             0,
	|             СтоимостьТоваровСрезПоследних.СтоимостьУпр + СтоимостьТоваровСрезПоследних.ДопРасходыУпр + СтоимостьТоваровСрезПоследних.ПостатейныеПостоянныеУпр + СтоимостьТоваровСрезПоследних.ПостатейныеПеременныеУпр,
	|             СтоимостьТоваровСрезПоследних.СтоимостьРегл + СтоимостьТоваровСрезПоследних.ДопРасходыРегл + СтоимостьТоваровСрезПоследних.ПостатейныеПостоянныеРегл + СтоимостьТоваровСрезПоследних.ПостатейныеПеременныеРегл,
	|             ВЫБОР
	|                             КОГДА СтоимостьТоваровСрезПоследних.СтоимостьБезНДС = 0
	|                                             ТОГДА 0
	|                             ИНАЧЕ ВЫРАЗИТЬ(СтоимостьТоваровСрезПоследних.Стоимость / СтоимостьТоваровСрезПоследних.СтоимостьБезНДС КАК ЧИСЛО(5, 2))
	|             КОНЕЦ,
	|             (СтоимостьТоваровСрезПоследних.СтоимостьУпр + СтоимостьТоваровСрезПоследних.ДопРасходыУпр + СтоимостьТоваровСрезПоследних.ПостатейныеПостоянныеУпр + СтоимостьТоваровСрезПоследних.ПостатейныеПеременныеУпр) * ВЫБОР
	|                             КОГДА СтоимостьТоваровСрезПоследних.СтоимостьБезНДС = 0
	|                                             ТОГДА 0
	|                             ИНАЧЕ ВЫРАЗИТЬ(СтоимостьТоваровСрезПоследних.Стоимость / СтоимостьТоваровСрезПоследних.СтоимостьБезНДС КАК ЧИСЛО(5, 2))
	|             КОНЕЦ,
	|             (СтоимостьТоваровСрезПоследних.СтоимостьРегл + СтоимостьТоваровСрезПоследних.ДопРасходыРегл + СтоимостьТоваровСрезПоследних.ПостатейныеПостоянныеРегл + СтоимостьТоваровСрезПоследних.ПостатейныеПеременныеРегл) * ВЫБОР
	|                             КОГДА СтоимостьТоваровСрезПоследних.СтоимостьБезНДС = 0
	|                                             ТОГДА 0
	|                             ИНАЧЕ ВЫРАЗИТЬ(СтоимостьТоваровСрезПоследних.Стоимость / СтоимостьТоваровСрезПоследних.СтоимостьБезНДС КАК ЧИСЛО(5, 2))
	|             КОНЕЦ,
	|             СтоимостьТоваровСрезПоследних.Стоимость,
	|             СтоимостьТоваровСрезПоследних.СтоимостьБезНДС,
	|             NULL
	|ИЗ
	|             РегистрСведений.СтоимостьТоваров.СрезПоследних(
	|                                             &Дата,
	|                                             АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
	|                                                             И Организация = &Организация
	|                                                             И РазделУчета = &РазделУчета) КАК СтоимостьТоваровСрезПоследних
	|ГДЕ
	|             СтоимостьТоваровСрезПоследних.АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
	|             И СтоимостьТоваровСрезПоследних.Период < &Дата
	|             И СтоимостьТоваровСрезПоследних.Организация = &Организация
	|             И СтоимостьТоваровСрезПоследних.РазделУчета = &РазделУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|             СУММА(ВТ.ЦенаИзПоставкиУпр) КАК ЦенаИзПоставкиУпр,
	|             СУММА(ВТ.ЦенаИзПоставкиУпрБезНДС) КАК ЦенаИзПоставкиУпрБезНДС,
	|             СУММА(ВТ.ЦенаИзПоставкиРегл) КАК ЦенаИзПоставкиРегл,
	|             СУММА(ВТ.ЦенаИзПоставкиРеглБезНДС) КАК ЦенаИзПоставкиРеглБезНДС,
	|             СУММА(ВТ.ЦенаИзПоследнейПоставкиУпр) КАК ЦенаИзПоследнейПоставкиУпр,
	|             СУММА(ВТ.ЦенаИзПоследнейПоставкиУпрБезНДС) КАК ЦенаИзПоследнейПоставкиУпрБезНДС,
	|             СУММА(ВТ.ЦенаИзПоследнейПоставкиРегл) КАК ЦенаИзПоследнейПоставкиРегл,
	|             СУММА(ВТ.ЦенаИзПоследнейПоставкиРеглБезНДС) КАК ЦенаИзПоследнейПоставкиРеглБезНДС,
	|             СУММА(ВТ.ЦенаСредняяУпрБезНДС) КАК ЦенаСредняяУпрБезНДС,
	|             СУММА(ВТ.ЦенаСредняяРеглБезНДС) КАК ЦенаСредняяРеглБезНДС,
	|             МАКСИМУМ(ВТ.НДС) КАК НДС,
	|             СУММА(ВТ.ЦенаСредняяУпр) КАК ЦенаСредняяУпр,
	|             СУММА(ВТ.ЦенаСредняяРегл) КАК ЦенаСредняяРегл,
	|             СУММА(ВТ.Стоимость) КАК Стоимость,
	|             СУММА(ВТ.СтоимостьБезНДС) КАК СтоимостьБезНДС
	|ИЗ
	|             ВТ КАК ВТ";
	Запрос.УстановитьПараметр("Дата",Дата);
	Запрос.УстановитьПараметр("ДокументПоступления",ДокументПоступления);
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("РазделУчета",Перечисления.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах); 
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл                       
		ЗаполнитьЗначенияСвойств(Структура,Выборка);                       
	КонецЦикла; 
	
	Возврат Структура;       
	УстановитьПривилегированныйРежим(Ложь);
	
