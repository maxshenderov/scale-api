
#Область ЗаполнениеДокумента 
// Процедура ЗаполнениеРеквизитовШапки
//
/// Описание: НужноИзменить
//
// Параметры: 
// Объект                                             - Объект                             - (обязательный).  Пример: "(ДокументОбъект.Лико_БланкЭтапа)"    
// МассивРеквизитов    - Массив                                                           - (обязательный).Пример: Массив 
//
Процедура ЗаполнениеРеквизитовШапки(Объект,МассивРеквизитов) Экспорт //+Лико m.shenderov 11.09.2017
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	Для каждого Реквизит Из МассивРеквизитов Цикл
		Если  Реквизит="РабочееМесто" Тогда
			Объект.РабочееМесто = ПараметрыСеанса.Лико_РабочееМесто;
		КонецЕсли;
		Если  Реквизит="Организация" Тогда
			Объект.Организация = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитПользователяОрганизация", ТекущийПользователь);
		КонецЕсли;                       
		
		Если  Реквизит="Подразделение" Тогда                                           
			Объект.Подразделение = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитПользователяПодразделение", ТекущийПользователь);
		КонецЕсли;
		
		
	КонецЦикла;
	
КонецПроцедуры //ЗаполнениеРеквизитовШапки -Лико m.shenderov 11.09.2017

Процедура РеквизитыШапки(Структура) Экспорт 
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	Структура.Вставить("РабочееМесто",ПараметрыСеанса.Лико_РабочееМесто);                          
	Структура.Вставить("Организация",
	Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитПользователяОрганизация", ТекущийПользователь));
	Структура.Вставить("Подразделение",
	ТекущийПользователь.Подразделение);
	Структура.Вставить("Склад",Справочники.Лико_РабочиеМеста.ПолучитьСвойство("СкладСИМ"));
	Структура.Вставить("ЗонаПриемки",Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ЗонаПриемки"));
	Структура.Вставить("Помещение",Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ПомещениеСИМ"));
	
	Структура.Вставить("Лико_РабочееМесто",ПараметрыСеанса.Лико_РабочееМесто);                            
	Структура.Вставить("Лико_Организация",
	Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитПользователяОрганизация", ТекущийПользователь));
	Структура.Вставить("Лико_Подразделение",
	ТекущийПользователь.Подразделение); 
	
КонецПроцедуры 


Функция ПолучитьСтруктуруДляЗаполненияТиповыхДокументов(Контрагент, Валюта,ВидОперации,ТипПродукции=Неопределено) Экспорт 
	
	Если НЕ ЗначениеЗаполнено(ТипПродукции) Тогда
		ТипПродукции=Перечисления.Лико_ТипыПродукции.Материалы;
	КонецЕсли;


	Структура = Новый Структура;
	Структура.Вставить("Договор"         ,Неопределено) ;
	Структура.Вставить("Соглашение"      ,Неопределено) ;
	Структура.Вставить("СпособДоставки"  ,Неопределено) ;
	Структура.Вставить("Организация"     ,Неопределено) ;   
	Структура.Вставить("Интеркампани"    ,Неопределено) ;




	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             Лико_ЗаполениеРегламентированныхДокументов.Договор КАК Договор,
	|             Лико_ЗаполениеРегламентированныхДокументов.Соглашение КАК Соглашение,
	|             Лико_ЗаполениеРегламентированныхДокументов.Организация КАК Организация,
	|             Лико_ЗаполениеРегламентированныхДокументов.Интеркампани КАК Интеркампани,
	|             Лико_ЗаполениеРегламентированныхДокументов.СпособДоставки КАК СпособДоставки
	|ИЗ
	|             РегистрСведений.Лико_ЗаполениеРегламентированныхДокументов КАК Лико_ЗаполениеРегламентированныхДокументов
	|ГДЕ
	|             Лико_ЗаполениеРегламентированныхДокументов.Контрагент = &Контрагент
	|             И Лико_ЗаполениеРегламентированныхДокументов.Валюта = &Валюта
	|             И Лико_ЗаполениеРегламентированныхДокументов.ТипПродукции = &ТипПродукции
	|             И Лико_ЗаполениеРегламентированныхДокументов.ТипОперации = &ВидОперации";
	
	Запрос.УстановитьПараметр("Контрагент",Контрагент );
	Запрос.УстановитьПараметр("Валюта",Валюта );
	Запрос.УстановитьПараметр("ВидОперации",ВидОперации);
	Запрос.УстановитьПараметр("ТипПродукции",ТипПродукции);


	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Структура.Договор             =Выборка.Договор;
		Структура.Соглашение          =Выборка.Соглашение;
		Структура.СпособДоставки      =Выборка.СпособДоставки;
		Структура.Организация         =Выборка.Организация;
		Структура.Интеркампани        =Выборка.Интеркампани;

		
	КонецЦикла; 


	Возврат Структура;


КонецФункции


Функция НайтиГруппуФинУчетаПоПорядкуОплату(ПорядокОплаты) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             ГруппыФинансовогоУчетаРасчетов.Ссылка КАК Ссылка
	|ИЗ
	|             Справочник.ГруппыФинансовогоУчетаРасчетов КАК ГруппыФинансовогоУчетаРасчетов
	|ГДЕ
	|             НЕ ГруппыФинансовогоУчетаРасчетов.ПометкаУдаления
	|             И ГруппыФинансовогоУчетаРасчетов.РасчетыСКлиентами
	|             И ГруппыФинансовогоУчетаРасчетов.ПорядокОплаты = &ПорядокОплаты";
	
	Запрос.УстановитьПараметр("ПорядокОплаты", ПорядокОплаты);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

