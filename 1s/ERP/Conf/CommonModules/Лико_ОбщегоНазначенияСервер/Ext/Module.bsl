#Область Инструкции

Функция ПроверкаНепрочитанныхИнструкциий(Оператор,РабочийЦентр) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Результат=0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТС_Инструкции.Ссылка КАК Ссылка,
	|	ТС_ИнструкцииРАбочиеЦентры.РабочийЦентр КАК РабочийЦентр
	|ИЗ
	|	Справочник.ТС_Инструкции КАК ТС_Инструкции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТС_ЖурналОзнакомленияСИнструкциями.СрезПоследних КАК ТС_ЖурналОзнакомленияСИнструкциямиСрезПоследних
	|		ПО ТС_Инструкции.Ссылка = ТС_ЖурналОзнакомленияСИнструкциямиСрезПоследних.Инструкция
	|			И (ТС_ЖурналОзнакомленияСИнструкциямиСрезПоследних.Оператор = &Оператор)
	|			И ТС_Инструкции.КонтрольДатыОзнакомления <= ТС_ЖурналОзнакомленияСИнструкциямиСрезПоследних.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТС_Инструкции.РабочиеЦентры КАК ТС_ИнструкцииРАбочиеЦентры
	|		ПО (ТС_ИнструкцииРАбочиеЦентры.Ссылка = ТС_Инструкции.Ссылка)
	|ГДЕ
	|	ТС_ЖурналОзнакомленияСИнструкциямиСрезПоследних.Период ЕСТЬ NULL
	|	И ТС_Инструкции.КонтрольДатыОзнакомления <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|	И (ТС_ИнструкцииРАбочиеЦентры.РабочийЦентр ЕСТЬ NULL
	|			ИЛИ ТС_ИнструкцииРАбочиеЦентры.РабочийЦентр = &РабочийЦентр)
	|	И НЕ ТС_Инструкции.Выключить
	|	И ТС_Инструкции.КонтрольДатыОзнакомления < &ТекущаяДата";
	Запрос.УстановитьПараметр("Оператор",Оператор );
	Запрос.УстановитьПараметр("РабочийЦентр",РабочийЦентр );
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
	
	
	Возврат Запрос.Выполнить().Выбрать().Количество();
	
	
	
КонецФункции


