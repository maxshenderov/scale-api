Процедура ОтправитьПоПочтеЗаявке(ЗаявкаНаРемонт,Адреса=Неопределено, ПовторнаяОтправка = Ложь)  Экспорт 
	
	Если НЕ Лико_Дополнительно.ПроверитьЭтоРабочаяБаза() Тогда
		// Это копия, письма отправлять не нужно
		Возврат;
	КонецЕсли;
	
	Если Адреса=Неопределено Тогда
		Адреса=Новый Массив;
		//СтрокаКонтактов=УправлениеСвойствами.ЗначениеСвойства(ЗаявкаНаРемонт.РабочийЦентр.Лико_Площадка,"Лико_КонтактыТехнологов");
		СтрокаКонтактов=ПолучитьСписокКонтактовПоПодразделению(ЗаявкаНаРемонт.ПодразделениеПолучатель,ЗаявкаНаРемонт.РабочийЦентр.Лико_Площадка, ?(ЗаявкаНаРемонт.ПодразделениеПолучатель = Справочники.ТС_Подразделения.Формщики, ЗаявкаНаРемонт.РабочийЦентр.Лико_ПроизводственноеПомещение, Неопределено),ЗаявкаНаРемонт.РабочийЦентр);
		ОбщийМассив=СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаКонтактов,";",Истина);
		Для каждого Адрес Из ОбщийМассив Цикл
			Если СтрНайти(Адрес,"@")>0 Тогда
				Адреса.Добавить(Адрес);
			КонецЕсли;                                       
		КонецЦикла;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Адреса) Или ТипЗнч(Адреса)<>Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Адресат="";
	Для каждого Адрес Из Адреса Цикл
		Адресат=Адресат + Адрес+";";
	КонецЦикла;
	
	Адресат=Лев(Адресат,СтрДлина(Адресат)-1);
	
	НомерЗаявки=ЗаявкаНаРемонт.Номер; 
	
	ТипЗаявки = "";
	Если ЗаявкаНаРемонт.ПодразделениеПолучатель = Справочники.ТС_Подразделения.Формщики Тогда
		ТипЗаявки = "на формы";
	ИначеЕсли ЗаявкаНаРемонт.ПодразделениеПолучатель = Справочники.ТС_Подразделения.Механики Тогда
		ТипЗаявки = "механикам";
	ИначеЕсли ЗаявкаНаРемонт.ПодразделениеПолучатель = Справочники.ТС_Подразделения.МеханикиЦифра Тогда
		ТипЗаявки = "механикам цифры";
	ИначеЕсли ЗаявкаНаРемонт.ПодразделениеПолучатель = Справочники.ТС_Подразделения.Технологи Тогда
		ТипЗаявки = "технологам";
	ИначеЕсли ЗаявкаНаРемонт.ПодразделениеПолучатель = Справочники.ТС_Подразделения.ИТ Тогда
		ТипЗаявки = "в ИТ";
	КонецЕсли;		
		
	Если ЗаявкаНаРемонт.ПометкаУдаления Тогда
		Текст="Удалена заявка " + ТипЗаявки + " по рабочему центру "+СокрЛП(ЗаявкаНаРемонт.РабочийЦентр.Наименование)+" "+
		НомерЗаявки + " от " + Формат(ЗаявкаНаРемонт.Дата, "ДФ='дд ММММ гггг'");;
	Иначе
		Текст="Поступила заявка " + ТипЗаявки + " по рабочему центру "+СокрЛП(ЗаявкаНаРемонт.РабочийЦентр.Наименование)+" "+
		НомерЗаявки + " от " + Формат(ЗаявкаНаРемонт.Дата, "ДФ='дд ММММ гггг'");;
	КонецЕсли;
	текст=СтрЗаменить(текст,"№","N");
	Тема  = текст;                   
	
	Если ЗаявкаНаРемонт.ПодразделениеПолучатель = Справочники.ТС_Подразделения.Формщики Тогда
		Если ЗаявкаНаРемонт.СогласованоСБригадиром И НЕ ПовторнаяОтправка Тогда
			Возврат;
		КонецЕсли;
		Текст = Текст + Символы.ПС + Символы.ВК + "Заказ " + ЗаявкаНаРемонт.ЗаказКлиента.НомерБезПрефикса + ", вид форм " + ЗаявкаНаРемонт.ВидФорм + ", цвета: " + ЗаявкаНаРемонт.Описание;
	Иначе
		Текст=Текст+Символы.ПС+Символы.ВК+ "Причина :"+Символы.ПС+Символы.ВК;
		Причина="";
		Для каждого Секция  Из ЗаявкаНаРемонт.Секции  Цикл
			Если Не ЗначениеЗаполнено(Причина) Тогда
				Причина=СокрЛП(ЗаявкаНаРемонт.Секции[0].Причина.Наименование)+Символы.ВТаб
			КонецЕсли;
			Причина=Причина+СокрЛП(ЗаявкаНаРемонт.Секции[0].Комментарий);                        
		КонецЦикла;    
		Текст=Текст+Причина;
	КонецЕсли;
	
	текст=СтрЗаменить(текст,"№","N");
	
	Лико_Планирование.ОтправитьПисьмо(текст, Тема, Адресат,,"textBody");                   
	
КонецПроцедуры

