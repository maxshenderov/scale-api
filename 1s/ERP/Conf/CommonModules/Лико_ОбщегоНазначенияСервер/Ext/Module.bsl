Процедура НайтиДокументПоступления(ДокументПоступления,Организация,Серия,Дата) Экспорт //+Лико m.shenderov 07.10.2018
	ПриходыйОрдер=Неопределено;        
	СтруктураПоследнегоДокумента=ПоследнийДокументПоступленияСтруктура(Организация,Серия,Дата); 
	Если ТипЗнч(СтруктураПоследнегоДокумента.Документ)=Тип("ДокументСсылка.ПриходныйОрдерНаТовары")  Тогда
		ПриходныйОрдер=СтруктураПоследнегоДокумента.Документ;
	ИначеЕсли ТипЗнч(СтруктураПоследнегоДокумента.Документ)=Тип("ДокументСсылка.Лико_БланкЭтапа") И ЗначениеЗаполнено(СтруктураПоследнегоДокумента.Серия) Тогда
		Если  Серия=СтруктураПоследнегоДокумента.Серия Тогда
			Возврат ;
		КонецЕсли;
		
		НайтиДокументПоступления(ДокументПоступления,Организация,СтруктураПоследнегоДокумента.Серия,Дата); 
	КонецЕсли;                       
	Если ЗначениеЗаполнено(ПриходныйОрдер) Тогда
		ДокументПоступления=НайтиДокументПоступленияПоПриходномуОрдеру(ПриходныйОрдер,Серия.ЯССМ_ОбъектНоменклатуры.Номенклатура);
	КонецЕсли;
	
	
	
	
	
КонецПроцедуры //-Лико m.shenderov 07.10.2018 

Функция ПоследнийДокументПоступленияСтруктура (Организация,Серия,Дата) //+Лико m.shenderov 07.10.2018
	
	Структура = Новый Структура;
	Структура.Вставить("Документ",Неопределено);
	Структура.Вставить("Серия",Серия);  
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|             ТоварыВЯчейках.Регистратор КАК Регистратор
	|ИЗ
	|             РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
	|ГДЕ
	|             ТоварыВЯчейках.Серия = &Серия
	|             И ТоварыВЯчейках.Регистратор ССЫЛКА Документ.ПриходныйОрдерНаТовары
	|             И ТоварыВЯчейках.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|             И ТоварыВЯчейках.Регистратор.Распоряжение.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|             ТоварыВЯчейках.Период УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|             ТоварыВЯчейках.Регистратор КАК Регистратор
	|ИЗ
	|             РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
	|ГДЕ
	|             ТоварыВЯчейках.Серия = &Серия
	|             И ТоварыВЯчейках.Регистратор ССЫЛКА Документ.Лико_БланкЭтапа
	|             И ТоварыВЯчейках.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|             И ТоварыВЯчейках.Регистратор.Распоряжение Ссылка Документ.СборкаТоваров
	|
	|УПОРЯДОЧИТЬ ПО
	|             ТоварыВЯчейках.Период УБЫВ";
	Запрос.УстановитьПараметр("Серия",Серия );
	Запрос.УстановитьПараметр("Организация",Организация );
	
	Пакет = Запрос.ВыполнитьПакет();
	
	
	Если Не Пакет[0].Пустой() Тогда                           
		Выборка =  Пакет[0].Выбрать();
		Выборка.Следующий();
		Структура.Документ=Выборка.Регистратор;
	ИначеЕсли НЕ Пакет[1].Пустой() Тогда
		Выборка =  Пакет[1].Выбрать();
		Выборка.Следующий();                             
		Для каждого Товар Из Выборка.Регистратор.Товары Цикл                                                    
			Если Товар.Списать Тогда                                                                        
				Структура.Серия=Товар.Серия;
				Прервать;
			КонецЕсли;                                       
		КонецЦикла;                   
		Структура.Документ=Выборка.Регистратор;
	КонецЕсли;       
	Возврат Структура;       
КонецФункции //-Лико m.shenderov 07.10.2018 

Функция НайтиДокументПоступленияПоПриходномуОрдеру(ПриходныйОрдер,Номенклатура)  Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|             Лико_ТоварыКПоступлению.Регистратор КАК Регистратор
	|ИЗ
	|             РегистрНакопления.Лико_ТоварыКПоступлению КАК Лико_ТоварыКПоступлению
	|ГДЕ
	|             Лико_ТоварыКПоступлению.ПриходныйОрдер = &ПриходныйОрдер
	|             И Лико_ТоварыКПоступлению.Номенклатура = &Номенклатура
	|             И Лико_ТоварыКПоступлению.Регистратор ССЫЛКА Документ.ПриобретениеТоваровУслуг";
	Запрос.УстановитьПараметр("ПриходныйОрдер",ПриходныйОрдер );
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура );
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Регистратор;                              
	КонецЕсли;
	
	
КонецФункции //-Лико m.shenderov 07.10.2018 




