Процедура СоздатьРедактироватьПередачуСырьяПереработчику(Документ, ЗаказКлиента, Заказчик, Знач Материалы, Отказ) Экспорт
	
	ИмяНакладной                               ="ПередачаСырьяПереработчику";
	ДокументСсылка                          =НайтиДокумент(ИмяНакладной,"Лико_Документ",Документ);
	
	Если  ДокументСсылка<>Неопределено Тогда
		ДокументОбъект=ДокументСсылка.ПолучитьОбъект();
	Иначе
		ДокументОбъект= Документы.ПередачаСырьяПереработчику.СоздатьДокумент();
	КонецЕсли;       
	
	
	ЗаказВПереработку=НайтиДокумент("ЗаказПереработчику","ДокументОснование",ЗаказКлиента);
	
	Если ЗаказВПереработку=Неопределено Тогда
		Отказ=Истина;
		Возврат;
	КонецЕсли;
	
	ВалютаРуб = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаЕвр = Константы.ВалютаУправленческогоУчета.Получить();
	
	Если ЗначениеЗаполнено(ЗаказВПереработку) Тогда 
		
		МассивСсылок = Новый Массив();
		МассивСсылок.Добавить(ЗаказВПереработку);
		//ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.ПараметрыОткрытияФормыНакладнойНаОснованииЗаказа(МассивСсылок,"ПередачаСырьяПереработчику");
		//Основание=ПараметрыОткрытия.ПараметрыФормы.Основание;
		
		
		ЗаполнитьДокументНаОсновании(ДокументОбъект,МассивСсылок);
		Если Не ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда
			ДокументОбъект.Склад=Документ.Склад;
		КонецЕсли;
		
		//ДанныеДляПроверки                             = Документы[ИмяНакладной].ДанныеДляПроверкиВводаНаОсновании(МассивСсылок, Неопределено);     
		//ПараметрыОткрытия                              = Новый Структура;
		//ПараметрыЗаполнения          = Документы[ИмяНакладной].ПараметрыЗаполненияДокумента();
		//ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ДанныеДляПроверки);
		//РеквизитыШапки                                      = Документы[ИмяНакладной].ДанныеЗаполненияНакладной(МассивСсылок,ДанныеДляПроверки);
		//Документы[ИмяНакладной].ИнициализироватьПараметрыЗаполнения(ПараметрыЗаполнения, РеквизитыШапки,МассивСсылок);                      
		//ДокументОбъект.Заполнить(ПараметрыЗаполнения);
		
		//ЗаполнитьЗначенияСвойств(ДокументОбъект,ЗаказВПереработку,,"Номер,Дата,Ссылка");
		ДокументОбъект.Валюта=ВалютаРуб;
		ДокументОбъект.ПометкаУдаления=Ложь;
		ДокументОбъект.ЗаказПереработчику=ЗаказВПереработку;                
		ДокументОбъект.ПередачаПоЗаказам=Истина;
		ДокументОбъект.СпособДоставки=ЗаказВПереработку.СпособДоставки;
	КонецЕсли;
	ДокументОбъект.Лико_Документ=Документ;
	ДокументОбъект.ХозяйственнаяОперация=Неопределено;
	
	Тз=Материалы;
	Если ЗначениеЗаполнено(ЗаказВПереработку) Тогда
		Тз.Колонки.Добавить("ЗаказПереработчику");
	КонецЕсли;
	Для каждого СтрТЗ Из Тз Цикл
		Если ЗначениеЗаполнено(ЗаказВПереработку) Тогда
			СтрТЗ.ЗаказПереработчику= ЗаказВПереработку;
		КонецЕсли;                                         
	КонецЦикла;
	//НовоеРаспоряжение.Валюта=Валюта;
	ДокументОбъект.Комментарий = ""  + "Создан автоматически на основании документа """ + Документ + """";
	ДокументОбъект.Дата=Документ.Дата;
	
	ФизЛицо = Документ.АвторДокумента;
	ДокументОбъект.Отпустил = ФизЛицо;
	ДокументОбъект.ОтпустилДолжность = Лико_Дополнительно.НайтиДолжностьФизЛица(ДокументОбъект.Отпустил, ДокументОбъект.Организация, ДокументОбъект.Дата);
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.ОтпустилДолжность) Тогда
		ДокументОбъект.ОтпустилДолжность = "Кладовщик";
	КонецЕсли;
	ДокументОбъект.Лико_НеНужныДвиженияОрдерныхСкладов=Истина;
	ДокументОбъект.Менеджер = ПараметрыСеанса.ТекущийПользователь;
	ДокументОбъект.Руководитель = Лико_Дополнительно.НайтиЛицоСПравомПодписи(ДокументОбъект.Организация, Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ДокументОбъект.Отпустил, ДокументОбъект.Дата); 
	ДокументОбъект.ГлавныйБухгалтер = Лико_Дополнительно.НайтиЛицоСПравомПодписи(ДокументОбъект.Организация, Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, ДокументОбъект.Отпустил, ДокументОбъект.Дата); 
	ДокументОбъект.Основание="Дог. №25/18 от 01.07.2018 (на давальческих условиях)";
	
	//ДляДокумента=ПолучитьСтруктуруДляЗаполненияТиповыхДокументов();
	//НовоеРаспоряжение.Договор       =ДляДокумента.Договор;              
	//НовоеРаспоряжение.Основание                      =НовоеРаспоряжение.Договор.Наименование;
	//НовоеРаспоряжение.ОснованиеДата            =НовоеРаспоряжение.Договор.Дата;
	//
	
	
	Если ЗначениеЗаполнено(ЗаказВПереработку) Тогда
		Тз.Свернуть("Номенклатура,Характеристика,Упаковка,ЗаказПереработчику","Количество,КоличествоУпаковок");
	Иначе
		Тз.Свернуть("Номенклатура,Характеристика,Упаковка","Количество,КоличествоУпаковок"); 
	КонецЕсли;
	
	ДокументОбъект.Товары.Загрузить(Тз); 
	Для каждого СтрокаТовары Из ДокументОбъект.Товары Цикл                            
		СтрокаТовары.Склад=ДокументОбъект.Склад;
		Структура = Новый Структура;
		Структура.Вставить("Номенклатура",СтрокаТовары.Номенклатура);
		СтрокиЗаказа=ЗаказВПереработку.Материалы.НайтиСтроки(Структура);
		ЦенаEUR=0;
		Для каждого ЦенаВЗаказе Из  СтрокиЗаказа Цикл
			ЦенаEUR= ЦенаВЗаказе.Цена;
		КонецЦикла;
		Если ЦенаEUR=0 ТОгда                               
			ЦенаEUR= СтруктураЦеныПоЦенновойГрупе(СтрокаТовары.Номенклатура.ЦеноваяГруппа,Заказчик).Цена;
		КонецЕсли;
		ЦенаRUB=РаботаСКурсамиВалют.ПересчитатьВВалюту(ЦенаEUR,ВалютаЕвр,ВалютаРуб,Документ.Дата);
		//СтрокаТовары.Цена = СтруктураЦеныПоЦенновойГрупе(СтрокаТовары.Номенклатура.ЦеноваяГруппа,Заказчик).Цена;
		СтрокаТовары.Цена = ЦенаRUB;
		
		//СтрокаТовары.Цена = ПолучитьЦенуПоследнейЗакупкиЗакупкиНоменклатуры(Заказчик,СтрокаТовары.Номенклатура,СтрокаТовары.Характеристика,Документ.Дата,Ложь,Истина);
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСумму");
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, Неопределено);
		
	КонецЦикла;
	
	ДокументОбъект.Товары.Сортировать("Номенклатура,Характеристика"); 
	ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьКонтрольПриПроведении",Истина); 
	
	Попытка                                                             
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);                                                  
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + ДокументОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		
	КонецПопытки;
	
	
	
КонецПроцедуры


