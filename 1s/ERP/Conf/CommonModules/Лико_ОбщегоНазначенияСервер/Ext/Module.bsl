Функция СоздатьПолучитьРаспоряжениеНаКраску(ДокументСсылка) Экспорт
	ЗаказМатериаловВПроизводство=Неопределено;     
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|             ЗаказМатериаловВПроизводство.Ссылка КАК Ссылка
	|ИЗ
	|             Документ.ЗаказМатериаловВПроизводство КАК ЗаказМатериаловВПроизводство
	|ГДЕ
	|             ЗаказМатериаловВПроизводство.Лико_Документ = &Лико_Документ
	|
	|УПОРЯДОЧИТЬ ПО
	|             ЗаказМатериаловВПроизводство.Дата";
	Запрос.УстановитьПараметр("Лико_Документ",ДокументСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаказМатериаловВПроизводство=Выборка.Ссылка;
	КонецЦикла;
	//Колористическая=УправлениеСвойствами.ЗначениеСвойства(ДокументСсылка.Организация,"Лико_Колористическая");
	Колористическая=ДокументСсылка.Склад.Лико_площадка.ЦеховаяКладовая;

	
	Если ЗаказМатериаловВПроизводство=Неопределено И 
		ЗначениеЗаполнено(Колористическая) Тогда
		НовоеРаспоряжение = Документы.ЗаказМатериаловВПроизводство.СоздатьДокумент(); 
		НовоеРаспоряжение.Дата = ДокументСсылка.Дата;
		НовоеРаспоряжение.Организация                                                     =                ДокументСсылка.Организация;
		НовоеРаспоряжение.Подразделение                                               =                ДокументСсылка.Подразделение;
		НовоеРаспоряжение.ЦеховаяКладовая                                           =             Колористическая;
		НовоеРаспоряжение.Склад                                                                                    =                ДокументСсылка.Склад;
		НовоеРаспоряжение.ДатаОтгрузки                                                    =             ДокументСсылка.Дата;
		НовоеРаспоряжение.УправлениеПроизводством2_2=             Истина;
		НовоеРаспоряжение.Статус                                                                   =                Перечисления.СтатусыЗаказовМатериаловВПроизводство.КВыполнению;
		НовоеРаспоряжение.ХозяйственнаяОперация                             =                Перечисления.ХозяйственныеОперации.ПередачаМатериаловВКладовую;                
		НовоеРаспоряжение.Комментарий                                                   =             "Создан в проведении документа: "+ Выборка.Ссылка; 
		НовоеРаспоряжение.Лико_Документ                                               =             ДокументСсылка;
		НовоеРаспоряжение.Записать(РежимЗаписиДокумента.Запись);
		ЗаказМатериаловВПроизводство=НовоеРаспоряжение.Ссылка; 
	ИначеЕсли Колористическая <> ЗаказМатериаловВПроизводство.ЦеховаяКладовая Тогда
		ДокОбъект =ЗаказМатериаловВПроизводство.ПолучитьОбъект();
		ДокОбъект.ЦеховаяКладовая =  Колористическая ;
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);

