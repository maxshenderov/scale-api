Процедура СоздатьДокументСчетФактураВыданный(Основание,Отказ)Экспорт
	УжеСозданныйДокумент=НайтиСчетФактуруПоОснованию(Основание);
	
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйДокОбъект = Документы.СчетФактураВыданный.СоздатьДокумент();
	НовыйДокОбъект.Дата = Основание.Дата;
	НовыйДокОбъект.Номер = Основание.Номер;
	НовыйДокОбъект.ПредставлениеНомера = Документы.СчетФактураВыданный.ПолучитьПредставлениеНомера(НовыйДокОбъект);
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ДокументОснование", Основание);
	ДанныеЗаполнения.Вставить("Организация", Основание.Организация);
	ДанныеЗаполнения.Вставить("ДатаВыставления", Основание.Дата);
	НовыйДокОбъект.Заполнить(ДанныеЗаполнения);
	Если НовыйДокОбъект.Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		НовыйДокОбъект.Валюта = Основание.Валюта;
	КонецЕсли;
	НовыйДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	
	ФизЛицо = УправлениеСвойствами.ЗначениеСвойства(НовыйДокОбъект.Организация,"Лико_ФизЛицоПриПередачеВЭксплуатацию");
     	НовыйДокОбъект.Руководитель = Лико_Дополнительно.НайтиЛицоСПравомПодписи(НовыйДокОбъект.Организация, Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ФизЛицо, НовыйДокОбъект.Дата); 
	НовыйДокОбъект.ГлавныйБухгалтер = Лико_Дополнительно.НайтиЛицоСПравомПодписи(НовыйДокОбъект.Организация, Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, ФизЛицо, НовыйДокОбъект.Дата); 
	

	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка");
		Для Каждого     ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//НовыйДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;                  
КонецПроцедуры


Процедура СоздатьРедактироватьРеализацяТоваровИУслуг(Документ,ЗаказКлиента,Заказчик,Знач Выпуск, Отказ)Экспорт 

	ДокументСсылка=НайтиДокумент("РеализацияТоваровУслуг","Лико_Документ",Документ);

	Если  ДокументСсылка<>Неопределено Тогда
		ДокументОбъект=ДокументСсылка.ПолучитьОбъект();
	Иначе
		ДокументОбъект= Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	КонецЕсли;       

	//
	//ЗаказВПереработку=НайтиДокумент("ЗаказПереработчику","ДокументОснование",ЗаказКлиента);
	//
	//Если ЗаказВПереработку=Неопределено Тогда
	//            Отказ=Истина;
	//            Возврат;
	//КонецЕсли;   




	ДокументОбъект.Дата = Документ.Дата;

	ВалютаРуб = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаЕвр = Константы.ВалютаУправленческогоУчета.Получить();
	ВалютаДок = Документ.Валюта;

	ДляДокумента=ПолучитьСтруктуруДляЗаполненияТиповыхДокументов(Документ.Контрагент,ВалютаДок,Документ.ВидОперации);

	ДокументОбъект.Организация = Документ.Организация;
	ДокументОбъект.БанковскийСчетОрганизации = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитОрганизацииБанковскийСчетПоУмолчанию", ДокументОбъект.Организация);
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.БанковскийСчетОрганизации) Тогда
		ДокументОбъект.БанковскийСчетОрганизации = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(ДокументОбъект.Организация, ВалютаРуб);
	КонецЕсли;
	ДокументОбъект.Контрагент = Документ.Контрагент;
	ДокументОбъект.БанковскийСчетКонтрагента = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(ДокументОбъект.Контрагент, ВалютаРуб);
	ДокументОбъект.Валюта = ВалютаДок;
	ДокументОбъект.ВалютаВзаиморасчетов = ДокументОбъект.Валюта;
	ДокументОбъект.Партнер = ДокументОбъект.Контрагент.Партнер;
	ДокументОбъект.Подразделение = Справочники.Лико_ПредопределенныеЗначения.ПодразделениеПроизводство.ЗначениеПараметра;
	ДокументОбъект.Склад = Документ.Склад;
	ДокументОбъект.Согласован = Истина;
	//ДокументОбъект.Соглашение = НайтиСоглашениеИлиДоговор("СоглашенияСКлиентами", ДокументОбъект.Организация, ДокументОбъект.Контрагент);
	ДокументОбъект.Соглашение = ДляДокумента.Соглашение;

	Если НЕ ЗначениеЗаполнено(ДокументОбъект.Соглашение) Тогда
		Возврат ;
	КонецЕсли;
	ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	ДокументОбъект.ЦенаВключаетНДС = Истина;
	ДокументОбъект.Автор = ПараметрыСеанса.ТекущийПользователь;
	ДокументОбъект.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	ДокументОбъект.КурсЧислитель = 1;
	ДокументОбъект.КурсЗнаменатель = 1;
