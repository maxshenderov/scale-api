Функция СтавкаНДСНаДату(Дата) Экспорт //+Лико m.shenderov 21.03.2024
	
		
	Результат=0; 
	
	УстановитьПривилегированныйРежим(Истина);

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(СтавкиНДС.НачалоПериода) КАК НачалоПериода
	|ПОМЕСТИТЬ ВТ_ДатаНачалаСтавки
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС
	|ГДЕ
	|	СтавкиНДС.Основная
	|	И СтавкиНДС.НачалоПериода <= &Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтавкиНДС.Ставка КАК Ставка
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДатаНачалаСтавки КАК ВТ_ДатаНачалаСтавки
	|		ПО СтавкиНДС.НачалоПериода = ВТ_ДатаНачалаСтавки.НачалоПериода
	|ГДЕ
	|	СтавкиНДС.Основная";
	Запрос.УстановитьПараметр("Дата", Дата);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат=Выборка.Ставка;
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции //-Лико m.shenderov 21.03.2024 

#КонецОбласти