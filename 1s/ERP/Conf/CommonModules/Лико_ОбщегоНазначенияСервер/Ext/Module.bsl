Процедура ОтправитьСМСПоЗаявке(ЗаявкаНаРемонт, Телефоны = Неопределено, ТекстСообщения = Неопределено)  Экспорт 
	
	Если НЕ Лико_Дополнительно.ПроверитьЭтоРабочаяБаза() Тогда
		// Это копия, письма отправлять не нужно
		Возврат;
	КонецЕсли;
	
	Если Телефоны=Неопределено Тогда
		Телефоны=Новый Массив;
		СтрокаКонтактов=ПолучитьСписокКонтактовПоПодразделению(ЗаявкаНаРемонт.ПодразделениеПолучатель,ЗаявкаНаРемонт.РабочийЦентр.Лико_Площадка);
		
		ОбщийМассив=СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаКонтактов,";",Истина);
		Для каждого Тел Из ОбщийМассив Цикл
			Если СтрНайти(Тел,"@")=0 Тогда
				Телефоны.Добавить(Тел);
			КонецЕсли;                                       
		КонецЦикла;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Телефоны) Или ТипЗнч(Телефоны)<>Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	НомерЗаявки=ЗаявкаНаРемонт.Номер; 
	Причина="";
	Комментарий="";
	Если ЗаявкаНаРемонт.Секции.Количество()>0 И ЗначениеЗаполнено(ЗаявкаНаРемонт.Секции[0].Комментарий)Тогда
		Комментарий=". Комментарий: "+СокрЛП(ЗаявкаНаРемонт.Секции[0].Комментарий);         
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Причина) и ЗаявкаНаРемонт.Секции.Количество()>0 Тогда
		Причина=СокрЛП(ЗаявкаНаРемонт.Секции[0].Причина.Наименование)
	КонецЕсли;
	
	Для каждого НомерТелефона Из Телефоны Цикл
		
		Если НЕ ЗначениеЗаполнено(ТекстСообщения) Тогда
			Строка=Формат(ТекущаяДата(), "ДФ='dd.MM.yy HH:mm'") + " ";         
			Если ЗаявкаНаРемонт.ПометкаУдаления Тогда
				Строка=Строка + "Удалена";
			Иначе
				Строка=Строка + "Добавлена";
			КонецЕсли;
			Строка = Строка + " заявка N "+ Формат(ЗаявкаНаРемонт.Номер, "ЧГ=0")+". ";
			
		Иначе
			Строка = ТекстСообщения;
		КонецЕсли;
		
		Строка=Строка+             
		СокрЛП(ЗаявкаНаРемонт.РабочийЦентр.Наименование)+". "+
		"Причина: "+Причина+Комментарий;
		
		ОтправитьСМС(НомерТелефона, Строка, НомерЗаявки);
		
		//КаталогСМС = СокрЛП(Справочники.Лико_ПредопределенныеЗначения.СМСКаталог.ЗначениеПараметра);
		//Строка=СтрЗаменить(Строка,"№","N");
		//Текстовый = Новый ТекстовыйДокумент;
		//Текстовый.УстановитьТипФайла("windows-1251");
		//Текстовый.ДобавитьСтроку("");
		//Текстовый.ДобавитьСтроку("To: " + НомерТелефона);
		//Текстовый.ДобавитьСтроку("");
		//Текстовый.ДобавитьСтроку(ВТранслит(Строка));
		//
		//Текстовый.Записать(КаталогСМС + "\" + НомерТелефона + "_" + НомерЗаявки+ ".txt");
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтправитьСМС(НомерТелефона, Сообщение, ИмяФайла = "") Экспорт
	
	//КаталогСМС = СокрЛП(Справочники.Лико_ПредопределенныеЗначения.СМСКаталог.ЗначениеПараметра);
	//Сообщение=СтрЗаменить(Сообщение,"№","N");
	//Текстовый = Новый ТекстовыйДокумент;
	//Текстовый.УстановитьТипФайла("windows-1251");
	//Текстовый.ДобавитьСтроку("");
	//Текстовый.ДобавитьСтроку("To: " + НомерТелефона);
	//Текстовый.ДобавитьСтроку("");
	//Текстовый.ДобавитьСтроку(ВТранслит(Сообщение));
	//
	//Если ИмяФайла = "" Тогда
	//	ИмяФайла = Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss");
	//КонецЕсли;
	//
	//Текстовый.Записать(КаталогСМС + "\" + НомерТелефона + "_" + ИмяФайла+ ".txt"); 
	
	// --> Начало Лико Ефимов ЕВВ 22.01.2026
	// Новый метод по API (письмо 22.01.2026 11:13)
	НомерТелефонаПриведенный = Лико_Дополнительно.ОставитьВСтрокеТолькоЧисла(НомерТелефона);
	НомерТелефонаПриведенный = СокрЛП(НомерТелефонаПриведенный);
	Если СтрДлина(НомерТелефонаПриведенный) = 10 Тогда
		НомерТелефонаПриведенный = "+7" + НомерТелефонаПриведенный;
	КонецЕсли;
	Если Лев(НомерТелефонаПриведенный, 1) = "8" Тогда
		НомерТелефонаПриведенный = "+7" + Сред(НомерТелефонаПриведенный, 2);
	КонецЕсли;
	Если Лев(НомерТелефонаПриведенный, 2) = "+8" Тогда
		НомерТелефонаПриведенный = "+7" + Сред(НомерТелефонаПриведенный, 3);
	КонецЕсли;
	Если Лев(НомерТелефонаПриведенный, 1) <> "+" Тогда
		НомерТелефонаПриведенный = "+" + НомерТелефонаПриведенный;
	КонецЕсли;
	
	СообщениеТранслит = ВТранслит(Сообщение);
	
  	Структура = Новый Структура;
	Структура.Вставить("to", НомерТелефонаПриведенный);	
	Структура.Вставить("message", СообщениеТранслит);
	json = Лико_HTTP_Сервер.СтруктураВJSON(Структура);
	host = "SMS";
	slug = "send";
	port = "5000";
	header = Новый Массив;
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Content-type", "application/json");
	Соответствие.Вставить("X-API-Key", "iiAmdRuN9chBSCB");
	header.Добавить(Соответствие);
	Попытка
		Результат = Лико_HTTP_Сервер.HttpRecuest1с(host,slug,json,,,,port,header);
		КодСостояния = Результат.КодСостояния;
	Исключение
		КодСостояния = Неопределено;
	КонецПопытки;
	Если КодСостояния = Неопределено
		ИЛИ КодСостояния <> 200 Тогда
		Попытка
			Результат = Лико_HTTP_Сервер.HttpRecuest1с(host,slug,json,,,,port,header);
			КодСостояния = Результат.КодСостояния;
		Исключение
			КодСостояния = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если КодСостояния = Неопределено
		ИЛИ КодСостояния <> 200 Тогда
		Попытка
			Результат = Лико_HTTP_Сервер.HttpRecuest1с(host,slug,json,,,,port,header);
			КодСостояния = Результат.КодСостояния;
		Исключение
			КодСостояния = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Если КодСостояния = Неопределено
		ИЛИ КодСостояния <> 200 Тогда
		ТекстПисьма = "Не удалось отправить СМС с тексом " + Сообщение + " (" + СообщениеТранслит + ")" + " на номер " + НомерТелефона + " (" + НомерТелефонаПриведенный + ")";
		Если КодСостояния = Неопределено Тогда	
			ТекстПисьма = ТекстПисьма + ". КодСостояния не получен";
		Иначе
			ТекстПисьма = ТекстПисьма + ". КодСостояния = " + КодСостояния;
		КонецЕсли;
		
		Лико_Планирование.ОтправитьПисьмо(ТекстПисьма, "Ошибка при отправке СМС из 1С", "vefimov@okil.ru",, "textBody",,,, Ложь); 
	КонецЕсли;
