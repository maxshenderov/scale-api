Функция ПечатьСтикераДокумента(ДокументСсылка, КоличествоЭкземпляров=1, БыстраяПечать=Истина, ИмяПринтера="",ГруппироватьПо=Неопределено) Экспорт  
	ДанныеДляПечати = Новый Структура;
	КолУУ=Ложь;
	КоличествоГПУУ=0; 
	Сотрудник=ДокументСсылка.Сотрудник;
	Если ТипЗнч(ДокументСсылка)=Тип("ДокументСсылка.Лико_БланкЭтапа") Тогда
		ДанныеДляПечати.Вставить("Дата", ДокументСсылка.Дата);
		ДанныеДляПечати.Вставить("Номер", ДокументСсылка.Номер);
		ДанныеДляПечати.Вставить("ВидОперации", СтрШаблон("Закрытие бланка заказа № %1 от %2",ДокументСсылка.Номер,ДокументСсылка.Дата));
		ДанныеДляПечати.Вставить("Получатель", ДокументСсылка.РабочийЦентр);
		ДанныеДляПечати.Вставить("НомерЗаказа", ДокументСсылка.НомерЗаказа);
		ДанныеДляПечати.Вставить("Сотрудник", ФизическиеЛицаКлиентСервер.ФамилияИнициалыФизЛица(Строка(ДокументСсылка.Сотрудник))
		+ ?(ЗначениеЗаполнено(ДокументСсылка.Сотрудник2), ", "+ФизическиеЛицаКлиентСервер.ФамилияИнициалыФизЛица(Строка(ДокументСсылка.Сотрудник2)),""));
		ДанныеДляПечати.Вставить("АвторДокумента",                                       ФизическиеЛицаКлиентСервер.ФамилияИнициалыФизЛица(Строка(ДокументСсылка.АвторДокумента)));                
		
		//+ Лико m.shenderov 20.12.2017
		
		
		
		Если ЗначениеЗаполнено(ДокументСсылка.ДатаНачала) И ЗначениеЗаполнено(ДокументСсылка.ДатаОкончания) Тогда
			
			ДанныеДляПечати.Вставить("Длительность",Окр((ДокументСсылка.ДатаОкончания-ДокументСсылка.ДатаНачала)/60/60,2));
			
		КонецЕсли;
		//- Лико m.shenderov 20.12.2017
		
		
		СтруктураВыпущеннаяГП = ПолучитьКоличествоВыпущеннойГП(ДокументСсылка);
		КоличествоГП = СтруктураВыпущеннаяГП.КоличествоГП;
		ЕдиницаИзмеренияГП = СтруктураВыпущеннаяГП.ЕдиницаИзмеренияГП;
		ДанныеДляПечати.Вставить("КоличествоГППредставление", "" + КоличествоГП + "  "+ЕдиницаИзмеренияГП);
		
		ТЗТовары = ДокументСсылка.Товары.ВыгрузитьКолонки();
		ТЗВыпуск = ДокументСсылка.Выпуск.ВыгрузитьКолонки(); 
		
		
		Если ГруппироватьПо<>Неопределено Тогда 
			КоличествоГП=0;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Лико_БланкЭтапа.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.Лико_БланкЭтапа КАК Лико_БланкЭтапа
			|ГДЕ
			|	Лико_БланкЭтапа.Проведен
			|	И Лико_БланкЭтапа.ЗаказПокупателя = &Заказ 
			|	И Лико_БланкЭтапа.НомерПроката = &НомерПроката 
			|	И Лико_БланкЭтапа.Сотрудник = &Сотрудник
			|	И ВЫБОР
			|			КОГДА &ФильтрПоБланку
			|				ТОГДА Лико_БланкЭтапа.НомерБланка = &НомерБланка
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ
			|
			|УПОРЯДОЧИТЬ ПО
			|	Лико_БланкЭтапа.Дата";
			Запрос.УстановитьПараметр("Заказ",ДокументСсылка.ЗаказПокупателя);
			Запрос.УстановитьПараметр("НомерПроката",ДокументСсылка.НомерПроката);
			Запрос.УстановитьПараметр("Сотрудник",Сотрудник);
			Запрос.УстановитьПараметр("ФильтрПоБланку",ГруппироватьПо="Бланк");
			Запрос.УстановитьПараметр("НомерБланка",ДокументСсылка.НомерБланка);
			
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			СтрДок="Закрытия бланков заказа № : ";
			ПерваяСтрока=Истина;
			Пока Выборка.Следующий() Цикл
				
				Если ПерваяСтрока Тогда					
					ПерваяСтрока=Ложь;
					
					СтрДок=СтрШаблон("%1%2",СтрДок,Выборка.Ссылка.Номер);
				Иначе
					СтрДок=СтрШаблон("%1, %2",СтрДок,Выборка.Ссылка.Номер); 				
				КонецЕсли;
				
				
				Для Каждого СтрокаТовары Из Выборка.Ссылка.Товары Цикл
					
					Если Не СтрокаТовары.Списать Тогда
						Продолжить;
					КонецЕсли;
					
					НоваяСтрока = ТЗТовары.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовары);
					
					НоваяСтрока.Количество = НоваяСтрока.КоличествоРасход ;
					НоваяСтрока.КоличествоУУ = НоваяСтрока.КоличествоРасходУУ;
					
				КонецЦикла;  
				Для Каждого СтрокаВыпуск Из Выборка.Ссылка.Выпуск Цикл
					
					
					НоваяСтрока = ТЗВыпуск.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВыпуск);
					КоличествоГП=КоличествоГП+НоваяСтрока.Количество;
					КоличествоГПУУ=КоличествоГПУУ+НоваяСтрока.КоличествоУУ; 
					ЕдиницаИзмеренияГП= СтрШаблон("пог. м (%1 м2)",Строка(КоличествоГПУУ));  
					ДанныеДляПечати.Вставить("КоличествоГППредставление", "" + КоличествоГП + "  "+ЕдиницаИзмеренияГП);
					
					
				КонецЦикла;
				
				
				
				
			КонецЦикла; 
			
			ДанныеДляПечати.Вставить("ВидОперации",СтрДок);	
			
			
		Иначе
			
			
			Для Каждого СтрокаТовары Из ДокументСсылка.Товары Цикл
				
				Если Не СтрокаТовары.Списать Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ТЗТовары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовары);
				
				НоваяСтрока.Количество = НоваяСтрока.КоличествоРасход ;
				НоваяСтрока.КоличествоУУ = НоваяСтрока.КоличествоРасходУУ;
				
			КонецЦикла;
			
			ТЗВыпуск = ДокументСсылка.Выпуск.Выгрузить(); 
			
		КонецЕсли;
		
		
		КолУУ=Истина;
	ИначеЕсли ТипЗнч(ДокументСсылка)=Тип("ДокументСсылка.Лико_ВозвратТоваров") или ТипЗнч(ДокументСсылка)=Тип("ДокументСсылка.Лико_ПередачаТоваров") Тогда
		ДанныеДляПечати.Вставить("Дата",                                                                  ДокументСсылка.Дата);
		ДанныеДляПечати.Вставить("Номер",                                                                              ДокументСсылка.Номер);
		//ДанныеДляПечати.Вставить("ВидОперации",                                               ДокументСсылка.ВидОперации);
		ДанныеДляПечати.Вставить("ВидОперации", СтрШаблон("%1 № %2 от %3",ДокументСсылка.ВидОперации,ДокументСсылка.Номер,ДокументСсылка.Дата));
		ДанныеДляПечати.Вставить("Получатель",                                                    ДокументСсылка.АдресХранения);
		Если ТипЗнч(ДокументСсылка)=Тип("ДокументСсылка.Лико_ПередачаТоваров") И ЗначениеЗаполнено(ДокументСсылка.Получатель) Тогда
			ДанныеДляПечати.Получатель=ДокументСсылка.Получатель; 
		КонецЕсли;
		
		ДанныеДляПечати.Вставить("НомерЗаказа",                                 Прав(ДокументСсылка.ЗаказКлиента.Номер,7));
		ДанныеДляПечати.Вставить("Сотрудник",                                                      ФизическиеЛицаКлиентСервер.ФамилияИнициалыФизЛица(Строка(ДокументСсылка.Сотрудник)));;
		ДанныеДляПечати.Вставить("АвторДокумента",                                       ФизическиеЛицаКлиентСервер.ФамилияИнициалыФизЛица(Строка(ДокументСсылка.АвторДокумента)));                               
		ТЗТовары = ДокументСсылка.Товары.Выгрузить();
		КоличествоГП=0;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Макет = Документы.Лико_БланкЭтапа.ПолучитьМакет("ЗакрытиеБланкаЗаказа");
	
	Если КоличествоГП=0 Тогда
		ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	Иначе
		ОбластьШапка  = Макет.ПолучитьОбласть("ШапкаСВыпускомГП");
	КонецЕсли;
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	ОбластьШапкаВыпуск = Макет.ПолучитьОбласть("ШапкаВыпуск");
	ОбластьСтрокаВыпуск = Макет.ПолучитьОбласть("СтрокаВыпуск");
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ЯССМ_ПАРАМЕТРЫ_ПЕЧАТИ_ЯССМ_ЗакрытиеБланкаЗаказа";
	
	ОбластьШапка.Параметры.Заполнить(ДанныеДляПечати);
	ТабДокумент.Вывести(ОбластьШапка);
	
	
	ТЗТовары.Колонки.Добавить("Нарезка");
	ТЗТовары.Колонки.Добавить("Втулка");
	ТЗТовары.Колонки.Добавить("БазоваяЕдиницаИзмерения");
	
	
	Для Каждого СтрокаТЗТовары Из ТЗТовары Цикл
		СтрокаТЗТовары.Номенклатура = СтрокаТЗТовары.Номенклатура;
		СтрокаТЗТовары.Нарезка = СтрокаТЗТовары.Характеристика;
		СтрокаТЗТовары.Втулка = СтрокаТЗТовары.Серия.ЯССМ_ОбъектНоменклатуры.Втулка;
		СтрокаТЗТовары.БазоваяЕдиницаИзмерения = СтрокаТЗТовары.Серия.Яссм_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения;
	КонецЦикла;
	//ТЗТовары.Свернуть("Номенклатура, Нарезка, Втулка, БазоваяЕдиницаИзмерения", "Количество,КоличествоУпаковок");
	ТЗИтог= Новый ТаблицаЗначений;
	ТЗИтог.Колонки.Добавить("Номенклатура");
	ТЗИтог.Колонки.Добавить("Нарезка");
	ТЗИтог.Колонки.Добавить("Втулка");
	ТЗИтог.Колонки.Добавить("БазоваяЕдиницаИзмерения");
	ТЗИтог.Колонки.Добавить("Количество");
	ТЗИтог.Колонки.Добавить("КоличествоУУ");
	
	
	Если  ТипЗнч(ДокументСсылка)=Тип("ДокументСсылка.Лико_БланкЭтапа") Тогда
		Для Каждого СтрокаТЗТовары Из ТЗТовары Цикл
			НовыйТЗИтог=ТЗИтог.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйТЗИтог,СтрокаТЗТовары);
			НовыйТЗИтог.БазоваяЕдиницаИзмерения= СтрокаТЗТовары.БазоваяЕдиницаИзмерения.Наименование;
		КонецЦикла;
		
		
		ТЗИтог.Свернуть("Номенклатура, Нарезка, Втулка, БазоваяЕдиницаИзмерения", "Количество,КоличествоУУ");
	Иначе
		Для Каждого СтрокаТЗТовары Из ТЗТовары Цикл
			НовыйТЗИтог=ТЗИтог.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйТЗИтог,СтрокаТЗТовары);
			НовыйТЗИтог.БазоваяЕдиницаИзмерения= СтрокаТЗТовары.БазоваяЕдиницаИзмерения.Наименование;
			НовыйТЗИтог.Количество= СтрокаТЗТовары.КоличествоУпаковок;
			НовыйТЗИтог.КоличествоУУ= СтрокаТЗТовары.Количество;
			
		КонецЦикла;                    
		
		ТЗИтог.Свернуть("Номенклатура, Нарезка, Втулка, БазоваяЕдиницаИзмерения", "Количество,КоличествоУУ");
		
	КонецЕсли;
	
	Для Каждого СтрокаТовары Из ТЗИтог Цикл
		ОбластьСтрока.Параметры.НоменклатураПредставление = "" + Формат(СтрокаТовары.Номенклатура.ЦеноваяГруппа.Код, "ЧГ=0") + " (" + СтрокаТовары.Номенклатура.Код + ") " + " " + СтрокаТовары.Номенклатура;
		ОбластьСтрока.Параметры.НамоткаВтулкаПредставление = ?(ЗначениеЗаполнено(СтрокаТовары.Нарезка), "Ø"+СтрокаТовары.Нарезка+" ", "") + ?(ЗначениеЗаполнено(СтрокаТовары.Втулка), "("+СтрокаТовары.Втулка+")", "");
		ОбластьСтрока.Параметры.КоличествоПредставление = "" + ?(КолУУ,СтрокаТовары.Количество,СтрокаТовары.Количество) + " " + СтрокаТовары.БазоваяЕдиницаИзмерения;
		
		ТабДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;
	Если ТипЗнч(ДокументСсылка)=Тип("ДокументСсылка.Лико_БланкЭтапа") и ДокументСсылка.РабочийЦентр.Лико_ВводитьУдарыПриЗакрытииЗаказа Тогда                      
		ОбластьСтрока.Параметры.НоменклатураПредставление ="Количество ударов ";
		//ОбластьСтрока.Параметры.НамоткаВтулкаПредставление = ?(ЗначениеЗаполнено(СтрокаТовары.Нарезка), "Ø"+СтрокаТовары.Нарезка+" ", "") + ?(ЗначениеЗаполнено(СтрокаТовары.Втулка), "("+СтрокаТовары.Втулка+")", "");
		ОбластьСтрока.Параметры.КоличествоПредставление =  ДокументСсылка.КоличествоУдаров;
		ТабДокумент.Вывести(ОбластьСтрока);                            
	КонецЕсли;
	
	
	Если КоличествоГП>0 Тогда
		ТабДокумент.Вывести(ОбластьШапкаВыпуск);
		
		
		ТЗВыпуск.Колонки.Добавить("Нарезка");
		ТЗВыпуск.Колонки.Добавить("Втулка");
		ТЗВыпуск.Колонки.Добавить("БазоваяЕдиницаИзмерения");
		Для Каждого СтрокаТЗВыпуск Из ТЗВыпуск Цикл
			СтрокаТЗВыпуск.Номенклатура = СтрокаТЗВыпуск.Номенклатура;
			СтрокаТЗВыпуск.Нарезка = СтрокаТЗВыпуск.Серия.ЯССМ_ОбъектНоменклатуры.Нарезка;
			СтрокаТЗВыпуск.Втулка = СтрокаТЗВыпуск.Серия.ЯССМ_ОбъектНоменклатуры.Втулка;
			СтрокаТЗВыпуск.БазоваяЕдиницаИзмерения = СтрокаТЗВыпуск.Серия.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения;
		КонецЦикла;
		ТЗВыпуск.Свернуть("Номенклатура, Нарезка, Втулка, БазоваяЕдиницаИзмерения", "Количество");
		
		Для Каждого СтрокаТЗВыпуск Из ТЗВыпуск Цикл
			ОбластьСтрокаВыпуск.Параметры.НоменклатураПредставление = "" + Формат(СтрокаТЗВыпуск.Номенклатура.ЦеноваяГруппа.Код, "ЧГ=0") + " (" + СтрокаТЗВыпуск.Номенклатура.Код + ") " + " " + СтрокаТЗВыпуск.Номенклатура;
			ОбластьСтрокаВыпуск.Параметры.НамоткаВтулкаПредставление = ?(ЗначениеЗаполнено(СтрокаТЗВыпуск.Нарезка), "Ø"+СтрокаТЗВыпуск.Нарезка+" ", "") + ?(ЗначениеЗаполнено(СтрокаТЗВыпуск.Втулка), "("+СтрокаТЗВыпуск.Втулка+")", "");
			ОбластьСтрокаВыпуск.Параметры.КоличествоПредставление = "" + СтрокаТЗВыпуск.Количество + " " + СтрокаТЗВыпуск.БазоваяЕдиницаИзмерения;
			ТабДокумент.Вывести(ОбластьСтрокаВыпуск);
		КонецЦикла;                    
	КонецЕсли;       
	
	//+ Лико m.shenderov 20.12.2017
	Если ДанныеДляПечати.Свойство("Длительность") Тогда
		ОбластьВремя  = Макет.ПолучитьОбласть("СтрокаВремя");
		ОбластьВремя.Параметры.Время=ДанныеДляПечати.Длительность;
		ТабДокумент.Вывести(ОбластьВремя);
		
	КонецЕсли;
	
	//- Лико m.shenderov 20.12.2017
	
	
	Если ИмяПринтера="" Тогда
		
		ИмяПринтера=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ИмяПринтераЭтикеток","");
		
	КонецЕсли;
	
	
	
	
	//ОбъектВывода.Защита = Истина;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ПолеСлева = 1;
	ТабДокумент.ПолеСправа = 0;
	ТабДокумент.ПолеСнизу = 0;
	ТабДокумент.ПолеСверху = 1;
	
	ТабДокумент.ИмяПринтера = ИмяПринтера;
	
	// Получить необходимое количество копий
	Если КоличествоЭкземпляров > 0 Тогда
		ТабДокумент.КоличествоЭкземпляров = КоличествоЭкземпляров;
	КонецЕсли;
	Возврат ТабДокумент; 
	
КонецФункции



Функция ПолучитьКоличествоВыпущеннойГП(ЗакрытиеЗаказаСсылка) Экспорт
	
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("КоличествоГП", 0);
	СтруктураРезультат.Вставить("ЕдиницаИзмеренияГП", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	
	ЗапросГП = Новый Запрос;
	ЗапросГП.Текст = 
	"ВЫБРАТЬ
	|             ЕСТЬNULL(ВложенныйЗапрос.Количество, 0) КАК КоличествоГП,
	|             ВложенныйЗапрос.ОбъектНоменклатурыБазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|             (ВЫБРАТЬ
	|                             СУММА(ЯССМ_ЗакрытиеЗаказаВыпуск.Количество) КАК Количество,
	|                     МАКСИМУМ(ЯССМ_ЗакрытиеЗаказаВыпуск.Серия.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения) КАК ОбъектНоменклатурыБазоваяЕдиницаИзмерения
	|             ИЗ
	|                             Документ.Лико_БланкЭтапа.Выпуск КАК ЯССМ_ЗакрытиеЗаказаВыпуск
	|             ГДЕ
	|                             ЯССМ_ЗакрытиеЗаказаВыпуск.Ссылка = &Ссылка) КАК ВложенныйЗапрос";
	ЗапросГП.УстановитьПараметр("Ссылка", ЗакрытиеЗаказаСсылка);
	РезультатЗапросаГП = ЗапросГП.Выполнить();
	Если Не РезультатЗапросаГП.Пустой() Тогда
		ВыборкаЗапросаГП = РезультатЗапросаГП.Выбрать();
		ВыборкаЗапросаГП.Следующий();
		
		СтруктураРезультат.Вставить("КоличествоГП", ВыборкаЗапросаГП.КоличествоГП);
		СтруктураРезультат.Вставить("ЕдиницаИзмеренияГП", ВыборкаЗапросаГП.ЕдиницаИзмерения);
	КонецЕсли;
	
