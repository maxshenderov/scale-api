Функция ПолучитьТЗGtin(gtin="") Экспорт  //+Лико m.shenderov 12.05.2021
	
	Попытка 		
		УстановитьПривилегированныйРежим(Истина);	
		SetHttp = Новый Структура;
		SetHttp.Вставить("host","192.168.20.80");
		SetHttp.Вставить("slug","api/ps/v1/mcdn/orders/info");
		SetHttp.Вставить("port",6085);
		
		Token=": 2c04ec6c-6ee4-91bf-128e-6ab5e3fee1c5";
		HtmlHeader = Новый Массив(); 	
		HtmlHeader.Добавить(Новый Структура("Authorization", СтрШаблон("clientToken %1",Token)));
		
		Если ЗначениеЗаполнено(gtin) Тогда
			
			Структура = Новый Структура;
			Структура.Вставить("id",0);
			Массив = Новый Массив();
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("gtin",gtin);
			Массив.Добавить(СтруктураОтбора);
			Структура.Вставить("params",Массив);
			ТелоЗапроса=Лико_HTTP_Сервер.СтруктураВJSON(Структура);
			
			
			
			HttpRecuest=Лико_HTTP_Сервер.HttpResponsPost(SetHttp.host,SetHttp.slug,ТелоЗапроса,"",SetHttp.port,HtmlHeader);
			Результат=Лико_HTTP_Сервер.ПолучитьОтветJSON(HttpRecuest).result;	
			
		Иначе
			Ответ=Лико_HTTP_Сервер.HttpResponsGet(SetHttp.host,SetHttp.slug,SetHttp.port);
			
			ЧтениеJSON = Новый ЧтениеJSON; 	
			ЧтениеJSON.УстановитьСтроку(Ответ);	
			Данные = ПрочитатьJSON(ЧтениеJSON,,,ФорматДатыJSON.ISO);
			ЧтениеJSON.Закрыть();
			Результат= Данные.result;
		КонецЕсли;
		Для каждого ТД Из Результат Цикл
			ТД.timestamp_suz=Лико_HTTP_Сервер.TimestampВДату(Цел(ТД.timestamp_suz/1000));
			ТД.update_time=Лико_HTTP_Сервер.TimestampВДату(ТД.update_time);
		КонецЦикла;
		
		Возврат  ОбщегоНазначенияУТ.МассивВТаблицуЗначений(Результат);
		
	Исключение
		Сообщить(ОписаниеОшибки());		
	КонецПопытки; 
	
КонецФункции //-Лико m.shenderov 12.05.2021 


