Функция ФорматДлительности(Знач Длительность)
	
	
	Если Не ЗначениеЗаполнено(Длительность) Или Длительность <=0  Тогда 
		Возврат "";
	ИначеЕсли  Цел(Длительность)<=60 тогда 
		Возврат "00:"+Формат(Длительность,"ЧЦ=2; ЧВН=");
		
	иначе 
		Возврат Строка(Цел(Цел(Длительность)/60))+":"+Формат(Окр(Длительность,0)-Цел(Цел(Длительность)/60)*60,"ЧЦ=2; ЧВН=");
	КонецЕсли;
	
