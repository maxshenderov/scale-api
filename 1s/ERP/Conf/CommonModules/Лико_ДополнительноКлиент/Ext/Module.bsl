&НаКлиенте
Процедура ЗакрытьСоединениеССервером(ПараметрыСоединения) экспорт
	ADOCommand = ПараметрыСоединения.ADOCommand;
	ADORecordset = ПараметрыСоединения.ADORecordset;
	ADOConnection = ПараметрыСоединения.ADOConnection;
	
	Если ADORecordset <> Неопределено И ADORecordset.State <> 0 Тогда
		ADORecordset.Close();
	КонецЕсли;
	
	Если ADOCommand <> Неопределено И ADOCommand.State <> 0 Тогда
		ADOCommand.Close();
	КонецЕсли;
	
	Если ADOConnection <> Неопределено И ADOConnection.State <> 0 Тогда
		ADOConnection.Close();
	КонецЕсли;
	
	Попытка
		ADOCommand.УдалитьCOMОбъект();
		ADORecordset.УдалитьCOMОбъект();	
		ADOConnection.УдалитьCOMОбъект();	
	Исключение	
	КонецПопытки;
	
КонецПроцедуры

