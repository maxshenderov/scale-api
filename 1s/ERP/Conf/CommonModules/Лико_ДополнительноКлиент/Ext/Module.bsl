&НаКлиенте
Процедура ПочиститьШтрихкодыОтЗапрещенныхСимволов(МассивШтрихкодов) Экспорт // --> Начало Лико Ефимов ЕВВ 06.09.2017
	
	Если ТипЗнч(МассивШтрихкодов) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для сч=0 по МассивШтрихкодов.Количество()-1 Цикл
		ЭлементМассива = МассивШтрихкодов[сч];
		Если ТипЗнч(ЭлементМассива) = Тип("Массив") Тогда
			ПочиститьШтрихкодыОтЗапрещенныхСимволов(ЭлементМассива);
		Иначе
			УдалитьИзСтрокиЗапрещенныеСимволы(ЭлементМассива);
		КонецЕсли;
		МассивШтрихкодов.Установить(сч, ЭлементМассива);
	КонецЦикла;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 06.09.2017

&НаКлиенте
Процедура УдалитьИзСтрокиЗапрещенныеСимволы(Строка) Экспорт // --> Начало Лико Ефимов ЕВВ 06.09.2017
	
	Если ТипЗнч(Строка) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	
	МассивЗапрещенныхСимволов = Новый Массив;
	МассивЗапрещенныхСимволов.Добавить(Символ(29));
	
	СтрокаБезЗапрещенныхСимволов = "";
	ДлинаСтроки = СтрДлина(Строка);
	Для сч=1 по ДлинаСтроки Цикл
		ТекСимвол = Сред(Строка, сч, 1);
		Если МассивЗапрещенныхСимволов.Найти(ТекСимвол) = Неопределено Тогда
			СтрокаБезЗапрещенныхСимволов = СтрокаБезЗапрещенныхСимволов + ТекСимвол;
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	Строка = СтрокаБезЗапрещенныхСимволов;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 06.09.2017

