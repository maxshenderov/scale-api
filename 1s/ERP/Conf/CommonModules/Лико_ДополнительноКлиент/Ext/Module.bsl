&НаКлиенте
Процедура РедактированиеРеквизитовСписка(Поле,СписокДляРедактирования,ТекущийДокумент,СтандартнаяОбработка) Экспорт
	
	Структура = Новый Структура;
	
	Если Лико_Дополнительно.РольДоступнаНаСервере("ПолныеПрава") ИЛИ Лико_Дополнительно.РольДоступнаНаСервере("Лико_ДоступКСтатусуПриходаДокументов") Тогда
		Если Найти(Поле.Имя,"Лико_СтатусПриходаДокументов")>0 Тогда
			СтандартнаяОбработка = Ложь;
			Реквизит = "Лико_СтатусПриходаДокументов";
			Подсказка = "Выберите статус прихода документов."
		ИначеЕсли Найти(Поле.Имя,"Лико_КомментарийПоПриходуДокументов")>0 Тогда
			СтандартнаяОбработка = Ложь;
			Реквизит = "Лико_КомментарийПоПриходуДокументов";
			Подсказка = "Введите комментарий по приходу документов.";
		КонецЕсли;
	КонецЕсли;
	
	Если Лико_Дополнительно.РольДоступнаНаСервере("ПолныеПрава") ИЛИ Лико_Дополнительно.РольДоступнаНаСервере("Лико_ДоступКДатеЗакрытияПродаж") Тогда
		Если Найти(Поле.Имя,"Лико_ДатаЗакрытия")>0 Тогда
			СтандартнаяОбработка = Ложь;
			Реквизит = "Лико_ДатаЗакрытия";
			Подсказка = "Введите Дату закрытия документа.";		
		КонецЕсли;
	КонецЕсли;
	
	Если Не СтандартнаяОбработка Тогда 
		Структура.Вставить("Ключ",Реквизит); 
		Структура.Вставить("СписокДляРедактирования", СписокДляРедактирования);
		Структура.Вставить("ТекущийДокумент", ТекущийДокумент);
		ТекущееЗначение = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТекущийДокумент,Реквизит);
		
		ОписаниеОповещения= Новый ОписаниеОповещения("РедактированиеРеквизитаЗавершение",Лико_ДополнительноКлиент,Структура);
		
		Если Реквизит = "Лико_СтатусПриходаДокументов" Тогда
			ОткрытьФорму("Справочник.Лико_СтатусыПриходаДокументов.ФормаВыбора",,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		ИначеЕсли Реквизит = "Лико_КомментарийПоПриходуДокументов" Тогда
			ПоказатьВводСтроки(ОписаниеОповещения,ТекущееЗначение,Подсказка);
		ИначеЕсли Реквизит = "Лико_ДатаЗакрытия" Тогда
			ПоказатьВводДаты(ОписаниеОповещения,ТекущееЗначение,Подсказка);
		КонецЕсли;
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеРеквизитаЗавершение(РезультатФормы, ПараметрФормы) Экспорт
	Если РезультатФормы=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Лико_Дополнительно.РедактироватьРеквизитСервер(ПараметрФормы.ТекущийДокумент,ПараметрФормы.Ключ,РезультатФормы);
	Если ПараметрФормы.Ключ = "Лико_ДатаЗакрытия"  И  ОбщегоНазначенияУТКлиентСервер.ЕстьРеквизитОбъекта(ПараметрФормы.ТекущийДокумент, "Лико_ДатаОплаты") Тогда 
		Лико_ДатаОплаты 		= ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ПараметрФормы.ТекущийДокумент, "Лико_ДатаОплаты");
		ДатаПолученияДокументов = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ПараметрФормы.ТекущийДокумент,"ДатаПолученияДокументов") ;
		Если (РезультатФормы<> Макс(Лико_ДатаОплаты ,ДатаПолученияДокументов) ИЛИ Не ЗначениеЗаполнено(Мин(Лико_ДатаОплаты ,ДатаПолученияДокументов) ))
			И Не ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ПараметрФормы.ТекущийДокумент , "Лико_РучнаяКорректировкаДатыЗакрытия")  Тогда  
			Лико_Дополнительно.РедактироватьРеквизитСервер(ПараметрФормы.ТекущийДокумент,"Лико_РучнаяКорректировкаДатыЗакрытия",Истина);
		КонецЕсли;
	КонецЕсли;
	ПараметрФормы.СписокДляРедактирования.Обновить();	
КонецПроцедуры


