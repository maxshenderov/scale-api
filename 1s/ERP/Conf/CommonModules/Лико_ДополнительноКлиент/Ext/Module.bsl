&НаКлиенте
Функция Connect(ADOConnection, ADOCommand, ADORecordset, ДанныеДляПодключения)
	ОбъектыСозданы = CreateConnection(ADOConnection) И CreateCommand(ADOCommand) И CreateRecordset(ADORecordset);
	
	Возврат_ = Истина;
	
	Если ОбъектыСозданы И ADOConnection.State=0 Тогда
		
		Если InitConnection(ADOConnection, ДанныеДляПодключения) Тогда
		Иначе
			Возврат_ = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Возврат_;
КонецФункции

&НаКлиенте
Функция InitConnection(ADOConnection, ДанныеДляПодключения)
	Возврат_ = Истина;
	
	source__ = "Provider=SQLOLEDB; SERVER=" + СокрЛП(ДанныеДляПодключения.ServerName)       
	+ "; Database=" + СокрЛП(ДанныеДляПодключения.NameDB) + "; ";
	
	ТекстПользователя = "";				
	
	Если ДанныеДляПодключения.Свойство("SQL_Пользователь") Тогда        // nadin 
		source__ = source__ + "Uid=" + СокрЛП(ДанныеДляПодключения.SQL_Пользователь) + ";";
		source__ = source__ + "Pwd=" + СокрЛП(ДанныеДляПодключения.SQL_Пароль) + ";";
		
		ТекстПользователя = "" + ДанныеДляПодключения.SQL_Пользователь;
	Иначе
		source__ = source__ + "Trusted_Connection=Yes;";
		
		ТекстПользователя = "пользователь операционной системы";
	КонецЕсли;
	
