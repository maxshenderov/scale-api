// Поиск физического лица по введенным цифрам табельного номера
Процедура ПоискФизЛицаПоТабНомеруПриОкончанииВводаТекста(ПолеВвода, Текст, ЗначениеПоляВвода, СтандартнаяОбработка) Экспорт
	
	Попытка
		СтандартнаяОбработка = Ложь;
		
		ТекстЧисло = Число(Текст);
		
		Если ТекстЧисло>0 Тогда
			МассивФиз = Лико_Дополнительно.ОпределитьРаботникаПоТабНомеру(ТекстЧисло, ТекущаяДата());
			ТекстОшибки="";	
			
			Если МассивФиз.Количество() = 1 Тогда
				ЗначениеПоляВвода= МассивФиз.Получить(0);
				
			ИначеЕсли МассивФиз.Количество() = 0 Тогда 		
				ТекстОшибки="Не найден сотрудник с табельным номером "+ТекстЧисло+".";
				
			Иначе
				ТекстОшибки="Найдено "+МассивФиз.Количество()+
				" сотрудников с табельным номером "+ТекстЧисло+
				" нет возможности определить нужного.";
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				СообщениенПользователю= Новый СообщениеПользователю();
				СообщениенПользователю.Текст= ТекстОшибки;
				СообщениенПользователю.Поле=ПолеВвода;
				СообщениенПользователю.Сообщить();
			КонецЕсли; 	
		КонецЕсли;
	Исключение
		СтандартнаяОбработка = Истина;
	КонецПопытки;
	
КонецПроцедуры //ПоискФизЛицаПоТабНомеруПриОкончанииВводаТекста Экспорт


