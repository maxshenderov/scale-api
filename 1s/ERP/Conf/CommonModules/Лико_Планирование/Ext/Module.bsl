#Область Лико_СебестоимостьЗаказов 
Процедура ЗаполнитьЛико_СебестоимостьЗаказов(Период = Неопределено, Площадка = Неопределено, Партнер = Неопределено, Заказ = Неопределено, ТолькоУдалить = Ложь, Регистратор = Неопределено, ЗапускИзОбработки = Ложь) Экспорт

	НачалоОбработки = ТекущаяДата(); 
	
	Если Регистратор = Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(Площадка) Тогда
			Сообщить("Заполните площадку");
			Возврат;
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(Период.ДатаНачала) Тогда
			Сообщить("Заполнить дату начала периода");
			Возврат;
		КонецЕсли;  
		
		Если ТолькоУдалить Тогда
			// Без транзакции просто удалим
			УдалитьДвиженияЛико_СебестоимостьЗаказовЗаПериод(Период, Площадка, Партнер, Заказ); 
			Сообщить("Удаление завершено " + НачалоОбработки + " - " + ТекущаяДата());
			Возврат;
		КонецЕсли;
	Иначе 
		Если НЕ ЗначениеЗаполнено(Регистратор) Тогда
			Сообщить("В процедуру по заполнению регистра Лико_СебестоимостьЗаказов передан пустой регистратор");
			Возврат;
		КонецЕсли;
		// Присвоим вместо Неопределено пустые значения, т.к. в запросе проверка на пустные значения
		Период = Новый СтандартныйПериод;
		Площадка = Справочники.Организации.ПустаяСсылка();
		Партнер = Справочники.Партнеры.ПустаяСсылка();
		Заказ = Документы.ЗаказКлиента.ПустаяСсылка();
	КонецЕсли;
		
	НачатьТранзакцию();

	Если Регистратор = Неопределено Тогда
		УдалитьДвиженияЛико_СебестоимостьЗаказовЗаПериод(Период, Площадка, Партнер, Заказ);
	Иначе
		// Удалим движения только по регистратору
		НаборЗаписейСебестоимостьЗаказов = РегистрыНакопления.Лико_СебестоимостьЗаказов.СоздатьНаборЗаписей();
		НаборЗаписейСебестоимостьЗаказов.Отбор.Регистратор.Установить(Регистратор);
		НаборЗаписейСебестоимостьЗаказов.Записать();
		Если ТолькоУдалить Тогда
			ЗафиксироватьТранзакцию();
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	МассивИменРесурсов = Новый Массив;
	Для каждого Ресурс из Метаданные.РегистрыНакопления.Лико_СебестоимостьЗаказов.Ресурсы Цикл
		Если Ресурс.Имя = "Транспорт" Тогда
			Продолжить;
		КонецЕсли;
		МассивИменРесурсов.Добавить(Ресурс.Имя);
	КонецЦикла;

	Запрос = СформироватьЗапросЗаполненияЛико_СебестоимостьЗаказов(Период, Площадка, Партнер, Заказ, Регистратор);
	Пакеты = Запрос.ВыполнитьПакет();
	СооЗаказыОстатки = СформироватьСоответствиеЗаказыОстаткиДляЗаполненияЛико_СебестоимостьЗаказов(Пакеты[6], МассивИменРесурсов);
	СооСборок = СформироватьСоответствиеСборокДляЗаполненияЛико_СебестоимостьЗаказов(Пакеты[4]);
	СооЗаказыВыпуски = СформироватьСоответствиеЗаказыОстаткиДляЗаполненияЛико_СебестоимостьЗаказов(Пакеты[7], МассивИменРесурсов);
	
	РаспределитьНаПартииЛико_СебестоимостьЗаказов(Пакеты[5], СооЗаказыОстатки, СооСборок, МассивИменРесурсов, СооЗаказыВыпуски);
	
	ЗафиксироватьТранзакцию();

	Если ЗапускИзОбработки Тогда
		Сообщить("Готово " + НачалоОбработки + " - " + ТекущаяДата());
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьДвиженияЛико_СебестоимостьЗаказовЗаПериод(Период, Площадка, Партнер, Заказ) 	
	
	Запрос = Новый Запрос;
	Запрос.Текст =    
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Лико_СебестоимостьЗаказов.Регистратор КАК Регистратор,
	|	МИНИМУМ(Лико_СебестоимостьЗаказов.Период) КАК Период
	|ИЗ
	|	РегистрНакопления.Лико_СебестоимостьЗаказов КАК Лико_СебестоимостьЗаказов
	|ГДЕ
	|	НЕ Лико_СебестоимостьЗаказов.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2
	|	И Лико_СебестоимостьЗаказов.Период >= &ДатаНачала
	|	И Лико_СебестоимостьЗаказов.Заказ.Площадка = &Площадка
	|	И ВЫБОР
	|			КОГДА &Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Лико_СебестоимостьЗаказов.Заказ.Партнер = &Партнер
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_СебестоимостьЗаказов.Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);  
	Запрос.УстановитьПараметр("Площадка", Площадка);
	Запрос.УстановитьПараметр("Партнер", Партнер);
	
	ВыборкаЗапросов = Запрос.Выполнить();    
	ВыборкаОчистка = ВыборкаЗапросов.Выбрать();  
	
	Пока ВыборкаОчистка.Следующий() Цикл
		НаборЗаписей = РегистрыНакопления.Лико_СебестоимостьЗаказов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаОчистка.Регистратор);
		НаборЗаписей.Записать(); 		  
	КонецЦикла;  
	
КонецПроцедуры 

Функция СформироватьЗапросЗаполненияЛико_СебестоимостьЗаказов(Период, Площадка, Партнер, Заказ, Регистратор) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыОрганизаций.Период КАК Период,
	|	ТоварыОрганизаций.Регистратор КАК Регистратор,
	|	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры КАК Заказ,
	|	ТоварыОрганизаций.ВидДвижения КАК ВидДвижения,
	|	СУММА(ТоварыОрганизаций.Количество) КАК Количество
	|ПОМЕСТИТЬ ВтВсеСборки
	|ИЗ
	|	РегистрНакопления.ТоварыОрганизаций КАК ТоварыОрганизаций
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Регистратор = НЕОПРЕДЕЛЕНО
	|				ТОГДА ТоварыОрганизаций.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|						И ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры.Площадка = &Площадка
	|			ИНАЧЕ ТоварыОрганизаций.Регистратор = &Регистратор
	|		КОНЕЦ
	|	И ТоварыОрганизаций.Регистратор ССЫЛКА Документ.СборкаТоваров
	|	И ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Номенклатура.ВидНоменклатуры.Лико_НоменклатураЭтикеток
	|	И ВЫБОР
	|			КОГДА &Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры = &Заказ
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры.Партнер = &Партнер
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыОрганизаций.Период,
	|	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры,
	|	ТоварыОрганизаций.Регистратор,
	|	ТоварыОрганизаций.ВидДвижения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВыручкаИСебестоимостьПродаж.Период КАК Период,
	|	ВыручкаИСебестоимостьПродаж.Регистратор КАК Регистратор,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ВЫБОР
	|		КОГДА ВыручкаИСебестоимостьПродаж.Регистратор ССЫЛКА Документ.ОтчетДавальцу
	|			ТОГДА ВыручкаИСебестоимостьПродаж.Регистратор.ЗаказДавальца.Лико_ЗаказКлиента
	|		ИНАЧЕ ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры
	|	КОНЕЦ КАК Заказ,
	|	СУММА(ВыручкаИСебестоимостьПродаж.Количество) КАК Количество,
	|	ВЫБОР
	|		КОГДА ВыручкаИСебестоимостьПродаж.Регистратор ССЫЛКА Документ.ОтчетДавальцу
	|			ТОГДА 1
	|		КОГДА ВыручкаИСебестоимостьПродаж.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ТОГДА 5
	|		КОГДА ВыручкаИСебестоимостьПродаж.Регистратор ССЫЛКА Документ.ВозвратТоваровОтКлиента
	|			ТОГДА 2
	|		КОГДА ВыручкаИСебестоимостьПродаж.Регистратор ССЫЛКА Документ.КорректировкаРеализации
	|			ТОГДА 3
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ТипПорядокДокумента
	|ПОМЕСТИТЬ ВтДокументы
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК ВыручкаИСебестоимостьПродаж
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры.ДополнительныеРеквизиты КАК ПартнерыДополнительныеРеквизиты
	|		ПО ВыручкаИСебестоимостьПродаж.АналитикаУчетаПоПартнерам.Партнер = ПартнерыДополнительныеРеквизиты.Ссылка
	|			И (ПартнерыДополнительныеРеквизиты.Свойство.Имя = ""Лико_СобственнаяОрганизация"")
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Регистратор = НЕОПРЕДЕЛЕНО
	|				ТОГДА ВыручкаИСебестоимостьПродаж.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|			ИНАЧЕ ВыручкаИСебестоимостьПродаж.Регистратор = &Регистратор
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА ВыручкаИСебестоимостьПродаж.Регистратор ССЫЛКА Документ.ОтчетДавальцу
	|				ТОГДА ВЫБОР
	|						КОГДА &Регистратор = НЕОПРЕДЕЛЕНО
	|							ТОГДА ВыручкаИСебестоимостьПродаж.Регистратор.ЗаказДавальца.Лико_ЗаказКлиента.Площадка = &Площадка
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|			ИНАЧЕ ПартнерыДополнительныеРеквизиты.Значение ЕСТЬ NULL
	|					И ВЫБОР
	|						КОГДА &Регистратор = НЕОПРЕДЕЛЕНО
	|							ТОГДА ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры.Площадка = &Площадка
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Номенклатура.ВидНоменклатуры.Лико_НоменклатураЭтикеток
	|		КОНЕЦ
	|	И (ВыручкаИСебестоимостьПродаж.Регистратор ССЫЛКА Документ.ОтчетДавальцу
	|			ИЛИ ВыручкаИСебестоимостьПродаж.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ИЛИ ВыручкаИСебестоимостьПродаж.Регистратор ССЫЛКА Документ.ВозвратТоваровОтКлиента
	|			ИЛИ ВыручкаИСебестоимостьПродаж.Регистратор ССЫЛКА Документ.КорректировкаРеализации)
	|	И ВЫБОР
	|			КОГДА &Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры = &Заказ
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры.Партнер = &Партнер
	|		КОНЕЦ
	|	И ВыручкаИСебестоимостьПродаж.Количество <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыручкаИСебестоимостьПродаж.Период,
	|	ВыручкаИСебестоимостьПродаж.Регистратор,
	|	ВЫБОР
	|		КОГДА ВыручкаИСебестоимостьПродаж.Регистратор ССЫЛКА Документ.ОтчетДавальцу
	|			ТОГДА ВыручкаИСебестоимостьПродаж.Регистратор.ЗаказДавальца.Лико_ЗаказКлиента
	|		ИНАЧЕ ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры
	|	КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТоварыОрганизаций.Период,
	|	ТоварыОрганизаций.Регистратор,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры,
	|	СУММА(ТоварыОрганизаций.Количество),
	|	6
	|ИЗ
	|	РегистрНакопления.ТоварыОрганизаций КАК ТоварыОрганизаций
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Регистратор = НЕОПРЕДЕЛЕНО
	|				ТОГДА ТоварыОрганизаций.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|						И ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры.Площадка = &Площадка
	|			ИНАЧЕ ТоварыОрганизаций.Регистратор = &Регистратор
	|		КОНЕЦ
	|	И ТоварыОрганизаций.Регистратор ССЫЛКА Документ.ВнутреннееПотребление
	|	И ТоварыОрганизаций.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Номенклатура.ВидНоменклатуры.Лико_НоменклатураЭтикеток
	|	И ВЫБОР
	|			КОГДА &Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры = &Заказ
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры.Партнер = &Партнер
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыОрганизаций.Период,
	|	ТоварыОрганизаций.Регистратор,
	|	ТоварыОрганизаций.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВтВсеСборки.Период,
	|	ВтВсеСборки.Регистратор,
	|	ВтВсеСборки.ВидДвижения,
	|	ВтВсеСборки.Заказ,
	|	ВтВсеСборки.Количество,
	|	4
	|ИЗ
	|	ВтВсеСборки КАК ВтВсеСборки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВтДокументы.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВТЗаказыДляОстатков
	|ИЗ
	|	ВтДокументы КАК ВтДокументы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
