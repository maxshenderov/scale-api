Функция СформироватьСоответствиеЗаказыОстаткиДляЗаполненияЛико_СебестоимостьЗаказов(Пакет, МассивИменРесурсов)	
	
	Соответствие = Новый Соответствие;
	
	ВыборкаЗаказ=Пакет.Выбрать();
	
	Пока ВыборкаЗаказ.Следующий() Цикл 		
		Заказ=ВыборкаЗаказ.Заказ;
		Соответствие.Вставить(Заказ);  
		Остатки = Новый Структура;
		Для каждого ТекИмяРесурса из МассивИменРесурсов Цикл
			Остатки.Вставить(ТекИмяРесурса, ВыборкаЗаказ[ТекИмяРесурса]);
		КонецЦикла;		
		Соответствие[Заказ]=Остатки;
	КонецЦикла;	
	
	Возврат Соответствие;
	
КонецФункции 

Функция СформироватьСоответствиеСборокДляЗаполненияЛико_СебестоимостьЗаказов(Пакет)
	
	Соответствие = Новый Соответствие;
	
	ВыборкаРегистратор=Пакет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРегистратор.Следующий() Цикл
		МассивСтруктур = Новый Массив;
		ВыборкаЗаказ = ВыборкаРегистратор.Выбрать();
		Пока ВыборкаЗаказ.Следующий() Цикл
			СтруктураСборки = Новый Структура("Период,Заказ,Количество,ВидДвижения");
			ЗаполнитьЗначенияСвойств(СтруктураСборки, ВыборкаЗаказ);
			МассивСтруктур.Добавить(СтруктураСборки);
		КонецЦикла;
		
		Соответствие.Вставить(ВыборкаРегистратор.Регистратор, МассивСтруктур);
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

Процедура РаспределитьНаПартииЛико_СебестоимостьЗаказов(ПакетДоки, СооЗаказыОстатки, СооСборок, МассивИменРесурсов, СооЗаказыВыпуски)
	
	ВыборкаРегистратор				=ПакетДоки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	 
	ВсегоДокументов					=ВыборкаРегистратор.Количество();
	КоличествоДокументов			=0;
	
	ОдинЗаказВСборке = Ложь;
	// ТипПорядокДокумента. Служит для 2 целей: 1) сортировка в пределах одной секунды, 2) отбор по типу документа/
	// 1 - ОтчетДавальцу
	// 2 - Возврат
	// 3 - Корректировка
	// 4 - Сборка
	// 5 - Реализация
	// 6 - ВнутреннееПотребление
	Пока ВыборкаРегистратор.Следующий() Цикл
		
		Регистратор=ВыборкаРегистратор.Регистратор; 
		НаборЗаписей = РегистрыНакопления.Лико_СебестоимостьЗаказов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);	
		НаборЗаписей.Прочитать();   
		
		Если ВыборкаРегистратор.ТипПорядокДокумента = 4 Тогда // Сборки
			МассивЗаказовВСборке = СооСборок[ВыборкаРегистратор.Регистратор];
			Если МассивЗаказовВСборке.Количество() < 2 Тогда
				Если (ВыборкаРегистратор.Регистратор.Номер = "ЛК00-006761" И Год(ВыборкаРегистратор.Регистратор.Дата) = 2021)
					ИЛИ (ВыборкаРегистратор.Регистратор.Номер = "ОК00-000001" И Год(ВыборкаРегистратор.Регистратор.Дата) = 2022)
					ИЛИ (ВыборкаРегистратор.Регистратор.Номер = "ОК000000025" И Год(ВыборкаРегистратор.Регистратор.Дата) = 2018)
					ИЛИ (ВыборкаРегистратор.Регистратор.Номер = "ОК000000045" И Год(ВыборкаРегистратор.Регистратор.Дата) = 2018)
					Тогда
					// Это исключительный документ, по нему не будем ничего делать
					Продолжить;
				Иначе
					ОтменитьТранзакцию();
					ВызватьИсключение "Непредвиденная ситуация. В массиве ""МассивЗаказовВСборке"" меньше 2 строк. Регистратор " + ВыборкаРегистратор.Регистратор;
				КонецЕсли;
				// Код для > 2 отрабатывает аналогично, поэтому = 2 закомментим	
				//ИначеЕсли МассивЗаказовВСборке.Количество() = 2 Тогда
				//	Если МассивЗаказовВСборке[0].Заказ = МассивЗаказовВСборке[1].Заказ Тогда
				//		Если МассивЗаказовВСборке[0].Количество = МассивЗаказовВСборке[1].Количество Тогда
				//			// Одинаковый заказ и одинаковое количество, ничего не делаем
				//			Продолжить;
				//		Иначе
				//			// Одинаковый заказ, но разное количество
				//			// Найдем разность количеств. На первом месте у нас всегда приход
				//			КоличествоРезультат = МассивЗаказовВСборке[0].Количество - МассивЗаказовВСборке[1].Количество;
				//			Если КоличествоРезультат > 0 Тогда
				//				ВидДвижения = ВидДвиженияНакопления.Приход;
				//			Иначе
				//				ВидДвижения = ВидДвиженияНакопления.Расход;
				//				КоличествоРезультат = КоличествоРезультат * -1;
				//			КонецЕсли;
				//			
				//			ТекСтруктураЗаказа = МассивЗаказовВСборке[0];
				//			ТекСтруктураЗаказа.ВидДвижения = ВидДвижения;
				//			ТекСтруктураЗаказа.Количество = КоличествоРезультат; 
				//			СделатьЗаписьПоСборке(СооЗаказыОстатки, ТекСтруктураЗаказа, НаборЗаписей, ВыборкаРегистратор);
				//		КонецЕсли;
				//	Иначе
				//		// Разные заказы
				//		Для каждого ТекСтруктураЗаказа из МассивЗаказовВСборке Цикл
				//			СделатьЗаписьПоСборке(СооЗаказыОстатки, ТекСтруктураЗаказа, НаборЗаписей, ВыборкаРегистратор);
				//		КонецЦикла;				
				//	КонецЕсли;
			Иначе
				// С сборке несколько заказов
				// Сначала нужно проверить, есть ли в сборке повторяющие заказы (расход и приход одного). Если есть, то такие заказы нужно привести к одной строке
				Для каждого ТекСтруктураЗаказа из МассивЗаказовВСборке Цикл
					ТекМассивПовторов = Новый Массив;
					Для каждого ТекСтруктураЗаказа2 из МассивЗаказовВСборке Цикл
						Если ТекСтруктураЗаказа.Заказ = ТекСтруктураЗаказа2.Заказ Тогда
							ТекМассивПовторов.Добавить(ТекСтруктураЗаказа2);
						КонецЕсли;
					КонецЦикла;
					Если ТекМассивПовторов.Количество() > 2 Тогда
						ОтменитьТранзакцию();
						ВызватьИсключение "Непредвиденная ситуация. В массиве ""ТекМассивПовторов"" больше 2 строк. Регистратор " + ВыборкаРегистратор.Регистратор;
					ИначеЕсли ТекМассивПовторов.Количество() = 2 Тогда
						// Найдем разность строк. На первом месте всегда приход
						КоличествоРезультат = ТекМассивПовторов[0].Количество - ТекМассивПовторов[1].Количество;
						Если КоличествоРезультат = 0 Тогда
							// Одинаковое количество по одному заказу. Такая запись нам не нужна. Удаляем обе строки
							МассивЗаказовВСборке.Удалить(МассивЗаказовВСборке.Найти(ТекМассивПовторов[1]));
							МассивЗаказовВСборке.Удалить(МассивЗаказовВСборке.Найти(ТекМассивПовторов[0]));
							// Дальше искать не будем, т.к. в массиве может быть только 1 такой случай
							Прервать;
						ИначеЕсли КоличествоРезультат > 0 Тогда
							ТекСтруктураЗаказа.ВидДвижения = ВидДвиженияНакопления.Приход;
							ТекСтруктураЗаказа.Количество = КоличествоРезультат;
						Иначе
							ТекСтруктураЗаказа.ВидДвижения = ВидДвиженияНакопления.Расход;
							ТекСтруктураЗаказа.Количество = КоличествоРезультат * -1;
						КонецЕсли;
						// Первую строку скорректировли выше. Вторую удалим
						МассивЗаказовВСборке.Удалить(МассивЗаказовВСборке.Найти(ТекМассивПовторов[1]));
						// Дальше искать не будем, т.к. в массиве может быть только 1 такой случай
						Прервать;
					КонецЕсли;
				КонецЦикла;
				// Теперь просто сформируем записи как обычно для оставшихся строк
				Для каждого ТекСтруктураЗаказа из МассивЗаказовВСборке Цикл
					ЗаказОстаток = СооЗаказыОстатки.Получить(ТекСтруктураЗаказа.Заказ);
					Если ЗаказОстаток = Неопределено ИЛИ ЗаказОстаток.Количество <= 0 Тогда
						Продолжить;;
					Иначе
						Запись                  = НаборЗаписей.Добавить();
						Запись.Период           = ВыборкаРегистратор.Период; 
						Запись.Регистратор      = ВыборкаРегистратор.Регистратор; 
						Запись.Заказ            = ТекСтруктураЗаказа.Заказ;
						Запись.ВидДвижения 		= ТекСтруктураЗаказа.ВидДвижения;
						Если Запись.ВидДвижения = ВидДвиженияНакопления.Расход Тогда
							// Расход
							Если ЗаказОстаток.Количество = ТекСтруктураЗаказа.Количество Тогда
								// После сборки ничего не останется. Списываем все ресурсы полностью
								ЗаполнитьЗначенияСвойств(Запись, ЗаказОстаток);
								СооЗаказыОстатки.Удалить(ТекСтруктураЗаказа.Заказ);
							Иначе
								// После сборки что-то останется. Списываем только количество. Остальные ресурсы пусть списываются следующим расходом
								Запись.Количество = Мин(ТекСтруктураЗаказа.Количество, ЗаказОстаток.Количество);
								ЗаказОстаток.Количество = ЗаказОстаток.Количество - Запись.Количество;
							КонецЕсли;
						Иначе
							// Приход
							// Просто оприходуем количество
							Запись.Количество = ТекСтруктураЗаказа.Количество; 
							ЗаказОстаток.Количество = ЗаказОстаток.Количество + Запись.Количество;
						КонецЕсли;
						
						Попытка
							НаборЗаписей.Записать();   
						Исключение
							Сообщить(ВыборкаРегистратор.Регистратор);
							ОтменитьТранзакцию();
							ВызватьИсключение ОписаниеОшибки();
						КонецПопытки;
					КонецЕсли; 
				КонецЦикла;				
			КонецЕсли;		
			
			Продолжить;
		КОнецЕсли; 
		
		Выборка=ВыборкаРегистратор.Выбрать();		
		Пока Выборка.Следующий() Цикл    
			Списать	= 0; 
			Остаток = 0;
			Заказ = Выборка.Заказ;
			ЗаказОстаток = СооЗаказыОстатки.Получить(Заказ);
			
			Если ВыборкаРегистратор.ТипПорядокДокумента = 2 ИЛИ ВыборкаРегистратор.ТипПорядокДокумента = 3 Тогда // Возвраты и корректировки
				Если Выборка.ЗаказМетражКВМ < 2000 Тогда
					// По таким заказам возвраты не пишем
					Продолжить;
				КонецЕсли;

				ЗаказВыпуск = СооЗаказыВыпуски.Получить(Заказ);
				Если ЗаказВыпуск = Неопределено Тогда
					// По заказу нет выпуска
					Продолжить;
				КонецЕсли; 
				Если ЗаказОстаток = Неопределено Тогда
					// Остатков нет в соответствии. Добавим
					СооЗаказыОстатки.Вставить(Заказ);
					Остатки = Новый Структура;
					Для каждого ТекИмяРесурса из МассивИменРесурсов Цикл
						Остатки.Вставить(ТекИмяРесурса, 0);
					КонецЦикла;
					СооЗаказыОстатки[Заказ]=Остатки;
					ЗаказОстаток = СооЗаказыОстатки.Получить(Заказ); 
				КонецЕсли;
				
				Запись = НаборЗаписей.Добавить();
				Запись.Период = ВыборкаРегистратор.Период;
				Запись.Регистратор = Регистратор;
				Запись.ВидДвижения = Выборка.ВидДвижения;
				Запись.Заказ = Заказ;
				Запись.Количество = Выборка.Количество;
				Коэффициент = Запись.Количество / ЗаказВыпуск.Количество;
				ЗаказОстаток.Количество	= ЗаказОстаток.Количество - Запись.Количество;
				Для каждого ТекИмяРесурса из МассивИменРесурсов Цикл
					Если ТекИмяРесурса = "Количество" Тогда
						Продолжить;
					КонецЕсли;
					Запись[ТекИмяРесурса] = ЗаказВыпуск[ТекИмяРесурса] * Коэффициент;
					ЗаказОстаток[ТекИмяРесурса] = ЗаказОстаток[ТекИмяРесурса] - Запись[ТекИмяРесурса];
				КонецЦикла;
				
			Иначе // Реализации, списания
				
				Если ЗаказОстаток = Неопределено ИЛИ ЗаказОстаток.Количество = 0 Тогда
					Продолжить;
				Иначе
					Остаток = ЗаказОстаток.Количество;
					//Затраты моги быть позже выпуска, например, транспорт, списываем без количества
					Если Остаток > 0 Тогда
						//Если заказано меньше 2000 м2 списываем все затраты сразу
						Если Выборка.Количество < Остаток Тогда    
							Если Выборка.ЗаказМетражКВМ < 2000 Тогда 
								Списать = Остаток;
							Иначе
								Списать = Выборка.Количество;
							КонецЕсли;
						Иначе   
							Списать = Остаток;
						КонецЕсли;
					КонецЕсли;
					Запись                  = НаборЗаписей.Добавить();
					Запись.Период           = ВыборкаРегистратор.Период; 
					Запись.Регистратор      = Регистратор; 
					Запись.ВидДвижения      = Выборка.ВидДвижения;
					Запись.Заказ            = Заказ; 
					Если Остаток = Списать Тогда 
						ЗаполнитьЗначенияСвойств(Запись,СооЗаказыОстатки[Заказ]);
						СооЗаказыОстатки.Удалить(Заказ);
					Иначе
						Запись.Количество		= Мин(Списать,Остаток); 
						Коэффициент				= Запись.Количество/Остаток;
						ЗаказОстаток.Количество	= ЗаказОстаток.Количество - Запись.Количество;
						
						Для каждого ТекИмяРесурса из МассивИменРесурсов Цикл
							Если ТекИмяРесурса = "Количество" Тогда
								Продолжить;
							КонецЕсли;
							Запись[ТекИмяРесурса] = ЗаказОстаток[ТекИмяРесурса] * Коэффициент;
							ЗаказОстаток[ТекИмяРесурса] = ЗаказОстаток[ТекИмяРесурса] - Запись[ТекИмяРесурса];
						КонецЦикла;
					КонецЕсли;	
				КонецЕсли; 
			КонецЕсли; 
		КонецЦикла;   
		
		Попытка
			НаборЗаписей.Записать();   
		Исключение
			Сообщить(ВыборкаРегистратор.Регистратор);
			ОтменитьТранзакцию();
			ВызватьИсключение ОписаниеОшибки();
		КонецПопытки;
		
	КонецЦикла;	
	
КонецПроцедуры
#КонецОбласти