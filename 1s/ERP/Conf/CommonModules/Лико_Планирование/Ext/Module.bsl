	iConf.fields(cdoSMTPUseSSL).value         = 0;  //Secure Sockets Layer
	// --> Начало Лико Ефимов ЕВВ 02.06.2017
	cdoSMTPConnectionTimeout                = "http://schemas.microsoft.com/cdo/configuration/smtpconnectiontimeout";
	iConf.fields(cdoSMTPConnectionTimeout).value         = 45;
	// <-- Конец Лико Ефимов ЕВВ 02.06.2017
	iConf.fields.update();            

	iMsg=новый COMОбъект("CDO.Message"); // createObject("CDO.Message");
	iMsg.configuration = iConf; 

	iMsg.to                                =sTo;
	iMsg.from                          =sFrom;
	iMsg.subject     =Тема; 
	iMsg.Sender      = Отправитель;
	// --> Начало Лико Ефимов ЕВВ 15.04.2025
	//iMsg.BodyPart.Charset= "koi8-r"; 
	iMsg.BodyPart.Charset= "utf-8";
	// <-- Конец Лико Ефимов ЕВВ 15.04.2025
	Если ВложениеПисьма<> Неопределено Тогда
		// <-- Начало Лико Яцун С. В.
		//iMsg.AddAttachment(ВложениеПисьма);
		Если ТипЗнч(ВложениеПисьма) = Тип("СписокЗначений") Тогда
			Для Каждого ПутьКВложению Из ВложениеПисьма Цикл
				ТекФайл = Новый Файл(ПутьКВложению.Значение); // --> Начало Лико Ефимов ЕВВ 05.04.2023 дописал проверку существования файла
				Если ТекФайл.Существует() Тогда
					iMsg.AddAttachment(ПутьКВложению.Значение);
				КонецЕсли;
			КонецЦикла;
		Иначе		
			ТекФайл = Новый Файл(ВложениеПисьма);
			Если ТекФайл.Существует() Тогда
				iMsg.AddAttachment(ВложениеПисьма);
			КонецЕсли;
		КонецЕсли;
		// <-- Конец Лико Яцун С. В.
	КонецЕсли;

	Если ТипТекста="htmlBody" Тогда 
		iMsg.htmlBody=  Текст;
	Иначе
		iMsg[ТипТекста]= Текст;
	КонецЕсли;

	#Если Сервер Тогда
		КоличествоПопыток = 1;
	#КонецЕсли
	ПроизвестиОтправкуСформированногоПисьма(iMsg, КоличествоПопыток, ИнтервалМеждуПопыткамиСек,,,ВыводитьСообщение);
	// <-- Конец Лико Ефимов ЕВВ 02.06.2017

КонецПроцедуры

Функция ПроизвестиОтправкуСформированногоПисьма(iMsg, КоличествоПопыток = 1, ИнтервалМеждуПопыткамиСек = 0, ТекущаяПопытка = 1, ВремяПредыдущейПопытки = Неопределено, ВыводитьСообщение) // --> Начало Лико Ефимов ЕВВ 02.06.2017 
	
	Если ТекущаяПопытка > КоличествоПопыток Тогда
		Возврат Ложь;
	Иначе
		Если НЕ ТекущаяПопытка = 1 Тогда
			//ждем
			Пока ВремяПредыдущейПопытки + ИнтервалМеждуПопыткамиСек >= ТекущаяДата() Цикл
			КонецЦикла;
		КонецЕсли;
		Попытка
			iMsg.send();
			Если ВыводитьСообщение Тогда
				Сообщить("Сообщение отправлено (с " + ТекущаяПопытка + " попытки).");
			КонецЕсли;
			Возврат Истина;
		Исключение
			Если ПроизвестиОтправкуСформированногоПисьма(iMsg, КоличествоПопыток, ИнтервалМеждуПопыткамиСек, ТекущаяПопытка + 1, ТекущаяДата(), ВыводитьСообщение) Тогда
				Возврат Истина;
			Иначе
				#Если Клиент Тогда
					Если ВыводитьСообщение Тогда
						Сообщить("Сообщение не отправлено! Количество попыток = " + КоличествоПопыток + ". Описание последней ошибки: " + ОписаниеОшибки());
					КонецЕсли;
				#КонецЕсли
				Возврат Истина;
			КонецЕсли;			
		КонецПопытки;
	КонецЕсли;
	
КонецФункции // <-- Конец Лико Ефимов ЕВВ 02.06.2017 

