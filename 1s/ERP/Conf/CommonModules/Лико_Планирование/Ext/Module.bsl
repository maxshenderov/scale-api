Функция НайтиСоздатьДоговорПереработчикаДавальца(Организация, Контрагент, тип)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Организация = &Организация
	|	И ДоговорыКонтрагентов.Контрагент = &Контрагент
	|	И ДоговорыКонтрагентов.ТипДоговора = &Тип
	|	И ДоговорыКонтрагентов.Лико_ЭтоРеальныйДоговор = ЛОЖЬ";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Тип", тип);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Если ЗначениеЗаполнено(Результат.Ссылка) Тогда 
		Возврат Результат.Ссылка;
	Иначе
		ДоговорОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		ДоговорОбъект.Организация = Организация;
		ДоговорОбъект.Контрагент = Контрагент;
		ДоговорОбъект.ТипДоговора = тип;
		ДоговорОбъект.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("978");
		ДоговорОбъект.Наименование = "Для переработки";
		ДоговорОбъект.НаименованиеДляПечати = "Для переработки";
		ДоговорОбъект.ПорядокРасчетов =  Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
		ДоговорОбъект.Статус	= Перечисления.СтатусыДоговоровКонтрагентов.Действует;
		ДоговорОбъект.Записать();
		Возврат ДоговорОбъект.Ссылка;
	КонецЕсли;	
КонецФункции

//Процедура перекидывает заказ на следующий этап
Процедура ПеренестиЗаказ(Заказ, Этап, РабочийЦентр = Неопределено, НомерБланка = Неопределено, Количество = Неопределено, ПричинаБлокировки = Неопределено, ОбработкаЭтапа = Ложь)	Экспорт
	Площадка = Заказ.Площадка;
	Ответственный = Пользователи.ТекущийПользователь();
	Запись = РегистрыСведений.Лико_ЭтапыЗаказа.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДата();
	Запись.Заказ =Заказ;
	Запись.Этап = Этап;
	Запись.Площадка =  Площадка; 
	
	Если ОбработкаЭтапа Тогда  
		Запись.ДатаОбработкиЭтапа = ТекущаяДата();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерБланка) Тогда 
		Запись.НомерБланка = НомерБланка;
	Иначе	
		Запись.НомерБланка = 1;
	КонецЕсли;
	Если ЗначениеЗаполнено(РабочийЦентр) Тогда 
		Запись.РабочийЦентр = РабочийЦентр;
	КонецЕсли;
	
	
	//Если Площадка Икс-Пак, а пользователь из группы Препресс, заменяем его на Саляхова
	Если Площадка = Справочники.Лико_Площадки.ИксПак Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГруппыПользователейСостав.Пользователь КАК Пользователь
		|ИЗ
		|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
		|ГДЕ
		|	ГруппыПользователейСостав.Ссылка.Наименование = ""Препресс""
		|	И ГруппыПользователейСостав.Пользователь = &Пользователь";
		Запрос.УстановитьПараметр("Пользователь", Ответственный);
		Результат = Запрос.Выполнить().Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.Пользователь) Тогда 
			Запись.Ответственный = Справочники.Пользователи.НайтиПоНаименованию("Саляхов Рамиль");
		Иначе	
			Запись.Ответственный = Ответственный;
		КонецЕсли;
	Иначе 
		Запись.Ответственный = Ответственный;

	КонецЕсли;
	
	Если ЗначениеЗаполнено(Количество) Тогда 
		Запись.Количество = Количество;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПричинаБлокировки) Тогда 
		Запись.ПричинаБлокировки = ПричинаБлокировки;
	КонецЕсли;
	
	Запись.Записать();
	
	Если Заказ.Площадка = Справочники.Лико_Площадки.ИксПак Тогда 
		Если Этап =  Справочники.Лико_ЭтапыВыполненияЗаказа.ОПП Тогда 
			Текст = "Заказ "+ Заказ.НомерБезПрефикса  +" "+Заказ.ВидЗаказа+" "+" передан на ОПП";
			Тема =  Текст;
			АдресРассылки = УправлениеСвойствами.ЗначениеСвойства(Заказ.Площадка.Организация, "АдресОПП");
			ОтправитьПисьмо(текст, Тема,  АдресРассылки);	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

Функция ОпределитьЭтап(Заказ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Лико_ЭтапыЗаказаСрезПоследних.Этап, ЗНАЧЕНИЕ(Справочник.Лико_ЭтапыВыполненияЗаказа.ПустаяСсылка)) КАК Этап
	|ИЗ
	|	РегистрСведений.Лико_ЭтапыЗаказа.СрезПоследних(
	|			,
	|			Заказ = &Заказ
	|				И Площадка = &Площадка) КАК Лико_ЭтапыЗаказаСрезПоследних";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Площадка", Заказ.Площадка);
	
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Возврат(Результат.Этап);
	
КонецФункции


Процедура АннулироватьЗаказ(Заказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	ЗаказОбъект = Заказ.ПолучитьОбъект();
	Запрос= Новый Запрос;
	Запрос.Текст = 
