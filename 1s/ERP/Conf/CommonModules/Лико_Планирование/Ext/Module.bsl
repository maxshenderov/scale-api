Функция ЕстьЭтапыНеДоПечати(Заказ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиента.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ЕСТЬNULL(ВЫБОР
	|				КОГДА Лико_ЭтапыЗаказа.Этап.ДоПечати
	|					ТОГДА ЛОЖЬ
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ, ЛОЖЬ)) КАК Этап
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЭтапыЗаказа КАК Лико_ЭтапыЗаказа
	|		ПО ЗаказКлиента.Ссылка = Лико_ЭтапыЗаказа.Заказ
	|ГДЕ
	|	Лико_ЭтапыЗаказа.Заказ = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиента.Ссылка";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = Запрос.Выполнить().Выбрать();
		Результат.Следующий();  
		Возврат Результат.Этап;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура Лико_ПередЗаписьюНоменклатурыПередЗаписью(Источник, Отказ) Экспорт
	Тип = "";
	числосимволов = 0;
	Если Источник.ВидНоменклатуры.Лико_НоменклатураЭтикеток = Истина Тогда
		// --> Начало Лико Ефимов ЕВВ 14.02.2018 
		Если НЕ ЗначениеЗаполнено(Источник.Лико_ТипЭтикетки) Тогда
			Сообщить("Не заполнен Тип этикетки.");
			Отказ = Истина;
		КонецЕсли;
		// <-- Конец Лико Ефимов ЕВВ 14.02.2018
		
		// --> Начало Лико Ефимов ЕВВ 21.06.2021
		// Сделаем универсально
		
