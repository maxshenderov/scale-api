Функция ВЗаказеПлоскоеТиснениеИКонгревВОдномПрокате(Заказ)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказКлиентаВидыРабот.Ссылка КАК Ссылка,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиентаВидыРабот.ВидРабот) КАК ВидРабот,
	               |	ЗаказКлиентаВидыРабот.НомерПроката КАК НомерПроката
	               |ИЗ
	               |	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	               |ГДЕ
	               |	(ЗаказКлиентаВидыРабот.ВидРабот = &ВидРабот1
	               |			ИЛИ ЗаказКлиентаВидыРабот.ВидРабот = &ВидРабот2)
	               |	И ЗаказКлиентаВидыРабот.Ссылка = &Ссылка
	               |	И ЗаказКлиентаВидыРабот.РабочийЦентр В(&РабочиеЦентры)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказКлиентаВидыРабот.Ссылка,
	               |	ЗаказКлиентаВидыРабот.НомерПроката
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиентаВидыРабот.ВидРабот) > 1";
	РабочиеЦентры = Новый Массив;
	РабочиеЦентры.Добавить(Справочники.РабочиеЦентры.НайтиПоРеквизиту("ПорядковыйНомер",1));
	РабочиеЦентры.Добавить(Справочники.РабочиеЦентры.НайтиПоРеквизиту("ПорядковыйНомер",21));
	РабочиеЦентры.Добавить(Справочники.РабочиеЦентры.НайтиПоРеквизиту("ПорядковыйНомер",24));
	РабочиеЦентры.Добавить(Справочники.РабочиеЦентры.НайтиПоРеквизиту("ПорядковыйНомер",28));
	РабочиеЦентры.Добавить(Справочники.РабочиеЦентры.НайтиПоРеквизиту("ПорядковыйНомер",29));
	РабочиеЦентры.Добавить(Справочники.РабочиеЦентры.НайтиПоРеквизиту("ПорядковыйНомер",9));
	Запрос.УстановитьПараметр("Ссылка", Заказ);
	Запрос.УстановитьПараметр("РабочиеЦентры", РабочиеЦентры);
	Запрос.УстановитьПараметр("ВидРабот1", Справочники.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПродольное);
	Запрос.УстановитьПараметр("ВидРабот2", Справочники.ВидыРаботСотрудников.Конгрев);	
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество()>0 Тогда
		Возврат Истина
	Иначе
		Возврат Ложь;
	КонецЕсли;

