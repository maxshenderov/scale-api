Процедура ОтправитьПисьмоДизайнеру(Заказ) Экспорт
	Если  ЗначениеЗаполнено(Заказ.Дизайнер) Тогда 
		Получатель =  Заказ.Дизайнер;
	Иначе
		Получатель = Заказ.Менеджер;
	КонецЕсли;
	
	Если Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Получатель, "РассылкаФайлНаПрепресс",Ложь) Тогда
		Тема = Заказ.НомерБезПрефикса+ " " + Заказ.Этикетки+ " " + Заказ.Артикулы;
		Текст = Тема +"
		| В ответ на это письмо отправьте файл оригинал макета в Adobe illustrator на адрес prepress2@okil.ru ";
		ОтправитьПисьмо(текст, Тема, Получатель, "<prepress@okil.ru>"); 
	КонецЕсли;
КонецПроцедуры

Процедура ОтправитьУведомлениеОбОтправке(Заказ, АдресРассылки)  Экспорт
	Текст = "Заказ "+ Заказ.НомерБезПрефикса  +" "+Заказ.ВидЗаказа+" "+" направлен в работу <br>" +
	"Заказчик "+Заказ.Партнер.Наименование+"<br>";
	Для каждого стр из Заказ.Товары Цикл
		Текст = Текст + стр.номенклатура.Наименование+ " "+ стр.Количество+ " тыс. шт., Направление намотки:"+ стр.Направление+"<br>";
	КонецЦикла;	
	Текст = Текст+ "Основной материал: " + Заказ.ОсновнойМатериал.Наименование+ " "+ Заказ.ОсновнойМатериал.Код+"<br>";
	Для каждого стр из Заказ.ВидыРабот Цикл
		Если ЗначениеЗаполнено(стр.Материал) Тогда 
			Текст = Текст + "Дополнительный материал: "+ стр.материал.наименование + " "+ стр.материал.код+"<br>";
		КонецЕсли;	
	КонецЦикла;
	Тема =  "Заказ "+ Заказ.НомерБезПрефикса  + " "+ Заказ.Партнер.Наименование+ " направлен в работу";
	Лико_Планирование.ОтправитьПисьмо(текст, Тема,  АдресРассылки);


