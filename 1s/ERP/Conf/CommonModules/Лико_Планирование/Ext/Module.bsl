		|              ЗаказКлиентаОтгрузки.Ссылка.Площадка КАК Площадка
		|ИЗ
		|              Документ.ЗаказКлиента.Отгрузки КАК ЗаказКлиентаОтгрузки
		|ГДЕ
		|              ЗаказКлиентаОтгрузки.Ссылка = &Заказ
		|              И ЗаказКлиентаОтгрузки.Дата <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|              И НЕ ЗаказКлиентаОтгрузки.ДокументОтгрузки ССЫЛКА Документ.ВозвратТоваровОтКлиента
		|              И НЕ ЗаказКлиентаОтгрузки.ДокументОтгрузки ССЫЛКА Документ.КорректировкаРеализации
		|
		|УПОРЯДОЧИТЬ ПО
		|              ЗаказКлиентаОтгрузки.Дата";


		Запрос.УстановитьПараметр("Заказ", ЗаказКлиента);
		Запрос.УстановитьПараметр("ИксПак", Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра);
		Выборка = Запрос.Выполнить().Выбрать();
		ПОка ВЫборка.Следующий() Цикл
			//11.07.2019 - для Икс-Пака заполняем так же, как и для Ликофлекса
			//Если Выборка.Площадка = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра Тогда
			//            ЗаполнитьРегистрыЗатратНаОтгрузкуПоследнюю(ЗаказКлиента, выборка.КлючСтроки, Отказ);
			//Иначе              
			Если ЗначениеЗаполнено(Выборка.Настройка) Тогда 
				ЗаполнитьРегистрыЗатратНаОтгрузкуПоследнюю(ЗаказКлиента, выборка.КлючСтроки, Отказ);
			Иначе
				ЗаполнитьРегистрыЗатратНаОтгрузкуПоНормам(ЗаказКлиента, выборка.КлючСтроки, Отказ);
			КонецЕсли;                                       
			//КонецЕсли;

		КонецЦикла;    
		ТЗОтгрузкиСНарезкой = Новый ТаблицаЗначений;
		ЗаполнитьЗатратыПоОтгрузке(ЗаказКлиента);

		НаборЗаписейОтгрузки = РегистрыСведений.Лико_Отгрузки.СоздатьНаборЗаписей();
		НаборЗаписейОтгрузки.Отбор.Регистратор.Установить(Источник.Ссылка);
		НаборЗаписейОтгрузки .Записать();

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ЗатратыПоОтгрузке.ЗаказКлиента КАК ЗаказКлиента,
		|	Лико_ЗатратыПоОтгрузке.КлючСтроки КАК КлючСтроки,
		|	СУММА(Лико_ЗатратыПоОтгрузке.Количество) КАК Количество,
		|	СУММА(Лико_ЗатратыПоОтгрузке.КоличествоПМ) КАК КоличествоПМ
		|ПОМЕСТИТЬ ТЗФакт
		|ИЗ
		|	РегистрНакопления.Лико_ЗатратыПоОтгрузке КАК Лико_ЗатратыПоОтгрузке
		|ГДЕ
		|	Лико_ЗатратыПоОтгрузке.Регистратор = &Заказ
		|	И Лико_ЗатратыПоОтгрузке.СтатьяЗатрат = ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ОсновнойМатериал)
		|
		|СГРУППИРОВАТЬ ПО
		|	Лико_ЗатратыПоОтгрузке.ЗаказКлиента,
		|	Лико_ЗатратыПоОтгрузке.КлючСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказКлиентаОтгрузки.Ссылка КАК Заказ,
		|	ЗаказКлиентаОтгрузки.Дата КАК ДатаОтгрузки,
		|	ЗаказКлиентаОтгрузки.ДокументОтгрузки КАК Отгрузка,
		|	ЗаказКлиентаОтгрузки.КлючСтроки КАК КлючСтроки,
		|	ЗаказКлиентаОтгрузки.Стоимость КАК Стоимость,
		|	СУММА(Лико_ЗатратыПоОтгрузке.Сумма) КАК Себестоимость,
		|	ЗаказКлиентаОтгрузки.ВремяИзготовления КАК ВремяИзготовления,
		|	ЗаказКлиентаОтгрузки.Ссылка.Дата КАК Период,
		|	ЗаказКлиентаОтгрузки.КвадратныйМетраж КАК МетражКВМ,
		|	ЗаказКлиентаОтгрузки.Количество КАК Количество,
		|	ЗаказКлиентаОтгрузки.РабочийЦентр КАК РабочийЦентр,
		|	ЗаказКлиентаОтгрузки.Настройка КАК Настройка,
		|	ЗаказКлиентаОтгрузки.ПогонныйМетраж КАК МетражПМ,
		|	ЗаказКлиентаОтгрузки.КодПостпечатныхРабот КАК КодРабот,
		|	МАКСИМУМ(ЗаказКлиентаОтгрузки.КвадратныйМетраж) КАК КвадратныйМетраж,
		|	ЗаказКлиентаОтгрузки.КомментарийКОтгрузке КАК КомментарийКОтгрузке,
		|	ЗаказКлиентаОтгрузки.ОбщийМетраж КАК МетражПлан
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.ЗаказКлиента.Отгрузки КАК ЗаказКлиентаОтгрузки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ЗатратыПоОтгрузке КАК Лико_ЗатратыПоОтгрузке
		|		ПО ЗаказКлиентаОтгрузки.Ссылка = Лико_ЗатратыПоОтгрузке.ЗаказКлиента
		|			И ЗаказКлиентаОтгрузки.КлючСтроки = Лико_ЗатратыПоОтгрузке.КлючСтроки
		|ГДЕ
		|	ЗаказКлиентаОтгрузки.Ссылка = &Заказ
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаОтгрузки.Ссылка,
		|	ЗаказКлиентаОтгрузки.Дата,
		|	ЗаказКлиентаОтгрузки.ДокументОтгрузки,
		|	ЗаказКлиентаОтгрузки.КлючСтроки,
		|	ЗаказКлиентаОтгрузки.Стоимость,
		|	ЗаказКлиентаОтгрузки.ВремяИзготовления,
		|	ЗаказКлиентаОтгрузки.Ссылка.Дата,
		|	ЗаказКлиентаОтгрузки.КвадратныйМетраж,
		|	ЗаказКлиентаОтгрузки.РабочийЦентр,
		|	ЗаказКлиентаОтгрузки.Настройка,
		|	ЗаказКлиентаОтгрузки.ПогонныйМетраж,
		|	ЗаказКлиентаОтгрузки.КодПостпечатныхРабот,
		|	ЗаказКлиентаОтгрузки.Количество,
		|	ЗаказКлиентаОтгрузки.КомментарийКОтгрузке,
		|	ЗаказКлиентаОтгрузки.ОбщийМетраж
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Заказ КАК Заказ,
		|	ВТ.КлючСтроки КАК КлючСтроки,
		|	СУММА(ЕСТЬNULL(ЗаказКлиентаНормативы.ВремяПечати, 0) + ЕСТЬNULL(ЗаказКлиентаНормативы.ВремяНаНастройку, 0) + ЕСТЬNULL(ЗаказКлиентаНормативы.ВремяНаСменуРоликов / 60, 0)) КАК ВремяИзготовления,
		|	СУММА(ВЫБОР
		|			КОГДА ЗаказКлиентаНормативы.НомерПроката = 1
		|				ТОГДА ЕСТЬNULL(ЗаказКлиентаНормативы.ВремяПечати, 0) + ЕСТЬNULL(ЗаказКлиентаНормативы.ВремяНаНастройку, 0) + ЕСТЬNULL(ЗаказКлиентаНормативы.ВремяНаСменуРоликов / 60, 0)
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Время1РЦ,
		|	СУММА(ЗаказКлиентаНормативы.РабочийЦентр.Лико_КоэффициентУчетаВремени * (ЕСТЬNULL(ЗаказКлиентаНормативы.ВремяПечати, 0) + ЕСТЬNULL(ЗаказКлиентаНормативы.ВремяНаНастройку, 0) + ЕСТЬNULL(ЗаказКлиентаНормативы.ВремяНаСменуРоликов / 60, 0))) КАК ВремяУУ
		|ПОМЕСТИТЬ ВТВремя
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Нормативы КАК ЗаказКлиентаНормативы
		|		ПО ВТ.Заказ = ЗаказКлиентаНормативы.Ссылка
		|			И ВТ.КлючСтроки = ЗаказКлиентаНормативы.НомерОтгрузки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ.Заказ,
		|	ВТ.КлючСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Заказ КАК Заказ,
		|	ВТ.КлючСтроки КАК КлючСтроки,
