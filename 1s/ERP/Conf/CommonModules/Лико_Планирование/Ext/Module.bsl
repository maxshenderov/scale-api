Функция ПолучитьНомерДляЗаказа(Организация, типЗаказа, видЗаказа, Регион ) Экспорт
	
	
УстановитьПривилегированныйРежим(Истина);
	
	КодРегиона = Регион.КодРегиона;
	ПерваяЦифра = СокрЛП(КодРегиона);
	// <-- Начало Лико Яцун С. В. 26.12.2024 
	Если Регион = Справочники.БизнесРегионы.Линкс Тогда
		ПерваяЦифра = Сред(СокрЛП(КодРегиона),1,1);
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 26.12.2024
	ВтораяЦифра = Сред(Строка(ТекущаяДата()), 10,1);
	Если ЗначениеЗаполнено(ТипЗаказа) Тогда
		Если типЗаказа = Перечисления.Лико_ТипыЗаказов.ПолуфабрикатПодАппликатор Тогда
			ТретьяЦифра = "5"; // Такая же, как у обычного полуфабриката
		Иначе
			ТретьяЦифра = Строка(Перечисления.Лико_ТипыЗаказов.Индекс(ТипЗаказа));
		КонецЕсли;
	Иначе 	
		ТретьяЦифра = "1";
	КонецЕсли; 
	
	Если (ПерваяЦифра = "1"  ) И ТретьяЦифра = "1" Тогда    // ИЛИ ПерваяЦифра = "7" ИЛИ ПерваяЦифра = "9" 
		ТретьяЦифра = "6";
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ВидЗаказа) Тогда 
		Если ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Пробник Тогда 
			ТретьяЦифра = "9";
		ИначеЕсли 	ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПричинаРекламация Тогда 
			ТретьяЦифра = "7";
		ИначеЕсли 	ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка Тогда 
			ТретьяЦифра = "8";
		КонецЕсли;
	КонецЕсли;
	
	
	ПервыеЦифры = "00"+ Перваяцифра+ВтораяЦифра+ТретьяЦифра;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПОДСТРОКА(ЗаказКлиента.Номер, 5, 7) КАК Номер
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ПОДСТРОКА(ЗаказКлиента.Номер, 3, 5) = &ПрефиксСтарый
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер УБЫВ";
	
	// <-- Начало Лико Яцун С. В. 16.12.2024
	РегионЛинкс = Ложь;	
	Если Регион = Справочники.БизнесРегионы.Линкс Тогда
		РегионЛинкс = Истина;
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ПОДСТРОКА(ЗаказКлиента.Номер, 3, 5) = &ПрефиксСтарый","ПОДСТРОКА(ЗаказКлиента.Номер, 3, 5) = &ПрефиксСтарый И ПОДСТРОКА(ЗаказКлиента.Номер, 5, 7) ПОДОБНО ""___[2-9]___""");
		//ЧетвертаяЦифраМинимум = "2";
		//ПервыеЦифры	= ПервыеЦифры + ЧетвертаяЦифраМинимум;
	ИначеЕсли Регион = Справочники.БизнесРегионы.ВеликийНовгород Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ПОДСТРОКА(ЗаказКлиента.Номер, 3, 5) = &ПрефиксСтарый","ПОДСТРОКА(ЗаказКлиента.Номер, 3, 5) = &ПрефиксСтарый И НЕ ПОДСТРОКА(ЗаказКлиента.Номер, 5, 7) ПОДОБНО ""___[2-9]___""");
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 16.12.2024
	
	Запрос.УстановитьПараметр("ПрефиксСтарый", ПервыеЦифры);
	
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Если ЗначениеЗаполнено(Результат.Номер) Тогда 
		Номер = Организация.Префикс+"00"+Строка(Формат(Число(Результат.Номер ) +1, "ЧГ=0") );
	Иначе
		// <-- Начало Лико Яцун С. В. 16.12.2024
		//Номер = Организация.Префикс+ПервыеЦифры+"0001";
		Если РегионЛинкс Тогда
			Номер = Организация.Префикс+ПервыеЦифры+"2001";
		Иначе
			Номер = Организация.Префикс+ПервыеЦифры+"0001";
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 16.12.2024
	КонецЕсли;

	Возврат Номер;

КонецФункции	
	
Процедура Подписка_ПриУстановкеНовогоКода(Источник, СтандартнаяОбработка, Префикс) Экспорт
	ТипИсточника = ТипЗнч(Источник);
	
	Если ТипИсточника = Тип("СправочникОбъект.Лико_Формы") Тогда
		
		Если Источник.Сплошная Тогда
			// Для сплошных своя нумерация 0001
			СтандартнаяОбработка = Ложь;
		    УстановитьПривилегированныйРежим(Истина);
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Лико_Формы.Код КАК Код
				|ИЗ
				|	Справочник.Лико_Формы КАК Лико_Формы
				|ГДЕ
				|	Лико_Формы.Сплошная
				|
				|УПОРЯДОЧИТЬ ПО
				|	Код УБЫВ";
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				Источник.Код = Формат(Число(Выборка.Код)+1, "ЧЦ=4; ЧВН=; ЧГ=0"); 
			Иначе
				Источник.Код = "0001";
			КонецЕсли;
			// Проверим, чтобы такой код не был занят какой-то другой формой
			Для сч = 1 по 1000 Цикл
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ
					|	Лико_Формы.Ссылка КАК Ссылка
					|ИЗ
					|	Справочник.Лико_Формы КАК Лико_Формы
					|ГДЕ
					|	Лико_Формы.Код = &Код";
				
				Запрос.УстановитьПараметр("Код", Источник.Код);
				Если Запрос.Выполнить().Пустой() Тогда
					// Такого кода нет, отлично
					Прервать;
				Иначе
					// Такой код уже есть, прибавим 1
					Источник.Код = Формат(Число(Источник.Код)+1, "ЧЦ=4; ЧВН=; ЧГ=0");
				КонецЕсли;
			КонецЦикла;
		Иначе
			Если ЗначениеЗаполнено(Источник.Заказ) Тогда
				Префикс = Источник.Заказ.НомерБезПрефикса;						
				// --> Начало Лико Ефимов ЕВВ 29.07.2024
				// Код увеличен на 2 символа. Часть форм будет создаваться без этих двух символов в конце, а часть полностью
				// В связи с этим, номер теперь придется формировать вручную
				СтандартнаяОбработка = Ложь;
		       	УстановитьПривилегированныйРежим(Истина);
				Запрос = Новый Запрос("
					|ВЫБРАТЬ
					|	ПОДСТРОКА(Лико_Формы.Код, 8, 2) КАК ПорядковыйНомер
					|ИЗ
					|	Справочник.Лико_Формы КАК Лико_Формы
					|ГДЕ
					|	ПОДСТРОКА(Лико_Формы.Код, 1, 7) = &Префикс
					|
					|УПОРЯДОЧИТЬ ПО
					|	ПорядковыйНомер УБЫВ");
				Запрос.УстановитьПараметр("Префикс", Префикс);
				Выборка = Запрос.Выполнить().Выбрать();
				ПорядковыйНомер = "";
				Пока Выборка.Следующий() Цикл
					Попытка
						// если вдруг в Выборка.ПорядковыйНомер содержится не число, то уйдем в исключение и продолжим перебирать номера
						ПорядковыйНомер = Число(Выборка.ПорядковыйНомер) + 1;
						Прервать;
					Исключение
						Продолжить;
					КонецПопытки;
				КонецЦикла;
				
				Если НЕ ЗначениеЗаполнено(ПорядковыйНомер) Тогда
					ПорядковыйНомер = 1;
				КонецЕсли;
				Источник.Код = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Префикс, 7, "0", "Справа") + Формат(ПорядковыйНомер, "ЧЦ=2; ЧВН=");
				Если ЗначениеЗаполнено(Источник.ДистортФлексо) И ЗначениеЗаполнено(Источник.ВидПолимера) Тогда
					ПрефиксВидПолимера = Лев(СокрЛП(Источник.ВидПолимера.Префикс), 1);
					ПрефиксДисторт = Источник.ДистортФлексо.Префикс;
					Если ЗначениеЗаполнено(ПрефиксВидПолимера) И ЗначениеЗаполнено(ПрефиксДисторт) Тогда
						// Дополняем номер
						Источник.Код = Источник.Код + ПрефиксВидПолимера + ПрефиксДисторт;
					КонецЕсли;
				КонецЕсли;
				// <-- Конец Лико Ефимов ЕВВ 29.07.2024
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипИсточника = Тип("СправочникОбъект.Номенклатура") Тогда
		Если Источник.ВидНоменклатуры.Лико_НоменклатураЭтикеток = Истина
			Тогда Префикс = "е";
			//--> Маковеева А.Ю.
			//остальную номенклатуру нумеруем с префиксом "m"
		Иначе
			Префикс = "m";
			//<-- Маковеева А.Ю.
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ЗаполнитьПоказателиДляТаблиц(Ссылка,НомерПроката,НомерВарианта = 1 ) Экспорт
// Данная процедура собирает комплексные данные о заказе клиента для заполнения таблицы показателей

	ДобавитьЗначениеПоказателя(Ссылка, НомерВарианта, НомерПроката, Справочники.Лико_ПараметрыРасчетаНормативов.Поправка1С, 1);
	ДобавитьЗначениеПоказателя(Ссылка, НомерВарианта, НомерПроката, Справочники.Лико_ПараметрыРасчетаНормативов.ПЗВ, 1);
	
#Область Запрос	
	Запрос = Новый Запрос;
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ТаблицаЦвета.Ссылка КАК Заказ,
		|	ТаблицаЦвета.ВидСекции.ВидПечати КАК ВидПечати,
		|	ТаблицаЦвета.ТипЦвета1 КАК ТипЦвета,
		|	ТаблицаЦвета.ТипКраски КАК ТипКраски,
		|	ТаблицаЦвета.Название КАК Название,
		|	ТаблицаЦвета.ПроцентЗаливки КАК ПроцентЗаливки,
		|	ТаблицаЦвета.Грамматура КАК Грамматура,
		|	ТаблицаЦвета.ЗапечатываемыйМатериал КАК ЗапечатываемыйМатериал,
		|	ТаблицаЦвета.НомерПроката КАК НомерПроката,
		|	ТаблицаЦвета.НомерВарианта КАК НомерВарианта,
		|	СУММА(1) КАК КоличествоЦветов,
		|	ТаблицаЦвета.ВидТМЦ КАК ВидТМЦ,
		|	ТаблицаЦвета.ВидЗаливки КАК ВидЗаливки
		|ПОМЕСТИТЬ ЦветаВЗаказах
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ТаблицаЦвета
		|ГДЕ
		|	ТаблицаЦвета.Ссылка = &Ссылка
		|	И ТаблицаЦвета.НомерВарианта = &НомерВарианта
		|	И ТаблицаЦвета.НомерПроката = &НомерПроката
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦвета.Ссылка,
		|	ТаблицаЦвета.НомерПроката,
		|	ТаблицаЦвета.ТипКраски,
		|	ТаблицаЦвета.Название,
		|	ТаблицаЦвета.ПроцентЗаливки,
		|	ТаблицаЦвета.Грамматура,
		|	ТаблицаЦвета.ЗапечатываемыйМатериал,
		|	ТаблицаЦвета.НомерВарианта,
		|	ТаблицаЦвета.ТипЦвета1,
		|	ТаблицаЦвета.ВидСекции.ВидПечати,
		|	ТаблицаЦвета.ВидТМЦ,
		|	ТаблицаЦвета.ВидЗаливки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЦветаВЗаказах.ВидПечати КАК ВидПечати,
		|	ЦветаВЗаказах.ТипЦвета КАК ТипЦвета,
		|	ЦветаВЗаказах.ТипКраски КАК ТипКраски,
		|	ЦветаВЗаказах.Название КАК Название,
		|	ЦветаВЗаказах.ПроцентЗаливки КАК ПроцентЗаливки,
		|	ЦветаВЗаказах.Грамматура КАК Грамматура,
		|	ЦветаВЗаказах.ЗапечатываемыйМатериал КАК ЗапечатываемыйМатериал,
		|	ЦветаВЗаказах.НомерПроката КАК НомерПроката,
		|	ЦветаВЗаказах.НомерВарианта КАК НомерВарианта,
		|	МАКСИМУМ(ЦветаВЗаказах.КоличествоЦветов) КАК КоличествоЦветов,
		|	ЦветаВЗаказах.ВидТМЦ КАК ВидТМЦ,
		|	ЦветаВЗаказах.ВидЗаливки КАК ВидЗаливки
		|ПОМЕСТИТЬ ВТ_ВсеЦвета
		|ИЗ
		|	ЦветаВЗаказах КАК ЦветаВЗаказах
		|
		|СГРУППИРОВАТЬ ПО
		|	ЦветаВЗаказах.ВидПечати,
		|	ЦветаВЗаказах.ТипЦвета,
		|	ЦветаВЗаказах.ТипКраски,
		|	ЦветаВЗаказах.Название,
		|	ЦветаВЗаказах.ПроцентЗаливки,
		|	ЦветаВЗаказах.Грамматура,
		|	ЦветаВЗаказах.ЗапечатываемыйМатериал,
		|	ЦветаВЗаказах.НомерПроката,
		|	ЦветаВЗаказах.НомерВарианта,
		|	ЦветаВЗаказах.ВидТМЦ,
		|	ЦветаВЗаказах.ВидЗаливки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ТаблицаВидыРабот.ВидСекции.ОтображатьВТЧЦвета
		|				И НЕ ТаблицаВидыРабот.ВидСекции.ОтображатьВТЧРаботы
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Печать)
		|		ИНАЧЕ ТаблицаВидыРабот.ВидСекции
		|	КОНЕЦ КАК ВидРабот,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ 1) КАК КоличествоРабот,
		|	ТаблицаВидыРабот.НомерРаботы КАК НомерРаботы
		|ПОМЕСТИТЬ ВТ_РаботыСНомерами
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ТаблицаВидыРабот
		|ГДЕ
		|	ТаблицаВидыРабот.Ссылка = &Ссылка
		|	И ТаблицаВидыРабот.НомерПроката = &НомерПроката
		|	И ТаблицаВидыРабот.НомерВарианта = &НомерВарианта
		|	И (ТаблицаВидыРабот.ВидСекции.ОтображатьВТЧЦвета
		|			ИЛИ ТаблицаВидыРабот.ВидСекции.ОтображатьВТЧРаботы)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаВидыРабот.НомерРаботы,
		|	ВЫБОР
		|		КОГДА ТаблицаВидыРабот.ВидСекции.ОтображатьВТЧЦвета
		|				И НЕ ТаблицаВидыРабот.ВидСекции.ОтображатьВТЧРаботы
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Печать)
		|		ИНАЧЕ ТаблицаВидыРабот.ВидСекции
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_РаботыСНомерами.ВидРабот КАК Показатель,
		|	КОЛИЧЕСТВО(ВТ_РаботыСНомерами.КоличествоРабот) КАК ЗначениеПоказателя
		|ПОМЕСТИТЬ ВТ_Работы
		|ИЗ
		|	ВТ_РаботыСНомерами КАК ВТ_РаботыСНомерами
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_РаботыСНомерами.ВидРабот
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ТаблицаОсновнойМатериал.ОсновнойМатериал ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ТаблицаОсновнойМатериал.ОсновнойМатериал.ЦеноваяГруппа.ТипМатериала
		|		КОГДА ТаблицаОсновнойМатериал.ОсновнойМатериал ССЫЛКА Справочник.ЦеновыеГруппы
		|			ТОГДА ТаблицаОсновнойМатериал.ОсновнойМатериал.ТипМатериала
		|	КОНЕЦ КАК Показатель,
		|	1 КАК ЗначениеПоказателя
		|ПОМЕСТИТЬ ВТ_ОсновнойМатериал
		|ИЗ
		|	Документ.ЗаказКлиента КАК ТаблицаОсновнойМатериал
		|ГДЕ
		|	ТаблицаОсновнойМатериал.Ссылка = &ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Лико_ПараметрыРасчетаНормативовТипыЦветов1.Ссылка КАК Показатель,
		|	СУММА(1 * ВТ_ВсеЦвета.КоличествоЦветов) КАК ЗначениеПоказателя
		|ПОМЕСТИТЬ ВТ_Цвета
