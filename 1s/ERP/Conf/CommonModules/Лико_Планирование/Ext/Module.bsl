	|			КОГДА &Сдвиг = 0
	|				ТОГДА СоглашенияСКлиентами.ЭтапыГрафикаОплаты.ВариантОплаты В (&МассивВариантовОплатыАванс)
	|			ИНАЧЕ НЕ СоглашенияСКлиентами.ЭтапыГрафикаОплаты.ВариантОплаты В (&МассивВариантовОплатыАванс)
	|		КОНЕЦ
	|	И СоглашенияСКлиентами.Партнер = &Партнер";
	Запрос.УстановитьПараметр("Партнер",  Партнер);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("Сдвиг", КоличествоДнейОтрочки);
	Запрос.УстановитьПараметр("МассивВариантовОплатыАванс", МассивВариантовОплатыАванс);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда 
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// Попробуем найти типовое соглашение
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|              СоглашенияСКлиентами.Ссылка КАК Ссылка
	|ИЗ
	|              Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
	|ГДЕ
	|              НЕ СоглашенияСКлиентами.ПометкаУдаления
	|              И СоглашенияСКлиентами.Типовое
	|              И СоглашенияСКлиентами.Валюта = &Валюта
	|              И СоглашенияСКлиентами.ЭтапыГрафикаОплаты.Сдвиг = &Сдвиг
	|              И СоглашенияСКлиентами.ЭтапыГрафикаОплаты.ПроцентПлатежа = 100
	|              И ВЫБОР
	|                                             КОГДА &Сдвиг = 0
	|                                                             ТОГДА СоглашенияСКлиентами.ЭтапыГрафикаОплаты.ВариантОплаты В (&МассивВариантовОплатыАванс)
	|                                             ИНАЧЕ НЕ СоглашенияСКлиентами.ЭтапыГрафикаОплаты.ВариантОплаты В (&МассивВариантовОплатыАванс)
	|                             КОНЕЦ";
	
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("Сдвиг", КоличествоДнейОтрочки);
	
	Запрос.УстановитьПараметр("МассивВариантовОплатыАванс", МассивВариантовОплатыАванс);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ТиповоеСоглашение = Выборка.Ссылка;
	Иначе
		ТиповоеСоглашение = Справочники.СоглашенияСКлиентами.ПустаяСсылка();
	КонецЕсли;
	
	НовоеСоглашение = Справочники.СоглашенияСКлиентами.СоздатьЭлемент();
	НовоеСоглашение.Партнер = Партнер;
	НовоеСоглашение.Валюта = Валюта;
	НовоеСоглашение.ЦенаВключаетНДС = Истина;
	НовоеСоглашение.Соглашение = ТиповоеСоглашение;
	НовоеСоглашение.Статус = Перечисления.СтатусыСоглашенийСКлиентами.Действует;
	НовоеСоглашение.Согласован = Истина;
	НовоеСоглашение.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;  
	
	НовоеСоглашение.ГруппаФинансовогоУчета = Лико_Дополнительно.НайтиГруппуФинУчетаПоВалютеИНалогообложению(Валюта, Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);

	НовоеСоглашение.ИспользуютсяДоговорыКонтрагентов = Истина;
	НовоеСоглашение.ВариантРасчетаЦен = Перечисления.ВариантыРасчетаЦенПоСоглашениямСКлиентами.БезЦен;
	НовоеСоглашение.ВидСоглашенияДляОграниченияЧтения = Перечисления.ВидыСоглашенийСКлиентамиДляОграниченияЧтения.Индивидуальные;
	НовоеСоглашение.ВидСоглашенияДляОграниченияИзменения = Перечисления.ВидыСоглашенийСКлиентамиДляОграниченияИзменения.Индивидуальные;
	НовоеСоглашение.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента;
	НоваяСтрокаЭтапов = НовоеСоглашение.ЭтапыГрафикаОплаты.Добавить();
	НоваяСтрокаЭтапов.ВариантОплаты = ?(КоличествоДнейОтрочки = 0, Перечисления.ВариантыКонтроляОплатыКлиентом.ПредоплатаДоОтгрузки, Перечисления.ВариантыКонтроляОплатыКлиентом.КредитПослеОтгрузки);
	НоваяСтрокаЭтапов.ПроцентПлатежа = 100;
	НоваяСтрокаЭтапов.Сдвиг = КоличествоДнейОтрочки;
	Попытка
		НовоеСоглашение.Записать();
		Возврат НовоеСоглашение.Ссылка;
	Исключение
		Сообщить("Не удалось создать соглашение для партнера """ + Партнер + """, валюта """ + Валюта + """: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ЗаполнитьДоговорНаСервере(Партнер, Контрагент, Менеджер)
	Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Запрос=Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка  Как Договор
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Партнер = &Партнер
	|	И ДоговорыКонтрагентов.Контрагент = &Контрагент
	|	И ДоговорыКонтрагентов.ДляЗаказов = ИСТИНА";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Договор = Результат.Договор;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Договор) Тогда 
		ДоговорОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		ДоговорОбъект.Партнер  = Партнер;
		ДоговорОбъект.Контрагент = Контрагент;
		ДоговорОбъект.ДляЗаказов = Истина;
		ДоговорОбъект.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияОкил.ЗначениеПараметра;
		ДоговорОбъект.Наименование = "Для заказов";
		ДоговорОбъект.НаименованиеДляПечати = "Для заказов";
		ДоговорОбъект.Менеджер =  Менеджер;
		ДоговорОбъект.ВалютаВзаиморасчетов	= Справочники.Валюты.НайтиПоКоду("978");
		ДоговорОбъект.ПорядокРасчетов =  Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
		ДоговорОбъект.Статус	= Перечисления.СтатусыДоговоровКонтрагентов.Действует;
		ДоговорОбъект.ТипДоговора =  Перечисления.ТипыДоговоров.СПокупателем;

		ДоговорОбъект.Записать();
		Договор = ДоговорОбъект.Ссылка;
	КонецЕсли;
	Возврат Договор;
КонецФункции	

Процедура ПеренестиСпецификациюИзУППНаСервере(СпецКод, СпецНаименование ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	текПользователь = Пользователи.ТекущийПользователь();
	Площадка =  текПользователь.Лико_Площадка;
	Регион = текПользователь.Лико_Регион;

	Если Не ЗначениеЗаполнено(Площадка) ИЛИ Не ЗначениеЗаполнено(Регион) Тогда 
		Сообщить("Не указана площадка или регион для пользователя");
		Возврат;
	КонецЕсли;
	
	
	МСоединение = ПолучитьПодключениеКСервернойБД();

	ЗапросЕРП = Новый Запрос;
	ЗапросЕРП.текст = 
	"ВЫБРАТЬ
	|	Лико_Спецификации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Лико_Спецификации КАК Лико_Спецификации
	|ГДЕ
	|	Лико_Спецификации.Код = &код
	|	И Лико_Спецификации.Наименование = &наименование";
	ЗапросЕРП.УстановитьПараметр("Код", СпецКод);
	ЗапросЕРП.УстановитьПараметр("Наименование", СпецНаименование);
	РезультатЗапросаЕРП = ЗапросЕРП.Выполнить();
	Если  РезультатЗапросаЕРП.Пустой()   Тогда 
		Спец = Справочники.Лико_Спецификации.СоздатьЭлемент();
		Спец.Код  = СпецКод;
		Спец.Наименование = СпецНаименование;
	Иначе
		РезультатЕРП = РезультатЗапросаЕРП.Выбрать();
		РезультатЕРП.Следующий();
		Спец =РезультатЕРП.Ссылка.ПолучитьОбъект();
		Спец.Товары.Очистить();
		Спец.цвета.Очистить();
		Спец.ВидыРабот.Очистить();
		Спец.Формы.Очистить();
	КонецЕсли;
	
	Спец.Площадка = Площадка;
	Спец.Регион = Регион;

	
	ЗапросУПП = мСоединение.NewObject("Запрос");
	ЗапросУПП.Текст = 
					
			"ВЫБРАТЬ
			|	СпецификацииНоменклатуры.Ссылка,
			|	СпецификацииНоменклатуры.Контрагент.ИНН,
			|	СпецификацииНоменклатуры.Контрагент.Наименование,
			|	СпецификацииНоменклатуры.Контрагент.НаименованиеПолное,
			|	СпецификацииНоменклатуры.Контрагент.ЮрФизЛицо.Порядок,
			|	СпецификацииНоменклатуры.Контрагент.КПП,
			|	СпецификацииНоменклатуры.ПроверкаОрфографии,
			|	СпецификацииНоменклатуры.ПроверкаШК,
			|	СпецификацииНоменклатуры.ЧитабельностьМедали,
			|	СпецификацииНоменклатуры.ГрамматураКлеяКнижки,
			|	СпецификацииНоменклатуры.КоличествоПоверхностейКнижки,
			|	СпецификацииНоменклатуры.КоличествоЭтикетокВСтопеТУ,
			|	СпецификацииНоменклатуры.ШиринаРукаваТУ,
			|	СпецификацииНоменклатуры.ПоперечнаяРезкаТУ,
			|	СпецификацииНоменклатуры.ПоперечнаяПерфорацияТУ,
			|	СпецификацииНоменклатуры.Дизайнер.Наименование,
			|	СпецификацииНоменклатуры.КонтрольОТК,
			|	СпецификацииНоменклатуры.БезЛака,
			|	СпецификацииНоменклатуры.СпособНаклейки.Порядок,
			|	СпецификацииНоменклатуры.ОбразецЦвета.Порядок,
			|	СпецификацииНоменклатуры.ПоставщикМатериалаЛюбой,
			|	СпецификацииНоменклатуры.ВертикальнаяПерфорацияТУ,
			|	ВЫБОР
			|		КОГДА СпецификацииНоменклатуры.ОсновнойМатериал ССЫЛКА Справочник.ЦеновыеГруппы
			|			ТОГДА СпецификацииНоменклатуры.ОсновнойМатериал.Код
			|		ИНАЧЕ """"
			|	КОНЕЦ КАК ОсновнойМатериалЦГКод,
