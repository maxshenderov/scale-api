	    				ЗаписьНормативы.МетрыНаБрак =  выборка.процентНаБрак*МетражДляРЦ;
	    				МетрыНаНастройку = выборка.МетрыНаНастройку*КоличествоНастроек;
	    				ЗаписьНормативы.МетрыНаНастройку = МетрыНаНастройку;
	    				Если ЗначениеЗаполнено(Выборка.скоростьПечати) Тогда
	    					Если Выборка.НФ Тогда  
	    						Если ЗначениеЗаполнено(Выборка.ЭтикетокНаЛисте) Тогда 
	    							ВремяПечати = Окр(Тираж/(Выборка.ЭтикетокНаЛисте*Выборка.СкоростьПечати),2)*60;
	    						КонецЕсли;
	    					//ИначеЕсли Выборка.РабочийЦентр.ПорядковыйНомер = 410 Тогда
	    					//	ВремяПечати = Окр(Тираж/(ЗаказСсылка.Ручьи*Выборка.СкоростьПечати),2);		
	    						
	    					Иначе
	    						ВремяПечати = (МетражДляРЦ+ЗаписьНормативы.МетрыНаБрак)/Выборка.скоростьПечати;
	    					КонецЕсли;	
	    				КонецЕсли;	
	    				ЗаписьНормативы.ВремяПечати =ВремяПечати;
	    				ЗаписьНормативы.ВремяНаНастройку = Выборка.ВремяНаНастройку*КоличествоНастроек;
	    				ЗаписьНормативы.ПроцентНаБрак = Выборка.ПроцентНаБрак;
	    				
	    				МетражДляРЦ = МетражДляРЦ+ЗаписьНормативы.метрыНаБрак+МетрыНаНастройку;
	    				ЗаписьНормативы.метражДляРЦ = МетражДляРЦ;
	    				Если ЗначениеЗаполнено(Выборка.длинаролика) Тогда 
	    					ЗаписьНормативы.ДлинаРолика = Выборка.длинаролика;
	    					ЗаписьНормативы.времянасменуроликов = 5*Выборка.КоличествоМатериалов*Окр((МетражДляРЦ/Выборка.ДлинаРолика) + 0.4999) + 5 *Выборка.КоличествоТиснений*Окр((МетражДляРЦ/2000) + 0.4999);
	    				КонецЕсли;
	    				
	    				//МойкаСекций = МойкаСекций+НормативыДляРЦ.МойкаСекций;
	    				//Т.к. настроек может быть несколько!
	    				
	    				ВремяВыполненияЗаказа = ВремяВыполненияЗаказа+ВремяПечати+ЗаписьНормативы.ВремяНаНастройку+ЗаписьНормативы.времянасменуроликов;
	    				ВремяУУ = ВремяУУ+ (ВремяПечати+ЗаписьНормативы.ВремяНаНастройку+ЗаписьНормативы.времянасменуроликов)* Выборка.КоэффициентУчетаВремени;
	    				Если Выборка.НомерПроката = 1 Тогда 
	    					Время1РЦ = ВремяПечати+ЗаписьНормативы.ВремяНаНастройку+ЗаписьНормативы.времянасменуроликов;
	    				КонецЕсли;
	    				ДлинаПечати = Выборка.ДлинаПечати;
	    				//КоличествоЭтикетокВРаппорте = Выборка.КоличествоЭтикетокВРаппорте;
	    				Если  Выборка.ЦифровойРЦ И ЗначениеЗаполнено(ДлинаПечати)   ТОгда     //  И ЗначениеЗаполнено(КоличествоЭтикетокВРаппорте)
	    				//	КоличествоЭтикетокОбщее = МетражДляРЦ * КоличествоЭтикетокВРаппорте /ДлинаПечати;
	    				//	ВсегоКликов = Окр(2*Выборка.КоличествоКликов *КоличествоЭтикетокОбщее/КоличествоЭтикетокВРаппорте);
	    					ВсегоКликов = ВсегоКликов+ Окр(2*Выборка.КоличествоКликов * МетражДляРЦ/ДлинаПечати);
	    					
	    				КонецЕсли;	
	    			КонецЕсли;
	    							
	    		КонецЦикла;
	    		

	    		ЗаписьОтгрузки.РасчетноеКоличествоКликов = Коэффициент *ВсегоКликов;
	    		ЗаписьОтгрузки.времяПлан = Коэффициент *ВремяВыполненияЗаказа;
	    		ЗаписьОтгрузки.МетражПланПМ = Коэффициент *МетражДляРЦ; 
	    		ЗаписьОтгрузки.МетражПлан = Коэффициент *МетражДляРЦ * ВыборкаЗаказы.МетражКВМ/ВыборкаЗаказы.МетражПМ; 
	    		ЗаписьОтгрузки.ВремяПлан =  Коэффициент *Окр(ВремяВыполненияЗаказа/60,4);
	    		ЗаписьОтгрузки.Время1РЦ =  Коэффициент *Окр(Время1РЦ/60,4);
	    		ЗаписьОтгрузки.ВремяУУ =  Коэффициент *Окр(ВремяУУ/60,4);
	    		
	    		Если ЗаполнятьЗатраты И Не ВыборкаЗаказы.УдаленаОУ Тогда 
	    			Если КоличествоНастроек=0 Тогда 
	    				ЗаполнитьРегистрыЗатратНаОтгрузкуПоНормам2(Док, ВыборкаЗаказы.Заказ, МетражДляРЦ, ВсегоКликов);
	    			Иначе
	    				ЗаполнитьРегистрыЗатратНаОтгрузкуПоследнюю2(Док,ВыборкаЗаказы.Заказ) ;
	    			КонецЕсли;
	    		КонецЕсли;	

	    		
	  
	    	Иначе
	    		Если  ТипЗнч(Док) <> Тип("ДокументСсылка.КорректировкаРеализации") Тогда 
	    			Продолжить;
	    		КонецЕсли;	
	    	КонецЕсли;
	    	НаборЗаписейНормативы.Записать();
	    	НаборЗаписейОтгрузки.Записать();

		КонецЦикла;		

		Если ЗаполнятьЗатраты  Тогда 
			ЗаполнитьЗатратыПоОтгрузке2(Док);
		КонецЕсли;
		
		ЗаписыватьОтгрузкиПродажи = ложь;
		ПОка ВыборкаОтгрузкиПродажи.Следующий() Цикл
			Запись = НаборЗаписейОтгрузкиПродажи.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, ВыборкаОтгрузкиПродажи);
			ЗаписыватьОтгрузкиПродажи = Истина;
		КонецЦикла;
		Если ЗаписыватьОтгрузкиПродажи Тогда 
			НаборЗаписейОтгрузкиПродажи.Записать();
		КонецЕсли; 
#КонецОбласти	
	КонецЕсли;

  
КонецПроцедуры


Процедура ЗаполнитьРегистрыЗатратНаОтгрузкуПоНормам2(Регистратор, Заказ, МетражПлан, расчетноеколичествоКликов = 0, Отказ=Ложь) Экспорт
	УстановитьПривилегированныйРежим(Истина);

	Период = Регистратор.Дата;
	ДатаОстатков= КонецДня(Период);

	ЗапросЗатраты = Новый Запрос;
	ЗапросЗатраты.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.ЗаказКлиента КАК ЗаказКлиента,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.СтатьяЗатрат КАК СтатьяЗатрат,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.НомерПроката КАК НомерПроката,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.РабочийЦентр КАК РабочийЦентр,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.ВидРабот КАК ВидРабот,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.НомерРаботы КАК НомерРаботы,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.Затрата КАК Затрата,
	|	СУММА(Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.КоличествоОстаток) КАК Количество,
	|	СУММА(Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.КоличествоПМОстаток) КАК КоличествоПМ,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.ВидНастроечногоМатериала КАК ВидНастроечногоМатериала
	|ПОМЕСТИТЬ Затраты
	|ИЗ
	|	РегистрНакопления.Лико_ЗатратыПоЗаказуДляОтгрузки.Остатки(
	|			&Дата,
	|			ЗаказКлиента = &Заказ
	|				И СтатьяЗатрат В (ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ОсновнойМатериал), ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ДополнительныеМатериалы))) КАК Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.ЗаказКлиента,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.СтатьяЗатрат,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.Затрата,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.РабочийЦентр,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.НомерПроката,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.НомерРаботы,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.ВидРабот,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.ВидНастроечногоМатериала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Затраты.ЗаказКлиента КАК ЗаказКлиента,
	|	Затраты.СтатьяЗатрат КАК СтатьяЗатрат,
	|	Затраты.НомерПроката КАК НомерПроката,
	|	Затраты.ВидРабот КАК ВидРабот,
	|	Затраты.НомерРаботы КАК НомерРаботы,
	|	Затраты.Затрата КАК Затрата,
	|	Затраты.Количество КАК Количество,
	|	Затраты.РабочийЦентр КАК РабочийЦентр,
	|	ЗаказКлиентаВидыРабот.Дополнительно КАК Подача,
	|	ЗаказКлиентаВидыРабот.ЭтикетокВПодаче КАК ЭтикетокВПодаче,
	|	Затраты.КоличествоПМ КАК КоличествоПМ,
	|	Затраты.ВидНастроечногоМатериала КАК ВидНастроечногоМатериала
	|ИЗ
	|	Затраты КАК Затраты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|		ПО Затраты.ЗаказКлиента = ЗаказКлиентаВидыРабот.Ссылка
	|			И Затраты.НомерПроката = ЗаказКлиентаВидыРабот.НомерПроката
	|			И Затраты.ВидРабот = ЗаказКлиентаВидыРабот.ВидРабот
	|			И Затраты.НомерРаботы = ЗаказКлиентаВидыРабот.НомерРаботы
	|ГДЕ
	|	Затраты.Количество > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	Затраты.ЗаказКлиента,
	|	Затраты.СтатьяЗатрат,
	|	Затраты.НомерПроката,
	|	Затраты.ВидРабот,
	|	Затраты.НомерРаботы,
	|	Затраты.Затрата,
	|	Затраты.Количество,
	|	Затраты.РабочийЦентр,
	|	ЗаказКлиентаВидыРабот.Дополнительно,
	|	ЗаказКлиентаВидыРабот.ЭтикетокВПодаче,
	|	Затраты.КоличествоПМ,
	|	Затраты.ВидНастроечногоМатериала
	|ИТОГИ
	|	МАКСИМУМ(ЗаказКлиента),
	|	МАКСИМУМ(Подача),
	|	МАКСИМУМ(ЭтикетокВПодаче)
	|ПО
	|	СтатьяЗатрат,
	|	НомерПроката,
	|	ВидРабот,
	|	НомерРаботы";				
	ЗапросЗатраты.УстановитьПараметр("Заказ", Заказ);
	ЗапросЗатраты.УстановитьПараметр("Дата", ДатаОстатков);
	НаборЗаписей = РегистрыНакопления.Лико_ЗатратыПоЗаказуДляОтгрузки.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
	НаборЗаписей.Прочитать();
	ВыборкаСтатья = ЗапросЗатраты.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "СтатьяЗатрат");
	Пока  ВыборкаСтатья.Следующий() Цикл
		ВыборкаПрокат =  ВЫборкаСтатья.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "НомерПроката");
		Пока ВыборкаПрокат.Следующий() Цикл
			ВЫборкаВидРабот = ВыборкаПрокат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидРабот");
			Пока ВыборкаВидРабот.Следующий() Цикл
				ВыборкаНомерРаботы = ВыборкаВидРабот.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "НомерРаботы");
				Пока ВыборкаНомерРаботы.Следующий() Цикл
					//Считаем в погонных метрах, списываем в квадратных
					Норма = 0;
					Если ВыборкаНомерРаботы.ВидРабот.Родитель = Справочники.ВидыРаботСотрудников.Тиснение И ЗначениеЗаполнено(ВыборкаНомерРаботы.Подача) И ЗначениеЗаполнено(ВыборкаНомерРаботы.ЭтикетокВПодаче) Тогда
						КоличествоСНастройкойБраком = МетражПлан * Заказ.Нарезка.Размер/1000 * Заказ.ШтКВМ/1000;												
						Норма =(ВыборкаНомерРаботы.Подача*КоличествоСНастройкойБраком)/ВыборкаНомерРаботы.ЭтикетокВПодаче;	
					Иначе
						Норма = МетражПлан;
					КонецЕсли;
					ВыборкаЗатраты = ВыборкаНомерРаботы.Выбрать();
					ПОка ВыборкаЗатраты.Следующий() Цикл
						НарезкаРасчетная =  ВыборкаЗатраты.Количество/ ВыборкаЗатраты.КоличествоПМ;
						Если ВЫборкаЗатраты.КоличествоПМ>Норма Тогда 
							Списать = Норма;
							Норма = 0;
						Иначе
							Списать = ВыборкаЗатраты.КоличествоПМ;
							Норма = Норма - ВыборкаЗатраты.КоличествоПМ;
						КонецЕсли;	
						Запись = НаборЗаписей.Добавить();
						ЗаполнитьЗначенияСвойств(Запись, ВыборкаЗатраты);
						Запись.ВидДвижения = ВидДвиженияНакопления.Расход;
						Запись.Регистратор = Регистратор;
						Запись.Период = Период;
						Запись.КоличествоПМ =  Списать;
						Запись.Количество = Списать*НарезкаРасчетная;
						
						Если Норма = 0 Тогда 
							Прервать;
						КонецЕсли;
						
					КонецЦикла;					
				КонецЦикла;				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ЗапросЗатраты = Новый Запрос;
	ЗапросЗатраты.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.ЗаказКлиента КАК ЗаказКлиента,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.СтатьяЗатрат КАК СтатьяЗатрат,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.НомерПроката КАК НомерПроката,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.ВидРабот КАК ВидРабот,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.НомерРаботы КАК НомерРаботы,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.Затрата КАК Затрата,
	|	СУММА(Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.КоличествоОстаток) КАК Количество,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.РабочийЦентр КАК РабочийЦентр,
	|	СУММА(Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.СуммаОстаток) КАК Сумма
	|ИЗ
	|	РегистрНакопления.Лико_ЗатратыПоЗаказуДляОтгрузки.Остатки(
	|			&Дата,
	|			ЗаказКлиента = &Заказ
	|				И НЕ СтатьяЗатрат В (ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ОсновнойМатериал), ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ДополнительныеМатериалы))) КАК Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.ЗаказКлиента,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.СтатьяЗатрат,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.ВидРабот,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.Затрата,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.РабочийЦентр,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.НомерПроката,
	|	Лико_ЗатратыПоЗаказуДляОтгрузкиОстатки.НомерРаботы";
	ЗапросЗатраты.УстановитьПараметр("Заказ", Заказ);
	ЗапросЗатраты.УстановитьПараметр("Дата", ДатаОстатков);
	ВыборкаЗатраты = ЗапросЗатраты.Выполнить().Выбрать();
	ПОка ВыборкаЗатраты.Следующий() Цикл
		Списать=ВыборкаЗатраты.Количество;
		Если ВыборкаЗатраты.СтатьяЗатрат = Справочники.Лико_СтатьиЗатрат.Клики Тогда 
			Если ЗначениеЗаполнено(расчетноеколичествоКликов) ТОгда 
				Если ВыборкаЗатраты.Количество>=расчетноеколичествоКликов Тогда 
					Списать = расчетноеколичествоКликов ;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаЗатраты);
		Запись.ВидДвижения = ВидДвиженияНакопления.Расход;
		Запись.Регистратор = Регистратор;
