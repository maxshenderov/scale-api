Процедура ЗаполнениеПродажпоАктамРабот(Источник, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);

	Док = Источник.Ссылка;
	НаборЗаписейПродажи = РегистрыНакопления.Лико_Продажи.СоздатьНаборЗаписей();
	НаборЗаписейПродажи.Отбор.Регистратор.Установить(Док);
	НаборЗаписейПродажи.Записать();
	
	НаборЗаписейОтгрузки = РегистрыНакопления.Лико_отгрузки2.СоздатьНаборЗаписей();
	НаборЗаписейОтгрузки.Отбор.Регистратор.Установить(Док);
	НаборЗаписейОтгрузки.Записать();
	
	//НаборЗаписейПродажиДляДохода = РегистрыНакопления.Лико_ПродажиДляДохода.СоздатьНаборЗаписей();
	//НаборЗаписейПродажиДляДохода.Отбор.Регистратор.Установить(Док);
	//НаборЗаписейПродажиДляДохода.Записать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	
	"ВЫБРАТЬ
	|	ВыручкаИСебестоимостьПродаж.Период КАК Период,
	|	ЕСТЬNULL(ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры, ЗНАЧЕНИЕ(Документ.заказКлиента.ПустаяСсылка)) КАК Заказ,
	|	ВыручкаИСебестоимостьПродаж.Регистратор КАК Регистратор,
	|	МАКСИМУМ(ВыручкаИСебестоимостьПродаж.Регистратор) КАК ДокументПродажи,
	|	МАКСИМУМ(ВыручкаИСебестоимостьПродаж.Регистратор) КАК ДокументОтгрузки,
	|	ВыручкаИСебестоимостьПродаж.АналитикаУчетаПоПартнерам.Договор КАК Договор,
	|	ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	СУММА(ВыручкаИСебестоимостьПродаж.СуммаВыручки) КАК Стоимость,
	|	СУММА(ВыручкаИСебестоимостьПродаж.СуммаВыручкиБезНДС) КАК СтоимостьБезНДС,
	|	СУММА(ВыручкаИСебестоимостьПродаж.СуммаВыручкиРегл) КАК СтоимостьРегл,
	|	СУММА(ВыручкаИСебестоимостьПродаж.СуммаВыручкиСНДСРегл) КАК СтоимостьРеглСНДС,
	|	ВЫБОР
	|		КОГДА ВыручкаИСебестоимостьПродаж.Регистратор.Лико_ДатаЗакрытия >= ДАТАВРЕМЯ(2021, 6, 1)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЗаписьДляДохода
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК ВыручкаИСебестоимостьПродаж
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры.ДополнительныеРеквизиты КАК ПартнерыДополнительныеРеквизиты
	|		ПО ВыручкаИСебестоимостьПродаж.АналитикаУчетаПоПартнерам.Партнер = ПартнерыДополнительныеРеквизиты.Ссылка
	|			И (ПартнерыДополнительныеРеквизиты.Свойство.Имя = ""Лико_СобственнаяОрганизация"")
	|ГДЕ
	|	ПартнерыДополнительныеРеквизиты.Значение ЕСТЬ NULL
	|	И ВыручкаИСебестоимостьПродаж.Регистратор = &ДокументПродажи
	|	И НЕ ВыручкаИСебестоимостьПродаж.АналитикаУчетаПоПартнерам.Организация В
	|				(ВЫБРАТЬ
	|					Лико_ПредопределенныеЗначения.ЗначениеПараметра КАК ЗначениеПараметра
	|				ИЗ
	|					Справочник.Лико_ПредопределенныеЗначения КАК Лико_ПредопределенныеЗначения
	|				ГДЕ
	|					Лико_ПредопределенныеЗначения.Ссылка = ЗНАЧЕНИЕ(Справочник.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыручкаИСебестоимостьПродаж.АналитикаУчетаПоПартнерам.Договор,
	|	ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Номенклатура,
	|	ВыручкаИСебестоимостьПродаж.Период,
	|	ВыручкаИСебестоимостьПродаж.Регистратор,
	|	ЕСТЬNULL(ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры, ЗНАЧЕНИЕ(Документ.заказКлиента.ПустаяСсылка)),
	|	ВЫБОР
	|		КОГДА ВыручкаИСебестоимостьПродаж.Регистратор.Лико_ДатаЗакрытия >= ДАТАВРЕМЯ(2021, 6, 1)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ"  ;
	
	Запрос.УстановитьПараметр("ДокументПродажи", Док);
	Выборка = Запрос.Выполнить().Выбрать(); 
	Пока Выборка.Следующий() Цикл
		ЗаписьПродажи = НаборЗаписейПродажи.Добавить();
		ЗаполнитьЗначенияСвойств(ЗаписьПродажи, Выборка);
		ЗаписьОтгрузки = НаборЗаписейотгрузки.Добавить();
		ЗаполнитьЗначенияСвойств(ЗаписьОтгрузки, Выборка);
		//Если  Выборка.ЗаписьДляДохода Тогда 
		//	ЗаписьПродажиДляДохода = НаборЗаписейПродажиДляДохода.ДобавитьПриход();
		//	ЗаполнитьЗначенияСвойств(ЗаписьПродажиДляДохода, Выборка);	
		//КонецЕсли;
	КонецЦикла;
	НаборЗаписейПродажи.Записать();
	НаборЗаписейОтгрузки.Записать();
	//НаборЗаписейПродажиДляДохода.Записать();

	
КонецПроцедуры	

Процедура ЗаполнениеПараметровСписания(Источник, Отказ) Экспорт
	
	
	УстановитьПривилегированныйРежим(Истина);   
	
	Если Источник.дата>= '20220201' Тогда 
        ЗаполнениеПараметровСписания2022(Источник, Отказ);
		Возврат;
    КонецЕсли;

	Док = Источник.Ссылка;
	НаборЗаписейПродажи = РегистрыНакопления.Лико_Продажи.СоздатьНаборЗаписей();
	НаборЗаписейПродажи.Отбор.Регистратор.Установить(Док);
	НаборЗаписейПродажи.Записать();	
	
	НаборЗаписейОтгрузки = РегистрыНакопления.Лико_Отгрузки2.СоздатьНаборЗаписей();
    НаборЗаписейОтгрузки.Отбор.Регистратор.Установить(Док);
    НаборЗаписейОтгрузки.Записать();
    
    НаборЗаписейНормативыОтгрузки = РегистрыСведений.Лико_НормативыОтгрузки.СоздатьНаборЗаписей();
    НаборЗаписейНормативыОтгрузки.Отбор.Регистратор.Установить(Док);
    НаборЗаписейНормативыОтгрузки.Записать();
    
 

	НаборЗаписейЗатратыПоОтгрузке = РегистрыНакопления.Лико_ЗатратыПоЗаказуДляОтгрузки.СоздатьНаборЗаписей();
	НаборЗаписейЗатратыПоОтгрузке.Отбор.Регистратор.Установить(Док);
	НаборЗаписейЗатратыПоОтгрузке.Записать();  
	
	НаборЗаписейСебестоимостьЗаказов = РегистрыНакопления.Лико_СебестоимостьЗаказов.СоздатьНаборЗаписей();
	НаборЗаписейСебестоимостьЗаказов.Отбор.Регистратор.Установить(Док);
	НаборЗаписейСебестоимостьЗаказов.Записать();
	
	НаборЗаписейПродажиДляДохода = РегистрыНакопления.Лико_ПродажиДляДохода.СоздатьНаборЗаписей();
	НаборЗаписейПродажиДляДохода.Отбор.Регистратор.Установить(Док);
	НаборЗаписейПродажиДляДохода.Записать();

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
