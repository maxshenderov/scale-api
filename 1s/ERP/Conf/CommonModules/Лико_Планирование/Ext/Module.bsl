			ТЗ = Лико_Планирование.ПолучитьСтоимостьКраскиЛаков(Выборка.ЗаказКлиента,"Документ.ЗаказКлиента", Выборка.Количество, Выборка.КоличествоПМ, 1, ДатаЦены, Выборка.НомерПроката, Истина);
			Для каждого стр ИЗ ТЗ Цикл
				Запись = НаборЗаписейЗатратыпоЗаказу.Добавить();
				ЗаполнитьЗначенияСвойств(Запись, стр, ,  "Количество, Сумма");
				Запись.КоличествоПлан = стр.Количество;
				Запись.СуммаПлан = стр.сумма;
				Запись.Сумма = стр.суммафакт;
