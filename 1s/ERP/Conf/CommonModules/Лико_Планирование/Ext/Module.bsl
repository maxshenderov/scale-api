		//	Тип = "(КЭ)";
		//	числосимволов = 4;
		//ИначеЕсли Источник.Лико_ТипЭтикетки = Перечисления.Лико_ТипыЭтикеток.Кльр Тогда 
		//	Тип = "(Кльр)";
		//	числосимволов = 6;
		//КонецЕсли;
		
		Тип = "(" + Лико_Дополнительно.ИмяПеречисления(Источник.Лико_ТипЭтикетки) + ")";
		числосимволов = СтрДлина(Тип);
	    // <-- Конец Лико Ефимов ЕВВ 21.06.2021
		
		Если ЗначениеЗаполнено(Тип) Тогда
			Если Прав(Источник.Наименование, числосимволов) <> Тип Тогда 
				Источник.Наименование= Источник.Наименование+ " "+тип;
			КонецЕсли;
		КонецЕсли;	
