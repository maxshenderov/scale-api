			Сообщить("Необходимо указать вид ТМЦ");
			Отказ = Истина;
		КонецЕсли;	
	КонецЕсли;
	
	// --> Начало Лико Ефимов ЕВВ 21.06.2025
	ДопСвойствоВнутреннийНомерОкил = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "ВнутреннийНомерОКИЛ_4576749183cf480bba064812ab6ee3c6");
	Если ЗначениеЗаполнено(ДопСвойствоВнутреннийНомерОкил) Тогда
		НайденнаяСтрокаДопРекв = Источник.ДополнительныеРеквизиты.Найти(ДопСвойствоВнутреннийНомерОкил, "Свойство");
		Если НайденнаяСтрокаДопРекв <> Неопределено И ЗначениеЗаполнено(НайденнаяСтрокаДопРекв.Значение) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Номенклатура,
				|	НоменклатураДополнительныеРеквизиты.Ссылка.Код КАК Код
				|ИЗ
				|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
				|ГДЕ
				|	НоменклатураДополнительныеРеквизиты.Свойство = &ДопСвойствоВнутреннийНомерОкил
				|	И НоменклатураДополнительныеРеквизиты.Значение = &ВнутреннийНомер
				|	И НЕ НоменклатураДополнительныеРеквизиты.Ссылка.ПометкаУдаления
				|	И НоменклатураДополнительныеРеквизиты.Ссылка <> &Ссылка
				|
				|СГРУППИРОВАТЬ ПО
				|	НоменклатураДополнительныеРеквизиты.Ссылка,
				|	НоменклатураДополнительныеРеквизиты.Ссылка.Код";
			
			Запрос.УстановитьПараметр("ДопСвойствоВнутреннийНомерОкил", ДопСвойствоВнутреннийНомерОкил);
			Запрос.УстановитьПараметр("ВнутреннийНомер", СокрЛП(НайденнаяСтрокаДопРекв.Значение));
			Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
			РезультатЗапроса = Запрос.Выполнить();
			Если НЕ РезультатЗапроса.Пустой() Тогда
				Отказ = Истина;
				Выборка = РезультатЗапроса.Выбрать();
				Выборка.Следующий();
				Сообщить("Ошибка при записи номенклатуры """ + Источник + """: с внутренним номером ОКИЛ " + СокрЛП(НайденнаяСтрокаДопРекв.Значение) + " в системе уже есть номенклатура (код " + Выборка.Код + ")");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
    // <-- Конец Лико Ефимов ЕВВ 21.06.2025
КонецПроцедуры


Функция СоздатьНоменклатуруНаСервере (Текст, ТипЭтикетки, Регион, Партнер, Артикул = Неопределено, DFM = Ложь, ТипЗаказа = Неопределено)	Экспорт
	
	НоваяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	
	НачатьТранзакцию();

	НоваяНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
	НоваяНоменклатура.Наименование =Текст;
	//НоваяНоменклатура.НаименованиеПолное = Текст;
	//НоваяНоменклатура.Артикул = Выборка.НоменклатураАртикул;
	ВидНоменклатуры = Регион.Лико_ВидНоменклатуры;
	НоваяНоменклатура.ВидНоменклатуры = ВидНоменклатуры;
	НоваяНоменклатура.ГруппаФинансовогоУчета = ВидНоменклатуры.ГруппаФинансовогоУчета;
	НоваяНоменклатура.ГруппаАналитическогоУчета = ВидНоменклатуры.ГруппаАналитическогоУчета;
	//НоваяНоменклатура.Код = Выборка.НоменклатураКод;
	НоваяНоменклатура.СтавкаНДС =  УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС20);
	//НоваяНоменклатура.ЕдиницаИзмерения =  Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("тыс.шт");
	НоваяНоменклатура.ЕдиницаИзмерения =  ВидНоменклатуры.ЕдиницаИзмерения;
	НоваяНоменклатура.ЕдиницаДляОтчетов = ВидНоменклатуры.ЕдиницаДляОтчетов;
	НоваяНоменклатура.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	НоваяНоменклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
	НоваяНоменклатура.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры;
	НоваяНоменклатура.ИспользоватьУпаковки = Истина;
	//НоваяНоменклатура.НаборУпаковок =  Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("тыс.шт");
	НоваяНоменклатура.НаборУпаковок = ВидНоменклатуры.НаборУпаковок;
	НоваяНоменклатура.ГруппаДоступа = Справочники.ГруппыДоступаНоменклатуры.НайтиПоНаименованию("Готовая продукция");
	НоваяНоменклатура.СкладскаяГруппа =  Справочники.Лико_ПредопределенныеЗначения.СкладскаяГруппаНоменклатурыДляГП.ЗначениеПараметра;
	НоваяНоменклатура.Лико_ТипЭтикетки = ТипЭтикетки;
	Если ЗначениеЗаполнено(Артикул) Тогда 
		НоваяНоменклатура.Артикул = Артикул;
	КонецЕсли;
	НоваяНоменклатура.Лико_DFM = DFM;
	Если ТипЗаказа <> Неопределено И ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Термоусадка Тогда
		КодТНВЭДТУ = Справочники.КлассификаторТНВЭД.НайтиПоКоду("4911990000");
		НоваяНоменклатура.КодТНВЭД = КодТНВЭДТУ;
	Иначе
		НоваяНоменклатура.КодТНВЭД = ВидНоменклатуры.КодТНВЭД;
	КонецЕсли;

	НоваяНоменклатура.Записать();
	Если  Не ЗначениеЗаполнено(Артикул) Тогда 
		НоваяНоменклатура.Артикул =  Лико_Планирование.КодБезНулей(НоваяНоменклатура.Код) + "-0";
		НоваяНоменклатура.Записать();
	КонецЕсли;
	
	МассивСтруктур = Новый Массив;
	МассивСтруктур.Добавить(Новый Структура("Свойство, Значение",ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Партнер", Истина),Партнер));
	УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(НоваяНоменклатура.Ссылка,МассивСтруктур);
	
	ЗафиксироватьТранзакцию();

	Возврат НоваяНоменклатура.Ссылка;		
КонецФункции


//Заполним в Заказе Цвета, работы, штампы    
Процедура ПередЗаписьюДокументов_ЗаказКлиента(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Источник.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Оснастка Тогда 
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;
	КонецЕсли;

	
	
	Если Источник.Товары.Количество() >0 Тогда
		Если ЗначениеЗаполнено(Источник.Товары[0].Номенклатура) Тогда 
			Источник.ЕдиницаИзмеренияЗаказа =  Источник.Товары[0].Номенклатура.ЕдиницаИзмерения;
		КонецЕсли; 
		Если ЗначениеЗаполнено(Источник.Товары[0].ВнутреннийДиаметр) Тогда 
			Источник.Втулка =  Источник.Товары[0].ВнутреннийДиаметр;
		КонецЕсли;

	КонецЕсли;
	
		
	// --> Начало Лико Митюшин МФМ 15.06.2021
	//Лико_ТиражМетраж.РасчитатьТиражМетраж(Источник) ;
	Если ЗначениеЗаполнено(Источник.ДатаОтправкиВРаботу) И (Источник.МетражКВМ = 0 Или Источник.ШтКВМ = 0) Тогда
		Сообщить("Метраж или Шт КВМ равны 0, проверьте и укажите правильные парамметры штампа.");
		Отказ = Истина;	
		Возврат;
	КонецЕсли;
	// <-- Конец Лико Митюшин МФМ 15.06.2021
	ПоперечнаяРезка = Ложь;
	Если Источник.Товары.Найти(Истина, "ПоперечнаяРезка") <>Неопределено Тогда 
		ПоперечнаяРезка = Истина;
	КонецЕсли;
    Источник.ПоперечнаяРезка = ПоперечнаяРезка;
	
	
	//Заполним Этикетки	
	Этикетки = "";
	Если Источник.ТИпЗаказа = Перечисления.Лико_ТипыЗаказов.Полуфабрикат Тогда 
		Таб = Источник.Товары.Выгрузить();
		Таб.Свернуть("Номенклатура,КодЭтикеткиЗаказчика");
		Для каждого стр из Таб Цикл
			Если ЗначениеЗаполнено(стр.Номенклатура.ЦеноваяГруппа) Тогда 
				Этикетки = Этикетки + "("+СокрЛП(стр.Номенклатура.ЦеноваяГруппа.Код)+")"+" "+СокрЛП(стр.Номенклатура.Наименование);
			Иначе
				Этикетки = Этикетки + " "+СокрЛП(стр.Номенклатура.Наименование);
			КонецЕсли;
			Если ЗначениеЗаполнено(стр.КодЭтикеткиЗаказчика)Тогда
				Этикетки = Этикетки +" * "+ стр.КодЭтикеткиЗаказчика;
			КонецЕсли;	
		КонецЦикла;	 
	Иначе	
		Таб = Источник.Товары.Выгрузить();
		Таб.Свернуть("Номенклатура,КодЭтикеткиЗаказчика");
		Для каждого стр из Таб Цикл
			Этикетки = Этикетки + стр.Номенклатура.Лико_ТипЭтикетки+" "+СокрЛП(стр.Номенклатура.Наименование);
			Если ЗначениеЗаполнено(стр.КодЭтикеткиЗаказчика)Тогда
				Этикетки = Этикетки +" * "+ стр.КодЭтикеткиЗаказчика;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Источник.ОтгрузкаСНастройкой) И Источник.ОтгрузкаСНастройкой<> Неопределено Тогда 
		Источник.ОтгрузкаСНастройкой = Неопределено;
	КонецЕсли;
	Источник.Этикетки  = Этикетки;
	НомераКонтрактов = "";
	Таб = Источник.Товары.Выгрузить();
	Таб.Свернуть("NКонтракта");
	Для каждого стр из Таб Цикл
		Если ЗначениеЗаполнено(стр.NКонтракта) Тогда 
			НомераКонтрактов = НомераКонтрактов+ ?(ЗначениеЗаполнено(НомераКонтрактов)," * ", "") + стр.NКонтракта;	
		КонецЕсли;	
	КонецЦикла;
	Источник.НомераКонтрактов =НомераКонтрактов;
	
	Артикулы = "";
	Таб = Источник.Товары.Выгрузить();
	Таб.Свернуть("Номенклатура,ВерсияНоменклатуры");
	Для каждого стр из Таб Цикл
		Если ЗначениеЗаполнено(стр.Номенклатура) Тогда 
			Если стр.Номенклатура.Лико_DFM Тогда 
				Артикулы = Артикулы+ ?(ЗначениеЗаполнено(Артикулы)," * ", "") + стр.ВерсияНоменклатуры.Артикул;
			Иначе	
				Артикулы = Артикулы+ ?(ЗначениеЗаполнено(Артикулы)," * ", "") + стр.Номенклатура.Артикул;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	Источник.Артикулы =Артикулы;
	
	//Заполним договор
	Если Не ЗначениеЗаполнено(Источник.Договор) Тогда 
		Если ЗначениеЗаполнено(Источник.Партнер) И ЗначениеЗаполнено(Источник.Контрагент) Тогда 
			Источник.Договор = ЗаполнитьДоговорНаСервере(Источник.Партнер,Источник.Контрагент, Источник.Менеджер);
		КонецЕсли;	
	КонецЕсли;

	
	
	ОригиналМакет = Ложь;
	Таб = Источник.Товары.Выгрузить();
	Таб.Свернуть("ОригиналМакет");
	Для каждого стр из Таб Цикл
		Если ЗначениеЗаполнено(стр.ОригиналМакет) Тогда 
			ОригиналМакет = Истина;
		КонецЕсли;	
	КонецЦикла;
	Источник.ОригиналМакет =ОригиналМакет;
	

	ШтампыСтрокой = "";
	ДопМатериалыСтрокой = "";	
	ВидСекцииТрафарет =  Справочники.Лико_ВидыСекций.ТрафаретнаяПечать;
    ВидСекцииНумератор = Справочники.Лико_ВидыСекций.Нумератор; 
	ВидСекцииКонгрев =    Справочники.Лико_ВидыСекций.Конгрев;
	ВидСекцииГорячееТиснениеСНумератором = Справочники.Лико_ВидыСекций.ГорячееТиснениеСНумератором;
	ВидСекцииКнижка = Справочники.Лико_ВидыСекций.Книжка;
	ВидРЦNewFoil = Справочники.ВидыРабочихЦентров.NewFoil;
	ВидРЦIndigo = Справочники.ВидыРабочихЦентров.Indigo;
	 
	ЭтоЦифровой = Ложь;
	ЭтоНФ = ЛОжь;
	ЭтоКнижка = Ложь;
	ЭтоТрафарет = Ложь;
	ЭтоФлексо = Ложь;
	ЭтоТиснение = Ложь;
	ЭтоЛаминация = Ложь;    
	ЭтоКонгрев = Ложь;  
	ЭтоНумератор = Ложь;
	ЛейблШифтер = Ложь;	
		 
	//Если Не Источник.РучнойВводПрокатов Тогда
	//	ЗаполнитьНомерПроката(Источник, Источник.Цифровой) ;
	//КонецЕсли;

//	ПроставитьНомераРабот(Источник);
	Для каждого стр из Источник.Цвета Цикл
		Если Не стр.номерварианта =1 Тогда 
			стр.номерварианта = 1;
		КонецЕсли;
			 
		Если стр.ВидСекции = ВидСекцииТрафарет И Не ЭтоТрафарет Тогда 
			ЭтоТрафарет = Истина;
		//ИначеЕсли  стр.ВидСекции.Родитель = Справочники.Лико_ВидыСекций.Флексо Тогда
		//	 ЭтоФлексо = Истина; 
		ИначеЕсли стр.ВидСекции.Тиснение И Не ЭтоТиснение Тогда  
				ЭтоТиснение = Истина;
	    ИначеЕсли стр.ВидСекции.Ламинация И Не ЭтоЛаминация Тогда  
				ЭтоЛаминация = Истина; 
		ИначеЕсли (стр.ВидСекции = ВидСекцииНумератор ИЛИ   стр.ВидСекции = ВидСекцииГорячееТиснениеСНумератором) И Не ЭтоНумератор Тогда  
				ЭтоНумератор = Истина;	
		ИначеЕсли стр.ВидСекции = ВидСекцииКонгрев И Не ЭтоКонгрев Тогда  
				ЭтоКонгрев = Истина;						 
		ИначеЕсли  стр.ВидСекции = ВидСекцииКнижка  И Не ЭтоКнижка Тогда
            ЭтоКнижка = Истина;
		КонецЕсли;
		
		// --> Начало Лико Ефимов ЕВВ 04.08.2025
		Если Стр.ВидСекции = Справочники.Лико_ВидыСекций.ЛейблШифтер Тогда
			ЛейблШифтер = Истина;
		КонецЕсли;
		// <-- Конец Лико Ефимов ЕВВ 04.08.2025

		Если ЗначениеЗаполнено(стр.РабочийЦентр) Тогда 
			Если Стр.РабочийЦентр.ВидРабочегоЦентра  = ВидРЦNewFoil и Не ЭтоНФ Тогда  
				ЭтоНФНФ = Истина;
			ИначеЕсли Стр.РабочийЦентр.ВидРабочегоЦентра  = ВидРЦIndigo и Не ЭтоЦифровой Тогда  
				ЭтоЦифровой = Истина;	
			КонецЕсли;			
		КонецЕсли;
		
		//20231011
		//Переносим из Видов Работ в Цвета 
	    Если ЗначениеЗаполнено(стр.Оснастка) Тогда 
			ШтампыСтрокой = ШтампыСтрокой+ ?(ЗначениеЗаполнено(ШтампыСтрокой)," * ", "") + стр.Оснастка.Артикул;	
		КонецЕсли;
		Если ЗначениеЗаполнено(стр.Материал) Тогда
			Если стрНайти(ДопМатериалыСтрокой,стр.Материал.Наименование)=0 Тогда  
				ДопМатериалыСтрокой = ДопМатериалыСтрокой+?(ЗначениеЗаполнено(ДопМатериалыСтрокой)," * ", "") +стр.Нарезка+" "+ стр.Материал.Наименование;
			КонецЕсли;	
		КонецЕсли;

		
	КонецЦикла;	
	
	Если Источник.Трафарет <> ЭтоТрафарет Тогда 
		Источник.Трафарет = ЭтоТрафарет;
	КонецЕсли;
	
	Если Источник.Тиснение <> ЭтоТиснение Тогда 
		Источник.Тиснение = ЭтоТиснение;
	КонецЕсли; 
	
	Если Источник.Ламинация <> ЭтоЛаминация Тогда 
		Источник.Ламинация = ЭтоЛаминация ;
	КонецЕсли;   
	
	Если Источник.Нумератор <> ЭтоНумератор Тогда 
		Источник.Нумератор = ЭтоНумератор ;
	КонецЕсли;
	
	Если Источник.Конгрев <> ЭтоКонгрев Тогда 
		Источник.Конгрев = ЭтоКонгрев ;
	КонецЕсли; 
	
	Если Источник.Цифровой <> ЭтоЦифровой Тогда 
		Источник.Цифровой = ЭтоЦифровой ;
	КонецЕсли;
	
	Если Источник.НФ <> ЭтоНФ Тогда 
		Источник.НФ = ЭтоНФ ;
	КонецЕсли; 
	
	Если Не Источник.Цифровой Тогда 
		Источник.КоличествоКликов = 0;
	КонецЕсли;   
	
	Если Источник.КнижныйМодуль <> ЭтоКнижка Тогда 
		 Источник.КнижныйМодуль = ЭтоКнижка;
	КонецЕсли;  
	Если НЕ Источник.Книжка И ЭтоКнижка Тогда 
		 Источник.Книжка = ЭтоКнижка;
	КонецЕсли;  
	
	Источник.ЛейблШифтер = ЛейблШифтер;
	
	Источник.ШтампыСтрокой =ШтампыСтрокой;
	Источник.ДопМатериалыСтрокой =ДопМатериалыСтрокой;
	СтруктураЦены = ПолучитьСреднююЦену(Источник.Ссылка);
	Если  Источник.Товары.Итог("Количество")>0 Тогда
		Источник.ЦенаСредняя =  Источник.Товары.Итог("Сумма")/Источник.Товары.Итог("Количество");
	КонецЕсли;
	Источник.ЦенаДляДокументовСредняя = СтруктураЦены.ЦенаДляДокументовСредняя;
	Источник.СуммаДокумента = Источник.Товары.Итог("СуммаСНДС")+Источник.СтоимостьОснастки;
	
	//Заполним Цвета
	Источник.ЦветаСтрокой = ПолучитьСтрокуЦветов(Источник.Ссылка);
	Если Источник.Цифровой Тогда
		Источник.ЦветаСтрокойЦифра = СтрокаЛакиПоЗаказу(Источник.Ссылка, Истина);
	КонецЕсли;
	Источник.ФормыСтрокой =ПолучитьСтрокуФорм(Источник.Ссылка);
	// --> Начало Лико Ефимов ЕВВ 18.08.2021 
	Источник.GtinСтрокой = ПолучитьGtinСтрокой(Источник);
	// <-- Конец Лико Ефимов ЕВВ 18.08.2021 
	//Первый Рабочий Центр
	//Если Заказ отправлен в работу, то рабочий центр не меняем
	Если Не ЗначениеЗаполнено(Источник.ДатаОтправкиВРаботу) Тогда 
		стр = Источник.ВидыРабот.Найти(1, "НомерПроката");
		Если стр<>Неопределено Тогда 
			Источник.РабочийЦентр = стр.РабочийЦентр;
		КонецЕсли;
	КонецЕсли;  
	
	Если Источник.РабочийЦентр.ПорядковыйНомер = 300 И Источник.Площадка = Справочники.Лико_Площадки.Ликофлекс Тогда 
		Источник.ГруппировкаДляОтчетов = Справочники.Лико_ГруппировкиОтчетовНаСайте.ИксПакДляЛикофлекс;
	ИначеЕсли Источник.Площадка = Справочники.Лико_Площадки.Ликофлекс И Источник.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Термоусадка Тогда 
		Источник.ГруппировкаДляОтчетов = Справочники.Лико_ГруппировкиОтчетовНаСайте.ЛикофлексТУ;    
	Иначе
		Источник.ГруппировкаДляОтчетов = Источник.Площадка.ГруппировкаДляОтчетов;
    КонецЕсли;
	
	
	// --> Начало Лико Ефимов ЕВВ 02.09.2024
	Источник.ЕстьНезаполненныеФормы = Ложь;
	Для каждого Строка из Источник.Цвета Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Форма)
			И ЗначениеЗаполнено(Строка.ВидТМЦ)
			И НЕ ВРег(СокрЛП(Строка.Название)) = ВРег("Полоса")
			И (Строка.ВидЗаливки = Перечисления.Лико_ВидЗаливки.НеСплошная
				ИЛИ Строка.ВидТМЦ = Справочники.Лико_ВидыТМЦ.Краска) 
			И НЕ (Строка.ВидСекции = Справочники.Лико_ВидыСекций.ЦифровойЛак
				ИЛИ Строка.ВидСекции = Справочники.Лико_ВидыСекций.Инкджет
				ИЛИ Строка.ВидСекции = Справочники.Лико_ВидыСекций.ЦифровоеТиснение
				ИЛИ Строка.ВидСекции = Справочники.Лико_ВидыСекций.Нумератор)
			И Строка.РабочийЦентр.ВидРабочегоЦентра <> Справочники.ВидыРабочихЦентров.СклейкаТермоусадки
			Тогда
			Источник.ЕстьНезаполненныеФормы = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	// <-- Конец Лико Ефимов ЕВВ 02.09.2024
		
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

	
Функция ПолучитьGtinСтрокой(ЗаказОбъект) // --> Начало Лико Ефимов ЕВВ 18.08.2021 
	
	МассивGtin = Новый Массив;
	Для каждого Строка из ЗаказОбъект.Товары Цикл
		Если ЗначениеЗаполнено(Строка.ЧестныйЗнак) И ЗначениеЗаполнено(Строка.ЧестныйЗнак.Gtin) Тогда
			МассивGtin.Добавить(СокрЛП(Строка.ЧестныйЗнак.Gtin));
		КонецЕсли;
	КонецЦикла;
	
	Если МассивGtin.Количество() = 0 Тогда
		Возврат "";
	Иначе
		МассивGtin = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивGtin);
		СтрокаGtin = "";
		Для каждого Gtin из МассивGtin Цикл
			СтрокаGtin = ?(ЗначениеЗаполнено(СтрокаGtin), СтрокаGtin + ", ", "") + Gtin;
		КонецЦикла;
		Возврат СтрокаGtin;
	КонецЕсли;

КонецФункции // <-- Конец Лико Ефимов ЕВВ 18.08.2021 

Процедура ПроставитьНомераРабот(Источник) Экспорт
//Необходимо проставить номера работ в рамках одного проката
	ТаблицаРабот = Новый ТаблицаЗначений;
	ТаблицаРабот.Колонки.Добавить("НомерПроката");
	ТаблицаРабот.Колонки.Добавить("ВидРабот");
	ТаблицаРабот.Колонки.Добавить("Оснастка");
	ТаблицаРабот.Колонки.Добавить("Материал");
	ТаблицаРабот.Колонки.Добавить("Клей");
	ТаблицаРабот.Колонки.Добавить("НомерРаботы");

	Для каждого стр из Источник.ВидыРабот Цикл
		Отбор = Новый Структура("НомерПроката, ВидРабот", стр.номерпроката, стр.ВидРабот);
		массивработ =  ТаблицаРабот.НайтиСтроки(Отбор);
		Если МассивРабот.Количество() = 0 Тогда 
			стр.НомерРаботы = 1;
			нстр = ТаблицаРабот.Добавить();
			ЗаполнитьЗначенияСвойств(нстр, стр);
		Иначе
			Если стр.ВидРабот.Родитель = Справочники.ВидыРаботСотрудников.Тиснение  Тогда 
			ОтборПовторов = Новый Структура("НомерПроката, ВидРабот, Оснастка, Материал, Клей", стр.НомерПроката, стр.ВидРабот, стр.Оснастка, стр.Материал, стр.Клей);
			массивработПовторов = ТаблицаРабот.НайтиСтроки(ОтборПовторов);
				Если массивработПОвторов.количество()>0 ТОгда 
					стр.НомерРаботы = массивработПовторов[0].номерработы;
				Иначе
					стр.номерработы = массивработ.Количество()+1;
					нстр = ТаблицаРабот.Добавить();
					ЗаполнитьЗначенияСвойств(нстр, стр);				
				КонецЕсли;
			Иначе
			    стр.номерработы = массивработ.Количество()+1;
				нстр = ТаблицаРабот.Добавить();
				ЗаполнитьЗначенияСвойств(нстр, стр);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры	

Процедура ЗаполнитьНомерПроката(Заказ, Цифровой = Ложь) Экспорт
НомерПроката = 1;
	НомерПрокатаОмеги = 2;
	
	МассивНайденныхРЦ = Новый Массив;                           
	
	Для Каждого стрВидРабот Из Заказ.ВидыРабот Цикл
		
		РЦ = стрВидРабот.РабочийЦентр;			
		Если МассивНайденныхРЦ.Найти(РЦ)= Неопределено Тогда
			
			Для Каждого стрВидРаботРЦ Из Заказ.ВидыРабот Цикл
				
				Если стрВидРаботРЦ.РабочийЦентр = РЦ Тогда 
					
					стрВидРаботРЦ.НомерПроката = НомерПроката;
					
					Если РЦ.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Omega ИЛИ РЦ.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Cartes Тогда 
						НомерПрокатаОмеги = НомерПроката;
					КонецЕсли;
					
					
				Иначе Продолжить;
					
				КонецЕсли;
				
			КонецЦикла;
			
			МассивНайденныхРЦ.Добавить(РЦ);
			
			НомерПроката = НомерПроката + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Цифровой Тогда 
		Для Каждого стр из Заказ.Цвета Цикл
			Если Не стр.видСекции = Справочники.Лико_ВидыСекций.Цифровая Тогда 
				стр.номерпроката = НомерПрокатаОмеги;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры


Функция ПолучитьСреднююЦену(Заказ)
	СтруктураЦены = Новый Структура("ЦенаСредняя, ЦенаДляДокументовСредняя", 0, 0);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Ссылка КАК Ссылка,
	|	СРЕДНЕЕ(ЗаказКлиентаТовары.Цена) КАК Цена,
	|	СРЕДНЕЕ(ЗаказКлиентаТовары.ЦенаДляДокументов) КАК ЦенаДляДокументов
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Ссылка";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Если ЗначениеЗаполнено(Результат.Цена) Тогда 
		СтруктураЦены.ЦенаСредняя = Результат.Цена;
	КонецЕсли;
	Если ЗначениеЗаполнено(Результат.ЦенаДляДокументов) Тогда 
		СтруктураЦены.ЦенаДляДокументовСредняя = Результат.ЦенаДляДокументов;
	КонецЕсли;
	Возврат СтруктураЦены;
	
	
КонецФункции	

Функция ПолучитьСтрокуЦветов(Заказ) Экспорт
	// --> Начало Лико Ефимов ЕВВ 29.05.2018 
	// --> Начало Лико Ефимов ЕВВ 04.08.2025 Для цифры сделали отдельный реквизит ЦветаСтрокойЦифра
	//Если Заказ.Цифровой Тогда
	//	СтрокаЦветов = СтрокаЛакиПоЗаказу(Заказ, Истина);
	//	Возврат СтрокаЦветов;			
	//КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 29.05.2018
	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЗаказКлиентаЦвета.ВидТМЦ = ЗНАЧЕНИЕ(Справочник.Лико_ВидыТМЦ.Краска)
	|			ТОГДА ЗаказКлиентаЦвета.ТипЦвета1
	|		ИНАЧЕ ЗаказКлиентаЦвета.ВидТМЦ
	|	КОНЕЦ КАК ТипЦвета,
	|	ЗаказКлиентаЦвета.Название КАК Название,
	|	ЗаказКлиентаЦвета.ПроцентЗаливки КАК ПроцентЗаливки,
	|	ЗаказКлиентаЦвета.ВидСекции КАК ВидСекции
	|ПОМЕСТИТЬ ТаблицаЦветов
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	|ГДЕ
	|	ЗаказКлиентаЦвета.Ссылка = &Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаЦветов.Название КАК Название,
	|	СУММА(ЕСТЬNULL(Лико_ПантоныСостав.O, 0)) КАК O,
	|	СУММА(ЕСТЬNULL(Лико_ПантоныСостав.V, 0)) КАК V
	|ПОМЕСТИТЬ Раскладка
	|ИЗ
	|	ТаблицаЦветов КАК ТаблицаЦветов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_Пантоны.Состав КАК Лико_ПантоныСостав
	|		ПО ТаблицаЦветов.Название = Лико_ПантоныСостав.Ссылка
	|			И (Лико_ПантоныСостав.O > 0
	|				ИЛИ Лико_ПантоныСостав.V > 0)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаЦветов.Название
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаЦветов.ВидСекции КАК ВидСекции,
	|	ТаблицаЦветов.ТипЦвета КАК ТипЦвета,
	|	ТаблицаЦветов.Название КАК Название,
	|	ТаблицаЦветов.ПроцентЗаливки КАК ПроцентЗаливки,
	|	Раскладка.O КАК O,
	|	Раскладка.V КАК V
	|ИЗ
	|	ТаблицаЦветов КАК ТаблицаЦветов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Раскладка КАК Раскладка
	|		ПО ТаблицаЦветов.Название = Раскладка.Название
	|ИТОГИ ПО
	|	ВидСекции";
	Запрос.УстановитьПараметр("Заказ",Заказ);
	ВыборкаВидСекции = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидСекции");
	СтрокаЦветов= "";
	сх = 0;
	O=Ложь;
	V=Ложь;
	Пока выборкаВидСекции.Следующий() Цикл
		Если сх>0 Тогда
			СтрокаЦветов =  СтрокаЦветов+", ";
		КонецЕсли;
		
		СтрокаЦветов = СтрокаЦветов+ВыборкаВидСекции.ВидСекции+ " ";
		Выборка = ВыборкаВидСекции.Выбрать();
		сч = 0;
		Пока Выборка.Следующий() Цикл
			Если сч>0 Тогда
				СтрокаЦветов =  СтрокаЦветов+"+ ";
			КонецЕсли;
			СтрокаЦветов = СтрокаЦветов+Выборка.ТипЦвета+" "+Выборка.Название+?(ЗначениеЗаполнено(Выборка.Название), " ","")+?(ЗначениеЗаполнено(Выборка.ПроцентЗаливки),Строка(Выборка.ПроцентЗаливки)+"% ",""); 	
			Если ЗначениеЗаполнено(Выборка.O) Тогда 
				O=Истина;
			КонецЕсли;
			Если  ЗначениеЗаполнено(Выборка.V) Тогда 
				V=Истина;
			КонецЕсли;
			
			
			сч=1;
		КонецЦикла;
		сх=1;
	КонецЦикла;
	Если ЗначениеЗаполнено(Заказ.Площадка) Тогда 
		Если Заказ.Площадка  = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЭкоФлекс.ЗначениеПараметра Тогда 
			
			Если V Тогда 
				СтрокаЦветов = "V, "+СтрокаЦветов;
			КонецЕсли;	
			Если O Тогда 
				СтрокаЦветов = "O, "+СтрокаЦветов;
			КонецЕсли;	
			
		КонецЕсли;	
	КонецЕсли;
	//числосимволов = стрДлина(строкацветов);
	//строкаЦветов = Лев(строкацветов, числосимволов-2);
	Возврат строкацветов;
КонецФункции	

// Формирует строку лаков в формате цифровых заказов
//
Функция СтрокаЛакиПоЗаказу(Заказ, СЛаминацией = Ложь) Экспорт // --> Начало Лико Ефимов ЕВВ 30.05.2018 
	Лаки = "";
	ЗапросЛаки = Новый Запрос;
	ЗапросЛаки.Текст =  
	"ВЫБРАТЬ
	|	ТЧ.ВидТМЦ КАК ВидТМЦ,
	|	ТЧ.ТипЦвета1 КАК ТипЦвета,
	|	ТЧ.ТипКраски КАК ТипКраски,
	|	ТЧ.Название КАК Название,
	|	ТЧ.ВидСекции КАК ВидСекции
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	&ТЧ КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЗаказКлиентаЦвета.ВидТМЦ = ЗНАЧЕНИЕ(Справочник.Лико_ВидыТМЦ.Краска)
	|			ТОГДА ЗаказКлиентаЦвета.Название
	|		КОГДА ЗаказКлиентаЦвета.ВидТМЦ = ЗНАЧЕНИЕ(Справочник.Лико_ВидыТМЦ.БесцветнаяМасса)
	|			ТОГДА ""БМ""
	|		ИНАЧЕ ЗаказКлиентаЦвета.ТипКраски.Код
	|	КОНЕЦ КАК Код,
	|	ЗаказКлиентаЦвета.ТипЦвета КАК ТипЦвета
	|ИЗ
	|	ВТ_ТЧ КАК ЗаказКлиентаЦвета
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ЗаказКлиентаЦвета.ВидТМЦ = ЗНАЧЕНИЕ(Справочник.Лико_ВидыТМЦ.Краска)
	|				ТОГДА ЗаказКлиентаЦвета.ТипЦвета В (ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.Pmc), ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.PmcПоОбразцу))
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И (ЗаказКлиентаЦвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ФлексоПечать)
	|			ИЛИ ЗаказКлиентаЦвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ТрафаретнаяПечать))";
	
	ЗапросЛаки.УстановитьПараметр("ТЧ", Заказ.Цвета.Выгрузить(,"ВидТМЦ,ТипЦвета1,ТипКраски,Название,ВидСекции"));
	ВыборкаЛаки = ЗапросЛаки.Выполнить().Выбрать();
	Пока ВыборкаЛаки.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаЛаки.Код) Тогда 
			Лаки = Лаки + ?(ЗначениеЗаполнено(Лаки),",", "") + СокрЛП(ВыборкаЛаки.Код);
		КонецЕсли;	
	КонецЦикла;
	Если СЛаминацией И Заказ.Ламинация Тогда
		Лаки = Лаки + ?(ЗначениеЗаполнено(Лаки), ",", "") + "ЛАМ";
	КонецЕсли;
	Возврат Лаки;
	
КонецФункции 


Функция ПолучитьСтрокуФорм(Заказ) Экспорт
	стрФормы = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СпецификацииНоменклатурыФормы.Значение.ВидПечати КАК ВидПечати,
	|	СпецификацииНоменклатурыФормы.Значение.Код КАК Значение
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК СпецификацииНоменклатурыЦвета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Формы КАК СпецификацииНоменклатурыФормы
	|		ПО СпецификацииНоменклатурыЦвета.Ссылка = СпецификацииНоменклатурыФормы.Ссылка
	|			И СпецификацииНоменклатурыЦвета.КлючСтроки = СпецификацииНоменклатурыФормы.КлючСтроки
	|ГДЕ
	|	СпецификацииНоменклатурыЦвета.Ссылка = &Заказ
	|ИТОГИ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Значение)
	|ПО
	|	ВидПечати";
	Запрос.УстановитьПараметр("Заказ",Заказ);
	ВыборкаВидПечати = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидПечати");
	Пока ВыборкаВидПечати.Следующий() Цикл
		стрФормы = стрФормы+ВыборкаВидПечати.ВидПечати+": ";
		Выборка = ВыборкаВидПечати.Выбрать();
		Пока Выборка.Следующий() Цикл
			стрФормы = стрФормы+Выборка.Значение+ " ";
		КонецЦикла;
	КонецЦикла;
	Возврат стрФормы;
КонецФункции

//Определить количество кликов
Функция УстановитьЧислоКликов(Ссылка, НомерВарианта = 1) Экспорт  
		КоличествоКликов = 0;
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Лико_Спецификации") Тогда 
		ИмяТаблицы = "Справочник.Лико_Спецификации";
	Иначе
		ИмяТаблицы = "Документ.ЗаказКлиента";
	КонецЕсли;

	//	Проверяем возможность расчета кликов, если для pmc не установлено значение из справочника пантонов, количество кликов = 6 + белила
	Запрос =Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	ТаблицаЦветов.НомерСтроки КАК НомерСтроки,
	|	ТаблицаЦветов.ТипЦвета1 КАК ТипЦвета
	|ИЗ
	|	"+ИмяТаблицы+".Цвета КАК ТаблицаЦветов
	|ГДЕ
	|	ТаблицаЦветов.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Цифровая)
	|	И (ТаблицаЦветов.Название = ЗНАЧЕНИЕ(Справочник.Лико_Пантоны.ПустаяСсылка)
	|			ИЛИ НЕ ТаблицаЦветов.Название ССЫЛКА Справочник.Лико_Пантоны)
	|	И ТаблицаЦветов.Ссылка = &Ссылка
	|	И (ТаблицаЦветов.ТипЦвета1 = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.Pmc)
	|			ИЛИ ТаблицаЦветов.ТипЦвета1 = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.PmcПоОбразцу))
	|	И ТаблицаЦветов.НомерВарианта = &НомерВарианта";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("НомерВарианта", НомерВарианта);

	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Если ЗначениеЗаполнено(Результат.ТипЦвета) Тогда
		//Определим количество белил
		ЗапросБелила = Новый Запрос;
		ЗапросБелила.текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(ЕСТЬNULL(ТаблицаЦветов.ТипЦвета1, 0)) КАК КоличествоБелил,
		|	ТаблицаЦветов.Ссылка КАК Заказ
		|ИЗ
		|	"+ИмяТаблицы+".Цвета КАК ТаблицаЦветов
		|ГДЕ
		|	ТаблицаЦветов.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Цифровая)
		|	И ТаблицаЦветов.Ссылка = &Ссылка
		|	И ТаблицаЦветов.ТипЦвета1 = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.Белый)
		|	И ТаблицаЦветов.НомерВарианта = &НомерВарианта
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаЦветов.Ссылка";
		ЗапросБелила.УстановитьПараметр("Ссылка", Ссылка);
		ЗапросБелила.УстановитьПараметр("НомерВарианта", НомерВарианта);

		РезультатБелила = ЗапросБелила.Выполнить().Выбрать();
		РезультатБелила.Следующий();
		Если ЗначениеЗаполнено(РезультатБелила.КоличествоБелил) Тогда 
			КоличествоКликов = РезультатБелила.КоличествоБелил+6;
		Иначе
			КоличествоКликов = 6;
		КонецЕсли;
		
		Возврат  КоличествоКликов;
	КонецЕсли;
	
	//Получим группу материала и рабочий центр
	ТипМатериала = "";
	Если ТипЗнч(Ссылка.ОсновнойМатериал) = Тип("Справочникссылка.Номенклатура") Тогда 
		Материал = Ссылка.ОсновнойМатериал.ЦеноваяГруппа;
	ИначеЕсли ТипЗнч(Ссылка.ОсновнойМатериал) = Тип("Справочникссылка.ЦеновыеГруппы") Тогда
		Материал = Ссылка.ОсновнойМатериал;
	КонецЕсли;
	Если   Найти(НРег(Материал.Наименование), "crystal")>0 ИЛИ Найти(НРег(Материал.Наименование), "прозрачная")>0 Тогда		
		ТипМатериала = "Пленка прозрачная";
	КонецЕсли;
	Если  Найти(НРег(Материал.Наименование), "бумага")>0 Тогда
		Если Найти(НРег(Материал.Наименование), "метал")>0 Тогда
			ТипМатериала = "Бумага металлизированная";
		Иначе
			ТипМатериала = "Бумага";
		КонецЕсли;
	КонецЕсли;
	Если  Найти(НРег(Материал.Наименование), "пленка")>0 Тогда
		Если Найти(НРег(Материал.Наименование), "метал")>0 Тогда
			ТипМатериала = "Пленка металлизированная";
		Иначе
			ТипМатериала = "Пленка";
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТипМатериала) Тогда 
		ТипМатериала = "Бумага";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаВидыРабот.РабочийЦентр КАК РабочийЦентр
	|ИЗ
	|	"+ИмяТаблицы+".ВидыРабот КАК ТаблицаВидыРабот
	|ГДЕ
	|	ТаблицаВидыРабот.Ссылка = &Ссылка
	|	И ТаблицаВидыРабот.ВидРабот = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Печать)
	|	И ТаблицаВидыРабот.НомерВарианта = &НомерВарианта";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("НомерВарианта", НомерВарианта);

	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Если Не ЗначениеЗаполнено(Результат.РабочийЦентр) Тогда
		Сообщить("Расчет кликов производится только для конкретной машины (вид работ -Печать).");
		Возврат 0;
	Иначе РабочийЦентр = Результат.РабочийЦентр;	
	КонецЕсли;
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
|	ЕСТЬNULL(ВложенныйЗапрос.Заказ, ВложенныйЗапрос1.Ссылка) КАК Заказ,
|	ВложенныйЗапрос.КоличествоКликов + ЕСТЬNULL(ВложенныйЗапрос1.КоличествоБелил, 0) КАК КоличествоКликов,
|	ВложенныйЗапрос1.КоличествоБелил КАК КоличествоБелил,
|	ВложенныйЗапрос1.Ссылка КАК Ссылка
|ИЗ
|	(ВЫБРАТЬ
|		ВложенныйЗапрос.C + ВложенныйЗапрос.M + ВложенныйЗапрос.Y + ВложенныйЗапрос.K + ВложенныйЗапрос.O + ВложенныйЗапрос.V КАК КоличествоКликов,
|		ВложенныйЗапрос.Заказ КАК Заказ
|	ИЗ
|		(ВЫБРАТЬ
|			МАКСИМУМ(ВЫБОР
|					КОГДА ВложенныйЗапрос.ТипЦвета = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.C)
|						ТОГДА ВложенныйЗапрос.Количество
|					ИНАЧЕ ВЫБОР
|							КОГДА ВложенныйЗапрос1.C > 0
|								ТОГДА 1
|							ИНАЧЕ 0
|						КОНЕЦ
|				КОНЕЦ) КАК C,
|			МАКСИМУМ(ВЫБОР
|					КОГДА ВложенныйЗапрос.ТипЦвета = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.M)
|						ТОГДА ВложенныйЗапрос.Количество
|					ИНАЧЕ ВЫБОР
|							КОГДА ВложенныйЗапрос1.M > 0
|								ТОГДА 1
|							ИНАЧЕ 0
|						КОНЕЦ
|				КОНЕЦ) КАК M,
|			МАКСИМУМ(ВЫБОР
|					КОГДА ВложенныйЗапрос.ТипЦвета = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.Y)
|						ТОГДА ВложенныйЗапрос.Количество
|					ИНАЧЕ ВЫБОР
|							КОГДА ВложенныйЗапрос1.Y > 0
|								ТОГДА 1
|							ИНАЧЕ 0
|						КОНЕЦ
|				КОНЕЦ) КАК Y,
|			МАКСИМУМ(ВЫБОР
|					КОГДА ВложенныйЗапрос.ТипЦвета = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.K)
|						ТОГДА ВложенныйЗапрос.Количество
|					ИНАЧЕ ВЫБОР
|							КОГДА ВложенныйЗапрос1.K > 0
|								ТОГДА 1
|							ИНАЧЕ 0
|						КОНЕЦ
|				КОНЕЦ) КАК K,
|			МАКСИМУМ(ВЫБОР
|					КОГДА ВложенныйЗапрос1.O > 0
|						ТОГДА 1
|					ИНАЧЕ 0
|				КОНЕЦ) КАК O,
|			МАКСИМУМ(ВЫБОР
|					КОГДА ВложенныйЗапрос1.V > 0
|						ТОГДА 1
|					ИНАЧЕ 0
|				КОНЕЦ) КАК V,
|			ЕСТЬNULL(ВложенныйЗапрос.Ссылка, ВложенныйЗапрос1.Ссылка) КАК Заказ
|		ИЗ
|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
|				ТаблицаЦвета.Ссылка КАК Ссылка,
|				МАКСИМУМ(Лико_ПантоныСостав.C) КАК C,
|				МАКСИМУМ(Лико_ПантоныСостав.M) КАК M,
|				МАКСИМУМ(Лико_ПантоныСостав.Y) КАК Y,
|				МАКСИМУМ(Лико_ПантоныСостав.K) КАК K,
|				МАКСИМУМ(Лико_ПантоныСостав.O) КАК O,
|				МАКСИМУМ(Лико_ПантоныСостав.V) КАК V
|			ИЗ
|				"+ИмяТаблицы+".Цвета КАК ТаблицаЦвета
|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_Пантоны.Состав КАК Лико_ПантоныСостав
|					ПО ТаблицаЦвета.Название = Лико_ПантоныСостав.Ссылка
|			ГДЕ
|				ТаблицаЦвета.Ссылка = &Ссылка
|				И ТаблицаЦвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Цифровая)
|				И (ТаблицаЦвета.ТипЦвета1 = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.Pmc)
|						ИЛИ ТаблицаЦвета.ТипЦвета1 = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.PmcПоОбразцу))
|				И ВЫБОР
|						КОГДА Лико_ПантоныСостав.Ссылка.Тип = ЗНАЧЕНИЕ(Перечисление.Лико_ТипПантона.Эконом)
|							ТОГДА Лико_ПантоныСостав.Материал = ""Пленка прозрачная""
|						ИНАЧЕ Лико_ПантоныСостав.Материал = &Материал
|					КОНЕЦ
|				И ТаблицаЦвета.НомерВарианта = &НомерВарианта
|			
|			СГРУППИРОВАТЬ ПО
|				ТаблицаЦвета.Ссылка) КАК ВложенныйЗапрос1
|				ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
|					ТаблицаЦвета.ТипЦвета1 КАК ТипЦвета,
|					ТаблицаЦвета.Ссылка КАК Ссылка,
|					КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТаблицаЦвета.НомерСтроки) КАК Количество
|				ИЗ
|					"+ИмяТаблицы+".Цвета КАК ТаблицаЦвета
|				ГДЕ
|					ТаблицаЦвета.Ссылка = &Ссылка
|					И ТаблицаЦвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Цифровая)
|					И (ТаблицаЦвета.ТипЦвета1 = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.C)
|							ИЛИ ТаблицаЦвета.ТипЦвета1 = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.M)
|							ИЛИ ТаблицаЦвета.ТипЦвета1 = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.Y)
|							ИЛИ ТаблицаЦвета.ТипЦвета1 = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.K))
|					И ТаблицаЦвета.НомерВарианта = &НомерВарианта
|				
|				СГРУППИРОВАТЬ ПО
|					ТаблицаЦвета.Ссылка,
|					ТаблицаЦвета.ТипЦвета1) КАК ВложенныйЗапрос
|				ПО ВложенныйЗапрос1.Ссылка = ВложенныйЗапрос.Ссылка
|		
|		СГРУППИРОВАТЬ ПО
|			ЕСТЬNULL(ВложенныйЗапрос.Ссылка, ВложенныйЗапрос1.Ссылка)) КАК ВложенныйЗапрос) КАК ВложенныйЗапрос
|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
|			КОЛИЧЕСТВО(ТаблицаЦвета.ТипЦвета1) КАК КоличествоБелил,
|			ТаблицаЦвета.Ссылка КАК Ссылка
|		ИЗ
|			"+ИмяТаблицы+".Цвета КАК ТаблицаЦвета
|		ГДЕ
|			ТаблицаЦвета.Ссылка = &Ссылка
|			И ТаблицаЦвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Цифровая)
|			И ТаблицаЦвета.ТипЦвета1 = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.Белый)
|			И ТаблицаЦвета.НомерВарианта = &НомерВарианта
|		
|		СГРУППИРОВАТЬ ПО
|			ТаблицаЦвета.Ссылка) КАК ВложенныйЗапрос1
|		ПО ВложенныйЗапрос.Заказ = ВложенныйЗапрос1.Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Материал", ТипМатериала);
	Запрос.УстановитьПараметр("НомерВарианта", НомерВарианта);

	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();	
	Возврат Результат.КоличествоКликов;
КонецФункции	

//Заполняем этикетки в ОМ, данные в параметрах штампа
Процедура ЗаполнитьСвязанныеДанные(Заказ) Экспорт
	// --> Начало Лико Ефимов ЕВВ 02.08.2021
	Если НЕ ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 02.08.2021
	ЗапросШтампы = Новый Запрос;
	ЗапросШтампы.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаВидыРабот.Оснастка КАК Оснастка
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|		ПО ЗаказКлиентаВидыРабот.Оснастка = Лико_ПараметрыШтампа.Номенклатура
	|			И ЗаказКлиентаВидыРабот.Ссылка.Ссылка = Лико_ПараметрыШтампа.Заказ
	|			И ЗаказКлиентаВидыРабот.Ссылка.Партнер = Лико_ПараметрыШтампа.Партнер
	|			И ЗаказКлиентаВидыРабот.Ссылка.Менеджер = Лико_ПараметрыШтампа.Менеджер
	|ГДЕ
	|	Лико_ПараметрыШтампа.Номенклатура ЕСТЬ NULL
	|	И ЗаказКлиентаВидыРабот.Оснастка.ВидНоменклатуры = &Оснастка
	|	И ЗаказКлиентаВидыРабот.Ссылка = &Заказ";
	ЗапросШтампы.УстановитьПараметр("Заказ", Заказ);
	ЗапросШтампы.УстановитьПараметр("Оснастка", Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыОснастка.ЗначениеПараметра);
	ВыборкаШтампы = ЗапросШтампы.Выполнить().Выбрать();
	Пока ВыборкаШтампы.Следующий() Цикл
		Запись =РегистрыСведений.Лико_ПараметрыШтампа.СоздатьМенеджерЗаписи();
		Запись.Номенклатура = ВыборкаШтампы.Оснастка;
		Запись.Прочитать();
		Запись.Номенклатура = ВыборкаШтампы.Оснастка;
		Запись.Партнер = Заказ.Партнер;
		Запись.Менеджер = Заказ.Менеджер;
		Запись.Заказ = Заказ;
		Запись.Записать();	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказКлиентаТовары.Ссылка КАК Заказ,
	|	ЗаказКлиентаТовары.ОригиналМакет КАК ОМ,
	|	ЗаказКлиентаТовары1.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТОМ
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары1
	|		ПО ЗаказКлиентаТовары.Ссылка = ЗаказКлиентаТовары1.Ссылка
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ
	|	И ЗаказКлиентаТовары.ОригиналМакет <> ЗНАЧЕНИЕ(Справочник.Лико_ОригиналМакеты.Пустаяссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОМ.ОМ КАК ОМ,
	|	ВТОМ.Номенклатура КАК Номенклатура
	|ИЗ
	|	ВТОМ КАК ВТОМ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ОригиналМакеты.Этикетки КАК Лико_ОригиналМакетыЭтикетки
	|		ПО ВТОМ.ОМ = Лико_ОригиналМакетыЭтикетки.Ссылка
	|			И ВТОМ.Номенклатура = Лико_ОригиналМакетыЭтикетки.Номенклатура
	|ГДЕ
	|	Лико_ОригиналМакетыЭтикетки.Ссылка ЕСТЬ NULL
	|ИТОГИ ПО
	|	ОМ";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	ВыборкаОМ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ОМ");
	Пока ВыборкаОМ.Следующий() Цикл
		ОМ = ВЫборкаОМ.ОМ.ПолучитьОбъект();
		Выборка = ВыборкаОМ.Выбрать();
		Пока Выборка.Следующий() Цикл
			стр = ОМ.Этикетки.Добавить();
			стр.Номенклатура = Выборка.Номенклатура;
		КонецЦикла;
		ОМ.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ПереписатьАртикулыНоменклатуры(Заказ) Экспорт    
	УстановитьПривилегированныйРежим(Истина);	

	ВидЗаказа = Заказ.ВидЗаказа;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	|	ЗаказКлиентаТовары.Ссылка КАК Заказ
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ
	|	И ЗаказКлиентаТовары.Номенклатура.ВидНоменклатуры.Лико_НоменклатураЭтикеток = ИСТИНА
	|	И НЕ ЗаказКлиентаТовары.Номенклатура.Лико_DFM
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Номенклатура,
	|	ЗаказКлиентаТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Номенклатура КАК Номенклатура,
	|	КОЛИЧЕСТВО(ЗаказКлиентаТовары.Ссылка) КАК КоличествоДругихЗаказов
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ПО ВТ.Заказ <> ЗаказКлиентаТовары.Ссылка
	|			И ВТ.Номенклатура = ЗаказКлиентаТовары.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Номенклатура";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НомОбъект = Выборка.Номенклатура.ПолучитьОбъект();
		КодБезНулей = КодБезНулей(НомОбъект.Код);
		ДлинаКода = СтрДлина(КодБезНулей);
		Если Сред(НомОбъект.Артикул,1, ДлинаКода)<> КодБезНулей ИЛИ Сред(НомОбъект.Артикул,ДлинаКода+1,1)<>"-" Тогда
			НомОбъект.Артикул = КодБезНулей + "-0";
			Попытка
				НомОбъект.Записать();
			Исключение	
			КонецПопытки;
		Иначе
			Если Не Заказ.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.ВплавляемаяЭтикетка Тогда 
				Если ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПовторСИзменением ИЛИ ВидЗаказа = Перечисления.Лико_ВидыЗаказов.СложныйПовтор ИЛИ ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПолныйПовторСПереводомНаДругуюМашину ИЛИ ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Новый Тогда
					//Начало изменений 20171003 Иванова - Илья просил не менять артикулы у цифровых заказов
					//Начало изменений 201908.29 Иванова А.В. - если отправляется заказ, в котором была создана этикетка, версию не поднимаем
					Если Не Заказ.РабочийЦентр.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Indigo И Выборка.КоличествоДругихЗаказов > 0  Тогда 
						ДлинаАртикула = СтрДлина(НомОбъект.Артикул);
						Если ДлинаАртикула - ДлинаКода = 2 Тогда
							ПоследнийСимвол = Прав(НомОбъект.Артикул, 1);
						ИначеЕсли ДлинаАртикула - ДлинаКода = 3 Тогда
							ПоследнийСимвол = Прав(НомОбъект.Артикул, 2);
						КонецЕсли;
													
						Если ЗначениеЗаполнено(ПоследнийСимвол) Тогда 
							НомОбъект.Артикул = Лев(НомОбъект.Артикул,ДлинаКода) + "-"+Строка(Число(ПоследнийСимвол)+1);
						Иначе
							НомОбъект.Артикул = КодБезНулей + "-0";
						КонецЕсли;
						Попытка
							НомОбъект.Записать();
						Исключение	
						КонецПопытки;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;		
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);	
КонецПроцедуры	
	
Процедура ЗаполнитьРЦВФормах(Заказ) Экспорт
	Если ЗначениеЗаполнено(Заказ.РабочийЦентр) Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаказКлиентаФормы.Значение КАК Форма
		|ИЗ
		|	Документ.ЗаказКлиента.Формы КАК ЗаказКлиентаФормы
		|ГДЕ
		|	ЗаказКлиентаФормы.Ссылка = &Заказ
		|	И ЗаказКлиентаФормы.Значение.РабочийЦентр <> ЗаказКлиентаФормы.Ссылка.РабочийЦентр
		|	И НЕ ЗаказКлиентаФормы.Значение.Сплошная";
		Запрос.УстановитьПараметр("Заказ", Заказ);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ФормаОбъект = Выборка.Форма.ПолучитьОбъект();
			ФормаОбъект.РабочийЦентр = Заказ.РабочийЦентр;
			ФормаОбъект.Записать();
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура УточнитьНомераФорм(Заказ) Экспорт
Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаФормы.Значение КАК Форма
	|ИЗ
	|	Документ.ЗаказКлиента.Формы КАК ЗаказКлиентаФормы
	|ГДЕ
	|	ЗаказКлиентаФормы.Ссылка = &Заказ
	|	И ПОДСТРОКА(ЗаказКлиентаФормы.Значение.Код, 7, 1) = """"
	|	И НЕ ЗаказКлиентаФормы.Значение.Сплошная";
		Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл	
		Префикс = Заказ.НомерБезПрефикса;
		Попытка
			Объект = Выборка.Форма.ПолучитьОбъект();
		    Объект.УстановитьНовыйКод(Префикс);
			Объект.Записать();
		Исключение;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры


Функция КодБезНулей(Код) Экспорт
	Номер = СокрЛП(Код);
	//Удаляем префикс
	Цифры = "1234567890";
	Пока Найти(Цифры, Лев(Номер, 1)) = 0  Цикл
		Номер = Сред(Номер, 2);
	КонецЦикла;
	// удаление ведущих нулей
	Пока Лев(Номер, 1)="0" Цикл
		Номер = Сред(Номер, 2);
	КонецЦикла;
	Возврат Номер;
КонецФункции


//Выгрузка заказа в XML
Процедура ВыгрузитьЗаказXML(Заказ)  Экспорт
		Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЗаказКлиентаВидыРабот.ВидРабот.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Тиснение)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Тиснение,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЗаказКлиентаВидыРабот.ВидРабот.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Конгревы)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
