		|	Лико_ПараметрыРасчетаНормативов.Ссылка = ЗНАЧЕНИЕ(Справочник.Лико_ПараметрыРасчетаНормативов.КодЦеновойГруппы)
		|	И ЗаказКлиента.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗНАЧЕНИЕ(Справочник.Лико_ПараметрыРасчетаНормативов.ПраймированиеНаЦифре),
		|	1
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаВидыРабот
		|ГДЕ
		|	ЗаказКлиентаВидыРабот.Ссылка = &Ссылка
		|	И ЗаказКлиентаВидыРабот.НомерПроката = &НомерПроката
		|	И ЗаказКлиентаВидыРабот.НомерВарианта = &НомерВарианта
		|	И ЗаказКлиентаВидыРабот.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.indigo)
		|	И ЗаказКлиентаВидыРабот.Ссылка.Праймер <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	И ЗаказКлиентаВидыРабот.Ссылка.Праймер <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
		|	И ЗаказКлиентаВидыРабот.Ссылка.Праймер <> НЕОПРЕДЕЛЕНО
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Лико_ПараметрыРасчетаНормативов.Ссылка,
		|	СУММА(1)
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаВидыРабот
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ПараметрыРасчетаНормативов КАК Лико_ПараметрыРасчетаНормативов
		|		ПО (Лико_ПараметрыРасчетаНормативов.Ссылка = ЗНАЧЕНИЕ(Справочник.Лико_ПараметрыРасчетаНормативов.НумерацияНаЦифре))
		|ГДЕ
		|	ЗаказКлиентаВидыРабот.Ссылка = &Ссылка
		|	И ЗаказКлиентаВидыРабот.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Нумератор)
		|	И ЗаказКлиентаВидыРабот.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.indigo)
		|
		|СГРУППИРОВАТЬ ПО
		|	Лико_ПараметрыРасчетаНормативов.Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ссылка);
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);
	Запрос.УстановитьПараметр("НомерВарианта", НомерВарианта);
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Лико_Спецификации") Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВЫБРАТЬ
		                                         |	ЗаказКлиента.Ссылка КАК Заказ,
		                                         |	ЗаказКлиента.Ручьи КАК Ручьи,
		                                         |	ЗаказКлиента.КоличествоКликов КАК КоличествоКликов
		                                         |ПОМЕСТИТЬ ВТ_ПараметрыШтампа
		                                         |ИЗ
		                                         |	Документ.ЗаказКлиента КАК ЗаказКлиента
		                                         |ГДЕ
		                                         |	ЗаказКлиента.Ссылка = &Ссылка" , 
		"ВЫБРАТЬ
		|	Лико_Спецификации.Ссылка КАК Заказ,
		|	Лико_Спецификации.Ручьи КАК Ручьи,
		|	Лико_Спецификации.КоличествоКликов КАК КоличествоКликов
		|ПОМЕСТИТЬ ВТ_ПараметрыШтампа
		|ИЗ
		|	Справочник.Лико_Спецификации КАК Лико_Спецификации
		|ГДЕ
		|	Лико_Спецификации.Ссылка = &Ссылка");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Документ.ЗаказКлиента", "Справочник.Лико_Спецификации");
	КонецЕсли;
	Если ЗначениеЗаполнено(Ссылка.КоличествоКликов) Тогда
		ДобавитьЗначениеПоказателя(Ссылка, НомерВарианта, НомерПроката, Справочники.Лико_ПараметрыРасчетаНормативов.КоличествоКликов, Ссылка.КоличествоКликов);
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;	

#КонецОбласти
	КоличествоЦветов = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		//ПоказателиДляТаблиц.Вставить(Выборка.ВидРабот, Выборка.КоличествоРабот);
		Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Выборка.Показатель)) Тогда 
			Если  Выборка.Показатель =Справочники.Лико_ПараметрыРасчетаНормативов.КоличествоЦветовОфсет ИЛИ  Выборка.Показатель =Справочники.Лико_ПараметрыРасчетаНормативов.КоличествоЦветовФлексо
				ИЛИ  Выборка.Показатель =Справочники.Лико_ПараметрыРасчетаНормативов.КоличествоЦветовГлубокая ИЛИ  Выборка.Показатель =Справочники.Лико_ПараметрыРасчетаНормативов.ЛакВыборочный
				ИЛИ Выборка.Показатель =Справочники.Лико_ВидыСекций.ТиснениеХолодноеФлексо ИЛИ Выборка.Показатель = Справочники.Лико_ВидыСекций.ЛаминацияФлексо ИЛИ Выборка.Показатель = Справочники.Лико_ВидыСекций.ГлубокаяЛаминация ИЛИ Выборка.Показатель = Справочники.Лико_ВидыСекций.БессольвентнаяЛаминация Тогда					   
				КоличествоЦветов = КоличествоЦветов + Выборка.ЗначениеПоказателя; 
			КонецЕсли; 
			ДобавитьЗначениеПоказателя(Ссылка,НомерВарианта, НомерПроката, Выборка.ПОказатель, Выборка.ЗначениеПоказателя);
		Иначе
			ДобавитьЗначениеПоказателя(Ссылка, НомерВарианта, НомерПроката, Выборка.ПОказатель, 1);
		КонецЕсли;
		
	КонецЦикла;
	//Добавляем и нулевое количество цветов тоже
	//Если ЗначениеЗаполнено(КоличествоЦветов) Тогда 
		ДобавитьЗначениеПоказателя(Ссылка,НомерВарианта, НомерПроката, Справочники.Лико_ПараметрыРасчетаНормативов.КоличествоЦветов, КоличествоЦветов);
	//КонецЕсли;
	
	Если Ссылка["Цвета"].Количество() = 0 Тогда 
		ДобавитьЗначениеПоказателя(Ссылка,НомерВарианта, НомерПроката, Справочники.Лико_ПараметрыРасчетаНормативов.БезПечати, 1);
	КонецЕсли;
	
КонецПроцедуры            


Процедура ДобавитьЗначениеПоказателя(Заказ, НомерВарианта = 1, НомерПроката, ПОказатель, ЗначениеПоказателя)
	НоваяЗапись =РегистрыСведений.Лико_ПоказателиРасчетаЗаказа.СоздатьМенеджерЗаписи();
	НоваяЗапись.Заказ = Заказ;
	НоваяЗапись.НомерВарианта = НомерВарианта;
	НоваяЗапись.НомерПроката = НомерПроката;
	НоваяЗапись.ПОказатель = ПОказатель;
	НоваяЗапись.ЗначениеПоказателя = ЗначениеПоказателя;
	НоваяЗапись.Записать();
	
КонецПроцедуры

//Расчет технических параметров для РЦ по спецификации или Заказу    
//возвращает структуру, содержащую все вычисленные параметры
Функция РассчитатьНормативыДляРЦ(Заказ, ПогонныйМетраж,  РабочийЦентр, МетрыНаБракПредыдущихПеределов, МетрыНаНастройкуПредыдущихПеределов, НомерПроката, КоличествоЭтикетокЗаданное,  ВариантРасчета = 1, НомерВарианта = 1)    Экспорт
		
	Если ТипЗнч(Заказ) = Тип("СправочникСсылка.Лико_Спецификации") Тогда 
		ИмяТаблицы = "Справочник.Лико_Спецификации";
		// <-- Начало Лико Яцун С. В. 21.08.2024
		//стрШтамп = Заказ.параметрыШтампа.Найти(НомерВарианта, "НомерВарианта");
		стрШтамп = Заказ;
		// <-- Конец Лико Яцун С. В. 21.08.2024
	Иначе
		ИмяТаблицы = "Документ.ЗаказКлиента";
		стрШтамп = Заказ;
	КонецЕсли;
	
	// --> Начало Лико Митюшин МФМ 07.04.2021
	лРучьи = Лико_ТиражМетраж.РучьиОтШтампа(стрШтамп);
	// <-- Конец Лико Митюшин МФМ 07.04.2021
	
	ЗапросПоказатели =   Новый Запрос;
	ЗапросПоказатели.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПоказателиРасчетаЗаказа.ЗначениеПоказателя КАК ЗначениеПоказателя,
	|	Лико_ПоказателиРасчетаЗаказа.Показатель КАК Показатель
	|ИЗ
	|	РегистрСведений.Лико_ПоказателиРасчетаЗаказа КАК Лико_ПоказателиРасчетаЗаказа
	|ГДЕ
	|	Лико_ПоказателиРасчетаЗаказа.Заказ = &Заказ
	|	И Лико_ПоказателиРасчетаЗаказа.НомерПроката = &НомерПроката
	|	И Лико_ПоказателиРасчетаЗаказа.НомерВарианта = &НомерВарианта";
	ЗапросПоказатели.УстановитьПараметр("Заказ", Заказ);
	ЗапросПоказатели.УстановитьПараметр("НомерПроката", НомерПроката);
	ЗапросПоказатели.УстановитьПараметр("НомерВарианта", НомерВарианта);
	
	ТабПоказатели = ЗапросПоказатели.Выполнить().выгрузить();
	
	ВремяНаНастройку = 0;
	МетрыНаНастройку = 0;
	ВремяНаМойкуСекций = 0;
	МойкаСекций = 0;
	
	РассчитанныеПараметры = Новый структура; //Помещаем в структуры рассчитанные метры на настройку, скорость печати и т.д. 
	
	//Для заказов, входящих в серию, кроме первого настройку не считаем.
	Настройка = Истина;
	Если Заказ.СерийныйЗаказ И Заказ.ПервыйВСерии <> Заказ ТОгда 
		Настройка = Ложь;
	КонецЕсли;
	
	//Запрос для метров на настройку
	
	ЗапросНормативы = Новый Запрос;
	ЗапросНормативы.Текст=
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лико_ПоказателиРасчетаЗаказа.Показатель КАК Показатель,
	|	Лико_ПоказателиРасчетаЗаказа.ЗначениеПоказателя КАК ЗначениеПоказателя
	|ПОМЕСТИТЬ ВТаблицаПараметров
	|ИЗ
	|	РегистрСведений.Лико_ПоказателиРасчетаЗаказа КАК Лико_ПоказателиРасчетаЗаказа
	|ГДЕ
	|	Лико_ПоказателиРасчетаЗаказа.Заказ = &Заказ
	|	И Лико_ПоказателиРасчетаЗаказа.НомерПроката = &НомерПроката
	|	И Лико_ПоказателиРасчетаЗаказа.НомерВарианта = &НомерВарианта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.НомерВарианта, Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.НомерВарианта) КАК НомерВарианта,
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.Ссылка, Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.Ссылка) КАК Ссылка
	|ПОМЕСТИТЬ Таб
	|ИЗ
	|	Справочник.РабочиеЦентры КАК РабочиеЦентры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.РабочиеЦентры КАК Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры
	|		ПО (Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.Ссылка = &Ссылка)
	|			И РабочиеЦентры.Ссылка = Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.РабочийЦентр
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.РабочиеЦентры КАК Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1
	|		ПО РабочиеЦентры.ВидРабочегоЦентра = Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.РабочийЦентр
	|			И (Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.Ссылка = &Ссылка)
	|ГДЕ
	|	РабочиеЦентры.Ссылка = &РабочийЦентр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ВариантРасчета, 1) КАК ВариантРасчета
	|ПОМЕСТИТЬ ВариантыРасчета
	|ИЗ
	|	Таб КАК Таб
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.ТаблицаПоказателей КАК Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей
	|		ПО Таб.Ссылка = Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Ссылка
	|			И Таб.НомерВарианта = Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.НомерВарианта
	|			И (Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ВариантРасчета = &ВариантРасчета)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ВариантРасчета, 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(ВЫБОР
	|				КОГДА Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ОднократноеЗначение = ИСТИНА
	|					ТОГДА Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ЗначениеПоказателя
	|				ИНАЧЕ Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ЗначениеПоказателя * ВТаблицаПараметров.ЗначениеПоказателя
	|			КОНЕЦ, 0)) КАК Норматив,
	|	СУММА(ВТаблицаПараметров.ЗначениеПоказателя) КАК ЗначениеПараметра
	|ИЗ
	|	Таб КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.ТаблицаПоказателей КАК Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТаблицаПараметров КАК ВТаблицаПараметров
	|			ПО Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель = ВТаблицаПараметров.Показатель
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТаблицаПараметров КАК ВТаблицаПараметров2
	|			ПО Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель2 = ВТаблицаПараметров2.Показатель
	|				И Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ЗначениеПоказателя2 <= ВТаблицаПараметров2.ЗначениеПоказателя
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВариантыРасчета КАК ВариантыРасчета
	|			ПО Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ВариантРасчета = ВариантыРасчета.ВариантРасчета
	|		ПО Таб.Ссылка = Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Ссылка
	|			И Таб.НомерВарианта = Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.НомерВарианта
	|ГДЕ
	|	ВЫБОР
	|			КОГДА Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель2 = НЕОПРЕДЕЛЕНО
	|					ИЛИ Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель2 = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ПустаяСсылка)
	|					ИЛИ Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель2 = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ПустаяСсылка)
	|					ИЛИ Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель2 = ЗНАЧЕНИЕ(Справочник.Лико_ПараметрыРасчетаНормативов.ПустаяСсылка)
	|					ИЛИ Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель2 = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыМатериалов.ПустаяСсылка)
	|					ИЛИ Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель2 = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЗаказов.ПустаяСсылка)
	|					ИЛИ Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель2 = """"
	|					ИЛИ Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель2 = 0
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель2 = ВТаблицаПараметров2.Показатель
	|					И ВТаблицаПараметров2.ЗначениеПоказателя >= Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ЗначениеПоказателя2
	|		КОНЕЦ
	|	И НЕ Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ЗначениеПоказателя ЕСТЬ NULL";
	
	ЗапросНормативы.УстановитьПараметр("РабочийЦентр", РабочийЦентр);
	ЗапросНормативы.УстановитьПараметр("Ссылка", Справочники.Лико_ТаблицыДляРасчетаНормативов.МетрыНаНастройку);
	ЗапросНормативы.УстановитьПараметр("ВариантРасчета", ВариантРасчета);
	ЗапросНормативы.УстановитьПараметр("Заказ", Заказ);
	ЗапросНормативы.УстановитьПараметр("НомерПроката", НомерПроката);
	ЗапросНормативы.УстановитьПараметр("НомерВарианта", НомерВарианта);
	
	КоличествоКликов = 0;
	стрклики = ТабПоказатели.Найти(Справочники.Лико_ПараметрыРасчетаНормативов.КоличествоКликов);
	Если стрклики <> Неопределено Тогда
		КоличествоКликов = стрклики.ЗначениеПОказателя;
	КонецЕсли;
	Если РабочийЦентр.ВидРабочегоЦентра= Справочники.ВидыРабочихЦентров.Indigo Тогда 
		Если Не ЗначениеЗаполнено(КоличествоКликов) Тогда 
			СообщениеОбОшибке = "Для цифровой машины не указано количество кликов (в колонке Дополнительно)! Расчет не возможен";
			Возврат СообщениеОбОшибке;
		КонецЕсли;	
	КонецЕсли;
	
	Если Настройка ТОгда 
		
		//1. Метры на настройку	
		
		Результат = ЗапросНормативы.Выполнить().Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.Норматив) Тогда 
			МетрыНаНастройку= Результат.Норматив;
		КонецЕсли;
		
		ВремяПоКликам = 0;
		Если РабочийЦентр.ВидРабочегоЦентра= Справочники.ВидыРабочихЦентров.Indigo Тогда 
			
			Если стрклики<> Неопределено Тогда 
				МетрыПоКликам =  ПолучитьЗначениеПоказателяПоЦветам(Справочники.Лико_ТаблицыДляРасчетаНормативов.МетрыНаНастройку,РабочийЦентр, ВариантРасчета, КоличествоКликов);		
				МетрыНаНастройку = МетрыНаНастройку+ МетрыПоКликам;
				
				ВремяПоКликам =  ПолучитьЗначениеПоказателяПоЦветам(Справочники.Лико_ТаблицыДляРасчетаНормативов.ВремяНаНастройку,РабочийЦентр, ВариантРасчета, КоличествоКликов);		
			КонецЕсли;
		КонецЕсли;	
		
		
		//Для каждой сменной формы добавим 30 метров на настройку
		ВремяНаНастройкуСменныхФорм =0;
		//Если НомерПроката =1 Тогда 
		КоличествоСменныхФорм =  ОпределитьКоличествоСменныхФорм(Заказ,ИмяТаблицы, НомерПроката, НомерВарианта);
		Если ЗначениеЗаполнено(КоличествоСменныхФорм) Тогда 
			Если РабочийЦентр <>Справочники.РабочиеЦентры.НайтиПоКоду("ПорядковыйНомер", 410) Тогда 
				МетрыНаНастройку = МетрыНаНастройку+ОпределитьКоличествоСменныхФорм(Заказ,ИмяТаблицы, НомерПроката, НомерВарианта)*30;
				ВремяНаНастройкуСменныхФорм = КоличествоСменныхФорм*7;
				
			КонецЕсли;
		КонецЕсли;	
		//КонецЕсли;
		
		//	2. Время на настройку
		//Сначала определим время на мойку секций и количество промываемых секций (понадобится для расчета стоимости)
		ЗапросНормативы.УстановитьПараметр("Ссылка", Справочники.Лико_ТаблицыДляРасчетаНормативов.МойкаСекций);	
		Результат = ЗапросНормативы.Выполнить().Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.Норматив) Тогда 
			ВремяНаМойкуСекций= Результат.Норматив;
			МойкаСекций = Результат.ЗначениеПараметра;
			
		КонецЕсли;
		
		РассчитанныеПараметры.Вставить("МойкаСекций", МойкаСекций);
		
		
		//Получим таблицу показателей по заданному рабочему центру	
		ВремяНаНастройку = 0;
		Если РабочийЦентр.ВидРабочегоЦентра= Справочники.ВидыРабочихЦентров.Indigo Тогда 			
			Если ЗначениеЗаполнено(КоличествоКликов) Тогда
				ВремяНаНастройку =   ПолучитьЗначениеПоказателяПоЦветам(Справочники.Лико_ТаблицыДляРасчетаНормативов.ВремяНаНастройку,РабочийЦентр, ВариантРасчета, КоличествоКликов);		
			КонецЕсли;
		КонецЕсли;	
		
		ЗапросНормативы.УстановитьПараметр("Ссылка", Справочники.Лико_ТаблицыДляРасчетаНормативов.ВремяНаНастройку);	
		Результат = ЗапросНормативы.Выполнить().Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.Норматив) Тогда 
			ВремяНаНастройку= Результат.Норматив;
		КонецЕсли;	
		
		ВремяНаНастройку = ВремяНаНастройку+ВремяНаМойкуСекций+ВремяНаНастройкуСменныхФорм+ ВремяПоКликам;
	Иначе
		РассчитанныеПараметры.Вставить("МойкаСекций", МойкаСекций);		
	КонецЕсли;	
	
	Если Заказ.СерийныйЗаказ ТОгда 
		//Необходимо определить общее количество этикеток по заказам, входящим в серию и метры и время на настройку распределить по заказам пропорционально этому количеству.
		ЗапросПоСерии = Новый Запрос;
		ЗапросПоСерии.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.ПервыйВСерии КАК ПервыйВСерии,
		|	МАКСИМУМ(ЗаказКлиента.Тираж) КАК Тираж
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Ссылка = &Заказ
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиента.ПервыйВСерии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.ПервыйВСерии КАК ПервыйВСерии,
		|	ВТ.Тираж КАК Тираж,
		|	СУММА(ЗаказКлиента.Тираж) КАК ТиражОбщий
		|ПОМЕСТИТЬ ВТЗаказы
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
		|		ПО ВТ.ПервыйВСерии = ЗаказКлиента.ПервыйВСерии
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ.ПервыйВСерии,
		|	ВТ.Тираж
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ВТЗаказы.Тираж / ВТЗаказы.ТиражОбщий КАК ЧИСЛО(15, 2)) КАК Коэффициент,
		|	ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройкуСерии, 0) КАК ВремяНаНастройкуСерии,
		|	ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.МетрыНаНастройкуСерии, 0) КАК МетрыНаНастройкуСерии
		|ИЗ
		|	ВТЗаказы КАК ВТЗаказы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
		|		ПО ВТЗаказы.ПервыйВСерии = Лико_ПараметрыПроизводстваЗаказа.Заказ
		|			И (Лико_ПараметрыПроизводстваЗаказа.НомерПроката = &НомерПроката)";
		ЗапросПоСерии.УстановитьПараметр("Заказ", Заказ);
		ЗапросПоСерии.УстановитьПараметр("НомерПроката", НомерПроката);
		
		РезультатаЗапросаПоСерии = ЗапросПоСерии.Выполнить();
		Если Не  РезультатаЗапросаПоСерии.Пустой() Тогда 
			РезультатПоСерии = РезультатаЗапросаПоСерии.Выбрать();
			РезультатПоСерии.Следующий();
			Если Заказ.ПервыйВСерии = Заказ ТОгда 
				РассчитанныеПараметры.Вставить("МетрыНаНастройкуСерии", МетрыНаНастройку);
				РассчитанныеПараметры.Вставить("ВремяНаНастройкуСерии", Окр(ВремяНаНастройку,2));
				МетрыНаНастройку = МетрыНаНастройку*РезультатПоСерии.Коэффициент;
				ВремяНаНастройку = ВремяНаНастройку*РезультатПоСерии.Коэффициент;
			Иначе
				МетрыНаНастройку = РезультатПоСерии.МетрыНаНастройкуСерии*РезультатПоСерии.Коэффициент;
				ВремяНаНастройку = РезультатПоСерии.ВремяНаНастройкуСерии*РезультатПоСерии.Коэффициент;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	
	РассчитанныеПараметры.Вставить("МетрыНаНастройку", МетрыНаНастройку);
	РассчитанныеПараметры.Вставить("ВремяНаНастройку", Окр(ВремяНаНастройку,2));
	
	
	//3. Процент на брак
	ПроцентНаБрак = 0;
	//Определим процент в зависимости от количества цветов:
	Если РабочийЦентр.ВидРабочегоЦентра= Справочники.ВидыРабочихЦентров.Indigo  Тогда 			
		Если ЗначениеЗаполнено(КоличествоКликов) Тогда
			ПроцентНаБрак =   ПолучитьЗначениеПоказателяПоЦветам(Справочники.Лико_ТаблицыДляРасчетаНормативов.ПроцентНаБрак,РабочийЦентр, ВариантРасчета, КоличествоКликов);		
		КонецЕсли;
	Иначе
		
		стрОснЦветов = ТабПоказатели.Найти(Справочники.Лико_ПараметрыРасчетаНормативов.КоличествоЦветов);
		
		
		Если стрОснЦветов<>Неопределено Тогда 
			ОснЦветов = стрОснЦветов.ЗначениеПОказателя;
			ПроцентНаБрак =   ПолучитьЗначениеПоказателяПоЦветам(Справочники.Лико_ТаблицыДляРасчетаНормативов.ПроцентНаБрак,РабочийЦентр, ВариантРасчета, ОснЦветов);
		КонецЕсли;	
	КонецЕсли;
	
	ЗапросНормативы.УстановитьПараметр("Ссылка", Справочники.Лико_ТаблицыДляРасчетаНормативов.ПроцентНаБрак);
	
	РезультатЗапросаБрак =  ЗапросНормативы.Выполнить();
	Если Не РезультатЗапросаБрак.Пустой() Тогда
		Результат = РезультатЗапросаБрак.Выбрать();
		Результат.Следующий();
		Если  ЗначениеЗаполнено(Результат.Норматив) Тогда 
			ПроцентНаБрак = ПроцентНаБрак+Результат.Норматив;
		КонецЕсли;	
	КонецЕсли;
	РассчитанныеПараметры.Вставить("ПроцентНаБрак", ПроцентНаБрак);
	
	//4. Метры на брак
	МетрыНаБрак = (ПогонныйМетраж+МетрыНаБракПредыдущихПеределов+МетрыНаНастройкуПредыдущихПеределов)*ПроцентНаБрак; 
	РассчитанныеПараметры.Вставить("МетрыНаБрак", МетрыНаБрак);
	
	//20190814 Количество роликов - переменная величина, в показатели ее не добавляем!!!
	
	
	// 5.Время на установку и смену роликов 
	
	//20190814 Количество роликов - переменная величина, в показатели ее не добавляем!!!
	//Необходимо отдельно знать время на смену роликов, т.к. настройки мождет не быть, а ролики меняются в процессе печати.
	//ВремяНаУстановкуРоликов = ВремяНаУстановкуРоликов(РабочийЦентр, КоличествоРоликов, КоличествоРоликовЛаминации, ВариантРасчета);
	//РассчитанныеПараметры.Вставить("ВремяНаУстановкуРоликов", Окр(ВремяНаУстановкуРоликов,2));
	
	//20200625 - Время на установку 1 ролика входит в ПЗВ, т.е. берем время, начиная со 2 ролика
	ВремяНаСменуРоликов = 0;
	ДлинаРолика = 0;
	
	МетражДляРоликов =    ПогонныйМетраж+МетрыНаБрак+МетрыНаНастройку+ МетрыНаБракПредыдущихПеределов+МетрыНаНастройкуПредыдущихПеределов;
	Если ВариантРасчета = 1 Тогда 
		КодЦГ = 1000; //если он не определен - для полуфабриката и т.д.
		стрКодЦГ = ТабПоказатели.Найти(Справочники.Лико_ПараметрыРасчетаНормативов.КодЦеновойГруппы);
		Если стрКодЦГ<> Неопределено Тогда 
			КодЦГ = стрКодЦГ.ЗначениеПОказателя;
		КонецЕсли;
		ДанныеПоРоликам =ДанныеПоРОликам(Заказ, ИмяТаблицы, КодЦГ,  НомерПроката, НомерВарианта, РабочийЦентр, МетражДляРоликов);
		ВремяНаСменуРоликов =  ДанныеПоРоликам.ВремяНаСменуРоликов;	
		РассчитанныеПараметры.Вставить("ДлинаРолика", ДанныеПоРоликам.ДлинаРолика);
		РассчитанныеПараметры.Вставить("ВремяНаСменуРоликов", Окр(ВремяНаСменуРоликов,2));
	ИначеЕсли ВариантРасчета = 2 Тогда 
		ВремяНаСменуРоликов =  ВремяНаУстановкуРОликов(Заказ,МетражДляРоликов, РабочийЦентр, ЗапросНормативы, ТабПоказатели, 2);
		РассчитанныеПараметры.Вставить("ВремяНаСменуРоликов", Окр(ВремяНаСменуРоликов,2));
	КонецЕсли;
	
	// 6. Скорость печати
	СкоростьПечати = 0;
	ВремяПечати = 0 ;       
#Область Скорость_Индиго
	Если  РабочийЦентр.ВидРабочегоЦентра= Справочники.ВидыРабочихЦентров.Indigo Тогда 	
		//20190812 - Для имеющихся на производстве цифровых машин Технические клики добавлять не нужно
		
		//Определим количество технических кликов: металлизированный материал и белила  +1; минимально  может быть 2 клика		
		КоличествоТехническихКликов = КоличествоКликов;
		Если ТабПоказатели.Найти(Справочники.Лико_ПараметрыРасчетаНормативов.Metal)<>Неопределено Тогда 
			КоличествоТехническихКликов = КоличествоКликов+1;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		//20200526 - один технический клик добавляем при наличии любых белил 
		//20230712 - технический клик добавляем только для премиальных белил   
		
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(ТаблицаЦвета.ТипЦвета1) КАК КоличествоБелил
		|ИЗ
		|	"+ИмяТаблицы+".Цвета КАК ТаблицаЦвета
		|ГДЕ
		|	ТаблицаЦвета.ТипЦвета1 = ЗНАЧЕНИЕ(Справочник.Лико_ТипыЦвета.Белый)
		|	И ТаблицаЦвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Цифровая)
		|	И ТаблицаЦвета.НомерВарианта = &НомерВарианта
		|	И ТаблицаЦвета.Ссылка = &Ссылка
		|	И ТаблицаЦвета.ТипКраски.Код = ""3148     """;
		
		Запрос.УстановитьПараметр("Ссылка", Заказ);    
		Запрос.УстановитьПараметр("НомерВарианта", НомерВарианта);

		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда 
			Результат = РезультатЗапроса.Выбрать();
			Результат.Следующий();
			Если ЗначениеЗаполнено(Результат.КоличествоБелил) Тогда 
				КоличествоТехническихКликов = КоличествоТехническихКликов +1;
			КонецЕсли;
		КонецЕсли;
		
		КоличествоТехническихКликов = Макс(КоличествоТехническихКликов,2);
		
		///20250319 Технические клики могут быть заданы вручную в заказе
		Если ИмяТаблицы = "Документ.ЗаказКлиента" Тогда 
			Если ЗначениеЗаполнено(Заказ.КоличествоТехническихКликов) Тогда 
		       КоличествоТехническихКликов =  КоличествоКликов +Заказ.КоличествоТехническихКликов;
		   КонецЕсли;
		КонецЕсли;
		
		
		//с 21.07.21 15.30 данные о длине печати и количестве эт в рппорте берем из заказа
		СчитаемПоНовому = Истина;
		Если  ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			Если Заказ.ДатаОтправкиВРаботу <> '00010101' И  Заказ.ДатаОтправкиВРаботу < '202107211530' Тогда 
				СчитаемПоНовому = Ложь;
			КонецЕсли;
		КонецЕсли;
		// --> Начало Лико Митюшин МФМ 28.07.2021
		текПараметрыИндигоЗаполнены = (ЗначениеЗаполнено(стрШтамп.ЭтМЭР) И ЗначениеЗаполнено(стрШтамп.ДлинаПечатиИндиго) 
			И ЗначениеЗаполнено(стрШтамп.ЭтикетокНаЛистеИндиго) И ЗначениеЗаполнено(стрШтамп.РучьиПечатиИндиго));
		// <-- Конец Лико Митюшин МФМ 28.07.2021
		Если СчитаемПоНовому ИЛИ текПараметрыИндигоЗаполнены Тогда 
