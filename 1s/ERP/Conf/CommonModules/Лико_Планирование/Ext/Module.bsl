		стр.СуммаНДС  =  стрэт.СуммаНДС;
		стр.СуммаСНДС =стрэт.СуммаСНДС;
	
 
		//Если ЗначениеЗаполнено(стр.сумма) И ЗначениеЗаполнено(ЗаказДавальца.ставкаНДС) Тогда 
		//	ТекПроцентНДС = ЦенообразованиеКлиентСервер.ПолучитьСтавкуНДСЧислом(ЗаказДавальца.СтавкаНДС);
		//	стр.сумма*ТекПроцентНДС/100;
