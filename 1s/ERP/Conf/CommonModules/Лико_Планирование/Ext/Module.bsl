Функция ПолучитьРЦПервогоПроката(Заказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаЦвета.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.Gallus)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.Flexo)
		|		КОГДА ЗаказКлиентаЦвета.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.GallusGranitic)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.MPS)
		|		ИНАЧЕ ЗаказКлиентаЦвета.РабочийЦентр.ВидРабочегоЦентра
		|	КОНЕЦ КАК ВидРЦ
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
		|ГДЕ
		|	ЗаказКлиентаЦвета.Ссылка = &Заказ
		|	И ЗаказКлиентаЦвета.НомерПроката = 1";
	
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	РЦПервогоПроката = Запрос.Выполнить().Выгрузить()[0].ВидРЦ;
	Возврат РЦПервогоПроката;

