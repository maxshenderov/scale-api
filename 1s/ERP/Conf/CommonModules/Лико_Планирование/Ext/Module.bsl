		ЗаказОбъект.Состояние =  Перечисления.Лико_СостоянияЗаказов.Аннулирован;
		ЗаказОбъект.Записать();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПооперационноеРасписание2_2.Этап КАК Этап
		|ИЗ
		|	РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2
		|ГДЕ
		|	ПооперационноеРасписание2_2.Этап.Распоряжение.ДокументОснование = &Заказ";
		Запрос.УстановитьПараметр("Заказ", Заказ);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Лико_Дополнительно.УдалитьЭтапПроизводстваИзПлана(Выборка.Этап,,, Истина);

			//НаборЗаписей = РегистрыСведений.ПооперационноеРасписание2_2.СоздатьНаборЗаписей();
			//НаборЗаписей.Отбор.Этап.Значение = Выборка.Этап;
			//НаборЗаписей.Отбор.Этап.Использование = Истина;
			//НаборЗаписей.Записать();
	
		КонецЦикла;	
				
		//Резервирование 		
		Если Заказ.Площадка = Справочники.Лико_Площадки.Ликофлекс ИЛИ Заказ.Площадка = Справочники.Лико_Площадки.Линкс Тогда 
			Запрос = Новый Запрос;
			Запрос.Текст = 
