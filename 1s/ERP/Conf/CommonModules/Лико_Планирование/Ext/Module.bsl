			//Если ЗначениеЗаполнено(Результат.Цена) Тогда 
			ДобавитьЗатраты(Ссылка, НомерВарианта, РабочийЦентр,1, Справочники.Лико_СтатьиЗатрат.ОсновнойМатериал,Ссылка.ОсновнойМатериал,Расч_Квм,Расч_Квм*?(ЗначениеЗаполнено(Результат.Цена),Результат.Цена,0) ,ПараметрыШтампа.Нарезка, Справочники.ВидыРаботСотрудников.Печать, ,1,Ссылка.ДавальческоеСырье); 
			//КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	//КонецЕсли;			
	
	
	//Стоимость флексо клише:	
	//Клише берем из табличной части Цвета с отметкой "Цветоделение"
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Лико_Спецификации") И НЕ ЗначениеЗаполнено(Ссылка.ПлощадьКлише) Тогда 
