			НаборЗаписейНормативы.Записать();
			НаборЗаписейВыпуск.Записать();
            НаборЗаписейПриходРасходГПДляОтгрузки.Записать();
		КонецЦикла;
		
		Если Не  Док.Лико_ЭтоОбщийЭтапНаМесяц Тогда 
			Пока ВыборкаЗатратыЭтапа.Следующий() Цикл
				ЗаписьЗатратыЭтапа = НаборЗаписейЗатратыПоЗаказу.Добавить();
				ЗаполнитьЗначенияСвойств( ЗаписьЗатратыЭтапа,ВыборкаЗатратыЭтапа);
			КонецЦикла;
			НаборЗаписейЗатратыПоЗаказу.Записать();
			
			Пока Выборкасебестоимость.Следующий() Цикл
				ЗаписьСебестоимость = НаборЗаписейСебестоимостьЗаказов.Добавить();
				ЗаполнитьЗначенияСвойств(ЗаписьСебестоимость, Выборкасебестоимость);
			КонецЦикла;
			Пока ВыборкасебестоимостьПФ.Следующий() Цикл
				ЗаписьСебестоимостьПФ = НаборЗаписейСебестоимостьЗаказов.Добавить();
				ЗаполнитьЗначенияСвойств(ЗаписьСебестоимостьПФ, ВыборкасебестоимостьПФ);
			КонецЦикла;
		Иначе  
			Пока Выборкасебестоимость.Следующий() Цикл
				ЗаписьСебестоимость = НаборЗаписейСебестоимостьЗаказов.Добавить();
				ЗаполнитьЗначенияСвойств(ЗаписьСебестоимость, Выборкасебестоимость, "Регистратор, Период, Заказ, Количество, МетражКВМ");
			КонецЦикла;

		КонецЕсли;	

		НаборЗаписейСебестоимостьЗаказов.Записать();  
		
			
		
	КонецЕсли;	

КонецПроцедуры


