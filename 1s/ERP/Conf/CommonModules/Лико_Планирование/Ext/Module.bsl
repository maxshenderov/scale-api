   |	СпецификацииНоменклатурыПараметрыШтампа.ШиринаРулона.Размер КАК НарезкаРазмер,
   |	СпецификацииНоменклатурыПараметрыШтампа.Ручьи,
   |	СпецификацииНоменклатурыПараметрыШтампа.Z.КоличествоЗубьев,
   |	СпецификацииНоменклатурыПараметрыШтампа.ШагПечати,
   |	СпецификацииНоменклатурыПараметрыШтампа.ДлинаЭтикетки,
   |	СпецификацииНоменклатурыПараметрыШтампа.ШиринаЭтикетки
   |ИЗ
   |	Справочник.СпецификацииНоменклатуры.ПараметрыШтампа КАК СпецификацииНоменклатурыПараметрыШтампа
   |ГДЕ
   |	СпецификацииНоменклатурыПараметрыШтампа.Ссылка.Код = &Код
   | 	И СпецификацииНоменклатурыПараметрыШтампа.Ссылка.Наименование = &Наименование" ;

	
	Выборка = ЗапросУПП.Выполнить().Выбрать();
	Пока Выборка.следующий() Цикл
		стр = 	Спец;
		Если ЗначениеЗаполнено(Выборка.ШтампВырубнойКод) Тогда 
			Оснастка = Справочники.Номенклатура.НайтиПоКоду(Выборка.ШтампВырубнойКод);
			Если ЗначениеЗаполнено(Оснастка) Тогда 
				стр.ШтампВырубной = оснастка;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(стр, Выборка);

			Если ЗначениеЗаполнено(Выборка.НарезкаРазмер) ТОгда 
				Нарезка=Справочники.ЯССМ_Нарезки.НайтиПоРеквизиту("Размер", Выборка.НарезкаРазмер);

				Если Не ЗначениеЗаполнено(Нарезка) Тогда 
					НарезкаНовый = Справочники.ЯССМ_Нарезки.СоздатьЭлемент();
					НарезкаНовый.код = Результат.ШиринаРулонаКод;
					НарезкаНовый.Размер = Результат.ШиринаРулонаРазмер;
					НарезкаНовый.Наименование = Строка(Результат.ШиринаРулонаРазмер);
					НарезкаНовый.Записать();
					Нарезка = НарезкаНовый.Ссылка;
				КонецЕсли;
				стр.Нарезка=Нарезка;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ZКоличествоЗубьев) ТОгда 
			стр.z=Справочники.Лико_ZКоличествоЗубьев.НайтиПоРеквизиту("КоличествоЗубьев", Выборка.ZКоличествоЗубьев);
		КонецЕсли;
		стр.количествоКликов= КоличествоКликов;
	КонецЦикла;
	
	
	
	Спец.Записать();
	УстановитьПривилегированныйРежим(Ложь);


КонецПроцедуры



Функция ПоложитьФайлВБазуSQL(Подключение, ИмяТаблицы, АдресВременногоХранилища, Ссылка, ИдентификаторСтроки, ИмяФайла, Замещать = Истина) Экспорт	
	
	Если Подключение = Неопределено Тогда
		#Если Клиент Тогда
			Предупреждение("Отсутствует подключение к SQL серверу! Обратитесь, пожалуйста, в IT - отдел.");
		#КонецЕсли
		Возврат Ложь;	
	КонецЕсли;
	
	ИДСсылки = ЗначениеВСтрокуВнутр(Ссылка);
	ИДСсылкиМакета = ЗначениеВСтрокуВнутр(ИдентификаторСтроки);
	
	ДД = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);  // вытаскиваем на сервере из временного хранилища как двоичные данные
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(); // получаем имя временного файла на сервере
	ДД.Записать(ИмяВременногоФайла);   
	
	Stream = Новый COMОбъект("ADODB.Stream");
	Stream.Type = 1;
	Stream.Open();
	//Stream.LoadFromFile(ИмяФайла);
	Stream.LoadFromFile(ИмяВременногоФайла);
	
	RecordSet = Новый COMОбъект("ADODB.RecordSet");
	RecordSet.CursorLocation = 3;
	RecordSet.LockType = 2;
	
	Имяр = РазобратьСтроку(ИмяФайла, "\");
	//Имяр = РазобратьСтроку(ИмяВременногоФайла, "\");
	Имяр = Имяр[Имяр.Количество() - 1].Значение;
	
	Запрос = "select [GUID], [GUIDMaket],[Data], [FileName], [UserName], [DateTime] from [" + ИмяТаблицы + "] where [GUID]='" + ИДСсылки + "' AND [GUIDMaket]='" +ИДСсылкиМакета + "'";
	
	Попытка		
		RecordSet.Open(Запрос, Подключение);
	Исключение	
		#Если Клиент Тогда
			Сообщить("Ошибка выполнения SQL запроса (" + ОписаниеОшибки() + ")", СтатусСообщения.ОченьВажное);
		#КонецЕсли	
		Возврат Ложь;
	КонецПопытки;
	
	Если RecordSet.RecordCount > 0 И Замещать = Ложь Тогда
		RecordSet.AddNew();
		Имяр = Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy hh-mm-ss'") + " " + Имяр;
	ИначеЕсли RecordSet.RecordCount = 0 Тогда
		RecordSet.AddNew();
	Иначе		
		RecordSet.MoveFirst();
	КонецЕсли;
	
	RecordSet.Fields("Data").Value = Stream.Read(-1);
	RecordSet.Fields("GUID").Value = ИДСсылки;
	RecordSet.Fields("GUIDMaket").Value = ИДСсылкиМакета;
	RecordSet.Fields("FileName").Value = Имяр;
	RecordSet.Fields("UserName").Value = СокрЛП(Строка(ПользователиКлиентСервер.ТекущийПользователь()));
	RecordSet.Fields("DateTime").Value = ТекущаяДата();
	RecordSet.Update();	
	
	Stream.Close();
	RecordSet.Close();
	
	Возврат Истина;
КонецФункции

Функция РазобратьСтроку(_Строка, _Разделитель, _УдалятьПустые = Истина) Экспорт
	Результат = Новый СписокЗначений;
	_т = СтрЗаменить(_Строка, _Разделитель, Символы.ПС);
	
	Для Строк = 1 по СтрЧислоСтрок(_т) Цикл
		Если СтрДлина(СтрПолучитьСтроку(_т, Строк)) > 0 ИЛИ не _УдалятьПустые Тогда
			Результат.Добавить(СтрПолучитьСтроку(_т, Строк));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция ПолучитьФайлИзБазыSQL(Подключение, ИмяТаблицы, Ссылка,ИдентификаторСтроки,ИмяФайла) Экспорт
	Если Подключение = Неопределено Тогда
		#Если Клиент Тогда
			Предупреждение("Отсутствует подключение к SQL серверу! Обратитесь, пожалуйста, в IT - отдел.");
		#КонецЕсли	
		Возврат Неопределено;
	КонецЕсли;
	
	Файл = Неопределено;
	ИДСсылки = ЗначениеВСтрокуВнутр(Ссылка);
	ИДСсылкиМакета = ЗначениеВСтрокуВнутр(ИдентификаторСтроки);
	
	Stream = Новый COMОбъект("ADODB.Stream");
	Stream.Type = 1;
	Stream.Open();
	
	RecordSet = Новый COMОбъект("ADODB.RecordSet");
	RecordSet.CursorLocation = 3;
	RecordSet.LockType = 2;
	
	Запрос = "SELECT Data FROM [" + ИмяТаблицы + "] WHERE GUID = '" + ИДСсылки + "' AND GUIDMaket  = '" + ИДСсылкиМакета + "'";
	RecordSet.Open(Запрос, Подключение);
	
	Попытка
		RecordSet.MoveFirst();
		Stream.Write(RecordSet.Fields("Data").Value);
		//фрис = КаталогВременныхФайлов() + ИмяФайла;
		//Stream.SaveToFile(фрис);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(); // получаем имя временного файла на сервере
		Stream.SaveToFile(ИмяВременногоФайла);
		
		Stream.Close();
		RecordSet.Close();
		
		//Файл = Новый ДвоичныеДанные(фрис);
		//УдалитьФайлы(фрис);
		
		Файл = Новый ДвоичныеДанные(ИмяВременногоФайла);
		
		
		УдалитьФайлы(ИмяВременногоФайла);
		
		Возврат Файл;
	Исключение
		Сообщить("В базе данных SQL отсутствует файл с указанным именем!", СтатусСообщения.ОченьВажное);
		
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Процедура ОтменаПодготовленныхМатериалов(Заказ) //+Лико m.shenderov 16.01.2018
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
