	Если Не Отказ Тогда 
		ЗаказПр = ЗаказПрОбъект.Ссылка;
	Иначе Возврат
	КонецЕсли;
	
	СоздатьДобавитьЭтапыПроизводства(Заказ, ЗаказПр, Заказ.Площадка, Отказ);
	
