			Запись.Сумма = ВыборкаКлеяТУ.суммафакт;
			ЗаполнитьЗначенияСвойств(Запись, Выборка, "Регистратор, ЗаказКлиента, Период,РабочийЦентр");
			Запись.МетражПМ = Выборка.КоличествоПМ;
		КонецЦикла;



		НаборЗаписейЗатратыпоЗаказу.Записать();

	КонецЕсли;   
	
	Если НаборЗаписейЗатратыпоЗаказу.Количество()>0 И ЗначениеЗаполнено(Док.ЗаказПокупателя.РезультатЗаказа) Тогда
		//Отложеннный пересчет по заказу
		НоваяЗапись =РегистрыСведений.Лико_ПересчетДокументов.СоздатьМенеджерЗаписи();
