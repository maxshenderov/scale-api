					|	ЗаказКлиента.Ссылка = &Ссылка";
				КонецЕсли;
				
				ЗапросЭтНаЛисте.УстановитьПараметр("Ссылка", Заказ);
				ЗапросЭтНаЛисте.УстановитьПараметр("НомерПроката", НомерПроката);
				РезультатЭтикетокНаЛисте =ЗапросЭтНаЛисте.Выполнить().Выбрать();
				РезультатЭтикетокНаЛисте.Следующий();
				Если ЗначениеЗаполнено(РезультатЭтикетокНаЛисте.ЭтикетокНаЛисте) Тогда 
					ВремяПечати = Окр(КоличествоЭтикетокЗаданное/(РезультатЭтикетокНаЛисте.ЭтикетокНаЛисте*СкоростьПечати),2)*60;
				КонецЕсли;	
			ИначеЕсли 	 РабочийЦентр.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Tatani Тогда  				
				ВремяПечати = Окр(КоличествоЭтикетокЗаданное/(лРучьи*СкоростьПечати),2);	
			ИначеЕсли 	 РабочийЦентр.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Sсaldopack Тогда 
				ВремяПечати = Окр(КоличествоЭтикетокЗаданное/(СкоростьПечати),2);			
			КонецЕсли;
			Если РабочийЦентр.ПорядковыйНомер = 410 Тогда
				ВремяПечати = Окр(КоличествоЭтикетокЗаданное/(лРучьи*СкоростьПечати),2)*60;
				
			КонецЕсли;
		иначе
			ВремяПечати = 0;
			//20180913 Иванова А.В. Не будем нервировать пользователей
			//Сообщить("Нулевая скорость печати"); 
		КонецЕсли;
	КонецЕсли;
	РассчитанныеПараметры.Вставить("СкоростьПечати", СкоростьПечати);
	РассчитанныеПараметры.Вставить("ВремяПечати", Окр(ВремяПечати,2));
	
	
	// Время выполнения заказа
	ВремяВыполненияЗаказа = Окр(ВремяНаНастройку+ ВремяПечати+ВремяНаСменуРоликов,2);
	РассчитанныеПараметры.Вставить("ВремяВыполненияЗаказа", ВремяВыполненияЗаказа);
	
	//ВремяПечатиЧ = Цел(ВремяПечати/60);
	//ВремяВыполненияЗаказаЧ = Цел(ВремяВыполненияЗаказа/60);
	//ВремяПечатиВЧасах = Строка(ВремяПечатиЧ)+ " ч. "+Строка(ВремяПечати-ВремяПечатиЧ*60)+" мин." ;
	//ВремяВыполненияЗаказаВЧасах = Строка(ВремяВыполненияЗаказаЧ)+ " ч. "+Строка(ВремяВыполненияЗаказа-ВремяВыполненияЗаказаЧ*60)+" мин.";
	
	
	//РассчитанныеПараметры.Вставить("ПоказателиДляТаблиц", ПоказателиДляТаблиц);
	
	
	Возврат РассчитанныеПараметры;
	

	
КонецФункции

Функция ПолучитьЗапросПоНормативамЗаказа();
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка КАК Заказ
		|ПОМЕСТИТЬ ВТЗаказы
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Ссылка = &Заказ
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиента.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказКлиентаВидыРабот.Ссылка КАК Заказ,
		|	СУММА(ВЫБОР
		|			КОГДА ЗаказКлиентаВидыРабот.ВидРабот.Родитель <> ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Тиснение)
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КоличествоМатериалов,
		|	СУММА(ВЫБОР
		|			КОГДА ЗаказКлиентаВидыРабот.ВидРабот = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ГорячееТиснениеРотационное)
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КоличествоТиснений,
		|	ЗаказКлиентаВидыРабот.НомерПроката КАК НомерПроката
		|ПОМЕСТИТЬ ВТМатериалы
		|ИЗ
		|	ВТЗаказы КАК ВТЗаказы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
		|		ПО ВТЗаказы.Заказ = ЗаказКлиентаВидыРабот.Ссылка
		|ГДЕ
		|	(ЗаказКлиентаВидыРабот.Материал <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
		|				И ЗаказКлиентаВидыРабот.Материал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|				И ЗаказКлиентаВидыРабот.Материал <> НЕОПРЕДЕЛЕНО
		|			ИЛИ ЗаказКлиентаВидыРабот.МатериалФакт <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
		|				И ЗаказКлиентаВидыРабот.МатериалФакт <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|				И ЗаказКлиентаВидыРабот.МатериалФакт <> НЕОПРЕДЕЛЕНО)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаВидыРабот.Ссылка,
		|	ЗаказКлиентаВидыРабот.НомерПроката
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказКлиентаВидыРабот.Ссылка КАК Заказ,
		|	ЗаказКлиентаВидыРабот.НомерПроката КАК НомерПроката,
		|	МИНИМУМ(ВЫБОР
		|			КОГДА ЗаказКлиентаВидыРабот.ВидРабот = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Вырубка)
		|				ТОГДА ЗаказКлиентаВидыРабот.Ссылка.ЭтикетокНаЛисте
		|			ИНАЧЕ ЕСТЬNULL(Лико_ПараметрыШтампа.ЭтикетокНаЛисте, ЗаказКлиентаВидыРабот.Ссылка.ЭтикетокНаЛисте)
		|		КОНЕЦ) КАК ЭтикетокНаЛисте
		|ПОМЕСТИТЬ ВТНФ
		|ИЗ
		|	ВТЗаказы КАК ВТЗаказы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
		|			ПО ЗаказКлиентаВидыРабот.Оснастка = Лико_ПараметрыШтампа.Номенклатура
		|		ПО ВТЗаказы.Заказ = ЗаказКлиентаВидыРабот.Ссылка
		|ГДЕ
		|	ЗаказКлиентаВидыРабот.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.NewFoil)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаВидыРабот.Ссылка,
		|	ЗаказКлиентаВидыРабот.НомерПроката
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТЗаказы.Заказ КАК Заказ,
		|	ВЫБОР
		|		КОГДА ВТЗаказы.Заказ.ЭтикетокНаЛисте <> 0
		|				И ВТЗаказы.Заказ.Ручьи <> 0
		|			ТОГДА ВЫБОР
		|					КОГДА ВТЗаказы.Заказ.ШагПечати <> 0
		|						ТОГДА ВТЗаказы.Заказ.ШагПечати
		|					ИНАЧЕ ВЫБОР
		|							КОГДА ВТЗаказы.Заказ.Z <> ЗНАЧЕНИЕ(Справочник.Лико_ZКоличествоЗубьев.ПустаяСсылка)
		|								ТОГДА ВТЗаказы.Заказ.Z.КоличествоЗубьев * 3.175 / 1000
		|							ИНАЧЕ 0
		|						КОНЕЦ
		|				КОНЕЦ / (ВТЗаказы.Заказ.ЭтикетокНаЛисте / ВТЗаказы.Заказ.Ручьи)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДлинаЭтикеткиСПрипуском
		|ПОМЕСТИТЬ ВТЦифра
		|ИЗ
		|	ВТЗаказы КАК ВТЗаказы
		|ГДЕ
		|	ВТЗаказы.Заказ.Цифровой = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Лико_ПараметрыПроизводстваЗаказа.Заказ КАК Заказ,
		|	Лико_ПараметрыПроизводстваЗаказа.НомерПроката КАК НомерПроката,
		|	Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр КАК РабочийЦентр,
		|	Лико_ПараметрыПроизводстваЗаказа.МетрыНаНастройку КАК МетрыНаНастройку,
		|	Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку КАК ВремяНаНастройку,
		|	Лико_ПараметрыПроизводстваЗаказа.СкоростьПечати КАК СкоростьПечати,
		|	Лико_ПараметрыПроизводстваЗаказа.ДлинаРолика КАК ДлинаРолика,
		|	1 + ЕСТЬNULL(ВТМатериалы.КоличествоМатериалов, 0) КАК КоличествоМатериалов,
		|	ЕСТЬNULL(ВТМатериалы.КоличествоТиснений, 0) КАК КоличествоТиснений,
		|	Лико_ПараметрыПроизводстваЗаказа.ПроцентНаБрак КАК ПроцентНаБрак,
		|	ВТНФ.ЭтикетокНаЛисте КАК ЭтикетокНаЛисте,
		|	ВЫБОР
		|		КОГДА Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.NewFoil)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК НФ,
		|	Лико_ПараметрыПроизводстваЗаказа.ПроцентНаБрак * 100 КАК ПроцентНаБрак100,
		|	ВТЗаказы.Заказ.КоличествоКликов КАК КоличествоКликов,
		|	ВЫБОР
		|		КОГДА ВТЗаказы.Заказ.ДлинаПечати <> 0
		|			ТОГДА ВТЗаказы.Заказ.ДлинаПечати
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ВТЦифра.ДлинаЭтикеткиСПрипуском <> 0
		|					ТОГДА ВЫРАЗИТЬ((ВЫРАЗИТЬ(0.98 / ВТЦифра.ДлинаЭтикеткиСПрипуском КАК ЧИСЛО(15, 0))) * ВТЦифра.ДлинаЭтикеткиСПрипуском КАК ЧИСЛО(15, 3))
		|				ИНАЧЕ 0
		|			КОНЕЦ
		|	КОНЕЦ КАК ДлинаПечати,
		|	ВЫБОР
		|		КОГДА ВТЗаказы.Заказ.ЭтикетокНаЛистеИндиго <> 0
		|			ТОГДА ВТЗаказы.Заказ.ЭтикетокНаЛистеИндиго
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ВТЦифра.ДлинаЭтикеткиСПрипуском <> 0
		|					ТОГДА (ВЫРАЗИТЬ(0.98 / ВТЦифра.ДлинаЭтикеткиСПрипуском КАК ЧИСЛО(15, 0))) * ВТЦифра.Заказ.Ручьи
		|				ИНАЧЕ 0
		|			КОНЕЦ
		|	КОНЕЦ КАК КоличествоЭтикетокВРаппорте,
		|	ВЫБОР
		|		КОГДА Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.indigo)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЦифровойРЦ
		|ИЗ
		|	ВТЗаказы КАК ВТЗаказы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВТМатериалы КАК ВТМатериалы
		|			ПО Лико_ПараметрыПроизводстваЗаказа.Заказ = ВТМатериалы.Заказ
		|				И Лико_ПараметрыПроизводстваЗаказа.НомерПроката = ВТМатериалы.НомерПроката
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВТНФ КАК ВТНФ
		|			ПО Лико_ПараметрыПроизводстваЗаказа.Заказ = ВТНФ.Заказ
		|				И Лико_ПараметрыПроизводстваЗаказа.НомерПроката = ВТНФ.НомерПроката
		|		ПО ВТЗаказы.Заказ = Лико_ПараметрыПроизводстваЗаказа.Заказ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦифра КАК ВТЦифра
		|		ПО ВТЗаказы.Заказ = ВТЦифра.Заказ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Лико_ПараметрыПроизводстваЗаказа.Заказ.Дата,
		|	НомерПроката УБЫВ
		|ИТОГИ ПО
		|	Заказ";
	
	Возврат ТекстЗапроса;
	
КонецФункции

//Расчет нормативов для каждой отгрузки
Процедура РассчитатьНормативыПоОтгрузке(ЗаказОбъект, Идентификатор, Отказ) Экспорт
	ЗаказСсылка = ЗаказОбъект.Ссылка;

	текстр = ЗаказОбъект.Отгрузки.Найти( Идентификатор, "КлючСтроки");
	Тираж = текстр.количество*1000;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПОлучитьЗапросПоНормативамЗаказа();
		
	Запрос.УстановитьПараметр("ДатаНачала", текстр.Дата);
	Запрос.УстановитьПараметр("ДатаОкончания", текстр.Дата);
	Запрос.УстановитьПараметр("Заказ", ЗаказСсылка);
	ВыборкаЗаказы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Заказ");
	Пока ВыборкаЗаказы.Следующий() Цикл	
		Записывать = Истина;			
		Если Не ЗначениеЗаполнено(текстр.ПогонныйМетраж) Тогда
			Если ЗначениеЗаполнено(ЗаказСсылка.Нарезка) Тогда 
				текстр.ПогонныйМетраж = (текстр.КвадратныйМетраж/ЗаказСсылка.Нарезка.Размер)*1000 ;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(текстр.ПогонныйМетраж) Тогда 
			МетражДляРЦ = текстр.ПогонныйМетраж;
			КоличествоНастроек = текстр.Настройка;
			ВремяВыполненияЗаказаВЧасах  = 0;
			ВремяПечати = 0;
			Выборка = ВыборкаЗаказы.Выбрать();
			Пока Выборка.Следующий() Цикл
				стрНормативы = ЗаказОбъект.Нормативы.Добавить();
				стрНормативы.НомерПроката = Выборка.НомерПроката;
				стрНормативы.НомерОтгрузки = текстр.КлючСтроки;
				Если Выборка.НомерПроката = 1 Тогда 
					стрНормативы.РабочийЦентр = Текстр.РабочийЦентр; 
				Иначе
					стрНормативы.РабочийЦентр = Выборка.РабочийЦентр; 
				КонецЕсли;		
				СтрНормативы.СкоростьПечати = Выборка.СкоростьПечати;
				стрНормативы.МетрыНаБрак =  выборка.процентНаБрак*МетражДляРЦ;
				МетрыНаНастройку = выборка.МетрыНаНастройку*КоличествоНастроек;
				стрНормативы.МетрыНаНастройку = МетрыНаНастройку;
				Если ЗначениеЗаполнено(Выборка.скоростьПечати) Тогда
					Если Выборка.НФ Тогда  
						Если ЗначениеЗаполнено(Выборка.ЭтикетокНаЛисте) Тогда 
							ВремяПечати = Окр(Тираж/(Выборка.ЭтикетокНаЛисте*Выборка.СкоростьПечати),2);
						КонецЕсли;
					//ИначеЕсли Выборка.РабочийЦентр.ПорядковыйНомер = 410 Тогда
					//	ВремяПечати = Окр(Тираж/(ЗаказСсылка.Ручьи*Выборка.СкоростьПечати),2);		
						
					Иначе
						ВремяПечати =  Окр(((МетражДляРЦ+стрНормативы.метрыНаБрак)/Выборка.скоростьПечати)/60,2);
					КонецЕсли;	
				КонецЕсли;	
				стрНормативы.ВремяПечати =ВремяПечати;
				стрНормативы.ВремяНаНастройку = Окр(Выборка.ВремяНаНастройку/60,2)*КоличествоНастроек;
				стрНормативы.ПроцентНаБрак = Выборка.ПроцентНаБрак100;
				
				МетражДляРЦ = МетражДляРЦ+стрНормативы.метрыНаБрак+МетрыНаНастройку;
				стрНормативы.метражДляРЦ = МетражДляРЦ;
				Если ЗначениеЗаполнено(Выборка.длинаролика) Тогда 
					стрНормативы.времянасменуроликов = 5*Выборка.КоличествоМатериалов*Окр((МетражДляРЦ/Выборка.ДлинаРолика) + 0.4999) + 5 *Выборка.КоличествоТиснений*Окр((МетражДляРЦ/2000) + 0.4999);
				КонецЕсли;
				
				//МойкаСекций = МойкаСекций+НормативыДляРЦ.МойкаСекций;
				//Т.к. настроек может быть несколько!
				
				ВремяВыполненияЗаказаВЧасах = ВремяВыполненияЗаказаВЧасах+ВремяПечати+стрНормативы.ВремяНаНастройку+Окр(стрНормативы.времянасменуроликов/60,2);
				Если ЗаказСсылка.ДатаОтправкиВРаботу < '202107211530' Тогда
					ДлинаПечати = Выборка.ДлинаПечати;
				Иначе
					ДлинаПечати =  ЗаказСсылка.ДлинаПечатиИндиго;
