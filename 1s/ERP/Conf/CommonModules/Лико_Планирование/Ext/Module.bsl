	|	Работы.РабочийЦентр КАК РабочийЦентр,
	|	Работы.Нарезка КАК Нарезка,
	|	Работы.ПроцентЗаливки КАК ПроцентЗаливки,
	|	Работы.Дополнительно КАК Дополнительно,
	|	Работы.ЭтикетокВПодаче КАК ЭтикетокВПодаче,
	|	Работы.ЗаказНовойОснастки КАК ЗаказНовойОснастки
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&Работы КАК Работы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	ВидыРаботСотрудников.Ссылка КАК ВидРабот,
	|	ВТ.Оснастка КАК Оснастка,
	|	ВТ.Материал КАК Материал,
	|	ВТ.Клей КАК Клей,
	|	ВТ.РабочийЦентр КАК РабочийЦентр,
	|	ВТ.Нарезка КАК Нарезка,
	|	ВТ.ПроцентЗаливки КАК ПроцентЗаливки,
	|	ВТ.Дополнительно КАК Дополнительно,
	|	ВТ.ЭтикетокВПодаче КАК ЭтикетокВПодаче,
	|	ВТ.ЗаказНовойОснастки КАК ЗаказНовойОснастки
	|ПОМЕСТИТЬ ВТРаботы
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыРаботСотрудников КАК ВидыРаботСотрудников
	|		ПО ВТ.ВидРабот = ВидыРаботСотрудников.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРаботы.НомерСтроки КАК НомерСтроки,
	|	ВТРаботы.ВидРабот КАК ВидРабот,
	|	ЕСТЬNULL(РабочиеЦентрыВидыРабот.ПроверятьКод, ЛОЖЬ) КАК ПроверятьКод,
	|	ВЫБОР
	|		КОГДА ВТРаботы.ВидРабот ЕСТЬ NULL
	|			ТОГДА ""Указан не корректный вид работ ""
	|		КОГДА ВТРаботы.ВидРабот.Лико_Оснастка = ИСТИНА
	|				И ВТРаботы.ЗаказНовойОснастки = ЛОЖЬ
	|				И ВТРаботы.Оснастка = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ""Не указана оснастка ""
	|		КОГДА ВТРаботы.ВидРабот.Лико_Материал = ИСТИНА
	|				И (ВТРаботы.Материал = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|					ИЛИ ВТРаботы.Материал = ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
	|					ИЛИ ВТРаботы.Материал = НЕОПРЕДЕЛЕНО)
	|			ТОГДА ""Не указан материал ""
	|		КОГДА ВТРаботы.ВидРабот.Лико_Клей = ИСТИНА
	|				И (ВТРаботы.Клей = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|					ИЛИ ВТРаботы.Клей = ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
	|					ИЛИ ВТРаботы.Клей = НЕОПРЕДЕЛЕНО)
	|			ТОГДА ВЫБОР
	|					КОГДА ВТРаботы.ВидРабот = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Нумератор)
	|						ТОГДА ""Не указан код чернил""
	|					ИНАЧЕ ""Не указан клей""
	|				КОНЕЦ
	|		КОГДА ВТРаботы.ВидРабот.Лико_Нарезка = ИСТИНА
	|				И ВТРаботы.Нарезка = ЗНАЧЕНИЕ(Справочник.ЯССМ_Нарезки.ПустаяСсылка)
	|			ТОГДА ""Не указана нарека""
	|		КОГДА ВТРаботы.ВидРабот.Лико_ПроцентЗаливки = ИСТИНА
	|				И ВТРаботы.ПроцентЗаливки = 0
	|			ТОГДА ""Не указан процент заливки""
	|		КОГДА ВТРаботы.ВидРабот.Лико_Дополнительно = ИСТИНА
	|				И ВТРаботы.Дополнительно = 0
	|			ТОГДА ВЫБОР
	|					КОГДА ВТРаботы.ВидРабот.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Тиснение)
	|						ТОГДА ""Не указана подача  ""
	|					ИНАЧЕ ""Не указано количество ручьев нумератора""
	|				КОНЕЦ
	|		КОГДА ВТРаботы.ВидРабот.Лико_ЭтикетокВПодаче = ИСТИНА
	|				И ВТРаботы.ЭтикетокВПодаче = 0
	|			ТОГДА ""Не указано количество этикеток в подаче ""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ОписаниеОшибки,
	|	РабочиеЦентрыВидыРабот.ВидРабот КАК ВидРаботРЦ,
	|	РабочиеЦентрыВидыРабот.КодОснастки КАК КодОснасткиРЦ,
	|	ВТРаботы.Оснастка КАК Оснастка,
	|	ВТРаботы.РабочийЦентр В
	|		(ВЫБРАТЬ
	|			РабочиеЦентры.Ссылка КАК Ссылка
	|		ИЗ
	|			Справочник.РабочиеЦентры КАК РабочиеЦентры
	|		ГДЕ
	|			РабочиеЦентры.ПорядковыйНомер = 2) КАК Поле1
	|ИЗ
	|	ВТРаботы КАК ВТРаботы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РабочиеЦентры.ВидыРабот КАК РабочиеЦентрыВидыРабот
	|		ПО ВТРаботы.ВидРабот = РабочиеЦентрыВидыРабот.ВидРабот
	|			И ВТРаботы.РабочийЦентр = РабочиеЦентрыВидыРабот.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|		ПО ВТРаботы.Оснастка = Лико_ПараметрыШтампа.Номенклатура";

		
	Запрос.УстановитьПараметр("Работы", Работы);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ОписаниеОшибки) Тогда 
			ТекстОшибки = ТекстОшибки+	"В строке "+ Выборка.НомерСтроки+ " "+Выборка.ОписаниеОшибки;
		Иначе
			Если Выборка.ПроверятьКод Тогда 
				Если Лев(Выборка.Оснастка.Артикул, СтрДлина(Выборка.КодОснасткиРЦ))<> Выборка.КодОснасткиРЦ Тогда 
		   			ТекстОшибки = ТекстОшибки+	"В строке "+ Выборка.НомерСтроки+ " указана не корректная оснастка! Код оснастки должен начинаться на "+ Выборка.КодОснасткиРЦ;
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.Оснастка) Тогда
				Если Выборка.Оснастка.Лико_НеИспользовать Тогда
					ТекстОшибки = ТекстОшибки + "В строке "+ Выборка.НомерСтроки+ " указана оснастка, которая не используется!"+ Выборка.Оснастка.НаименованиеПолное;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	Если ТекстОШибки <> "" Тогда 
		Возврат ТекстОшибки;
	Иначе 
		Возврат Истина;
		
	КонецЕсли;


КонецФункции

Функция ПроверитьЗаполнениеЦветов(Цвета) Экспорт
	ТекстОшибки = "";
	БезЛака = Истина;
	Если Цвета.Количество()>0 Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Цвета.НомерПроката КАК НомерПроката,
		|	Цвета.ВидСекции КАК ВидСекции,
		|	Цвета.РабочийЦентр КАК РабочийЦентр
		|ПОМЕСТИТЬ Цвета
		|ИЗ
		|	&Цвета КАК Цвета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Цвета.РабочийЦентр КАК РабочийЦентр,
		|	Цвета.НомерПроката КАК НомерПроката,
		|	Лико_ВидыСекций.ВидПечати КАК ВидПечати
		|ПОМЕСТИТЬ ВТЦвета
		|ИЗ
		|	Цвета КАК Цвета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ВидыСекций КАК Лико_ВидыСекций
		|		ПО Цвета.ВидСекции = Лико_ВидыСекций.Ссылка
		|			И (Лико_ВидыСекций.ВидПечати <> ЗНАЧЕНИЕ(Справочник.Лико_ВидыПечати.Пустаяссылка))
		|
		|СГРУППИРОВАТЬ ПО
		|	Лико_ВидыСекций.ВидПечати,
		|	Цвета.РабочийЦентр,
		|	Цвета.НомерПроката
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТЦвета.РабочийЦентр КАК РабочийЦентр,
		|	ВТЦвета.НомерПроката КАК НомерПроката,
		|	ВТЦвета.ВидПечати КАК ВидПечати,
		|	РабочиеЦентрыЦвета.ВидПечати КАК ВидПечати1
		|ИЗ
		|	ВТЦвета КАК ВТЦвета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РабочиеЦентры.Цвета КАК РабочиеЦентрыЦвета
		|		ПО ВТЦвета.РабочийЦентр = РабочиеЦентрыЦвета.Ссылка
		|			И ВТЦвета.ВидПечати = РабочиеЦентрыЦвета.ВидПечати
		|ГДЕ
		|	РабочиеЦентрыЦвета.ВидПечати ЕСТЬ NULL";
		Запрос.УстановитьПараметр("Цвета", Цвета);
		Выборка = Запрос.Выполнить().Выбрать();
		ПОка Выборка.Следующий() Цикл
			ТекстОшибки =ТекстОшибки + " На машине " +выборка.РабочийЦентр + " не возможно напечатать цвет "+ выборка.ВидПечати;
			Возврат ТекстОшибки;
		КонецЦикла;


	КонецЕсли;
	Если ТекстОШибки <> "" Тогда 
		Возврат ТекстОшибки;
	Иначе Возврат Истина;
	КонецЕсли;


КонецФункции

Процедура ПометитьНаУдалениеЗаказыНаПроизводствоЭтапы(Заказ, Отказ);
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаПроизводство2_2.Ссылка КАК ЗаказНаПроизводство,
	|	ЗаказНаПроизводство2_2.ПометкаУдаления КАК ПометкаУдаления,
	|	ЭтапПроизводства2_2.Ссылка КАК Этап
	|ИЗ
	|	Документ.ЗаказНаПроизводство2_2 КАК ЗаказНаПроизводство2_2
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	|		ПО ЗаказНаПроизводство2_2.Ссылка = ЭтапПроизводства2_2.Распоряжение
	|			И (ЭтапПроизводства2_2.ПометкаУдаления = ЛОЖЬ)
	|ГДЕ
	|	ЗаказНаПроизводство2_2.ДокументОснование = &Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭтапПроизводства2_2.Номер
	|ИТОГИ ПО
	|	ЗаказНаПроизводство";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	ВыборкаЗаказПР = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ЗаказНаПроизводство");
	Пока ВыборкаЗаказПР.Следующий() Цикл
		Если  ЗначениеЗаполнено(ВыборкаЗаказПР.ЗаказНаПроизводство) Тогда 
			//Помечаем на удаление Заказ на производство и все сопутствующие этапы
			Выборка = ВыборкаЗаказПр.Выбрать();
			Пока Выборка.Следующий() Цикл
				Если ЗначениеЗаполнено(Выборка.Этап) Тогда
					Попытка 
						ЭтапОбъект = Выборка.Этап.ПолучитьОбъект();
						ЭтапОбъект.ПометкаУдаления = Истина;
						ЭтапОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					Исключение
						Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось пометить на удаление этап. "+Выборка.Этап.Номер+ " Заказ не отправлен в работу. " + ОписаниеОшибки());
						ОтменитьТранзакцию();
						Отказ = Истина;
						Возврат;
					КонецПопытки;
				КонецЕсли;	

			КонецЦикла;
			Если ВыборкаЗаказПр.ПометкаУдаления=Ложь Тогда 
				Попытка 
					ЗаказПрОбъект = ВыборкаЗаказПР.ЗаказНаПроизводство.ПолучитьОбъект();;
					ЗаказПрОбъект.ПометкаУдаления = Истина;
					ЗаказПрОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Исключение
					Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось пометить на удаление заказ на производство. Заказ не отправлен в работу. " + ОписаниеОшибки());
					ОтменитьТранзакцию();
					Отказ = Истина;
					Возврат;
				КонецПопытки;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры	

Функция ПроверитьНеобходимостьЦветоделения(Заказ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаЦвета.Ссылка КАК Заказ,
	|	МАКСИМУМ(ЗаказКлиентаЦвета.Цветоделение = ИСТИНА
	|			ИЛИ ЗаказКлиентаЦвета.Перегравировка = ИСТИНА) КАК Цветоделение,
	|	ЗаказКлиентаЦвета.Ссылка.ДатаУтвержденияЦветов КАК ДатаУтвержденияЦветов
	|ПОМЕСТИТЬ ТабДанные
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	|ГДЕ
	|	ЗаказКлиентаЦвета.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаЦвета.Ссылка,
	|	ЗаказКлиентаЦвета.Ссылка.ДатаУтвержденияЦветов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ЗаказКлиентаЦветоделение.ДатаЦветоделения) КАК ДатаЦветоделенияМаксимум,
	|	ЗаказКлиентаЦветоделение.Ссылка КАК Заказ,
	|	МИНИМУМ(ЗаказКлиентаЦветоделение.ДатаЦветоделения) КАК ДатаЦветоделенияМинимум
	|ПОМЕСТИТЬ ТабЦветоделение
	|ИЗ
	|	Документ.ЗаказКлиента.Цветоделение КАК ЗаказКлиентаЦветоделение
	|ГДЕ
	|	ЗаказКлиентаЦветоделение.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаЦветоделение.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДанные.Заказ КАК Заказ,
	|	ТабДанные.Цветоделение КАК Цветоделение,
	|	ВЫБОР
	|		КОГДА ТабДанные.Цветоделение = ЛОЖЬ
	|				ИЛИ ТабЦветоделение.ДатаЦветоделенияМинимум = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ТабЦветоделение.ДатаЦветоделенияМаксимум ЕСТЬ NULL
	|						ИЛИ ТабДанные.ДатаУтвержденияЦветов > ТабЦветоделение.ДатаЦветоделенияМаксимум
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|	КОНЕЦ КАК НеобходимостьЦветоделения,
	|	ТабЦветоделение.ДатаЦветоделенияМаксимум КАК ДатаЦветоделенияМаксимум,
	|	ТабЦветоделение.ДатаЦветоделенияМинимум КАК ДатаЦветоделенияМинимум
	|ИЗ
	|	ТабДанные КАК ТабДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабЦветоделение КАК ТабЦветоделение
	|		ПО ТабДанные.Заказ = ТабЦветоделение.Заказ";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Возврат Результат.НеобходимостьЦветоделения;
	
КонецФункции

Процедура ПроверитьДоходностьЗаказа(Заказ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =  
	"ВЫБРАТЬ
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ КАК Заказ,
	|	Лико_ПараметрыПроизводстваЗаказа.Доходность КАК Доходность,
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ.НомерБезПрефикса КАК Номер,
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ.Партнер КАК Партнер,
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ.Менеджер КАК Менеджер,
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ.Этикетки КАК Этикетки,
	|	Лико_ПараметрыПроизводстваЗаказа.Рентабельность КАК Рентабельность
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|ГДЕ
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ = &Заказ
	|	И Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1
	|	И Лико_ПараметрыПроизводстваЗаказа.Заказ.ВидЗаказа <> ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.Техобслуживание)
	|	И Лико_ПараметрыПроизводстваЗаказа.Заказ.ВидЗаказа <> ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.ТестированиеМатериалов)
	|	И Лико_ПараметрыПроизводстваЗаказа.Заказ.ВидЗаказа <> ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка)
	|	И Лико_ПараметрыПроизводстваЗаказа.Заказ.ВидЗаказа <> ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.ПеределЗаказаПричинаРекламация)
	|	И (Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.Indigo)
	|			ИЛИ Лико_ПараметрыПроизводстваЗаказа.Заказ.Цифровой)
