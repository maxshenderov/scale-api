	|		ПО ВТОсновнойМатериал.Регистратор = ВТМаксимум.Регистратор
	|			И ВТОсновнойМатериал.Заказ = ВТМаксимум.Заказ
	|			И ВТОсновнойМатериал.Количество = ВТМаксимум.Количество
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТМаксимум.Регистратор,
	|	ВТМаксимум.Заказ,
	|	ВТМаксимум.ДокументОтгрузки,
	|	ВТМаксимум.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРЦ.Регистратор КАК Регистратор,
	|	ВТРЦ.Период КАК Период,
	|	ВТРЦ.Заказ КАК ЗаказКлиента,
	|	ВТРЦ.ДокументОтгрузки КАК ДокументОтгрузки,
	|	ВТРЦ.РабочийЦентр КАК РабочийЦентр,
	|	ВТ.Затрата КАК Затрата,
	|	ВТ.СтатьяЗатрат КАК СтатьяЗатрат,
	|	ВТ.НомерПроката КАК НомерПроката,
	|	ВТ.ВидРабот КАК ВидРабот,
	|	ВТ.НомерРаботы КАК НомерРаботы,
	|	ВТ.ВидНастроечногоМатериала КАК ВидНастроечногоМатериала,
	|	ВТ.Количество КАК Количество,
	|	ВТ.КоличествоПМ КАК КоличествоПМ,
	|	ВТ.ЦГ КАК ЦГ,
	|	ВТ.Сумма КАК Сумма,
	|	ЕСТЬNULL(ВТ.МетражФакт, 0) КАК МетражФакт,
	|	ЕСТЬNULL(ВТ.МетражФактПМ, 0) КАК МетражФактПМ,
	|	ВЫБОР
	|		КОГДА ВТ.Регистратор ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЗаполнятьЗатраты
	|ИЗ
	|	ВТРЦ КАК ВТРЦ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	|		ПО ВТРЦ.Регистратор = ВТ.Регистратор
	|			И ВТРЦ.Заказ = ВТ.ЗаказКлиента
	|			И ВТРЦ.ДокументОтгрузки = ВТ.ДокументОтгрузки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Количество УБЫВ
	|ИТОГИ
	|	МАКСИМУМ(Регистратор),
	|	МАКСИМУМ(Период),
	|	МАКСИМУМ(ДокументОтгрузки),
	|	МАКСИМУМ(РабочийЦентр),
	|	СУММА(МетражФакт),
	|	СУММА(МетражФактПМ),
	|	МАКСИМУМ(ЗаполнятьЗатраты)
	|ПО
	|	ЗаказКлиента";

	Запрос.УстановитьПараметр("Регистратор", Регистратор);

						
	ВыборкаЗаказы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ЗаказКлиента");
	ПОка ВыборкаЗаказы.Следующий() Цикл
		ОсновнойМатериал = Справочники.ЦеновыеГруппы.ПустаяСсылка();
		Если ВЫборкаЗаказы.ЗаполнятьЗатраты Тогда 
			Выборка = ВыборкаЗаказы.Выбрать();
			ПОка ВЫборка.Следующий() Цикл
				Если Выборка.СтатьяЗатрат = Справочники.Лико_СтатьиЗатрат.ОсновнойМатериал И Не ЗначениеЗаполнено(ОсновнойМатериал) Тогда 
					ОсновнойМатериал = Выборка.ЦГ;
				КонецЕсли;
				Запись = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(Запись, Выборка);
				Если Не ЗначениеЗаполнено(Выборка.Сумма)  Тогда 
					Цена = Лико_Планирование.ЦенаЦеновойГруппы(Выборка.ЦГ, Выборка.Период, Выборка.ЗаказКлиента.Площадка.Организация);
					Запись.Сумма = Выборка.Количество*Цена;
				КонецЕсли;
				Запись.Регистратор =Регистратор;
				Запись.Период = Регистратор.Дата;	
			КонецЦикла;
		КонецЕсли;	
		Для каждого ЗаписьОтгрузки Из НаборЗаписейОтгрузки   Цикл
			Если ЗаписьОтгрузки.Заказ = ВыборкаЗаказы.ЗаказКлиента Тогда
				ЗаписьОтгрузки.МетражФакт = ВыборкаЗаказы.МетражФакт;
				ЗаписьОтгрузки.МетражФактПМ = ВыборкаЗаказы.МетражФактПМ;
				ЗаписьОтгрузки.РабочийЦентр = ВЫборкаЗаказы.РабочийЦентр;
				ЗаписьОтгрузки.РабочийЦентр = ВЫборкаЗаказы.РабочийЦентр;
				Если ЗначениеЗаполнено(ОсновнойМатериал) Тогда 
					ЗаписьОтгрузки.ОсновнойМатериал = ОсновнойМатериал;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;		
	КонецЦикла;	
	НаборЗаписей.Записать();
	НаборЗаписейОтгрузки.Записать();

	
КонецПроцедуры


Процедура ЗаполнитьЗатратыНаПоследнююОтгрузку(ЗаказОбъект, КлючСтроки, Отказ) Экспорт
	текстр = ЗаказОбъект.Отгрузки.Найти(КлючСтроки,"КлючСтроки");

	ТЗ_РаботыМатериалы = ПолучитьТаблицуРаботСМатериалами(ЗаказОбъект.Ссылка);
	Для каждого стрРабот из ТЗ_РаботыМатериалы Цикл
		ТЗ = ПолучитьНеучтенныеЗатраты(ЗаказОбъект.Ссылка, стрРабот.ВидРабот,стрРабот.номерработы );
	    Для каждого стр из ТЗ Цикл
			стрзт = ЗаказОбъект.затратыПоОтгрузке.Добавить();
			ЗаполнитьЗначенияСвойств(стрЗТ, стр);
			стрзт.НомерОтгрузки = ключстроки;
			//стрзт.номерработы = 1;
		КонецЦикла;
	КонецЦикла;
	////Добавим количество кликов
	ТекСтр.КоличествоКликов =0;
	// --> Начало Лико Ефимов ЕВВ 04.08.2023
	//ВсегоКликов = ЗаказОбъект.ПервыйПрокат.Итог("ВсегоКликов");
	ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК = Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК.ЗначениеПараметра;
	Если ЗначениеЗаполнено(ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК) И ТекущаяДата() >= ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК И ЗаказОбъект.Дата >= Дата('20230101') Тогда
		ВсегоКликов = ЗаказОбъект.Производство.Итог("ВсегоКликов");
	Иначе
		ВсегоКликов = ЗаказОбъект.ПервыйПрокат.Итог("ВсегоКликов");
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 04.08.2023
	УчтеноКликов = ЗаказОбъект.Отгрузки.Итог("КоличествоКликов");
	Если УчтеноКликов<ВсегоКликов Тогда
		ТекСтр.КоличествоКликов = ВсегоКликов-УчтеноКликов;
	КонецЕсли;
	
	ЗаполнитьКоличествоКоробокИРоликовИзДокументовОтгрузок(ЗаказОбъект) ;
	
КонецПроцедуры

Процедура ЗаполнитьЗатратыНаОтгрузкуПоНормам(ЗаказОбъект, КлючСтроки, Отказ) Экспорт

	текстр = ЗаказОбъект.Отгрузки.Найти(КлючСтроки,"КлючСтроки");
	
	//Создаем таблицу работ из "ввода данных"
	ТЗ_РаботыМатериалы = ПолучитьТаблицуРаботСМатериалами(ЗаказОбъект.Ссылка);
	Для каждого стрРабот из ТЗ_РаботыМатериалы Цикл
		//Определяем нормы для вида работ
		Если стрРабот.ВидРабот.Родитель = Справочники.ВидыРаботСотрудников.Тиснение Тогда
			Если стрРабот.НомерРаботы = 1 Тогда 
				Норма = текстр.ТиснениеПлан1;
			Иначе
				Норма = текстр.ТиснениеПлан2;
			КонецЕсли;
		ИначеЕсли стрРабот.ВидРабот.Родитель = Справочники.ВидыРаботСотрудников.Ламинирование Тогда
			Если стрРабот.НомерРаботы = 1 Тогда 
				Норма = текстр.ЛаминацияПлан1;
			Иначе
				Норма = текстр.ЛаминацияПлан2;
			КонецЕсли;
	    Иначе		
			//Заполняем основной материал по норме
			Норма = текстр.ОбщийМетраж;
		КонецЕсли;
		
		ТЗ = ПолучитьНеучтенныеЗатраты(ЗаказОбъект.Ссылка, стрРабот.ВидРабот,стрРабот.номерработы );
		Для каждого стр из ТЗ Цикл
			стрзт = ЗаказОбъект.затратыПоОтгрузке.Добавить();
			ЗаполнитьЗначенияСвойств(стрЗТ, стр);
			стрзт.НомерОтгрузки = текстр.ключстроки;
			стрзт.номерработы = стрРабот.НомерРаботы;
			Если Норма>стр.количество Тогда 
				надосписать = стр.количество;
			Иначе
				надосписать = Норма;
			КонецЕсли;	
			стрзт.Количество = надосписать;
			Норма = Норма-НадоСписать;
			Если Норма <=0 Тогда 
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;	
	текстр.количествокликов = текстр.РасчетноеКоличествоКликов;
	
КонецПроцедуры

