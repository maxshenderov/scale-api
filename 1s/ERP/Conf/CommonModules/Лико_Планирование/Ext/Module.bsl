		|		КОГДА ПОДСТРОКА(СправочникНоменклатура.ЦеноваяГруппа.Код, 4, 2) = ""00""
		|				ИЛИ ПОДСТРОКА(СправочникНоменклатура.ЦеноваяГруппа.Код, 4, 2) = ""01""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Тиснение)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Пустаяссылка)
		|	КОНЕЦ КАК ПризнакРаботы,
		|	&Заказ КАК Заказ
		|ПОМЕСТИТЬ ВТДанные
		|ИЗ
		|	Справочник.Номенклатура КАК СправочникНоменклатура
		|ГДЕ
		|	СправочникНоменклатура.Ссылка = &Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЗаказКлиента.ОсновнойМатериалФакт <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
		|			ТОГДА ЗаказКлиента.ОсновнойМатериалФакт.Ссылка
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ЗаказКлиента.ОсновнойМатериал ССЫЛКА Справочник.Номенклатура
		|					ТОГДА ЗаказКлиента.ОсновнойМатериал.ЦеноваяГруппа
		|				ИНАЧЕ ЗаказКлиента.ОсновнойМатериал.Ссылка
		|			КОНЕЦ
		|	КОНЕЦ КАК ОсновнойМатериал,
		|	ЗаказКлиента.Ссылка КАК Заказ,
		|	ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Печать) КАК ВидРабот,
		|	1 КАК НомерРаботы
		|ПОМЕСТИТЬ ВТОсновной
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Ссылка = &Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаВидыРабот.МатериалФакт <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
		|			ТОГДА ЗаказКлиентаВидыРабот.МатериалФакт.Ссылка
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ЗаказКлиентаВидыРабот.Материал ССЫЛКА Справочник.Номенклатура
		|					ТОГДА ЗаказКлиентаВидыРабот.Материал.ЦеноваяГруппа
		|				ИНАЧЕ ЗаказКлиентаВидыРабот.Материал.Ссылка
		|			КОНЕЦ
		|	КОНЕЦ КАК ДопМатериал,
		|	ЗаказКлиентаВидыРабот.Ссылка КАК Заказ,
		|	ЗаказКлиентаВидыРабот.ВидРабот КАК ВидРабот,
		|	ЗаказКлиентаВидыРабот.Клей КАК Клей,
		|	ЗаказКлиентаВидыРабот.НомерРаботы КАК НомерРаботы
		|ПОМЕСТИТЬ ВТДоп
		|ИЗ
		|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
		|ГДЕ
		|	ЗаказКлиентаВидыРабот.Материал <> НЕОПРЕДЕЛЕНО
		|	И ЗаказКлиентаВидыРабот.Материал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	И ЗаказКлиентаВидыРабот.Материал <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
		|	И ЗаказКлиентаВидыРабот.Ссылка = &Заказ
		|	И ЗаказКлиентаВидыРабот.НомерПроката = &НомерПроката
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаВидыРабот.Ссылка,
		|	ЗаказКлиентаВидыРабот.ВидРабот,
		|	ЗаказКлиентаВидыРабот.Клей,
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаВидыРабот.МатериалФакт <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
		|			ТОГДА ЗаказКлиентаВидыРабот.МатериалФакт.Ссылка
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ЗаказКлиентаВидыРабот.Материал ССЫЛКА Справочник.Номенклатура
		|					ТОГДА ЗаказКлиентаВидыРабот.Материал.ЦеноваяГруппа
		|				ИНАЧЕ ЗаказКлиентаВидыРабот.Материал.Ссылка
		|			КОНЕЦ
		|	КОНЕЦ,
		|	ЗаказКлиентаВидыРабот.НомерРаботы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТДоп.ВидРабот.Родитель КАК ПризнакРаботы,
		|	КОЛИЧЕСТВО(ВТДоп.ВидРабот) КАК КоличествоДопРабот,
		|	ВТДоп.Заказ КАК Заказ
		|ПОМЕСТИТЬ ВТКоличествоДопРабот
		|ИЗ
		|	ВТДоп КАК ВТДоп
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТДоп.ВидРабот.Родитель,
		|	ВТДоп.Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТКоличествоДопРабот.КоличествоДопРабот КАК КоличествоДопРаботОбщее,
		|	ВТКоличествоДопРабот.Заказ КАК Заказ
		|ПОМЕСТИТЬ ВТКоличествоДопРаботОбщее
		|ИЗ
		|	ВТКоличествоДопРабот КАК ВТКоличествоДопРабот
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТКоличествоДопРабот.КоличествоДопРабот,
		|	ВТКоличествоДопРабот.Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТДанные.Номенклатура КАК Номенклатура,
		|	ВТДанные.ЦеноваяГруппа КАК ЦеноваяГруппа,
		|	ЕСТЬNULL(ВТОсновной.ВидРабот, ВТДоп.ВидРабот) КАК ВидРабот,
		|	ВТДанные.НомерПроката КАК НомерПроката,
		|	ВТДанные.ПризнакРаботы КАК ПризнакРаботы,
		|	ВТДанные.РулонныйМатериал КАК РулонныйМатериал,
		|	ЕСТЬNULL(ВТКоличествоДопРабот.КоличествоДопРабот, 0) КАК КоличествоДопРабот,
		|	ВТДанные.Заказ КАК Заказ,
		|	ЕСТЬNULL(ВТКоличествоДопРаботОбщее.КоличествоДопРаботОбщее, 0) КАК КоличествоДопРаботОбщее,
		|	ЕСТЬNULL(ВТОсновной.НомерРаботы, ВТДоп.НомерРаботы) КАК НомерРаботы
		|ИЗ
		|	ВТДанные КАК ВТДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОсновной КАК ВТОсновной
		|		ПО ВТДанные.ЦеноваяГруппа = ВТОсновной.ОсновнойМатериал
		|			И (&НомерПроката = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДоп КАК ВТДоп
		|		ПО ВТДанные.ЦеноваяГруппа = ВТДоп.ДопМатериал
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКоличествоДопРабот КАК ВТКоличествоДопРабот
		|		ПО ВТДанные.ПризнакРаботы = ВТКоличествоДопРабот.ПризнакРаботы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКоличествоДопРаботОбщее КАК ВТКоличествоДопРаботОбщее
		|		ПО ВТДанные.Заказ = ВТКоличествоДопРаботОбщее.Заказ";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);

	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		НайденнаяРабота.ВидРабот = Выборка.ВидРабот;
		НайденнаяРабота.НомерРаботы = Выборка.НомерРаботы;
		Если Не ЗначениеЗаполнено(Выборка.ВидРабот) Тогда 
			Если Выборка.КоличествоДопРаботОбщее = 0 И НомерПроката = 1 Тогда 
					НайденнаяРабота.ВидРабот =Справочники.ВидыРаботСотрудников.Печать;
					НайденнаяРабота.НомерРаботы = 1;
			Иначе
				Если ЗначениеЗаполнено(Выборка.ПризнакРаботы) Тогда 
					НайденнаяРабота= НайтиРаботу(Выборка.Заказ, Выборка.ПризнакРаботы);					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат НайденнаяРабота;
	УстановитьПривилегированныйРежим(Ложь);
КонецФункции

Функция НайтиВидСекцииПоНоменклатуре(Заказ, НомерПроката, Номенклатура) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	НайденнаяСекция = Новый Структура("ВидСекции, НомерРаботы");
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СправочникНоменклатура.Ссылка КАК Номенклатура,
		|	СправочникНоменклатура.ЦеноваяГруппа КАК ЦеноваяГруппа,
		|	&НомерПроката КАК НомерПроката,
		|	СправочникНоменклатура.ВидНоменклатуры.Лико_РулонныйМатериал КАК РулонныйМатериал,
		|	&Заказ КАК Заказ,
		|	ВЫБОР
		|		КОГДА ПОДСТРОКА(СправочникНоменклатура.ЦеноваяГруппа.Код, 4, 2) = ""00""
		|				ИЛИ ПОДСТРОКА(СправочникНоменклатура.ЦеноваяГруппа.Код, 4, 2) = ""01""
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоТиснение
		|ПОМЕСТИТЬ ВТДанные
		|ИЗ
		|	Справочник.Номенклатура КАК СправочникНоменклатура
		|ГДЕ
		|	СправочникНоменклатура.Ссылка = &Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЗаказКлиента.ОсновнойМатериалФакт <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
		|			ТОГДА ЗаказКлиента.ОсновнойМатериалФакт.Ссылка
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ЗаказКлиента.ОсновнойМатериал ССЫЛКА Справочник.Номенклатура
		|					ТОГДА ЗаказКлиента.ОсновнойМатериал.ЦеноваяГруппа
		|				ИНАЧЕ ЗаказКлиента.ОсновнойМатериал.Ссылка
		|			КОНЕЦ
		|	КОНЕЦ КАК ОсновнойМатериал,
		|	ЗаказКлиента.Ссылка КАК Заказ,
		|	ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Печать) КАК ВидРабот,
		|	1 КАК НомерРаботы
		|ПОМЕСТИТЬ ВТОсновной
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Ссылка = &Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаЦвета.Материал ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ЗаказКлиентаЦвета.Материал.ЦеноваяГруппа
		|		ИНАЧЕ ЗаказКлиентаЦвета.Материал.Ссылка
		|	КОНЕЦ КАК ДопМатериал,
		|	ЗаказКлиентаЦвета.Ссылка КАК Заказ,
		|	ЗаказКлиентаЦвета.ВидСекции КАК ВидРабот,
		|	МИНИМУМ(ЗаказКлиентаЦвета.НомерРаботы) КАК НомерРаботы
		|ПОМЕСТИТЬ ВТДоп
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
		|ГДЕ
		|	ЗаказКлиентаЦвета.Материал <> НЕОПРЕДЕЛЕНО
		|	И ЗаказКлиентаЦвета.Материал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	И ЗаказКлиентаЦвета.Материал <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
		|	И ЗаказКлиентаЦвета.Ссылка = &Заказ
		|	И ЗаказКлиентаЦвета.НомерПроката = &НомерПроката
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаЦвета.Ссылка,
		|	ЗаказКлиентаЦвета.ВидСекции,
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаЦвета.Материал ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ЗаказКлиентаЦвета.Материал.ЦеноваяГруппа
		|		ИНАЧЕ ЗаказКлиентаЦвета.Материал.Ссылка
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТДанные.Номенклатура КАК Номенклатура,
		|	ВТДанные.ЦеноваяГруппа КАК ЦеноваяГруппа,
		|	ЕСТЬNULL(ВТОсновной.ВидРабот, ВТДоп.ВидРабот) КАК ВидРабот,
		|	ВТДанные.НомерПроката КАК НомерПроката,
		|	ВТДанные.ЭтоТиснение КАК ПризнакРаботы,
		|	ВТДанные.РулонныйМатериал КАК РулонныйМатериал,
		|	ВТДанные.Заказ КАК Заказ,
		|	ЕСТЬNULL(ВТОсновной.НомерРаботы, ВТДоп.НомерРаботы) КАК НомерРаботы
		|ИЗ
		|	ВТДанные КАК ВТДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОсновной КАК ВТОсновной
		|		ПО ВТДанные.ЦеноваяГруппа = ВТОсновной.ОсновнойМатериал
		|			И (&НомерПроката = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДоп КАК ВТДоп
		|		ПО ВТДанные.ЦеноваяГруппа = ВТДоп.ДопМатериал
		|			И ВТДанные.ЭтоТиснение = ВТДоп.ВидРабот.Тиснение";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);

	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		НайденнаяСекция.ВидСекции = Выборка.ВидРабот;
		НайденнаяСекция.НомерРаботы = Выборка.НомерРаботы;
	КонецЕсли;
	Возврат НайденнаяСекция;
	УстановитьПривилегированныйРежим(Ложь);
КонецФункции


Процедура ЗаполнитьСтоимостьПерегравированныхВалов(Источник, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =     
    "ВЫБРАТЬ
	 |	ПрочиеРасходыОбороты.АналитикаРасходов КАК Номенклатура,
	 |	СУММА(ПрочиеРасходыОбороты.СуммаПриход) КАК Цена
	 |ИЗ
	 |	РегистрНакопления.ПрочиеРасходы.Обороты(
	 |			,
	 |			,
	 |			Регистратор,
	 |			Организация = &Организация
	 |				И СтатьяРасходов = &Статья) КАК ПрочиеРасходыОбороты
	 |ГДЕ
	 |	ПрочиеРасходыОбороты.Регистратор = &Ссылка
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	ПрочиеРасходыОбороты.АналитикаРасходов";
	
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	Запрос.УстановитьПараметр("Организация", Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра);
	Запрос.УстановитьПараметр("Статья", ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоКоду("00-000378"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.Лико_ПараметрыШтампа.СоздатьМенеджерЗаписи();
		Запись.Номенклатура = Выборка.Номенклатура;
		Запись.Прочитать();
		Запись.Номенклатура = Выборка.Номенклатура;
		Запись.Цена = Выборка.Цена;
		Запись.Записать();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);	

	
	

КонецПроцедуры


//Закрытие бланка
Процедура ЗаполнениеЗатратЗаказаПоБланку(Док, Отказ = Ложь, ПересчитыватьОтгрузки = Истина) Экспорт

		

	Если ЗначениеЗаполнено(Док) Тогда 
		Если ЗначениеЗаполнено(Док.ЗаказПокупателя) Тогда 
			Если Док.ЗаказПокупателя.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Оснастка Тогда 
				Возврат;
			КонецЕсли; 
			Если ЗначениеЗаполнено(Док.ЗаказНаРаскрой) Тогда 
				Возврат;
			КонецЕсли;

		Иначе 
			Возврат;
		КонецЕсли;		
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	НаборЗаписейЗатратыпоЗаказу = РегистрыНакопления.Лико_ЗатратыПоЗаказу.СоздатьНаборЗаписей();
	НаборЗаписейЗатратыпоЗаказу.Отбор.Регистратор.Установить(Док);
	НаборЗаписейЗатратыпоЗаказу.Записать();



	Если ПересчитыватьОтгрузки Тогда 
		НаборЗаписейЗатратыпоЗаказуДляОтгрузки = РегистрыНакопления.Лико_ЗатратыПоЗаказуДляОтгрузки.СоздатьНаборЗаписей();
		НаборЗаписейЗатратыпоЗаказуДляОтгрузки.Отбор.Регистратор.Установить(Док);
		НаборЗаписейЗатратыпоЗаказуДляОтгрузки.Записать();
	КонецЕсли;



//	Конец_Месяца =  КонецМесяца(Док.Дата); 
    //ДатаЦены = НачалоМесяца(Док.Дата); 
	ДатаЦены = Док.Дата; 
	Площадка =  Док.Организация;
	ПлощадкаЛикофлекс = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра;


	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаЦвета.НомерПроката КАК НомерПроката,
	|	ЗаказКлиентаЦвета.НомерРаботы КАК НомерРаботы,
	|	Лико_БланкЭтапа.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ИСТИНА) КАК ДавальческоеСырье,
	|	ЗаказКлиентаЦвета.ВидСекции КАК ВидСекции
	|ПОМЕСТИТЬ ВТДавальческоеСырье
	|ИЗ
	|	Документ.Лико_БланкЭтапа КАК Лико_БланкЭтапа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	|		ПО Лико_БланкЭтапа.ЗаказПокупателя = ЗаказКлиентаЦвета.Ссылка
	|			И (ЗаказКлиентаЦвета.ДавальческоеСырье)
	|ГДЕ
	|	Лико_БланкЭтапа.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаЦвета.НомерПроката,
	|	ЗаказКлиентаЦвета.НомерРаботы,
	|	Лико_БланкЭтапа.Ссылка,
	|	ЗаказКлиентаЦвета.ВидСекции
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(&Период) КАК Период,
	|	Лико_БланкЭтапаТовары.Ссылка КАК Бланк,
	|	МАКСИМУМ(Лико_БланкЭтапаТовары.Ссылка.ЗаказПокупателя) КАК ЗаказКлиента,
	|	МАКСИМУМ(Лико_БланкЭтапаТовары.Ссылка.РабочийЦентр) КАК РабочийЦентр,
	|	Лико_БланкЭтапаТовары.Номенклатура КАК Затрата,
	|	ВЫБОР
	|		КОГДА Лико_БланкЭтапаТовары.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Печать)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ОсновнойМатериал)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ДополнительныеМатериалы)
	|	КОНЕЦ КАК СтатьяЗатрат,
	|	Лико_БланкЭтапаТовары.Ссылка.НомерПроката КАК НомерПроката,
	|	ВЫБОР
	|		КОГДА Лико_БланкЭтапаТовары.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ГорячееТиснениеПлоское)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПоперечное)
	|		ИНАЧЕ Лико_БланкЭтапаТовары.ВидСекции.ВидРабот
	|	КОНЕЦ КАК ВидРабот,
	|	Лико_БланкЭтапаТовары.НомерРаботы КАК НомерРаботы,
	|	СУММА(Лико_БланкЭтапаТовары.КоличествоРасходУУ) КАК Количество,
	|	СУММА(Лико_БланкЭтапаТовары.КоличествоРасход) КАК КоличествоПМ,
	|	Лико_БланкЭтапаТовары.Серия.ЯССМ_ОбъектНоменклатуры.ВидНастроечногоМатериала КАК ВидНастроечногоМатериала,
	|	ВЫБОР
	|		КОГДА Лико_БланкЭтапаТовары.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Печать)
	|			ТОГДА ЕСТЬNULL(Лико_БланкЭтапаТовары.Ссылка.ЗаказПокупателя.ДавальческоеСырье, ЛОЖЬ)
	|		ИНАЧЕ ЕСТЬNULL(ВТДавальческоеСырье.ДавальческоеСырье, ЛОЖЬ)
	|	КОНЕЦ КАК ДавальческоеСырье,
	|	Лико_БланкЭтапаТовары.ВидСекции КАК ВидСекции
	|ПОМЕСТИТЬ ВТМатериалы
	|ИЗ
	|	Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДавальческоеСырье КАК ВТДавальческоеСырье
	|		ПО Лико_БланкЭтапаТовары.Ссылка = ВТДавальческоеСырье.Ссылка
	|			И Лико_БланкЭтапаТовары.НомерРаботы = ВТДавальческоеСырье.НомерРаботы
	|			И Лико_БланкЭтапаТовары.Ссылка.НомерПроката = ВТДавальческоеСырье.НомерПроката
	|			И Лико_БланкЭтапаТовары.ВидСекции = ВТДавальческоеСырье.ВидСекции
	|ГДЕ
	|	Лико_БланкЭтапаТовары.Ссылка = &Ссылка
	|	И Лико_БланкЭтапаТовары.Списать
	|	И Лико_БланкЭтапаТовары.Ссылка.ЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
