Процедура УдалитьРасходЗатратПоОтгрузке(Заказ, КлючСтроки) Экспорт
	НаборЗаписей = РегистрыНакопления.Лико_ЗатратыПоЗаказуДляОтгрузки.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Заказ);
	НаборЗаписей.Прочитать();
	Массив = Новый Массив;
	Для каждого Запись из НаборЗаписей Цикл
		Если Запись.КлючСтроки =  КлючСтроки Тогда 
			Массив.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Массив Цикл
		Элемент.Удалить();
	КонецЦикла;
	НаборЗаписей.Записать();
 
КонецПроцедуры

Функция ПолучитьТаблицуРаботСМатериалами(Заказ)  Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаВидыРабот.ВидРабот КАК ВидРабот,
	|	СУММА(1) КАК КоличествоРабот,
	|	МИНИМУМ(1) КАК НомерРаботы
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &Ссылка
	|	И (ЗаказКлиентаВидыРабот.МатериалФакт <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
	|			ИЛИ ЗаказКлиентаВидыРабот.Материал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				И ЗаказКлиентаВидыРабот.Материал <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
	|				И ЗаказКлиентаВидыРабот.Материал <> НЕОПРЕДЕЛЕНО)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаВидыРабот.ВидРабот";
	Запрос.УстановитьПараметр("Ссылка", Заказ);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.КоличествоРабот >1 Тогда 
			сч = 1;
			Пока сч<Выборка.КоличествоРабот Цикл
				стрТЗ = ТЗ.Добавить();
				стрТЗ.ВидРабот = Выборка.ВидРабот;
				стрТЗ.НомерРаботы = сч+1;
				сч = сч+1;
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;
	//стрПП = ВидыРабот.Найти(Справочники.ВидыРаботСотрудников.Печать);
	//Если стрПП <> Неопределено Тогда 
		стрТЗ = ТЗ.Добавить();
		стрТЗ.видРабот = Справочники.ВидыРаботСотрудников.Печать;
	    стрТЗ.номерРаботы = 1;
	//КонецЕсли;
	
	Возврат ТЗ;	
КонецФункции

Функция ПолучитьНеучтенныеЗатраты(Заказ, ВидРабот, номерработы = 1) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	ВложенныйЗапрос.Количество - ЕСТЬNULL(ВложенныйЗапрос1.Количество, 0) КАК Количество,
	|	ВложенныйЗапрос.ВидРабот КАК ВидРабот,
	|	ВложенныйЗапрос.НомерРаботы КАК НомерРаботы
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗаказКлиентаЗатраты.Номенклатура КАК Номенклатура,
	|		СУММА(ЗаказКлиентаЗатраты.Количество) КАК Количество,
	|		МИНИМУМ(ЗаказКлиентаЗатраты.Дата) КАК Дата,
	|		ЗаказКлиентаЗатраты.ВидРабот КАК ВидРабот,
	|		ЗаказКлиентаЗатраты.НомерРаботы КАК НомерРаботы
	|	ИЗ
	|		Документ.ЗаказКлиента.Затраты КАК ЗаказКлиентаЗатраты
	|	ГДЕ
	|		ЗаказКлиентаЗатраты.ВидРабот = &ВидРабот
	|		И ЗаказКлиентаЗатраты.Ссылка = &ссылка
	|		И ЗаказКлиентаЗатраты.НомерРаботы = &номерработы
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЗаказКлиентаЗатраты.Номенклатура,
	|		ЗаказКлиентаЗатраты.ВидРабот,
	|		ЗаказКлиентаЗатраты.НомерРаботы) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЗаказКлиентаЗатратыПоОтгрузке.Номенклатура КАК Номенклатура,
	|			СУММА(ЗаказКлиентаЗатратыПоОтгрузке.Количество) КАК Количество
	|		ИЗ
	|			Документ.ЗаказКлиента.ЗатратыПоОтгрузке КАК ЗаказКлиентаЗатратыПоОтгрузке
	|		ГДЕ
	|			ЗаказКлиентаЗатратыПоОтгрузке.Ссылка = &Ссылка
	|			И ЗаказКлиентаЗатратыПоОтгрузке.ВидРабот = &ВидРабот
	|			И ЗаказКлиентаЗатратыПоОтгрузке.НомерРаботы = &номерработы
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ЗаказКлиентаЗатратыПоОтгрузке.Номенклатура) КАК ВложенныйЗапрос1
	|		ПО ВложенныйЗапрос.Номенклатура = ВложенныйЗапрос1.Номенклатура
	|ГДЕ
	|	ВложенныйЗапрос.Количество - ЕСТЬNULL(ВложенныйЗапрос1.Количество, 0) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВложенныйЗапрос.Дата";
	Запрос.УстановитьПараметр("Ссылка", Заказ);
	Запрос.УстановитьПараметр("ВидРабот", ВидРабот);
	Запрос.УстановитьПараметр("НомерРаботы", НомерРаботы);
//	Запрос.УстановитьПараметр("НомерОтгрузки", НомерОтгрузки);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возврат ТЗ;
КонецФункции

Процедура ЗаполнитьФактическиеДопМатериалы(Заказ, КлючСтроки) Экспорт
	текстр = Заказ.Отгрузки.Найти(КлючСтроки, "КлючСтроки");

	Если Не текстр.РучнаяКорректировка ТОгда 
		текстр.ФактическийМетраж = 0;
	КонецЕсли;	
	текстр.ТиснениеФакт1 = 0;
	текстр.ТиснениеФакт2 = 0;
	текстр.ЛаминацияФакт1 = 0;
	текстр.ЛаминацияФакт2=0;

	Отбор = новый Структура("НомерОтгрузки", текстр.КлючСтроки); 
	строки =Заказ.ЗатратыПоОтгрузке.НайтиСтроки(Отбор);
	Для каждого стр из Строки Цикл
		Если стр.видРабот = Справочники.ВидыРаботСотрудников.Печать Тогда 
			Если Не текстр.РучнаяКорректировка ТОгда 
				текстр.ФактическийМетраж = текстр.ФактическийМетраж+ стр.Количество;
			КонецЕсли;	
		ИначеЕсли стр.видРабот.Родитель = Справочники.ВидыРаботСотрудников.Тиснение Тогда 
			Если стр.НомерРаботы = 1 Тогда 
				текстр.ТиснениеФакт1 = текстр.ТиснениеФакт1 +стр.Количество;
			Иначе 
				текстр.ТиснениеФакт2 = текстр.ТиснениеФакт2 +стр.Количество;
			КонецЕсли;
		ИначеЕсли стр.видРабот.Родитель = Справочники.ВидыРаботСотрудников.Ламинирование Тогда  
			Если стр.НомерРаботы = 1 Тогда 
				текстр.ЛаминацияФакт1 = текстр.ЛаминацияФакт1 +стр.Количество;
			Иначе 
				текстр.ЛаминацияФакт2 = текстр.ЛаминацияФакт2 +стр.Количество;
			КонецЕсли;
		КонецЕсли;
		Если стр.ВидРабот = Справочники.ВидыРаботСотрудников.Склейка Тогда
			Если  Найти(НРег(стр.Номенклатура.Наименование),"подложка")>0 ИЛИ  Найти(НРег(стр.Номенклатура.Наименование),"жемчуж")>0  ИЛИ Найти(НРег(стр.Номенклатура.Наименование),"метал")>0  Тогда 
				текстр.ЛаминацияФакт2 = текстр.ЛаминацияФакт2 +стр.Количество;
			Иначе
				текстр.ЛаминацияФакт1 = текстр.ЛаминацияФакт1 +стр.Количество;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;		


КонецПроцедуры

Процедура ЗаполнитьФормыТрафаретыПолотна(ЗаказОбъект, КлючСтроки)  Экспорт
	текстр = ЗаказОбъект.Отгрузки.Найти(КлючСтроки, "КлючСтроки");

	аналоговые = 0;
	Цифровые = 0;
	ВысокаяПечать = 0;
	ОфсетнаяПечать = 0;
	ГлубокаяПечать = 0;
	НовыхСеток = 0;
	ПолотноОфсетное = 0;
	ПолотноДляТиснения = 0;
	Для каждого стр из ЗаказОбъект.ИзготовлениеФорм Цикл
		Если стр.ВидФормы = перечисления.Лико_ВидыФорм.Аналоговые Тогда 
			аналоговые  = аналоговые+стр.КоличествоНовых+стр.КоличествоПеределок;
		ИначеЕсли стр.ВидФормы = перечисления.Лико_ВидыФорм.Цифровые Тогда 
			Цифровые  = Цифровые+стр.КоличествоНовых+стр.КоличествоПеределок;
		ИначеЕсли стр.ВидФормы = перечисления.Лико_ВидыФорм.ВысокаяПечать Тогда 
			ВысокаяПечать  = ВысокаяПечать+стр.КоличествоНовых+стр.КоличествоПеределок;
		ИначеЕсли стр.ВидФормы = перечисления.Лико_ВидыФорм.ОфсетнаяПечать Тогда 
			ОфсетнаяПечать  = ОфсетнаяПечать+стр.КоличествоНовых+стр.КоличествоПеределок;
		ИначеЕсли стр.ВидФормы = перечисления.Лико_ВидыФорм.ГлубокаяПечать Тогда 
			ГлубокаяПечать  = ГлубокаяПечать+стр.КоличествоНовых+стр.КоличествоПеределок;
		КонецЕсли;
	КонецЦикла;
	КоличествоЗасветок = 0;
	Для каждого стр из ЗаказОбъект.ЗасветкаStork Цикл
		Если стр.Засветка Тогда
			КоличествоЗасветок = КоличествоЗасветок+1;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого стр из ЗаказОбъект.ТрафСетки Цикл
		НовыхСеток = НовыхСеток+ стр.НовыхСеток;
	КонецЦикла;
	
	

КонецПроцедуры	

Процедура ЗаполнитьКоличествоКоробокИРоликовИзДокументовОтгрузок(ЗаказОбъект) Экспорт	
	ЗаказОбъект.КоличествоРоликов = 0;
	ЗаказОбъект.КоличествоКоробок = 0;
	МассивДокументов = Новый Массив;
	Для каждого Строка из ЗаказОбъект.Отгрузки Цикл
		Если ЗначениеЗаполнено(Строка.ДокументОтгрузки) И МассивДокументов.Найти(Строка.ДокументОтгрузки) = Неопределено Тогда
			МассивДокументов.Добавить(Строка.ДокументОтгрузки);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия.Лико_КоличествоРоликов) КАК КоличествоРоликов,
		|	СУММА(1) КАК КоличествоКоробок
		|ИЗ
		|	Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерНаТовары.ОтгружаемыеТовары КАК РасходныйОрдерНаТоварыОтгружаемыеТовары
		|		ПО РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка = РасходныйОрдерНаТоварыОтгружаемыеТовары.Ссылка
		|			И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Номенклатура = РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура
		|			И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Характеристика = РасходныйОрдерНаТоварыОтгружаемыеТовары.Характеристика
		|ГДЕ
		|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка.Проведен
		|	И НЕ РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка.ПометкаУдаления
		|	И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение В(&МассивДокументов)
		|	И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Характеристика.Лико_ЗаказНоменклатуры = &Заказ";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Запрос.УстановитьПараметр("Заказ", ЗаказОбъект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаказОбъект.КоличествоРоликов = ВыборкаДетальныеЗаписи.КоличествоРоликов;
		ЗаказОбъект.КоличествоКоробок = ВыборкаДетальныеЗаписи.КоличествоКоробок;
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиСотрудникаПоПользователю(Пользователь)   Экспорт
	Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
	Сотрудник = УправлениеСвойствами.ЗначениеСвойства(Пользователь, ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Основной сотрудник"));
	Если Не значениеЗаполнено(Сотрудник) Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Сотрудник
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		|		ПО Сотрудники.ФизическоеЛицо = Пользователи.ФизическоеЛицо
		|ГДЕ
		|	Пользователи.Ссылка = &Пользователь";
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Возврат Выборка.Сотрудник;	
		КонецЦикла;
	КонецЕсли;	
	Возврат Сотрудник; 
КонецФункции	


Функция НайтиДолжностьСотрудника(Сотрудник, дата)  Экспорт
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеДляПодбораСотрудников.Сотрудник КАК Сотрудник,
	|	ДанныеДляПодбораСотрудников.ДолжностьПоШтатномуРасписанию.Должность КАК Должность
	|ИЗ
	|	РегистрСведений.ДанныеДляПодбораСотрудников КАК ДанныеДляПодбораСотрудников
	|ГДЕ
	|	ДанныеДляПодбораСотрудников.Сотрудник = &Сотрудник
	|	И ДанныеДляПодбораСотрудников.Окончание > &Дата
	|	И ДанныеДляПодбораСотрудников.Начало < &Дата
	|	И ДанныеДляПодбораСотрудников.ДолжностьПоШтатномуРасписанию.Должность <> ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Дата", Дата);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		УстановитьПривилегированныйРежим(Ложь);

		Возврат Результат.Должность;
	КонецЕсли;
	Возврат Справочники.Должности.ПустаяСсылка();
	УстановитьПривилегированныйРежим(Ложь);

КонецФункции

Процедура Лико_ОбновитьСтатистикуСкорости(ДатаНачала = Неопределено) Экспорт 
	УстановитьПривилегированныйРежим(Истина);

    ИмяФайла = ПолучитьИмяВременногоФайла();
    ВнОбработка = Лико_Дополнительно.НайтиДополнительнуюОбработкуПоИмениОбъекта("Лико_ФормированиеСтатистикиСкорости");
    ДвоичныеДанные = ВнОбработка.ХранилищеОбработки.Получить();
    ДвоичныеДанные.Записать(ИмяФайла);
    ВнешняяОбработкаПлан = ВнешниеОбработки.Создать(ИмяФайла, Ложь);
	
	СтруктураПараметров = Новый Структура;
	Если ДатаНачала <> Неопределено И ЗначениеЗаполнено(ДатаНачала) Тогда
		СтруктураПараметров.Вставить("ДатаНачала", ДатаНачала);
	КонецЕсли;
	
    ВнешняяОбработкаПлан.ВыполнитьКоманду("Лико_ФормированиеСтатистикиСкоростиВФоне", СтруктураПараметров);
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция ПолучитьГрамматуруВала(Номенклатура, ПлощадкаИксПак) Экспорт
	Грамматура = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПараметрыШтампа.ГрамматураВала КАК ГрамматураВала,
	|	Лико_ПараметрыШтампа.ПроцентЗаливки КАК ПроцентЗаливки
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|ГДЕ
	|	Лико_ПараметрыШтампа.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.ГрамматураВала) Тогда
			Если ПлощадкаИксПак Тогда 
				Грамматура =  Результат.ГрамматураВала ;
			Иначе
				Грамматура = Результат.ГрамматураВала*0.5;
			КонецЕсли;
			ПроцентЗаливки = Результат.ПроцентЗаливки;
		КонецЕсли;
	КонецЕсли;
	ПараметрыВала = Новый Структура("Грамматура,ПроцентЗаливки", Грамматура, ПроцентЗаливки);
	Возврат ПараметрыВала;
КонецФункции

