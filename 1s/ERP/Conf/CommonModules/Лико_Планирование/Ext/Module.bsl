Функция ПолучитьКодПостПечатныхработ(Заказ)   Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЗаказКлиентаВидыРабот.ВидРабот = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ПечатьСклеящегоСлоя)
	|				ТОГДА 10
	|			КОГДА ЗаказКлиентаВидыРабот.ВидРабот = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ХолодноеТиснение)
	|				ТОГДА 20
	|			КОГДА ЗаказКлиентаВидыРабот.ВидРабот = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Книжка)
	|				ТОГДА 14
	|			КОГДА ЗаказКлиентаВидыРабот.Материал ССЫЛКА Справочник.ЦеновыеГруппы
	|					И ЗаказКлиентаВидыРабот.Материал.Лико_3DТиснение = ИСТИНА
	|				ТОГДА 21
	|			КОГДА ЗаказКлиентаВидыРабот.Материал ССЫЛКА Справочник.Номенклатура
	|					И ЗаказКлиентаВидыРабот.Материал.ЦеноваяГруппа.Лико_3DТиснение = ИСТИНА
	|				ТОГДА 21
	|			КОГДА ЗаказКлиентаВидыРабот.Ссылка.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.Пробник)
	|				ТОГДА 53
	|			КОГДА ЗаказКлиентаВидыРабот.Ссылка.ТипЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЗаказов.Термоусадка)
	|					И ЗаказКлиентаВидыРабот.Ссылка.ПоперечнаяРезкаТУ
	|				ТОГДА 72
	|			КОГДА ЗаказКлиентаВидыРабот.ВидРабот.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Нумерация)
	|				ТОГДА 80
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КодПостпечатныхРабот
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &ссылка";
	Запрос.УстановитьПараметр("Ссылка",Заказ);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	
	возврат Результат.Кодпостпечатныхработ;	
КонецФункции


//Отправка писем
Процедура ОтправитьПисьмо(	Текст,
							Тема,
							Адресат,
							Отправитель = """Robot 1c"" <IRobot1cKo@okil.ru>",
							ТипТекста="htmlBody",
							КоличествоПопыток = 3,
							ИнтервалМеждуПопыткамиСек = 2,
							ВложениеПисьма = Неопределено,
							ВыводитьСообщение = Истина) Экспорт
	
	Если ТипЗнч(Адресат) = Тип("Строка") Тогда
		Кому = Адресат;
	ИначеЕсли ТипЗнч(Адресат) = Тип("СписокЗначений")   Тогда
		Кому = "";
		Для каждого Элем Из Адресат Цикл
			// --> Начало Лико Ефимов ЕВВ 10.07.2019
			Если ТипЗнч(Элем.Значение) = Тип("Строка") И ЗначениеЗаполнено(Элем.Значение) Тогда
				Кому = Кому+?(ЗначениеЗаполнено(Кому),";", "")+Элем.Значение;
				Продолжить;
			КонецЕсли;
			// <-- Конец Лико Ефимов ЕВВ 10.07.2019
			СтруктураАдресов =  ВзаимодействияВызовСервера.НаименованиеИАдресаЭлектроннойПочтыКонтакта(Элем.Значение).Адреса;
			Если СтруктураАдресов.Количество()>0 Тогда
				// --> Начало Лико Ефимов ЕВВ 17.02.2022
				//Кому = Кому+?(ЗначениеЗаполнено(Кому),";", "")+СтруктураАдресов[0].Значение;
				Для каждого ЗначениеСтруктуры из СтруктураАдресов Цикл
					Кому = Кому+?(ЗначениеЗаполнено(Кому),";", "")+ЗначениеСтруктуры.Значение;
				КонецЦикла;
				// <-- Конец Лико Ефимов ЕВВ 17.02.2022
			КонецЕсли;

		КонецЦикла;		
	Иначе
		//Кому = ПолучитьПочтуПользователя(Адресат);
		СтруктураАдресов =  ВзаимодействияВызовСервера.НаименованиеИАдресаЭлектроннойПочтыКонтакта(Адресат).Адреса;
		Если СтруктураАдресов.Количество()>0 Тогда
			// --> Начало Лико Ефимов ЕВВ 17.02.2022
			//Кому = СтруктураАдресов[0].Значение;
			Кому = "";
			Для каждого ЗначениеСтруктуры из СтруктураАдресов Цикл
				Кому = Кому+?(ЗначениеЗаполнено(Кому),";", "")+ЗначениеСтруктуры.Значение;
			КонецЦикла;
			// <-- Конец Лико Ефимов ЕВВ 17.02.2022
		КонецЕсли;
	КонецЕсли;	
	Если Не ЗначениеЗаполнено(Кому) Тогда
		Возврат;
	КонецЕсли;

	// --> Начало Лико Ефимов ЕВВ 27.06.2019
	Если НЕ Лико_Дополнительно.ПроверитьЭтоРабочаяБаза() Тогда
		// Это копия, письма отправлять не нужно
		Сообщить("Это копия базы, поэтому письмо не было отправлено. Если бы это была рабочая база, то было бы отправлено следующее письмо:
		|Отправитель: " + Отправитель + "
		|Получатель: " + Кому + "
		|Тема: " + Тема + "
		|Текст: " + Текст + "
		|Вложение: " + ВложениеПисьма);
		Возврат;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 27.06.2019
	
	// --> Начало Лико Ефимов ЕВВ 31.07.2023
	ОтправкаПисемТиповымМетодом = Справочники.Лико_ПредопределенныеЗначения.ОтправкаПисемТиповымМетодом.ЗначениеПараметра;
	Если ЗначениеЗаполнено(ОтправкаПисемТиповымМетодом) И ОтправкаПисемТиповымМетодом Тогда
		// Пробую отправить типовым механизмом
		УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию("IRobot1cKo@okil.r");
		ПараметрыПисьма = Новый Структура;
		МассивВложений = Новый Массив;
		Если ВложениеПисьма<> Неопределено Тогда
			Если ТипЗнч(ВложениеПисьма) = Тип("СписокЗначений") Тогда
				СписокВложений = ВложениеПисьма;
			Иначе
				СписокВложений = Новый СписокЗначений; 
				СписокВложений.Добавить(ВложениеПисьма);
			КонецЕсли;
			
			Для Каждого ПутьКВложению Из СписокВложений Цикл
				ТекФайл = Новый Файл(ПутьКВложению.Значение);
				Если ТекФайл.Существует() Тогда 
					АдресВХ = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ТекФайл.ПолноеИмя));
					МассивВложений.Добавить(Новый Структура("Представление,АдресВоВременномХранилище,Кодировка,Идентификатор", ТекФайл.Имя, АдресВХ, "", ""));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ПараметрыПисьма.Вставить("Вложения", МассивВложений);
		МассивСтруктурКому = Новый Массив;
		МассивКому = СтрРазделить(Кому, ";", Ложь);
		Для каждого СтрокаКому из МассивКому Цикл
			МассивСтруктурКому.Добавить(Новый Структура("Адрес,Представление", СтрокаКому, ""));
		КонецЦикла;
		ПараметрыПисьма.Вставить("Кому", МассивСтруктурКому);
		ПараметрыПисьма.Вставить("Копии", Новый Массив);
		ПараметрыПисьма.Вставить("ПолучателиСообщения", Новый Массив);
		ПараметрыПисьма.Вставить("СкрытыеКопии", Новый Массив); 
		ПараметрыПисьма.Вставить("Тело", Текст);
		Если ТипТекста="htmlBody" Тогда
 			ПараметрыПисьма.Вставить("ТипТекста", "HTML");
		КонецЕсли;
		ПараметрыПисьма.Вставить("Тема", Тема);
		Письмо = РаботаСПочтовымиСообщениями.ПодготовитьПисьмо(УчетнаяЗапись, ПараметрыПисьма);
		РезультатОтправки = РаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗапись, Письмо);
		Возврат;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 31.07.2023
	
