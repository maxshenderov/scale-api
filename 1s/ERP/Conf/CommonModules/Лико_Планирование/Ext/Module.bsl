		ЗапросКонтрагент.УстановитьПараметр("Наименование", Результат.КонтрагентНаименование);
		РезультатЗапросаКонтрагент = ЗапросКонтрагент.Выполнить();
		Если Не РезультатЗапросаКонтрагент.Пустой() Тогда 
			РезультатКонтрагент = РезультатЗапросаКонтрагент.Выбрать();
			РезультатКонтрагент.Следующий();
			Если ЗначениеЗаполнено(РезультатКонтрагент.Ссылка) ТОгда 
				Контрагент = РезультатКонтрагент.Ссылка;
			Иначе	
				Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", Результат.КонтрагентИНН);
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Результат.КонтрагентНаименование)    Тогда 
			Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(Результат.КонтрагентНаименование);
		Иначе 
			Контрагент = Справочники.Контрагенты.ПустаяСсылка()
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Контрагент) Тогда
