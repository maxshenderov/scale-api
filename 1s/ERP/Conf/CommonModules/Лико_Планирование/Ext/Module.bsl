Функция НайтиРаботу(Заказ, ВидРабот) Экспорт
	НайденнаяРабота = Новый Структура("ВидРабот, НомерРаботы, КоличествоРабот");

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаВидыРабот.ВидРабот КАК ВидРабот,
	|	СУММА(1) КАК КоличествоРабот
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ
	|	И ЗаказКлиентаВидыРабот.ВидРабот В ИЕРАРХИИ(&СписокРабот)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаВидыРабот.ВидРабот";
	Запрос.УстановитьПараметр("СписокРабот", ВидРабот);
	Запрос.УстановитьПараметр("Заказ", Заказ);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Количество() = 1 Тогда 
		РезультатЗапроса.Следующий();
		НайденнаяРабота.ВидРабот = РезультатЗапроса.ВидРабот;
		НайденнаяРабота.КоличествоРабот  = РезультатЗапроса.КоличествоРабот;
	КонецЕсли;
	Возврат НайденнаяРабота;

	
