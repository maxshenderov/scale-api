	|					И ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ОсновнаяЕвро)) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних
	|		ПО ВТЧернила.Затрата = Лико_ЦеныГруппНоменклатурыСрезПоследних.ЦеноваяГруппа
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
	|				&Дата,
	|				Площадка = &Площадка
	|					И ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ТабашФакт)) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних1
	|		ПО ВТЧернила.Затрата = Лико_ЦеныГруппНоменклатурыСрезПоследних1.ЦеноваяГруппа";

	Если РасчетФакта Тогда 
		Запрос.УстановитьПараметр("Тираж", Расч_Квм * 0.001 * Ссылка.ШтКВМ);
	Иначе
		Запрос.УстановитьПараметр("Тираж", Тираж);
	КонецЕсли;
	ВыборкаЧернила= Запрос.Выполнить().Выбрать();
	Пока  ВыборкаЧернила.Следующий() Цикл
		стр = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(стр, ВыборкаЧернила);	
	КонецЦикла;  

	#Конецобласти

#Область Праймер 

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаЦвета.ВидСекции КАК ВидСекции,
		|	ТаблицаЦвета.НомерРаботы КАК НомерРаботы,
		|	ТаблицаЦвета.РабочийЦентр КАК РабочийЦентр,
		|	ТаблицаЦвета.Ссылка.Праймер.ЦеноваяГруппа КАК Затрата,
		|	ТаблицаЦвета.НомерПроката КАК НомерПроката
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	"+ИмяТаблицы+".Цвета КАК ТаблицаЦвета
		|ГДЕ
		|	ТаблицаЦвета.Ссылка = &Ссылка
		|	И ТаблицаЦвета.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.indigo)
		|	И НЕ ТаблицаЦвета.Ссылка.Праймер В (ЗНАЧЕНИЕ(Справочник.Лико_праймеры.ПустаяСсылка), ЗНАЧЕНИЕ(Справочник.Лико_праймеры.БезПраймера))
		|	И ТаблицаЦвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Цифровая)
		|	И ВЫБОР
		|			КОГДА &НомерПроката = 0
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ТаблицаЦвета.НомерПроката = &НомерПроката
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.Праймер) КАК СтатьяЗатрат,
		|	ВТ.ВидСекции КАК ВидСекции,
		|	ВТ.НомерРаботы КАК НомерРаботы,
		|	ВТ.РабочийЦентр КАК РабочийЦентр,
		|	ВТ.Затрата КАК Затрата,
		|	ВТ.НомерПроката КАК НомерПроката,
		|	Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение КАК КоэффициентПереноса,
		|	&Расч_Квм * Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение / 1000 * Лико_ЦеныГруппНоменклатурыСрезПоследних.Цена КАК Сумма,
		|	&Расч_Квм * Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение / 1000 * Лико_ЦеныГруппНоменклатурыСрезПоследних1.Цена КАК СуммаФакт,
		|	&Расч_Квм * Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение / 1000 КАК Количество,
		|	Лико_ЦеныГруппНоменклатурыСрезПоследних.Цена КАК ЦенаПлан,
		|	Лико_ЦеныГруппНоменклатурыСрезПоследних1.Цена КАК Цена,
		|	&Расч_КВМ КАК Метраж,
		|	Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение КАК КоэффициентКМетражу
		|ИЗ
		|	РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
		|			&Дата,
		|			Площадка = &Площадка
		|				И ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ТабашФакт)) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних1
		|		ПРАВОЕ СОЕДИНЕНИЕ ВТ КАК ВТ
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
		|					&Дата,
		|					Площадка = &Площадка
		|						И ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ОсновнаяЕвро)) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних
		|			ПО ВТ.Затрата = Лико_ЦеныГруппНоменклатурыСрезПоследних.ЦеноваяГруппа
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЗначенияКоэффициентовПереноса.СрезПоследних(
		|					&Дата,
		|					Площадка = &Площадка
		|						И Коэффициент = ЗНАЧЕНИЕ(Справочник.Лико_КоэффициентыДляРасчетов.КоэффициентПереносаПраймераЦифры)) КАК Лико_ЗначенияКоэффициентовПереносаСрезПоследних
		|			ПО ВТ.Затрата = Лико_ЗначенияКоэффициентовПереносаСрезПоследних.ЦеноваяГруппа
		|		ПО (ВТ.Затрата = Лико_ЦеныГруппНоменклатурыСрезПоследних1.ЦеноваяГруппа)";
	
	
	ВыборкаПраймер = Запрос.Выполнить().Выбрать();

	Пока  ВыборкаПраймер.Следующий() Цикл
		стр = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(стр, ВыборкаПраймер);	
	КонецЦикла;  
		
#Конецобласти

Возврат ТЗ;	

	

КонецФункции

	
		
		
Функция ПолучитьСтоимостьКлеяТУ(Ссылка, НомерВарианта, МетражПМ, Дата, Ручьи ) Экспорт

	
	//МетражПМ - чистый метраж отгруженный или по заказу, для закрытия бланков - метраж по незававершенному производству на ТУ
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ КАК Заказ,
	|	Лико_ПараметрыПроизводстваЗаказа.НомерПроката КАК НомерПроката,
	|	ВЫБОР
	|		КОГДА &Метраж = 0
	|			ТОГДА Лико_ПараметрыПроизводстваЗаказа.МетражДляРЦ * 1.05
	|		ИНАЧЕ &Метраж * 1.05
	|	КОНЕЦ КАК Метраж,
	|	ВЫБОР
	|		КОГДА Лико_ПараметрыПроизводстваЗаказа.Заказ.РучьиПечати = 0
	|			ТОГДА Лико_ПараметрыПроизводстваЗаказа.Заказ.РучьиПечатиИндиго
	|		ИНАЧЕ Лико_ПараметрыПроизводстваЗаказа.Заказ.РучьиПечати
	|	КОНЕЦ КАК Ручьи,
	|	Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение КАК Коэффициент,
	|	Лико_ЗначенияКоэффициентовПереносаСрезПоследних.ЦГПоУмолчанию КАК ЦГПоУмолчанию
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа,
	|	РегистрСведений.Лико_ЗначенияКоэффициентовПереноса.СрезПоследних(
	|			&Дата,
	|			Площадка = &Площадка
	|				И Коэффициент = ЗНАЧЕНИЕ(Справочник.Лико_КоэффициентыДляРасчетов.КоэффициентПереносаКлеяТермоусадки)) КАК Лико_ЗначенияКоэффициентовПереносаСрезПоследних
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(&Ссылка) = ТИП(Документ.ЗаказКлиента)
	|				ТОГДА Лико_ПараметрыПроизводстваЗаказа.Заказ = &Ссылка
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ
	|	И Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.СклейкаТермоусадки)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Лико_СпецификацииНормативы.Ссылка,
	|	Лико_СпецификацииНормативы.НомерПроката,
	|	Лико_СпецификацииНормативы.МетражДляРЦ * 1.05,
	|	ВЫБОР
	|		КОГДА Лико_СпецификацииНормативы.Ссылка.РучьиПечати = 0
	|			ТОГДА Лико_СпецификацииНормативы.Ссылка.РучьиПечатиИндиго
	|		ИНАЧЕ Лико_СпецификацииНормативы.Ссылка.РучьиПечати
	|	КОНЕЦ,
	|	Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение,
	|	Лико_ЗначенияКоэффициентовПереносаСрезПоследних.ЦГПоУмолчанию
	|ИЗ
	|	Справочник.Лико_Спецификации.Нормативы КАК Лико_СпецификацииНормативы,
	|	РегистрСведений.Лико_ЗначенияКоэффициентовПереноса.СрезПоследних(
	|			&Дата,
	|			Площадка = &Площадка
	|				И Коэффициент = ЗНАЧЕНИЕ(Справочник.Лико_КоэффициентыДляРасчетов.КоэффициентПереносаКлеяТермоусадки)) КАК Лико_ЗначенияКоэффициентовПереносаСрезПоследних
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(&Ссылка) = ТИП(Справочник.Лико_Спецификации)
	|				ТОГДА Лико_СпецификацииНормативы.Ссылка = &Ссылка
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ
	|	И Лико_СпецификацииНормативы.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.СклейкаТермоусадки)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Заказ КАК Заказ,
	|	ВТ.НомерПроката КАК НомерПроката,
	|	ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.Клей) КАК СтатьяЗатрат,
	|	ВТ.Метраж КАК Метраж,
	|	ВТ.ЦГПоУмолчанию КАК Затрата,
	|	ВТ.Ручьи КАК Ручьи,
	|	ВТ.Коэффициент КАК КоэффициентПереноса,
	|	ВТ.Метраж * ВТ.Ручьи * ВТ.Коэффициент / 1000 * Лико_ЦеныГруппНоменклатурыСрезПоследних.Цена КАК Сумма,
	|	ВТ.Метраж * ВТ.Ручьи / 1000 * ВТ.Коэффициент КАК Количество,
	|	ВТ.Метраж * ВТ.Ручьи * ВТ.Коэффициент / 1000 * Лико_ЦеныГруппНоменклатурыСрезПоследних1.Цена КАК СуммаФакт,
	|	Лико_ЦеныГруппНоменклатурыСрезПоследних.Цена КАК Цена,
	|	Лико_ЦеныГруппНоменклатурыСрезПоследних1.Цена КАК ЦенаФакт
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
	|				&Дата,
	|				ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ОсновнаяЕвро)
	|					И Площадка = &Площадка) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних
	|		ПО ВТ.ЦГПоУмолчанию = Лико_ЦеныГруппНоменклатурыСрезПоследних.ЦеноваяГруппа
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
	|				&Дата,
	|				ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.Табашфакт)
	|					И Площадка = &Площадка) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних1
	|		ПО ВТ.ЦГПоУмолчанию = Лико_ЦеныГруппНоменклатурыСрезПоследних1.ЦеноваяГруппа";
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Площадка", Ссылка.Площадка.Организация);
	Запрос.УстановитьПараметр("НомерВарианта", НомерВарианта);
	Запрос.УстановитьПараметр("Метраж", МетражПМ);
	Запрос.УстановитьПараметр("Ручьи", Ручьи);
	Запрос.УстановитьПараметр("ЦГ", Справочники.Лико_КоэффициентыДляРасчетов.КоэффициентПереносаКлеяТермоусадки.ЦеноваяГруппа);
	Запрос.УстановитьПараметр("Дата", Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	ВЫборка.Следующий();
	Возврат Выборка;
КонецФункции

Функция ПолучитьПроцентФакторинга(Клиент, Дата) Экспорт   
	ПроцентФакторинга = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_СтавкиФакторингаСрезПоследних.Ставка КАК Ставка
	|ИЗ
	|	РегистрСведений.Лико_СтавкиФакторинга.СрезПоследних(&Дата, Клиент = &Клиент) КАК Лико_СтавкиФакторингаСрезПоследних";  
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Клиент", Клиент);

	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		ПроцентФакторинга = Результат.Ставка;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПроцентФакторинга) Тогда     
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|  СтавкаРефинансированияЦБСрезПоследних.Размер КАК Размер
		|ИЗ                                                                                                            
		
		|  РегистрСведений.СтавкаРефинансированияЦБ.СрезПоследних(&Дата, ) КАК СтавкаРефинансированияЦБСрезПоследних";  
		Запрос.УстановитьПараметр("Дата", Дата);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда 
			Результат = РезультатЗапроса.Выбрать();
			Результат.Следующий();
			ПроцентФакторинга = ПроцентФакторинга+Результат.Размер;
		КонецЕсли;

		//ТекстЗапроса = 
		//"ВЫБРАТЬ
		//|  СтавкаРефинансированияЦБСрезПоследних.Размер КАК Размер
		//|ИЗ
		//|  РегистрСведений.СтавкаРефинансированияЦБ.СрезПоследних(&Дата, ) КАК СтавкаРефинансированияЦБСрезПоследних";
		//Запрос
		//ТЗ =Лико_HTTP_Сервер.Запрос1с(ТекстЗапроса,Новый Структура("Дата",Дата),"ZUP");
		//Для каждого ЭлементМассива Из ТЗ Цикл
		//	ПроцентФакторинга =ПроцентФакторинга+ЭлементМассива.Размер;
		//КонецЦикла;
	КонецЕсли;
	Возврат ПроцентФакторинга;
КонецФункции

Процедура  ДобавитьЗатраты(Ссылка,номерварианта =1,  РабочийЦентр, НомерПроката, СтатьяЗатрат,Затрата=Неопределено, Количество, Сумма, Нарезка = Неопределено, видработ=Неопределено, РЦ = Неопределено, НомерРаботы = 1, ДавальческоеСырье = Ложь, стр = неопределено) Экспорт
	Запись = РегистрыСведений.Лико_Затраты.СоздатьМенеджерЗаписи();
	Запись.ЗаказКлиента = Ссылка;
	Запись.РабочийЦентр = РабочийЦентр;
	Запись.СтатьяЗатрат = СтатьяЗатрат;
	Запись.НомерПроката = НомерПроката;
	Запись.ДавальческоеСырье = ДавальческоеСырье;
	Запись.ВидРабот = ВидРабот;

	Если ЗначениеЗаполнено(видРабот) Тогда 
		Запись.ВидРабот = ВидРабот;
		Запись.НомерРаботы = НомерРаботы;
	Иначе 
		Запись.ВидРабот = Справочники.ВидыРаботСотрудников.ПустаяСсылка();
		Запись.НомерРаботы = 0;		
	КонецЕсли;		
    Запись.НомерВарианта = НомерВарианта;
	Если ЗначениеЗаполнено(Затрата) Тогда 
		Запись.Затрата = Затрата;
	КонецЕсли;	
	Запись.прочитать();
	Запись.ЗаказКлиента = Ссылка;
	Запись.РабочийЦентр = РабочийЦентр;
	Запись.СтатьяЗатрат = СтатьяЗатрат;
	Запись.НомерПроката = НомерПроката;
	Запись.ДавальческоеСырье = ДавальческоеСырье;
	Запись.ВидРабот = ВидРабот;

	Если ЗначениеЗаполнено(видРабот) Тогда 
		Запись.ВидРабот = ВидРабот;
		Запись.НомерРаботы = НомерРаботы;  
		Если ЗначениеЗаполнено(ВидРабот.Лико_ВидСекции) Тогда 
			Запись.ВидСекции = ВидРабот.Лико_ВидСекции;  
       КонецЕсли;
	Иначе 
		Запись.ВидРабот = Справочники.ВидыРаботСотрудников.ПустаяСсылка();
		Запись.НомерРаботы = 0;		
	КонецЕсли;		
    Запись.НомерВарианта = НомерВарианта;
	Если ЗначениеЗаполнено(Затрата) Тогда 
		Запись.Затрата = Затрата;
	КонецЕсли;	

	
	Если ЗначениеЗаполнено(РЦ) Тогда 
		Запись.РЦ = РЦ;
	КонецЕсли;
	Если ЗначениеЗаполнено(Нарезка) Тогда 
		Запись.Нарезка = Нарезка;
	КонецЕсли;
	
	Если Типзнч(ссылка) = Тип("ДокументСсылка.ЗаказКлиента") Тогда 
		Если ЗначениеЗаполнено(Количество)   Тогда 
			Запись.Количество = Запись.количество+Количество;
		КонецЕсли;
		Если ЗначениеЗаполнено(Сумма) Тогда 
			Запись.Сумма = Запись.Сумма+Сумма;
		КонецЕсли;
	Иначе 
		Запись.Количество = Количество;
		Запись.Сумма = Сумма;

	КонецЕсли;     
	
	Если Не стр = Неопределено Тогда 
		ЗаполнитьЗначенияСвойств(Запись, стр, "ПроцентЗаливки, Грамматура, РасходКраски, ПроцентГрамматура, КоличествоЦветов, КоэффициентПереноса, Плотность, Метраж, КоэффициентКМетражу");
		Запись.Цена = стр.ЦенаПлан;
    КонецЕсли;

	Запись.Записать();
КонецПроцедуры

Процедура  ДобавитьЗатратыНовая(Ссылка,РабочийЦентр, Количество, Сумма, Выборка, Цена = Неопределено) Экспорт
	Запись = РегистрыСведений.Лико_Затраты.СоздатьМенеджерЗаписи();
	Запись.ЗаказКлиента = Ссылка;
	ЗаполнитьЗначенияСвойств(Запись, Выборка);	
	Запись.РабочийЦентр = РабочийЦентр; 
	Запись.Количество = Количество; 
	Запись.Сумма = Сумма;  
	Если ЗначениеЗаполнено(Цена) Тогда 
		Запись.Цена = Цена;
	КонецЕсли;
    Запись.НомерВарианта = 1;
	Если Не ЗначениеЗаполнено(Запись.НомерПроката) Тогда 
		Запись.НомерПроката = 1;
	КонецЕсли;

	
	Запись.Записать();

КонецПроцедуры

Функция ПолучитьСтавкуЭкспортнойПошлины(Дата)
    Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СРЕДНЕЕ(КурсыВалют.Курс) КАК Курс,
	|	КурсыВалют.Валюта КАК Валюта
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.КурсыВалют КАК КурсыВалют
	|ГДЕ
	|	КурсыВалют.Валюта.Код = ""840""
	|	И КурсыВалют.Период МЕЖДУ ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ), МЕСЯЦ, -2), ДЕНЬ, 25) И ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ), МЕСЯЦ, -1), ДЕНЬ, 24)
	|
	|СГРУППИРОВАТЬ ПО
	|	КурсыВалют.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ВТ.Курс < 80
	|			ТОГДА 0
	|		КОГДА ВТ.Курс < 85
	|			ТОГДА 4
	|		КОГДА ВТ.Курс < 90
	|			ТОГДА 4.5
	|		КОГДА ВТ.Курс < 95
	|			ТОГДА 5.5
	|		ИНАЧЕ 7
	|	КОНЕЦ КАК Ставка,
	|	ВТ.Курс КАК Курс
	|ИЗ
	|	ВТ КАК ВТ";  
	Запрос.УстановитьПараметр("Дата", Дата);
	РезультатЗапроса = Запрос.Выполнить();
	Если не РезультатЗапроса.Пустой() Тогда 
    	Результат = РезультатЗапроса.Выбрать();    
		Результат.Следующий();
		Возврат Результат.Ставка;
	КонецЕсли;
	
КонецФункции

//Отправка в работу
Процедура НаправитьВРаботу(Заказ, БезПечати = Ложь, Отказ = ЛОжь, ПодниматьВерсию = Истина, МенялисьМатериалы = Ложь, ПричиныЗамены = Неопределено) Экспорт
		//Отправка в работу
	УстановитьПривилегированныйРежим(Истина);       
	Площадка = Заказ.Площадка.Организация;
	ПлощадкаЛикофлекс = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра;
	ПлощадкаИксПак = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра;
    ПлощадкаАвантаж = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияАвантаж.ЗначениеПараметра;
    ПлощадкаЭкофлекс = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЭкоФлекс.ЗначениеПараметра;   
	РЦЛаминатор =  Заказ.РабочийЦентр.ПорядковыйНомер =300;


	
	НачатьТранзакцию();
	
	//Давальческое сырье
	Если Заказ.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Полуфабрикат И Заказ.ДавальческоеСырье Тогда 
		ПометитьНаУдалениеЗаказыДавальца_Переработчику(Заказ, Отказ);
		СоздатьАктуализироватьЗаказыДвальца_Переработчику(Заказ, Отказ);
		Если Отказ Тогда 
			Возврат;
		КонецЕсли;

	Иначе
		//Проверяем, менялось количество прокатов
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Лико_ПараметрыПроизводстваЗаказа.Заказ КАК Заказ,
		|	МАКСИМУМ(Лико_ПараметрыПроизводстваЗаказа.НомерПроката) КАК ВсегоПрокатов
		|ПОМЕСТИТЬ ВТПрокаты
		|ИЗ
		|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
		|ГДЕ
		|	Лико_ПараметрыПроизводстваЗаказа.Заказ = &Заказ
		|	И НЕ Лико_ПараметрыПроизводстваЗаказа.Заказ.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка)
		|
		|СГРУППИРОВАТЬ ПО
		|	Лико_ПараметрыПроизводстваЗаказа.Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЭтапПроизводства2_2.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПроизводствоИзДавальческогоСырья)
		|			ТОГДА ЭтапПроизводства2_2.Распоряжение.ДокументОснование.Лико_ЗаказКлиента
		|		ИНАЧЕ ЭтапПроизводства2_2.Распоряжение.ДокументОснование.Ссылка
		|	КОНЕЦ КАК Заказ,
		|	МАКСИМУМ(ЭтапПроизводства2_2.НомерПроката) КАК ВсегоПрокатов,
		|	ЭтапПроизводства2_2.Организация КАК Организация
		|ПОМЕСТИТЬ ВТЭтапы
		|ИЗ
		|	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ЭтапПроизводства2_2.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПроизводствоИзДавальческогоСырья)
		|				ТОГДА ЭтапПроизводства2_2.Распоряжение.ДокументОснование.Лико_ЗаказКлиента = &Заказ
		|			ИНАЧЕ ЭтапПроизводства2_2.Распоряжение.ДокументОснование.Ссылка = &Заказ
		|		КОНЕЦ
		|	И ЭтапПроизводства2_2.ВидЭтапа = ЗНАЧЕНИЕ(Справочник.Лико_ВидыЭтаповПроизводства.Прокат)
		|	И ЭтапПроизводства2_2.ПометкаУдаления = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА ЭтапПроизводства2_2.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПроизводствоИзДавальческогоСырья)
		|			ТОГДА ЭтапПроизводства2_2.Распоряжение.ДокументОснование.Лико_ЗаказКлиента
		|		ИНАЧЕ ЭтапПроизводства2_2.Распоряжение.ДокументОснование.Ссылка
		|	КОНЕЦ,
		|	ЭтапПроизводства2_2.Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТПрокаты.Заказ КАК Заказ,
		|	ВТПрокаты.ВсегоПрокатов КАК ВсегоПрокатовВЗаказах,
		|	ВТЭтапы.ВсегоПрокатов КАК ВсегоПрокатовВЭтапах
		|ИЗ
		|	ВТПрокаты КАК ВТПрокаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЭтапы КАК ВТЭтапы
		|		ПО ВТПрокаты.Заказ = ВТЭтапы.Заказ
		|ГДЕ
		|	(ВТПрокаты.ВсегоПрокатов <> ВТЭтапы.ВсегоПрокатов
		|			ИЛИ ВТЭтапы.Организация <> &Площадка
		|			ИЛИ ВТЭтапы.Заказ ЕСТЬ NULL)";
		Запрос.УстановитьПараметр("Заказ", Заказ);
		Запрос.УстановитьПараметр("Площадка", Площадка );

		
		Если Не ЗначениеЗаполнено(Заказ.ДатаОтправкиВРаботу) Или Не Запрос.Выполнить().Пустой() Тогда 
		
			//Помечаем на удаление заказы на производство и этапы
			ПометитьНаУдалениеЗаказыНаПроизводствоЭтапы(Заказ, Отказ);
			Если Отказ Тогда 
				Возврат
			КонецЕсли;
				
						
			//Проверяем  есть ли Заказы на производство по организациям - площадкам из рабочих центров
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗаказКлиентаЦвета.Ссылка.Площадка.Организация КАК Площадка,
			|	ЗаказКлиентаЦвета.Ссылка КАК Заказ,
			|	МАКСИМУМ(ЗаказКлиентаЦвета.НомерПроката) КАК НомерПроката
			|ПОМЕСТИТЬ ВТ_Площадки
			|ИЗ
			|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
			|ГДЕ
			|	ЗаказКлиентаЦвета.Ссылка = &Заказ
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗаказКлиентаЦвета.Ссылка,
			|	ЗаказКлиентаЦвета.Ссылка.Площадка.Организация
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Площадки.Площадка КАК Площадка,
			|	МАКСИМУМ(ЕСТЬNULL(ЗаказНаПроизводство2_2.Ссылка, ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство2_2.ПустаяСсылка))) КАК ЗаказНаПроизводство,
			|	ВТ_Площадки.НомерПроката КАК НомерПроката
			|ИЗ
			|	ВТ_Площадки КАК ВТ_Площадки
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2 КАК ЗаказНаПроизводство2_2
			|		ПО ВТ_Площадки.Площадка = ЗаказНаПроизводство2_2.Организация
			|			И ВТ_Площадки.Заказ = ЗаказНаПроизводство2_2.ДокументОснование
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_Площадки.Площадка,
			|	ВТ_Площадки.НомерПроката
			|
			|УПОРЯДОЧИТЬ ПО
			|	НомерПроката УБЫВ";

			Запрос.УстановитьПараметр("Заказ", Заказ);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Если  ЗначениеЗаполнено(Выборка.ЗаказНаПроизводство) Тогда 
					ЗаказПрОбъект = Выборка.ЗаказНаПроизводство.ПолучитьОбъект();
				Иначе
					ЗаказПРОбъект = Документы.ЗаказНаПроизводство2_2.СоздатьДокумент();
					ЗаказПРОбъект.Организация  = Выборка.Площадка;  
				КонецЕсли;	
				ЗаполнитьПоЗаказуКлиента(ЗаказПрОбъект, Заказ);	
				ЗаказПр = ЗаказПрОбъект.Ссылка;
				СоздатьДобавитьЭтапыПроизводства(Заказ, ЗаказПр, Выборка.Площадка, Отказ);
				Если Отказ Тогда 
					Возврат;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;

	
	
	//+ Лико Субботин 03.12.2021
	Если Заказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПолныйПовтор 
			и  Площадка = ПлощадкаЛикофлекс 
			и Заказ.Цифровой = Ложь Тогда 
			
		НужноПредупредить = Ложь;	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
		|	ЗаказКлиентаТовары.Направление КАК Направление
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка = &ПовторЗаказа";
		
		Запрос.УстановитьПараметр("ПовторЗаказа", Заказ.ПовторЗаказа);
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		//СтрокаНомераСтрок: в цикле запишутся номера строк через запятую, где будет рассчитано превышение
		СтрокаНомераСтрок = "";
		Для каждого стр из Заказ.Товары Цикл
			отбор = Новый Структура;
			отбор.Вставить("Номенклатура", стр.Номенклатура);
			отбор.Вставить("Направление", стр.Направление);		
			Если РезультатЗапроса.НайтиСтроки(отбор).Количество() = 0 Тогда
				
				МетражВСтроке = Лико_ТиражМетраж.РассчитатьМетраж(стр.Количество*1000, Заказ.Нарезка, Заказ.ШтКВМ);
				Если МетражВСтроке > 3000 Тогда
					НужноПредупредить = Истина;
					СтрокаНомераСтрок = СтрокаНомераСтрок + стр.НомерСтроки + " ";
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НужноПредупредить Тогда
			
			ОтправитьПисьмо(СтрШаблон(" №%1 выписан как полный повтор, но в нем отличается направление намотки в строках: %2",
													строка(Заказ.Ссылка), СтрокаНомераСтрок) , "Метраж превысил 3000",  "vivanov@okil-sato.ru; YSubbotin@okil-sato.ru");

			
		КонецЕсли;
		
		
	КонецЕсли;
	//- Лико Субботин 03.12.2021

	
	
	Если Заказ.ДатаОтправкиВРаботу<>'00010101'  Тогда 
		Если ПодниматьВерсию Тогда 
			ЗаказОбъект = Заказ.ПолучитьОбъект();
			ЗаказОбъект.Версия = ЗаказОбъект.Версия+1;
			ЗаказОбъект.Записать();
		КонецЕсли;
		// <-- Начало Лико Яцун С. В. 23.03.2023
		//Если ЗначениеЗаполнено(ПричиныЗамены) И ПричиныЗамены.Свойство("Количество") Тогда
			СоздатьОбновитьЗаказНаРаскрой(Заказ,ПлощадкаИксПак,Истина);
		//КонецЕсли;
		// <-- Конец Лико Яцун С. В. 23.03.2023
	Иначе
		//Для нулевой версии
		//Перепишем артикулы до создания заявки на цветоделение
		Если  (Заказ.Площадка = Справочники.Лико_Площадки.Ликофлекс И Заказ.РабочийЦентр.ПорядковыйНомер <> 9) ИЛИ Площадка = ПлощадкаИксПак Тогда
			//Перепишем артикулы
			ПереписатьАртикулыНоменклатуры(Заказ);
			//Изменим номера форм только в Ликофлексе
			УточнитьНомераФорм(Заказ);

		КонецЕсли;	
		ЗаполнитьРЦВФормах(Заказ);
		
		АдресРассылки = УправлениеСвойствами.ЗначениеСвойства(Заказ.Партнер, "Лико_АдресРассылкиПриОтправкеЗаказа");
		Если ЗначениеЗаполнено(АдресРассылки)   Тогда 
			ОтправитьУведомлениеОбОтправке(Заказ, АдресРассылки);
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(Заказ.ВедущийТехнолог) Тогда
			Если Заказ.ВидЗаказа <>Перечисления.Лико_ВидыЗаказов.ПолныйПовтор Тогда 
