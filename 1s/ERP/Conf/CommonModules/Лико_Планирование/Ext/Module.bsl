Процедура РассчитатьСпецификациюПоРЦ(СпецОбъект, Выборка, Отказ = Истина) Экспорт
	Ссылка = СпецОбъект.Ссылка;
	НомерВарианта = Выборка.НомерВарианта;
	МетровВсегоОсн=0;
	//Стоимость новых штампов и клише
	Ст_Шт_Клише =Выборка.СтоимостьОснастки;
	ТаблицаРЦ = ПолучитьРЦСпецификацииПоПеределам(Ссылка, Выборка.РабочийЦентр, НомерВарианта);	
	МетрыНаБрак = 0;
	МетрыНаНастройку = 0; 
	МойкаСекций = 0;
	ОбщееВремяВыполненияЗаказа =0;
	ВремяЗаказаДляДоходности = 0;
	ВремяОсновнойМашины = 0;
	
	ЗатратыНаМатериалы = 0;
	ВремяВыполненияНФ_119=0;
	ЗатратыНаОснастку = 0;
	ВсегоКликов = 0;
	ТипРасчета = Ссылка.ТипРасчета;
	КоэффициентВремениДоходности = 1;
	стоимостьРаботРЦ = 0;
	//		ПоказателиПоЗаказу = Новый Соответствие; //собираем показатели по всем машинам
	Для каждого ТекРЦ из ТаблицаРЦ Цикл 
		НормативыДляРЦ= РассчитатьНормативыДляРЦ(Ссылка, Выборка.ПогонныйМетраж, ТекРЦ.РЦ, МетрыНаБрак, МетрыНаНастройку, текРЦ.НомерПроката, Выборка.Количество, ,номерварианта);
		Если ТипЗнч(НормативыДляРЦ) <>Тип("Строка") Тогда
			//				ЗаполнитьПоказателиПоЗаказу(ПоказателиПоЗаказу, НормативыДляРЦ.ПоказателиДляТаблиц);
			стрНормативы =СпецОбъект.Нормативы.Добавить();
			стрНормативы.НомерПроката = текРЦ.НомерПроката;
			стрНормативы.РабочийЦентр = ТекРЦ.РЦ;
			стрНормативы.Нарезка = Выборка.Нарезка;
			стрнормативы.НомерВарианта = номерварианта;
			стрнормативы.КлючСтроки= ВЫборка.КлючСтроки;
			//				
			МетрыНаБрак = МетрыНаБрак +НормативыДляРЦ.МетрыНаБрак;
			МетрыНаНастройку = МетрыНаНастройку+НормативыДляРЦ.МетрыНаНастройку;
			МойкаСекций = МойкаСекций+НормативыДляРЦ.МойкаСекций;
			Если текРЦ.НомерПроката >1 Тогда 
				Если ЗначениеЗаполнено(ТекРЦ.РЦ.Лико_КоэффициентВремениДоходности) Тогда 
					
					//20181213 - не учитываем вторую и последующие машины в любом случае	
					//Иначе
					//	ВремяЗаказаДляДоходности = ВремяЗаказаДляДоходности+НормативыДляРЦ.ВремяВыполненияЗаказа;
					
					//Начало изменений Иванова Анна 20190404 Для расчета доходности по заказам с Шобером, Картесом, НФ, Омегой, Ламинатором, Тотани нужно добавлять 20% от их расчетного времени
					ВремяЗаказаДляДоходности = ВремяЗаказаДляДоходности+НормативыДляРЦ.ВремяВыполненияЗаказа*ТекРЦ.РЦ.Лико_КоэффициентВремениДоходности;
					//Основная машина может быть не первой!!!
					Если  ТекРЦ.РЦ.Лико_КоэффициентВремениДоходности = 1 ТОгда 
						ВремяОсновнойМашины =  ВремяОсновнойМашины+ НормативыДляРЦ.ВремяВыполненияЗаказа*ТекРЦ.РЦ.Лико_КоэффициентВремениДоходности;
					КонецЕсли;
				КонецЕсли;
				
				 
				Если ЗначениеЗаполнено(ТекРЦ.РЦ.Лико_СебестоимостьЧаса) ТОгда 
					Если ЗначениеЗаполнено(НормативыДляРЦ.ВремяВыполненияЗаказа) Тогда
						стоимостьРаботРЦ = стоимостьРаботРЦ+ТекРЦ.РЦ.Лико_СебестоимостьЧаса* НормативыДляРЦ.ВремяВыполненияЗаказа/60;
						стрНормативы.Себестоимость =  стоимостьРаботРЦ;
					КонецЕсли;	
				КонецЕсли;
					
				
			Иначе
				Если ЗначениеЗаполнено(ВремяОсновнойМашины ) ТОгда 
					ВремяЗаказаДляДоходности = ВремяЗаказаДляДоходности +  НормативыДляРЦ.ВремяВыполненияЗаказа*ТекРЦ.РЦ.Лико_КоэффициентВремениДоходности;						
				Иначе	
					ВремяЗаказаДляДоходности = ВремяЗаказаДляДоходности +  НормативыДляРЦ.ВремяВыполненияЗаказа;
				КонецЕсли;	
				
			КонецЕсли;
			
			стрНормативы.МетрыНаНастройку = НормативыДляРЦ.МетрыНаНастройку;
			стрНормативы.МетрыНаБрак = НормативыДляРЦ.МетрыНаБрак;
			стрНормативы.ВремяПечати = НормативыДляРЦ.ВремяПечати;
			стрНормативы.ВремяНаНастройку = НормативыДляРЦ.ВремяНаНастройку;
			стрНормативы.ВремяНаСменуРоликов = НормативыДляРЦ.ВремяНаСменуРоликов;
			стрНормативы.СкоростьПечати = НормативыДляРЦ.СкоростьПечати;
			стрНормативы.МетражДляРЦ = Выборка.ПогонныйМетраж+ МетрыНаБрак+МетрыНаНастройку;
			Если текРЦ.РЦ.ВидРабочегоЦентра= Справочники.ВидыРабочихЦентров.Indigo Тогда 
				ВсегоКликов  =  НормативыДляРЦ.ВсегоКликов;
				стрНормативы.КоличествоКликов = НормативыДляРЦ.ВсегоКликов;
			КонецЕсли; 
			//				//	ВремяВыполненияЗаказаВЧасах = ВремяВыполненияЗаказаВЧасах+НормативыДляРЦ.ВремяПечати+НормативыДляРЦ.ВремяНаНастройку;
			стрНормативы.ПроцентНаБрак = НормативыДляРЦ.ПроцентНаБрак;
			//стрНормативы.Штампы = ШтампыСтрокойПоПрокату(Заказ,текРЦ.НомерПроката); 
			//Определим и запишем в затраты на материалы по РЦ 
			ЗатратыНаМатериалыПоРЦ = РассчитатьЗатратыНаМатериалыПоРЦ(Ссылка, ТекРЦ.НомерПроката, Выборка.Количество, Выборка.ПогонныйМетраж, МетрыНаБрак, МетрыНаНастройку, Выборка.РабочийЦентр, Выборка, НомерВарианта);
			ЗатратыНаМатериалы = ЗатратыНаМатериалы +  ЗатратыНаМатериалыПоРЦ;
			
		Иначе Сообщить(НормативыДляРЦ);;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ВремяЗаказаДляДоходности = ВремяЗаказаДляДоходности*КоэффициентВремениДоходности;
	
	МетровВсего = (МетрыНаБрак+МетрыНаНастройку+Выборка.ПогонныйМетраж )*Выборка.НарезкаРазмер/1000;
	//Добавляем Расчет Доходности
	Затраты = РассчитатьЗатратыПоРЦ(Ссылка,Выборка.РабочийЦентр, Выборка.Количество, МетровВсего, Выборка.СуммаЗаказаРасчет,ВсегоКликов, МойкаСекций,ЗатратыНаОснастку, Выборка, НомерВарианта );
	Затраты = Затраты+СтоимостьРаботРЦ;
	К_Дох = ПолучитьКоэффициентНалоговВДоходности(ТекущаяДата(), Ссылка.Площадка);

	
	Если ТипРасчета = 3 Тогда
		Если ВремяЗаказаДляДоходности >0 Тогда
			//20200625 - Окулов сказал, что \"видимо доходность может быть больше дохода " :)
			//Если ВремяЗаказаДляДоходности>60 Тогда
			СуммаЗаказа_Расчет =Окр(((Выборка.Доходность* ВремяЗаказаДляДоходности)/60+Затраты)/К_Дох,3);
			//Иначе 
			//	СуммаЗаказа_Расчет = (Выборка.Доходность+Затраты)/К_Дох;
			//КонецЕсли;
		КонецЕсли;
	ИначеЕсли  ТипРасчета = 4 Тогда
		//Начало изменений 02.07.2013 Рентабельность будет определяться из Дохода
		//СуммаЗаказа_Расчет = Затраты*(1+текстр.ЗаданнаяРентабельность/100);
		СуммаЗаказа_Расчет =  Затраты/(К_Дох-Выборка.Рентабельность/100);
	Иначе
		СуммаЗаказа_Расчет = Выборка.Количество/1000*Выборка.Цена;// Для спецификации не будем учитывать стоимость штампов и клише, выставляемую покупателю!
	КонецЕсли;	
	
	
	//Цена 1000 этикеток
	Если Выборка.Количество>0 Тогда
		//		//Цена_Расчет =  Окр((СуммаЗаказа_Расчет- Ст_рот_шт-Ст_клише)/КоличествоЭтикеток*1000,4);
		//Цена_Расчет =  Окр((СуммаЗаказа_Расчет-Выборка.СтоимостьОснастки)/Выборка.Количество*1000,4); 
		Цена_Расчет =  Окр((СуммаЗаказа_Расчет)/Выборка.Количество*1000,4);
		// Для спецификации не будем учитывать стоимость штампов и клише, выставляемую покупателю!  
		//Будем считать, что менеджер указывает заданную доходность без учета перевыставляемой оснастки
		Если ТипРасчета = 3 ИЛИ ТипРасчета = 4 Тогда
			Цена = Цена_Расчет;
		Иначе
			Цена = Выборка.Цена;
		КонецЕсли;
	КонецЕсли;
	
	//Доход: стоимость минус материалы
	Доход = К_Дох*СуммаЗаказа_Расчет-Затраты;
	//Рентабельность
	Если ТипРасчета =4 Тогда 
		Рентабельность = Выборка.Рентабельность;
	Иначе	
		Рентабельность = Доход/СуммаЗаказа_Расчет*100;
	КонецЕсли;
	
	Если ТипРасчета = 3 Тогда
		Доходность = Выборка.Доходность;
	Иначе
		Если  ВремяЗаказаДляДоходности>0 Тогда
			//20200625 - Окулов сказал, что \"видимо доходность может быть больше дохода " :)
			//Если ВремяЗаказаДляДоходности>60 Тогда
			Доходность = Окр(Доход/(ВремяЗаказаДляДоходности)*60);
			//Иначе
			//	Доходность =Доход;
			//КонецЕсли;		
		Иначе
			Доходность = 0;
		КонецЕсли;
	КонецЕсли;	
	СтрСтоимость = СпецОбъект.Стоимость.Найти(Выборка.КлючСтроки, "КлючСтроки");	
	СтрСтоимость.Доход = Доход;
	СтрСтоимость.Доходность = доходность;
	СтрСтоимость.Рентабельность = Рентабельность;
	СтрСтоимость.Цена = Цена;
	
	СтрСтоимость.Стоимость =СуммаЗаказа_Расчет;
	СтрСтоимость.СебеСтоимость =Затраты;
	СтрСтоимость.МетражДляРЦКВМ = МетровВсего;
	СтрСтоимость.ВремяВыполнения = ОбщееВремяВыполненияЗаказа;
	Если Не ЗначениеЗаполнено(СтрСтоимость.КвадратныйМетраж) Тогда
		Сообщить("В строке № " + СтрСтоимость.НомерСтроки + " не заполнен Метраж Кв.М");
	Иначе
		СтрСтоимость.ЦенаКвМ = СтрСтоимость.Стоимость/СтрСтоимость.КвадратныйМетраж;
	КонецЕсли;
	
	//СтрСтоимость.Тираж = Выборка.количество/1000;
	//СтрСтоимость.МетражКвМ = Выборка.КвадратныйМетраж;
	//СтрСтоимость.ЗатратыНаОснастку = ЗатратыНаОснастку;
	//СтрСтоимость.ДатаОценки = ТекущаяДата();
	//СтрСтоимость.Записать();				
	Отказ = Ложь;
КонецПроцедуры
	
Функция ПараметрыПоРЦ(Этап, РабочийЦентр, Заказ = Неопределено, НомерПроката = Неопределено) Экспорт
	ПараметрыПоРЦ = Новый структура;
	Время = 0;
	Запрос = Новый Запрос;
	Запрос.Текст= 
	"ВЫБРАТЬ
	|	Лико_ПараметрыПроизводстваЗаказа.ВремяПечати КАК ВремяПечати,
	|	Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку КАК ВремяНаНастройку,
	|	ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.ВремяПечати, 0) + ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку, 0) + ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.ВремяНаСменуРоликов, 0) КАК Время,
	|	ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.МетражДляРЦ, 0) КАК МетражДляРЦ,
	|	Лико_ПараметрыПроизводстваЗаказа.Штампы КАК Штампы,
	|	Лико_ПараметрыПроизводстваЗаказа.ПлощадьПечатиНФ КАК ПлощадьПечатиНФ,
	|	ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.КоличествоКликов, 0) КАК КоличествоКликов
	|ИЗ
	|	Справочник.РабочиеЦентры КАК РабочиеЦентры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|		ПО (РабочиеЦентры.Ссылка = Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр
	|				ИЛИ РабочиеЦентры.ВидРабочегоЦентра = Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр.ВидРабочегоЦентра)
	|ГДЕ
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ = &Заказ
	|	И Лико_ПараметрыПроизводстваЗаказа.НомерПроката = &НомерПроката
	|	И РабочиеЦентры.Ссылка = &Рабочийцентр";
	// --> Начало Лико Ефимов ЕВВ 02.02.2018
	// При вызове этой процедуры 1000 раз из планирования, получение заказа из этапа занимает очень много времени, переделал
	//Запрос.УстановитьПараметр("Заказ", Этап.Распоряжение.ДокументОснование);
	//Запрос.УстановитьПараметр("НомерПроката", Этап.НомерПроката);
	Запрос.УстановитьПараметр("Заказ", ?(Заказ = Неопределено, Этап.Распоряжение.ДокументОснование, Заказ));
	Запрос.УстановитьПараметр("НомерПроката", ?(НомерПроката = Неопределено, Этап.НомерПроката, НомерПроката));
	// <-- Конец Лико Ефимов ЕВВ 02.02.2018 
	Запрос.УстановитьПараметр("Рабочийцентр", РабочийЦентр);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		ПараметрыПоРЦ.Вставить("Время", Результат.Время);
		ПараметрыПоРЦ.Вставить("МетражДляРЦ", Результат.МетражДляРЦ);
		ПараметрыПоРЦ.Вставить("Штампы", Результат.Штампы);
		ПараметрыПоРЦ.Вставить("ПлощадьПечатиНФ", Результат.ПлощадьПечатиНФ);
		ПараметрыПоРЦ.Вставить("КоличествоКликов", Результат.КоличествоКликов);
	КонецЕсли;
	Возврат ПараметрыПоРЦ;
	
КонецФункции

// Необходимо добавить в заказ РЦ, которого там нет и посчитать для него нормативы
Процедура Добавить_РЦ(Заказ, РабочийЦентр, НомерПроката) Экспорт
	Записывать = ЛОжь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаЦвета.Ссылка КАК Ссылка,
	|	ЗаказКлиентаЦвета.РабочийЦентр КАК РабочийЦентр,
	|	ЗаказКлиентаЦвета.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Справочник.РабочиеЦентры КАК РабочиеЦентры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	|		ПО РабочиеЦентры.ВидРабочегоЦентра <> ЗаказКлиентаЦвета.РабочийЦентр.ВидРабочегоЦентра
	|ГДЕ
	|	ЗаказКлиентаЦвета.Ссылка = &Заказ
	|	И ЗаказКлиентаЦвета.НомерПроката = &НомерПроката
	|	И РабочиеЦентры.Ссылка = &РабочийЦентр";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("РабочийЦентр", РабочийЦентр);
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество()>0 Тогда 
		ЗаказОбъект = Заказ.ПолучитьОбъект();
		Пока Выборка.Следующий() Цикл
			ЗаказОбъект.Цвета[Выборка.НомерСтроки-1].РабочийЦентр = РабочийЦентр;
		КонецЦикла;
		Если НомерПроката = 1 Тогда 
			ЗаказОбъект.РабочийЦентр = РабочийЦентр;
		КонецЕсли;
		ЗаказОбъект.Записать();
		РассчитатьСебестоимость_НормативыЗаказа(Заказ);
	
	КонецЕсли;

	
		
	
КонецПроцедуры

//Изменить РЦ - по данным плана меняем РЦ без пересчета заказа
Процедура ИзменитьРЦВЗаказеИзПлана(Заказ, НомерПроката, РабочийЦентр, Отказ=Ложь)  Экспорт
	ЗаказОбъект = Заказ.ПолучитьОбъект();
	Для каждого стр из ЗаказОбъект.Цвета Цикл
		Если стр.номерпроката = номерпроката и  стр.рабочийЦентр <> рабочийЦентр Тогда 
			стр.рабочийЦентр = рабочийЦентр;
		КонецЕсли;
	КонецЦикла;
	Если НомерПроката = 1 и ЗаказОбъект.РабочийЦентр <>  РабочийЦентр Тогда 			
		ЗаказОбъект.РабочийЦентр = РабочийЦентр;
	КонецЕсли;
	Попытка 
		ЗаказОбъект.ОбменДанными.Загрузка=Истина;
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);	
	Исключение;
		Отказ = Истина;
	КонецПопытки;
КонецПроцедуры

//Расчет затрат на материалы
Функция РассчитатьЗатратыНаМатериалыПоРЦ(Ссылка, НомерПроката, Количество, ПогонныйМетраж, МетрыНаБрак, МетрыНаНастройку, РабочийЦентр, ПараметрыШтампа, НомерВарианта = 1) Экспорт 
//Определим и запишем в таблицу материалы по этому РЦ и этому варианту!!!!	
	УстановитьПривилегированныйРежим(Истина);

	ЗатратыНаМатериалы = 0;
	ЗапросМатериалы = Новый Запрос;   
	Метраж = ПогонныйМетраж+ МетрыНаБрак+ МетрыНаНастройку ;
	Комбинированный = Ложь;
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗаказКлиента") Тогда 
		Если Ссылка.комбинированный ТОгда 
			Комбинированный = Истина;
		КонецЕсли;

		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ТаблицаЦвета.ВидСекции КАК ВидСекции,
		|	ВЫБОР
		|		КОГДА ТаблицаЦвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ГорячееТиснениеПлоское)
		|			ТОГДА ВЫБОР
		|					КОГДА ТаблицаЦвета.НаправлениеПротяжки = ЗНАЧЕНИЕ(Перечисление.Лико_НаправленияПротяжки.Продольное)
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПродольное)
		|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПоперечное)
		|				КОНЕЦ
		|		ИНАЧЕ ТаблицаЦвета.ВидСекции.ВидРабот
		|	КОНЕЦ КАК ВидРабот,
		|	ТаблицаЦвета.Материал КАК Затрата,
		|	ТаблицаЦвета.Нарезка КАК Нарезка,
		|	ТаблицаЦвета.Подача КАК Дополнительно,
		|	Лико_ПараметрыШтампа.ЭтикетокНаЛисте КАК ЭтикетокНаЛисте,
		|	ЕСТЬNULL(ЕСТЬNULL(ЦеныМатериалов.Цена, ЦеныМатериаловЛикофлекс.Цена), 0) КАК ЦенаМатериала,
		|	ТаблицаЦвета.ЭтикетокВПодаче КАК ЭтикетокВПодаче,
		|	ТаблицаЦвета.НомерПроката КАК НомерПроката,
		|	ТаблицаЦвета.РабочийЦентр КАК РЦ,
		|	ТаблицаЦвета.ЗаказМатериала КАК ЗаказМатериала,
		|	ТаблицаЦвета.НомерРаботы КАК НомерРаботы,
		|	ТаблицаЦвета.Ссылка.РучьиПечати КАК Ручьи,
		|	ТаблицаЦвета.ДавальческоеСырье КАК ДавальческоеСырье,
		|	ВЫБОР
		|		КОГДА ТаблицаЦвета.КоличествоРучьевМатериала = 0
		|			ТОГДА 1
		|		ИНАЧЕ ТаблицаЦвета.КоличествоРучьевМатериала
		|	КОНЕЦ КАК КоличествоРучьевМатериала,
		|	ТаблицаЦвета.Подача КАК Подача,
		|	ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ДополнительныеМатериалы) КАК СтатьяЗатрат,
		|	1 КАК НомерВарианта
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ТаблицаЦвета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
		|				&Дата,
		|				ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ОсновнаяЕвро)
		|					И Площадка = &Площадка) КАК ЦеныМатериалов
		|		ПО (ВЫБОР
		|				КОГДА ТаблицаЦвета.Материал ССЫЛКА Справочник.ЦеновыеГруппы
		|					ТОГДА ТаблицаЦвета.Материал = ЦеныМатериалов.ЦеноваяГруппа
		|				ИНАЧЕ ТаблицаЦвета.Материал.ЦеноваяГруппа = ЦеныМатериалов.ЦеноваяГруппа
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
		|		ПО ТаблицаЦвета.Оснастка = Лико_ПараметрыШтампа.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
		|				&Дата,
		|				ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ОсновнаяЕвро)
		|					И Площадка = &ПлощадкаЛикофлекс) КАК ЦеныМатериаловЛикофлекс
		|		ПО (ВЫБОР
		|				КОГДА ТаблицаЦвета.Материал ССЫЛКА Справочник.ЦеновыеГруппы
		|					ТОГДА ТаблицаЦвета.Материал = ЦеныМатериаловЛикофлекс.ЦеноваяГруппа
		|				ИНАЧЕ ТаблицаЦвета.Материал.ЦеноваяГруппа = ЦеныМатериаловЛикофлекс.ЦеноваяГруппа
		|			КОНЕЦ)
		|ГДЕ
		|	ТаблицаЦвета.Ссылка = &Ссылка
		|	И ТаблицаЦвета.Материал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.Пустаяссылка)
		|	И ТаблицаЦвета.Материал <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.Пустаяссылка)
		|	И ТаблицаЦвета.Материал <> НЕОПРЕДЕЛЕНО
		|	И ТаблицаЦвета.НомерПроката = &НомерПроката
		|	И ТаблицаЦвета.НомерВарианта = &НомерВарианта";

		
		
		ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Лико_Спецификации") Тогда 	
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ТаблицаЦвета.ВидСекции КАК ВидСекции,
		|	ВЫБОР
		|		КОГДА ТаблицаЦвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ГорячееТиснениеПлоское)
		|			ТОГДА ВЫБОР
		|					КОГДА ТаблицаЦвета.НаправлениеПротяжки = ЗНАЧЕНИЕ(Перечисление.Лико_НаправленияПротяжки.Продольное)
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПродольное)
		|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПоперечное)
		|				КОНЕЦ
		|		ИНАЧЕ ТаблицаЦвета.ВидСекции.ВидРабот
		|	КОНЕЦ КАК ВидРабот,
		|	ТаблицаЦвета.Материал КАК Затрата,
		|	ТаблицаЦвета.Нарезка КАК Нарезка,
		|	ТаблицаЦвета.Подача КАК Подача,
		|	Лико_ПараметрыШтампа.ЭтикетокНаЛисте КАК ЭтикетокНаЛисте,
