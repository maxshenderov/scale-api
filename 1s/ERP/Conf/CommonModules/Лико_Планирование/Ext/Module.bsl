	Запрос.УстановитьПараметр("СписокСкладов",СписокСкладов); 
	
	//Предопределенные значения
	МассивЛико_Предопределенные = Лико_ТиражМетраж.ПолучитьМассивЛико_Предопределенные();
	
	Выборка = Запрос.выполнить().Выбрать();
	ПОка Выборка.Следующий() Цикл
		ЗаказОбъект = Выборка.Заказ.ПолучитьОбъект();
		ОчиститьПустыеОтгрузки(ЗаказОбъект);
		нстр = ЗаказОбъект.Отгрузки.Добавить();
		ЗаполнитьЗначенияСвойств(нстр, Выборка);
		нстр.ключстроки = Новый УникальныйИдентификатор;
		
		ВсегоЗаказано = Выборка.ВсегоЗаказано;
		
		нстр.ОсновнойМатериал = ЗаказОбъект.ОсновнойМатериал;
		Если ЗначениеЗаполнено(ЗаказОбъект.РабочийЦентр) Тогда 
			нстр.рабочийЦентр = ЗаказОбъект.рабочийцентр;
		КонецЕсли;
		нстр.КодПостпечатныхРабот =   Лико_Планирование.ПолучитьКодПостПечатныхработ(выборка.Заказ);
		//Пытаемся определить, последняя ли это отгрузка
		
		ВсегоОтгружено = ЗаказОбъект.Отгрузки.Итог("Количество");
		Если Выборка.Площадка = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра И ТипЗнч(Источник) = Тип("ДокументОбъект.ОтчетДавальцу") Тогда 
			//Настройку ставим для первой строки
		    Если нстр.номерстроки = 1 Тогда 
				нстр.Настройка = 1;
			КонецЕсли;		
		Иначе	
			Если (ВсегоЗаказано-ВсегоОтгружено)*100/ВсегоЗаказано<=5 Тогда 
				нстр.Настройка = 1;
			КонецЕсли;
		КонецЕсли;
		Попытка
			ЗаказОбъект.ОбменДанными.Загрузка=Истина;
			ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось записать заказ" +ЗаказОбъект.НомерБезПрефикса+ ОписаниеОшибки());
			Отказ = Истина;
			Возврат;
		КонецПопытки;
		Если Выборка.РасчетНормативов Тогда 
			РассчитатьНормативыПоОтгрузке(ЗаказОбъект, нстр.ключстроки, Отказ);
		КонецЕсли;	
		
	КонецЦикла;


	
