					ЭкономияВОплату =  (Движение.ПланКвМ*(1+КоэффициентЭкономии/100)-Движение.ФактКВМ)*ТипМатериала;
					КоэффициентВремениВОплату = ПолучитьКоэффициент(Справочники.Лико_ТаблицыДляРасчетаНормативов.КоэффициентВремениВОплату, выборка.РабочийЦентр,СложностьЗаказа);
				ИначеЕсли  выборка.РабочийЦентр.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Cartes ИЛИ выборка.РабочийЦентр.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Omega Тогда       
					КоэффициентЭкономии = ПолучитьКоэффициент(Справочники.Лико_ТаблицыДляРасчетаНормативов.СмещениеВыработки, выборка.РабочийЦентр,СложностьЗаказа); 
					ЭкономияВОплату  = (Движение.ПланКвМ*(1+КоэффициентЭкономии/100)-Движение.ФактКВМ)*ТипМатериала;
				КонецЕсли;

				Движение.ЭкономияВОплату = ЭкономияВОплату;
				Если  ЭкономияВОплату<0 И ЗначениеЗаполнено(ПодтвержденныйПерерасход) Тогда  
					Если (ПодтвержденныйПерерасход*ТипМатериала+ЭкономияВОплату)>0 Тогда 
						ЭкономияВОплатуСУчетомПерерасхода = 0;
					Иначе 
						ЭкономияВОплатуСУчетомПерерасхода = ПодтвержденныйПерерасход*ТипМатериала+ЭкономияВОплату;
					КонецЕсли;
				Иначе 
					ЭкономияВОплатуСУчетомПерерасхода = ЭкономияВОплату;
				КонецЕсли;
				Движение.ЭкономияВОплатуСУчетомПерерасхода = ЭкономияВОплатуСУчетомПерерасхода;

				Движение.ВремяВОплату = (ВремяНаНастройку+ВремяПечати)*?(КоэффициентВремениВОплату=0, 1, КоэффициентВремениВОплату) + ?(выборка.Дата >= Дата('20250525'),выборка.КартаСнятияВремяВОплату,0);

				Движение.ВремяНаНастройкуПлан = ВремяНаНастройку;
				Движение.ВремяПечатиПлан =  ВремяПечати;
				Движение.ВремяНаСменуРоликовПлан = ВремяНаНаСменуРОликовПлан;
				Движение.КартаРасхода = выборка.КартаПерерасходаНомер;
				Движение.КартаРасходаПриПечати = выборка.КартаПерерасходаПриПечатиНомер;
				Движение.КартаСнятия =  выборка.КартаСнятияНомер;
				Движение.Тиснение = РезультатСложность.Тиснение;
				Движение.ЛаминированиеЖемчужкой = РезультатСложность.ЛаминированиеЖемчужкой;
				Движение.ПечатьСКлеящегоСлоя = РезультатСложность.ПечатьСКлеящегоСлоя;
				Движение.НаличиеТрафаретов = РезультатСложность.НаличиеТрафаретов;
				Движение.СложностьЗаказа = РезультатСложность.СложностьЗаказа;
			КонецЦикла;

		КонецЕсли;
	КонецЦикла;
	НаборЗаписейВыработкаПечатников.Записать();
	НаборЗаписейВыработкаОператоровТУ.Записать();
КонецПроцедуры

Процедура ЗаполнитьЗатратыПоОтгрузке(Заказ) Экспорт
	НаборЗаписей = РегистрыНакопления.Лико_ЗатратыПоОтгрузке.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Заказ);
	НаборЗаписей.Записать();
	РабочийЦентр = Справочники.РабочиеЦентры.ПустаяСсылка();
	

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаОтгрузки.КлючСтроки КАК КлючСтроки,
	|	ЗаказКлиентаОтгрузки.Дата КАК ДатаОтгрузки,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.ЗаказКлиента КАК ЗаказКлиента,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.РабочийЦентр КАК РабочийЦентр,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.Затрата КАК Затрата,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.СтатьяЗатрат КАК СтатьяЗатрат,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.НомерПроката КАК НомерПроката,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.ВидРабот КАК ВидРабот,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.НомерРаботы КАК НомерРаботы,
	|	СУММА(Лико_ЗатратыПоЗаказуДляОтгрузки.Количество) КАК Количество,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.Отгрузка КАК Отгрузка,
	|	ВЫБОР
	|		КОГДА Лико_ЗатратыПоЗаказуДляОтгрузки.Затрата ССЫЛКА Справочник.Номенклатура
	|			ТОГДА Лико_ЗатратыПоЗаказуДляОтгрузки.Затрата.ЦеноваяГруппа
	|		КОГДА Лико_ЗатратыПоЗаказуДляОтгрузки.Затрата ССЫЛКА Справочник.ЦеновыеГруппы
	|			ТОГДА Лико_ЗатратыПоЗаказуДляОтгрузки.Затрата
	|	КОНЕЦ КАК ЦГ,
	|	СУММА(ВЫБОР
	|			КОГДА НЕ Лико_ПараметрыШтампа.Цена ЕСТЬ NULL
	|				ТОГДА Лико_ПараметрыШтампа.Цена * Лико_ЗатратыПоЗаказуДляОтгрузки.Количество
	|			ИНАЧЕ Лико_ЗатратыПоЗаказуДляОтгрузки.Сумма
	|		КОНЕЦ) КАК Сумма,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.ВидНастроечногоМатериала КАК ВидНастроечногоМатериала,
	|	СУММА(Лико_ЗатратыПоЗаказуДляОтгрузки.КоличествоПМ) КАК КоличествоПМ
	|ИЗ
	|	Документ.ЗаказКлиента.Отгрузки КАК ЗаказКлиентаОтгрузки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ЗатратыПоЗаказуДляОтгрузки КАК Лико_ЗатратыПоЗаказуДляОтгрузки
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|			ПО Лико_ЗатратыПоЗаказуДляОтгрузки.Затрата = Лико_ПараметрыШтампа.Номенклатура
	|		ПО ЗаказКлиентаОтгрузки.Ссылка = Лико_ЗатратыПоЗаказуДляОтгрузки.ЗаказКлиента
	|			И ЗаказКлиентаОтгрузки.КлючСтроки = Лико_ЗатратыПоЗаказуДляОтгрузки.КлючСтроки
	|ГДЕ
	|	ЗаказКлиентаОтгрузки.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаОтгрузки.КлючСтроки,
	|	ЗаказКлиентаОтгрузки.Дата,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.ЗаказКлиента,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.РабочийЦентр,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.Затрата,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.СтатьяЗатрат,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.НомерПроката,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.ВидРабот,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.НомерРаботы,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.Отгрузка,
	|	ВЫБОР
	|		КОГДА Лико_ЗатратыПоЗаказуДляОтгрузки.Затрата ССЫЛКА Справочник.Номенклатура
	|			ТОГДА Лико_ЗатратыПоЗаказуДляОтгрузки.Затрата.ЦеноваяГруппа
	|		КОГДА Лико_ЗатратыПоЗаказуДляОтгрузки.Затрата ССЫЛКА Справочник.ЦеновыеГруппы
	|			ТОГДА Лико_ЗатратыПоЗаказуДляОтгрузки.Затрата
	|	КОНЕЦ,
	|	Лико_ЗатратыПоЗаказуДляОтгрузки.ВидНастроечногоМатериала";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Если Не ЗначениеЗаполнено(Выборка.Сумма)  Тогда 
			Цена = ЦенаЦеновойГруппы(Выборка.ЦГ, Выборка.ДатаОтгрузки, Заказ.Площадка.Организация);
			Запись.Сумма = Выборка.Количество*Цена;
		КонецЕсли;
		Запись.Регистратор = Заказ;
		Запись.Период = Выборка.ДатаОтгрузки;	
		
		//Запись.КлючСтроки = текстр.КлючСтроки;
		//Запись.Отгрузка = текстр.ДокументОтгрузки;
	КонецЦикла;
	НаборЗаписей.Записать();
	НаборЗаписей.Прочитать();
	
	//Заполняем краски лаки
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказКлиентаОтгрузки.Дата КАК Период,
	|	ЗаказКлиентаОтгрузки.Ссылка КАК Регистратор,
	|	Лико_ЗатратыПоОтгрузке.ЗаказКлиента КАК ЗаказКлиента,
	|	ЗаказКлиентаОтгрузки.ДокументОтгрузки КАК Отгрузка,
	|	МАКСИМУМ(ЗаказКлиентаОтгрузки.Дата) КАК ДатаОтгрузки,
	|	МАКСИМУМ(Лико_ЗатратыПоОтгрузке.РабочийЦентр) КАК РабочийЦентр,
	|	МИНИМУМ(Лико_ЗатратыПоОтгрузке.НомерПроката) КАК НомерПроката,
	|	ЗаказКлиентаОтгрузки.КлючСтроки КАК КлючСтроки,
	|	Лико_ЗатратыПоОтгрузке.СтатьяЗатрат КАК СтатьяЗатрат,
	|	ЗаказКлиентаОтгрузки.КвадратныйМетраж КАК КвадратныйМетраж,
	|	СУММА(Лико_ЗатратыПоОтгрузке.Количество) КАК Количество,
	|	СУММА(Лико_ЗатратыПоОтгрузке.КоличествоПМ) КАК КоличествоПМ,
	|	ЗаказКлиентаОтгрузки.ПогонныйМетраж КАК ПогонныйМетраж
	|ИЗ
	|	Документ.ЗаказКлиента.Отгрузки КАК ЗаказКлиентаОтгрузки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ЗатратыПоОтгрузке КАК Лико_ЗатратыПоОтгрузке
	|		ПО ЗаказКлиентаОтгрузки.Ссылка = Лико_ЗатратыПоОтгрузке.ЗаказКлиента
	|			И ЗаказКлиентаОтгрузки.КлючСтроки = Лико_ЗатратыПоОтгрузке.КлючСтроки
	|ГДЕ
	|	Лико_ЗатратыПоОтгрузке.СтатьяЗатрат = ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ОсновнойМатериал)
	|	И ЗаказКлиентаОтгрузки.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаОтгрузки.Дата,
	|	ЗаказКлиентаОтгрузки.Ссылка,
	|	Лико_ЗатратыПоОтгрузке.ЗаказКлиента,
	|	ЗаказКлиентаОтгрузки.ДокументОтгрузки,
	|	ЗаказКлиентаОтгрузки.КлючСтроки,
	|	Лико_ЗатратыПоОтгрузке.СтатьяЗатрат,
	|	ЗаказКлиентаОтгрузки.КвадратныйМетраж,
	|	ЗаказКлиентаОтгрузки.ПогонныйМетраж";
	
	ТЗОтгрузкиОснМатериал = Запрос.выполнить().Выгрузить();
	Для каждого стрОтгрузка из ТЗОтгрузкиОснМатериал  Цикл
		РабочийЦентр = Выборка.рабочийЦентр;
		ТЗ = ПолучитьСтоимостьКраскиЛаков(Заказ,"Документ.ЗаказКлиента", стрОтгрузка.Количество, стрОтгрузка.КоличествоПМ, 1, НачалоМесяца(стрОтгрузка.ДатаОтгрузки), 1, Истина);   //СтрОтгрузка.КвадратныйМетраж
		Для каждого стр ИЗ ТЗ Цикл
			Запись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, стр);
			ЗаполнитьЗначенияСвойств(Запись, стрОтгрузка, "ЗаказКлиента, ДатаОтгрузки, КлючСтроки, РабочийЦентр, Отгрузка");
			Запись.Метраж = стрОтгрузка.Количество;
			Запись.Регистратор = Заказ;
			Запись.Период = стрОтгрузка.ДатаОтгрузки;
		КонецЦикла;
		
		Если Заказ.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Термоусадка Тогда 
			ВыборкаКлеяТУ = ПолучитьСтоимостьКлеяТУ(Заказ,1,  стрОтгрузка.ПогонныйМетраж*1.05 ,НачалоМесяца(стрОтгрузка.ДатаОтгрузки), Заказ.Ручьи   );
			//1,05 - добавляем 5 % на брак
			Запись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, ВыборкаКлеяТУ);
			ЗаполнитьЗначенияСвойств(Запись, стрОтгрузка, "ЗаказКлиента, ДатаОтгрузки, КлючСтроки, РабочийЦентр, Отгрузка");
			Запись.Метраж = стрОтгрузка.Количество;
			Запись.Регистратор = Заказ;
			Запись.Период = стрОтгрузка.ДатаОтгрузки;

		КонецЕсли;

	КонецЦикла;
	
		
	//Мойку секций пока берем из затрат заказа
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаОтгрузки.Ссылка КАК ЗаказКлиента,
	|	ЗаказКлиентаОтгрузки.Дата КАК ДатаОтгрузки,
	|	ЗаказКлиентаОтгрузки.ДокументОтгрузки КАК ДокументОтгрузки,
	|	ЗаказКлиентаОтгрузки.КлючСтроки КАК КлючСтроки,
	|	Лико_Затраты.СтатьяЗатрат КАК СтатьяЗатрат,
	|	Лико_Затраты.Затрата КАК Затрата,
	|	ЗаказКлиентаОтгрузки.Ссылка КАК Регистратор,
	|	ЗаказКлиентаОтгрузки.Дата КАК Период,
	|	Лико_Затраты.НомерПроката КАК НомерПроката,
	|	Лико_Затраты.Количество КАК Количество,
	|	Лико_Затраты.Количество * 4.3 * ЗаказКлиентаОтгрузки.Настройка КАК Сумма
	|ИЗ
	|	Документ.ЗаказКлиента.Отгрузки КАК ЗаказКлиентаОтгрузки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_Затраты КАК Лико_Затраты
	|		ПО ЗаказКлиентаОтгрузки.Ссылка = Лико_Затраты.ЗаказКлиента
	|			И (Лико_Затраты.СтатьяЗатрат = ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.МойкаСекций))
	|ГДЕ
	|	ЗаказКлиентаОтгрузки.Ссылка = &Заказ
	|	И ЗаказКлиентаОтгрузки.Настройка > 0";	
	ВыборкаМойка = Запрос.Выполнить().Выбрать();
	Пока ВыборкаМойка.Следующий() Цикл
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаМойка);
		Запись.РабочийЦентр = Выборка.РабочийЦентр;
	КонецЦикла;	
	
	//Стоимость скотча
	//приклеиваются все формы, т.е. все цвета кроме бесцветной массы и лака без окна:
	ЗапросСкотч = Новый Запрос;
	ЗапросСкотч.Текст = 
	"ВЫБРАТЬ
	|	СУММА(1) КАК КоличествоКлише,
	|	ТаблицаЦвета.Ссылка КАК Заказ,
	|	ТаблицаЦвета.НомерПроката КАК НомерПроката
	|ПОМЕСТИТЬ ВТКлише
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК ТаблицаЦвета
	|ГДЕ
	|	ТаблицаЦвета.Ссылка = &Заказ
	|	И ТаблицаЦвета.ВидСекции.РОдитель =  ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Флексо)
	|	И ТаблицаЦвета.ВидСекции <>  ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ЛаминацияСамоклейкой)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаЦвета.Ссылка,
	|	ТаблицаЦвета.НомерПроката
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиентаОтгрузки.Ссылка КАК ЗаказКлиента,
	|	ЗаказКлиентаОтгрузки.Дата КАК ДатаОтгрузки,
	|	ЗаказКлиентаОтгрузки.ДокументОтгрузки КАК ДокументОтгрузки,
	|	ЗаказКлиентаОтгрузки.КлючСтроки КАК КлючСтроки,
	|	ЗаказКлиентаОтгрузки.Ссылка КАК Регистратор,
	|	ЗаказКлиентаОтгрузки.Дата КАК Период,
	|	ВТКлише.КоличествоКлише КАК Количество,
	|	ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.Скотч) КАК СтатьяЗатрат,
	|	ВТКлише.КоличествоКлише * 2.5 КАК Сумма
	|ИЗ
