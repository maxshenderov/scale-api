		НаборЗаписейНормативы.Записать();
	КонецЕсли;
	
    ЗаполнятьЗатраты = ЛОжь;   
	ПовторноеПроведение = Ложь;  
	//20230621 Возвращаемся к актуализации записей при каждом проведении
	//Если Источник.ДополнительныеСвойства.Свойство("Лико_Отгрузки") Тогда 
	//	Если Источник.ДополнительныеСвойства.Лико_Отгрузки.Количество() > 0 Тогда  
	//		ПовторноеПроведение = Истина; 
	//	КонецЕсли;
	//КонецЕсли;	
	

	
	
