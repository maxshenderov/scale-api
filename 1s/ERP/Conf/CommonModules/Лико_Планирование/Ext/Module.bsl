		Площадка = Менеджер.Лико_Площадка;
		Регион =  Менеджер.Лико_Регион;
		
	КонецЕсли;
	Спец.Менеджер = менеджер;
	
	
		
	Если ЗначениеЗаполнено(Результат.ОсновнойМатериалЦГКод) Тогда 
		Спец.ОсновнойМатериал = Справочники.ЦеновыеГруппы.НайтиПоКоду(Результат.ОсновнойМатериалЦГКод);
	ИначеЕсли ЗначениеЗаполнено(Результат.ОсновнойМатериалНоменклатураКод) Тогда 
		ОсновнойМатериал = Справочники.Номенклатура.НайтиПоКоду(Результат.ОсновнойМатериалНоменклатураКод);
		Если ЗначениеЗаполнено(ОсновнойМатериал) Тогда 
			Спец.ОсновнойМатериал =ОсновнойМатериал;
		Иначе
			Сообщить("Не найден материал "+ Результат.ОсновнойМатериалНоменклатураКод) ;
		//	Возврат;
			//Док.ОсновнойМатериал = ЗагрузитьМатериалНаСервере(Результат.ОсновнойМатериалНоменклатураКод);
		КонецЕсли;	
	КонецЕсли;
		
	Спец.ЧитабельностьМедали = Результат.ЧитабельностьМедали;
	Спец.ГрамматураКлеяКнижки = Результат.ГрамматураКлеяКнижки;
	Спец.ПроверкаОрфографии = Результат.ПроверкаОрфографии;
	Спец.ПроверкаШК = Результат.ПроверкаШК;
	Спец.КоличествоПоверхностейКнижки = Результат.КоличествоПоверхностейКнижки;
	Спец.ШиринаРукаваТУ = Результат.ШиринаРукаваТУ;
	Спец.ПоперечнаяРезкаТУ = Результат.ПоперечнаяРезкаТУ;
