//Штрихкоды
Функция ПолучитьШтрихКодЗаказа(Заказ, НомерБланка = 1, ШКСтрокой="",НомерПроката=1, НомерПриложения = 0) Экспорт
	
	Перем ШК;
	
	ВидИнформации = "30060000";
	НомерЗаказа = Заказ.НомерБезПрефикса;
	
	ФВерсия = Формат(Заказ.Версия, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");
	ФНомерБланка = Формат(НомерБланка, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");
	ФНомерПроката = Формат(НомерПроката, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");
	// --> Начало Лико Ефимов ЕВВ 14.11.2024
	// Добавлю в штрихкод номер приложения, сократив номер проката до 2 знаков (в функции обработки ШК номер проката раньше был 5-6-7-8 символы, сейчас будет 7-8, а номер приложения 5-6
	//ШК = "300600"+ФНомерПроката+ФВерсия+ФНомерБланка+НомерЗаказа;
	ФНомерПриложения = Формат(НомерПриложения, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");	
	ШК = "3006" + ФНомерПриложения + ФНомерПроката + ФВерсия + ФНомерБланка + НомерЗаказа;
	// <-- Конец Лико Ефимов ЕВВ 14.11.2024

	КонтольныйСимвол = 0;
	Для Ц = 1 по СтрДлина(ШК) Цикл
		Попытка
			КонтольныйСимвол = КонтольныйСимвол + Число(Сред(ШК, Ц, 1));
		Исключение
		КонецПопытки;
	КонецЦикла;	
	
	КонтольныйСимвол = Прав(СокрЛП(КонтольныйСимвол),1);
	
	ШК = ШК + КонтольныйСимвол;
	
	Возврат ШК;
КонецФункции //ПолучитьШтрихКодЗаказаСпецификации Экспорт

