		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТКоробок.Заказ КАК Регистратор,
		|	ВТКоробок.Заказ КАК ЗаказКлиента,
		|	ВТКоробок.КлючСтроки КАК КлючСтроки,
		|	ВТКоробок.ДокументОтгрузки КАК Отгрузка,
		|	ВТКоробок.ДатаОтгрузки КАК Период,
		|	ВТКоробок.ДатаОтгрузки КАК ДатаОтгрузки,
		|	ВТКоробок.НомерПроката КАК НомерПроката,
		|	ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.Коробки) КАК СтатьяЗатрат,
		|	ВТКоробок.РабочийЦентр КАК РабочийЦентр,
		|	ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.УпаковочныеМатериалы) КАК Затрата,
		|	ВТКоробок.КоличествоКоробок КАК Количество,
		|	ВЫРАЗИТЬ(ВТКоробок.КоличествоКоробок * 0.6 КАК ЧИСЛО(10, 0)) КАК Сумма
		|ИЗ
		|	ВТКоробок КАК ВТКоробок
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТКоробок.Заказ,
		|	ВТКоробок.Заказ,
		|	ВТКоробок.КлючСтроки,
		|	ВТКоробок.ДокументОтгрузки,
		|	ВТКоробок.ДатаОтгрузки,
		|	ВТКоробок.ДатаОтгрузки,
		|	ВТКоробок.НомерПроката,
		|	ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.Втулки),
		|	ВТКоробок.РабочийЦентр,
		|	ЗаказКлиента.Втулка.ЦеноваяГруппа,
		|	ВТКоробок.КоличествоРоликов,
		|	ВТКоробок.КоличествоРоликов * 0.5 * ВТКоробок.НарезкаРазмер
		|ИЗ
		|	ВТКоробок КАК ВТКоробок
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
		|		ПО ВТКоробок.Заказ = ЗаказКлиента.Ссылка
		|ГДЕ
		|	НЕ ЗаказКлиента.Втулка.ЦеноваяГруппа ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Таб", ТЗОтгрузкиОснМатериал);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
	КонецЦикла;	
	
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция  ЦенаЦеновойГруппы(ЦГ, Дата,Площадка, ТипЦен =Неопределено)  Экспорт
	Цена = 0;
	Если ТипЦен = Неопределено Тогда 
		ТипЦен = Перечисления.Лико_ТипЦен.ОсновнаяЕвро;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Лико_ЦеныГруппНоменклатурыСрезПоследних.Цена, Лико_ЦеныГруппНоменклатурыСрезПоследних1.Цена) КАК Цена
	|ИЗ
	|	РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
	|			&Дата,
	|			ТипЦен = &ТипЦен
	|				И Площадка = &Площадка
	|				И ЦеноваяГруппа = &ЦГ) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
	|				&Дата,
	|				ТипЦен = &ТипЦен
	|					И Площадка = &ПлощадкаЛикофлекс
	|					И ЦеноваяГруппа = &ЦГ) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних1
	|		ПО Лико_ЦеныГруппНоменклатурыСрезПоследних.ЦеноваяГруппа = Лико_ЦеныГруппНоменклатурыСрезПоследних1.ЦеноваяГруппа";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ЦГ", ЦГ);
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);

	Запрос.УстановитьПараметр("Площадка", Площадка);
	Запрос.УстановитьПараметр("ПлощадкаЛикофлекс", Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Цена = Выборка.Цена;
	КонецЦикла;
	Возврат Цена;
КонецФункции

Функция ОпределитьНастройкуЗП(Заказ, текстр)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаПеремотка.Дата КАК Дата,
	|	ЗаказКлиентаПеремотка.Сотрудник КАК Сотрудник,
	|	МИНИМУМ(ЗаказКлиентаПеремотка.НомерСтроки) КАК НомерСтроки
	|ИЗ
	|	Документ.ЗаказКлиента.Перемотка КАК ЗаказКлиентаПеремотка
	|ГДЕ
	|	ЗаказКлиентаПеремотка.Ссылка = &Ссылка
	|	И ЗаказКлиентаПеремотка.Сотрудник = &Сотрудник
	|	И ЗаказКлиентаПеремотка.Дата = &Дата
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаПеремотка.Дата,
	|	ЗаказКлиентаПеремотка.Сотрудник";
	Запрос.УстановитьПараметр("Ссылка", Заказ);
	Запрос.УстановитьПараметр("Сотрудник", текстр.Сотрудник);
	Запрос.УстановитьПараметр("Дата", текстр.Дата);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Если текстр.Номерстроки = Результат.НомерСтроки Тогда 
		Возврат 1;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

