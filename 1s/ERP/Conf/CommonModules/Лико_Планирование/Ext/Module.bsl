Процедура СозданиеЗаказовОснасткиПриСписанииШтампов(ДокСписания) Экспорт
	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Лико_ПередачаТоваровТовары.Номенклатура КАК Оснастка,
	|	МАКСИМУМ(ЗаказКлиентаВидыРабот.Ссылка.Дата) КАК Дата
	|ПОМЕСТИТЬ ВТДаты
	|ИЗ
	|	Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|		ПО Лико_ПередачаТоваровТовары.Номенклатура.Артикул = ЗаказКлиентаВидыРабот.Оснастка.Артикул
	|ГДЕ
	|	Лико_ПередачаТоваровТовары.Ссылка = &Ссылка
	|	И Лико_ПередачаТоваровТовары.Номенклатура.Артикул <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ПередачаТоваровТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДаты.Оснастка КАК Оснастка,
	|	ЗаказКлиентаВидыРабот.ВидРабот КАК ВидРабот,
	|	ЗаказКлиентаВидыРабот.Ссылка КАК Заказ
	|ПОМЕСТИТЬ ВТЗаказ
	|ИЗ
	|	ВТДаты КАК ВТДаты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|		ПО ВТДаты.Оснастка.Артикул = ЗаказКлиентаВидыРабот.Оснастка.Артикул
	|			И ВТДаты.Дата = ЗаказКлиентаВидыРабот.Ссылка.Дата
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТДаты.Оснастка,
	|	ЗаказКлиентаВидыРабот.ВидРабот,
	|	ЗаказКлиентаВидыРабот.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЗаказ.Заказ КАК Заказ,
	|	ВТЗаказ.Оснастка КАК Оснастка,
	|	СУММА(ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.МетражДляРЦ, 0)) КАК Метраж,
	|	ВТЗаказ.Заказ.ШагПечати КАК ШагПечати,
	|	ВТЗаказ.Заказ.Z КАК Z,
	|	Лико_ЗаказыНаОснасткуСрезПоследних.ЗаказНаОснастку КАК ЗаказНаОснастку,
	|	ВТЗаказ.ВидРабот КАК ВидРабот
	|ПОМЕСТИТЬ ВТПлан
	|ИЗ
	|	ВТЗаказ КАК ВТЗаказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|		ПО ВТЗаказ.Заказ = Лико_ПараметрыПроизводстваЗаказа.Заказ
	|			И ВТЗаказ.Заказ.РабочийЦентр = Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр
	|			И (Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1)
	|			И (ВТЗаказ.Заказ.Состояние = ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаказов.ВключенВПлан))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЗаказыНаОснастку.СрезПоследних КАК Лико_ЗаказыНаОснасткуСрезПоследних
	|		ПО ВТЗаказ.Оснастка = Лико_ЗаказыНаОснасткуСрезПоследних.Номенклатура
	|			И (Лико_ЗаказыНаОснасткуСрезПоследних.Статус <> ЗНАЧЕНИЕ(Перечисление.Лико_СтатусыЗаказовНаОснастку.Поступил))
	|			И (Лико_ЗаказыНаОснасткуСрезПоследних.Статус <> ЗНАЧЕНИЕ(Перечисление.Лико_СтатусыЗаказовНаОснастку.Отменен))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТЗаказ.Заказ,
	|	ВТЗаказ.Заказ.ШагПечати,
	|	ВТЗаказ.Заказ.Z,
	|	Лико_ЗаказыНаОснасткуСрезПоследних.ЗаказНаОснастку,
	|	ВТЗаказ.Оснастка,
	|	ВТЗаказ.ВидРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПлан.Оснастка КАК Оснастка,
	|	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры КАК СерияЯССМ_ОбъектНоменклатуры,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК КоличествоОстаток,
	|	Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбщаяНаработка КАК ОбщаяНаработка,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА ВТПлан.Z <> ЗНАЧЕНИЕ(Справочник.Лико_ZКоличествоЗубьев.ПустаяСсылка)
	|				ТОГДА Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбщаяНаработка / (ВТПлан.Z.КоличествоЗубьев * 3.175 / 1000)
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ВТПлан.ШагПечати <> 0
	|						ТОГДА Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбщаяНаработка / ВТПлан.ШагПечати
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		КОНЕЦ КАК ЧИСЛО(15, 0)) КАК КоличествоУдаровФакт
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	ВТПлан КАК ВТПлан
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки КАК ТоварыВЯчейкахОстатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_НаработкиОбъектовНоменклатуры.СрезПоследних КАК Лико_НаработкиОбъектовНоменклатурыСрезПоследних
	|			ПО ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры = Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбъектНоменклатуры
	|		ПО ВТПлан.Оснастка = ТоварыВЯчейкахОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОстатки.Оснастка КАК Оснастка,
	|	СУММА(ВТОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	|	СУММА(ВТОстатки.КоличествоУдаровФакт) КАК КоличествоУдаровФакт
	|ПОМЕСТИТЬ ВТОстаткиИтог
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТОстатки.Оснастка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПлан.Оснастка КАК Оснастка,
	|	ВТПлан.Оснастка.Артикул КАК Артикул,
	|	ВТПлан.ВидРабот КАК ВидРабот,
	|	ВТПлан.Заказ КАК Заказ,
	|	ВТПлан.Заказ.Менеджер КАК Менеджер,
	|	ЕСТЬNULL(ВТОстаткиИтог.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(ВТОстаткиИтог.КоличествоУдаровФакт, 0) КАК КоличествоУдаровФакт,
	|	ВТПлан.ЗаказНаОснастку КАК ЗаказНаОснастку,
	|	ВТПлан.Заказ.Этикетки КАК Этикетки,
	|	ВЫБОР
	|		КОГДА ВТПлан.ЗаказНаОснастку ЕСТЬ NULL
	|				И (ВТОстаткиИтог.КоличествоОстаток ЕСТЬ NULL
	|					ИЛИ (ВЫРАЗИТЬ(ВЫБОР
	|							КОГДА ВТПлан.Z <> ЗНАЧЕНИЕ(Справочник.Лико_ZКоличествоЗубьев.ПустаяСсылка)
	|								ТОГДА ВТПлан.Метраж / (ВТПлан.Z.КоличествоЗубьев * 3.175 / 1000)
	|							ИНАЧЕ ВЫБОР
	|									КОГДА ВТПлан.ШагПечати <> 0
	|										ТОГДА ВТПлан.Метраж / ВТПлан.ШагПечати
	|									ИНАЧЕ 0
	|								КОНЕЦ
	|						КОНЕЦ КАК ЧИСЛО(15, 0))) + ВТОстаткиИтог.КоличествоУдаровФакт > 3000000)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ТребуетсяЗаказ
	|ИЗ
	|	ВТПлан КАК ВТПлан
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстаткиИтог КАК ВТОстаткиИтог
	|		ПО ВТПлан.Оснастка = ВТОстаткиИтог.Оснастка
	|ИТОГИ ПО
	|	Менеджер";
	Запрос.УстановитьПараметр("Ссылка", ДокСписания);
	ВыборкаМенеджер = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Менеджер");
	ОтветственныйЗаОснастку = Справочники.Лико_ПредопределенныеЗначения.ПользовательОтветственныйЗаОснастку.ЗначениеПараметра;
	Пока ВыборкаМенеджер.Следующий() Цикл
		СтрОснастки = "";
		Выборка = ВыборкаМенеджер.Выбрать();
		ЗаказСоздан = Ложь;
		Пока Выборка.Следующий() Цикл
			Если Выборка.ТребуетсяЗаказ Тогда 
				Если Не ЗаказСоздан Тогда 
					ДокОбъект = Документы.Лико_ЗаказОснастки.СоздатьДокумент();
					ДокОбъект.Дата = ТекущаяДата();
					ДокОбъект.Площадка = Справочники.Лико_Площадки.Ликофлекс;
					ДокОбъект.Ответственный = Справочники.Пользователи.НайтиПоНаименованию("Robot 1C");
					ДокОбъект.Комментарий = "Документ создан автоматически при проведении списания N"+ ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокСписания.Номер, Ложь, Ложь);
					ДокОбъект.ВидОперации = Перечисления.Лико_ВидыОперацийЗаказОснастки.Перезаказ;
					ЗаказСоздан = Истина;
				КонецЕсли;
				стр = ДокОбъект.Оснастка.Добавить();
				стр.Номенклатура = Выборка.Оснастка;
				стр.Количество = 1;
				стр.Менеджер = Выборка.Менеджер;
				стр.Заказ = Выборка.Заказ;
				стр.статус = перечисления.Лико_СтатусыЗаказовНаОснастку.Создан;
				стр.ВидШтампа = Выборка.ВидРабот;
				стр.КлючСтроки = Новый УникальныйИдентификатор; 
				Если ЗначениеЗаполнено(Выборка.Заказ) Тогда 
					стртовары = Выборка.Заказ.Товары[0];
					стрэт =  ДокОбъект.Этикетки.Добавить();
					стрэт.этикетка = стртовары.номенклатура;
					стрэт.КлючСтроки = стр.КлючСтроки;
				КонецЕсли;
			КонецЕсли;	
			стрОснастки = СтрОснастки+ " Оснастка "+Выборка.Оснастка.Наименование+ " "+ Выборка.Артикул+ " использовалась в заказе N" +Выборка.Заказ.НомерБезПрефикса+" для печати этикеток "+ Выборка.Этикетки+";  "+Символы.ПС + " Остаток на складе " + Выборка.КоличествоОстаток;					
		КонецЦикла;
		Если ЗаказСоздан ТОгда 
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			НомерДок = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокОбъект.Ссылка.Номер, Ложь, Ложь);
			текст = "Подтвердите или отмените заказ на оснастку N " +НомерДок+ " для перезаказа списанной оснастки:          "+ Символы.ПС+стрОснастки;
			Тема = "Подтвердите или отмените заказ на оснастку N " +НомерДок+ " для перезаказа списанной оснастки ";
		Иначе
			Текст = "Произведено списание оснастки: "+СтрОснастки;
			Тема = Текст;
		КонецЕсли;
		Адресат = Новый  СписокЗначений;
		Адресат.Добавить(ВыборкаМенеджер.Менеджер);
		Адресат.Добавить(ОтветственныйЗаОснастку);
		ОтправитьПисьмо(текст, Тема, Адресат) ;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

Процедура СозданиеЗаказовОснасткиПоЗаказуКлиента(Заказ, СтруктураСНормативом) Экспорт
	УстановитьПривилегированныйРежим(Истина);

	//ОтветственныйЗаОснастку = Лико_Дополнительно.НайтиЭлектронныйАдресОтветственногоПоСкладу(Заказ.Площадка, 
	//	"ЛкАдресДляОтправкиПисемОСозданииЗаявкиНаОснасткуИзЗаказа", "Справочник.Организации", Ложь);
	Если СтруктураСНормативом.Свойство("НормативПробега") = Ложь Тогда
		Возврат;
	Иначе
		Если Не ЗначениеЗаполнено(СтруктураСНормативом.НормативПробега) Тогда
			Возврат;
		КонецЕсли;		
	КонецЕсли;

	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Организация", Заказ.Площадка);
	НайденныеСтроки = СтруктураСНормативом.НормативПробега.ОповещенияПоОрганизации.НайтиСтроки(ПараметрыОтбора);

	ОтветственныйЗаОснастку = Неопределено;
	Для Каждого ТекСтр из НайденныеСтроки Цикл
		ОтветственныйЗаОснастку = ТекСтр.Адресат;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ОтветственныйЗаОснастку) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказКлиентаВидыРабот.Оснастка КАК Оснастка,
	|	ЗаказКлиентаВидыРабот.ВидРабот КАК ВидРабот,
	|	ЗаказКлиентаВидыРабот.Ссылка КАК Заказ
	|ПОМЕСТИТЬ ВТЗаказ
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ
	|	И ЗаказКлиентаВидыРабот.ВидРабот = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Вырубка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаВидыРабот.ВидРабот,
	|	ЗаказКлиентаВидыРабот.Ссылка,
	|	ЗаказКлиентаВидыРабот.Оснастка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЗаказ.Заказ КАК Заказ,
	|	ВТЗаказ.Оснастка КАК Оснастка,
	|	СУММА(ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.МетражДляРЦ, 0)) КАК Метраж,
	|	ВТЗаказ.Заказ.ШагПечати КАК ШагПечати,
	|	ВТЗаказ.Заказ.Z КАК Z,
	|	Лико_ЗаказыНаОснасткуСрезПоследних.ЗаказНаОснастку КАК ЗаказНаОснастку,
	|	ВТЗаказ.ВидРабот КАК ВидРабот
	|ПОМЕСТИТЬ ВТПлан
	|ИЗ
	|	ВТЗаказ КАК ВТЗаказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|		ПО ВТЗаказ.Заказ = Лико_ПараметрыПроизводстваЗаказа.Заказ
	|			И ВТЗаказ.Заказ.РабочийЦентр = Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр
	|			И (Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1)
	|			И (ВТЗаказ.Заказ.Состояние = ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаказов.ВключенВПлан))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЗаказыНаОснастку.СрезПоследних КАК Лико_ЗаказыНаОснасткуСрезПоследних
	|		ПО ВТЗаказ.Оснастка = Лико_ЗаказыНаОснасткуСрезПоследних.Номенклатура
	|			И (Лико_ЗаказыНаОснасткуСрезПоследних.Статус <> ЗНАЧЕНИЕ(Перечисление.Лико_СтатусыЗаказовНаОснастку.Поступил))
	|			И (Лико_ЗаказыНаОснасткуСрезПоследних.Статус <> ЗНАЧЕНИЕ(Перечисление.Лико_СтатусыЗаказовНаОснастку.Отменен))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТЗаказ.Заказ,
	|	ВТЗаказ.Заказ.ШагПечати,
	|	ВТЗаказ.Заказ.Z,
	|	Лико_ЗаказыНаОснасткуСрезПоследних.ЗаказНаОснастку,
	|	ВТЗаказ.Оснастка,
	|	ВТЗаказ.ВидРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПлан.Оснастка КАК Оснастка,
	|	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры КАК СерияЯССМ_ОбъектНоменклатуры,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК КоличествоОстаток,
	|	Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбщаяНаработка КАК ОбщаяНаработка,
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА ВТПлан.Z <> ЗНАЧЕНИЕ(Справочник.Лико_ZКоличествоЗубьев.ПустаяСсылка)
	|				ТОГДА Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбщаяНаработка / (ВТПлан.Z.КоличествоЗубьев * 3.175 / 1000)
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ВТПлан.ШагПечати <> 0
	|						ТОГДА Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбщаяНаработка / ВТПлан.ШагПечати
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		КОНЕЦ КАК ЧИСЛО(15, 0)) КАК КоличествоУдаровФакт
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	ВТПлан КАК ВТПлан
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки КАК ТоварыВЯчейкахОстатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_НаработкиОбъектовНоменклатуры.СрезПоследних КАК Лико_НаработкиОбъектовНоменклатурыСрезПоследних
	|			ПО ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры = Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбъектНоменклатуры
	|		ПО ВТПлан.Оснастка = ТоварыВЯчейкахОстатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОстатки.Оснастка КАК Оснастка,
	|	СУММА(ВТОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	|	СУММА(ВТОстатки.КоличествоУдаровФакт) КАК КоличествоУдаровФакт
	|ПОМЕСТИТЬ ВТОстаткиИтог
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТОстатки.Оснастка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПлан.Оснастка КАК Оснастка,
	|	ВТПлан.Оснастка.Артикул КАК Артикул,
	|	ВТПлан.ВидРабот КАК ВидРабот,
	|	ВТПлан.Заказ КАК Заказ,
	|	ВТПлан.Заказ.Менеджер КАК Менеджер,
	|	ЕСТЬNULL(ВТОстаткиИтог.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(ВТОстаткиИтог.КоличествоУдаровФакт, 0) КАК КоличествоУдаровФакт,
	|	ВТПлан.ЗаказНаОснастку КАК ЗаказНаОснастку,
	|	ВТПлан.Заказ.Этикетки КАК Этикетки,
	|	ВЫБОР
	|		КОГДА ВТПлан.ЗаказНаОснастку ЕСТЬ NULL
	|				И (ВТОстаткиИтог.КоличествоОстаток ЕСТЬ NULL
	|					ИЛИ (ВЫРАЗИТЬ(ВЫБОР
	|							КОГДА ВТПлан.Z <> ЗНАЧЕНИЕ(Справочник.Лико_ZКоличествоЗубьев.ПустаяСсылка)
	|								ТОГДА ВТПлан.Метраж / (ВТПлан.Z.КоличествоЗубьев * 3.175 / 1000)
	|							ИНАЧЕ ВЫБОР
	|									КОГДА ВТПлан.ШагПечати <> 0
	|										ТОГДА ВТПлан.Метраж / ВТПлан.ШагПечати
	|									ИНАЧЕ 0
	|								КОНЕЦ
	|						КОНЕЦ КАК ЧИСЛО(15, 0))) + ВТОстаткиИтог.КоличествоУдаровФакт > 3000000)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ТребуетсяЗаказ
	|ИЗ
	|	ВТПлан КАК ВТПлан
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстаткиИтог КАК ВТОстаткиИтог
	|		ПО ВТПлан.Оснастка = ВТОстаткиИтог.Оснастка";

	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать(); 
	ЭтоПервый = Истина;
	текЗаказОснасткиУжеЕсть = Ложь;
	ЗаказНомер = "";
	ЗаказЭтикетки="";
	НомерШтампа="";
	ЗаказКлиент="";
	Артикул="";
	ДокОбъект = Неопределено;
	Пока Выборка.Следующий() Цикл
		ЗаказНомер = Выборка.Заказ.Номер;
		ЗаказЭтикетки = Выборка.Заказ.Этикетки;
	    ЗаказКлиент   = Выборка.Заказ.Партнер;	
		Если Не ЗначениеЗаполнено(Выборка.ЗаказНаОснастку) Тогда 
			Если ЭтоПервый Тогда 
				ДокОбъект = Документы.Лико_ЗаказОснастки.СоздатьДокумент();
				ДокОбъект.Дата = ТекущаяДата();
				ДокОбъект.Площадка = Справочники.Лико_Площадки.Ликофлекс;
				ДокОбъект.Ответственный = Справочники.Пользователи.НайтиПоНаименованию("Robot 1C");
				ДокОбъект.Комментарий = "Документ создан автоматически при отправки в работу заказа: " + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Заказ.Номер, Ложь, Ложь);
				ДокОбъект.ВидОперации = Перечисления.Лико_ВидыОперацийЗаказОснастки.Перезаказ;
				ЭтоПервый = Ложь;
			КонецЕсли;
			стр = ДокОбъект.Оснастка.Добавить();
			стр.Номенклатура = Выборка.Оснастка;
		    Артикул=Стр.Номенклатура.Артикул;
			стр.Количество = 1;
			стр.Менеджер = Выборка.Менеджер;
			стр.Заказ = Выборка.Заказ;
			стр.статус = перечисления.Лико_СтатусыЗаказовНаОснастку.Создан;
			стр.ВидШтампа = Выборка.ВидРабот;
			стр.КлючСтроки = Новый УникальныйИдентификатор; 
			Если ЗначениеЗаполнено(Выборка.Заказ) Тогда 
				стртовары = Выборка.Заказ.Товары[0];
				стрэт =  ДокОбъект.Этикетки.Добавить();
				стрэт.этикетка = стртовары.номенклатура;
				стрэт.КлючСтроки = стр.КлючСтроки;
			КонецЕсли;
		Иначе
			текЗаказОснасткиУжеЕсть = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если текЗаказОснасткиУжеЕсть Тогда
		Возврат;
	КонецЕсли;
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);

	НомерДок = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокОбъект.Ссылка.Номер, Ложь, Ложь);
	текст = "ВНИМАНИЕ!!!" + Символы.ПС + "По статистике 80% штампов """ + СтруктураСНормативом.Норматив + """ выходят из строя при пробеге менее " + СтруктураСНормативом.Норматив + " ударов."
	+ Символы.ПС + "Вами выписан заказ N" + ЗаказНомер + ", пробег штампов после печати данного тиража составит " + Формат(СтруктураСНормативом.ОстаточныйРесурс - СтруктураСНормативом.Норматив, "ЧДЦ=2; ЧО=4") + " ударов" + Символы.ПС +
	"Создана заявка на оснастку N" + НомерДок + ". Этикетка: "+ЗаказЭтикетки+". Для предзаказа штампа заявку необходимо подтвердить.";
	Тема = "Подтвердите или отмените заказ на оснастку N " +НомерДок+ " по заказу N "+ЗаказНомер+", клиент: "+ЗаказКлиент+", штамп: " +Артикул+". Для перезаказа оснастки ";

	Адресат = Новый СписокЗначений;
	Адресат.Добавить(Заказ.Менеджер);
	Адресат.Добавить(ОтветственныйЗаОснастку);
	ОтправитьПисьмо(текст, Тема, Адресат) ;

	УстановитьПривилегированныйРежим(Ложь);	

КонецПроцедуры
	
Процедура ОтметитьВыполнениеЗаказовОснастки(ДокПоступления) Экспорт
	УстановитьПривилегированныйРежим(Истина);	

	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	ПриходныйОрдерНаТоварыТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ПриходныйОрдерНаТоварыТовары.КоличествоУпаковок) КАК Количество,
	|	Лико_ЗаказОснасткиОснастка.Ссылка КАК ЗаказОснастки,
	|	Лико_ЗаказОснасткиОснастка.НомерСтроки КАК НомерСтроки,
	|	ПриходныйОрдерНаТоварыТовары.Номенклатура.Артикул КАК Артикул
	|ИЗ
	|	Документ.ПриходныйОрдерНаТовары.Товары КАК ПриходныйОрдерНаТоварыТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_ЗаказОснастки.Оснастка КАК Лико_ЗаказОснасткиОснастка
	|		ПО ПриходныйОрдерНаТоварыТовары.Номенклатура = Лико_ЗаказОснасткиОснастка.Номенклатура
	|			И (Лико_ЗаказОснасткиОснастка.Ссылка.Дата < ПриходныйОрдерНаТоварыТовары.Ссылка.Дата)
	|			И (Лико_ЗаказОснасткиОснастка.Статус <> ЗНАЧЕНИЕ(Перечисление.Лико_СтатусыЗаказовНаОснастку.Поступил))
	|			И (Лико_ЗаказОснасткиОснастка.Статус <> ЗНАЧЕНИЕ(Перечисление.Лико_СтатусыЗаказовНаОснастку.Отменен))
	|ГДЕ
	|	ПриходныйОрдерНаТоварыТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ПриходныйОрдерНаТоварыТовары.Номенклатура,
	|	Лико_ЗаказОснасткиОснастка.Ссылка,
	|	ПриходныйОрдерНаТоварыТовары.Номенклатура.Артикул,
	|	Лико_ЗаказОснасткиОснастка.НомерСтроки
	|ИТОГИ ПО
	|	Номенклатура";
	Запрос.УстановитьПараметр("Ссылка", ДокПоступления);
	ВыборкаНом = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Номенклатура");
	ОтветственныйЗаОснастку = Справочники.Лико_ПредопределенныеЗначения.ПользовательОтветственныйЗаОснастку.ЗначениеПараметра;

	Пока ВыборкаНом.Следующий() Цикл
		сч = 1;
		Выборка = ВыборкаНом.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если сч = 1 Тогда 
				ДокОбъект = Выборка.ЗаказОснастки.ПолучитьОбъект();
				стр = ДокОбъект.Оснастка[Выборка.НомерСтроки-1];
			//Если стр <>Неопределено Тогда
				стр.статус = Перечисления.Лико_СтатусыЗаказовНаОснастку.Поступил;
				стр.количество = Выборка.Количество;
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Этикетки = "";
				НомерЗаказа = "";
				Если значениеЗаполнено(стр.Заказ) Тогда 
					Этикетки = Стр.Заказ.Этикетки;
					НомерЗаказа = стр.Заказ.НомерБезПрефикса;
				КонецЕсли;
				текст = "Поступил штамп " +Выборка.Артикул+ " для заказа  "+ НомерЗаказа+ " этикетки "+ Этикетки+ " Заказ Оснастки "+ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Выборка.ЗаказОснастки.Номер, Ложь, Ложь);
				Тема = текст;
				Адресат = Новый  СписокЗначений;
				Адресат.Добавить(стр.Менеджер);
				Адресат.Добавить(ОтветственныйЗаОснастку);

				ОтправитьПисьмо(текст, Тема, Адресат) ;
				сч = сч+1;	
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);	

КонецПроцедуры

Процедура ЗаполнитьЦенуОснастки(ДокПоступления) Экспорт
	УстановитьПривилегированныйРежим(Истина);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПриобретениеТоваровУслугТовары.Номенклатура КАК Номенклатура,
	|	ПриобретениеТоваровУслугТовары.Количество КАК Количество,
	|	ПриобретениеТоваровУслугТовары.СуммаСНДС КАК СуммаСНДС,
	|	ПриобретениеТоваровУслугТовары.Ссылка.Валюта КАК Валюта,
	|	ПриобретениеТоваровУслугТовары.Ссылка.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА ПриобретениеТоваровУслугТовары.Ссылка.ЦенаВключаетНДС = ИСТИНА
	|			ТОГДА ПриобретениеТоваровУслугТовары.Цена
	|		ИНАЧЕ ПриобретениеТоваровУслугТовары.СуммаСНДС / ПриобретениеТоваровУслугТовары.Количество
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
	|ГДЕ
	|	ПриобретениеТоваровУслугТовары.Ссылка = &Ссылка
	|	И ПриобретениеТоваровУслугТовары.Номенклатура.ВидНоменклатуры = &Оснастка";
	Запрос.УстановитьПараметр("Ссылка", ДокПоступления);
	Запрос.УстановитьПараметр("Оснастка", Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыОснастка.ЗначениеПараметра);
	Выборка = Запрос.Выполнить().Выбрать();
	ПОка Выборка.Следующий() Цикл
		Запись = РегистрыСведений.Лико_ПараметрыШтампа.СоздатьМенеджерЗаписи();
		Запись.Номенклатура = Выборка.Номенклатура;
		Запись.Прочитать();
		Запись.Номенклатура = Выборка.Номенклатура;
		Если Выборка.Валюта<>Справочники.Валюты.НайтиПоКоду("978") Тогда 
			Цена = Окр(РаботаСКурсамиВалют.ПересчитатьВВалюту(выборка.Цена, Выборка.Валюта,  Справочники.Валюты.НайтиПоКоду("978"), Выборка.Дата),0);
			Запись.Цена = Цена;
		Иначе
			Запись.Цена = Выборка.Цена;
        КонецЕсли;
		Запись.Записать();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);	
КонецПроцедуры

Функция СтоимостьЗаказаДляПередачиМеждуОрганизациями(Заказ, Площадка)   Экспорт
	Стоимость = Заказ.СуммаДокумента;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаВидыРабот.РабочийЦентр КАК РабочийЦентр,
	|	ЗаказКлиентаВидыРабот.НомерПроката КАК НомерПроката,
	|	ЗаказКлиентаВидыРабот.Ссылка КАК Заказ
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот,
	|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ
	|	И ЗаказКлиентаВидыРабот.РабочийЦентр.Лико_Площадка = &Площадка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаВидыРабот.РабочийЦентр,
	|	ЗаказКлиентаВидыРабот.НомерПроката,
	|	ЗаказКлиентаВидыРабот.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.РабочийЦентр КАК РабочийЦентр,
	|	ВТ.НомерПроката КАК НомерПроката,
	|	(ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.ВремяПечати, 0) + ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку, 0)) / 60 * ВТ.РабочийЦентр.Лико_СебестоимостьЧаса КАК СтоимостьРабот,
	|	(ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.ВремяПечати, 0) + ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку, 0)) / 60 КАК Время,
	|	ВТ.РабочийЦентр.Лико_СебестоимостьЧаса КАК РабочийЦентрЛико_СебестоимостьЧаса
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|		ПО ВТ.НомерПроката = Лико_ПараметрыПроизводстваЗаказа.НомерПроката
	|			И ВТ.Заказ = Лико_ПараметрыПроизводстваЗаказа.Заказ
	|ИТОГИ
	|	СУММА(СтоимостьРабот)
	|ПО
	|	ОБЩИЕ";
	Запрос.УстановитьПараметр("Заказ",Заказ);
	Запрос.УстановитьПараметр("Площадка", Площадка);
	Результат = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Общие");
	Результат.Следующий();
	ПроцентУменьшенияЦеныПродажиОкилДляПередач = 6;
	Стоимость = Стоимость*(100 - ПроцентУменьшенияЦеныПродажиОкилДляПередач) / 100;
	Если ЗначениеЗаполнено(Результат.СтоимостьРабот) Тогда
		сообщить(Результат.СтоимостьРабот);
		Стоимость = Стоимость-  Результат.СтоимостьРабот;
	КонецЕсли;

	Возврат Стоимость;

		
КонецФункции

