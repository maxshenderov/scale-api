Функция ПолучитьКоэффициент(Норматив,РабочийЦентр,СложностьЗаказа) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ЗначениеПоказателя, 0) КАК КоэффициентЭкономии
	|ИЗ
	|	Справочник.Лико_ТаблицыДляРасчетаНормативов.РабочиеЦентры КАК Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.ТаблицаПоказателей КАК Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей
	|		ПО Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.Ссылка = Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Ссылка
	|			И Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.НомерВарианта = Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.НомерВарианта
	|ГДЕ
	|	Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.Ссылка = &Норматив
	|	И Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.РабочийЦентр = &РабочийЦентр
	|	И Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель = &Сложность";
	Запрос.УстановитьПараметр("РабочийЦентр", РабочийЦентр);
	Запрос.УстановитьПараметр("Сложность", СложностьЗаказа);
	Запрос.УстановитьПараметр("Норматив", Норматив);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Возврат Результат.КоэффициентЭкономии;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция ПолучитьДифКоэффициент(стр) экспорт

	//Илья Иванов сказал, что считать надо одинаково, письмо от 03.01.2017
	//Если Заказ.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Пробник ИЛИ  Заказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ЦифроваяПроба Тогда 
	//	К =  КоличествоНаименований*(КоличествоЦветовФлексо*1.25+КоличествоЦветовВысокая*1.25+КоличествоЦветовОфсет*1.5+КоличествоЦветовГлубокая*3+КоличествоЦветовИндиго+КоличествоЦветовТрафарет*1.5 +КоличествоТиснений);
	//Иначе
	К =  Окр(sqrt(стр.КоличествоНаименований),2)*(стр.КоличествоЦветовФлексо*1.25+стр.КоличествоЦветовИнкджет*1.25+стр.КоличествоЦветовОфсет*1.5+стр.КоличествоЦветовГлубокая*3+стр.КоличествоЦветовЦифровая+стр.КоличествоЦветовТрафарет*1.5 +стр.КоличествоТиснений+стр.КоличествоКонгревов);		
	//КонецЕсли;	
	Возврат К;
