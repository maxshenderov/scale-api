Функция ПолучитьТаблицуДопМатериалов(Заказ, ГруппаРабот)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаВидыРабот.ВидРабот КАК ВидРабот,
	|	ЗаказКлиентаВидыРабот.Материал КАК Материал,
	|	ЗаказКлиентаВидыРабот.Нарезка КАК Нарезка,
	|	ЗаказКлиентаВидыРабот.ПроцентЗаливки КАК ПроцентЗаливки,
	|	ЗаказКлиентаВидыРабот.Дополнительно КАК Дополнительно,
	|	ЗаказКлиентаВидыРабот.ЭтикетокВПодаче КАК ЭтикетокВПодаче,
	|	ЕСТЬNULL(Лико_ПараметрыШтампа.ЭтикетокНаЛисте, 0) КАК ЭтикетокНаЛисте
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|		ПО ЗаказКлиентаВидыРабот.Оснастка = Лико_ПараметрыШтампа.Номенклатура
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &Ссылка
	|	И ЗаказКлиентаВидыРабот.ВидРабот.Родитель = &ГруппаРабот
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказКлиентаВидыРабот.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Заказ);
	Запрос.УстановитьПараметр("ГруппаРабот", ГруппаРабот);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции


Функция ПолучитьРЦПоПеределам(Ссылка, ПервыйРЦ=Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ссылка", Ссылка);
	Запрос.УстановитьПараметр("ПервыйРЦ", ПервыйРЦ);

	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаЦвета.НомерПроката КАК НомерПроката,
		|	МАКСИМУМ(ЗаказКлиентаЦвета.РабочийЦентр) КАК РЦ
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
		|ГДЕ
		|	ЗаказКлиентаЦвета.Ссылка = &Ссылка
		|	И ВЫБОР
		|			КОГДА &ПервыйРЦ <> НЕОПРЕДЕЛЕНО
		|				ТОГДА ЗаказКлиентаЦвета.НомерПроката <> 1
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаЦвета.НомерПроката
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказКлиентаЦвета.НомерПроката УБЫВ";

	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ПервыйРЦ<> Неопределено Тогда 
	
		стр = ТЗ.Добавить();
		стр.РЦ = ПервыйРЦ;
		стр.НомерПроката = 1;
	КонецЕсли;
	
	Возврат ТЗ;	
		
КонецФункции	

Функция ПолучитьРЦСпецификацииПоПеределам(Ссылка, ПервыйРЦ=Неопределено, НомерВарианта) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ссылка", Ссылка);
	Запрос.УстановитьПараметр("НомерВарианта", НомерВарианта);

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СпецификацииВидыРабот.НомерПроката КАК НомерПроката,
	|	МАКСИМУМ(СпецификацииВидыРабот.РабочийЦентр) КАК РЦ
	|ИЗ
	|	Справочник.Лико_Спецификации.ВидыРабот КАК СпецификацииВидыРабот
	|ГДЕ
	|	СпецификацииВидыРабот.Ссылка = &ссылка
	|	И СпецификацииВидыРабот.НомерВарианта = &НомерВарианта
	|
	|СГРУППИРОВАТЬ ПО
	|	СпецификацииВидыРабот.НомерПроката
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерПроката УБЫВ";
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возврат ТЗ;

КонецФункции	

Функция ПолучитьЗначениеПоказателяПоЦветам(ТаблицаНормативов,РабочийЦентр, ВариантРасчета, КоличествоКликов)
	ЗапросПоКликам = Новый Запрос;
	ЗапросПоКликам.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.НомерВарианта, Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.НомерВарианта) КАК НомерВарианта,
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.Ссылка, Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.Ссылка) КАК Ссылка
	|ПОМЕСТИТЬ Таб
	|ИЗ
	|	Справочник.РабочиеЦентры КАК РабочиеЦентры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.РабочиеЦентры КАК Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры
	|		ПО (Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.Ссылка = &Ссылка)
	|			И РабочиеЦентры.Ссылка = Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.РабочийЦентр
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.РабочиеЦентры КАК Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1
	|		ПО РабочиеЦентры.ВидРабочегоЦентра = Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.РабочийЦентр
	|			И (Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.Ссылка = &Ссылка)
	|ГДЕ
	|	РабочиеЦентры.Ссылка = &РабочийЦентр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.ВариантРасчета, 1) КАК ВариантРасчета
	|ПОМЕСТИТЬ ВариантыРасчета
	|ИЗ
	|	Таб КАК Таб
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.ТаблицаЦветов КАК Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов
	|		ПО Таб.Ссылка = Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.Ссылка
	|			И Таб.НомерВарианта = Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.НомерВарианта
	|			И (Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.ВариантРасчета = &ВариантРасчета)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.ВариантРасчета, 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.КоличествоЦветов) КАК МаксимальныйПоказатель
	|ПОМЕСТИТЬ ТабМаксимум
	|ИЗ
	|	Таб КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.ТаблицаЦветов КАК Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВариантыРасчета КАК ВариантыРасчета
	|			ПО Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.ВариантРасчета = ВариантыРасчета.ВариантРасчета
	|		ПО Таб.Ссылка = Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.Ссылка
	|			И Таб.НомерВарианта = Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.НомерВарианта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.ЗначениеПоказателя КАК ЗначениеПоказателя,
	|	ТабМаксимум.МаксимальныйПоказатель КАК МаксимальныйПоказатель
	|ИЗ
	|	Таб КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.ТаблицаЦветов КАК Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВариантыРасчета КАК ВариантыРасчета
	|			ПО Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.ВариантРасчета = ВариантыРасчета.ВариантРасчета
	|		ПО Таб.Ссылка = Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.Ссылка
	|			И Таб.НомерВарианта = Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.НомерВарианта,
	|	ТабМаксимум КАК ТабМаксимум
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &КоличествоКликов <= ТабМаксимум.МаксимальныйПоказатель
	|				ТОГДА Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.КоличествоЦветов = &КоличествоКликов
	|			ИНАЧЕ Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.КоличествоЦветов = ТабМаксимум.МаксимальныйПоказатель
	|		КОНЕЦ";
	ЗапросПоКликам.УстановитьПараметр("РабочийЦентр", РабочийЦентр);
	ЗапросПоКликам.УстановитьПараметр("Ссылка", ТаблицаНормативов);
	ЗапросПоКликам.УстановитьПараметр("ВариантРасчета", ВариантРасчета);
	ЗапросПоКликам.УстановитьПараметр("КоличествоКликов", КоличествоКликов);
	РезультатПоКликам = ЗапросПоКликам.Выполнить().Выбрать();
	РезультатПоКликам.Следующий();
	Если ЗначениеЗаполнено(РезультатПоКликам.ЗначениеПОказателя) Тогда 
		Возврат  РезультатПоКликам.ЗначениеПОказателя;
	Иначе 
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьКоличествоСменныхФорм(Ссылка, ИмяТаблицы, НомерПроката, НомерВарианта = 1)   Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(ВложенныйЗапрос.КоличествоФорм - 1, 0)) КАК КоличествоСменныхФорм
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТаблицаЦвета.КлючСтроки КАК КлючСтроки,
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТаблицаФормы.Значение) КАК КоличествоФорм
	|	ИЗ
	|		"+ИмяТаблицы+".Цвета КАК ТаблицаЦвета
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ "+ИмяТаблицы+".Формы КАК ТаблицаФормы
	|			ПО ТаблицаЦвета.Ссылка = ТаблицаФормы.Ссылка
	|				И ТаблицаЦвета.КлючСтроки = ТаблицаФормы.КлючСтроки
	|				И (НЕ ТаблицаФормы.Значение ЕСТЬ NULL)
	|	ГДЕ
	|		ТаблицаЦвета.Ссылка = &Ссылка
	|		И ТаблицаЦвета.НомерПроката = &НомерПроката
	|		И ТаблицаЦвета.НомерВарианта = &НомерВарианта
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ТаблицаЦвета.КлючСтроки) КАК ВложенныйЗапрос
	|ГДЕ
	|	ВложенныйЗапрос.КоличествоФорм > 1" ;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);
	Запрос.УстановитьПараметр("НомерВарианта", НомерВарианта);

	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Если Не ЗначениеЗаполнено(Результат.КоличествоСменныхФорм) Тогда 
		Возврат 0;
	Иначе
		Возврат Результат.КоличествоСменныхФорм;
	КонецЕсли;	
	
КонецФункции

Функция ВремяНаУстановкуРоликов(Заказ, МетражПМ, РабочийЦентр,ЗапросНормативы, ТабПоказатели, ВариантРасчета = 2) Экспорт
	//Определяем длины роликов
	//4 Длина ролика	
	ДлинаРолика = 0; 
	ДлинаРоликаЛаминации=0;
	КоличествоРоликов = 0;
	КоличествоРоликовЛаминации =0;
	КоличествоРоликовХолодногоТиснения =0;
	ОкрДоБольшего = 0.4999;
	ВремяНаУстановкуРоликов = 0;

	
	ЗапросНормативы.УстановитьПараметр("Ссылка", Справочники.Лико_ТаблицыДляРасчетаНормативов.ДлинаРолика);	
	Результат = ЗапросНормативы.Выполнить().Выбрать();
	Результат.Следующий();
	Если ЗначениеЗаполнено(Результат.Норматив) Тогда 
		ДлинаРолика= Результат.Норматив;
		КоличествоРоликов = Окр(((МетражПМ)/ ДлинаРолика +ОкрДоБольшего));
		
	КонецЕсли;	
	стрЛаминаций = ТабПоказатели.Найти(Справочники.Лико_ПараметрыРасчетаНормативов.КоличествоЛаминаций);
	Если стрЛаминаций<>Неопределено Тогда 
		ЗапросНормативы.УстановитьПараметр("Ссылка", Справочники.Лико_ТаблицыДляРасчетаНормативов.ДлинаРоликаЛаминации);	
		Результат = ЗапросНормативы.Выполнить().Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.Норматив) Тогда 
			ДлинаРоликаЛаминации = Результат.Норматив;
			КоличествоРоликовЛаминации = Окр(((МетражПМ)/ ДлинаРоликаЛаминации +ОкрДоБольшего));
			КоличествоРоликовЛаминации =КоличествоРоликовЛаминации*стрЛаминаций.ЗначениеПоказателя;			
		КонецЕсли;
	КонецЕсли;	
	
	стрТиснений = ТабПоказатели.Найти(Справочники.Лико_ПараметрыРасчетаНормативов.КоличествоТиснений);
	
	Если стрТиснений<>Неопределено Тогда 
		Если стрТиснений.ЗначениеПоказателя>0 Тогда 
			Если РабочийЦентр.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Omega И   РабочийЦентр.ПорядковыйНомер <>18 ТОгда
				ДлинаРоликаТиснения = 600;
			Иначе
				ДлинаРоликаТиснения = ДлинаРолика;
			КонецЕсли;
			КоличествоРоликовТиснения = стрТиснений.ЗначениеПоказателя*Окр(((МетражПМ) / ДлинаРоликаТиснения+ ОкрДоБольшего));
			КоличествоРоликов=КоличествоРоликов+ КоличествоРоликовТиснения;
		КонецЕсли;	
	КонецЕсли;	
	
	Если РабочийЦентр.ПорядковыйНомер = 18 ТОгда 
		ВремяНаУстановкуРоликов = ВремяНаУстановкуРоликов+КоличествоРоликов*3;
	Иначе 
		ВремяНаУстановкуРоликов = ВремяНаУстановкуРоликов+КоличествоРоликов*5;
	КонецЕсли;
	
	Если  РабочийЦентр.видрабочегоЦентра =  Справочники.ВидыРабочихЦентров.MO3300  Тогда 
		ВремяНаУстановкуРоликов = ВремяНаУстановкуРоликов+КоличествоРоликовЛаминации*3;
	ИначеЕсли  РабочийЦентр.видрабочегоЦентра =  Справочники.ВидыРабочихЦентров.MPS ИЛИ РабочийЦентр.видрабочегоЦентра =  Справочники.ВидыРабочихЦентров.MPSOfset Тогда 
		ВремяНаУстановкуРоликов = ВремяНаУстановкуРоликов+КоличествоРоликовЛаминации*7;
	Иначе 
		ВремяНаУстановкуРоликов = ВремяНаУстановкуРоликов+КоличествоРоликовЛаминации*5;
	КонецЕсли;	
	
	Возврат ВремяНаУстановкуРоликов;
КонецФункции

Функция ДанныеПоРоликам(Заказ, ИмяТаблицы = "Документ.ЗаказКлиента",  КодЦГ, НомерПроката, НомерВарианта, РабочийЦентр, Метраж) Экспорт

	ДанныеПоРоликам = Новый Структура();
	ДанныеПоРоликам.Вставить("ВремяНаСменуРоликов", 0);
	ДанныеПоРоликам.Вставить("ДлинаРолика", 0);
	
	Запрос = Новый Запрос;	
	#Область ДанныеПоРоликам   
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаВидыРабот.ВидСекции КАК ВидРабот,
	|	ЗаказКлиентаВидыРабот.КоличествоРучьевМатериала КАК КоличествоМатериалов
	|ПОМЕСТИТЬ ВТМатериалы
	|ИЗ
	|	"+ИмяТаблицы+".Цвета КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ
	|	И ЗаказКлиентаВидыРабот.НомерПроката = &НомерПроката
	|	И ЗаказКлиентаВидыРабот.Материал <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
	|	И ЗаказКлиентаВидыРабот.Материал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И ЗаказКлиентаВидыРабот.Материал <> НЕОПРЕДЕЛЕНО
	|	И ЗаказКлиентаВидыРабот.НомерВарианта = &НомерВарианта
	|	И НЕ ЗаказКлиентаВидыРабот.ВидСекции В (ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ГорячееТиснениеПлоское), ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ГорячееТиснениеВРегистрПлоское))
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаВидыРабот.ВидСекции,
	|	ЗаказКлиентаВидыРабот.КоличествоРучьевМатериала
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Основной материал"",
	|	1
	|ИЗ
	|	"+ИмяТаблицы+" КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Ссылка = &Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТМатериалы.КоличествоМатериалов) КАК КоличествоМатериалов
	|ПОМЕСТИТЬ ВТКоличествоМатериалов
	|ИЗ
	|	ВТМатериалы КАК ВТМатериалы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.НомерВарианта, Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.НомерВарианта) КАК НомерВарианта,
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.Ссылка, Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.Ссылка) КАК Ссылка
	|ПОМЕСТИТЬ ВТНормативы
	|ИЗ
	|	Справочник.РабочиеЦентры КАК РабочиеЦентры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.РабочиеЦентры КАК Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры
	|		ПО РабочиеЦентры.Ссылка = Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.РабочийЦентр
	|			И (Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.Ссылка = ЗНАЧЕНИЕ(Справочник.Лико_ТаблицыДляРасчетаНормативов.ДлинаРолика))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.РабочиеЦентры КАК Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1
	|		ПО РабочиеЦентры.ВидРабочегоЦентра = Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.РабочийЦентр
	|			И (Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.Ссылка = ЗНАЧЕНИЕ(Справочник.Лико_ТаблицыДляРасчетаНормативов.ДлинаРолика))
	|ГДЕ
	|	РабочиеЦентры.Ссылка = &РабочийЦентр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ЗначениеПоказателя КАК ДлинаРолика
	|ПОМЕСТИТЬ ВТПоУмолчанию
	|ИЗ
	|	ВТНормативы КАК ВТНормативы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.ТаблицаПоказателей КАК Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей
	|		ПО ВТНормативы.Ссылка = Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Ссылка
	|			И ВТНормативы.НомерВарианта = Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.НомерВарианта
	|			И (Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель = ЗНАЧЕНИЕ(Справочник.Лико_ПараметрыРасчетаНормативов.Поправка1С))
	|			И (Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ВариантРасчета = 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&КодЦГ КАК КодЦГ,
	|	ВТКоличествоМатериалов.КоличествоМатериалов КАК КоличествоМатериалов,
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.ЗначениеПоказателя, ВТПОУмолчанию.ДлинаРолика) КАК ДлинаРолика,
	|	5 * ЕСТЬNULL(ВТКоличествоМатериалов.КоличествоМатериалов, 0) * (ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА &Метраж / ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.ЗначениеПоказателя, ВТПОУмолчанию.ДлинаРолика) > 1
	|				ТОГДА &Метраж / ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.ЗначениеПоказателя, ВТПОУмолчанию.ДлинаРолика)
	|			ИНАЧЕ 0
	|		КОНЕЦ + 0.4999 КАК ЧИСЛО(15, 0))) КАК ВремяНаСменуРоликов
	|ИЗ
	|	ВТКоличествоМатериалов КАК ВТКоличествоМатериалов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПоУмолчанию КАК ВТПОУмолчанию
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.ТаблицаЦветов КАК Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов
	|		ПО (Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.НомерВарианта В
	|				(ВЫБРАТЬ
	|					ВТНормативы.НомерВарианта КАК НомерВарианта
	|				ИЗ
	|					ВТНормативы КАК ВТНормативы))
	|			И (Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.Ссылка = ЗНАЧЕНИЕ(Справочник.Лико_ТаблицыДляРасчетаНормативов.ДлинаРолика))
	|			И (Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.КоличествоЦветов = &КодЦГ)";
	
	#КонецОбласти
	
	
	
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("КодЦГ", КодЦГ);
	Запрос.УстановитьПараметр("НомерВарианта", НомерВарианта);
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);
	Запрос.УстановитьПараметр("РабочийЦентр", РабочийЦентр);
	Запрос.УстановитьПараметр("Метраж", Метраж);
	РезультатЗапроса  = Запрос.Выполнить();	
	Если Не РезультатЗапроса.Пустой() Тогда
		//Результат = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Общие");
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.ВремяНаСменуРоликов) Тогда 
			ДанныеПоРоликам.ВремяНаСменуРоликов = Результат.ВремяНаСменуРоликов;
			ДанныеПоРоликам.ДлинаРолика = Результат.ДлинаРолика;
		КонецЕсли;	
	КонецЕсли;
	Возврат ДанныеПоРоликам;

КонецФункции


Функция ШтампыСтрокойПоПрокату(Заказ, НомерПроката) Экспорт
	Штампы = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказКлиентаВидыРабот.Оснастка.Артикул КАК ОснасткаАртикул
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ
	|	И ЗаказКлиентаВидыРабот.НомерПроката = &НомерПроката
	|	И ЗаказКлиентаВидыРабот.Оснастка <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Штампы = Штампы + ?(ЗначениеЗаполнено(Штампы), ", ", "")+Выборка.ОснасткаАртикул;	
	КонецЦикла;	
	Возврат Штампы;
КонецФункции

Функция  ПолучитьКоэффициентНалоговВДоходности(Период = Неопределено, Площадка = Неопределено) Экспорт    
	Если Не ЗначениеЗаполнено(Период) Тогда 
		Период = ТекущаяДата();
	КонецЕсли;   
	Если Не ЗначениеЗаполнено(Площадка) Тогда 
		Площадка	 = Справочники.Лико_Площадки.Ликофлекс;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.Лико_ЗначенияКоэффициентовПереноса.СрезПоследних(
	|			&Период,
	|			Коэффициент = ЗНАЧЕНИЕ(Справочник.Лико_КоэффициентыДляРасчетов.КоэффициентНалоговДляДоходности)
	|				И Площадка = &Площадка) КАК Лико_ЗначенияКоэффициентовПереносаСрезПоследних";
	Запрос.УстановитьПараметр("Период", Период); 
	Запрос.УстановитьПараметр("Площадка", Площадка.организация);

	
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Возврат Результат.Значение;
	
КонецФункции

//Рассчет нормативов конкретного заказа, т.к. количество в заказе и спецификации может отличаться
Процедура  РассчитатьСебестоимость_НормативыЗаказа(Ссылка, Отказ = Истина) Экспорт
	НаборЗаписей = РегистрыСведений.Лико_ПараметрыПроизводстваЗаказа.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Заказ.Значение = Ссылка;
	НаборЗаписей.Отбор.Заказ.Использование = Истина;
	НаборЗаписей.Записать();
	
	НаборЗаписейПоказатели = РегистрыСведений.Лико_ПоказателиРасчетаЗаказа.СоздатьНаборЗаписей();
	НаборЗаписейПоказатели.Отбор.Заказ.Значение = Ссылка;
	НаборЗаписейПоказатели.Отбор.Заказ.Использование = Истина;
	НаборЗаписейПоказатели.Записать();
	
	НаборЗаписейЗатраты = РегистрыСведений.Лико_Затраты.СоздатьНаборЗаписей();
	НаборЗаписейЗатраты.Отбор.ЗаказКлиента.Значение = Ссылка;
	НаборЗаписейЗатраты.Отбор.ЗаказКлиента.Использование = Истина;
	НаборЗаписейЗатраты.Записать();

	
	ЗапросПрокаты = Новый Запрос;
	ЗапросПрокаты.текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаВидыРабот.НомерПроката КАК НомерПроката,
	|	ТаблицаВидыРабот.НомерВарианта КАК НомерВарианта
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК ТаблицаВидыРабот
	|ГДЕ
	|	ТаблицаВидыРабот.Ссылка = &Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерВарианта,
	|	НомерПроката";
	ЗапросПрокаты.УстановитьПараметр("Заказ", Ссылка);
	ВыборкаПрокаты = ЗапросПрокаты.Выполнить().Выбрать();
	Пока ВыборкаПрокаты.Следующий() Цикл  
        ЗаполнитьПоказателиДляТаблиц(Ссылка, ВыборкаПрокаты.НомерПроката);			
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст =		
	"ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Ссылка КАК Заказ,
	|	ЗаказКлиентаТовары.Номенклатура.ЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
	|	СУММА(ВЫБОР
	|			КОГДА ЗаказКлиентаТовары.Ссылка.ХолостойХод = ИСТИНА
	|					И ЗаказКлиентаТовары.КоличествоЭтикетокВРолике > 0
	|				ТОГДА ЗаказКлиентаТовары.Количество + ЗаказКлиентаТовары.Количество / ЗаказКлиентаТовары.КоличествоЭтикетокВРолике * ЗаказКлиентаТовары.ДопЭтикетокВРолике
	|			ИНАЧЕ ЗаказКлиентаТовары.Количество
	|		КОНЕЦ) КАК Количество,
	|	СРЕДНЕЕ(ЗаказКлиентаТовары.Цена) КАК Цена,
	|	СУММА(ВЫБОР
	|			КОГДА ЗаказКлиентаТовары.КоличествоЭтикетокВРолике > 0
	|				ТОГДА ЗаказКлиентаТовары.Количество * 1000 / ЗаказКлиентаТовары.КоличествоЭтикетокВРолике
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоРоликов,
	|	СУММА(ВЫБОР
	|			КОГДА ЗаказКлиентаТовары.КоличествоЭтикетокВРолике > 0
	|				ТОГДА ЗаказКлиентаТовары.ДопЭтикетокВРолике * (ЗаказКлиентаТовары.Количество * 1000 / ЗаказКлиентаТовары.КоличествоЭтикетокВРолике)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоДопЭтикеток,
	|	СУММА(ЗаказКлиентаТовары.Цена * ВЫБОР
	|			КОГДА ЗаказКлиентаТовары.Ссылка.ХолостойХод = ИСТИНА
	|					И ЗаказКлиентаТовары.КоличествоЭтикетокВРолике > 0
	|				ТОГДА ЗаказКлиентаТовары.Количество + ЗаказКлиентаТовары.Количество / ЗаказКлиентаТовары.КоличествоЭтикетокВРолике * ЗаказКлиентаТовары.ДопЭтикетокВРолике
	|			ИНАЧЕ ЗаказКлиентаТовары.Количество
	|		КОНЕЦ) КАК Стоимость
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Номенклатура.ЕдиницаИзмерения,
	|	ЗаказКлиентаТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Заказ КАК Заказ,
	|	ВТ.НоменклатураЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
	|	ВТ.Количество КАК Количество,
	|	ВТ.Стоимость / ВТ.Количество КАК Цена,
	|	ВТ.КоличествоРоликов КАК КоличествоРоликов,
	|	ВТ.КоличествоДопЭтикеток КАК КоличествоДопЭтикеток
	|ПОМЕСТИТЬ ВТ2
	|ИЗ
	|	ВТ КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиентаЦвета.Ссылка КАК Заказ,
	|	МАКСИМУМ(ЗаказКлиентаЦвета.РабочийЦентр) КАК РабочийЦентр
	|ПОМЕСТИТЬ ВТПП
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	|ГДЕ
	|	ЗаказКлиентаЦвета.Ссылка = &Заказ
	|	И ЗаказКлиентаЦвета.НомерПроката = 1
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаЦвета.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ2.Заказ КАК Заказ,
	|	ВТ2.НоменклатураЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ВТ2.НоменклатураЕдиницаИзмерения = ТысШт.ЗначениеПараметра
	|			ТОГДА ВТ2.Количество * 1000
	|		КОГДА ВТ2.НоменклатураЕдиницаИзмерения = ПМ.ЗначениеПараметра
	|			ТОГДА ВТ2.Количество
	|		КОГДА ВТ2.НоменклатураЕдиницаИзмерения = КВМ.ЗначениеПараметра
	|			ТОГДА ВТ2.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ВТ2.Заказ.КомиссияЗаТысячу > 0
	|			ТОГДА ВТ2.Цена - ВТ2.Заказ.КомиссияЗаТысячу
	|		ИНАЧЕ ВТ2.Цена
	|	КОНЕЦ КАК Цена,
	|	ВТ2.КоличествоРоликов КАК КоличествоРоликов,
	|	ВТ2.КоличествоДопЭтикеток КАК КоличествоДопЭтикеток,
	|	ВТ2.Заказ.СтоимостьОснастки КАК СтоимостьОснастки,
	|	ВТ2.Заказ.ЭтикетокНаЛисте КАК ЭтикетокНаЛисте,
	|	ВТ2.Заказ.ШагПечати КАК ШагПечати,
	|	ВТ2.Заказ.Нарезка.Размер КАК НарезкаРазмер,
	|	ВТ2.Заказ.Z.КоличествоЗубьев КАК ZКоличествоЗубьев,
	|	ВТПП.РабочийЦентр КАК РабочийЦентр,
	|	ВЫБОР
	|		КОГДА ВТ2.НоменклатураЕдиницаИзмерения = ТысШт.ЗначениеПараметра
	|			ТОГДА ВТ2.Заказ.МетражПМ
	|		КОГДА ВТ2.НоменклатураЕдиницаИзмерения = ПМ.ЗначениеПараметра
	|			ТОГДА ВТ2.Количество
	|		КОГДА ВТ2.НоменклатураЕдиницаИзмерения = КВМ.ЗначениеПараметра
	|			ТОГДА ВТ2.Количество / ВТ2.Заказ.Нарезка.Размер * 1000
	|	КОНЕЦ КАК ПогонныйМетраж,
	|	ВЫБОР
	|		КОГДА ВТ2.НоменклатураЕдиницаИзмерения = ТысШт.ЗначениеПараметра
	|			ТОГДА ВТ2.Заказ.МетражКВМ
	|		КОГДА ВТ2.НоменклатураЕдиницаИзмерения = ПМ.ЗначениеПараметра
	|			ТОГДА ВТ2.Количество * ВТ2.Заказ.Нарезка.Размер / 1000
	|		КОГДА ВТ2.НоменклатураЕдиницаИзмерения = КВМ.ЗначениеПараметра
	|			ТОГДА ВТ2.Количество
	|	КОНЕЦ КАК КвадратныйМетраж,
	|	ВТ2.Количество * ВЫБОР
	|		КОГДА ВТ2.Заказ.КомиссияЗаТысячу > 0
	|			ТОГДА ВТ2.Цена - ВТ2.Заказ.КомиссияЗаТысячу
	|		ИНАЧЕ ВТ2.Цена
	|	КОНЕЦ + ВТ2.Заказ.СтоимостьОснастки КАК СуммаЗаказаРасчет,
	|	ВТ2.Заказ.Нарезка КАК Нарезка
	|ИЗ
	|	ВТ2 КАК ВТ2
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПП КАК ВТПП
	|		ПО ВТ2.Заказ = ВТПП.Заказ,
	|	Справочник.Лико_ПредопределенныеЗначения КАК ТысШт,
	|	Справочник.Лико_ПредопределенныеЗначения КАК ПМ,
	|	Справочник.Лико_ПредопределенныеЗначения КАК КВМ
	|ГДЕ
	|	ТысШт.ИмяПредопределенныхДанных = ""ЕИТысШт""
	|	И ПМ.ИмяПредопределенныхДанных = ""ЕИПогМетр""
	|	И КВМ.ИмяПредопределенныхДанных = ""ЕИКвадрМетр""";


	Запрос.УстановитьПараметр("Заказ", Ссылка);
	Выборка=Запрос.Выполнить().Выбрать();
	ПОка Выборка.Следующий() Цикл
		РассчитатьЗаказПоРЦ(Ссылка, Выборка, Отказ);
		Если Отказ Тогда 
			Возврат;
		КонецЕсли;
		ЗаполнитьНормоЧасы(Ссылка);

	КонецЦикла;
	//НаборЗаписейЗатраты.Записать();
	Отказ = Ложь;
КонецПроцедуры

Процедура  РассчитатьСебестоимость_НормативыКомбинированногоЗаказа(Ссылка, Отказ = Истина) Экспорт
