	|	ЗаказКлиентаТовары.Характеристика,
	|	ЗаказКлиентаТовары.Упаковка,
	|	ЗаказКлиентаТовары.КоличествоУпаковок,
	|	ЗаказКлиентаТовары.Количество,
	|	ЗаказКлиентаТовары.Ссылка.Склад
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ";
	ЗапросТовары.УстановитьПараметр("Заказ", ЗаказКлиента);
	ВыборкаТовары = ЗапросТовары.Выполнить().Выбрать();
	Пока ВЫборкаТовары.Следующий() Цикл
		стрпродукция = ЗаказПр.продукция.Добавить();
		ЗаполнитьЗначенияСвойств(стрПродукция, выборкатовары);
		Если ЗначениеЗаполнено(ЗаказДавальца) Тогда 
			стрпродукция.назначение = ЗаказДавальца.Назначение;			
		КонецЕсли;
	КонецЦикла;
	
	ЗаказПр.Статус = Перечисления.СтатусыЗаказовНаПроизводство2_2.КПроизводству;
	ЗаказПр.РазмещениеВыпуска = Перечисления.СпособыПривязкиОперацийПроизводства.КНачалу;
	
	Попытка 
		ЗаказПр.записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось провести заказ на производство. Заказ не отправлен в работу. " + ОписаниеОшибки());
