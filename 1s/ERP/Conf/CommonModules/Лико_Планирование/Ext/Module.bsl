Функция СоздатьПеределкуНаСервере(Заказ) Экспорт
	
	Переделка = 1;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(ЗаказКлиентаЦветоделение.Переделка) КАК Переделка,
	|	ЗаказКлиентаЦветоделение.Ссылка КАК Заказ
	|ИЗ
	|	Документ.ЗаказКлиента.Цветоделение КАК ЗаказКлиентаЦветоделение
	|ГДЕ
	|	ЗаказКлиентаЦветоделение.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаЦветоделение.Ссылка";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.Переделка) Тогда 
			Переделка = Переделка +Результат.Переделка;
		КонецЕсли;
	КонецЕсли;
	ЗаказОбъект = Заказ.ПолучитьОбъект();
	// --> Начало Лико Субботин 29.03.2023 
	Если ЗаказОбъект.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПолныйПовтор Тогда
		ЗаказОбъект.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПовторСИзменением;
	КонецЕсли;
	// <-- Конец Лико Субботин 29.03.2023 
	
	стрЦв = ЗаказОбъект.Цветоделение.Добавить();
	стрЦв.Ключстроки = Новый УникальныйИдентификатор;
	стрЦв.Переделка = Переделка;
	стрцв.ДатаЗаявки = ТекущаяДата();
	стрцв.АвторПеределки = Пользователи.ТекущийПользователь().ФизическоеЛицо;
	ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Возврат стрЦв.Ключстроки;
	
КонецФункции

Процедура ПроверитьЗаполнениеПараметровШтампа(Работы) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Работы.ВидРабот КАК ВидРабот,
	|	Работы.Оснастка КАК Оснастка,
	|	Работы.Дополнительно КАК Подача,
	|	Работы.ЭтикетокВПодаче КАК ЭтикетокВПодаче
	|ПОМЕСТИТЬ ВТРаботы
	|ИЗ
	|	&Работы КАК Работы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРаботы.Оснастка КАК Оснастка,
	|	Лико_ПараметрыШтампа.ЭтикетокВПодаче КАК ЭтикетокВПодаче,
	|	Лико_ПараметрыШтампа.Подача КАК Подача
	|ИЗ
	|	ВТРаботы КАК ВТРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|		ПО ВТРаботы.Оснастка = Лико_ПараметрыШтампа.Номенклатура
	|ГДЕ
	|	(ВТРаботы.ВидРабот = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПродольное)
	|			ИЛИ ВТРаботы.ВидРабот = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПоперечное))
	|	И ВТРаботы.Оснастка <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Работы", Работы);
	Выборка = Запрос.Выполнить().Выбрать();
	Текст = "";
	Пока Выборка.Следующий() Цикл
		Если Не (ЗначениеЗаполнено(Выборка.Подача) И ЗначениеЗаполнено(Выборка.ЭтикетокВПодаче)) Тогда 
			Текст = Текст+ " "+Выборка.Оснастка.Артикул;
		КонецЕсли;		
	КонецЦикла;
	Если ЗначениеЗаполнено(Текст) Тогда 
		Текст= "Не заполнены параметры штампа тиснения (подача, этикеток в подаче) для штампов: "+Текст;
		Тема = Текст;
		Адресат = Справочники.Лико_ПредопределенныеЗначения.ПользовательОтветственныйЗаОснастку.ЗначениеПараметра;
		ОтправитьПисьмо(текст, Тема, Адресат) ;
	КонецЕсли;
	
КонецПроцедуры

