Функция СтоимостьМатериалаЗаказа(Заказ) Экспорт
	Цена = 0;
	Если ЗначениеЗаполнено(Заказ) Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ЕСТЬNULL(Лико_ПараметрыПроизводстваЗаказа.Себестоимость, 0)) КАК Себестоимость
		|ИЗ
		|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
		|ГДЕ
		|	Лико_ПараметрыПроизводстваЗаказа.Заказ = &Заказ
		|	И Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1";
		Запрос.УстановитьПараметр("Заказ", Заказ);
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() ТОгда 
			Результат = РезультатЗапроса.Выбрать();
			Результат.Следующий();
			Цена = Результат.Себестоимость;
		КонецЕсли;
	КонецЕсли;	
	Возврат Цена;
КонецФункции


Функция РассчитатьЗатратыПоРЦ(Ссылка,РабочийЦентр, Количество, Расч_Квм, СуммаЗаказаРасчет = 0, ВсегоКликов, МойкаСекций, ЗатратыНаОснастку, ПараметрыШтампа, НомерВарианта=1) Экспорт	
	//Затраты записываем в регистр накопления Лико_Затраты
	УстановитьПривилегированныйРежим(Истина);
	
	Площадка = ссылка.Площадка.Организация; 
	ПлощадкаЛикофлекс = Справочники.Лико_Площадки.Ликофлекс.Организация;
