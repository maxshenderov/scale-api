	НаборЗаписейЗатраты.Отбор.ЗаказКлиента.Значение = Ссылка;
	НаборЗаписейЗатраты.Отбор.ЗаказКлиента.Использование = Истина;
	НаборЗаписейЗатраты.Записать();

	
	ЗапросПрокаты = Новый Запрос;
	ЗапросПрокаты.текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаЦвета.НомерПроката КАК НомерПроката,
	|	ТаблицаЦвета.НомерВарианта КАК НомерВарианта
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК ТаблицаЦвета
	|ГДЕ
	|	ТаблицаЦвета.Ссылка = &Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерВарианта,
	|	НомерПроката";
	ЗапросПрокаты.УстановитьПараметр("Заказ", Ссылка);
	ВыборкаПрокаты = ЗапросПрокаты.Выполнить().Выбрать();
	Пока ВыборкаПрокаты.Следующий() Цикл
		ЗаполнитьПоказателиДляТаблиц(Ссылка, ВыборкаПрокаты.НомерПроката);	
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Ссылка КАК Заказ,
	|	ЗаказКлиентаТовары.Номенклатура.ЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
	|	СУММА(ВЫБОР
	|			КОГДА ЗаказКлиентаТовары.Ссылка.ХолостойХод = ИСТИНА
	|				ТОГДА ЗаказКлиентаТовары.Количество + ЗаказКлиентаТовары.Количество * 1000 / ЗаказКлиентаТовары.КоличествоЭтикетокВРолике * ЗаказКлиентаТовары.ДопЭтикетокВРолике
	|			ИНАЧЕ ЗаказКлиентаТовары.Количество
	|		КОНЕЦ) КАК Количество,
	|	СРЕДНЕЕ(ЗаказКлиентаТовары.Цена) КАК Цена,
	|	СУММА(ВЫБОР
	|			КОГДА ЗаказКлиентаТовары.КоличествоЭтикетокВРолике > 0
	|				ТОГДА ЗаказКлиентаТовары.Количество * 1000 / ЗаказКлиентаТовары.КоличествоЭтикетокВРолике
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоРоликов,
	|	СУММА(ВЫБОР
	|			КОГДА ЗаказКлиентаТовары.КоличествоЭтикетокВРолике > 0
	|				ТОГДА ЗаказКлиентаТовары.ДопЭтикетокВРолике * (ЗаказКлиентаТовары.Количество * 1000 / ЗаказКлиентаТовары.КоличествоЭтикетокВРолике)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоДопЭтикеток
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Номенклатура.ЕдиницаИзмерения,
	|	ЗаказКлиентаТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиентаЦвета.Ссылка КАК Заказ,
	|	МАКСИМУМ(ЗаказКлиентаЦвета.РабочийЦентр) КАК РабочийЦентр
	|ПОМЕСТИТЬ ВТПП
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	|ГДЕ
	|	ЗаказКлиентаЦвета.Ссылка = &Заказ
	|	И ЗаказКлиентаЦвета.НомерПроката = 1
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаЦвета.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Заказ КАК Заказ,
	|	ВТ.НоменклатураЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВЫБОР
	|		КОГДА ВТ.НоменклатураЕдиницаИзмерения = ТысШт.ЗначениеПараметра
	|			ТОГДА ВТ.Количество * 1000
	|		КОГДА ВТ.НоменклатураЕдиницаИзмерения = ПМ.ЗначениеПараметра
	|			ТОГДА ВТ.Количество
	|		КОГДА ВТ.НоменклатураЕдиницаИзмерения = КВМ.ЗначениеПараметра
	|			ТОГДА ВТ.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ВТ.Заказ.КомиссияЗаТысячу > 0
	|			ТОГДА ВТ.Цена - ВТ.Заказ.КомиссияЗаТысячу
	|		ИНАЧЕ ВТ.Цена
	|	КОНЕЦ КАК Цена,
	|	ВТ.КоличествоРоликов КАК КоличествоРоликов,
	|	ВТ.КоличествоДопЭтикеток КАК КоличествоДопЭтикеток,
	|	ВТ.Заказ.СтоимостьОснастки КАК СтоимостьОснастки,
	|	ВТ.Заказ.ЭтикетокНаЛисте КАК ЭтикетокНаЛисте,
	|	ВТ.Заказ.ШагПечати КАК ШагПечати,
	|	ВТ.Заказ.Нарезка.Размер КАК НарезкаРазмер,
	|	ВТ.Заказ.Z.КоличествоЗубьев КАК ZКоличествоЗубьев,
	|	ВЫБОР
	|		КОГДА ВТ.НоменклатураЕдиницаИзмерения = ТысШт.ЗначениеПараметра
	|			ТОГДА ВТ.Заказ.МетражПМ
	|		КОГДА ВТ.НоменклатураЕдиницаИзмерения = ПМ.ЗначениеПараметра
	|			ТОГДА ВТ.Количество
	|		КОГДА ВТ.НоменклатураЕдиницаИзмерения = КВМ.ЗначениеПараметра
	|			ТОГДА ВТ.Количество / ВТ.Заказ.Нарезка.Размер * 1000
	|	КОНЕЦ КАК ПогонныйМетраж,
	|	ВЫБОР
	|		КОГДА ВТ.НоменклатураЕдиницаИзмерения = ТысШт.ЗначениеПараметра
	|			ТОГДА ВТ.Заказ.МетражКВМ
	|		КОГДА ВТ.НоменклатураЕдиницаИзмерения = ПМ.ЗначениеПараметра
	|			ТОГДА ВТ.Количество * ВТ.Заказ.Нарезка.Размер / 1000
	|		КОГДА ВТ.НоменклатураЕдиницаИзмерения = КВМ.ЗначениеПараметра
	|			ТОГДА ВТ.Количество
	|	КОНЕЦ КАК КвадратныйМетраж,
	|	ВТ.Количество * ВЫБОР
	|		КОГДА ВТ.Заказ.КомиссияЗаТысячу > 0
	|			ТОГДА ВТ.Цена - ВТ.Заказ.КомиссияЗаТысячу
	|		ИНАЧЕ ВТ.Цена
	|	КОНЕЦ + ВТ.Заказ.СтоимостьОснастки КАК СуммаЗаказаРасчет,
	|	ВТ.Заказ.Нарезка КАК Нарезка,
	|	ВТПП.РабочийЦентр КАК РабочийЦентр
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПП КАК ВТПП
	|		ПО ВТ.Заказ = ВТПП.Заказ,
	|	Справочник.Лико_ПредопределенныеЗначения КАК ТысШт,
	|	Справочник.Лико_ПредопределенныеЗначения КАК ПМ,
	|	Справочник.Лико_ПредопределенныеЗначения КАК КВМ
	|ГДЕ
	|	ТысШт.ИмяПредопределенныхДанных = ""ЕИТысШт""
	|	И ПМ.ИмяПредопределенныхДанных = ""ЕИПогМетр""
	|	И КВМ.ИмяПредопределенныхДанных = ""ЕИКвадрМетр""";
	Запрос.УстановитьПараметр("Заказ", Ссылка);
	Выборка=Запрос.Выполнить().Выбрать();
	ПОка Выборка.Следующий() Цикл
		РассчитатьКомбинированныйЗаказПоРЦ(Ссылка, Выборка, Отказ);
		Если Отказ Тогда 
			Возврат;
		КонецЕсли;
	КонецЦикла;
	//НаборЗаписейЗатраты.Записать();
	Отказ = Ложь;
КонецПроцедуры


Процедура РассчитатьЗаказПоРЦ(Заказ, Выборка, Отказ = Истина) Экспорт
	МетровВсегоОсн=0;
	//Стоимость новых штампов и клише
	Ст_Шт_Клише =Выборка.СтоимостьОснастки;
	ТаблицаРЦ = ПолучитьРЦПоПеределам(Заказ, Выборка.РабочийЦентр);	
	МетрыНаБрак = 0;
	МетрыНаНастройку = 0; 
	МойкаСекций = 0;
	ОбщееВремяВыполненияЗаказа =0;
	ВремяЗаказаДляДоходности = 0;
	ВремяОсновнойМашины = 0;
	ЗатратыНаМатериалы = 0;
	ВремяВыполненияНФ_119=0;
	ЗатратыНаОснастку = 0;
	ВсегоКликов = 0;
	КоэффициентВремениДоходности = 1;
	СтоимостьРаботРЦ = 0;   
	
	//К_Дох = 0.915;   
	//с 2019 меняем
	//К_Дох = 0.91;
	//15.08.2022 - меняем на 0.87 с 1 января 2022
	//Добавляем в справочник Лико_КоэффициентыДляРасчета и храним в регистре
	К_Дох = ПолучитьКоэффициентНалоговВДоходности(ТекущаяДата(), Заказ.Площадка);
	
	
	//		ПоказателиПоЗаказу = Новый Соответствие; //собираем показатели по всем машинам
	Для каждого ТекРЦ из ТаблицаРЦ Цикл 
		НормативыДляРЦ= РассчитатьНормативыДляРЦ(Заказ, Выборка.ПогонныйМетраж, ТекРЦ.РЦ, МетрыНаБрак, МетрыНаНастройку, текРЦ.НомерПроката, Выборка.Количество);
		Если ТипЗнч(НормативыДляРЦ) <>Тип("Строка") Тогда
			//				ЗаполнитьПоказателиПоЗаказу(ПоказателиПоЗаказу, НормативыДляРЦ.ПоказателиДляТаблиц);
			стрНормативы =РегистрыСведений.Лико_ПараметрыПроизводстваЗаказа.СоздатьМенеджерЗаписи();
			стрНормативы.Заказ = Заказ;
			стрНормативы.НомерПроката = текРЦ.НомерПроката;
			стрНормативы.РабочийЦентр = ТекРЦ.РЦ;
			стрНормативы.Нарезка = Выборка.Нарезка;
			//				
			МетрыНаБрак = МетрыНаБрак +НормативыДляРЦ.МетрыНаБрак;
			МетрыНаНастройку = МетрыНаНастройку+НормативыДляРЦ.МетрыНаНастройку;
			МойкаСекций = МойкаСекций+НормативыДляРЦ.МойкаСекций;
			Если текРЦ.НомерПроката >1 Тогда 
				Если ЗначениеЗаполнено(ТекРЦ.РЦ.Лико_КоэффициентВремениДоходности) Тогда 
			   					
				//20181213 - не учитываем вторую и последующие машины в любом случае	
				//Иначе
				//	ВремяЗаказаДляДоходности = ВремяЗаказаДляДоходности+НормативыДляРЦ.ВремяВыполненияЗаказа;
				
				//Начало изменений Иванова Анна 20190404 Для расчета доходности по заказам с Шобером, Картесом, НФ, Омегой, Ламинатором, Тотани нужно добавлять 20% от их расчетного времени
					ВремяЗаказаДляДоходности = ВремяЗаказаДляДоходности+НормативыДляРЦ.ВремяВыполненияЗаказа*ТекРЦ.РЦ.Лико_КоэффициентВремениДоходности;
					//Основная машина может быть не первой!!!
					Если  ТекРЦ.РЦ.Лико_КоэффициентВремениДоходности = 1 ТОгда 
						ВремяОсновнойМашины =  ВремяОсновнойМашины+ НормативыДляРЦ.ВремяВыполненияЗаказа*ТекРЦ.РЦ.Лико_КоэффициентВремениДоходности;
					КонецЕсли;
				КонецЕсли;
			  					
		
					Если ЗначениеЗаполнено(ТекРЦ.РЦ.Лико_СебестоимостьЧаса) ТОгда 
						Если ЗначениеЗаполнено(НормативыДляРЦ.ВремяВыполненияЗаказа) Тогда
							стоимостьРаботРЦ = стоимостьРаботРЦ+ТекРЦ.РЦ.Лико_СебестоимостьЧаса* НормативыДляРЦ.ВремяВыполненияЗаказа/60;
							стрНормативы.Себестоимость =  стоимостьРаботРЦ;
						КонецЕсли;	
					КонецЕсли;
				
			Иначе
				Если ЗначениеЗаполнено(ВремяОсновнойМашины ) ТОгда 
					ВремяЗаказаДляДоходности = ВремяЗаказаДляДоходности +  НормативыДляРЦ.ВремяВыполненияЗаказа*ТекРЦ.РЦ.Лико_КоэффициентВремениДоходности;						
				Иначе	
					ВремяЗаказаДляДоходности = ВремяЗаказаДляДоходности +  НормативыДляРЦ.ВремяВыполненияЗаказа;
				КонецЕсли;	
			КонецЕсли;
			
			
			//Если (ТекРЦ.РЦ.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Omega ИЛИ ТекРЦ.РЦ.ВидРабочегоЦентра =Справочники.ВидыРабочихЦентров.Cartes) И Не ТекРЦ.РЦ.ПорядковыйНомер = 18   Тогда
			//	ОбщееВремяВыполненияЗаказа =ОбщееВремяВыполненияЗаказа+НормативыДляРЦ.ВремяВыполненияЗаказа*0.2;
			//ИначеЕсли (ТекРЦ.РЦ.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Omega ИЛИ ТекРЦ.РЦ.ВидРабочегоЦентра =Справочники.ВидыРабочихЦентров.Cartes) И Не ТекРЦ.РЦ.ПорядковыйНомер = 18   Тогда
			//	ОбщееВремяВыполненияЗаказа =ОбщееВремяВыполненияЗаказа+НормативыДляРЦ.ВремяВыполненияЗаказа*0.2;	
			//Иначе
			//	ОбщееВремяВыполненияЗаказа =ОбщееВремяВыполненияЗаказа+НормативыДляРЦ.ВремяВыполненияЗаказа;
			//КонецЕсли;	
			
			стрНормативы.МетрыНаНастройку = НормативыДляРЦ.МетрыНаНастройку;
			стрНормативы.МетрыНаБрак = НормативыДляРЦ.МетрыНаБрак;
			стрНормативы.ВремяПечати = НормативыДляРЦ.ВремяПечати;
			стрНормативы.ВремяНаНастройку = НормативыДляРЦ.ВремяНаНастройку;
			стрНормативы.ВремяНаСменуРоликов = НормативыДляРЦ.ВремяНаСменуРоликов;
			стрНормативы.ДлинаРолика = НормативыДляРЦ.ДлинаРолика;
			стрНормативы.СкоростьПечати = НормативыДляРЦ.СкоростьПечати;
			стрНормативы.МетражДляРЦ = Выборка.ПогонныйМетраж+ МетрыНаБрак+МетрыНаНастройку;
			Если текРЦ.РЦ.ВидРабочегоЦентра= Справочники.ВидыРабочихЦентров.Indigo Тогда 
				ВсегоКликов  =  НормативыДляРЦ.ВсегоКликов;
				стрНормативы.КоличествоКликов = НормативыДляРЦ.ВсегоКликов;
			КонецЕсли; 
			//				//	ВремяВыполненияЗаказаВЧасах = ВремяВыполненияЗаказаВЧасах+НормативыДляРЦ.ВремяПечати+НормативыДляРЦ.ВремяНаНастройку;
			стрНормативы.ПроцентНаБрак = НормативыДляРЦ.ПроцентНаБрак;
			стрНормативы.Штампы = ШтампыСтрокойПоПрокату(Заказ,текРЦ.НомерПроката); 
			Если Заказ.СерийныйЗаказ И Заказ.ПервыйВСерии = Заказ ТОгда 
				стрНормативы.МетрыНаНастройкуСерии = НормативыДляРЦ.МетрыНаНастройкуСерии ;
				стрНормативы.ВремяНаНастройкуСерии = НормативыДляРЦ.ВремяНаНастройкуСерии ;
			КонецЕсли;
			стрНормативы.Записать();
			//Определим и запишем в затраты на материалы по РЦ 
			ЗатратыНаМатериалыПоРЦ = РассчитатьЗатратыНаМатериалыПоРЦ(Заказ, ТекРЦ.НомерПроката, Выборка.Количество, Выборка.ПогонныйМетраж, МетрыНаБрак, МетрыНаНастройку, Выборка.РабочийЦентр, Заказ);
			ЗатратыНаМатериалы = ЗатратыНаМатериалы +  ЗатратыНаМатериалыПоРЦ;
			
		Иначе Сообщить(НормативыДляРЦ);;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	МетровВсего = (МетрыНаБрак+МетрыНаНастройку+Выборка.ПогонныйМетраж )*Выборка.НарезкаРазмер/1000;
	
	//Добавляем Расчет Доходности
	Затраты = 0;
	Если Заказ.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка Тогда 
		Затраты = РассчитатьЗатратыПоРЦ(Заказ,Выборка.РабочийЦентр, Выборка.Количество, МетровВсего,Выборка.СуммаЗаказаРасчет, ВсегоКликов, МойкаСекций,ЗатратыНаОснастку, Заказ );
	КонецЕсли;
	

	//20181213 Иванова
	//Доход = К_Дох*Выборка.СуммаЗаказаРасчет-Затраты;    
	
	//Для заказов Ламинатора для Ликофлекса Доход = стоимости услуги   
	Если Заказ.ГруппировкаДляОтчетов = Справочники.Лико_ГруппировкиОтчетовНаСайте.ИксПакДляЛикофлекс Тогда 
		Доход = К_Дох*Выборка.СуммаЗаказаРасчет;
	Иначе	
		Доход = К_Дох*Выборка.СуммаЗаказаРасчет-Затраты-стоимостьРаботРЦ; 
	КонецЕсли;	
	//Расчет доходности в час
	Если  ВремяЗаказаДляДоходности>0 Тогда
		   //20200625 - Окулов сказал, что \"видимо доходность может быть больше дохода " :)
			//Если ВремяЗаказаДляДоходности>60 Тогда 	
			//	//	Доходность = Окр(Доход/(ОбщееВремяВыполненияЗаказа)*60); //Т.к. время выпонения в минутах
				Доходность = Окр((Доход)/(ВремяЗаказаДляДоходности)*60); 
			//Иначе
			//	Доходность =Доход;	
			//	//КонецЕсли;
			//КонецЕсли;	
	Иначе
		Доходность = 0;
	КонецЕсли;
	
	ПарамПервогоРЦ =РегистрыСведений.Лико_ПараметрыПроизводстваЗаказа.СоздатьМенеджерЗаписи();
	ПарамПервогоРЦ.Заказ = Заказ;
	ПарамПервогоРЦ.НомерПроката = 1;
	ПарамПервогоРЦ.РабочийЦентр = Выборка.РабочийЦентр;
	ПарамПервогоРЦ.Прочитать();
	ПарамПервогоРЦ.Доходность = Доходность;
	ПарамПервогоРЦ.Доход = Доход;
	Если ЗначениеЗаполнено(Выборка.СуммаЗаказаРасчет) Тогда 
		ПарамПервогоРЦ.Рентабельность = Окр(Доход/Выборка.СуммаЗаказаРасчет*100,2);
	КонецЕсли;	
	ПарамПервогоРЦ.Стоимость =Выборка.СуммаЗаказаРасчет;
	ПарамПервогоРЦ.СебеСтоимость =Затраты;
	ПарамПервогоРЦ.Тираж = Выборка.количество/1000;
	ПарамПервогоРЦ.МетражКвМ = Выборка.КвадратныйМетраж;
	ПарамПервогоРЦ.Цена = Выборка.Цена;
	ПарамПервогоРЦ.ЗатратыНаОснастку = ЗатратыНаОснастку;
	ПарамПервогоРЦ.ДатаОценки = ТекущаяДата();
	ПарамПервогоРЦ.Записать();				
	//		КонецЦикла;
	//		//Записшем данные по основному материалу
	//		Если МетровВсегоОсн< МетровВсего Тогда
	//			МетровВсегоОсн=МетровВсего;
	//			НарезкаОснМат =ВыборкаВариант.ШиринаРулона; 
	//		КонецЕсли;	
	Отказ = Ложь;
КонецПроцедуры

Процедура РассчитатьКомбинированныйЗаказПоРЦ(Заказ, Выборка, Отказ = Истина) Экспорт
	МетровВсегоОсн=0;
	//Стоимость новых штампов и клише
	Ст_Шт_Клише =Выборка.СтоимостьОснастки;
	ТаблицаРЦ = ПолучитьРЦПоПеределам(Заказ, Выборка.РабочийЦентр);	
	МетрыНаБрак = 0;
	МетрыНаНастройку = 0; 
	МойкаСекций = 0;
	ОбщееВремяВыполненияЗаказа =0;
	ВремяЗаказаДляДоходности = 0;
	ЗатратыНаМатериалы = 0;
	ЗатратыНаОснастку = 0;
	ВсегоКликов = 0;
	Если Заказ.ЕдиницаИзмеренияЗаказа = Справочники.Лико_ПредопределенныеЗначения.ЕИТысШт.ЗначениеПараметра Тогда 
		КоэффициентЕдИзм = 1000;
	Иначе
		КоэффициентЕдИзм = 1;
	КонецЕсли;
	//		ПоказателиПоЗаказу = Новый Соответствие; //собираем показатели по всем машинам
	Для каждого ТекРЦ из ТаблицаРЦ Цикл 
		НормативыДляРЦ= РассчитатьНормативыДляРЦ(Заказ, Выборка.ПогонныйМетраж, ТекРЦ.РЦ, МетрыНаБрак, МетрыНаНастройку, текРЦ.НомерПроката, Выборка.Количество);
		Если ТипЗнч(НормативыДляРЦ) <>Тип("Строка") Тогда
			//				ЗаполнитьПоказателиПоЗаказу(ПоказателиПоЗаказу, НормативыДляРЦ.ПоказателиДляТаблиц);
			стрНормативы =РегистрыСведений.Лико_ПараметрыПроизводстваЗаказа.СоздатьМенеджерЗаписи();
			стрНормативы.Заказ = Заказ;
			стрНормативы.НомерПроката = текРЦ.НомерПроката;
			стрНормативы.РабочийЦентр = ТекРЦ.РЦ;
			стрНормативы.Нарезка = Выборка.Нарезка;
			//				
			МетрыНаБрак = МетрыНаБрак +НормативыДляРЦ.МетрыНаБрак;
			МетрыНаНастройку = МетрыНаНастройку+НормативыДляРЦ.МетрыНаНастройку;
			МойкаСекций = МойкаСекций+НормативыДляРЦ.МойкаСекций;
			Если  текРЦ.НомерПроката>1 Тогда 
				ВремяЗаказаДляДоходности =ВремяЗаказаДляДоходности+НормативыДляРЦ.ВремяВыполненияЗаказа*ТекРЦ.РЦ.Лико_КоэффициентВремениДоходности;
			Иначе
				ВремяЗаказаДляДоходности =ВремяЗаказаДляДоходности+НормативыДляРЦ.ВремяВыполненияЗаказа;
			КонецЕсли;	
			стрНормативы.МетрыНаНастройку = НормативыДляРЦ.МетрыНаНастройку;
			стрНормативы.МетрыНаБрак = НормативыДляРЦ.МетрыНаБрак;
			стрНормативы.ВремяПечати = НормативыДляРЦ.ВремяПечати;
			стрНормативы.ВремяНаНастройку = НормативыДляРЦ.ВремяНаНастройку;
			стрНормативы.ВремяНаСменуРоликов = НормативыДляРЦ.ВремяНаСменуРоликов;
			стрНормативы.СкоростьПечати = НормативыДляРЦ.СкоростьПечати;
			стрНормативы.МетражДляРЦ = Выборка.ПогонныйМетраж+ МетрыНаБрак+МетрыНаНастройку;
			Если текРЦ.РЦ.ВидРабочегоЦентра= Справочники.ВидыРабочихЦентров.Indigo Тогда 
				ВсегоКликов  =  НормативыДляРЦ.ВсегоКликов;
				стрНормативы.КоличествоКликов = НормативыДляРЦ.ВсегоКликов;
			КонецЕсли; 
			//				//	ВремяВыполненияЗаказаВЧасах = ВремяВыполненияЗаказаВЧасах+НормативыДляРЦ.ВремяПечати+НормативыДляРЦ.ВремяНаНастройку;
			стрНормативы.ПроцентНаБрак = НормативыДляРЦ.ПроцентНаБрак;
			стрНормативы.Штампы = ШтампыСтрокойПоПрокату(Заказ,текРЦ.НомерПроката); 
			стрНормативы.Записать();
			//Определим и запишем в затраты на материалы по РЦ 
			//Для Комбинированного заказа необходимо предварительно уточнить количество этикеток в заказе материала и пересчитать его себестоимость
			ЗапросЗаказыМатериалов = Новый Запрос;
			ЗапросЗаказыМатериалов.текст = 
			"ВЫБРАТЬ
			|	ЗаказКлиентаЦвета.ЗаказМатериала КАК ЗаказМатериала
			|ИЗ
			|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
			|ГДЕ
			|	ЗаказКлиентаЦвета.Ссылка = &Заказ
			|	И ЗаказКлиентаЦвета.НомерПроката = &НомерПроката
			|	И ЗаказКлиентаЦвета.ЗаказМатериала <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)";
			ЗапросЗаказыМатериалов.УстановитьПараметр("Заказ", Заказ);
			ЗапросЗаказыМатериалов.УстановитьПараметр("НомерПроката", ТекРЦ.НомерПроката);

			ВыборкаЗаказыМатериалов = ЗапросЗаказыМатериалов.Выполнить().Выбрать();
			
			//20201222 - если явно не указано, что пересчитывать не надо
			Если Не Заказ.НеПересчитыватьПФ  Тогда 
				Пока ВыборкаЗаказыМатериалов.Следующий() Цикл
					ТиражДляМатериала =   (Выборка.Количество*(1+(МетрыНаБрак+МетрыНаНастройку)/Выборка.ПогонныйМетраж))/КоэффициентЕдИзм ;
					УточнитьКоличествоЭтикетокЗаказа(ВыборкаЗаказыМатериалов.ЗаказМатериала, ТиражДляМатериала);
					РассчитатьСебестоимость_НормативыЗаказа(ВыборкаЗаказыМатериалов.ЗаказМатериала);
				КонецЦикла;
			КонецЕсли;
			ЗатратыНаМатериалыПоРЦ = РассчитатьЗатратыНаМатериалыПоРЦ(Заказ, ТекРЦ.НомерПроката, Выборка.Количество, Выборка.ПогонныйМетраж, МетрыНаБрак, МетрыНаНастройку, Выборка.РабочийЦентр, Заказ);
			ЗатратыНаМатериалы = ЗатратыНаМатериалы +  ЗатратыНаМатериалыПоРЦ;
			
		Иначе Сообщить(НормативыДляРЦ);;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	

	МетровВсего = (МетрыНаБрак+МетрыНаНастройку+Выборка.ПогонныйМетраж )*Выборка.НарезкаРазмер/1000;
	
	//Если заказ комбинированный, необходимо определить количество этикеток для заказа основы
				 //Выборка.Количество*(1+(МетрыНаБрак+МетрыНаНастройку)/Выборка.ПогонныйМетраж);

	ТиражВсего =  (Выборка.Количество*(1+(МетрыНаБрак+МетрыНаНастройку)/Выборка.ПогонныйМетраж))/КоэффициентЕдИзм ;


	
	//20200810 - Иванова Пока убираем
	Если ЗначениеЗаполнено(Заказ.ЗаказОсновногоМатериала) И Не Заказ.НеПересчитыватьПФ Тогда 
	
		УточнитьКоличествоЭтикетокЗаказа(Заказ.ЗаказОсновногоМатериала, ТиражВсего);
		
		Если ЗначениеЗаполнено(Заказ.ЗаказОсновногоМатериала) Тогда 
			РассчитатьСебестоимость_НормативыЗаказа(Заказ.ЗаказОсновногоМатериала);
	    КонецЕсли;
	КонецЕсли;

	//Добавляем Расчет Доходности
	Затраты = РассчитатьЗатратыПоРЦ(Заказ,Выборка.РабочийЦентр, Выборка.Количество, МетровВсего, Выборка.СуммаЗаказаРасчет, ВсегоКликов, МойкаСекций,ЗатратыНаОснастку, Заказ );
	
	//			Затраты = РассчитатьЗатратыПоРЦ(Заказ,ВыбСпецификация.Спецификация,ВыборкаВариант.НомерВарианта, Выборка,НормативыДляРЦ.ПоказателиДляТаблиц,  Количество, МетровВсего,МойкаСекций, ЗатратыНаОснастку);
	//Затраты = Затраты+ЗатратыНаМатериалы;     Затраты на материалы уже включены
	К_Дох = ПолучитьКоэффициентНалоговВДоходности(ТекущаяДата(), Заказ.Площадка);
				
	Доход = К_Дох*Выборка.СуммаЗаказаРасчет-Затраты;
	//Расчет доходности в час
	Если  НормативыДляРЦ.ВремяВыполненияЗаказа>0 Тогда
		Если ВремяЗаказаДляДоходности>0  Тогда 
			Доходность = Окр(Доход/(ВремяЗаказаДляДоходности)*60); //Т.к. время выпонения в минутах
		//Иначе
		//	Доходность =Доход;	
		//КонецЕсли;
		КонецЕсли;
	Иначе
		Доходность = 0;
	КонецЕсли;
	
	ПарамПервогоРЦ =РегистрыСведений.Лико_ПараметрыПроизводстваЗаказа.СоздатьМенеджерЗаписи();
	ПарамПервогоРЦ.Заказ = Заказ;
	ПарамПервогоРЦ.НомерПроката = 1;
	ПарамПервогоРЦ.РабочийЦентр = Выборка.РабочийЦентр;
	ПарамПервогоРЦ.Прочитать();
	ПарамПервогоРЦ.Доходность = Доходность;
	ПарамПервогоРЦ.Доход = Доход;
	Если ЗначениеЗаполнено(Выборка.СуммаЗаказаРасчет) Тогда 
		ПарамПервогоРЦ.Рентабельность = Окр(Доход/Выборка.СуммаЗаказаРасчет*100,2);
	КонецЕсли;	
	ПарамПервогоРЦ.Стоимость =Выборка.СуммаЗаказаРасчет;
	ПарамПервогоРЦ.СебеСтоимость =Затраты;
	ПарамПервогоРЦ.Тираж = Выборка.количество/1000;
	ПарамПервогоРЦ.МетражКвМ = Выборка.КвадратныйМетраж;
	ПарамПервогоРЦ.Цена = Выборка.Цена;
	ПарамПервогоРЦ.ЗатратыНаОснастку = ЗатратыНаОснастку;
	ПарамПервогоРЦ.ДатаОценки = ТекущаяДата();
	ПарамПервогоРЦ.Записать();				
	//		КонецЦикла;
	//		//Записшем данные по основному материалу
	//		Если МетровВсегоОсн< МетровВсего Тогда
	//			МетровВсегоОсн=МетровВсего;
	//			НарезкаОснМат =ВыборкаВариант.ШиринаРулона; 
	//		КонецЕсли;	
	Отказ = Ложь;

КонецПроцедуры

Процедура ЗаполнитьНормоЧасы(Заказ)  Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ КАК Заказ,
	|	СУММА(ВЫБОР
	|			КОГДА Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1
	|				ТОГДА (Лико_ПараметрыПроизводстваЗаказа.ВремяПечати + Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку + Лико_ПараметрыПроизводстваЗаказа.ВремяНаСменуРоликов) * Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр.Лико_КоэффициентУчетаВремени
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Время1РЦ,
	|	СУММА((Лико_ПараметрыПроизводстваЗаказа.ВремяПечати + Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку + Лико_ПараметрыПроизводстваЗаказа.ВремяНаСменуРоликов) * Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр.Лико_КоэффициентУчетаВремени) КАК ВремяУУ,
	|	СУММА(Лико_ПараметрыПроизводстваЗаказа.ВремяПечати + Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку + Лико_ПараметрыПроизводстваЗаказа.ВремяНаСменуРоликов) КАК ВремяИзготовления,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1
	|				ТОГДА Лико_ПараметрыПроизводстваЗаказа.Рентабельность
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Рентабельность,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1
	|				ТОГДА Лико_ПараметрыПроизводстваЗаказа.Доход
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Доход,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1
	|				ТОГДА Лико_ПараметрыПроизводстваЗаказа.Доходность
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Доходность,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1
	|				ТОГДА ВЫБОР
	|						КОГДА Лико_ПараметрыПроизводстваЗаказа.Тираж > 0
	|							ТОГДА Лико_ПараметрыПроизводстваЗаказа.Доход / Лико_ПараметрыПроизводстваЗаказа.Тираж
	|						ИНАЧЕ 0
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ДоходНаЕдПлан,
	|	СУММА(ВЫБОР
	|			КОГДА Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1
	|				ТОГДА Лико_ПараметрыПроизводстваЗаказа.МетражДляРЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК МетражПланПМ,
	|	СУММА(ВЫБОР
	|			КОГДА Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1
	|				ТОГДА ВЫБОР
	|						КОГДА НЕ Лико_ПараметрыПроизводстваЗаказа.Нарезка.Размер ЕСТЬ NULL
	|							ТОГДА Лико_ПараметрыПроизводстваЗаказа.МетражДляРЦ * Лико_ПараметрыПроизводстваЗаказа.Нарезка.Размер / 1000
	|						ИНАЧЕ 0
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК МетражПланКВМ
	|ПОМЕСТИТЬ ВТВремя
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|ГДЕ
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиентаПроизводство.Ссылка КАК Заказ,
	|	СУММА(ЗаказКлиентаПроизводство.ВремяВыполнения * 60 * ЗаказКлиентаПроизводство.РабочийЦентр.Лико_КоэффициентУчетаВремени) КАК ВремяПробников
	|ПОМЕСТИТЬ ВТВремяПробников
	|ИЗ
	|	Документ.ЗаказКлиента.Производство КАК ЗаказКлиентаПроизводство
	|ГДЕ
	|	ЗаказКлиентаПроизводство.ВремяВыполнения <> 0
	|	И ЗаказКлиентаПроизводство.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаПроизводство.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТВремя.Заказ КАК Заказ,
	|	ВЫБОР
	|		КОГДА ВТВремя.Заказ.Тираж < 1
	|			ТОГДА 10
	|		ИНАЧЕ ВЫРАЗИТЬ(ЕСТЬNULL(ВТВремяПробников.ВремяПробников, ВТВремя.Время1РЦ) / ВТВремя.Заказ.Тираж КАК ЧИСЛО(15, 2))
	|	КОНЕЦ КАК Время1РЦ,
	|	ЕСТЬNULL(ВТВремяПробников.ВремяПробников, ВТВремя.ВремяУУ) КАК ВремяУУ,
	|	ВТВремя.ВремяИзготовления КАК ВремяИзготовления,
	|	ВЫБОР
	|		КОГДА ВТВремя.Заказ.Тираж < 1
	|			ТОГДА 10
	|		ИНАЧЕ ВЫРАЗИТЬ(ЕСТЬNULL(ВТВремяПробников.ВремяПробников, ВТВремя.ВремяУУ) / ВТВремя.Заказ.Тираж КАК ЧИСЛО(15, 2))
	|	КОНЕЦ КАК НормоЧасы,
	|	ВТВремя.Рентабельность КАК Рентабельность,
	|	ВТВремя.Доход КАК Доход,
	|	ВТВремя.Доходность КАК Доходность,
	|	ВТВремя.ДоходНаЕдПлан КАК ДоходНаЕдПлан,
	|	ВТВремя.МетражПланПМ КАК МетражПланПМ,
	|	ВТВремя.МетражПланКВМ КАК МетражПланКВМ
	|ИЗ
	|	ВТВремя КАК ВТВремя
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВремяПробников КАК ВТВремяПробников
	|		ПО ВТВремя.Заказ = ВТВремяПробников.Заказ";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	// --> Начало Лико Ефимов ЕВВ 04.08.2023
	ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК = Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК.ЗначениеПараметра;
		// <-- Конец Лико Ефимов ЕВВ 04.08.2023
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		ЗаказОбъект = Заказ.ПолучитьОбъект();
		ЗаказОбъект.ВремяИзготовления = Результат.ВремяИзготовления;
		ЗаказОбъект.ВремяУУ = Результат.ВремяУУ;
		ЗаказОбъект.ВремяИзготовления1РЦ = Результат.Время1РЦ;
		ЗаказОбъект.НормоЧасы = Результат.НормоЧасы;  
		ЗаказОбъект.ДоходПлан = Результат.Доход;
		ЗаказОбъект.РентабельностьПлан = Результат.Рентабельность;
		ЗаказОбъект.ДоходностьПлан = Результат.Доходность;
        ЗаказОбъект.ДоходНаЕдПлан = Результат.ДоходНаЕдПлан;   
		ЗаказОбъект.МетражПланКВМ = Результат.МетражПланКВМ;
        ЗаказОбъект.МетражПланПМ = Результат.МетражПланПМ;

		// --> Начало Лико Яцун 15.11.2022
		Если ЗаказОбъект.ЧестныйЗнак Тогда
			КоличествоЗнаков = 0;
			Для каждого Стр из Заказ.Товары Цикл 
				Если ЗначениеЗаполнено(стр.ЧестныйЗнак) Тогда 
					КоличествоЗнаков = КоличествоЗнаков + Стр.КоличествоУпаковок * 1.1;
				КонецЕсли;
			КонецЦикла;
			КоличествоКодовЧестногоЗнакаПлан = КоличествоЗнаков * ЗаказОбъект.МетражПланКВМ / ЗаказОбъект.МетражКВМ;
			ЗаказОбъект.КоличествоКодовЧестногоЗнакаПлан = КоличествоКодовЧестногоЗнакаПлан;
		КонецЕсли;
		// <-- Конец Лико Яцун 15.11.2022

		Попытка
			ЗаказОбъект.ОбменДанными.Загрузка=Истина;
			ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);	
		Исключение
		
		КонецПопытки;

	КонецЕсли;
	
КонецПроцедуры

Процедура УточнитьКоличествоЭтикетокЗаказа(Заказ, Тираж)
	ВсегоЭт = Заказ.Товары.Итог("Количество");
	Если ВсегоЭт<>Тираж Тогда 
		ЗаказОбъект = Заказ.ПолучитьОбъект();
		Для каждого стр из ЗаказОбъект.Товары Цикл
			стр.Количество =  Тираж *стр.количество/ВсегоЭт;
			стр.количествоУпаковок =  стр.Количество;
			стр.Сумма = стр.цена*стр.количество;
			Если значениеЗаполнено(стр.ставкаНДС) Тогда 
				ТекПроцентНДС = ЦенообразованиеКлиентСервер.ПолучитьСтавкуНДСЧислом(стр.СтавкаНДС);
				стр.суммаНДС = стр.сумма* ТекПроцентНДС;
				стр.СуммаСНДС = стр.Сумма+стр.суммаНДС ;
			КонецЕсли;	
		КонецЦикла;
		Лико_ТиражМетраж.РасчитатьТиражМетраж(ЗаказОбъект) ;
		ЗаказОбъект.Записать();
	КонецЕсли;

КонецПроцедуры		

