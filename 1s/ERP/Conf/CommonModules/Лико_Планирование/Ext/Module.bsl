			Движение.Материал = текстр.Материал;
			Движение.Нарезка = текстр.Нарезка;
			Движение.КвадратныйМетражПлан = текстр.КвадратныйМетражПлан;
			Движение.КвадратныйМетражФакт = текстр.КвадратныйМетражФакт;
			Движение.Перерасход = текстр.Перерасход;
			Движение.Технолог = текстр.Технолог;
			Движение.Причина = текстр.Причина;
			Движение.Заключение = текстр.Заключение;
			Движение.Примечание = текстр.Примечание;
		КонецЦикла;
		НаборЗаписейКартыПерерасхода.Записать();

		//Карты снятия
		Для каждого текстр из Источник.КартаСнятия Цикл
			Движение = НаборЗаписейКартыСнятия.Добавить();
			Движение.Регистратор = ЗаказКлиента;
			Движение.Период = Источник.Дата;
			Движение.ЗаказКлиента = ЗаказКлиента;
			Движение.НомерКарты = текстр.НомерКарты;
			Движение.Смена = текстр.смена;
			Движение.РабочийЦентр = текстр.РабочийЦентр;
			Движение.Печатник = текстр.Печатник;
			Движение.ДатаРаботы = текстр.ДатаСнятия;
			Движение.Материал = текстр.Материал;
			Движение.Нарезка = текстр.Нарезка;
			Движение.КвадратныйМетражФакт = текстр.КвадратныйМетражФакт;
			Движение.Технолог = текстр.Технолог;
			Движение.Причина = текстр.Причина;
			Движение.Заключение = текстр.ЗаключениеТехнолога;
			Движение.Примечание = текстр.Примечание;
		КонецЦикла;
		НаборЗаписейКартыСнятия.Записать();

	КонецЕсли;

	////Заполняем затраты по отгрузке
	//С 2020 года данные об отгрузках пишем в регистр, исключение - Икс-Пак
	Если ЗаказКлиента.Площадка =   Справочники.Лико_Площадки.Ликофлекс  ИЛИ ЗаказКлиента.Площадка =   Справочники.Лико_Площадки.ИксПак Тогда
		НаборЗаписей = РегистрыНакопления.Лико_ЗатратыПоЗаказуДляОтгрузки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ЗаказКлиента);
		НаборЗаписей.Записать();

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|              ЗаказКлиентаОтгрузки.Ссылка КАК Ссылка,
		|              ЗаказКлиентаОтгрузки.КлючСтроки КАК КлючСтроки,
