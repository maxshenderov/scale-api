		|                             КОГДА ЗаказКлиентаЦвета.ВидПечати = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыПечати.Траф)
		|                                             ТОГДА 1
		|                             ИНАЧЕ 0
		|             КОНЕЦ КАК НаличиеТрафаретов
		|ПОМЕСТИТЬ СложностьЦветов
		|ИЗ
		|             Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
		|ГДЕ
		|             ЗаказКлиентаЦвета.Ссылка = &ЗаказКлиента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|             ЕСТЬNULL(СложностьРабот.ЗаказКлиента, СложностьЦветов.ЗаказКлиента) КАК ЗаказКлиента,
		|             СложностьРабот.Тиснение КАК Тиснение,
		|             СложностьРабот.КоличествоЛаминаций КАК КоличествоЛаминаций,
		|             СложностьРабот.ЛаминированиеЖемчужкой КАК ЛаминированиеЖемчужкой,
		|             СложностьРабот.ПечатьСКлеящегоСлоя КАК ПечатьСКлеящегоСлоя,
		|             СложностьЦветов.НаличиеТрафаретов КАК НаличиеТрафаретов,
		|             ВЫБОР
		|                             КОГДА СложностьРабот.Тиснение + СложностьРабот.КоличествоЛаминаций + СложностьРабот.ЛаминированиеЖемчужкой + СложностьРабот.ПечатьСКлеящегоСлоя > 0
		|                                                            ИЛИ СложностьЦветов.НаличиеТрафаретов > 0
		|                                             ТОГДА 1
		|                             ИНАЧЕ 0
		|             КОНЕЦ КАК СложностьЗаказа
		|ИЗ
		|             СложностьРабот КАК СложностьРабот,
		|             СложностьЦветов КАК СложностьЦветов";
		ЗапросСложность.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
		РезультатСложность = ЗапросСложность.Выполнить().Выбрать();
		РезультатСложность.Следующий();
		СложностьЗаказа = РезультатСложность.СложностьЗаказа;

		ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК = Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК.ЗначениеПараметра;
		Если ЗначениеЗаполнено(ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК) И ТекущаяДата() >= ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК И ЗаказКлиента.Дата >= Дата('20230101') Тогда
			СформироватьЗаписиРегистровЗарплатыНовыйМеханизм(ЗаказКлиента, НаборЗаписейВыработкаТиснильщиков, ТипМатериала, НаборЗаписейВыработкаПечатников, СложностьЗаказа, РезультатСложность, НаборЗаписейВыработкаОператоровТУ);		
		Иначе
		//	СформироватьЗаписиРегистровЗарплатыСтарыйМеханизм(ЗаказКлиента, НаборЗаписейВыработкаТиснильщиков, Источник, ТипМатериала, НаборЗаписейВыработкаПечатников, СложностьЗаказа, РезультатСложность, НаборЗаписейВыработкаОператоровТУ);		
		КонецЕсли;

		//Карты перерасхода  
		Для каждого текстр из Источник.КартаПерерасхода Цикл
			Движение = НаборЗаписейКартыПерерасхода.Добавить();
