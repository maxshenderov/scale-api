Функция Connect(ADOConnection, ADOCommand, ADORecordset, ДанныеДляПодключения)
	ОбъектыСозданы = CreateConnection(ADOConnection) И CreateCommand(ADOCommand) И CreateRecordset(ADORecordset);
	
	Возврат_ = Истина;
	
	Если ОбъектыСозданы И ADOConnection.State=0 Тогда
		
		Если InitConnection(ADOConnection, ДанныеДляПодключения) Тогда
		Иначе
			Возврат_ = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Возврат_;
КонецФункции

Функция InitConnection(ADOConnection, ДанныеДляПодключения)
	Возврат_ = Истина;
	
	source__ = "Provider=SQLOLEDB; SERVER=" + СокрЛП(ДанныеДляПодключения.ServerName)       
	+ "; Database=" + СокрЛП(ДанныеДляПодключения.NameDB) + "; ";
	
	ТекстПользователя = "";				
	
	Если ДанныеДляПодключения.Свойство("SQL_Пользователь") Тогда        // nadin 
		source__ = source__ + "Uid=" + СокрЛП(ДанныеДляПодключения.SQL_Пользователь) + ";";
		source__ = source__ + "Pwd=" + СокрЛП(ДанныеДляПодключения.SQL_Пароль) + ";";
		
		ТекстПользователя = "" + ДанныеДляПодключения.SQL_Пользователь;
	Иначе
		source__ = source__ + "Trusted_Connection=Yes;";
		
		ТекстПользователя = "пользователь операционной системы";
	КонецЕсли;
	
	source__ = source__ + "APP=1CGATE;";
	
	ADOConnection.ConnectionString = source__;
	ADOConnection.ConnectionTimeout = ДанныеДляПодключения.ConnectionTimeout;
	ADOConnection.CommandTimeout = ДанныеДляПодключения.CommandTimeout;
	ADOConnection.CursorLocation = 3;
	
	Попытка
		ADOConnection.Open();
	Исключение
		#Если Клиент Тогда
			ЯС_Общие.СообщитьДляКлиента( "Неудачная попытка подключения к серверу (пользователь: " + ТекстПользователя + "): " + ОписаниеОшибки(), СтатусСообщения.Важное);
		#КонецЕсли
		#Если Сервер Тогда
			ЗаписьЖурналаРегистрации("Запросы SQL", УровеньЖурналаРегистрации.Ошибка, , , "Неудачная попытка подключения к серверу (пользователь: " + ТекстПользователя + "): "  + ОписаниеОшибки());
		#КонецЕсли
		Возврат_ = Ложь;
	КонецПопытки;
	
	Возврат Возврат_;
КонецФункции

Процедура ЗакрытьСоединениеССервером(ПараметрыСоединения) экспорт
	ADOCommand = ПараметрыСоединения.ADOCommand;
	ADORecordset = ПараметрыСоединения.ADORecordset;
	ADOConnection = ПараметрыСоединения.ADOConnection;
	
	Если ADORecordset <> Неопределено И ADORecordset.State <> 0 Тогда
		ADORecordset.Close();
	КонецЕсли;
	
	Если ADOCommand <> Неопределено И ADOCommand.State <> 0 Тогда
		ADOCommand.Close();
	КонецЕсли;
	
	Если ADOConnection <> Неопределено И ADOConnection.State <> 0 Тогда
		ADOConnection.Close();
	КонецЕсли;
	
	Попытка
		ADOCommand.УдалитьCOMОбъект();
		ADORecordset.УдалитьCOMОбъект();	
		ADOConnection.УдалитьCOMОбъект();	
	Исключение	
	КонецПопытки;
	
КонецПроцедуры


//Перенос заказов из УПП в ЕРП
Процедура ПеренестиЗаказИзУПП(НомерЗаказа) Экспорт
	УстановитьПривилегированныйРежим(Истина);
    ДатаНачала = ДобавитьМесяц('20100101',Сред(НомерЗаказа, 2,1)*12);
	
	МСоединение = ПолучитьПодключениеКСервернойБД();
    ЗаказУПП = МСоединение.Документы.ЗаказПокупателя.НайтиПоНомеру("ОК00"+ НомерЗаказа, ДатаНачала);
	//НомерВарианта = 1;

	Если Не ЗначениеЗаполнено(ЗаказУПП.Number) Тогда
		ЗаказУПП = МСоединение.Документы.ЗаказПокупателя.НайтиПоНомеру("АВ00"+ НомерЗаказа, ДатаНачала);
		
		Если Не ЗначениеЗаполнено(ЗаказУПП.Number) Тогда
			ЗаказУПП = МСоединение.Документы.ЗаказПокупателя.НайтиПоНомеру("ЭФ00"+ НомерЗаказа, ДатаНачала);
			Если Не ЗначениеЗаполнено(ЗаказУПП.Number) Тогда
				Сообщить("Не найден документ!");
        		Возврат;
			КонецЕсли;	
		КонецЕсли;
	
	КонецЕсли;
	ДокСсылка = Документы.ЗаказКлиента.НайтиПоНомеру( ЗаказУПП.Номер, ЗаказУПП.Дата);
	Если ДокСсылка = Документы.ЗаказКлиента.ПустаяСсылка() Тогда 
		Док = Документы.ЗаказКлиента.СоздатьДокумент();
		Док.Дата = ЗаказУПП.Дата;
		Док.Номер = ЗаказУПП.Номер;
	Иначе
		Док = ДокСсылка.ПолучитьОбъект();
		док.Товары.Очистить();
		Док.цвета.Очистить();
		Док.ВидыРабот.Очистить();
		Док.Формы.Очистить();
	КонецЕсли;
	
	ЗапросУПП = мСоединение.NewObject("Запрос");
	ЗапросУПП.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПокупателяТовары.Ссылка КАК Заказ,
		|	МАКСИМУМ(ЗаказПокупателяТовары.Спецификация) КАК Спецификация,
		|	МАКСИМУМ(ЗаказПокупателяТовары.НомерВарианта) КАК НомерВарианта
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
		|ГДЕ
		|	ЗаказПокупателяТовары.Ссылка.Номер = &Номер
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПокупателяТовары.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Заказ,
		|	МАКСИМУМ(СпецификацииНоменклатурыВидыРабот.РабочийЦентр.Наименование) КАК РЦВырубкиНаименование
		|ПОМЕСТИТЬ ВТВырубка
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры.ВидыРабот КАК СпецификацииНоменклатурыВидыРабот
		|		ПО ВТ.Спецификация = СпецификацииНоменклатурыВидыРабот.Ссылка
		|			И ВТ.НомерВарианта = СпецификацииНоменклатурыВидыРабот.НомерВарианта
		|			И (СпецификацииНоменклатурыВидыРабот.ВидРабот = ЗНАЧЕНИЕ(Справочник.ТехнологическиеОперации.Вырубка))
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ.Заказ
		|;
		|
