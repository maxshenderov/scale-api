Процедура ОчиститьДанныеПоОтгрузке(Док) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаОтгрузки.Ссылка КАК Заказ
	|ИЗ
	|	Документ.ЗаказКлиента.Отгрузки КАК ЗаказКлиентаОтгрузки
	|ГДЕ
	|	ЗаказКлиентаОтгрузки.ДокументОтгрузки = &Док
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаОтгрузки.Ссылка";
	Запрос.УстановитьПараметр("Док", Док);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаказОбъект = Выборка.Заказ.ПолучитьОбъект();
		Отбор = Новый Структура("ДокументОтгрузки", Док);
		МассивСтрок = ЗаказОбъект.Отгрузки.НайтиСтроки(Отбор);
		Для каждого ЭлементМассива Из МассивСтрок Цикл
			УдалитьСтрокиПоКлючу(ЗаказОбъект, ЭлементМассива.КлючСтроки, "Нормативы", "НомерОтгрузки");  
		
			ЗаказОбъект.Отгрузки.Удалить(ЭлементМассива);
		КонецЦикла;
		Попытка
			ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		Исключение
			Отказ = Истина;
			Возврат;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьСтрокиПоКлючу(Объект, КлючСтроки, ИмяТЧ, ИмяКолонки = "КлючСтроки")  
	МассивСтрок =Объект[ИмяТЧ].НайтиСтроки(Новый Структура(ИмяКолонки,  КлючСтроки));
	Для каждого ЭлементМассива Из МассивСтрок Цикл
		Объект[ИмяТЧ].Удалить(ЭлементМассива);
	КонецЦикла;	
КонецПроцедуры

Процедура ОчиститьПустыеОтгрузки(ЗаказОбъект)   Экспорт
	МассивСтрок = Новый Массив;
	Для каждого стр из ЗаказОбъект.Отгрузки Цикл
		Если Не ЗначениеЗаполнено(стр.ДокументОтгрузки) Тогда 
			МассивСтрок.Добавить(стр);
		КонецЕсли;
	КонецЦикла;
	Для каждого ЭлементМассива Из МассивСтрок Цикл
		УдалитьСтрокиПоКлючу(ЗаказОбъект, ЭлементМассива.КлючСтроки, "Нормативы", "НомерОтгрузки");  
		УдалитьСтрокиПоКлючу(ЗаказОбъект, ЭлементМассива.КлючСтроки, "ЗатратыПоОтгрузке", "НомерОтгрузки"); 
		ЗаказОбъект.Отгрузки.Удалить(ЭлементМассива);
	КонецЦикла;
	Попытка
		ЗаказОбъект.Записать();		
	Исключение
		Отказ = Истина;
		Возврат;
	КонецПопытки;
КонецПроцедуры


Процедура ЗаполнениеПараметровОтгрузки(Источник, Отказ) Экспорт
	
	
    УстановитьПривилегированныйРежим(Истина);    
	Если Источник.дата<'20200101' Тогда 
