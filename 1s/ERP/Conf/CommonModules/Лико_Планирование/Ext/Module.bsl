Процедура ЗаполнениеЗатратИзЗакрытиеБланка(Док, Отказ = Ложь) Экспорт
		УстановитьПривилегированныйРежим(Истина);
	//20200407 - не пишем Затраты, только машины
	//20231116 - пишем машины в Цвета
	Запрос = Новый Запрос;
	
	Если ТипЗнч(Док) = Тип("ДокументСсылка.Лико_БланкЭтапа") Тогда 
		Бланк = Док;	
		Если Не ЗначениеЗаполнено(Бланк.ЗаказПокупателя) Тогда 
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_БланкЭтапаТовары.Ссылка.РабочийЦентр КАК РабочийЦентр,
	|	СУММА(Лико_БланкЭтапаТовары.КоличествоРасходУУ) КАК Количество,
	|	Лико_БланкЭтапаТовары.Ссылка.НомерПроката КАК НомерПроката,
	|	Лико_БланкЭтапаТовары.Ссылка.ЗаказПокупателя КАК Заказ
	|ПОМЕСТИТЬ ВТ_Итог
	|ИЗ
	|	Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
	|ГДЕ
	|	Лико_БланкЭтапаТовары.Списать = ИСТИНА
	|	И Лико_БланкЭтапаТовары.Ссылка = &Бланк
	|	И Лико_БланкЭтапаТовары.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Печать)
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_БланкЭтапаТовары.Ссылка.РабочийЦентр,
	|	Лико_БланкЭтапаТовары.Ссылка.НомерПроката,
	|	Лико_БланкЭтапаТовары.Ссылка.ЗаказПокупателя
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Лико_БланкЭтапаТовары.Ссылка.РабочийЦентр,
	|	СУММА(Лико_БланкЭтапаТовары.КоличествоРасходУУ),
	|	Лико_БланкЭтапаТовары.Ссылка.НомерПроката,
	|	Лико_БланкЭтапа.ЗаказПокупателя
	|ИЗ
	|	Документ.Лико_БланкЭтапа КАК Лико_БланкЭтапа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
	|		ПО Лико_БланкЭтапа.Ссылка <> Лико_БланкЭтапаТовары.Ссылка
	|			И Лико_БланкЭтапа.НомерПроката = Лико_БланкЭтапаТовары.Ссылка.НомерПроката
	|			И (Лико_БланкЭтапаТовары.Ссылка.Проведен)
	|			И (Лико_БланкЭтапаТовары.Списать = ИСТИНА)
	|			И (Лико_БланкЭтапаТовары.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Печать))
	|			И Лико_БланкЭтапа.ЗаказПокупателя = Лико_БланкЭтапаТовары.Ссылка.ЗаказПокупателя
	|ГДЕ
	|	Лико_БланкЭтапа.Ссылка = &Бланк
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_БланкЭтапаТовары.Ссылка.РабочийЦентр,
	|	Лико_БланкЭтапаТовары.Ссылка.НомерПроката,
	|	Лико_БланкЭтапа.ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	СУММА(ВТ_Итог.Количество) КАК Количество,
	|	ВТ_Итог.РабочийЦентр КАК РабочийЦентр,
	|	ВТ_Итог.НомерПроката КАК НомерПроката,
	|	ВТ_Итог.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВТ_ОсновнойМатериал
	|ИЗ
	|	ВТ_Итог КАК ВТ_Итог
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Итог.РабочийЦентр,
	|	ВТ_Итог.НомерПроката,
	|	ВТ_Итог.Заказ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Количество УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ_ОсновнойМатериал.Количество) КАК Количество,
	|	ВТ_ОсновнойМатериал.НомерПроката КАК НомерПроката
	|ПОМЕСТИТЬ ВТ_Максимум
	|ИЗ
	|	ВТ_ОсновнойМатериал КАК ВТ_ОсновнойМатериал
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОсновнойМатериал.НомерПроката
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОсновнойМатериал.РабочийЦентр КАК РабочийЦентр,
	|	ВТ_ОсновнойМатериал.НомерПроката КАК НомерПроката,
	|	ВТ_ОсновнойМатериал.Заказ КАК Заказ,
	|	ЗаказКлиентаЦвета.НомерСтроки КАК НомерСтроки,
	|	ВТ_ОсновнойМатериал.РабочийЦентр.ВидРабочегоЦентра <> ЗаказКлиентаЦвета.РабочийЦентр.ВидРабочегоЦентра КАК ПересчитыватьЗаказ
	|ИЗ
	|	ВТ_ОсновнойМатериал КАК ВТ_ОсновнойМатериал
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Максимум КАК ВТ_Максимум
	|		ПО ВТ_ОсновнойМатериал.Количество = ВТ_Максимум.Количество
	|			И ВТ_ОсновнойМатериал.НомерПроката = ВТ_Максимум.НомерПроката
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	|		ПО ВТ_ОсновнойМатериал.Заказ = ЗаказКлиентаЦвета.Ссылка
	|			И ВТ_ОсновнойМатериал.НомерПроката = ЗаказКлиентаЦвета.НомерПроката
	|			И ВТ_ОсновнойМатериал.РабочийЦентр <> ЗаказКлиентаЦвета.РабочийЦентр
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ
	|	МАКСИМУМ(ПересчитыватьЗаказ)
	|ПО
	|	Заказ";
	
	Запрос.УстановитьПараметр("Бланк", Бланк);
	
	ВыборкаЗаказ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Заказ");   
	ПервыйРЦ= неопределено;
	Пока ВыборкаЗаказ.Следующий() Цикл
		ЗаказОбъект = ВыборкаЗаказ.Заказ.ПолучитьОбъект();
		Выборка =  ВыборкаЗаказ.Выбрать();
		Пока Выборка.Следующий() Цикл   
			ЗаказОбъект.Цвета[Выборка.НомерСтроки-1].РабочийЦентр = Выборка.РабочийЦентр; 
			Если ВыборкаЗаказ.НомерПроката = 1 Тогда 
				ПервыйРЦ = Выборка.РабочийЦентр;
			КонецЕсли; 

		КонецЦикла;	     
		Если ЗначениеЗаполнено(ПервыйРЦ)  Тогда 
			ЗаказОбъект.РабочийЦентр = ПервыйРЦ;
		КонецЕсли; 

		ЗаказОбъект.ОбменДанными.Загрузка=Истина;  
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);   
		Если ВыборкаЗаказ.пересчитыватьЗаказ Тогда 
			РассчитатьСебестоимость_НормативыЗаказа(ЗаказОбъект.ссылка);
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры


//Прочие затраты
Процедура РаспределениеПрочихЗатратПоЗаказам(Док, Отказ = Ложь) Экспорт
УстановитьПривилегированныйРежим(Истина);

	НаборЗаписейЗатратыпоЗаказу = РегистрыНакопления.Лико_ЗатратыПоЗаказу.СоздатьНаборЗаписей();
	НаборЗаписейЗатратыпоЗаказу.Отбор.Регистратор.Установить(Док);
	НаборЗаписейЗатратыпоЗаказу.Записать();
	
	НаборЗаписейЗатратыНаПродажи = РегистрыНакопления.Лико_ЗатратыНаПродажи.СоздатьНаборЗаписей();
	НаборЗаписейЗатратыНаПродажи.Отбор.Регистратор.Установить(Док);
	НаборЗаписейЗатратыНаПродажи.Записать();

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПрочиеЗатратыЗатраты.Ссылка КАК Регистратор,
	|	Лико_ПрочиеЗатратыЗатраты.Период КАК Период,
	|	Лико_ПрочиеЗатратыЗатраты.СтатьяЗатрат КАК СтатьяЗатрат,
	|	Лико_ПрочиеЗатратыЗатраты.РабочийЦентр КАК РабочийЦентр,
	|	Лико_ПрочиеЗатратыЗатраты.Заказ КАК ЗаказКлиента,
	|	Лико_ПрочиеЗатратыЗатраты.НомерПроката КАК НомерПроката,
	|	СУММА(Лико_ПрочиеЗатратыЗатраты.Сумма) КАК Сумма,
	|	СУММА(Лико_ПрочиеЗатратыЗатраты.СуммаПлан) КАК СуммаПлан,
	|	Лико_ПрочиеЗатратыЗатраты.Ссылка.Подразделение КАК Подразделение
	|ИЗ
	|	Документ.Лико_ПрочиеЗатраты.Затраты КАК Лико_ПрочиеЗатратыЗатраты
	|ГДЕ
	|	Лико_ПрочиеЗатратыЗатраты.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ПрочиеЗатратыЗатраты.Ссылка,
	|	Лико_ПрочиеЗатратыЗатраты.Период,
	|	Лико_ПрочиеЗатратыЗатраты.СтатьяЗатрат,
	|	Лико_ПрочиеЗатратыЗатраты.РабочийЦентр,
	|	Лико_ПрочиеЗатратыЗатраты.Заказ,
	|	Лико_ПрочиеЗатратыЗатраты.НомерПроката,
	|	Лико_ПрочиеЗатратыЗатраты.Ссылка.Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_ПрочиеЗатратыЗатраты.Ссылка КАК Регистратор,
	|	Лико_ПрочиеЗатратыЗатраты.Период КАК Период,
	|	Лико_ПрочиеЗатратыЗатраты.СтатьяЗатрат КАК СтатьяЗатрат,
	|	Лико_ПрочиеЗатратыЗатраты.Заказ КАК Заказ,
	|	Лико_ПрочиеЗатратыЗатраты.ДокументПродажи КАК ДокументПродажи,
	|	СУММА(Лико_ПрочиеЗатратыЗатраты.Сумма) КАК Сумма
	|ИЗ
	|	Документ.Лико_ПрочиеЗатраты.Затраты КАК Лико_ПрочиеЗатратыЗатраты
	|ГДЕ
	|	Лико_ПрочиеЗатратыЗатраты.Ссылка = &Ссылка
	|	И Лико_ПрочиеЗатратыЗатраты.СтатьяЗатрат.УчитыватьВВыпуске = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ПрочиеЗатратыЗатраты.Ссылка,
	|	Лико_ПрочиеЗатратыЗатраты.Период,
	|	Лико_ПрочиеЗатратыЗатраты.Заказ,
	|	Лико_ПрочиеЗатратыЗатраты.ДокументПродажи,
	|	Лико_ПрочиеЗатратыЗатраты.СтатьяЗатрат";	
	Запрос.УстановитьПараметр("Ссылка", Док);  
	ВыборкаЗапросов = Запрос.ВыполнитьПакет();

	ВыборкаЗатратыЗаказа  = ВыборкаЗапросов.Получить(0).Выбрать();  
	ВыборкаЗатратыПродажи = ВыборкаЗапросов.Получить(1).Выбрать();  

	Пока ВыборкаЗатратыЗаказа.Следующий() цикл
		Запись = НаборЗаписейЗатратыпоЗаказу.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаЗатратыЗаказа);
	КонецЦикла;
	НаборЗаписейЗатратыпоЗаказу.Записать();
	
	
	Пока ВыборкаЗатратыПродажи.Следующий() цикл
		Запись = НаборЗаписейЗатратыНаПродажи.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, ВыборкаЗатратыПродажи);
	КонецЦикла;
	НаборЗаписейЗатратыНаПродажи.Записать();
	
КонецПроцедуры


//Выпуск
Процедура ЗаполнениеПараметровВыпуска(Источник, Отказ) Экспорт
	
	//Не заполняем для заказов с видом Оснастка
	
	УстановитьПривилегированныйРежим(Истина);
	
	Док = Источник.Ссылка;
	НаборЗаписейВыпуск = РегистрыНакопления.Лико_ВыпускГП.СоздатьНаборЗаписей();
	НаборЗаписейВыпуск.Отбор.Регистратор.Установить(Док);
	НаборЗаписейВыпуск.Записать();
	
	НаборЗаписейНормативы = РегистрыСведений.Лико_НормативыВыпуска.СоздатьНаборЗаписей();
	НаборЗаписейНормативы.Отбор.Регистратор.Установить(Док);
	НаборЗаписейНормативы.Записать();
	
	НаборЗаписейЗатратыПоЗаказу = РегистрыНакопления.Лико_ЗатратыПоЗаказу.СоздатьНаборЗаписей();
	НаборЗаписейЗатратыПоЗаказу.Отбор.Регистратор.Установить(Док);
	НаборЗаписейЗатратыпоЗаказу.Записать();
	
	НаборЗаписейСебестоимостьЗаказов = РегистрыНакопления.Лико_СебестоимостьЗаказов.СоздатьНаборЗаписей();
	НаборЗаписейСебестоимостьЗаказов.Отбор.Регистратор.Установить(Док);
	НаборЗаписейСебестоимостьЗаказов.Записать();     
	
	НаборЗаписейПриходРасходГПДляОтгрузки = РегистрыНакопления.Лико_ПриходРасходГПДляОтгрузки.СоздатьНаборЗаписей();
	НаборЗаписейПриходРасходГПДляОтгрузки.Отбор.Регистратор.Установить(Док);
	НаборЗаписейПриходРасходГПДляОтгрузки.Записать();


	ЗапросДата = Новый Запрос;
	ЗапросДата.Текст = 
	"ВЫБРАТЬ
	|	МИНИМУМ(ВыпускПродукции.Период) КАК Период
	|ИЗ
	|	РегистрНакопления.ВыпускПродукции КАК ВыпускПродукции
	|ГДЕ
	|	ВыпускПродукции.Регистратор = &Регистратор";
	ЗапросДата.УстановитьПараметр("Регистратор", Док);
	РезультатЗапроса = ЗапросДата.Выполнить().Выбрать();
	РезультатЗапроса.Следующий();
	Если ЗначениеЗаполнено(РезультатЗапроса.Период) Тогда 
		МинДатаВыпуска = РезультатЗапроса.Период;
	
		Запрос = Новый Запрос;
		Запрос.Текст = 	
	//Регионы не делают закрытие заказа, списываем все затраты сразу	
	
	#Область Запрос_Выпуск
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВыпускПродукцииОбороты.Регистратор КАК Документ.ЭтапПроизводства2_2) КАК Регистратор,
	|	ВЫРАЗИТЬ(ВыпускПродукцииОбороты.Регистратор КАК Документ.ЭтапПроизводства2_2).Лико_ЗаказКлиента КАК Заказ,
	|	ВыпускПродукцииОбороты.Период КАК Период,
	|	СУММА(ВыпускПродукцииОбороты.КоличествоОборот) КАК Количество,
	|	ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Номенклатура) КАК КоличествоНоменклатур,
	|	ЕСТЬNULL(ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Характеристика.ЯССМ_Нарезка.Размер, 0) КАК Нарезка,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(ВыпускПродукцииОбороты.Регистратор КАК Документ.ЭтапПроизводства2_2).Лико_ЗаказКлиента.ТипЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЗаказов.Термоусадка)
	|			ТОГДА 2
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КоэффициентТУ
	|ПОМЕСТИТЬ ВТВыпуск
	|ИЗ
	|	РегистрНакопления.ВыпускПродукции.Обороты(, , Регистратор, ) КАК ВыпускПродукцииОбороты
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ВыпускПродукцииОбороты.Регистратор.Лико_ЭтоОбщийЭтапНаМесяц
	|				ТОГДА ВыпускПродукцииОбороты.КоличествоОборот > ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры.Тираж * 0.05
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ВыпускПродукцииОбороты.Регистратор.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПроизводствоИзДавальческогоСырья)
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ НЕ ВыпускПродукцииОбороты.Регистратор.Распоряжение.ДокументОснование.ВидЗаказа В (ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка), ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.Оснастка))
	|				КОНЕЦ
	|		КОНЕЦ
	|	И ВыпускПродукцииОбороты.Регистратор = &Регистратор
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыпускПродукцииОбороты.Период,
	|	ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения,
	|	ЕСТЬNULL(ВыпускПродукцииОбороты.АналитикаУчетаНоменклатуры.Характеристика.ЯССМ_Нарезка.Размер, 0),
	|	ВЫРАЗИТЬ(ВыпускПродукцииОбороты.Регистратор КАК Документ.ЭтапПроизводства2_2).Лико_ЗаказКлиента,
	|	ВЫРАЗИТЬ(ВыпускПродукцииОбороты.Регистратор КАК Документ.ЭтапПроизводства2_2),
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(ВыпускПродукцииОбороты.Регистратор КАК Документ.ЭтапПроизводства2_2).Лико_ЗаказКлиента.ТипЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЗаказов.Термоусадка)
	|			ТОГДА 2
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТВыпуск.Регистратор КАК Регистратор,
	|	ВТВыпуск.Заказ КАК Заказ,
	|	ВТВыпуск.Период КАК Период,
	|	СУММА(ВТВыпуск.Количество) КАК Количество,
	|	СУММА(ВЫРАЗИТЬ(ВЫБОР
	|				КОГДА ВТВыпуск.ЕдиницаИзмерения = ТысШт.ЗначениеПараметра
	|					ТОГДА ВТВыпуск.Количество * 1000 * 1000 / ВТВыпуск.Заказ.ШтКВМ / ВТВыпуск.Заказ.Нарезка.Размер
	|				КОГДА ВТВыпуск.ЕдиницаИзмерения = ПМ.ЗначениеПараметра
	|					ТОГДА ВТВыпуск.Количество
	|				КОГДА ВТВыпуск.ЕдиницаИзмерения = КВМ.ЗначениеПараметра
	|					ТОГДА ВЫБОР
	|							КОГДА ВТВыпуск.Нарезка > 0
	|								ТОГДА ВТВыпуск.Количество * 1000 / ВТВыпуск.Нарезка
	|							ИНАЧЕ ВТВыпуск.Количество * 1000 / ВТВыпуск.Заказ.Нарезка.Размер
	|						КОНЕЦ
	|			КОНЕЦ КАК ЧИСЛО(15, 4))) КАК МетражПМ,
	|	СУММА(ВЫРАЗИТЬ(ВЫБОР
	|				КОГДА ВТВыпуск.ЕдиницаИзмерения = ТысШт.ЗначениеПараметра
	|					ТОГДА ВТВыпуск.Количество * 1000 / ВТВыпуск.Заказ.ШтКВМ
	|				КОГДА ВТВыпуск.ЕдиницаИзмерения = ПМ.ЗначениеПараметра
	|					ТОГДА ВТВыпуск.Количество * ВТВыпуск.Заказ.Нарезка.Размер / 1000
	|				КОГДА ВТВыпуск.ЕдиницаИзмерения = КВМ.ЗначениеПараметра
	|					ТОГДА ВТВыпуск.Количество
	|			КОНЕЦ КАК ЧИСЛО(15, 4))) КАК МетражКВМ
	|ПОМЕСТИТЬ ВТЗаказы
	|ИЗ
	|	ВТВыпуск КАК ВТВыпуск,
	|	Справочник.Лико_ПредопределенныеЗначения КАК ТысШт,
	|	Справочник.Лико_ПредопределенныеЗначения КАК ПМ,
	|	Справочник.Лико_ПредопределенныеЗначения КАК КВМ
	|ГДЕ
	|	ТысШт.ИмяПредопределенныхДанных = ""ЕИТысШт""
	|	И ПМ.ИмяПредопределенныхДанных = ""ЕИПогМетр""
	|	И КВМ.ИмяПредопределенныхДанных = ""ЕИКвадрМетр""
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТВыпуск.Регистратор,
	|	ВТВыпуск.Заказ,
	|	ВТВыпуск.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЗаказы.Заказ КАК Заказ,
	|	СУММА(ТоварыВЯчейкахОстатки.ВНаличииОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТНезавершеннка
	|ИЗ
	|	ВТЗаказы КАК ВТЗаказы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(, Номенклатура.ВидНоменклатуры.Лико_НоменклатураЭтикеток = ЛОЖЬ) КАК ТоварыВЯчейкахОстатки
	|		ПО ВТЗаказы.Заказ = ТоварыВЯчейкахОстатки.Характеристика.Лико_ЗаказНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТЗаказы.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТВыпуск.Заказ КАК Заказ,
	|	ВТВыпуск.Регистратор КАК Регистратор,
	|	МИНИМУМ(ВТВыпуск.Период) КАК Период,
	|	МАКСИМУМ(ВТВыпуск.КоличествоНоменклатур) КАК КоличествоНоменклатур
	|ПОМЕСТИТЬ ПервыйВыпуск
	|ИЗ
	|	ВТВыпуск КАК ВТВыпуск
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТВыпуск.Заказ,
	|	ВТВыпуск.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЗаказы.Заказ КАК Заказ,
	|	СУММА(ВыпускПродукции.Количество) КАК Количество,
	|	ВТЗаказы.Период КАК Период
	|ПОМЕСТИТЬ ВТСледующийВыпуск
	|ИЗ
	|	ВТЗаказы КАК ВТЗаказы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ВыпускПродукции КАК ВыпускПродукции
	|		ПО (ВЫБОР
	|				КОГДА ВыпускПродукции.Регистратор.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПроизводствоИзДавальческогоСырья)
	|					ТОГДА ВТЗаказы.Заказ = ВыпускПродукции.Регистратор.Распоряжение.ДокументОснование.Лико_ЗаказКлиента
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ВыпускПродукции.АналитикаУчетаНоменклатуры.Номенклатура.ВидНоменклатуры.Лико_НоменклатураЭтикеток = ИСТИНА
	|							ТОГДА ВТЗаказы.Заказ = ВыпускПродукции.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры
	|					КОНЕЦ
	|			КОНЕЦ)
	|			И (ВыпускПродукции.Период > ВТЗаказы.Период)
	|			И (ВЫБОР
	|				КОГДА ВыпускПродукции.Регистратор.Лико_ЭтоОбщийЭтапНаМесяц
	|					ТОГДА ВыпускПродукции.Количество > ВТЗаказы.Заказ.Тираж * 0.05
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТЗаказы.Заказ,
	|	ВТЗаказы.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТЗаказы.Количество) КАК Количество,
	|	ВТЗаказы.Заказ КАК Заказ,
	|	СУММА(ВТЗаказы.МетражКВМ) КАК МетражКВМ,
	|	МИНИМУМ(ВТЗаказы.Период) КАК Период,
	|	ВТЗаказы.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ВТ_ВсегоВыпуск
	|ИЗ
	|	ВТЗаказы КАК ВТЗаказы
	|
	|СГРУППИРОВАТЬ ПО
