		Если ТипЗнч(Док) = Тип("ДокументСсылка.ВнутреннееПотребление") ИЛИ  ТипЗнч(Док) = Тип("ДокументСсылка.РеализацияТОваровУслуг")     ИЛИ ТипЗнч(Док) = Тип("ДокументСсылка.ОтчетДавальцу")   ИЛИ ТипЗнч(Док) = Тип("ДокументСсылка.ПеремещениеТОваров") ТОгда 
			ЗаполнятьЗатраты = Истина;
			НаборЗаписейЗатратыПоЗаказу = РегистрыНакопления.Лико_ЗатратыПоЗаказуДляОтгрузки.СоздатьНаборЗаписей();
			НаборЗаписейЗатратыПоЗаказу.Отбор.Регистратор.Установить(Док);
			НаборЗаписейЗатратыПоЗаказу.Записать();
		КонецЕсли;
	КонецЕсли;
	
	    
