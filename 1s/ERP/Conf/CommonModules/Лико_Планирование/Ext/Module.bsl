	Результат  = ЗапросУПП.Выполнить().Выбрать();
	Результат.Следующий();
	//Спец.Организация =  Справочники.Организации.НайтиПоРеквизиту("ИНН", Результат.ОрганизацияИНН);
	Спец.Комментарий = Результат.Комментарий;

	
	Если ЗначениеЗаполнено(Результат.КонтрагентИНН) Тогда 
