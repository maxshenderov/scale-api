	Ручьи = ПараметрыШтампа.Ручьи;
	Расч_Пм = Расч_Квм/Нарезка;
	
	Комбинированный = ЛОжь;
	РассчитыватьОсновнойМатериал = Истина;
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Лико_Спецификации") Тогда 
		ИмяТаблицы = "Справочник.Лико_Спецификации";
		Если ЗначениеЗаполнено(Ссылка.ЦенаОсновногоМатериала) Тогда 
			ДобавитьЗатраты(Ссылка, НомерВарианта, РабочийЦентр,1, Справочники.Лико_СтатьиЗатрат.ОсновнойМатериал,Ссылка.ОсновнойМатериал,Расч_Квм,Расч_Квм*Ссылка.ЦенаОсновногоМатериала ,ПараметрыШтампа.Нарезка,Справочники.ВидыРаботСотрудников.Печать,,1,Ссылка.ДавальческоеСырье); 
			РассчитыватьОсновнойМатериал = Ложь;
		КонецЕсли;
	Иначе
		ИмяТаблицы = "Документ.ЗаказКлиента";
		Если Ссылка.комбинированный ТОгда
			Комбинированный = Истина;
			ЗаказОсновногоМатериала =  Ссылка.ЗаказОсновногоМатериала;
		КонецЕсли;
		Если  Ссылка.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка ТОгда
			 РассчитыватьОсновнойМатериал = Ложь;
		КонецЕсли; 
		 
	КонецЕсли;

	Если РассчитыватьОсновнойМатериал ТОгда 
		Если комбинированный И ЗначениеЗаполнено(ЗаказОсновногоМатериала) ТОгда
			Коэффициент = 1;
			Если  ЗначениеЗаполнено(ЗаказОсновногоМатериала.ТиражЗаказовГП) Тогда 
				 Коэффициент  = Количество/(ЗаказОсновногоМатериала.ТиражЗаказовГП/1000);
			КонецЕсли;	
			ЦенаМатериала = СтоимостьМатериалаЗаказа(Ссылка.ЗаказОсновногоМатериала)*Коэффициент;
			ДобавитьЗатраты(Ссылка, НомерВарианта, РабочийЦентр,1, Справочники.Лико_СтатьиЗатрат.ОсновнойМатериал,Ссылка.ОсновнойМатериал,Расч_Квм,ЦенаМатериала ,ПараметрыШтампа.Нарезка,Справочники.ВидыРаботСотрудников.Печать,,1,Ссылка.ДавальческоеСырье); 
		Иначе	
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВЫБОР
			|		КОГДА Таблица.ОсновнойМатериал ССЫЛКА Справочник.ЦеновыеГруппы
			|			ТОГДА Таблица.ОсновнойМатериал
			|		КОГДА Таблица.ОсновнойМатериал ССЫЛКА Справочник.Номенклатура
			|			ТОГДА Таблица.ОсновнойМатериал.ЦеноваяГруппа
			|	КОНЕЦ КАК ОсновнойМатериал
			|ПОМЕСТИТЬ ВТ
			|ИЗ
			|	"+ИмяТаблицы+" КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка = &ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	ВЫБОР
			|		КОГДА Таблица.ОсновнойМатериал ССЫЛКА Справочник.ЦеновыеГруппы
			|			ТОГДА Таблица.ОсновнойМатериал
			|		КОГДА Таблица.ОсновнойМатериал ССЫЛКА Справочник.Номенклатура
