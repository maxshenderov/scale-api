Процедура  СоздатьДобавитьЭтапыПроизводства(Заказ, ЗаказПр, Площадка, Отказ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаВидыРабот.Ссылка КАК Заказ,
	|	ЗаказКлиентаВидыРабот.НомерПроката КАК НомерПроката
	|ПОМЕСТИТЬ Прокаты
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаВидыРабот.НомерПроката,
	|	ЗаказКлиентаВидыРабот.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_ПараметрыПроизводстваЗаказа.НомерПроката КАК НомерПроката,
	|	МАКСИМУМ(Лико_ПараметрыПроизводстваЗаказа.ВремяПечати + Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку) КАК Время
	|ПОМЕСТИТЬ ВТ_Время
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|ГДЕ
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ПараметрыПроизводстваЗаказа.НомерПроката
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_СхемыПроизводстваЭтапы.ВидЭтапа КАК ВидЭтапа,
	|	Лико_СхемыПроизводстваЭтапы.ВидЭтапа.Наименование КАК ВидЭтапаНаименование,
	|	Прокаты.НомерПроката КАК НомерПроката,
	|	ЕСТЬNULL(ВТ_Время.Время, Лико_СхемыПроизводстваЭтапы.ВидЭтапа.ДлительностьЭтапа) КАК Длительность,
	|	Лико_СхемыПроизводстваЭтапы.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТСхема
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_СхемыПроизводства.Этапы КАК Лико_СхемыПроизводстваЭтапы
	|			ЛЕВОЕ СОЕДИНЕНИЕ Прокаты КАК Прокаты
	|				ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Время КАК ВТ_Время
	|				ПО Прокаты.НомерПроката = ВТ_Время.НомерПроката
	|			ПО (Лико_СхемыПроизводстваЭтапы.ВидЭтапа = ЗНАЧЕНИЕ(Справочник.Лико_ВидыЭтаповПроизводства.Прокат))
	|		ПО (ВЫБОР
	|				КОГДА ЗаказКлиента.ТипЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЗаказов.Полуфабрикат)
	|					ТОГДА ВЫБОР
	|							КОГДА ЗаказКлиента.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.Оснастка)
	|								ТОГДА Лико_СхемыПроизводстваЭтапы.Ссылка.ТипЗаказа = ЗаказКлиента.ТипЗаказа
	|										И Лико_СхемыПроизводстваЭтапы.Ссылка.ВидЗаказа = ЗаказКлиента.ВидЗаказа
	|							ИНАЧЕ Лико_СхемыПроизводстваЭтапы.Ссылка.ТипЗаказа = ЗаказКлиента.ТипЗаказа
	|									И Лико_СхемыПроизводстваЭтапы.Ссылка.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.ПустаяСсылка)
	|						КОНЕЦ
	|				ИНАЧЕ Лико_СхемыПроизводстваЭтапы.Ссылка.ВидЗаказа = ЗаказКлиента.ВидЗаказа
	|			КОНЕЦ)
	|ГДЕ
	|	ЗаказКлиента.Ссылка = &Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСхема.ВидЭтапа КАК ВидЭтапа,
	|	ВТСхема.ВидЭтапаНаименование КАК ВидЭтапаНаименование,
	|	ВТСхема.НомерПроката КАК НомерПроката,
	|	ВТСхема.Длительность КАК Длительность,
	|	ЭтапПроизводства2_2.Ссылка КАК ДокЭтап,
	|	ВТСхема.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_Этапы
	|ИЗ
	|	ВТСхема КАК ВТСхема
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	|		ПО (ЭтапПроизводства2_2.Распоряжение.ДокументОснование = &Заказ
	|				ИЛИ ЭтапПроизводства2_2.Распоряжение.ДокументОснование.Лико_ЗаказКлиента = &Заказ)
	|			И ВТСхема.ВидЭтапа = ЭтапПроизводства2_2.ВидЭтапа
	|			И (ВЫБОР
	|				КОГДА ВТСхема.ВидЭтапа = ЗНАЧЕНИЕ(Справочник.Лико_ВидыЭтаповПроизводства.Прокат)
	|					ТОГДА ВТСхема.НомерПроката = ЭтапПроизводства2_2.НомерПроката
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|			И (ЭтапПроизводства2_2.Распоряжение = &ЗаказНаПроизводство)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Этапы.ВидЭтапа КАК ВидЭтапа,
	|	ВТ_Этапы.ВидЭтапаНаименование КАК ВидЭтапаНаименование,
	|	ВЫБОР
	|		КОГДА ВТ_Этапы.ВидЭтапа = ЗНАЧЕНИЕ(Справочник.Лико_ВидыЭтаповПроизводства.Гравировка)
	|			ТОГДА 1
	|		ИНАЧЕ ВТ_Этапы.НомерПроката
	|	КОНЕЦ КАК НомерПроката,
	|	ВТ_Этапы.Длительность КАК Длительность,
	|	ВТ_Этапы.ДокЭтап КАК ДокЭтап
	|ИЗ
	|	ВТ_Этапы КАК ВТ_Этапы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Этапы.НомерСтроки,
	|	ВТ_Этапы.ВидЭтапа,
	|	ВТ_Этапы.ВидЭтапаНаименование,
	|	ВТ_Этапы.Длительность,
	|	ВТ_Этапы.ДокЭтап,
	|	ВЫБОР
	|		КОГДА ВТ_Этапы.ВидЭтапа = ЗНАЧЕНИЕ(Справочник.Лико_ВидыЭтаповПроизводства.Гравировка)
	|			ТОГДА 1
	|		ИНАЧЕ ВТ_Этапы.НомерПроката
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Этапы.НомерСтроки УБЫВ,
	|	НомерПроката УБЫВ";

	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Площадка", Площадка);
	Запрос.УстановитьПараметр("ЗаказНаПроизводство", ЗаказПР);

	Выборка = Запрос.Выполнить().Выбрать();
	ВсегоЭтапов = Выборка.Количество();
	СписокЭтапов = Новый СписокЗначений;
	сч = ВсегоЭтапов;
	ЭтапСледующий = Документы.ЭтапПроизводства2_2.ПустаяСсылка();
	ВыпускающийЭтап =  Документы.ЭтапПроизводства2_2.ПустаяСсылка();
	ПартияПроизводства = НайтиСоздатьПартиюПроизводства(ЗаказПР);
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ДокЭтап) Тогда 
			Этап = Выборка.ДокЭтап.ПолучитьОбъект();
			Этап.ПометкаУдаления = Ложь;
			Этап.Последователи.Очистить();
			Этап.НомерСледующегоЭтапа =0;
			Этап.ЯвляетсяНазначениемПродукции = Ложь;
			Этап.ВыходныеИзделия.Очистить();  
		Иначе	
			Этап = Документы.ЭтапПроизводства2_2.СоздатьДокумент();
		КонецЕсли;
			Этап.ПартияПроизводства = ПартияПроизводства;
			Этап.дата = ТекущаяДата();
			Этап.Распоряжение = ЗаказПр;
			Этап.Статус = Перечисления.СтатусыЭтаповПроизводства2_2.КВыполнению;
			Этап.Подразделение = ЗаказПр.Подразделение;
			Этап.Организация = ЗаказПр.Организация;
			Этап.ВыпускПодДеятельность = ЗаказПр.ЗаказПодДеятельность;
			Этап.ВыпускПодДеятельность =Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
			Этап.Ответственный = ЗаказПр.Ответственный;
			Этап.НаименованиеЭтапа = Выборка.ВидЭтапаНаименование + " "+Прав(Заказ.Номер,7); 
			Этап.КоличествоУпаковокПлан = 1;
			Этап.НомерЭтапа = сч;
			Этап.Валюта = Справочники.Валюты.НайтиПоКоду("978");
				
			Если ТипЗнч(ЗаказПр.ДокументОснование) = Тип("ДокументСсылка.ЗаказДавальца") Тогда 
				Этап.Партнер = ЗаказПр.ДокументОснование.Партнер;
				Этап.Договор = ЗаказПр.ДокументОснование.Договор;
				Этап.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПроизводствоИзДавальческогоСырья;
			Иначе
				Этап.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СобственноеПроизводство;
			КонецЕсли;	
			Этап.ПроизводствоОднойДатой = Истина;
			Этап.ВидЭтапа = Выборка.ВидЭтапа;
			Этап.ДлительностьЭтапа = Выборка.Длительность;
			Этап.ЕдиницаИзмеренияДлительностиЭтапа =  Перечисления.ЕдиницыИзмеренияВремени.Минута;
			Этап.НомерПартииЗапуска = 1;
			Этап.НомерЭтапаВПартииЗапуска = Этап.НомерЭтапа; 
			Этап.ВариантПриемкиТоваров = Константы.ВариантПриемкиТоваров.Получить();
			Если Выборка.ВидЭтапа = Справочники.Лико_ВидыЭтаповПроизводства.Упаковка Тогда 
				Этап.МаршрутнаяКарта = Справочники.Лико_ПредопределенныеЗначения.МаршрутнаяКартаУпаковка.ЗначениеПараметра;
			Иначе
				Этап.МаршрутнаяКарта = Справочники.Лико_ПредопределенныеЗначения.МаршрутнаяКартаПечать.ЗначениеПараметра;
			КонецЕсли;
			Этап.ТипПроизводственногоПроцесса = Перечисления.ТипыПроизводственныхПроцессов.Сборка;
			Этап.КоэффициентМаршрутнойКарты = 1;

			Если Выборка.ВидЭтапа = Справочники.Лико_ВидыЭтаповПроизводства.Прокат Тогда 
				Этап.НомерПроката = Выборка.НомерПроката;
						
			КонецЕсли;	
			
			Номер = Заказ.НомерБезПрефикса
			+ "."
			+ Формат(Этап.НомерПартииЗапуска, "ЧГ=0")
			+ "."
			+ Формат(Этап.НомерЭтапаВПартииЗапуска, "ЧГ=0");
			Этап.Номер = Номер;
			Этап.СпособРаспределенияЗатратНаВыходныеИзделия = Перечисления.СпособыРаспределенияЗатратНаВыходныеИзделия.ПоДолямСтоимости;
			
			Если сч  = ВсегоЭтапов Тогда 
				Этап.ЯвляетсяНазначениемПродукции = Истина;
				Для каждого стртовары из Заказ.товары Цикл
					стр = Этап.ВыходныеИзделия.Добавить();
					ЗаполнитьЗначенияСвойств(стр, стртовары, , "кодстроки");
					стр.СтатьяРасходов = Справочники.СтатьиКалькуляции.НайтиПонаименованию("Печать");
					стр.Получатель = Заказ.Склад;
					стр.ДоляСтоимости = 1;        
					стр.Подразделение = Этап.Подразделение;
				КонецЦикла;	
				
				Попытка 
					Этап.записать();
					ВыпускающийЭтап =  Этап.Ссылка;
					Этап.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось создать этапы заказа. Заказ не отправлен в работу. " + ОписаниеОшибки());
					ОтменитьТранзакцию();
					Отказ = Истина;
					Возврат;
				КонецПопытки;
			Иначе 
				стрпоследователи = Этап.Последователи.Добавить() ;
				стрпоследователи.Этап =ЭтапСледующий; 
				Этап.НомерСледующегоЭтапа =сч+1;
				Попытка 
					Этап.записать();
					Этап.записать(РежимЗаписиДокумента.Проведение);
				Исключение
					Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось создать этапы заказа. Заказ не отправлен в работу. " + ОписаниеОшибки());
					ОтменитьТранзакцию();
					Отказ = Истина;
					Возврат;
				КонецПопытки;	
			КонецЕсли;
	
			ЭтапСледующий = Этап.Ссылка;
			сч = сч-1;   
			
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиСоздатьПартиюПроизводства(ЗаказПР) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаПроизводство2_2Продукция.Ссылка КАК ЗаказПр,
	|	ЗаказНаПроизводство2_2Продукция.Ссылка.Организация КАК Организация,
	|	ЗаказНаПроизводство2_2Продукция.Ссылка.ЗаказПодДеятельность КАК ЗаказПодДеятельность,
	|	ЗаказНаПроизводство2_2Продукция.Номенклатура КАК Номенклатура,
	|	ЗаказНаПроизводство2_2Продукция.Характеристика КАК Характеристика,
	|	ЗаказНаПроизводство2_2Продукция.Номенклатура.ВидНоменклатуры.ГруппаАналитическогоУчета КАК ГруппаАналитическогоУчета,
	|	ПартииПроизводства.Ссылка КАК Партия
	|ИЗ
	|	Документ.ЗаказНаПроизводство2_2.Продукция КАК ЗаказНаПроизводство2_2Продукция
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПартииПроизводства КАК ПартииПроизводства
	|		ПО ЗаказНаПроизводство2_2Продукция.Ссылка = ПартииПроизводства.Документ
	|ГДЕ
	|	ЗаказНаПроизводство2_2Продукция.Ссылка = &ЗаказПр
	|	И ЗаказНаПроизводство2_2Продукция.НомерСтроки = 1";
	Запрос.УстановитьПараметр("ЗаказПр", ЗаказПр);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Если ЗначениеЗаполнено(Результат.Партия) Тогда 
		ПартияОбъект = Результат.Партия.ПолучитьОбъект();
	Иначе 	
		ПартияОбъект = Справочники.ПартииПроизводства.СоздатьЭлемент();
	КонецЕсли;	
	ПартияОбъект.Документ = ЗаказПр;
	ПартияОбъект.НаправлениеДеятельности = ЗаказПр.НаправлениеДеятельности;
	стр = ЗаказПр.Продукция[0];
	ПартияОбъект.ОсновноеИзделиеНоменклатура = Результат.Номенклатура;
	ПартияОбъект.ОсновноеИзделиеХарактеристика = Результат.Характеристика;
	ПартияОбъект.Организация = Результат.Организация;
	ПартияОбъект.ТипПроцесса = Перечисления.ТипыПроизводственныхПроцессов.Сборка;
	ПартияОбъект.ВидДеятельностиНДС =  Результат.ЗаказПодДеятельность;
	ПартияОбъект.ГруппаПродукции = Результат.ГруппаАналитическогоУчета;
	ПартияОбъект.ГруппировкаЗатрат = Перечисления.ГруппировкиЗатратВПроизводствеБезЗаказа.ПоСпецификациямИНазначениям;
	ПартияОбъект.Записать();
	Возврат ПартияОбъект.Ссылка;
	
КонецФункции

Процедура ПометитьНаУдалениеЗаказыДавальца_Переработчику(Заказ, Отказ)  Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПереработчику.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПереработчику КАК ЗаказПереработчику
	|ГДЕ
	|	ЗаказПереработчику.ДокументОснование = &Заказ
	|	И ЗаказПереработчику.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Если ЗначениеЗаполнено(Результат.Ссылка) Тогда 
		ЗаказПереработчику = Результат.ссылка.ПолучитьОбъект();
		ЗаказПереработчику.ПометкаУдаления = Истина;
		Попытка
			ЗаказПереработчику.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Исключение
			Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось распровести заказ переработчику. Заказ не отправлен в работу. " + ОписаниеОшибки());
			ОтменитьТранзакцию();
			Отказ = Истина;
			Возврат;
		КонецПопытки
	КонецЕсли;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказДавальца.Ссылка КАК ЗаказДавальца,
	|	ЗаказНаПроизводство2_2.Ссылка КАК ЗаказПр,
	|	ЭтапПроизводства2_2.Ссылка КАК Этап,
	|	ЗаказНаПроизводство2_2.ПометкаУдаления КАК ПометкаУдаленияЗаказПр,
	|	ЗаказДавальца.ПометкаУдаления КАК ПометкаУдаленияЗаказДавальца
	|ИЗ
	|	Документ.ЗаказДавальца КАК ЗаказДавальца
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2 КАК ЗаказНаПроизводство2_2
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
	|			ПО ЗаказНаПроизводство2_2.Ссылка = ЭтапПроизводства2_2.Распоряжение
	|				И (ЗаказНаПроизводство2_2.ПометкаУдаления = ЛОЖЬ)
	|		ПО ЗаказДавальца.Ссылка = ЗаказНаПроизводство2_2.ДокументОснование
	|ГДЕ
	|	ЗаказДавальца.Лико_ЗаказКлиента = &Заказ
	|ИТОГИ ПО
	|	ЗаказДавальца,
	|	ЗаказПр";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	ВыборкаЗаказДавальца = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ЗаказДавальца");
	Пока ВыборкаЗаказДавальца.Следующий() Цикл
		ВыборкаЗаказПр = ВыборкаЗаказДавальца.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ЗаказПр");
		Пока ВыборкаЗаказПр.Следующий() Цикл
			Выборка = ВыборкаЗаказПр.Выбрать();
			Пока Выборка.Следующий() Цикл
				Попытка 
					ЭтапОбъект = Выборка.Этап.ПолучитьОбъект();
					ЭтапОбъект.ПометкаУдаления = Истина;
					ЭтапОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Исключение
					Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось пометить на удаление этап. "+Выборка.Этап.Номер+ " Заказ не отправлен в работу. " + ОписаниеОшибки());
					ОтменитьТранзакцию();
					Отказ = Истина;
					Возврат;
				КонецПопытки;		
			КонецЦикла;
			Если ВыборкаЗаказПр.ПометкаУдаленияЗаказПр Тогда 
				Попытка 
					ЗаказПрОбъект = ВыборкаЗаказПР.ЗаказПР.ПолучитьОбъект();;
					ЗаказПрОбъект.ПометкаУдаления = Истина;
					ЗаказПрОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Исключение
					Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось пометить на удаление заказ на производство. Заказ не отправлен в работу. " + ОписаниеОшибки());
					ОтменитьТранзакцию();
					Отказ = Истина;
					Возврат;
				КонецПопытки;
			КонецЕсли;
			
		КонецЦикла;	
		Если ВыборкаЗаказДавальца.ПометкаУдаленияЗаказДавальца Тогда 
			Попытка 
				ЗаказДавальцаОбъект = ВыборкаЗаказДавальца.ЗаказДавальцао.ПолучитьОбъект();;
				ЗаказДавальцаОбъект.ПометкаУдаления = Истина;
				ЗаказДавальцаОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Исключение
				Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось пометить на удаление заказ давальца. Заказ не отправлен в работу. " + ОписаниеОшибки());
				ОтменитьТранзакцию();
				Отказ = Истина;
				Возврат;
			КонецПопытки;
		КонецЕсли;	
	Конеццикла;

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


Процедура СоздатьАктуализироватьЗаказыДвальца_Переработчику(Заказ, Отказ)  Экспорт
	
		//+ ---> Лико m.shenderov 01.12.2022 
		
