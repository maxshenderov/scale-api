				Запись.метраж =  Выборка.Количество;
			КонецЦикла;
		КонецЦикла;

		//Стоимость клея для ТУ
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ТоварыКРаспределениюОбороты.ЗаказКлиента КАК ЗаказКлиента,
