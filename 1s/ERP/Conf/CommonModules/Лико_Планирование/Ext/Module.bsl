	|					КОГДА ВТ_ЗакрытыеСчета.Регистратор.Лико_ДатаОплаты >= ВТ_ЗакрытыеСчета.Регистратор.ДатаПолученияДокументов
	|						ТОГДА ВТ_ЗакрытыеСчета.Регистратор.Лико_ДатаОплаты
	|					ИНАЧЕ ВТ_ЗакрытыеСчета.Регистратор.ДатаПолученияДокументов
	|				КОНЕЦ
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ КАК ДатаЗакрытия
	|ИЗ
	|	ВТ_ЗакрытыеСчета КАК ВТ_ЗакрытыеСчета
	|ГДЕ
	|	ВТ_ЗакрытыеСчета.Регистратор.Лико_ДатаОплаты <> ВТ_ЗакрытыеСчета.Период
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОплаты";
	
	Запрос.УстановитьПараметр("Регистратор", Источник.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Выборка.Регистратор.ПолучитьОбъект();
		Док.Лико_ДатаОплаты = Выборка.ДатаОплаты;
		Если Не   Док.Лико_РучнаяКорректировкаДатыЗакрытия Тогда 
			Если Не ЗначениеЗаполнено(Док.Лико_ДатаЗакрытия) И ЗначениеЗаполнено(Выборка.ДатаЗакрытия) Тогда 
		        Док.Лико_ДатаЗакрытия = Выборка.ДатаЗакрытия;
			КонецЕсли;
		КонецЕсли;                                                                         	
		Док.ОбменДанными.Загрузка=Истина;
		Док.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

