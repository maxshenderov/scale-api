	ЖурналДокументовСА_ОбщийЖурналДокументов.Ответственный,
	ЖурналДокументовСА_ОбщийЖурналДокументов.Тип,
	ЕСТЬNULL(ТаблицаСканов.КоличествоСканов, 0) КАК КоличествоСканов
ИЗ
	ЖурналДокументов.СА_ОбщийЖурналДокументов КАК ЖурналДокументовСА_ОбщийЖурналДокументов
ЛЕВОЕ СОЕДИНЕНИЕ
	(ВЫБРАТЬ
		СА_СканОбразы.Документ КАК Документ,
		СА_СканОбразы.ТипПечатнойФормы КАК ТипПечатнойФормы,
		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СА_СканОбразы.Ссылка) КАК КоличествоСканов
	ИЗ
		ЖурналДокументов.СА_ОбщийЖурналДокументов КАК СА_ОбщийЖурналДокументов
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ
				Справочник.СА_СканОбразы КАК СА_СканОбразы
			ПО СА_СканОбразы.Документ = СА_ОбщийЖурналДокументов.Ссылка
	ГДЕ
		СА_СканОбразы.ТипПечатнойФормы В(&amp;ТипыПечатныхФорм)
	
	СГРУППИРОВАТЬ ПО
		СА_СканОбразы.Документ,
		СА_СканОбразы.ТипПечатнойФормы) КАК ТаблицаСканов
ПО ЖурналДокументовСА_ОбщийЖурналДокументов.Ссылка = ТаблицаСканов.Документ</QueryText>
				<MainTable>DocumentJournal.СА_ОбщийЖурналДокументов</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:item>
							<dcsset:selection/>
							<dcsset:filter>
