			НайденныеСтроки = ЗаказыНаОтгрузку.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() = 0 Тогда
				Отбор.Удалить("Намотка");
				НайденныеСтроки = ЗаказыНаОтгрузку.НайтиСтроки(Отбор);
			КонецЕсли;
			Если НайденныеСтроки.Количество() = 0 Тогда
				Отбор.Удалить("КодЭтикеткиЗаказчика");
				НайденныеСтроки = ЗаказыНаОтгрузку.НайтиСтроки(Отбор);
