								КонецЕсли;
								НоваяСтрока = ТаблицаНовыхДокументов.Добавить();
								НоваяСтрока.Документ = НовыйДокументОтборРазмещениеТоваров_Размещение;
								НоваяСтрока.Регион = Строка.Регион;
							КонецЕсли;
							// <-- Конец Лико Яцун С. В. 02.03.2023
							
							Если ЭтоПеремещениеНаСкладХраненияДругойПлощадки Тогда
								// Создаем приемку товаров на отв. хранение
								НовыйДокументПриемкаТоваровНаХранение = СоздатьДокументПриемкаТоваровНаХранение(НовыйДокументПеремещениеТоваров, СтруктураТиповыхДокументовРегион.ПриемкаТоваровНаХранение); 
								Если НовыйДокументПриемкаТоваровНаХранение = Неопределено Тогда
									Возврат Ложь;
								КонецЕсли;
								НоваяСтрока = ТаблицаНовыхДокументов.Добавить();
								НоваяСтрока.Документ = НовыйДокументПриемкаТоваровНаХранение;
								НоваяСтрока.Регион = Строка.Регион;
							КонецЕсли;
							
							Если ЭтоПеремещениеСоСкладаХрененияДругойПлощадки
								ИЛИ ЭтоРеализацияБезДенегСоСкладаХраненияДругойПлощадки
								Тогда
								// Создаем отгрузку товаров с отв. хранения
								НовыйДокументОтгрузкаТоваровСХранения = СоздатьДокументОтгрузкаТоваровСХранения(СтруктураТиповыхДокументовРегион.ОтгрузкаТоваровСХранения, Неопределено, НовыйДокументПеремещениеТоваров); 
								Если НовыйДокументОтгрузкаТоваровСХранения = Неопределено Тогда
									Возврат Ложь;
								КонецЕсли;
								НоваяСтрока = ТаблицаНовыхДокументов.Добавить();
								НоваяСтрока.Документ = НовыйДокументОтгрузкаТоваровСХранения;
								НоваяСтрока.Регион = Строка.Регион;
								
							КонецЕсли;
							
						Иначе
							Если ТекущийСклад = Неопределено Тогда
								Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Для региона """ + Строка.Регион + """ не найден склад. Перемещение не создано. Транзакция по созданию типовых документов отменена.");
								Возврат Ложь;	
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			ПредыдущийКонтрагент = Строка.Грузополучатель;
			ПредыдущаяВалюта = Строка.Валюта;
			ПредыдущийРегион = Строка.Регион;
		КонецЦикла;
		
	КонецЕсли;
	
	// Запишем типовые документы в регистр Лико_СвязиСТиповымиДокументами
	Результат = Лико_Дополнительно.ЗаписатьТиповыеДокументыВРегистрЛико_СвязиСТиповымиДокументами(ТаблицаНовыхДокументов, Ссылка);
	Если НЕ Результат Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	
	// Если были созданы реализации, запустим фоновое задание по распределению расчетов с клиентами (в транзакции оно скорее всего не выполнилось из-за блокировок)
	Если ЕстьРеализации Тогда
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(ТекущаяДата());
		МассивПараметров.Добавить(Неопределено);
		//ОбщегоНазначения.ВыполнитьМетодКонфигурации("РаспределениеВзаиморасчетовВызовСервера.РаспределитьВсеРасчетыСКлиентами", МассивПараметров);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПоЗаявкеНаОтгрузкуУжеЕстьЗакрытаяЗаявкаНаТранспортировку(ЗаявкаНаОтгрузку)
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лико_ЗаявкаНаТранспортировку.Продукция КАК Лико_ЗаявкаНаТранспортировкуПродукция
	|ГДЕ
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка.Проведен
	|	И НЕ Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка.ПометкаУдаления
	|	И Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаявокНаТранспортировку.Закрыт)
	|	И Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка.Ссылка <> &Ссылка
	|	И Лико_ЗаявкаНаТранспортировкуПродукция.Мест <> 0
	|	И Лико_ЗаявкаНаТранспортировкуПродукция.ЗаявкаНаОтгрузку = &ЗаявкаНаОтгрузку
	|	И Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка.ДатаОтгрузки <= &ДатаОтгрузки";
	
	Запрос.УстановитьПараметр("ЗаявкаНаОтгрузку", ЗаявкаНаОтгрузку);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ДатаОтгрузки", ДатаОтгрузки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

Функция СоздатьДокументОтборРазмещениеТоваров(УжеСозданныйДокумент = Неопределено)
	
	Отказ = Ложь;
	
	// Если документ уже создан, будет все сложнее. Кладовщик к этому времени уже мог что-то в него насканировать.
	// Для начала проверим, есть ли в документе размещенные (отсканированные) коробки. Если нет, то просто перезаполним его также, как и для нового докумнета.
	// Если размещенные коробки уже есть, то нельзя допустить, чтобы они пропали из документа - в этом случае будем отменять тразнакцию
	// (пусть руками открывают документ и убирают в нем эти коробки сами, а после этого записывают заявку).
	
	// Также интересна ситуация, когда документ просто перезаписывается и никакие данные не меняются. Статус документа ОтборРазмещениеТоваров менять в этом случае не нужно,
	// да и вообще записывать его лишний раз ни к чему. А если хотя бы какие-то данные поменялись, будем ставить статус "Подготовлено" и записывать документ.
	// Сравнивать будем табличные части заново заполненного (но еще не записанного) документа ОтборРазмещениеТоваров со старыми ТЧ этого же документа (выгрузим их перед перезаполнением)
	
	// Для регионов же (если в складе стоит Истина у доп. реквизита Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитСкладаИспользоватьОстаткиТранспортногоМодуляДляПодбораМестВЗаявку", СкладГП)
	// места операторы будут ставить в заявке руками, а в отбор вообще заходить не будут. Поэтому будем при записи заявки места всегда ставить из документа,
	// а что там стоит в отборе вообще проверять не будем
	
	Если ДополнительныеСвойства.Свойство("ИспользоватьОстаткиТранспортногоМодуляДляПодбораМестВЗаявку") И ДополнительныеСвойства.ИспользоватьОстаткиТранспортногоМодуляДляПодбораМестВЗаявку Тогда
		ИспользоватьОстаткиТранспортногоМодуляДляПодбораМестВЗаявку = Истина;
	Иначе
		ЗначениеДопРеквизита = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитСкладаИспользоватьОстаткиТранспортногоМодуляДляПодбораМестВЗаявку", СкладГП);
		ИспользоватьОстаткиТранспортногоМодуляДляПодбораМестВЗаявку = ?(ЗначениеДопРеквизита = Неопределено, Ложь, ЗначениеДопРеквизита);
	КонецЕсли;
	ЗонаОтгрузки = Лико_Дополнительно.ПолучитьЗонуОтгрузкиПоСкладу(СкладГП);
	ЗаякаЗакрыта = Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт;
	
	Если УжеСозданныйДокумент = Неопределено ИЛИ УжеСозданныйДокумент.ТоварыРазмещение.Итог("КоличествоУпаковокРазмещено") = 0 ИЛИ ИспользоватьОстаткиТранспортногоМодуляДляПодбораМестВЗаявку Тогда
		
		НовыйДокОбъект = Документы.ОтборРазмещениеТоваров.СоздатьДокумент();
		НовыйДокОбъект.Дата = ДатаПроведенияПоАдресномуСкладу;
		НовыйДокОбъект.ВидОперации = Перечисления.ВидыОперацийОтбораРазмещенияТоваров.Перемещение;
		НовыйДокОбъект.ДатаНачалаВыполнения = ДатаПроведенияПоАдресномуСкладу;
		НовыйДокОбъект.ДатаОкончанияВыполнения = ДатаПроведенияПоАдресномуСкладу;
		НовыйДокОбъект.Ответственный = ?(ЗначениеЗаполнено(СоздалЗаявку) И ТипЗнч(СоздалЗаявку) = ТИП("СправочникСсылка.Пользователи"), СоздалЗаявку, ПараметрыСеанса.ТекущийПользователь);
		НовыйДокОбъект.Склад = СкладГП;
		НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + Ссылка + """";
		
		//ПредыдущийВид = Неопределено;
		//ПредыдущаяУпаковка = Неопределено;
		УпаковкаТысШт = Справочники.Лико_ПредопределенныеЗначения.УпаковкаТысШт.ЗначениеПараметра;
		Для каждого Строка из Продукция Цикл
			Если ЗаякаЗакрыта И Строка.Мест = 0 Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрокаОтбор = НовыйДокОбъект.ТоварыОтбор.Добавить();
			НоваяСтрокаОтбор.Количество = Строка.Серия.Лико_КоличествоВУпаковке;
			НоваяСтрокаОтбор.КоличествоУпаковок = НоваяСтрокаОтбор.Количество;
			НоваяСтрокаОтбор.Номенклатура = Строка.Номенклатура;
			//Если ПредыдущийВид = НоваяСтрокаОтбор.Номенклатура.ВидНоменклатуры Тогда
			//	НоваяСтрокаОтбор.Упаковка = ПредыдущаяУпаковка;
			//Иначе
			//	НоваяСтрокаОтбор.Упаковка = Лико_Дополнительно.ПолучитьУпаковкуПоУмолчаниюДляВидаНоменклатуры(НоваяСтрокаОтбор.Номенклатура.ВидНоменклатуры);
			//КонецЕсли; 
			НоваяСтрокаОтбор.Упаковка = УпаковкаТысШт;
			НоваяСтрокаОтбор.Характеристика = Строка.Характеристика;
			НоваяСтрокаОтбор.Ячейка = Строка.АдресХранения;
			НоваяСтрокаОтбор.ВесУпаковки = 1;
			НоваяСтрокаОтбор.Серия = Строка.Серия;
			НоваяСтрокаОтбор.СтатусУказанияСерий = 8;
			
			НоваяСтрокаРазмещение = НовыйДокОбъект.ТоварыРазмещение.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРазмещение, НоваяСтрокаОтбор,,"Ячейка");
			НоваяСтрокаРазмещение.Ячейка = ЗонаОтгрузки;
			
			Если ИспользоватьОстаткиТранспортногоМодуляДляПодбораМестВЗаявку И Строка.Мест <> 0 Тогда
				НоваяСтрокаОтбор.КоличествоОтобрано = НоваяСтрокаОтбор.Количество;
				НоваяСтрокаОтбор.КоличествоУпаковокОтобрано = НоваяСтрокаОтбор.Количество;
				НоваяСтрокаРазмещение.КоличествоРазмещено = НоваяСтрокаОтбор.Количество;
				НоваяСтрокаРазмещение.КоличествоУпаковокРазмещено = НоваяСтрокаОтбор.Количество;
			КонецЕсли;
			
			//ПредыдущийВид = НоваяСтрокаОтбор.Номенклатура.ВидНоменклатуры;
			//ПредыдущаяУпаковка = НоваяСтрокаОтбор.Упаковка;
		КонецЦикла;
		
		Если УжеСозданныйДокумент <> Неопределено Тогда
			УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
			ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
			Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
				УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
			КонецЦикла;
			НовыйДокОбъект = УжеСозданныйДокументОбъект;
		КонецЕсли;
		
	Иначе
		
		// Документ уже создан и в нем есть размещенные коробки
		
		// Первым делом проверим склад
		Если УжеСозданныйДокумент.Склад <> СкладГП Тогда
			Сообщить("" + Ссылка + ". Склад ГП документа отличается от склада, с которого уже есть отобранные коробки по заявке.");
			ОтменитьТранзакцию();
			Возврат Неопределено;
		КонецЕсли;			
		
		// Заполним ТЧ ТоварыОтбор И ТоварыРазмещение по данным заявки, затем проверим ТаблицаТоварыРазмещение по ТЧ ТоварыОтбор.
		// Если ошибок нет, то перенесем размещенное количество из ТаблицаТоварыРазмещение в обе ТЧ документа 
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		УжеСозданныйДокументОбъект.Дата = ДатаПроведенияПоАдресномуСкладу;
		УжеСозданныйДокументОбъект.ДатаНачалаВыполнения = ДатаПроведенияПоАдресномуСкладу;
		УжеСозданныйДокументОбъект.ДатаОкончанияВыполнения = ДатаПроведенияПоАдресномуСкладу;
		ТаблицаТоварыОтбор = УжеСозданныйДокументОбъект.ТоварыОтбор.Выгрузить();
		ТаблицаТоварыРазмещение = УжеСозданныйДокументОбъект.ТоварыРазмещение.Выгрузить();
		УжеСозданныйДокументОбъект.ТоварыОтбор.Очистить();
		УжеСозданныйДокументОбъект.ТоварыРазмещение.Очистить();
		//ПредыдущийВид = Неопределено;
		//ПредыдущаяУпаковка = Неопределено;
		УпаковкаТысШт = Справочники.Лико_ПредопределенныеЗначения.УпаковкаТысШт.ЗначениеПараметра;
		Для каждого Строка из Продукция Цикл
			Если ЗаякаЗакрыта И Строка.Мест = 0 Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрокаОтбор = УжеСозданныйДокументОбъект.ТоварыОтбор.Добавить();
			НоваяСтрокаОтбор.Количество = Строка.Количество;
			НоваяСтрокаОтбор.КоличествоОтобрано = 0;
			НоваяСтрокаОтбор.КоличествоУпаковок = НоваяСтрокаОтбор.Количество;
			НоваяСтрокаОтбор.КоличествоУпаковокОтобрано = 0;
			НоваяСтрокаОтбор.Номенклатура = Строка.Номенклатура;
			//Если ПредыдущийВид = НоваяСтрокаОтбор.Номенклатура.ВидНоменклатуры Тогда
			//	НоваяСтрокаОтбор.Упаковка = ПредыдущаяУпаковка;
			//Иначе
			//	НоваяСтрокаОтбор.Упаковка = Лико_Дополнительно.ПолучитьУпаковкуПоУмолчаниюДляВидаНоменклатуры(НоваяСтрокаОтбор.Номенклатура.ВидНоменклатуры);
			//КонецЕсли;
			НоваяСтрокаОтбор.Упаковка = УпаковкаТысШт;
			НоваяСтрокаОтбор.Характеристика = Строка.Характеристика;
			НоваяСтрокаОтбор.Ячейка = Строка.АдресХранения;
			НоваяСтрокаОтбор.ВесУпаковки = 1;
			НоваяСтрокаОтбор.Серия = Строка.Серия;
			НоваяСтрокаОтбор.СтатусУказанияСерий = 8;
			
			НоваяСтрокаРазмещение = УжеСозданныйДокументОбъект.ТоварыРазмещение.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРазмещение, НоваяСтрокаОтбор,,"Ячейка");
			НоваяСтрокаРазмещение.Ячейка = ЗонаОтгрузки;
			НоваяСтрокаРазмещение.КоличествоРазмещено = 0;
			НоваяСтрокаРазмещение.КоличествоУпаковокРазмещено = 0;
			
			//ПредыдущийВид = НоваяСтрокаОтбор.Номенклатура.ВидНоменклатуры;
			//ПредыдущаяУпаковка = НоваяСтрокаОтбор.Упаковка;
		КонецЦикла;
		
		Отбор = Новый Структура("Номенклатура,Упаковка,Характеристика,Назначение,Серия,СтатусУказанияСерий");
		Для каждого Строка из ТаблицаТоварыРазмещение Цикл
			Если Строка.КоличествоУпаковокРазмещено > 0 Тогда
				ЗаполнитьЗначенияСвойств(Отбор, Строка);
				НайденныеСтроки = УжеСозданныйДокументОбъект.ТоварыОтбор.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() = 0 Тогда
					// Такой коробки нет, отменяем транзакцию
					Сообщить("" + Ссылка + ". Коробка " + Строка.Номенклатура + " / " + Строка.Серия + ": уже отобрана на складе, но ее нет в заявке.");
					ОтменитьТранзакцию();
					Возврат Неопределено;
				Иначе
					// Заполним размещенное количество в ТЧ документа
					СтрокаТоварыОтбор = НайденныеСтроки[0];
					СтрокаТоварыОтбор.КоличествоОтобрано = Строка.КоличествоРазмещено;
					СтрокаТоварыОтбор.КоличествоУпаковокОтобрано = Строка.КоличествоУпаковокРазмещено;
					
					// Индексы строк табличных частей совпадают, т.к. мы их только что перезаполнили
					СтрокаТоварыРазмещение = УжеСозданныйДокументОбъект.ТоварыРазмещение[СтрокаТоварыОтбор.НомерСтроки - 1];
					СтрокаТоварыРазмещение.КоличествоРазмещено = Строка.КоличествоРазмещено;
					СтрокаТоварыРазмещение.КоличествоУпаковокРазмещено = Строка.КоличествоУпаковокРазмещено;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ТаблицыРазличаются = Лико_Дополнительно.СравнениеДвухОдинаковыхТаблицЗначенийПоСодержимому(ТаблицаТоварыОтбор, УжеСозданныйДокументОбъект.ТоварыОтбор.Выгрузить())
		ИЛИ  Лико_Дополнительно.СравнениеДвухОдинаковыхТаблицЗначенийПоСодержимому(ТаблицаТоварыРазмещение, УжеСозданныйДокументОбъект.ТоварыРазмещение.Выгрузить());
		Если НЕ ТаблицыРазличаются И УжеСозданныйДокументОбъект.Проведен И УжеСозданныйДокументОбъект.Дата = УжеСозданныйДокумент.Дата Тогда
			// Не надо записывать
			Возврат УжеСозданныйДокумент;
		КонецЕсли;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
		
	КонецЕсли;
	
	//// Установим статус в соответствии с подобранным количеством: если ничего не подобрано - подготовлено, если все подобрано - выполнено без ошибок, если часть подобрано - выполнено с ошибками
	//Если НовыйДокОбъект.ТоварыРазмещение.Итог("КоличествоРазмещено") = 0 Тогда
	//	НовыйДокОбъект.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.Подготовлено;
	//Иначе
	//	ВсеРазмещено = Истина;
	//	Для каждого Строка из НовыйДокОбъект.ТоварыРазмещение Цикл
	//		Если Строка.КоличествоРазмещено <> Строка.Количество Тогда
	//			ВсеРазмещено = Ложь;
	//			Прервать;
	//		КонецЕсли;
	//	КонецЦикла;
	//	Если ВсеРазмещено Тогда
	//		НовыйДокОбъект.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.ВыполненоБезОшибок;
	//	Иначе
	//		НовыйДокОбъект.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.ВыполненоСОшибками;
	//	КонецЕсли;
	//КонецЕсли;
	
	// Статус специально ставлю "ВРаботе", чтобы в подписке на событие он проставился правильный в зависимости от подобранного количества
	// Если оставить, то при текущем статусе документа "ВыполненоБезОшибок" перед записью документа подоранное количество заполнится из колонки "Количество"
	Если СозданНаОснованииПолученияГПИзПроизводства Тогда
		НовыйДокОбъект.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.ВыполненоБезОшибок;
	Иначе
		НовыйДокОбъект.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.ВРаботе;
	КонецЕсли;
	НовыйДокОбъект.ПометкаУдаления = Ложь;
	НовыйДокОбъект.Проведен = Истина;
	НовыйДокОбъект.ДополнительныеСвойства.Вставить("Лико_АвтоматическоеСоздание");
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;                  
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция СоздатьДокументРеализацияТоваровУслуг(УжеСозданныйДокумент = Неопределено, ТоварыВРеализацию, МассивСчетов, ТекущийСклад)
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	//ТоварыВРеализацию = Лико_Дополнительно.НайтиСтрокиВозвращаетТЗ(СтруктураПараметров.ТЗПродукция.Выгрузить(), Новый Структура("Контрагент,Валюта", СтруктураПараметров.Контрагент, СтруктураПараметров.Валюта));
	Если ТоварыВРеализацию.Количество() = 0 Тогда
		ОтменитьТранзакцию();
		Возврат Неопределено;
	КонецЕсли;
	ПерваяСтрока = ТоварыВРеализацию[0];
	
	НовыйДокОбъект = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	НовыйДокОбъект.Дата = ДатаОтгрузки;
	//Если ЗначениеЗаполнено(ПерваяСтрока.АдресДоставки) Тогда 
	//	НовыйДокОбъект.АдресДоставки = ПерваяСтрока.АдресДоставки;
	//Иначе
	НовыйДокОбъект.АдресДоставки = АдресДоставки;
	НовыйДокОбъект.АдресДоставкиЗначенияПолей = АдресДоставкиЗначенияПолей;
	//КонецЕсли;
	
	ВалютаРуб = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаЕвр = Константы.ВалютаУправленческогоУчета.Получить();
	НовыйДокОбъект.Организация = ОрганизацияПродавецКлиенту;
	//НовыйДокОбъект.БанковскийСчетОрганизации = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитОрганизацииБанковскийСчетПоУмолчанию", НовыйДокОбъект.Организация);
	//Если НЕ ЗначениеЗаполнено(НовыйДокОбъект.БанковскийСчетОрганизации) Тогда
	//	НовыйДокОбъект.БанковскийСчетОрганизации = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(НовыйДокОбъект.Организация, ВалютаРуб);
	//КонецЕсли;
	Если ТипЗнч(Грузоотправитель) = Тип("СправочникСсылка.Контрагенты") Тогда
		НовыйДокОбъект.Грузоотправитель = Грузоотправитель;
		НовыйДокОбъект.БанковскийСчетГрузоотправителя = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(Грузоотправитель, ВалютаРуб);
	КонецЕсли;
	Если ПерваяСтрока.Грузополучатель <> ПерваяСтрока.Контрагент Тогда
		НовыйДокОбъект.Грузополучатель = ПерваяСтрока.Грузополучатель;
		НовыйДокОбъект.БанковскийСчетГрузополучателя = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(ПерваяСтрока.Грузополучатель, ВалютаРуб);
	КонецЕсли;
	НовыйДокОбъект.Валюта = ПерваяСтрока.Валюта;
	НакладнаяНаЭкспорт = ПерваяСтрока.Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент;
	Если НакладнаяНаЭкспорт Тогда
		НовыйДокОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНаЭкспорт;
	Иначе
		НовыйДокОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	КонецЕсли;
	НовыйДокОбъект.ВалютаВзаиморасчетов = НовыйДокОбъект.Валюта;
	НовыйДокОбъект.Контрагент = ПерваяСтрока.Контрагент;
	НовыйДокОбъект.Менеджер = ПерваяСтрока.ЗаказКлиента.Менеджер;
	
	//ПриСозданииОтгрузкиБратьПартнераИзЗаказаАНеИзКонтрагента = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, ПерваяСтрока.Контрагент.Партнер, "ПриСозданииОтгрузкиБратьПартнераИзЗаказаАНеИзКонтрагента_087633c41e41426fb319ce4c41e3ffab", Ложь);
	
	// По требованию Капкина теперь партнер будет всегда браться из заказа
	//ПриСозданииОтгрузкиБратьПартнераИзЗаказаАНеИзКонтрагента = Истина;
	
	// сделал наоборот: по умолчанию брать из заказа, а для некоторых случаев брать из контрагента
	ПриСозданииОтгрузкиБратьПартнераИзКонтрагентаАНеИзЗаказа = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, ПерваяСтрока.Контрагент.Партнер, "ПриСозданииОтгрузкиБратьПартнераИзКонтрагентаАНеИзЗаказа_fca67e4d4a11435ca3926adb18a18d38", Ложь);
	Если ПриСозданииОтгрузкиБратьПартнераИзКонтрагентаАНеИзЗаказа Тогда
		НовыйДокОбъект.Партнер = ПерваяСтрока.Контрагент.Партнер;
	Иначе
		НовыйДокОбъект.Партнер = ПерваяСтрока.ЗаказКлиента.Партнер;
	КонецЕсли;
	
	Если НовыйДокОбъект.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра ИЛИ НовыйДокОбъект.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра ИЛИ НовыйДокОбъект.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияАвантаж.ЗначениеПараметра Тогда
		//НовыйДокОбъект.Подразделение = Справочники.Лико_ПредопределенныеЗначения.ПодразделениеПроизводство.ЗначениеПараметра;
		НовыйДокОбъект.Подразделение = ПерваяСтрока.ЗаказКлиента.Площадка.ПодразделениеПроизводство; // --> Начало Лико Ефимов ЕВВ 17.12.2024
	Иначе
		Если ЗначениеЗаполнено(НовыйДокОбъект.Менеджер.Подразделение) Тогда
			НовыйДокОбъект.Подразделение = НовыйДокОбъект.Менеджер.Подразделение;
		Иначе
			НовыйДокОбъект.Подразделение = ПолучитьПодразделениеПоРегиону(ПерваяСтрока.ЗаказКлиента.Регион);
		КонецЕсли;
	КонецЕсли;
	НовыйДокОбъект.Склад = ТекущийСклад;
	НовыйДокОбъект.Согласован = Истина;
	НовыйДокОбъект.Соглашение = ПерваяСтрока.ЗаказКлиента.Соглашение;
	НовыйДокОбъект.ХозяйственнаяОперация = ПерваяСтрока.ЗаказКлиента.ХозяйственнаяОперация;
	НовыйДокОбъект.ЦенаВключаетНДС = ?(ПерваяСтрока.ПересчитыватьЦеныВЦеныБезНДС, Ложь, ПерваяСтрока.ЦенаВключаетНДС);
	НовыйДокОбъект.Автор = ?(ЗначениеЗаполнено(СоздалЗаявку) И ТипЗнч(СоздалЗаявку) = ТИП("СправочникСсылка.Пользователи"), СоздалЗаявку, ПараметрыСеанса.ТекущийПользователь);
	НовыйДокОбъект.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	Отбор = Новый Структура("Валюта", НовыйДокОбъект.Валюта);
	//КурсВалюты = РегистрыСведений.КурсыВалют.СрезПоследних(ДатаОтгрузки, Отбор);
	//НовыйДокОбъект.Курс = КурсВалюты[0].Курс;
	//НовыйДокОбъект.Кратность = КурсВалюты[0].Кратность;
	НовыйДокОбъект.КурсЧислитель = 1;
	НовыйДокОбъект.КурсЗнаменатель = 1;
	НовыйДокОбъект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	Перевозчик = ?(ЗначениеЗаполнено(Диспетчер), Диспетчер.Партнер, ПеревозчикЖДиАвиа.Партнер);
	Если ЗначениеЗаполнено(Перевозчик) Тогда
		НовыйДокОбъект.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчика;
		НовыйДокОбъект.ПеревозчикПартнер = Перевозчик;
	Иначе
		НовыйДокОбъект.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	КонецЕсли;
	НовыйДокОбъект.Комментарий = ПерваяСтрока.Комментарий + Символы.ПС;
	НовыйДокОбъект.Комментарий = "" + НовыйДокОбъект.Комментарий + "Создан автоматически на основании документа """ + Ссылка + """";
	ЗаполнитьОтветственныхЛиц(НовыйДокОбъект);
	
	НовыйДокОбъект.ГруппаФинансовогоУчета = Лико_Дополнительно.НайтиГруппуФинУчетаПоВалютеИНалогообложению(НовыйДокОбъект.Валюта, НовыйДокОбъект.НалогообложениеНДС);
	
	// если есть счета на оплату, проведем сперва в статусе "К предоплате", а после зачета оплаты отдельно проведем в статусе "Отгружено"
	//Если МассивСчетов.Количество() > 0 Тогда
	//	НовыйДокОбъект.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.КПредоплате;
	//Иначе
	НовыйДокОбъект.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено;
	//КонецЕсли;
	
	СтавкаНДС0 = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС0);
	Для каждого Строка из ТоварыВРеализацию Цикл
		НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = Строка.Номенклатура;
		НоваяСтрока.Характеристика = Строка.Характеристика;
		НоваяСтрока.Упаковка = Строка.Номенклатура.ЕдиницаИзмерения;
		НоваяСтрока.КоличествоУпаковок = Строка.КоличествоОтгружено;
		НоваяСтрока.Количество = Строка.КоличествоОтгружено;
		НоваяСтрока.Цена = Строка.Цена;
		Если НакладнаяНаЭкспорт Тогда
			// не резидент, ставка НДС = 0
			НоваяСтрока.СтавкаНДС = СтавкаНДС0;
			НоваяСтрока.КодТНВЭД = НоваяСтрока.Номенклатура.КодТНВЭД;
		Иначе
			// резидент
			НоваяСтрока.СтавкаНДС = Строка.СтавкаНДС;
		КонецЕсли;
		НоваяСтрока.Склад = НовыйДокОбъект.Склад;
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСумму");
		//СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", НовыйДокОбъект.НалогообложениеНДС);
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", Новый Структура("ЦенаВключаетНДС,СтавкаНДС", НовыйДокОбъект.ЦенаВключаетНДС, НоваяСтрока.СтавкаНДС));
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
	КонецЦикла;
	//НовыйДокОбъект.Товары.Сортировать("Характеристика,Номенклатура");
	
	// Заполняем договор
	НовыйДокОбъект.Договор = ПодобратьДоговорВРеализацию(ПерваяСтрока.ЗаказКлиента, НовыйДокОбъект, МассивСчетов, ПерваяСтрока.РеальныйДоговор);
	Если ЗначениеЗаполнено(НовыйДокОбъект.Договор) Тогда
		СтруктураОснования = Лико_Дополнительно.СформироватьОснованиеРеализацииПоДоговору(НовыйДокОбъект.Договор, НовыйДокОбъект.Дата);
		Если СтруктураОснования <> Неопределено И ЗначениеЗаполнено(СтруктураОснования.ТекстОснования) Тогда
			НовыйДокОбъект.Основание = СтруктураОснования.ТекстОснования;
			НовыйДокОбъект.ОснованиеНомер = СтруктураОснования.Номер;
			НовыйДокОбъект.ОснованиеДата = СтруктураОснования.Дата;
		КонецЕсли;
	КонецЕсли;
	НовыйДокОбъект.БанковскийСчетОрганизации = НовыйДокОбъект.Договор.БанковскийСчет;
	НовыйДокОбъект.ОплатаВВалюте = НовыйДокОбъект.Договор.ОплатаВВалюте;
	НовыйДокОбъект.БанковскийСчетКонтрагента = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(ПерваяСтрока.Контрагент, ?(НовыйДокОбъект.ОплатаВВалюте, Неопределено, ВалютаРуб));
	
	// Заполним даты и суммы платежей
	//НовыйДокОбъект.ЗаполнитьЭтапыГрафикаОплаты();
	
	НовыйДокОбъект.УстановитьНовыйНомер();
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер,Сканы,Лико_ОбщаяСтоимостьДоставки,Лико_СкладДляРасчетаСтоимостиДоставки");
		Если Лев(УжеСозданныйДокументОбъект.Номер, 2) <> Лев(НовыйДокОбъект.Номер, 2)
			ИЛИ Сред(УжеСозданныйДокументОбъект.Номер, 6, 1) <> Сред(НовыйДокОбъект.Номер, 6, 1)
			Тогда
			// Если префиксы организаций или года разные, то номер тоже будем менять
			УжеСозданныйДокументОбъект.Номер = НовыйДокОбъект.Номер;
		КонецЕсли;
		
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;                  
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция СоздатьДокументАктВыполненныхРабот(УжеСозданныйДокумент = Неопределено, РеализацияТоваровУслуг, ЗаявкаНаОтгрузку)
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	ВалютаРуб = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаЕвр = Константы.ВалютаУправленческогоУчета.Получить();
	ПерваяСтрокаТоваров = ЗаявкаНаОтгрузку.Товары[0];
	
	НовыйДокОбъект = Документы.АктВыполненныхРабот.СоздатьДокумент();
	
	ЗаполнитьЗначенияСвойств(НовыйДокОбъект, РеализацияТоваровУслуг, "Номер,Дата,БанковскийСчетКонтрагента,БанковскийСчетОрганизации,Контрагент,Менеджер,НалогообложениеНДС,Организация,Партнер,Подразделение,Соглашение,Договор,Автор,Руководитель,ГлавныйБухгалтер,ПорядокРасчетов,Основание,ОснованиеДата,ОснованиеНомер,Комментарий");
	
	КурсВалюты = 1;
	Если ПерваяСтрокаТоваров.ВалютаЦены = ВалютаРуб Тогда
		НовыйДокОбъект.Валюта = ВалютаРуб;
	Иначе
		Если ПерваяСтрокаТоваров.ОтгрузкаВРублях Тогда
			// Требуется пересчет в рубли
			КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ПерваяСтрокаТоваров.ВалютаЦены, НовыйДокОбъект.Дата).Курс;
			НовыйДокОбъект.Валюта = ВалютаРуб;
		Иначе
			НовыйДокОбъект.Валюта = ПерваяСтрокаТоваров.ВалютаЦены;
		КонецЕсли;
	КонецЕсли;
	
	НовыйДокОбъект.ВалютаВзаиморасчетов = НовыйДокОбъект.Валюта;
	//НовыйДокОбъект.Комментарий = "" + НовыйДокОбъект.Комментарий + "Создан автоматически на основании документа """ + Ссылка + """";
	НовыйДокОбъект.ЦенаВключаетНДС = ?(ЗначениеЗаполнено(ЗаявкаНаОтгрузку.Услуги[0].Характеристика.Лико_ЗаказНоменклатуры), ЗаявкаНаОтгрузку.Услуги[0].Характеристика.Лико_ЗаказНоменклатуры.ЦенаДляДокументовВключаетНДС, ПерваяСтрокаТоваров.ЗаказКлиента.ЦенаДляДокументовВключаетНДС);
	НовыйДокОбъект.КурсЧислитель = 1;
	НовыйДокОбъект.КурсЗнаменатель = 1;
	
	СтавкаНДС = РеализацияТоваровУслуг.Товары[0].СтавкаНДС;
	
	Для каждого СтрокаУслуги из ЗаявкаНаОтгрузку.Услуги Цикл
		
		НоваяСтрока = НовыйДокОбъект.Услуги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаУслуги, "Номенклатура,Характеристика,Содержание,Количество");
		//НоваяСтрока.Характеристика = НайтиИлиСоздатьХарактеристикуДляУслуги(СтрокаУслуги.Номенклатура, СтрокаУслуги.ЗаказКлиента);
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Содержание) Тогда
			НоваяСтрока.Содержание = НоваяСтрока.Номенклатура.НаименованиеПолное + ?(ЗначениеЗаполнено(НоваяСтрока.Характеристика), " (" + НоваяСтрока.Характеристика.НаименованиеПолное + ")", "");
		КонецЕсли;
		
		НоваяСтрока.Цена = СтрокаУслуги.Цена * КурсВалюты;
		НоваяСтрока.СтавкаНДС = СтавкаНДС;
		СтруктураДействий = Новый Структура;
		СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(НовыйДокОбъект);
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать, ИмяКоличества", Ложь, "Количество"));
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
		СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
		СтруктураДействий.Вставить("ПересчитатьСумму", "Количество");
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
		
	КонецЦикла;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Сканы");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;                  
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция СоздатьДокументТраспортнаяНакладная(УжеСозданныйДокумент = Неопределено, Основание, ТаблицаСерий, ИзменитьТолькоДанныеПеревозчика = Ложь)
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	Если ИзменитьТолькоДанныеПеревозчика Тогда
		НовыйДокОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
	Иначе
		НовыйДокОбъект = Документы.ТранспортнаяНакладная.СоздатьДокумент();
		НовыйДокОбъект.Номер = Основание.Номер;
		//МассивРаспоряжений = Новый Массив;
		//МассивРаспоряжений.Добавить(Основание);
		//РеквизитыТранспортнойНакладной = Документы.ТранспортнаяНакладная.РеквизитыТранспортнойНакладнойЗаполненные(МассивРаспоряжений);
		НовыйДокОбъект.Заполнить(Основание);
		НовыйДокОбъект.ВыводДанныхОТоварномСоставе = Перечисления.ВариантыВыводаДанныхОТоварномСоставе.ТоварныйСостав;
		НовыйДокОбъект.ВидПеревозки = ТипЗаявки;
		НовыйДокОбъект.МассаБрутто = Документы.Лико_ЗаявкаНаТранспортировку.РассчитатьВесКоробокДляТаблицыСерий(ТаблицаСерий);
		НовыйДокОбъект.МассаНетто = НовыйДокОбъект.МассаБрутто;
		НовыйДокОбъект.СрокДоставки = СрокДоставки;
		НовыйДокОбъект.Лико_Логист = ОтпускРазрешил;
		НовыйДокОбъект.Лико_КоличествоМест = Лико_Дополнительно.РассчитатьКоличествоКоробокВТЗ(ТаблицаСерий);
		НовыйДокОбъект.ГлавныйБухгалтер = Основание.ГлавныйБухгалтер;
		НовыйДокОбъект.БанковскийСчетЗаказчикаПеревозки = Основание.БанковскийСчетОрганизации;
		НовыйДокОбъект.АдресПогрузки = АдресГрузоотправителя;
		НовыйДокОбъект.АдресПогрузкиЗначенияПолей = АдресГрузоотправителяЗначенияПолей;
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ПеремещениеТоваров")    
			// --> Начало Лико Ефимов ЕВВ 16.02.2023 Странно, что ОтгрузкаТоваровСХранения я сделал по аналогии с перемещением. Нужно ее делать по аналогии с реализацией, поэтому пусть идет в Иначе
			//ИЛИ ТипЗнч(Основание) = Тип("ДокументСсылка.ОтгрузкаТоваровСХранения") 
			Тогда
			ТекГрузополучатель = ?(ЗначениеЗаполнено(КорректировкаГрузополучатель), КорректировкаГрузополучатель, Контрагент);
			ВТранспортнойНакладнойПлательщикЭтоКонтрагентРеализации = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, ТекГрузополучатель.Партнер, "ВТранспортнойНакладнойПлательщикКонтрагентРеализации", Ложь);
			
			НовыйДокОбъект.Организация = ОрганизацияПродавецКлиенту;
			НовыйДокОбъект.Грузоотправитель = НовыйДокОбъект.Организация;
			НовыйДокОбъект.Грузополучатель = ТекГрузополучатель;
			Если ВТранспортнойНакладнойПлательщикЭтоКонтрагентРеализации Тогда
				НовыйДокОбъект.Плательщик = ТекГрузополучатель;
				НовыйДокОбъект.БанковскийСчетПлательщика = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(НовыйДокОбъект.Плательщик, Константы.ВалютаРегламентированногоУчета.Получить());
			Иначе
				НовыйДокОбъект.Плательщик = НовыйДокОбъект.Организация;
				НовыйДокОбъект.БанковскийСчетПлательщика = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитОрганизацииБанковскийСчетПоУмолчанию", НовыйДокОбъект.Плательщик);
				Если НЕ ЗначениеЗаполнено(НовыйДокОбъект.БанковскийСчетПлательщика) Тогда
					НовыйДокОбъект.БанковскийСчетПлательщика = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(НовыйДокОбъект.Плательщик, Константы.ВалютаРегламентированногоУчета.Получить());
				КонецЕсли;
			КонецЕсли;
			НовыйДокОбъект.ЗаказчикПеревозки = НовыйДокОбъект.Организация;
			ЗаполнитьОтветственныхЛиц(НовыйДокОбъект);
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ОтгрузкаТоваровСХранения") Тогда
			ТекГрузополучатель = ?(ЗначениеЗаполнено(КорректировкаГрузополучатель), КорректировкаГрузополучатель, Контрагент);
			ВТранспортнойНакладнойПлательщикЭтоКонтрагентРеализации = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Основание.Партнер, "ВТранспортнойНакладнойПлательщикКонтрагентРеализации", Ложь);
			
			НовыйДокОбъект.Организация = Основание.Организация;
			НовыйДокОбъект.Грузоотправитель = НовыйДокОбъект.Организация;
			НовыйДокОбъект.Грузополучатель = ТекГрузополучатель;
			Если ВТранспортнойНакладнойПлательщикЭтоКонтрагентРеализации Тогда
				НовыйДокОбъект.Плательщик = Основание.Контрагент;
				НовыйДокОбъект.БанковскийСчетПлательщика = Основание.БанковскийСчетКонтрагента;
			Иначе
				НовыйДокОбъект.Плательщик = Основание.Организация;
				НовыйДокОбъект.БанковскийСчетПлательщика = Основание.БанковскийСчетОрганизации;
			КонецЕсли;
			НовыйДокОбъект.ЗаказчикПеревозки = Основание.Организация;
			ЗаполнитьОтветственныхЛиц(НовыйДокОбъект);
		Иначе
			ВТранспортнойНакладнойПлательщикЭтоКонтрагентРеализации = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Основание.Партнер, "ВТранспортнойНакладнойПлательщикКонтрагентРеализации", Ложь);
			
			Если ВТранспортнойНакладнойПлательщикЭтоКонтрагентРеализации Тогда
				НовыйДокОбъект.Плательщик = Основание.Контрагент;
				НовыйДокОбъект.БанковскийСчетПлательщика = Основание.БанковскийСчетКонтрагента;
			Иначе
				НовыйДокОбъект.Плательщик = Основание.Организация;
				НовыйДокОбъект.БанковскийСчетПлательщика = Основание.БанковскийСчетОрганизации;
			КонецЕсли;
			НовыйДокОбъект.ЗаказчикПеревозки = Основание.Организация;
		КонецЕсли;
		
		Если НовыйДокОбъект.Плательщик = НовыйДокОбъект.ЗаказчикПеревозки Тогда
			НовыйДокОбъект.БанковскийСчетЗаказчикаПеревозки = НовыйДокОбъект.БанковскийСчетПлательщика;
		Иначе
			НовыйДокОбъект.БанковскийСчетЗаказчикаПеревозки = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитОрганизацииБанковскийСчетПоУмолчанию", НовыйДокОбъект.ЗаказчикПеревозки);
			Если НЕ ЗначениеЗаполнено(НовыйДокОбъект.БанковскийСчетЗаказчикаПеревозки) Тогда
				НовыйДокОбъект.БанковскийСчетЗаказчикаПеревозки = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(НовыйДокОбъект.ЗаказчикПеревозки, Константы.ВалютаРегламентированногоУчета.Получить());
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	НовыйДокОбъект.Лико_Пломба = Пломба;
	НовыйДокОбъект.АвтомобильВместимостьВКубическихМетрах = Машина.ВместимостьВКубическихМетрах;
	НовыйДокОбъект.АвтомобильГосударственныйНомер = Машина.Код;
	НовыйДокОбъект.АвтомобильГрузоподъемностьВТоннах = Машина.ГрузоподъемностьВТоннах;
	НовыйДокОбъект.АвтомобильМарка = Машина.Марка;
	НовыйДокОбъект.АвтомобильТип = Машина.Тип;
	НовыйДокОбъект.Водитель = Водитель;
	НовыйДокОбъект.ГосударственныйНомерПрицепа = Машина.ГосударственныйНомерПрицепа;
	НовыйДокОбъект.ЛицензионнаяКарточкаВид = Машина.ЛицензионнаяКарточкаВид;
	НовыйДокОбъект.ЛицензионнаяКарточкаНомер = Машина.ЛицензионнаяКарточкаНомер;
	НовыйДокОбъект.ЛицензионнаяКарточкаРегистрационныйНомер = Машина.ЛицензионнаяКарточкаРегистрационныйНомер;
	НовыйДокОбъект.ЛицензионнаяКарточкаСерия = Машина.ЛицензионнаяКарточкаСерия;
	НовыйДокОбъект.Перевозчик = ?(ЗначениеЗаполнено(Диспетчер), Диспетчер, ПеревозчикЖДиАвиа);
	НовыйДокОбъект.БанковскийСчетПеревозчика = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(НовыйДокОбъект.Перевозчик, Константы.ВалютаРегламентированногоУчета.Получить());
	НовыйДокОбъект.Прицеп = Машина.Прицеп;
	ДанныеВодУдостоверения = Лико_Дополнительно.ПолучитьДанныеВодУдостоверения(Водитель, НовыйДокОбъект.Дата);
	НовыйДокОбъект.УдостоверениеНомер = ДанныеВодУдостоверения.УдостоверениеНомер;
	НовыйДокОбъект.УдостоверениеСерия = ДанныеВодУдостоверения.УдостоверениеСерия;
	НовыйДокОбъект.Лико_ДатаВыдачиУдостоверения = ДанныеВодУдостоверения.Лико_ДатаВыдачиУдостоверения;
	НовыйДокОбъект.АдресДоставки = АдресДоставки;
	НовыйДокОбъект.АдресДоставкиЗначенияПолей = АдресДоставкиЗначенияПолей;
	
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Сканы");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;                  
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Процедура ЗаполнитьОтветственныхЛиц(НовыйДокОбъект)
	
	ФизЛицо = ПараметрыСеанса.ТекущийПользователь.ФизическоеЛицо;
	НовыйДокОбъект.Отпустил = ?(ЗначениеЗаполнено(Кладовщик), Кладовщик, ФизЛицо);
	НовыйДокОбъект.ОтпустилДолжность = Лико_Дополнительно.НайтиДолжностьФизЛица(НовыйДокОбъект.Отпустил, НовыйДокОбъект.Организация, НовыйДокОбъект.Дата);
	Если НЕ ЗначениеЗаполнено(НовыйДокОбъект.ОтпустилДолжность) Тогда
		НовыйДокОбъект.ОтпустилДолжность = "Кладовщик";
	КонецЕсли;
	
	Если НовыйДокОбъект.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияАвантаж.ЗначениеПараметра ИЛИ НовыйДокОбъект.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЭкоФлекс.ЗначениеПараметра Тогда
		Руководитель = ?(ЗначениеЗаполнено(ОтпускРазрешил), ОтпускРазрешил, НовыйДокОбъект.Отпустил);
		ГлавныйБухгалтер = ?(ЗначениеЗаполнено(ОтпускПроизвел), ОтпускПроизвел, НовыйДокОбъект.Отпустил);
	Иначе
		Руководитель = НовыйДокОбъект.Отпустил;
		ГлавныйБухгалтер = НовыйДокОбъект.Отпустил;
	КонецЕсли;
	
	НовыйДокОбъект.Руководитель = Лико_Дополнительно.НайтиЛицоСПравомПодписи(НовыйДокОбъект.Организация, Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, Руководитель, НовыйДокОбъект.Дата); 
	НовыйДокОбъект.ГлавныйБухгалтер = Лико_Дополнительно.НайтиЛицоСПравомПодписи(НовыйДокОбъект.Организация, Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, ГлавныйБухгалтер, НовыйДокОбъект.Дата); 
	
КонецПроцедуры

Функция ПолучитьМассивСчетов(ТоварыВРеализацию)
	
	МассивСчетов = Новый Массив;
	ТаблицаСчетов = ТоварыВРеализацию.Скопировать(,"СчетНаОплату");
	ТаблицаСчетов.Свернуть("СчетНаОплату");
	Для каждого Строка из ТаблицаСчетов Цикл
		Если ЗначениеЗаполнено(Строка.СчетНаОплату) Тогда
			МассивСчетов.Добавить(Строка.СчетНаОплату);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивСчетов;
	
КонецФункции

Функция ПодобратьДоговорВРеализацию(ЗаказКлиента, Реализация, МассивСчетов, РеальныйДоговор)
	
	Договор = Неопределено;
	ДоговорИзСчета = Ложь;
	//Если ЗаказКлиента.Соглашение.ИспользуютсяДоговорыКонтрагентов Тогда
	Если МассивСчетов.Количество() = 0 Тогда
		Договор = Лико_Дополнительно.ПодобратьДоговор(ЗаказКлиента, Реализация);
	Иначе
		Для каждого Счет из МассивСчетов Цикл
			Если ЗначениеЗаполнено(Счет.Договор) Тогда
				Договор = Счет.Договор;
				ДоговорИзСчета = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЗначениеЗаполнено(Договор) Тогда
			// Договор будем формировать исходя из ЗаказаКлиента (он получен из первой строки реализации)
			Договор = Лико_Дополнительно.ПодобратьДоговор(ЗаказКлиента, Реализация);
		КонецЕсли;
	КонецЕсли;
	//КонецЕсли;
	Если Договор.Организация <> Реализация.Организация
		ИЛИ Договор.Контрагент <> Реализация.Контрагент
		ИЛИ Договор.Партнер <> Реализация.Партнер
		//ИЛИ Договор.ПорядокОплаты <> Реализация.ПорядокОплаты
		ИЛИ Договор.ГруппаФинансовогоУчета <> Реализация.ГруппаФинансовогоУчета
		ИЛИ Договор.ВалютаВзаиморасчетов <> Реализация.ВалютаВзаиморасчетов
		ИЛИ (НЕ ДоговорИзСчета И Договор.Дата <> НачалоДня(Реализация.Дата))
		ИЛИ (ЗначениеЗаполнено(РеальныйДоговор) И Договор.Лико_СсылкаНаРеальныйДоговор <> РеальныйДоговор)
		ИЛИ (НЕ ДоговорИзСчета И Договор.СтавкаНДС <> Реализация.Товары[0].СтавкаНДС)
		ИЛИ Договор.Лико_Площадка <> ЗаказКлиента.Площадка
		ИЛИ Договор.Менеджер <> Реализация.Менеджер
		ИЛИ Договор.ПометкаУдаления
		Тогда
		
		ДоговорОбъект = Договор.ПолучитьОбъект();
		ДоговорОбъект.Организация = Реализация.Организация;
		//ДоговорОбъект.ПорядокОплаты = Реализация.ПорядокОплаты;
		ДоговорОбъект.ГруппаФинансовогоУчета = Реализация.ГруппаФинансовогоУчета;
		ДоговорОбъект.ВалютаВзаиморасчетов = Реализация.ВалютаВзаиморасчетов;
		ДоговорОбъект.Контрагент = Реализация.Контрагент;
		ДоговорОбъект.Партнер = Реализация.Партнер;
		Если НЕ ДоговорИзСчета Тогда
			ДоговорОбъект.Дата = Реализация.Дата;
			ДоговорОбъект.СтавкаНДС = Реализация.Товары[0].СтавкаНДС;
		КонецЕсли;
		Если ЗначениеЗаполнено(РеальныйДоговор) Тогда
			ДоговорОбъект.Лико_СсылкаНаРеальныйДоговор = РеальныйДоговор;
		Иначе
			ДоговорОбъект.Лико_СсылкаНаРеальныйДоговор = Лико_Дополнительно.НайтиРеальныйДоговор(ДоговорОбъект.Организация, ДоговорОбъект.Контрагент, ДоговорОбъект.Дата, ДоговорОбъект.ВалютаВзаиморасчетов);
		КонецЕсли;
		ДоговорОбъект.Лико_Площадка = ЗаказКлиента.Площадка;
		ДоговорОбъект.ПометкаУдаления = Ложь;
		ДоговорОбъект.Записать();
	КонецЕсли;
	Возврат Договор;
	
КонецФункции

Процедура ПривязатьОплатыКРеализации(МассивСчетов, Реализация)
	
	УстановитьПривилегированныйРежим(Истина);
	Для каждого СчетНаОплату из МассивСчетов Цикл
		// Найдем для счета документы оплаты и привяжем их к накладной
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка,
		|	ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.НомерСтроки
		|ИЗ
		|	Документ.ПоступлениеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа
		|ГДЕ
		|	(ВЫРАЗИТЬ(ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.ОснованиеПлатежа КАК Документ.Лико_СчетНаОплатуКлиенту)) = &ОснованиеПлатежа
		|	И ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.Проведен
		|	И ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Заказ <> &Реализация";
		
		Запрос.УстановитьПараметр("ОснованиеПлатежа", СчетНаОплату);
		Запрос.УстановитьПараметр("Реализация", Реализация);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			СтрокаРасшифровкаПлатежа = ДокОбъект.РасшифровкаПлатежа[Выборка.НомерСтроки-1];
			СтрокаРасшифровкаПлатежа.Заказ = Реализация;
			Попытка
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Платеж """ + Выборка.Ссылка + """ привязан к накладной """ + Реализация + """");
			Исключение
				Сообщить("Документ """ + Выборка.Ссылка + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
				ОтменитьТранзакцию();
				ВызватьИсключение;
			КонецПопытки;
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры

Функция СоздатьДокументСчетФактураВыданный(УжеСозданныйДокумент = Неопределено, Основание, АктВыполненныхРабот)
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйДокОбъект = Документы.СчетФактураВыданный.СоздатьДокумент();
	НовыйДокОбъект.Дата = Основание.Дата;
	НовыйДокОбъект.Номер = Основание.Номер;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ДокументОснование", Основание);
	Если ЗначениеЗаполнено(АктВыполненныхРабот) Тогда
		МассивОснований = Новый Массив;
		МассивОснований.Добавить(Основание);
		МассивОснований.Добавить(АктВыполненныхРабот);
		ДанныеЗаполнения.ДокументОснование = МассивОснований;
		ДанныеЗаполнения.Вставить("Корректировочный", Ложь);
		ДанныеЗаполнения.Вставить("Исправление", Ложь);
		ДанныеЗаполнения.Вставить("РеализацияЧерезКомиссионера", Ложь);
	КонецЕсли;
	ДанныеЗаполнения.Вставить("Организация", Основание.Организация);
	ДанныеЗаполнения.Вставить("ДатаВыставления", Основание.Дата);
	НовыйДокОбъект.Заполнить(ДанныеЗаполнения);
	Если НовыйДокОбъект.Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		НовыйДокОбъект.Валюта = Основание.Валюта;
	КонецЕсли;
	НовыйДокОбъект.Ответственный = ?(ЗначениеЗаполнено(СоздалЗаявку) И ТипЗнч(СоздалЗаявку) = ТИП("СправочникСсылка.Пользователи"), СоздалЗаявку, ПараметрыСеанса.ТекущийПользователь);
	НовыйДокОбъект.ПредставлениеНомера = Документы.СчетФактураВыданный.ПолучитьПредставлениеНомера(НовыйДокОбъект);
	ЗаполнитьЗначенияСвойств(НовыйДокОбъект, Основание, "Руководитель,ГлавныйБухгалтер");
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Сканы");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Если НовыйДокОбъект.Номер <> Основание.Номер Тогда
			НовыйДокОбъект.Номер = Основание.Номер;
			НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		//НовыйДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;                  
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция СоздатьДокументСчетНаОплатуКлиенту(УжеСозданныйДокумент = Неопределено, Основание)
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйДокОбъект = Документы.СчетНаОплатуКлиенту.СоздатьДокумент();
	НовыйДокОбъект.Дата = Основание.Дата;
	НомерДоговора = СокрЛП(Основание.Договор.Номер);
	НовыйДокОбъект.Заполнить(Основание);	
	НовыйДокОбъект.Менеджер = Основание.Менеджер;
	СтруктураОснования = Лико_Дополнительно.СформироватьОснованиеРеализацииПоДоговору(Основание.Договор, Основание.Дата, Истина);
	Если СтруктураОснования <> Неопределено И ЗначениеЗаполнено(СтруктураОснования.ТекстОснования) Тогда
		НовыйДокОбъект.ДополнительнаяИнформация = СтруктураОснования.ТекстОснования;
	КонецЕсли;
	
	НовыйДокОбъект.ГлавныйБухгалтер = Основание.ГлавныйБухгалтер;
	НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + Ссылка + """";
	
	Если НовыйДокОбъект.ЭтапыГрафикаОплаты.Количество() > 0 И НовыйДокОбъект.ЭтапыГрафикаОплаты.Итог("ПроцентПлатежа") < 100 Тогда
		НовыйДокОбъект.ЭтапыГрафикаОплаты[0].ПроцентПлатежа = НовыйДокОбъект.ЭтапыГрафикаОплаты[0].ПроцентПлатежа + 100 - НовыйДокОбъект.ЭтапыГрафикаОплаты.Итог("ПроцентПлатежа");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерДоговора) И СтрДлина(НомерДоговора) <=10 Тогда
		НовыйДокОбъект.Номер = Лико_Дополнительно.ПолучитьНомерДокументаДляСчетаНаОплатуКлиенту(НовыйДокОбъект, НомерДоговора);
	КонецЕсли;
	
	//Если УжеСозданныйДокумент = Неопределено Тогда
	//	// Попробуем найти документ с таким номером
	//	УжеСозданныйДокумент = Документы.СчетНаОплатуКлиенту.НайтиПоНомеру(НовыйДокОбъект.Номер, НовыйДокОбъект.Дата);
	//	Если НЕ ЗначениеЗаполнено(УжеСозданныйДокумент) Тогда
	//		УжеСозданныйДокумент = Неопределено;
	//	КонецЕсли;
	//КонецЕсли;		
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		СписокИсключаемыхРеквизитов = "Ссылка";
		Если НовыйДокОбъект.Номер = "" Тогда
			СписокИсключаемыхРеквизитов = СписокИсключаемыхРеквизитов + ",Номер";
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,СписокИсключаемыхРеквизитов);
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НомерДоЗаписи = НовыйДокОбъект.Номер;
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//НовыйДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		Если НовыйДокОбъект.Номер <> НомерДоЗаписи Тогда
			НовыйДокОбъект.Номер = НомерДоЗаписи;
			НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;                  
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция СоздатьДокументЛико_СчетНаОплатуКлиенту(УжеСозданныйДокумент = Неопределено, Реализация, АктВыполненныхРабот)
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйДокОбъект = Документы.Лико_СчетНаОплатуКлиенту.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(НовыйДокОбъект, Реализация, "Дата,Организация,Валюта,Менеджер,Партнер,Контрагент,Договор,Руководитель,ГлавныйБухгалтер,ЦенаВключаетНДС,ХозяйственнаяОперация");
	НомерДоговора = СокрЛП(Реализация.Договор.Номер);
	Если ЗначениеЗаполнено(НомерДоговора) И СтрДлина(НомерДоговора) <=10 Тогда
		НовыйДокОбъект.Номер = Лико_Дополнительно.ПолучитьНомерДокументаДляСчетаНаОплатуКлиенту(НовыйДокОбъект, НомерДоговора);
	КонецЕсли;
	НовыйДокОбъект.БанковскийСчет = Реализация.БанковскийСчетОрганизации;
	НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + Ссылка + """, т.к. в комплекте документов есть акт выполненных работ";
	
	Для каждого Строка из Реализация.Товары Цикл
		НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "Номенклатура,Характеристика,Количество,Цена,Сумма,СтавкаНДС,СуммаНДС,СуммаСНДС");
		НоваяСтрока.ЗаказКлиента = НоваяСтрока.Характеристика.Лико_ЗаказНоменклатуры;
	КонецЦикла;
	
	Для каждого Строка из АктВыполненныхРабот.Услуги Цикл
		НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "Номенклатура,Характеристика,Количество,Цена,Сумма,СтавкаНДС,СуммаНДС,СуммаСНДС,Содержание");
		НоваяСтрока.ЗаказКлиента = НоваяСтрока.Характеристика.Лико_ЗаказНоменклатуры;
	КонецЦикла;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		СписокИсключаемыхРеквизитов = "Ссылка";
		Если НовыйДокОбъект.Номер = "" Тогда
			СписокИсключаемыхРеквизитов = СписокИсключаемыхРеквизитов + ",Номер";
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,СписокИсключаемыхРеквизитов);
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	НовыйДокОбъект.ДополнительныеСвойства.Вставить("Лико_ПрограммноеСоздание");
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//НовыйДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;                  
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция СоздатьДокументПередачаТоваровМеждуОрганизациями(УжеСозданныйДокумент = Неопределено, ТЗТовары)
	
	Отказ = Ложь;  
	УстановитьПривилегированныйРежим(Истина);
	
	//ТоварыВРеализацию = Лико_Дополнительно.НайтиСтрокиВозвращаетТЗ(СтруктураПараметров.ТЗПродукция.Выгрузить(), Новый Структура("Контрагент,Валюта", СтруктураПараметров.Контрагент, СтруктураПараметров.Валюта));
	Если ТЗТовары.Количество() = 0 Тогда
		ОтменитьТранзакцию();
		Возврат Неопределено;
	КонецЕсли;
	ПерваяСтрока = ТЗТовары[0];
	
	НовыйДокОбъект = Документы.ПередачаТоваровМеждуОрганизациями.СоздатьДокумент();
	НовыйДокОбъект.Дата = ДатаОтгрузки;
	//Если ЗначениеЗаполнено(ПерваяСтрока.АдресДоставки) Тогда 
	//	НовыйДокОбъект.АдресДоставки = ПерваяСтрока.АдресДоставки;
	//Иначе
	//	НовыйДокОбъект.АдресДоставки = АдресДоставки;
	//КонецЕсли;
	ОрганизацияПродавец = Организация;
	Если ТипЗнч(Грузоотправитель) = Тип("СправочникСсылка.Организации") Тогда
		ОрганизацияПокупатель = Грузоотправитель;
	Иначе
		ОрганизацияПокупатель = Лико_Дополнительно.ПолучитьОрганизациюПоКонтрагенту(Грузоотправитель);
		Если НЕ ЗначениеЗаполнено(ОрганизацияПокупатель) Тогда
			Сообщить("" + Ссылка + ": контрагент, выбранный в грузоотправителе 1 (" + Грузоотправитель + "), не соответствует ни одной организации.");
			Отказ = Истина;
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	ВалютаЕвр = Константы.ВалютаУправленческогоУчета.Получить();
	ВалютаРуб = Константы.ВалютаРегламентированногоУчета.Получить();
	
	НовыйДокОбъект.Валюта = ПерваяСтрока.Валюта;
	НовыйДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияТоваровВДругуюОрганизацию;
	НовыйДокОбъект.Организация = ОрганизацияПродавец;
	НовыйДокОбъект.ЦенаВключаетНДС = Истина;
	НовыйДокОбъект.Склад = СкладГП;
	Если ТипЗнч(Грузоотправитель) = Тип("СправочникСсылка.Контрагенты") Тогда
		НовыйДокОбъект.БанковскийСчетГрузоотправителя = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(Грузоотправитель, ВалютаЕвр);
		НовыйДокОбъект.Грузоотправитель = Грузоотправитель;
	КонецЕсли;
	НовыйДокОбъект.НалогообложениеНДС = Справочники.Организации.НалогообложениеНДС(НовыйДокОбъект.Организация, НовыйДокОбъект.Склад, НовыйДокОбъект.Дата);
	НовыйДокОбъект.ДатаПлатежа = ДатаОтгрузки;
	НовыйДокОбъект.БанковскийСчетОрганизации = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(ОрганизацияПродавец, ВалютаЕвр);
	НовыйДокОбъект.БанковскийСчетОрганизацииПолучателя = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(ОрганизацияПокупатель, ВалютаЕвр);
	НовыйДокОбъект.ВалютаВзаиморасчетов = ВалютаЕвр;
	НовыйДокОбъект.ОрганизацияПолучатель = ОрганизацияПокупатель;
	НовыйДокОбъект.ПередачаПодДеятельность = НовыйДокОбъект.НалогообложениеНДС;
	НовыйДокОбъект.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	Отбор = Новый Структура("Валюта", НовыйДокОбъект.ВалютаВзаиморасчетов);
	НовыйДокОбъект.Курс = 1;
	НовыйДокОбъект.Кратность = 1;
	//Если НовыйДокОбъект.Валюта = ВалютаРуб Тогда	
	//	НовыйДокОбъект.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВРублях;
	//Иначе
	//	НовыйДокОбъект.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВВалюте;
	//КонецЕсли;
	НовыйДокОбъект.Менеджер = ПерваяСтрока.ЗаказКлиента.Менеджер;
	НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + Ссылка + """";
	
	Для каждого Строка из ТЗТовары Цикл
		НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = Строка.Номенклатура;
		НоваяСтрока.Характеристика = Строка.Характеристика;
		НоваяСтрока.Упаковка = Строка.Номенклатура.ЕдиницаИзмерения;
		НоваяСтрока.КоличествоУпаковок = Строка.КоличествоОтгружено;
		НоваяСтрока.Количество = Строка.КоличествоОтгружено;
		НоваяСтрока.Цена = 0.9 * 0.9 * Строка.Цена; // 90% от цены продажи Грузоотправителя 1 Грузоотправителю 2 (которая также составляет 90% от цены продажи Грузоотправителя 2 клиенту)
		НоваяСтрока.СтавкаНДС = Строка.СтавкаНДС;
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСумму");
		//СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", НовыйДокОбъект.НалогообложениеНДС);
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", Новый Структура("ЦенаВключаетНДС,СтавкаНДС", НовыйДокОбъект.ЦенаВключаетНДС, НоваяСтрока.СтавкаНДС));
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
	КонецЦикла;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//НовыйДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;                  
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция СоздатьДокументЛико_ПередачаТоваровМеждуОрганизациями(ТЗТовары, УжеСозданныйДокумент = Неопределено, ДляКаждойОтгрузкиСвойДокумент = Ложь)
	
	Отказ = Ложь;  
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТЗТовары.Количество() = 0 Тогда
		ОтменитьТранзакцию();
		Возврат Неопределено;
	КонецЕсли;
	
	ПерваяСтрока = ТЗТовары[0];
	ВалютаЕвро = Константы.ВалютаУправленческогоУчета.Получить();
	ОрганизацияВладелецСкладаГП = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, СкладГП, "ОрганизациявладелецТовара_45268c9975cc4604bdcfde6c95172d5f");
	
	Если ПерваяСтрока.ПлощадкаОрганизация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра
		ИЛИ ОрганизацияПродавецКлиенту = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра 
		ИЛИ ПерваяСтрока.ПлощадкаОрганизация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛинкс.ЗначениеПараметра 
		ИЛИ ОрганизацияПродавецКлиенту = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛинкс.ЗначениеПараметра
		ИЛИ ОрганизацияВладелецСкладаГП = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛинкс.ЗначениеПараметра
		Тогда
		ТипДокумента = Перечисления.Лико_ТипПередачиТоваровМеждуОрганизациями.РеализацияИПоступление;
	Иначе
		ТипДокумента = Перечисления.Лико_ТипПередачиТоваровМеждуОрганизациями.Интеркампани;
	КонецЕсли;
	
	// запрос вставляю здесь, чтобы потом можно было использовать его параметры для заполнения нового документа
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Валюта", ПерваяСтрока.Валюта);
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаОтгрузки));
	Запрос.УстановитьПараметр("ОрганизацияПокупатель", ОрганизацияПродавецКлиенту);
	Если ОрганизацияВладелецСкладаГП = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛинкс.ЗначениеПараметра Тогда
		Запрос.УстановитьПараметр("ОрганизацияПродавец", ОрганизацияВладелецСкладаГП);
	Иначе
		Запрос.УстановитьПараметр("ОрганизацияПродавец", ПерваяСтрока.ПлощадкаОрганизация);
	КонецЕсли;
	Запрос.УстановитьПараметр("СкладПродажи", СкладГП);
	Запрос.УстановитьПараметр("ТипДокумента", ТипДокумента);
	Запрос.УстановитьПараметр("НалогообложениеНДС", Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);
	Запрос.УстановитьПараметр("ЦенаВключаетНДС", Истина);
	
	Если ДляКаждойОтгрузкиСвойДокумент Тогда
		Если ЗначениеЗаполнено(УжеСозданныйДокумент) Тогда
			НовыйДокОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		Иначе
			НовыйДокОбъект = Документы.Лико_ПередачаТоваровМеждуОрганизациями.СоздатьДокумент();
		КонецЕсли;
	Иначе
		// Сначала попробуем найти документ
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ПередачаТоваровМеждуОрганизациями.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Лико_ПередачаТоваровМеждуОрганизациями КАК Лико_ПередачаТоваровМеждуОрганизациями
		|ГДЕ
		|	КОНЕЦПЕРИОДА(Лико_ПередачаТоваровМеждуОрганизациями.Дата, ДЕНЬ) = &Дата
		|	И Лико_ПередачаТоваровМеждуОрганизациями.ОрганизацияПродавец = &ОрганизацияПродавец
		|	И Лико_ПередачаТоваровМеждуОрганизациями.ОрганизацияПокупатель = &ОрганизацияПокупатель
		|	И Лико_ПередачаТоваровМеждуОрганизациями.СкладПродажи = &СкладПродажи
