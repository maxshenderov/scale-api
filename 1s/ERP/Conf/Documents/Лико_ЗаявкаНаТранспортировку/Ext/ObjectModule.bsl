	|	ВТ_СЦенамиИВалютами.Грузополучатель КАК Грузополучатель,
	|	ВТ_СЦенамиИВалютами.НомерСтрокиВЗаказеКлиента КАК НомерСтрокиВЗаказеКлиента,
	|	ВТ_СЦенамиИВалютами.ЗаказКлиента.Соглашение КАК Соглашение,
	|	ВТ_СЦенамиИВалютами.ЗаказКлиента.Регион КАК Регион,
	|	ВЫБОР
	|		КОГДА ВТ_СЦенамиИВалютами.ЗаказКлиента.Соглашение.ВалютаВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА ВТ_СЦенамиИВалютами.ЗаказКлиента.Договор.ВалютаВзаиморасчетов
	|		ИНАЧЕ ВТ_СЦенамиИВалютами.ЗаказКлиента.Соглашение.ВалютаВзаиморасчетов
	|	КОНЕЦ КАК ВалютаВзаиморасчетов,
	|	ВТ_СЦенамиИВалютами.КоличествоОтгружено КАК КоличествоОтгружено,
	|	&СтавкаНДСПоУмолчанию КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА &ТипОтгрузки В (ЗНАЧЕНИЕ(Перечисление.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиенту), ЗНАЧЕНИЕ(Перечисление.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения), ЗНАЧЕНИЕ(Перечисление.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуЧерезСкладРегиона), ЗНАЧЕНИЕ(Перечисление.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуСоСкладаХранения), ЗНАЧЕНИЕ(Перечисление.Лико_ТипыОтгрузкиГотовойПродукции.СписаниеСоСкладаХранения))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СоздаватьДокументыРеализацииВТранспортномМодуле,
	|	ВТ_СЦенамиИВалютами.Комментарий КАК Комментарий,
	|	ВТ_СЦенамиИВалютами.ЗаказКлиента.ЦенаДляДокументовВключаетНДС КАК ЦенаВключаетНДС,
	|	ВТ_КонтрагентыСДопРеквизитами.ПересчитыватьЦеныВЦеныБезНДС КАК ПересчитыватьЦеныВЦеныБезНДС,
	|	ВТ_КонтрагентыСДопРеквизитами.ТипСортировкиПриАвтоматическомСозданииРеализаций.Наименование КАК ТипСортировкиПриАвтоматическомСозданииРеализаций
	|ИЗ
	|	ВТ_СЦенамиИВалютами КАК ВТ_СЦенамиИВалютами
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КонтрагентыСДопРеквизитами КАК ВТ_КонтрагентыСДопРеквизитами
	|		ПО ВТ_СЦенамиИВалютами.Контрагент = ВТ_КонтрагентыСДопРеквизитами.Контрагент
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидНоменклатуры";		
	Запрос.УстановитьПараметр("Таблица", Таблица);	
	Запрос.УстановитьПараметр("ТипОтгрузки", ТипОтгрузки);	
	//Запрос.УстановитьПараметр("ДопРеквизитПартнера", Справочники.Лико_ПредопределенныеЗначения.ДопРеквизитПартнераСоздаватьДокументыРеализацииВТранспортномМодуле.ЗначениеПараметра);	
	Запрос.УстановитьПараметр("ДопРеквизитПартнераПересчитыватьЦены", ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "ПересчитыватьЦеныВЦеныБезНДСПриСозданииРеализаций_fe9b76240f4042419e569d14908c63fb"));	
	Если ДатаОтгрузки >= Дата('20260101') Тогда
		СтавкаНДСПоУмолчанию = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС22);
	ИначеЕсли ДатаОтгрузки >= Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияСтавкиНДС20.ЗначениеПараметра Тогда
		СтавкаНДСПоУмолчанию = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС20);
	Иначе
		СтавкаНДСПоУмолчанию = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС18);
	КонецЕсли;
	Запрос.УстановитьПараметр("СтавкаНДСПоУмолчанию", СтавкаНДСПоУмолчанию);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Таблица.Колонки.Добавить("Упаковка");
	Таблица.Колонки.Добавить("ЦенаЕвро");
	
	КурсВалюты = РегистрыСведений.КурсыВалют.СрезПоследних(ДатаОтгрузки, Новый Структура("Валюта", ВалютаУпрУчета));
	Курс = КурсВалюты[0].Курс;
	Если Курс = 0 Тогда
		Курс = 1;
	КонецЕсли;
	
	ПредыдущийВид = Неопределено;
	ПредыдущаяУпаковка = Неопределено;
	ЭтоСписание = ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.СписаниеСОрганизацииПроизводителя;
	УпаковкаТысШт = Справочники.Лико_ПредопределенныеЗначения.УпаковкаТысШт.ЗначениеПараметра;
	Для каждого Строка Из Таблица Цикл
		Если ЭтоСписание Тогда
			Строка.Регион = Неопределено;
		Иначе
			Если Строка.Регион = Справочники.БизнесРегионы.Производство Тогда
				Строка.Регион = Справочники.БизнесРегионы.Акватория;
			ИначеЕсли Строка.Регион = Справочники.БизнесРегионы.Авантаж Тогда
				Строка.Регион = Справочники.БизнесРегионы.Екатеринбург;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Строка.Валюта) Тогда
			Строка.Валюта = ВалютаУпрУчета;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Строка.Грузополучатель) Тогда
			Строка.Грузополучатель = Строка.Контрагент;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КорректировкаКонтрагент) Тогда
			Строка.Контрагент = КорректировкаКонтрагент;
		КонецЕсли;
		Если ЗначениеЗаполнено(КорректировкаГрузополучатель) Тогда
			Строка.Грузополучатель = КорректировкаГрузополучатель;
		КонецЕсли;
		Если ЗначениеЗаполнено(КорректировкаВалюта) Тогда
			Строка.Валюта = КорректировкаВалюта;
		КонецЕсли;
		Если ЗначениеЗаполнено(КорректировкаОтгрузкаВРублях) Тогда
			Если КорректировкаОтгрузкаВРублях = 1 Тогда
				Строка.ОтгрузкаВРублях = Истина;
			ИначеЕсли КорректировкаОтгрузкаВРублях = 2 Тогда
				Строка.ОтгрузкаВРублях = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		//Если ПредыдущийВид = Строка.ВидНоменклатуры Тогда
		//	Строка.Упаковка = ПредыдущаяУпаковка;
		//Иначе
		//	Строка.Упаковка = Лико_Дополнительно.ПолучитьУпаковкуПоУмолчаниюДляВидаНоменклатуры(Строка.Номенклатура.ВидНоменклатуры);
		//КонецЕсли;
		Строка.Упаковка = УпаковкаТысШт;
		
		Если Строка.Цена <> 0 Тогда
			Если Строка.ОтгрузкаВРублях И Строка.Валюта <> ВалютаРеглУчета Тогда
				Строка.Цена = Окр(Строка.Цена * Курс, 4);
				Строка.Валюта = ВалютаРеглУчета;
			КонецЕсли;
		Иначе
			// ХЗ что с этим делать, потому что цену поискали и в заявке на отгрузку, и в заказе в двух местах ("цена для документов" и просто "цена")
			// Поставлю очень большую цену - знак того, что нужно искать ошибку и переделывать накладную
			//Строка.Цена = 99999999;
			Если НЕ ЗначениеЗаполнено(Строка.Валюта) Тогда
				Строка.Валюта = ВалютаРеглУчета;
			КонецЕсли;
			Если ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиенту ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуЧерезСкладРегиона Тогда
				Строка.Цена = 99999999; // --> Начало Лико Ефимов ЕВВ 07.02.2022 Перенес установку цены внутрь условия наличия реализации
				Сообщить("" + Строка.Номенклатура + " / " + Строка.Характеристика + " / " + Строка.Контрагент + ": не найдена цена!!! Для формирования документов поставлена цена 999999, но это нужно исправлять!");
			КонецЕсли;
		КонецЕсли;
		Если Строка.ПересчитыватьЦеныВЦеныБезНДС
			И Строка.ЦенаВключаетНДС
			И ТипОтгрузки <> Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуСоСкладаХранения
			И ТипОтгрузки <> Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.СписаниеСоСкладаХранения 
			Тогда
			ТекПроцентНДС = Строка.СтавкаНДС.Ставка;
			Строка.Цена = Строка.Цена * 100 / (100+ТекПроцентНДС);
		КонецЕсли;
		Если Строка.Валюта = ВалютаУпрУчета Тогда
			Строка.ЦенаЕвро = Строка.Цена;
		Иначе
			Строка.ЦенаЕвро = Окр(Строка.Цена / Курс, 4);
		КонецЕсли;
		
		ПредыдущийВид = Строка.ВидНоменклатуры;
		ПредыдущаяУпаковка = Строка.Упаковка;
	КонецЦикла;
	//Таблица.Сортировать("СоздаватьДокументыРеализацииВТранспортномМодуле УБЫВ,Регион,Грузополучатель,Валюта");
	СтрокаСортировки = "СоздаватьДокументыРеализацииВТранспортномМодуле УБЫВ";
	Если ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладРегиона ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладРегиона2 ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуИСписаниеСОрганизацииПродавца Тогда
		СтрокаСортировки = СтрокаСортировки + ",Регион";
	КонецЕсли;
	СтрокаСортировки = СтрокаСортировки + ",Грузополучатель,Валюта";
	ТипСортировкиПриАвтоматическомСозданииРеализаций = Таблица[0].ТипСортировкиПриАвтоматическомСозданииРеализаций;
	Если ЗначениеЗаполнено(ТипСортировкиПриАвтоматическомСозданииРеализаций) Тогда
		Если ТипСортировкиПриАвтоматическомСозданииРеализаций = "Номер поставки" Тогда
			СтрокаСортировки = СтрокаСортировки + ",НомерПоставкиНаименование";
		ИначеЕсли ТипСортировкиПриАвтоматическомСозданииРеализаций = "Код этикетки заказчика" Тогда
			СтрокаСортировки = СтрокаСортировки + ",КодЭтикеткиЗаказчика";
		КонецЕсли;			
	КонецЕсли;
	СтрокаСортировки = СтрокаСортировки + ",НоменклатураНаименованиеПолное,ХарактеристикаНаименованиеПолное";
	Таблица.Сортировать(СтрокаСортировки);
	
	Возврат Таблица;
	
КонецФункции

