	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Таблица = Запрос.Выполнить().Выгрузить();
	// Получим номер первой строки, у которой заполнена заявка на отгрузку
	НомерПервойСтрокиСЗаявкойНаОтгрузку = -1;
	Для каждого Строка из Таблица Цикл
		Если Строка.НомерСтрокиВЗаявкеНаОтгрузку <> -1 Тогда
			НомерПервойСтрокиСЗаявкойНаОтгрузку = Строка.НомерСтрокиВЗаявкеНаОтгрузку;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Строка из Таблица Цикл
		Если Строка.НомерСтрокиВЗаявкеНаОтгрузку = -1 Тогда
			// Заявка не нашлась
			Отбор = Новый Структура();
			Отбор.Вставить("Номенклатура");
			Отбор.Вставить("Характеристика");
			Отбор.Вставить("Намотка");
			Отбор.Вставить("Город");
			Отбор.Вставить("КодЭтикеткиЗаказчика");
			Отбор.Вставить("ЧестныйЗнак");
			Отбор.Вставить("НомерПоставки");
			// Будем убирать по одному полю
			ЗаполнитьЗначенияСвойств(Отбор, Строка);
