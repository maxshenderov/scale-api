	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения И Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт И ДополнительныеСвойства.Свойство("ТолькоПровестиПоРегистрамДокумента") Тогда
			// не нужно	
		Иначе
			
			Таблица = Продукция.Выгрузить(,"Серия,Мест,НомерСтроки");
			Таблица.Очистить();
			Для каждого Строка из Продукция Цикл
				Если Строка.Мест > 0 Тогда
					НоваяСтрока = Таблица.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				КонецЕсли;
			КонецЦикла;
			
			ЗапросЯС = Новый Запрос;
			ЗапросЯС.Текст = "ВЫБРАТЬ
			|	Т.НомерСтроки,
			|	Т.Серия,
			|	Т.Мест
			|ПОМЕСТИТЬ ВТ
			|ИЗ
			|	&Таблица КАК Т
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ.НомерСтроки,
			|	ВТ.Серия,
			|	ВТ.Мест,
			|	МАКСИМУМ(Лико_АдресноеХранение.Период) КАК ДатаРазмещения,
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лико_АдресноеХранение.Паллет) КАК КоличествоРазличныхПаллет,
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лико_АдресноеХранение.Ячейка) КАК КоличествоРазличныхАдресХранения,
			|	МАКСИМУМ(ЕСТЬNULL(Лико_АдресноеХранение.Ячейка, НЕОПРЕДЕЛЕНО)) КАК Ячейка,
			|	МАКСИМУМ(Лико_АдресноеХранение.Паллет) КАК Паллет
			|ИЗ
			|	ВТ КАК ВТ
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_АдресноеХранение.СрезПоследних(&Период, Регистратор <> &Ссылка) КАК Лико_АдресноеХранение
			|		ПО (Лико_АдресноеХранение.Серия = ВТ.Серия)
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ.НомерСтроки,
			|	ВТ.Серия,
			|	ВТ.Мест";
			
			ЗапросЯС.УстановитьПараметр("Таблица", Таблица);
			ЗапросЯС.УстановитьПараметр("Ссылка", Ссылка);
			Если (Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт И ДополнительныеСвойства.Свойство("ТолькоПровестиПоРегистрамДокумента")) // Коловалов добавляет стоимость доставки
				ИЛИ ДополнительныеСвойства.Свойство("ПроверятьАдресноеХранениеНаДатуДокумента") // На всякий случай, вдруг нужно будет провести такой документ
				Тогда
				ЗапросЯС.УстановитьПараметр("Период", ДатаОтгрузки);
			Иначе
				ЗапросЯС.УстановитьПараметр("Период", Дата('39991231'));
			КонецЕсли;
			
			
			РезультатЗапросаЯС = ЗапросЯС.Выполнить();
			ВыборкаЯС = РезультатЗапросаЯС.Выбрать();
			
			ЯС_ТекстОшибки = "";
			ДатаПроведенияПоАдресномуСкладу = Дата;
			Пока ВыборкаЯС.Следующий() Цикл
				
				Если ВыборкаЯС.КоличествоРазличныхАдресХранения > 1 Тогда
					ЯС_ТекстОшибки = ЯС_ТекстОшибки + "Внимание! Коробка " + ВыборкаЯС.Серия + " находится по " + ВыборкаЯС.КоличествоРазличныхАдресХранения + " разным адресам" + Символы.ПС;
					Отказ = Истина;
				КонецЕсли;
				
				Если ВыборкаЯС.КоличествоРазличныхПаллет > 1 Тогда
					ЯС_ТекстОшибки = ЯС_ТекстОшибки + "Внимание! Коробка " + ВыборкаЯС.Серия+" находится по " + ВыборкаЯС.КоличествоРазличныхПаллет + " разным паллетам" + Символы.ПС;
					Отказ = Истина;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(ВыборкаЯС.Ячейка) Тогда
					ЯС_ТекстОшибки = ЯС_ТекстОшибки + "Внимание! Коробка (" + ВыборкаЯС.Серия + ") не зарегистрирована в ячеистом складе" + Символы.ПС;
					Отказ = Истина;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаЯС.Ячейка)
					И ВыборкаЯС.Ячейка.Владелец <> СкладГП
					И НЕ (Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт И ДополнительныеСвойства.Свойство("ТолькоПровестиПоРегистрамДокумента")) // У Коновалова проблемы из-за переноса ячеек ГП на основной склад
					Тогда
					ЯС_ТекстОшибки = ЯС_ТекстОшибки + "Внимание! Коробка (" + ВыборкаЯС.Серия + ") лежит на другом ячеистом складе (" + ВыборкаЯС.Ячейка.Владелец + ")" + Символы.ПС;
					Отказ = Истина;
				КонецЕсли;
				
				Если НЕ Отказ Тогда
					ДатаПроведенияПоАдресномуСкладу = ?(ДатаПроведенияПоАдресномуСкладу > ВыборкаЯС.ДатаРазмещения, ДатаПроведенияПоАдресномуСкладу, ВыборкаЯС.ДатаРазмещения + 1);
				КонецЕсли;	
			КонецЦикла;
			
			Если СокрЛП(ЯС_ТекстОшибки) <> "" Тогда
				Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("ОШИБКА! Есть ошибки по хранению: " + Символы.ПС + ЯС_ТекстОшибки);
			КонецЕсли;
			
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
			
			ВыборкаЯС.Сбросить();
			Пока ВыборкаЯС.Следующий() Цикл
				СтрокаПродукции = Продукция[ВыборкаЯС.НомерСтроки - 1];
				СтрокаПродукции.АдресХранения = ВыборкаЯС.Ячейка;
				СтрокаПродукции.Паллет = ВыборкаЯС.Паллет;
			КонецЦикла;
			
			ВыборкаЯС.Сбросить();
			
			ДополнительныеСвойства.Вставить("ВыборкаЯС", ВыборкаЯС);
		КонецЕсли;
		
		Если Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт И ЗначениеЗаполнено(НачалоСборки) И НЕ ЗначениеЗаполнено(ОкончаниеСборки) Тогда
			ОкончаниеСборки = ТекущаяДата();
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(АдресДоставкиЗначенияПолей) Тогда
		ОбщегоНазначенияУТВызовСервера.ЗаполнитьЗначенияПолейКИПоПредставлению(АдресДоставки, АдресДоставкиЗначенияПолей);
	КонецЕсли;
	
	ДатаОтгрузки = Макс(Дата, ДатаПроведенияПоАдресномуСкладу);
	РассчитатьСтоимостьДоставки();
	
	Если КорректировкаВалюта <> Ссылка.КорректировкаВалюта ИЛИ КорректировкаГрузополучатель <> Ссылка.КорректировкаГрузополучатель ИЛИ КорректировкаКонтрагент <> Ссылка.КорректировкаКонтрагент ИЛИ КорректировкаОтгрузкаВРублях <> Ссылка.КорректировкаОтгрузкаВРублях Тогда
		ДополнительныеСвойства.Вставить("ИзменилисьКорректируемыеПараметры", Истина);
	КонецЕсли;
	
	Если Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт И Ссылка.Статус <> Статус Тогда
		// Изменился статус на закрыт
		ДатаЗакладкиТермодатчиков = ТекущаяДата();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НачалоСборки) Тогда
		НачалоСборки = ТекущаяДата();
		Сборщик = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент) И Ссылка.Статус <> Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт Тогда
		ЛикоИспользоватьВыгрузкуEDIСообщений = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Контрагент, "ЛикоИспользоватьВыгрузкуEDIСообщений", Ложь);
		Если ЛикоИспользоватьВыгрузкуEDIСообщений И СтатусВыгрузкиЭлектронныхДокументов = 0 Тогда
			СтатусВыгрузкиЭлектронныхДокументов = 1;
		ИначеЕсли НЕ ЛикоИспользоватьВыгрузкуEDIСообщений И СтатусВыгрузкиЭлектронныхДокументов <> 0 Тогда
			СтатусВыгрузкиЭлектронныхДокументов = 0;
		КонецЕсли;
	КонецЕсли;
	
	// --> Начало Лико Яцун 02.02.2023 
	Если Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт 
		И (ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиенту 
		ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения 
		ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуСоСкладаХранения) Тогда
		Если СтатусОтправкиПакетаДокументовКлиентуПоПочте <> 2 Тогда
			КонтрагентДляОтправкиПакетаДокументовПоПочте = Неопределено;
			Если ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения Тогда
				Если ЗначениеЗаполнено(КорректировкаКонтрагент) Тогда
					КонтрагентДляОтправкиПакетаДокументовПоПочте = КорректировкаКонтрагент;
				Иначе
					МассивКонтрагентовДляОтправкиПакетаДокументовПоПочте = ПолучитьМассивКонтрагентовПартнеров();
					Если МассивКонтрагентовДляОтправкиПакетаДокументовПоПочте.Количество() = 1 Тогда
						КонтрагентДляОтправкиПакетаДокументовПоПочте = МассивКонтрагентовДляОтправкиПакетаДокументовПоПочте[0];
					КонецЕсли;
				КонецЕсли;
			Иначе
				КонтрагентДляОтправкиПакетаДокументовПоПочте = ?(ЗначениеЗаполнено(КорректировкаГрузополучатель), КорректировкаГрузополучатель, Контрагент);
			КонецЕсли;
				
			Если ЗначениеЗаполнено(КонтрагентДляОтправкиПакетаДокументовПоПочте) Тогда
				АдресЭлектроннойПочтыДляОтправкиПакетаДокументов = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(,КонтрагентДляОтправкиПакетаДокументовПоПочте,"АдресЭлектроннойПочтыДляОтправкиПакетаДокументов");
				Если ЗначениеЗаполнено(АдресЭлектроннойПочтыДляОтправкиПакетаДокументов) И СтатусОтправкиПакетаДокументовКлиентуПоПочте = 0 Тогда
					СтатусОтправкиПакетаДокументовКлиентуПоПочте = 1;
				ИначеЕсли НЕ ЗначениеЗаполнено(АдресЭлектроннойПочтыДляОтправкиПакетаДокументов) И СтатусОтправкиПакетаДокументовКлиентуПоПочте <> 0 Тогда
					СтатусОтправкиПакетаДокументовКлиентуПоПочте = 0;
				КонецЕсли;
			Иначе
				СтатусОтправкиПакетаДокументовКлиентуПоПочте = 0;
			КонецЕсли;
		КонецЕсли;
	Иначе
		СтатусОтправкиПакетаДокументовКлиентуПоПочте = 0;
	КонецЕсли;
	// <-- Конец Лико Яцун 02.02.2023
	
	Если НЕ Отказ
		И ЗначениеЗаполнено(Ссылка)
		И Ссылка.Проведен
		И Ссылка.ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения
		И Ссылка.Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт
		И НЕ ДополнительныеСвойства.Свойство("ТолькоПровестиПоРегистрамДокумента")
		И НЕ ДополнительныеСвойства.Свойство("ИзменитьИнформациюОПеревозчике")
		Тогда
		// Очистим контрагента-владельца в сериях ссылки. Если документ потом опять проведется, то контрагент заполнится обратно в проведении
		Для каждого Строка из Ссылка.Продукция Цикл
			Если Строка.Мест > 0 И ЗначениеЗаполнено(Строка.Серия.Лико_КонтрагентВладелецТовара) Тогда
				СерияОбъект = Строка.Серия.ПолучитьОбъект();
				СерияОбъект.Лико_КонтрагентВладелецТовара = Неопределено;
				СерияОбъект.ОбменДанными.Загрузка = Истина;
				Попытка
					СерияОбъект.Записать();
				Исключение
					Отказ = Истина;
					Сообщить("" + Ссылка + ": не удалось очистить контрагента-владельца в серии """ + СерияОбъект + """.");
					ВызватьИсключение;
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если НЕ Отказ
		И ЗначениеЗаполнено(Ссылка)
		И НЕ ДополнительныеСвойства.Свойство("ТолькоПровестиПоРегистрамДокумента")
		И НЕ ДополнительныеСвойства.Свойство("ИзменитьИнформациюОПеревозчике")
		Тогда 
		// Удалим записи из связанных регистров. Они создадутся еще раз при проведении документа
		УдалитьЗаписиИзЭтаповЗаказа();
		УдалитьЗаписиИзЛико_РегистрацияОтправкиДокументов();
	КонецЕсли;
			
КонецПроцедуры

Процедура УдалитьЗаписиИзЛико_РегистрацияОтправкиДокументов()

	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи = РегистрыСведений.Лико_РегистрацияОтправкиДокументов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = Ссылка.ДатаОтгрузки;
	МенеджерЗаписи.Пакет = Ссылка;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран()
		И МенеджерЗаписи.Статус = Перечисления.Лико_СтатусыОтправкиДокументов.Создан
		Тогда
		
		Попытка
			МенеджерЗаписи.Удалить();	
		Исключение
			Сообщить("Не удалось удалить запись из регистра ""лк Регистрация отправки документов"": " + ОписаниеОшибки());
			Отказ = Истина;
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьМассивКонтрагентовПартнеров(Тип = "Контрагент") // --> Начало Лико Яцун 02.02.2023
	
	ТаблицаСтрок = ЗаказыНаОтгрузку.Выгрузить();
	ТаблицаСтрок.Сортировать("НомерСтроки");
	ПартнерыМассив = Новый Массив;
	Для каждого Строка из ТаблицаСтрок Цикл
		Если Строка.КоличествоПодобранное > 0 Тогда
			СтруктураДляОтбора = Новый Структура("Характеристика,Намотка,Город,КодЭтикеткиЗаказчика,НомерПоставки,ЧестныйЗнак");
			ЗаполнитьЗначенияСвойств(СтруктураДляОтбора, Строка);
			НайденныеСтроки = Строка.ЗаявкаНаОтгрузку.Товары.НайтиСтроки(СтруктураДляОтбора);
			Если НайденныеСтроки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если Тип = "Контрагент" Тогда
				ПартнерыМассив.Добавить(НайденныеСтроки[0].Контрагент);
			ИначеЕсли Тип = "Партнер" Тогда
				ПартнерыМассив.Добавить(НайденныеСтроки[0].Контрагент.Партнер);
			Иначе
				ВызватьИсключение("В функцию ""ПолучитьМассивКонтрагентовПартнеров"" модуля объекта документа ""Лико_ЗаявкаНаТранспортировку"" передан несовместимый тип");
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	//ВспомогательнаяТаблица = Новый ТаблицаЗначений;
	//ВспомогательнаяТаблица.Колонки.Добавить("Значение");
	//
	//Для Инд = 0 По ПартнерыМассив.ВГраница() Цикл
	//	ВспомогательнаяТаблица.Добавить();
	//КонецЦикла;
	//
	//ВспомогательнаяТаблица.ЗагрузитьКолонку(ПартнерыМассив, "Значение");
	//ВспомогательнаяТаблица.Свернуть("Значение");
	//ВспомогательнаяТаблица.Сортировать("Значение");
	//
	//ПартнерыМассив = ВспомогательнаяТаблица.ВыгрузитьКолонку("Значение");

	ПартнерыМассив = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ПартнерыМассив);
	
	Возврат ПартнерыМассив;
	
КонецФункции // <-- Конец Лико Яцун 02.02.2023

Процедура ПересчитатьПодобранноеКоличество() Экспорт

	ТолькоСМестами = Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт ИЛИ Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Подтвержден;
	Для каждого СтрокаЗаказыНаОтгрузку из ЗаказыНаОтгрузку Цикл
		ЗаполнитьЗначенияСвойств(СтруктураСоответствияТЧ, СтрокаЗаказыНаОтгрузку);
		СтрокиПродукция = Продукция.НайтиСтроки(СтруктураСоответствияТЧ);
		КоличествоПодобранное = 0;
		Для каждого СтрокаПродукция из СтрокиПродукция Цикл
			Если ТолькоСМестами И СтрокаПродукция.Мест = 0 Тогда
				Продолжить;
			КонецЕсли;
			КоличествоПодобранное = КоличествоПодобранное + СтрокаПродукция.Количество;
		КонецЦикла;
		СтрокаЗаказыНаОтгрузку.КоличествоПодобранное = КоличествоПодобранное;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ДополнительныеСвойства.Свойство("Лико_ПровестиТолькоПоРНЛико_СтоимостьДоставки") ИЛИ ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьШтрихкод();
	
КонецПроцедуры

Процедура СоздатьШтрихкод() Экспорт
	
	Если НЕ РегистрыСведений.Лико_ШтрихкодыДокументов.Выбрать(Новый Структура("Док", Ссылка)).Следующий() Тогда
		ШтрихКод			= Лико_Дополнительно.ВычислитьКонтрольнуюСумму("2010" + Прав(Формат(Год(Дата), "ЧВН=; ЧГ="), 2) + Прав(Формат(Номер, "ЧВН=; ЧГ="), 5));
		МЗаписей			= РегистрыСведений.Лико_ШтрихкодыДокументов.СоздатьМенеджерЗаписи();
		МЗаписей.Док		= ЭтотОбъект.Ссылка;
		МЗаписей.ШтрихКод	= ШтрихКод;
		МЗаписей.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьТаблицуДляСозданияРеализаций()
	
	ВалютаРеглУчета = Константы.ВалютаРегламентированногоУчета.Получить(); //руб
	ВалютаУпрУчета = Константы.ВалютаУправленческогоУчета.Получить(); //euro
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Лико_ЗаявкаНаТранспортировкуПродукция.ЗаказКлиента КАК ЗаказКлиента,
