Процедура ПерезаполнитьКоличествоИзСерий()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Продукция.НомерСтроки КАК НомерСтроки,
	|	ВЫРАЗИТЬ(Продукция.Серия КАК Справочник.СерииНоменклатуры) КАК Серия,
	|	Продукция.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&Продукция КАК Продукция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	ВТ.Серия КАК Серия,
	|	ВТ.Количество КАК Количество,
	|	ВТ.Серия.Лико_КоличествоВУпаковке КАК КоличествоВСерии
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	ВТ.Количество <> ВТ.Серия.Лико_КоличествоВУпаковке";
	
	Запрос.УстановитьПараметр("Продукция", Продукция.Выгрузить(,"НомерСтроки,Серия,Количество"));
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Продукция[ВыборкаДетальныеЗаписи.НомерСтроки-1].Количество = ВыборкаДетальныеЗаписи.КоличествоВСерии;
	КонецЦикла;
	
КонецПроцедуры

