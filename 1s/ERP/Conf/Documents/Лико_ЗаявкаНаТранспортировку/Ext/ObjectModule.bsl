Перем КлючиСтруктуры;
Перем СтруктураСоответствияТЧ;
Перем ОрганизацияПродавецКлиенту;

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	//Если ДополнительныеСвойства.Свойство("Лико_ПровестиТолькоПоРНЛико_СтоимостьДоставки") Тогда
	//	Лико_СформироватьДвиженияПоРНЛико_СтоимостьДоставки(Отказ);
	//	Возврат;
	//КонецЕсли;
	
	//АдресХраненияТоваровВПути = ЛикоМодулиРаботыСоСкладамиСервер.ПолучитьСвойствоОбъекта("АдресХраненияТоваровВПути", СкладРегиона);
	//В УПП нет такого свойства "АдресХраненияТоваровВПути"
	Если Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт
		И СкладРегиона.ИспользоватьОрдернуюСхемуПриПоступлении
		И (ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения
		ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладРегиона // вряд ли нужен, но пусть будет на всякий случай
		ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладРегиона2
		ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеМеждуСкладамиХранения
		ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладОтвХраненияДругойПлощадки)
		Тогда
		Если ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеМеждуСкладамиХранения
			Тогда
			ЯчейкаПолучатель = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, СкладРегиона, "ЯчейкаХранениеПоУмолчанию");
		Иначе
			ЯчейкаПолучатель = Лико_Дополнительно.ПолучитьЗонуПриемкиПоСкладу(СкладРегиона);
		КонецЕсли;
		Для каждого Строка из Продукция Цикл
			Если Строка.Мест > 0 Тогда
				Движение = Движения.Лико_АдресноеХранение.Добавить();
				Движение.Период = ДатаОтгрузки;
				Движение.Регистратор = Ссылка;
				Движение.Серия = Строка.Серия;
				Движение.Паллет = Строка.Паллет;
				Движение.Ячейка = ЯчейкаПолучатель;
				Движение.ВыбылСоСклада = Ложь;
				Движение.Склад = СкладРегиона;
			КонецЕсли;
		КонецЦикла;
	Иначе
		АдресХраненияТоваровВПути = Неопределено;
		Движения.Лико_АдресноеХранение.Записывать = Истина;
		ВыборкаЯС = ДополнительныеСвойства.ВыборкаЯС;
		Пока ВыборкаЯС.Следующий() Цикл
			Если ВыборкаЯС.Мест = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Движение = Движения.Лико_АдресноеХранение.Добавить();
			// Если дата документа больше даты размещения, поставим ее, иначе поставим дату размещения + 1
			// В противном случае может получится ситуация: 1 числа создали заявку, 2 числа переместили коробку в другую ячейку, 3 числа ее подобрали в заявку.
			// Если сделать запись датой документа, то по регистру коробка останется в "другой ячейке" от 2 числа
			Движение.Период = ДатаПроведенияПоАдресномуСкладу;
			Движение.Регистратор = Ссылка;
			Движение.Серия = ВыборкаЯС.Серия;
			Движение.Паллет = ?(ЗначениеЗАполнено(АдресХраненияТоваровВПути), ВыборкаЯС.Паллет, Справочники.Лико_Паллеты.ПустаяСсылка());
			Движение.Ячейка = АдресХраненияТоваровВПути;
			Движение.ВыбылСоСклада = НЕ ЗначениеЗАполнено(АдресХраненияТоваровВПути);
		КонецЦикла;
	КонецЕсли;
	
	СформироватьДвиженияПоЛико_ЗаявкиНаОтгрузку();
	
	Если НЕ Отказ Тогда 
		//Если НЕ ЗначениеЗаполнено(АдресХраненияТоваровВПути) Тогда
		//	СхемаФормированияДокументов = ЛикоМодулиРаботыСоСкладами.ОпределитьСхемуФормированияДокументовРеализации(Грузоотправитель, Дата);
		//	ПерепровестиЗаявку(СхемаФормированияДокументов);
		//КонецЕсли;
		//
		//СостояниеЗаявки = Перечисления.ЛикоСостояниеЗаявокНаТранспортировку.Закрыт;
		//
		//ИзменитьСтатусЗаявки(СостояниеЗаявки, ЭтотОбъект.Дата);
	КонецЕсли;
	
	Если НЕ Отказ И Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт Тогда
		// Добавим записи в Лико_ЭтапыЗаказа
		ИспользованиеРеквизитаДокументВРегистреЭтапыЗаказа = Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияРеквизитаДокументВРегистреЭтапыЗаказа.ЗначениеПараметра <= ДатаОтгрузки;
		УстановитьПривилегированныйРежим(Истина);
		ТаблицаЗаказов = Продукция.Выгрузить(,"ЗаказКлиента,Количество,Мест");
		ТаблицаЗаказов.Очистить();
		Для каждого Строка из Продукция Цикл
			Если Строка.Мест > 0 Тогда
				ЗаполнитьЗначенияСвойств(ТаблицаЗаказов.Добавить(), Строка);
			КонецЕсли;
		КонецЦикла;
		ТаблицаЗаказов.Свернуть("ЗаказКлиента", "Количество");
		Для каждого Строка из ТаблицаЗаказов Цикл
			МенеджерЗаписи = РегистрыСведений.Лико_ЭтапыЗаказа.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = ДатаОтгрузки;
			МенеджерЗаписи.Заказ = Строка.ЗаказКлиента;
			МенеджерЗаписи.Площадка = Строка.ЗаказКлиента.Площадка;
			МенеджерЗаписи.Количество = Строка.Количество;
			МенеджерЗаписи.Этап = Справочники.Лико_ЭтапыВыполненияЗаказа.Отгрузка;
			//МенеджерЗаписи.Ответственный = ?(ЗначениеЗаполнено(СоздалЗаявку) И ТипЗнч(СоздалЗаявку) = ТИП("СправочникСсылка.Пользователи"), СоздалЗаявку, ПараметрыСеанса.ТекущийПользователь);
			МенеджерЗаписи.Ответственный = ?(ЗначениеЗаполнено(Кладовщик), Кладовщик, ПараметрыСеанса.ТекущийПользователь);
			МенеджерЗаписи.Комментарий = ТипОтгрузки;
			Если ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуИСписаниеСОрганизацииПродавца
				ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиенту
				Тогда
				// Нужен грузополучатель
				МенеджерЗаписи.Комментарий = МенеджерЗаписи.Комментарий + " (грузополучатель """ + Контрагент + """)";
			ИначеЕсли ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеМеждуСкладамиХранения
				ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладОтвХраненияДругойПлощадки
				ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеСоСкладаОтвХраненияДругойПлощадки
				Тогда
				// Нужно 2 склада
				МенеджерЗаписи.Комментарий = МенеджерЗаписи.Комментарий + " (со склада """ + СкладГП + """ на склад """ + СкладРегиона + """)";
			ИначеЕсли ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладРегиона2 
				ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения
                Тогда
				// Нужен склад региона
				МенеджерЗаписи.Комментарий = МенеджерЗаписи.Комментарий + " (склад """ + СкладРегиона + """)";
			ИначеЕсли ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.СписаниеСоСкладаХранения Тогда
				// Нужен склад ГП
				МенеджерЗаписи.Комментарий = МенеджерЗаписи.Комментарий + " (склад """ + СкладГП + """)";
			ИначеЕсли ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуСоСкладаХранения Тогда
				// Нужен грузополучатель и склад ГП
				МенеджерЗаписи.Комментарий = МенеджерЗаписи.Комментарий + " (грузополучатель """ + Контрагент + """, склад """ + СкладГП + """)";
			ИначеЕсли ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуЧерезСкладРегиона 
				ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладРегиона
				Тогда
				// Нужен грузополучатель и склад региона
				МенеджерЗаписи.Комментарий = МенеджерЗаписи.Комментарий + " (грузополучатель """ + Контрагент + """, склад """ + СкладРегиона + """)";
			КонецЕсли;
			
			Если ИспользованиеРеквизитаДокументВРегистреЭтапыЗаказа Тогда
				МенеджерЗаписи.Документ = Ссылка;
			КонецЕсли;
			Попытка
				МенеджерЗаписи.Записать(Истина);
			Исключение
				Сообщить("Не удалось добавить запись в регистр ""лк Этапы заказа"": " + ОписаниеОшибки());
				Отказ = Истина;
				Прервать;
			КонецПопытки;
			ИзменитьСтатусЗаказаНаЗакрыт(Строка.ЗаказКлиента);
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Лико_СформироватьДвиженияПоРНЛико_СтоимостьДоставки(Отказ);
	
	//Начало изменений Иванова А.В. 20190524
	Лико_СформироватьДвиженияПОЛико_ЗатратыПоЗаказу(Отказ);
	//Конец изменений Иванова А.В. 20190524
	
	Если ДополнительныеСвойства.Свойство("ТолькоПровестиПоРегистрамДокумента") Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ИзменитьИнформациюОПеревозчике") Тогда
		УстановитьПривилегированныйРежим(Истина);
		// Поменяем информацию о перевозчике
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК ТиповойДокумент
		|ИЗ
		|	РегистрСведений.Лико_СвязиСТиповымиДокументами КАК Лико_СвязиСТиповымиДокументами
		|ГДЕ
		|	(ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.Документ КАК Документ.Лико_ЗаявкаНаТранспортировку)) = &Документ
		|	И (Лико_СвязиСТиповымиДокументами.ТиповойДокумент ССЫЛКА Документ.РеализацияТоваровУслуг
		|			ИЛИ Лико_СвязиСТиповымиДокументами.ТиповойДокумент ССЫЛКА Документ.ТранспортнаяНакладная
		|			ИЛИ Лико_СвязиСТиповымиДокументами.ТиповойДокумент ССЫЛКА Документ.ПеремещениеТоваров)";
		
		Запрос.УстановитьПараметр("Документ", Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Перевозчик = ?(ЗначениеЗаполнено(Диспетчер), Диспетчер.Партнер, ПеревозчикЖДиАвиа.Партнер);
		Если ЗначениеЗаполнено(Перевозчик) И ЗначениеЗаполнено(АдресДоставки) Тогда
			СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчика;
		Иначе
			СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
		КонецЕсли;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Документ = ВыборкаДетальныеЗаписи.ТиповойДокумент;
			ТипДокумента = ТипЗнч(Документ);
			Если ТипДокумента = Тип("ДокументСсылка.РеализацияТоваровУслуг") ИЛИ ТипДокумента = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
				Если Документ.АдресДоставки <> АдресДоставки ИЛИ Документ.ПеревозчикПартнер <> Перевозчик Тогда
					ДокументОбъект = Документ.ПолучитьОбъект();
					ДокументОбъект.АдресДоставки = АдресДоставки;
					ДокументОбъект.АдресДоставкиЗначенияПолей = АдресДоставкиЗначенияПолей;
					ДокументОбъект.СпособДоставки = СпособДоставки;
					ДокументОбъект.ПеревозчикПартнер = Перевозчик;
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
			ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
				// Полностью переделаем ее
				СоздатьДокументТраспортнаяНакладная(Документ, Неопределено, Неопределено, Истина);
			КонецЕсли;	
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		Отказ = НЕ СоздатьТиповыеДокументы();
	КонецЕсли;
	//Если НЕ Отказ Тогда
	//	ПровестиПереупаковкиПаллет();
	//КонецЕсли;
	
КонецПроцедуры

Функция СоздатьТиповыеДокументы() Экспорт
	
	Отказ = Ложь;	
	Если ДополнительныеСвойства.Свойство("ЗаписьИзОтборРазмещениеТоваров") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Грузоотправитель2) Тогда
		ОрганизацияПродавецКлиенту = Грузоотправитель2;
	Иначе
		Если ТипЗнч(Грузоотправитель) = Тип("СправочникСсылка.Организации") Тогда
			ОрганизацияПродавецКлиенту = Грузоотправитель;
		Иначе
			ОрганизацияПродавецКлиенту = Лико_Дополнительно.ПолучитьОрганизациюПоКонтрагенту(Грузоотправитель);
			Если НЕ ЗначениеЗаполнено(ОрганизацияПродавецКлиенту) Тогда
				Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("" + Ссылка + ": контрагент, выбранный в грузоотправителе 1 (" + Грузоотправитель + "), не соответствует ни одной организации.");
				Отказ = Истина;
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
	
	ОрганизацияВладелецСкладаГП = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, СкладГП, "ОрганизациявладелецТовара_45268c9975cc4604bdcfde6c95172d5f");
	
	НачатьТранзакцию();
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ДополнительныеСвойства.Свойство("ИзменилисьКорректируемыеПараметры") И ДополнительныеСвойства.ИзменилисьКорректируемыеПараметры Тогда
		// Переделаем ключевые параметры в регистре Лико_СвязиСТиповымиДокументам
		Если НЕ ПеределатьКлючевыеПараметрыВСвязяхСТиповымиДокументами() Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаНовыхДокументов = Новый ТаблицаЗначений;
	ТаблицаНовыхДокументов.Колонки.Добавить("Документ");
	ТаблицаНовыхДокументов.Колонки.Добавить("Контрагент");
	ТаблицаНовыхДокументов.Колонки.Добавить("Валюта");
	ТаблицаНовыхДокументов.Колонки.Добавить("Регион");
	ЕстьРеализации = Ложь;
	
	// Перед тем как создавать, нужно сначала их все пометить на удаление. Причем ОтборРазмещениеТоваров_Перемещение и Лико_ПередачаТоваровМеждуОрганизациями трогать не нужно
	КлючиСтруктурыУдаляемыхДокументов = Лико_Дополнительно.ПолучитьКлючиСтруктурыБезДокумента(КлючиСтруктуры, "ОтборРазмещениеТоваров_Перемещение"); 
	КлючиСтруктурыУдаляемыхДокументов = Лико_Дополнительно.ПолучитьКлючиСтруктурыБезДокумента(КлючиСтруктурыУдаляемыхДокументов, "Лико_ПередачаТоваровМеждуОрганизациями"); 
	СтруктураТиповыхДокументовУдаление = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(Истина,, КлючиСтруктурыУдаляемыхДокументов, Ссылка,,"Лико_АвтоматическоеСоздание");
	Если СтруктураТиповыхДокументовУдаление = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Найдем ОтборРазмещениеТоваров_Перемещение 
	СтруктураТиповыхДокументов = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(,, "ОтборРазмещениеТоваров_Перемещение", Ссылка, Ложь);
	Если СтруктураТиповыхДокументов = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СкладГП.ИспользоватьАдресноеХранение Тогда
		
		Если НЕ ДополнительныеСвойства.Свойство("ЗаписьИзОтборРазмещениеТоваров") Тогда
			НовыйДокументОтборРазмещениеТоваров_Перемещение = СоздатьДокументОтборРазмещениеТоваров(СтруктураТиповыхДокументов.ОтборРазмещениеТоваров_Перемещение);
			Если НовыйДокументОтборРазмещениеТоваров_Перемещение = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаНовыхДокументов.Добавить();
		НоваяСтрока.Документ = НовыйДокументОтборРазмещениеТоваров_Перемещение;
		
	КонецЕсли;
	
	// Найдем Лико_ПередачаТоваровМеждуОрганизациями 
	// СтруктураТиповыхДокументов = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(,, "Лико_ПередачаТоваровМеждуОрганизациями", Ссылка, Ложь);
	//Если СтруктураТиповыхДокументов = Неопределено Тогда
	//	Возврат Ложь;
	//КонецЕсли;
	//Если ЗначениеЗаполнено(СтруктураТиповыхДокументов.Лико_ПередачаТоваровМеждуОрганизациями) Тогда
		// Нужно удалить из этого документа связанные строки
		УдалитьИзЛико_ПередачаТоваровМеждуОрганизациямиСвязанныеСтроки();
	//КонецЕсли;
	
	Если Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт Тогда
		
		//Типовые документы с пустым контрагентом и с пустой валютой
		ОтборТиповыхДокументов = Новый Структура("Контрагент,Валюта,Регион", Справочники.Контрагенты.ПустаяСсылка(), Справочники.Валюты.ПустаяСсылка(), Справочники.БизнесРегионы.ПустаяСсылка()); 
		СтруктураТиповыхДокументов = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(, ОтборТиповыхДокументов, КлючиСтруктуры, Ссылка, Ложь);
		Если СтруктураТиповыхДокументов = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		// Нужно создать реализации, расходные ордера и отборы из ячеек
		ПредыдущийКонтрагент = Неопределено;
		ПредыдущаяВалюта = Неопределено;
		ПредыдущийРегион = Неопределено;
		ПерваяСтрокаДляПеремещения = Истина;
		ТЗТовары = СформироватьТаблицуДляСозданияРеализаций();
		//МассивСчетов = ПолучитьМассивСчетов(ТЗТовары);
		//Если МассивСчетов.Количество() > 1 Тогда
		//	Сообщить("В заявках на отгрузку содержаться разные счета на предоплату. Закрытие невозможно. Необходимо разбить заявку на транспортировку на разные заявки (чтобы в каждой был только один счет на предоплату)");
		//	Возврат Ложь;
		//КонецЕсли;
		ТЗВсехСерий = Продукция.Выгрузить(,"Номенклатура,Характеристика,ЗаказКлиента,Контрагент,Намотка,Город,КодЭтикеткиЗаказчика,ЧестныйЗнак,НомерПоставки,Серия,Мест,ЗаявкаНаОтгрузку,Паллет");
		ТЗВсехСерий.Колонки.Добавить("Списано");
		// Если Мест = 0, сразу поставим признак Списано, чтобы эта серия не подбиралась
		Для каждого Строка из ТЗВсехСерий Цикл
			Строка.Списано = Строка.Мест = 0;
		КонецЦикла;
		
		ЭтоСписание = ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.СписаниеСОрганизацииПроизводителя;
		ЭтоРеализацияСПеремещениемНаСкладХранения = ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения;
		ЭтоПеремещениеСоСкладаХранения = (ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуСоСкладаХранения ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.СписаниеСоСкладаХранения ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеМеждуСкладамиХранения);
		ЭтоРеализацияКлиентуЧерезСкладРегиона = ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуЧерезСкладРегиона;
		ЭтоПеремещениеНаСкладХраненияДругойПлощадки = ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладОтвХраненияДругойПлощадки;
		ЭтоПеремещениеСоСкладаХрененияДругойПлощадки = ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеСоСкладаОтвХраненияДругойПлощадки;
		ЭтоРеализацияБезДенегСоСкладаХраненияДругойПлощадки = СкладГП.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараДругойПлощадкиСПравомПродажи И ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуИСписаниеСОрганизацииПродавца;
		АктВыполненныхРаботСоздан = Ложь;
		Ответственный = ?(ЗначениеЗаполнено(СоздалЗаявку) И ТипЗнч(СоздалЗаявку) = ТИП("СправочникСсылка.Пользователи"), СоздалЗаявку, ПараметрыСеанса.ТекущийПользователь);
		
		ЕстьПерепродажаСОрганизацииНаГрузоотправителя = Ложь;
		// Если грузополучателем выбран Окил для заказов или Окил для отгрузок, то это скорее всего пробники и отгружать будем на разные склады (в зависимости от регионов заказов)
		ОтгружаемНаРазныеСкладыВЗависимостиОтРегиона = НЕ ЭтоСписание
														И НЕ ЭтоПеремещениеНаСкладХраненияДругойПлощадки
														И НЕ ЭтоПеремещениеСоСкладаХрененияДругойПлощадки
														И НЕ СкладРегиона.ИспользоватьОрдернуюСхемуПриОтгрузке // при откгрузке на склад региона не нужно
														И СтрНайти(Контрагент.Наименование, "Окил для ") > 0;

		Если (ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиенту
				ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуИСписаниеСОрганизацииПродавца
				ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения
				ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуСоСкладаХранения
				ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.СписаниеСоСкладаХранения)
			И НЕ СозданНаОснованииПолученияГПИзПроизводства
			И Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, ТЗТовары[0].Контрагент.Партнер, "Лико_РегистрироватьОтправкуДокументов", Ложь)
			Тогда
			МенеджерЗаписи = РегистрыСведений.Лико_РегистрацияОтправкиДокументов.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = ДатаОтгрузки;
			МенеджерЗаписи.Пакет = Ссылка;
			МенеджерЗаписи.Статус = Перечисления.Лико_СтатусыОтправкиДокументов.Создан;
			Если ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения Тогда
				МенеджерЗаписи.Контрагент = ТЗТовары[0].Контрагент;
			Иначе
				МенеджерЗаписи.Контрагент = ?(ЗначениеЗаполнено(КорректировкаГрузополучатель), КорректировкаГрузополучатель, ?(ЗначениеЗаполнено(ТЗТовары[0].Грузополучатель), ТЗТовары[0].Грузополучатель, ТЗТовары[0].Контрагент));
			КонецЕсли;
			МенеджерЗаписи.Ответственный = ОтпускПроизвел;
			Попытка
				МенеджерЗаписи.Записать();
			Исключение
				Отказ = Истина;
				Сообщить("" + Ссылка + ": не удалось добавить записи в Лико_РегистрацияОтправкиДокументов: " + ОписаниеОшибки());
				ОтменитьТранзакцию();
				ВызватьИсключение;
				Возврат Ложь
			КонецПопытки;			
		КонецЕсли;
		
		Если 
			НЕ ЭтоСписание
			И НЕ ЭтоПеремещениеСоСкладаХранения
			И ТЗТовары[0].ПлощадкаОрганизация <> ОрганизацияПродавецКлиенту
			И (ТЗТовары[0].ПлощадкаОрганизация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра
				ИЛИ НЕ (ТЗТовары[0].ПлощадкаОрганизация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра     // ОКИЛ продает товар Ликофлекса - перепродажу создавать не нужно
						И ОрганизацияПродавецКлиенту = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияОкил.ЗначениеПараметра)
				ИЛИ (ОрганизацияВладелецСкладаГП = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛинкс.ЗначениеПараметра               // ОКИЛ продает товар Линкс
						И ОрганизацияПродавецКлиенту = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияОкил.ЗначениеПараметра)
			)
			И НЕ ЭтоПеремещениеНаСкладХраненияДругойПлощадки
			И НЕ ЭтоПеремещениеСоСкладаХрененияДругойПлощадки
			И НЕ ЭтоРеализацияБезДенегСоСкладаХраненияДругойПлощадки
			И СкладГП.Лико_ТипСкладаГотовойПродукции <> Перечисления.Лико_ТипыСкладовГотовойПродукции.Регион // Продают с ордерного склада региона, значит перепродажа между организациями уже сформирована (при отгрузке со склада производства)
			И НЕ (ОрганизацияВладелецСкладаГП = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛинкс.ЗначениеПараметра  // Для линкс ГП до 17 создавать не надо, если продает сам Линкс
					И ОрганизацияПродавецКлиенту = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛинкс.ЗначениеПараметра)
			Тогда
			
			ТоварыДляПередачи = ТЗТовары.Скопировать();
			ТоварыДляПередачи.Сортировать("Валюта");
			Для каждого Строка из ТоварыДляПередачи Цикл
				Если ПредыдущаяВалюта = Неопределено ИЛИ ПредыдущаяВалюта <> Строка.Валюта Тогда
					ОтборТиповыхДокументов = Новый Структура("Контрагент,Регион,Валюта", Справочники.Контрагенты.ПустаяСсылка(), Справочники.БизнесРегионы.ПустаяСсылка(), Строка.Валюта); 
					СтруктураТиповыхДокументовВалюта = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(, ОтборТиповыхДокументов, КлючиСтруктуры, Ссылка, Ложь);
					Если СтруктураТиповыхДокументовВалюта = Неопределено Тогда
						Возврат Ложь;
					КонецЕсли;
					
					Отбор = Новый Структура();
					Отбор.Вставить("Валюта", Строка.Валюта);
					ТоварыДляПередачиСОднойВалютой = ТоварыДляПередачи.Скопировать(Отбор);
					ДляКаждойОтгрузкиСвойДокумент = ТЗТовары[0].ПлощадкаОрганизация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра ИЛИ ОрганизацияВладелецСкладаГП = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛинкс.ЗначениеПараметра;
					НовыйДокументЛико_ПередачаТоваровМеждуОрганизациями = СоздатьДокументЛико_ПередачаТоваровМеждуОрганизациями(ТоварыДляПередачиСОднойВалютой, СтруктураТиповыхДокументовВалюта.Лико_ПередачаТоваровМеждуОрганизациями, ДляКаждойОтгрузкиСвойДокумент);
					Если НовыйДокументЛико_ПередачаТоваровМеждуОрганизациями = Неопределено Тогда
						Возврат Ложь;
					КонецЕсли;
					НоваяСтрока = ТаблицаНовыхДокументов.Добавить();
					НоваяСтрока.Документ = НовыйДокументЛико_ПередачаТоваровМеждуОрганизациями;
					НоваяСтрока.Валюта = Строка.Валюта;
					
					ЕстьПерепродажаСОрганизацииНаГрузоотправителя = Истина;
					
				КонецЕсли;
				ПредыдущаяВалюта = Строка.Валюта;
			КонецЦикла;
			ПредыдущаяВалюта = Неопределено;
		КонецЕсли;
		
		Для каждого Строка из ТЗТовары Цикл
			
			Если Строка.СоздаватьДокументыРеализацииВТранспортномМодуле Тогда
				
				//Если ПредыдущийКонтрагент = Неопределено ИЛИ Строка.Грузополучатель <> ПредыдущийКонтрагент ИЛИ ПредыдущаяВалюта = Неопределено ИЛИ Строка.Валюта <> ПредыдущаяВалюта ИЛИ Строка.Регион <> ПредыдущийРегион Тогда
				Если ПредыдущийКонтрагент = Неопределено ИЛИ Строка.Грузополучатель <> ПредыдущийКонтрагент ИЛИ ПредыдущаяВалюта = Неопределено ИЛИ Строка.Валюта <> ПредыдущаяВалюта Тогда
					
					ОтборТиповыхДокументов = Новый Структура("Контрагент,Валюта,Регион", Строка.Грузополучатель, Строка.Валюта, Строка.Регион); 
					СтруктураТиповыхДокументовКонтрагентВалютаРегион = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(, ОтборТиповыхДокументов, КлючиСтруктуры, Ссылка, Ложь);
					Если СтруктураТиповыхДокументовКонтрагентВалютаРегион = Неопределено Тогда
						Возврат Ложь;
					КонецЕсли;
					
					Отбор = Новый Структура();
					Отбор.Вставить("Грузополучатель", Строка.Грузополучатель);
					Отбор.Вставить("Валюта", Строка.Валюта);
					//Отбор.Вставить("Регион", Строка.Регион);
					ТоварыВРеализацию = ТЗТовары.Скопировать(Отбор);
					ТаблицаСерий = СформироватьТаблицуСерий(ТоварыВРеализацию, ТЗВсехСерий);
					СтрокаКолонокДляГруппировки = "";
					Для каждого Колонка из ТоварыВРеализацию.Колонки Цикл
						Если Колонка.Имя = "КодЭтикеткиЗаказчика" ИЛИ Колонка.Имя = "ЧестныйЗнак" ИЛИ Колонка.Имя = "НомерПоставки" ИЛИ Колонка.Имя = "Намотка" ИЛИ Колонка.Имя = "Город" ИЛИ Колонка.Имя = "КоличествоОтгружено" ИЛИ Колонка.Имя = "Мест" ИЛИ Колонка.Имя = "НомерСтрокиВЗаявкеНаОтгрузку" ИЛИ Колонка.Имя = "ЗаявкаНаОтгрузку" ИЛИ Колонка.Имя = "НомерСтрокиВЗаказеКлиента" Тогда   
							Продолжить;
						Иначе
							СтрокаКолонокДляГруппировки = СтрокаКолонокДляГруппировки + Колонка.Имя + ",";
						КонецЕсли;
					КонецЦикла;
					СтрокаКолонокДляГруппировки = Лев(СтрокаКолонокДляГруппировки, СтрДлина(СтрокаКолонокДляГруппировки) - 1);
