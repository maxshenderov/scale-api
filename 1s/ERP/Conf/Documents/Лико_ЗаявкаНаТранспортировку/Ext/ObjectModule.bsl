	КонецЕсли;
	//Если НЕ Отказ Тогда
	//	ПровестиПереупаковкиПаллет();
	//КонецЕсли;
КонецПроцедуры

Процедура УдалитьЗаписиИзЭтаповЗаказа() 
	
	ИспользованиеРеквизитаДокументВРегистреЭтапыЗаказа = Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияРеквизитаДокументВРегистреЭтапыЗаказа.ЗначениеПараметра <= ДатаОтгрузки;
	Если ИспользованиеРеквизитаДокументВРегистреЭтапыЗаказа Тогда
		Лико_Дополнительно.УдалитьЗаписиИзРегистраЛико_ЭтапыЗаказовПоДокументу(Ссылка);
	Иначе
		УстановитьПривилегированныйРежим(Истина);
		ТаблицаЗаказов = Ссылка.Продукция.Выгрузить(,"ЗаказКлиента,Количество");
		ТаблицаЗаказов.Свернуть("ЗаказКлиента", "Количество");
		Для каждого Строка из ТаблицаЗаказов Цикл
			МенеджерЗаписи = РегистрыСведений.Лико_ЭтапыЗаказа.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = Ссылка.ДатаОтгрузки;
			МенеджерЗаписи.Заказ = Строка.ЗаказКлиента;
			МенеджерЗаписи.Площадка = Строка.ЗаказКлиента.Площадка;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Этап = Справочники.Лико_ЭтапыВыполненияЗаказа.Отгрузка Тогда
				Попытка
					МенеджерЗаписи.Удалить();	
				Исключение
					Сообщить("Не удалось удалить запись из регистра ""лк Этапы заказа"": " + ОписаниеОшибки());
					Отказ = Истина;
					Прервать;
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьДвиженияПоЛико_ЗаявкиНаОтгрузку()
	
	Движения.Лико_ЗаявкиНаОтгрузку.Записывать = Истина;
	
	Если Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт Тогда
		МассивЗаявок = Новый Массив;
		МассивЗаказов = Новый Массив;
		МассивХарактеристик = Новый Массив;
		Для каждого Строка из Продукция Цикл
			Если Строка.Мест > 0 Тогда
				Если ЗначениеЗаполнено(Строка.ЗаявкаНаОтгрузку) И МассивЗаявок.Найти(Строка.ЗаявкаНаОтгрузку) = Неопределено Тогда
					МассивЗаявок.Добавить(Строка.ЗаявкаНаОтгрузку);
				КонецЕсли;
				Если МассивЗаказов.Найти(Строка.ЗаказКлиента) = Неопределено Тогда
					МассивЗаказов.Добавить(Строка.ЗаказКлиента);
				КонецЕсли;
				Если МассивХарактеристик.Найти(Строка.Характеристика) = Неопределено Тогда
					МассивХарактеристик.Добавить(Строка.Характеристика);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ЗаявкиНаОтгрузкуОстатки.ЗаказКлиента КАК ЗаказКлиента,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.Номенклатура КАК Номенклатура,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.Характеристика КАК Характеристика,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.ДокументОприходования КАК ДокументОприходования,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.Город КАК Город,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.Намотка КАК Намотка,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.Грузополучатель КАК Грузополучатель,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.НомерПоставки КАК НомерПоставки,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.КодЭтикеткиЗаказчика КАК КодЭтикеткиЗаказчика,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.ЧестныйЗнак КАК ЧестныйЗнак,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.КоличествоОстаток КАК Количество,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.КоличествоНеОтгруженоОстаток КАК КоличествоНеОтгружено
		|ИЗ
		|	РегистрНакопления.Лико_ЗаявкиНаОтгрузку.Остатки(
		|			,
		|			ДокументОприходования В (&ДокументыОприходования)
		|				И ЗаказКлиента В (&ЗаказыКлиентов)
		|				И Характеристика В (&МассивХарактеристик)) КАК Лико_ЗаявкиНаОтгрузкуОстатки";
		
		Запрос.УстановитьПараметр("ДокументыОприходования", МассивЗаявок);
		Запрос.УстановитьПараметр("ЗаказыКлиентов", МассивЗаказов);
		Запрос.УстановитьПараметр("МассивХарактеристик", МассивХарактеристик);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		МенятьСтатусЗаявки = Ложь;
		Пока Выборка.Следующий() Цикл
			Движение = Движения.Лико_ЗаявкиНаОтгрузку.Добавить();
			ЗаполнитьЗначенияСвойств(Движение, Выборка);
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = ДатаОтгрузки;
			МенятьСтатусЗаявки = Истина;
		КонецЦикла;
		Если МенятьСтатусЗаявки Тогда
			Для каждого ЗаявкаНаОтгрузку из МассивЗаявок Цикл
				Если ЗаявкаНаОтгрузку.СостояниеЗаявки <> Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт Тогда
					ЗаявкаНаОтгрузкуОбъект = ЗаявкаНаОтгрузку.ПолучитьОбъект();
					ЗаявкаНаОтгрузкуОбъект.СостояниеЗаявки = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт;
					ЗаявкаНаОтгрузкуОбъект.ОбменДанными.Загрузка = Истина;
					Попытка
						ЗаявкаНаОтгрузкуОбъект.Записать();
					Исключение
						Сообщить("Не удалось установить статус ""Закрыт"" документу """ + ЗаявкаНаОтгрузку + """: " + ОписаниеОшибки());
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;						
	Иначе
		// пока закомментил, т.к. кладовщики хотят видеть в ТМ заявки на отгрузку до тех пор, пока заявка на транспортировку не закроется
		//Для каждого Строка из ЗаказыНаОтгрузку Цикл
		//	Если ЗначениеЗаполнено(Строка.ЗаявкаНаОтгрузку) Тогда
		//		Движение = Движения.Лико_ЗаявкиНаОтгрузку.Добавить();
		//		ЗаполнитьЗначенияСвойств(Движение, Строка);
		//		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		//		Движение.ДокументОприходования = Строка.ЗаявкаНаОтгрузку;
		//		Движение.Период = Дата;
		//		Движение.Грузополучатель = Строка.Контрагент;
		//	КонецЕслИ;
		//КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьТаблицуСерий(ТоварыБезСерий, ТЗВсехСерий)
	
	ТаблицаСерий = ТЗВсехСерий.СкопироватьКолонки("Номенклатура,Характеристика,Серия,Паллет");
	ТаблицаСерий.Колонки.Добавить("Количество");
	ТаблицаСерий.Колонки.Добавить("КоличествоУпаковок");
	ТаблицаСерий.Колонки.Добавить("СтатусУказанияСерий");
	ТаблицаСерий.Колонки.Добавить("Упаковка");
	
	Отбор = Новый Структура("Номенклатура,Характеристика,ЗаказКлиента,Намотка,Город,НомерПоставки,КодЭтикеткиЗаказчика,ЧестныйЗнак,Списано,ЗаявкаНаОтгрузку");
	Отбор.Списано = Ложь;
	Для каждого Строка из ТоварыБезСерий Цикл
		
		ОсталосьСписатьСерий = Строка.КоличествоОтгружено;
		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		//Отбор.Контрагент = Строка.Грузополучатель;
		Серии = ТЗВсехСерий.НайтиСтроки(Отбор);
		Для каждого СтрокаСерии из Серии Цикл
			Если ОсталосьСписатьСерий <= 0 Тогда
				Прервать;
			КонецЕсли;
			НоваяСтрока = ТаблицаСерий.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСерии);
			НоваяСтрока.СтатусУказанияСерий = 8;
			НоваяСтрока.Количество = СтрокаСерии.Мест * СтрокаСерии.Серия.Лико_КоличествоВУпаковке;
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
			НоваяСтрока.Упаковка = Строка.Упаковка;
			СтрокаСерии.Списано = Истина;
			ОсталосьСписатьСерий = ОсталосьСписатьСерий - НоваяСтрока.Количество;
		КонецЦикла;
		Если ОсталосьСписатьСерий > 0 Тогда
			Сообщить("По складу списались не все коробки! Обязательно отправьте письмо программистам, пусть разбираются.");
		КонецЕсли;
	КонецЦикла;
	Возврат ТаблицаСерий;
	
КонецФункции

Процедура РассчитатьСтоимостьДоставки() Экспорт
	
	КурсДокумента = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Константы.ВалютаУправленческогоУчета.Получить(), ?(ЗначениеЗаполнено(ДатаОтгрузки), ДатаОтгрузки, Дата)).Курс;
	ОбщийВесКоробок = РассчитатьОбщийВесКоробок();
	//СтоимостьДоставкиЗаКг = ?(ОбщийВесКоробок = 0, 0, ОбщаяСтоимостьДоставки / ОбщийВесКоробок);
	ОбщаяСтоимостьДоставкиВЕвро = ?(КурсДокумента = 0, 0, ОбщаяСтоимостьДоставки / КурсДокумента);
	СтоимостьДоставкиВЕвроЗаКг = ?(ОбщийВесКоробок = 0, 0, ОбщаяСтоимостьДоставкиВЕвро / ОбщийВесКоробок);
	
	//Для каждого СтрокаЗаказыНаОтгрузку из ЗаказыНаОтгрузку Цикл
	//	Отбор = СтруктураСоответствияТЧ;
	//	ЗаполнитьЗначенияСвойств(Отбор, СтрокаЗаказыНаОтгрузку);
	//	СтрокиПродукция = Продукция.НайтиСтроки(Отбор);
	//	Если СтрокиПродукция.Количество() = 0 Тогда
	//		Продолжить;
	//	КонецЕсли;
	//	ВесКоробки = СтрокиПродукция[0].Серия.Лико_ВесКоробки;
	//	СтрокаЗаказыНаОтгрузку.Стоимость = СтоимостьДоставкиВЕвроЗаКг * ВесКоробки;
	//КонецЦикла;
	Для каждого Строка из Продукция Цикл
		Строка.Стоимость = 0;
	КонецЦикла;
	
	Таблица = Продукция.Выгрузить(, "НомерСтроки,Серия,Мест");
	Если Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Т.НомерСтроки,
	|	Т.Серия,
	|	Т.Мест
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&Таблица КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	ВТ.Серия.Лико_ВесКоробки * ВТ.Мест * &СтоимостьЗаКг КАК Стоимость
	|ИЗ
	|	ВТ КАК ВТ";
	
	Запрос.УстановитьПараметр("Таблица", Таблица);
	Запрос.УстановитьПараметр("СтоимостьЗаКг", СтоимостьДоставкиВЕвроЗаКг);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Продукция[ВыборкаДетальныеЗаписи.НомерСтроки-1].Стоимость = ВыборкаДетальныеЗаписи.Стоимость;
	КонецЦикла;
	
КонецПроцедуры

Функция РассчитатьОбщийВесКоробок() Экспорт
	
	Таблица = Продукция.Выгрузить(, "Серия,Мест");
	Если Таблица.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Т.Серия,
	|	Т.Мест
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&Таблица КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТ.Серия.Лико_ВесКоробки * ВТ.Мест) КАК Вес
	|ИЗ
	|	ВТ КАК ВТ";
	
	Запрос.УстановитьПараметр("Таблица", Таблица);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ОбщийВесКоробок = 0;
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ОбщийВесКоробок = ВыборкаДетальныеЗаписи.Вес;
	КонецЕсли;
	
	Возврат ОбщийВесКоробок;
	
КонецФункции

Функция ПолучитьПодразделениеПоРегиону(Регион)
	
	Подразделение = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Регион, "Подразделение_b50d06645caa487988f64db637024d3a");
	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
		Сообщить("В регионе """ + Регион + """ не заполнено подразделение");
		Возврат ПараметрыСеанса.ТекущийПользователь.Подразделение;
	Иначе
		Возврат Подразделение;
	КонецЕсли;
	
КонецФункции

Процедура ПровестиПереупаковкиПаллет()
	
	// Проведем все Формирования паллетов с типом "Переупаковка", содержащие серии документа
	// Смысл в том, что иногда возникают расхождения. Пример: кладовщик закачал коробки в заявку в 00:00, по регистру Товары в ячейках коробки переместились из ячейки "1"
	// в ячейку "Отгрузка". Потом кладовщик в 00:01 делает формирование паллета с типом "Переупаковка", система берет коробки из ячейки "Отгрузка" 
	// и кладет их в ячейку "Новые паллеты". В 00:02 кладовщик закрывает заявку, заявка еще раз проверяет где лежат коробки и берет коробку уже из "Новые паллеты" и опять кидает ее в "Отгрузка",
	// НО еще система сдвигает дату документа на дату последнего движения по ячеистоиму складу, т.е. на 00:02. Получается документ формирование паллета взял коробки из ячейки "Отгрузка", а на 00:01
	// коробки дежали не в "Отгрузка", а в ячейке "1" (дата-то сдвинулась). Перепроведем эти формирования и все встанет на свои места (формирование возьмет коробки уже из ячейки "1").
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Серия КАК Серия
	|ПОМЕСТИТЬ ВТ_СерииДокумента
	|ИЗ
	|	Документ.Лико_ЗаявкаНаТранспортировку.Продукция КАК Лико_ЗаявкаНаТранспортировкуПродукция
	|ГДЕ
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка = &Ссылка
	|	И Лико_ЗаявкаНаТранспортировкуПродукция.Мест > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лико_ФормированиеПаллета.Ссылка КАК Ссылка,
	|	Лико_ФормированиеПаллета.Дата КАК Дата
	|ИЗ
	|	Документ.Лико_ФормированиеПаллета КАК Лико_ФормированиеПаллета
	|ГДЕ
	|	Лико_ФормированиеПаллета.Содержимое.Серия В
	|			(ВЫБРАТЬ
	|				Т.Серия
	|			ИЗ
	|				ВТ_СерииДокумента КАК Т)
	|	И Лико_ФормированиеПаллета.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыФормированияПаллет.Переупаковка)
	|	И Лико_ФормированиеПаллета.Проведен
	|	И НЕ Лико_ФормированиеПаллета.ПометкаУдаления
	|	И Лико_ФормированиеПаллета.ЯчейкаПолучатель.Владелец = &Склад
	|	И Лико_ФормированиеПаллета.Дата >= &ДатаНачала
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ФормированиеПаллета.Ссылка,
	|	Лико_ФормированиеПаллета.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Лико_ФормированиеПаллета.Дата";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Склад", СкладГП);
	Запрос.УстановитьПараметр("ДатаНачала", ТекущаяДата() - 86400*3);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ШаблонЗапретаДанных = ДатыЗапретаИзменения.ШаблонДанныхДляПроверки();
		СтрокаШаблона = ШаблонЗапретаДанных.Добавить();
		СтрокаШаблона.Дата   = ВыборкаДетальныеЗаписи.Дата;
		Если ДатыЗапретаИзменения.НайденЗапретИзмененияДанных(ШаблонЗапретаДанных) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ФормированиеПаллетаОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ФормированиеПаллетаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			// не получилось
			а=0; // для возможности поставить точку останова
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура Лико_СформироватьДвиженияПоРНЛико_СтоимостьДоставки(Отказ)
	
	Движения.Лико_СтоимостьДоставки.Записывать = Истина;
	КурсДокумента = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Константы.ВалютаУправленческогоУчета.Получить(), ?(ЗначениеЗаполнено(ДатаОтгрузки), ДатаОтгрузки, Дата)).Курс;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка.ДатаОтгрузки КАК Период,
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка.СкладГП КАК Склад,
	|	Лико_ЗаявкаНаТранспортировкуПродукция.ЗаказКлиента КАК Заказ,
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Номенклатура КАК Номенклатура,
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Характеристика КАК Характеристика,
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Серия КАК Серия,
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Количество КАК Количество,
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Стоимость КАК Сумма,
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Стоимость * &Курс КАК СуммаРегл
	|ИЗ
	|	Документ.Лико_ЗаявкаНаТранспортировку.Продукция КАК Лико_ЗаявкаНаТранспортировкуПродукция
	|ГДЕ
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка = &Ссылка
	|	И Лико_ЗаявкаНаТранспортировкуПродукция.Мест > 0
	|	И Лико_ЗаявкаНаТранспортировкуПродукция.Стоимость > 0";
	
	Запрос.УстановитьПараметр("Курс", ?(ЗначениеЗаполнено(КурсДокумента), КурсДокумента, 1));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Движения.Лико_СтоимостьДоставки.Добавить(), ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
КонецПроцедуры

Процедура Лико_СформироватьДвиженияПОЛико_ЗатратыПоЗаказу(Отказ)
	УстановитьПривилегированныйРежим(Истина);
	
	Движения.Лико_ЗатратыПоЗаказу.Записывать = Истина;
	Движения.Лико_ЗатратыНаПродажи.Записывать = Истина;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка.ДатаОтгрузки КАК Период,
	|	Лико_ЗаявкаНаТранспортировкуПродукция.ЗаказКлиента КАК ЗаказКлиента,
	|	Лико_ЗаявкаНаТранспортировкуПродукция.ЗаказКлиента.РабочийЦентр КАК РабочийЦентр,
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ТранспортныеРасходы)) КАК СтатьяЗатрат,
	|	СУММА(Лико_ЗаявкаНаТранспортировкуПродукция.Количество) КАК Количество,
	|	СУММА(Лико_ЗаявкаНаТранспортировкуПродукция.Стоимость / 1.2) КАК Сумма,
	|	МАКСИМУМ(1) КАК НомерПроката,
	|	СУММА(Лико_ЗаявкаНаТранспортировкуПродукция.Стоимость) КАК СуммаПлан,
	|	СУММА(Лико_ЗаявкаНаТранспортировкуПродукция.Количество) КАК КоличествоПлан,
	|	СУММА(Лико_ЗаявкаНаТранспортировкуПродукция.Стоимость / 1.2) КАК Транспорт,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК Поле1,
	|	ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК Документ.РеализацияТоваровУслуг) КАК ДокументПродажи
	|ИЗ
	|	Документ.Лико_ЗаявкаНаТранспортировку.Продукция КАК Лико_ЗаявкаНаТранспортировкуПродукция
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_СвязиСТиповымиДокументами КАК Лико_СвязиСТиповымиДокументами
	|		ПО Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка = Лико_СвязиСТиповымиДокументами.Документ
	|			И (Лико_СвязиСТиповымиДокументами.ТиповойДокумент ССЫЛКА Документ.РеализацияТоваровУслуг)
	|			И (НЕ ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК Документ.РеализацияТоваровУслуг).ПометкаУдаления)
	|			И (ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК Документ.РеализацияТоваровУслуг).Проведен)
	|ГДЕ
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка = &Ссылка
	|	И Лико_ЗаявкаНаТранспортировкуПродукция.Мест > 0
	|	И (ВЫРАЗИТЬ(Лико_ЗаявкаНаТранспортировкуПродукция.Стоимость КАК ЧИСЛО(15, 2))) > 0
	|	И Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка.ОбщаяСтоимостьДоставки <> 1
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка.ДатаОтгрузки,
	|	Лико_ЗаявкаНаТранспортировкуПродукция.ЗаказКлиента,
	|	Лико_ЗаявкаНаТранспортировкуПродукция.ЗаказКлиента.РабочийЦентр,
	|	ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК Документ.РеализацияТоваровУслуг)";
	
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Движения.Лико_ЗатратыПоЗаказу.Добавить(), Выборка);
		Запись =  Движения.Лико_ЗатратыНаПродажи.Добавить();
		ЗаполнитьЗначенияСвойств(Запись,Выборка);
		Запись.Заказ = Выборка.ЗаказКлиента;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПеределатьКлючевыеПараметрыВСвязяхСТиповымиДокументами()
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписи = РегистрыСведений.Лико_СвязиСТиповымиДокументами.СоздатьНаборЗаписей();
	НаборЗаписи.Отбор.Документ.Установить(Ссылка);
	НаборЗаписи.Прочитать();
	
	Если КорректировкаОтгрузкаВРублях = 1 Тогда
		НоваяВалюта = Константы.ВалютаРегламентированногоУчета.Получить();
	Иначе
		Если ЗначениеЗаполнено(КорректировкаВалюта) Тогда
			НоваяВалюта = КорректировкаВалюта;
		ИначеЕсли ЗаказыНаОтгрузку.Количество() > 0 И ЗначениеЗаполнено(ЗаказыНаОтгрузку[0].Валюта) Тогда
			Если ЗаказыНаОтгрузку[0].ЗаявкаНаОтгрузку.Товары.Количество() > 0 И ЗаказыНаОтгрузку[0].ЗаявкаНаОтгрузку.Товары[0].ОтгрузкаВРублях Тогда
				НоваяВалюта = Константы.ВалютаРегламентированногоУчета.Получить();
			Иначе
				НоваяВалюта = ЗаказыНаОтгрузку[0].Валюта;
			КонецЕсли;
		ИначеЕсли Продукция.Количество() > 0 И Продукция[0].ЗаявкаНаОтгрузку.Товары.Количество() > 0 И ЗначениеЗаполнено(Продукция[0].ЗаявкаНаОтгрузку.Товары[0].ВалютаЦены) Тогда
			Если Продукция[0].ЗаявкаНаОтгрузку.Товары[0].ОтгрузкаВРублях Тогда
				НоваяВалюта = Константы.ВалютаРегламентированногоУчета.Получить();
			Иначе
				НоваяВалюта = Продукция[0].ЗаявкаНаОтгрузку.Товары[0].ВалютаЦены;
			КонецЕсли;
		Иначе
			НоваяВалюта = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Для каждого Запись из НаборЗаписи Цикл
		Если ЗначениеЗаполнено(Запись.Валюта) И ЗначениеЗаполнено(НоваяВалюта) Тогда
			Запись.Валюта = НоваяВалюта;
		КонецЕсли;
		Если ЗначениеЗаполнено(Запись.Контрагент) И ЗначениеЗаполнено(КорректировкаГрузополучатель) Тогда
			Запись.Контрагент = КорректировкаГрузополучатель;
		КонецЕсли;			
	КонецЦикла;
	
	Попытка
		НаборЗаписи.Записать(Истина);
	Исключение
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось записать данные в регистр сведений ЛикоСвязиСТиповымиДокументами! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Процедура УдалитьИзЛико_ПередачаТоваровМеждуОрганизациямиСвязанныеСтроки()

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ПередачаТоваровМеждуОрганизациями.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Лико_ПередачаТоваровМеждуОрганизациями КАК Лико_ПередачаТоваровМеждуОрганизациями
		|ГДЕ
		|	Лико_ПередачаТоваровМеждуОрганизациями.Товары.СвязанныйДокумент = &СвязанныйДокумент";
	
	Запрос.УстановитьПараметр("СвязанныйДокумент", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	
		ДокОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		
		МассивУдаляемыхСтрок = ДокОбъект.Товары.НайтиСтроки(Новый Структура("СвязанныйДокумент", Ссылка));
		
		Для каждого Строка из МассивУдаляемыхСтрок Цикл
			ДокОбъект.Товары.Удалить(Строка);
		КонецЦикла;
		
		Попытка
			Если ДокОбъект.Товары.Количество() = 0 И ДокОбъект.Проведен Тогда
				РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
			Иначе
				РежимЗаписи = ?(ДокОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
			КонецЕсли;
			ДокОбъект.Записать(РежимЗаписи);
		Исключение
			Отказ = Истина;
			Сообщить("Документ """ + ДокОбъект + """ не удалось выполнить операцию """ + РежимЗаписи + """ после удаления из него связанных строк! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;                  
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьАдресГрузоотправителя() Экспорт
	
	СтруктураВозврата = Новый Структура("Адрес,АдресЗначенияПолей");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление,
	|	КонтактнаяИнформация.ЗначенияПолей
	|ИЗ
	|	Справочник.Организации.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Ссылка = &Ссылка
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|	И КонтактнаяИнформация.Вид = &Вид";
	
	Запрос.УстановитьПараметр("Ссылка", Грузоотправитель);
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураВозврата.Адрес = Выборка.Представление;
		СтруктураВозврата.АдресЗначенияПолей = Выборка.ЗначенияПолей;
	Иначе
		СтруктураВозврата.Адрес = "";
		СтруктураВозврата.АдресЗначенияПолей = "";
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

