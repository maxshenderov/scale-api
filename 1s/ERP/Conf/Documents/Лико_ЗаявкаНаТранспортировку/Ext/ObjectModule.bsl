Функция СоздатьДокументПеремещениеТоваров(Таблица, УжеСозданныйДокумент = Неопределено, ТекущийСклад, ОрганизацияПеремещения, ЭтоПеремещениеСкладХраненияДругойПлощадки = Ложь)

	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	Если Таблица.Количество() = 0 Тогда
		ОтменитьТранзакцию();
		Возврат Неопределено;
	КонецЕсли;
	ПерваяСтрока = Таблица[0];

	НовыйДокОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
	НовыйДокОбъект.Дата = ДатаОтгрузки;
	НовыйДокОбъект.СкладОтправитель = СкладГП;
	НовыйДокОбъект.Организация = ОрганизацияПеремещения;
	Если НовыйДокОбъект.СкладОтправитель.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.Регион Тогда
		//НовыйДокОбъект.Организация = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, НовыйДокОбъект.СкладОтправитель, "ОрганизациявладелецТовара_45268c9975cc4604bdcfde6c95172d5f");
		//Если НЕ ЗначениеЗаполнено(НовыйДокОбъект.Организация) Тогда
			НовыйДокОбъект.Организация = Лико_Дополнительно.ОпределитьОрганизациюВладельцаТовара(ПерваяСтрока.Номенклатура, ПерваяСтрока.Характеристика, НовыйДокОбъект.СкладОтправитель, НовыйДокОбъект.Дата, УжеСозданныйДокумент);
		//КонецЕсли;
	КонецЕсли;
	Если ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеСоСкладаОтвХраненияДругойПлощадки
		ИЛИ (НовыйДокОбъект.СкладОтправитель.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараДругойПлощадкиСПравомПродажи
		И ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуИСписаниеСОрганизацииПродавца)
		Тогда
		НовыйДокОбъект.Организация = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, СкладГП, "ОрганизациявладелецТовара_45268c9975cc4604bdcfde6c95172d5f");
	КонецЕсли;
	НовыйДокОбъект.Ответственный = ?(ЗначениеЗаполнено(СоздалЗаявку) И ТипЗнч(СоздалЗаявку) = ТИП("СправочникСсылка.Пользователи"), СоздалЗаявку, ПараметрыСеанса.ТекущийПользователь);
	НовыйДокОбъект.СкладПолучатель = ТекущийСклад;
	НовыйДокОбъект.Статус = Перечисления.СтатусыПеремещенийТоваров.Принято;
	НовыйДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
	НовыйДокОбъект.Комментарий = ПерваяСтрока.Комментарий + Символы.ПС;
	НовыйДокОбъект.Комментарий = "" + НовыйДокОбъект.Комментарий + "Создан автоматически на основании документа """ + Ссылка + """";
	НовыйДокОбъект.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
	Перевозчик = ?(ЗначениеЗаполнено(Диспетчер), Диспетчер.Партнер, ПеревозчикЖДиАвиа.Партнер);
	Если ЗначениеЗаполнено(Перевозчик) И ЗначениеЗаполнено(АдресДоставки) Тогда
		НовыйДокОбъект.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчика;
		НовыйДокОбъект.ПеревозчикПартнер = Перевозчик;
		НовыйДокОбъект.АдресДоставки = АдресДоставки;
		НовыйДокОбъект.АдресДоставкиЗначенияПолей = АдресДоставкиЗначенияПолей;
	Иначе
		НовыйДокОбъект.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	КонецЕсли;

	ВалютаУпр = Константы.ВалютаУправленческогоУчета.Получить();
	КурсВалюты = РегистрыСведений.КурсыВалют.СрезПоследних(ДатаОтгрузки, Новый Структура("Валюта", ВалютаУпр));
	Курс = КурсВалюты[0].Курс;
	Если Курс = 0 Тогда
		Курс = 1;
	КонецЕсли;
	Если ДатаОтгрузки >= Дата('20260101') Тогда
		СтавкаНДС = 22;
	ИначеЕсли ДатаОтгрузки >= Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияСтавкиНДС20.ЗначениеПараметра Тогда
		СтавкаНДС = 20;
	Иначе
		СтавкаНДС = 18;
	КонецЕсли;
	Для каждого Строка из Таблица Цикл
		НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,, "Упаковка");
		НоваяСтрока.Количество = Строка.КоличествоОтгружено;
		НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		Если ЭтоПеремещениеСкладХраненияДругойПлощадки Тогда
			НоваяСтрока.Лико_Цена = Строка.ЦенаИзЗаказа;
			НоваяСтрока.Лико_ЦенаРегл = НоваяСтрока.Лико_Цена * Курс;
		Иначе
			НоваяСтрока.Лико_Цена = Строка.ЦенаЕвро;
			Если Строка.Валюта = ВалютаУпр Тогда
				НоваяСтрока.Лико_ЦенаРегл = Строка.ЦенаЕвро * Курс;
			Иначе
				НоваяСтрока.Лико_ЦенаРегл = Строка.Цена;
			КонецЕсли;
			Если НЕ Строка.ЦенаВключаетНДС Тогда
				НоваяСтрока.Лико_Цена = НоваяСтрока.Лико_Цена * (100 + СтавкаНДС) / 100;
				НоваяСтрока.Лико_ЦенаРегл = НоваяСтрока.Лико_ЦенаРегл * (100 + СтавкаНДС) / 100;
			КонецЕсли;
		КонецЕсли;

		НоваяСтрока.Лико_Сумма = НоваяСтрока.Количество * НоваяСтрока.Лико_Цена;
	КонецЦикла;

	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;

	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;

КонецФункции

Функция СоздатьДокументПриемкаТоваровНаХранение(Основание, УжеСозданныйДокумент = Неопределено) 
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйДокОбъект = Документы.ПриемкаТоваровНаХранение.СоздатьДокумент();
	НовыйДокОбъект.Склад = СкладРегиона;
	ТипОснования = ТипЗнч(Основание);
	Если ТипОснования = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ЗаполнитьЗначенияСвойств(НовыйДокОбъект, Основание, "Дата,Валюта,Партнер,Организация,Подразделение,Контрагент,Менеджер,Согласован");
		СписокРеквизитовТЧДляКопирования = "Номенклатура,Характеристика,Упаковка,КоличествоУпаковок,Количество,Цена,Сумма";
		ЦенаВключаетНДС = Основание.ЦенаВключаетНДС;
	ИначеЕсли ТипОснования = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		СписокРеквизитовТЧДляКопирования = "Номенклатура,Характеристика,Упаковка,КоличествоУпаковок,Количество";
		НовыйДокОбъект.Дата = Основание.Дата;
		НовыйДокОбъект.Подразделение = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, НовыйДокОбъект.Склад, "Подразделение_8b6aafc5a2e14ba0889da315170788bd");
		НовыйДокОбъект.Организация = СкладРегиона.Лико_Площадка.Организация;
		НовыйДокОбъект.Валюта = Константы.ВалютаУправленческогоУчета.Получить();
		НовыйДокОбъект.Контрагент = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Основание.Товары[0].Характеристика.Лико_ЗаказНоменклатуры.Площадка.Организация, "КонтрагентОрганизации_8e3f712fdca94791a890e1aa7853a0d2");
		НовыйДокОбъект.Партнер = НовыйДокОбъект.Контрагент.Партнер;
		НовыйДокОбъект.Менеджер = Основание.Ответственный;
		ЦенаВключаетНДС = Истина;
		НовыйДокОбъект.Согласован = Истина;
		Если НовыйДокОбъект.Дата >= Дата('20260101') Тогда
			СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС22);
		ИначеЕсли НовыйДокОбъект.Дата >= Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияСтавкиНДС20.ЗначениеПараметра Тогда
			СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС20);
		Иначе
			СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС18);
		КонецЕсли;
	КонецЕсли;
	
	НовыйДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПриемНаХранениеСПравомПродажи;
	НовыйДокОбъект.Договор = Лико_Дополнительно.НайтиИлиСоздатьДоговорНаОтветственноеХранение(НовыйДокОбъект.Дата, НовыйДокОбъект.Контрагент, НовыйДокОбъект.Организация, НовыйДокОбъект.Валюта);
	НовыйДокОбъект.Автор = ?(ЗначениеЗаполнено(СоздалЗаявку) И ТипЗнч(СоздалЗаявку) = ТИП("СправочникСсылка.Пользователи"), СоздалЗаявку, ПараметрыСеанса.ТекущийПользователь);
	НовыйДокОбъект.СпособДоставки = Перечисления.СпособыДоставки.СиламиПоставщикаДоНашегоСклада;
	НовыйДокОбъект.ВидЦеныПоставщика = Лико_Дополнительно.НайтиИлиСоздатьВидЦеныПоставщика(НовыйДокОбъект.Партнер, НовыйДокОбъект.Валюта, ЦенаВключаетНДС);
	НовыйДокОбъект.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
	НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + ЭтотОбъект + """";
	
	Для каждого Строка из Основание.Товары Цикл
		НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, СписокРеквизитовТЧДляКопирования);
		НоваяСтрока.Склад = НовыйДокОбъект.Склад;
		Если ТипОснования = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			// --> Начало Лико Ефимов ЕВВ 31.05.2023
			// Из документа ПриемкаТоваровНаХранение убрали признак НДС. Полагаю, что теперь цены должны быть всегда с НДС
			Если НЕ Основание.ЦенаВключаетНДС Тогда
				НоваяСтрока.Сумма = Строка.СуммаСНДС;
				НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.КоличествоУпаковок;
			КонецЕсли;
			// <-- Конец Лико Ефимов ЕВВ 31.05.2023
		ИначеЕсли ТипОснования = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
			НоваяСтрока.Цена = Строка.Лико_Цена;
			НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
			//НоваяСтрока.СтавкаНДС = СтавкаНДС;
			//СтруктураДействий = Новый Структура;
			//СтруктураДействий.Вставить("ПересчитатьСумму");
			//СтруктураДействий.Вставить("ПересчитатьСуммуНДС", Новый Структура("ЦенаВключаетНДС,СтавкаНДС", НовыйДокОбъект.ЦенаВключаетНДС, НоваяСтрока.СтавкаНДС));
			//СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
			//ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
		КонецЕсли;
	КонецЦикла;
	
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции 

Функция СоздатьДокументОтгрузкаТоваровСХранения(УжеСозданныйДокумент = Неопределено, ТоварыВРеализацию, ПеремещениеТоваров = Неопределено) 
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	ВалютаРуб = Константы.ВалютаРегламентированногоУчета.Получить();
	ОтветственноеХранениеТовараДругойПлощадкиСПравомПродажи = СкладГП.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараДругойПлощадкиСПравомПродажи;
	
	Если ЗначениеЗаполнено(ПеремещениеТоваров) Тогда
		ПерваяСтрока = ПеремещениеТоваров.Товары[0];
	Иначе
		ПерваяСтрока = ТоварыВРеализацию[0];
	КонецЕсли;
	
	НовыйДокОбъект = Документы.ОтгрузкаТоваровСХранения.СоздатьДокумент();
	Если ЗначениеЗаполнено(ПеремещениеТоваров) ИЛИ ОтветственноеХранениеТовараДругойПлощадкиСПравомПродажи Тогда
		НовыйДокОбъект.Контрагент = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, ПерваяСтрока.Характеристика.Лико_ЗаказНоменклатуры.Площадка.Организация, "КонтрагентОрганизации_8e3f712fdca94791a890e1aa7853a0d2");
		НовыйДокОбъект.Организация = СкладРегиона.Лико_Площадка.Организация;
		НовыйДокОбъект.Склад = СкладГП;
		НовыйДокОбъект.Подразделение = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, НовыйДокОбъект.Склад, "Подразделение_8b6aafc5a2e14ba0889da315170788bd");
		НовыйДокОбъект.Валюта = Константы.ВалютаУправленческогоУчета.Получить();
		НовыйДокОбъект.Партнер = НовыйДокОбъект.Контрагент.Партнер;
	Иначе
		НовыйДокОбъект.Контрагент = ПерваяСтрока.Контрагент;
		НовыйДокОбъект.Организация = ОрганизацияПродавецКлиенту;
		НовыйДокОбъект.Подразделение = ПолучитьПодразделениеПоРегиону(ПерваяСтрока.ЗаказКлиента.Регион);
		НовыйДокОбъект.Склад = СкладГП;
		НовыйДокОбъект.Валюта = ПерваяСтрока.Валюта;
		Если ПерваяСтрока.Грузополучатель <> ПерваяСтрока.Контрагент Тогда
			НовыйДокОбъект.Грузополучатель = ПерваяСтрока.Грузополучатель;
			НовыйДокОбъект.БанковскийСчетГрузополучателя = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(ПерваяСтрока.Грузополучатель, Константы.ВалютаРегламентированногоУчета.Получить());
		КонецЕсли;
		ПриСозданииОтгрузкиБратьПартнераИзКонтрагентаАНеИзЗаказа = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, ПерваяСтрока.Контрагент.Партнер, "ПриСозданииОтгрузкиБратьПартнераИзКонтрагентаАНеИзЗаказа_fca67e4d4a11435ca3926adb18a18d38", Ложь);
		Если ПриСозданииОтгрузкиБратьПартнераИзКонтрагентаАНеИзЗаказа Тогда
			НовыйДокОбъект.Партнер = ПерваяСтрока.Контрагент.Партнер;
		Иначе
			НовыйДокОбъект.Партнер = ПерваяСтрока.ЗаказКлиента.Партнер;
		КонецЕсли;
	КонецЕсли;
	
	НовыйДокОбъект.Дата = ДатаОтгрузки;
	НовыйДокОбъект.Менеджер = Менеджер; 
	
	НовыйДокОбъект.Договор = Лико_Дополнительно.НайтиИлиСоздатьДоговорНаОтветственноеХранение(НовыйДокОбъект.Дата, НовыйДокОбъект.Контрагент, НовыйДокОбъект.Организация, НовыйДокОбъект.Валюта);
	НовыйДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОтгрузкаПринятыхСПравомПродажиТоваровСХранения;
	НовыйДокОбъект.БанковскийСчетКонтрагента = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(НовыйДокОбъект.Контрагент, ВалютаРуб);
	НовыйДокОбъект.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	НовыйДокОбъект.Лико_ЭтоСписаниеСоСкладаОтветственногоХранения = ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.СписаниеСоСкладаХранения;
	НовыйДокОбъект.АдресДоставки = АдресДоставки;
	НовыйДокОбъект.АдресДоставкиЗначенияПолей = АдресДоставкиЗначенияПолей;
	НовыйДокОбъект.Комментарий = "" + НовыйДокОбъект.Комментарий + "Создан автоматически на основании документа """ + Ссылка + """";
	
	Если ПеремещениеТоваров = Неопределено Тогда
		Для каждого Строка из ТоварыВРеализацию Цикл
			НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
			НоваяСтрока.Номенклатура = Строка.Номенклатура;
			НоваяСтрока.Характеристика = Строка.Характеристика;
			НоваяСтрока.Упаковка = Строка.Номенклатура.ЕдиницаИзмерения;
			НоваяСтрока.КоличествоУпаковок = Строка.КоличествоОтгружено;
			НоваяСтрока.Количество = Строка.КоличествоОтгружено;
			Если ОтветственноеХранениеТовараДругойПлощадкиСПравомПродажи Тогда
				НоваяСтрока.Цена = Строка.ЦенаИзЗаказа;
			Иначе
				НоваяСтрока.Цена = Строка.Цена;
			КонецЕсли;
			//НоваяСтрока.СтавкаНДС = Строка.СтавкаНДС;
			НоваяСтрока.Склад = НовыйДокОбъект.Склад;
			
			Если НЕ ПерваяСтрока.ЦенаВключаетНДС Тогда
				// добавим НДС
				НоваяСтрока.Цена = НоваяСтрока.Цена * (100 + Строка.СтавкаНДС.Ставка) / 100;
			КонецЕсли;
			НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок;
			
			//СтруктураДействий = Новый Структура;
			//СтруктураДействий.Вставить("ПересчитатьСумму");
			//СтруктураДействий.Вставить("ПересчитатьСуммуНДС", Новый Структура("ЦенаВключаетНДС,СтавкаНДС", НовыйДокОбъект.ЦенаВключаетНДС, НоваяСтрока.СтавкаНДС));
			//СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
			//ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
		КонецЦикла;
	Иначе
		Для каждого Строка из ПеремещениеТоваров.Товары Цикл
			НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "Номенклатура,Характеристика,Упаковка,КоличествоУпаковок,Количество");
			НоваяСтрока.Склад = НовыйДокОбъект.Склад;
			НоваяСтрока.Цена = Строка.Лико_Цена;
			НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.КоличествоУпаковок;
			//НоваяСтрока.СтавкаНДС = СтавкаНДС;
			//СтруктураДействий = Новый Структура;
			//СтруктураДействий.Вставить("ПересчитатьСумму");
			//СтруктураДействий.Вставить("ПересчитатьСуммуНДС", Новый Структура("ЦенаВключаетНДС,СтавкаНДС", НовыйДокОбъект.ЦенаВключаетНДС, НоваяСтрока.СтавкаНДС));
			//СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
			//ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
		КонецЦикла;
	КонецЕсли;
	
	//НовыйДокОбъект.Товары.Сортировать("Характеристика,Номенклатура");
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер,Лико_ОбщаяСтоимостьДоставки,Лико_СкладДляРасчетаСтоимостиДоставки");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции 

Процедура ПриКопировании(ОбъектКопирования)
	
	Сканы = Ложь;
	ОбщаяСтоимостьДоставки = 0;
	СозданНаОснованииПолученияГПИзПроизводства = Ложь;
	СтатусВыгрузкиЭлектронныхДокументов = Неопределено;
	СтатусОтправкиПакетаДокументовКлиентуПоПочте = Неопределено;
	Комментарий = "";
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	//
	//Если ДополнительныеСвойства.Свойство("Лико_ПровестиТолькоПоРНЛико_СтоимостьДоставки") Тогда
	//	РассчитатьСтоимостьДоставки();
	//	Возврат;
	//КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Площадка) Тогда
		Сообщить("В документе """ + Ссылка + """ не заполнена площадка");
		Отказ = Истина;
	КонецЕсли;
	
	Если Площадка.Организация <> Организация Тогда
		Организация = Площадка.Организация;
	КонецЕсли;
	
	Если СозданНаОснованииПолученияГПИзПроизводства И НЕ РольДоступна("ПолныеПрава") И НЕ ДополнительныеСвойства.Свойство("Лико_СозданиеИзПолученияГПИзПроизводства") И НЕ ДополнительныеСвойства.Свойство("ЗаписьИзОтборРазмещениеТоваров") Тогда
		Сообщить("Документ создан на основании " + Метаданные.Документы.Лико_ПолучениеГПИзПроизводства.Представление() + ", корректировка запрещена");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) И Ссылка.Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт И НЕ ДополнительныеСвойства.Свойство("РазрешеноМенятьЗакрытуюЗаявку") И НЕ ДополнительныеСвойства.Свойство("ЗаписьИзОтборРазмещениеТоваров") Тогда
		Сообщить("Заявка уже закрыта. Изменения запрещены");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Дата > ТекущаяДата() И НЕ РольДоступна("ПолныеПрава") Тогда
		Сообщить("Дата (и время) документа не может быть больше текущей даты");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если НЕ СкладГП.ИспользоватьОрдернуюСхемуПриОтгрузке Тогда
		Сообщить("Складом ГП возможно выбрать только ордерные склады");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) И Ссылка.СкладГП <> СкладГП И (Ссылка.Продукция.Количество() > 0 ИЛИ Продукция.Количество() > 0) Тогда
		// Меняют склад ГП в заявке, у которой уже есть коробки
		Сообщить("Для изменения склада ГП необходимо сначала очистить таблицу ""Продукция"", затем сохранить заявку, а уже после этого изменить склад");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт Тогда // Проверки для закрытых заявок
		
		Если Продукция.Итог("Мест") = 0 Тогда
			Сообщить("Запись в статусе ""Закрыт"" невозможна, т.к. не отобрано ни одной коробки");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(АдресДоставки)
			И ТипОтгрузки <> Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.СписаниеСОрганизацииПроизводителя
			И ТипОтгрузки <> Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения
			И ТипОтгрузки <> Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеМеждуСкладамиХранения
			Тогда
			Сообщить("Нужно заполнить адрес доставки");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если (ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуСПеремещениемНаСкладХранения
			//ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.СписаниеСоСкладаХранения
			//ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуСоСкладаХранения
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеМеждуСкладамиХранения
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладОтвХраненияДругойПлощадки
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеСоСкладаОтвХраненияДругойПлощадки)
			И НЕ ЗначениеЗаполнено(СкладРегиона) Тогда
			Сообщить("Нужно заполнить склад хранения");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если (ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладРегиона
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладРегиона2 
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуИСписаниеСОрганизацииПродавца 
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуЧерезСкладРегиона) 
			И НЕ ЗначениеЗаполнено(СкладРегиона) Тогда
			Сообщить("Нужно заполнить склад региона");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТипОтгрузки) И НЕ ДополнительныеСвойства.Свойство("ТолькоПровестиПоРегистрамДокумента") Тогда
			Сообщить("Нужно заполнить тип отгрузки");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Грузоотправитель) И НЕ ДополнительныеСвойства.Свойство("ТолькоПровестиПоРегистрамДокумента") Тогда
			Сообщить("Нужно заполнить грузоотправителя");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если Грузоотправитель = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра И ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуИСписаниеСОрганизацииПродавца Тогда
			Сообщить("Для списания этикетки с организации ""Ликофлекс"" необходимо выбирать тип отгрузки ""Списание со склада производства""");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если (ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуИСписаниеСОрганизацииПродавца 
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладРегиона 
			//ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладРегиона2 
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуЧерезСкладРегиона)
			И (НЕ ЗначениеЗаполнено(СкладРегиона)
			ИЛИ СкладРегиона.ИспользоватьОрдернуюСхемуПриОтгрузке) Тогда
			Сообщить("Для выбранного типа отгрузки нужно выбрать склад региона (неордерный)");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если (ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеМеждуСкладамиХранения 
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладОтвХраненияДругойПлощадки 
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеСоСкладаОтвХраненияДругойПлощадки)
			И (НЕ ЗначениеЗаполнено(СкладРегиона)
			ИЛИ НЕ СкладРегиона.ИспользоватьОрдернуюСхемуПриОтгрузке) Тогда
			Сообщить("Для выбранного типа отгрузки нужно выбрать склад региона (ордерный)");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если (ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеСоСкладаОтвХраненияДругойПлощадки И СкладГП.Лико_ТипСкладаГотовойПродукции <> Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараДругойПлощадки И СкладГП.Лико_ТипСкладаГотовойПродукции <> Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараДругойПлощадкиСПравомПродажи)
			ИЛИ (ТипОтгрузки <> Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеСоСкладаОтвХраненияДругойПлощадки И СкладГП.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараДругойПлощадки)
			Тогда
			Отказ = Истина;
			Сообщить("Для склада """ + СкладГП + """ недоступен тип отгрузки """ + ТипОтгрузки + """");
		КонецЕсли;
		
		Если (СкладРегиона.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараДругойПлощадки И ТипОтгрузки <> Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладОтвХраненияДругойПлощадки)
			ИЛИ (СкладРегиона.Лико_ТипСкладаГотовойПродукции <> Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараДругойПлощадки И СкладРегиона.Лико_ТипСкладаГотовойПродукции <> Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараДругойПлощадкиСПравомПродажи И ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладОтвХраненияДругойПлощадки)
			Тогда
			Отказ = Истина;
			Сообщить("Для склада """ + СкладРегиона + """ недоступен тип отгрузки """ + ТипОтгрузки + """");
		КонецЕсли;
		
		Если СкладГП.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараДругойПлощадкиСПравомПродажи
			И НЕ (ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиенту
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеСоСкладаОтвХраненияДругойПлощадки
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.РеализацияКлиентуЧерезСкладРегиона
			ИЛИ ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуИСписаниеСОрганизацииПродавца) Тогда
			Отказ = Истина;
			Сообщить("Для склада """ + СкладГП + """ недоступен тип отгрузки """ + ТипОтгрузки + """");
		КонецЕсли;
		
		Если (ТипОтгрузки = Перечисления.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеНаСкладОтвХраненияДругойПлощадки)
			И СкладРегиона.Лико_Площадка.Организация = Организация Тогда
			Отказ = Истина;
