	//Если СтруктураТиповыхДокументов = Неопределено Тогда
	//	Отказ = Истина;
	//КонецЕсли;
	//Если НЕ Отказ И ЗначениеЗаполнено(СтруктураТиповыхДокументов.Лико_ПередачаТоваровМеждуОрганизациями) Тогда
		// Нужно удалить из этого документа связанные строки
		УдалитьИзЛико_ПередачаТоваровМеждуОрганизациямиСвязанныеСтроки();
	//КонецЕсли;
	//Если НЕ Отказ Тогда
	//	// Удалим запись из Лико_ЭтапыЗаказа
	//	УдалитьЗаписиИзЭтаповЗаказа();
	//КонецЕсли;
	Если НЕ Отказ Тогда
