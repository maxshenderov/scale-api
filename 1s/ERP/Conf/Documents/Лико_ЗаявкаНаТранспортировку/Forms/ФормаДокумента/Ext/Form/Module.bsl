&НаСервере
Функция ПолучитьИмяГрузоотправителя()
	Если ЗначениеЗаполнено(Объект.Грузоотправитель2) Тогда
		ИмяГрузоотправителя = "Грузоотправитель2";
	ИначеЕсли ЗначениеЗаполнено(Объект.Грузоотправитель) Тогда
		ИмяГрузоотправителя = "Грузоотправитель";
	Иначе
		ИмяГрузоотправителя = "Организация";
	КонецЕсли;
	
	Возврат ИмяГрузоотправителя;
КонецФункции

&НаСервере
Процедура ВодительПриИзмененииНаСервере()
	
	// Попробуем найти грузоперевозчика и машину
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТранспортныеСредстваЛико_Водители.Ссылка КАК Машина,
		|	ТранспортныеСредстваЛико_Водители.Ссылка.Лико_Грузоперевозчик КАК Диспетчер
		|ИЗ
		|	Справочник.ТранспортныеСредства.Лико_Водители КАК ТранспортныеСредстваЛико_Водители
		|ГДЕ
		|	ТранспортныеСредстваЛико_Водители.Водитель = &Водитель
		|	И НЕ ТранспортныеСредстваЛико_Водители.Ссылка.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТранспортныеСредстваЛико_Водители.Ссылка.Код УБЫВ";
	
	Запрос.УстановитьПараметр("Водитель", Объект.Водитель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Объект, Выборка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВодительПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Водитель) Тогда
		ВодительПриИзмененииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КладовщикПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Кладовщик) Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ОтпускПроизвел) Тогда
			Объект.ОтпускПроизвел = Объект.Кладовщик;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.ОтпускРазрешил) Тогда
			Объект.ОтпускРазрешил = Объект.Кладовщик;
		КонецЕсли;
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ЗаказыНаОтгрузкуПередУдалением(Элемент, Отказ)
	
	МассивСтрокДляУдаления = Новый Массив;
	Для каждого ВыделеннаяСтрока из Элемент.ВыделенныеСтроки Цикл
		Строка = Объект[Элемент.Имя].НайтиПоИдентификатору(ВыделеннаяСтрока);
		// Найдем строки Продукции
		Отбор = Новый Структура("ЗаказКлиента,Номенклатура,Характеристика,Контрагент,Намотка,КодЭтикеткиЗаказчика,ЧестныйЗнак,НомерПоставки,Город,ЗаявкаНаОтгрузку");
		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		СтрокиПродукции = Объект.Продукция.НайтиСтроки(Отбор);
		Для каждого СтрокаПродукции из СтрокиПродукции Цикл
			Если СтрокаПродукции.Мест > 0 Тогда
				Отказ = Истина;
				Сообщить("Для строки №" + Строка.НомерСтроки + " есть отобранные коробки, удаление таких заявок запрещено. Сначала очистите эти коробки через форму обработки заявки");
			Иначе
				МассивСтрокДляУдаления.Добавить(СтрокаПродукции);
			КонецЕсли;			
		КонецЦикла;
	КонецЦикла;
	Если НЕ Отказ Тогда
		Для каждого Строка из МассивСтрокДляУдаления Цикл
			Объект.Продукция.Удалить(Строка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВодительНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	фиксНастройки = Новый НастройкиКомпоновкиДанных;
	
	эОтбор = фиксНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	эОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Родитель");
	эОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	эОтбор.ПравоеЗначение = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Справочники.Лико_ПредопределенныеЗначения.ГруппаФизическихЛицВодители.ЗначениеПараметра");
	эОтбор.Использование = Истина;
	
	ПараметрыОтбора = Новый Структура;    
	ПараметрыОтбора.Вставить("ФиксированныеНастройки", фиксНастройки);
	ПараметрыОтбора.Вставить("РежимВыбора", Истина);
	ПараметрыОтбора.Вставить("Лико_РежимПросмотра", ОтображениеТаблицы.Список);
	
	ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора", ПараметрыОтбора,,,,, Новый ОписаниеОповещения("Лико_ВыбранВодитель", ЭтотОбъект));
	
КонецПроцедуры

