&НаКлиенте
Процедура ДобавитьВУпаковку(Команда)
	
	ПереносимыеСтроки = Объект.ЗаказыНаОтгрузку.НайтиСтроки(Новый Структура("ВыбранныеСтроки", Истина));
	Если ПереносимыеСтроки.Количество() = 0 Тогда
		Сообщить("Не выбрано ни одной строки.");	
	Иначе
		ИдентификаторыПереносимыхСтрок = Новый Массив;
		Для каждого ПереносимаяСтрока из ПереносимыеСтроки Цикл
			ИдентификаторыПереносимыхСтрок.Добавить(ПереносимаяСтрока.ПолучитьИдентификатор());
		КонецЦикла;
		ПоказатьВопрос(Новый ОписаниеОповещения("ОтветНаВопросОДобавленииСтрокНаУпаковку", ЭтотОбъект, Новый Структура("ИдентификаторыПереносимыхСтрок", ИдентификаторыПереносимыхСтрок)), "Отмеченные строки будут добавлены в план упаковки.
		|Продолжить?", РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветНаВопросОДобавленииСтрокНаУпаковку(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПоказатьВводДаты(Новый ОписаниеОповещения("ВвелиДатуУпаковки", ЭтотОбъект, ДопПараметры), ТекущаяДата(), "Введите дату", ЧастиДаты.ДатаВремя);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВвелиДатуУпаковки(ДатаУпаковки, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ДатаУпаковки) Тогда
		ДобавитьСтрокиВУпаковку(ДопПараметры.ИдентификаторыПереносимыхСтрок, ДатаУпаковки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьСтрокиВУпаковку(ИдентификаторыПереносимыхСтрок, ДатаУпаковки)
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаПереносимыхСтрок = Объект.ЗаказыНаОтгрузку.Выгрузить();
	ТаблицаПереносимыхСтрок.Очистить();
	Для каждого ИдентификаторПереносимойСтроки из ИдентификаторыПереносимыхСтрок Цикл
		НоваяСтрока = ТаблицаПереносимыхСтрок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Объект.ЗаказыНаОтгрузку.НайтиПоИдентификатору(ИдентификаторПереносимойСтроки));
	КонецЦикла;
	МассивЗаявок = Новый Массив;
	МассивЗаказов = Новый Массив;
	МассивХарактеристик = Новый Массив;
	Для каждого Строка из ТаблицаПереносимыхСтрок Цикл
		Если ЗначениеЗаполнено(Строка.ЗаявкаНаОтгрузку) И МассивЗаявок.Найти(Строка.ЗаявкаНаОтгрузку) = Неопределено Тогда
			МассивЗаявок.Добавить(Строка.ЗаявкаНаОтгрузку);
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.ЗаказКлиента) И МассивЗаказов.Найти(Строка.ЗаказКлиента) = Неопределено Тогда
			МассивЗаказов.Добавить(Строка.ЗаказКлиента);
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.Характеристика) И МассивХарактеристик.Найти(Строка.Характеристика) = Неопределено Тогда
			МассивХарактеристик.Добавить(Строка.Характеристика);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ЗаявкиНаОтгрузкуОстатки.ДокументОприходования КАК ЗаявкаНаОтгрузку,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.Характеристика КАК Характеристика,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.Город КАК Город,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.Намотка КАК Намотка,
		|	Лико_ЗаявкиНаОтгрузкуОстатки.КоличествоОстаток КАК Количество
		|ПОМЕСТИТЬ ВТ_Заявки
		|ИЗ
		|	РегистрНакопления.Лико_ЗаявкиНаОтгрузку.Остатки(
		|			,
		|			ДокументОприходования В (&ДокументыОприходования)
		|				И ЗаказКлиента В (&ЗаказыКлиентов)
		|				И Характеристика В (&МассивХарактеристик)) КАК Лико_ЗаявкиНаОтгрузкуОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Заявки.ЗаявкаНаОтгрузку КАК ЗаявкаНаОтгрузку,
		|	ВТ_Заявки.Характеристика КАК Характеристика,
		|	ВТ_Заявки.Город КАК Город,
		|	ВТ_Заявки.Намотка КАК Намотка,
		|	ВТ_Заявки.Количество КАК Количество,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА Лико_ПланУпаковкиТовары.Ссылка ЕСТЬ NULL
		|				ТОГДА ЛОЖЬ
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ) КАК УжеЕстьВПлане,
		|	ВТ_Заявки.ЗаявкаНаОтгрузку.Номер КАК НомерЗаявки,
		|	ВТ_Заявки.Характеристика.Владелец КАК Номенклатура
		|ИЗ
		|	ВТ_Заявки КАК ВТ_Заявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лико_ПланУпаковки.Товары КАК Лико_ПланУпаковкиТовары
		|		ПО ВТ_Заявки.ЗаявкаНаОтгрузку = Лико_ПланУпаковкиТовары.ЗаявкаНаОтгрузку
		|			И ВТ_Заявки.Характеристика = Лико_ПланУпаковкиТовары.Характеристика
		|			И ВТ_Заявки.Город = Лико_ПланУпаковкиТовары.Город
		|			И ВТ_Заявки.Намотка = Лико_ПланУпаковкиТовары.Намотка
		|			И (Лико_ПланУпаковкиТовары.Ссылка.Проведен
		|				И НЕ Лико_ПланУпаковкиТовары.Ссылка.ПометкаУдаления
		|				И Лико_ПланУпаковкиТовары.Ссылка.ВидДвижения)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Заявки.ЗаявкаНаОтгрузку,
		|	ВТ_Заявки.Характеристика,
		|	ВТ_Заявки.Город,
		|	ВТ_Заявки.Намотка,
		|	ВТ_Заявки.Количество,
		|	ВТ_Заявки.ЗаявкаНаОтгрузку.Номер,
		|	ВТ_Заявки.Характеристика.Владелец";
	
	Запрос.УстановитьПараметр("ДокументыОприходования", МассивЗаявок);
	Запрос.УстановитьПараметр("ЗаказыКлиентов", МассивЗаказов);
	Запрос.УстановитьПараметр("МассивХарактеристик", МассивХарактеристик);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		НовыйДокумент = Документы.Лико_ПланУпаковки.СоздатьДокумент();
		НовыйДокумент.Дата = ДатаУпаковки;
		НовыйДокумент.ВидДокумента = Перечисления.Лико_ВидыДокументовПланУпаковки.УпаковкаИПеремотка;
		НовыйДокумент.ВидДвижения = Истина; // Приход
		НовыйДокумент.Автор = ПараметрыСеанса.ТекущийПользователь;
		Пока Выборка.Следующий() Цикл
			Если Выборка.УжеЕстьВПлане Тогда
				Сообщить("" + Выборка.НомерЗаявки + " / " + Выборка.Номенклатура + " / " + Выборка.Город + " / " + Выборка.Намотка + " уже есть в плане, строка пропущена");
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НовыйДокумент.Товары.Добавить(), Выборка);
		КонецЦикла;
		Если НовыйДокумент.Товары.Количество() > 0 Тогда
			Попытка
				НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
				Сообщить("В план добавлено строк: " + НовыйДокумент.Товары.Количество());
			Исключение
				Сообщить("Не удалось провести документ """ + НовыйДокумент + """: " + ОписаниеОшибки());	
			КонецПопытки;
		КонецЕсли;
	Иначе
		Сообщить("Не найдено остатков по выбранным строкам");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
		
КонецФункции

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для каждого Строка из Объект.ЗаказыНаОтгрузку Цикл
		Строка.ВыбранныеСтроки = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для каждого Строка из Объект.ЗаказыНаОтгрузку Цикл
		Строка.ВыбранныеСтроки = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьОкончитьСборку(Команда)
	НачатьОкончитьСборкуНаСервере();
КонецПроцедуры

&НаСервере
Процедура НачатьОкончитьСборкуНаСервере()
	
	Если ЗначениеЗаполнено(Объект.НачалоСборки) И ЗначениеЗаполнено(Объект.ОкончаниеСборки) Тогда
		// Отменяем
		Объект.ОкончаниеСборки = Неопределено;
		Объект.НачалоСборки = Неопределено;
		Объект.Сборщик = Неопределено;
	ИначеЕсли ЗначениеЗаполнено(Объект.НачалоСборки) Тогда
		// Заканчиваем
		Объект.ОкончаниеСборки = ТекущаяДатаСеанса();
	Иначе
		// Начинаем
		Объект.НачалоСборки = ТекущаяДатаСеанса();
		Объект.Сборщик = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	// Если Статус заявки = Закрыт, то сразу сохраним в режиме обмена данными
	Если Объект.Ссылка.Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт И НЕ Модифицированность Тогда
		РеквизитОбъект = РеквизитФормыВЗначение("Объект");
		РеквизитОбъект.ОбменДанными.Загрузка = Истина;
		РеквизитОбъект.Записать(РежимЗаписиДокумента.Запись);
		ЭтаФорма.Прочитать();
	Иначе
		Модифицированность = Истина;
	КонецЕсли;
	
	ИзменитьНазваниеКнопкиНачалаОкончанияСборкиИНадписиОСборке();
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьНазваниеКнопкиНачалаОкончанияСборкиИНадписиОСборке()
	
	Если ЗначениеЗаполнено(Объект.НачалоСборки) И ЗначениеЗаполнено(Объект.ОкончаниеСборки) Тогда
		Элементы.ФормаНачатьОкончитьСборку.Заголовок = "Отменить сборку";
		Элементы.ФормаНадписьОСборке.Заголовок = "Сборка окончена " + Формат(Объект.ОкончаниеСборки, "ДФ='dd.MM.yy ""в"" HH:mm:ss'") + ": " + Объект.Сборщик;
	ИначеЕсли ЗначениеЗаполнено(Объект.НачалоСборки) Тогда
		Элементы.ФормаНачатьОкончитьСборку.Заголовок = "Закончить сборку";
		Элементы.ФормаНадписьОСборке.Заголовок = "Сборка начата " + Формат(Объект.НачалоСборки, "ДФ='dd.MM.yy ""в"" HH:mm:ss'") + ": " + Объект.Сборщик;
	Иначе
		Элементы.ФормаНачатьОкончитьСборку.Заголовок = "Начать сборку";
		Элементы.ФормаНадписьОСборке.Заголовок = "Сборка НЕ начата";
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьОстаткиПоСтрокеБезУчетаКлючевыхПараметров(Команда)
	ОткрытьФорму("Документ.Лико_ЗаявкаНаТранспортировку.Форма.ФормаВыбораКлючевыхПараметров", Новый Структура("ВариантОткрытия", "ЗаявкаНаТранспортировку"),,,,, Новый ОписаниеОповещения("ВыбраныКлючевыеПараметрыПодбора", ЭтотОбъект, Новый Структура("ИмяКоманды", Команда.Имя)), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ВыбраныКлючевыеПараметрыПодбора(Результат, ДопПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ПодобратьОстатки(ЭтаФорма.Команды[ДопПараметры.ИмяКоманды], Результат);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуОбработкиЗаявки(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Ключ", Объект.Ссылка);
		//ОткрытьФорму("Документ.Лико_ЗаявкаНаТранспортировку.Форма.ФормаОбработкиЗаявкиНаТранспортировку", ПараметрыОткрытия,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ПараметрыКоманды = Лико_Дополнительно.ПолучитьПараметрыКомандыВнешнейОбработки(,, "ТранспортныйМодуль");
		ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ПараметрыКоманды.Ссылка);
		ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.ФормаОбработкиЗаявкиНаТранспортировку", ПараметрыОткрытия, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьМеста(Команда)
	Для каждого Строка из Объект.Продукция Цикл
		Строка.Мест = 1;
	КонецЦикла;
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьМеста(Команда)
	Для каждого Строка из Объект.Продукция Цикл
		Строка.Мест = 0;
	КонецЦикла;
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОтчетПоОтгруженнымТоварам(Команда)
		
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Перед формированием отчета документ нужно записать");
		Возврат;	
	КонецЕсли;
	
	Отчет = Лико_Дополнительно.ПолучитьПараметрыКомандыВнешнегоОтчета(,, "Лико_ОтгруженныеТоварыСоСрокомХранения");
	Если Отчет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяОтчета = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(Отчет.ДополнительнаяОбработкаСсылка);

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЗаявкаНаТранспортировку", Объект.Ссылка);
	СтруктураПараметров.Вставить("ДатаОтсчета", ?(ЗначениеЗаполнено(Объект.ДатаОтгрузки), Объект.ДатаОтгрузки, Объект.Дата));

	ПараметрыОткрытия = Лико_Дополнительно.ПолучитьПараметрыОткрытияОтчета(ИмяОтчета, СтруктураПараметров);
	ОткрытьФорму("ВнешнийОтчет." + ИмяОтчета + ".ФормаОбъекта", ПараметрыОткрытия, ЭтотОбъект);
	
	
КонецПроцедуры 
