
Процедура ОбработкаПроведения(Отказ, Режим)
	Движения.Хозрасчетный.Записывать=Истина;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХозрасчетныйОстатки.Счет КАК Счет,
	|	ХозрасчетныйОстатки.Субконто1 КАК Номенклатура,
	|	ХозрасчетныйОстатки.Субконто2 КАК ПартииМатериаловВЭксплуатации,
	|	ХозрасчетныйОстатки.Субконто3 КАК РаботникиОрганизаций,
	|	ХозрасчетныйОстатки.Организация КАК Организация,
	|	ХозрасчетныйОстатки.Валюта КАК Валюта,
	|	ХозрасчетныйОстатки.Подразделение КАК Подразделение,
	|	ХозрасчетныйОстатки.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ХозрасчетныйОстатки.СуммаОстаток КАК СуммаОстаток,
	|	ХозрасчетныйОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ХозрасчетныйОстатки.Субконто2.ДатаЗавершенияЭксплуатации КАК ДатаЗавершенияЭксплуатации
	|ПОМЕСТИТЬ Вт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&Дата, Счет.Родитель = &Счет, , Организация = &Организация) КАК ХозрасчетныйОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт.Счет КАК Счет,
	|	Вт.Номенклатура КАК Номенклатура,
	|	Вт.ПартииМатериаловВЭксплуатации КАК ПартииМатериаловВЭксплуатации,
	|	Вт.РаботникиОрганизаций КАК РаботникиОрганизаций,
	|	Вт.Организация КАК Организация,
	|	Вт.Валюта КАК Валюта,
	|	Вт.Подразделение КАК Подразделение,
	|	Вт.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Вт.СуммаОстаток КАК СуммаОстаток,
	|	Вт.КоличествоОстаток КАК КоличествоОстаток,
	|	Вт.ДатаЗавершенияЭксплуатации КАК ДатаЗавершенияЭксплуатации
	|ИЗ
	|	Вт КАК Вт
	|ГДЕ
	|	Вт.ДатаЗавершенияЭксплуатации < &Дата";
	Запрос.УстановитьПараметр("Дата",НачалоМесяца(Дата) );
	Запрос.УстановитьПараметр("счет",ПланыСчетов.Хозрасчетный.МатериальныеЦенностиВЭксплуатации );
	Запрос.УстановитьПараметр("Организация",Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Движение=Движения.Хозрасчетный.Добавить();
		Движение.Период=Дата;
		Движение.Организация=Организация;
		Движение.СчетКт=Выборка.Счет;
		Движение.СубконтоКт.Номенклатура=Выборка.Номенклатура;
		Движение.СубконтоКт.ПартииМатериаловВЭксплуатации=Выборка.ПартииМатериаловВЭксплуатации;
		Если  Выборка.Счет<> ПланыСчетов.Хозрасчетный.СпецоснасткаВЭксплуатацииВспомогательный Тогда
			Движение.СубконтоКт.РаботникиОрганизаций=Выборка.РаботникиОрганизаций; 	
		КонецЕсли;
		Движение.Сумма=Выборка.СуммаОстаток;
		Движение.КоличествоКт=Выборка.КоличествоОстаток;
		
	КонецЦикла; 
	
КонецПроцедуры
