		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВТ.Период,
		|		ВТ.ЗаказКлиента,
		|		ВТ.РабочийЦентр,
		|		ВТ.Количество,
		|		ЗаказКлиентаЦвета.НомерПроката,
		|		ВТ.Затрата) КАК ВТПрокатыТрафарета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
		|		ПО ВТПрокатыТрафарета.ЗаказКлиента = ЗаказКлиентаВидыРабот.Ссылка
		|			И ВТПрокатыТрафарета.НомерПроката = ЗаказКлиентаВидыРабот.НомерПроката
		|			И ВТПрокатыТрафарета.РабочийЦентр.ВидРабочегоЦентра = ЗаказКлиентаВидыРабот.РабочийЦентр.ВидРабочегоЦентра
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(, ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.Табаш)) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних
		|		ПО ВТПрокатыТрафарета.Затрата = Лико_ЦеныГруппНоменклатурыСрезПоследних.ЦеноваяГруппа
		|			И ВТПрокатыТрафарета.ЗаказКлиента.Площадка = Лико_ЦеныГруппНоменклатурыСрезПоследних.Площадка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
		|				,
		|				ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.Табаш)
		|					И Площадка.Наименование = "" Ликофлекс"") КАК Лико_ЦеныГруппНоменклатурыСрезПоследних1
		|		ПО ВТПрокатыТрафарета.Затрата = Лико_ЦеныГруппНоменклатурыСрезПоследних1.ЦеноваяГруппа
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТПрокатыТрафарета.Период,
		|	ВТПрокатыТрафарета.ЗаказКлиента,
		|	ВТПрокатыТрафарета.РабочийЦентр,
		|	ВТПрокатыТрафарета.Количество,
		|	ВТПрокатыТрафарета.Затрата,
		|	ЕСТЬNULL(ВТПрокатыТрафарета.НомерПроката, 1),
		|	ЕСТЬNULL(ЗаказКлиентаВидыРабот.НомерПроката, 100),
		|	ВТПрокатыТрафарета.Количество * ЕСТЬNULL(ЕСТЬNULL(Лико_ЦеныГруппНоменклатурыСрезПоследних.Цена, Лико_ЦеныГруппНоменклатурыСрезПоследних1.Цена), 0)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерПрокатаРаботы";

	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
