&НаСервереБезКонтекста
Функция ДанныеИзРегистраПоЦГСоо(ПлощадкаПоставщика, ПлощадкаПокупателя, Период, знач _ЦеноваяГруппа=Неопределено)
	
		
	СооЦГ = РегистрыСведений.Лико_ВыполненныеРаботыМеждуОрганизациямиРаботыИЦены.ДанныеДляЗаполненияПоЦеновойГруппеСоо(
	ПлощадкаПоставщика,
	ПлощадкаПокупателя,
	Период,
	_ЦеноваяГруппа);
	
	
	Возврат СооЦГ
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьТчЦеныДаннымиИзРегистра() 
	
	СооЦГ = ДанныеИзРегистраПоЦГСоо(
	Объект.ПлощадкаПоставщика,
	Объект.ПлощадкаПокупателя,
	Объект.Дата,
	Объект.Цены.Выгрузить().ВыгрузитьКолонку("ЦеноваяГруппа"));
	
	Для каждого СтрЦена Из Объект.Цены Цикл 
		
		СтруктураДанныхЦГ = СооЦГ[СтрЦена.ЦеноваяГруппа];
		
		Если ЗначениеЗаполнено(СтруктураДанныхЦГ) Тогда
			
			ЗаполнитьЗначенияСвойств(СтрЦена,СтруктураДанныхЦГ);
			
		КонецЕсли;
		
		
		
		
	КонецЦикла;
	
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьТчЦеныДаннымиИзРегистраСервер() 
	
	СооЦГ = ДанныеИзРегистраПоЦГСоо(
	Объект.ПлощадкаПоставщика,
	Объект.ПлощадкаПокупателя,
	Объект.Дата,
	Объект.Цены.Выгрузить().ВыгрузитьКолонку("ЦеноваяГруппа"));
	
	Для каждого СтрЦена Из Объект.Цены Цикл 
		
		СтруктураДанныхЦГ = СооЦГ[СтрЦена.ЦеноваяГруппа];
		
		Если ЗначениеЗаполнено(СтруктураДанныхЦГ) Тогда
			
			ЗаполнитьЗначенияСвойств(СтрЦена,СтруктураДанныхЦГ);
			
		КонецЕсли;
		
		
		
		
	КонецЦикла;
	
	
КонецПроцедуры 


&НаКлиенте
Процедура ЗаполнитьСтрокуТчЦеныДаннымиИзРегистра() 
	
	ТД = Элементы.Цены.ТекущиеДанные;
	
	Если ТД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СооЦГ = ДанныеИзРегистраПоЦГСоо(Объект.ПлощадкаПоставщика,Объект.ПлощадкаПокупателя,Объект.Дата,ТД.ЦеноваяГруппа);
	
	СтруктураДанныхЦГ = СооЦГ[ТД.ЦеноваяГруппа];
	
	Если ЗначениеЗаполнено(СтруктураДанныхЦГ) Тогда
		
		ЗаполнитьЗначенияСвойств(ТД,СтруктураДанныхЦГ);
		
		ЗаполнитьЗначенияСвойств(Объект, СтруктураДанныхЦГ);
		
	КонецЕсли;
	
	
КонецПроцедуры 

&НаКлиенте
Процедура ПересчетСуммы()
	ТД = Элементы.Цены.ТекущиеДанные;
	
	Если ТД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТД.Сумма = ТД.Количество*ТД.Цена;
	
КонецПроцедуры


&НаКлиенте
Процедура ПересчетЦены()
	
	ТД = Элементы.Цены.ТекущиеДанные;
	
	Если ТД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТД.Количество = 0 Тогда
		Возврат;
	КонецЕсли;

	
	ТД.Цена = ТД.Сумма/ТД.Количество
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция КонтрагентПоОрганизацииСервер(Организация) 

Возврат УправлениеСвойствами.ЗначениеСвойства(Организация,"КонтрагентОрганизации_8e3f712fdca94791a890e1aa7853a0d2");
КонецФункции

&НаКлиенте
Процедура РассчитатьНДС()
	
	КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	ТекущаяСтрока = Элементы.Цены.ТекущиеДанные;

	
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	
	СтруктураДействий = Новый Структура;
	
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму","Количество");
	ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);

	
КонецПроцедуры 


&НаСервере
Процедура РассчитатьНДССервер(Данные)
	
	КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	

	
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	
	СтруктураДействий = Новый Структура;
	
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму","Количество");
	ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(Данные, СтруктураДействий, КэшированныеЗначения);

	
КонецПроцедуры 



&НаКлиенте
Процедура РассчитатьНДСТчЦеныСервер()
	
	КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	
	Для каждого СтрЦена Из Объект.Цены Цикл
		
		СтруктураДействий = Новый Структура;
		
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСумму","Количество");
		ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(СтрЦена, СтруктураДействий, КэшированныеЗначения);
		
	
КонецЦикла;
	
		
	
	
КонецПроцедуры 

