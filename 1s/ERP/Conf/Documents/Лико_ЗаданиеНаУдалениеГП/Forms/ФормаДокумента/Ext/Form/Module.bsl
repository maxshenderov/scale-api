
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ТиповыеДокументы.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	Элементы.ТиповыеДокументы.Обновить();
	ЭтаФорма.Прочитать();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТиповыеДокументы.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		УправлениеДоступностьюЭлементов();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УправлениеДоступностьюЭлементов()
	
	Параметры.Свойство("РазрешеноМенятьЗакрытуюЗаявку", РазрешеноМенятьЗакрытуюЗаявку);
	
	ПолныеПрава = РольДоступна("ПолныеПрава");
	
	Если ЗначениеЗаполнено(Объект.Ссылка) И Объект.Ссылка.Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Закрыт И НЕ РазрешеноМенятьЗакрытуюЗаявку Тогда
		ТолькоПросмотр = Истина;
		Элементы.ТоварыКонтекстноеМенюРазделитьСтроку.Доступность = Ложь;
	КонецЕсли;
	
	Элементы.Статус.ТолькоПросмотр = НЕ ПолныеПрава;
	Если Элементы.Статус.ТолькоПросмотр Тогда
		Элементы.Статус.МаксимальнаяШирина = Элементы.Статус.МаксимальнаяШирина + 2;
	КонецЕсли;
	Элементы.Номер.ТолькоПросмотр = НЕ ПолныеПрава;
	Элементы.Организация.ТолькоПросмотр = НЕ ПолныеПрава;
	Элементы.Менеджер.ТолькоПросмотр = НЕ ПолныеПрава; 
	Элементы.Дата.ТолькоПросмотр = НЕ ПолныеПрава;
	Элементы.ПодтвердитьЗаявку.Доступность = Объект.Статус = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Создан;
	
КонецПроцедуры

&НаКлиенте
Процедура ТиповыеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ТиповойДокумент) Тогда
		ПоказатьЗначение(,Элемент.ТекущиеДанные.ТиповойДокумент);
	КонецЕсли;
КонецПроцедуры

