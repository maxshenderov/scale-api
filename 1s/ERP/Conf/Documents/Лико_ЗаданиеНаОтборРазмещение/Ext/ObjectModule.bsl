#Область ОбработчикиПроведения
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Площадка =АдресКуда.Лико_Площадка;
	Организация=АдресКуда.Лико_Организация;
	Склад=АдресКуда.Владелец;
	
	
	Если РежимЗаписи =РежимЗаписиДокумента.Проведение   Тогда
		
		Если Не ЗначениеЗаполнено(Статус) Тогда 
			
			Статус=Перечисления.Лико_СтатусыЗаданийСклада.Новое; 
			
		КонецЕсли;
		
		
		Если ЗначениеЗаполнено(АдресТранзит)
			И Статус=Перечисления.Лико_СтатусыЗаданийСклада.Новое Тогда
			
			Статус=Перечисления.Лико_СтатусыЗаданийСклада.ВТранзите; 
			
			
		КонецЕсли;
		
		ЕСли  ЗначениеЗаполнено(АдресКудаФакт) И (Статус=Перечисления.Лико_СтатусыЗаданийСклада.Новое 
			Или Статус=Перечисления.Лико_СтатусыЗаданийСклада.ВТранзите) Тогда 
			
			Статус=Перечисления.Лико_СтатусыЗаданийСклада.Выполнено; 
			
		КонецЕсли;
		
		
	КонецЕсли;
	
	
	
	
	Если РежимЗаписи =РежимЗаписиДокумента.Проведение
		И (Статус=Перечисления.Лико_СтатусыЗаданийСклада.Новое 
		Или Статус=Перечисления.Лико_СтатусыЗаданийСклада.ВТранзите) Тогда 
		
		УчитыватьПриПодборе = Истина;
		
	Иначе
		
		УчитыватьПриПодборе = Ложь;
		
	КонецЕсли;
	
	
	Если  ЗначениеЗаполнено(АдресОткуда.Лико_Секция) И  ЗначениеЗаполнено(АдресКуда.Лико_Секция) Тогда
		ТипЗадания =Перечисления.Лико_ТипыСкладскихЗаданий.Перемещение;
	ИначеЕсли  Не ЗначениеЗаполнено(АдресОткуда.Лико_Секция) И  ЗначениеЗаполнено(АдресКуда.Лико_Секция)ТОгда
		ТипЗадания =Перечисления.Лико_ТипыСкладскихЗаданий.Размещение;
	Иначе
		ТипЗадания =Перечисления.Лико_ТипыСкладскихЗаданий.Отбор;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОснование) 
		И Не ЗначениеЗаполнено(АвторДокумента) Тогда
		
		АвторДокумента = ДокументОснование.АвторДокумента;
		
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если РежимПроведения=РежимПроведенияДокумента.Оперативный Тогда
		
		Если Статус=Перечисления.Лико_СтатусыЗаданийСклада.Новое 
			Или Статус=Перечисления.Лико_СтатусыЗаданийСклада.ВТранзите Тогда
			
			Документы.Лико_ЗаданиеНаОтборРазмещение.ОтменитьСтарыеЗадания(Паллет,Ссылка);
			
		КонецЕсли;
		
		
				
		
	КонецЕсли;
	
	СформироватьДвиженияПаллетыВСекциях();

	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	
	Статус=Неопределено;
	АвторДокумента=Неопределено;
	УчитыватьПриПодборе=Неопределено;	
	ДокументОснование=Неопределено;
	АдресКудаФакт=Неопределено;
	ДокументПеремещения=Неопределено;
	
	
КонецПроцедуры



