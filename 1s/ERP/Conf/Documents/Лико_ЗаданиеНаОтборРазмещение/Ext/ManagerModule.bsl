/// <summary>
/// Функция поиска паллета по адресу хранения
/// </summary>
/// <param name="Адрес">СправочникСсылка.СкладскиеЯчейки - Адрес для поиска паллета</param>
/// <returns>СправочникСсылка.Лико_Паллеты2_0 - Найденный паллет</returns>
Функция НайтиПаллетПоАдресу(Адрес) Экспорт
 	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лико_ПаллетыВСекцияхОстатки.Паллет КАК Паллет
	|ИЗ
	|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(, Адрес = &Адрес) КАК Лико_ПаллетыВСекцияхОстатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Лико_ПаллетыВСекцияхОстатки.Паллет.Код";

	Запрос.УстановитьПараметр("Адрес", Адрес);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Паллет;
	Иначе
		Возврат Справочники.Лико_Паллеты2_0.ПустаяСсылка();
	КонецЕсли;

КонецФункции

/// <summary>
/// Проверяет наличие паллета в других заданиях на отбор/размещение
/// </summary>
/// <param name="Паллет">СправочникСсылка.Лико_Паллеты2_0 - Паллет для проверки</param>
/// <returns>Булево - Истина если паллет найден в других заданиях</returns>
Функция ПаллетВЗадании(Паллет) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Документы.Лико_ЗаданиеНаОтборРазмещение.ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(Паллет) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Задания.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лико_ЗаданиеНаОтборРазмещение КАК Задания
	|ГДЕ
	|	Задания.Паллет = &Паллет
	|	И Задания.Проведен = ИСТИНА
	|	И (Задания.Статус = ЗНАЧЕНИЕ(Перечисление.Лико_СтатусыЗаданийСклада.Новое)
	|			ИЛИ Задания.Статус = ЗНАЧЕНИЕ(Перечисление.Лико_СтатусыЗаданийСклада.ВТранзите))
	|	И НЕ Задания.ПометкаУдаления";

	Запрос.УстановитьПараметр("Паллет", Паллет);

	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
	   Результат = Выборка.Ссылка;
   КонецЦикла; 
   
   Возврат Результат;
КонецФункции

/// <summary>
/// Отменяет старые задания с указанным паллетом
/// Отменяет только проведенные задания в статусе Новое или ВТранзите
/// </summary>
/// <param name="Паллет">СправочникСсылка.Лико_Паллеты2_0 - Паллет для отмены заданий</param>
Процедура ОтменитьСтарыеЗадания(Паллет, ЗаданиеСсылка=Неопределено) Экспорт
  	УстановитьПривилегированныйРежим(Истина);

	Если Не ЗначениеЗаполнено(Паллет) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Задания.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лико_ЗаданиеНаОтборРазмещение КАК Задания
	|ГДЕ
	|	Задания.Паллет = &Паллет
	|	И Задания.Проведен = ИСТИНА
	|	И (Задания.Статус = ЗНАЧЕНИЕ(Перечисление.Лико_СтатусыЗаданийСклада.Новое)
	|			ИЛИ Задания.Статус = ЗНАЧЕНИЕ(Перечисление.Лико_СтатусыЗаданийСклада.ВТранзите))
	|	И НЕ Задания.ПометкаУдаления
	|	И Задания.Ссылка <> &Ссылка";

	Запрос.УстановитьПараметр("Паллет", Паллет);
	Запрос.УстановитьПараметр("Ссылка", ЗаданиеСсылка);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл
		
		ОбъектЗадания = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектЗадания.Статус = Перечисления.Лико_СтатусыЗаданийСклада.Отменено;
		
		Попытка
			ОбъектЗадания.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		ОшибкаСообщение = "Ошибка при сохранении документа Лико_ЗаданиеНаОтборРазмещение: " + ОписаниеОшибки();
		ВызватьИсключение ОшибкаСообщение;
		КонецПопытки;
		
	КонецЦикла;

КонецПроцедуры



