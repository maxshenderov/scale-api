
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ПодключаемоеОборудование
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" Тогда
			ОбработатьШтрихкоды(ПодключаемоеОборудованиеУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр));
		КонецЕсли;
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШтрихкоды(ДанныеШтрихкода)
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущиеДанные = Неопределено;
	Иначе
		ТекущиеДанные = Объект.Содержимое.НайтиПоИдентификатору(ТекущаяСтрока);
	КонецЕсли;
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаТовары;
	
	//Найдем серию
	МассивСерий = Лико_Дополнительно.НайтиСерииПоШтрихкоду(ДанныеШтрихкода.Штрихкод);
	СерияНайдена = МассивСерий.Количество() > 0;
	Если СерияНайдена Тогда
		Отказ = Ложь;
		Если НЕ ЗначениеЗаполнено(ТекущаяЯчейка) Тогда
			Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не заполнена ячейка!");
			Отказ = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекущийПаллет) Тогда
			Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не заполнен паллет!");
			Отказ = Истина;
		КонецЕсли;
		Если ТекущиеДанные = Неопределено Тогда
			Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Ошибка. Не найдена текущая строка.");
			Отказ = Истина;
		КонецЕсли;			
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		Для каждого Серия из МассивСерий Цикл
			Если Объект.Содержимое.НайтиСтроки(Новый Структура("Серия", Серия)).Количество() = 0 Тогда
				Если ЗначениеЗаполнено(ТекущиеДанные.Серия) ИЛИ ЗначениеЗаполнено(ТекущиеДанные.ШтрихкодСерии) Тогда
					ТекущиеДанные = Объект.Содержимое.Добавить();
					ТекущиеДанные.Ячейка = ТекущаяЯчейка;
					ТекущиеДанные.Паллет = ТекущийПаллет;
					Элементы.Содержимое.ТекущаяСтрока = ТекущиеДанные.ПолучитьИдентификатор();
				КонецЕсли;
				ТекущиеДанные.Серия = Серия;
			Иначе
				Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Серия """ + Серия + """ уже присутствует в таблице.");
			КонецЕсли;
		КонецЦикла;
		КоличествоКоробок = РассчитатьКоличествоКоробок();
	Иначе
		Результат = Лико_ДополнительноКлиент.ОбработатьШтрихКодНеТовара(ДанныеШтрихкода.Штрихкод);
		Если Результат.Ошибка <> "" Тогда
			// Если это штрихкод серии, запишем его в колонку ШтрихкодСерии
			Если СтрДлина(ДанныеШтрихкода.Штрихкод) = 20 Тогда
				Если ТекущиеДанные = Неопределено Тогда
					Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Ошибка. Не найдена текущая строка.");
					Отказ = Истина;
				Иначе
					Если Объект.Содержимое.НайтиСтроки(Новый Структура("ШтрихкодСерии", ДанныеШтрихкода.Штрихкод)).Количество() = 0 Тогда
						ТекущиеДанные = Объект.Содержимое.Добавить();
						ТекущиеДанные.Ячейка = ТекущаяЯчейка;
						ТекущиеДанные.Паллет = ТекущийПаллет;
						ТекущиеДанные.ШтрихкодСерии = ДанныеШтрихкода.Штрихкод;
						Элементы.Содержимое.ТекущаяСтрока = ТекущиеДанные.ПолучитьИдентификатор();
					Иначе
						Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Штрихкод """ + ДанныеШтрихкода.Штрихкод + """ уже присутствует в таблице.");
					КонецЕсли;
				КонецЕсли;
			Иначе
				Сообщить(Результат.Ошибка);
			КонецЕсли;
		Иначе
			Если Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Паллета") Тогда
				//Это паллет
				Если ТекущийПаллет = Результат.Паллет Тогда
					Возврат;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ТекущаяЯчейка) Тогда
					Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Сначала нужно отсканировать штрихкод ячейки.");
					Возврат;
				КонецЕсли;
				Если Объект.Содержимое.Количество() > 0 И ТекущиеДанные = Неопределено Тогда
					Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Ошибка. Не найдена текущая строка.");
					Возврат;
				КонецЕсли;
				Если ЗначениеЗаполнено(ТекущиеДанные.Серия) Тогда
					Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Уже введена информация о паллете. Сканируйте коробки или новую ячейку.");
					Возврат;
				КонецЕсли;	
				НайденныеСтроки = Объект.Содержимое.НайтиСтроки(Новый Структура("Паллет", Результат.Паллет));
				Если НайденныеСтроки.Количество() = 0 Тогда
					ТекущиеДанные.Паллет = Результат.Паллет;
					СодержимоеПриАктивизацииСтроки(Неопределено);
				Иначе
					Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Паллет """ + Результат.Паллет + """ уже присутствует в таблице. Считайте другой паллет или продолжайте сканировать коробки этого паллета (они будут помещены в ячейку """ + НайденныеСтроки[0].Ячейка + """.");
					Элементы.Содержимое.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
					СодержимоеПриАктивизацииСтроки(Неопределено);
				КонецЕсли;
			ИначеЕсли Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Адреса")
				ИЛИ Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Адреса_Короткий") Тогда
				//Это ячейка
				Если ТекущаяЯчейка = Результат.АдресаХранения Тогда
					Возврат;
				КонецЕсли;
				НайденныеСтроки = Объект.Содержимое.НайтиСтроки(Новый Структура("Ячейка", Результат.АдресаХранения));
				Если НайденныеСтроки.Количество() = 0 Тогда
					СкладВладелец = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Результат.АдресаХранения.Владелец", Результат, "Результат");
					Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
						Объект.Склад = СкладВладелец;
					КонецЕсли;
					Если СкладВладелец <> Объект.Склад Тогда
						Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Считана ячейка склада, отличного от выбранного в документе.");
						Возврат;
					КонецЕслИ;
					ТекущиеДанные = Объект.Содержимое.Добавить();
					ТекущиеДанные.Ячейка = Результат.АдресаХранения;
					Элементы.Содержимое.ТекущаяСтрока = ТекущиеДанные.ПолучитьИдентификатор();
				Иначе
					Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Ячейка """ + Результат.АдресаХранения + """ уже присутствует в таблице. Считайте другую ячейку или продолжайте сканировать коробки в эту ячейку (они будут принадлежать уже введенному паллету """ + НайденныеСтроки[0].Паллет + """.");
					Элементы.Содержимое.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
					СодержимоеПриАктивизацииСтроки(Неопределено);
				КонецЕсли;
			ИначеЕсли Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Сотрудника") Тогда
				//Это физ. лицо
				Объект.АвторДокумента = Результат.Сотрудник;
				Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаОсновное;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ИнициализироватьКомпоновкуДанных(Ложь);
	
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	ТиповыеДокументы.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	УстановитьДоступностьЭлементов();
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.РабочееМесто = ПараметрыСеанса.Лико_РабочееМесто;
		ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
		Объект.Организация = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитПользователяОрганизация", ТекущийПользователь); 
		Объект.Подразделение = ТекущийПользователь.Подразделение;
		Объект.Склад = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитПользователяСГП", ТекущийПользователь);
		Параметры.Свойство("ФизЛицо", Объект.АвторДокумента);
	КонецЕсли;
	КоличествоКоробок = РассчитатьКоличествоКоробок();
	
КонецПроцедуры

&НаКлиенте
Процедура ТиповыеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ТиповойДокумент) Тогда
		ПоказатьЗначение(,Элемент.ТекущиеДанные.ТиповойДокумент);
	КонецЕсли;
КонецПроцедуры

