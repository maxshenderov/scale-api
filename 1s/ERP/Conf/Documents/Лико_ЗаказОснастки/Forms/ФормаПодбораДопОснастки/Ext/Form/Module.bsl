&НаКлиенте
 Процедура СоздатьЗаказОснастки(Команда)
	Массив = Новый Массив();
	
	Для каждого Оснастка Из Тз Цикл
		Если Оснастка.Выбрать Тогда
			Массив.Добавить(Оснастка.Номенклатура);
		КонецЕсли;
		
		
	КонецЦикла;
	
	Закрыть(Массив);
	 
КонецПроцедуры


