	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	Лико_ЗаказОснастки.Проведен КАК Проведен,
	Лико_ЗаказОснастки.Номер КАК Номер,
	Лико_ЗаказОснастки.Дата КАК Дата,
	Лико_ЗаказОснастки.Срочный КАК Срочный,
	Лико_ЗаказОснастки.ВидОперации КАК ВидОперации,
	Лико_ЗаказОснасткиОснастка.Номенклатура.Артикул КАК Артикул,
	Лико_ЗаказОснасткиОснастка.Номенклатура КАК Оснастка,
	Лико_ЗаказОснасткиОснастка.Количество КАК Количество,
	Лико_ЗаказОснасткиОснастка.Менеджер КАК Менеджер,
	Лико_ЗаказОснасткиОснастка.Заказ КАК Заказ,
	ЕСТЬNULL(Лико_ЗаказыНаОснасткуСрезПоследних.Статус, Лико_ЗаказОснасткиОснастка.Статус) КАК Статус,
	Лико_ЗаказыНаОснасткуСрезПоследних.Ответственный КАК Ответственный,
	ЗаказКлиента.Этикетки КАК Этикетки,
	Лико_ЗаказОснастки.Комментарий КАК Комментарий,
	Лико_ЗаказОснастки.Площадка КАК Площадка,
	Лико_ЗаказОснастки.Ссылка КАК Ссылка
ИЗ
	Документ.Лико_ЗаказОснастки.Оснастка КАК Лико_ЗаказОснасткиОснастка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЗаказыНаОснастку.СрезПоследних КАК Лико_ЗаказыНаОснасткуСрезПоследних
		ПО Лико_ЗаказОснасткиОснастка.Ссылка = Лико_ЗаказыНаОснасткуСрезПоследних.ЗаказНаОснастку
			И Лико_ЗаказОснасткиОснастка.Номенклатура = Лико_ЗаказыНаОснасткуСрезПоследних.Номенклатура
			И Лико_ЗаказОснасткиОснастка.КлючСтроки = Лико_ЗаказыНаОснасткуСрезПоследних.КлючСтроки
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_ЗаказОснастки КАК Лико_ЗаказОснастки
		ПО Лико_ЗаказОснасткиОснастка.Ссылка = Лико_ЗаказОснастки.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
		ПО Лико_ЗаказОснасткиОснастка.Заказ = ЗаказКлиента.Ссылка

СГРУППИРОВАТЬ ПО
	Лико_ЗаказОснасткиОснастка.Номенклатура,
	Лико_ЗаказОснасткиОснастка.Менеджер,
	Лико_ЗаказОснасткиОснастка.Заказ,
	ЕСТЬNULL(Лико_ЗаказыНаОснасткуСрезПоследних.Статус, Лико_ЗаказОснасткиОснастка.Статус),
	Лико_ЗаказыНаОснасткуСрезПоследних.Ответственный,
	Лико_ЗаказОснастки.Ссылка,
	ЗаказКлиента.Этикетки,
	Лико_ЗаказОснастки.Проведен,
	Лико_ЗаказОснастки.Номер,
	Лико_ЗаказОснастки.Дата,
	Лико_ЗаказОснастки.Срочный,
	Лико_ЗаказОснастки.ВидОперации,
	Лико_ЗаказОснасткиОснастка.Номенклатура.Артикул,
	Лико_ЗаказОснасткиОснастка.Количество,
	Лико_ЗаказОснастки.Комментарий,
	Лико_ЗаказОснастки.Площадка</QueryText>
