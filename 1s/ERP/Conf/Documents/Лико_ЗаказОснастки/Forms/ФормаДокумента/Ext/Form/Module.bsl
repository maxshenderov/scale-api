&НаКлиенте
Процедура ОснасткаЗаказПриИзменении(Элемент)
	ТД=Элементы.Оснастка.ТекущиеДанные;
	ТД.Партнер=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Заказ,"Партнер");
	ТД.Регион=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Партнер,"БизнесРегион");

КонецПроцедуры


&НаКлиенте
Процедура ОснасткаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ЭтоИнженерОСнасткиСервер() И  (Поле.Имя="ОснасткаЗаказНаПроизводствоНомерБезПрефикса" Или 
		Поле.Имя="ОснасткаЗаказНаПроизводствоСтатусЗаказаНаПроизводствоОснасткиОснастки") Тогда
		Тд=Элементы.Оснастка.ТекущиеДанные;
		Если  ТД<>Неопределено И  ТД.ВнутреннийЗаказ Тогда
			СоздатьОткрытьЗаказНаПроизводство(Неопределено);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

	
	//*************************
	//************************* 
	
	Если Объект.ВидОперации  = Перечисления.Лико_ВидыОперацийЗаказОснастки.Перезаказ  И
		НЕ РольДоступна("Лико_ИнженерОснастки") И
		НЕ РольДоступна("ПолныеПрава")	Тогда 
		
		УстановитьВидимостьПараметров(Ложь,Ложь);
	Иначе
		УстановитьВидимостьПараметров(Истина,Истина);
	КонецЕсли;
	
	Если ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.ЗаказКлиента")
		И Параметры.Ключ.Пустая() И НЕ Лико_Дополнительно.РольДоступнаНаСервере("Лико_ИнженерОснастки") Тогда
		Элементы.ВидОперации.Доступность = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда 
		Для каждого стр из Объект.Оснастка Цикл
			стр.статус = Перечисления.Лико_СтатусыЗаказовНаОснастку.Создан;	
		КонецЦикла;
	КонецЕсли;	
	
	Если Не (РольДоступна("ПолныеПрава") ИЛИ 
		РольДоступна("Лико_ДобавлениеИзменениеЗаказовПоПлощадке") ИЛИ 
		Лико_Дополнительно.РольДоступнаНаСервере("Лико_ИнженерОснастки")) Тогда 
		Элементы.Комментарий.Доступность = Ложь;
	КонецЕсли;
	
	Если Не РольДоступна("ПолныеПрава") Тогда
		Элементы.Номер.Доступность = Ложь;
	КонецЕсли;
	
	Если  Не РольДоступна("ПолныеПрава") И  УправлениеДоступом.ЕстьРоль("Лико_Разработчик3dМоделей") Тогда
		УстановитьВидемостьДляРазработчика3dМоделей();
	КонецЕсли; 	
	
	
	//************************
	//************************
	
	
	
	
	
	ДобавитьУсловноеОформление();
	ОбновитьЗаголовокДлинаШирина();

	УстановитьВидимостьСервер();
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьСервер() //+Лико m.shenderov 01.09.2021

Элементы.ОснасткаСоздатьЗаказыНаПроизводство.Видимость=ЭтоИнженерОСнасткиСервер();	
		
	
КонецПроцедуры  //-Лико m.shenderov 01.09.2021

