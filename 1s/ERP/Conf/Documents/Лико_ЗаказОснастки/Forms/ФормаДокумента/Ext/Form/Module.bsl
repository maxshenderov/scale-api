Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Сч=0;
	Для каждого Оснастка  Из Объект.Оснастка Цикл
		Если Не ЗначениеЗаполнено(Оснастка.Заказ) И Не ЗначениеЗаполнено(Оснастка.Партнер) Тогда
			Отказ= Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Заполните поле: ""Заказ"" или поле:""Партнер""";
			Сообщение.Поле = СтрШаблон("Объект.Оснастка[%1].Заказ",Строка(Сч)); //имя реквизита 
			Сообщение.УстановитьДанные("Объект"); //Ссылка на объект ИБ
			Сообщение.Сообщить();
		КонецЕсли;
		Сч=Сч+1;
	КонецЦикла;
	
	ПроверкаНаСервереПередЗаписью(Отказ);
КонецПроцедуры

