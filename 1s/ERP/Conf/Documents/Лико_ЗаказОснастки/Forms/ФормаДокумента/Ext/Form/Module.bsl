Асинх Процедура СоздатьОткрытьЗаказНаПроизводствоКлиент () //+Лико m.shenderov 13.09.2021
	
	Если ЭтаФорма.Модифицированность Тогда
		Сообщить("Необходимо записать документ!");
		Возврат;
	КонецЕсли; 	
	
	ТД=Элементы.Оснастка.ТекущиеДанные; 
	
	Если  ТД<>Неопределено  Тогда
		Если Не ЗначениеЗаполнено(ТД.ЗаказНаПроизводство) Тогда
			
			ЕстьРегион=ЗначениеЗаполнено(ТД.Регион) Или 
			ЗначениеЗаполнено(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Заказ,"Регион")) Или
			ЗначениеЗаполнено(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Партнер,"БизнесРегион"));
			
			Если Не ЗначениеЗаполнено(ТД.Номенклатура) Тогда
				СообщитьПользвателюКлиент("Номенклатура");
			     Возврат ;
			КонецЕсли;
			
			Если Не ЕстьРегион Тогда
				СообщитьПользвателюКлиент("Регион");
				Возврат ;
			КонецЕсли;
			
			
			Режим = РежимДиалогаВопрос.ДаНет;
			Ответ = Ждать ВопросАсинх(СтрШаблон("Создать заказ на производство для : %1 %2 ?",ТД.Номенклатура,ТД.Номенклатура), Режим, 0);
			Если Ответ = КодВозвратаДиалога.Нет Тогда
				Возврат;
			КонецЕсли;
			
			Организация   = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Заказ,"Организация");
			Организация   = ?(ЗначениеЗаполнено(Организация),Организация,Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Объект.Получатель,"Организация"));
			
			Регион=
			?(
			ЗначениеЗаполнено(ТД.Регион),
			ТД.Регион,
			Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Заказ,"Регион")
			);  			
			
			ТД.ЗаказНаПроизводство=СоздатьЗаказНаполуфабрикатСервер(Организация,Объект.Площадка,ТД.Заказ,ТД.Партнер,Регион,ТД.Номенклатура,ТД.Количество,Истина);
			//ТД.ЗаказНаПроизводство=Документы.Лико_ЗаказОснастки.СоздатьЗаказНаполуфабрикат(Организация,Объект.Площадка,ТД.Заказ,ТД.Партнер,Регион,ТД.Номенклатура,ТД.Количество,Истина);

			Записать(Новый Структура("РежимЗаписи, РежимПроведения", РежимЗаписиДокумента.Запись, РежимПроведенияДокумента.Неоперативный));  			
			//НаправитьВРаботуСервер(ТД.ЗаказНаПроизводство,ТД.Номенклатура);
			
			Возврат;
			
		КонецЕсли;
		Если ЗначениеЗаполнено(ТД.ЗаказНаПроизводство) Тогда
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Ключ",ТД.ЗаказНаПроизводство);
			ОписаниеОповещение=Новый ОписаниеОповещения("ЗакрытиеФормыЗаказаЗавершение",ЭтаФорма);
			ОткрытьФорму("Документ.ЗаказКлиента.Форма.Лико_ФормаДокумента_ЗаказОснастки",ПараметрыФормы,,,,,ОписаниеОповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
		
	КонецЕсли;

	
	
КонецПроцедуры //-Лико m.shenderov 13.09.2021

&НаКлиенте
Асинх Процедура СоздатьЗаказыНаПроизводствоКлиент () //+Лико m.shenderov 13.09.2021
	
	Если ЭтаФорма.Модифицированность Тогда
		Сообщить("Необходимо записать документ!");
		Возврат;
	КонецЕсли;
	Режим = РежимДиалогаВопрос.ДаНет;
	Ответ = Ждать ВопросАсинх(СтрШаблон("Создать заказы на производство?"), Режим, 0);
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	
	Отказ=Ложь;
	ТД=Элементы.Оснастка.ТекущиеДанные; 
	
	Для каждого ТД Из Объект.Оснастка Цикл
		
		Если ТД.ВнутреннийЗаказ И Не ЗначениеЗаполнено(ТД.ЗаказНаПроизводство) Тогда
			
			ЕстьРегион=ЗначениеЗаполнено(ТД.Регион) Или 
			ЗначениеЗаполнено(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Заказ,"Регион")) Или
			ЗначениеЗаполнено(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Партнер,"БизнесРегион"));
			
			Если Не ЗначениеЗаполнено(ТД.Номенклатура) Тогда
				СообщитьПользвателюКлиент("Номенклатура");
				Отказ=Истина;
			КонецЕсли;
			
			Если Не ЕстьРегион Тогда
				СообщитьПользвателюКлиент("Регион");
				Отказ=Истина;
			КонецЕсли;
			
			
			
			Организация   = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Заказ,"Организация");
			Организация   = ?(ЗначениеЗаполнено(Организация),Организация,Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Объект.Получатель,"Организация"));
			
			Регион=
			?(
			ЗначениеЗаполнено(ТД.Регион),
			ТД.Регион,
			Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Заказ,"Регион")
			);  			
			
			ТД.ЗаказНаПроизводство=СоздатьЗаказНаполуфабрикатСервер(Организация,Объект.Площадка,ТД.Заказ,ТД.Партнер,Регион,ТД.Номенклатура,?(ТД.Количество=0,1,ТД.Количество),Истина);
			Записать(Новый Структура("РежимЗаписи, РежимПроведения", РежимЗаписиДокумента.Запись, РежимПроведенияДокумента.Неоперативный));  			
			//НаправитьВРаботуСервер(ТД.ЗаказНаПроизводство,ТД.Номенклатура);
			
			
			
		КонецЕсли;
	КонецЦикла;
	

	
	
КонецПроцедуры //-Лико m.shenderov 13.09.2021




