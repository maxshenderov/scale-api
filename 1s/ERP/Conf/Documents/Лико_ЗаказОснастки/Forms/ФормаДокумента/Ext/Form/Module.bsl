Процедура ДопОснасткаЗавершение(Результат, Параметры) Экспорт  //+Лико m.shenderov 13.10.2021
	
	Если ТипЗнч(Результат)=Тип("Массив") и Результат.Количество()>0 Тогда
		ТД=Элементы.Оснастка.ТекущиеДанные;
		//Массив = Новый Массив();
		//Массив.Добавить(ТД);
		
		//Тз=Объект.ОСнастка.Выгрузить(Массив);
		
		Для каждого Номенклатура Из Результат Цикл
			
			НоваяОснастка=Объект.Оснастка.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяОснастка,ТД,,"КлючСтроки,Номенклатура,ЗаказНаПроизводство");
			НоваяОснастка.Номенклатура=Номенклатура;
			
		КонецЦикла;
		
		
	КонецЕсли;
	
	
КонецПроцедуры //-Лико m.shenderov 13.10.2021

