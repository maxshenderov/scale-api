&НаСервере
Процедура ОбновитьЗаголовокДлинаШирина()
	
	Если Объект.Площадка = Справочники.Лико_Площадки.Урал Тогда
		Элементы.ОснасткаДлинаЭтикетки.Заголовок = "Длина этикетки";
		Элементы.ОснасткаШиринаЭтикетки.Заголовок = "Ширина этикетки";
		Элементы.ОснасткаДлинаЭтикетки1.Заголовок = "Длина этикетки";
		Элементы.ОснасткаШиринаЭтикетки1.Заголовок = "Ширина этикетки";

	Иначе
		Элементы.ОснасткаДлинаЭтикетки.Заголовок = "Высота этикетки (по нарезке)";
		Элементы.ОснасткаШиринаЭтикетки.Заголовок = "Ширина этикетки (по раппорту)";
		Элементы.ОснасткаДлинаЭтикетки1.Заголовок = "Высота этикетки (по нарезке)";
		Элементы.ОснасткаШиринаЭтикетки1.Заголовок = "Ширина этикетки (по раппорту)";
	КонецЕсли;

КонецПроцедуры
	

&НаСервере
Процедура ПриСозданииНаСервереВместо(Отказ, СтандартнаяОбработка)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

	Если Объект.ВидОперации  = Перечисления.Лико_ВидыОперацийЗаказОснастки.Перезаказ  И 
		Не РольДоступна("Лико_ИнженерОснастки") И 
		Не  РольДоступна("ПолныеПрава")Тогда
 
		    
		УстановитьВидимостьПараметров(Ложь,Ложь);
	Иначе
		УстановитьВидимостьПараметров(Истина,Истина);
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(параметры.ЗначениеКопирования) Тогда 
		Для каждого стр из Объект.Оснастка Цикл
			стр.статус = Перечисления.Лико_СтатусыЗаказовНаОснастку.Создан;	
		КонецЦикла;
	КонецЕсли;	
	Если Не (РольДоступна("ПолныеПрава") ИЛИ  РольДоступна("Лико_ДобавлениеИзменениеЗаказовПоПлощадке") ИЛИ  РольДоступна("Лико_ИнженерОснастки")) Тогда 
		Элементы.Комментарий.Доступность = Ложь;
	КонецЕсли;
	Если Не РольДоступна("ПолныеПрава") Тогда
		Элементы.Номер.Доступность = Ложь;
	КонецЕсли;
	
	Если   РольДоступна("Лико_Разработчик3dМоделей")  И Не РольДоступна("ПолныеПрава") Тогда
		 УстановитьВидемостьДляРазработчика3dМоделей();
	КонецЕсли;
	
	
	ДобавитьУсловноеОформление();
	ОбновитьЗаголовокДлинаШирина();

КонецПроцедуры






