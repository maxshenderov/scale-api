&НаКлиенте
Процедура ДопОснастка(Команда)
	ТД=Элементы.Оснастка.ТекущиеДанные;
	Если ТД=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Артикул=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Номенклатура,"Артикул");
	Структура = Новый Структура;
	Структура.Вставить("Артикул",Артикул);

	ОО= Новый ОписаниеОповещения("ДопОснасткаЗавершение",ЭтаФорма);
	
	ОткрытьФорму("Документ.Лико_ЗаказОснастки.Форма.ФормаПодбораДопОснастки",Структура,,,,,ОО,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

