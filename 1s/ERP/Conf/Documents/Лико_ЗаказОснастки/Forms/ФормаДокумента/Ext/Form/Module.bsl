&НаСервере
Процедура ОтправитьПисьмоНаСервере(ПисьмоТехнологу, ПисьмоМенеджерам)
	АдресатМенеджер = "";
	АдресатТехнолог = "";
	Адресат = "";
	
	
	Если ПисьмоТехнологу Тогда 
		АдресатТехнолог = Лико_Планирование.ПолучитьПочтуПользователя(Справочники.Пользователи.НайтиПоНаименованию("Ромса Виталий"));
	КонецЕсли;
	Если Объект.ВидОперации = Перечисления.Лико_ВидыОперацийЗаказОснастки.Перезаказ Тогда 
		Тема = "Создан заказ на оснастку №"+ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Объект.Номер)+" для перезаказа ранее использованных штампов: ";
    КонецЕсли;
	
	Если ПисьмоМенеджерам Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ЗаказОснасткиОснастка.Менеджер КАК Менеджер,
		|	Лико_ЗаказОснасткиОснастка.Номенклатура,
		|	Лико_ЗаказОснасткиОснастка.Номенклатура.Артикул КАК Артикул,
		|	Лико_ЗаказОснасткиОснастка.Заказ,
		|	Лико_ЗаказОснасткиОснастка.Заказ.НомерБезПрефикса Как НомерЗаказа
		|ИЗ
		|	Документ.Лико_ЗаказОснастки.Оснастка КАК Лико_ЗаказОснасткиОснастка
		|ГДЕ
		|	Лико_ЗаказОснасткиОснастка.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	Лико_ЗаказОснасткиОснастка.Менеджер,
		|	Лико_ЗаказОснасткиОснастка.Номенклатура,
		|	Лико_ЗаказОснасткиОснастка.Номенклатура.Артикул,
		|	Лико_ЗаказОснасткиОснастка.Заказ,
		|	Лико_ЗаказОснасткиОснастка.Заказ.НомерБезПрефикса
		|ИТОГИ ПО
		|	Менеджер";
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		ВыборкаМенеджер = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Менеджер");
		Пока ВыборкаМенеджер.Следующий()  Цикл
			АдресатМенеджер = Лико_Планирование.ПолучитьПочтуПользователя(ВыборкаМенеджер.Менеджер);
			СтрОснастки = "";
			Выборка = ВыборкаМенеджер.Выбрать();
			Пока Выборка.Следующий() Цикл
				СтрОснастки = СтрОснастки+ " Заказ №"+Выборка.НомерЗаказа+" штамп " +Выборка.Номенклатура.Артикул;
			КонецЦикла;	
			текст = Тема+ СтрОснастки;
			Адресат = АдресатТехнолог+?(ЗначениеЗаполнено(АдресатТехнолог), "; ", "")+АдресатМенеджер;
			Лико_Планирование.ОтправитьПисьмо(текст, Тема, Адресат) ;

		КонецЦикла;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ЗаказОснасткиОснастка.Менеджер КАК Менеджер,
		|	Лико_ЗаказОснасткиОснастка.Номенклатура,
		|	Лико_ЗаказОснасткиОснастка.Номенклатура.Артикул КАК Артикул,
		|	Лико_ЗаказОснасткиОснастка.Заказ
		|ИЗ
		|	Документ.Лико_ЗаказОснастки.Оснастка КАК Лико_ЗаказОснасткиОснастка
		|ГДЕ
		|	Лико_ЗаказОснасткиОснастка.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Менеджер";
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		СтрОснастки = "";
		Пока Выборка.Следующий() Цикл
			СтрОснастки = СтрОснастки+ " Заказ №"+ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Выборка.Заказ.Номер)+" штамп " +Выборка.Номенклатура.Артикул;
		КонецЦикла;
		текст = Тема+ СтрОснастки;
		Лико_Планирование.ОтправитьПисьмо(текст, Тема, АдресатТехнолог) ;
	КонецЕсли;	
	
КонецПроцедуры


&НаСервере
Функция ПечатьЗаказОснасткиНаСервере(НомерСтроки = 0)
	Макет = Документы.Лико_ЗаказОснастки.ПОлучитьМакет("ЗаказОснастки");
	ТабДокумент = Новый ТабличныйДокумент;
	Запрос = Новый Запрос;

	Если НомерСтроки>0 Тогда 
		УсловиеСтроки = "	И Лико_ЗаказОснасткиОснастка.НомерСтроки = &НомерСтроки";
	Иначе
		УсловиеСтроки = "";
	КонецЕсли;	

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗаказОснасткиОснастка.Заказ КАК Заказ,
	|	Лико_ЗаказОснасткиОснастка.Заказ.Регион КАК Регион,
	|	Лико_ЗаказОснасткиОснастка.Менеджер КАК Менеджер,
	|	Лико_ЗаказОснасткиОснастка.Партнер КАК Контрагент,
	|	Лико_ЗаказОснасткиОснастка.Тираж КАК Тираж,
	|	Лико_ЗаказОснасткиОснастка.КоличествоЦветов КАК КоличествоЦветов,
	|	Лико_ЗаказОснасткиОснастка.Материал КАК Материал,
	|	Лико_ЗаказОснасткиОснастка.Нарезка КАК Нарезка,
	|	Лико_ЗаказОснасткиОснастка.Подложка КАК Подложка,
	|	Лико_ЗаказОснасткиОснастка.ВидШтампа КАК ВидШтампа,
	|	Лико_ЗаказОснасткиОснастка.Номенклатура.Артикул КАК Артикул,
	|	Лико_ЗаказОснасткиОснастка.Номенклатура КАК Номенклатура,
	|	Лико_ЗаказОснасткиОснастка.Количество КАК Количество,
	|	Лико_ЗаказОснасткиОснастка.ВидРЦ КАК ТипРЦ,
	|	Лико_ЗаказОснасткиОснастка.ТипВырубки КАК ТипВырубки,
	|	Лико_ЗаказОснасткиОснастка.ТипИнструмента КАК ТипИнструмента,
	|	Лико_ЗаказОснасткиОснастка.ШиринаРукава КАК ШиринаРукава,
	|	Лико_ЗаказОснасткиОснастка.ШагПечати КАК ШагПечати,
	|	Лико_ЗаказОснасткиОснастка.Z КАК Z,
	|	Лико_ЗаказОснасткиОснастка.ЭтикетокНаЛисте КАК ЭтикетокНаЛисте,
	|	Лико_ЗаказОснасткиОснастка.Ручьи КАК Ручьи,
	|	Лико_ЗаказОснасткиОснастка.ДлинаЭтикетки КАК ДлинаЭтикетки,
	|	Лико_ЗаказОснасткиОснастка.ШиринаЭтикетки КАК ШиринаЭтикетки,
	|	Лико_ЗаказОснасткиОснастка.ИнтервалМеждуРучьями КАК ИнтервалМеждуРучьями,
	|	Лико_ЗаказОснасткиОснастка.ИнтервалМеждуЭтикетками КАК ИнтервалМеждуЭтикетками,
	|	Лико_ЗаказОснасткиОснастка.НаправлениеНамотки КАК НаправлениеНамотки,
	|	Лико_ЗаказОснасткиОснастка.Диаметр КАК Диаметр,
	|	Лико_ЗаказОснасткиОснастка.Радиус КАК Радиус,
	|	Лико_ЗаказОснасткиОснастка.ВидПечати КАК ВидПечати,
	|	Лико_ЗаказОснасткиОснастка.Статус КАК Статус,
	|	Лико_ЗаказОснасткиОснастка.КлючСтроки КАК КлючСтроки,
	|	Лико_ЗаказОснасткиОснастка.Ссылка.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА Лико_ЗаказОснасткиОснастка.Ручьи > 0
	|			ТОГДА Лико_ЗаказОснасткиОснастка.ЭтикетокНаЛисте / Лико_ЗаказОснасткиОснастка.Ручьи
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЧислоЭтикеток,
	|	Лико_ЗаказОснасткиОснастка.Примечание КАК Примечание,
	|	Лико_ЗаказОснасткиОснастка.РабочийЦентр КАК РЦ,
	|	Лико_ЗаказОснасткиОснастка._3DМодель КАК _3DМодель,
	|	Лико_ЗаказОснасткиОснастка.Книжка КАК Книжка,
	|	Лико_ЗаказОснасткиОснастка.Вклейка КАК Вклейка
	|ИЗ
	|	Документ.Лико_ЗаказОснастки.Оснастка КАК Лико_ЗаказОснасткиОснастка
	|ГДЕ
	|	Лико_ЗаказОснасткиОснастка.Ссылка = &Ссылка"+УсловиеСтроки;
	
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("НомерСтроки", НомерСтроки);
	Выборка = Запрос.Выполнить().Выбрать();
	сч = 0;
	Пока Выборка.Следующий() Цикл
		Если сч>0 Тогда 
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;	
		ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
		НомерДок =  ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Объект.Номер);
		ОбластьМакета.Параметры.ТекстЗаголовка = "Заявка № "+ НомерДок;
		ТабДокумент.Вывести(ОбластьМакета);

		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ОбластьШапка.Параметры.Заполнить(Выборка);
		ОбластьШапка.Параметры.НомерДок =  НомерДок;
		ОбластьШапка.Параметры.Дата =  Объект.Дата;
		ОбластьШапка.Параметры.Площадка = Объект.Площадка;
		//ОбластьШапка.Параметры.НомерЗаказа = ОбщегоНазначения.ПолучитьНомерНаПечать(Выборка.Заказ);

		ТабДокумент.Вывести(ОбластьШапка);	
		ЗапросЭт = Новый Запрос;
		ЗапросЭт.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
