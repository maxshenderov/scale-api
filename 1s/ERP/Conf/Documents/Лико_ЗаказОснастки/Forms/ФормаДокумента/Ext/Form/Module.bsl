			ОбластьПоРаппорту.Текст = "";
			ОбластьКнижка = Макет.Область("Книжка");
			ОбластьКнижка.Текст = "";
			Область3DМодель = Макет.Область("_3DМодель");
			Область3DМодель.Текст = "";
		КонецЕсли;
		Если Объект.Площадка = Справочники.Лико_Площадки.Урал Тогда
