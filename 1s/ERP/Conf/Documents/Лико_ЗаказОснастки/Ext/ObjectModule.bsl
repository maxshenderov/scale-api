

Процедура ОбработкаПроведения(Отказ, РежимПроведения)	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗаказОснасткиОснастка.Ссылка КАК Ссылка,
	|	Лико_ЗаказОснасткиОснастка.Номенклатура КАК Номенклатура,
	|	Лико_ЗаказОснасткиОснастка.Количество КАК Количество,
	|	Лико_ЗаказОснасткиОснастка.Менеджер КАК Менеджер,
	|	Лико_ЗаказОснасткиОснастка.Заказ КАК Заказ,
	|	Лико_ЗаказОснасткиОснастка.Статус КАК Статус,
	|	Лико_ЗаказОснасткиОснастка.Примечание КАК Примечание,
	|	Лико_ЗаказОснасткиОснастка.КлючСтроки КАК КлючСтроки,
	|	Лико_ЗаказОснасткиОснастка.ЗаказНаПроизводство КАК ВнутреннийЗаказ
	|ИЗ
	|	Документ.Лико_ЗаказОснастки.Оснастка КАК Лико_ЗаказОснасткиОснастка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЗаказыНаОснастку КАК Лико_ЗаказыНаОснастку
	|		ПО Лико_ЗаказОснасткиОснастка.КлючСтроки = Лико_ЗаказыНаОснастку.КлючСтроки
	|			И Лико_ЗаказОснасткиОснастка.Ссылка = Лико_ЗаказыНаОснастку.ЗаказНаОснастку
	|			И Лико_ЗаказОснасткиОснастка.Статус = Лико_ЗаказыНаОснастку.Статус
	|ГДЕ
	|	Лико_ЗаказыНаОснастку.ЗаказНаОснастку ЕСТЬ NULL
	|	И Лико_ЗаказОснасткиОснастка.Ссылка = &ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	ОтправлятьПисьмо = Ложь;
	Пока Выборка.Следующий() Цикл
		Запись 					= РегистрыСведений.Лико_ЗаказыНаОснастку.СоздатьМенеджерЗаписи();
		Запись.Период 			= ТекущаяДата();
		Запись.ЗаказНаОснастку 	= Ссылка;
		Запись.Заказ 			= Выборка.Заказ;
		Запись.Менеджер 		= Выборка.Менеджер;
		Запись.Номенклатура 	= Выборка.Номенклатура;
		Запись.Статус 			= Выборка.Статус;
		Запись.Количество 		= Выборка.Количество;
		Запись.Примечание 		= Выборка.Примечание;
		Запись.КлючСтроки 		= Выборка.КлючСтроки;
		Запись.ВнутреннийЗаказ 	= Выборка.ВнутреннийЗаказ;

		Запись.Ответственный 	= Пользователи.ТекущийПользователь();
		Запись.Записать();
		Если Выборка.Статус = Перечисления.Лико_СтатусыЗаказовНаОснастку.Подтвержден Тогда 
			ОтправлятьПисьмо = Истина;
		КонецЕсли;	
	КонецЦикла;
	
	//Дозаполним записи, если они изменились (были удалены или добавлены номенклатура, заказ и т.д.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗаказыНаОснастку.Номенклатура КАК Номенклатура,
	|	Лико_ЗаказыНаОснастку.Период КАК Период,
	|	Лико_ЗаказыНаОснастку.Менеджер КАК Менеджер,
	|	Лико_ЗаказыНаОснастку.Заказ КАК Заказ,
	|	Лико_ЗаказыНаОснастку.ЗаказНаОснастку КАК ЗаказНаОснастку,
	|	Лико_ЗаказыНаОснастку.КлючСтроки КАК КлючСтроки,
	|	Лико_ЗаказыНаОснастку.ВнутреннийЗаказ КАК ВнутреннийЗаказ
	|ПОМЕСТИТЬ ВТЗаписей
	|ИЗ
	|	РегистрСведений.Лико_ЗаказыНаОснастку КАК Лико_ЗаказыНаОснастку
	|ГДЕ
	|	Лико_ЗаказыНаОснастку.ЗаказНаОснастку = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЗаписей.ЗаказНаОснастку КАК ЗаказНаОснастку,
	|	ВТЗаписей.КлючСтроки КАК КлючСтроки,
	|	ВТЗаписей.Номенклатура КАК Номенклатура,
	|	ВТЗаписей.Период КАК Период,
	|	ВТЗаписей.Менеджер КАК Менеджер,
	|	ВТЗаписей.Заказ КАК Заказ,
	|	Лико_ЗаказОснасткиОснастка.Менеджер КАК Менеджер1,
	|	Лико_ЗаказОснасткиОснастка.Заказ КАК Заказ1,
	|	Лико_ЗаказОснасткиОснастка.Номенклатура КАК Номенклатура1,
	|	Лико_ЗаказОснасткиОснастка.Ссылка КАК Ссылка,
	|	ВТЗаписей.ВнутреннийЗаказ КАК ВнутреннийЗаказ
	|ИЗ
	|	ВТЗаписей КАК ВТЗаписей
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лико_ЗаказОснастки.Оснастка КАК Лико_ЗаказОснасткиОснастка
	|		ПО (Лико_ЗаказОснасткиОснастка.Ссылка = ВТЗаписей.ЗаказНаОснастку)
	|			И (Лико_ЗаказОснасткиОснастка.КлючСтроки = ВТЗаписей.КлючСтроки)
	|ГДЕ
	|	(ВТЗаписей.Менеджер <> Лико_ЗаказОснасткиОснастка.Менеджер
	|			ИЛИ ВТЗаписей.Заказ <> Лико_ЗаказОснасткиОснастка.Заказ
	|			ИЛИ ВТЗаписей.Номенклатура <> Лико_ЗаказОснасткиОснастка.Номенклатура
	|			ИЛИ Лико_ЗаказОснасткиОснастка.Ссылка ЕСТЬ NULL)";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда 
			Запись 					= РегистрыСведений.Лико_ЗаказыНаОснастку.СоздатьМенеджерЗаписи();
			Запись.Период 			= Выборка.Период;
			Запись.ЗаказНаОснастку 	= Ссылка;
			Запись.Ключстроки	 	= Выборка.КлючСтроки;
			Запись.Заказ 			= Выборка.Заказ;
			Запись.Менеджер 		= Выборка.Менеджер;
			Запись.Номенклатура 	= Выборка.Номенклатура;
			Запись.ВнутреннийЗаказ 	= Выборка.ВнутреннийЗаказ;

			Запись.Прочитать();
			Запись.Период 			= Выборка.Период;
			Запись.ЗаказНаОснастку 	= Ссылка;
			Запись.Ключстроки	 	= Выборка.КлючСтроки;
			Запись.ВнутреннийЗаказ 	= Выборка.ВнутреннийЗаказ;
			Запись.Заказ 			= Выборка.Заказ1;
			Запись.Менеджер 		= Выборка.Менеджер1;
			Запись.Номенклатура 	= Выборка.Номенклатура1;
			Запись.Записать();
		КонецЕсли;
			
	КонецЦикла;

	// --> Маковеева А.Ю. 01.08.2018
	//ищем параметры штампов с пустыми реквизитами "Менеджер", "Партнер" и "Заказ" и заполняем их
	
	ТЗ_Оснастка = Оснастка.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ_Оснастка.Номенклатура КАК Номенклатура,
		|	ТЗ_Оснастка.Партнер КАК Партнер,
		|	ТЗ_Оснастка.Менеджер КАК Менеджер,
		|	ТЗ_Оснастка.Заказ КАК Заказ
		|ПОМЕСТИТЬ ВТ_Оснастка
		|ИЗ
		|	&ТЗ_Оснастка КАК ТЗ_Оснастка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Оснастка.Номенклатура КАК Номенклатура,
		|	ВТ_Оснастка.Партнер КАК Партнер,
		|	ВТ_Оснастка.Менеджер КАК Менеджер,
		|	ВТ_Оснастка.Заказ КАК Заказ
		|ИЗ
		|	РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Оснастка КАК ВТ_Оснастка
		|		ПО Лико_ПараметрыШтампа.Номенклатура = ВТ_Оснастка.Номенклатура
		|ГДЕ
		|	Лико_ПараметрыШтампа.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
		|	И Лико_ПараметрыШтампа.Менеджер = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|	И Лико_ПараметрыШтампа.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ТЗ_Оснастка", ТЗ_Оснастка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаШтампов = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаШтампов.Следующий() Цикл
		
		НЗ_ПараметрыШтампа = РегистрыСведений.Лико_ПараметрыШтампа.СоздатьНаборЗаписей();
		НЗ_ПараметрыШтампа.Отбор.Номенклатура.Установить(ВыборкаШтампов.Номенклатура);
		НЗ_ПараметрыШтампа.Прочитать();
		
		Для Каждого ПараметрыШтампа Из НЗ_ПараметрыШтампа Цикл
			ЗаполнитьЗначенияСвойств(ПараметрыШтампа, ВыборкаШтампов, "Заказ, Партнер, Менеджер"); 	
		КонецЦикла;
		
		Попытка
			НЗ_ПараметрыШтампа.Записать();
		Исключение
			Сообщить("Произошла ошибка при заполнении параметров штампа " + Строка(ВыборкаШтампов.Номенклатура) + " (" + Строка(ВыборкаШтампов.Номенклатура.Код) + ")");
		КонецПопытки;
		
	КонецЦикла;
	// <-- Маковеева А.Ю. 01.08.2018
	
	Если ОтправлятьПисьмо Тогда 
		Адресат = Справочники.Лико_ПредопределенныеЗначения.ПользовательОтветственныйЗаОснастку.ЗначениеПараметра;
		Если ЗначениеЗаполнено(Адресат) Тогда 
			НомерЗаказаОснастки = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Ссылка.Номер);
			текст = "Подтвержден заказ на оснастку N " +НомерЗаказаОснастки+" пользователем "+Пользователи.ТекущийПользователь()  ;
			Тема = "Подтвержден заказ на оснастку N " +НомерЗаказаОснастки+ " вид: "+ВидОперации;
			Лико_Планирование.ОтправитьПисьмо(текст, Тема, Адресат) ;
		КонецЕсли;	
	КонецЕсли;	

	
КонецПроцедуры


Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказКлиента") 
		//+ Лико m.shenderov 15.09.2021
		
		Или (ТипЗнч(ДанныеЗаполнения)=Тип("Структура") И ДанныеЗаполнения.Свойство("Заказ")) Тогда
		
		МассивНоменклатур=Новый Массив;
		
		Если ТипЗнч(ДанныеЗаполнения)=Тип("Структура") Тогда
			Заказ = ДанныеЗаполнения.Заказ;
			МассивНоменклатур= ?(ДанныеЗаполнения.Свойство("МассивНоменклатур"),ДанныеЗаполнения.МассивНоменклатур,МассивНоменклатур);
		Иначе
			Заказ = ДанныеЗаполнения;
		КонецЕсли;
		//- Лико m.shenderov 15.09.2021
		
		//ИначеЕсли  ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.СпецификацииНоменклатуры") Тогда
		//	ЗаполнитьПоСпецификации(ДанныеЗаполнения,1);
		//ИначеЕсли  ТипЗнч(ДанныеЗаполнения) = Тип("Структура")  Тогда
		//	Если ДанныеЗаполнения.Свойство("Заказ") Тогда 
		// Заполнение шапки
		Ответственный = Пользователи.ТекущийПользователь();
		Площадка = Заказ.Площадка;
		//ВидОперации = Перечисления.Лико_ВидыОперацийЗаказОснастки.Перезаказ;
		//ЗаказНового = Ложь;
		ЗапросНом =Новый Запрос;
		ЗапросНом.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаказПокупателяТовары.Номенклатура
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказПокупателяТовары
		|ГДЕ
		|	ЗаказПокупателяТовары.Ссылка = &Заказ";
		ЗапросНом.УстановитьПараметр("Заказ", Заказ);
		ТЗНом = ЗапросНом.Выполнить().Выгрузить();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиентаЦвета.НомерСтроки) КАК КоличествоЦветов,
		|	ЗаказКлиентаЦвета.Ссылка КАК Заказ
		|ПОМЕСТИТЬ ТабЦветов
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
		|ГДЕ
		|	ЗаказКлиентаЦвета.Ссылка = &Заказ
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаЦвета.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаВидыРабот.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ГорячееТиснениеПлоское)
		|			ТОГДА ВЫБОР
		|					КОГДА ЗаказКлиентаВидыРабот.НаправлениеПротяжки = ЗНАЧЕНИЕ(Перечисление.Лико_НаправленияПротяжки.Поперечное)
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПоперечное)
		|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПродольное)
		|				КОНЕЦ
		|		ИНАЧЕ ЗаказКлиентаВидыРабот.ВидСекции.ВидРабот
		|	КОНЕЦ КАК ВидРабот,
		|	ЗаказКлиентаВидыРабот.РабочийЦентр КАК РабочийЦентр,
		|	ЗаказКлиентаВидыРабот.Оснастка КАК Номенклатура,
		|	ЗаказКлиентаВидыРабот.ЗаказНовойОснастки КАК ЗаказНовойОснастки,
		|	ЗаказКлиентаВидыРабот.Ссылка.ОсновнойМатериал КАК Материал,
		|	ЗаказКлиентаВидыРабот.Ссылка.Партнер КАК Партнер,
		|	ЗаказКлиентаВидыРабот.Ссылка.ОсновнойМатериал КАК ОсновнойМатериал,
		|	ЗаказКлиентаВидыРабот.Ссылка.МетражПМ КАК МетражПМ,
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаВидыРабот.Оснастка = ЗаказКлиентаВидыРабот.Ссылка.ШтампВырубной
		|			ТОГДА ЗаказКлиентаВидыРабот.Ссылка.Нарезка
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ЗаказКлиентаВидыРабот.Нарезка <> ЗНАЧЕНИЕ(Справочник.Яссм_Нарезки.ПустаяСсылка)
		|					ТОГДА ЗаказКлиентаВидыРабот.Нарезка
		|				ИНАЧЕ Лико_ПараметрыШтампа.Нарезка
		|			КОНЕЦ
		|	КОНЕЦ КАК Нарезка,
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаВидыРабот.Оснастка = ЗаказКлиентаВидыРабот.Ссылка.ШтампВырубной
		|			ТОГДА ЗаказКлиентаВидыРабот.Ссылка.ЭтикетокНаЛисте
		|		ИНАЧЕ Лико_ПараметрыШтампа.ЭтикетокНаЛисте
		|	КОНЕЦ КАК ЭтикетокНаЛисте,
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаВидыРабот.Оснастка = ЗаказКлиентаВидыРабот.Ссылка.ШтампВырубной
		|			ТОГДА ЗаказКлиентаВидыРабот.Ссылка.ШагПечати
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ЗаказКлиентаВидыРабот.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Нумератор)
		|						И ЗаказКлиентаВидыРабот.КоличествоРучьевНумератора <> 0
		|					ТОГДА ЗаказКлиентаВидыРабот.КоличествоРучьевНумератора
		|				КОГДА ЗаказКлиентаВидыРабот.Подача <> 0
		|					ТОГДА ЗаказКлиентаВидыРабот.Подача
		|				ИНАЧЕ Лико_ПараметрыШтампа.ШагПечати
		|			КОНЕЦ
		|	КОНЕЦ КАК ШагПечати,
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаВидыРабот.Оснастка = ЗаказКлиентаВидыРабот.Ссылка.ШтампВырубной
		|			ТОГДА ЗаказКлиентаВидыРабот.Ссылка.Ручьи
		|		ИНАЧЕ Лико_ПараметрыШтампа.Ручьи
		|	КОНЕЦ КАК Ручьи,
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаВидыРабот.Оснастка = ЗаказКлиентаВидыРабот.Ссылка.ШтампВырубной
