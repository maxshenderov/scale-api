Функция ЭлектроныеАдресаОтвественныхЗаЗаявкиНаОснастку(Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	  |	Лико_ЗаказОснасткиОснастка.Номенклатура КАК Номенклатура,
	  |	МАКСИМУМ(Лико_ЗаказОснасткиОснастка.Ссылка.Дата) КАК Дата
	  |ПОМЕСТИТЬ втДатыПоследнихЗаказов
	  |ИЗ
	  |	Документ.Лико_ЗаказОснастки.Оснастка КАК Лико_ЗаказОснасткиОснастка
	  |ГДЕ
	  |	Лико_ЗаказОснасткиОснастка.Номенклатура В(&Номенклатура)
	  |
	  |СГРУППИРОВАТЬ ПО
	  |	Лико_ЗаказОснасткиОснастка.Номенклатура
	  |;
	  |
	  |////////////////////////////////////////////////////////////////////////////////
	  |ВЫБРАТЬ
	  |	Лико_ЗаказОснасткиОснастка.Ссылка КАК Ссылка,
	  |	Лико_ЗаказОснасткиОснастка.Номенклатура КАК Номенклатура,
	  |	втДатыПоследнихЗаказов.Дата КАК Дата,
	  |	Лико_ЗаказОснасткиОснастка.Ссылка.Ответственный КАК Ответственный
	  |ИЗ
	  |	втДатыПоследнихЗаказов КАК втДатыПоследнихЗаказов
	  |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_ЗаказОснастки.Оснастка КАК Лико_ЗаказОснасткиОснастка
	  |		ПО втДатыПоследнихЗаказов.Дата = Лико_ЗаказОснасткиОснастка.Ссылка.Дата
	  |			И втДатыПоследнихЗаказов.Номенклатура = Лико_ЗаказОснасткиОснастка.Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Ответственные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ответственный");
	Емайлы = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(Ответственные,Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты,Справочники.ВидыКонтактнойИнформации.EmailПользователя);
КонецФункции

