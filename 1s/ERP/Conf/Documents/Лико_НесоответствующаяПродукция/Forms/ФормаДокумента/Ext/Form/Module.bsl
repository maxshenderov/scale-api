Процедура СотрудникиСотрудникПриИзменении(Элемент)
	текстр = Элементы.Сотрудники.ТекущиеДанные;
	Если ЗначениеЗаполнено(текстр.сотрудник) Тогда 
		стртовары = Элементы.ТОвары.ТекущиеДанные;
		Если ЗначениеЗаполнено(стртовары.датаработы) Тогда 
			текстр.Должность = НайтиДолжностьСотрудника(текстр.Сотрудник,стртовары.датаработы );
		Иначе
			текстр.Должность = НайтиДолжностьСотрудника(текстр.Сотрудник,объект.дата );
		КонецЕсли;	

		текстр.Дата = НайтиДатуРаботы(текстр.Сотрудник, стртовары.заказклиента);
	КонецЕсли;
КонецПроцедуры


&НаСервере
Функция НайтиДатуРаботы(Сотрудник, заказ)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(ЗаказКлиентаПроизводство.Дата) КАК Дата
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.ЗаказКлиента.Производство КАК ЗаказКлиентаПроизводство
	|ГДЕ
	|	ЗаказКлиентаПроизводство.Ссылка = &Заказ
	|	И ЗаказКлиентаПроизводство.Сотрудник = &Сотрудник
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(ЗаказКлиентаПеремотка.Дата)
	|ИЗ
	|	Документ.ЗаказКлиента.Перемотка КАК ЗаказКлиентаПеремотка
	|ГДЕ
	|	ЗаказКлиентаПеремотка.Ссылка = &Заказ
	|	И ЗаказКлиентаПеремотка.Сотрудник = &Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ.Дата) КАК Дата
	|ИЗ
	|	ВТ КАК ВТ";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Заказ", Заказ);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Возврат Результат.Дата;
	КонецЕсли;

КонецФункции

