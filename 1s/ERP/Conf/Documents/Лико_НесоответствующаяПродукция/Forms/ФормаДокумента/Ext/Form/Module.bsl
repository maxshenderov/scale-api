&НаКлиенте
Процедура ФайлыНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Не Файлы<>"Добавьте каталог" Тогда 
		ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	
		ДиалогВыбораФайла.ПолноеИмяФайла = "";
		ДиалогВыбораФайла.Фильтр = "(*.*)|*.*";
		ДиалогВыбораФайла.МножественныйВыбор = Ложь;
		ДиалогВыбораФайла.Заголовок = "Выберите каталог";
	
		Если ДиалогВыбораФайла.Выбрать() Тогда
			Файлы = ДиалогВыбораФайла.Каталог;
		КонецЕсли;

		
	Иначе
		WshShell = Новый COMОбъект("WScript.Shell");
		WshShell.Run("Explorer "+Файлы);

	КонецЕсли;

КонецПроцедуры

