&НаСервере
Функция ПечатьНППоСотрудникуНаСервере(номерстрокизаказа, номерстрокисотрудника)
	ВПФ = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("Печатная форма ""Расследование причин дефекта""");
	ВнешняяОбработкаОбъект = ДополнительныеОтчетыИОбработкиВызовСервера.ОбъектВнешнейОбработки(ВПФ);
	ВнешняяОбработкаОбъект.НомерСтрокиЗаказа = НомерСтрокиЗаказа;
	ВнешняяОбработкаОбъект.НомерСтрокиСотрудника = НомерСтрокиСотрудника;
	Массив = Новый Массив();
	Массив.Добавить(Объект.Ссылка);
	
	ТабДокумент = ВнешняяОбработкаОбъект.ПечатьРасследованиеПричинДефекта(Массив);
	Возврат ТабДокумент;
	
КонецФункции

&НаКлиенте
Процедура ПечатьНППоСотруднику(Команда)
	текстр = Элементы.ТОвары.ТекущиеДанные;
	текстрсотрудник = Элементы.Сотрудники.текущиеданные;
	Если текстр<>Неопределено И текстрсотрудник <>Неопределено ТОгда	
		МассивТабДок = ПечатьНППоСотрудникуНаСервере(текстр.номерстроки, текстрсотрудник.НомерСтроки);
		Если  МассивТабДок.Количество() >0 Тогда 
			ТабДокумент =  МассивТабДок[0].ТабДок;
			ТабДокумент.ТолькоПросмотр = Истина;
			ТабДокумент.АвтоМасштаб=Истина;
			ТабДокумент.ЭкземпляровНаСтранице=1;
			ТабДокумент.ОтображатьЗаголовки = Ложь;
			ТабДокумент.Показать();		
		КонецЕсли;	
	КонецЕсли;	
	
	
КонецПроцедуры

&НаСервере
Функция ПечатьОбразецБракаПоЗаказуСервере(номерстрокизаказа)
	ВПФ = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("Печатная форма ""Образец брака""");
	ВнешняяОбработкаОбъект = ДополнительныеОтчетыИОбработкиВызовСервера.ОбъектВнешнейОбработки(ВПФ);
	ВнешняяОбработкаОбъект.НомерСтрокиЗаказа = НомерСтрокиЗаказа;
	Массив = Новый Массив();
	Массив.Добавить(Объект.Ссылка);
	
	ТабДокумент = ВнешняяОбработкаОбъект.ПечатьОбразецБрака(Массив);
	Возврат ТабДокумент;
	
КонецФункции


&НаКлиенте
Процедура ПечатьОбразецБракаПоЗаказу(Команда)
	текстр = Элементы.ТОвары.ТекущиеДанные;
	Если текстр<>Неопределено ТОгда	
		МассивТабДок = ПечатьОбразецБракаПоЗаказуСервере(текстр.номерстроки);
		Если  МассивТабДок.Количество() >0 Тогда 
			ТабДокумент =  МассивТабДок[0].ТабДок;
			ТабДокумент.ТолькоПросмотр = Истина;
			ТабДокумент.АвтоМасштаб=Истина;
			ТабДокумент.ЭкземпляровНаСтранице=1;
			ТабДокумент.ОтображатьЗаголовки = Ложь;
			ТабДокумент.Показать();		
		КонецЕсли;	
	КонецЕсли;	

КонецПроцедуры

