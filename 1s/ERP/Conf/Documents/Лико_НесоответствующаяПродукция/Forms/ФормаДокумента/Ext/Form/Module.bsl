&НаКлиенте
Процедура ПечатьЗаключенияДляПечатников(Команда)
	
	текстр = Элементы.Товары.ТекущиеДанные;
	текстрсотрудник = Элементы.Сотрудники.ТекущиеДанные;
	Если текстр <> Неопределено И текстрсотрудник <> Неопределено Тогда	
		ТабДокумент = ПечатьЗаключенияПоАктуОБракеНаСервере(текстр.НомерСтроки, текстрсотрудник.НомерСтроки, Истина);
		ТабДокумент.Показать();		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЗаключенияДляПеремотчиков(Команда)
	
	текстр = Элементы.Товары.ТекущиеДанные;
	текстрсотрудник = Элементы.Сотрудники.ТекущиеДанные;
	Если текстр <> Неопределено И текстрсотрудник <> Неопределено Тогда	
		ТабДокумент = ПечатьЗаключенияПоАктуОБракеНаСервере(текстр.НомерСтроки, текстрсотрудник.НомерСтроки);
		ТабДокумент.Показать();		
	КонецЕсли;	
	
