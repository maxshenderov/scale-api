	Если ЗначениеЗаполнено(текстр.ЗаказКлиента) Тогда
		текстр.МетражКВЗабракованных =  РассчитатьМетраж(текстр.КоличествоЗабракованных, текстр.ЗаказКлиента);
	КонецЕсли;	

КонецПроцедуры


&НаСервере
Процедура ТоварыЗаказКлиентаПриИзмененииНаСервере(Идентификатор, заказ)
	
	Объект.Партнер = Заказ.Партнер;
	Объект.Менеджер = Заказ.Менеджер;
	Объект.Организация = Заказ.Организация;
	Объект.Площадка = Заказ.Площадка;
	текстр = Объект.Товары.НайтиПоИдентификатору(Идентификатор);
	текстр.ЗаказКлиента = Заказ;
	ДокументОбъект = РеквизитФормыВЗначение("Объект"); 
	ДокументОбъект.ЗаполнитьСтрокуПоЗаказу(текстр); 
	
