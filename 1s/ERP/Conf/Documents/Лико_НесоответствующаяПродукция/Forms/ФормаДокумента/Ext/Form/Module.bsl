&НаСервере
Функция  ПечатьЗаключенияПоАктуОБракеНаСервере(номерстрокизаказа, номерстрокисотрудника, ДляПечатников = Ложь)
	
	ВПФ = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("Печатная форма ""лк Заключение по акту о браке""");
	ВнешняяОбработкаОбъект = ДополнительныеОтчетыИОбработкиВызовСервера.ОбъектВнешнейОбработки(ВПФ);
	ВнешняяОбработкаОбъект.НомерСтрокиЗаказа 		= НомерСтрокиЗаказа;
	ВнешняяОбработкаОбъект.НомерСтрокиСотрудника 	= НомерСтрокиСотрудника;
	ВнешняяОбработкаОбъект.ДляПечатников 			= ДляПечатников;
	Массив = Новый Массив();
	Массив.Добавить(Объект.Ссылка);
	
	ТабДокумент = ВнешняяОбработкаОбъект.ПечатьВнешнейПечатнойФормы(Массив);
	
	ТабДокумент.ТолькоПросмотр 			= Истина;
	ТабДокумент.АвтоМасштаб 			= Истина;
	ТабДокумент.ЭкземпляровНаСтранице 	= 1;
	ТабДокумент.ОтображатьЗаголовки 	= Ложь;
	
	Возврат ТабДокумент;
	
КонецФункции

