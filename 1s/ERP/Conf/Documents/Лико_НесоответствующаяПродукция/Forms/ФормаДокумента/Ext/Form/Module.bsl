&НаКлиенте
Процедура ОтправитьПисьмо(Команда)

	ВПФ = НайтиВПФ("Печатная форма ""Ответ на претензию""");

	Если ВПФ.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВПФ);
	ОбъектыНазначения = Новый Массив;
	ОбъектыНазначения.Добавить(Объект.Ссылка);
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ОбъектыНазначения", ОбъектыНазначения);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПОслеОтправкиПисьма", ЭтаФорма);

	ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма", ПараметрыОткрытия, ЭтаФорма, ,,,ОписаниеОповещения);

КонецПроцедуры

