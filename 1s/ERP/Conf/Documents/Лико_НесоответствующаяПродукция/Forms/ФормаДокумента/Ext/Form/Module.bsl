
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтоОтветственныйЗаРекламации =  ?(ЗначениеЗаполнено(УправлениеСвойствами.ЗначениеСвойства(Пользователи.ТекущийПользователь(), ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Ответственный за рекламации"))), Истина, Ложь);

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Объект.Состояние = Перечисления.Лико_СостоянияНесоответствийЗаказу.ВРаботе;
		Объект.СотрудникОбнаружившийБрак = Лико_Планирование.НайтиСотрудникаПоПользователю(Пользователи.ТекущийПользователь());	
		
		Если  ЭтоОтветственныйЗаРекламации Тогда 
			Объект.ВидОперации = Перечисления.Лико_ВидыОперацийНесоответствияЗаказу.РекламацияКлиента;
		Иначе 
			Если РольДоступна("Лико_ЗаказыКлиентов") ТОгда 
				Объект.ВидОперации = Перечисления.Лико_ВидыОперацийНесоответствияЗаказу.Прочее;
			КонецЕсли;
		КонецЕсли;
		Объект.Ответственный = ПОльзователи.ТекущийПользователь();

	КонецЕсли;
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если Не ЗначениеЗаполнено(Объект.Файлы) Тогда 
		Файлы = "Добавьте каталог";
	Иначе
		Файлы = Объект.Файлы;
		
	КонецЕсли;
	Если Объект.ВидОперации = Перечисления.Лико_ВидыОперацийНесоответствияЗаказу.Прочее Тогда 
		 УстановитьВидимостьЭлементов(Ложь);
	ИначеЕсли  Объект.видоперации = Перечисления.Лико_ВидыОперацийНесоответствияЗаказу.РекламацияКлиента Тогда 
		Если Не (РольДоступна("ПолныеПрава") ИЛИ РольДоступна("Лико_НесоответстветствующаяПродукция"))  Тогда 
			ЭтаФорма.ТолькоПросмотр = Истина;
		КонецЕсли;		
    КонецЕсли;	
 	ОбновитьВидимостьЭлементовДляИксПака();
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьЭлементовДляИксПака()
	
	Если Объект.Площадка = Справочники.Лико_Площадки.ИксПак И Объект.ВидОперации = Перечисления.Лико_ВидыОперацийНесоответствияЗаказу.РекламацияКлиента Тогда
		Элементы.ВидПретензии.Видимость = Истина;
		Элементы.ТоварыКатегорияПретензии.Видимость = Истина;
	Иначе 
		Элементы.ВидПретензии.Видимость = Ложь;
		Элементы.ТоварыКатегорияПретензии.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыДокументОтгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	текстр = Элементы.Товары.ТекущиеДанные;
	Если ЗначениеЗаполнено(текстр.ЗаказКлиента) Тогда
		СтандартнаяОбработка = Ложь;
		ДопПараметры = Новый Структура("Заказ", текстр.ЗаказКлиента);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПОслеВыбораОтгрузки", ЭтаФорма);
		ОткрытьФорму("Документ.ЗаказКлиента.Форма.Лико_ФормаВыбораДокументаОтгрузки", ДопПараметры, ЭтаФорма, ,,,ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура  ПОслеВыбораОтгрузки(Результат, Параметры) Экспорт
	Если ЗначениеЗаполнено(Результат) Тогда 
		стр = Элементы.ТОвары.текущиеданные;
		стр.документотгрузки = результат;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция РассчитатьМетраж(Тираж, Заказ)
	Если ЗначениеЗаполнено(Заказ.ШтКВМ) Тогда 
		Возврат Тираж*1000/ Заказ.ШтКВМ;
	Иначе 
		Возврат 0;
	КонецЕсли;
КонецФункции

