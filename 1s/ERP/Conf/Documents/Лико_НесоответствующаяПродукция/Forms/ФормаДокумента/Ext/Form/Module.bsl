&НаКлиенте
Процедура ЗаполнитьМетражВСотрудниках(Команда)
	Текстр = Элементы.ТОвары.ТекущиеДанные;
	стр = Элементы.Сотрудники.ТекущиеДанные;
	Если стр<> Неопределено Тогда 
		стр.Количество = текстр.количествоЗабракованных;
		стр.МетражКВМ = Текстр.МетражКВЗабракованных;
		стр.Дефект = текстр.дефект;
		стр.СостояниеРешенияПоСотруднику = ПредопределенноеЗначение("Перечисление.Лико_СостоянияРешенийПоСотрудникамДопустившимБрак.ВРаботе")
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ДобавитьЗаказПереборкиНаСервере(Идентификатор, ВидПовтора)
	
	стр = Объект.Товары.НайтиПоИдентификатору(Идентификатор);
	ИсходныйЗаказ = стр.ЗаказКлиента;
	// <-- Начало Лико Яцун С. В. 15.06.2023 
	//НовыйЗаказ =ИсходныйЗаказ.скопировать();
	Если ВидПовтора = Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка Тогда
		ОбъектИсходныйЗаказ = ИсходныйЗаказ.ПолучитьОбъект();
		ОбъектИсходныйЗаказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка;
		НовыйЗаказ = ОбъектИсходныйЗаказ.Скопировать();
	Иначе	
		НовыйЗаказ = ИсходныйЗаказ.Скопировать();
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 15.06.2023
	НовыйЗаказ.Версия = 0;
	НовыйЗаказ.ВидЗаказа =  ВидПовтора;
	//Если Регион<>Неопределено Тогда 
	//	НовыйЗаказ.Регион = Регион;
	//КонецЕсли;
	Если НовыйЗаказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПричинаРекламация Тогда
		НовыйЗаказ.Номер = Лев(ИсходныйЗаказ.Номер, 6)+"7"+Прав(ИсходныйЗаказ.Номер, 4);
	ИначеЕсли НовыйЗаказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка Тогда
		НовыйЗаказ.Номер = Лев(ИсходныйЗаказ.Номер, 6)+"8"+Прав(ИсходныйЗаказ.Номер, 4);
		НовыйЗаказ.Цвета.Очистить();
		НовыйЗаказ.ВидыРабот.Очистить();
		НовыйЗаказ.Формы.Очистить();
		стрработа = НовыйЗаказ.ВидыРабот.Добавить();
		стрработа.ВидРабот = Справочники.ВидыРаботСотрудников.Перемотка;
		стрработа.рабочийЦентр = Справочники.РабочиеЦентры.НайтиПоНаименованию("Перемотка", Истина);
		стрработа.номерпроката = 1;
		стрработа.номерварианта = 1;
		стрработа.ключстроки =  Новый УникальныйИдентификатор;
		// <-- Начало Лико Яцун С. В. 22.08.2023
		стрцветаработа = НовыйЗаказ.Цвета.Добавить();
		стрцветаработа.ВидСекции = Справочники.Лико_ВидыСекций.Перемотка;
		стрцветаработа.рабочийЦентр = Справочники.РабочиеЦентры.НайтиПоНаименованию("Перемотка", Истина);
		стрцветаработа.номерпроката = 1;
		стрцветаработа.номерварианта = 1;
		стрцветаработа.ключстроки =  Новый УникальныйИдентификатор;
		// <-- Конец Лико Яцун С. В. 22.08.2023
		// --> Начало Лико Митюшин МФМ 05.08.2021
		НовыйЗаказ.ШтампВырубной = Справочники.Номенклатура.ПустаяСсылка();
		Если ЗначениеЗаполнено(ИсходныйЗаказ.ДлинаПечати) И ЗначениеЗаполнено(ИсходныйЗаказ.ЭтикетокНаЛистеПечати) Тогда 
			НовыйЗаказ.ДлинаПечати 				= ИсходныйЗаказ.ДлинаПечати;
			НовыйЗаказ.ЭтикетокНаЛистеПечати 	= ИсходныйЗаказ.ЭтикетокНаЛистеПечати;
		ИначеЕсли ЗначениеЗаполнено(ИсходныйЗаказ.ШагПечати) И ЗначениеЗаполнено(ИсходныйЗаказ.ЭтикетокНаЛисте) Тогда
			НовыйЗаказ.ДлинаПечати 				= ИсходныйЗаказ.ШагПечати;
			НовыйЗаказ.ЭтикетокНаЛистеПечати 	= ИсходныйЗаказ.ЭтикетокНаЛисте;
		ИначеЕсли ЗначениеЗаполнено(ИсходныйЗаказ.ДлинаПечатиИндиго) И ЗначениеЗаполнено(ИсходныйЗаказ.ЭтикетокНаЛистеИндиго) Тогда
			НовыйЗаказ.ДлинаПечати 				= ИсходныйЗаказ.ДлинаПечатиИндиго;
			НовыйЗаказ.ЭтикетокНаЛистеПечати 	= ИсходныйЗаказ.ЭтикетокНаЛистеИндиго;
		КонецЕсли;	
		// <-- Конец Лико Митюшин МФМ 05.08.2021
	КонецЕсли;	
	//Проверим наличие заказа с указанным номером
	// --> Начало Лико Ефимов ЕВВ 18.03.2020
	//Если Документы.ЗаказКлиента.НайтиПоНомеру(НовыйЗаказ.Номер)<>Документы.ЗаказКлиента.ПустаяСсылка() Тогда 
	//	НовыйЗаказ.Номер = "";
	//КонецЕсли;
	Если ЗначениеЗаполнено(Документы.ЗаказКлиента.НайтиПоРеквизиту("НомерБезПрефикса", Прав(НовыйЗаказ.Номер, Метаданные.Документы.ЗаказКлиента.Реквизиты.НомерБезПрефикса.Тип.КвалификаторыСтроки.Длина))) Тогда
		// Документ с таким номером уже есть, присвоим просто следующий номер, без префикса переборки/перепечатки (согласованно с Анной 20200318)
		НовыйЗаказ.Номер = Лико_Планирование.ПолучитьНомерДляЗаказа(ИсходныйЗаказ.Организация, ИсходныйЗаказ.ТипЗаказа, ИсходныйЗаказ.ВидЗаказа, ИсходныйЗаказ.Регион);
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 18.03.2020
	
	
	НовыйЗаказ.Менеджер = ИсходныйЗаказ.Менеджер;
	НовыйЗаказ.ИсходныйЗаказ = ИсходныйЗаказ.Ссылка;

	НовыйЗаказ.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний");
	НовыйЗаказ.способдоставки = Перечисления.СпособыДоставки.Самовывоз;
	Если Не ЗначениеЗаполнено(НовыйЗаказ.НалогообложениеНДС) Тогда 
		НовыйЗаказ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС; 
	КонецЕсли;	
	НовыйЗаказ.Статус = Перечисления.СтатусыЗаказовКлиентов.КОбеспечению;
	НовыйЗаказ.ЦенаВключаетНДС = Истина;
	//Если Не ЗначениеЗаполнено(НовыйЗаказ.ПорядокОплаты) Тогда 
	//	НовыйЗаказ.ПорядокОплаты =  Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВРублях;
	//КонецЕсли;
	Если   НовыйЗаказ.Соглашение.Типовое Тогда 
	    НовыйЗаказ.Соглашение = Справочники.СоглашенияСКлиентами.ПустаяСсылка();
	КонецЕсли;

	НовыйЗаказ.ДатаУтвержденияЦветов = '0001.01.01';
	НовыйЗаказ.УтвердилЦвета = Справочники.Пользователи.ПустаяСсылка();	
	НовыйЗаказ.ДатаУтвержденияРабот = '0001.01.01';
	НовыйЗаказ.УтвердилРаботы = Справочники.Пользователи.ПустаяСсылка();	

	НовыйЗаказ.Дата = ТекущаяДата();
	НовыйЗаказ.Валюта = Справочники.Валюты.НайтиПоКоду("978");
	НовыйЗаказ.Ответственный = ПОльзователи.ТекущийПользователь();
	НовыйЗаказ.Заблокирован = Ложь;
	НовыйЗаказ.ДатаОтправкиВРаботу = '0001.01.01';
	НовыйЗаказ.ДатаЗакрытия =  '0001.01.01';
	НовыйЗаказ.Состояние = Перечисления.Лико_СостоянияЗаказов.Создан;
	НовыйЗаказ.СрочноеЦветоделение = ЛОжь;
	НовыйЗаказ.КоличествоРоликов = 0;
	НовыйЗаказ.КоличествоКоробок = 0;
	НовыйЗаказ.ОписаниеИзменений = "";
	НовыйЗаказ.ОсновнойМатериалФакт = Справочники.ЦеновыеГруппы.ПустаяСсылка();
	НовыйЗаказ.НарезкаФакт = Справочники.ЯССМ_Нарезки.ПустаяСсылка();
	Для каждого стр из НовыйЗаказ.ВидыРабот Цикл
		стр.материалфакт = Справочники.ЦеновыеГруппы.ПустаяСсылка();
		//стр.клейфакт = Справочники.ЦеновыеГруппы.ПустаяСсылка();
	КонецЦикла;
	Для каждого стр из НовыйЗаказ.Цвета Цикл
		стр.Цветоделение = ЛОжь;
		стр.Перегравировка = Ложь;
	КонецЦикла;	
	НовыйЗаказ.КоличествоПоУпаковке = 0;
	НовыйЗаказ.КомментарийОУ = "";
	НовыйЗаказ.ОтветственныйОУ = Справочники.Пользователи.ПустаяСсылка();
	НовыйЗаказ.ПечатьВПрисутствииТехнолога = Ложь;

	НовыйЗаказ.Цветоделение.Очистить();
	НовыйЗаказ.Отгрузки.Очистить();
	НовыйЗаказ.Нормативы.Очистить();
	НовыйЗаказ.КартаПерерасхода.Очистить();
	НовыйЗаказ.КартаСнятия.Очистить();
	НовыйЗаказ.Перемотка.Очистить();
	НовыйЗаказ.ИзготовлениеФорм.Очистить();
	Если НовыйЗаказ.Товары.Количество()>0 Тогда 
		Для каждого стр из НовыйЗаказ.Товары Цикл
			стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется;
			// --> Начало Лико Митюшин МФМ 05.08.2021
			Если НовыйЗаказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка Тогда
				стр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
				стр.Цена = 0;
				стр.сумма = 0;
				стр.суммаСНДС = 0;
				стр.СуммаНДС = 0;
				Стр.ЦенаДляДокументов = 0;
			Иначе
			// <-- Конец Лико Митюшин МФМ 05.08.2021
				СтавкаЧислом = ЦенообразованиеКлиентСервер.ПолучитьСтавкуНДСЧислом(стр.СтавкаНДС);
				Если СтавкаЧислом= 18 Тогда 
					стр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
					стр.Цена = (стр.цена/1.18)*1.20;
					стр.сумма = стр.количество*стр.цена;
					стр.суммаСНДС = стр.сумма;
					стр.СуммаНДС = стр.сумма*СтавкаЧислом/(100+СтавкаЧислом);
					Если НовыйЗаказ.ЦенаДляДокументовВключаетНДС Тогда 
						Стр.ЦенаДляДокументов = (Стр.ЦенаДляДокументов/1.18)*1.20;
					КонецЕсли;	
				КонецЕсли;
			// <-- Начало Лико Митюшин МФМ 05.08.2021
			КонецЕсли;
			// <-- Конец Лико Митюшин МФМ 05.08.2021
		КонецЦикла;
		НовыйЗаказ.СуммаДокумента = НовыйЗаказ.Товары.Итог("СуммаСНДС")+НовыйЗаказ.СтоимостьОснастки;
	КонецЕсли;
	Если НовыйЗаказ.Цвета.Количество()>0 Тогда 
		Для каждого стр из НовыйЗаказ.Цвета Цикл
			стр.Цветоделение = Ложь;
			стр.Перегравировка = Ложь;
		КонецЦикла;
	КонецЕсли;
	НовыйЗаказ.ДатаОтгрузки = ТекущаяДата()+604800;
	НовыйЗаказ.ЖелаемаяДатаОтгрузки = ТекущаяДата()+604800;	
	НовыйЗаказ.Записать();
	НовыйЗаказ.ВидВырубки = Лико_ТиражМетраж.ПолучитьВидВырубки(НовыйЗаказ.ссылка);
	НовыйЗаказ.НомерБезПрефикса = Прав(НовыйЗаказ.Номер,7);
	НовыйЗаказ.Записать();
	Возврат НовыйЗаказ.ссылка;
	
КонецФункции



