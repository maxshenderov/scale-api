#Область СлужебныеПроцедурыИФункции

// Выполняет все проверки перед проведением документа
//
// Параметры:
//  Отказ - Булево - флаг отказа от проведения (выходной параметр)
//  РежимПроведения - РежимПроведенияДокумента - режим проведения документа
//
Процедура ВыполнитьПроверкиПередПроведением(Отказ, РежимПроведения)

    // Проверка последовательности проведения документов по сериям
    // Выполняется только в неоперативном режиме для производительности
    // Пропускается при загрузке данных и если установлен флаг пропуска
    Если РежимПроведения = РежимПроведенияДокумента.Неоперативный Тогда

        ПропуститьПроверку = ОбменДанными.Загрузка
            ИЛИ ДополнительныеСвойства.Свойство("ПропуститьПроверкуПоследовательности");

        Если НЕ ПропуститьПроверку Тогда
            ПроверитьПроведениеЗаднимЧислом(Отказ);
            Если Отказ Тогда
                Возврат;
            КонецЕсли;
        КонецЕсли;

    КонецЕсли;

КонецПроцедуры

// Подготавливает данные для проведения документа
//
// Параметры:
//  Отказ - Булево - флаг отказа от проведения (выходной параметр)
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с остатками товаров для проведения
//
Функция ПодготовитьДанныеДляПроведения(Отказ)

    // Получение остатков товаров в ячейках
    ТаблицаТоваров = Товары.Выгрузить();
    ТаблицаОстатков = Справочники.Лико_Паллеты2_0.ПолучитьОстаткиТоваровПоСериямВЯчейках(
        ТаблицаТоваров,
        Дата
    );

    // Проверка достаточности остатков
    РезультатПроверки = Справочники.Лико_Паллеты2_0.ПроверитьНаличиеОстатков(ТаблицаОстатков, ТаблицаТоваров);

    Если НЕ РезультатПроверки.ОстаткиДостаточны Тогда

        // Выводим заголовок ошибки
        СообщитьОбОшибкеОстатков(РезультатПроверки.ТекстЗаголовка);

        // Выводим отдельные сообщения для каждой серии с привязкой к строке
        Если РезультатПроверки.Свойство("СообщенияПоСтрокам") Тогда
            Для Каждого ДанныеСообщения Из РезультатПроверки.СообщенияПоСтрокам Цикл

                Сообщение = Новый СообщениеПользователю;
                Сообщение.Текст = ДанныеСообщения.Текст;
                Сообщение.Поле = "Товары[" + Формат(ДанныеСообщения.ИндексСтроки, "ЧГ=0") + "].Серия";
                Сообщение.УстановитьДанные(ЭтотОбъект);
                Сообщение.Сообщить();

            КонецЦикла;
        КонецЕсли;

        // Выводим информацию о возможных причинах
        Если РезультатПроверки.Свойство("ТекстПричин") И ЗначениеЗаполнено(РезультатПроверки.ТекстПричин) Тогда
            СообщитьОбОшибкеОстатков(РезультатПроверки.ТекстПричин);
        КонецЕсли;

        Отказ = Истина;
        Возврат Неопределено;
    КонецЕсли;

    Возврат ТаблицаОстатков;

КонецФункции

// Формирует все движения документов по регистрам
//
// Параметры:
//  ТаблицаОстатков - ТаблицаЗначений - таблица с остатками товаров для проведения
//
Процедура СформироватьДвиженияДокумента(ТаблицаОстатков)
	
	// Проверяем, изменился ли адрес паллета
	АдресИзменен = ПроверитьИзменениеАдресаПаллета();
	
	// Движения по товарам в ячейках формируются только если адрес изменился
	Если АдресИзменен Тогда 
		
		СформироватьДвиженияПоРегиструТоварыВЯчейках(ТаблицаОстатков);
		СформироватьДвиженияСоставаПаллеты(ТаблицаОстатков);
        СформироватьДвиженияРегистрацииПаллеты();
		
	КонецЕсли;
	
	СформироватьДвиженияГабаритовПаллеты(); 	
	
КонецПроцедуры

// Формирует движения записи габаритов паллеты
//
Процедура СформироватьДвиженияГабаритовПаллеты()

    Движения.Лико_ПараметрыПаллет.Записывать = Истина;
    ДвижениеПараметры = Движения.Лико_ПараметрыПаллет.Добавить();
    ДвижениеПараметры.Период = Дата;
    ДвижениеПараметры.Паллет = Паллет;
    ДвижениеПараметры.Типоразмер = Типоразмер;

КонецПроцедуры

// Формирует движения состава паллеты
//
Процедура СформироватьДвиженияСоставаПаллеты(ТаблицаОстатков)
	
	
	Движения.Лико_ТоварыНаПаллетах.Записывать = Истина;
	
	ОстаткиТоваровСПаллет=ОстаткиТоваровСПаллет(); 
	
	Для Каждого СтрокаОстатков Из ОстаткиТоваровСПаллет Цикл
		
		// Если количество к перемещению = 0, пропускаем строку
		Если СтрокаОстатков.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Параметры движения расхода
		ПараметрыДвижения = Новый Структура;
		ПараметрыДвижения.Вставить("ВидДвижения", ВидДвиженияНакопления.Расход);
		ПараметрыДвижения.Вставить("Период", Дата);
		ПараметрыДвижения.Вставить("Серия", СтрокаОстатков.Серия);
		ПараметрыДвижения.Вставить("Паллет", СтрокаОстатков.Паллет);
		ПараметрыДвижения.Вставить("Количество", СтрокаОстатков.Количество);
		
		
		ДобавитьДвижение(Движения.Лико_ТоварыНаПаллетах, ПараметрыДвижения);
		
	КонецЦикла;


	
	
	
    Для Каждого СтрокаОстатков Из ТаблицаОстатков Цикл
        
        // Если количество к перемещению = 0, пропускаем строку
        Если СтрокаОстатков.КоличествоКПеремещению <= 0 Тогда
            Продолжить;
        КонецЕсли;
        
        // Параметры движения расхода
        ПараметрыДвижения = Новый Структура;
        ПараметрыДвижения.Вставить("ВидДвижения", ВидДвиженияНакопления.Приход);
		ПараметрыДвижения.Вставить("Период", Дата); 
		ПараметрыДвижения.Вставить("Серия", СтрокаОстатков.Серия);
		ПараметрыДвижения.Вставить("Паллет", Паллет);
        ПараметрыДвижения.Вставить("Количество", СтрокаОстатков.КоличествоКПеремещению);
      
        
             ДобавитьДвижение(Движения.Лико_ТоварыНаПаллетах, ПараметрыДвижения);
              
    КонецЦикла;

	
	
	
	
КонецПроцедуры

// Формирует движения регистрации паллеты в секциях
//
Процедура СформироватьДвиженияРегистрацииПаллеты()
	
	
	  
    СформироватьДвиженияСписанияПаллетыИзСекции();

	
    // Регистрация паллеты в зоне приемки
    Движения.Лико_ПаллетыВСекциях.Записывать = Истина;
    ДвижениеСекции = Движения.Лико_ПаллетыВСекциях.ДобавитьПриход();
    ДвижениеСекции.Период = Дата;
    ДвижениеСекции.Паллет = Паллет;
    ДвижениеСекции.Адрес = АдресХранения;
    ДвижениеСекции.Секция = АдресХранения;
    ДвижениеСекции.Количество = 1;
    ДвижениеСекции.Заблокирован = 0;

КонецПроцедуры

// Формирует движения по регистру ТоварыВЯчейках
//
// Параметры:
//  ТаблицаОстатков - ТаблицаЗначений - таблица с остатками товаров
//  ДатаДокумента - Дата - дата документа
//  ЦелевойАдресХранения - СправочникСсылка.СкладскиеЯчейки - ячейка назначения
//
Процедура СформироватьДвиженияПоРегиструТоварыВЯчейках(ТаблицаОстатков)
    
    Движения.ТоварыВЯчейках.Записывать = Истина;
    
    Для Каждого СтрокаОстатков Из ТаблицаОстатков Цикл
        
        // Если количество к перемещению = 0, пропускаем строку
        Если СтрокаОстатков.КоличествоКПеремещению <= 0 Тогда
            Продолжить;
        КонецЕсли;
        
        // Параметры движения расхода
        ПараметрыДвижения = Новый Структура;
        ПараметрыДвижения.Вставить("ВидДвижения", ВидДвиженияНакопления.Расход);
        ПараметрыДвижения.Вставить("Период", Дата);
        ПараметрыДвижения.Вставить("Номенклатура", СтрокаОстатков.Номенклатура);
        ПараметрыДвижения.Вставить("Характеристика", СтрокаОстатков.Характеристика);
        ПараметрыДвижения.Вставить("Назначение", Справочники.Назначения.ПустаяСсылка());
        ПараметрыДвижения.Вставить("Упаковка", СтрокаОстатков.Упаковка);
        ПараметрыДвижения.Вставить("Ячейка", СтрокаОстатков.Ячейка);
        ПараметрыДвижения.Вставить("Серия", СтрокаОстатков.Серия);
        ПараметрыДвижения.Вставить("ВНаличии", СтрокаОстатков.КоличествоКПеремещению);
        ПараметрыДвижения.Вставить("КОтбору", 0);
        ПараметрыДвижения.Вставить("КРазмещению", 0);
        
        // Расход - списание товара с исходной ячейки
        ДобавитьДвижение(Движения.ТоварыВЯчейках, ПараметрыДвижения);
        
        // Параметры движения прихода (изменяем только вид движения и ячейку)
        ПараметрыДвижения.ВидДвижения = ВидДвиженияНакопления.Приход;
        ПараметрыДвижения.Ячейка = АдресХранения;
        
        // Приход - формирование остатков в целевой ячейке
        ДобавитьДвижение(Движения.ТоварыВЯчейках, ПараметрыДвижения);
        
    КонецЦикла;
    
КонецПроцедуры

// Добавляет движение по регистру накопления
//
// Параметры:
//  НаборЗаписей - РегистрНакопленияНаборЗаписей - набор записей регистра накопления
//  ПараметрыДвижения - Структура - параметры движения, ключи структуры должны соответствовать
//                      реквизитам, измерениям и ресурсам регистра
//
Процедура ДобавитьДвижение(НаборЗаписей, ПараметрыДвижения)

    Движение = НаборЗаписей.Добавить();
    ЗаполнитьЗначенияСвойств(Движение, ПараметрыДвижения);

КонецПроцедуры

// Формирует движения списания товаров с предыдущих паллет
//
// Параметры:
//  ДатаДокумента - Дата - дата документа
//
Функция ОстаткиТоваровСПаллет()

  
    // Получаем уникальные серии из документа для оптимизации запроса
    СерииДокумента = Новый Массив;
    Для Каждого СтрокаТоваров Из Товары Цикл
        Если ЗначениеЗаполнено(СтрокаТоваров.Серия) И СерииДокумента.Найти(СтрокаТоваров.Серия) = Неопределено Тогда
            СерииДокумента.Добавить(СтрокаТоваров.Серия);
        КонецЕсли;
    КонецЦикла;

    // Один запрос для получения остатков паллет для всех серий из документа
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |	ТоварыНаПаллетахОстатки.Серия КАК Серия,
    |	ТоварыНаПаллетахОстатки.Паллет КАК Паллет,
    |	ТоварыНаПаллетахОстатки.КоличествоОстаток КАК Количество
    |ИЗ
    |	РегистрНакопления.Лико_ТоварыНаПаллетах.Остатки(&ДатаДокумента, Серия В (&СерииДокумента)) КАК ТоварыНаПаллетахОстатки
    |ГДЕ
    |	ТоварыНаПаллетахОстатки.КоличествоОстаток > 0
    |
    |УПОРЯДОЧИТЬ ПО
    |	Серия,
    |	Количество УБЫВ";

    Запрос.УстановитьПараметр("ДатаДокумента", Дата);
    Запрос.УстановитьПараметр("СерииДокумента", СерииДокумента);

    Возврат Запрос.Выполнить().Выгрузить();
   

	
	
КонецФункции

// Проверяет, изменился ли адрес хранения паллета
//
// Возвращаемое значение:
//  Булево - Истина, если адрес паллета изменился или паллета не было в секциях
//
Функция ПроверитьИзменениеАдресаПаллета()
	
	// Находим текущую секцию паллеты на дату документа
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    ПаллетыВСекцияхОстатки.Адрес КАК Адрес,
	|    ПаллетыВСекцияхОстатки.Секция КАК Секция
	|ИЗ
	|    РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
	|        &ДатаДокумента,
	|        Паллет = &ТекущаяПаллет
	|    ) КАК ПаллетыВСекцияхОстатки
	|ГДЕ
	|    ПаллетыВСекцияхОстатки.КоличествоОстаток > 0";
	
	Запрос.УстановитьПараметр("ДатаДокумента", Дата);
	Запрос.УстановитьПараметр("ТекущаяПаллет", Паллет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Если паллета не найдена в секциях - значит это новая регистрация
	Если НЕ Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Сравниваем предыдущий адрес с новым
	ПредыдущийАдрес = Выборка.Адрес;
	НовыйАдрес = АдресХранения;
	
	// Если адреса различаются - адрес изменился
	Возврат ПредыдущийАдрес <> НовыйАдрес;
	
КонецФункции

// Формирует движения списания паллеты из предыдущей секции
//
// Параметры:
//  ДатаДокумента - Дата - дата документа
//
Процедура СформироватьДвиженияСписанияПаллетыИзСекции()

    Движения.Лико_ПаллетыВСекциях.Записывать = Истина;

    // Находим текущую секцию паллеты на дату документа
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ПаллетыВСекцияхОстатки.Адрес КАК Адрес,
    |    ПаллетыВСекцияхОстатки.Секция КАК Секция
    |ИЗ
    |    РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
    |        &ДатаДокумента,
    |        Паллет = &ТекущаяПаллет
    |    ) КАК ПаллетыВСекцияхОстатки
    |ГДЕ
    |    ПаллетыВСекцияхОстатки.КоличествоОстаток > 0";

    Запрос.УстановитьПараметр("ДатаДокумента", Дата);
    Запрос.УстановитьПараметр("ТекущаяПаллет", Паллет);

    Выборка = Запрос.Выполнить().Выбрать();

    Если Выборка.Следующий() Тогда

        // Расход паллеты из предыдущей секции
        ДвижениеРасход = Движения.Лико_ПаллетыВСекциях.ДобавитьРасход();
        ДвижениеРасход.Период = Дата;
        ДвижениеРасход.Паллет = Паллет;
        ДвижениеРасход.Адрес = Выборка.Адрес;
        ДвижениеРасход.Секция = Выборка.Секция;
        ДвижениеРасход.Количество = 1;
        ДвижениеРасход.Заблокирован = 0;

    КонецЕсли;

КонецПроцедуры

// Выводит сообщение пользователю об ошибке остатков
//
// Параметры:
//  ТекстОшибки - Строка - текст сообщения об ошибке
//
Процедура СообщитьОбОшибкеОстатков(ТекстОшибки)
    
    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = ТекстОшибки;
    Сообщение.Сообщить();
    
КонецПроцедуры

// Проверяет возможность проведения документа задним числом
//
// Параметры:
//  Отказ - Булево - флаг отказа от проведения (выходной параметр)
//
Процедура ПроверитьПроведениеЗаднимЧислом(Отказ)
    
    // Получаем список серий из табличной части документа
    СписокСерий = Товары.ВыгрузитьКолонку("Серия");
    
    Если СписокСерий.Количество() = 0 Тогда
        Возврат; // Нет серий для проверки
    КонецЕсли;
    
    // Запрос для поиска документов, проведенных позже данной даты и использующих те же серии
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 50
    |    ТоварыВЯчейках.Регистратор КАК Документ,
    |    ТоварыВЯчейках.Регистратор.Дата КАК ДатаДокумента
    |ИЗ
    |    РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
    |ГДЕ
    |    ТоварыВЯчейках.Серия В(&СписокСерий)
    |    И ТоварыВЯчейках.Регистратор <> &ТекущийДокумент
    |    И ТоварыВЯчейках.Регистратор.Дата >= &ДатаТекущегоДокумента
    |
    |УПОРЯДОЧИТЬ ПО
    |    ДатаДокумента УБЫВ";
    
    Запрос.УстановитьПараметр("СписокСерий", СписокСерий);
    Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);
    Запрос.УстановитьПараметр("ДатаТекущегоДокумента", Дата);
    
    РезультатЗапроса = Запрос.Выполнить();
    
    Если НЕ РезультатЗапроса.Пустой() Тогда
        
        ТаблицаДокументов = РезультатЗапроса.Выгрузить();
        КоличествоПоздних = ТаблицаДокументов.Количество();
        
        // Заголовок ошибки
        ТекстЗаголовка = НСтр("ru = 'ВНИМАНИЕ! Проведение документа невозможно.
        |
        |Вы пытаетесь провести документ датой %1, но уже существуют более поздние документы с теми же сериями товаров.
        |Проведение задним числом нарушит хронологическую последовательность движений по сериям и приведёт к ошибкам в учёте.'");
        
        ТекстЗаголовка = СтрЗаменить(ТекстЗаголовка, "%1", Формат(Дата, "ДЛФ=DD"));
        СообщитьОбОшибкеОстатков(ТекстЗаголовка);
        
        // Выводим каждый документ отдельным сообщением с возможностью перехода
        Счетчик = 0;
        Для Каждого СтрокаДок Из ТаблицаДокументов Цикл
            
            Если Счетчик >= 20 Тогда // Ограничиваем вывод 20 документами
                Прервать;
            КонецЕсли;
            
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = Строка(СтрокаДок.Документ);
            Сообщение.КлючДанных = СтрокаДок.Документ;
            Сообщение.Сообщить();
            
            Счетчик = Счетчик + 1;
            
        КонецЦикла;
        
        Если КоличествоПоздних > 20 Тогда
            СообщитьОбОшибкеОстатков("... и ещё " + Формат(КоличествоПоздних - 20, "ЧГ=0") + " документов");
        КонецЕсли;
        
        // Подсказка что делать
        ТекстПодсказки = НСтр("ru = '
        |ЧТО ДЕЛАТЬ:
        |
        |Вариант 1 (Рекомендуется):
        |  1. Измените дату документа на более позднюю (после всех зависимых документов)
        |  2. Проведите документ
        |
        |Вариант 2 (Сложный):
        |  1. Отмените проведение ВСЕХ более поздних документов (в обратном хронологическом порядке)
        |  2. Проведите этот документ
        |  3. Проведите отменённые документы заново (в хронологическом порядке)
        |
        |Вариант 3:
        |  • Используйте текущую дату для проведения документа
        |
        |Вариант 4 (Программный обход):
        |  • Установите ДополнительныеСвойства.ПропуститьПроверкуПоследовательности = Истина
        |
        |Общее количество более поздних документов: %1'");
        
        ТекстПодсказки = СтрЗаменить(ТекстПодсказки, "%1", Формат(КоличествоПоздних, "ЧГ=0"));
        СообщитьОбОшибкеОстатков(ТекстПодсказки);
        
        Отказ = Истина;
        
    КонецЕсли;
    
КонецПроцедуры

