Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЗначениеЗаполнено(АдресХранения.Лико_Секция) Тогда
		Отказ=Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("Нельзя указывать адрес:""%1"" секции в формировании паллета!",АдресХранения);
		Сообщение.Поле = "АдресХранения";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	
	Склад = АдресХранения.Владелец;
	Площадка = АдресХранения.Лико_Площадка;
	Организация = АдресХранения.Лико_Организация;
	
	
	
КонецПроцедуры



// Обработчик проведения документа
//
// Параметры:
//  Отказ - Булево - флаг отказа от проведения
//  РежимПроведения - РежимПроведенияДокумента - режим проведения документа
//

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// 1. Выполнение всех проверок перед проведением
    ВыполнитьПроверкиПередПроведением(Отказ, РежимПроведения);
    Если Отказ Тогда
        Возврат;
    КонецЕсли;

    // 2. Подготовка данных для проведения
    ТаблицаОстатков = ПодготовитьДанныеДляПроведения(Отказ);
    Если Отказ Тогда
        Возврат;
    КонецЕсли;

    // 3. Формирование движений по регистрам
    СформироватьДвиженияДокумента(ТаблицаОстатков);
    Документы.Лико_ЗаданиеНаОтборРазмещение.ОбработатьЗадание(Ссылка);

КонецПроцедуры

// Обработчик удаления проведения документа (отмена проведения)
//
// Параметры:
//  Отказ - Булево - флаг отказа от удаления проведения
//

Процедура ОбработкаУдаленияПроведения(Отказ)
    
    // Пропускаем проверку при загрузке данных
    Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;
    
    // Проверка наличия зависимых документов
    ПроверитьНаличиеЗависимыхДокументов(Отказ);
    
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

#КонецОбласти

