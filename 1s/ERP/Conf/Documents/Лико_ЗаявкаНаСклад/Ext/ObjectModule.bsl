
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ИнициализироватьДокумент(ДанныеЗаполнения); 		
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВидОперации=Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ПриходИзПроизводства;
	КонецЕсли;	
КонецПроцедуры


Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Дата          = ТекущаяДатаСеанса();
	Ответственный = Пользователи.ТекущийПользователь();
	Структура = Новый Структура;
	Лико_ОбщегоНазначенияСервер.РеквизитыШапки(Структура);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,Структура);
	Если Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ЗаполнениеСотрудникаВЗаявке",Ложь) Тогда
		Сотрудник=АвторДокумента;
	КонецЕсли; 
	
	Если ТипЗнч(ДанныеЗаполнения)=Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект,ДанныеЗаполнения);
	КонецЕсли;
	
	
КонецПроцедуры
                                                  


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда
		
		
		Если Не ДополнительныеСвойства.Свойство("УстановитьСтатусзаявки") Тогда			
			Справочники.Лико_ПравилаПеремещенияТМЦ.ВыполнитьПроверку(ЭтотОбъект,Отказ);
		КонецЕсли;
		
		н=0;
		Если Проведен=Ложь И Не ВозвратНаСклад Тогда	

			Для каждого Товар Из Товары Цикл

				ОстатокНаскладе=ПолучитьОстатокНаСкладе2(Товар.Серия,Товар.АдресХранения.Владелец);
				Если Товар.КоличествоУпаковок>ОстатокНаскладе Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не хватает на складе номенклатуры:"+Товар.Серия +"! Остаток на складе:"+ОстатокНаскладе;
					Сообщение.Поле = "Товары["+н+"].КоличествоУпаковок"; //имя реквизита 
					Сообщение.УстановитьДанные(ЭтотОбъект); //Ссылка на объект ИБ
					Сообщение.Сообщить();
					Отказ=Истина;	
				КонецЕсли;


				н=н+1;

			КонецЦикла;
		КонецЕсли;	
		// --> Начало Лико Субботин 21.03.2023 	
		Если Не ДополнительныеСвойства.Свойство("УстановитьСтатусзаявки") Тогда
			
			//Отказ = ПроверкаСвязьЦеновыхГруппСЗаказом(отказ);  
		КонецЕсли;
		// <-- Конец Лико Субботин 21.03.2023 
		Если Не Отказ Тогда
			УстановитьСтатус();
		КонецЕсли;

	Иначе
		Передача=НайтиПередачу();
		Если ЗначениеЗаполнено(Передача) Тогда
			Если  РольДоступна("АдминистраторСистемы") Или РольДоступна("Лико_РедактированиеКоличестоУУ") Тогда
			Иначе

				Отказ=Истина;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Нельзя отменить заявку т.к. она уже обработана складом!";
				Сообщение.Сообщить();
				Статус=Перечисления.Лико_СтатусЗаявокНаСклад.Отменен;	

			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 

	лПартнер=?(ЗначениеЗаполнено(ЗаказКлиента),ЗаказКлиента.Партнер,ЗаказНаРаскрой.Партнер);

	Документы.Лико_УстановкаРезерваМатериалов.ПроверкаРезерваМатериалов(Отказ,РежимЗаписи,лПартнер,Товары);


КонецПроцедуры



Функция ПроверкаСвязьЦеновыхГруппСЗаказом(отказ) // Субботин 21.03.23   

	Если отказ ИЛИ ВозвратНаСклад Тогда
		Возврат отказ;
	КонецЕсли;
	

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗаявкаНаСкладТовары.Номенклатура.ЦеноваяГруппа КАК ЦеноваяГруппа,
	|	Лико_ЗаявкаНаСкладТовары.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.Лико_ЗаявкаНаСклад.Товары КАК Лико_ЗаявкаНаСкладТовары
	|ГДЕ
	|	Лико_ЗаявкаНаСкладТовары.Ссылка = &Ссылка
	|	И (Лико_ЗаявкаНаСкладТовары.Номенклатура.ЦеноваяГруппа.Лико_ВидТМЦ = ЗНАЧЕНИЕ(Справочник.Лико_ВидыТМЦ.Лак)
	|			ИЛИ Лико_ЗаявкаНаСкладТовары.Номенклатура.ЦеноваяГруппа.Лико_ВидТМЦ = ЗНАЧЕНИЕ(Справочник.Лико_ВидыТМЦ.клей)
	|			ИЛИ Лико_ЗаявкаНаСкладТовары.Номенклатура.ЦеноваяГруппа.Лико_ВидТМЦ = ЗНАЧЕНИЕ(Справочник.Лико_ВидыТМЦ.праймер)
	|			ИЛИ Лико_ЗаявкаНаСкладТовары.Номенклатура.ЦеноваяГруппа.Лико_ВидТМЦ = ЗНАЧЕНИЕ(Справочник.Лико_ВидыТМЦ.краска))
	|	И Лико_ЗаявкаНаСкладТовары.Номенклатура.ЦеноваяГруппа.Лико_РасчетКакОсновнойКраски = ЛОЖЬ";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	РезультатЗапроса = Запрос.Выполнить();

	Если не РезультатЗапроса.Пустой() Тогда 
		Если не ЗначениеЗаполнено(ЗаказКлиента) Тогда 
			отказ = истина;  
			Сообщить("Необходимо заполнить заказ клиента"); 
		Иначе  
			Выборка = РезультатЗапроса.Выбрать();

			Пока Выборка.Следующий() Цикл
				Если ЦеноваяГруппаНеСодержитсяВЗаказе(Выборка.ЦеноваяГруппа) Тогда
					Отказ = Истина;
					Сообщить(СтрШаблон("В заявке содержится номенклатура %1 с ценовой группой,  которой нет в указанном заказе, откорректируйте данные заказа", Выборка.Номенклатура));

				КонецЕсли;
			КонецЦикла;

		КонецЕсли;
	КонецЕсли;

	Возврат Отказ	

КонецФункции


Функция ПолучитьОстатокНаСкладе2(лСерия,лСклад)
	лКоличество=0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|				И Ячейка.Владелец = &Склад И Ячейка.Лико_ТипСклада = ЗНАЧЕНИЕ(Перечисление.Лико_ТипСклада.СИМ)) КАК ТоварыВЯчейкахОстатки";
	Запрос.УстановитьПараметр("Номенклатура", лСерия.ЯССМ_ОбъектНоменклатуры.Номенклатура);
	Запрос.УстановитьПараметр("Склад",лСклад );

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		лКоличество=Выборка.Остаток;	
	КонецЦикла; 

	Возврат лКоличество;


КонецФункции



Функция ЦеноваяГруппаНеСодержитсяВЗаказе(ЦеноваяГруппа) // Субботин 21.03.23
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаЦвета.ТипКраски КАК ЦеноваяГруппа
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
		|ГДЕ
		|	ЗаказКлиентаЦвета.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаВидыРабот.Клей ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ЗаказКлиентаВидыРабот.Клей.ЦеноваяГруппа
		|		КОГДА ЗаказКлиентаВидыРабот.Клей ССЫЛКА Справочник.ЦеновыеГруппы
		|			ТОГДА ЗаказКлиентаВидыРабот.Клей
		|	КОНЕЦ
		|ИЗ
		|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
		|ГДЕ
		|	ЗаказКлиентаВидыРабот.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаказКлиента);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЦеноваяГруппа");  
	
	
   	Возврат  РезультатЗапроса.Найти(ЦеноваяГруппа) = Неопределено
	
	
КонецФункции 
 

Процедура УстановитьСтатус() //+Лико m.shenderov 05.11.2018
	Передача=НайтиПередачу();
	
	
	Если Статус=Перечисления.Лико_СтатусЗаявокНаСклад.Отменен Тогда
		
		
		Если ЗначениеЗаполнено(Передача) ТОгда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Нельзя отменить заявку т.к. она уже обработана складом!";
			Сообщение.Сообщить();	
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Передача) Тогда
		Если Передача.Проведен и  НЕ ДополнительныеСвойства.Свойство("УдалениеДОкументаПоЗаявке") Тогда
			Статус=Перечисления.Лико_СтатусЗаявокНаСклад.Выдан;	
		Иначе
			Статус=Перечисления.Лико_СтатусЗаявокНаСклад.Подготовлен;
		КонецЕсли;
	Иначе
		Статус=Перечисления.Лико_СтатусЗаявокНаСклад.ВОбработке;
		
	КонецЕсли;
	
	
	
	
КонецПроцедуры //-Лико m.shenderov 05.11.2018

Функция НайтиПередачу() //+Лико m.shenderov 05.11.2018
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПередачаТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лико_ПередачаТоваров КАК Лико_ПередачаТоваров
	|ГДЕ
	|	Лико_ПередачаТоваров.ЗаявкаНаСклад = &Ссылка
	|	И НЕ Лико_ПередачаТоваров.ПометкаУдаления
	|	И Лико_ПередачаТоваров.ЗаявкаНаСклад <> ЗНАЧЕНИЕ(Документ.Лико_ЗаявкаНаСклад.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Лико_ВозвратТоваров.Ссылка
	|ИЗ
	|	Документ.Лико_ВозвратТоваров КАК Лико_ВозвратТоваров
	|ГДЕ
	|	Лико_ВозвратТоваров.ЗаявкаНаСклад = &Ссылка
	|	И НЕ Лико_ВозвратТоваров.ПометкаУдаления
	|	И Лико_ВозвратТоваров.ЗаявкаНаСклад <> ЗНАЧЕНИЕ(Документ.Лико_ЗаявкаНаСклад.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
		
	КонецЦикла; 
	
	
	
КонецФункции //-Лико m.shenderov 05.11.2018 



Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	МассивНепроверяемыхРеквизитов = Новый Массив;

	ЕстьЗапчасть=Ложь;
	Для каждого Товар Из Товары Цикл

		Если Товар.Номенклатура.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыЗапчасти.ЗначениеПараметра Тогда

			ЕстьЗапчасть=Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	//
	//Если Не ЕстьЗапчасть Тогда 		
	//	МассивНепроверяемыхРеквизитов.Добавить("РабочийЦентр"); 
	//КонецЕсли;

	Если (Организация=Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра Или
		Организация=Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра) И  Не ВозвратНаСклад ТОгда
	Иначе
		МассивНепроверяемыхРеквизитов.Добавить("РабочийЦентр"); 

	КонецЕсли;

	Если ВозвратНаСклад Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Товары.АдресХранения"); 
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Серия"); 

	КонецЕсли;


	Если ВозвратНаСклад Тогда
		ПроверяемыеРеквизиты.Добавить("Комментарий");
	КонецЕсли;
	
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение 
		Или ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Продажа
		Или ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПереработку Тогда
		МассивНепроверяемыхРеквизитов.Добавить("РабочийЦентр");
	КонецЕсли;
	
	Если  ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Продажа
		Или ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПереработку Тогда
		
	Иначе
		МассивНепроверяемыхРеквизитов.Добавить("Партнер"); 
		МассивНепроверяемыхРеквизитов.Добавить("Контрагент");


	КонецЕсли;
	
	Если  ВидОперации <> Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение Тогда 		
		  МассивНепроверяемыхРеквизитов.Добавить("Адрес");
	КонецЕсли;
	

	


	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);

	//ПараметрыПроверки = ОбщегоНазначенияУТ.ПараметрыПроверкиЗаполненияКоличества();
	//ПараметрыПроверки.ИмяТЧ = "Товары";
	//ПараметрыПроверки.СуффиксДопРеквизита = "";
	//ПараметрыПроверки.ПроверитьВозможностьОкругления = Ложь;
	//ОбщегоНазначенияУТ.ПроверитьЗаполнениеКоличества(ЭтотОбъект, ПроверяемыеРеквизиты, Отказ,ПараметрыПроверки);


КонецПроцедуры


