&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.НеИспользоватьПравило Тогда
		Возврат;	
	КонецЕсли;
	
	
	Если  УчетПравилПеремещенияТМЦ Тогда
		
		Если ПараметрыЗаписи.РежимЗаписи=РежимЗаписиДокумента.Проведение  
			И Не ПараметрыЗаписи.Свойство("ПроверкаПравилПеремещенияТМЦПередЗаписью") Тогда
			
		
		Ответ = ПроверитьФИФОЛИФО(Отказ,ПараметрыЗаписи.РежимЗаписи);
		
		Если ТипЗнч(Ответ)=Тип("Массив") И  Ответ.Количество()>0 Тогда
			
			Текст ="";
			Для каждого Комментарий Из Ответ Цикл
				Текст = Текст+?(ЗначениеЗаполнено(Текст),"|"+Комментарий,Комментарий);
				Сообщить(Комментарий);
				
			КонецЦикла;
			
			Если ЗначениеЗаполнено(Текст) Тогда
				
				Текст=Текст+"
				| Продолжить?";
					
					Режим = РежимДиалогаВопрос.ДаНет;
					Оповещение = Новый ОписаниеОповещения("ПроверкаПравилПеремещенияТМЦПередЗаписью", ЭтотОбъект, Новый Структура("Отказ,ПроверкаПравилПеремещенияТМЦПередЗаписью",Отказ,Ложь));
					ПоказатьВопрос(Оповещение, Текст, Режим, 0); 
					Отказ=Истина;
					Возврат;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
		
	Иначе

	
	
	// <-- Начало Лико Яцун С. В. 14.10.2025 
	НарушинПринципФИФО = Новый Структура("Вопрос,Письмо","","");
	Если НЕ ПараметрыЗаписи.Свойство("ПровестиПослеПроверкиФИФО") Тогда
		НарушинПринципФИФО = ПроверитьФИФО(Отказ,ПараметрыЗаписи.РежимЗаписи);
	КонецЕсли;
	Если НарушинПринципФИФО.Вопрос <> "" Тогда
		Вопрос = НарушинПринципФИФО.Вопрос + Символы.ПС + Символы.ПС + "Записать заявку?";
		ТекстПисьма = НарушинПринципФИФО.Письмо;
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросФИФО", ЭтотОбъект,Новый Структура("ПараметрыЗаписи,ТекстПисьма",ПараметрыЗаписи,ТекстПисьма)), 
		Вопрос,
		РежимДиалогаВопрос.ДаНет);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 14.10.2025 
	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроверитьФИФО(Отказ,РежимЗаписи) // <-- Начало Лико Яцун С. В. 14.10.2025

	ТзТоварыСтарые =   Объект.Ссылка.Товары.Выгрузить(,"Серия");
	ТзТоварыНовые  = Объект.Товары.Выгрузить(,"Серия");
	
	ТзТоварыСтарые.Свернуть("Серия");
	ТзТоварыНовые.Свернуть("Серия");
	
	ЕстьИзмененияТоваров = Лико_Дополнительно.СравнениеДвухОдинаковыхТаблицЗначенийПоСодержимому(ТзТоварыСтарые,ТзТоварыНовые);

	Вопрос = "";
	Письмо = "";
	
	Если ЕстьИзмененияТоваров 
		И РежимЗаписи = РежимЗаписиДокумента.Проведение 
		И НЕ Отказ 
		И Объект.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра Тогда
		ТЗ = Объект.Товары.Выгрузить(); 
		КвалификаторыДаты = Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя);
		ТЗ.Колонки.Добавить("ДатаФормирования",Новый ОписаниеТипов("Дата", , ,КвалификаторыДаты));	
		Для каждого СтрТЗ Из ТЗ Цикл
			СтрТЗ.ДатаФормирования = СтрТЗ.Серия.ЯССМ_ОбъектНоменклатуры.ДатаФормирования;
		КонецЦикла;
		ТЗ.Сортировать("ДатаФормирования Убыв");
		МассивСерийЗаявки = ТЗ.ВыгрузитьКолонку("Серия");
		МассивПодобранныхСерий = Новый Массив;
		Для каждого Стр Из ТЗ Цикл
			Если Стр.АдресХранения.Лико_Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра
				И Стр.АдресХранения.Владелец.Лико_Площадка = Справочники.Лико_Площадки.Ликофлекс
				И НЕ Стр.АдресХранения.Лико_ПомещениеБрака
				И ЗначениеЗаполнено(Стр.Серия) 
				И (Стр.Номенклатура.ВидНоменклатуры.Наименование = "Краска" И Стр.Серия.ЯССМ_ОбъектНоменклатуры.Уникальный ИЛИ Стр.Номенклатура.ЦеноваяГруппа.Лико_ВидТМЦ = Справочники.Лико_ВидыТМЦ.Чернила) Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.ДатаФормирования КАК ДатаФормирования,
				|	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.НомерПоставки КАК НомерПоставки,
				|	ТоварыВЯчейкахОстатки.Серия КАК Серия
				|ПОМЕСТИТЬ ВТСерии
				|ИЗ
				|	РегистрНакопления.ТоварыВЯчейках.Остатки(
				|			&ДатаОстатков,
				|			Номенклатура = &Номенклатура
				|				И НАЧАЛОПЕРИОДА(Серия.ЯССМ_ОбъектНоменклатуры.ДатаФормирования, ДЕНЬ) < НАЧАЛОПЕРИОДА(&ДатаФормированияТМЦ, ДЕНЬ)
				|				И НЕ Серия В (&МассивСерийЗаявки)
				|				И НЕ Серия В (&МассивПодобранныхСерий)
				|				И НЕ Ячейка.Лико_ПомещениеБрака
				|				И ВЫБОР
				|					КОГДА &УдаленныйСклад
				|							ИЛИ &ОтветХранение
				|						ТОГДА Ячейка.Помещение = &Помещение
				|					ИНАЧЕ Ячейка.Лико_ТипСклада = &ТипСклада
				|							И Ячейка.Лико_Организация = &Организация
				|							И Ячейка.Владелец = &Склад
				|							И НЕ Ячейка.Лико_ОтветственноеХранение
				|							И НЕ Ячейка.Лико_УдаленныйСклад
				|				КОНЕЦ) КАК ТоварыВЯчейкахОстатки
				|
				|СГРУППИРОВАТЬ ПО
				|	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.ДатаФормирования,
				|	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.НомерПоставки,
				|	ТоварыВЯчейкахОстатки.Серия
				|
				|УПОРЯДОЧИТЬ ПО
				|	ДатаФормирования
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВТСерии.ДатаФормирования КАК ДатаФормирования,
				|	ВТСерии.НомерПоставки КАК НомерПоставки,
				|	ВТСерии.Серия КАК Серия
				|ИЗ
				|	ВТСерии КАК ВТСерии
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лико_ЗаявкаНаСклад.Товары КАК Лико_ЗаявкаНаСкладТовары
				|		ПО ВТСерии.Серия = Лико_ЗаявкаНаСкладТовары.Серия
				|			И (Лико_ЗаявкаНаСкладТовары.Ссылка <> &Ссылка)
				|			И (Лико_ЗаявкаНаСкладТовары.Ссылка.Проведен)
				|			И (Лико_ЗаявкаНаСкладТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.Лико_СтатусЗаявокНаСклад.ВОбработке)
				|				ИЛИ Лико_ЗаявкаНаСкладТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.Лико_СтатусЗаявокНаСклад.Подготовлен))
				|ГДЕ
				|	Лико_ЗаявкаНаСкладТовары.Серия ЕСТЬ NULL";
				
				Запрос.УстановитьПараметр("ДатаОстатков", ?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата,ТекущаяДата()));
				Запрос.УстановитьПараметр("ДатаФормированияТМЦ", Стр.Серия.ЯССМ_ОбъектНоменклатуры.ДатаФормирования);
				Запрос.УстановитьПараметр("МассивСерийЗаявки", МассивСерийЗаявки);
				Запрос.УстановитьПараметр("МассивПодобранныхСерий", МассивПодобранныхСерий);
				Запрос.УстановитьПараметр("Номенклатура", Стр.Номенклатура);
				Запрос.УстановитьПараметр("Помещение", Стр.АдресХранения.Помещение);
				Запрос.УстановитьПараметр("Организация", Стр.АдресХранения.Лико_Организация);
				Запрос.УстановитьПараметр("Склад", Стр.АдресХранения.Владелец);
				Запрос.УстановитьПараметр("ТипСклада", Стр.АдресХранения.Лико_ТипСклада);
				Запрос.УстановитьПараметр("УдаленныйСклад", Стр.АдресХранения.Лико_УдаленныйСклад);
				Запрос.УстановитьПараметр("ОтветХранение", Стр.АдресХранения.Лико_ОтветственноеХранение);
				Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					МассивПодобранныхСерий.Добавить(ВыборкаДетальныеЗаписи.Серия); 
					НомерПоставки = Стр.Серия.ЯССМ_ОбъектНоменклатуры.НомерПоставки;
					ДатаФормирования = Стр.Серия.ЯССМ_ОбъектНоменклатуры.ДатаФормирования;
					ТекстВопроса = "Нарушен принцип ФИФО, для ТМЦ """ + Стр.Номенклатура.Наименование + """, #" + НомерПоставки + " от " + Формат(ДатаФормирования,"ДФ=dd.MM.yyyy") 
					+ " - есть более ранний - " + "#" + ВыборкаДетальныеЗаписи.НомерПоставки + " от " + Формат(ВыборкаДетальныеЗаписи.ДатаФормирования,"ДФ=dd.MM.yyyy");
					Вопрос = ?(Вопрос = "", ТекстВопроса,Вопрос + Символы.ПС + Символы.ПС + ТекстВопроса);
					ТекстПисьма = "Для ТМЦ """ + Стр.Номенклатура.НаименованиеПолное 
					+ ?(Найти(НРег(Стр.Номенклатура.НаименованиеПолное),НРег(Стр.Номенклатура.Артикул)) > 0,""," (" + Стр.Номенклатура.Артикул +")") 
					+ """, #" + НомерПоставки + " от " + Формат(ДатаФормирования,"ДФ=dd.MM.yyyy") 
					+ " - есть более ранний - " + "#" + ВыборкаДетальныеЗаписи.НомерПоставки + " от " + Формат(ВыборкаДетальныеЗаписи.ДатаФормирования,"ДФ=dd.MM.yyyy");
					Письмо = ?(Письмо = "", ТекстПисьма,Письмо + "<br>" + "<br>" + ТекстПисьма);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	Иначе
		СтруктураВозврата = Новый Структура("Вопрос,Письмо",Вопрос,Письмо);
		Возврат СтруктураВозврата; 
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура("Вопрос,Письмо",Вопрос,Письмо);
	Возврат СтруктураВозврата;
	
КонецФункции  // <-- Конец Лико Яцун С. В. 14.10.2025

&НаКлиенте
Процедура ПослеОтветаНаВопросФИФО(РезультатВопроса, ДополнительныеПараметры) Экспорт // <-- Начало Лико Яцун С. В. 14.10.2025
    
	Результат = РезультатВопроса;
	Если Результат = КодВозвратаДиалога.Да Тогда
		ДополнительныеПараметры.ПараметрыЗаписи.Вставить("ПровестиПослеПроверкиФИФО",Истина);
		ЭтаФорма.Записать(ДополнительныеПараметры.ПараметрыЗаписи);
		ТемаПисьма = "В заявке на склад " + Объект.Номер + " от " + Формат(Объект.Дата,"ДФ=dd.MM.yyyy") + " нарушен принцип ФИФО";
		ТекстПисьма = "В заявке на склад " + Объект.Номер + " от " + Формат(Объект.Дата,"ДФ=dd.MM.yyyy") + " нарушен принцип ФИФО: " + "<br>" + "<br>" + ДополнительныеПараметры.ТекстПисьма;
		Адресат = "MBuyanov@okil-sato.ru;ALeshev@okil-sato.ru;OlegPak@okil.ru;OLyaskovskaya@okil-sato.ru";
		ОтправитьПисьмо(ТекстПисьма, ТемаПисьма, Адресат);
	КонецЕсли; 
	
КонецПроцедуры // <-- Конец Лико Яцун С. В. 14.10.2025    

