&НаСервереБезКонтекста
Функция УчетПоСериям(Товар) //+Лико m.shenderov 25.10.2017
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.ИспользоватьСерии КАК ИспользоватьСерии
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ВидыНоменклатуры.Ссылка = Номенклатура.ВидНоменклатуры
	|ГДЕ
	|	Номенклатура.Ссылка = &Товар
	|
	|СГРУППИРОВАТЬ ПО
	|	ВидыНоменклатуры.ИспользоватьСерии";
	Запрос.УстановитьПараметр("Товар",Товар );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ИспользоватьСерии;
	КонецЦикла; 
	
	Возврат Ложь;
	
	
КонецФункции  //-Лико m.shenderov 25.10.2017



&НаКлиенте
Процедура ОткрытьПодборСерийЗавершение(ИмяТЧ, Текст, ТекущиеДанные)
	// Вставить содержимое метода.
	Если НоменклатураКлиент.ДляУказанияСерийНуженСерверныйВызов(ЭтаФорма,ПараметрыУказанияСерий[ИмяТЧ],Текст, ТекущиеДанные)
		и Лико_ОбщегоНазначенияСервер.ЕстьОбъектНоменклатуры(ТекущиеДанные.Номенклатура,ТекущиеДанные.Характеристика) Тогда
		Структура = Новый Структура;
		Структура.Вставить("Номенклатура",ТекущиеДанные.Номенклатура);
		Структура.Вставить("Характеристика",ТекущиеДанные.Характеристика);
		Структура.Вставить("Склад",Объект.Склад);
		Структура.Вставить("ТолькоОстатки",Истина);
		
		
		ОписаниеОповещения= Новый ОписаниеОповещения("Лико_ОткрытьПодборСерийЗавершение",ЭтаФорма);
		
		ОткрытьФорму("ОбщаяФорма.Лико_ФормаПодбораСерии",Структура,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		Возврат;	 
	КонецЕсли;	
	
КонецПроцедуры


&НаКлиенте
Процедура Лико_ОткрытьПодборСерийЗавершение(РезультатФормы,ПараметрыФормы) Экспорт //+Лико m.shenderov 28.09.2017
	
	Если РезультатФормы<>Неопределено Тогда
		Счет=0;
		Для каждого Результат Из РезультатФормы Цикл
			Счет=Счет+1;
			Если Счет=1 И  ЗначениеЗаполнено(Элементы.Товары.ТекущиеДанные.Серия) Тогда
				Счет=2;
			КонецЕсли;
			
			Если Счет>1 Тогда 	
				Отбор= Новый Структура;
				Отбор.Вставить("Серия",Результат.Серия);
				НайденныеСтроки=Объект.Товары.НайтиСтроки(Отбор); 
				Если  НайденныеСтроки.Количество()>0 Тогда
					Элементы.Товары.ТекущаяСтрока=Объект.Товары.Индекс(НайденныеСтроки[0]);
					Для каждого Стр Из НайденныеСтроки Цикл
						
					КонецЦикла;
				Иначе
					Элементы.Товары.СкопироватьСтроку();
				КонецЕсли;
				
			КонецЕсли; 			
			ТекСтрока				=Элементы.Товары.ТекущиеДанные;			
			ТекСтрока.Серия			=Результат.Серия;
			Данныесерии				=ПолучитьДанныеПоСерии(Результат.Серия);
			ТекСтрока.Упаковка		=ДанныеСерии.Упаковка;
			ТекСтрока.АдресХранения	=Результат.АдресХранения;
			ТекСтрока.КоличествоУпаковок=Результат.Количество; 	
			Действия 			= Новый Структура();
			ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок( Действия,"");	
			Действия.Вставить("ПроверитьСериюРассчитатьСтатус", Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий));
			ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекСтрока,Действия,КэшированныеЗначения);						
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры //-Лико m.shenderov 28.09.2017



