&НаКлиенте
Процедура ЗаполнениеПартииУВыделенныхЭлементовЗавершение(Результат,Параметры) Экспорт //+Лико m.shenderov 10.04.2023
	
	Если ТипЗнч(Результат)=Тип("Структура") И ЗначениеЗаполнено(Результат) Тогда 
		
		Для каждого Индекс Из Элементы.Товары.ВыделенныеСтроки  Цикл 
			
			         
			ЗаполнитьПартиюСервер( Элементы.Товары.ДанныеСтроки(Индекс).Серия,Результат);
			
			
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры //-Лико m.shenderov 10.04.2023


&НаСервере
Процедура ЗаполнитьПартиюСервер(Серия,Данные) //+Лико m.shenderov 10.04.2023
	ЗаписыватьОбъекты=Ложь;
	ОбъектНоменклатуры=Серия.ЯССМ_ОбъектНоменклатуры;
	Если ОбъектНоменклатуры.Уникальный Тогда
		
		СпрОбъект=  ОбъектНоменклатуры.ПолучитьОбъект();
		
		ЗаполнитьЗначенияСвойств(СпрОбъект,Данные);
		СпрОбъект.Записать();
		
		ЗаписыватьОбъекты=Истина;
	КонецЕсли;
	
	Если ЗаписыватьОбъекты Тогда
		ПриЧтенииСозданииНаСервере();

	КонецЕсли;
	
КонецПроцедуры  //-Лико m.shenderov 10.04.2023

