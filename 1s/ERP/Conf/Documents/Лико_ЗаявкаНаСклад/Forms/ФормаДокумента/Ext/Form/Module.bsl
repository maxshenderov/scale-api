		КонецЕсли;  
		Возврат
	КонецЕсли;

	
	Лико_СкладыКлиент.ПоказатьФормуОбъектаНоменклатуры(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка,"ТоварыСерияИмяКороткое");

