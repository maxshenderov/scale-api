&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	Перем ТекущаяСтрока;
	Перем СтруктураДействий;
	Элементы.Товары.ТекущиеДанные.Серия=Неопределено;
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	СтруктураДействий = Новый Структура;
	
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий));
	
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
	ЭтаФорма.ИмяФормы, "Товары"));
	
	ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	

КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПриЧтенииСозданииНаСервере();
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда		
		
		НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий); 		
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 	
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма); 
	
	////+AttachFiles
	
	payload = Новый Структура;
	payload.Вставить("DocName","Лико_ЗабраковкаОснастки");
	payload.Вставить("DocNumber",Объект.Номер);
	payload.Вставить("DocDate",Объект.Дата); 	
	
	Структура = Новый Структура;
	Структура.Вставить( "action","attach-files");
	Структура.Вставить( "payload",payload);
	Структура.Вставить("ttl",30); 	
	
	Json    = WebSocketСервер.СтруктураВJSON(Структура); 		
	Settings= WebSocketСервер.SettingsTest();
	Token   = WebSocketСервер.ПолучитьToken(Settings);  
	
	ssl      = Новый ЗащищенноеСоединениеOpenSSL();
	
	Массив = Новый Массив();
	Массив.Добавить(Новый Структура("Authorization", СтрШаблон("Bearer %1",Token)));
	
	HttpRespons     = WebSocketСервер.HttpRequest(Settings.domain,Settings.ApiEndPoint_AttachFiles,Json,ssl,,Массив);
	ОтветПотокаJSON = WebSocketСервер.ПолучитьОтветJSON(HttpRespons);		
	
	Если ОтветПотокаJSON.Свойство("uuid") Тогда 
		uuid_=ОтветПотокаJSON.uuid;
		 КодРабочегоМеста=WebSocketСервер.ПолучитьКодРабочегоМеста();

		Урл=WebSocketСервер.url(WebSocketСервер.settingsTest(),Новый Структура("ext,subject",uuid_,КодРабочегоМеста));  	
	КонецЕсли;
	
	url=Урл;
	// Подсистема WebSocket
	ПоказыватьQRCode=Ложь; 
	

	WebSocketСервер.ИнициализацияNew(ЭтаФорма,ПоказыватьQRCode,,WebSocketСервер.SettingsTest(),url);
	// Подсистема WebSocket
	
	////-AttachFiles
	
КонецПроцедуры

