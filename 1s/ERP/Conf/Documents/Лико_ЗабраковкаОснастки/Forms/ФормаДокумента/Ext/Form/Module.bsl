&НаСервереБезКонтекста
Функция ПолучитьДанныеПоСерии(Серия) 	
	//Серия=Справочники.СерииНоменклатуры.СоздатьЭлемент();
	Если Серия.ЯССМ_ОбъектНоменклатуры.Уникальный Тогда
		Количество= Серия.ЯССМ_ОбъектНоменклатуры.Количество;
	Иначе
		Количество=1
	КонецЕсли;
	
	
	Структура = Новый Структура;
	
	Структура.Вставить("Количество",Количество);
	//Структура.Вставить("Упаковка",Серия.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения);	
	Возврат Структура; 
	
	
