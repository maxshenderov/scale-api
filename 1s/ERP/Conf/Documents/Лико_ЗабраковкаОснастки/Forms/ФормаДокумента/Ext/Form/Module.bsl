Процедура ТоварыРешениеПриИзменении(Элемент)
	
	Если Элементы.Товары.ТекущиеДанные.Решение = ПредопределенноеЗначение("Справочник.Лико_РешенияПоБракуОснастки.ОграниченноГодныйК2") Тогда
		 Элементы.Товары.ТекущиеДанные.К2 = Истина;
	КонецЕсли;
	 
	Если Элементы.Товары.ТекущиеДанные.ПодРекламацию И Элементы.Товары.ТекущиеДанные.Решение = ПредопределенноеЗначение("Справочник.Лико_РешенияПоБракуОснастки.Списать") Тогда
		ПоказатьПредупреждение(,Новый ФорматированнаяСтрока("Внимание! Оснастка попадает под рекламацию! Прикрепите образцы к забракованному штампу и сдайте в ИК.",Новый Шрифт("Arial",15,Истина)),,"ВНИМАНИЕ!");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыДефектПриИзменении(Элемент)
	
	ДанныеОснастки = ПодучитьДанныеОснастки(Элементы.Товары.ТекущиеДанные.Серия);

	Если ДанныеОснастки.ЭтоПерваяВыдачаОснастки Тогда
		Элементы.Товары.ТекущиеДанные.Пробег = ПосчитатьПробегОснастки(Элементы.Товары.ТекущиеДанные.Номенклатура,Элементы.Товары.ТекущиеДанные.Серия);
	Иначе
		Элементы.Товары.ТекущиеДанные.Пробег = ДанныеОснастки.Пробег;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеОснастки.Форма) Тогда
		Элементы.Товары.ТекущиеДанные.Форма = ДанныеОснастки.Форма;
	КонецЕсли;
	
	Если ДанныеОснастки.ОснасткаПокупная 
		И ДанныеОснастки.ЭтоПерваяВыдачаОснастки 
		И Элементы.Товары.ТекущиеДанные.Пробег < 50000 
		И (Элементы.Товары.ТекущиеДанные.Дефект = ПредопределенноеЗначение("Справочник.Лико_ДефектыОснастки.Износ") 
			ИЛИ Элементы.Товары.ТекущиеДанные.Дефект = ПредопределенноеЗначение("Справочник.Лико_ДефектыОснастки.ДефектИзготовления")
			ИЛИ Элементы.Товары.ТекущиеДанные.Дефект = ПредопределенноеЗначение("Справочник.Лико_ДефектыОснастки.НесоответствиеЧертежу")) Тогда
		Элементы.Товары.ТекущиеДанные.ПодРекламацию = Истина;
	Иначе
		Элементы.Товары.ТекущиеДанные.ПодРекламацию = Ложь;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ПодучитьДанныеОснастки(ОснасткаСерия)

	ДатаПроверки = ?(ЗначениеЗаполнено(Объект.Ссылка),Объект.Дата,ТекущаяДата());
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Остатки.Ячейка КАК Ячейка ИЗ РегистрНакопления.ТоварыВЯчейках.Остатки(&Дата, Серия = &Серия) КАК Остатки
		|ГДЕ      Остатки.Серия = &Серия";  
	
	Запрос.УстановитьПараметр("Серия",ОснасткаСерия);
	Запрос.УстановитьПараметр("Дата",ДатаПроверки);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		АдресХранения = Выборка.Ячейка;
		Прервать;
	КонецЦикла;
	
	НаработкаТекОперации = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лико_ПередачаТоваровТовары.Ссылка КАК Ссылка,
		|	ЕСТЬNULL(Лико_ПередачаТоваровТовары.Ссылка.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПередачиВПроизводство,
		|	Лико_ПередачаТоваровТовары.Серия КАК Серия
		|ПОМЕСТИТЬ ВТДатаПередачиВПроизводство
		|ИЗ
		|	Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
		|ГДЕ
		|	Лико_ПередачаТоваровТовары.Серия = &Серия
		|	И Лико_ПередачаТоваровТовары.Ссылка.Проведен
		|	И НЕ Лико_ПередачаТоваровТовары.Ссылка.ПометкаУдаления
		|	И Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПередачиВПроизводство УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лико_ВозвратТоваровТовары.Ссылка КАК Ссылка,
		|	ЕСТЬNULL(Лико_ВозвратТоваровТовары.Ссылка.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВозвратаИзПроизводства,
		|	Лико_ВозвратТоваровТовары.Серия КАК Серия
		|ПОМЕСТИТЬ ВТДатаВозвратаНаСклад
		|ИЗ
		|	Документ.Лико_ВозвратТоваров.Товары КАК Лико_ВозвратТоваровТовары
		|ГДЕ
		|	Лико_ВозвратТоваровТовары.Ссылка.Проведен
		|	И НЕ Лико_ВозвратТоваровТовары.Ссылка.ПометкаУдаления
		|	И Лико_ВозвратТоваровТовары.Серия = &Серия
		|	И Лико_ВозвратТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ВозвратНаСклад.ПриходИзПроизводства)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаВозвратаИзПроизводства УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ВТДатаВозвратаНаСклад.ДатаВозвратаИзПроизводства, ДАТАВРЕМЯ(1, 1, 1)) < ЕСТЬNULL(ВТДатаПередачиВПроизводство.ДатаПередачиВПроизводство, ДАТАВРЕМЯ(1, 1, 1)) КАК УчитыватьТекущуюНаработку
		|ИЗ
		|	ВТДатаПередачиВПроизводство КАК ВТДатаПередачиВПроизводство
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВТДатаВозвратаНаСклад КАК ВТДатаВозвратаНаСклад
		|		ПО ВТДатаПередачиВПроизводство.Серия = ВТДатаВозвратаНаСклад.Серия";
	
	Запрос.УстановитьПараметр("Серия", ОснасткаСерия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.УчитыватьТекущуюНаработку Тогда
			НаработкаТекОперации = Лико_Дополнительно.ПолучитьПробегШтампаПоДаннымСчетчика(ОснасткаСерия, ДатаПроверки, АдресХранения, Ложь);
		Иначе
			НаработкаТекОперации = 0;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЯССМ_ОбъектыНоменклатуры.Категория2 КАК К2,
		|	ВЫБОР
		|		КОГДА Лико_ПараметрыШтампа.ВидРабот = &ВидРаботКонгрев
		|				И ЕСТЬNULL(Лико_ПараметрыШтампа.ШагПоРаппорту, 0) <> 0
		|				И Лико_ПараметрыШтампа.ЭтикетокНаЛисте <> 0
		|				И Лико_ПараметрыШтампа.Ручьи <> 0
		|			ТОГДА (ЕСТЬNULL(Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбщаяНаработка, 0) + &НаработкаТекОперации) / (Лико_ПараметрыШтампа.ЭтикетокНаЛисте / Лико_ПараметрыШтампа.Ручьи) * Лико_ПараметрыШтампа.ШагПоРаппорту
		|		КОГДА ЕСТЬNULL(Лико_ПараметрыШтампа.ШагПечати, 0) <> 0
		|			ТОГДА (ЕСТЬNULL(Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбщаяНаработка, 0) + &НаработкаТекОперации) / Лико_ПараметрыШтампа.ШагПечати
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Удары,
		|	Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбщаяНаработка КАК Пробег,
		|	ЯССМ_ОбъектыНоменклатуры.ПриходныйОрдер КАК ПриходныйОрдер,
		|	ЕСТЬNULL(Лико_НаработкиГлубокихФормСрезПоследних.ОбщаяНаработка, 0) КАК ПробегГлубокихВалов,
		|	ВидОснастки.Значение КАК ВидОснастки,
		|	ВидШтампаВала.Значение КАК ВидШтампа,
		|	Лико_ВалыФормыСрезПоследних.Форма КАК Форма
		|ИЗ
		|	Справочник.ЯССМ_ОбъектыНоменклатуры КАК ЯССМ_ОбъектыНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_НаработкиОбъектовНоменклатуры.СрезПоследних КАК Лико_НаработкиОбъектовНоменклатурыСрезПоследних
		|		ПО ЯССМ_ОбъектыНоменклатуры.Ссылка = Лико_НаработкиОбъектовНоменклатурыСрезПоследних.ОбъектНоменклатуры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
		|		ПО ЯССМ_ОбъектыНоменклатуры.Номенклатура = Лико_ПараметрыШтампа.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ВалыФормы.СрезПоследних КАК Лико_ВалыФормыСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_НаработкиГлубокихФорм.СрезПоследних КАК Лико_НаработкиГлубокихФормСрезПоследних
		|			ПО Лико_ВалыФормыСрезПоследних.Вал = Лико_НаработкиГлубокихФормСрезПоследних.Вал
		|				И Лико_ВалыФормыСрезПоследних.Форма = Лико_НаработкиГлубокихФормСрезПоследних.Форма
		|				И (НАЧАЛОПЕРИОДА(Лико_ВалыФормыСрезПоследних.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(Лико_НаработкиГлубокихФормСрезПоследних.ДатаПрихода, ДЕНЬ))
		|		ПО ЯССМ_ОбъектыНоменклатуры.Номенклатура = Лико_ВалыФормыСрезПоследних.Вал
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ВидОснастки
		|		ПО ЯССМ_ОбъектыНоменклатуры.Номенклатура = ВидОснастки.Ссылка
		|			И (ВидОснастки.Свойство.Имя = ""ОснасткаВид"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ВидШтампаВала
		|		ПО ЯССМ_ОбъектыНоменклатуры.Номенклатура = ВидШтампаВала.Ссылка
		|			И (ВидШтампаВала.Свойство.Имя = ""ОстасткаВидШтампа"")
		|ГДЕ
		|	ЯССМ_ОбъектыНоменклатуры.Серия = &ОснасткаСерия";
	
	Запрос.УстановитьПараметр("ВидРаботКонгрев", Справочники.ВидыРаботСотрудников.Конгрев);
	Запрос.УстановитьПараметр("ОснасткаСерия", ОснасткаСерия);
	Запрос.УстановитьПараметр("НаработкаТекОперации", НаработкаТекОперации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Структура = Новый Структура();
		Структура.Вставить("К2",ВыборкаДетальныеЗаписи.К2);
		
		Если ВыборкаДетальныеЗаписи.ПробегГлубокихВалов > 0 
			И ВыборкаДетальныеЗаписи.ВидОснастки = Перечисления.Лико_ВидОснастки.Вал 
			И ВыборкаДетальныеЗаписи.ВидШтампа = Справочники.Лико_ВидШтампа.ГлубокаяПечать Тогда
			Структура.Вставить("Пробег",ВыборкаДетальныеЗаписи.ПробегГлубокихВалов);
			Структура.Вставить("ЭтоПерваяВыдачаОснастки",Ложь);
			Структура.Вставить("Форма",ВыборкаДетальныеЗаписи.Форма);
		ИначеЕсли ВыборкаДетальныеЗаписи.ВидОснастки = Перечисления.Лико_ВидОснастки.Вал 
			И ВыборкаДетальныеЗаписи.ВидШтампа = Справочники.Лико_ВидШтампа.ГлубокаяПечать Тогда
			Структура.Вставить("ЭтоПерваяВыдачаОснастки",Истина);
			Структура.Вставить("Форма",ВыборкаДетальныеЗаписи.Форма);
		ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Пробег) = Тип("Null") Тогда
			Структура.Вставить("ЭтоПерваяВыдачаОснастки",Истина);
			Структура.Вставить("Форма",Неопределено);
		Иначе
			Структура.Вставить("Пробег",ВыборкаДетальныеЗаписи.Удары);
			Структура.Вставить("ЭтоПерваяВыдачаОснастки",Ложь); 
			Структура.Вставить("Форма",Неопределено);
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПриходныйОрдер) Тогда
			Структура.Вставить("ОснасткаПокупная",Истина);
		Иначе
			Структура.Вставить("ОснасткаПокупная",Ложь); 
		КонецЕсли;

	КонецЦикла;
	
	Возврат Структура;

КонецФункции 

&НаСервере
Функция ПосчитатьПробегОснастки(Номенклатура,ОснасткаСерия)
	
	ДатаПроверки = ?(ЗначениеЗаполнено(Объект.Ссылка),Объект.Дата,ТекущаяДата());
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Остатки.Ячейка КАК Ячейка ИЗ РегистрНакопления.ТоварыВЯчейках.Остатки(&Дата, Серия = &Серия) КАК Остатки
		|ГДЕ      Остатки.Серия = &Серия";  
	
	Запрос.УстановитьПараметр("Серия",ОснасткаСерия);
	Запрос.УстановитьПараметр("Дата",ДатаПроверки);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		АдресХранения = Выборка.Ячейка;
		Прервать;
	КонецЦикла;  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА Лико_ПараметрыШтампа.ВидРабот = &ВидРаботКонгрев
		|					И ЕСТЬNULL(Лико_ПараметрыШтампа.ШагПоРаппорту, 0) <> 0
		|					И Лико_ПараметрыШтампа.ЭтикетокНаЛисте <> 0
		|					И Лико_ПараметрыШтампа.Ручьи <> 0
		|				ТОГДА ЕСТЬNULL(&НаработкаТекОперации, 0) / (Лико_ПараметрыШтампа.ЭтикетокНаЛисте / Лико_ПараметрыШтампа.Ручьи) * Лико_ПараметрыШтампа.ШагПоРаппорту
		|			КОГДА ВидОснастки.Значение = ЗНАЧЕНИЕ(Перечисление.Лико_ВидОснастки.Вал)
		|					И ВидШтампаВала.Значение = ЗНАЧЕНИЕ(Справочник.Лико_ВидШтампа.ГлубокаяПечать)
		|				ТОГДА ЕСТЬNULL(&НаработкаТекОперации, 0)
		|			КОГДА ЕСТЬNULL(Лико_ПараметрыШтампа.ШагПечати, 0) <> 0
		|				ТОГДА ЕСТЬNULL(&НаработкаТекОперации, 0) / Лико_ПараметрыШтампа.ШагПечати
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Удары
		|ИЗ
		|	РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ВидШтампаВала
		|		ПО Лико_ПараметрыШтампа.Номенклатура = ВидШтампаВала.Ссылка
		|			И (ВидШтампаВала.Свойство.Имя = ""ОстасткаВидШтампа"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ВидОснастки
		|		ПО Лико_ПараметрыШтампа.Номенклатура = ВидОснастки.Ссылка
		|			И (ВидОснастки.Свойство.Имя = ""ОснасткаВид"")
		|ГДЕ
		|	Лико_ПараметрыШтампа.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("ВидРаботКонгрев", Справочники.ВидыРаботСотрудников.Конгрев);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("НаработкаТекОперации", Лико_Дополнительно.ПолучитьПробегШтампаПоДаннымСчетчика(ОснасткаСерия, ДатаПроверки, АдресХранения, Ложь));

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Пробег = ВыборкаДетальныеЗаписи.Удары;
	КонецЦикла;
	
	Возврат Пробег;
	
КонецФункции
