	Элементы.Товары.ТекущиеДанные.Серия=Неопределено; 
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ВозвратНаСклад.ПриходИзПроизводства")  Тогда
		
		Если ПараметрыЗаписи.РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда
			ПроверитьАдресПроизводства(Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	// <-- Начало Лико Яцун С. В. 16.02.2026 
	Если НЕ Отказ И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ПроверитьНеобходимостьУтилизацииФорм();
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 16.02.2026
	
КонецПроцедуры

&НаСервере
Функция ПроверитьНеобходимостьУтилизацииФорм() // <-- Начало Лико Яцун С. В. 16.02.2026
	
	ВидОперацииДокумента = Объект.ВидОперации;
	ОповещениеПользователю = "";
	Если ВидОперацииДокумента = Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ПриходФорм Тогда
		
		Для каждого Стр Из Объект.Формы Цикл
				Если Стр.Форма.ДействияСФормой = Перечисления.Лико_ДействияСФормой.Утилизировать Тогда
					ТекстСообщения = "Строка №" + Стр.НомерСтроки + ": Форма № " + Стр.Форма.Код + " - Данную форму надо утилизировать";
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = ТекстСообщения;
					Сообщение.Сообщить();
					ОповещениеПользователю = ?(ЗначениеЗаполнено(ОповещениеПользователю),ОповещениеПользователю + Символы.ПС + ТекстСообщения,ТекстСообщения)
				КонецЕсли;
		КонецЦикла;
			
	ИначеЕсли ВидОперацииДокумента = Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ВводНачальныхОстатковФорм Тогда
		
		ТЗФорм = Объект.Формы.Выгрузить();
		ТЗФорм.Свернуть("Конверт");
		
		Для каждого Стр Из ТЗФорм Цикл
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Лико_ИсторияДвиженийФормСрезПоследних.Форма.Код КАК Форма
			|ИЗ
			|	РегистрСведений.Лико_ИсторияДвиженийФорм.СрезПоследних КАК Лико_ИсторияДвиженийФормСрезПоследних
			|ГДЕ
			|	Лико_ИсторияДвиженийФормСрезПоследних.Расположение = &Расположение
			|	И Лико_ИсторияДвиженийФормСрезПоследних.Форма.ДействияСФормой = &ДействияСФормой";
			
			Запрос.УстановитьПараметр("ДействияСФормой", Перечисления.Лико_ДействияСФормой.Утилизировать);
			Запрос.УстановитьПараметр("Расположение", Стр.Конверт);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ТекстСообщения = "В конверте " + Стр.Конверт + " хранится Форма № " + ВыборкаДетальныеЗаписи.Форма + ", которую надо утилизировать";
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстСообщения;
				Сообщение.Сообщить();
				ОповещениеПользователю = ?(ЗначениеЗаполнено(ОповещениеПользователю),ОповещениеПользователю + Символы.ПС + ТекстСообщения,ТекстСообщения)
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли; 
	
	Возврат ОповещениеПользователю;
	
КонецФункции // <-- Конец Лико Яцун С. В. 16.02.2026

Процедура  ПроверитьАдресПроизводства(Отказ) //+Лико m.shenderov 25/12/2019
	ИндексСтроки=0;
	Для каждого Товар Из Объект.Товары  Цикл
		Если Товар.АдресХранения.Помещение.Лико_ТипСклада<>Перечисления.Лико_ТипСклада.Производство ТОгда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Товар находится не на производстве!";
			Сообщение.Поле = "Объект.Товары["+Строка(ИндексСтроки)+"].АдресХранения"; //имя реквизита 
			//Сообщение.КлючДанных = Ссылка;
			//Сообщение.ПутьКДанным = "Объект";
			Сообщение.УстановитьДанные(Объект); //Ссылка на объект ИБ
			
			Сообщение.Сообщить();		
			//Отказ=Истина;	
		КонецЕсли;
		
		ИндексСтроки=ИндексСтроки+1;
	КонецЦикла;
	
	
КонецПроцедуры //-Лико m.shenderov 25/12/2019

&НаСервере
