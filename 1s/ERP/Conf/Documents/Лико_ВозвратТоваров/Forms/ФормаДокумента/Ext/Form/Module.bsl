&НаКлиенте
Процедура ПечатьСкладскойКарточки(Команда)
	
	Если Не Объект.Проведен Тогда
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Распечатать карточку складской операции можно только после проведения документа!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	Данные = Новый Структура;
	Данные.Вставить("ДатаВремя", Объект.Дата);
	Данные.Вставить("Номер", Объект.Номер);
	Данные.Вставить("ВидОперации", Объект.ВидОперации);
	Данные.Вставить("НомерЗаказа", Прав(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Объект.ЗаказКлиента,"Номер"),7));
	Данные.Вставить("Сотрудник", ФизическиеЛицаКлиентСервер.ФамилияИнициалыФизЛица(Строка(Объект.Сотрудник)));
	Данные.Вставить("Получатель", Строка(Объект.АдресХранения)+" "+ ПомещениеАдресаХранения( Объект.АдресХранения));
	Данные.Вставить("АвторДокумента", ФизическиеЛицаКлиентСервер.ФамилияИнициалыФизЛица(Строка(Объект.АвторДокумента)));
	
	//Если Товары.Количество()>3 Тогда
	//	Если Вопрос("Будет распечатано "+Товары.Количество()+" карточек складских операций. Вы уверены, что хотите распечатать все эти карточки?", РежимДиалогаВопрос.ДаНет, 5, КодВозвратаДиалога.Нет, "Внимание!")=КодВозвратаДиалога.Нет Тогда
	//		Возврат;
	//	КонецЕсли;
	//КонецЕсли;
	
	КоличествоКопий = 1;
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		
		Данные.Вставить("КоличествоЕдиницаИзмерения", "" + СтрокаТовары.Количество + " " + СтрокаТовары.Упаковка);
		Данные.Вставить("ОбъектНоменклатуры", СтрокаТовары.Серия);
		Данные.Вставить("Дополнительное", "");
		Если Не ЗначениеЗаполнено(Объект.АдресХранения) Тогда
			Данные.Вставить("Получатель", Строка(СтрокаТовары.АдресХраненияНовый)+" "+ ПомещениеАдресаХранения(СтрокаТовары.АдресХраненияНовый));
			
			
		КонецЕсли;
		
		// переопределим адрес хранения для ролика
		//Данные.Вставить("Получатель", СтрокаТовары.АдресХранения);
		
		
		ТабДокумент=Лико_ОбщегоНазначенияСервер.ПечатьСкладскойОперации(Данные, КоличествоКопий, СразуНаПринтер());
		
		Если КоличествоКопий > 0 Тогда
			ТабДокумент.КоличествоЭкземпляров = КоличествоКопий;
		КонецЕсли;
		
		
		ТабДокумент.Напечатать();
	КонецЦикла;
	
	
	Если Объект.Формы.Количество()>0 Тогда
		
		//ВремФормы = Объект.Формы.Выгрузить();
		ТабДокумент=Лико_ОбщегоНазначенияСервер.ФормыПечатьСкладскойОперации(Объект.Ссылка, Данные, Ложь, КоличествоКопий, СразуНаПринтер());
		
		Если КоличествоКопий > 0 Тогда
			ТабДокумент.КоличествоЭкземпляров = КоличествоКопий;
		КонецЕсли;
		
		
		ТабДокумент.Напечатать();
		
	КонецЕсли;
	
	
КонецПроцедуры
