&НаСервере
Процедура ОбработатьШтрихКодДокумента(МассивСсылок) //+Лико m.shenderov 23.08.2018
	
	Для каждого СсылкаДокумента Из МассивСсылок Цикл
		
		Если ТипЗНЧ(СсылкаДокумента)=Тип("ДокументСсылка.Лико_ЗаявкаНаСклад") Тогда
			Объект.ЗаявкаНаСклад=СсылкаДокумента;
			Тз=Объект.ЗаявкаНаСклад.Товары.Выгрузить();
			Тз.Свернуть("Номенклатура, характеристика");
			Объект.Товары.Загрузить(Тз);
			НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий); 	
			
		КонецЕсли;
		
		
	КонецЦикла;
	
	
КонецПроцедуры  //-Лико m.shenderov 23.08.2018

