&НаКлиенте
Процедура ПодборНоменклатуры(Команда)
	Структура = Новый Структура;
	Структура.Вставить("Склад",Объект.Склад);	
	Структура.Вставить("Период",?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата,ТекущаяДата()));
	Структура.Вставить("ТолькоОстатки",Истина);
	
	Если ЗначениеЗаполнено(Объект.Отправитель) И ТипЗнч(Объект.Отправитель)=Тип("СправочникСсылка.РабочиеЦентры") Тогда
		Ячейка=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Объект.Отправитель,"ЛикоЯчейка");
		Структура.Вставить("Ячейка",Ячейка);
		ПомещениеПроизводство=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Ячейка,"Помещение");
		Структура.Вставить("Помещение",ПомещениеПроизводство); 
	КонецЕсли;
	
	Если Не Структура.Свойство("Помещение") Тогда
		ПомещениеПроизводство=ПолучитьПомещениеПроизводство();
		Структура.Вставить("Помещение",ПомещениеПроизводство);
	КонецЕсли;
	
	
	ОписаниеОповещения=Новый ОписаниеОповещения("ПодборНоменклатурыЗавершение",ЭтаФорма);
