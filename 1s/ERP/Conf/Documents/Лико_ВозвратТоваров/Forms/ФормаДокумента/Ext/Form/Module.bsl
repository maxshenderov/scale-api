Процедура ЗаполнитьНаработкуПоДаннымСчетчика(Команда) // --> Начало Лико Ефимов ЕВВ 26.08.2021 
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	ЗаполнитьДанныеПоНаработке(ТекущаяСтрока, Истина);
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 26.08.2021 

&НаКлиенте
Процедура ЗаполнитьДанныеПоНаработке(ТекущаяСтрока, РучнойВызов = Ложь) // --> Начало Лико Ефимов ЕВВ 27.08.2021
	Если ТекущаяСтрока <> Неопределено Тогда
		Модифицированность = Истина;
		ТекущаяСтрока.НаработкаТекущейОперации = Лико_Дополнительно.ПолучитьПробегШтампаПоДаннымСчетчика(ТекущаяСтрока.Серия, Объект.Дата, ТекущаяСтрока.АдресХранения, РучнойВызов);
		Если ТекущаяСтрока.НаработкаТекущейОперации <> 0 И НЕ Объект.ДанныеПоНаработке Тогда
			Объект.ДанныеПоНаработке = Истина;
			УстановитьВидимость();
		ИначеЕсли ТекущаяСтрока.НаработкаТекущейОперации <> 0 И ТекущаяСтрока.НаработкаПредыдущихОпераций = 0 И Объект.ДанныеПоНаработке И ЗначениеЗаполнено(ТекущаяСтрока.Серия) Тогда
			лДанныеПоНаработке = Лико_Дополнительно.ПолучитьДанныеПоНаработке(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.Серия,"ЯССМ_ОбъектНоменклатуры"), ?(Не ЗначениеЗаполнено(Объект.Ссылка), ТекущаяДата(), Объект.Дата-1)); 		
			ТекущаяСтрока.НаработкаПредыдущихОпераций = лДанныеПоНаработке.ОбщаяНаработка;
			ТекущаяСтрока.ПримечаниеПоПредыдущимНаработкам = лДанныеПоНаработке.Примечание;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 27.08.2021 

