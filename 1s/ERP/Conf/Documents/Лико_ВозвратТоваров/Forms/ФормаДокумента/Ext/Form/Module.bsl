	СтандартнаяОбработка=Ложь;
	Структура = Новый Структура;
	Отбор = Новый Структура;
	Отбор.Вставить("ВалютаВзаиморасчетов",Объект.Лико_Валюта);
	Отбор.Вставить("Контрагент",	Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Объект.Распоряжение,"Контрагент"));
	Отбор.Вставить("Организация",	Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Объект.Распоряжение,"Организация"));
	Отбор.Вставить("Партнер",		Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Объект.Распоряжение,"Партнер"));
	Структура.Вставить("Отбор",		Отбор);
	ОткрытьФорму("Справочник.ДоговорыКонтрагентов.ФормаВыбора",Структура,Элементы.Лико_Договор);
	
	
КонецПроцедуры

