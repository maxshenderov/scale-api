Процедура КопироватьПоРельсеНаСервере(Форма,Конверт)
	//Форма		=Элементы.Формы.ТекущиеДанные.Форма;
	//Конверт		=Элементы.Формы.ТекущиеДанные.Конверт;
	
	Если ЗначениеЗаполнено(Форма) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_Формы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Лико_Формы КАК Лико_Формы
		|ГДЕ
		|	ПОДСТРОКА(Лико_Формы.Код, 1, 7) = &Код
		|	И Лико_Формы.Ссылка <> &Форма
		|
		|УПОРЯДОЧИТЬ ПО
		|	Лико_Формы.Код";
		Запрос.УстановитьПараметр("Форма",Форма);
		Запрос.УстановитьПараметр("Код",Сред(Форма.Код,1,7));
		
