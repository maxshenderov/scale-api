			Распоряжение=Документы.РеализацияТоваровУслуг.ПолучитьСсылку();
		ИначеЕсли ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Списание Тогда		
			Распоряжение=Документы.ВнутреннееПотребление.ПолучитьСсылку();
