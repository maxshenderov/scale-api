Процедура СоздатьРедактироватьПоступлениеОтПереработчика(Распоряжение, ДанныеЗаполнения, РежимЗаписи,Отказ) 
	Возврат;
	Если Не РежимЗаписи=РежимЗаписиДокумента.Проведение  Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеЗаполнения.ВидОперации=Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ПриходИзПереработки Тогда
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Распоряжение) Тогда
			НовоеРаспоряжение=Распоряжение.ПолучитьОбъект();
			Если НовоеРаспоряжение=Неопределено Тогда
				НовоеРаспоряжение=Документы.ПоступлениеОтПереработчика.СоздатьДокумент();	
				НовоеРаспоряжение.УстановитьСсылкуНового(ДанныеЗаполнения.Распоряжение); 
			КонецЕсли;  				
		Иначе
			НовоеРаспоряжение=Документы.ПоступлениеОтПереработчика.СоздатьДокумент();	
			НовоеРаспоряжение.УстановитьСсылкуНового(ДанныеЗаполнения.Распоряжение); 				
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НовоеРаспоряжение,ДанныеЗаполнения);
		Тз=Товары.Выгрузить(,ПоляТыблицыТоваров());
		Тз.Свернуть("Номенклатура,Характеристика,Упаковка","Количество,КоличествоУпаковок");
		Тз.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
		Для каждого СтТз Из Тз Цикл
			СтТз.Склад=Склад;
		КонецЦикла;
		НовоеРаспоряжение.ХозяйственнаяОперация=Перечисления.ХозяйственныеОперации.ПоступлениеОтПереработчика;
		НовоеРаспоряжение.Товары.Загрузить(Тз); 			
		Попытка 				
			НовоеРаспоряжение.Записать(РежимЗаписиДокумента.Проведение); 				
		Исключение
			НовоеРаспоряжение.Записать();
		КонецПопытки;
		
		Распоряжение=НовоеРаспоряжение.Ссылка;
		
	КонецЕсли;	
	
КонецПроцедуры 

Процедура СоздатьРедактироватьВозвратПоставщику(Распоряжение, ДанныеЗаполнения, РежимЗаписи,Отказ) 
	Если Не РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеЗаполнения.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ВозвратПоставщику Тогда
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Распоряжение) Тогда
			НовоеРаспоряжение=Распоряжение.ПолучитьОбъект();
			Если НовоеРаспоряжение=Неопределено Тогда
				НовоеРаспоряжение=Документы.ВозвратТоваровПоставщику.СоздатьДокумент();	
				НовоеРаспоряжение.УстановитьСсылкуНового(ДанныеЗаполнения.Распоряжение); 
			КонецЕсли;  				
		Иначе
			НовоеРаспоряжение=Документы.ВозвратТоваровПоставщику.СоздатьДокумент();	
			НовоеРаспоряжение.УстановитьСсылкуНового(ДанныеЗаполнения.Распоряжение); 				
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НовоеРаспоряжение,ДанныеЗаполнения);
		НовоеРаспоряжение.Товары.Загрузить(ДанныеЗаполнения.Товары.Выгрузить(,ПоляТыблицыТоваров())); 			
		Попытка 				
			НовоеРаспоряжение.Записать(); 				
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
		
		
		Распоряжение=НовоеРаспоряжение.Ссылка;
		
	КонецЕсли;	
	
