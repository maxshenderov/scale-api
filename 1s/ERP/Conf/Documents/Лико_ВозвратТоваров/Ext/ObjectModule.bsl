			НовоеПоступление.ГруппаФинансовогоУчета=Справочники.ГруппыФинансовогоУчетаРасчетов.НайтиПоНаименованию("Поставщики (у.е.)");
			
		КонецЕсли;
	КонецЕсли;
	
	Если НовоеПоступление.Валюта = ВалютаРуб Тогда
		// не резидент, ставка НДС = 0
		НовоеПоступление.ГруппаФинансовогоУчета=Справочники.ГруппыФинансовогоУчетаРасчетов.НайтиПоНаименованию("Поставщики (руб)");
