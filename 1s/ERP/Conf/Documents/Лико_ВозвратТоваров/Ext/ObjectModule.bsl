


#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ИнициализироватьДокумент(ДанныеЗаполнения); 		
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВидОперации=Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ПриходИзПроизводства;
	КонецЕсли;	
КонецПроцедуры


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
			

	
	//+Проверка ЯССМ Склада
	//#Если Клиент Тогда
	Если Не Лико_ОбщегоНазначенияСервер.АдминистраторСклада() Тогда
		Расшифровка = "";			
		МассивОбъектов = Товары.ВыгрузитьКолонку("Серия");
		МожноПровестиДокумент = Лико_ОбщегоНазначенияСервер.ПроверитьВозможностьПроведенияДокумента(ЭтотОбъект, МассивОбъектов, РежимЗаписи, РежимПроведения, Расшифровка);
		Если Не МожноПровестиДокумент Тогда
			
			СообщениеПользователю = "Невозможно провести документ на это время! Пояснение: " + Расшифровка;
			Сообщить(СообщениеПользователю);			
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//#КонецЕсли
	//-Проверка ЯССМ Склада
	
	// --> Начало Лико Ефимов ЕВВ 25.08.2021
	ПроверитьНовыеАдресаХранения(Отказ, РежимЗаписи);
	// <-- Конец Лико Ефимов ЕВВ 25.08.2021	
	
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ВводНачальныхОстатковФорм или
		ВидОперации=Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ПриходФорм	   Тогда
		Товары.Очистить();
	Иначе
		Формы.Очистить();
	КонецЕсли;
	
	
	
	Если ТипЗнч(Отправитель)=Тип("СправочникСсылка.Контрагенты") и ЗначениеЗаполнено(Отправитель) Тогда
		Контрагент=Отправитель;
		Партнер=Контрагент.Партнер;
	КонецЕсли;
	
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);	
	ДополнительныеСвойства.Вставить("БылПроведен", Проведен); 
	
	
	//ТаблицаТоваровИзменена--> 
	
	ТзТоварыСтарые =   Ссылка.Товары.Выгрузить(,"Номенклатура");
	ТзТоварыНовые  = Товары.Выгрузить(,"Номенклатура");
	
	ТзТоварыСтарые.Свернуть("Номенклатура");
	ТзТоварыНовые.Свернуть("Номенклатура");
	
	ЕстьИзмененияТоваров = Лико_Дополнительно.СравнениеДвухОдинаковыхТаблицЗначенийПоСодержимому(ТзТоварыСтарые,ТзТоварыНовые);
	
	ДополнительныеСвойства.Вставить("ТаблицаТоваровИзменена", ЕстьИзмененияТоваров); 
	
	//ТаблицаТоваровИзменена<--	
	
	
	
	ЕСли ОтражатьВБухгалтерскомУчете=Истина Тогда
		
		ПроверитьНаличиеРаспоряжения();
	Иначе
		Распоряжение=Неопределено;
	КонецЕсли;
	Для каждого Товар Из Товары Цикл
		Если ЗначениеЗаполнено(Товар.Серия) Тогда	
			Товар.СтатусУказанияСерий=8;
		Иначе
			Товар.СтатусУказанияСерий=7;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ДанныеПоНаработке Тогда
		
		Для каждого Товар Из Товары Цикл
			Если Товар.НаработкаТекущейОперации>0 Тогда
				ДанныеПоНаработке=Истина;
			КонецЕсли;
			
			
		КонецЦикла;
	КонецЕсли;
		
	Если ЭтоНовый() и ОтражатьВБухгалтерскомУчете Тогда
		НоваяСсылка=Документы.Лико_ВозвратТоваров.ПолучитьСсылку();
		ДополнительныеСвойства.Вставить("НоваяСсылкаСсылка",НоваяСсылка);
		УстановитьСсылкуНового(НоваяСсылка);
		Распоряжение=Неопределено; 
		
	КонецЕсли;

	 Если  Не Проведен Тогда	
		ОбработатьРаспоряжение(ДополнительныеСвойства.РежимЗаписи,Отказ);
	КонецЕсли;
	
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ПриходИзПроизводства И 
		Не ЗначениеЗаполнено(Отправитель) Тогда
		ГУ=Справочники.РабочиеЦентры.НайтиПоНаименованию("Гравировальный участок");
		АдресГУ =ГУ.ЛикоЯчейка;
		
		Для каждого Товар Из Товары Цикл
			Если Товар.АдресХранения=АдресГУ Тогда
				Отправитель=ГУ;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
		ЗаполнитьСклады(Отказ, РежимЗаписи);

		//+ ---> Лико2.5 m.shenderov 30.03.2022
	ПроведениеДокументов.ПередЗаписьюДокумента(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	//- <--- Лико2.5 m.shenderov 30.03.2022


КонецПроцедуры

Процедура ПроверитьНовыеАдресаХранения(Отказ, РежимЗаписи) // --> Начало Лико Ефимов ЕВВ 25.08.2021
	
	Если Дата < Дата('20210826100000') ИЛИ РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РабочиеЦентры.ЛикоЯчейка КАК Ячейка
		|ПОМЕСТИТЬ ВТ_ЯчейкиРабочихЦентров
		|ИЗ
		|	Справочник.РабочиеЦентры КАК РабочиеЦентры
		|ГДЕ
		|	НЕ РабочиеЦентры.ВидРабочегоЦентра В (&ВидыРЦИсключения)
		|	И РабочиеЦентры.ЛикоЯчейка <> ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	РабочиеЦентры.ЛикоЯчейка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТЗ.АдресХраненияНовый КАК Справочник.СкладскиеЯчейки) КАК АдресХраненияНовый,
		|	ВЫРАЗИТЬ(ТЗ.НомерСтроки КАК ЧИСЛО(15, 0)) КАК НомерСтроки
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ВТ.АдресХраненияНовый = ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
		|			ТОГДА &ЯчейкаИзШапки
		|		ИНАЧЕ ВТ.АдресХраненияНовый
		|	КОНЕЦ КАК АдресХраненияСУчетомТЧ,
		|	ВТ.НомерСтроки КАК НомерСтроки,
		|	ВТ.АдресХраненияНовый КАК АдресХраненияНовый
		|ПОМЕСТИТЬ ВТ2
		|ИЗ
		|	ВТ КАК ВТ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ2.АдресХраненияСУчетомТЧ КАК АдресХраненияСУчетомТЧ,
		|	ВТ2.НомерСтроки КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА ВТ_ЯчейкиРабочихЦентров.Ячейка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЯчейкаРЦ,
		|	ВТ2.АдресХраненияНовый КАК АдресХраненияНовый
		|ПОМЕСТИТЬ ВТ3
		|ИЗ
		|	ВТ2 КАК ВТ2
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЯчейкиРабочихЦентров КАК ВТ_ЯчейкиРабочихЦентров
		|		ПО ВТ2.АдресХраненияСУчетомТЧ = ВТ_ЯчейкиРабочихЦентров.Ячейка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ3.НомерСтроки КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА ВТ3.АдресХраненияНовый = ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК АдресХраненияНовыйПустой
		|ИЗ
		|	ВТ3 КАК ВТ3
		|ГДЕ
		|	ВТ3.ЯчейкаРЦ";
	
	Запрос.УстановитьПараметр("ТЗ", Товары.Выгрузить(,"НомерСтроки,АдресХраненияНовый"));
	Запрос.УстановитьПараметр("ЯчейкаИзШапки", АдресХранения);
	Запрос.УстановитьПараметр("ВидыРЦИсключения", Лико_Дополнительно.СформироватьМассивИсключенийВидовРЦДляПоискаЯчеекРЦ());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ?(ЗначениеЗаполнено(Ссылка), "" + Ссылка + " ", "") + " Строка №" + ВыборкаДетальныеЗаписи.НомерСтроки + ": материалы запрещено возвращать в ячейки рабочих центров";
		Если ВыборкаДетальныеЗаписи.АдресХраненияНовыйПустой Тогда
			Сообщение.Поле = "АдресХранения";
		Иначе
			Сообщение.Поле = "Товары["+(ВыборкаДетальныеЗаписи.НомерСтроки-1)+"].АдресХраненияНовый";
		КонецЕсли;
		Сообщение.ПутьКДанным = "Объект";
		Сообщение.Сообщить();
	КонецЦикла;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 25.08.2021 


Процедура ОбработкаПроведения(Отказ, РежимПроведения)
   //+ ---> Лико2.5 m.shenderov 05.04.2022
  	Если Отказ Тогда
		Возврат;
	КонецЕсли;


	ПроведениеДокументов.ОбработкаПроведенияДокумента(ЭтотОбъект, Отказ);

	 //- <--- Лико2.5 m.shenderov 05.04.2022
 

	СозатьНаборЗаписейИсторяФорм(Отказ);
	СозатьНаборЗаписейПоНаработке(Отказ);
	// <-- Начало Лико Яцун С. В. 11.03.2024 
	ДатаГлубокихФорм = Справочники.Лико_ПредопределенныеЗначения.ДатаГлубокихФорм.ЗначениеПараметра;
	Если ЗначениеЗаполнено(ДатаГлубокихФорм) И ДатаГлубокихФорм < ТекущаяДата() И ВидОперации = Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ПриходИзПереработки Тогда
		//Если ДополнительныеСвойства.ТаблицаТоваровИзменена Тогда 
			
			СозатьЗаписьПоЗаявкамНаГравировкуВалов(Отказ, ДополнительныеСвойства.ТаблицаТоваровИзменена);
			
		//КонецЕсли;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 11.03.2024

	Если Не Отказ и ВидОперации=Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ПриходПоАктуРазборки Тогда

		//УстановитьПризнакАктаРазборкиУНоменклатуры();

	КонецЕсли;
	Лико_ОбщегоНазначенияСервер.ПроверитьКоличествоОбъектаНоменклатуры(Товары.ВыгрузитьКолонку("Серия"));
	
	РегистрыСведений.Лико_СерииНоменклатурыДоп.Записать(ЭтотОбъект); 

	Обработки.ПеремещениеТоваровДоп.СформироватьДокумент(ЭтотОбъект);


КонецПроцедуры



Процедура СтруктураПараметровЗаписиОбъекта() 	
	
	Если Не ДополнительныеСвойства.Свойство("ЕстьВопросыПередЗаписью") ТОгда
		ДополнительныеСвойства.Вставить("ЕстьВопросыПередЗаписью", Ложь);
	КонецЕсли;
	Если Не ДополнительныеСвойства.Свойство("НовыйОбъект") ТОгда
		ДополнительныеСвойства.Вставить("НовыйОбъект", Ложь); 		
	КонецЕсли;
	Если Не ДополнительныеСвойства.Свойство("ПринудительноЗакрытьФорму") ТОгда
		ДополнительныеСвойства.Вставить("ПринудительноЗакрытьФорму", Ложь); 		
	КонецЕсли;
	Если Не ДополнительныеСвойства.Свойство("РежимЗаписи") ТОгда
		ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписиДокумента.Запись);		
	КонецЕсли; 	
	Если Не ДополнительныеСвойства.Свойство("РежимПроведения") ТОгда
		ДополнительныеСвойства.Вставить("РежимПроведения", РежимПроведенияДокумента.Неоперативный); 	
	КонецЕсли;
	
Конецпроцедуры


Процедура ОбработкаУдаленияПроведения(Отказ)
	
	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПроведениеДокументов.ОбработкаУдаленияПроведенияДокумента(ЭтотОбъект, Отказ);
	
	ОбработатьРаспоряжение(РежимЗаписиДокумента.ОтменаПроведения,Отказ);
	
	
	Лико_ОбщегоНазначенияСервер.НайтиДокументИПометитьНаУдаление("ПрочееОприходованиеТоваров","Лико_Документ",Ссылка,Отказ);
	Лико_ОбщегоНазначенияСервер.НайтиДокументИПометитьНаУдаление("ПриобретениеУслугПрочихАктивов","Лико_Документ",Ссылка,Отказ); 
	Лико_ОбщегоНазначенияСервер.НайтиДокументИПометитьНаУдаление("ПеремещениеТоваров","Лико_Документ",Ссылка,Отказ);
	Распоряжение=Неопределено;
	Лико_ПоступлениеБух=Неопределено;
	
КонецПроцедуры


Процедура ПриКопировании(ОбъектКопирования)
	
	ИнициализироватьДокумент();
	
КонецПроцедуры


Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Если ДополнительныеСвойства.Свойство("ПараметрыПроверки") Тогда	
		ПараметрыПроверки = ДополнительныеСвойства.ПараметрыПроверки;
		НепроверяемыеРеквизитыМассив = ПараметрыПроверки.НепроверяемыеРеквизиты;
		Для Каждого СтрМас из НепроверяемыеРеквизитыМассив Цикл
			МассивНепроверяемыхРеквизитов.Добавить(СтрМас);
		КонецЦикла;
	Иначе
		
	КонецЕсли;
	
	Если Не СкладыСервер.ИспользоватьСкладскиеПомещения(Склад,Дата) Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Помещение");
	КонецЕсли;
	
	
	
	ПараметрыПроверки = НоменклатураСервер.ПараметрыПроверкиЗаполненияХарактеристик();
	ПараметрыПроверки.ИмяТЧ = "Товары";
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ЭтотОбъект,МассивНепроверяемыхРеквизитов,Отказ,ПараметрыПроверки);
	
	
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУпаковкиНоменклатуры") Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Упаковка");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Упаковка");
		ТекстСообщения = НСтр("ru='В настройках программы не включено использование упаковок номенклатуры, 
		|поэтому нельзя оформить документ по складу с адресным хранением остатков. Обратитесь к администратору'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
	КонецЕсли;
	
	Если ВидОперации<>Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство Тогда
		
		МассивНепроверяемыхРеквизитов.Добавить("ЗаказКлиента");
		МассивНепроверяемыхРеквизитов.Добавить("НомерБланка");
		МассивНепроверяемыхРеквизитов.Добавить("Сотрудник");
		
	КонецЕсли;
	
	
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ВводНачальныхОстатковФорм Или
		ВидОперации=Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ПриходФорм Тогда
		
		МассивНепроверяемыхРеквизитов.Добавить("ЗаказКлиента");
		МассивНепроверяемыхРеквизитов.Добавить("НомерБланка");
		МассивНепроверяемыхРеквизитов.Добавить("Сотрудник");
		МассивНепроверяемыхРеквизитов.Добавить("Получатель");
		МассивНепроверяемыхРеквизитов.Добавить("Товары");
		
		
	КонецЕсли;
	
	  Если Не (ОтражатьВБухгалтерскомУчете) Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Лико_ЦеныНоменклатуры");
		МассивНепроверяемыхРеквизитов.Добавить("Лико_ЦеныНоменклатуры.Цена"); 
	КонецЕсли;

	
	
	
	ПараметрыПроверки = НоменклатураСервер.ПараметрыПроверкиЗаполненияУпаковок();
	ПараметрыПроверки.ИмяТЧ = "Товары";
	НоменклатураСервер.ПроверитьЗаполнениеУпаковок(ЭтотОбъект,МассивНепроверяемыхРеквизитов,Отказ, ПараметрыПроверки);
	ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект, Документы.Лико_ПередачаТоваров);
	
