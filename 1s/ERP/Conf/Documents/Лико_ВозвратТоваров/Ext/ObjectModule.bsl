	Если БезНДС Тогда 
			НовоеПоступление.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
			НовоеПоступление.ЗакупкаПодДеятельность=Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
            	НовоеПоступление.ЦенаВключаетНДС = Ложь;

	Иначе
			НовоеПоступление.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
			НовоеПоступление.ЗакупкаПодДеятельность=Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;

