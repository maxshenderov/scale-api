Процедура УстановитьСтатусзаявки(Отказ,УдалениеДОкументаПоЗаявке=Ложь) //+Лико m.shenderov 05.11.2018
	Если Не Отказ Тогда
		Если ЗначениеЗаполнено(ЗаявкаНаСклад) Тогда
			ДокументОбъект=ЗаявкаНаСклад.ПолучитьОбъект();
			Если  УдалениеДОкументаПоЗаявке Тогда
				ДокументОбъект.ДополнительныеСвойства.Вставить("УдалениеДОкументаПоЗаявке",Истина);
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли; 		
	КонецЕсли;	
