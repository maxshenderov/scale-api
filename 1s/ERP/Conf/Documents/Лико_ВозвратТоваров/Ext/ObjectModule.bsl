Процедура СоздатьРедактироватьПродажа(Распоряжение, ДанныеЗаполнения, РежимЗаписи,Отказ) 
	Если Не РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеЗаполнения.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Продажа Тогда
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Распоряжение) Тогда
			НовоеРаспоряжение=Распоряжение.ПолучитьОбъект();
			Если НовоеРаспоряжение=Неопределено Тогда
				НовоеРаспоряжение=Документы.РеализацияТоваровУслуг.СоздатьДокумент();	
				НовоеРаспоряжение.УстановитьСсылкуНового(ДанныеЗаполнения.Распоряжение); 
			КонецЕсли;  				
		Иначе
			НовоеРаспоряжение=Документы.РеализацияТоваровУслуг.СоздатьДокумент();	
			НовоеРаспоряжение.УстановитьСсылкуНового(ДанныеЗаполнения.Распоряжение); 				
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НовоеРаспоряжение,ДанныеЗаполнения);
		НовоеРаспоряжение.Товары.Загрузить(ДанныеЗаполнения.Товары.Выгрузить(,ПоляТыблицыТоваров())); 			
		Попытка 				
			НовоеРаспоряжение.Записать(); 				
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
		
		Распоряжение=НовоеРаспоряжение.Ссылка;
		
	КонецЕсли;	
	
КонецПроцедуры 

Процедура СоздатьРедактироватьСписание(Распоряжение, ДанныеЗаполнения, РежимЗаписи,Отказ) 
	Если Не РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеЗаполнения.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Списание Тогда
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Распоряжение) Тогда
			НовоеРаспоряжение=Распоряжение.ПолучитьОбъект();
			Если НовоеРаспоряжение=Неопределено Тогда
				НовоеРаспоряжение=Документы.ВнутреннееПотребление.СоздатьДокумент();	
				НовоеРаспоряжение.УстановитьСсылкуНового(ДанныеЗаполнения.Распоряжение); 
			КонецЕсли;  				
		Иначе
			НовоеРаспоряжение=Документы.ВнутреннееПотребление.СоздатьДокумент();	
			НовоеРаспоряжение.УстановитьСсылкуНового(ДанныеЗаполнения.Распоряжение); 				
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НовоеРаспоряжение,ДанныеЗаполнения);
		НовоеРаспоряжение.Товары.Загрузить(ДанныеЗаполнения.Товары.Выгрузить(,ПоляТыблицыТоваров())); 			
		НовоеРаспоряжение.ХозяйственнаяОперация=Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию;
		Для каждого Товар Из НовоеРаспоряжение.Товары  Цикл
			Товар.СтатьяРасходов=Справочники.Лико_ПредопределенныеЗначения.СтатьяСписанияМатериалов.ЗначениеПараметра;
			
		КонецЦикла;
		Попытка 				
			НовоеРаспоряжение.Записать(РежимЗаписиДокумента.Проведение); 				
		Исключение
			НовоеРаспоряжение.Записать();
		КонецПопытки;
		Если  Распоряжение<>НовоеРаспоряжение.Ссылка Тогда
			//Распоряжение=НовоеРаспоряжение.Ссылка;
			//Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры 

Процедура СозатьНаборЗаписейИсторяФорм(Отказ) //+Лико m.shenderov 21.10.2017
	Если  Отказ Тогда 	
		Возврат;
	КонецЕсли;
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ВводНачальныхОстатковФорм
		Или ВидОперации=Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ПриходФорм Тогда
		Движения.Лико_ИсторияДвиженийФорм.Записывать = Истина;
		
		Для Каждого ТекСтрокаФормы Из Формы Цикл
			Движение                  = Движения.Лико_ИсторияДвиженийФорм.Добавить();  			
			Движение.Период           = Дата;
			Движение.Организация      = Организация;
			Движение.Форма            = ТекСтрокаФормы.Форма;			
			Движение.Расположение     = ТекСтрокаФормы.Конверт;
			Движение.ЗаказПокупателя  = ?( ВидОперации=Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ВводНачальныхОстатковФорм,ТекСтрокаФормы.Форма.Заказ,Null);
			Движение.Ответственный    = АвторДокумента;
		КонецЦикла;
		
	КонецЕсли;
	
	
	
КонецПроцедуры //-Лико m.shenderov 21.10.2017


Процедура СозатьНаборЗаписейПоНаработке(Отказ) //+Лико m.shenderov 21.10.2017
	Если  Отказ Тогда 	
		Возврат;
	КонецЕсли;
	Если ДанныеПоНаработке Тогда
		Движения.Лико_НаработкиОбъектовНоменклатуры.Записывать = Истина;
		
		// <-- Начало Лико Яцун С. В. 30.07.2024
		Движения.Лико_НаработкиГлубокихФорм.Записывать = Истина;
		// <-- Конец Лико Яцун С. В. 30.07.2024
		
		Для каждого Товар Из Товары  Цикл
			
			лДанныеПоНаработке = Лико_Дополнительно.ПолучитьДанныеПоНаработке(Товар.Серия.ЯССМ_ОбъектНоменклатуры, Дата-1);
			
			Движение 							= Движения.Лико_НаработкиОбъектовНоменклатуры.Добавить();
			Движение.Период 					= Дата;
			Движение.ОбъектНоменклатуры 		= Товар.Серия.ЯССМ_ОбъектНоменклатуры;
			Движение.НаработкаТекущейОперации 	= Товар.НаработкаТекущейОперации;
			Движение.ОбщаяНаработка 			= Товар.НаработкаТекущейОперации + лДанныеПоНаработке.ОбщаяНаработка;
			Движение.РабочийЦентр 				= Отправитель;
			Движение.Примечание 				= Товар.ПримечаниеПоНаработке;
			Движение.НомерСекции 				= Товар.НомерСекции; 
			
			// <-- Начало Лико Яцун С. В. 30.07.2024
			//Наработка глубоких форм
			//Форма вала на дату прихода из производства
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Лико_ВалыФормыСрезПоследних.Период КАК Период,
			|	Лико_ВалыФормыСрезПоследних.Форма КАК Форма
			|ИЗ
			|	РегистрСведений.Лико_ВалыФормы.СрезПоследних(&МоментВремени, Вал = &Вал) КАК Лико_ВалыФормыСрезПоследних
			|ГДЕ
			|	Лико_ВалыФормыСрезПоследних.Вал = &Вал";
			
			Запрос.УстановитьПараметр("Вал", Товар.Номенклатура); 
			Запрос.УстановитьПараметр("МоментВремени", Дата);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Количество() = 0 Тогда
				Продолжить;	
			КонецЕсли;
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ДатаПриходаФормы = ВыборкаДетальныеЗаписи.Период;
				ТекущаяФормаВала = ВыборкаДетальныеЗаписи.Форма;
			КонецЦикла;
			//Общая наработка Формы
			ЗапросДанныеПоНаработке = Новый Запрос;
			ЗапросДанныеПоНаработке.Текст = 
			"ВЫБРАТЬ
			|	Лико_НаработкиГлубокихФормСрезПоследних.ОбщаяНаработка КАК ОбщаяНаработка
			|ИЗ
			|	РегистрСведений.Лико_НаработкиГлубокихФорм.СрезПоследних(
			|			&МоментВремени,
			|			Вал = &Вал
			|				И Форма = &Форма
			|				И НАЧАЛОПЕРИОДА(ДатаПрихода, ДЕНЬ) = &ДатаПриходаФормы) КАК Лико_НаработкиГлубокихФормСрезПоследних";
			
			ЗапросДанныеПоНаработке.УстановитьПараметр("Вал", Товар.Номенклатура);
			ЗапросДанныеПоНаработке.УстановитьПараметр("Форма", ТекущаяФормаВала);
			ЗапросДанныеПоНаработке.УстановитьПараметр("ДатаПриходаФормы", НачалоДня(ДатаПриходаФормы));
			ЗапросДанныеПоНаработке.УстановитьПараметр("МоментВремени", Дата - 1);
			
			РезультатЗапросаДанныеПоНаработке = ЗапросДанныеПоНаработке.Выполнить(); 
			
			Если Не РезультатЗапросаДанныеПоНаработке.Пустой() Тогда
				ВыборкаЗапросаДанныеПоНаработке = РезультатЗапросаДанныеПоНаработке.Выбрать();
				ВыборкаЗапросаДанныеПоНаработке.Следующий();
				ДанныеПоНаработкеОбщаяНаработка = ВыборкаЗапросаДанныеПоНаработке.ОбщаяНаработка;
			Иначе
				ДанныеПоНаработкеОбщаяНаработка = 0;
			КонецЕсли;
			//Запись наработки глубоких форм
			ДвижениеЛико_НаработкиГлубокихФорм 							= Движения.Лико_НаработкиГлубокихФорм.Добавить();
			ДвижениеЛико_НаработкиГлубокихФорм.Период 					= Дата;
			ДвижениеЛико_НаработкиГлубокихФорм.Вал 						= Товар.Номенклатура;
			ДвижениеЛико_НаработкиГлубокихФорм.Форма 					= ТекущаяФормаВала;
			ДвижениеЛико_НаработкиГлубокихФорм.ДатаПрихода 				= ДатаПриходаФормы;
			ДвижениеЛико_НаработкиГлубокихФорм.НаработкаТекущейОперации = Товар.НаработкаТекущейОперации;
			ДвижениеЛико_НаработкиГлубокихФорм.ОбщаяНаработка 			= Товар.НаработкаТекущейОперации + ДанныеПоНаработкеОбщаяНаработка;
			// <-- Конец Лико Яцун С. В. 30.07.2024
			
		КонецЦикла;
		
		
	КонецЕсли;
	
	
	
КонецПроцедуры //-Лико m.shenderov 21.10.2017


Процедура СозатьЗаписьПоЗаявкамНаГравировкуВалов(Отказ, ОтправитьПисьмо) // <-- Начало Лико Яцун С. В. 11.03.2024
	
	Если  Отказ Тогда 	
		Возврат;
	КонецЕсли;
	
	Для Каждого Стр Из Товары Цикл
		Если Стр.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Оснастка") 
			И Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(,Стр.Номенклатура,"ОснасткаВид", Перечисления.Лико_ВидОснастки.ПустаяСсылка()) = Перечисления.Лико_ВидОснастки.Вал Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Лико_ЗаявкиНаГравировкуВалов.Вал КАК Вал,
			|	Лико_ЗаявкиНаГравировкуВалов.Форма КАК Форма,
			|	Лико_ЗаявкиНаГравировкуВалов.Количество КАК Количество,
			|	Лико_ЗаявкиНаГравировкуВалов.Регистратор КАК Регистратор
			|ПОМЕСТИТЬ ВТПоследняяЗаявка
			|ИЗ
			|	РегистрНакопления.Лико_ЗаявкиНаГравировкуВалов КАК Лико_ЗаявкиНаГравировкуВалов
			|ГДЕ
			|	Лико_ЗаявкиНаГравировкуВалов.Вал = &Вал
			|	И Лико_ЗаявкиНаГравировкуВалов.ВидДвижения = &ВидДвижения
			|
			|УПОРЯДОЧИТЬ ПО
			|	Лико_ЗаявкиНаГравировкуВалов.Период УБЫВ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Лико_ЗаявкиНаГравировкуВаловОстатки.Вал КАК Вал,
			|	Лико_ЗаявкиНаГравировкуВаловОстатки.Форма КАК Форма,
			|	Лико_ЗаявкиНаГравировкуВаловОстатки.КоличествоОстаток КАК КоличествоОстаток,
			|	ВТПоследняяЗаявка.Регистратор КАК Регистратор,
			|	ЕСТЬNULL(ВЫРАЗИТЬ(ВТПоследняяЗаявка.Регистратор КАК Документ.Лико_ЗаявкаНаГравировкуВалов).ЗаказКлиента, ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)) КАК Заказ
			|ИЗ
			|	РегистрНакопления.Лико_ЗаявкиНаГравировкуВалов.Остатки(, Вал = &Вал) КАК Лико_ЗаявкиНаГравировкуВаловОстатки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоследняяЗаявка КАК ВТПоследняяЗаявка
			|		ПО Лико_ЗаявкиНаГравировкуВаловОстатки.Вал = ВТПоследняяЗаявка.Вал
			|			И Лико_ЗаявкиНаГравировкуВаловОстатки.Форма = ВТПоследняяЗаявка.Форма";
			
			Запрос.УстановитьПараметр("Вал", Стр.Номенклатура);
			Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Приход);

			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			//Проверка есть ли уже запись Вала с этим регистратором и отправка письма, если нет записи и нет открытой заявки на действия в валом
			ЗапросПроверка = Новый Запрос;
			ЗапросПроверка.Текст = 
			"ВЫБРАТЬ
			|	Лико_ЗаявкиНаГравировкуВалов.Вал КАК Вал
			|ИЗ
			|	РегистрНакопления.Лико_ЗаявкиНаГравировкуВалов КАК Лико_ЗаявкиНаГравировкуВалов
			|ГДЕ
			|	Лико_ЗаявкиНаГравировкуВалов.Регистратор = &Регистратор
			|	И Лико_ЗаявкиНаГравировкуВалов.ВидДвижения = &ВидДвижения
			|	И Лико_ЗаявкиНаГравировкуВалов.Вал = &Вал";
			
			ЗапросПроверка.УстановитьПараметр("Вал", Стр.Номенклатура);
			ЗапросПроверка.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Расход);
			ЗапросПроверка.УстановитьПараметр("Регистратор", Ссылка);
			
			РезультатЗапросаПроверка = ЗапросПроверка.Выполнить();
			
			ВыборкаДетальныеЗаписиПроверка = РезультатЗапросаПроверка.Выбрать();
			ЗаявкаНаДействияСВаломПоЭтомуДокументуИсполнена = Ложь;
			Пока ВыборкаДетальныеЗаписиПроверка.Следующий() Цикл
				ЗаявкаНаДействияСВаломПоЭтомуДокументуИсполнена = Истина;
			КонецЦикла;
						
			Если ВыборкаДетальныеЗаписи.Количество() = 0 И НЕ ЗаявкаНаДействияСВаломПоЭтомуДокументуИсполнена Тогда
				ТекстПисьма = "Приход из переработки №" + Номер + ", вал " + Стр.Номенклатура.Артикул + " - нет заявки на действия в валом, не возможно установить связь с глубокой формой.";
				Если Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра Тогда
					Адресат = "VRomsa@okil-sato.ru;aivanova@okil-sato.ru;OlegPak@okil.ru";
				ИначеЕсли Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра Тогда
					Адресат = "vplaksin@okil-sato.ru;aivanova@okil-sato.ru;OlegPak@okil.ru";
				Иначе
					Адресат = "";
				КонецЕсли;
				Если ЗначениеЗаполнено(Адресат) И ОтправитьПисьмо Тогда
					Лико_Планирование.ОтправитьПисьмо(ТекстПисьма, ТекстПисьма, Адресат);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Движения.Лико_ЗаявкиНаГравировкуВалов.Записывать = Истина;
				Движение = Движения.Лико_ЗаявкиНаГравировкуВалов.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период = Дата;
				Движение.Вал = ВыборкаДетальныеЗаписи.Вал;
				Движение.Форма = ВыборкаДетальныеЗаписи.Форма;
				Движение.Количество = ВыборкаДетальныеЗаписи.КоличествоОстаток;
				Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Регистратор.ВидОперации) ИЛИ ВыборкаДетальныеЗаписи.Регистратор.ВидОперации = Перечисления.Лико_ВидыОперацийЗаявокНаГравировку.Гравировка Тогда
					//Запись для связи Вала с Формой
					НаборЗаписей = РегистрыСведений.Лико_ВалыФормы.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Регистратор.Установить(Ссылка);
					НаборЗаписей.Прочитать();
					ОбновитьСуществующуюЗапись = Ложь;
					Для Каждого Запись Из НаборЗаписей Цикл
						Если Запись.Вал = ВыборкаДетальныеЗаписи.Вал Тогда
							ОбновитьСуществующуюЗапись = Истина;
							Запись.Форма = ВыборкаДетальныеЗаписи.Форма; 
						КонецЕсли;
					КонецЦикла;
					Если НЕ ОбновитьСуществующуюЗапись Тогда
						НоваяЗапись = НаборЗаписей.Добавить();
						НоваяЗапись.Регистратор = Ссылка;
						НоваяЗапись.Период = Дата;
						НоваяЗапись.Вал = ВыборкаДетальныеЗаписи.Вал;
						НоваяЗапись.Форма = ВыборкаДетальныеЗаписи.Форма;
						НоваяЗапись.Заказ = ВыборкаДетальныеЗаписи.Заказ;
					КонецЕсли;
					НаборЗаписей.Записать();
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // <-- Конец Лико Яцун С. В. 11.03.2024



