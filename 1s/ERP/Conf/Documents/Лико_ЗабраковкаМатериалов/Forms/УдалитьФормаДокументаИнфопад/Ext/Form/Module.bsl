		СтруктураПараметров.Вставить("ОбязательностьВвода", Ложь);
		СтруктураПараметров.Вставить("ЗапретНулевогоРезультата", Ложь);			
		СтруктураПараметров.Вставить("НабираемыйТекст", Элементы.Материалы.ТекущиеДанные.МетражПМ);
		ОписаниеОповещения= Новый ОписаниеОповещения("УстановитьМетражПМ",ЭтаФорма);	
		ОткрытьФорму("ОбщаяФорма.ТСВиртуальнаяКлавиатураЦифровая", СтруктураПараметров,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс); 		
		//ЭтаФорма.Элементы.Материалы.ТекущийЭлемент = ЭтаФорма.Элементы.Материалы.ПодчиненныеЭлементы.МатериалыМетражПМ;
		ЭтаФорма.Элементы.Материалы.ВыделенныеСтроки.Очистить();
	КонецЕсли;
	
	Если Элемент.ТекущийЭлемент.Имя="МатериалыМетражКВМ" Тогда 			
		СтруктураПараметров = Новый Структура;	
