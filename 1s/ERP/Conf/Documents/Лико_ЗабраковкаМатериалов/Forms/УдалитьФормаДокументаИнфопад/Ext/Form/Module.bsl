#Область СтандартныеПроцедуры

Перем глПодключаемоеОборудованиеСобытиеОбработано;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//++ kit:mih web 16.07.21
	Если Параметры.Свойство("СотрудникПринявшийРешение") Тогда
		Объект.СотрудникПринявшийРешение = Параметры.СотрудникПринявшийРешение;
	КонецЕсли;
	//-- kit:mih web 16.07.21
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//++ kit:mih web 11.07.21
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Автор = ?(ЗначениеЗаполнено(ГлЛико_Оператор), ГлЛико_Оператор, ПользователиКлиент.ТекущийПользователь());
	КонецЕсли;
	
	//Подключение внешнего оборудования
	ИспользоватьПодключаемоеОборудование = Истина;
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтаФорма, "СканерШтрихкода");
	
	ЭтаФорма.Активизировать();
	
	Если НЕ ЗначениеЗаполнено(Объект.Номер) Тогда
		Записать();
		Объект.ЭтоНовыйДокумент = Истина;
	КонецЕсли;
	//-- kit:mih web 16.07.21

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	//Расчет МетражКВМ и заполнение МетражСтрокой //++ kit:mih web 16.07.21
	Объект.МетражСтрокой = "";
	Объект.МетражКВМ = 0;
	Для Каждого Строка Из Объект.Материалы Цикл
		
		Объект.МетражКВМ = Объект.МетражКВМ + Строка.МетражКВМ;
		Если Объект.МетражСтрокой = "" Тогда
			Объект.МетражСтрокой = "" + Строка.Нарезка + " - " +  Строка.МетражКВМ;
		Иначе
			Объект.МетражСтрокой = Объект.МетражСтрокой + ", " + Строка.Нарезка + " - " +  Строка.МетражКВМ;
		КонецЕсли;
		
	КонецЦикла;	
	
	//-- kit:mih web 16.07.21
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
		
	Если НЕ ЗакрытиеПоКнопке Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ПодключаемоеОборудование //++ kit:mih web 16.07.21
	СтандартнаяОбработка = Ложь;
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" Тогда
			
			МассивСтруктурДанных = МенеджерОборудованияУТКлиент.ПреобразоватьДанныеСоСканераВМассив(Параметр);
			МассивШтрихКодов = Новый Массив;
			
			//Для Каждого ЭлементМассива Из МассивСтруктурДанных Цикл
			Если МассивСтруктурДанных.Количество() > 0 Тогда
				МассивШтрихКодов.Добавить(МассивСтруктурДанных[0].Штрихкод);
			КонецЕсли;
			//КонецЦикла;
			
			ОбработатьШтрихкоды(МассивШтрихКодов);	
			
		КонецЕсли;
	КонецЕсли;
	// Конец ПодключаемоеОборудование  //-- kit:mih web 16.07.21
	
КонецПроцедуры

#КонецОбласти

#Область ОбработкиКнопок

&НаКлиенте
Процедура Вниз(Команда) //++ kit:mih web 16.07.21
	
	ИндексТекущегоЭлементаКоллекции = Объект.Материалы.Индекс(
	Элементы.Материалы.ТекущиеДанные);
	КоличествоЭлементовКоллекции = Объект.Материалы.Количество();
	Если ИндексТекущегоЭлементаКоллекции < КоличествоЭлементовКоллекции - 1 Тогда
		Элементы.Материалы.ТекущаяСтрока =
		Объект.Материалы[ИндексТекущегоЭлементаКоллекции+1].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры //-- kit:mih web 16.07.21

&НаКлиенте
Процедура Вверх(Команда) //++ kit:mih web 16.07.21
	
	ИндексТекущегоЭлементаКоллекции = Объект.Материалы.Индекс(
	Элементы.Материалы.ТекущиеДанные);
	Если ИндексТекущегоЭлементаКоллекции > 0  Тогда
		Элементы.Материалы.ТекущаяСтрока =
		Объект.Материалы[ИндексТекущегоЭлементаКоллекции-1].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры //-- kit:mih web 16.07.21

&НаКлиенте
Процедура СохранитьДокумент(Команда) //++ kit:mih web 16.07.21
	
	ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	
	Если НЕ ЗначениеЗаполнено(Объект.ЗаказКлиента) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Поле ""Заказ клиента"" не заполнено",,"ЗаказКлиента","Объект.ЗаказКлиента"); 
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Дефект) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Поле ""Дефект"" не заполнено",,"Дефект","Объект.Дефект");
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.СотрудникОбнаружившийБрак) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Поле ""Сотрудник обнаружевший брак"" не заполнено",,"СотрудникОбнаружившийБрак","Объект.СотрудникОбнаружившийБрак");
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Решение) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Поле ""Решение"" не заполнено",,"Решение","Объект.Решение");
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.СотрудникПринявшийРешение) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Поле ""Сотрудник принявший решение"" не заполнено",,"СотрудникПринявшийРешение","Объект.СотрудникПринявшийРешение");
	ИначеЕсли Объект.Материалы.Количество()=0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("В таблице ""Материалы"" нет материалов",,"Материалы","Объект.Материалы");
	Иначе
		ЗакрытиеПоКнопке = Истина;
		Оповестить("ЗакрытиеДокументаЗабраковки", Новый Структура("ЭтоНовыйДокумент, Основание", Объект.ЭтоНовыйДокумент, Объект.ДокументОснование), ЭтаФорма);
		Объект.ЭтоНовыйДокумент = Ложь;
		ЭтаФорма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры //-- kit:mih web 16.07.21

&НаКлиенте
Процедура ЗакрытьДокумент(Команда) //++ kit:mih web 16.07.21
	
	Модифицированность = Ложь;
	ЗакрытиеПоКнопке = Истина;
	
	Если Объект.ЭтоНовыйДокумент Тогда		
		//Установка пометки на удаление документа ЗабраковкаМатериалов
		УдалениеДокументаЗабраковкиНаСервере(Объект.Ссылка);
		Оповестить("УдалениеДокументаЗабраковки", Объект.ДокументОснование, ЭтаФорма);	
	КонецЕсли;
		
	ЭтаФорма.Закрыть();	 
	
КонецПроцедуры //-- kit:mih web 16.07.21

&НаСервере
Процедура УдалениеДокументаЗабраковкиНаСервере(СсылкаНаДокумент)
	
	ОбъектЗабраковки = СсылкаНаДокумент.ПолучитьОбъект();
	УстановитьПривилегированныйРежим(Истина);
	ОбъектЗабраковки.Удалить();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

