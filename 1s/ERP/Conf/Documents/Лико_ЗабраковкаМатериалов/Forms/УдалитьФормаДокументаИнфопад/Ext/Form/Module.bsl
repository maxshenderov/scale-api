&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	//Отправка сообщений //++ kit:mih web 14.07.21
	Если ЗначениеЗаполнено(Объект.Решение) И НЕ Объект.ПисьмоПоРешениюОтправлено Тогда
		Лико_ДополнительноКлиент.НачатьОтправкуСообщения(Объект.Ссылка, "ПоРешению", ПользователиКлиент.ТекущийПользователь(), ПолучитьМакетНаСервере("ФормаПисьмаДляЭлектроннойПочты"));
		Объект.ПисьмоПоРешениюОтправлено = Истина;
		Записать();
	ИначеЕсли ЗначениеЗаполнено(Объект.ТипВозвратаПоставщику) И НЕ Объект.ПисьмоКладовщикамОтправлено Тогда
		Лико_ДополнительноКлиент.НачатьОтправкуСообщения(Объект.Ссылка, "Кладовщикам", ПользователиКлиент.ТекущийПользователь(), ПолучитьМакетНаСервере("ФормаПисьмаДляЭлектроннойПочты"));
		Объект.ПисьмоКладовщикамОтправлено = Истина;
		Записать();
	КонецЕсли;
	//-- kit:mih web 14.07.21

КонецПроцедуры

