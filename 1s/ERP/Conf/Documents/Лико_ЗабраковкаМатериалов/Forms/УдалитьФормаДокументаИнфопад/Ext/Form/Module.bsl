#Область ПодключениеОборудованияИОбработкаШтрихКодов

&НаКлиенте
Процедура ОбработатьШтрихкоды(ШтрихКоды) //++ kit:mih web 16.07.21
	
	ДанныеОбъектовНоменклатур = Новый Соответствие;
	Для Каждого СтрокаДанных Из ШтрихКоды Цикл
		ДанныеОбъектовНоменклатур.Вставить(СтрокаДанных, Новый Структура);
	КонецЦикла;
	
	Лико_Дополнительно.ЗаполнениеКоллекцииОбъектовНоменклатурыПоШтрихКоду(ДанныеОбъектовНоменклатур, ШтрихКоды); 
	
	Для Каждого Запись Из ДанныеОбъектовНоменклатур Цикл
		
		Если Запись.Значение.Свойство("ОШИБКА") Тогда
			
			ОбщегоНазначенияКлиент.СообщитьПользователю("Невозможно обработать данный штрихкод");
			Прервать;
			
		КонецЕсли;
		
		Если НЕ ТипЗнч(Запись.Значение) = Тип("Структура") ИЛИ НЕ Запись.Значение.Свойство("НОМЕНКЛАТУРА") Тогда
			
			ОбщегоНазначенияКлиент.СообщитьПользователю("Невозможно обработать данный штрихкод");
			Прервать;
			
		Иначе
			
			НоваяСтрока = Объект.Материалы.Добавить();
			НоваяСтрока.Номенклатура = Запись.Значение["НОМЕНКЛАТУРА"];
			НоваяСтрока.Серия 		 = Запись.Значение["СЕРИЯ"];
			НоваяСтрока.Количество	 = Запись.Значение["КОЛИЧЕСТВО"];
			НоваяСтрока.МетражПМ     = Запись.Значение["КОЛИЧЕСТВО"];
			НоваяСтрока.МетражКВМ    = Запись.Значение["КОЛИЧЕСТВО"] * Запись.Значение["ЧИСЛИТЕЛЬ"];
			НоваяСтрока.Нарезка	     = Запись.Значение["НАРЕЗКА"];
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры //-- kit:mih web 16.07.21

