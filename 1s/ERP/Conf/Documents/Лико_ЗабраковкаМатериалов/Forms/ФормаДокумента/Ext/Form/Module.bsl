Функция ПолучитьНеобходимыеПараметрыИзРабочегоМеста()
	
	СтруктураПараметров = Новый Структура("СкладСИМ,ПомещениеСИМ");
	ЗаполнитьЗначенияСвойств(СтруктураПараметров, ПараметрыСеанса.Лико_РабочееМесто);
	Возврат СтруктураПараметров;
	
КонецФункции

&НаКлиенте
Процедура ПодборНоменклатурыЗавершение(РезультатФормы,ПараметрыФормы) Экспорт //+Лико m.shenderov 25.10.2017
	
	Если ТипЗнч(РезультатФормы)=Тип("Массив") Тогда
		Для каждого Товар Из РезультатФормы Цикл
			Если Объект.Материалы.НайтиСтроки(Новый Структура("Серия", Товар.Серия)).Количество()=0 Тогда
				Модифицированность = Истина;
				НоваяСтрока=Объект.Материалы.Добавить(); 			 
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Товар);
				НоваяСтрока.Количество = Товар.КоличествоУпаковок;
				НоваяСтрока.МетражПМ = НоваяСтрока.Количество;
				НоваяСтрока.КоэффициентПересчетаУУ = Товар.Коэффициент;
				НоваяСтрока.МетражКВМ = НоваяСтрока.Количество * НоваяСтрока.КоэффициентПересчетаУУ;
				Серия = НоваяСтрока.Серия;
				НоваяСтрока.Нарезка = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Серия.ЯССМ_ОбъектНоменклатуры.Нарезка", Серия, "Серия");   
				НоваяСтрока.Цена = ПолучитьЦену(Товар.Номенклатура, Объект.Организация, Объект.Дата);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры //-Лико m.shenderov 25.10.2017

