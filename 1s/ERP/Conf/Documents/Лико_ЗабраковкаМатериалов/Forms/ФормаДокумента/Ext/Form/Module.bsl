&НаКлиенте
Процедура МатериалыСерияПриИзменении(Элемент)
	//МатериалыСерияПриИзмененииНаСервере( );
	
	
	ТекущаяСтрока 							= 	Элементы.Материалы.ТекущиеДанные;
	ОбъектНоменклатуры						=	ПолучитьДанныеПоОбъектуНоменклатуры(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.Серия,"ЯССМ_ОбъектНоменклатуры"));	
	ТекущаяСтрока.Номенклатура 				= 	ОбъектНоменклатуры.Номенклатура;
	ТекущаяСтрока.Серия 		 			= 	ОбъектНоменклатуры.Серия;
	ТекущаяСтрока.Количество	 			= 	ОбъектНоменклатуры.Количество;
	ТекущаяСтрока.МетражПМ     				= 	ОбъектНоменклатуры.Количество;

	ТекущаяСтрока.КоэффициентПересчетаУУ 	= 	ОбъектНоменклатуры.КоэффициентПересчетаУУ;
	ТекущаяСтрока.МетражКВМ    				= 	ТекущаяСтрока.Количество * ТекущаяСтрока.КоэффициентПересчетаУУ;
	ТекущаяСтрока.Нарезка	     			= 	ОбъектНоменклатуры.Нарезка; 
	//Субботин 30.11.22
	ТекущаяСтрока.Цена 						= 	ПолучитьЦену(ОбъектНоменклатуры.Номенклатура, Объект.Организация, Объект.Дата);
	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеПоОбъектуНоменклатуры(ОбъектНоменклатуры) //+Лико m.shenderov 10.05.2023
	
	Структура = Новый Структура;
	Структура.Вставить("Номенклатура",ОбъектНоменклатуры.Номенклатура); 
	Структура.Вставить("Серия",ОбъектНоменклатуры.Серия);
	Структура.Вставить("Количество",ОбъектНоменклатуры.Количество);
	Структура.Вставить("КоэффициентПересчетаУУ",ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель);
	Структура.Вставить("Нарезка",ОбъектНоменклатуры.Нарезка);
		
	Возврат Структура;
	
КонецФункции  //-Лико m.shenderov 10.05.2023



&НаСервере
Процедура МатериалыСерияПриИзмененииНаСервере()
	
	ТекущаяСтрока = Элементы.Материалы.ТекущиеДанные;
	ТекущаяСтрока.КоэффициентПересчетаУУ = ТекущаяСтрока.Серия.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель;
	ТекущаяСтрока.МетражКВМ = ТекущаяСтрока.Количество * ТекущаяСтрока.КоэффициентПересчетаУУ;
	Элементы.Материалы.ТекущиеДанные.Номенклатура = ТекущаяСтрока.Серия.ЯССМ_ОбъектНоменклатуры.Номенклатура;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыМетражПМПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Материалы.ТекущиеДанные;
	ТекущаяСтрока.Количество = ТекущаяСтрока.МетражПМ;
	ТекущаяСтрока.МетражКВМ = ТекущаяСтрока.Количество * ТекущаяСтрока.КоэффициентПересчетаУУ;
	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыМетражКВМПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Материалы.ТекущиеДанные;
	Если ТекущаяСтрока.КоэффициентПересчетаУУ <> 0 Тогда
		ТекущаяСтрока.Количество = ТекущаяСтрока.МетражКВМ / ТекущаяСтрока.КоэффициентПересчетаУУ;
		ТекущаяСтрока.МетражПМ = ТекущаяСтрока.Количество;
	Иначе
		Сообщить("Для текущей строки не заполнен коэффициент пересчета УУ. Проверьте, заполнена ли серия. Если серия заполнена, то обратитесь к программистам");
		ТекущаяСтрока.Количество = 0;
		ТекущаяСтрока.МетражПМ = 0;
	КонецЕсли;
	
КонецПроцедуры

