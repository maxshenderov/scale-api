&НаКлиенте
Процедура УстановкаВидимостиРеквизитов()  //++ kit:mih web 16.07.21
	
	Доступ =  ПроверкаРолей();
	
	Элементы.МестоРезкиМатериала.Доступность = Доступ;
	Элементы.Поставщик.Доступность = Доступ;
	Элементы.Акт.Доступность = Доступ;
	Элементы.СтатусПретензии.Доступность = Доступ;
	Элементы.ДатаВыставленияПретензии.Доступность = Доступ;
	Элементы.ДатаОжиданияОтвета.Доступность = Доступ;
	Элементы.Ответ.Доступность = Доступ;
	Элементы.ТипВозвратаПоставщику.Доступность = Доступ;
	Элементы.СуммаБрака.Доступность = Доступ;
	Элементы.Валюта.Доступность = Доступ;
	Элементы.ОкончательноеРешение.Доступность = Доступ;
	Элементы.ДатаВыполнения.Доступность = Доступ;
	Если ЗначениеЗаполнено(Объект.РабочийЦентр) Тогда
		Элементы.РабочийЦентр.Доступность = Истина;
		Элементы.МестоОбнаружения.Доступность = Ложь;
	ИначеЕсли ЗначениеЗаполнено(Объект.МестоОбнаружения) Тогда
		Элементы.РабочийЦентр.Доступность = Ложь;
		Элементы.МестоОбнаружения.Доступность = Истина;
	Иначе
		Элементы.РабочийЦентр.Доступность = Истина;
		Элементы.МестоОбнаружения.Доступность = Истина;
		Элементы.РабочийЦентр.АвтоОтметкаНезаполненного = Истина;
		Элементы.МестоОбнаружения.АвтоОтметкаНезаполненного = Истина;
	КонецЕсли;
	
КонецПроцедуры  //-- kit:mih web 16.07.21

