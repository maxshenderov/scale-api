#Область ПодключениеОборудованиеИОбработкаШтрихКодов
&НаКлиенте
Процедура ОбработатьШтрихкоды(ДанныеШтрихкода)
	
	Результат = Лико_ДополнительноКлиент.ОбработатьШтрихКодНеТовара(ДанныеШтрихкода.Штрихкод);
	Если Результат.Ошибка <> "" Тогда
		Сообщить(Результат.Ошибка);
	Иначе
		Если Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Сотрудника") Тогда
			Объект.СотрудникОбнаружившийБрак = Результат.Сотрудник;
		ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры_Короткий") Или 
			Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры") Тогда
			Если ЗначениеЗаполнено(Результат.ОбъектНоменклатуры) Тогда
				ОбработатьШКОбъектаНоменклатуры(Результат.ОбъектНоменклатуры);
			Иначе
				Сообщить("Объект номенклатуры не найден");
			КонецЕсли;
		ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ЗаказаСпецификации") ИЛИ Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Заказа") Тогда
			Объект.ЗаказКлиента = Лико_Дополнительно.НайтиДокументПоНомеру7Символов(Результат.НомерЗаказа, "ЗаказКлиента");
		ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_РабочегоЦентра") Тогда
			Объект.РабочийЦентр = Результат.РабочийЦентр;
		Иначе
			Сообщить("Штрихкод вида """ + Результат.ВидШК + """ не поддерживается в данном документе");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьШКОбъектаНоменклатуры(ОбъектНоменклатуры)
	
	Если Объект.Материалы.НайтиСтроки(Новый Структура("Серия", ОбъектНоменклатуры.Серия)).Количество() = 0 Тогда // --> Начало Лико Ефимов ЕВВ 27.10.2021 
		НоваяСтрока = Объект.Материалы.Добавить();
		Модифицированность = Истина;
		НоваяСтрока.Номенклатура = ОбъектНоменклатуры.Номенклатура;
		НоваяСтрока.Серия 		 = ОбъектНоменклатуры.Серия;
		НоваяСтрока.Количество	 = ОбъектНоменклатуры.Количество;
		НоваяСтрока.МетражПМ     = НоваяСтрока.Количество;
		НоваяСтрока.КоэффициентПересчетаУУ = ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель;
		НоваяСтрока.МетражКВМ    = НоваяСтрока.Количество * НоваяСтрока.КоэффициентПересчетаУУ;
		НоваяСтрока.Нарезка	     = ОбъектНоменклатуры.Нарезка; 
		//Субботин 30.11.22
		НоваяСтрока.Цена 		 = ПолучитьЦену(ОбъектНоменклатуры.Номенклатура, Объект.Организация, Объект.Дата);
		//Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаМатериалы;
	КонецЕсли;
	
КонецПроцедуры


          
