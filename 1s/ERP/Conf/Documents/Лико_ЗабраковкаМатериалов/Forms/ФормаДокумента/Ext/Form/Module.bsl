#Область СтандартныеПроцедуры

Перем глПодключаемоеОборудованиеСобытиеОбработано;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект); 
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
		
	//++ kit:mih web 16.07.21
	Если Параметры.Свойство("СотрудникПринявшийРешение") Тогда
		Объект.СотрудникПринявшийРешение = Параметры.СотрудникПринявшийРешение;
	КонецЕсли;
	//-- kit:mih web 16.07.21
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьСвязанныеДанныеНаСервере();
		Объект.Автор = ПараметрыСеанса.ТекущийПользователь;
		Если НЕ ЗначениеЗаполнено(Объект.Организация) И Объект.Автор.Лико_Площадки.Количество() > 0 Тогда
			Объект.Организация = Объект.Автор.Лико_Площадки[0].Организация;
		КонецЕсли;
		ЭтоНовыйДокумент = Истина;
		Объект.Дата = ТекущаяДата();
		Записать();
	КонецЕсли;
	
	////+AttachFiles
	
	payload = Новый Структура;
	payload.Вставить("DocName","Лико_ЗабраковкаМатериалов");
	payload.Вставить("DocNumber",Объект.Номер);
	payload.Вставить("DocDate",Объект.Дата); 	
	
	Структура = Новый Структура;
	Структура.Вставить( "action","attach-files");
	Структура.Вставить( "payload",payload);
	Структура.Вставить("ttl",30); 	
	
	Json    = WebSocketСервер.СтруктураВJSON(Структура); 		
	Settings= WebSocketСервер.SettingsTest();
	Token   = WebSocketСервер.ПолучитьToken(Settings);  
	
	ssl      = Новый ЗащищенноеСоединениеOpenSSL();
	
	Массив = Новый Массив();
	Массив.Добавить(Новый Структура("Authorization", СтрШаблон("Bearer %1",Token)));
	
	HttpRespons     = WebSocketСервер.HttpRequest(Settings.domain,Settings.ApiEndPoint_AttachFiles,Json,ssl,,Массив);
	ОтветПотокаJSON = WebSocketСервер.ПолучитьОтветJSON(HttpRespons);		
	
	Если ОтветПотокаJSON.Свойство("uuid") Тогда 
		uuid_=ОтветПотокаJSON.uuid;
		 КодРабочегоМеста=WebSocketСервер.ПолучитьКодРабочегоМеста();

		Урл=WebSocketСервер.url(WebSocketСервер.settingsTest(),Новый Структура("ext,subject",uuid_,КодРабочегоМеста));  	
	КонецЕсли;
	
	url=Урл;
	// Подсистема WebSocket
	ПоказыватьQRCode=Ложь; 
	

	WebSocketСервер.ИнициализацияNew(ЭтаФорма,ПоказыватьQRCode,,WebSocketСервер.SettingsTest(),url);
	// Подсистема WebSocket
	
	
	
	////-AttachFiles
	

	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЭтоНовыйДокумент И ЗначениеЗаполнено(ГлЛико_Оператор) И ГлЛико_Оператор <> Объект.Автор Тогда
		Объект.Автор = ГлЛико_Оператор;
	КонецЕсли;
	
	//++ kit:mih web 11.07.21
	УстановкаВидимостиРеквизитов();
	
	//Подключение внешнего оборудования
	ИспользоватьПодключаемоеОборудование = Истина;
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтаФорма, "СканерШтрихкода");
	//-- kit:mih web 11.07.21
	
	ПодключитьОбработчикОжидания("ИзменитьШиринуQR", 2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьШиринуQR()
	
	ЭлементWebSocketURL = Элементы.Найти("WebSocketURL");
	Если ЭлементWebSocketURL <> Неопределено Тогда
		ЭлементWebSocketURL.Ширина = 19;
	КонецЕсли;
	
КонецПроцедуры



&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	//Расчет МетражКВМ и заполнение МетражСтрокой ++ kit:mih web 11.07.21
	Объект.МетражСтрокой = "";
	Объект.МетражКВМ = 0;
	Для Каждого Строка Из Объект.Материалы Цикл
		
		Объект.МетражКВМ = Объект.МетражКВМ + Строка.МетражКВМ;
		Если Объект.МетражСтрокой = "" Тогда
			Объект.МетражСтрокой = "" + Строка.Нарезка + " - " +  Строка.МетражКВМ;
		Иначе
			Объект.МетражСтрокой = Объект.МетражСтрокой + ", " + Строка.Нарезка + " - " +  Строка.МетражКВМ;
		КонецЕсли;
		
	КонецЦикла;	
	//-- kit:mih web 16.07.21
	
КонецПроцедуры

