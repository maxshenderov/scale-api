// Функция НайтиСоздать (адаптр)
//
/// Описание: Поиск или создание документа Лико_КартаПерерасхода 
//
// Параметры: 
// Данные 		   - Произвольный          	    - (обязательный).  П 
//
// Возвращаемое значение:
//  Документ.Лико_КаратаПерерасхода.Ссылка
//
Функция НайтиСоздать(Данные) Экспорт  //+Лико m.shenderov 01.07.2025
	
	Параметры = Неопределено;
	
	ПараметрыПоСтруктуре(Данные, Параметры);
	ПараметрыПоJSON(Данные, Параметры);	
	
	Если Параметры=Неопределено Тогда
		
		Ошибка = "Некорректный формат параметра ""Данные"" в функции Документы.Лико_КартаПерерасхода.НайтиСоздать(Данные).";		
		ВызватьИсключение(Ошибка);
		
	КонецЕсли;
	
	КартаПерерасхода = ДокументПоПараметрам(Параметры.Заказ,Параметры.НомерБланка,Параметры.НомерПроката,Параметры.СтатусЗаказаПерерасхода,Параметры.Оператор); 
	Если КартаПерерасхода =Неопределено Тогда
		
		ДокОбъект = СоздатьДокумент(); 
		ДокОбъект.Заполнить(Параметры);
		Если Не ДокОбъект.ПроверитьЗаполнение() Тогда
			ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Не удалось создать карту перерасхода по заказу :%1
			|%2'"),
			Параметры.Заказ,
			СтрСоединить(ПолучитьСообщенияПользователю(), Символы.ПС)
			); 
		КонецЕсли;
	КонецЕсли; 
		
		
	
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КартаПерерасхода = ДокОбъект.Ссылка; 
		
	
	
	
	Возврат КартаПерерасхода;
	
КонецФункции //НайтиДокумент -Лико m.shenderov 01.07.2025

Функция ДокументПоПараметрам(Заказ,НомерБланка,НомерПроката,СтатусЗаказаПерерасхода,Оператор) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_КартаПерерасхода.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Лико_КартаПерерасхода КАК Лико_КартаПерерасхода
		|ГДЕ
		|	Лико_КартаПерерасхода.Заказ = &Заказ
		|	И Лико_КартаПерерасхода.НомерПроката = &НомерПроката
		|	И Лико_КартаПерерасхода.НомерБланка = &НомерБланка
		|	И Лико_КартаПерерасхода.Статус = &Статус
		|	И НЕ Лико_КартаПерерасхода.ПометкаУдаления
		|	И Лико_КартаПерерасхода.Оператор = &Оператор";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);
	Запрос.УстановитьПараметр("НомерБланка", НомерБланка);
	Запрос.УстановитьПараметр("Статус", СтатусЗаказаПерерасхода);
	Запрос.УстановитьПараметр("Оператор", Оператор);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ЕстьКартаСТакимиПараметрами(Объект) Экспорт 

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_КартаПерерасхода.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Лико_КартаПерерасхода КАК Лико_КартаПерерасхода
		|ГДЕ
		|	Лико_КартаПерерасхода.Заказ = &Заказ
		|	И Лико_КартаПерерасхода.НомерПроката = &НомерПроката
		|	И Лико_КартаПерерасхода.НомерБланка = &НомерБланка
		|	И Лико_КартаПерерасхода.Статус = &Статус
		|	И Лико_КартаПерерасхода.Оператор = &Оператор
		|	И НЕ Лико_КартаПерерасхода.ПометкаУдаления
		|	И Лико_КартаПерерасхода.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Заказ", Объект.Заказ);
	Запрос.УстановитьПараметр("НомерБланка", Объект.НомерБланка);
	Запрос.УстановитьПараметр("НомерПроката", Объект.НомерПроката);
	Запрос.УстановитьПараметр("Оператор", Объект.Оператор);
	Запрос.УстановитьПараметр("Статус", Объект.Статус);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Карта = Новый Структура("Номер,Дата",ВыборкаДетальныеЗаписи.Ссылка.Номер,Формат(ВыборкаДетальныеЗаписи.Ссылка.Дата,"ДФ=dd.MM.yyyy"));
		Возврат Карта;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции 

