Функция КартыПерерасходаПоРабочемуЦентру(РабочийЦентр) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лико_КартаПерерасхода.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лико_КартаПерерасхода КАК Лико_КартаПерерасхода
	|ГДЕ
	|	Лико_КартаПерерасхода.РабочийЦентр = &РабочийЦентр
	|	И Лико_КартаПерерасхода.Проведен
	|	И НЕ Лико_КартаПерерасхода.ПометкаУдаления";
	Запрос.УстановитьПараметр("РабочийЦентр",РабочийЦентр );
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"); 	
	
	

КонецФункции // КартыПерерасходаПоРабочемуЦентру()

Функция КартаПерерасходаВСтруктуру(Карта, Реквизиты = Неопределено, РеквизитыТолькоПросмотр = Неопределено, РеквизитыПроверкаЗаполнения = Неопределено) Экспорт 
	
	Результат = Новый Массив;

	
	Если (ЗначениеЗаполнено(Реквизиты) 
		И ТипЗнч(Реквизиты)=Тип("Массив") 
		И Реквизиты.Найти("Номер")<>Неопределено) 
		Или (Не ЗначениеЗаполнено(Реквизиты))  Тогда
		
		
				Структура = Новый Структура;
		Структура.Вставить("name","Номер");
		Структура.Вставить("synonym","Номер");
		Структура.Вставить("readOnly",Истина);
		Структура.Вставить("validationCheck",Истина);
		Структура.Вставить("value",Карта.Номер);
		Результат.Добавить(Структура);
		
		Структура = Новый Структура;
		Структура.Вставить("name","Дата");
		Структура.Вставить("synonym","Дата");
		Структура.Вставить("readOnly",Истина);
		Структура.Вставить("validationCheck",Истина);
		Структура.Вставить("value",Карта.Дата);
		Результат.Добавить(Структура);
		
	КонецЕсли;
	
	
	
	//Карта = Документы.Лико_КартаПерерасхода.СоздатьДокумент();
	Для каждого Реквизит Из Метаданные.Документы.Лико_КартаПерерасхода.Реквизиты  Цикл
		
		лТолькоПросмотр = Ложь;
		лПроверкаЗаполнения = Ложь;
		
		Если ЗначениеЗаполнено(Реквизиты) 
			И ТипЗнч(Реквизиты)=Тип("Массив") 
			И Реквизиты.Найти(Реквизит.Имя)=Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РеквизитыТолькоПросмотр) 
			И ТипЗнч(РеквизитыТолькоПросмотр)=Тип("Массив") 
			И РеквизитыТолькоПросмотр.Найти(Реквизит.Имя)<>Неопределено Тогда
			
			лТолькоПросмотр = Истина;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РеквизитыПроверкаЗаполнения) 
			И ТипЗнч(РеквизитыПроверкаЗаполнения)=Тип("Массив") 
			И РеквизитыПроверкаЗаполнения.Найти(Реквизит.Имя)<>Неопределено Тогда
			
			лПроверкаЗаполнения = Истина;
			
		КонецЕсли;
		
		
		
		Структура = Новый Структура;
		Структура.Вставить("name",Реквизит.Имя);
		Структура.Вставить("synonym",Реквизит.Синоним);
		Структура.Вставить("readOnly",лТолькоПросмотр);
		Структура.Вставить("validationCheck",лПроверкаЗаполнения);
	    ЗначениеРеквизита =  Карта[Реквизит.Имя];	
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Карта[Реквизит.Имя])) Тогда
		ЗначениеРеквизита =  Строка(Карта[Реквизит.Имя]);	
			
		Если ТипЗнч(Карта[Реквизит.Имя])=Тип("ДокументСсылка.ЗаказКлиента") Тогда
			
			ДатаЗаказаСтруктура = Новый Структура;
		ДатаЗаказаСтруктура.Вставить("name","ЗаказДата");
		ДатаЗаказаСтруктура.Вставить("synonym","Дата");
		ДатаЗаказаСтруктура.Вставить("readOnly",Истина);
		ДатаЗаказаСтруктура.Вставить("validationCheck",Истина);
		ДатаЗаказаСтруктура.Вставить("value",Карта[Реквизит.Имя].Дата);
		
		Результат.Добавить(ДатаЗаказаСтруктура);
		  
			ЗначениеРеквизита =Карта[Реквизит.Имя].Номер;
		КонецЕсли;
		
		
		Если ТипЗнч(Карта[Реквизит.Имя])=Тип("ПеречислениеСсылка.ТССтатусыЗаказов") Тогда 
			МассивЗначений =Новый массив;
			МассивЗначений.Добавить("Настройка");
			МассивЗначений.Добавить("Печать");
			Структура.Вставить("possibleValues",МассивЗначений);
			
		КонецЕсли;
	КонецЕсли;
		Структура.Вставить("value",ЗначениеРеквизита);

		
		Результат.Добавить(Структура);
		
	КонецЦикла;
	
	
	Возврат Результат;
	
КонецФункции

Функция КартыПерерасходаВМассив(МассивКарт, Реквизиты = Неопределено, РеквизитыТолькоПросмотр = Неопределено, РеквизитыПроверкаЗаполнения = Неопределено) Экспорт 
	
	Результат = Новый Массив;
	//Карта = Документы.Лико_КартаПерерасхода.СоздатьДокумент();
	Для каждого Карта Из МассивКарт  Цикл
		
		СтруктураКрты = КартаПерерасходаВСтруктуру(Карта, Реквизиты, РеквизитыТолькоПросмотр, РеквизитыПроверкаЗаполнения);	
		Результат.Добавить(СтруктураКрты); 
		
	КонецЦикла;
	
	
	Возврат Результат;
	
КонецФункции 




