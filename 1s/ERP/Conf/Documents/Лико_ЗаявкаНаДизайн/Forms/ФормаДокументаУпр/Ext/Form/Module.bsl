Процедура ТоварыНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если РедактированиеСтрокиСпецификации Тогда
		  РедактированиеСтрокиСпецификации=Ложь;
		  Возврат;
		
	КонецЕсли;
	  
	СтандартнаяОбработка = Ложь;
	
	Спецификация=Элементы.Товары.ТекущиеДанные.Спецификация;
	СЗ = Новый СписокЗначений;
	
	Элемент.СписокВыбора.ЗагрузитьЗначения(ПолучитьСписокНоменклатуры(Спецификация));
	//ОписаниеОповещение=Новый ОписаниеОповещения("ТоварыНоменклатураНачалоВыбораЗавершение",ЭтаФорма);
	//ПоказатьВыборИзСписка(ОписаниеОповещение,СписокНоменклатуры,Элемент);
	
	
КонецПроцедуры

Функция ПолучитьСписокНоменклатуры(Спецификация) //+Лико m.shenderov 03/11/2019
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Лико_СпецификацииТовары.Номенклатура
	|ИЗ
	|	Справочник.Лико_Спецификации.Товары КАК Лико_СпецификацииТовары
	|ГДЕ
	|	Лико_СпецификацииТовары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",?(ЗначениеЗаполнено(Спецификация),Спецификация,Объект.ЗаказКлиента ));
	СЗ = Новый СписокЗначений;
	
	//Сз.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура"));
	СЗ=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
	Возврат СЗ;
	
	
КонецФункции //-Лико m.shenderov 03/11/2019 

