Процедура ЗаполнитьТаблицуТоварыДополнительнымиПолями() //+Лико m.shenderov 03/11/2019
	
	Для каждого Товар Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(Товар.Спецификация) Тогда 
			ПараметрыШтампа = ПолучитьПараметрыШтампа(Товар.Спецификация, Товар.НомерВарианта);	
		    Товар.ОсновнойМатериал		=Товар.Спецификация.ОсновнойМатериал;
			Товар.АртикулШтампа			=?(ЗначениеЗаполнено(ПараметрыШтампа.ШтампВырубной),ПараметрыШтампа.ШтампВырубной.Артикул,Неопределено); 
			Если НЕ ЗначениеЗаполнено(Товар.НомерВарианта) Тогда
				Товар.НомерВарианта = 1;
			КонецЕсли;
		Иначе
			ПараметрыШтампа				=Объект.ЗаказКлиента;
			Товар.ОсновнойМатериал		=ПараметрыШтампа.ОсновнойМатериал;
			Товар.АртикулШтампа			=ПараметрыШтампа.ШтампВырубной.Артикул;
		КонецЕсли;
		Товар.ШтампВырубной			=ПараметрыШтампа.ШтампВырубной;
		Товар.ЭтикетокНаЛисте		=ПараметрыШтампа.ЭтикетокНаЛисте;	
		Товар.ШиринаРулона			=ПараметрыШтампа.Нарезка;
		Товар.Ручьи					=ПараметрыШтампа.Ручьи;
		Товар.Z						=ПараметрыШтампа.Z;
		// --> Начало Лико Митюшин МФМ 14.04.2021
		Товар.РучьиПечати			= ПараметрыШтампа.РучьиПечати;
		Товар.ЭтикетокНаЛистеПечати	= ПараметрыШтампа.ЭтикетокНаЛистеПечати;
		// <-- Конец Лико Митюшин МФМ 14.04.2021
	
	КонецЦикла;	
	
КонецПроцедуры //-Лико m.shenderov 03/11/2019


&НаСервереБезКонтекста
Функция ПолучитьПараметрыШтампа(Спецификация, НомерВарианта) //+Лико m.shenderov 15/12/2019
	Структура = Новый Структура;
	Структура.Вставить("ШтампВырубной");
	Структура.Вставить("ЭтикетокНаЛисте");
	Структура.Вставить("Нарезка");
	Структура.Вставить("Ручьи");
	Структура.Вставить("Z");
	// --> Начало Лико Митюшин МФМ 14.04.2021
	Структура.Вставить("РучьиПечати");
	Структура.Вставить("ЭтикетокНаЛистеПечати");
	// <-- Конец Лико Митюшин МФМ 14.04.2021
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лико_Спецификации.ШтампВырубной КАК ШтампВырубной,
	|	Лико_Спецификации.ЭтикетокНаЛисте КАК ЭтикетокНаЛисте,
	|	Лико_Спецификации.Нарезка КАК Нарезка,
	|	Лико_Спецификации.Ручьи КАК Ручьи,
	|	Лико_Спецификации.Z КАК Z,
	|	Лико_Спецификации.РучьиПечати КАК РучьиПечати,
	|	Лико_Спецификации.ЭтикетокНаЛистеПечати КАК ЭтикетокНаЛистеПечати
	|ИЗ
	|	Справочник.Лико_Спецификации КАК Лико_Спецификации
	|ГДЕ
	|	Лико_Спецификации.Ссылка = &Спецификация";
	Запрос.УстановитьПараметр("Спецификация",Спецификация );
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл		
		ЗаполнитьЗначенияСвойств(Структура,Выборка);
	КонецЦикла; 
	
	Возврат Структура;
	
КонецФункции  //-Лико m.shenderov 15/12/2019




