	Если ВыбранныйЭлемент <> Неопределено Тогда    
		типЭтикетки = ВыбранныйЭлемент.Значение;
		Номенклатура = СоздатьНоменклатуруНаСервере(ДопПараметры.Текст, типэтикетки);
		ДопПараметры.ТекущиеДанные.Номенклатура = Номенклатура;
	КонецЕсли; 		
	
КонецПроцедуры

