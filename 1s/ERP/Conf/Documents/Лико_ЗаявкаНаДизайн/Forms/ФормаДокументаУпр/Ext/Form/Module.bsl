&НаКлиенте
Процедура РедактированиеСпецификацииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ТекСтрока=Элементы.Товары.ТекущиеДанные;
		СтрСпецификация=ТекСтрока.Спецификация;
		НоменклатураПоспецификации=НоменклатураПоСпецификацииСервер(СтрСпецификация);
		н=1;
		Для каждого СтрНоменклатура Из НоменклатураПоспецификации Цикл
			Если н=1  Тогда
				н=2;
				
				ТекСтрока.Номенклатура=СтрНоменклатура;
			Иначе
				НоваяСтрока=Объект.Товары.Добавить();
				НоваяСтрока.Спецификация=СтрСпецификация;
				НоваяСтрока.Номенклатура=СтрНоменклатура;
			КонецЕсли;				
		КонецЦикла;		
	ЗаполнитьТаблицуТоварыДополнительнымиПолями();
	
	КонецЕсли; 
	
КонецПроцедуры


