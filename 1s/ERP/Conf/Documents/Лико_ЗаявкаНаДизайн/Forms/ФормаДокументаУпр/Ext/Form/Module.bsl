Процедура УстановитьДоступностьВидимостьЭлементовФормы()
	
	Если Не Документы.Лико_ЗаявкаНаДизайн.ЕстьГруппаДоступа("лк Бригадир",ПараметрыСеанса.ТекущийПользователь) Тогда
		
		Элементы.ДатаФактическогоЗакрытия.Видимость = Ложь;
		
		Если Объект.СтатусЗаявки=Перечисления.Лико_СтатусыЗаявкиНаДизайн.Закрыта Тогда
			ЭтаФорма.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //УстановитьДоступностьВидимостьЭлементовФормы

Процедура СформироватьПодменюФорматаДляСкрипта()
	Для каждого Эл Из  Элементы.ФорматДляСкрипта.ПодчиненныеЭлементы Цикл
		ИмяКоманды=Эл.Имя;
		Элементы.Удалить(Эл);
		Если Команды.Найти(ИмяКоманды)<>Неопределено Тогда
			Команды.Удалить(Команды.Найти(ИмяКоманды));
		КонецЕсли;
		
		
	КонецЦикла;
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		
		ПроверитьСоздатьПодменюФорматаДляСкрипта(СтрокаТовары.НомерСтроки);
		
	КонецЦикла;
	
	
	
	
	
КонецПроцедуры //СформироватьПодменюФорматаДляСкрипта

Процедура ПроверитьСоздатьПодменюФорматаДляСкрипта(НомерСтроки)
	
	ПрефиксИмени = "ФорматДляСкрипта";
	ИмяКнопки=ПрефиксИмени+НомерСтроки;
	
	Если Элементы.Найти(ИмяКнопки)=Неопределено Тогда
		
		// добавим саму кнопку монтажа
		
		КомандаФормы  = Команды.Добавить(ИмяКнопки);
		КомандаФормы.Действие = "ПодменюФорматДляСкриптаНажатие";
		Элементы.Добавить(ИмяКнопки,Тип("КнопкаФормы"), Элементы.ФорматДляСкрипта); 
		Элементы[ИмяКнопки].Заголовок = Строка(НомерСтроки)+Объект.Товары[НомерСтроки-1].Номенклатура;
		Элементы[ИмяКнопки].ИмяКоманды = ИмяКнопки;
		
		///Элементы.Переместить(Элементы[ИмяКнопки],ЭтаФорма.КоманднаяПанель,Элементы.ФорматДляСкрипта); 
	КонецЕсли;
	
КонецПроцедуры //ПроверитьСоздатьПодменюФорматаДляСкрипта

&НаКлиенте
Процедура ПодменюФорматДляСкриптаНажатие(Элемент)
	ПозицияПробела = СтрЗаменить(Элемент.Имя,"ФорматДляСкрипта","");
	НомерСтроки = Число(ПозицияПробела);
	Если НомерСтроки=0 Тогда
		Возврат;
	КонецЕсли;
	
	ВыводФорматаДляСкрипта(НомерСтроки);
	
КонецПроцедуры


&НаКлиенте
Процедура ВыводФорматаДляСкрипта(НомерСтроки)
	
	Отказ = Ложь;
	
	ТекущаяСтрока = Объект.Товары[НомерСтроки-1]; 
	
	ТекстСкрипта = СформироватьТекстДляСкриптаДизайн(Объект.Ссылка,ТекущаяСтрока.Номенклатура,НомерСтроки,ТекущаяСтрока.Спецификация,ТекущаяСтрока.НомерВарианта,Отказ);
	
	Если Отказ Тогда
		Сообщить("Не удалось сформировать формат для скрипта!",СтатусСообщения.Информация);
	Иначе
		ТекстДок = Новый ТекстовыйДокумент;
		ТекстДок.ДобавитьСтроку(ТекстСкрипта);
		
		ТекстДок.Показать();
	КонецЕсли;
	
КонецПроцедуры //ВыводФорматаДляСкрипта


Функция СформироватьТекстДляСкриптаДизайн(Ссылка,Номенклатура,НомерСтроки,Спецификация,НомерВарианта,Отказ) //+Лико m.shenderov 04/11/2019
		Возврат Документы.Лико_ЗаявкаНаДизайн.СформироватьТекстДляСкриптаДизайн(Ссылка,Номенклатура,НомерСтроки,Спецификация,НомерВарианта,Отказ)
КонецФункции //-Лико m.shenderov 04/11/2019 


