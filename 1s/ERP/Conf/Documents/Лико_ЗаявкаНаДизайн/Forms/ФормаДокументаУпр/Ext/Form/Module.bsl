&НаКлиенте
Процедура ТоварыНоменклатураСоздание(Элемент, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Сообщить("Сначала необходимо записать заявку!");
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	индексстроки =  ТекущиеДанные.НомерСтроки - 1;
	Наименование = Элемент.ТекстРедактирования;
	Список = Новый СписокЗначений;
	Список.Добавить(ПредопределенноеЗначение("Перечисление.Лико_ТипыЭтикеток.ЭТ"));
	Список.Добавить(ПредопределенноеЗначение("Перечисление.Лико_ТипыЭтикеток.КЭ"));
	Список.Добавить(ПредопределенноеЗначение("Перечисление.Лико_ТипыЭтикеток.Кльр"));
	ДопПараметры = Новый Структура("ТекущиеДанные, Элемент, Текст", ТекущиеДанные, Элемент, Наименование); 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораТипаЭтикетки", ЭтотОбъект, ДопПараметры);
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Выберите тип создаваемого товара (эт, контр или колье)";
	Сообщение.Сообщить();
	ПоказатьВыборИзСписка(ОписаниеОповещения, Список );
	
КонецПроцедуры

