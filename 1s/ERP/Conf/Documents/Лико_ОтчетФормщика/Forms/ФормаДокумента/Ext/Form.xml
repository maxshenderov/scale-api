			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	Лико_СвязиСТиповымиДокументами.ТиповойДокумент,
	Лико_СвязиСТиповымиДокументами.Комментарий,
