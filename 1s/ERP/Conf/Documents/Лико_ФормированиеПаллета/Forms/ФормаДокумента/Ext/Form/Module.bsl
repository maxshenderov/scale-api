&НаСервере
Процедура ИзменитьРаспоряжениеНаРастаркуВоВсехСтрокахНаСервере(ДопПараметры)
	
	Если Объект.Содержимое.Количество() > 0 И РольДоступна("ПолныеПрава") Тогда
		НачатьТранзакцию();
		Для каждого Строка из Объект.Содержимое Цикл
			СерияОбъект = Строка.Серия.ПолучитьОбъект();
			ЗаполнитьЗначенияСвойств(СерияОбъект, ДопПараметры);
			Попытка
				СерияОбъект.Записать();
				Сообщить("Записана серия """ + Строка.Серия + """");
			Исключение
				Сообщить("Не удалось записать серию """ + Строка.Серия + """");
				ОтменитьТранзакцию();
				ВызватьИсключение;
			КонецПопытки;
		КонецЦикла;
		Сообщить("Обработка завершена");
		ЗафиксироватьТранзакцию();	
	КонецЕсли;
	
КонецПроцедуры

