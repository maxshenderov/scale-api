&НаСервере
Процедура ЗаполнитьПризнакВыпускаИзРастарки()
	
	Если ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата()) > Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияНовойСхемыРастаркиВерсия3.ЗначениеПараметра И НЕ Объект.РастаркаПоСтаройСхемеВерсии2 Тогда
		
		// Заполним признак выпуска из растарки. В данном месте условно: если есть хотя бы одна коробка с распоряжением на растарку, то истина. В дальнейшем перед записью в модуле объекта будет еще один механизм заполнения
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СерииНоменклатуры.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
			|ГДЕ
			|	СерииНоменклатуры.Ссылка В(&МассивСерий)
			|	И СерииНоменклатуры.Лико_РаспоряжениеНаРастарку <> ЗНАЧЕНИЕ(Документ.Лико_ПеремещениеПаллета.ПустаяСсылка)";
		
		Запрос.УстановитьПараметр("МассивСерий", Объект.Содержимое.Выгрузить().ВыгрузитьКолонку("Серия"));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Объект.ВыпускИзРастарки = НЕ РезультатЗапроса.Пустой();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветилиНаВопросОПоследнемВыпуске(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	Иначе
		ДанОтветНаВопрос = Истина;
		Объект.ЭтоПоследнийВыпускПоРастарке = Ответ = КодВозвратаДиалога.Да;
		Записать(ДопПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветилиНаВопросОПроверкеКоличестваВыпуска(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если Объект.Площадка = ПредопределенноеЗначение("Справочник.Лико_Площадки.Ликофлекс") Тогда
			СформироватьИОтправитьПисьмоОПроверкеКоличестваВыпуска(Ложь);
			
			ДопПараметры.Вставить("ИмяПроцедурыПриУспешномПодтверждении", "ЗаписатьДокументПослеУспешногоПодтвержденияПропуском(ДопПараметры)");
			ДопПараметры.Вставить("Должности", "ДолжностьНачальникСменыУПО");
			ОписаниеОповещенияПриЗакрытииДругойФормы = Новый ОписаниеОповещения("РезультатЧтенияПропускаОтвЛица", ЭтотОбъект, ДопПараметры);
			ТСОтладка = Ложь;
			ПараметрыОткрытияДругойФормы = Новый Структура("ТекстЗаголовка,ТСОтладка,ИмяЗначения", "Считайте пропуск начальника смены ОПО", ТСОтладка, "Сотрудник");
			ПараметрыКоманды = Лико_Дополнительно.ПолучитьПараметрыКомандыВнешнейОбработки(,, "ТСРабочийСтолЕРП");
			ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ПараметрыКоманды.Ссылка);
			ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.ФормаЗапросаЧтенияШтрихкода", ПараметрыОткрытияДругойФормы, ЭтаФорма,,,,ОписаниеОповещенияПриЗакрытииДругойФормы, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе
			ДанОтветНаВопрос = Истина;
			Записать(ДопПараметры);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатЧтенияПропускаОтвЛица(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.Ошибка)
		ИЛИ НЕ ЗначениеЗаполнено(Результат.СчитанноеЗначение)
		ИЛИ ТипЗнч(Результат.СчитанноеЗначение) <> Тип("СправочникСсылка.ФизическиеЛица")
		Тогда
		Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
			Сообщить(Результат.Ошибка);
		Иначе
			Сообщить("Пропуск не был считан");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	НомерТелефона = "";
	ЗапрашиватьСМС = Истина;
	Должности = "";
	ДопПараметры.Свойство("Должности", Должности);
	Если ФизЛицоОбладаетПравамиНачальникаСмены(Результат.СчитанноеЗначение, НомерТелефона, ЗапрашиватьСМС, Должности) Тогда
		ЗапрашиватьСМС = Истина; // для упаковки поставим принудительно
		ДопПараметры.Вставить("ФизЛицоПодтверждения", Результат.СчитанноеЗначение);
		ДопПараметры.Вставить("СчитанПропускБригадира");
		Если ЗапрашиватьСМС Тогда
			// Потребуем подтверждение пропуска по смс
			Если НЕ ЗначениеЗаполнено(НомерТелефона) Тогда
				Сообщить("У физ лица " + Результат.СчитанноеЗначение + " не заполнен номер телефона, подтверждение невозможно");
				Возврат;
			КонецЕсли;
			
			// Сформируем код подверждения через генератор случайных чисел
			КодПотверждения = ОтправитьКодПодтвержденияПоСмс(НомерТелефона);
			
			// Запросим код подтверждения
			ДопПараметры.Вставить("КодПодтверждения", КодПотверждения);
			ОписаниеОповещенияПослеВводаВозврата = Новый ОписаниеОповещения("ВведенКодПодтвержденияДляПодтвержденияПропускаОтвЛица", ЭтотОбъект, ДопПараметры);
			//ПараметрыДляКлавиатуры = Новый Структура("НабираемыйТекст,ТекстЗаголовка", "", "Введите код из смс на номер " + НомерТелефона);
			//ОткрытьФорму("ОбщаяФорма.ТСВиртуальнаяКлавиатураЦифровая", ПараметрыДляКлавиатуры,,,,, ОписаниеОповещенияПослеВводаВозврата, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);  
			ПоказатьВводСтроки(ОписаниеОповещенияПослеВводаВозврата, "", "Введите код из смс на номер " + НомерТелефона, 4, Ложь);
		Иначе	
			// СМС не нужны, считаем проверку пройденной
			Выполнить("" + ДопПараметры.ИмяПроцедурыПриУспешномПодтверждении);
		КонецЕсли;
		
	Иначе
		Сообщить("Считан пропуск сотрудника, не обладающего требуемыми правами");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ФизЛицоОбладаетПравамиНачальникаСмены(ФизЛицо, НомерТелефона = "", ЗапрашиватьСМС = Ложь, СтрокаДолжностей = "")
	
	ИмяФайла = ПолучитьИмяВременногоФайла();
	ВнОбработка = Лико_Дополнительно.НайтиДополнительнуюОбработкуПоИмениОбъекта("ТСРабочийСтолЕРП");
	Если НЕ ЗначениеЗаполнено(ВнОбработка) Тогда
		Сообщить("Не найдена дополнительная обработка с именем объекта ТСРабочийСтолЕРП");
		Возврат Неопределено;
	КонецЕсли;
	ДвоичныеДанные = ВнОбработка.ХранилищеОбработки.Получить();
	ДвоичныеДанные.Записать(ИмяФайла);
	ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь);

	Результат = ВнешняяОбработка.ФизЛицоОбладаетПравамиНачальникаСмены(ФизЛицо, Объект.Организация, НомерТелефона, ЗапрашиватьСМС, СтрокаДолжностей);
	
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
	КонецПопытки;
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция ОтправитьКодПодтвержденияПоСмс(НомерТелефона)
	
	ИмяФайла = ПолучитьИмяВременногоФайла();
	ВнОбработка = Лико_Дополнительно.НайтиДополнительнуюОбработкуПоИмениОбъекта("ТСРабочийСтолЕРП");
	Если НЕ ЗначениеЗаполнено(ВнОбработка) Тогда
		Сообщить("Не найдена дополнительная обработка с именем объекта ТСРабочийСтолЕРП");
		Возврат Неопределено;
	КонецЕсли;
	ДвоичныеДанные = ВнОбработка.ХранилищеОбработки.Получить();
	ДвоичныеДанные.Записать(ИмяФайла);
	ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь);

	Результат =  ВнешняяОбработка.ОтправитьКодПодтвержденияПоСмс(НомерТелефона, Объект.РабочееМесто);
	
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
	КонецПопытки;
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ВведенКодПодтвержденияДляПодтвержденияПропускаОтвЛица(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Результат) Тогда
		Сообщить("Не введен код подтверждения из смс");
		Возврат;
	КонецЕсли;
	
	ВведенныйКод = Формат(Результат, "ЧЦ=4; ЧВН=; ЧГ=0");
	
	ТекущаяДата = ТекущаяДата();
	
	// на всякий случай будем генерить код на сегодня
	КодНаСегодня = Прав(Формат(День(ТекущаяДата) * Месяц(ТекущаяДата) * Год(ТекущаяДата) - День(ТекущаяДата) - Месяц(ТекущаяДата) - Год(ТекущаяДата), "ЧЦ=10; ЧВН=; ЧГ=0"), 4);
	
	Если ВведенныйКод <> ДопПараметры.КодПодтверждения И ВведенныйКод <> КодНаСегодня Тогда
		Сообщить("Код подтверждения не совпал: вы ввели " + ВведенныйКод + ", был отправлен " + ДопПараметры.КодПодтверждения);
		Возврат;
	КонецЕсли;
	
	// Если дошло до сюда, значит все проверки пройдены, вызовем нужную процедуру, имя которой сохранено в ДопПараметры
	Выполнить("" + ДопПараметры.ИмяПроцедурыПриУспешномПодтверждении);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДокументПослеУспешногоПодтвержденияПропуском(ДопПараметры) Экспорт
	ДанОтветНаВопрос = Истина;
	Записать(ДопПараметры);
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.СтраницаТоварыПоЗаказам Тогда
		ЗаполнитьТаблицуПоЗаказам();
		ЗаполнитьТаблицуПроверкиКоличестваВыпуска();
	КонецЕсли;

КонецПроцедуры
	
&НаСервере
Процедура ЗаполнитьТаблицуПоЗаказам()
	
	ТоварыСвернуто.Очистить();
	КоличествоМестИтог = 0;
	КоличествоИтог = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Таблица.Серия КАК Справочник.СерииНоменклатуры) КАК Серия
		|ПОМЕСТИТЬ ВТ
