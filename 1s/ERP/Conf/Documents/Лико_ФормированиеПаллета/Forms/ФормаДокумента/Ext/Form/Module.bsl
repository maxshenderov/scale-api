		ТекНомерСтроки = ТекНомерСтроки + 1;
		Строка.НомерСтроки = ТекНомерСтроки;
	КонецЦикла;
	
	КоличествоМестИтог = ТоварыСвернуто.Итог("КоличествоМест");
	КоличествоИтог = ТоварыСвернуто.Итог("Количество");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПроверкиКоличестваВыпуска()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Объект.ПроизводственноеПомещение = Справочники.Лико_ПроизводственныеПомещения.Шобер
		Тогда
		Шобер = Истина;
		Элементы.ТаблицаПроверкиКоличестваВыпускаКоличествоПереданоНаУпаковку.Видимость = Истина;
		Элементы.ТаблицаПроверкиКоличестваВыпускаКоличествоКвМРасходМатериала.Видимость = Ложь;
		Элементы.ТаблицаПроверкиКоличестваВыпускаКоличествоКвМВыпущеноВсего.Видимость = Ложь;
		Элементы.ТаблицаПроверкиКоличестваВыпускаКоличествоКвМРазница.Заголовок = "Разница (тыс.шт.)";
	Иначе
		Шобер = Ложь;
		Элементы.ТаблицаПроверкиКоличестваВыпускаКоличествоПереданоНаУпаковку.Видимость = Ложь;
		Элементы.ТаблицаПроверкиКоличестваВыпускаКоличествоКвМРасходМатериала.Видимость = Истина;
		Элементы.ТаблицаПроверкиКоличестваВыпускаКоличествоКвМВыпущеноВсего.Видимость = Истина;
		Элементы.ТаблицаПроверкиКоличестваВыпускаКоличествоКвМРазница.Заголовок = "Разница (м2)";
	КонецЕсли;
	// <-- Начало Лико Яцун С. В. 07.04.2025
	Если НЕ Объект.Площадка = Справочники.Лико_Площадки.Линкс Тогда
		Элементы.ТаблицаПроверкиКоличестваВыпускаКоличествоПереданоНаВК.Видимость = Ложь;
		Элементы.ТаблицаПроверкиКоличестваВыпускаКоличествоРазницаВК.Видимость = Ложь;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 07.04.2025
	
	ЗаполнитьПризнакВыпускаИзРастарки();
	
	ТаблицаПроверкиКоличестваВыпуска.Очистить();
	ВТаблицеСравненияЕстьОтрицательныеЗаписи = Ложь;
	ПроверкаВыпустилиБольшеЧемПередалиНаВК = Ложь;
	Если Объект.ТипДокумента <> Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции ИЛИ Объект.ВыпускИзРастарки Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Таблица.Серия КАК Справочник.СерииНоменклатуры) КАК Серия
