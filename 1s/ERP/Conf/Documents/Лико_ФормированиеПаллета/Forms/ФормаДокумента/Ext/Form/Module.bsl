&НаСервере
Процедура РассчитатьКоличествоКоробок()
	
	КоличествоКоробок = Лико_Дополнительно.РассчитатьКоличествоКоробокВТЗ(Объект.Содержимое.Выгрузить(, "Серия"));
	КоличествоКоробокРастарки = Лико_Дополнительно.РассчитатьКоличествоКоробокВТЗ(Объект.СодержимоеРастарки.Выгрузить(, "Серия"));
	//Элементы.СтраницаТовары.Заголовок = "Товары (" + Объект.Содержимое.Количество() + ")";
	//Элементы.СтраницаСодержимоеРастарки.Заголовок = "Растариваемые коробки (" + Объект.СодержимоеРастарки.Количество() + ")";

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	РассчитатьКоличествоКоробок();
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаТоварыПоЗаказам Тогда
		ЗаполнитьТаблицуПоЗаказам();
		ЗаполнитьТаблицуПроверкиКоличестваВыпуска();
