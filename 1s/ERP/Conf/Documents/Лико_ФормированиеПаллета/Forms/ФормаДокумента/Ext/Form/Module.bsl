
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ПодключаемоеОборудование
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" Тогда
			ОбработатьШтрихкоды(ПодключаемоеОборудованиеУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр));
		КонецЕсли;
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
	Если ИмяСобытия = "Лико_ПередачаМассиваСозданныхСерийЧерезПомощникЛинкс" И Объект.Комментарий = Параметр.СтруктураРастарки.НомерДокумента Тогда
		Для каждого ТекСерия из Параметр.МассивСерий Цикл
			НоваяСтрока = Объект.Содержимое.Добавить();
			НоваяСтрока.Серия = ТекСерия;
			Модифицированность = Истина;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьШтрихкодыСервер(ДанныеШтрихкода)
	
	//Найдем серию
	МассивСерий = Лико_Дополнительно.НайтиСерииПоШтрихкоду(ДанныеШтрихкода.Штрихкод);
	СерияНайдена = МассивСерий.Количество() > 0;
	Для каждого Серия из МассивСерий Цикл
		Если Объект.Содержимое.НайтиСтроки(Новый Структура("Серия", Серия)).Количество() = 0 Тогда
			НоваяСтрока = Объект.Содержимое.Добавить();
			НоваяСтрока.Серия = Серия;
			//ПроверитьИзменитьОрганизациюДокумента();
		Иначе
			Сообщить("Серия """ + Серия + """ уже добавлена в паллет.");
		КонецЕсли;
	КонецЦикла;
		
	Если НЕ СерияНайдена Тогда
		
		// Обработаем "наши" штрихкоды
		Результат = Лико_Дополнительно.ОбработатьШтрихКодНеТовараСервер(ДанныеШтрихкода.Штрихкод);
		Если Результат.Ошибка <> "" Тогда
			// Попробуем найти распоряжение на растарку
			Менеджеры = Новый Массив;
			Менеджеры.Добавить(Документы.Лико_ПеремещениеПаллета.ПустаяСсылка());
			МассивСсылок = ШтрихкодированиеПечатныхФорм.ПолучитьСсылкуПоШтрихкодуТабличногоДокумента(ДанныеШтрихкода.Штрихкод, Менеджеры);
			Если МассивСсылок.Количество() = 0 ИЛИ ТипЗнч(МассивСсылок[0]) <> Тип("ДокументСсылка.Лико_ПеремещениеПаллета") Тогда
				// распоряжение на растарку не нашли
				Сообщить(Результат.Ошибка);
			Иначе
				
				Если НЕ Объект.ВыпускИзРастарки Тогда
					Сообщить("Вы считали бланк распоряжения на растарку, поэтому паллету был установлен признак ""Выпуск из растарки""");
					Объект.ВыпускИзРастарки = Истина;
					Объект.ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции;
					УправлениеЭлементамиФормы();
				КонецЕсли;
				Объект.РаспоряжениеНаРастарку = МассивСсылок[0];
				Если Объект.ЯчейкаРастарка <> Объект.РаспоряжениеНаРастарку.ЯчейкаПолучатель Тогда
					Объект.ЯчейкаРастарка = Объект.РаспоряжениеНаРастарку.ЯчейкаПолучатель;
					Объект.ЯчейкаПолучатель = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Объект.ЯчейкаРастарка.Владелец, "ЯчейкаХранениеПоУмолчанию");
				КонецЕсли;
				Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаОсновное;
			КонецЕсли;
		Иначе
			Если Результат.ВидШК = Перечисления.ЯС_ВидыШК.ШК_Паллета Тогда
				//Это паллет
				//Объект.Паллет = Результат.Паллет;
				//Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаОсновное;
				
				// Теперь при считывании паллета будем добавлять коробки паллета в содержимое
				ТаблицаСерий = Лико_Дополнительно.ПолучитьСодержимоеПаллета(Результат.Паллет);
				Если ТаблицаСерий = Неопределено Тогда
					Возврат;
				КонецЕсли;
				сч = 0;
				Для каждого Строка из ТаблицаСерий Цикл
					Если Объект.Содержимое.НайтиСтроки(Новый Структура("Серия", Строка.Серия)).Количество() = 0 Тогда
						ЗаполнитьЗначенияСвойств(Объект.Содержимое.Добавить(), Строка);
					Иначе
						Сообщить("Серия """ + Строка.Серия + """ уже добавлена в паллет.");
					КонецЕсли;
					ПроверитьИзменитьОрганизациюДокумента();
				КонецЦикла;				
				
			ИначеЕсли Результат.ВидШК = Перечисления.ЯС_ВидыШК.ШК_Сотрудника Тогда
				//Это физ. лицо
				Объект.АвторДокумента = Результат.Сотрудник;
				Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаОсновное;
			ИначеЕсли Результат.ВидШК = Перечисления.ЯС_ВидыШК.ШК_Адреса
				ИЛИ Результат.ВидШК = Перечисления.ЯС_ВидыШК.ШК_Адреса_Короткий Тогда
				//Это ячейка
				Объект.ЯчейкаПолучатель = Результат.АдресаХранения;
				Объект.ЯчейкаРастарка = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Объект.ЯчейкаПолучатель.Владелец, "ЯчейкаРастарка");
				Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаОсновное;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаТовары;
		ПроверитьИзменитьОрганизациюДокумента();
	КонецЕсли;
	РассчитатьКоличествоКоробок();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИзменитьОрганизациюДокумента()
	
	Если Объект.ТипДокумента <> Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Содержимое.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	//Если Объект.ПроизводственноеПомещение <> Справочники.Лико_ПроизводственныеПомещения.Шобер Тогда
	//	Возврат;
	//КонецЕсли;
	
	ПлощадкаПервойКоробки = Объект.Содержимое[0].Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Площадка;
	Если ПлощадкаПервойКоробки <> Объект.Площадка Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Склады.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Склады КАК Склады
			|ГДЕ
			|	Склады.Лико_Площадка = &Лико_Площадка
			|	И Склады.Лико_ТипСкладаГотовойПродукции = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыСкладовГотовойПродукции.Производство)
			|	И НЕ Склады.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Лико_Площадка", ПлощадкаПервойКоробки);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		НовыйСклад = Неопределено;
		//Если ВыборкаДетальныеЗаписи.Количество() <> 1 Тогда
		//	Сообщить("Найдено " + ВыборкаДетальныеЗаписи.Количество() + " склада с типом ""Производство"" по площадке """ + ПлощадкаПервойКоробки + """. Обратитесь к программистам");
		//	Возврат;
		//ИначеЕсли ПлощадкаПервойКоробки = Справочники.Лико_Площадки.Линкс Тогда
		//	НовыйСклад = Справочники.Лико_ПредопределенныеЗначения.СкладГпЮзВМеталлострое.ЗначениеПараметра;	
		//Иначе
		//	ВыборкаДетальныеЗаписи.Следующий();
		//	НовыйСклад = ВыборкаДетальныеЗаписи.Ссылка;
		//КонецЕсли; 
		Если ВыборкаДетальныеЗаписи.Количество() = 1 Тогда
			ВыборкаДетальныеЗаписи.Следующий();
			НовыйСклад = ВыборкаДетальныеЗаписи.Ссылка;
		ИначеЕсли ПлощадкаПервойКоробки = Справочники.Лико_Площадки.Линкс Тогда
			НовыйСклад = Справочники.Лико_ПредопределенныеЗначения.СкладГпЮзВМеталлострое.ЗначениеПараметра;	
		Иначе
			Сообщить("Найдено " + ВыборкаДетальныеЗаписи.Количество() + " склада с типом ""Производство"" по площадке """ + ПлощадкаПервойКоробки + """. Обратитесь к программистам");
			Возврат;
		КонецЕсли; 
		Если ЗначениеЗаполнено(НовыйСклад) Тогда
			ЯчейкаУпаковка = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, НовыйСклад, "ЯчейкаУпаковка");
			Если НЕ ЗначениеЗаполнено(ЯчейкаУпаковка) Тогда
				Сообщить("Не найдена ячейка-упаковка для склада """ + НовыйСклад + """. Обратитесь к программистам");
				Возврат;
			КонецЕсли;
			ЯчейкаРастарка = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, НовыйСклад, "ЯчейкаРастарка");
			Если НЕ ЗначениеЗаполнено(ЯчейкаРастарка) Тогда
				Сообщить("Не найдена ячейка-растарка для склада """ + НовыйСклад + """. Обратитесь к программистам");
				Возврат;
			КонецЕсли;
			Объект.Площадка = ПлощадкаПервойКоробки;
			Объект.Организация = ПлощадкаПервойКоробки.Организация;
			Объект.ЯчейкаПолучатель = ЯчейкаУпаковка;
			Объект.ЯчейкаРастарка = ЯчейкаРастарка;
			Если ЗначениеЗаполнено(НовыйСклад.Подразделение) И Объект.Подразделение <> НовыйСклад.Подразделение Тогда
				Объект.Подразделение = НовыйСклад.Подразделение;
			КонецЕсли;
			Сообщить("Изменена площадка документа на """ + Объект.площадка + """, т.к. вы считали штриход коробки другой площадки");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	
	Если Объект.СозданНаОснованииПолученияГПИзПроизводства Тогда
		Сообщить("Документ создан на основании " + Метаданные.Документы.Лико_ПолучениеГПИзПроизводства.Представление() + ", корректировка возможно только под полными правами");
		Если НЕ ТолькоПросмотр Тогда
			ТолькоПросмотр = НЕ РольДоступна("ПолныеПрава");
		КонецЕсли;
	КонецЕсли;
	
	ТиповыеДокументы.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) И НЕ ЗначениеЗаполнено(Объект.ТипДокумента) Тогда
		Параметры.Свойство("ТипДокумента", Объект.ТипДокумента);
		Если НЕ ЗначениеЗаполнено(Объект.ТипДокумента) Тогда
			Объект.ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.Переупаковка;
		КонецЕсли;
		Параметры.Свойство("ФизЛицо", Объект.АвторДокумента);
		Параметры.Свойство("ВыпускИзРастарки", Объект.ВыпускИзРастарки);
		Объект.РабочееМесто = ПараметрыСеанса.Лико_РабочееМесто;
		Если НЕ ЗначениеЗаполнено(Объект.АвторДокумента) Тогда
			Объект.АвторДокумента = Объект.РабочееМесто.СотрудникПоF2;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.АвторДокумента) Тогда
			Объект.АвторДокумента = Объект.РабочееМесто.СотрудникПоF3;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.АвторДокумента) Тогда
			Объект.АвторДокумента = ПараметрыСеанса.ТекущийПользователь.ФизическоеЛицо;
		КонецЕсли;
		//Если Параметры.Свойство("СоздатьНовыйПаллет") И Параметры.СоздатьНовыйПаллет Тогда
			//Нужно создавать паллет
			Объект.Паллет = Лико_Дополнительно.СоздатьНовыйПаллет(Объект.АвторДокумента);
		//КонецЕсли;
		ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
		Объект.Площадка = Лико_Дополнительно.ПлощадкаПользователяПоУмолчанию(); 
		Объект.Организация = Объект.Площадка.Организация; 
		Объект.Подразделение = ТекущийПользователь.Подразделение;
		Параметры.Свойство("ЯчейкаПолучатель", Объект.ЯчейкаПолучатель);
		Если НЕ ЗначениеЗаполнено(Объект.ЯчейкаПолучатель) Тогда
			Если Объект.ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции Тогда
				Объект.ЯчейкаПолучатель = Объект.РабочееМесто.АдресРазмещенияНовогоПаллетаУпаковка;
			Иначе
				Объект.ЯчейкаПолучатель = Объект.РабочееМесто.АдресРазмещенияНовогоПаллетаПереупаковка;
			КонецЕсли;
		КонецЕсли;
		Объект.ПроизводственноеПомещение = Объект.РабочееМесто.ПроизводственноеПомещение;
		Объект.ЯчейкаРастарка = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Объект.ЯчейкаПолучатель.Владелец, "ЯчейкаРастарка");
		Параметры.Свойство("ДатаУпрощенногоПроведения", Объект.ДатаУпрощенногоПроведения); 
		Параметры.Свойство("Комментарий", Объект.Комментарий);
	КонецЕсли;
	
	//РассчитатьКоличествоКоробок();
	
	ДокументПроведенПриОткрытии = Объект.Проведен;
	
	ПолныеПрава = РольДоступна("ПолныеПрава");
	Лико_ДополнительныеПраваНачальникаСГП = РольДоступна("Лико_ДополнительныеПраваНачальникаСГП");
	Элементы.СодержимоеВыбылСоСклада.Видимость = ПолныеПрава;
	Элементы.Дата.Доступность = ПолныеПрава ИЛИ Лико_ДополнительныеПраваНачальникаСГП;
	Элементы.ДатаФормирования.Доступность = ПолныеПрава;
	Элементы.Организация.Доступность = ПолныеПрава;
	Элементы.Площадка.Доступность = ПолныеПрава;
	Элементы.Подразделение.Доступность = ПолныеПрава;
	//Элементы.РаспоряжениеНаРастарку.Доступность = ПолныеПрава;
	Элементы.Паллет.Доступность = ПолныеПрава;
	Элементы.ЯчейкаПолучатель.Доступность = ПолныеПрава;
	Элементы.РабочееМесто.Доступность = ПолныеПрава;
	Элементы.ПроизводственноеПомещение.Доступность = ПолныеПрава;
	Элементы.АвторДокумента.Доступность = ПолныеПрава;
	Элементы.ЭтоПоследнийВыпускПоРастарке.Видимость = ПолныеПрава;
	Элементы.ЯчейкаРастарка.Видимость = ПолныеПрава;
	Элементы.СтраницаСодержимоеРастарки.Видимость = ПолныеПрава;
	Элементы.ДатаУпрощенногоПроведения.Доступность = ПолныеПрава;
	Элементы.СодержимоеИзменитьРаспоряжениеНаРастаркуВоВсехСтроках.Видимость = ПолныеПрава;
	Элементы.ФормаПровести.Видимость = ПолныеПрава;

	Если ПолныеПрава Тогда
		УпаковкаПроверятьКоличествоВыпуска = Ложь;
	ИначеЕсли Объект.РабочееМесто.ОбработкиДляОткрытияПриЗапуске1С.Найти(Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", "Лико_РабочееМестоПеремоткаУпаковка")) <> Неопределено
		ИЛИ Объект.РабочееМесто.ТипРабочегоМеста = Перечисления.Лико_ТипыРабочегоМеста.Инфопад 
		Тогда
		// Работают через обработку "Перемотка упаковка", проверять тоже не надо
		УпаковкаПроверятьКоличествоВыпуска = Ложь;
	Иначе
		УпаковкаПроверятьКоличествоВыпуска = Истина;
	КонецЕсли;
	
	УправляющийШтрихкодПроведенияФормированияПаллета = Справочники.Лико_ПредопределенныеЗначения.УправляющийШтрихкодПроведенияФормированияПаллета.ЗначениеПараметра;
	Если НЕ ЗначениеЗаполнено(УправляющийШтрихкодПроведенияФормированияПаллета) Тогда
		Сообщить("В справочнике предопределенных значений не заполнен УправляющийШтрихкодПроведенияФормированияПаллета. Обратитесь к программистам");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТиповыеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ТиповойДокумент) Тогда
		ПоказатьЗначение(,Элемент.ТекущиеДанные.ТиповойДокумент);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ТиповыеДокументы.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	Элементы.ТиповыеДокументы.Обновить();
	РассчитатьКоличествоКоробок();
	
	Если УпаковкаПроверятьКоличествоВыпуска И ВТаблицеСравненияЕстьОтрицательныеЗаписи Тогда
		СформироватьИОтправитьПисьмоОПроверкеКоличестваВыпуска(Истина, ?(ПараметрыЗаписи.Свойство("ФизЛицоПодтверждения"), ПараметрыЗаписи.ФизЛицоПодтверждения, Неопределено));	
	КонецЕсли;
	// <-- Начало Лико Яцун С. В. 07.04.2025 
	Если Объект.Площадка = ПредопределенноеЗначение("Справочник.Лико_Площадки.Линкс") И УпаковкаПроверятьКоличествоВыпуска И ПроверкаВыпустилиБольшеЧемПередалиНаВК Тогда
		СформироватьИОтправитьПисьмоОПроверкеКоличестваВыпускаИКоличестваПереданногоНаВК();	
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 07.04.2025 
	
	// --> Начало Лико Ефимов ЕВВ 08.01.2020
	ДокПеремещения = Неопределено;
	Если Объект.ЯчейкаПолучатель = Объект.ЯчейкаРастарка И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение И Объект.Проведен И НЕ ДокументПроведенПриОткрытии Тогда
		// Создадим сразу перемещение паллета на растарку и распечатаем распоряжение на растарку
		ДокПеремещения = СоздатьПеремещениеНаРастарку();
		Если ЗначениеЗаполнено(ДокПеремещения) Тогда
			Обработка = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Справочники.Лико_ПредопределенныеЗначения.ВнешняяПечатнаяФормаНакладнаяНаПередел.ЗначениеПараметра");
			Если НЕ ЗначениеЗаполнено(Обработка) Тогда
				Сообщить("В системе не зарегистрирована печатная форма ""Накладная на передел"" или она не заполнена в справочнике предопределенных значений.");
				Возврат;
			КонецЕсли;
			ИмяОбъекта = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Обработка.ИмяОбъекта", Обработка, "Обработка"); 
			МассивОбъектов = Новый Массив;
			МассивОбъектов.Добавить(ДокПеремещения);
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("ИсточникДанных", Обработка);
			ПараметрыОткрытия.Вставить("ПараметрыИсточника", Новый Структура("ИдентификаторКоманды,ОбъектыНазначения", ИмяОбъекта, МассивОбъектов));
			ПараметрыОткрытия.Вставить("ПараметрыПечати", Неопределено);
			
			ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыОткрытия, ЭтаФорма, Строка(Новый УникальныйИдентификатор));
		КонецЕсли		
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 08.01.2020
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение И НЕ ДокументПроведенПриОткрытии И Объект.Организация <> Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЭкоФлекс.ЗначениеПараметра") И НЕ ЗначениеЗаполнено(ДокПеремещения) Тогда
		// Нужно вывести на печать паллетный ярлык
		Обработка = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Справочники.Лико_ПредопределенныеЗначения.ВнешняяПечатнаяФормаПаллетныйЯрлык.ЗначениеПараметра");
		Если НЕ ЗначениеЗаполнено(Обработка) Тогда
			Сообщить("В системе не зарегистрирована печатная форма ""Паллетный ярлык"" или она не заполнена в справочнике предопределенных значений.");
			Возврат;
		КонецЕсли;
		ИмяОбъекта = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Обработка.ИмяОбъекта", Обработка, "Обработка"); 
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Объект.Ссылка);
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("ИсточникДанных", Обработка);
		ПараметрыОткрытия.Вставить("ПараметрыИсточника", Новый Структура("ИдентификаторКоманды,ОбъектыНазначения", ИмяОбъекта, МассивОбъектов));
		ПараметрыОткрытия.Вставить("ПараметрыПечати", Неопределено);
		
		ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыОткрытия, ЭтаФорма, Строка(Новый УникальныйИдентификатор));
		
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ДокументПроведенПриОткрытии = Истина;
	КонецЕсли; 
	
	// --> Начало Лико Ефимов ЕВВ 06.11.2025
	Если Объект.Площадка = ПредопределенноеЗначение("Справочник.Лико_Площадки.Линкс") Тогда
		Оповестить("Лико_ПроведеноФормированиеПаллета",, "Лико_ФормированиеПаллета");
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 06.11.2025
	
	Если ПараметрыЗаписи.Свойство("ЗакрытьФорму") И ПараметрыЗаписи.ЗакрытьФорму Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьИОтправитьПисьмоОПроверкеКоличестваВыпуска(ПослеЗаписи = Истина, НачальникСменыУПО = Неопределено)

	// Нужно отправить письмо старшему перемотчику
	Шобер = Объект.ПроизводственноеПомещение = Справочники.Лико_ПроизводственныеПомещения.Шобер;
	Адресат = Лико_Дополнительно.НайтиЭлектронныйАдресОтветственногоПоСкладу(Объект.ЯчейкаПолучатель.Владелец, "Лико_АдресДляОтправкиПисемОРасхожденииВыпускаИРасходаМатериала",, Ложь);
	Если ЗначениеЗаполнено(Адресат) Тогда
		Если ПослеЗаписи Тогда
			ТемаПисьма = "Расхождение при проверке количества выпуска " + Объект.Паллет;
			Если Шобер Тогда
				ТекстПисьма = "На упаковке выпустили " + Объект.Паллет + ", по которому есть расхождения с переданным на упаковку количеством (номер документа " + Объект.Номер + ")."; 
			Иначе
				ТекстПисьма = "На упаковке выпустили " + Объект.Паллет + ", по которому есть расхождения с расходом материала (номер документа " + Объект.Номер + ")."; 
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НачальникСменыУПО) Тогда
				ТекстПисьма = ТекстПисьма + "<br>"  + Символы.ПС + "Подтвердил своим пропуском сотрудник " + НачальникСменыУПО + ".";
			КонецЕсли;
		Иначе
			ТемаПисьма = "Запрос пропуска для подтверждения выпуска, по которому есть расхождение при проверке количества";
			ТекстПисьма = "На упаковке " + ?(Шобер, "(шобер) ", "") + "хотят выпустить паллет, по которому есть расхождение при проверке количества. Нужно подтверждение начальника смены ОПО.";
		КонецЕсли;
		Для каждого Строка из ТаблицаПроверкиКоличестваВыпуска Цикл
			Если Строка.КоличествоРазница < 0 И НЕ Строка.НеПроверять Тогда
				Если Шобер Тогда
					ТекстПисьма = ТекстПисьма + "<br>"  + Символы.ПС + "Заказ " + Строка.Заказ.НомерБезПрефикса + ": тираж " + Строка.КоличествоЗаказано + " тыс.шт., выпущено " + Строка.КоличествоВыпущеноВсего + " тыс.шт., передано на упаковку " + Строка.КоличествоПереданоНаУпаковку + " тыс.шт., превышение " + (Строка.КоличествоРазница * -1) + " тыс.шт.";
				Иначе
					ТекстПисьма = ТекстПисьма + "<br>"  + Символы.ПС + "Заказ " + Строка.Заказ.НомерБезПрефикса + ": тираж " + Строка.КоличествоЗаказано + " тыс.шт., выпущено " + Строка.КоличествоВыпущеноВсего + " тыс.шт., расход материала " + Строка.КоличествоКвМРасходМатериала + " кв.м., выпущено " + Строка.КоличествоКвМВыпущеноВсего + " кв.м., превышение " + (Строка.КоличествоРазница * -1) + " кв.м.";
				КонецЕсли;		
			КонецЕсли;		
		КонецЦикла;
		ТекстПисьма = СтрЗаменить(ТекстПисьма, "№", "N");
		ТемаПисьма = СтрЗаменить(ТемаПисьма, "№", "N");
		Лико_Планирование.ОтправитьПисьмо(ТекстПисьма, ТемаПисьма, Адресат,,,,,, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьИОтправитьПисьмоОПроверкеКоличестваВыпускаИКоличестваПереданногоНаВК() // <-- Начало Лико Яцун С. В. 07.04.2025

	Адресаты = "TPetrova@okil-sato.ru;NShadova@okil-sato.ru;DSakhno@okil-sato.ru";
	ТемаПисьма = "Расхождение при проверке количества выпуска " + Объект.Паллет;
	ТекстПисьма = "На упаковке выпустили " + Объект.Паллет + ", по которому есть расхождения с переданным на ВК количеством (номер документа " + Объект.Номер + ")."; 
	Для каждого Строка из ТаблицаПроверкиКоличестваВыпуска Цикл
		Если Строка.КоличествоРазницаВК < 0 И НЕ Строка.НеПроверять Тогда
			ТекстПисьма = ТекстПисьма + "<br>"  + Символы.ПС + "Заказ " + Строка.Заказ.НомерБезПрефикса + ": тираж " + Строка.КоличествоЗаказано + " тыс.шт., выпущено " + Строка.КоличествоВыпущеноВсего + " тыс.шт., передано на ВК " + Строка.КоличествоПереданоНаВК + " тыс.шт., превышение " + (Строка.КоличествоРазницаВК * -1) + " тыс.шт.";
		КонецЕсли;		
	КонецЦикла;
	ТекстПисьма = СтрЗаменить(ТекстПисьма, "№", "N");
	ТемаПисьма = СтрЗаменить(ТемаПисьма, "№", "N");
	Лико_Планирование.ОтправитьПисьмо(ТекстПисьма, ТемаПисьма, Адресаты,,,,,, Ложь);
	
КонецПроцедуры // <-- Конец Лико Яцун С. В. 07.04.2025

&НаСервере
Функция СоздатьПеремещениеНаРастарку()
	
	// Сначала попробуем найти такой документ
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ПеремещениеПаллета.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Лико_ПеремещениеПаллета КАК Лико_ПеремещениеПаллета
		|ГДЕ
		|	Лико_ПеремещениеПаллета.Проведен
		|	И НЕ Лико_ПеремещениеПаллета.ПометкаУдаления
		|	И Лико_ПеремещениеПаллета.Дата = &Дата
		|	И Лико_ПеремещениеПаллета.ЯчейкаПолучатель = &ЯчейкаПолучатель
		|	И Лико_ПеремещениеПаллета.Паллет = &Паллет";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата + 1);
	Запрос.УстановитьПараметр("Паллет", Объект.Паллет);
	Запрос.УстановитьПараметр("ЯчейкаПолучатель", Объект.ЯчейкаПолучатель);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	НовыйДок = Документы.Лико_ПеремещениеПаллета.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(НовыйДок, Объект, "АвторДокумента,Организация,Паллет,Подразделение,РабочееМесто,Площадка");
	НовыйДок.АвторДокумента = Объект.АвторДокумента;
	НовыйДок.Дата = Объект.Дата + 1;
	НовыйДок.Комментарий = "Создан на основании документа """ + Объект.Ссылка + """, т.к. в формировании ячейкой-получателем была указана ячейка-растарка";
	НовыйДок.ПричинаРастарки = Перечисления.Лико_ПричиныРастарки.КомплектацияПоЗаявкеМенеджераНаОтгрузку;
	НовыйДок.СкладОтправитель = Объект.ЯчейкаПолучатель.Владелец;
	НовыйДок.СкладПолучатель = НовыйДок.СкладОтправитель;
	НовыйДок.ЯчейкаОтправитель = Объект.ЯчейкаПолучатель;
	НовыйДок.ЯчейкаПолучатель = НовыйДок.ЯчейкаОтправитель;
	Для каждого Строка из Объект.Содержимое Цикл;
		НоваяСтрока = НовыйДок.Содержимое.Добавить();
		НоваяСтрока.Серия = Строка.Серия;
	КонецЦикла;
	Попытка
		НовыйДок.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Исключение
		Сообщить("Не удалось создать перемещение на растарку. Описание ошибки: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	Сообщить("Сформирован документ """ + НовыйДок.Ссылка + """ на растарку");
	Возврат НовыйДок.Ссылка;
	
КонецФункции

