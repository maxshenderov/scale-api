	//	Отказ = Истина;
	//	// Нужно спросить, последний ли это выпуск
	//	ОписаниеОповещения = Новый ОписаниеОповещения("ОтветилиНаВопросОПоследнемВыпуске", ЭтотОбъект, ПараметрыЗаписи);
	//	ПоказатьВопрос(ОписаниеОповещения, "Это последний выпуск по выбранному распоряжению на растарку?", РежимДиалогаВопрос.ДаНетОтмена,, КодВозвратаДиалога.Отмена);
	//ИначеЕсли
	Если НЕ ДанОтветНаВопрос И УпаковкаПроверятьКоличествоВыпуска И (ВТаблицеСравненияЕстьОтрицательныеЗаписи ИЛИ ПроверкаВыпустилиБольшеЧемПередалиНаВК) И НЕ Объект.ВыпускИзРастарки Тогда
