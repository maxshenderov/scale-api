		|		КОГДА &Шобер
		|			ТОГДА ЕСТЬNULL(ВТ_ПереданоНаУпаковку.КоличествоПереданоНаУпаковку, 0) - ВТ_Итог.КоличествоВыпущеноБезТекущегоДокумента - ВТ_Итог.КоличествоВыпущеноТекущимДокументом
		|		ИНАЧЕ ВТ_Итог.КоличествоКвМРасходМатериала - ВТ_Итог.КоличествоКвМВыпущеноБезТекущегоДокумента - ВТ_Итог.КоличествоКвМВыпущеноТекущимДокументом
		|	КОНЕЦ КАК КоличествоРазница,
		|	ВЫБОР
		|		КОГДА ВТ_Итог.Заказ.ВидЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка)
		|				ИЛИ ВТ_Итог.Заказ.Комбинированный
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК НеПроверять,
		|	ЕСТЬNULL(ВТ_ПереданоНаУпаковку.КоличествоПереданоНаУпаковку, 0) КАК КоличествоПереданоНаУпаковку,
		|	ЕСТЬNULL(ВТЛинксПереданоНаВК.КоличествоПриход, 0) КАК КоличествоПереданоНаВК,
		|	ЕСТЬNULL(ВТЛинксПереданоНаВК.КоличествоПриход, 0) - ВТ_Итог.КоличествоВыпущеноБезТекущегоДокумента - ВТ_Итог.КоличествоВыпущеноТекущимДокументом КАК КоличествоРазницаВК
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПереданоНаУпаковку КАК ВТ_ПереданоНаУпаковку
		|		ПО ВТ_Итог.Заказ = ВТ_ПереданоНаУпаковку.Заказ
		|			И (&Шобер)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЛинксПереданоНаВК КАК ВТЛинксПереданоНаВК
		|		ПО ВТ_Итог.Заказ = ВТЛинксПереданоНаВК.Заказ";
	
	Запрос.УстановитьПараметр("Таблица", Объект.Содержимое.Выгрузить());
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("ЯчейкаРастарка", Объект.ЯчейкаРастарка);
	Запрос.УстановитьПараметр("Шобер", Шобер);
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	ТаблицаПроверкиКоличестваВыпуска.Загрузить(ТаблицаРезультат);
	
	// --> Начало Лико Ефимов ЕВВ 03.06.2024
	// Потом убрать
	ВключенаПроверкаУпаковкиНаШобере = Справочники.Лико_ПредопределенныеЗначения.ВключенаПроверкаУпаковкиНаШобере.ЗначениеПараметра;
	Если НЕ ЗначениеЗаполнено(ВключенаПроверкаУпаковкиНаШобере) Тогда
		ВключенаПроверкаУпаковкиНаШобере = Ложь;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 03.06.2024
	
	Для каждого Строка из ТаблицаРезультат Цикл
		// <-- Начало Лико Яцун С. В. 07.04.2025 
		Если Объект.Площадка = Справочники.Лико_Площадки.Линкс И Строка.КоличествоРазницаВК < 0 И НЕ Строка.НеПроверять Тогда
			ПроверкаВыпустилиБольшеЧемПередалиНаВК = Истина;	
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 07.04.2025
		Если Строка.КоличествоРазница < 0 И НЕ Строка.НеПроверять Тогда
			// --> Начало Лико Ефимов ЕВВ 03.06.2024
			// Потом убрать
			Если Шобер И НЕ ВключенаПроверкаУпаковкиНаШобере Тогда
				Продолжить;
			КонецЕсли; 
			// <-- Конец Лико Ефимов ЕВВ 03.06.2024
			
			ВТаблицеСравненияЕстьОтрицательныеЗаписи = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	//ТекНомерСтроки = 0;
	//Для каждого Строка из ТоварыСвернуто Цикл
	//	ТекНомерСтроки = ТекНомерСтроки + 1;
	//	Строка.НомерСтроки = ТекНомерСтроки;
	//КонецЦикла;
	
	//КоличествоМестИтог = ТоварыСвернуто.Итог("КоличествоМест");
	//КоличествоИтог = ТоварыСвернуто.Итог("Количество");
	
КонецПроцедуры

