Функция СформироватьТаблицуДляКорректировкиРегистров(МассивСерий, Склад) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(СерииНоменклатуры.Лико_ХарактеристикаВладелец.Владелец КАК Справочник.Номенклатура) КАК Номенклатура,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец КАК Характеристика,
		|	СерииНоменклатуры.Ссылка КАК Серия,
		|	СерииНоменклатуры.Лико_КоличествоВУпаковке КАК Количество,
		|	МАКСИМУМ(ВЫРАЗИТЬ(ДвиженияСерийТоваров.Документ КАК Документ.ПриходныйОрдерНаТовары)) КАК ПриходныйОрдерНаТовары
		|ИЗ
		|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДвиженияСерийТоваров КАК ДвиженияСерийТоваров
		|		ПО СерииНоменклатуры.Ссылка = ДвиженияСерийТоваров.Серия
		|			И (ДвиженияСерийТоваров.Документ ССЫЛКА Документ.ПриходныйОрдерНаТовары)
		|			И (ВЫРАЗИТЬ(ДвиженияСерийТоваров.Документ КАК Документ.ПриходныйОрдерНаТовары).Склад = &Склад)
		|			И (ВЫРАЗИТЬ(ДвиженияСерийТоваров.Документ КАК Документ.ПриходныйОрдерНаТовары).СкладскаяОперация = ЗНАЧЕНИЕ(Перечисление.СкладскиеОперации.ПриемкаОтПоставщика))
		|ГДЕ
		|	СерииНоменклатуры.Ссылка В(&МассивСерий)
		|
		|СГРУППИРОВАТЬ ПО
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец,
		|	СерииНоменклатуры.Ссылка,
		|	СерииНоменклатуры.Лико_КоличествоВУпаковке,
		|	ВЫРАЗИТЬ(СерииНоменклатуры.Лико_ХарактеристикаВладелец.Владелец КАК Справочник.Номенклатура)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Серия";
	
	Запрос.УстановитьПараметр("МассивСерий", МассивСерий);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

