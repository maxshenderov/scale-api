Процедура СоздатьПередачуПродукцииВФоне(Параметры, АдресХранилища) Экспорт
	
	Основание = Параметры.Основание;
	
	НачатьТранзакцию();
	
	Попытка
		НовыйДокументПередачаНаСклад = Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент();
		
		НовыйДокументПередачаНаСклад.Заполнить(Основание);
		НовыйДокументПередачаНаСклад.Дата = ТекущаяДата();
		НовыйДокументПередачаНаСклад.Комментарий = "" +  Основание;
		
		//НовыйДокументПередачаНаСклад.Записать(РежимЗаписиДокумента.Проведение);
		НовыйДокументПередачаНаСклад.Записать(РежимЗаписиДокумента.Запись);
		Сообщить("Создан документ """ + НовыйДокументПередачаНаСклад.Ссылка + """"); 
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(НовыйДокументПередачаНаСклад.Ссылка, АдресХранилища);
	
КонецПроцедуры

