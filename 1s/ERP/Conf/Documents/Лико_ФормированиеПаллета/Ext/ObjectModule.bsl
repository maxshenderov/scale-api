		|	ВТ_Серии.Номенклатура КАК Номенклатура,
		|	ВТ_Серии.Характеристика КАК Характеристика,
		|	СУММА(ВТ_Серии.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТ_Товары
		|ИЗ
		|	ВТ_Серии КАК ВТ_Серии
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Серии.Номенклатура,
		|	ВТ_Серии.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Товары.Номенклатура КАК Номенклатура,
		|	ВТ_Товары.Характеристика КАК Характеристика,
		|	ВТ_Товары.Количество КАК Количество,
		|	ВТ_Товары.Количество КАК КоличествоУпаковок,
		|	ЕСТЬNULL(ОстаткиТоваровСгруппированы.ВНаличииОстаток, 0) КАК ВНаличииОстаток
		|ИЗ
		|	ВТ_Товары КАК ВТ_Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|			ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
		|			СУММА(ТоварыНаСкладахОстатки.ВНаличииОстаток) КАК ВНаличииОстаток
		|		ИЗ
		|			РегистрНакопления.ТоварыНаСкладах.Остатки(
		|					&ДатаОстатков,
		|					(Номенклатура, Характеристика) В
		|							(ВЫБРАТЬ
		|								Т.Номенклатура,
		|								Т.Характеристика
		|							ИЗ
		|								ВТ_Товары КАК Т)
		|						И Склад = &НеордерныйСклад) КАК ТоварыНаСкладахОстатки
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ТоварыНаСкладахОстатки.Номенклатура,
		|			ТоварыНаСкладахОстатки.Характеристика) КАК ОстаткиТоваровСгруппированы
		|		ПО ВТ_Товары.Номенклатура = ОстаткиТоваровСгруппированы.Номенклатура
		|			И ВТ_Товары.Характеристика = ОстаткиТоваровСгруппированы.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Серии.Номенклатура КАК Номенклатура,
		|	ВТ_Серии.Характеристика КАК Характеристика,
		|	ВТ_Серии.Серия КАК Серия,
		|	ВТ_Серии.Количество КАК Количество,
		|	ВТ_Серии.ЯчейкаПолучатель КАК ЯчейкаПолучатель
		|ИЗ
		|	ВТ_Серии КАК ВТ_Серии";

		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("ДатаОстатков", Дата);
		Запрос.УстановитьПараметр("НеордерныйСклад", СкладОтправитель);
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		ТаблицаБезСерий = РезультатыЗапроса[РезультатыЗапроса.Количество()-2].Выгрузить();
		ЕстьОшибкиПоОстаткам = Ложь;
		Для каждого Строка из ТаблицаБезСерий Цикл
			Если Строка.Количество > Строка.ВНаличииОстаток Тогда
				ЕстьОшибкиПоОстаткам = Истина;
				Сообщить("Для позиции """ + Строка.Номенклатура + " / " + Строка.Характеристика + """ не хватает остатков на складе """ + СкладОтправитель + """. Требуется " + Строка.Количество + ", в наличии " + Строка.ВНаличииОстаток);
			КонецЕсли;
		КонецЦикла;
		Если ЕстьОшибкиПоОстаткам Тогда
			Возврат Ложь;
		КонецЕсли;

		ТаблицаСерий = РезультатыЗапроса[РезультатыЗапроса.Количество()-1].Выгрузить();
		Лико_Дополнительно.ДополнитьТаблицуСерийКолонкамиДляПроведенияДокументов(ТаблицаСерий);

		НачатьТранзакцию();
		// Сначала найдем уже сформированные типовые документы, распроведем их и будем заполнять заново
		КлючиСтруктурыБезЭтапа = Лико_Дополнительно.ПолучитьКлючиСтруктурыБезДокумента(КлючиСтруктуры, "ЭтапПроизводства2_2");
		СтруктураТиповыхДокументов = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(Истина,, КлючиСтруктурыБезЭтапа, Ссылка);
		Если СтруктураТиповыхДокументов = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		// Создаем перемещение товаров
		НовыйДокументПеремещениеТоваров = СоздатьДокументПеремещениеТоваров(ТаблицаБезСерий, СтруктураТиповыхДокументов.ПеремещениеТоваров);
		Если НовыйДокументПеремещениеТоваров = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		НоваяСтрока = ТаблицаНовыхДокументов.Добавить();
		НоваяСтрока.Документ = НовыйДокументПеремещениеТоваров;

		// Создаем документ "Приходный ордер"
		НовыйДокументПриходныйОрдерНаТовары = Лико_Дополнительно.СоздатьДокументПриходныйОрдерНаТоварыНаОснованииРаспоряжения(НовыйДокументПеремещениеТоваров, СтруктураТиповыхДокументов.ПриходныйОрдерНаТовары, ТаблицаСерий); 
		Если НовыйДокументПриходныйОрдерНаТовары = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		НоваяСтрока = ТаблицаНовыхДокументов.Добавить();
		НоваяСтрока.Документ = НовыйДокументПриходныйОрдерНаТовары;

		// Создаем размещение на складе
		НовыйДокументОтборРазмещениеТоваров_Размещение = Лико_Дополнительно.СоздатьРазмещениеТоваровНаОснованииПриходногоОрдера(НовыйДокументПриходныйОрдерНаТовары, СтруктураТиповыхДокументов.ОтборРазмещениеТоваров_Размещение, ЯчейкаПолучатель);
		Если НовыйДокументОтборРазмещениеТоваров_Размещение = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		НоваяСтрока = ТаблицаНовыхДокументов.Добавить();
		НоваяСтрока.Документ = НовыйДокументОтборРазмещениеТоваров_Размещение;

	Иначе
		Сообщить("Тип документа """ + ТипДокумента + """ не предусмотрен разработчиками");
		Возврат Ложь;
	КонецЕсли;

	Если ПараметрыДляСозданияОднойЦепочки = Неопределено Тогда
		//Запишем типовые документы в регистр ЛикоСвязиСТиповымиДокументами
		Результат = Лико_Дополнительно.ЗаписатьТиповыеДокументыВРегистрЛико_СвязиСТиповымиДокументами(ТаблицаНовыхДокументов, Ссылка);
		Если НЕ Результат Тогда
			Возврат Ложь;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
		Возврат Истина;  
	Иначе
		Возврат ТаблицаНовыхДокументов;
	КонецЕсли;

КонецФункции

Функция ПодобратьВыпускающийЭтапПоЗаказу(Заказ)
	
	ВыпускающийЭтап = Лико_Дополнительно.НайтиВыпускающийЭтапПоЗаказуКлиента(Заказ);
	Если ВыпускающийЭтап = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Заказ.Площадка <> Справочники.Лико_Площадки.ИксПак Тогда // --> Начало Лико Ефимов ЕВВ 12.10.2020 Для Икс-пака проверять не будем, пусть всегда пишется в исходный заказ 
		ПроверитьВыпускающийЭтапПоДатам(ВыпускающийЭтап);
	КонецЕсли;

	Возврат ВыпускающийЭтап;
	
КонецФункции

Функция СоздатьЭтап(ВыборкаЗаказ, УжеСозданныйДокумент)

	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	//Распоряжение    = Лико_Дополнительно.НайтиЗаказНаПроизводствоПоЗаказуКлиента(ВыборкаЗаказ.ЗаказКлиента);
	//Если Распоряжение = Неопределено Тогда
	//	Отказ = Истина;
	//	Сообщить("Не найден заказ на производство для заказа клиента """ + ВыборкаЗаказ.ЗаказКлиента + """! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
	//	ОтменитьТранзакцию();
	//	Возврат Неопределено;
	//КонецЕсли;
	
	Если УжеСозданныйДокумент = Неопределено ИЛИ УжеСозданныйДокумент.Лико_ЭтоОбщийЭтапНаМесяц Тогда
		УжеСозданныйДокумент = Неопределено;
		ВыпускающийЭтап = ПодобратьВыпускающийЭтапПоЗаказу(ВыборкаЗаказ.ЗаказКлиента);
	КонецЕсли;
	
	Если УжеСозданныйДокумент = Неопределено Тогда
		НовыйДокОбъект = ВыпускающийЭтап.ПолучитьОбъект();
	Иначе
		НовыйДокОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
	КонецЕсли;
	Если НовыйДокОбъект.Лико_ЭтоОбщийЭтапНаМесяц Тогда
		КоличествоЗаказовКоторыеПишутВОбщийЭтап = КоличествоЗаказовКоторыеПишутВОбщийЭтап + 1;
	КонецЕсли;

	Если НовыйДокОбъект.Статус <> Перечисления.СтатусыЭтаповПроизводства2_2.Завершен Тогда
		НовыйДокОбъект.Статус = Перечисления.СтатусыЭтаповПроизводства2_2.Начат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(НовыйДокОбъект.ФактическоеНачалоЭтапа) Тогда
		НовыйДокОбъект.ФактическоеНачалоЭтапа = Дата;
	КонецЕсли;
	НовыйДокОбъект.ПроизводствоОднойДатой = Ложь;
	Если НЕ ЗначениеЗаполнено(НовыйДокОбъект.МаршрутнаяКарта) Тогда
		НовыйДокОбъект.МаршрутнаяКарта = Справочники.Лико_ПредопределенныеЗначения.МаршрутнаяКартаУпаковка.ЗначениеПараметра;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(НовыйДокОбъект.КоэффициентМаршрутнойКарты) Тогда
		НовыйДокОбъект.КоэффициентМаршрутнойКарты = 1;
	КонецЕсли;
	Если НовыйДокОбъект.МаксимальныйКодСтрокиИзделия = 0 И НовыйДокОбъект.ВыходныеИзделия.Количество() > 0 Тогда
		ТаблицаВыходныеИздения = НовыйДокОбъект.ВыходныеИзделия.Выгрузить(,"КодСтроки");
		ТаблицаВыходныеИздения.Сортировать("КодСтроки Убыв");
		НовыйДокОбъект.МаксимальныйКодСтрокиИзделия = ТаблицаВыходныеИздения[0].КодСтроки;
	КонецЕсли;		
	
	МассивСтрокДляУдаления = Новый Массив;
	Для каждого Строка из НовыйДокОбъект.ВыходныеИзделия Цикл
		Если НЕ Строка.Произведено Тогда
			МассивСтрокДляУдаления.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Для каждого Строка из МассивСтрокДляУдаления Цикл
		НовыйДокОбъект.ВыходныеИзделия.Удалить(Строка);
	КонецЦикла;
	
	ВыборкаДетальныеЗаписи = ВыборкаЗаказ.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.КоличествоВУпаковке = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = НовыйДокОбъект.ВыходныеИзделия.Добавить();	
		НоваяСтрока.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
		НоваяСтрока.Характеристика = ВыборкаДетальныеЗаписи.Характеристика;
		НоваяСтрока.КоличествоУпаковок = ВыборкаДетальныеЗаписи.КоличествоВУпаковке;
		НоваяСтрока.Количество = ВыборкаДетальныеЗаписи.КоличествоВУпаковке;
		НоваяСтрока.Получатель = ЯчейкаПолучатель.Владелец;
		НоваяСтрока.Произведено = Истина;
		НоваяСтрока.ДатаПроизводства = Дата;
		НоваяСтрока.ДоляСтоимости = НоваяСтрока.Количество;
		НоваяСтрока.Лико_ФормированиеПаллета = Ссылка;
		НоваяСтрока.Подразделение = НовыйДокОбъект.Подразделение;
	КонецЦикла;
	
	МаксимальнаяДатаПроизводства = Дата(1,1,1);
	МинимальнаяДатаПроизводства = Дата('39991231235959');
	Для каждого Строка из НовыйДокОбъект.ВыходныеИзделия Цикл
		//Строка.ДоляСтоимости = Строка.Количество;
		МаксимальнаяДатаПроизводства = Макс(МаксимальнаяДатаПроизводства, Строка.ДатаПроизводства);
		МинимальнаяДатаПроизводства = Мин(МинимальнаяДатаПроизводства, Строка.ДатаПроизводства);
	КонецЦикла;
	МаксимальнаяДатаПроизводства = Макс(МаксимальнаяДатаПроизводства, Дата);
	НовыйДокОбъект.ФактическоеОкончаниеЭтапа = МаксимальнаяДатаПроизводства;
	Если НовыйДокОбъект.ФактическоеНачалоЭтапа > МинимальнаяДатаПроизводства Тогда
		НовыйДокОбъект.ФактическоеНачалоЭтапа = МинимальнаяДатаПроизводства;		
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("Лико_НеРассчитыватьНормативныйГрафик") ИЛИ КоличествоЗаказовКоторыеПишутВОбщийЭтап > 1 Тогда
		НовыйДокОбъект.ДополнительныеСвойства.Вставить("Лико_НеРассчитыватьНормативныйГрафик", Истина);
	КонецЕсли;	
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция СоздатьПередачуПродукции(НовыйЭтапСсылка, Заказ, УжеСозданныйДокумент)
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	//ОбъектыОснований = Новый Массив;
	//ОбъектыОснований.Добавить(НовыйЭтапСсылка);
	//
	//ПараметрыОткрытия = ПроизводствоВызовСервера.ПараметрыСозданияДвиженияПродукцииИМатериаловНаОсновании(
	//ОбъектыОснований,
	//ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства"));
	
	НовыйДокОбъект = Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент();
	
	//НовыйДокОбъект.Заполнить(ПараметрыОткрытия.Основание);
	НовыйДокОбъект.Дата = Дата;
	НовыйДокОбъект.Организация = НовыйЭтапСсылка.Организация;
	НовыйДокОбъект.Отправитель = НовыйЭтапСсылка.Подразделение;
	НовыйДокОбъект.Получатель = ЯчейкаПолучатель.Владелец;
	НовыйДокОбъект.Распоряжение = НовыйЭтапСсылка;
	НовыйДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + Ссылка + """";
	НовыйДокОбъект.ПоРаспоряжениям = Истина;
	НовыйДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства;
	НовыйДокОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	НовыйДокОбъект.Статус = Перечисления.СтатусыДвиженияПродукцииИМатериалов.Принято;
	НовыйДокОбъект.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
	
	Для каждого Строка из НовыйЭтапСсылка.ВыходныеИзделия Цикл
		Если Строка.Лико_ФормированиеПаллета = Ссылка И Строка.Характеристика.Лико_ЗаказНоменклатуры = Заказ Тогда
			НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "Номенклатура,Характеристика,Количество,КоличествоУпаковок,КодСтроки");
			НоваяСтрока.НазначениеОтправителя = НовыйЭтапСсылка.Назначение;
			НоваяСтрока.Распоряжение = НовыйЭтапСсылка;
		КонецЕсли;
	КонецЦикла;
	
	//// Удалим из передачи те строки, которые не соответствуют текущему формированию паллета
	//МассивКодовСтрокЭтапа = Новый Массив;
	//Для каждого СтрокаТЧ из НовыйЭтапСсылка.ВыходныеИзделия Цикл
	//	Если СтрокаТЧ.Лико_ФормированиеПаллета = Ссылка Тогда
	//		МассивКодовСтрокЭтапа.Добавить(СтрокаТЧ.КодСтроки);
	//	КонецЕсли;
