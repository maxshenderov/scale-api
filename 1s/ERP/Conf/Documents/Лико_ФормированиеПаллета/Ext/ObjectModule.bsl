	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция _СоздатьДокументКорректировкаРегистровУпрощенныйРежим(УжеСозданныйДокумент = Неопределено, ТаблицаПриход = Неопределено, ТаблицаРасход = Неопределено)
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	Склад = ЯчейкаПолучатель.Владелец;

	НовыйДокОбъект = Документы.ПриходныйОрдерНаТовары.СоздатьДокумент();
	НовыйДокОбъект.Дата = Дата;
	НовыйДокОбъект.Склад = Склад;    
	НовыйДокОбъект.Распоряжение = Документы.ЭтапПроизводства2_2.ПустаяСсылка(); // Без него не открывается форма
	НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + Ссылка + """"; 
	НовыйДокОбъект.Проведен = Истина;
	НовыйДокОбъект.ОбменДанными.Загрузка = Истина;
	НовыйДокОбъект.УстановитьНовыйНомер();
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НаборЗаписейТоварыНаСкладах = РегистрыНакопления.ТоварыНаСкладах.СоздатьНаборЗаписей();
	НаборЗаписейТоварыНаСкладах.Отбор.Регистратор.Установить(НовыйДокОбъект.Ссылка);	
	НаборЗаписейТоварыНаСкладах.Прочитать();
		
	НаборЗаписейТоварыВЯчейках = РегистрыНакопления.ТоварыВЯчейках.СоздатьНаборЗаписей();
	НаборЗаписейТоварыВЯчейках.Отбор.Регистратор.Установить(НовыйДокОбъект.Ссылка);	
	НаборЗаписейТоварыВЯчейках.Прочитать();
		
	УпаковкаТысШт = Справочники.Лико_ПредопределенныеЗначения.УпаковкаТысШт.ЗначениеПараметра;
	Если ТаблицаПриход = Неопределено Тогда
		Для каждого Строка из Содержимое Цикл
			Движение = НаборЗаписейТоварыНаСкладах.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = НовыйДокОбъект.Дата;
			Движение.Склад = Склад;
			Движение.Серия = Строка.Серия; 
			Движение.Характеристика = Движение.Серия.Лико_ХарактеристикаВладелец;
			Движение.Номенклатура = Движение.Характеристика.Владелец;
			Движение.ВНаличии = Движение.Серия.Лико_КоличествоВУпаковке;

			Движение = НаборЗаписейТоварыВЯчейках.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = НовыйДокОбъект.Дата;
			Движение.Упаковка = УпаковкаТысШт;
			Движение.Ячейка = ЯчейкаПолучатель;
			Движение.Серия = Строка.Серия; 
			Движение.Характеристика = Движение.Серия.Лико_ХарактеристикаВладелец;
			Движение.Номенклатура = Движение.Характеристика.Владелец;
			Движение.ВНаличии = Движение.Серия.Лико_КоличествоВУпаковке;
		КонецЦикла;
	Иначе
		Для каждого Строка из ТаблицаПриход Цикл
			Движение = НаборЗаписейТоварыНаСкладах.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = НовыйДокОбъект.Дата;
			Движение.Склад = Склад;
			Движение.Серия = Строка.Серия; 
			Движение.Характеристика = Строка.Характеристика;
			Движение.Номенклатура = Строка.Номенклатура;
			Движение.ВНаличии = Строка.Количество;

			Движение = НаборЗаписейТоварыВЯчейках.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = НовыйДокОбъект.Дата;
			Движение.Упаковка = Строка.Упаковка;
			Движение.Ячейка = ЯчейкаПолучатель;
			Движение.Серия = Строка.Серия; 
			Движение.Характеристика = Строка.Характеристика;
			Движение.Номенклатура = Строка.Номенклатура;
			Движение.ВНаличии = Строка.Количество;
		КонецЦикла;
	КонецЕсли;

	Если ТаблицаРасход = Неопределено Тогда		
		Для каждого Строка из СодержимоеРастарки Цикл
			Движение = НаборЗаписейТоварыНаСкладах.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = НовыйДокОбъект.Дата;
			Движение.Склад = Склад;
			Движение.Серия = Строка.Серия; 
			Движение.Характеристика = Движение.Серия.Лико_ХарактеристикаВладелец;
			Движение.Номенклатура = Движение.Характеристика.Владелец;
			Движение.ВНаличии = Движение.Серия.Лико_КоличествоВУпаковке;

			Движение = НаборЗаписейТоварыВЯчейках.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = НовыйДокОбъект.Дата;
			Движение.Упаковка = УпаковкаТысШт;
			Движение.Ячейка = ЯчейкаРастарка;
			Движение.Серия = Строка.Серия; 
			Движение.Характеристика = Движение.Серия.Лико_ХарактеристикаВладелец;
			Движение.Номенклатура = Движение.Характеристика.Владелец;
			Движение.ВНаличии = Движение.Серия.Лико_КоличествоВУпаковке;
		КонецЦикла;
	Иначе
		Для каждого Строка из ТаблицаРасход Цикл
			Движение = НаборЗаписейТоварыНаСкладах.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = НовыйДокОбъект.Дата;
			Движение.Склад = Склад;
			Движение.Серия = Строка.Серия; 
			Движение.Характеристика = Строка.Характеристика;
			Движение.Номенклатура = Строка.Номенклатура;
			Движение.ВНаличии = Строка.Количество;

			Движение = НаборЗаписейТоварыВЯчейках.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = НовыйДокОбъект.Дата;
			Движение.Упаковка = Строка.Упаковка;
			Движение.Ячейка = ЯчейкаРастарка;
			Движение.Серия = Строка.Серия; 
			Движение.Характеристика = Строка.Характеристика;
			Движение.Номенклатура = Строка.Номенклатура;
			Движение.ВНаличии = Строка.Количество;
		КонецЦикла;
	КонецЕсли;
	
	НаборЗаписейТоварыНаСкладах.Записать();
	НаборЗаписейТоварыВЯчейках.Записать();

	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	НачатьТранзакцию();
	// <-- Начало Лико Яцун С. В. 26.09.2025 
	Если Площадка = Справочники.Лико_Площадки.Линкс И ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции И НЕ ВыпускИзРастарки Тогда 
		УдалитьЗаписиДвиженияПеремотки();
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 26.09.2025 
	//Пометим на удаление связанные типовые документы
	КлючиСтруктурыБезЭтапа = Лико_Дополнительно.ПолучитьКлючиСтруктурыБезДокумента(КлючиСтруктуры, "ЭтапПроизводства2_2");
	СтруктураТиповыхДокументов = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(Истина,, КлючиСтруктурыБезЭтапа, Ссылка);
	Если СтруктураТиповыхДокументов = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;
	
	// Удалим из этапа строки выпуска, соответствующие этому формированию паллета
	Если ДополнительныеСвойства.Свойство("Лико_НеРассчитыватьНормативныйГрафик") Тогда
		ДопСвойстваЭтапа = Новый Структура("Лико_НеРассчитыватьНормативныйГрафик", Истина);
	Иначе
		ДопСвойстваЭтапа = Неопределено;
	КонецЕсли;
	Результат = Лико_Дополнительно.УдалитьИзЭтаповСтрокиВыпускаПоСвязанномуФормированиюПаллета(Ссылка, ДопСвойстваЭтапа);
	Если НЕ Результат Тогда
		Отказ = Истина;
	КонецЕсли;
	
	// Удалим запись из Лико_ЭтапыЗаказа
	ИспользованиеРеквизитаДокументВРегистреЭтапыЗаказа = Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияРеквизитаДокументВРегистреЭтапыЗаказа.ЗначениеПараметра <= ?(ЗначениеЗаполнено(ДатаФормирования), ДатаФормирования, Дата);
	Если ИспользованиеРеквизитаДокументВРегистреЭтапыЗаказа Тогда
		Лико_Дополнительно.УдалитьЗаписиИзРегистраЛико_ЭтапыЗаказовПоДокументу(Ссылка);
	КонецЕсли;
	ТаблицаЗаказов = Новый ТаблицаЗначений;
	ТаблицаЗаказов.Колонки.Добавить("Заказ");
	Для каждого Строка из Содержимое Цикл
		НоваяСтрока = ТаблицаЗаказов.Добавить();
		НоваяСтрока.Заказ = Строка.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры;
	КонецЦикла;
	ТаблицаЗаказов.Свернуть("Заказ");
	Для каждого Строка из ТаблицаЗаказов Цикл
		Если НЕ ИспользованиеРеквизитаДокументВРегистреЭтапыЗаказа Тогда
			МенеджерЗаписи = РегистрыСведений.Лико_ЭтапыЗаказа.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = ?(ЗначениеЗаполнено(ДатаФормирования), ДатаФормирования, Дата);
			МенеджерЗаписи.Заказ = Строка.Заказ;
			МенеджерЗаписи.Площадка = Строка.Заказ.Площадка;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Этап = Справочники.Лико_ЭтапыВыполненияЗаказа.Упаковка Тогда
				Попытка
					МенеджерЗаписи.Удалить();	
				Исключение
					Сообщить("Не удалось удалить запись из регистра ""лк Этапы заказа"": " + ОписаниеОшибки());
					Отказ = Истина;
					Прервать;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		Лико_Дополнительно.ОбновитьВЗаказеСреднееКоличествоВКоробкеИРолике(Строка.Заказ, Ссылка, Истина, Истина);
	КонецЦикла;	

	//Если ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции Тогда
	//	// Удалим записи из документа Лико_ДвиженияЗаказаПоЭтапам
	//	Лико_Дополнительно.УдалитьЗаписиИзДокументаЛико_ДвиженияЗаказаПоЭтапам(XMLСтрока(Ссылка));
	//КонецЕсли;
		
	Если НЕ Отказ Тогда
		ЗафиксироватьТранзакцию();	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Площадка) Тогда
		Сообщить("В документе """ + Ссылка + """ не заполнена площадка");
		Отказ = Истина;
	КонецЕсли;
	
	Если Площадка.Организация <> Организация Тогда
		Организация = Площадка.Организация;
	КонецЕсли;
	
	Если СозданНаОснованииПолученияГПИзПроизводства И НЕ РольДоступна("ПолныеПрава") И НЕ ДополнительныеСвойства.Свойство("Лико_СозданиеИзПолученияГПИзПроизводства") Тогда
		Сообщить("Документ создан на основании " + Метаданные.Документы.Лико_ПолучениеГПИзПроизводства.Представление() + ", корректировка запрещена");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка)
		И Ссылка.Проведен
		И НЕ РольДоступна("ПолныеПрава")
		И НЕ ДополнительныеСвойства.Свойство("ОтключитьЧастьПроверок")
		Тогда
		Сообщить("Запрещено корректировать проведенный документ");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТипДокумента) Тогда
		Отказ = Истина;
		Сообщить("В документе """ + Ссылка + """ не заполнен тип документа. Запись невозможна.");
	КонецЕсли;
	
	РастаркаПоВерсии3 = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДата()) >= Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияНовойСхемыРастаркиВерсия3.ЗначениеПараметра И НЕ РастаркаПоСтаройСхемеВерсии2;
	
	Если РастаркаПоВерсии3 Тогда
		// Сбросим признак выпуска из растарки, т.к. он будет установлен ниже
		ВыпускИзРастарки = Ложь;
	КонецЕсли;
	
	Если ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции и РастаркаПоВерсии3 Тогда
		МассивТипов = Новый Массив;
		МассивСкладов = Новый Массив;
		МассивРаспоряжений = Новый Массив;
		СкладПолучатель = ЯчейкаПолучатель.Владелец;
		Для каждого Строка из Содержимое Цикл
			ТекущееРаспоряжение = Строка.Серия.Лико_РаспоряжениеНаРастарку;
			МассивТипов.Добавить(?(ЗначениеЗаполнено(ТекущееРаспоряжение), "Растарка", "Не растарка"));
			Если ЗначениеЗаполнено(ТекущееРаспоряжение) Тогда
				ВыпускИзРастарки = Истина;
			КонецЕсли;
			МассивРаспоряжений.Добавить(ТекущееРаспоряжение);
			МассивСкладов.Добавить(ТекущееРаспоряжение.СкладПолучатель);
		КонецЦикла;
		МассивТипов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивТипов);
		МассивРаспоряжений = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивРаспоряжений);
		МассивСкладов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСкладов);
		Если МассивТипов.Количество() > 1 Тогда
			Сообщить("В документе содержатся коробки из растарки и новые коробки. Необходимо разделить документ:");
			Отказ = Истина;
			Для каждого Строка из Содержимое Цикл
				Сообщить("" + Строка.Серия + ?(ЗначениеЗаполнено(Строка.Серия.Лико_РаспоряжениеНаРастарку), " из растарки", " новая"));
			КонецЦикла;
		КонецЕсли;
		Если НЕ Отказ И ВыпускИзРастарки Тогда
			Если МассивСкладов.Количество() > 1 Тогда
				Сообщить("В документе содержатся коробки растарки по разным складам. Необходимо разделить документ:");
				Отказ = Истина;
				Для каждого Строка из Содержимое Цикл
					Сообщить("" + Строка.Серия + " - склад """ + Строка.Серия.Лико_РаспоряжениеНаРастарку.СкладПолучатель + """");
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		Если НЕ Отказ И ВыпускИзРастарки Тогда
			Если ЯчейкаПолучатель.Владелец <> МассивСкладов[0] Тогда
				ЯчейкаРастарка = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, МассивСкладов[0], "ЯчейкаРастарка");
				ЯчейкаПолучатель = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, МассивСкладов[0], "ЯчейкаХранениеПоУмолчанию");
			КонецЕсли;
		КонецЕсли;
		Если НЕ Отказ И ВыпускИзРастарки И ЯчейкаРастарка.Владелец.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараКлиентаУНас Тогда
			Если МассивРаспоряжений.Количество() > 1 Тогда
				Сообщить("В документе содержатся коробки растарки Ангара по разным распоряжениям. Необходимо разделить документ:");
				Отказ = Истина;
				Для каждого Строка из Содержимое Цикл
					Сообщить("" + Строка.Серия + " - распоряжение """ + Строка.Серия.Лико_РаспоряжениеНаРастарку + """");
				КонецЦикла;
			Иначе
				РаспоряжениеНаРастарку = МассивРаспоряжений[0];
			КонецЕсли;
		КонецЕсли;			
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) И Ссылка.Проведен И РежимЗаписи = РежимЗаписиДокумента.Проведение И (Ссылка.ТипДокумента <> ТипДокумента ИЛИ Ссылка.РаспоряжениеНаРастарку <> РаспоряжениеНаРастарку ИЛИ Ссылка.ВыпускИзРастарки <> ВыпускИзРастарки) Тогда
		Отказ = Истина;
		Сообщить("" + Ссылка + ": нельзя менять тип документа (или распоряжение на растарку) у проведенного документа. Сначала распроведите документ.");
	КонецЕсли;
	
	Если Дата >= Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияНовойСхемыРастарки.ЗначениеПараметра Тогда
		Если ВыпускИзРастарки И НЕ ЗначениеЗаполнено(РаспоряжениеНаРастарку) И Дата < Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияНовойСхемыРастаркиВерсия3.ЗначениеПараметра Тогда
			Отказ = Истина;
			Сообщить("Необходимо просканировать распоряжение на растарку");
		КонецЕсли;
		
		Если ВыпускИзРастарки И НЕ ЗначениеЗаполнено(ЯчейкаРастарка) Тогда
			Отказ = Истина;
			Сообщить("Необходимо заполнить ячейку-растарку");
		КонецЕсли;
	
		Если ЗначениеЗаполнено(ЯчейкаРастарка) И ЯчейкаРастарка.Владелец <> ЯчейкаПолучатель.Владелец Тогда
			Отказ = Истина;
			Сообщить("Склады ячейки-растарки и ячейки-получателя должны совпадать");
		КонецЕсли;
	КонецЕсли;
	
	Если ЯчейкаПолучатель.Владелец.Лико_ТипСклада <> Перечисления.Лико_ТипСклада.ГП Тогда
		Отказ = Истина;
		Сообщить("В данном документе можно выбирать только склады с типом ""ГП""");
	КонецЕсли;
	
	Если ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ПеремещениеСНеордерногоСклада И НЕ ЗначениеЗаполнено(СкладОтправитель) Тогда
		Отказ = Истина;
		Сообщить("Для типа документа """ + ТипДокумента + """ небходимо заполнить неордерный склад-отправитель");
	КонецЕсли;
	
	Если ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции И ЗначениеЗаполнено(Ссылка) И НЕ РольДоступна("ПолныеПрава") И НЕ ДополнительныеСвойства.Свойство("ОтключитьЧастьПроверок") Тогда
		УстановитьПривилегированныйРежим(Истина);
		// Проверим, не содержатся ли коробки из формирования в отгрузках
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка КАК Ссылка,
			|	Лико_ЗаявкаНаТранспортировкуПродукция.Серия КАК Серия
			|ИЗ
			|	Документ.Лико_ЗаявкаНаТранспортировку.Продукция КАК Лико_ЗаявкаНаТранспортировкуПродукция
			|ГДЕ
			|	Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка.Проведен
			|	И Лико_ЗаявкаНаТранспортировкуПродукция.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаявокНаТранспортировку.Закрыт)
			|	И Лико_ЗаявкаНаТранспортировкуПродукция.Мест > 0
			|	И Лико_ЗаявкаНаТранспортировкуПродукция.Серия В(&МассивСерий)";
		
		Запрос.УстановитьПараметр("МассивСерий", Ссылка.Содержимое.ВыгрузитьКолонку("Серия"));
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Отказ = Истина;
			Сообщить("Коробка """ + ВыборкаДетальныеЗаписи.Серия + """ уже содержится в отгрузке """ + ВыборкаДетальныеЗаписи.Ссылка + """. Корректировка документа невозможна");
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);		
	КонецЕсли;

	//Если РастаркаПоВерсии3 Тогда
	Если Дата >= Дата('20200828110000') И ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.Переупаковка И НЕ РольДоступна("ПолныеПрава") Тогда
		// Проверим, чтобы ячейка-получатель и ячейка-растарка отличались
		Если ЯчейкаПолучатель = ЯчейкаРастарка Тогда
			Отказ = Истина;
			//Сообщить("Используется новая схема растарки (версия 3), поэтому формировать паллеты сразу в ячейку-растарку больше нельзя. Вы можете просканировать коробки сразу в перемещение паллета");
			Сообщить("Формировать паллеты сразу в ячейку-растарку больше нельзя. Вы можете просканировать коробки в перемещение паллета");
		КонецЕсли;
	КонецЕсли;

	Если ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции И Содержимое.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Площадка КАК Площадка
			|ИЗ
			|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
			|ГДЕ
			|	СерииНоменклатуры.Ссылка В(&МассивСерий)
			|
			|СГРУППИРОВАТЬ ПО
			|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Площадка";
		
		Запрос.УстановитьПараметр("МассивСерий", Содержимое.ВыгрузитьКолонку("Серия"));
		ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
		Если ВыборкаДетальныеЗаписи.Количество() > 1 Тогда
			Отказ = Истина;
			Сообщить("В документе содержатся коробки разных площадок. Необходимо разделить документ:");
			Для каждого Строка из Содержимое Цикл
				Сообщить("" + Строка.Серия + " - площадка """ + Строка.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Площадка + """");
			КонецЦикла;
		КонецЕсли;

		Если НЕ ВыпускИзРастарки И Содержимое[0].Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Площадка <> ЯчейкаПолучатель.Владелец.Лико_Площадка Тогда
			Отказ = Истина;
			Сообщить("Площадка склада не соответствует площадке выпускаемого заказа");
		КонецЕсли;
	КонецЕсли;		
	
	Если НЕ Отказ И НЕ ЗначениеЗаполнено(ДатаФормирования) Тогда
		ДатаФормирования = Дата;
	КонецЕсли;
	
	СодержимоеРастарки.Очистить();
	
	// --> Начало Лико Ефимов ЕВВ 24.01.2023
	Если НЕ Отказ 
		И ЗначениеЗаполнено(Ссылка)
		И Ссылка.ВыпускИзРастарки
		И Ссылка.Проведен
		И Ссылка.ЯчейкаРастарка.Владелец.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараКлиентаУНас Тогда
		// Очистим контрагента-владельца в сериях ссылки. Если документ потом опять проведется, то контрагент заполнится обратно в проведении
		Для каждого Строка из Ссылка.Содержимое Цикл
			Если ЗначениеЗаполнено(Строка.Серия.Лико_КонтрагентВладелецТовара) Тогда
				СерияОбъект = Строка.Серия.ПолучитьОбъект();
				СерияОбъект.Лико_КонтрагентВладелецТовара = Неопределено;
				СерияОбъект.ОбменДанными.Загрузка = Истина;
				Попытка
					СерияОбъект.Записать();
				Исключение
					Отказ = Истина;
					Сообщить("" + Ссылка + ": не удалось очистить контрагента-владельца в серии """ + СерияОбъект + """.");
					ВызватьИсключение;
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 24.01.2023

	Если НЕ ЗначениеЗаполнено(Ссылка) И ЗначениеЗаполнено(ДатаУпрощенногоПроведения) Тогда
		// Сдвинем на текущую у нового документа
		ДатаУпрощенногоПроведения = ТекущаяДата();
	КонецЕсли; 
	
	Если ТипДокумента <> Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции И ЗначениеЗаполнено(ДатаУпрощенногоПроведения) Тогда
		// Для НЕ выпусков это не нужно
		ДатаУпрощенногоПроведения = Неопределено;
	КонецЕсли; 
	
КонецПроцедуры

Функция СоздатьДокументОтборРазмещениеТоваров(ВыборкаСерия, УжеСозданныйДокумент = Неопределено)
	
	Отказ = Ложь;
	
	НовыйДокОбъект = Документы.ОтборРазмещениеТоваров.СоздатьДокумент();
	НовыйДокОбъект.Дата = Дата;
	НовыйДокОбъект.ВидОперации = Перечисления.ВидыОперацийОтбораРазмещенияТоваров.Перемещение;
	НовыйДокОбъект.ДатаНачалаВыполнения = Дата;
	НовыйДокОбъект.ДатаОкончанияВыполнения = Дата;
	НовыйДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	НовыйДокОбъект.Склад = ЯчейкаПолучатель.Владелец;
	НовыйДокОбъект.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.ВРаботе;
	НовыйДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + Ссылка + """";
	УпаковкаТысШт = Справочники.Лико_ПредопределенныеЗначения.УпаковкаТысШт.ЗначениеПараметра;
	
	Пока ВыборкаСерия.Следующий() Цикл
		Выборка = ВыборкаСерия.Выбрать();
		КоличествоОсталось = ВыборкаСерия.Серия.Лико_КоличествоВУпаковке;
		КоличествоОприходовать = КоличествоОсталось;
		Пока Выборка.Следующий() Цикл
			Если КоличествоОсталось <= 0 Тогда
				Прервать;
			КонецЕсли;
			Если КоличествоОсталось > Выборка.ВНаличииОстаток Тогда
				КоличествоСписываем = Выборка.ВНаличииОстаток;
			Иначе
				КоличествоСписываем = КоличествоОсталось
			КонецЕсли;
			КоличествоОсталось = КоличествоОсталось - КоличествоСписываем;
			
			НоваяСтрокаОтбор = НовыйДокОбъект.ТоварыОтбор.Добавить();
			НоваяСтрокаОтбор.Количество = КоличествоСписываем;
			НоваяСтрокаОтбор.КоличествоОтобрано = КоличествоСписываем;
			НоваяСтрокаОтбор.КоличествоУпаковок = КоличествоСписываем;
			НоваяСтрокаОтбор.КоличествоУпаковокОтобрано = КоличествоСписываем;
			НоваяСтрокаОтбор.Номенклатура = Выборка.Номенклатура;
			//НоваяСтрокаОтбор.Упаковка = Лико_Дополнительно.ПолучитьУпаковкуПоУмолчаниюДляВидаНоменклатуры(НоваяСтрокаОтбор.Номенклатура.ВидНоменклатуры);
			НоваяСтрокаОтбор.Упаковка = УпаковкаТысШт;
			НоваяСтрокаОтбор.Характеристика = Выборка.Характеристика;
			НоваяСтрокаОтбор.Ячейка = Выборка.Ячейка;
			НоваяСтрокаОтбор.ВесУпаковки = 1;
			НоваяСтрокаОтбор.Серия = Выборка.Серия;
			НоваяСтрокаОтбор.СтатусУказанияСерий = 8;
		КонецЦикла;
		
		НоваяСтрокаРазмещение = НовыйДокОбъект.ТоварыРазмещение.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРазмещение, НоваяСтрокаОтбор,,"Ячейка");
		НоваяСтрокаРазмещение.Ячейка = ЯчейкаПолучатель;
		НоваяСтрокаРазмещение.Количество = КоличествоОприходовать;
		НоваяСтрокаРазмещение.КоличествоРазмещено = КоличествоОприходовать;
		НоваяСтрокаРазмещение.КоличествоУпаковок = КоличествоОприходовать;
		НоваяСтрокаРазмещение.КоличествоУпаковокРазмещено = КоличествоОприходовать;
	КонецЦикла;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		//чтобы отработали проверки при проведении отбора, его сперва нужно провести в статусе "В работе" или "Подготовлено", а уже потом в статусе "Выполнено без ошибок"
		//(если провести сразу в статусе "Выполнено без ошибок", то проверок не будет и документ без проблем проведется)
		Если НЕ ОтключитьЧастьПроверок Тогда
			// С такими проверками невозможно перепровести документ задним числом (если коробки после этого имеют другие движения), закомментим пока
			//НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		//меняем статус и проводим еще раз
		НовыйДокОбъект.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.ВыполненоБезОшибок;
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//Сообщить(?(УжеСозданныйДокумент = Неопределено, "Создан", "Перезаполнен") + " документ """ + НовыйДокОбъект + """");
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция НайтиПоследнийЭтапВЦепочкеЗаказаНаПроизводство(ЗаказНаПроизводство)
	
	
КонецФункции

Процедура ПроверитьВыпускающийЭтапПоДатам(ЭтапСсылка)
	
	Если ЭтапСсылка.ВыходныеИзделия.НайтиСтроки(Новый Структура("Произведено", Истина)).Количество() > 0 И ЭтапСсылка.ПроизводствоОднойДатой И ЗначениеЗаполнено(ЭтапСсылка.ДатаПроизводства) Тогда
		МинДатаПроизводства = ЭтапСсылка.ДатаПроизводства;
	Иначе
		// Получим дату производства первой коробки
		МинДатаПроизводства = Дата('39991231');
		Для каждого Строка из ЭтапСсылка.ВыходныеИзделия Цикл
			Если Строка.Произведено И ЗначениеЗаполнено(Строка.ДатаПроизводства) Тогда
				МинДатаПроизводства = Мин(МинДатаПроизводства, Строка.ДатаПроизводства);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// 20181003 если по заказу был документ "Бланк этапа" с недавней датой, то нужно писать коробки в первоначальный этап
	ДатаПоследнегоБланка = ПолучитьДатуПоследнегоБланкаЭтапаПоЗаказу(Лико_Дополнительно.НайтиЗаказКлиентаПоЭтапу(ЭтапСсылка));
	// --> Начало Лико Ефимов ЕВВ 15.01.2026 Сравним не месяц, а квартал
	СравниваемаяДата = КонецКвартала(Макс(МинДатаПроизводства, ДатаПоследнегоБланка));
	
	ДатаНачалаДня = НачалоДня(Дата);
	// Если с момента производства первой коробки прошло больше 25 дней и уже наступил следующий месяц, то будем искать другой этап (общий на весь месяц для таких случаев)
	Если СравниваемаяДата < ДатаНачалаДня - Справочники.Лико_ПредопределенныеЗначения.КоличествоДнейСМоментаПервогоВыпускаДоМоментаВыпускаЧерезОбщийЭтап.ЗначениеПараметра*86400 Тогда
		ЭтапСсылка = Лико_Дополнительно.НайтиИлиСоздатьОбщийВыпускающийЭтапНаМесяц(Организация, Дата, Подразделение, Содержимое[0].Серия.Лико_ХарактеристикаВладелец, ЯчейкаПолучатель.Владелец);		
	КонецЕсли;
					
КонецПроцедуры

Функция УдалитьОднуСериюИзФормированияПаллета(СерияДляУдаления) Экспорт
	
	Если Содержимое.Найти(СерияДляУдаления, "Серия") = Неопределено Тогда
		Сообщить("Серии """ + СерияДляУдаления + """ нет в документе """ + Ссылка + """");
		Возврат Ложь;
	КонецЕсли;
	ТекущийЗаказ = СерияДляУдаления.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Т.Серия КАК Серия
	|ПОМЕСТИТЬ ВТ_ТаблицаСгруппирована
	|ИЗ
	|	Документ.Лико_ФормированиеПаллета.Содержимое КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка
	|	И Т.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры = &Заказ
	|	И Т.Серия <> &Серия
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаСгруппирована.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры КАК ЗаказКлиента,
	|	ПОДСТРОКА(ВТ_ТаблицаСгруппирована.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Номер, 5, 7) КАК НомерЗаказа,
	|	ВТ_ТаблицаСгруппирована.Серия.Лико_ХарактеристикаВладелец.Владелец КАК Номенклатура,
	|	ВТ_ТаблицаСгруппирована.Серия.Лико_ХарактеристикаВладелец КАК Характеристика,
	|	ВТ_ТаблицаСгруппирована.Серия КАК Серия,
	|	ВТ_ТаблицаСгруппирована.Серия.Лико_КоличествоВУпаковке КАК КоличествоВУпаковке
	|ПОМЕСТИТЬ ВТ_ДанныеСЗаказом
	|ИЗ
	|	ВТ_ТаблицаСгруппирована КАК ВТ_ТаблицаСгруппирована
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеСЗаказом.ЗаказКлиента КАК ЗаказКлиента,
	|	ВТ_ДанныеСЗаказом.НомерЗаказа КАК НомерЗаказа,
	|	ВТ_ДанныеСЗаказом.Номенклатура КАК Номенклатура,
	|	ВТ_ДанныеСЗаказом.Характеристика КАК Характеристика,
	|	ВТ_ДанныеСЗаказом.Серия КАК Серия,
	|	ВТ_ДанныеСЗаказом.КоличествоВУпаковке КАК КоличествоВУпаковке
	|ИЗ
	|	ВТ_ДанныеСЗаказом КАК ВТ_ДанныеСЗаказом
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеСЗаказом.ЗаказКлиента КАК ЗаказКлиента,
	|	ВТ_ДанныеСЗаказом.НомерЗаказа КАК НомерЗаказа,
	|	ВТ_ДанныеСЗаказом.Номенклатура КАК Номенклатура,
	|	ВТ_ДанныеСЗаказом.Характеристика КАК Характеристика,
	|	СУММА(ВТ_ДанныеСЗаказом.КоличествоВУпаковке) КАК КоличествоВУпаковке
	|ИЗ
	|	ВТ_ДанныеСЗаказом КАК ВТ_ДанныеСЗаказом
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеСЗаказом.ЗаказКлиента,
	|	ВТ_ДанныеСЗаказом.НомерЗаказа,
	|	ВТ_ДанныеСЗаказом.Номенклатура,
	|	ВТ_ДанныеСЗаказом.Характеристика
	|ИТОГИ
	|	СУММА(КоличествоВУпаковке)
	|ПО
	|	ЗаказКлиента";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Заказ", ТекущийЗаказ);
	Запрос.УстановитьПараметр("Серия", СерияДляУдаления);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаСерии = РезультатыЗапроса[РезультатыЗапроса.Количество()-2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаЗаказ = РезультатыЗапроса[РезультатыЗапроса.Количество()-1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТаблицаНовыхДокументов = Новый ТаблицаЗначений;
	ТаблицаНовыхДокументов.Колонки.Добавить("Заказ");
	ТаблицаНовыхДокументов.Колонки.Добавить("Документ");
	ТаблицаНовыхДокументов.Колонки.Добавить("Номенклатура");
	
	ОтключитьЧастьПроверок = Неопределено;
	ДополнительныеСвойства.Свойство("ОтключитьЧастьПроверок", ОтключитьЧастьПроверок);
	ОтключитьЧастьПроверок = ?(ОтключитьЧастьПроверок = Неопределено, Ложь, ОтключитьЧастьПроверок);
	
	НачатьТранзакцию();
	// Сначала найдем уже сформированные типовые документы, распроведем их и будем заполнять заново
	// + искать будем с отбором по заказу серии
	КлючиСтруктурыБезЭтапа = Лико_Дополнительно.ПолучитьКлючиСтруктурыБезДокумента(КлючиСтруктуры, "ЭтапПроизводства2_2");
	Отбор = Новый Структура("Заказ", ТекущийЗаказ);
	СтруктураТиповыхДокументов = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(Истина, Отбор, КлючиСтруктурыБезЭтапа, Ссылка);
	Если СтруктураТиповыхДокументов = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Удалим из этапа строки выпуска, соответствующие этому формированию паллета
	// + заказу серии
	Результат = Лико_Дополнительно.УдалитьИзЭтаповСтрокиВыпускаПоСвязанномуФормированиюПаллета(Ссылка, Новый Структура("Лико_НеРассчитыватьНормативныйГрафик", Истина), ТекущийЗаказ);
	Если НЕ Результат Тогда
		Отказ = Истина;
	КонецЕсли;
		
	Если ВыборкаЗаказ.Следующий() Тогда
		
		// Еще остались серии по этому заказу
		
		ОтборТиповыхДокументов = Новый Структура("Заказ", ВыборкаЗаказ.ЗаказКлиента); 
		СтруктураТиповыхДокументов = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(,ОтборТиповыхДокументов, КлючиСтруктуры, Ссылка, Ложь);
		Если СтруктураТиповыхДокументов = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		//Создаем этап для заказа на выпуск продукции
		НовыйЭтапСсылка = СоздатьЭтап(ВыборкаЗаказ, СтруктураТиповыхДокументов.ЭтапПроизводства2_2);
		Если НовыйЭтапСсылка = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		//Создаем передачу продукции на склад
		НовыйДокументПередачаНаСкладСсылка = СоздатьПередачуПродукции(НовыйЭтапСсылка, ВыборкаЗаказ.ЗаказКлиента, СтруктураТиповыхДокументов.ДвижениеПродукцииИМатериалов);
		Если НовыйДокументПередачаНаСкладСсылка = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		//Создаем приходный ордер - тут уже будут серии
		НовыйДокументПриходныйОрдерСсылка = Неопределено;
		Если ЯчейкаПолучатель.ТипСкладскойЯчейки = Перечисления.ТипыСкладскихЯчеек.Приемка Тогда
			Приемка = ЯчейкаПолучатель;
		Иначе
			Приемка = Лико_Дополнительно.ПолучитьЗонуПриемкиПоСкладу(ЯчейкаПолучатель.Владелец);
		КонецЕсли;
		
		НовыйДокументПриходныйОрдерСсылка = СоздатьПриходныйОрдер(НовыйЭтапСсылка, ВыборкаСерии, Приемка, СтруктураТиповыхДокументов.ПриходныйОрдерНаТовары);
		Если НовыйДокументПриходныйОрдерСсылка = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если ЯчейкаПолучатель <> Приемка Тогда
			НовыйДокументРазмещениеТоваровСсылка = Лико_Дополнительно.СоздатьРазмещениеТоваровНаОснованииПриходногоОрдера(НовыйДокументПриходныйОрдерСсылка, СтруктураТиповыхДокументов.ОтборРазмещениеТоваров_Размещение, ЯчейкаПолучатель);
			Если НовыйДокументРазмещениеТоваровСсылка = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		
		МассивТиповыхДокументов = Новый Массив;
		МассивТиповыхДокументов.Добавить(НовыйЭтапСсылка);
		МассивТиповыхДокументов.Добавить(НовыйДокументПередачаНаСкладСсылка);
		МассивТиповыхДокументов.Добавить(НовыйДокументПриходныйОрдерСсылка);
		МассивТиповыхДокументов.Добавить(НовыйДокументРазмещениеТоваровСсылка);
		Для каждого Строка из МассивТиповыхДокументов Цикл
			НоваяСтрока = ТаблицаНовыхДокументов.Добавить();
			НоваяСтрока.Документ = Строка;
			НоваяСтрока.Заказ = ВыборкаЗаказ.ЗаказКлиента;
		КонецЦикла;
		
	Иначе
		// В документе не осталось серий по текущему заказу
		а=0;
	КонецЕсли;

	//Запишем типовые документы в регистр ЛикоСвязиСТиповымиДокументами
	Результат = Лико_Дополнительно.ЗаписатьТиповыеДокументыВРегистрЛико_СвязиСТиповымиДокументами(ТаблицаНовыхДокументов, Ссылка, ТекущийЗаказ);
	Если НЕ Результат Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Удаляем серию из Содержимого
	Содержимое.Удалить(Содержимое.Найти(СерияДляУдаления, "Серия"));
	
	// Проводим документ с доп. свойством ПровестиТолькоПоРегиструАдресноеХранение
	ДополнительныеСвойства.Вставить("ПровестиТолькоПоРегиструАдресноеХранение", Истина);
	Если Содержимое.Количество() = 0 Тогда
		// Удаляем документ
		ПометкаУдаления = Истина;
		ЭтотОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе
		ЭтотОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;

	ЗафиксироватьТранзакцию();
	Возврат Истина;	
	
КонецФункции

Функция ДанныеЗаполненияДляМодификацииЦепочки(ВыпускающийЭтап, Распоряжение, Потребность = Неопределено)

	ОбщиеРеквизиты = СтрСоединить(Документы.ЭтапПроизводства2_2.ОбщиеРеквизитыЦепочкиЭтапов(),",");
	ЗначенияЗаполнения = Новый Структура(ОбщиеРеквизиты);
	
	ЗначенияЗаполнения.Вставить("НомерПартииЗапуска");
	ЗначенияЗаполнения.Вставить("НомерЭтапаВПартииЗапуска");
	
	ВыходныеИзделия = УправлениеПроизводством.СтруктураДанныхИзделияЭтапа();
	
	Если ЗначениеЗаполнено(ВыпускающийЭтап) Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	МАКСИМУМ(ЭтапПроизводства22.НомерЭтапаВПартииЗапуска) КАК НомерЭтапаВПартииЗапуска
			|ПОМЕСТИТЬ ВТНомерЭтапаВПартииЗапуска
			|ИЗ
			|	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства22
			|ГДЕ
			|	ЭтапПроизводства22.ИдентификаторЦепочки = &ИдентификаторЦепочки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	" + ОбщиеРеквизиты + ",
			|
			|	ЭтапПроизводства22.НомерПартииЗапуска                                КАК НомерПартииЗапуска,
			|	ЕСТЬNULL(ВТНомерЭтапаВПартииЗапуска.НомерЭтапаВПартииЗапуска, 0) + 1 КАК НомерЭтапаВПартииЗапуска
			|
			|ИЗ
			|	Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства22
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНомерЭтапаВПартииЗапуска КАК ВТНомерЭтапаВПартииЗапуска
			|		ПО (ИСТИНА)
			|ГДЕ
			|	ЭтапПроизводства22.Ссылка = &ИдентификаторЦепочки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВыходныеИзделия.*,
			|	ВЫБОР
			|		КОГДА ВыходныеИзделия.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПроизводствоИзДавальческогоСырья)
			|				И ВыходныеИзделия.ЭтапПотребитель = ЗНАЧЕНИЕ(Документ.ЭтапПроизводства2_2.ПустаяСсылка)
			|				И ВыходныеИзделия.Назначение      = ВыходныеИзделия.Ссылка.НазначениеМатериалы
			|			ТОГДА ИСТИНА
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК СнятьОбособление
			|ИЗ
			|	Документ.ЭтапПроизводства2_2.ВыходныеИзделия КАК ВыходныеИзделия
			|ГДЕ
			|	ВыходныеИзделия.Ссылка = &ИдентификаторЦепочки");
		
		Запрос.УстановитьПараметр("ИдентификаторЦепочки", ВыпускающийЭтап);
		
		РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
		// ЗначенияЗаполнения
		Выборка = РезультатыЗапроса[1].Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, Выборка);
		
		// ВыходныеИзделия
		Выборка = РезультатыЗапроса[2].Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.СнятьОбособление Тогда
				ЗаполнитьЗначенияСвойств(ВыходныеИзделия.Добавить(), Выборка,,"Назначение");
			Иначе
				ЗаполнитьЗначенияСвойств(ВыходныеИзделия.Добавить(), Выборка);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		// ЗначенияЗаполнения
		ЗначенияЗаполнения.Распоряжение = Распоряжение;
		
		ЗначенияЗаполнения.Спецификация = Справочники.РесурсныеСпецификации.ПустаяСсылка();
		ЗначенияЗаполнения.Запланировано = 1;
		
		ЗначенияЗаполнения.НомерПартииЗапуска = НомераПартийЗапуска(Распоряжение).Получить(Распоряжение);
		ЗначенияЗаполнения.НомерЭтапаВПартииЗапуска = 1;
		
		Если Тип(Потребность) = Тип("Структура") Тогда
			
			КлючСхемы = УправлениеПроизводствомКлиентСервер.КлючСхемыОбособления();
				КлючСхемы.Распоряжение = Потребность.Распоряжение;
				КлючСхемы.Назначение   = Потребность.Назначение;
			СхемаОбособления = Документы.ЗаказНаПроизводство2_2.СхемаОбособленияПоКлючу(КлючСхемы);
			
			ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, СхемаОбособления);
			
			// ВыходныеИзделия
			НоваяСтрока = ВыходныеИзделия.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Потребность);
	
			ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, Новый Структура("ПересчитатьКоличествоУпаковок"), Неопределено);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ОбщиеРеквизиты", ОбщиеРеквизиты);
	Результат.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	Результат.Вставить("ВыходныеИзделия", ВыходныеИзделия);
	Возврат Результат;
	
КонецФункции

Функция НомераПартийЗапуска(Распоряжения)
	
	Результат = Новый Соответствие;
	Если ТипЗнч(Распоряжения) = Тип("Массив") Тогда
		Для каждого Ссылка Из Распоряжения Цикл
			Результат.Вставить(Ссылка, 1);
		КонецЦикла;
	Иначе
		Результат.Вставить(Распоряжения, 1);
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Распоряжение                 КАК Распоряжение,
		|	МАКСИМУМ(Т.НомерПартииЗапуска) КАК НомерПартииЗапуска
		|ИЗ
		|	Документ.ЭтапПроизводства2_2 КАК Т
		|ГДЕ
		|	Т.Распоряжение В (&Распоряжения)
		|
		|СГРУППИРОВАТЬ ПО
		|	Т.Распоряжение");
		
	Запрос.УстановитьПараметр("Распоряжения", Распоряжения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Распоряжение, Выборка.НомерПартииЗапуска + 1);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДатуПоследнегоБланкаЭтапаПоЗаказу(Заказ)
	
	ДатаБланка = Дата(1,1,1);
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лико_БланкЭтапа.Дата КАК Дата
		|ИЗ
		|	Документ.Лико_БланкЭтапа КАК Лико_БланкЭтапа
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ДвижениеПродукцииИМатериалов КАК ДвижениеПродукцииИМатериалов
		|		ПО Лико_БланкЭтапа.Ссылка = ДвижениеПродукцииИМатериалов.Лико_Документ
		|			И (ДвижениеПродукцииИМатериалов.Проведен
		|				И НЕ ДвижениеПродукцииИМатериалов.ПометкаУдаления)
		|ГДЕ
		|	Лико_БланкЭтапа.Проведен
		|	И НЕ Лико_БланкЭтапа.ПометкаУдаления
		|	И Лико_БланкЭтапа.ЗаказПокупателя = &ЗаказПокупателя
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ЗаказПокупателя", Заказ);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ДатаБланка = ВыборкаДетальныеЗаписи.Дата;
	КонецЕсли;
	
	Возврат ДатаБланка;
	
КонецФункции

Функция ПолучитьДокументыВыпускаПоДанномуРаспоряжениюНаРастарку()
	
	Если НЕ ЗначениеЗаполнено(РаспоряжениеНаРастарку) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ФормированиеПаллетаСодержимоеРастарки.Ссылка КАК Ссылка,
		|	СУММА(1) КАК КоличествоКоробокРастарки
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.Лико_ФормированиеПаллета.СодержимоеРастарки КАК Лико_ФормированиеПаллетаСодержимоеРастарки
		|ГДЕ
		|	Лико_ФормированиеПаллетаСодержимоеРастарки.Ссылка.Проведен
		|	И Лико_ФормированиеПаллетаСодержимоеРастарки.Ссылка.РаспоряжениеНаРастарку = &РаспоряжениеНаРастарку
		|	И Лико_ФормированиеПаллетаСодержимоеРастарки.Ссылка.ВыпускИзРастарки
		|	И Лико_ФормированиеПаллетаСодержимоеРастарки.Ссылка <> &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	Лико_ФормированиеПаллетаСодержимоеРастарки.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Ссылка КАК Ссылка,
		|	ВТ.КоличествоКоробокРастарки КАК КоличествоКоробокРастарки,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лико_СвязиСТиповымиДокументами.ТиповойДокумент) КАК КоличествоСборок
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_СвязиСТиповымиДокументами КАК Лико_СвязиСТиповымиДокументами
		|		ПО (ВТ.Ссылка = (ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.Документ КАК Документ.Лико_ФормированиеПаллета)))
		|			И (Лико_СвязиСТиповымиДокументами.ТиповойДокумент ССЫЛКА Документ.СборкаТоваров)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ.Ссылка,
		|	ВТ.КоличествоКоробокРастарки";
	
	Запрос.УстановитьПараметр("РаспоряжениеНаРастарку", РаспоряжениеНаРастарку);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьТаблицуСерийПоРаспоряжениюНаРастаркуВсеЕщеЛежащихВРастарке(ОпределеннаяСерия = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ПеремещениеПаллетаСодержимое.Серия КАК Серия
		|ПОМЕСТИТЬ ВТ_СерииИзРаспоряжения
		|ИЗ
		|	Документ.Лико_ПеремещениеПаллета.Содержимое КАК Лико_ПеремещениеПаллетаСодержимое
		|ГДЕ
		|	Лико_ПеремещениеПаллетаСодержимое.Ссылка = &РаспоряжениеНаРастарку
		|	И ВЫБОР
		|			КОГДА &ОпределеннаяСерия = НЕОПРЕДЕЛЕНО
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ Лико_ПеремещениеПаллетаСодержимое.Серия = &ОпределеннаяСерия
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СерииИзРаспоряжения.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Партнер КАК Партнер,
		|	ВТ_СерииИзРаспоряжения.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры КАК Заказ,
		|	ВЫРАЗИТЬ(ВТ_СерииИзРаспоряжения.Серия.Лико_ХарактеристикаВладелец.Владелец КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ВТ_СерииИзРаспоряжения.Серия.Лико_ХарактеристикаВладелец КАК Характеристика,
		|	ВТ_СерииИзРаспоряжения.Серия КАК Серия,
		|	КОЛИЧЕСТВО(ТоварыВЯчейкахОстатки.Серия) КАК Серия1,
		|	МАКСИМУМ(ТоварыВЯчейкахОстатки.ВНаличииОстаток) КАК Количество
		|ИЗ
		|	ВТ_СерииИзРаспоряжения КАК ВТ_СерииИзРаспоряжения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
		|				,
		|				Серия В
		|						(ВЫБРАТЬ
		|							Т.Серия
		|						ИЗ
		|							ВТ_СерииИзРаспоряжения КАК Т)
		|					И Ячейка = &ЯчейкаРастарка) КАК ТоварыВЯчейкахОстатки
		|		ПО ВТ_СерииИзРаспоряжения.Серия = ТоварыВЯчейкахОстатки.Серия
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СерииИзРаспоряжения.Серия,
		|	ВЫРАЗИТЬ(ВТ_СерииИзРаспоряжения.Серия.Лико_ХарактеристикаВладелец.Владелец КАК Справочник.Номенклатура),
		|	ВТ_СерииИзРаспоряжения.Серия.Лико_ХарактеристикаВладелец,
		|	ВТ_СерииИзРаспоряжения.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры,
		|	ВТ_СерииИзРаспоряжения.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Партнер";
	
	Запрос.УстановитьПараметр("РаспоряжениеНаРастарку", РаспоряжениеНаРастарку);
	Запрос.УстановитьПараметр("ЯчейкаРастарка", ЯчейкаРастарка);
	Запрос.УстановитьПараметр("ОпределеннаяСерия", ОпределеннаяСерия);
	
	ТаблицаСерий = Запрос.Выполнить().Выгрузить();
	ТаблицаСерий.Колонки.Добавить("Списано", Новый ОписаниеТипов("Булево"));
	ТаблицаСерий.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,0)));
	ТаблицаСерий.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,3)));
	ТаблицаСерий.Колонки.Добавить("СтатусУказанияСерий", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(1,0)));
	ТаблицаСерий.Колонки.Добавить("Упаковка", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	НомерСтроки = 0;
	УпаковкаПоУмолчанию = Справочники.Лико_ПредопределенныеЗначения.УпаковкаТысШт.ЗначениеПараметра;
	Для каждого Строка из ТаблицаСерий Цикл
		НомерСтроки = НомерСтроки + 1;
		Строка.НомерСтроки = НомерСтроки;
		Строка.КоличествоУпаковок = Строка.Количество;
		Строка.СтатусУказанияСерий = 8;
		Строка.Упаковка = УпаковкаПоУмолчанию;
	КонецЦикла;
	Возврат ТаблицаСерий;
	
КонецФункции

Функция СформироватьДеревоВыпуска()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ФормированиеПаллетаСодержимое.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Партнер КАК Партнер,
		|	Лико_ФормированиеПаллетаСодержимое.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры КАК Заказ,
		|	ВЫРАЗИТЬ(Лико_ФормированиеПаллетаСодержимое.Серия.Лико_ХарактеристикаВладелец.Владелец КАК Справочник.Номенклатура) КАК Номенклатура,
		|	Лико_ФормированиеПаллетаСодержимое.Серия.Лико_ХарактеристикаВладелец КАК Характеристика,
		|	Лико_ФормированиеПаллетаСодержимое.Серия КАК Серия,
		|	Лико_ФормированиеПаллетаСодержимое.Серия.Лико_КоличествоВУпаковке КАК Количество,
		|	Лико_ФормированиеПаллетаСодержимое.Серия.Лико_КоличествоВУпаковке КАК КоличествоУпаковок,
		|	8 КАК СтатусУказанияСерий,
		|	&УпаковкаПоУмолчанию КАК Упаковка
		|ИЗ
		|	Документ.Лико_ФормированиеПаллета.Содержимое КАК Лико_ФормированиеПаллетаСодержимое
		|ГДЕ
		|	Лико_ФормированиеПаллетаСодержимое.Ссылка = &Ссылка
		|ИТОГИ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Серия),
		|	СУММА(Количество),
		|	СУММА(КоличествоУпаковок)
		|ПО
		|	Номенклатура,
		|	Характеристика";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("УпаковкаПоУмолчанию", Справочники.Лико_ПредопределенныеЗначения.УпаковкаТысШт.ЗначениеПараметра);
	РезультатЗапроса = Запрос.Выполнить();
	
	ДеревоВыпуска = РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ДеревоВыпуска.Колонки.Добавить("НайденаПара", Новый ОписаниеТипов("Булево"));
	ДеревоВыпуска.Колонки.Добавить("РастариваемыеСтроки", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(1000)));
	ДеревоВыпуска.Колонки.Добавить("КоличествоНайденныхКоробок", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10,0)));
	Возврат ДеревоВыпуска;
	
КонецФункции

Процедура ОбработатьНайденныеДляРастаркиСтроки(СтрокаВыпуска, СтрокиРастарки, ДобавитьВсеСтроки = Ложь)
	
	Если СтрокиРастарки.Количество() > 0 Тогда
		// Такие коробки есть
		КоличествоОсталосьСписать = СтрокаВыпуска.Количество;
		Для каждого СтрокаРастарки Из СтрокиРастарки Цикл
			Если КоличествоОсталосьСписать <= 0 И НЕ ДобавитьВсеСтроки Тогда
				// Хватит
				Прервать;
			КонецЕсли;
			// Поставим строке выпуска признак найденной пары, а строке растарки признак "Списано"
			СтрокаВыпуска.НайденаПара = Истина;
			СтрокаВыпуска.РастариваемыеСтроки = СтрокаВыпуска.РастариваемыеСтроки + ?(ЗначениеЗаполнено(СтрокаВыпуска.РастариваемыеСтроки), ",", "") + СтрокаРастарки.НомерСтроки;
			СтрокаВыпуска.КоличествоНайденныхКоробок = СтрокаВыпуска.КоличествоНайденныхКоробок + 1;
			СтрокаРастарки.Списано = Истина;
			КоличествоОсталосьСписать = КоличествоОсталосьСписать - СтрокаРастарки.Количество;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьСборкуТоваров(УжеСозданныйДокумент, СтрокаВыпуска, ТаблицаДляРастаркиСвернута, НужнаРазборкаНераспределенныхВыпусков = Ложь, ДеревоВыпуска = Неопределено, ТаблицаСерийВыпуска)
	
	Отказ = Ложь;
	
	НовыйДокОбъект = Документы.СборкаТоваров.СоздатьДокумент();
	НовыйДокОбъект.Дата = Дата;
	НовыйДокОбъект.Количество = СтрокаВыпуска.Количество;
	НовыйДокОбъект.КоличествоУпаковок = НовыйДокОбъект.Количество;
	НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + Ссылка + """";
	НовыйДокОбъект.Номенклатура = СтрокаВыпуска.Номенклатура;
	НовыйДокОбъект.Организация = Организация; // Подумать про икс-пак
	НовыйДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	НовыйДокОбъект.Характеристика = СтрокаВыпуска.Характеристика;
	НовыйДокОбъект.Склад = ЯчейкаПолучатель.Владелец;
	НовыйДокОбъект.ДатаРаспоряжения = Дата;
	НовыйДокОбъект.Статус = Перечисления.СтатусыСборокТоваров.СобраноРазобрано;
	НовыйДокОбъект.СборкаПодДеятельность = Справочники.Организации.НалогообложениеНДС(НовыйДокОбъект.Организация, НовыйДокОбъект.Склад, Дата);
	НовыйДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СборкаТоваров;
	НовыйДокОбъект.Подразделение = Подразделение;
	НовыйДокОбъект.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
	
	Для каждого Строка из ТаблицаДляРастаркиСвернута Цикл
		НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = Строка.Номенклатура;
		НоваяСтрока.Характеристика = Строка.Характеристика;
		НоваяСтрока.Количество = Строка.Количество;
		НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
	КонецЦикла;
	
	Для каждого СтрокаСерия из СтрокаВыпуска.Строки Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаСерийВыпуска.Добавить(), СтрокаСерия);
	КонецЦикла;
	
	Если НужнаРазборкаНераспределенныхВыпусков И ТаблицаДляРастаркиСвернута.Количество() = 1 Тогда
		// Сбросим флаг
		НужнаРазборкаНераспределенныхВыпусков = Ложь;
		// Поменяем местами товары из ТЧ и из тела
		ПеределатьСборкуВРазборку(НовыйДокОбъект);
		// Добавим все выпуски, для которых не найдена пара
		Для каждого СтрокаНоменклатура из ДеревоВыпуска.Строки Цикл
			Для каждого СтрокаХарактеристика из СтрокаНоменклатура.Строки Цикл
				
				Если СтрокаХарактеристика.НайденаПара Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
				НоваяСтрока.Номенклатура = СтрокаХарактеристика.Номенклатура;
				НоваяСтрока.Характеристика = СтрокаХарактеристика.Характеристика;
				НоваяСтрока.Количество = СтрокаХарактеристика.Количество;
				НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
				НоваяСтрока.ДоляСтоимости = НоваяСтрока.Количество * 1000;

				// Добавим коробки выпуски в таблицу серий выпуска
				Для каждого СтрокаСерия из СтрокаХарактеристика.Строки Цикл
					ЗаполнитьЗначенияСвойств(ТаблицаСерийВыпуска.Добавить(), СтрокаСерия);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Если РольДоступна("ПолныеПрава") Тогда
		НовыйДокОбъект.ДополнительныеСвойства.Вставить("ОтключитьКонтрольПриПроведении", Истина);
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//Сообщить(?(УжеСозданныйДокумент = Неопределено, "Создан", "Перезаполнен") + " документ """ + НовыйДокОбъект + """");
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция СоздатьСборкуТоваровВер3(УжеСозданныйДокумент, СтрокаВыпуска, ТаблицаДляРастаркиСвернута, НужнаРазборкаНераспределенныхВыпусков = Ложь)
	
	Отказ = Ложь;
	
	НовыйДокОбъект = Документы.СборкаТоваров.СоздатьДокумент();
	НовыйДокОбъект.Дата = Дата;
	НовыйДокОбъект.Количество = СтрокаВыпуска.Количество;
	НовыйДокОбъект.КоличествоУпаковок = НовыйДокОбъект.Количество;
	НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + Ссылка + """";
	НовыйДокОбъект.Номенклатура = СтрокаВыпуска.Номенклатура;
	НовыйДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	НовыйДокОбъект.Характеристика = СтрокаВыпуска.Характеристика;
	НовыйДокОбъект.Склад = ЯчейкаПолучатель.Владелец;
	ВладелецТовараНаЭтомСкладе = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, НовыйДокОбъект.Склад, "ОрганизациявладелецТовара_45268c9975cc4604bdcfde6c95172d5f");
	Если НовыйДокОбъект.Склад.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.Регион И НЕ ЗначениеЗаполнено(ВладелецТовараНаЭтомСкладе) Тогда
		// Найдем организацию по регистру ТоварыОрганизаций
		ВладелецТовараНаЭтомСкладе = Лико_Дополнительно.ОпределитьОрганизациюВладельцаТовара(ТаблицаДляРастаркиСвернута[0].Номенклатура, ТаблицаДляРастаркиСвернута[0].Характеристика, НовыйДокОбъект.Склад, НовыйДокОбъект.Дата, УжеСозданныйДокумент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВладелецТовараНаЭтомСкладе) Тогда
		НовыйДокОбъект.Организация = ВладелецТовараНаЭтомСкладе;
	Иначе
		НовыйДокОбъект.Организация = Организация;
	КонецЕсли;
	НовыйДокОбъект.Статус = Перечисления.СтатусыСборокТоваров.СобраноРазобрано;
	НовыйДокОбъект.СборкаПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	НовыйДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СборкаТоваров;
	НовыйДокОбъект.Подразделение = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, НовыйДокОбъект.Склад, "Подразделение_8b6aafc5a2e14ba0889da315170788bd");
	НовыйДокОбъект.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
	
	Если НужнаРазборкаНераспределенныхВыпусков Тогда
		НужнаРазборкаНераспределенныхВыпусков = Ложь;
		НовыйДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РазборкаТоваров;
	КонецЕсли;
	
	Для каждого Строка из ТаблицаДляРастаркиСвернута Цикл
		НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = Строка.Номенклатура;
		НоваяСтрока.Характеристика = Строка.Характеристика;
		НоваяСтрока.Количество = Строка.Количество;
		НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
		Если НовыйДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РазборкаТоваров Тогда
			НоваяСтрока.ДоляСтоимости = НоваяСтрока.КоличествоУпаковок * 1000;
		КонецЕсли;
	КонецЦикла;
	
	//Если НужнаРазборкаНераспределенныхВыпусков Тогда
	//	// Сбросим флаг
	//	НужнаРазборкаНераспределенныхВыпусков = Ложь;
	//	НовыйДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РазборкаТоваров;
	//	// Поменяем местами товары из ТЧ и из тела
	//	//ПеределатьСборкуВРазборку(НовыйДокОбъект);
	//КонецЕсли;
	
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	//Если РольДоступна("ПолныеПрава") Тогда // не помню, зачем делал это только для полных прав. Отключил, т.к. столкнулся с проблемой при выпуске растарки по складу ОКИЛ Спб ОРД
		НовыйДокОбъект.ДополнительныеСвойства.Вставить("ОтключитьКонтрольПриПроведении", Истина);
	//КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение); 
		//Сообщить(?(УжеСозданныйДокумент = Неопределено, "Создан", "Перезаполнен") + " документ """ + НовыйДокОбъект + """");
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Процедура ПеределатьСборкуВРазборку(ДокОбъект)
	
	ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РазборкаТоваров;
	
	ТЗТовары = ДокОбъект.Товары.Выгрузить();
	
	ДокОбъект.Товары.Очистить();
	НоваяСтрока = ДокОбъект.Товары.Добавить();
	НоваяСтрока.Номенклатура = ДокОбъект.Номенклатура;
	НоваяСтрока.Характеристика = ДокОбъект.Характеристика;
	НоваяСтрока.Количество = ДокОбъект.Количество;
	НоваяСтрока.КоличествоУпаковок = ДокОбъект.Количество;
	НоваяСтрока.ДоляСтоимости = НоваяСтрока.Количество * 1000;
	
	ДокОбъект.Номенклатура = ТЗТовары[0].Номенклатура;
	ДокОбъект.Характеристика = ТЗТовары[0].Характеристика;
	ДокОбъект.Количество = ТЗТовары[0].Количество;
	ДокОбъект.КоличествоУпаковок = ТЗТовары[0].КоличествоУпаковок;
	
КонецПроцедуры

Процедура ЗаполнитьДатыВыпускаВСериях(Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Для каждого Строка из Содержимое Цикл
			Если Строка.Серия.Лико_ДатаВыпуска <> Дата Тогда
				СерияОбъект = Строка.Серия.ПолучитьОбъект();
				СерияОбъект.Лико_ДатаВыпуска = Дата;
				Попытка
					СерияОбъект.Записать();
				Исключение
					Сообщить("Не удалось записать дату выпуска в серию """ + СерияОбъект + """: " + ОписаниеОшибки());
					Отказ = Истина;
					Возврат;
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;				
	
КонецПроцедуры

Процедура ЗаполнитьВесИПлощадьВНоменклатуру(Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Лико_ФормированиеПаллетаСодержимое.Серия.Лико_ХарактеристикаВладелец.Владелец КАК Справочник.Номенклатура) КАК Номенклатура,
