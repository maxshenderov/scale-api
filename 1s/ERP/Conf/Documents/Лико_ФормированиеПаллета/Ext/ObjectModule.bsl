			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = НовыйДокОбъект.Дата;
			Движение.Склад = ЯчейкаПолучатель.Владелец;
			Движение.ВНаличии = Строка.Количество;
		КонецЦикла;
	КонецЦикла;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		Для каждого СтрокаТЧ из НовыйДокОбъект.ТаблицаРегистров Цикл
			УжеСозданныйДокументОбъект.Движения[СтрокаТЧ.Имя].Загрузить(НовыйДокОбъект.Движения[СтрокаТЧ.Имя].Выгрузить());
			УжеСозданныйДокументОбъект.Движения[СтрокаТЧ.Имя].Записать();
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

