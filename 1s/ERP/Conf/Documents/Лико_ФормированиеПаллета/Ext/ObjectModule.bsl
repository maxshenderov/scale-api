Функция СоздатьПриходныйОрдер(НовыйЭтапСсылка, ВыборкаСерии, Приемка, УжеСозданныйДокумент)
	
	Отказ = Ложь;
	Основание = Новый Структура;
	Основание.Вставить("Распоряжение",НовыйЭтапСсылка.Ссылка);
	Основание.Вставить("Отправитель",НовыйЭтапСсылка.Подразделение);
	Основание.Вставить("ЗакрыватьГрафикПоступления",Истина);
	Основание.Вставить("Склад", ЯчейкаПолучатель.Владелец);
	Основание.Вставить("Помещение", Справочники.СкладскиеПомещения.ПустаяСсылка());
	Основание.Вставить("ЗонаПриемки", Приемка);
	Основание.Вставить("ДатаВходящегоДокумента", НовыйЭтапСсылка.Дата);
	Основание.Вставить("НомерВходящегоДокумента", НовыйЭтапСсылка.Номер);
	Основание.Вставить("ДатаПоступления", Дата);
	Основание.Вставить("ХозяйственнаяОперация", Перечисления.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства);
	
	НовыйДокОбъект = Документы.ПриходныйОрдерНаТовары.СоздатьДокумент();
	
	НовыйДокОбъект.Заполнить(Основание);
	НовыйДокОбъект.Дата = Дата;
	НовыйДокОбъект.Статус = Перечисления.СтатусыПриходныхОрдеров.Принят;
	НовыйДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + Ссылка + """";
	НовыйДокОбъект.Лико_АвторДокумента = АвторДокумента;
	НовыйДокОбъект.Лико_РабочееМесто = РабочееМесто;
	НовыйДокОбъект.Товары.Очистить();
	//ПредыдущийВид = Неопределено;
	//ПредыдущаяУпаковка = Неопределено;
	УпаковкаТысШт = Справочники.Лико_ПредопределенныеЗначения.УпаковкаТысШт.ЗначениеПараметра;
	Пока ВыборкаСерии.Следующий() Цикл
		Если ВыборкаСерии.КоличествоВУпаковке = 0 Тогда
			Сообщить("У серии " + ВыборкаСерии.Серия + " не заполнен реквизит ""Количество в упаковке""! Данная серия пропущена.");
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = ВыборкаСерии.Номенклатура;
		НоваяСтрока.Характеристика = ВыборкаСерии.Характеристика;
		//Если ПредыдущийВид = НоваяСтрока.Номенклатура.ВидНоменклатуры Тогда
		//	НоваяСтрока.Упаковка = ПредыдущаяУпаковка;
		//Иначе
		//	НоваяСтрока.Упаковка = Лико_Дополнительно.ПолучитьУпаковкуПоУмолчаниюДляВидаНоменклатуры(НоваяСтрока.Номенклатура.ВидНоменклатуры);
		//КонецЕсли;
		НоваяСтрока.Упаковка = УпаковкаТысШт;
		НоваяСтрока.КоличествоУпаковок = ВыборкаСерии.КоличествоВУпаковке;
		НоваяСтрока.Количество = ВыборкаСерии.КоличествоВУпаковке;
		НоваяСтрока.СтатусУказанияСерий = 8;
		НоваяСтрока.Серия = ВыборкаСерии.Серия;
		
		//ПредыдущийВид = НоваяСтрока.Номенклатура.ВидНоменклатуры;
		//ПредыдущаяУпаковка = НоваяСтрока.Упаковка;
	КонецЦикла;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//Сообщить(?(УжеСозданныйДокумент = Неопределено, "Создан", "Перезаполнен") + " документ """ + НовыйДокОбъект + """");
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
