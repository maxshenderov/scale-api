
Перем КлючиСтруктуры;
Перем ОтключитьЧастьПроверок;
Перем КоличествоЗаказовКоторыеПишутВОбщийЭтап;

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если Содержимое.Количество() = 0 Тогда
		Отказ = Истина;
		Сообщить("Не выбрано ни одной коробки.");
		Возврат;
	КонецЕсли;
	
	Движения.Лико_АдресноеХранение.Записывать = Истина;
	Движения.Лико_УчетГотовыхЭтикеток.Записывать = Истина;
	
	// регистр ЛикоАдресноеХранение
	Для Каждого ТекСтрокаСодержимое Из Содержимое Цикл
		Движение = Движения.Лико_АдресноеХранение.Добавить();
		Движение.Период = Дата;
		Движение.Серия = ТекСтрокаСодержимое.Серия;
		Движение.Склад = ЯчейкаПолучатель.Владелец;
		Движение.Ячейка = ЯчейкаПолучатель;
		Движение.Паллет = Паллет;
		Движение.ВыбылСоСклада = ТекСтрокаСодержимое.ВыбылСоСклада;
	КонецЦикла;
	
	Если ДополнительныеСвойства.Свойство("ПровестиТолькоПоРегиструАдресноеХранение") Тогда
		// Сформируем движения по СодержимоеРастарки, т.к. обычно они формируются после проведения
		Для Каждого ТекСтрокаСодержимое Из СодержимоеРастарки Цикл
			Движение = Движения.Лико_АдресноеХранение.Добавить();
			Движение.Период = Дата;
			Движение.Серия = ТекСтрокаСодержимое.Серия;
			Движение.Склад = ЯчейкаРастарка.Владелец;
			Движение.Ячейка = ЯчейкаРастарка;
			Движение.ВыбылСоСклада = Истина;
		КонецЦикла;
	
		Возврат;
	КОнецЕслИ;
	
	Если ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции Тогда
	
		// Проверим, чтобы коробки, выбранные в формировании, не были уже сформированными
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Лико_ФормированиеПаллетаСодержимое.Серия КАК Серия,
			|	ВЫБОР
			|		КОГДА Лико_ФормированиеПаллетаСодержимое1.Серия ЕСТЬ NULL
			|			ТОГДА ЛОЖЬ
			|		ИНАЧЕ ИСТИНА
			|	КОНЕЦ КАК СерияВыпущена,
			|	Лико_ФормированиеПаллетаСодержимое1.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.Лико_ФормированиеПаллета.Содержимое КАК Лико_ФормированиеПаллетаСодержимое
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лико_ФормированиеПаллета.Содержимое КАК Лико_ФормированиеПаллетаСодержимое1
			|		ПО Лико_ФормированиеПаллетаСодержимое.Серия = Лико_ФормированиеПаллетаСодержимое1.Серия
			|			И (Лико_ФормированиеПаллетаСодержимое1.Ссылка <> &ЭтотДокумент)
			|			И (Лико_ФормированиеПаллетаСодержимое1.Ссылка.Проведен)
			|			И (Лико_ФормированиеПаллетаСодержимое1.Ссылка.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыФормированияПаллет.ВыпускПродукции))
			|ГДЕ
			|	Лико_ФормированиеПаллетаСодержимое.Ссылка = &ЭтотДокумент";
		
		Запрос.УстановитьПараметр("ЭтотДокумент", Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.СерияВыпущена Тогда
				Отказ = Истина;
				Сообщить("Серия """ + ВыборкаДетальныеЗаписи.Серия + """ уже содержится в документе """ + ВыборкаДетальныеЗаписи.Ссылка + """ (" + ВыборкаДетальныеЗаписи.Ссылка.Паллет + "). Проведение невозможно.");
			КонецЕсли;
		КонецЦикла;
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Отказ = НЕ СоздатьТиповыеДокументы();
	
	Если НЕ Отказ Тогда
		
		// <-- Начало Лико Яцун С. В. 26.09.2025 
		Если Площадка = Справочники.Лико_Площадки.Линкс И ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции И НЕ ВыпускИзРастарки Тогда 
			УдалитьЗаписиДвиженияПеремотки(); 
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	СерииНоменклатурыЛико_Содержимое.ОбъектНоменклатуры.Ответственный КАК Ответстввенный,
			|	Лико_ФормированиеПаллетаСодержимое.Ссылка КАК Документ,
			|	СУММА(СерииНоменклатурыЛико_Содержимое.ОбъектНоменклатуры.КоличествоВРоликеПослеПеремотки) КАК КоличествоТысШт,
			|	СерииНоменклатурыЛико_Содержимое.Ссылка.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры КАК ЗаказКлиента,
			|	СерииНоменклатурыЛико_Содержимое.ОбъектНоменклатуры.НомерБланка КАК НомерБланка,
			|	МАКСИМУМ(СерииНоменклатурыЛико_Содержимое.ОбъектНоменклатуры.КоличествоВРоликеПослеПеремотки) КАК КоличествоВРоликеПослеПеремотки,
			|	СерииНоменклатурыЛико_Содержимое.ОбъектНоменклатуры.РабочийЦентрВыпускаВРоликеПослеПеремотки КАК РабочийЦентрВыпускаВРоликеПослеПеремотки,
			|	НАЧАЛОПЕРИОДА(СерииНоменклатурыЛико_Содержимое.ОбъектНоменклатуры.ДатаФормирования, ДЕНЬ) КАК ДатаФормирования
			|ИЗ
			|	Документ.Лико_ФормированиеПаллета.Содержимое КАК Лико_ФормированиеПаллетаСодержимое
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры.Лико_Содержимое КАК СерииНоменклатурыЛико_Содержимое
			|		ПО Лико_ФормированиеПаллетаСодержимое.Серия = СерииНоменклатурыЛико_Содержимое.Ссылка
			|ГДЕ
			|	Лико_ФормированиеПаллетаСодержимое.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	Лико_ФормированиеПаллетаСодержимое.Ссылка,
			|	СерииНоменклатурыЛико_Содержимое.ОбъектНоменклатуры.Ответственный,
			|	СерииНоменклатурыЛико_Содержимое.Ссылка.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры,
			|	СерииНоменклатурыЛико_Содержимое.ОбъектНоменклатуры.НомерБланка,
			|	СерииНоменклатурыЛико_Содержимое.ОбъектНоменклатуры.РабочийЦентрВыпускаВРоликеПослеПеремотки,
			|	НАЧАЛОПЕРИОДА(СерииНоменклатурыЛико_Содержимое.ОбъектНоменклатуры.ДатаФормирования, ДЕНЬ)
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДатаФормирования
			|ИТОГИ ПО
			|	Ответстввенный";
			
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаОтветстввенный = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаОтветстввенный.Следующий() Цикл
				// Вставить обработку выборки ВыборкаОтветстввенный
				
				ВыборкаДетальныеЗаписи = ВыборкаОтветстввенный.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					ПараметрыДляВыработкиПеремотки = Новый Структура();
					ПараметрыДляВыработкиПеремотки.Вставить("Сотрудник",Лико_Дополнительно.ПолучитьСотрудникаПоФизЛицу(ВыборкаДетальныеЗаписи.Ответстввенный));
					ПараметрыДляВыработкиПеремотки.Вставить("Смена",Неопределено);
					ПараметрыДляВыработкиПеремотки.Вставить("ТипОперацииПеремотки",Справочники.Лико_ТипыОперацийПеремотка.БумажнаяПодложка);
					ПараметрыДляВыработкиПеремотки.Вставить("КоличествоТысШт",ВыборкаДетальныеЗаписи.КоличествоТысШт);
					ПараметрыДляВыработкиПеремотки.Вставить("КоличествоПМ",Неопределено);
					ПараметрыДляВыработкиПеремотки.Вставить("КоличествоНастроек",0);
					ПараметрыДляВыработкиПеремотки.Вставить("ДвойнаяНика",Ложь);
					ПараметрыДляВыработкиПеремотки.Вставить("КоличествоЭтикетокВРолике",ВыборкаДетальныеЗаписи.КоличествоВРоликеПослеПеремотки * 1000);
					ПараметрыДляВыработкиПеремотки.Вставить("КоличествоРучьевПереворота",0);
					ПараметрыДляВыработкиПеремотки.Вставить("ДокументОснование",Ссылка);
					ПараметрыДляВыработкиПеремотки.Вставить("РабочийЦентр",ВыборкаДетальныеЗаписи.РабочийЦентрВыпускаВРоликеПослеПеремотки);

					Лико_Дополнительно.ДобавитьЗаписьВДокументЛико_ДвиженияЗаказаПоЭтапам(
					ВыборкаДетальныеЗаписи.ЗаказКлиента,
					"Перемотка",
					ВыборкаДетальныеЗаписи.КоличествоТысШт,
					Строка(Новый УникальныйИдентификатор),
					АвторДокумента,
					ВыборкаДетальныеЗаписи.ДатаФормирования,
					Ложь,
					ВыборкаДетальныеЗаписи.НомерБланка,
					,,,,ПараметрыДляВыработкиПеремотки);
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 26.09.2025 
		
		ЗаполнитьДатыВыпускаВСериях(Отказ);
		ЗаполнитьВесИПлощадьВНоменклатуру(Отказ);
		
		Движения.Лико_АдресноеХранение.Записывать = Истина;
		Для Каждого ТекСтрокаСодержимое Из СодержимоеРастарки Цикл
			Движение = Движения.Лико_АдресноеХранение.Добавить();
			Движение.Период = Дата;
			Движение.Серия = ТекСтрокаСодержимое.Серия;
			Движение.Склад = ЯчейкаРастарка.Владелец;
			Движение.Ячейка = ЯчейкаРастарка;
			Движение.ВыбылСоСклада = Истина;
		КонецЦикла;
		
		Если ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции Тогда
			// Обновим среднее количество в заказах
			ТаблицаЗаказов = Новый ТаблицаЗначений;
			ТаблицаЗаказов.Колонки.Добавить("Заказ");
			Для каждого Строка из Содержимое Цикл
				НоваяСтрока = ТаблицаЗаказов.Добавить();
				НоваяСтрока.Заказ = Строка.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры;
			КонецЦикла;
			ТаблицаЗаказов.Свернуть("Заказ");
			Для каждого Строка из ТаблицаЗаказов Цикл
				Лико_Дополнительно.ОбновитьВЗаказеСреднееКоличествоВКоробкеИРолике(Строка.Заказ, Ссылка,, Истина);
			КонецЦикла;
			
			Если НЕ ВыпускИзРастарки Тогда
				ВоВсехКоробкахЗаполненоСодержимое = Истина;
				ТзДляУчетаГотовыхЭтикеток = Новый ТаблицаЗначений;
				ТзДляУчетаГотовыхЭтикеток.Колонки.Добавить("ЗаказКлиента");
				ТзДляУчетаГотовыхЭтикеток.Колонки.Добавить("НомерБланка");
				ТзДляУчетаГотовыхЭтикеток.Колонки.Добавить("Количество");
				Для каждого ТекСтрока из Содержимое Цикл
					Если ТекСтрока.Серия.Лико_Содержимое.Количество() = 0 Тогда
						ВоВсехКоробкахЗаполненоСодержимое = Ложь;
						Прервать;
					КонецЕсли;
					ТекЗаказКлиента = ТекСтрока.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры;
					Для каждого ТекСтрокаРолика1 из ТекСтрока.Серия.Лико_Содержимое Цикл
						Для каждого ТекСтрокаРолика2 из ТекСтрокаРолика1.ОбъектНоменклатуры.СоставРоликаПослеПеремотки Цикл
							Если ЗначениеЗаполнено(ТекСтрокаРолика2.ОбъектНоменклатуры.СтатусРоликаПослеПеремотки) Тогда
								// Это ролик с намотки, нужен еще один цикл
								Для каждого ТекСтрокаРолика3 из ТекСтрокаРолика2.ОбъектНоменклатуры.СоставРоликаПослеПеремотки Цикл
									НоваяСтрока = ТзДляУчетаГотовыхЭтикеток.Добавить();
									НоваяСтрока.ЗаказКлиента = ТекЗаказКлиента;
									НоваяСтрока.НомерБланка = ТекСтрокаРолика3.ОбъектНоменклатуры.НомерБланка;
									НоваяСтрока.Количество = ТекСтрокаРолика3.Количество;
								КонецЦикла;
							Иначе
								// Это ролик с размотки
								НоваяСтрока = ТзДляУчетаГотовыхЭтикеток.Добавить();
								НоваяСтрока.ЗаказКлиента = ТекЗаказКлиента;
								НоваяСтрока.НомерБланка = ТекСтрокаРолика2.ОбъектНоменклатуры.НомерБланка;
								НоваяСтрока.Количество = ТекСтрокаРолика2.Количество; 
							КонецЕсли;
						КонецЦикла;
					КонецЦикла;
				КонецЦикла;
				Если ВоВсехКоробкахЗаполненоСодержимое Тогда
					// Добавим записи в регистр Лико_УчетГотовыхЭтикеток 
					ТзДляУчетаГотовыхЭтикеток.Свернуть("ЗаказКлиента,НомерБланка", "Количество");
					Для каждого ТекСтрока из ТзДляУчетаГотовыхЭтикеток Цикл
						НоваяСтрока = Движения.Лико_УчетГотовыхЭтикеток.Добавить();
						НоваяСтрока.ЗаказКлиента = ТекСтрока.ЗаказКлиента;
						НоваяСтрока.Количество = ТекСтрока.Количество;
						НоваяСтрока.Период = Дата;
						НоваяСтрока.НомерБланка = ТекСтрока.НомерБланка;
						НоваяСтрока.ВидДвижения = ВидДвиженияНакопления.Приход;
						НоваяСтрока.Место = Перечисления.Лико_МестаУчетаГотовыхЭтикеток.Упаковка;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

Процедура УдалитьЗаписиДвиженияПеремотки()

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ДвиженияЗаказаПоЭтапамПеремотка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лико_ДвиженияЗаказаПоЭтапам.Перемотка КАК Лико_ДвиженияЗаказаПоЭтапамПеремотка
	|ГДЕ
	|	Лико_ДвиженияЗаказаПоЭтапамПеремотка.ДокументОснование = &ДокументОснование
	|	И НЕ Лико_ДвиженияЗаказаПоЭтапамПеремотка.Ссылка.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ДвиженияЗаказаПоЭтапамПеремотка.Ссылка";
	
	Запрос.УстановитьПараметр("ДокументОснование", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДвижОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		СтрокиДляУдаления = ДвижОбъект.Перемотка.НайтиСтроки(Новый Структура("ДокументОснование",Ссылка));
		Для каждого Стр из СтрокиДляУдаления Цикл
			ДвижОбъект.Перемотка.Удалить(Стр);
		КонецЦикла;
		ДвижОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция СоздатьТиповыеДокументы(ПараметрыДляСозданияОднойЦепочки = Неопределено) Экспорт

	ТаблицаНовыхДокументов = Новый ТаблицаЗначений;
	ТаблицаНовыхДокументов.Колонки.Добавить("Заказ");
	ТаблицаНовыхДокументов.Колонки.Добавить("Документ");
	ТаблицаНовыхДокументов.Колонки.Добавить("Номенклатура");
	ТаблицаНовыхДокументов.Колонки.Добавить("РаспоряжениеНаРастарку");
	ТаблицаНовыхДокументов.Колонки.Добавить("НомерЦепочкиВРаспоряженииНаРастарку");

	ОтключитьЧастьПроверок = Неопределено;
	ДополнительныеСвойства.Свойство("ОтключитьЧастьПроверок", ОтключитьЧастьПроверок);
	ОтключитьЧастьПроверок = ?(ОтключитьЧастьПроверок = Неопределено, Ложь, ОтключитьЧастьПроверок);

	ИспользованиеРеквизитаДокументВРегистреЭтапыЗаказа = Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияРеквизитаДокументВРегистреЭтапыЗаказа.ЗначениеПараметра <= ?(ЗначениеЗаполнено(ДатаФормирования), ДатаФормирования, Дата);
	ОбычныйРежимСозданияТиповыхДокументов = НЕ ЗначениеЗаполнено(ДатаУпрощенногоПроведения);

	Если ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.Переупаковка Тогда

		//на переупаковке по типовым механизмам будем делать только перемещение коробок
		НачатьТранзакцию();
		//Сначала найдем уже сформированные типовые документы, распроведем их и будем заполнять заново
		КлючиСтруктурыБезЭтапа = Лико_Дополнительно.ПолучитьКлючиСтруктурыБезДокумента(КлючиСтруктуры, "ЭтапПроизводства2_2");
		СтруктураТиповыхДокументов = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(Истина,, КлючиСтруктурыБезЭтапа, Ссылка);
		Если СтруктураТиповыхДокументов = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		//найдем в каких ячейках лежат выбранные коробки, причем делать это будем по типовым регистрам
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ФормированиеПаллетаСодержимое.Серия
		|ПОМЕСТИТЬ ВТ_ТоварыДокумента
		|ИЗ
		|	Документ.Лико_ФормированиеПаллета.Содержимое КАК Лико_ФормированиеПаллетаСодержимое
		|ГДЕ
		|	Лико_ФормированиеПаллетаСодержимое.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	Лико_ФормированиеПаллетаСодержимое.Серия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТоварыДокумента.Серия.Лико_ХарактеристикаВладелец.Владелец КАК Номенклатура,
		|	ВТ_ТоварыДокумента.Серия.Лико_ХарактеристикаВладелец КАК Характеристика,
		|	ВТ_ТоварыДокумента.Серия КАК Серия,
		|	ТоварыВЯчейкахОстатки.Ячейка,
		|	ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0) КАК ВНаличииОстаток,
		|	ВТ_ТоварыДокумента.Серия.Лико_КоличествоВУпаковке КАК КоличествоВДокументе
		|ИЗ
		|	ВТ_ТоварыДокумента КАК ВТ_ТоварыДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
		|				&Дата,
		|				Серия В
		|						(ВЫБРАТЬ
		|							Т.Серия
		|						ИЗ
		|							ВТ_ТоварыДокумента КАК Т)
		|					И Ячейка.Владелец = &Склад) КАК ТоварыВЯчейкахОстатки
		|		ПО ВТ_ТоварыДокумента.Серия = ТоварыВЯчейкахОстатки.Серия
		|ИТОГИ
		|	СУММА(ВНаличииОстаток),
		|	МАКСИМУМ(КоличествоВДокументе)
		|ПО
		|	Серия";

		Запрос.УстановитьПараметр("Дата", Новый Граница(Дата, ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Склад", ЯчейкаПолучатель.Владелец);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);

		РезультатЗапроса = Запрос.Выполнить();

		ВыборкаСерия = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

		//Если НЕ ОтключитьЧастьПроверок Тогда
		Отказ = Ложь;
		Пока ВыборкаСерия.Следующий() Цикл

			Если ВыборкаСерия.КоличествоВДокументе > ВыборкаСерия.ВНаличииОстаток Тогда
				//коробок не хватает
				Отказ = Истина;
				Сообщить("В документе """ + Ссылка + """ не хватает коробки """ + ВыборкаСерия.Серия + """ на выбранном складе.");
				Продолжить;
			КонецЕсли;

		КонецЦикла;
		Если Отказ Тогда
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецЕсли;

		ВыборкаСерия.Сбросить();
		//КонецЕсли;

		//Создаем новый документ
		НовыйДокументОтборРазмещениеТоваров_Перемещение = СоздатьДокументОтборРазмещениеТоваров(ВыборкаСерия, СтруктураТиповыхДокументов.ОтборРазмещениеТоваров_Перемещение);
		Если НовыйДокументОтборРазмещениеТоваров_Перемещение = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		НоваяСтрока = ТаблицаНовыхДокументов.Добавить();
		НоваяСтрока.Документ = НовыйДокументОтборРазмещениеТоваров_Перемещение;

	ИначеЕсли ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.ВыпускПродукции Тогда
		//Лико_Дополнительно.УдалитьЗаписиИзДокументаЛико_ДвиженияЗаказаПоЭтапам(XMLСтрока(Ссылка));
		Если НЕ ВыпускИзРастарки ИЛИ Дата < Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияНовойСхемыРастарки.ЗначениеПараметра Тогда
			// Обычный выпуск
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Т.Серия КАК Серия
			|ПОМЕСТИТЬ ВТ_ТаблицаСгруппирована
			|ИЗ
			|	Документ.Лико_ФормированиеПаллета.Содержимое КАК Т
			|ГДЕ
			|	Т.Ссылка = &Ссылка
			|	И ВЫБОР
			|			КОГДА &ОтборЗаказ = НЕОПРЕДЕЛЕНО
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ Т.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры = &ОтборЗаказ
			|		КОНЕЦ
			|
			|СГРУППИРОВАТЬ ПО
			|	Т.Серия
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ТаблицаСгруппирована.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры КАК ЗаказКлиента,
			|	ПОДСТРОКА(ВТ_ТаблицаСгруппирована.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Номер, 5, 7) КАК НомерЗаказа,
			|	ВТ_ТаблицаСгруппирована.Серия.Лико_ХарактеристикаВладелец.Владелец КАК Номенклатура,
			|	ВТ_ТаблицаСгруппирована.Серия.Лико_ХарактеристикаВладелец КАК Характеристика,
			|	ВТ_ТаблицаСгруппирована.Серия КАК Серия,
			|	ВТ_ТаблицаСгруппирована.Серия.Лико_КоличествоВУпаковке КАК КоличествоВУпаковке
			|ПОМЕСТИТЬ ВТ_ДанныеСЗаказом
			|ИЗ
			|	ВТ_ТаблицаСгруппирована КАК ВТ_ТаблицаСгруппирована
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ДанныеСЗаказом.ЗаказКлиента КАК ЗаказКлиента,
			|	ВТ_ДанныеСЗаказом.Номенклатура КАК Номенклатура,
			|	ВТ_ДанныеСЗаказом.Характеристика КАК Характеристика,
			|	СУММА(ВТ_ДанныеСЗаказом.КоличествоВУпаковке) КАК КоличествоВУпаковке
			|ПОМЕСТИТЬ ВТ_ТаблицаДляПроверки
			|ИЗ
			|	ВТ_ДанныеСЗаказом КАК ВТ_ДанныеСЗаказом
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_ДанныеСЗаказом.ЗаказКлиента,
			|	ВТ_ДанныеСЗаказом.Номенклатура,
			|	ВТ_ДанныеСЗаказом.Характеристика
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ДанныеСЗаказом.ЗаказКлиента КАК ЗаказКлиента,
			|	ВТ_ДанныеСЗаказом.НомерЗаказа КАК НомерЗаказа,
			|	ВТ_ДанныеСЗаказом.Номенклатура КАК Номенклатура,
			|	ВТ_ДанныеСЗаказом.Характеристика КАК Характеристика,
			|	ВТ_ДанныеСЗаказом.Серия КАК Серия,
			|	ВТ_ДанныеСЗаказом.КоличествоВУпаковке КАК КоличествоВУпаковке
			|ИЗ
			|	ВТ_ДанныеСЗаказом КАК ВТ_ДанныеСЗаказом
			|ИТОГИ
			|	СУММА(КоличествоВУпаковке)
			|ПО
			|	ЗаказКлиента
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ДанныеСЗаказом.ЗаказКлиента КАК ЗаказКлиента,
			|	ВТ_ДанныеСЗаказом.НомерЗаказа КАК НомерЗаказа,
			|	ВТ_ДанныеСЗаказом.Номенклатура КАК Номенклатура,
			|	ВТ_ДанныеСЗаказом.Характеристика КАК Характеристика,
			|	СУММА(ВТ_ДанныеСЗаказом.КоличествоВУпаковке) КАК КоличествоВУпаковке
			|ИЗ
			|	ВТ_ДанныеСЗаказом КАК ВТ_ДанныеСЗаказом
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_ДанныеСЗаказом.ЗаказКлиента,
			|	ВТ_ДанныеСЗаказом.НомерЗаказа,
			|	ВТ_ДанныеСЗаказом.Номенклатура,
			|	ВТ_ДанныеСЗаказом.Характеристика
			|ИТОГИ
			|	СУММА(КоличествоВУпаковке)
			|ПО
			|	ЗаказКлиента";

			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Если ПараметрыДляСозданияОднойЦепочки = Неопределено Тогда
				Запрос.УстановитьПараметр("ОтборЗаказ", Неопределено);
			Иначе
				Запрос.УстановитьПараметр("ОтборЗаказ", ПараметрыДляСозданияОднойЦепочки.Заказ);
			КонецЕсли;

			МассивРезультатов = Запрос.ВыполнитьПакет();

			ВыборкаЗаказ = МассивРезультатов[МассивРезультатов.Количество()-1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Если ПараметрыДляСозданияОднойЦепочки = Неопределено Тогда
				НачатьТранзакцию();
				//Сначала найдем уже сформированные типовые документы, распроведем их и будем заполнять заново
				КлючиСтруктурыБезЭтапа = Лико_Дополнительно.ПолучитьКлючиСтруктурыБезДокумента(КлючиСтруктуры, "ЭтапПроизводства2_2");
				СтруктураТиповыхДокументов = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(Истина,, КлючиСтруктурыБезЭтапа, Ссылка);
				Если СтруктураТиповыхДокументов = Неопределено Тогда
					Возврат Ложь;
				КонецЕсли;

				// Удалим из этапа строки выпуска, соответствующие этому формированию паллета
				Результат = Лико_Дополнительно.УдалитьИзЭтаповСтрокиВыпускаПоСвязанномуФормированиюПаллета(Ссылка, Новый Структура("Лико_НеРассчитыватьНормативныйГрафик", Истина));
				Если НЕ Результат Тогда
					Отказ = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ОбычныйРежимСозданияТиповыхДокументов И ПараметрыДляСозданияОднойЦепочки = Неопределено Тогда
				Упаковка = Справочники.Лико_ПредопределенныеЗначения.УпаковкаТысШт.ЗначениеПараметра;
				ВыборкаЗаказПоСериям = МассивРезультатов[МассивРезультатов.Количество()-2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаЗаказПоСериям.Следующий() Цикл
					
					ОтборТиповыхДокументов = Новый Структура("Заказ", ВыборкаЗаказПоСериям.ЗаказКлиента); 
					СтруктураТиповыхДокументов = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(,ОтборТиповыхДокументов, КлючиСтруктуры, Ссылка, Ложь);
					Если СтруктураТиповыхДокументов = Неопределено Тогда
						Возврат Ложь;
					КонецЕсли;

					МассивВыпуск = Новый Массив;
					ВыборкаСерии = ВыборкаЗаказПоСериям.Выбрать();
					Пока ВыборкаСерии.Следующий() Цикл
						СтрокаСтруктура = Новый Структура("Номенклатура,Характеристика,Упаковка,Серия,Количество");
						ЗаполнитьЗначенияСвойств(СтрокаСтруктура, ВыборкаСерии); 
						СтрокаСтруктура.Количество = ВыборкаСерии.КоличествоВУпаковке;
						СтрокаСтруктура.Упаковка = Упаковка;
						МассивВыпуск.Добавить(СтрокаСтруктура);
					КонецЦикла;
					// Создадим корректировку регистров
					НовыйДокументКорректировкаРегистров = СоздатьДокументКорректировкаРегистровУпрощенныйРежим(СтруктураТиповыхДокументов.КорректировкаРегистров, МассивВыпуск);
					Если НовыйДокументКорректировкаРегистров = Неопределено Тогда
						Возврат Ложь;
					КонецЕсли;
					НоваяСтрока = ТаблицаНовыхДокументов.Добавить();
					НоваяСтрока.Документ = НовыйДокументКорректировкаРегистров;
					НоваяСтрока.Заказ = ВыборкаЗаказПоСериям.ЗаказКлиента;
				КонецЦикла;
			КонецЕсли;

			Пока ВыборкаЗаказ.Следующий() Цикл

				Если ВыборкаЗаказ.КоличествоВУпаковке <= 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Если ОбычныйРежимСозданияТиповыхДокументов ИЛИ ПараметрыДляСозданияОднойЦепочки <> Неопределено Тогда
					
					ОтборТиповыхДокументов = Новый Структура("Заказ", ВыборкаЗаказ.ЗаказКлиента); 
					СтруктураТиповыхДокументов = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(,ОтборТиповыхДокументов, КлючиСтруктуры, Ссылка, Ложь);
					Если СтруктураТиповыхДокументов = Неопределено Тогда
						Возврат Ложь;
					КонецЕсли;
					
					//Создаем этап для заказа на выпуск продукции
					НовыйЭтапСсылка = СоздатьЭтап(ВыборкаЗаказ, СтруктураТиповыхДокументов.ЭтапПроизводства2_2);
				
					Если НовыйЭтапСсылка = Неопределено Тогда
						Возврат Ложь;
					КонецЕсли;
					
					//Создаем передачу продукции на склад
					НовыйДокументПередачаНаСкладСсылка = СоздатьПередачуПродукции(НовыйЭтапСсылка, ВыборкаЗаказ.ЗаказКлиента, СтруктураТиповыхДокументов.ДвижениеПродукцииИМатериалов);
					Если НовыйДокументПередачаНаСкладСсылка = Неопределено Тогда
						Возврат Ложь;
					КонецЕсли;

					//Создаем приходный ордер - тут уже будут серии
					НовыйДокументПриходныйОрдерСсылка = Неопределено;
					Если ЯчейкаПолучатель.ТипСкладскойЯчейки = Перечисления.ТипыСкладскихЯчеек.Приемка Тогда
						Приемка = ЯчейкаПолучатель;
					Иначе
						Приемка = Лико_Дополнительно.ПолучитьЗонуПриемкиПоСкладу(ЯчейкаПолучатель.Владелец);
					КонецЕсли;
					//здесь нам нужна номенклатура с сериями, поэтому будем получать другой пакет запроса (с сериями)
					ВыборкаЗаказПоСериям = МассивРезультатов[МассивРезультатов.Количество()-2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаЗаказПоСериям.Следующий() Цикл
						Если ВыборкаЗаказПоСериям.ЗаказКлиента <> ВыборкаЗаказ.ЗаказКлиента Тогда
							Продолжить;
						КонецЕсли;
						//Это нужный заказ
						ВыборкаСерии = ВыборкаЗаказПоСериям.Выбрать();
						НовыйДокументПриходныйОрдерСсылка = СоздатьПриходныйОрдер(НовыйЭтапСсылка, ВыборкаСерии, Приемка, СтруктураТиповыхДокументов.ПриходныйОрдерНаТовары);
						//нужный заказ мы обработали, дальше идти нет смысла
						Прервать;
					КонецЦикла;
					Если НовыйДокументПриходныйОрдерСсылка = Неопределено Тогда
						Возврат Ложь;
					КонецЕсли;

					Если ЯчейкаПолучатель <> Приемка Тогда
						НовыйДокументРазмещениеТоваровСсылка = Лико_Дополнительно.СоздатьРазмещениеТоваровНаОснованииПриходногоОрдера(НовыйДокументПриходныйОрдерСсылка, СтруктураТиповыхДокументов.ОтборРазмещениеТоваров_Размещение, ЯчейкаПолучатель);
						Если НовыйДокументРазмещениеТоваровСсылка = Неопределено Тогда
							Возврат Ложь;
						КонецЕсли;
					КонецЕсли;

					МассивТиповыхДокументов = Новый Массив;
					МассивТиповыхДокументов.Добавить(НовыйЭтапСсылка);
					МассивТиповыхДокументов.Добавить(НовыйДокументПередачаНаСкладСсылка);
					МассивТиповыхДокументов.Добавить(НовыйДокументПриходныйОрдерСсылка);
					МассивТиповыхДокументов.Добавить(НовыйДокументРазмещениеТоваровСсылка);
					Для каждого Строка из МассивТиповыхДокументов Цикл
						НоваяСтрока = ТаблицаНовыхДокументов.Добавить();
						НоваяСтрока.Документ = Строка;
						НоваяСтрока.Заказ = ВыборкаЗаказ.ЗаказКлиента;
					КонецЦикла;
				КонецЕсли;
				
				Если ПараметрыДляСозданияОднойЦепочки = Неопределено Тогда
					// Добавим запись в Лико_ЭтапыЗаказа
					МенеджерЗаписи = РегистрыСведений.Лико_ЭтапыЗаказа.СоздатьМенеджерЗаписи();
					МенеджерЗаписи.Период = ?(ЗначениеЗаполнено(ДатаФормирования), ДатаФормирования, Дата);
					МенеджерЗаписи.Заказ = ВыборкаЗаказ.ЗаказКлиента;
					МенеджерЗаписи.Площадка = ВыборкаЗаказ.ЗаказКлиента.Площадка;
					МенеджерЗаписи.Количество = ВыборкаЗаказ.КоличествоВУпаковке;
					МенеджерЗаписи.Этап = Справочники.Лико_ЭтапыВыполненияЗаказа.Упаковка;
					МенеджерЗаписи.Ответственный = АвторДокумента;
					Если ИспользованиеРеквизитаДокументВРегистреЭтапыЗаказа Тогда
						МенеджерЗаписи.Документ = Ссылка;
					КонецЕсли;
					Попытка
						МенеджерЗаписи.Записать(Истина);
					Исключение
						Сообщить("Не удалось добавить запись в регистр ""лк Этапы заказа"": " + ОписаниеОшибки());
						Возврат Ложь;
					КонецПопытки;

					// Добавим запись в документ Лико_ДвиженияЗаказаПоЭтапам
					//Лико_Дополнительно.ДобавитьЗаписьВДокументЛико_ДвиженияЗаказаПоЭтапам(
					//	ВыборкаЗаказ.ЗаказКлиента,
					//	"Упаковка",
					//	ВыборкаЗаказ.КоличествоВУпаковке,
					//	XMLСтрока(Ссылка),
					//	?(ЗначениеЗаполнено(АвторДокумента), АвторДокумента, ПараметрыСеанса.ТекущийПользователь),
					//	Дата,
					//	ВыпускИзРастарки);

					ИзменитьСтатусЗаказаНаВыполнен(ВыборкаЗаказ.ЗаказКлиента);
				КонецЕсли;

			КонецЦикла;

		Иначе

				// Растарка по версии 3, без распоряжения на растарку. Распоряжение и номер цепочки уже содержатся в серии
				РастркаАнгара = ЯчейкаРастарка.Владелец.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараКлиентаУНас;
				Если ЯчейкаРастарка.Владелец.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.Производство
					ИЛИ РастркаАнгара
					ИЛИ ЯчейкаРастарка.Владелец.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.Регион
					ИЛИ ЯчейкаРастарка.Владелец.Лико_ТипСкладаГотовойПродукции = Перечисления.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараДругойПлощадкиСПравомПродажи
					Тогда
					
					Если ПараметрыДляСозданияОднойЦепочки = Неопределено Тогда
						НачатьТранзакцию();
						СодержимоеРастарки.Очистить();
						//Сначала найдем уже сформированные типовые документы, распроведем их и будем заполнять заново
						КлючиСтруктурыБезЭтапа = Лико_Дополнительно.ПолучитьКлючиСтруктурыБезДокумента(КлючиСтруктуры, "ЭтапПроизводства2_2");
						СтруктураТиповыхДокументов = Лико_Дополнительно.НайтиУжеСформированныеТиповыеДокументы(Истина,, КлючиСтруктурыБезЭтапа, Ссылка);
						Если СтруктураТиповыхДокументов = Неопределено Тогда
							Возврат Ложь;
						КонецЕсли;

						Запрос = Новый Запрос;
						Запрос.Текст = 
						"ВЫБРАТЬ
						|	Лико_ФормированиеПаллетаСодержимое.НомерСтроки КАК НомерСтроки,
						|	Лико_ФормированиеПаллетаСодержимое.Серия КАК Серия,
						|	Лико_ФормированиеПаллетаСодержимое.Серия.Лико_РаспоряжениеНаРастарку КАК Лико_РаспоряжениеНаРастарку,
						|	Лико_ФормированиеПаллетаСодержимое.Серия.Лико_НомерЦепочкиВРаспоряженииНаРастарку КАК Лико_НомерЦепочкиВРаспоряженииНаРастарку,
						|	Лико_ФормированиеПаллетаСодержимое.Серия.Лико_КоличествоВУпаковке КАК Количество
						|ПОМЕСТИТЬ ВТ_СерииСРаспоряжениями
						|ИЗ
						|	Документ.Лико_ФормированиеПаллета.Содержимое КАК Лико_ФормированиеПаллетаСодержимое
						|ГДЕ
						|	Лико_ФормированиеПаллетаСодержимое.Ссылка = &Ссылка
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	ВТ_СерииСРаспоряжениями.Лико_РаспоряжениеНаРастарку КАК Лико_РаспоряжениеНаРастарку,
						|	ВТ_СерииСРаспоряжениями.Лико_НомерЦепочкиВРаспоряженииНаРастарку КАК Лико_НомерЦепочкиВРаспоряженииНаРастарку
						|ПОМЕСТИТЬ ВТ_Распоряжения
						|ИЗ
						|	ВТ_СерииСРаспоряжениями КАК ВТ_СерииСРаспоряжениями
						|
						|СГРУППИРОВАТЬ ПО
						|	ВТ_СерииСРаспоряжениями.Лико_РаспоряжениеНаРастарку,
						|	ВТ_СерииСРаспоряжениями.Лико_НомерЦепочкиВРаспоряженииНаРастарку
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	ВТ_Распоряжения.Лико_РаспоряжениеНаРастарку КАК Лико_РаспоряжениеНаРастарку,
						|	ВТ_Распоряжения.Лико_НомерЦепочкиВРаспоряженииНаРастарку КАК Лико_НомерЦепочкиВРаспоряженииНаРастарку,
						|	Лико_ПеремещениеПаллетаЗаказыНаРастарку.Характеристика КАК Характеристика,
						|	Лико_ПеремещениеПаллетаЗаказыНаРастарку.Намотка КАК Намотка,
						|	Лико_ПеремещениеПаллетаЗаказыНаРастарку.КодЭтикеткиЗаказчика КАК КодЭтикеткиЗаказчика,
						|	Лико_ПеремещениеПаллетаЗаказыНаРастарку.ЧестныйЗнак КАК ЧестныйЗнак,
						|	Лико_ПеремещениеПаллетаЗаказыНаРастарку.НомерПоставки КАК НомерПоставки,
						|	Лико_ПеремещениеПаллетаЗаказыНаРастарку.Город КАК Город,
						|	Лико_ПеремещениеПаллетаСодержимое.Серия КАК Серия
						|ПОМЕСТИТЬ ВТ_СерииИзРаспоряжений
						|ИЗ
						|	ВТ_Распоряжения КАК ВТ_Распоряжения
						|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_ПеремещениеПаллета.ЗаказыНаРастарку КАК Лико_ПеремещениеПаллетаЗаказыНаРастарку
						|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_ПеремещениеПаллета.Содержимое КАК Лико_ПеремещениеПаллетаСодержимое
						|			ПО Лико_ПеремещениеПаллетаЗаказыНаРастарку.Ссылка = Лико_ПеремещениеПаллетаСодержимое.Ссылка
						|				И Лико_ПеремещениеПаллетаЗаказыНаРастарку.Характеристика = Лико_ПеремещениеПаллетаСодержимое.Серия.Лико_ХарактеристикаВладелец
						|				И Лико_ПеремещениеПаллетаЗаказыНаРастарку.Намотка = Лико_ПеремещениеПаллетаСодержимое.Серия.Лико_НаправлениеНамотки
						|				И Лико_ПеремещениеПаллетаЗаказыНаРастарку.КодЭтикеткиЗаказчика = Лико_ПеремещениеПаллетаСодержимое.Серия.Лико_КодЭтикеткиЗаказчика
						|				И Лико_ПеремещениеПаллетаЗаказыНаРастарку.ЧестныйЗнак = Лико_ПеремещениеПаллетаСодержимое.Серия.Лико_ЧестныйЗнак
						|				И Лико_ПеремещениеПаллетаЗаказыНаРастарку.НомерПоставки = Лико_ПеремещениеПаллетаСодержимое.Серия.Лико_НомерПоставки
						|				И Лико_ПеремещениеПаллетаЗаказыНаРастарку.Город = Лико_ПеремещениеПаллетаСодержимое.Серия.Лико_Город
						|		ПО ВТ_Распоряжения.Лико_РаспоряжениеНаРастарку = Лико_ПеремещениеПаллетаЗаказыНаРастарку.Ссылка
						|			И ВТ_Распоряжения.Лико_НомерЦепочкиВРаспоряженииНаРастарку = Лико_ПеремещениеПаллетаЗаказыНаРастарку.НомерЦепочки
						|			И (Лико_ПеремещениеПаллетаЗаказыНаРастарку.ЭтоИсходнаяСтрока)
						|			И (Лико_ПеремещениеПаллетаЗаказыНаРастарку.Ссылка.Проведен)
						|			И (Лико_ПеремещениеПаллетаЗаказыНаРастарку.Ссылка.ЯчейкаПолучатель = &ЯчейкаРастарка)
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	ВТ_СерииСРаспоряжениями.Серия КАК Серия,
						|	ВТ_СерииСРаспоряжениями.Лико_РаспоряжениеНаРастарку КАК Лико_РаспоряжениеНаРастарку,
						|	ВТ_СерииСРаспоряжениями.Лико_НомерЦепочкиВРаспоряженииНаРастарку КАК Лико_НомерЦепочкиВРаспоряженииНаРастарку,
						|	ВТ_СерииСРаспоряжениями.Количество КАК Количество,
						|	ВТ_СерииСРаспоряжениями.Серия.Лико_ХарактеристикаВладелец КАК Характеристика,
						|	ВТ_СерииСРаспоряжениями.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры КАК Заказ,
						|	&Упаковка КАК Упаковка,
						|	ВЫРАЗИТЬ(ВТ_СерииСРаспоряжениями.Серия.Лико_ХарактеристикаВладелец.Владелец КАК Справочник.Номенклатура) КАК Номенклатура
						|ИЗ
						|	ВТ_СерииСРаспоряжениями КАК ВТ_СерииСРаспоряжениями
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	ВТ_СерииИзРаспоряжений.Лико_РаспоряжениеНаРастарку КАК Лико_РаспоряжениеНаРастарку,
						|	ВТ_СерииИзРаспоряжений.Лико_НомерЦепочкиВРаспоряженииНаРастарку КАК Лико_НомерЦепочкиВРаспоряженииНаРастарку,
						|	ВТ_СерииИзРаспоряжений.Серия КАК Серия,
						|	МАКСИМУМ(ТоварыВЯчейкахОстатки.ВНаличииОстаток) КАК Количество,
						|	ВТ_СерииИзРаспоряжений.Серия.Лико_ХарактеристикаВладелец КАК Характеристика,
						|	ВТ_СерииИзРаспоряжений.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры КАК Заказ,
						|	&Упаковка КАК Упаковка,
						|	ВЫРАЗИТЬ(ВТ_СерииИзРаспоряжений.Серия.Лико_ХарактеристикаВладелец.Владелец КАК Справочник.Номенклатура) КАК Номенклатура
						|ИЗ
						|	ВТ_СерииИзРаспоряжений КАК ВТ_СерииИзРаспоряжений
						|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
						|				,
						|				Серия В
						|						(ВЫБРАТЬ
						|							Т.Серия
						|						ИЗ
						|							ВТ_СерииИзРаспоряжений КАК Т)
						|					И Ячейка = &ЯчейкаРастарка) КАК ТоварыВЯчейкахОстатки
						|		ПО ВТ_СерииИзРаспоряжений.Серия = ТоварыВЯчейкахОстатки.Серия
						|
						|СГРУППИРОВАТЬ ПО
						|	ВТ_СерииИзРаспоряжений.Лико_РаспоряжениеНаРастарку,
						|	ВТ_СерииИзРаспоряжений.Лико_НомерЦепочкиВРаспоряженииНаРастарку,
						|	ВТ_СерииИзРаспоряжений.Серия,
						|	ВЫРАЗИТЬ(ВТ_СерииИзРаспоряжений.Серия.Лико_ХарактеристикаВладелец.Владелец КАК Справочник.Номенклатура),
						|	ВТ_СерииИзРаспоряжений.Серия.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры,
						|	ВТ_СерииИзРаспоряжений.Серия.Лико_ХарактеристикаВладелец";
						Запрос.УстановитьПараметр("Ссылка", Ссылка);
						Запрос.УстановитьПараметр("ЯчейкаРастарка", ЯчейкаРастарка);
						Запрос.УстановитьПараметр("Упаковка", Справочники.Лико_ПредопределенныеЗначения.УпаковкаТысШт.ЗначениеПараметра);
						РезультатыЗапроса = Запрос.ВыполнитьПакет();
						ТаблицаСерийСРаспоряжениями = РезультатыЗапроса[РезультатыЗапроса.Количество()-2].Выгрузить();
						ТаблицаСерийИзРаспоряженийВОстатках = РезультатыЗапроса[РезультатыЗапроса.Количество()-1].Выгрузить();

						// Сгруппируем коробки по распоряжениям на растарку
						ТаблицаРаспоряжений = ТаблицаСерийСРаспоряжениями.Скопировать();
						ТаблицаРаспоряжений.Свернуть("Лико_РаспоряжениеНаРастарку,Лико_НомерЦепочкиВРаспоряженииНаРастарку");
						МассивПоРаспоряжениям = Лико_Дополнительно.ТаблицаВМассивСтруктур(ТаблицаРаспоряжений);
						МассивФормированийИзКоторыхОтнялиКоробки = Новый Массив;
						Для каждого Структура из МассивПоРаспоряжениям Цикл
							КопияСтруктурыДляОтборов = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(Структура);
							ТаблицаСерийВыпускаПоРаспоряжению = ТаблицаСерийСРаспоряжениями.Скопировать(КопияСтруктурыДляОтборов);
							Структура.Вставить("ТаблицаСерийВыпускаПоРаспоряжению", ТаблицаСерийВыпускаПоРаспоряжению);
							ТаблицаСерийВыпускаПоРаспоряжениюКопия = ТаблицаСерийВыпускаПоРаспоряжению.Скопировать();
							ТаблицаСерийВыпускаПоРаспоряжениюКопия.Свернуть("Лико_РаспоряжениеНаРастарку,Лико_НомерЦепочкиВРаспоряженииНаРастарку", "Количество");
							КоличествоВыпуск = ТаблицаСерийВыпускаПоРаспоряжениюКопия[0].Количество;
							// Найдем в остатках серии по текущему распоряжению
							ТаблицаСерийРастаркиПоРаспоряжению = ТаблицаСерийИзРаспоряженийВОстатках.Скопировать(КопияСтруктурыДляОтборов);

							Если ТаблицаСерийРастаркиПоРаспоряжению.Количество() > 0 И ЗначениеЗаполнено(ТаблицаСерийВыпускаПоРаспоряжению[0].Серия.Лико_ДополнительныеНомераЦепочек) Тогда
								// Костыль для случаев, когда нужно смотать несколько заказов в один
								ТекРаспоряжение = ТаблицаСерийВыпускаПоРаспоряжению[0].Лико_РаспоряжениеНаРастарку;
								МассивДополнительныхНомеровЦепочек = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТаблицаСерийВыпускаПоРаспоряжению[0].Серия.Лико_ДополнительныеНомераЦепочек, ",", Истина, Истина);
								Для каждого ДопНомерЦепочкиСтрока из МассивДополнительныхНомеровЦепочек Цикл
									ДопНомерЦепочки = Число(ДопНомерЦепочкиСтрока);
									Запрос = Новый Запрос;
