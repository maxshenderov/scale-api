Функция СоздатьДокументКорректировкаРегистров(УжеСозданныйДокумент = Неопределено)
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйДокОбъект = Документы.КорректировкаРегистров.СоздатьДокумент();
	НовыйДокОбъект.Дата = Дата;
	НовыйДокОбъект.Комментарий = "Создан автоматически на основании документа """ + Ссылка + """";
	НовыйДокОбъект.Ответственный = ?(ЗначениеЗаполнено(РабочееМесто.Пользователь), РабочееМесто.Пользователь, ПараметрыСеанса.ТекущийПользователь);
	НовыйДокОбъект.Операция = Перечисления.ОперацииКорректировкиРегистров.РучнаяКорректировка;
	
	НоваяСтрока = НовыйДокОбъект.ТаблицаРегистров.Добавить();
	НоваяСтрока.Имя = "ДвиженияСерийТоваров";
	НоваяСтрока = НовыйДокОбъект.ТаблицаРегистров.Добавить();
	НоваяСтрока.Имя = "ТоварыВЯчейках";
	НоваяСтрока = НовыйДокОбъект.ТаблицаРегистров.Добавить();
	НоваяСтрока.Имя = "ТоварыНаСкладах";
	
	ТаблицаВыпуска = Документы.Лико_ФормированиеПаллета.СформироватьТаблицуДляКорректировкиРегистров(Содержимое.ВыгрузитьКолонку("Серия"), ЯчейкаПолучатель.Владелец);
	ТаблицаРастарки = Документы.Лико_ФормированиеПаллета.СформироватьТаблицуДляКорректировкиРегистров(СодержимоеРастарки.ВыгрузитьКолонку("Серия"), ЯчейкаРастарка.Владелец);
	МассивПриходныхОрдеров = ТаблицаРастарки.ВыгрузитьКолонку("ПриходныйОрдерНаТовары");
	МассивПриходныхОрдеров = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивПриходныхОрдеров);
	Если МассивПриходныхОрдеров.Количество() > 1 Тогда
		Сообщить("В распоряжении на растарку содержатся коробки из разных партий");
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;
	Если МассивПриходныхОрдеров.Количество() = 0 ИЛИ НЕ ЗначениеЗаполнено(МассивПриходныхОрдеров[0]) Тогда
		Сообщить("Не удалось получить партию коробок");
		Отказ = Истина;
		Возврат Неопределено;
	КонецЕсли;
	ПриходныйОрдерНаТовары = МассивПриходныхОрдеров[0];
	
	УпаковкаТысШт = Справочники.Лико_ПредопределенныеЗначения.УпаковкаТысШт.ЗначениеПараметра;
	Для каждого Строка из ТаблицаРастарки Цикл
		Движение = НовыйДокОбъект.Движения.ДвиженияСерийТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, Строка);
		Движение.Документ = ПриходныйОрдерНаТовары;
		Движение.Период = НовыйДокОбъект.Дата;
		Движение.Отправитель = Движение.Документ.Отправитель;
		Движение.СкладскаяОперация = Перечисления.СкладскиеОперации.ПриемкаОтПоставщика;
		Движение.Получатель = Движение.Документ.Склад;
		Движение.ЭтоСкладскоеДвижение = Истина;
		Движение.Количество = -Строка.Количество;
		
		Движение = НовыйДокОбъект.Движения.ТоварыВЯчейках.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, Строка);
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = НовыйДокОбъект.Дата;
		Движение.Упаковка = УпаковкаТысШт;
		Движение.Ячейка = ЯчейкаРастарка;
		Движение.ВНаличии = Строка.Количество;
		
		Движение = НовыйДокОбъект.Движения.ТоварыНаСкладах.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, Строка);
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = НовыйДокОбъект.Дата;
		Движение.Склад = ЯчейкаРастарка.Владелец;
		Движение.ВНаличии = Строка.Количество;
	КонецЦикла;
	
	Для каждого Строка из ТаблицаВыпуска Цикл
		Движение = НовыйДокОбъект.Движения.ДвиженияСерийТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, Строка);
		Движение.Документ = ПриходныйОрдерНаТовары;
		Движение.Период = НовыйДокОбъект.Дата;
		Движение.Отправитель = Движение.Документ.Отправитель;
		Движение.СкладскаяОперация = Перечисления.СкладскиеОперации.ПриемкаОтПоставщика;
		Движение.Получатель = Движение.Документ.Склад;
		Движение.ЭтоСкладскоеДвижение = Истина;
		Движение.Количество = Строка.Количество;
		
		Движение = НовыйДокОбъект.Движения.ТоварыВЯчейках.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, Строка);
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = НовыйДокОбъект.Дата;
		Движение.Упаковка = УпаковкаТысШт;
		Движение.Ячейка = ЯчейкаПолучатель;
		Движение.ВНаличии = Строка.Количество;
		
		Движение = НовыйДокОбъект.Движения.ТоварыНаСкладах.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, Строка);
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = НовыйДокОбъект.Дата;
		Движение.Склад = ЯчейкаПолучатель.Владелец;
		Движение.ВНаличии = Строка.Количество;
	КонецЦикла;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		Для каждого СтрокаТЧ из НовыйДокОбъект.ТаблицаРегистров Цикл
			УжеСозданныйДокументОбъект.Движения[СтрокаТЧ.Имя].Загрузить(НовыйДокОбъект.Движения[СтрокаТЧ.Имя].Выгрузить());
			УжеСозданныйДокументОбъект.Движения[СтрокаТЧ.Имя].Записать();
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
