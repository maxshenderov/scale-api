Процедура ПередЗаписьюБезРегионов(Отказ, РежимЗаписи, РежимПроведения)
	
	НомерСтроки=0;
	
	Для каждого Товар Из Товары Цикл
		ОбъектНоменклатуры=Товар.Серия.ЯССМ_ОбъектНоменклатуры;
		
		
		Если ОбъектНоменклатуры.Уникальный И 
			ОбъектНоменклатуры.Партнер <> Партнер И 
			ЗначениеЗаполнено(ОбъектНоменклатуры.Партнер) И 
			ЗначениеЗаполнено(Партнер) Тогда
			Отказ=Истина; 			
			
						
			
			ОбъектНоменклатуры_Партнер=ОбъектНоменклатуры.Партнер;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Материал: №%3 (%1) - %2 - #%4, необходимо снять с резерва: ""%5""!",
			Товар.Номенклатура.Код,
			Товар.Номенклатура,
			НомерСтроки+1,
			Формат(ОбъектНоменклатуры.НомерПоставки,"ЧДЦ=0; ЧГ="),
			ОбъектНоменклатуры_Партнер);
			Сообщение.Поле = "Товары["+НомерСтроки+"].Номенклатура"; //имя реквизита
			Сообщение.ПутьКДанным = "Объект";
			Сообщение.Сообщить();  				
			
		КонецЕсли;	
		НомерСтроки=НомерСтроки+1;
		
	КонецЦикла;
	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ОбъектНоменклатуры",Новый ОписаниеТипов("СправочникСсылка.ЯССМ_ОбъектыНоменклатуры"));
	Для каждого Товар Из Ссылка.Товары Цикл
		
		Если Товар.Серия.ЯССМ_ОбъектНоменклатуры.Уникальный Тогда
			
			НоваяСтрТз						=	ТЗ.Добавить();			 
			НоваяСтрТз.ОбъектНоменклатуры	= 	Товар.Серия.ЯССМ_ОбъектНоменклатуры;
			
		КонецЕсли;		
	КонецЦикла;
	
	ДополнительныеСвойства.Вставить("ТЗ_ОбъектыНоменклатуры",ТЗ); 
	                                                                                                                            
	ДополнительныеСвойства.Вставить("ОтменаРезерва",
	(Режимзаписи=РежимЗаписиДокумента.ОтменаПроведения И Ссылка.Проведен) Или 
	(Режимзаписи=РежимЗаписиДокумента.Проведение И Не ЗначениеЗаполнено(Партнер) И ЗначениеЗаполнено(Ссылка.Партнер)));

	
КонецПроцедуры


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

		
	
	Если Не Документы.Лико_УстановкаРезерваМатериалов.СтартРезевированияПодРегионы() Тогда
		
		ПередЗаписьюБезРегионов(Отказ, РежимЗаписи, РежимПроведения);
		
		Возврат;
		
	КонецЕсли;

	
