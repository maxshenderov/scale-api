			НомерСтроки+1,
			Формат(ОбъектНоменклатуры.НомерПоставки,"ЧДЦ=0; ЧГ="),
			ОбъектНоменклатуры_Резерв);
			Сообщение.Поле = "Товары["+НомерСтроки+"].Номенклатура"; //имя реквизита
			Сообщение.ПутьКДанным = "Объект";
			Сообщение.Сообщить();  				
			
		КонецЕсли;	
		НомерСтроки=НомерСтроки+1;
		
	КонецЦикла;
	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ОбъектНоменклатуры",Новый ОписаниеТипов("СправочникСсылка.ЯССМ_ОбъектыНоменклатуры"));
	Для каждого Товар Из Ссылка.Товары Цикл
		
		Если Товар.Серия.ЯССМ_ОбъектНоменклатуры.Уникальный Тогда
			
			НоваяСтрТз						=	ТЗ.Добавить();			 
			НоваяСтрТз.ОбъектНоменклатуры	= 	Товар.Серия.ЯССМ_ОбъектНоменклатуры;
			
		КонецЕсли;		
	КонецЦикла;
	
	ДополнительныеСвойства.Вставить("ТЗ_ОбъектыНоменклатуры",ТЗ); 
	                                                                                                                            
	ДополнительныеСвойства.Вставить("ОтменаРезерва",
	(Режимзаписи=РежимЗаписиДокумента.ОтменаПроведения И Ссылка.Проведен) Или 
	(Режимзаписи=РежимЗаписиДокумента.Проведение И Не ЗначениеЗаполнено(Резерв) И ЗначениеЗаполнено(Ссылка.Резерв)));

	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ИнициализироватьДокумент(ДанныеЗаполнения); 		
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Движения.Лико_РезервСерий.Записывать = Истина;

	ТЗ = ДополнительныеСвойства.ТЗ_ОбъектыНоменклатуры;
	
	Для каждого Товар Из Товары Цикл
		
		Если Товар.Серия.ЯССМ_ОбъектНоменклатуры.Уникальный Тогда
			
			 Движение 						=	Движения.Лико_РезервСерий.Добавить();
             Движение.Период				=	Дата;
			 Движение.Серия					=	Товар.Серия;
			 Движение.Партнер				=	Партнер; 
			 Если ЗначениеЗаполнено(Резерв) Тогда
				 Движение.Резерв				=	Резерв;
				 Движение.Партнер				=	Резерв;
			 КонецЕсли;
			 Движение.ОбъектНоменклатуры	=	Товар.Серия.ЯССМ_ОбъектНоменклатуры;
			 
			НоваяСтрТз						=	ТЗ.Добавить();			 
			НоваяСтрТз.ОбъектНоменклатуры	= 	 Движение.ОбъектНоменклатуры;

			
		КонецЕсли;
		
		
	КонецЦикла; 
		
		 Движения.Лико_РезервСерий.Записать(Истина);

	
	ТЗ.Свернуть("ОбъектНоменклатуры");
	
	Справочники.ЯССМ_ОбъектыНоменклатуры.УстановитьРезерв(ТЗ.ВыгрузитьКолонку("ОбъектНоменклатуры"));
		
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив; 
	
	Если Не ЗначениеЗаполнено(Партнер) И  Не ЗначениеЗаполнено(Резерв) Тогда
		ПроверяемыеРеквизиты.Добавить("Комментарий");
	КонецЕсли;
	
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);

КонецПроцедуры


Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Дата          	= ТекущаяДатаСеанса();
	Ответственный 	= Пользователи.ТекущийПользователь();
	Структура 		= Новый Структура;
	Лико_ОбщегоНазначенияСервер.РеквизитыШапки(Структура);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,Структура);
	
	Если Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ЗаполнениеСотрудникаВЗаявке",Ложь) Тогда
	КонецЕсли; 
	
	Если ТипЗнч(ДанныеЗаполнения)=Тип("Структура") Тогда
		
		
		 ЗаполнитьЗначенияСвойств(ЭтотОбъект,ДанныеЗаполнения);
		 
		 Если ДанныеЗаполнения.Свойство("МассивСерий") Тогда
			 
			 Для каждого Серия Из ДанныеЗаполнения.МассивСерий  Цикл 
				 
			НовыйТовар 					=	Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйТовар,Серия);
				 
			 	
			 КонецЦикла;
			 
		 КонецЕсли;
		 
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ТЗ = ДополнительныеСвойства.ТЗ_ОбъектыНоменклатуры;

	ТЗ.Свернуть("ОбъектНоменклатуры");
	
	 Движения.Лико_РезервСерий.Записывать=Истина;
	 Движения.Лико_РезервСерий.Записать(Истина);
	
	Справочники.ЯССМ_ОбъектыНоменклатуры.УстановитьРезерв(ТЗ.ВыгрузитьКолонку("ОбъектНоменклатуры"));

		
КонецПроцедуры


Процедура НаписатьПисьмоОтменаРезерва()
	ТабДок = Новый ТабличныйДокумент;
	
	Документы.Лико_УстановкаРезерваМатериалов.Печать(ТабДок,Ссылка);
	
	ИмяТемпФайла = ПолучитьИмяВременногоФайла();
	ТабДок.Записать(ИмяТемпФайла,ТипФайлаТабличногоДокумента.HTML5);
	ТекстHТМЛ = Новый ТекстовыйДокумент;
	ТекстHТМЛ.Прочитать(ИмяТемпФайла);
	ТекстHТМЛ = ТекстHТМЛ.ПолучитьТекст(); 					
	Текст=" Отмена резерва материалов : " ;
	Текст = Текст + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Ссылка); //+ " от " + Формат(Дата, "ДФ='дд ММММ гггг'");
	Текст = Текст + ". Объект "+ ?(ЗначениеЗаполнено(Резерв),Строка(Резерв), Строка(Партнер));
	Тема  = Текст;  
	Текст=ТекстHТМЛ;
	ТипСообщения=Справочники.Лико_ТипыСообщений.ОтменаРезерваМетериалов;
	Адресат = Справочники.Лико_ТипыСообщений.ПолучитьПочтовыеАдреса(ТипСообщения,Организация); 		
	Лико_Планирование.ОтправитьПисьмо(Текст, Тема, Адресат); 
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	
	
	Если ДополнительныеСвойства.ОтменаРезерва Тогда
		
		НаписатьПисьмоОтменаРезерва(); 
		
	КонецЕсли;
	
КонецПроцедуры


