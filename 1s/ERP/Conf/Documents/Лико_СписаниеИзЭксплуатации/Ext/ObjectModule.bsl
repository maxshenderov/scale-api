Процедура СписатьИзЭксплуатации(Отказ) //+Лико m.shenderov 31.10.2017
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТМЦВЭксплуатацииОбороты.Номенклатура КАК Номенклатура,
	|	ТМЦВЭксплуатацииОбороты.Характеристика КАК Характеристика,
	|	ТМЦВЭксплуатацииОбороты.Партия КАК ПартияТМЦВЭксплуатации,
	|	ТМЦВЭксплуатацииОбороты.КоличествоОборот КАК Количество,
	|	ТМЦВЭксплуатацииОбороты.ФизическоеЛицо КАК ФизическоеЛицо,
	|	&СтатьяРасходов КАК СтатьяРасходов,
	|	&АналитикаРасходов КАК АналитикаРасходов
	|ИЗ
	|	РегистрНакопления.ТМЦВЭксплуатации.Обороты(
	|			,
	|			&Дата,
	|			,
	|			Организация = &Организация
	|				И Подразделение = &Подразделение) КАК ТМЦВЭксплуатацииОбороты
	|ГДЕ
	|	ТМЦВЭксплуатацииОбороты.КоличествоОборот > 0";
	Запрос.УстановитьПараметр("Дата",Месяц);
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("Подразделение",Подразделение);
	Запрос.УстановитьПараметр("АналитикаРасходов",Подразделение);
	КатегорияЭксплуатации= Справочники.Лико_ПредопределенныеЗначения.КатегорияЭксплуатации.ЗначениеПараметра;	
	Запрос.УстановитьПараметр("СтатьяРасходов",КатегорияЭксплуатации.СтатьяРасходов);


	

	РезультатЗапроса = Запрос.Выполнить();

	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	ТЗ=РезультатЗапроса.Выгрузить();
	ДокументСписанияИзЭксплуатации=НайтиДокументСписанияИзЭксплуатации();
	//ДокументСписанияИзЭксплуатации=  Документы.СписаниеИзЭксплуатации.СоздатьДокумент();
	 
	
	//ЗаполнитьЗначенияСвойств(ДокументПередачаВЭксплуатацию,ЭтотОбъект,,"Ссылка,Дата,ХозяйственнаяОперация");
	ДокументСписанияИзЭксплуатации.Дата=КонецДня(Месяц);
	ДокументСписанияИзЭксплуатации.Организация=Организация;
	ДокументСписанияИзЭксплуатации.Подразделение=Подразделение;
	
	
	ДокументСписанияИзЭксплуатации.Товары.Загрузить(ТЗ);
	
		
	
	
	ДокументСписанияИзЭксплуатации.Лико_Распоряжение=Ссылка;
	
	
	Попытка
		ДокументСписанияИзЭксплуатации.Записать(РежимЗаписиДокумента.Проведение); 		
	Исключение
		//Отказ = Истина;
		ДокументСписанияИзЭксплуатации.Записать(РежимЗаписиДокумента.Запись);
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + ДокументСписанияИзЭксплуатации + """ не удалось провести! " + ОписаниеОшибки());		
	КонецПопытки;
	
	Если Не Отказ Тогда
		НаборЗаписей = РегистрыСведений.Лико_СвязиСТиповымиДокументами.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Документ.Установить(Ссылка);
		НоваяЗапись= НаборЗаписей.Добавить();
		НоваяЗапись.Документ=Ссылка;
		НоваяЗапись.ТиповойДокумент=ДокументСписанияИзЭксплуатации.Ссылка;
		НоваяЗапись.НомерВЦепочке=1;
		НаборЗаписей.Записать(Истина);		
	КонецЕсли;
	
	
	
	
	
	
КонецПроцедуры //-Лико m.shenderov 31.10.2017

