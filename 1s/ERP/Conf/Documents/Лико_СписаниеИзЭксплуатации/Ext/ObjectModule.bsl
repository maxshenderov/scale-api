Функция НайтиДокументПередачаВЭксплуатацию () //+Лико m.shenderov 31.10.2017
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВнутреннееПотреблениеТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВнутреннееПотребление КАК ВнутреннееПотреблениеТоваров
	|ГДЕ
	|	ВнутреннееПотреблениеТоваров.Лико_Распоряжение = &Лико_Распоряжение";
	Запрос.УстановитьПараметр("Лико_Распоряжение",Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если  РезультатЗапроса.Пустой() Тогда
		Возврат Документы.ВнутреннееПотребление.СоздатьДокумент();
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Возврат  Выборка.Ссылка.ПолучитьОбъект();
		КонецЦикла;
	КонецЕсли;
	
КонецФункции //-Лико m.shenderov 31.10.2017 

