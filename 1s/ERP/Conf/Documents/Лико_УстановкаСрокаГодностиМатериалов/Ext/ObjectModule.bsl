
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ИнициализироватьДокумент(ДанныеЗаполнения);
	
	КонецПроцедуры


Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Дата          = ТекущаяДатаСеанса();
	Ответственный = Пользователи.ТекущийПользователь();
	Структура = Новый Структура;
	Лико_ОбщегоНазначенияСервер.РеквизитыШапки(Структура);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,Структура);
	Если Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ЗаполнениеСотрудникаВЗаявке",Ложь) Тогда
		Сотрудник=АвторДокумента;
	КонецЕсли;
	
КонецПроцедуры


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	УстановитьПривилегированныйРежим(Истина);
	
	   	Если Проведен и РежимЗаписи<>РежимЗаписиДокумента.ОтменаПроведения Тогда
			Отка=Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Перед записью документа необходимо отменить проведение!";
			Сообщение.Сообщить();
		КонецЕсли;
		

	Для каждого Товар Из Товары Цикл
		ОбъектНоменклатуры=Товар.Серия.ЯССМ_ОбъектНоменклатуры;		
		Если РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда			
			Товар.УпотребитьДо=ОбъектНоменклатуры.УпотребитьДо;
			Товар.ДатаПроизводства = ОбъектНоменклатуры.ДатаПроизводства;
			Если ОбъектНоменклатуры.УпотребитьДо <> Товар.УпотребитьДоНовый Тогда  
			Справочники.ЯССМ_ОбъектыНоменклатуры.УстановитьСрокГодности(ОбъектНоменклатуры,Товар.УпотребитьДоНовый);
		КонецЕсли;
		Если  ЗначениеЗаполнено(Товар.ДатаПроизводстваНовый) И  ОбъектНоменклатуры.ДатаПроизводства<> Товар.ДатаПроизводстваНовый Тогда
			Справочники.ЯССМ_ОбъектыНоменклатуры.УстановитьДатуПроизводства(ОбъектНоменклатуры,Товар.ДатаПроизводстваНовый);
		КонецЕсли;	
		ИначеЕсли РежимЗаписи=РежимЗаписиДокумента.ОтменаПроведения Тогда
			Справочники.ЯССМ_ОбъектыНоменклатуры.УстановитьСрокГодности(ОбъектНоменклатуры,Товар.УпотребитьДо);
			Справочники.ЯССМ_ОбъектыНоменклатуры.УстановитьДатуПроизводства(ОбъектНоменклатуры,Товар.ДатаПроизводства);
		КонецЕсли;		
	КонецЦикла;  	
	
КонецПроцедуры

