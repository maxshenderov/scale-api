&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	

	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если Параметры.Свойство("ЗаявкаНаРемонтРЦ") Тогда 
		Объект.ЗаявкаНаРемонтРЦ=Параметры.ЗаявкаНаРемонтРЦ;
	КонецЕсли;
	
	Если Параметры.Свойство("РабочийЦентр") Тогда 
		Объект.РабочийЦентр=Параметры.РабочийЦентр;
	КонецЕсли;
	

	
	УстановитьУсловноеОформление(); 
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);	
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	ПриЧтенииСозданииНаСервере();
	
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 	
	
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	СразуНаПринтер=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ПечатьСразуНаПринтер",Ложь);	
Утверждение();
	
КонецПроцедуры



