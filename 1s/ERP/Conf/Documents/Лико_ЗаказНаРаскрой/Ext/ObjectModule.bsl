КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	 Статус=Неопределено; 
	 ИнициализироватьДокумент();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Если ВидРабот<>Справочники.ВидыРаботСотрудников.Активация Тогда
		МассивНепроверяемыхРеквизитов.Добавить("НоменклатураВыпуск");
	КонецЕсли;
	
	
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
	
	
КонецПроцедуры


#Область ИнициализацияИЗаполнение

Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	Если ТипЗнч(ДанныеЗаполнения)=Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект,ДанныеЗаполнения);
	КонецЕсли;
	
	
	Дата          = ТекущаяДатаСеанса();
	Ответственный = Пользователи.ТекущийПользователь();
	АвторДокумента=Ответственный.ФизическоеЛицо;
	Структура = Новый Структура;
	Лико_ОбщегоНазначенияСервер.РеквизитыШапки(Структура);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,Структура);
	
КонецПроцедуры

#КонецОбласти


#Область Дополнительно
Функция ПолучитьРаскройСтрокой() //+Лико m.shenderov 14.06.2022
	Строка="";
	
	Для каждого СтрРаскрой Из Раскрой  Цикл
		
		//Строка=Строка+СтрШаблон("%1-%2-%3;",СтрРаскрой.Нарезка,СтрРаскрой.КоличествоРоликов,СтрРаскрой.ДлинаРолика);
		Строка=Строка+СтрШаблон("%1-%2;",СтрРаскрой.Нарезка,СтрРаскрой.КоличествоРоликов);
		
		
		
	КонецЦикла; 
	Возврат ?(СтрДлина(Строка)>140,СтрШаблон("%1...",Лев(Строка,137)),Строка); 	
	
КонецФункции //-Лико m.shenderov 14.06.2022 

