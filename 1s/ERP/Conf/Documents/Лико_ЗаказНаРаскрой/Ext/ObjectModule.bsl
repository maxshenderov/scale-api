
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ИнициализироватьДокумент(ДанныеЗаполнения); 		
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		
		АвторДокумента=ПараметрыСеанса.ТекущийПользователь.ФизическоеЛицо;
		Ответственный=ПараметрыСеанса.ТекущийПользователь;
		Состояние=Справочники.Лико_ЭтапыВыполненияЗаказа.Производство;
		Номенклатура=Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;	
КонецПроцедуры


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	УстановитьПривилегированныйРежим(Истина);
	РаскройСтрокой=ПолучитьРаскройСтрокой(); 

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоНовый() Или ВидРабот<>Ссылка.ВидРабот Тогда

		ОбменДанными.Загрузка=Истина;
		Записать();
		ОбменДанными.Загрузка=Ложь;

	КонецЕсли;


	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);	




	Если Не ЗначениеЗаполнено(ВидРабот) Тогда
		ВидРабот=Справочники.ВидыРаботСотрудников.РаскройМатериала;
	КонецЕсли;

	//ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);		
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);	
	Если РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда 	
		Если Состояние<>Ссылка.Состояние И Состояние=Справочники.Лико_ЭтапыВыполненияЗаказа.ЗакрытиеЗаказа Тогда
			Закрыт=Истина;
			ДатаЗакрытия=ТекущаяДата();
		Иначе
			Закрыт=Ложь;
			ДатаЗакрытия=Неопределено;
		КонецЕсли;

	КонецЕсли;

	Номен=?(ТипЗнч(Номенклатура)=Тип("СправочникСсылка.ЦеновыеГруппы"),Номенклатура.ОсновнаяНоменклатура,Номенклатура);
	КоличествоНожей= Раскрой.Итог("КоличествоРоликов")+?(ПодрезкаКромка,1,-1); 

	Правило=Справочники.Лико_ПараметрыРасчетаРаскрояМатериалов.ОпределитьПравило(Номенклатура,,Ссылка); 
	Если ЗначениеЗаполнено(Правило) Тогда
		
		Если ВидРабот= Справочники.ВидыРаботСотрудников.Переворот Тогда
			
			ПЗВ=Документы.Лико_ЗаказНаРаскрой.ПЗВПереворот();	
		Иначе
			ПЗВ=Документы.Лико_ЗаказНаРаскрой.ПЗВ();	
		КонецЕсли;
		

		КоличествоРоликов=Раскрой.Итог("КоличествоРоликов");  

		Если КоличествоРоликов=0  Тогда   	
			СредняяДлинаРолика=Документы.Лико_ЗаказНаРаскрой.СредняяДлинаРоика(); 
			//КоличествоРоликов=Окр(КоличествоУпаковок/СредняяДлинаРолика)*ЗаказКлиента.РучьиПечати;
			КоличествоРоликов=ЗаказКлиента.РучьиПечати; 
			КоличествоНожей= КоличествоРоликов+?(ПодрезкаКромка,1,-1); 

		Иначе   		   
			//СредняяДлинаРолика=КоличествоУпаковок/КоличествоРоликов;
			СредняяДлинаРолика=Раскрой[0].ДлинаРолика;
			//КоличествоРоликов=Окр(КоличествоУпаковок/СредняяДлинаРолика)*Раскрой.Итог("КоличествоРоликов");
		КонецЕсли;
		Попытка

			ВремяРезкиМин=ПЗВ+
			КоличествоУпаковок/Правило.Скорость+
			КоличествоУпаковок/СредняяДлинаРолика*(Правило.ВремяСъема+КоличествоРоликов*Правило.ВремяРолика)
			+КоличествоУпаковок/Правило.ДлинаЮмбы*Правило.ВремяЮмбы+
			(КоличествоНожей)*Правило.ВремяНастройкиНожей;
			ВремяВыполненияПлан=ВремяРезкиМин/60;

			ВремяРаботыМин=КоличествоУпаковок/Правило.Скорость
			+КоличествоУпаковок/СредняяДлинаРолика*(Правило.ВремяСъема+КоличествоРоликов*Правило.ВремяРолика)
			+КоличествоУпаковок/Правило.ДлинаЮмбы*Правило.ВремяЮмбы;
			ВремяРаботыПлан=ВремяРаботыМин/60;

			ВремяНастройки=ПЗВ+(КоличествоНожей)*Правило.ВремяНастройкиНожей;
			ВремяНастройкиПлан=ВремяНастройки/60;


			ВремяВыполненияПланВремя=Документы.Лико_ЗаказНаРаскрой.ФорматироватьЧислоКакВремя(ВремяВыполненияПлан);
			ВремяРаботыПланВремя=Документы.Лико_ЗаказНаРаскрой.ФорматироватьЧислоКакВремя(ВремяРаботыПлан);
			ВремяНастройкиПланВремя=Документы.Лико_ЗаказНаРаскрой.ФорматироватьЧислоКакВремя(ВремяНастройкиПлан);


		Исключение
			//ОписаниеОшибки()
		КонецПопытки;

	КонецЕсли;

	//B12+ 
	//B14/B5+
	//B14/B15*B6
	//+B16*B7+
	//B14/B4*B8+
	//(B16+1)*B9 

	//$B12+
	//$B23/B5+
	//$B23/$B24*(B6+$B25*B7)+
	//$B23/B4*B8+
	//($B25+1)*B9   

	//ВремяРезкиМин=ПЗВ
	//+КоличествоУпаковок/Правило.Скорость
	//+КоличествоУпаковок/СредняяДлинаРолика*(Правило.ВремяСъема+КоличествоРоликов*Правило.ВремяРолика)
	//+КоличествоУпаковок/Правило.ДлинаЮмбы*Правило.ВремяЮмбы
	//+(КоличествоРоликов+1)*Правило.ВремяНастройкиНожей;



	Если ЗначениеЗаполнено(ЗаказКлиента) И Раскрой.Итог("КоличествоРоликов")=0 Тогда
		КоличествоНожей=Макс(КоличествоНожей,ЗаказКлиента.РучьиПечати+1);
	КонецЕсли;


	НормативРезки=Справочники.Лико_ПараметрыРасчетаРаскрояМатериалов.ОпределитьНормативРезки(Номен,КоличествоНожей,КоличествоУпаковок,Правило);

	Если НормативРезки=0 Тогда
		НормативРезки=1;
	КонецЕсли;


КонецПроцедуры


Процедура ОбработкаПроведения(Отказ, РежимПроведения)
   УстановитьПривилегированныйРежим(Истина);
	Движения.Лико_РаскройМатериаловПланФакт.Записывать = Истина;

	Движение=Движения.Лико_РаскройМатериаловПланФакт.ДобавитьПриход();
	Движение.Период=Дата;
	Движение.Заказ=Ссылка;
	Движение.Количество=КоличествоУпаковок;
	
	
КонецПроцедуры

Процедура СтруктураПараметровЗаписиОбъекта() 	
	
	Если Не ДополнительныеСвойства.Свойство("ЕстьВопросыПередЗаписью") ТОгда
		ДополнительныеСвойства.Вставить("ЕстьВопросыПередЗаписью", Ложь);
	КонецЕсли;
	Если Не ДополнительныеСвойства.Свойство("НовыйОбъект") ТОгда
		ДополнительныеСвойства.Вставить("НовыйОбъект", Ложь); 		
	КонецЕсли;
	Если Не ДополнительныеСвойства.Свойство("ПринудительноЗакрытьФорму") ТОгда
		ДополнительныеСвойства.Вставить("ПринудительноЗакрытьФорму", Ложь); 		
	КонецЕсли;
	Если Не ДополнительныеСвойства.Свойство("РежимЗаписи") ТОгда
		ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписиДокумента.Запись);		
	КонецЕсли; 	
	Если Не ДополнительныеСвойства.Свойство("РежимПроведения") ТОгда
		ДополнительныеСвойства.Вставить("РежимПроведения", РежимПроведенияДокумента.Неоперативный); 	
	КонецЕсли;
	
Конецпроцедуры

