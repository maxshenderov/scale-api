			|
			|СГРУППИРОВАТЬ ПО
			|	Лико_ПараметрыПроизводстваЗаказа.Заказ,
			|	Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр,
			|	Лико_ПараметрыПроизводстваЗаказа.НомерПроката";
			ЗапросРезка.УстановитьПараметр("Заказ", ЗаказКлиента);
			ВыборкаРезка = ЗапросРезка.Выполнить().Выбрать();
           	Пока ВыборкаРезка.Следующий() Цикл
				Возврат ЗаполнитьСтруктуруПоЗаказуКлиента(ЗаказКлиента,ВыборкаРезка.РабочийЦентр,ВыборкаРезка.Метраж);
			КонецЦикла;

	      	
КонецФункции //-Лико m.shenderov 18.07.2022 

Функция ПолучитьСтатистикуПоНарезке(Организация,Номенклатура,КолМес=3) Экспорт //+Лико m.shenderov 02.10.2023
	ДатаОкончания=ТекущаяДата();
	
	ДатаНачала=ДатаОкончания-КолМес*30*24*60*60;

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ТоварыКРаспределениюОбороты.Номенклатура КАК Номенклатура,
	|	Лико_ТоварыКРаспределениюОбороты.Характеристика.ЯССМ_Нарезка КАК Нарезка,
	|	Лико_ТоварыКРаспределениюОбороты.КоличествоОборот / &КолМес КАК СреднийРасходЗаМесяц,
	|	Лико_ТоварыКРаспределениюОбороты.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	РегистрНакопления.Лико_ТоварыКРаспределению.Обороты(
	|			&Дата1,
	|			&Дата2,
	|			,
	|			Номенклатура = &Номенклатура
	|				И РабочийЦентр.Лико_Площадка.Организация = &Организация
	|				И НЕ РабочийЦентр.Лико_Резак) КАК Лико_ТоварыКРаспределениюОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.Характеристика КАК Характеристика,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК ВНаличииОстаток
	|ПОМЕСТИТЬ ВременнаяТаблица1
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			(Номенклатура, Характеристика) В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						Вт.Номенклатура,
	|						Вт.Характеристика
	|					ИЗ
	|						ВременнаяТаблица КАК Вт)
	|				И Ячейка.Помещение.Лико_Организация = &Организация
	|				И Ячейка.Помещение.Лико_ТипСклада = ЗНАЧЕНИЕ(Перечисление.Лико_ТипСклада.Сим)
	|				И НЕ Ячейка.Помещение.Лико_ПомещениеБрака) КАК ТоварыВЯчейкахОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблица.Номенклатура КАК Номенклатура,
	|	ВременнаяТаблица.Характеристика КАК Характеристика,
	|	ВременнаяТаблица.Нарезка КАК Нарезка,
	|	ВременнаяТаблица.СреднийРасходЗаМесяц КАК СреднийРасходЗаМесяц,
	|	ЕСТЬNULL(ВременнаяТаблица1.ВНаличииОстаток, 0) КАК Остаток,
	|	ВременнаяТаблица.СреднийРасходЗаМесяц - ЕСТЬNULL(ВременнаяТаблица1.ВНаличииОстаток, 0) КАК Потребность,
	|	ВременнаяТаблица.Нарезка.Размер КАК НарезкаРазмер
	|ИЗ
	|	ВременнаяТаблица1 КАК ВременнаяТаблица1
	|		ПРАВОЕ СОЕДИНЕНИЕ ВременнаяТаблица КАК ВременнаяТаблица
	|		ПО (ВременнаяТаблица.Номенклатура = ВременнаяТаблица1.Номенклатура)
	|			И (ВременнаяТаблица.Характеристика = ВременнаяТаблица1.Характеристика)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НарезкаРазмер";
	Запрос.УстановитьПараметр("Дата1",ДатаНачала ); 
	Запрос.УстановитьПараметр("Дата2",ДатаОкончания ); 
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура ); 
	Запрос.УстановитьПараметр("Организация",Организация ); 
	Запрос.УстановитьПараметр("КолМес",КолМес ); 
	
	Возврат Запрос.Выполнить();
	

	РезультатЗапроса = Запрос.Выполнить();
	
	
	
	
КонецФункции //-Лико m.shenderov 02.10.2023 
