Функция ФорматироватьЧислоКакВремя(ЧислоВремя) Экспорт  //+Лико m.shenderov 15.06.2022
	
	Часы	= Цел(ЧислоВремя);
	Мин	= (((ЧислоВремя*60))%60)/100;
	Возврат Часы+Мин;  
	
	
КонецФункции  //-Лико m.shenderov 15.06.2022

Функция РасчитатьВремяВыполнения(Заказ,КоличествоУпаковок=Неопределено,Правило=Неопределено) Экспорт  //+Лико m.shenderov 10.07.2022
	
	Если Правило=Неопределено Тогда
		Правило=Заказ.Правило;
	КонецЕсли;
	
	Если КоличествоУпаковок=Неопределено Тогда
	КоличествоУпаковок=Заказ.КоличествоУпаковок;
	КонецЕсли;
	
		Структура = Новый Структура;
		Структура.Вставить("ВремяВыполненияПлан",0);
		Структура.Вставить("ВремяВыполненияПланВремя",0);
		Если ЗначениеЗаполнено(Правило) Тогда
		ПЗВ=Документы.Лико_ЗаказНаРаскрой.ПЗВ();
		
		КоличествоРоликов=Заказ.Раскрой.Итог("КоличествоРоликов");  
		
		Если КоличествоРоликов=0  Тогда   	
			СредняяДлинаРолика=Документы.Лико_ЗаказНаРаскрой.СредняяДлинаРоика(); 
			КоличествоРоликов=Окр(Заказ.КоличествоУпаковок/СредняяДлинаРолика)*Заказ.ЗаказКлиента.РучьиПечати; 
			КоличествоНожей= КоличествоРоликов+?(Заказ.ПодрезкаКромка,1,-1); 

		Иначе   		   
			СредняяДлинаРолика=КоличествоУпаковок/КоличествоРоликов; 
		КонецЕсли;
		Попытка
			
			ВремяРезкиМин=ПЗВ+
			КоличествоУпаковок/Правило.Скорость+
			КоличествоУпаковок/СредняяДлинаРолика*(Правило.ВремяСъема+КоличествоРоликов*Правило.ВремяРолика)+
			КоличествоУпаковок/Правило.ДлинаЮмбы*Правило.ВремяЮмбы+
			(КоличествоРоликов+1)*Правило.ВремяНастройкиНожей;
			Структура.ВремяВыполненияПлан=ВремяРезкиМин/60;
			Структура.ВремяВыполненияПланВремя=Документы.Лико_ЗаказНаРаскрой.ФорматироватьЧислоКакВремя(Структура.ВремяВыполненияПлан);
		Исключение
			//ОписаниеОшибки()
		КонецПопытки;
        КонецЕсли;
	     Возврат Структура;
	
КонецФункции //-Лико m.shenderov 10.07.2022 

Функция ЗаполнитьСтруктуруПоЗаказуКлиента(ЗаказКлиента,РабочийЦентр,Метраж) Экспорт //+Лико m.shenderov 20.06.2022
	
	Структура = Новый Структура;
	
	Структура.Вставить("ЗаказКлиента"	    ,ЗаказКлиента);
	Структура.Вставить("РабочийЦентр"		,РабочийЦентр);
	Структура.Вставить("КоличествоУпаковок" ,Метраж);
	Структура.Вставить("Нарезка"			,Неопределено);
	Структура.Вставить("Номенклатура"		,ПолучитьНоменклатуруПолуфабриката(ЗаказКлиента));
	Структура.Вставить("Организация"		,ЗаказКлиента.Площадка.Организация);
	Возврат Структура;
	
		
КонецФункции //-Лико m.shenderov 20.06.2022


