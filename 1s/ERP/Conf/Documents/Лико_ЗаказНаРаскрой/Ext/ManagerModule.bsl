Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("Ссылка");
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("ВидРабот");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Данные.ВидРабот) Тогда

		ПредставлениеОперации = СписокОпераций().НайтиПоЗначению(Данные.ВидРабот);
		Если ПредставлениеОперации <> Неопределено Тогда
			ПредставлениеОперации = ПредставлениеОперации.Представление;
		Иначе
			ПредставлениеОперации = "Раскрой";
		КонецЕсли;
		
		СтандартнаяОбработка = Ложь;
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='%1 %2 от %3'"),
			ПредставлениеОперации,
			Данные.Номер,
			Данные.Дата);
		
	КонецЕсли;
		
КонецПроцедуры


Функция СписокОпераций() Экспорт

	СписокОпераций = Новый СписокЗначений;
	
	Раскрой							= ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.РаскройМатериала");
	Активация						= ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.Активация");
	
	
		
	СписокОпераций.Добавить(Раскрой, 				НСтр("ru = 'лк Заказ на раскрой'"));
	СписокОпераций.Добавить(Активация,    		 	НСтр("ru = 'лк Заказ на активацию'"));
	
	
		
	Возврат СписокОпераций;

КонецФункции


Процедура СоздатьПоЗаказуКлиента(ЗаказКлиента, РабочийЦентр,Метраж) Экспорт

ЗаказНаРаскрой=НайтиЗаказНаРаскройПоЗаказуКлиента(ЗаказКлиента); 

	Если ТипЗнч(ЗаказНаРаскрой)=Тип("ДокументСсылка.Лико_ЗаказНаРаскрой") Тогда
		ДокОбъект=ЗаказНаРаскрой.ПолучитьОбъект();
	Иначе
		ДокОбъект=Документы.Лико_ЗаказНаРаскрой.СоздатьДокумент(); 
		ДокОбъект.АвторДокумента=ПараметрыСеанса.ТекущийПользователь.ФизическоеЛицо;
		ДокОбъект.Ответственный=ПараметрыСеанса.ТекущийПользователь;
		ДокОбъект.Состояние=Справочники.Лико_ЭтапыВыполненияЗаказа.Производство;

	КонецЕсли; 
	Если РабочийЦентр.ВидРабочегоЦентра=Справочники.ВидыРабочихЦентров.Rotomec  Тогда
		 РабочийЦентрЗаказаНаРаскрой=Справочники.РабочиеЦентры.НайтиПоНаименованию("Резак Peter Shmits");
	 Иначе
		 РабочийЦентрЗаказаНаРаскрой=РабочийЦентр; 
	КонецЕсли;
	
	ДокОбъект.ПометкаУдаления	=Ложь;
	ДокОбъект.ЗаказКлиента		=ЗаказКлиента;
	ДокОбъект.РабочийЦентр		=РабочийЦентрЗаказаНаРаскрой;
	ДокОбъект.КоличествоУпаковок=Метраж;
	ДокОбъект.Нарезка			=Неопределено;
	ДокОбъект.Номенклатура		=ПолучитьНоменклатуруПолуфабриката(ЗаказКлиента);
	ДокОбъект.Организация		=ЗаказКлиента.Площадка.Организация;
	ДокОбъект.Дата				=ТекущаяДата();
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);




КонецПроцедуры


Функция НайтиЗаказНаРаскройПоЗаказуКлиента(ЗаказКлиента) //+Лико m.shenderov 20.06.2022

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗаказНаРаскрой.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лико_ЗаказНаРаскрой КАК Лико_ЗаказНаРаскрой
	|ГДЕ
	|	Лико_ЗаказНаРаскрой.ЗаказКлиента = &ЗаказКлиента";
	Запрос.УстановитьПараметр("ЗаказКлиента",ЗаказКлиента );
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
	    Возврат Выборка.Ссылка;
	КонецЦикла; 


		
КонецФункции //-Лико m.shenderov 20.06.2022
 
 Функция ПолучитьНоменклатуруПолуфабриката(ЗаказКлиента) Экспорт  
	 УстановитьПривилегированныйРежим(Истина);
	 НомерЗаказа=ЗаказКлиента.НомерБезПрефикса;
	 МенеджерЗаказа=ЗаказКлиента.Менеджер;
	 МассивСозданныхОбъектов = Новый Массив;
	 
	 Запрос=Новый Запрос;
	 
	 Запрос.Текст ="ВЫБРАТЬ
	 |	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
	 |	ХарактеристикиНоменклатуры.Владелец КАК Номенклатура
	 |ИЗ
	 |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	 |ГДЕ
	 |	ХарактеристикиНоменклатуры.Лико_ЗаказНоменклатуры = &Заказ
	 |	И ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры = &ВидНоменклатуры";
	 
	 Запрос.УстановитьПараметр("Заказ",ЗаказКлиента);
	 Запрос.УстановитьПараметр("ВидНоменклатуры", Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра);
	 
	 РезультатЗапроса = Запрос.Выполнить();
	 
	 НоменклатураНезавершенка = Неопределено;
	 ХарактеристикаНезавершенка = Неопределено;
	 
	 //=--------- создаем незавершенку -----
	 РодительНезавершенкаНоменклатура = Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра;
	 РодительНезавершенка = Справочники.Лико_ПредопределенныеЗначения.ГруппаОбъектовНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра;
	 
	 Если Не РезультатЗапроса.Пустой() Тогда
		 ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		 ВыборкаЗапроса.Следующий();
		 
		 ХарактеристикаНезавершенка = ВыборкаЗапроса.Характеристика;
		 НоменклатураНезавершенка = ХарактеристикаНезавершенка.Владелец;
	 Иначе 	//запрос пуст!
		 
		 Если ЗначениеЗаполнено(МенеджерЗаказа) Тогда
			 ФИО = МенеджерЗаказа.Наименование;
			 Фамилия		= ВыделитьСлово(ФИО);
			 Имя			= ВыделитьСлово(ФИО);
			 Отчество	= ВыделитьСлово(ФИО);
			 ФИОСтрока = Фамилия+" "+Лев(имя,1)+"."+Лев(Отчество,1)+".";
		 Иначе
			 ФИОСтрока = "";
		 КонецЕсли;
		 //---------=
		 
		 Номенклатура1С = Справочники.Номенклатура.СоздатьЭлемент();
		 Номенклатура1С.УстановитьНовыйКод("n");
		 Номенклатура1С.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра;
		 Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Номенклатура1С);
		 
		 Номенклатура1С.Наименование = "Незавершенное производство по заказу №" + Формат(НомерЗаказа, "ЧГ=0") + " (" + ФИОСтрока + ")";
		 Номенклатура1С.НаименованиеПолное = Номенклатура1С.Наименование;
		 
		 Если Не РодительНезавершенкаНоменклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
			 Номенклатура1С.Родитель = РодительНезавершенкаНоменклатура;			
		 КонецЕсли;
		 Номенклатура1С.Записать();
		 
		 НоменклатураНезавершенка = Номенклатура1С.Ссылка;
		 
		 ХарактеристикаНезавершенкаОбъект=Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
		 ХарактеристикаНезавершенкаОбъект.Владелец=НоменклатураНезавершенка;
		 ХарактеристикаНезавершенкаОбъект.Лико_ЗаказНоменклатуры=ЗаказКлиента;
		 ХарактеристикаНезавершенкаОбъект.Записать();
		 ХарактеристикаНезавершенка=ХарактеристикаНезавершенкаОбъект.Ссылка;
	 КонецЕсли;
	 
	 Возврат НоменклатураНезавершенка;
	 
 КонецФункции //СоздатьОбъектыНоменклатуры
 
 
/// Функция выделяет первое слово в предложении
Функция ВыделитьСлово(ИсходнаяСтрока) Экспорт
	
	Буфер = СокрЛ(ИсходнаяСтрока);
	ПозицияПослПробела = Найти(Буфер, " ");
	
	Если ПозицияПослПробела = 0 Тогда
		ИсходнаяСтрока = "";
		Возврат Буфер;
	КонецЕсли;
	
	ВыделенноеСлово = СокрЛП(Лев(Буфер, ПозицияПослПробела));
	ИсходнаяСтрока = Сред(ИсходнаяСтрока, ПозицияПослПробела + 1);
	
	Возврат ВыделенноеСлово;
	
КонецФункции



