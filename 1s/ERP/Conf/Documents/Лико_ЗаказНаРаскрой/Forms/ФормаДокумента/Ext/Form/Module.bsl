
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	Если Объект.Номенклатура<>Неопределено Тогда
		Код=Объект.Номенклатура.Код;
	КонецЕсли;
	
	Если Объект.НоменклатураВыпуск<>Неопределено Тогда
		КодВыпуск=Объект.НоменклатураВыпуск.Код;
	КонецЕсли;
	
	СразуНаПринтер=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("СразуНаПринтер");
	ПечатьЗаказНаРаскрой=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ПечатьЗаказаНаРаскрой");
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	
	// Подсистема WebSocket
	ПоказыватьQRCode=Ложь;
	WebSocketСервер.Инициализация(ЭтаФорма,ПоказыватьQRCode);
	// Подсистема WebSocket
	//
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	
	РедактированиеОрганизации();
	
    ЗаполнитьСтатистикуСервер();
	
	Если Документы.Лико_УстановкаРезерваМатериалов.СтартРезевированияПодРегионы() Тогда
		
		Элементы.Резерв.Видимость=Истина;
		Элементы.Партнер.Видимость = Ложь;
	Иначе
		Элементы.Резерв.Видимость = Ложь;
		Элементы.Партнер.Видимость = Истина;

				
	КонецЕсли;


КонецПроцедуры

