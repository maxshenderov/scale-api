&НаСервере
Процедура ЗагузитьНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(Лико_БланкЭтапаТовары.КоличествоРасход) КАК МетражПоЗаказу,
	|	Лико_БланкЭтапаТовары.Характеристика.ЯССМ_Нарезка КАК Нарезка,
	|	Лико_БланкЭтапаТовары.Ссылка.Сотрудник КАК Печатник,
	|	Лико_БланкЭтапаТовары.Ссылка.Дата КАК ДатаПечати,
	|	Лико_БланкЭтапаТовары.Ссылка.РабочийЦентр КАК РабочийЦентр,
	|	Лико_БланкЭтапаТовары.Ссылка.НомерБланка КАК НомерБланка
	|ИЗ
	|	Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
	|ГДЕ
	|	Лико_БланкЭтапаТовары.Ссылка.ЗаказНаРаскрой = &ЗаказНаРаскрой
	|	И Лико_БланкЭтапаТовары.Ссылка.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_БланкЭтапаТовары.Характеристика.ЯССМ_Нарезка,
	|	Лико_БланкЭтапаТовары.Ссылка.Сотрудник,
	|	Лико_БланкЭтапаТовары.Ссылка.Дата,
	|	Лико_БланкЭтапаТовары.Ссылка.РабочийЦентр,
	|	Лико_БланкЭтапаТовары.Ссылка.НомерБланка";
	Запрос.УстановитьПараметр("ЗаказНаРаскрой",Объект.Ссылка );
	Объект.ДанныеПоРаскрою.Загрузить( Запрос.Выполнить().Выгрузить());
	
	
	
	
КонецПроцедуры

