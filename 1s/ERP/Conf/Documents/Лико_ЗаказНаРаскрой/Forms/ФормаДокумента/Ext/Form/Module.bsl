&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	// ПодключаемоеОборудование
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" Тогда
			ОбработатьШтрихкоды(ПодключаемоеОборудованиеУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр));
		КонецЕсли;
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	

КонецПроцедуры



&НаКлиенте
Процедура ОбработатьШтрихкоды(ДанныеШтрихкода)
	
	
	
	Результат = Лико_ДополнительноКлиент.ОбработатьШтрихКодНеТовара(ДанныеШтрихкода.Штрихкод);
	Если Результат.Ошибка <> "" Тогда 			
			
			Сообщить(Результат.Ошибка); 				
	Иначе
					
		Если Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Сотрудника") Тогда
			//Это физ. лицо
			
			Объект.Ответственный = Результат.Сотрудник;
		ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры_Короткий") Или 			
			Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры") Тогда
			
			
			Если Не ЗначениеЗаполнено(Результат.ОбъектНоменклатуры) Тогда  				
				Сообщить("Штрих код не найден! "+ Результат.ШК);
				Возврат;	
			КонецЕсли;			
			ОбработатьШКНоменклатуры(Результат);					
		Иначе
			//ОбработатьШтрихкодыТиповой(ДанныеШтрихкода);			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ОбработатьШКНоменклатуры(Результат);
	
ОбъектНоменклатуры			=Результат.ОбъектНоменклатуры;
//ОбъектНоменклатуры			=Справочники.ЯССМ_ОбъектыНоменклатуры.СоздатьЭлемент();
Объект.Номенклатура			=ОбъектНоменклатуры.Номенклатура;
Объект.Нарезка				=ОбъектНоменклатуры.Нарезка;
Объект.КоличествоУпаковок	=ОбъектНоменклатуры.Количество; 

Если Объект.Организация=Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра Тогда
	Если Не ЗначениеЗаполнено(Объект.ВидРабот) Тогда
    	Объект.ВидРабот     =Справочники.ВидыРаботСотрудников.РаскройМатериала;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.РабочийЦентр) Тогда
    	Объект.РабочийЦентр     =Справочники.РабочиеЦентры.НайтиПоНаименованию("Перемотка",Истина);
	КонецЕсли;
КонецЕсли;
	
		
КонецПроцедуры //-Лико m.shenderov 14.01.2018

