&НаСервере
Процедура ЗаполнитьСтатистикуСервер() //+Лико m.shenderov 02.10.2023
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТопНарезокПоИспользованию.Очистить();
	
	Если ЗначениеЗаполнено(Объект.Номенклатура) Тогда
		
		 Номенклатура= ?(ТипЗнч(Объект.Номенклатура)=Тип("СправочникСсылка.Номенклатура"),Объект.Номенклатура,Объект.Номенклатура.ОсновнаяНоменклатура);
		 
		 ТопНарезокПоИспользованию.Загрузить(
		 Документы.Лико_ЗаказНаРаскрой.ПолучитьСтатистикуПоНарезке(Объект.Организация,Номенклатура).Выгрузить());
		
	КонецЕсли;
	
	
КонецПроцедуры  //-Лико m.shenderov 02.10.2023


