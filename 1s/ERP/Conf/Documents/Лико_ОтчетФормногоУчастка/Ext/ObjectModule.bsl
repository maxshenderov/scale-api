
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ссылка) И Ссылка.Проведен И НЕ (РольДоступна("ПолныеПрава") ИЛИ РольДоступна("Лико_ДополнительныеПраваНачальникаФормногоУчастка")) И Дата < ТекущаяДата() - 86400 Тогда
		Отказ = Истина;
		Сообщить("Нельзя вносить изменения в проведенные документы по истечении 24 часов.");
		Возврат;
	КонецЕсли;
	
	Для каждого ТЧ Из Метаданные().ТабличныеЧасти Цикл
		Для каждого Строка из ЭтотОбъект[ТЧ.Имя] Цикл
			// Если время меньше 9:30, то будем ставить вчерашнюю дату
			// 9:30 = 34200 секунд
			КолСек = Дата - НачалоДня(Дата);
			Если КолСек < 34200 Тогда
				Строка.Дата = Дата-86400;
			Иначе
				Строка.Дата = Дата;
			КонецЕсли;
			Строка.Смена = Смена;
			Строка.Сотрудник = Сотрудник;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	// Сначала удалим из заказов, связанных с этим отчетом, все связанные строки
	УдалитьИзЗаказовСвязанныеСтроки(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Теперь запишем в заказы данные из табличной части в зависимости от типа документа
	Если ТипДокумента = Перечисления.Лико_ТипыДокументовОтчетФормногоУчастка.Формы Тогда
		ИмяТЧ = "ИзготовлениеФорм";
	ИначеЕсли ТипДокумента = Перечисления.Лико_ТипыДокументовОтчетФормногоУчастка.ЗасветкиStork Тогда
		ИмяТЧ = "ЗасветкаStork";
	ИначеЕсли ТипДокумента = Перечисления.Лико_ТипыДокументовОтчетФормногоУчастка.ТрафаретныеСетки Тогда
		ИмяТЧ = "ТрафСетки";
	Иначе
		Сообщить("Тип документа """ + ТипДокумента + """ не предусмотрен разработчиками программы.");
		ОтменитьТранзакцию();
		Возврат;
	КонецЕсли;
	
	Для каждого Строка из ЭтотОбъект[ИмяТЧ] Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Заказ) Тогда
			Сообщить("В строке № " + Строка.НомерСтроки + " не заполнен заказ. Строка пропущена");
			Продолжить;
		КонецЕсли;
		ЗаказОбъект = Строка.Заказ.ПолучитьОбъект();
		НоваяСтрока = ЗаказОбъект[ИмяТЧ].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,, "НомерСтроки");
		НоваяСтрока.ОтчетФормногоУчастка = Ссылка;
		Попытка
			ЗаказОбъект.Записать(?(ЗаказОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
		Исключение
			Сообщить("Не удалось добавить строки в документ """ + Строка.Заказ + """: " + ОписаниеОшибки());
			ОтменитьТранзакцию();
			Возврат;
		КонецПопытки;
	
		
	КонецЦикла;
	

	НаборЗаписейЗатраты = РегистрыНакопления.Лико_ЗатратыПоЗаказу.СоздатьНаборЗаписей();
	НаборЗаписейЗатраты.Отбор.Регистратор.Установить(Ссылка);
	НаборЗаписейЗатраты.Записать();
	
	НаборЗаписейЗатратыДляОтгрузки = РегистрыНакопления.Лико_ЗатратыПоЗаказуДляОтгрузки.СоздатьНаборЗаписей();
	НаборЗаписейЗатратыДляОтгрузки.Отбор.Регистратор.Установить(Ссылка);
	НаборЗаписейЗатратыДляОтгрузки.Записать();
	
	
	

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ОтчетФормногоУчасткаИзготовлениеФорм.Заказ КАК Заказ,
	|	Лико_ОтчетФормногоУчасткаИзготовлениеФорм.Ссылка.ВидПечати КАК ВидПечати,
	|	СУММА(Лико_ОтчетФормногоУчасткаИзготовлениеФорм.Заказ.ПлощадьКлише) КАК ПлощадьКлише,
	|	СУММА(Лико_ОтчетФормногоУчасткаИзготовлениеФорм.КоличествоНовых) КАК КоличествоШТ,
	|	Лико_ОтчетФормногоУчасткаИзготовлениеФорм.РабочийЦентр КАК РабочийЦентр,
	|	Лико_ОтчетФормногоУчасткаИзготовлениеФорм.НомерПроката КАК НомерПроката,
	|	ВЫБОР
	|		КОГДА Лико_ОтчетФормногоУчасткаИзготовлениеФорм.Ссылка.ВидПечати = ЗНАЧЕНИЕ(Справочник.Лико_ВидыПечати.Флексо)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПолимерДляФлексоКлише)
	|		КОГДА Лико_ОтчетФормногоУчасткаИзготовлениеФорм.Ссылка.ВидПечати = ЗНАЧЕНИЕ(Справочник.Лико_ВидыПечати.Офсет)
	|			ТОГДА Лико_ОтчетФормногоУчасткаИзготовлениеФорм.РабочийЦентр.ВидРабочегоЦентра.лкЦГКлише
	|	КОНЕЦ КАК ЦеноваяГруппа,
	|	Лико_ОтчетФормногоУчасткаИзготовлениеФорм.Ссылка.Дата КАК Дата,
	|	СУММА(ВЫБОР
	|			КОГДА Лико_ОтчетФормногоУчасткаИзготовлениеФорм.Ссылка.ВидПечати = ЗНАЧЕНИЕ(Справочник.Лико_ВидыПечати.Флексо)
	|				ТОГДА Лико_ОтчетФормногоУчасткаИзготовлениеФорм.КоличествоНовых * Лико_ОтчетФормногоУчасткаИзготовлениеФорм.Заказ.ПлощадьКлише * Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение / 10000
	|			КОГДА Лико_ОтчетФормногоУчасткаИзготовлениеФорм.Ссылка.ВидПечати = ЗНАЧЕНИЕ(Справочник.Лико_ВидыПечати.Офсет)
