	|	СУММА(ЕСТЬNULL(Лико_ЦеныГруппНоменклатурыСрезПоследнихТабаш.Цена, 0) * ВТ.Количество),
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.КлишеФлексо)),
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПолотноДляФормного)),
	|	СУММА(ЕСТЬNULL(Лико_ЦеныГруппНоменклатурыСрезПоследнихТабашФакт.Цена, 0) * ВТ.Количество),
	|	NULL
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
	|				&Дата,
	|				ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.Табаш)
	|					И Площадка = &Площадка
	|					И ЦеноваяГруппа = ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПолотноДляФормного)) КАК Лико_ЦеныГруппНоменклатурыСрезПоследнихТабаш
	|		ПО (ИСТИНА)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
	|				&Дата,
	|				ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ТабашФакт)
	|					И Площадка = &Площадка
	|					И ЦеноваяГруппа = ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПолотноДляФормного)) КАК Лико_ЦеныГруппНоменклатурыСрезПоследнихТабашФакт
	|		ПО (ИСТИНА)
	|ГДЕ
	|	ВТ.ВидПечати = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыПечати.Флексо)
	|	И ВТ.Дата < ДАТАВРЕМЯ(2021, 7, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Заказ,
	|	ВТ.РабочийЦентр,
	|	ВТ.НомерПроката,
	|	ВТ.Количество";
	Запрос.УстановитьПараметр("Ссылка", ссылка);
	Запрос.УстановитьПараметр("Площадка", Организация);
	Запрос.УстановитьПараметр("ПлощадкаЛикофлекс", Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра);
	Запрос.УстановитьПараметр("Дата", КонецМесяца(Дата));


	Выборка = Запрос.Выполнить().Выбрать();
	ПОка Выборка.Следующий() Цикл
		Запись =НаборЗаписейЗатраты.Добавить();
		Запись.Регистратор = Ссылка;
		Запись.Период = Дата;
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		
		
		Если  ОстаткиПоЗатратам ИЛИ Дата >= '20190101000000' Тогда 
			ЗаписьОстатки =НаборЗаписейЗатратыДляОтгрузки.Добавить();
			ЗаписьОстатки.Регистратор = Ссылка;
			ЗаписьОстатки.Период = Дата;
			ЗаписьОстатки.ВидДвижения = ВидДвиженияНакопления.Приход;
			ЗаполнитьЗначенияСвойств(ЗаписьОстатки, Выборка);
			ЗаписьОстатки.Сумма = Выборка.СуммаПлан;
			Если Выборка.СтатьяЗатрат = Справочники.Лико_СтатьиЗатрат.КлишеФлексо Тогда 
				ЗаписьОстатки.Количество = Выборка.КоличествоШт;
			КонецЕсли;
			
			//ЗаписьЗатратыпоЗаказуДляПродажи =НаборЗаписейЗатратыДляПродажи.Добавить();
			//ЗаполнитьЗначенияСвойств(ЗаписьЗатратыпоЗаказуДляПродажи , ЗаписьОстатки);

		КонецЕсли;	

	КонецЦикла;
	НаборЗаписейЗатраты.Записать();
  	НаборЗаписейЗатратыДляОтгрузки.Записать();
	//НаборЗаписейЗатратыДляПродажи.Записать();



	ЗафиксироватьТранзакцию();
			
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	УстановитьПривилегированныйРежим(Истина);
	НачатьТранзакцию();
	УдалитьИзЗаказовСвязанныеСтроки(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Процедура УдалитьИзЗаказовСвязанныеСтроки(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.ИзготовлениеФорм.ОтчетФормногоУчастка = &ОтчетФормногоУчастка";
	
	Запрос.УстановитьПараметр("ОтчетФормногоУчастка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаказОбъект = Выборка.Ссылка.ПолучитьОбъект();
		//Для каждого ТЧ Из Метаданные().ТабличныеЧасти Цикл
			НайденныеСтроки = ЗаказОбъект.ИзготовлениеФорм.НайтиСтроки(Новый Структура("ОтчетФормногоУчастка", Ссылка));
			Для каждого Строка из НайденныеСтроки Цикл
				ЗаказОбъект.ИзготовлениеФорм.Удалить(Строка);
			КонецЦикла;
		//КонецЦикла;
		Попытка
			ЗаказОбъект.Записать(?(ЗаказОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
		Исключение
			Отказ = Истина;
			Сообщить("Не удалось удалить строки из документа """ + Выборка.Ссылка + """: " + ОписаниеОшибки());
			ОтменитьТранзакцию();
			Возврат;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры
