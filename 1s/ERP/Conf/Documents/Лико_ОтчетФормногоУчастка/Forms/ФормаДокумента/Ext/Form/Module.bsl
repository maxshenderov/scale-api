//Начало изменений Иванова Анна 20181106 
&НаСервере
Процедура  ЗаполнитьПрокатРабочийЦентрНаСервере(ИмяТЧ, Идентификатор, НомерПроката= Неопределено, РабочийЦентр= Неопределено)
	УстановитьПривилегированныйРежим(Истина);
	текстр = Объект[ИмяТЧ].НайтиПоИдентификатору(Идентификатор);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказ", текстр.Заказ);
	Если ЗначениеЗаполнено(НомерПроката) ТОгда 		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ЗаказКлиентаВидыРабот.РабочийЦентр, ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.ПустаяСсылка)) КАК РабочийЦентр,
		|	ЗаказКлиентаВидыРабот.Ссылка КАК Заказ
		|ИЗ
		|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
		|ГДЕ
		|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ
		|	И ЗаказКлиентаВидыРабот.НомерПроката = &НомерПроката";
		Запрос.УстановитьПараметр("НомерПроката", НомерПроката);
		Результат = Запрос.Выполнить().Выбрать();
		Результат.Следующий();
		текстр.рабочийцентр = Результат.РабочийЦентр;
	ИначеЕсли ЗначениеЗаполнено(Рабочийцентр) ТОгда  
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаВидыРабот.Ссылка КАК Заказ,
		|	ЕСТЬNULL(ЗаказКлиентаВидыРабот.НомерПроката, 0) КАК НомерПроката
		|ИЗ
		|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
		|ГДЕ
		|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ
		|	И ЗаказКлиентаВидыРабот.РабочийЦентр.ВидРабочегоЦентра = &ВидРЦ";
		Запрос.УстановитьПараметр("ВидРЦ", РабочийЦентр.ВидРабочегоЦентра);
		Результат = Запрос.Выполнить().Выбрать();
		Результат.Следующий();
		текстр.номерпроката = результат.номерпроката;
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаЦвета.Ссылка КАК Заказ,
		|	ЗаказКлиентаЦвета.НомерПроката КАК НомерПроката
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
		|ГДЕ
		|	ЗаказКлиентаЦвета.Ссылка = &Заказ
		|	И ВЫБОР
		|			КОГДА &ТипДокумента = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыДокументовОтчетФормногоУчастка.Формы)
		|				ТОГДА ЗаказКлиентаЦвета.ВидПечати = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыПечати.Флексо)
		|						ИЛИ ЗаказКлиентаЦвета.ВидПечати = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыПечати.Офсет)
		|			ИНАЧЕ ЗаказКлиентаЦвета.ВидПечати = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыПечати.Траф)
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаЦвета.НомерПроката,
		|	ЗаказКлиентаЦвета.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказКлиентаВидыРабот.Ссылка КАК Заказ,
		|	ЕСТЬNULL(ЗаказКлиентаВидыРабот.РабочийЦентр, ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.ПустаяСсылка)) КАК РабочийЦентр,
		|	ВТ.НомерПроката КАК НомерПроката
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
		|		ПО ВТ.Заказ = ЗаказКлиентаВидыРабот.Ссылка
		|			И ВТ.НомерПроката = ЗаказКлиентаВидыРабот.НомерПроката
		|ГДЕ
		|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаВидыРабот.Ссылка,
		|	ВТ.НомерПроката,
		|	ЕСТЬNULL(ЗаказКлиентаВидыРабот.РабочийЦентр, ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.ПустаяСсылка))";
		Запрос.УстановитьПараметр("ТипДокумента", Объект.ТипДокумента);
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Количество() = 1 Тогда 
			Результат.Следующий();
			текстр.рабочийцентр = Результат.РабочийЦентр;
			текстр.номерпроката = Результат.НомерПроката;
		КонецЕсли;

	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
		
КонецПроцедуры

&НаКлиенте
Процедура НомерПрокатаПриИзменении(Элемент)
	ИмяТЧ = Элемент.Родитель.Имя;
	текстр = Элементы[ИмяТЧ].ТекущиеДанные;
	Если ЗначениеЗаполнено(текстр.НомерПроката) И ЗначениеЗаполнено(текстр.Заказ) Тогда 	
		//Если Не ЗначениеЗаполнено(стр.РабочийЦентр) ТОгда 
			Идентификатор = текстр.ПолучитьИдентификатор();
			ЗаполнитьПрокатРабочийЦентрНаСервере(ИмяТЧ, Идентификатор, текстр.НомерПроката);
		//КонецЕсли;			
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РабочийЦентрПриИзменении(Элемент)
	ИмяТЧ = Элемент.Родитель.Имя;
	текстр = Элементы[ИмяТЧ].ТекущиеДанные;
	Если ЗначениеЗаполнено(текстр.РабочийЦентр) И ЗначениеЗаполнено(текстр.Заказ) Тогда 	
		Если Не ЗначениеЗаполнено(текстр.НомерПроката) ТОгда 
			Идентификатор = текстр.ПолучитьИдентификатор();
			ЗаполнитьПрокатРабочийЦентрНаСервере(ИмяТЧ, Идентификатор, ,текстр.рабочийЦентр);
		КонецЕсли;			
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказПриИзменении(Элемент)
	ИмяТЧ = Элемент.Родитель.Имя;
	текстр = Элементы[ИмяТЧ].ТекущиеДанные;
	Если ЗначениеЗаполнено(текстр.Заказ) Тогда 
		Идентификатор = текстр.ПолучитьИдентификатор();
		ЗаполнитьПрокатРабочийЦентрНаСервере(ИмяТЧ, Идентификатор,);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзготовлениеФормШиринаПриИзменении(Элемент)
	текстр = Элементы.ИзготовлениеФорм.ТекущиеДанные;
	текстр.площадь = текстр.ширина*текстр.длина;
КонецПроцедуры

&НаКлиенте
Процедура ИзготовлениеФормДлинаПриИзменении(Элемент)
	текстр = Элементы.ИзготовлениеФорм.ТекущиеДанные;
	текстр.площадь = текстр.ширина*текстр.длина;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Не ЗначениеЗаполнено(Объект.ВидПечати) Тогда 
		Сообщить("Необходимо указать вид форм: офсет или флексо");
		Отказ = Истина;
	КонецЕсли;
	Отказ = ПроверитьПлощадьКлишеНаСервере()
КонецПроцедуры

&НаСервере
Функция ПроверитьПлощадьКлишеНаСервере()
	Если Объект.ВидПечати = Справочники.Лико_ВидыПечати.Флексо Тогда
		Для Каждого Стр из Объект.ИзготовлениеФорм Цикл
			Если Не ЗначениеЗаполнено(стр.Заказ) Тогда 
				Сообщить("Необходимо указать заказ в строке "+стр.номерстроки);
				Возврат Истина;
			Иначе
				Если Не ЗначениеЗаполнено(стр.Заказ.ПлощадьКлише) Тогда 
				    Сообщить("Не указана площадь клише "+стр.номерстроки);
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
КонецФункции
						

//КонецИзменений Иванова Анна 20181106

