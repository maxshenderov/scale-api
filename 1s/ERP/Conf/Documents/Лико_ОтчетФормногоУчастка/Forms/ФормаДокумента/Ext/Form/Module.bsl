
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипДокумента) Тогда
		Объект.ТипДокумента = Перечисления.Лико_ТипыДокументовОтчетФормногоУчастка.Формы;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Если ЗначениеЗаполнено(Объект.Сотрудник) Тогда
		ТабельныйНомер = Число(Прав(Объект.Сотрудник.Код, 10));
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	ПредыдущийТипДокумента = Объект.ТипДокумента;
	
	УстановитьВидимостьДоступностьЭлементов();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДоступностьЭлементов()
	
	Элементы.ИзготовлениеФорм.Видимость = Объект.ТипДокумента = Перечисления.Лико_ТипыДокументовОтчетФормногоУчастка.Формы;
	Элементы.ЗасветкаStork.Видимость = Объект.ТипДокумента = Перечисления.Лико_ТипыДокументовОтчетФормногоУчастка.ЗасветкиStork;
	Элементы.ТрафСетки.Видимость = Объект.ТипДокумента = Перечисления.Лико_ТипыДокументовОтчетФормногоУчастка.ТрафаретныеСетки;
	
	Если НЕ (РольДоступна("ПолныеПрава") ИЛИ РольДоступна("Лико_ДополнительныеПраваНачальникаФормногоУчастка")) Тогда
		Если Объект.Проведен Тогда
			Если Объект.Дата < ТекущаяДата() - 86400 Тогда
				ТолькоПросмотр = Истина;
			КонецЕсли;
			Элементы.ТабельныйНомер.ТолькоПросмотр = Истина;
		КонецЕсли;
		Элементы.Дата.ТолькоПросмотр = Истина;
	КонецЕсли;
	Если НЕ РольДоступна("ПолныеПрава") Тогда
		Элементы.Сотрудник.Доступность = Ложь;
		Элементы.ОстаткиПоЗатратам.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипДокументаПриИзменении(Элемент)
	
	Если ПредыдущийТипДокумента <> Объект.ТипДокумента И ПроверитьНеобходимостьЗадаватьВопрос() Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ОтветНаВопросОНеобходимостиИзмененияТипаДокумента", ЭтотОбъект), "По предыдущему типу документа (" + ПредыдущийТипДокумента + ") уже есть введенные данные. При изменении они будут очищены." + Символы.ПС + "Вы уверены, что хотите изменить тип документа?", РежимДиалогаВопрос.ДаНетОтмена);
	Иначе
		ПредыдущийТипДокумента = Объект.ТипДокумента;
		УстановитьВидимостьДоступностьЭлементов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ТабельныйНомерПриИзмененииНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	Объект.Сотрудник = Неопределено;
	Если НЕ ЗначениеЗаполнено(ТабельныйНомер) Тогда
		Возврат;
	КонецЕсли;
	Объект.Сотрудник = Лико_Дополнительно.ОпределитьСотрудникаПоТабНомеру(ТабельныйНомер);
	Если ЗначениеЗаполнено(Объект.Сотрудник) Тогда
		ТабельныйНомер = Формат(Число(Прав(Объект.Сотрудник.Код, 10)), "ЧГ=0");
		//УстановитьПривилегированныйРежим(Истина);
		Объект.Организация = Объект.Сотрудник.ГоловнаяОрганизация;
		//УстановитьПривилегированныйРежим(Ложь);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТабельныйНомерПриИзменении(Элемент)
	
	ТабельныйНомерПриИзмененииНаСервере();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьНеобходимостьЗадаватьВопрос()
	
	Если (ПредыдущийТипДокумента = Перечисления.Лико_ТипыДокументовОтчетФормногоУчастка.Формы И Объект.ИзготовлениеФорм.Количество() > 0)
		ИЛИ (ПредыдущийТипДокумента = Перечисления.Лико_ТипыДокументовОтчетФормногоУчастка.ЗасветкиStork И Объект.ЗасветкаStork.Количество() > 0)
		ИЛИ (ПредыдущийТипДокумента = Перечисления.Лико_ТипыДокументовОтчетФормногоУчастка.ТрафаретныеСетки И Объект.ТрафСетки.Количество() > 0) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОтветНаВопросОНеобходимостиИзмененияТипаДокумента(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если ПредыдущийТипДокумента = Объект.ТипДокумента Тогда
			Возврат;
		Иначе
			// Чистим ТЧ
			ПочиститьТЧВЗависимостиОтТипа();
		КонецЕсли;
	Иначе
		// Возвращаем тип
		Объект.ТипДокумента = ПредыдущийТипДокумента;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПочиститьТЧВЗависимостиОтТипа()
	
	Если ПредыдущийТипДокумента = Перечисления.Лико_ТипыДокументовОтчетФормногоУчастка.Формы Тогда
		Объект.ИзготовлениеФорм.Очистить();
	ИначеЕсли ПредыдущийТипДокумента = Перечисления.Лико_ТипыДокументовОтчетФормногоУчастка.ЗасветкиStork Тогда
		Объект.ЗасветкаStork.Очистить();
	ИначеЕсли ПредыдущийТипДокумента = Перечисления.Лико_ТипыДокументовОтчетФормногоУчастка.ТрафаретныеСетки Тогда
		Объект.ТрафСетки.Очистить();
	КонецЕсли;
	ПредыдущийТипДокумента = Объект.ТипДокумента;
	УстановитьВидимостьДоступностьЭлементов();
	
КонецПроцедуры

