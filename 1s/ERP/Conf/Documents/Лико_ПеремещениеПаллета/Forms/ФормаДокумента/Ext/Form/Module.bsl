&НаКлиенте
Процедура ЗаказыНаРастаркуКоличествоПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ЗаказыНаРастарку.ТекущиеДанные;
	// Найдем исходную строку
	ИсходныеСтроки = Объект.ЗаказыНаРастарку.НайтиСтроки(Новый Структура("ИдентификаторСвязи,ЭтоИсходнаяСтрока", ТекущаяСтрока.ИдентификаторСвязи, Истина));
	Если ИсходныеСтроки.Количество() <> 1 Тогда
		Сообщить("Ошибка: найдено " + ИсходныеСтроки.Количество() + " исходных строк");
		Возврат;
	КонецЕсли;
	ИсходнаяСтрока = ИсходныеСтроки[0];
	// Найдем НЕ исходные строки
	НеИсходныеСтроки = Объект.ЗаказыНаРастарку.НайтиСтроки(Новый Структура("ИдентификаторСвязи,ЭтоИсходнаяСтрока", ТекущаяСтрока.ИдентификаторСвязи, Ложь));
	КоличествоВНеИсходныхСтроках = 0;
	МаксимальныйНомерСтроки = 0;
	Для каждого Строка из НеИсходныеСтроки Цикл
		КоличествоВНеИсходныхСтроках = КоличествоВНеИсходныхСтроках + Строка.Количество;
		МаксимальныйНомерСтроки = Макс(МаксимальныйНомерСтроки, Строка.НомерСтроки);
	КонецЦикла;
	
	Если КоличествоВНеИсходныхСтроках < ИсходнаяСтрока.Количество Тогда
		// Нужно добавить новую строку в конец текущей связки строк
		НоваяСтрока = Объект.ЗаказыНаРастарку.Вставить(МаксимальныйНомерСтроки);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока,, "НомерСтроки,ЭтоИсходнаяСтрока");
		НоваяСтрока.Количество = ИсходнаяСтрока.Количество - КоличествоВНеИсходныхСтроках;
		Если НоваяСтрока.Количество <= 0.1 Тогда
			ОписаниеОповещенияПослеВопроса = Новый ОписаниеОповещения("ОтветилиНаВопросОбОстаткеЭтикеток", ЭтотОбъект, Новый Структура("ИдСтроки", НоваяСтрока.ПолучитьИдентификатор()));
			ПоказатьВопрос(ОписаниеОповещенияПослеВопроса, "Осталось " + НоваяСтрока.Количество * 1000 + " шт. этикеток. Необходимо их упаковать?", РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
		Иначе
			Сообщить("Вы ввели меньшее количество, чем передали на растарку. Добавлена новая строка на оставшееся количество (" + НоваяСтрока.Количество + " тыс.шт.)");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветилиНаВопросОбОстаткеЭтикеток(Ответ, ДопПараметры) Экспорт
	
	Строка = Объект.ЗаказыНаРастарку.НайтиПоИдентификатору(ДопПараметры.ИдСтроки);
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Строка.Примечание = "Не выбрасывать, упаковать в отдельную коробку";
	Иначе
		Строка.Примечание = "Можно утилизировать";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказыНаРастаркуПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ЗаказыНаРастарку.ТекущиеДанные;
	Элементы.ЗаказыНаРастаркуКонтекстноеМенюГруппаДляНеИсходныхСтрок.Видимость = ТекущаяСтрока <> Неопределено И НЕ ТекущаяСтрока.ЭтоИсходнаяСтрока;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказыНаРастаркуПередУдалением(Элемент, Отказ)
	
	Если НЕ ПолныеПрава Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.ЗаказыНаРастарку.ТекущиеДанные;
	НеИсходныеСтроки = Объект.ЗаказыНаРастарку.НайтиСтроки(Новый Структура("ИдентификаторСвязи,ЭтоИсходнаяСтрока", ТекущаяСтрока.ИдентификаторСвязи, Ложь));
	Если НеИсходныеСтроки.Количество() = 1 Тогда
		Отказ = Истина;
		Сообщить("Вы пытаетесь удалить единственную строку, которая должна получиться после растарки. Удаление единственной строки невозможно");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказыНаРастаркуХарактеристикаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	а=0;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказыНаРастаркуХарактеристикаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	а=0;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказыНаРастаркуВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекущаяСтрока = Элементы.ЗаказыНаРастарку.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено ИЛИ ТекущаяСтрока.ЭтоИсходнаяСтрока Тогда
		Возврат;
	КонецЕсли;
		
	Если НЕ ДоступКИзменениюТаблицыРастаркиВЗависимостиОтПричины(Объект.ПричинаРастарки) Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ЗаказыНаРастаркуХарактеристика" Тогда
		СтандартнаяОбработка = Ложь;
		// Найдем исходную строку
		ИсходныеСтроки = Объект.ЗаказыНаРастарку.НайтиСтроки(Новый Структура("ИдентификаторСвязи,ЭтоИсходнаяСтрока", ТекущаяСтрока.ИдентификаторСвязи, Истина));
		Если ИсходныеСтроки.Количество() <> 1 Тогда
			Сообщить("Ошибка: найдено " + ИсходныеСтроки.Количество() + " исходных строк");
			Возврат;
		КонецЕсли;
		//фиксНастройки = Новый НастройкиКомпоновкиДанных;
		////эОтбор = фиксНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		////эОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Партнер");
		////эОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		////Характеристика = ИсходныеСтроки[0].Характеристика;
		////Партнер = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Характеристика.Лико_ЗаказНоменклатуры.Партнер", Характеристика, "Характеристика");
		////эОтбор.ПравоеЗначение = Партнер;
		////эОтбор.Использование = Истина;
		//
		//ПараметрыОтбора = Новый Структура;    
		//ПараметрыОтбора.Вставить("ФиксированныеНастройки", фиксНастройки);
		//ПараметрыОтбора.Вставить("РежимВыбора", Истина);
		//
		//ОткрытьФорму("Документ.ЗаказКлиента.ФормаВыбора", ПараметрыОтбора,,,,, Новый ОписаниеОповещения("РастаркаВыбранЗаказКлиента", ЭтотОбъект, Новый Структура("ИдСтроки", Элементы.ЗаказыНаРастарку.ТекущаяСтрока)));
		
		ПоказатьВводСтроки(Новый ОписаниеОповещения("РастаркаВыбранЗаказКлиента", ЭтотОбъект, Новый Структура("ИдСтроки", Элементы.ЗаказыНаРастарку.ТекущаяСтрока)),, "Введите номер заказа", 7, Ложь);
		
	ИначеЕсли Поле.Имя = "ЗаказыНаРастаркуХарактеристикаВладелец" Тогда
		СтандартнаяОбработка = Ложь;
		//// Найдем исходную строку
		//ИсходныеСтроки = Объект.ЗаказыНаРастарку.НайтиСтроки(Новый Структура("ИдентификаторСвязи,ЭтоИсходнаяСтрока", Элементы.ЗаказыНаРастарку.ТекущиеДанные.ИдентификаторСвязи, Истина));
		//Если ИсходныеСтроки.Количество() <> 1 Тогда
		//	Сообщить("Ошибка: найдено " + ИсходныеСтроки.Количество() + " исходных строк");
		//	Возврат;
		//КонецЕсли;
		//Характеристика = ИсходныеСтроки[0].Характеристика;
		Заказ = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Характеристика.Лико_ЗаказНоменклатуры", Элементы.ЗаказыНаРастарку.ТекущиеДанные.Характеристика, "Характеристика");
		// Нужно выбрать номенклатуру
		ДопПараметры = Новый Структура("Заказ,ИдСтроки", Заказ, Элементы.ЗаказыНаРастарку.ТекущаяСтрока);
		ОткрытьФорму("Документ.Лико_ПеремещениеПаллета.Форма.ФормаВыбраНоменклатуры", ДопПараметры, ЭтаФорма, Новый УникальныйИдентификатор,,, Новый ОписаниеОповещения("РастаркаВыбранаНоменклатура", ЭтотОбъект, ДопПараметры), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДоступКИзменениюТаблицыРастаркиВЗависимостиОтПричины(Причина)
	
	Возврат Причина = Перечисления.Лико_ПричиныРастарки.ПеремоткаПоЗаявкеМенеджера ИЛИ Причина = Перечисления.Лико_ПричиныРастарки.ПереупаковкаБезПеремоткиПоЗаявкеМенеджера;
	
КонецФункции

&НаКлиенте
Процедура РастаркаВыбранЗаказКлиента(НомерЗаказа, ДопПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(НомерЗаказа) Тогда
		//Сообщить("Заказ не выбран");
		Возврат;
	КонецЕсли;

	Модифицированность = Истина;
	
	Заказ = Лико_Дополнительно.НайтиДокументПоНомеру7Символов(НомерЗаказа, "ЗаказКлиента");
	Если НЕ ЗначениеЗаполнено(Заказ) Тогда
		Сообщить("Не найден заказ с номером " + НомерЗаказа);
		Возврат;
	КонецЕсли;
	
	// Нужно выбрать номенклатуру
	ДопПараметры.Вставить("Заказ", Заказ);
	ОткрытьФорму("Документ.Лико_ПеремещениеПаллета.Форма.ФормаВыбраНоменклатуры", ДопПараметры, ЭтаФорма, Новый УникальныйИдентификатор,,, Новый ОписаниеОповещения("РастаркаВыбранаНоменклатура", ЭтотОбъект, ДопПараметры), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РастаркаВыбранаНоменклатура(ВыбранноеЗначение, ДопПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ВыбранноеЗначение.Характеристика) Тогда
		//Сообщить("Номенклатура не выбрана");
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ТекущаяСтрока = Объект.ЗаказыНаРастарку.НайтиПоИдентификатору(ДопПараметры.ИдСтроки);
	Если ТекущаяСтрока = Неопределено Тогда
		Сообщить("Ошибка: не удалось найти строку, для которой производился выбор заказа и номенклатуры");
		Возврат;
	КОнецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ВыбранноеЗначение,, "Количество");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказыНаРастаркуНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	Выполнение = Ложь;
КонецПроцедуры

&НаСервере
Процедура ПричинаРастаркиПриИзмененииНаСервере()
	
	Если Объект.ПричинаРастарки = Перечисления.Лико_ПричиныРастарки.КомплектацияПоЗаявкеМенеджераНаОтгрузку
		ИЛИ Объект.ПричинаРастарки = Перечисления.Лико_ПричиныРастарки.ПереупаковкаОшибкаМаркировки
		ИЛИ Объект.ПричинаРастарки = Перечисления.Лико_ПричиныРастарки.ПереупаковкаПоврежденаУпаковка
		ИЛИ Объект.ПричинаРастарки = Перечисления.Лико_ПричиныРастарки.ПовторныйВК Тогда
		Объект.ЗаказыНаРастарку.Очистить();
	КонецЕсли;
	
	ЗаполнитьТаблицуРастаркиНаСервере();
	
	УстановитьДоступностьЭлементов();
	
	Если Объект.ПричинаРастарки = Перечисления.Лико_ПричиныРастарки.ПереупаковкаБезПеремоткиПоЗаявкеМенеджера
		ИЛИ Объект.ПричинаРастарки = Перечисления.Лико_ПричиныРастарки.ПеремоткаПоЗаявкеМенеджера Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаРастарка;
		ЗаполнитьПримечанияНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПричинаРастаркиПриИзменении(Элемент)
	ПричинаРастаркиПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НЕ ЗначениеЗаполнено(Объект.АвторДокумента) Тогда
		Сообщить("Заполните автора документа");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Объект.Содержимое.Количество() > 0 И НЕ ЗначениеЗаполнено(Объект.Паллет) Тогда
		// Паллет не считан. Спросим, нужно ли создать новый паллет
		ОписаниеОповещения = Новый ОписаниеОповещения("ОтветНаВопросОНеобходимостиСоздаватьПаллет", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, "Вы не считали ШК паллета, но считали коробки. Создать паллет автоматически?", РежимДиалогаВопрос.ДаНетОтмена,, КодВозвратаДиалога.Отмена);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветНаВопросОНеобходимостиСоздаватьПаллет(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		СоздатьФормированиеПаллетаПереупаковка();		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьФормированиеПаллетаПереупаковка()
	
	Если НЕ ЗначениеЗаполнено(Объект.ЯчейкаПолучатель) Тогда
		Сообщить("Заполните ячейку-получатель");
		Возврат;
	КонецЕсли;
	
	НовыйДокумент = Документы.Лико_ФормированиеПаллета.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(НовыйДокумент, Объект, "АвторДокумента,РабочееМесто,Организация,Подразделение,Площадка");
	НовыйДокумент.ЯчейкаПолучатель = Объект.ЯчейкаПолучатель;
	НовыйДокумент.Комментарий = "Создан автоматически из перемещения паллета";
	НовыйДокумент.Паллет = Лико_Дополнительно.СоздатьНовыйПаллет(НовыйДокумент.АвторДокумента);
	НовыйДокумент.ТипДокумента = Перечисления.Лико_ТипыФормированияПаллет.Переупаковка;
	НовыйДокумент.Дата = ?(НачалоДня(Объект.Дата) <> НачалоДня(ТекущаяДата()), Объект.Дата-1, ТекущаяДата());
	НовыйДокумент.ДатаФормирования = НовыйДокумент.Дата;
	Для каждого Строка из Объект.Содержимое Цикл
		ЗаполнитьЗначенияСвойств(НовыйДокумент.Содержимое.Добавить(), Строка);
	КонецЦикла;
	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		Объект.Паллет = НовыйДокумент.Паллет;
		ПаллетПриИзмененииНаСервере();
		Сообщить("Создан документ """ + НовыйДокумент.Ссылка + """");
	Исключение
		Сообщить("Не удалось создать формирование паллета: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПримечания(Команда)
	ЗаполнитьПримечанияНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПримечанияНаСервере()
	
    УстановитьПривилегированныйРежим(Истина);
	
	ТаблицаРастарки = Объект.ЗаказыНаРастарку.Выгрузить(Новый Структура("ЭтоИсходнаяСтрока", Ложь));
	Если ТаблицаРастарки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТаблицаРастарки.НомерСтроки КАК ЧИСЛО(10, 0)) КАК НомерСтроки,
		|	ВЫРАЗИТЬ(ТаблицаРастарки.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика,
		|	ВЫРАЗИТЬ(ТаблицаРастарки.Намотка КАК Справочник.Лико_Намотка) КАК Намотка,
		|	ВЫРАЗИТЬ(ТаблицаРастарки.КодЭтикеткиЗаказчика КАК СТРОКА(40)) КАК КодЭтикеткиЗаказчика,
		|	ВЫРАЗИТЬ(ТаблицаРастарки.НомерПоставки КАК Справочник.Лико_НомераПоставок) КАК НомерПоставки,
		|	ВЫРАЗИТЬ(ТаблицаРастарки.Город КАК СТРОКА(100)) КАК Город,
		|	ВЫРАЗИТЬ(ТаблицаРастарки.ЧестныйЗнак КАК Справочник.Лико_ЧестныйЗнак) КАК ЧестныйЗнак
		|ПОМЕСТИТЬ ВТ_ТаблицаРастарки
		|ИЗ
		|	&ТаблицаРастарки КАК ТаблицаРастарки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТаблицаРастарки.НомерСтроки КАК НомерСтроки,
		|	ВТ_ТаблицаРастарки.Характеристика КАК Характеристика,
		|	ВТ_ТаблицаРастарки.Намотка КАК Намотка,
		|	ВТ_ТаблицаРастарки.КодЭтикеткиЗаказчика КАК КодЭтикеткиЗаказчика,
		|	ВТ_ТаблицаРастарки.НомерПоставки КАК НомерПоставки,
		|	ВТ_ТаблицаРастарки.Город КАК Город,
		|	ВТ_ТаблицаРастарки.ЧестныйЗнак КАК ЧестныйЗнак,
		|	МАКСИМУМ(Лико_ЗаявкаНаОтгрузкуТовары.Ссылка.Дата) КАК ДатаПоследнейЗаявкиНаОтгрузку
		|ПОМЕСТИТЬ ВТ_СДатойПоследнейЗаявки
		|ИЗ
		|	ВТ_ТаблицаРастарки КАК ВТ_ТаблицаРастарки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_ЗаявкаНаОтгрузку.Товары КАК Лико_ЗаявкаНаОтгрузкуТовары
		|		ПО ВТ_ТаблицаРастарки.Характеристика = Лико_ЗаявкаНаОтгрузкуТовары.Характеристика
		|			И (ВЫБОР
		|				КОГДА &БезКлючевыхПараметров
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_ТаблицаРастарки.Намотка = Лико_ЗаявкаНаОтгрузкуТовары.Намотка
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА &БезКлючевыхПараметров
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_ТаблицаРастарки.КодЭтикеткиЗаказчика = Лико_ЗаявкаНаОтгрузкуТовары.КодЭтикеткиЗаказчика
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА &БезКлючевыхПараметров
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_ТаблицаРастарки.НомерПоставки = Лико_ЗаявкаНаОтгрузкуТовары.НомерПоставки
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА &БезКлючевыхПараметров
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_ТаблицаРастарки.Город = Лико_ЗаявкаНаОтгрузкуТовары.Город
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА &БезКлючевыхПараметров
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_ТаблицаРастарки.ЧестныйЗнак = Лико_ЗаявкаНаОтгрузкуТовары.ЧестныйЗнак
		|			КОНЕЦ)
		|			И (Лико_ЗаявкаНаОтгрузкуТовары.Ссылка.Дата <= &ДатаРастарки)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ТаблицаРастарки.НомерСтроки,
		|	ВТ_ТаблицаРастарки.Характеристика,
		|	ВТ_ТаблицаРастарки.Намотка,
		|	ВТ_ТаблицаРастарки.КодЭтикеткиЗаказчика,
		|	ВТ_ТаблицаРастарки.НомерПоставки,
		|	ВТ_ТаблицаРастарки.Город,
		|	ВТ_ТаблицаРастарки.ЧестныйЗнак
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СДатойПоследнейЗаявки.НомерСтроки КАК НомерСтроки,
		|	ВТ_СДатойПоследнейЗаявки.Характеристика КАК Характеристика,
		|	ВТ_СДатойПоследнейЗаявки.Намотка КАК Намотка,
		|	ВТ_СДатойПоследнейЗаявки.КодЭтикеткиЗаказчика КАК КодЭтикеткиЗаказчика,
		|	ВТ_СДатойПоследнейЗаявки.НомерПоставки КАК НомерПоставки,
		|	ВТ_СДатойПоследнейЗаявки.Город КАК Город,
		|	ВТ_СДатойПоследнейЗаявки.ЧестныйЗнак КАК ЧестныйЗнак,
		|	ВТ_СДатойПоследнейЗаявки.ДатаПоследнейЗаявкиНаОтгрузку КАК ДатаПоследнейЗаявкиНаОтгрузку,
		|	МАКСИМУМ(ВЫРАЗИТЬ(Лико_ЗаявкаНаОтгрузкуТовары.Примечание КАК СТРОКА(1000))) КАК Примечание,
		|	МАКСИМУМ(Лико_ЗаявкаНаОтгрузкуТовары.Ссылка.Номер) КАК НомерЗаявкиНаОтгрузку
		|ИЗ
		|	ВТ_СДатойПоследнейЗаявки КАК ВТ_СДатойПоследнейЗаявки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_ЗаявкаНаОтгрузку.Товары КАК Лико_ЗаявкаНаОтгрузкуТовары
		|		ПО ВТ_СДатойПоследнейЗаявки.Характеристика = Лико_ЗаявкаНаОтгрузкуТовары.Характеристика
		|			И (ВЫБОР
		|				КОГДА &БезКлючевыхПараметров
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_СДатойПоследнейЗаявки.Намотка = Лико_ЗаявкаНаОтгрузкуТовары.Намотка
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА &БезКлючевыхПараметров
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_СДатойПоследнейЗаявки.КодЭтикеткиЗаказчика = Лико_ЗаявкаНаОтгрузкуТовары.КодЭтикеткиЗаказчика
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА &БезКлючевыхПараметров
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_СДатойПоследнейЗаявки.НомерПоставки = Лико_ЗаявкаНаОтгрузкуТовары.НомерПоставки
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА &БезКлючевыхПараметров
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_СДатойПоследнейЗаявки.Город = Лико_ЗаявкаНаОтгрузкуТовары.Город
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА &БезКлючевыхПараметров
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВТ_СДатойПоследнейЗаявки.ЧестныйЗнак = Лико_ЗаявкаНаОтгрузкуТовары.ЧестныйЗнак
		|			КОНЕЦ)
		|			И ((ВЫРАЗИТЬ(Лико_ЗаявкаНаОтгрузкуТовары.Примечание КАК СТРОКА(10))) <> """")
		|			И ВТ_СДатойПоследнейЗаявки.ДатаПоследнейЗаявкиНаОтгрузку = Лико_ЗаявкаНаОтгрузкуТовары.Ссылка.Дата
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СДатойПоследнейЗаявки.НомерСтроки,
		|	ВТ_СДатойПоследнейЗаявки.Характеристика,
		|	ВТ_СДатойПоследнейЗаявки.Намотка,
		|	ВТ_СДатойПоследнейЗаявки.КодЭтикеткиЗаказчика,
		|	ВТ_СДатойПоследнейЗаявки.НомерПоставки,
		|	ВТ_СДатойПоследнейЗаявки.Город,
		|	ВТ_СДатойПоследнейЗаявки.ЧестныйЗнак,
		|	ВТ_СДатойПоследнейЗаявки.ДатаПоследнейЗаявкиНаОтгрузку";

	Запрос.УстановитьПараметр("ТаблицаРастарки", ТаблицаРастарки);
	Запрос.УстановитьПараметр("ДатаРастарки", ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата()));
	Запрос.УстановитьПараметр("БезКлючевыхПараметров", Ложь);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		// Попробуем поискать без ключевых параметров
		Запрос.УстановитьПараметр("БезКлючевыхПараметров", Истина);
		РезультатЗапроса = Запрос.Выполнить();
	КонецЕсли;
	
	ОбработанныеНомераЦепочек = Новый Массив;
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаРастарки = Объект.ЗаказыНаРастарку[Выборка.НомерСтроки - 1]; 
			Если ОбработанныеНомераЦепочек.Найти(СтрокаРастарки.НомерЦепочки) = Неопределено Тогда
				СтрокаРастарки.Примечание = Выборка.Примечание;
				Сообщить("Заполнено примечание из заявки на отгрузку №" + Выборка.НомерЗаявкиНаОтгрузку + " для цепочки №" + СтрокаРастарки.НомерЦепочки + ?(Запрос.Параметры.БезКлючевыхПараметров, " (без ключевых параметров, необходима проверка)", ""));
				// Заполмним номер цепочки, чтобы заполнить примечание только в первой из неисходных строк
				ОбработанныеНомераЦепочек.Добавить(СтрокаРастарки.НомерЦепочки);
				Модифицированность = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
