Процедура СодержимоеПриИзменении(Элемент)
	РассчитатьКоличествоКоробок();
	ЗаполнитьТаблицуРастаркиНаСервере();
КонецПроцедуры

&НаСервере
Процедура РассчитатьКоличествоКоробок()
	
	КоличествоКоробок = Лико_Дополнительно.РассчитатьКоличествоКоробокВТЗ(Объект.Содержимое.Выгрузить(, "Серия"));
	Элементы.СтраницаТовары.Заголовок = "Товары (" + Объект.Содержимое.Количество() + ")";

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	РассчитатьКоличествоКоробок();
	ЗаполнитьТаблицуРастаркиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Объект.ПричинаРастарки = Перечисления.Лико_ПричиныРастарки.Прочее
		И НЕ ЗначениеЗаполнено(Объект.Комментарий) Тогда
		Отказ = Истина;
		Сообщить("Для причины растарки ""Прочее"" необходимо указать комментарий");
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Объект.ПричинаРастарки = Перечисления.Лико_ПричиныРастарки.ПереупаковкаОшибкаМаркировки
		И НЕ ЗначениеЗаполнено(Объект.Комментарий)
		И (Объект.Площадка = Справочники.Лико_Площадки.Ликофлекс
			ИЛИ Объект.Площадка = Справочники.Лико_Площадки.Линкс)
		И Объект.Дата >= Дата(2025,03,05,16,00,00) Тогда
		Отказ = Истина;
		Сообщить("Для причины растарки """ + Объект.ПричинаРастарки  + """ необходимо указать комментарий");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуРастарки(Команда)
	ЗаполнитьТаблицуРастаркиНаСервере();
КонецПроцедуры

