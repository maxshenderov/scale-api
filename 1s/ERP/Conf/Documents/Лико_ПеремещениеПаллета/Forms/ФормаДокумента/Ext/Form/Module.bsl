&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ПодключаемоеОборудование
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" Тогда
			ОбработатьШтрихкоды(ПодключаемоеОборудованиеУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр));
		КонецЕсли;
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШтрихкоды(ДанныеШтрихкода)
	
	//Найдем серию
	МассивСерий = Лико_Дополнительно.НайтиСерииПоШтрихкоду(ДанныеШтрихкода.Штрихкод);
	СерияНайдена = МассивСерий.Количество() > 0;
	Для каждого Серия из МассивСерий Цикл
		Если Объект.Содержимое.НайтиСтроки(Новый Структура("Серия", Серия)).Количество() = 0 Тогда
			НоваяСтрока = Объект.Содержимое.Добавить();
			НоваяСтрока.Серия = Серия;
		Иначе
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Серия """ + Серия + """ уже добавлена в паллет.";
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЦикла;
		                                         
	Если НЕ СерияНайдена Тогда
		Результат = Лико_ДополнительноКлиент.ОбработатьШтрихКодНеТовара(ДанныеШтрихкода.Штрихкод);
		Если Результат.Ошибка <> "" Тогда
			Сообщить(Результат.Ошибка);
		Иначе
			Если Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Паллета") Тогда
				//Это паллет
				Объект.Паллет = Результат.Паллет;
				Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаОсновное;
				ПаллетПриИзменении(Неопределено);
			ИначеЕсли Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Сотрудника") Тогда
				//Это физ. лицо
				Объект.АвторДокумента = Результат.Сотрудник;
				Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаОсновное;
			ИначеЕсли Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Адреса")
				ИЛИ Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Адреса_Короткий") Тогда
				//Это ячейка
				Объект.ЯчейкаПолучатель = Результат.АдресаХранения;
				ЯчейкаПолучательПриИзмененииНаСервере();
				Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаОсновное;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаТовары;
		РассчитатьКоличествоКоробок();
		ЗаполнитьТаблицуРастаркиНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПолныеПрава = РольДоступна("ПолныеПрава");
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	ТиповыеДокументы.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	УстановитьДоступностьЭлементов();
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) И НЕ ЗначениеЗаполнено(Объект.Паллет) Тогда
		Объект.РабочееМесто = ПараметрыСеанса.Лико_РабочееМесто;
		ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
		Объект.Площадка = Лико_Дополнительно.ПлощадкаПользователяПоУмолчанию(); 
		Объект.Организация = Объект.Площадка.Организация; 
		Объект.Подразделение = ТекущийПользователь.Подразделение;
		Параметры.Свойство("ФизЛицо", Объект.АвторДокумента);
	КонецЕсли;
	РассчитатьКоличествоКоробок();
	
	ДокументПроведенПриОткрытии = Объект.Проведен;
	
	Элементы.СодержимоеВыбылСоСклада.Видимость = РольДоступна("ПолныеПрава");
	
	Если Объект.ЗаказыНаРастарку.Количество() > 0 Тогда
		// Вызовем процедуру заполнения растарки, чтобы таблица правильно раскрасилась и расставились номера цепочек
		ЗаполнитьТаблицуРастаркиНаСервере();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) И ЗначениеЗаполнено(Объект.ПричинаРастарки) И ВРег(Лев(Строка(Объект.ПричинаРастарки), 17)) = ВРег("(не использовать)") Тогда
		Элементы.ПричинаРастарки.СписокВыбора.Добавить(Объект.ПричинаРастарки);
	КонецЕсли;
	
	РастаркаПоВерсии3 = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата()) >= Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияНовойСхемыРастаркиВерсия3.ЗначениеПараметра;
	
КонецПроцедуры

&НаКлиенте
Процедура ТиповыеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ТиповойДокумент) Тогда
		ПоказатьЗначение(,Элемент.ТекущиеДанные.ТиповойДокумент);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ТиповыеДокументы.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	Элементы.ТиповыеДокументы.Обновить();
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И НЕ ДокументПроведенПриОткрытии
		И Объект.ЯчейкаПолучатель = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Объект.СкладПолучатель, "ЯчейкаРастарка")
		//И Объект.ПричинаРастарки <> ПредопределенноеЗначение("Перечисление.Лико_ПричиныРастарки.ПереупаковкаОшибкаМаркировки")
		Тогда
		
		ДокументПроведенПриОткрытии = Истина;
		// Нужно вывести на печать накладную на передел
		Если РастаркаПоВерсии3 Тогда
			Обработка = Лико_Дополнительно.НайтиДополнительнуюОбработкуПоИмениОбъекта("ПечатнаяФормаНакладнаяНаПеределЕРП_Версия3");
		Иначе	
			Обработка = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Справочники.Лико_ПредопределенныеЗначения.ВнешняяПечатнаяФормаНакладнаяНаПередел.ЗначениеПараметра");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Обработка) Тогда
			Сообщить("В системе не зарегистрирована печатная форма ""Накладная на передел""");
			Возврат;
		КонецЕсли;
		ИмяОбъекта = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Обработка.ИмяОбъекта", Обработка, "Обработка"); 
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Объект.Ссылка);
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("ИсточникДанных", Обработка);
		ПараметрыОткрытия.Вставить("ПараметрыИсточника", Новый Структура("ИдентификаторКоманды,ОбъектыНазначения", ИмяОбъекта, МассивОбъектов));
		ПараметрыОткрытия.Вставить("ПараметрыПечати", Неопределено);
		ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыОткрытия, ЭтаФорма, Строка(Новый УникальныйИдентификатор));
		
		Если РастаркаПоВерсии3 Тогда
			Если НЕ (Объект.ПричинаРастарки = ПредопределенноеЗначение("Перечисление.Лико_ПричиныРастарки.ПереупаковкаОшибкаМаркировки") И Объект.Площадка = ПредопределенноеЗначение("Справочник.Лико_Площадки.Ликофлекс")) Тогда 
				// Дополнительно выведем старую форму тоже
				Обработка = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Справочники.Лико_ПредопределенныеЗначения.ВнешняяПечатнаяФормаНакладнаяНаПередел.ЗначениеПараметра");
				Если НЕ ЗначениеЗаполнено(Обработка) Тогда
					Сообщить("В системе не зарегистрирована печатная форма ""Накладная на передел""");
					Возврат;
				КонецЕсли;
				ИмяОбъекта = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Обработка.ИмяОбъекта", Обработка, "Обработка"); 
				МассивОбъектов = Новый Массив;
				МассивОбъектов.Добавить(Объект.Ссылка);
				ПараметрыОткрытия = Новый Структура;
				ПараметрыОткрытия.Вставить("ИсточникДанных", Обработка);
				ПараметрыОткрытия.Вставить("ПараметрыИсточника", Новый Структура("ИдентификаторКоманды,ОбъектыНазначения", ИмяОбъекта, МассивОбъектов));
				ПараметрыОткрытия.Вставить("ПараметрыПечати", Неопределено);
				ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыОткрытия, ЭтаФорма, Строка(Новый УникальныйИдентификатор));
			КонецЕсли;
			ОтправитьПисьмоОбОшибкеМаркировки();
		КонецЕсли;
	КонецЕсли;
	РассчитатьКоличествоКоробок();
	ЗаполнитьТаблицуРастаркиНаСервере();
	
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьПисьмоОбОшибкеМаркировки()
	
	Если Объект.ПричинаРастарки = Перечисления.Лико_ПричиныРастарки.ПереупаковкаОшибкаМаркировки Тогда
		АдресДляОтправкиПисем = Лико_Дополнительно.НайтиЭлектронныйАдресОтветственногоПоСкладу(Объект.СкладОтправитель, "лк Адрес для отправки писем о растарке с причиной Ошибка маркировки");
		Если ЗначениеЗаполнено(АдресДляОтправкиПисем) Тогда
			// Напишем письмо ответственному
			ИмяФайла = ПолучитьИмяВременногоФайла();
			ВнОбработка = Лико_Дополнительно.НайтиДополнительнуюОбработкуПоИмениОбъекта("ПечатнаяФормаНакладнаяНаПеределЕРП_Версия3");
			Если НЕ ЗначениеЗаполнено(ВнОбработка) Тогда
				Сообщить("В справочнике предопределенных значений не найдена ""ПечатнаяФормаНакладнаяНаПеределЕРП_Версия3""");
				Возврат;
			КонецЕсли;
			ДвоичныеДанные = ВнОбработка.ХранилищеОбработки.Получить();
			ДвоичныеДанные.Записать(ИмяФайла);
			ВнешняяОбработкаПлан = ВнешниеОбработки.Создать(ИмяФайла, Ложь);
			
			МассивОбъектов = Новый Массив;
			МассивОбъектов.Добавить(Объект.Ссылка);
			ТабДок = ВнешняяОбработкаПлан.СформироватьПечатнуюФорму(МассивОбъектов, Неопределено, Неопределено);
			Попытка
				УдалитьФайлы(ИмяФайла);
			Исключение
			КонецПопытки;
			
			Если ТабДок <> Неопределено Тогда
				Тема = "Ошибка маркировки " + Объект.Номер + " от " + Формат(Объект.Дата, "ДФ=dd.MM.yy");
				ИмяФайла = КаталогВременныхФайлов() + Тема + ".xlsx";
				ТабДок.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
				
				Текст = "";
				Лико_Планирование.ОтправитьПисьмо(Текст, Тема, АдресДляОтправкиПисем,,,,, ИмяФайла);
				
				Попытка
					УдалитьФайлы(ИмяФайла);
				Исключение
				КонецПопытки;
			Иначе
				ИмяФайла = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЯчейкаПолучательПриИзменении(Элемент)
	ЯчейкаПолучательПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЯчейкаПолучательПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.ЯчейкаПолучатель) Тогда
		Объект.СкладПолучатель = Объект.ЯчейкаПолучатель.Владелец;
	КонецЕсли;
	
	УстановитьДоступностьЭлементов();
	
	Если Элементы.СтраницаРастарка.Видимость Тогда
		ЗаполнитьТаблицуРастаркиНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементов()
	
	Элементы.СкладПолучатель.ТолькоПросмотр = ЗначениеЗаполнено(Объект.ЯчейкаПолучатель);
	// Видно только если ячейка-получатель = ячейка-растарка
	Элементы.ПричинаРастарки.Видимость = Объект.ЯчейкаПолучатель = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Объект.СкладПолучатель, "ЯчейкаРастарка");
	//Элементы.СтраницаРастарка.Видимость = Элементы.ПричинаРастарки.Видимость И РольДоступна("ПолныеПрава") И ДоступКИзменениюТаблицыРастаркиВЗависимостиОтПричины(Объект.ПричинаРастарки);
	Элементы.СтраницаРастарка.Видимость = Элементы.ПричинаРастарки.Видимость И ДоступКИзменениюТаблицыРастаркиВЗависимостиОтПричины(Объект.ПричинаРастарки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПаллетПриИзменении(Элемент)
	ПаллетПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПаллетПриИзмененииНаСервере()
	
	ОбъектДокумент = РеквизитФормыВЗначение("Объект");
	ОбъектДокумент.ПаллетПриИзменении();
	ЗначениеВРеквизитФормы(ОбъектДокумент, "Объект");
	РассчитатьКоличествоКоробок();
	Если Элементы.СтраницаРастарка.Видимость Тогда
		ЗаполнитьТаблицуРастаркиНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	МенеджерОборудованияКлиентПереопределяемый.НачатьПодключениеОборудованиеПриОткрытииФормы(ЭтаФорма, "СканерШтрихкода");
КонецПроцедуры

&НаСервереБезКонтекста
Функция НоменклатураПоШтрихкоду(ПараметрыОбработки, КэшированныеЗначения)
	
	Возврат ШтрихкодированиеНоменклатурыСервер.НоменклатураПоШтрихкоду(ПараметрыОбработки, КэшированныеЗначения); 
	
КонецФункции

&НаКлиенте
Процедура ПоискПоШтрихкодуВыполнить(Команда)
	
	ОчиститьСообщения();
	Оповещение = Новый ОписаниеОповещения("ПоискПоШтрихкодуЗавершение", ЭтотОбъект);
	ШтрихкодированиеНоменклатурыКлиент.ПоказатьВводШтрихкода(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискПоШтрихкодуЗавершение(ДанныхШтрихкода, ДополнительныеПараметры) Экспорт
	
	ОбработатьШтрихкоды(ДанныхШтрихкода);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСерииПоПаллету(Команда)
	ПаллетПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СкладПолучательПриИзменении(Элемент)
	Объект.ЯчейкаПолучатель = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура СкладОтправительПриИзменении(Элемент)
