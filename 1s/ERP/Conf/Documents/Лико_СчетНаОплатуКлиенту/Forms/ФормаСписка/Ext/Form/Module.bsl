&НаКлиенте
Процедура СоздатьЗаявкуНаОтгрузку(Команда)
	текстр = Элементы.Список.ТекущиеДанные;	
	Если текстр<>Неопределено Тогда 
		Партнер = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(текстр.Ссылка, "Партнер");	
		//Если есть шаблоны отгрузки, выбираем шаблон, если нет, показываем список заявок этого партнера для копирования
		Если ЕстьШаблоныОтгрузок(Партнер) Тогда 
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораШаблонаОтгрузки", ЭтотОбъект);
			Отбор = Новый Структура("Партнер",Партнер);
			ПараметрыФормы = Новый Структура("Отбор",Отбор);
			ОткрытьФорму("Справочник.Лико_ШаблоныЗаявокНаОтгрузку.ФормаВыбора",ПараметрыФормы,ЭтаФорма,Новый УникальныйИдентификатор,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
		Иначе   
			Контрагент = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(текстр.Ссылка, "Контрагент");
			ОрганизацияПродавец = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(текстр.Ссылка, "Организация");  
			Отбор = Новый Структура("Контрагент",Контрагент);
			Отбор.Вставить("ОрганизацияПродавец", ОрганизацияПродавец);
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораЗаявкиНаОтгрузку", ЭтотОбъект);
			ПараметрыФормы = Новый Структура("Отбор",Отбор);
			ОткрытьФорму("Документ.Лико_ЗаявкаНаОтгрузку.ФормаВыбора",ПараметрыФормы,ЭтаФорма,Новый УникальныйИдентификатор,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ЕстьШаблоныОтгрузок(Партнер)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ШаблоныЗаявокНаОтгрузку.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Лико_ШаблоныЗаявокНаОтгрузку КАК Лико_ШаблоныЗаявокНаОтгрузку
	|ГДЕ
	|	Лико_ШаблоныЗаявокНаОтгрузку.Партнер = &Партнер";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат  Ложь;
	Иначе 
		Возврат Истина;
	КонецЕсли;
КонецФункции



&НаКлиенте
Процедура ПослеВыбораШаблонаОтгрузки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		Если Элементы.Список.ВыделенныеСтроки.Количество() > 0 Тогда 
			Сп = Новый СписокЗначений;  
			сП.ЗагрузитьЗначения(Элементы.Список.ВыделенныеСтроки);	
			
			ФормаЗаявки = ПолучитьФорму("Документ.Лико_ЗаявкаНаОтгрузку.Форма.ФормаДокумента");
			ДанныеФормы = ФормаЗаявки.Объект; 
			ЗаполнитьЗаявкуНаОтгрузкуНаСервере(ДанныеФормы, Результат, СП);
			КопироватьДанныеФормы(ДанныеФормы, ФормаЗаявки.Объект); // копируем наш объект в объект формы и далее открываем ее
			ФормаЗаявки.Открыть();

    			
		КонецЕсли;
   КонецЕсли;	
КонецПроцедуры  

&НаСервере
Функция ЗаполнитьЗаявкуНаОтгрузкуНаСервере(ДанныеФормы, ШаблонЗаявкиНаОтгрузку,СписокЗаказов)   
		
	МетаданныеИсточник = Метаданные.Справочники.Лико_ШаблоныЗаявокНаОтгрузку;
	МетаданныеНазначение= Метаданные.Документы.Лико_ЗаявкаНаОтгрузку; 
	ДокЗаявка = Документы.Лико_ЗаявкаНаОтгрузку.СоздатьДокумент();
    ДокЗаявка.Дата = ТекущаяДата();  
	ДокЗаявка.СостояниеЗаявки = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Создан;
	ДокЗаявка.Ответственный = ШаблонЗаявкиНаОтгрузку.Менеджер;

    Для Каждого Реквизит Из МетаданныеИсточник.Реквизиты Цикл
		Имя = Реквизит.Имя;
		Если МетаданныеНазначение.Реквизиты.Найти(Имя) <> Неопределено Тогда
			ДокЗаявка[Имя] =  ШаблонЗаявкиНаОтгрузку[Имя];
