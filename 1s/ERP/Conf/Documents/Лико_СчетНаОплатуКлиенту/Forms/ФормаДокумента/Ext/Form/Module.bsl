&НаСервере
Процедура ДобавитьСтрокиИзПодбора(ДанныеФормыКоллекция)
	
	ТаблицаТоваров = ДанныеФормыКоллекция.Выгрузить(,"Номенклатура,Характеристика,ЗаказКлиента,Количество,Намотка,Город,КодЭтикеткиЗаказчика,ЧестныйЗнак,НомерПоставки");
	
	// Добавляем недостающие колонки из заказа клиента
	ОбработатьСтрокиПодбораНаСервере(ТаблицаТоваров);
	// Заполняем цену с учетом валюты
	ОбработатьЦеныВТаблицеТоваров(ТаблицаТоваров);
	// Добавляем товары в ТЧ
	ДобавитьТоварыИзТаблицы(ТаблицаТоваров);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьСтрокиПодбораНаСервере(ТаблицаТоваров)

	ТаблицаТоваров.Колонки.Добавить("Валюта");
	ТаблицаТоваров.Колонки.Добавить("Лико_ВалютаДляДокументов");
	ТаблицаТоваров.Колонки.Добавить("Цена");
	ТаблицаТоваров.Колонки.Добавить("ЦенаДляДокументов");
	ТаблицаТоваров.Колонки.Добавить("СтавкаНДС");
	МассивДляУдаления = Новый Массив;
	//НакладнаяНаЭкспорт = Объект.Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент;
	//Если НакладнаяНаЭкспорт Тогда
	//	СтавкаНДС = Перечисления.СтавкиНДС.НДС0;
	//ИначеЕсли Объект.Дата >= Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияСтавкиНДС20.ЗначениеПараметра Тогда
	//	СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
	//Иначе
	//	СтавкаНДС = Перечисления.СтавкиНДС.НДС18;
	//КонецЕсли;
	Для каждого Строка из ТаблицаТоваров Цикл
		
		// Найдем строку в заказе клиента
		Отбор = Новый Структура("Характеристика,Направление,Город,КодЭтикеткиЗаказчика,ЧестныйЗнак,NКонтракта");
		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		Отбор.NКонтракта = Строка.НомерПоставки;
		Отбор.Направление = Строка.Намотка;
		СтрокиЗаказа = Строка.ЗаказКлиента.Товары.НайтиСтроки(Отбор);
		Если СтрокиЗаказа.Количество() = 0 Тогда
			СтрокаЗаказа = Неопределено;
		Иначе
			СтрокаЗаказа = СтрокиЗаказа[0];
		КонецЕсли;
		
		Если СтрокаЗаказа = Неопределено Тогда
			// Поместим строку в массив для удаления
			МассивДляУдаления.Добавить(Строка);
		Иначе
			ЗаполнитьЗначенияСвойств(Строка, СтрокаЗаказа,, "Количество");
			Строка.Валюта = Строка.ЗаказКлиента.Валюта;
			Строка.Лико_ВалютаДляДокументов = Строка.ЗаказКлиента.ВалютаДляДокументов;
			//Строка.СтавкаНДС = СтавкаНДС;
		КонецЕсли;
			
	КонецЦикла;
	
	Для каждого Строка из МассивДляУдаления Цикл
		ТаблицаТоваров.Удалить(Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСкладПоУмолчаниюНаСервере()
	
	Возврат Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитПользователяСГП", ПараметрыСеанса.ТекущийПользователь);
	
