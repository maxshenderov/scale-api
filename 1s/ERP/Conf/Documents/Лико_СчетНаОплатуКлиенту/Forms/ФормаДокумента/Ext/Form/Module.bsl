		ПересчитатьСуммуДокумента();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоЗаказуНаСервере(ЗаказКлиента)
	
	// Добавим все позиции из заказа клиента. Если такая позиция уже есть, увеличим количество по ней
	ТаблицаТоваров = ЗаказКлиента.Товары.Выгрузить(, "Номенклатура,Характеристика,СтавкаНДС,Цена,ЦенаДляДокументов,Количество");
	ТаблицаТоваров.Колонки.Добавить("Валюта");
	ТаблицаТоваров.Колонки.Добавить("Лико_ВалютаДляДокументов");
	ТаблицаТоваров.Колонки.Добавить("ЗаказКлиента");
	ТаблицаТоваров.ЗаполнитьЗначения(ЗаказКлиента.Валюта, "Валюта");
	ТаблицаТоваров.ЗаполнитьЗначения(ЗаказКлиента.ВалютаДляДокументов, "Лико_ВалютаДляДокументов");
	ТаблицаТоваров.ЗаполнитьЗначения(ЗаказКлиента, "ЗаказКлиента");
	ОбработатьЦеныВТаблицеТоваров(ТаблицаТоваров);
	ДобавитьТоварыИзТаблицы(ТаблицаТоваров);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьЦеныВТаблицеТоваров(Товары)
	
	ВалютаУпр = Константы.ВалютаУправленческогоУчета.Получить();
	ВалютаРегл = Константы.ВалютаРегламентированногоУчета.Получить();
	СтруктураКурсов = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаУпр, ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата()));
	Если СтруктураКурсов.Курс = 0 Тогда
		СтруктураКурсов.Курс = 1;
	КонецЕсли;
	
	Для каждого Строка из Товары Цикл
		Если ЗначениеЗаполнено(Строка.ЦенаДляДокументов) Тогда
			Если Строка.Лико_ВалютаДляДокументов = Объект.Валюта Тогда
				Строка.Цена = Строка.ЦенаДляДокументов;
			Иначе
				Если Объект.Валюта = ВалютаРегл Тогда
					Строка.Цена = Строка.ЦенаДляДокументов * СтруктураКурсов.Курс;
				Иначе
					Строка.Цена = Строка.ЦенаДляДокументов / СтруктураКурсов.Курс;
				КонецЕсли;
			КонецЕсли;
		Иначе
			// --> Начало Лико Ефимов ЕВВ 22.01.2026
			// В таблице для переноса, которая пришла из формы подбора, цена всегда с НДС, поэтому уберем его из цены, если в счете ЦенаВключаетНДС = Ложь
			Если НЕ Объект.ЦенаВключаетНДС Тогда
				// Нужно убрать НДС
				Строка.Цена = Строка.Цена / (100 + ЦенообразованиеКлиентСервер.ПолучитьСтавкуНДСЧислом(Строка.СтавкаНДС)) * 100;
			КонецЕсли;
			// <-- Конец Лико Ефимов ЕВВ 22.01.2026
			Если Объект.Валюта = ВалютаРегл Тогда
				Строка.Цена = Строка.Цена * СтруктураКурсов.Курс;
			Иначе
				Строка.Цена = Строка.Цена;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьТоварыИзТаблицы(ТаблицаТоваров)
	
	КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	НакладнаяНаЭкспорт = Объект.Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент;
	Если НакладнаяНаЭкспорт Тогда
		СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС0);
	ИначеЕсли Объект.Дата >= Дата('20260101') Тогда
		СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС22);
	Иначе
		СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС20);
	КонецЕсли;
	Для каждого Строка из ТаблицаТоваров Цикл
		
		//Попробуем найти строку в этом документе
	    Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура", Строка.Номенклатура);
		Отбор.Вставить("Характеристика", Строка.Характеристика);
		Отбор.Вставить("Цена", Строка.Цена);
		
		СтрокиДокумента = Объект.Товары.НайтиСтроки(Отбор);
		Если СтрокиДокумента.Количество() = 0 Тогда
			ТекущаяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Строка);
			ТекущаяСтрока.СтавкаНДС = СтавкаНДС;
		Иначе
			ТекущаяСтрока = СтрокиДокумента[0];
			КоличествоДоИзменения = ТекущаяСтрока.Количество;
			ТекущаяСтрока.Количество = ТекущаяСтрока.Количество + Строка.Количество;
			Сообщить("Номенклатура " + Строка.Номенклатура + " / " + Строка.Характеристика
					+ " добавлена ранее: увеличено количество этикеток с " + Формат(КоличествоДоИзменения, "ЧГ=0") + " до " + Формат(ТекущаяСтрока.Количество, "ЧГ=0"));
		КонецЕсли;
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", Новый Структура("ЦенаВключаетНДС,СтавкаНДС", Объект.ЦенаВключаетНДС, ТекущаяСтрока.СтавкаНДС));
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
		СтруктураДействий.Вставить("ПересчитатьСумму", "Количество");
		ПакетнаяОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборЗаказов(Команда)
	
	// --> Начало Лико Яцун 05.05.2022
