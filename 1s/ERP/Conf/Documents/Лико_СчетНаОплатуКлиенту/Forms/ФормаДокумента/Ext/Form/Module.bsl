&НаКлиенте
Процедура Лико_СоздатьДоговор(Команда) // --> Начало Лико Ефимов ЕВВ 29.10.2018
	
	Если ЗначениеЗаполнено(Объект.Договор) Тогда
		Сообщить("Договор уже заполнен");
		Возврат;
	КонецЕсли;
	Если Объект.Товары.Количество() = 0 Тогда
		Сообщить("Сначала нужно заполнить товары");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Партнер) Тогда
		Сообщить("Заполните партнера");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Сообщить("Заполните контрагента");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Сообщить("Заполните организацию");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Валюта) Тогда
		Сообщить("Заполните валюту");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
		Сообщить("Заполните дату документа");
		Возврат;
	КонецЕсли;
	
	Лико_СоздатьДоговорНаСервере();
	Объект.НазначениеПлатежа = Неопределено;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 29.10.2018 

&НаСервере
Процедура Лико_СоздатьДоговорНаСервере() // --> Начало Лико Ефимов ЕВВ 29.10.2018
	
	Заказ = Объект.Товары[0].Характеристика.Лико_ЗаказНоменклатуры;
	Если НЕ ЗначениеЗаполнено(Заказ) Тогда
		Сообщить("В первой строке товаров обязательно должна быть заполнена характеристика с заказом");
		Возврат;
	КонецЕсли;
	Объект.Договор = Лико_Дополнительно.ПодобратьДоговор(Заказ, Объект, Истина);

	Лико_ПроверитьИзменитьБанковскийСчетОрганизации();
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 29.10.2018

&НаСервере
Процедура Лико_ПроверитьИзменитьБанковскийСчетОрганизации() // --> Начало Лико Ефимов ЕВВ 22.05.2025
	
	// По просьбе Крапивиной
	Если ЗначениеЗаполнено(Объект.Договор)
		И ЗначениеЗаполнено(Объект.Договор.БанковскийСчет)
		И Объект.БанковскийСчет <> Объект.Договор.БанковскийСчет 
		Тогда
		Объект.БанковскийСчет = Объект.Договор.БанковскийСчет;
		Сообщить("Банковский счет организации в документе был изменен, т.к. в договоре подобрался другой банковский счет организации");
	КонецЕсли; 
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 22.05.2025

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	Объект.НазначениеПлатежа = Неопределено;
	// --> Начало Лико Ефимов ЕВВ 22.05.2025
	Лико_ПроверитьИзменитьБанковскийСчетОрганизации();
	// <-- Конец Лико Ефимов ЕВВ 22.05.2025
КонецПроцедуры

&НаКлиенте
Процедура ТоварыХарактеристикаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ИдСтроки = Элементы.Товары.ТекущаяСтрока;
	Если ПроверитьНеобходимостьВводаХарактеристикиДляУслуги(ИдСтроки, СтандартнаяОбработка) Тогда
		ДопПараметры = Новый Структура("ИдСтроки", ИдСтроки);
		ОткрытьФорму("Документ.ЗаказКлиента.ФормаВыбора",,,,,,Новый ОписаниеОповещения("ВыбранЗаказДляХарактеристикиУслуги", ЭтотОбъект, ДопПараметры));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПроверитьНеобходимостьВводаХарактеристикиДляУслуги(ИдСтроки, СтандартнаяОбработка)
	
	ТекСтрока = Объект.Товары.НайтиПоИдентификатору(ИдСтроки);
	Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
		Сообщить("Сначала выберите номенклатуру");
		СтандартнаяОбработка = Ложь;
		Возврат Ложь;
	КонецЕсли;
	
	Если ТекСтрока.Номенклатура.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Услуга Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТекСтрока.Номенклатура.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать Тогда
		Сообщить("Для выбранной номенклатуры отключено использование характеристик");
		СтандартнаяОбработка = Ложь;
		Возврат Ложь;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ВыбранЗаказДляХарактеристикиУслуги(Результат, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		Модифицированность = Истина;
		ДопПараметры.Вставить("Заказ", Результат);
		ДобавитьХарактеристикуПоЗаказу(ДопПараметры);		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьХарактеристикуПоЗаказу(ДопПараметры)
	
	ТекСтрока = Объект.Товары.НайтиПоИдентификатору(ДопПараметры.ИдСтроки);
	ТекСтрока.Характеристика = Документы.Лико_ЗаявкаНаОтгрузку.НайтиИлиСоздатьХарактеристикуДляУслуги(ТекСтрока.Номенклатура, ДопПараметры.Заказ);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявкуНаОтгрузку(Команда)
	Если ЕстьШаблоныОтгрузок(Объект.Партнер) Тогда 
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораШаблонаОтгрузки", ЭтотОбъект);
		Отбор = Новый Структура("Партнер",Объект.Партнер);
		ПараметрыФормы = Новый Структура("Отбор",Отбор);
		ОткрытьФорму("Справочник.Лико_ШаблоныЗаявокНаОтгрузку.ФормаВыбора",ПараметрыФормы,ЭтаФорма,Новый УникальныйИдентификатор,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	Иначе   
		Отбор = Новый Структура("Контрагент", Объект.Контрагент);
		Отбор.Вставить("ОрганизацияПродавец", Объект.Организация);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораЗаявкиНаОтгрузку", ЭтотОбъект);
		ПараметрыФормы = Новый Структура("Отбор",Отбор);
		ОткрытьФорму("Документ.Лико_ЗаявкаНаОтгрузку.ФормаВыбора",ПараметрыФормы,ЭтаФорма,Новый УникальныйИдентификатор,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
		
	КонецЕсли;

КонецПроцедуры  

&НаСервере
Функция ЕстьШаблоныОтгрузок(Партнер)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ШаблоныЗаявокНаОтгрузку.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Лико_ШаблоныЗаявокНаОтгрузку КАК Лико_ШаблоныЗаявокНаОтгрузку
	|ГДЕ
	|	Лико_ШаблоныЗаявокНаОтгрузку.Партнер = &Партнер";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат  Ложь;
	Иначе 
		Возврат Истина;
	КонецЕсли;
КонецФункции



&НаКлиенте
Процедура ПослеВыбораШаблонаОтгрузки(Результат, ДополнительныеПараметры) Экспорт	
	Если Результат <> Неопределено Тогда
		Сп = Новый СписокЗначений;  
		Сп.Добавить(Объект.ссылка);				
		ФормаЗаявки = ПолучитьФорму("Документ.Лико_ЗаявкаНаОтгрузку.Форма.ФормаДокумента");
		ДанныеФормы = ФормаЗаявки.Объект; 
		ЗаполнитьЗаявкуНаОтгрузкуНаСервере(ДанныеФормы, Результат, СП);
		КопироватьДанныеФормы(ДанныеФормы, ФормаЗаявки.Объект); // копируем наш объект в объект формы и далее открываем ее
		ФормаЗаявки.Открыть(); 			
   КонецЕсли;	
КонецПроцедуры   


 &НаКлиенте
Процедура ПослеВыбораЗаявкиНаОтгрузку(Результат, ДополнительныеПараметры) Экспорт
	
    Если Результат <> Неопределено Тогда
   		Сп = Новый СписокЗначений;  
