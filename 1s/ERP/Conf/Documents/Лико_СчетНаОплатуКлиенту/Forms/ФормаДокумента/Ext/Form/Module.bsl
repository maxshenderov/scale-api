	|	Лико_СчетНаОплатуКлиентуТовары.Цена КАК Цена,
	|	Лико_СчетНаОплатуКлиентуТовары.Содержание КАК Содержание
	|ИЗ
	|	Документ.Лико_СчетНаОплатуКлиенту.Товары КАК Лико_СчетНаОплатуКлиентуТовары
	|ГДЕ
	|	Лико_СчетНаОплатуКлиентуТовары.Ссылка В (&СписокЗаказов)
	|	И Лико_СчетНаОплатуКлиентуТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_СчетНаОплатуКлиентуТовары.Номенклатура,
	|	Лико_СчетНаОплатуКлиентуТовары.Характеристика,
	|	Лико_СчетНаОплатуКлиентуТовары.Цена,
	|	Лико_СчетНаОплатуКлиентуТовары.Содержание"; 
	Запрос.УстановитьПараметр("СписокЗаказов", СписокЗаказов);  
	ВыборкаЗапросов = Запрос.ВыполнитьПакет();
	ВыборкаТовары  = ВыборкаЗапросов.Получить(1).Выбрать();  
	ВыборкаУслуги = ВыборкаЗапросов.Получить(2).Выбрать(); 
	Пока ВыборкаТовары.Следующий() Цикл
		нстр = ДокЗаявка.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(нстр, выборкаТовары);
		нстр.Контрагент =   ШаблонЗаявкиНаОтгрузку.Контрагент;
		нстр.АдресДоставки = ШаблонЗаявкиНаОтгрузку.АдресДоставки; 
		нстр.АдресДоставкиЗначенияПолей = ШаблонЗаявкиНаОтгрузку.АдресДоставкиЗначенияПолей; 
		нстр.Грузополучатель = ШаблонЗаявкиНаОтгрузку.Грузополучатель;
		нстр.ОтгрузкаВРублях = ШаблонЗаявкиНаОтгрузку.ОтгрузкаВРублях;  
		нстр.Примечание = ШаблонЗаявкиНаОтгрузку.Примечание;  

	КонецЦикла;
	Пока ВыборкаУслуги.Следующий() Цикл
		нстр = ДокЗаявка.Услуги.Добавить();
		ЗаполнитьЗначенияСвойств(нстр, выборкаУслуги);
	КонецЦикла;

	
	
	
	ЗначениеВДанныеФормы(ДокЗаявка,ДанныеФормы);


КонецФункции


