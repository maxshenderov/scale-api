Функция ЗаполнитьЗаявкуНаОтгрузкуНаСервере(ДанныеФормы, ШаблонЗаявкиНаОтгрузку,СписокЗаказов)    
	
//	Лико_Планирование.ЗаполнитьЗаявкуНаОтгрузкуПоСчетуИШаблону(ДанныеФормы, ШаблонЗаявкиНаОтгрузку,СписокЗаказов);
		
	МетаданныеИсточник = Метаданные.Справочники.Лико_ШаблоныЗаявокНаОтгрузку;
	МетаданныеНазначение= Метаданные.Документы.Лико_ЗаявкаНаОтгрузку; 
	ДокЗаявка = Документы.Лико_ЗаявкаНаОтгрузку.СоздатьДокумент();
    ДокЗаявка.Дата = ТекущаяДата();  
	ДокЗаявка.СостояниеЗаявки = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Создан;
	ДокЗаявка.Ответственный = ШаблонЗаявкиНаОтгрузку.Менеджер;

    Для Каждого Реквизит Из МетаданныеИсточник.Реквизиты Цикл
		Имя = Реквизит.Имя;
		Если МетаданныеНазначение.Реквизиты.Найти(Имя) <> Неопределено Тогда
			ДокЗаявка[Имя] =  ШаблонЗаявкиНаОтгрузку[Имя];
		КонецЕсли;
	КонецЦикла;   
	ДокЗаявка.СозданаИзЗаказаСчета = Истина;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Лико_СчетНаОплатуКлиентуТовары.Номенклатура КАК Номенклатура,
	|	Лико_СчетНаОплатуКлиентуТовары.Характеристика КАК Характеристика,
	|	Лико_СчетНаОплатуКлиентуТовары.Количество КАК Количество,
	|	Лико_СчетНаОплатуКлиентуТовары.Цена КАК Цена,
	|	Лико_СчетНаОплатуКлиентуТовары.ЗаказКлиента КАК ЗаказКлиента,
	|	Лико_СчетНаОплатуКлиентуТовары.Ссылка.Валюта КАК Валюта,
	|	Лико_СчетНаОплатуКлиентуТовары.Ссылка КАК СчетНаОплату
