Процедура ЗаполнитьСчетНаПредоплатуВЗаказах(МассивЗаказовДляПроверки, МассивЗаказовТекущегоДокумента = Неопределено, СсылкаТекущегоДокумента) Экспорт // --> Начало Лико Ефимов ЕВВ 10.03.2022

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказКлиентаДок.Ссылка КАК Заказ,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЗаказКлиентаДок.Ссылка В (&МассивЗаказовТекущегоДокумента)
	|				ТОГДА &СсылкаТекущегоДокумента
	|			КОГДА Лико_СчетНаОплатуКлиентуТовары.Ссылка ЕСТЬ NULL
	|				ТОГДА ЗНАЧЕНИЕ(Документ.Лико_СчетНаОплатуКлиенту.ПустаяСсылка)
	|			ИНАЧЕ Лико_СчетНаОплатуКлиентуТовары.Ссылка
	|		КОНЕЦ) КАК СчетНаПредоплату,
	|	ЗаказКлиентаДок.СчетНаПредоплату КАК СчетНаПредоплатуЗаказ
	|ПОМЕСТИТЬ Вт
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиентаДок
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лико_СчетНаОплатуКлиенту.Товары КАК Лико_СчетНаОплатуКлиентуТовары
	|		ПО ЗаказКлиентаДок.Ссылка = Лико_СчетНаОплатуКлиентуТовары.Характеристика.Лико_ЗаказНоменклатуры
	|			И (Лико_СчетНаОплатуКлиентуТовары.Ссылка.Проведен)
	|			И (Лико_СчетНаОплатуКлиентуТовары.Ссылка <> &СсылкаТекущегоДокумента)
	|ГДЕ
	|	ЗаказКлиентаДок.Ссылка В(&МассивЗаказовДляПроверки)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаДок.Ссылка,
	|	ЗаказКлиентаДок.СчетНаПредоплату
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт.Заказ КАК Заказ,
	|	Вт.СчетНаПредоплату КАК СчетНаПредоплату,
	|	Вт.СчетНаПредоплатуЗаказ КАК СчетНаПредоплатуЗаказ
	|ИЗ
	|	Вт КАК Вт
	|ГДЕ
	|	Вт.СчетНаПредоплату <> Вт.СчетНаПредоплатуЗаказ";
	
	Запрос.УстановитьПараметр("МассивЗаказовДляПроверки", МассивЗаказовДляПроверки);
	Запрос.УстановитьПараметр("МассивЗаказовТекущегоДокумента", МассивЗаказовТекущегоДокумента);
	Запрос.УстановитьПараметр("СсылкаТекущегоДокумента", СсылкаТекущегоДокумента);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Заказ.ПолучитьОбъект();
		ДокОбъект.СчетНаПредоплату = Выборка.СчетНаПредоплату;
		ДокОбъект.ОбменДанными.Загрузка = Истина;
		ДокОбъект.Записать();		
	КонецЦикла; 
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 10.03.2022
