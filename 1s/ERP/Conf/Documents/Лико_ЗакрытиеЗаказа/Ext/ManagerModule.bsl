КонецПроцедуры



Функция ТекстЗапросаТаблицаТоварыВЯчейках(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ТоварыВЯчейках";
	
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	ТекстЗапроса = 
	//Выполнено - Приходуем всю таблицу размещения
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.Характеристика КАК Характеристика,
	|	ТоварыВЯчейкахОстатки.Назначение КАК Назначение,
	|	ТоварыВЯчейкахОстатки.Упаковка КАК Упаковка,
	|	ТоварыВЯчейкахОстатки.Ячейка КАК Ячейка,
	|	ТоварыВЯчейкахОстатки.Серия КАК Серия,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК ВНаличии,
	|	ТоварыВЯчейкахОстатки.КОтборуОстаток КАК КОтбору,
	|	ТоварыВЯчейкахОстатки.КРазмещениюОстаток КАК КРазмещению
	|ИЗ
	|	Документ.Лико_ЗакрытиеЗаказа.Заказы КАК Лико_ЗакрытиеЗаказаЗаказы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(, Серия.ЯССМ_ОбъектНоменклатуры.Рулонный) КАК ТоварыВЯчейкахОстатки
	|		ПО Лико_ЗакрытиеЗаказаЗаказы.Заказ = ТоварыВЯчейкахОстатки.Характеристика.Лико_ЗаказНоменклатуры
	|ГДЕ
	|	(ТоварыВЯчейкахОстатки.Ячейка В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					РабочиеЦентры.ЛикоЯчейка КАК ЛикоЯчейка
	|				ИЗ
	|					Справочник.РабочиеЦентры КАК РабочиеЦентры
	|				ГДЕ
	|					РабочиеЦентры.ВидРабочегоЦентра В (&ВидРабочегоЦентра))
	|			ИЛИ ТоварыВЯчейкахОстатки.Ячейка В (&МассивНПЦУ))
	|	И ТоварыВЯчейкахОстатки.Характеристика.Лико_ЗаказНоменклатуры.Состояние = &Состояние
	|	И Лико_ЗакрытиеЗаказаЗаказы.Ссылка = &Ссылка
	|	И ТоварыВЯчейкахОстатки.Характеристика.Лико_ЗаказНоменклатуры.ТипЗаказа <> &ТипЗаказа
	|	И ТоварыВЯчейкахОстатки.Характеристика.Лико_ЗаказНоменклатуры.ТипЗаказа <> &ТипЗаказаУпаковка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	ТоварыВЯчейкахОстатки.Номенклатура,
	|	ТоварыВЯчейкахОстатки.Характеристика,
	|	ТоварыВЯчейкахОстатки.Назначение,
	|	ТоварыВЯчейкахОстатки.Упаковка,
	|	ТоварыВЯчейкахОстатки.Ячейка,
	|	ТоварыВЯчейкахОстатки.Серия,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток,
	|	ТоварыВЯчейкахОстатки.КОтборуОстаток,
	|	ТоварыВЯчейкахОстатки.КРазмещениюОстаток
	|ИЗ
	|	Документ.Лико_ЗакрытиеЗаказа.Заказы КАК Лико_ЗакрытиеЗаказаЗаказы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(, Серия.ЯССМ_ОбъектНоменклатуры.Рулонный) КАК ТоварыВЯчейкахОстатки
	|		ПО Лико_ЗакрытиеЗаказаЗаказы.Заказ = ТоварыВЯчейкахОстатки.Характеристика.Лико_ЗаказНоменклатуры
	|ГДЕ
	|	ТоварыВЯчейкахОстатки.Характеристика.Лико_ЗаказНоменклатуры.Состояние = &Состояние
	|	И Лико_ЗакрытиеЗаказаЗаказы.Ссылка = &Ссылка
	|	И ТоварыВЯчейкахОстатки.Характеристика.Лико_ЗаказНоменклатуры.ТипЗаказа = &ТипЗаказаУпаковка
	|	И ТоварыВЯчейкахОстатки.Ячейка.Лико_ТипСклада = ЗНАЧЕНИЕ(Перечисление.Лико_ТипСклада.Производство)";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

