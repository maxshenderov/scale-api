Процедура ЗаполнитьПараметрыИнициализации021025(Запрос, ДокументСсылка)
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗакрытиеЗаказа.Дата КАК Период,
	|	Лико_ЗакрытиеЗаказа.Номер КАК Номер,
	|	Лико_ЗакрытиеЗаказа.Организация КАК Организация
	|ИЗ
	|	Документ.Лико_ЗакрытиеЗаказа КАК Лико_ЗакрытиеЗаказа
	|ГДЕ
	|	Лико_ЗакрытиеЗаказа.Ссылка = &Ссылка";
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	
	
	Запрос.УстановитьПараметр("Период",      				Реквизиты.Период);	
	Запрос.УстановитьПараметр("Организация",    			Реквизиты.Организация);
	Массив = Новый Массив();
	Массив.Добавить(Справочники.ВидыРабочихЦентров.Omega);
	Массив.Добавить(Справочники.ВидыРабочихЦентров.Cartes);
	Запрос.УстановитьПараметр("ВидРабочегоЦентра",    		Массив);
    Запрос.УстановитьПараметр("Состояние",    				Перечисления.Лико_СостоянияЗаказов.Закрыт);
    Запрос.УстановитьПараметр("ТипЗаказа",    				Перечисления.Лико_ТипыЗаказов.Полуфабрикат);
	Запрос.УстановитьПараметр("ТипЗаказаУпаковка",    		Перечисления.Лико_ТипыЗаказов.Упаковка);
	
	 
	 Массив = Новый Массив();
	 Массив.Добавить(Справочники.СкладскиеЯчейки.НайтиПоКоду("Пол ЦУ 01"));
	 Массив.Добавить(Справочники.СкладскиеЯчейки.НайтиПоКоду("Пол ЦУ 02"));
	 Массив.Добавить(Справочники.СкладскиеЯчейки.НайтиПоКоду("Пол ЦУ Перемотка"));
	 Массив.Добавить(Справочники.СкладскиеЯчейки.НайтиПоКоду("Пол ЦУ Ротофлекс"));     
	Запрос.УстановитьПараметр("МассивНПЦУ",    		Массив);

	
КонецПроцедуры


