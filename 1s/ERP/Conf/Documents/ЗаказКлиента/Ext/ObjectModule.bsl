Процедура ЗапретИспользованияДавальческогоСырья(Отказ) 
	
	Если ДавальческоеСырье = Истина Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Запрет на использование давальческого сырья в заказе!";
		Сообщение.Поле = "ДавальческоеСырье"; //имя реквизита 
		Сообщение.КлючДанных = Ссылка;
		Сообщение.ПутьКДанным = "Объект";
		Сообщение.Сообщить();
		Отказ = Истина;  
		
	КонецЕсли;   
	
	Для каждого Цвет Из Цвета Цикл 
		Счетчик = 0;
		Если Цвет.ДавальческоеСырье = Истина Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Запрет на использование давальческого сырья в заказе!";
			Сообщение.Поле = СтрШаблон("Цвета[%1].НомерСтроки",Счетчик); //имя реквизита 
			Сообщение.КлючДанных = Ссылка;
			Сообщение.ПутьКДанным = "Объект";
			
			
			Сообщение.Сообщить();
			Отказ = Истина;  
			Счетчик = Счетчик+1; 
		КонецЕсли;   
		
		
	КонецЦикла;
	
