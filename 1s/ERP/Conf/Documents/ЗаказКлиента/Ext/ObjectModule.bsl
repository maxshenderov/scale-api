	|	СУММА(ВТВыпуск.Количество) КАК КоличествоВыпускКВМ,
	|	СУММА(ВТКликов.КоличествоКликов) КАК КоличествоКликов,
	|	ВТРасходСгруппирован.НомерПроката КАК НомерПроката,
	|	СУММА(ВТВыпуск.КоличествоВыпуск) КАК ЭтикетокНапечатано,
	|	МАКСИМУМ(ВТВыпуск.Валидация) КАК Валидация,
	|	МАКСИМУМ(ВТКартыСнятияПерерасхода.КартаСнятия) КАК КартаСнятия,
	|	МАКСИМУМ(ЕСТЬNULL(ВТКартыСнятияПерерасхода.КартаСнятия.Дата, ДАТАВРЕМЯ(1, 1, 1))) КАК ДатаКартыСнятия,
	|	МАКСИМУМ(ВТКартыСнятияПерерасхода.КартаСнятия.ВидСнятия) КАК ВидСнятия,
	|	МАКСИМУМ(ВТКартыСнятияПерерасхода.КартаПерерасхода) КАК КартаПерерасхода,
	|	МАКСИМУМ(ВТКартыСнятияПерерасхода.КартаПерерасходаПриПечати) КАК КартаПерерасходаПриПечати,
	|	МАКСИМУМ(ЕСТЬNULL(ВТ_ДатаПередачиНаЭтапПечать.Период, ДАТАВРЕМЯ(1, 1, 1))) КАК ДатаПередачиНаЭтапПечать,
	|	МИНИМУМ(ВТРасходСгруппирован.ДатаНачала) КАК ДатаНачала,
	|	МАКСИМУМ(ВТРасходСгруппирован.ДатаОкончания) КАК ДатаОкончания
	|ИЗ
	|	ВТРасходСгруппирован КАК ВТРасходСгруппирован
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВыпуск КАК ВТВыпуск
	|		ПО ВТРасходСгруппирован.Сотрудник = ВТВыпуск.Сотрудник
	|			И ВТРасходСгруппирован.РабочийЦентр = ВТВыпуск.РабочийЦентр
	|			И ВТРасходСгруппирован.НомерПроката = ВТВыпуск.НомерПроката
	|			И ВТРасходСгруппирован.НомерБланка = ВТВыпуск.НомерБланка
	|			И ВТРасходСгруппирован.НомерПриложения = ВТВыпуск.НомерПриложения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТУчтено КАК ВТУчтено
	|		ПО ВТРасходСгруппирован.Сотрудник = ВТУчтено.Сотрудник
	|			И ВТРасходСгруппирован.РабочийЦентр = ВТУчтено.РабочийЦентр
	|			И ВТРасходСгруппирован.НомерПроката = ВТУчтено.НомерПроката
	|			И ВТРасходСгруппирован.НомерБланка = ВТУчтено.НомерБланка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКликов КАК ВТКликов
	|		ПО ВТРасходСгруппирован.Сотрудник = ВТКликов.Сотрудник
	|			И ВТРасходСгруппирован.НомерПроката = ВТКликов.НомерПроката
	|			И ВТРасходСгруппирован.НомерБланка = ВТКликов.НомерБланка
	|			И ВТРасходСгруппирован.НомерПриложения = ВТКликов.НомерПриложения
	|			И ВТРасходСгруппирован.РабочийЦентр = ВТКликов.РабочийЦентр
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКартыСнятияПерерасхода КАК ВТКартыСнятияПерерасхода
	|		ПО ВТРасходСгруппирован.Сотрудник.ФизическоеЛицо = ВТКартыСнятияПерерасхода.Оператор
	|			И ВТРасходСгруппирован.НомерБланка = ВТКартыСнятияПерерасхода.НомерБланка
	|			И ВТРасходСгруппирован.НомерПроката = ВТКартыСнятияПерерасхода.НомерПроката
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДатаПередачиНаЭтапПечать КАК ВТ_ДатаПередачиНаЭтапПечать
	|		ПО ВТРасходСгруппирован.НомерБланка = ВТ_ДатаПередачиНаЭтапПечать.НомерБланка
	|			И (ВТРасходСгруппирован.НомерПроката = 1)
	|ГДЕ
	|	ВТУчтено.Сотрудник ЕСТЬ NULL
	|	И (ВТРасходСгруппирован.ВидРабот = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ПустаяСсылка)
	|			ИЛИ ВТРасходСгруппирован.ВидРабот = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Печать))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТРасходСгруппирован.ДатаРасхода,
	|	ВТРасходСгруппирован.Сотрудник,
	|	ВТРасходСгруппирован.РабочийЦентр,
	|	ВТРасходСгруппирован.НомерБланка,
	|	ВТРасходСгруппирован.НомерПриложения,
	|	ВТРасходСгруппирован.НомерПроката,
	|	ВТРасходСгруппирован.РабочийЦентр.ВидРабочегоЦентра,
	|	ВТРасходСгруппирован.Сотрудник.ФизическоеЛицо
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерПроката,
	|	НомерБланка,
	|	НомерПриложения,
	|	Дата,
	|	ВТРасходСгруппирован.Сотрудник.Наименование
	|ИТОГИ ПО
	|	НомерПроката";
	Запрос.УстановитьПараметр("Заказ", Ссылка);
	Запрос.УстановитьПараметр("МассивПрокатов", МассивПрокатов);
	ТЗ_Учтено = Производство.Выгрузить();
	ТЗ_Учтено.Очистить();
	Для каждого ТекСтрока из Производство Цикл
		Если МассивПрокатов.Найти(ТекСтрока.НомерПроката) <> Неопределено Тогда 
			НоваяСтрокаУчтено = ТЗ_Учтено.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаУчтено, ТекСтрока); 
			Если ЗначениеЗаполнено(НоваяСтрокаУчтено.СотрудникПоБланку) Тогда
				НоваяСтрокаУчтено.Сотрудник = НоваяСтрокаУчтено.СотрудникПоБланку;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Запрос.УстановитьПараметр("ТЗ_Учтено", ТЗ_Учтено);

	ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК = Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК.ЗначениеПараметра;
	
	ЭтоПробник = ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Пробник;
	ЭтоЛинкс = Площадка = Справочники.Лико_Площадки.Линкс;
	ДатаПереходаНоНовуюСхемуЗаполненияПроизводстваЛинкс = Справочники.Лико_ПредопределенныеЗначения.ДатаПереходаНоНовуюСхемуЗаполненияПроизводстваЛинкс.ЗначениеПараметра;
	Если НЕ ЗначениеЗаполнено(ДатаПереходаНоНовуюСхемуЗаполненияПроизводстваЛинкс) Тогда
		ДатаПереходаНоНовуюСхемуЗаполненияПроизводстваЛинкс = Дата('00010101');
	КонецЕсли;
	
	МассивРезультатовЗапроса = Запрос.ВыполнитьПакет();
	
	// --> Начало Лико Ефимов ЕВВ 08.12.2025
	// Сделаем соответствие настроек для переходного периода. Если соответствие пустое, то заполним по-старому, а если соответствие не пустое, то заполним из него
	//ВыборкаНастроек = МассивРезультатовЗапроса[МассивРезультатовЗапроса.Количество()-2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	//СоответствиеНастроек = Новый Соответствие;
	//Пока ВыборкаНастроек.Следующий() Цикл
	//	ВыборкаНастроекДетЗап = ВыборкаНастроек.Выбрать();
	//	СоответствиеНастроекТекПрокат = Новый Соответствие;
	//	Пока ВыборкаНастроекДетЗап.Следующий() Цикл
	//		СоответствиеНастроекТекПрокат.Вставить(ВыборкаНастроекДетЗап.НомерБланка, Истина);
	//	КонецЦикла;
	//	СоответствиеНастроек.Вставить(ВыборкаНастроек.НомерПроката, СоответствиеНастроекТекПрокат);
	//КонецЦикла; 
	ТаблицаНастроек = МассивРезультатовЗапроса[МассивРезультатовЗапроса.Количество()-2].Выгрузить();
	// <-- Конец Лико Ефимов ЕВВ 08.12.2025
	
	ВыборкаНомерПроката = МассивРезультатовЗапроса[МассивРезультатовЗапроса.Количество()-1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	Пока ВыборкаНомерПроката.Следующий() Цикл

		// Нужно заполнять засчитанные этикетки в том случае, если сейчас заполняют последний прокат.
		// Чтобы определить, последний ли это прокат, поищем НомерПроката+1 в цветах и работах. Если найдем, значит прокат не последний
		НужноЗаполнятьЗасчитанныеЭтикетки = Ложь;
		НайденныеСтрокиПоТекущемуПрокату = Цвета.НайтиСтроки(Новый Структура("НомерПроката", ВыборкаНомерПроката.НомерПроката));
		ТекРЦ = Неопределено;
		Для каждого ТекСтрокаЦвета из НайденныеСтрокиПоТекущемуПрокату Цикл
			Если ЗначениеЗаполнено(ТекСтрокаЦвета.РабочийЦентр) Тогда
				ТекРЦ = ТекСтрокаЦвета.РабочийЦентр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ТекРцСклейкаТермоусадки = ЗначениеЗаполнено(ТекРЦ) И ТекРЦ.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.СклейкаТермоусадки;
		ТекРЦОмега18 = ЗначениеЗаполнено(ТекРЦ) И ТекРЦ.ПорядковыйНомер = 18;
		
		Если ЗначениеЗаполнено(ТекРЦ) И ТекРЦ.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Comexi Тогда
			// Суп задача № 4324
			// Для комекси считаем по выпуску самой комекси 
			НужноЗаполнятьЗасчитанныеЭтикетки = Истина;
			СоответствиеБланковИЗасчЭт = СформироватьСоответствиеЗасчитанныхЭтикетокПоВыпускуТекущегоПроката(ВыборкаНомерПроката.НомерПроката);
		Иначе
			Если ЗначениеЗаполнено(ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК) И ТекущаяДата() >= ДатаНачалаЗаполненияЗасчитанныхЭтикетокПоДаннымВК Тогда
				СтруктураПоиска = Новый Структура("НомерПроката", ВыборкаНомерПроката.НомерПроката+1);
				Если Цвета.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда
					НужноЗаполнятьЗасчитанныеЭтикетки = Истина;
				КонецЕсли;
			КонецЕсли;
			Если НужноЗаполнятьЗасчитанныеЭтикетки Тогда
				СоответствиеБланковИЗасчЭт = Лико_Дополнительно.ПолучитьКоличествоЗасчитанныхЭтикетокПоЗаказу(Ссылка);
			Иначе
				// Суп задача № 3378
				// Это не последний прокат, поэтому засчитанные этикетки будем искать в зависимости от типа заказа
				Если ТипЗаказа = Перечисления.Лико_ТипыЗаказов.ВплавляемаяЭтикетка
					ИЛИ ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Упаковка Тогда
					// Тоже по ВК
					НужноЗаполнятьЗасчитанныеЭтикетки = Истина;
					СоответствиеБланковИЗасчЭт = Лико_Дополнительно.ПолучитьКоличествоЗасчитанныхЭтикетокПоЗаказу(Ссылка);
				ИначеЕсли ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Термоусадка
					ИЛИ ТипЗаказа = Перечисления.Лико_ТипыЗаказов.СамоклеящаясяЭтикетка Тогда
					НужноЗаполнятьЗасчитанныеЭтикетки = Истина;
					СоответствиеБланковИЗасчЭт = СформироватьСоответствиеЗасчитанныхЭтикетокПоПотреблениюСледующегоПроката(ВыборкаНомерПроката.НомерПроката);
					Если НЕ ЗначениеЗаполнено(СоответствиеБланковИЗасчЭт) И ТекРцСклейкаТермоусадки Тогда
						// После склейки не было потреблений, попробуем заполнить по поперечной резке
						ВСледующемПрокатеПоперечнаяРезка = Ложь;
						НайденныеСтроки = Цвета.НайтиСтроки(Новый Структура("НомерПроката", ВыборкаНомерПроката.НомерПроката+1));
						Для каждого Строка из НайденныеСтроки Цикл
							Если Строка.РабочийЦентр.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.ПоперечнаяРезка Тогда
								ВСледующемПрокатеПоперечнаяРезка = Истина;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						Если ВСледующемПрокатеПоперечнаяРезка Тогда
							СоответствиеБланковИЗасчЭт = СформироватьСоответствиеЗасчитанныхЭтикетокПоПередачеСПоперечнойРезкиНаВК();
						Иначе
							НужноЗаполнятьЗасчитанныеЭтикетки = Ложь;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//СоответствиеНастроекТекПрокат = СоответствиеНастроек.Получить(ВыборкаНомерПроката.НомерПроката);
		ТаблицаНастроекТекПрокат = ТаблицаНастроек.Скопировать(Новый Структура("НомерПроката", ВыборкаНомерПроката.НомерПроката));
		ТаблицаНастроекТекПрокатЗаполнена = ТаблицаНастроекТекПрокат.Количество() > 0;
		БылаНастройка = Ложь;  
		ЗаполнитьДополнительнуюНастройку = Ложь; 
		Если ТолькоНовые Тогда
			Для каждого Строка из Запрос.Параметры.ТЗ_Учтено Цикл
				Если Строка.НомерПроката = ВыборкаНомерПроката.НомерПроката
					И Строка.КоличествоНастроек <> 0 Тогда
					БылаНастройка = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Выборка = ВыборкаНомерПроката.Выбрать();

		Пока Выборка.Следующий() Цикл
			стрпп = Производство.Добавить();
			Если Выборка.НомерПроката = 1 Тогда 
				Если ЗначениеЗаполнено(Выборка.количествоКликов) Тогда 
					стрпп.ВсегоКликов = Выборка.КоличествоКликов;
				КонецЕсли;
				стрпп.Сотрудник2 = Выборка.Сотрудник2;
			КонецЕсли;       
			заполнитьЗначенияСвойств(стрпп, Выборка,, "Сотрудник2");
			// --> Начало Лико Ефимов ЕВВ 15.01.2026
			Если ЭтоПробник И ЗначениеЗаполнено(Выборка.ДатаНачала) И ЗначениеЗаполнено(Выборка.ДатаОкончания) Тогда
				стрпп.ВремяВыполнения = (Выборка.ДатаОкончания - Выборка.ДатаНачала) / 60 / 60;
			КонецЕсли;
			// <-- Конец Лико Ефимов ЕВВ 15.01.2026
			Если ЗначениеЗаполнено(Выборка.КартаСнятия) Тогда
				стрпп.КартаСнятияНомер = Выборка.КартаСнятия.Номер;
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.КартаПерерасхода) Тогда
				стрпп.КартаПерерасходаНомер = Выборка.КартаПерерасхода.Номер;
				стрпп.ПодтвержденныйПерерасход = Выборка.КартаПерерасхода.КоличествоПодтверждено;
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.КартаПерерасходаПриПечати) Тогда
				стрпп.КартаПерерасходаПриПечатиНомер = Выборка.КартаПерерасходаПриПечати.Номер;
				стрпп.ПодтвержденныйПерерасход = стрпп.ПодтвержденныйПерерасход + Выборка.КартаПерерасходаПриПечати.КоличествоПодтверждено;
			КонецЕсли;
			// --> Начало Лико Ефимов ЕВВ 08.12.2025
			Если ТаблицаНастроекТекПрокатЗаполнена Тогда 
				// Заполняем настройку из Документы.Лико_ДвиженияЗаказаПоЭтапам.ФактыНастройки
				ОператорЗаполнен = Истина;
				Для каждого ТекСтрокаТаблНастроекТекПрокат из ТаблицаНастроекТекПрокат Цикл
					Если НЕ ЗначениеЗаполнено(ТекСтрокаТаблНастроекТекПрокат.Оператор) Тогда
						ОператорЗаполнен = Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если ОператорЗаполнен Тогда
					МассивСтрокТаблНастроек = ТаблицаНастроекТекПрокат.НайтиСтроки(Новый Структура("НомерБланка,Оператор", Выборка.НомерБланка, Выборка.Оператор));
				Иначе
					МассивСтрокТаблНастроек = ТаблицаНастроекТекПрокат.НайтиСтроки(Новый Структура("НомерБланка", Выборка.НомерБланка));
				КонецЕсли;
				
				Если МассивСтрокТаблНастроек.Количество() <> 0 Тогда
					// По данному бланку зафиксирована настройка
					Стрпп.КоличествоНастроек = 1; 
					// Далее код Сергея Яцуна из старой ветки, который снимет настройку в том случае, если была карта снятия с определенными условиями
					Если ЗначениеЗаполнено(Выборка.ВидСнятия) И (Выборка.ВидСнятия = Перечисления.Лико_ВидыСнятия.ВинаПечатника ИЛИ Выборка.ВидСнятия = Перечисления.Лико_ВидыСнятия.НетВиныПечатника И НЕ ЗначениеЗаполнено(Выборка.КоличествоВыпускПМ)) Тогда
						Стрпп.КоличествоНастроек = 0;
					КонецЕсли; 
