						Иначе
							// Нужно найти свое приложение
							ЗначениеСоответствияТекПриложение = ЗначениеСоответствияТекБланк.Получить(Выборка.НомерПриложения);
							Если ЗначениеСоответствияТекПриложение <> Неопределено Тогда
								стрпп.ЭтикетокЗасчитано = ЗначениеСоответствияТекПриложение;
								ЗначениеСоответствияТекБланк.Удалить(Выборка.НомерПриложения);
							КонецЕсли;
						КонецЕсли;
						Если стрпп.КоличествоПМ <> 0 И стрпп.Количество <> 0 И стрпп.ЭтикетокЗасчитано <> 0 Тогда
							стрпп.ПогМетровЗасчитано = РассчитатьМетражНаСервере(стрпп.ЭтикетокЗасчитано * 1000, Выборка.ВидРабочегоЦентра);
							стрпп.КвМетровЗасчитано = стрпп.ПогМетровЗасчитано * стрпп.НарезкаРазмер / 1000; 
						КонецЕсли;
					Иначе
						стрпп.ЭтикетокЗасчитано = ЗначениеСоответствияТекБланк;
						Если стрпп.КоличествоПМ <> 0 И стрпп.Количество <> 0 И стрпп.ЭтикетокЗасчитано <> 0 Тогда
							стрпп.ПогМетровЗасчитано = РассчитатьМетражНаСервере(стрпп.ЭтикетокЗасчитано * 1000, Выборка.ВидРабочегоЦентра);
							стрпп.КвМетровЗасчитано = стрпп.ПогМетровЗасчитано * стрпп.НарезкаРазмер / 1000; 
						КонецЕсли;
					КонецЕсли;
					Если Выборка.НомерПриложения = 0 Тогда // Если номер приложения не равен 0, то строки уже удалились выше по номеру приложения
						// Удалим из соответствия, чтобы данные не попали в другие строки по этому же номеру бланка
						СоответствиеБланковИЗасчЭт.Удалить(Выборка.НомерБланка);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			// <-- Конец Лико Ефимов ЕВВ 07.07.2023
		КонецЦикла;
		
		// --> Начало Лико Ефимов ЕВВ 10.12.2025
		// Нужно обработать строки с расходом материала, но без выпуска
		Производство.Сортировать("НомерПроката,НомерБланка,НомерСтроки,Дата,Сотрудник"); // На всякий случай отсортируем, вдруг заполняют только новые. Номер строки в середине, чтобы старые записи были выше новых
		Для каждого Строка из Производство Цикл
			Если Строка.НомерПроката <> ВыборкаНомерПроката.НомерПроката Тогда
				// Нам нужен только текущий номер проката, пропустим эту строку
				Продолжить;
			КонецЕсли;
			Если НЕ ТекРцСклейкаТермоусадки
				И НЕ ТекРЦОмега18
				И НЕ ЗначениеЗаполнено(Строка.КартаСнятия) // Нет карты снятия
				И Строка.КоличествоПМ <> 0 // Есть расход
				И Строка.КоличествоНастроек = 0 // Нет настройки
				И Строка.ЭтикетокНапечатано = 0 // Нет выпуска
				Тогда
				// Не было карты снятия, был расход, не было настройки, но не было выпуска, поменяем сотрудника на сотрудника из следующего бланка
				
				// --> Начало Лико Ефимов ЕВВ 15.01.2026
				// Переделаю алгоритм, т.к. нужно искать не просто строку следующего бланка, а следующую строку с настройкой
				
				//Отбор = Новый Структура("НомерПроката,НомерБланка", Строка.НомерПроката, Строка.НомерБланка + 1);
				//СтрокиСледующегоБланка = Производство.НайтиСтроки(Отбор);
				//Если СтрокиСледующегоБланка.Количество() > 0 Тогда
				//	Если НЕ ЗначениеЗаполнено(Строка.СотрудникПоБланку) Тогда
				//		Строка.СотрудникПоБланку = Строка.Сотрудник; // Запоминаем сотрудника по бланку
				//	КонецЕсли;
				//	Строка.Сотрудник = СтрокиСледующегоБланка[0].Сотрудник; // Меняем сотрудника на сотрудника из следующего бланка
				//КонецЕсли; 
				
				СледующаяСтрокаСНастройкой = Неопределено;
				Для СчПоискаСлСтрокиСНастройкой = Производство.Индекс(Строка)+1 по Производство.Количество()-1 Цикл // Цикл со следующей строки до конца ТЧ
					ТекСтрокаПоиска = Производство[СчПоискаСлСтрокиСНастройкой];
					Если ТекСтрокаПоиска.НомерПроката <> ВыборкаНомерПроката.НомерПроката Тогда
						Продолжить;
					КонецЕсли;
					Если ТекСтрокаПоиска.КоличествоНастроек <> 0 Тогда
						СледующаяСтрокаСНастройкой = ТекСтрокаПоиска;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если СледующаяСтрокаСНастройкой <> Неопределено Тогда
					Если НЕ ЗначениеЗаполнено(Строка.СотрудникПоБланку) Тогда
						Строка.СотрудникПоБланку = Строка.Сотрудник; // Запоминаем сотрудника по бланку
					КонецЕсли;
					Строка.Сотрудник = СледующаяСтрокаСНастройкой.Сотрудник; // Меняем сотрудника на сотрудника из следующего бланка
					Строка.Сотрудник2 = СледующаяСтрокаСНастройкой.Сотрудник2; // Меняем сотрудника2 на сотрудника2 из следующего бланка
				КонецЕсли;
				// <-- Конец Лико Ефимов ЕВВ 15.01.2026
			КонецЕсли;	
		КонецЦикла;
       	// <-- Конец Лико Ефимов ЕВВ 10.12.2025
	КонецЦикла;
	
	// В конце попробуем заполнить поперечную резку
	НайденныеСтроки = Цвета.НайтиСтроки(Новый Структура("ВидСекции", Справочники.Лико_ВидыСекций.ПоперечнаяРезка));
	Если НайденныеСтроки.Количество() <> 0 И МассивПрокатов.Найти(НайденныеСтроки[0].НомерПроката) <> Неопределено И ЗначениеЗаполнено(Ссылка) Тогда
		ТекНомерПроката = НайденныеСтроки[0].НомерПроката;
		Если НЕ ТолькоНовые И Производство.НайтиСтроки(Новый Структура("НомерПроката", ТекНомерПроката)).Количество() > 0 Тогда
			// Данные уже заполнились выше, такого быть не должно, но на всякий случай проверили
			Возврат;
		КонецЕсли;
		
		КоличествоЭтикетокВРолике = 0;
		Для каждого Строка из Товары Цикл
			Если ЗначениеЗаполнено(Строка.КоличествоЭтикетокВРолике) Тогда
				КоличествоЭтикетокВРолике = Строка.КоличествоЭтикетокВРолике;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЗначениеЗаполнено(КоличествоЭтикетокВРолике) Тогда
			Возврат;
		КонецЕсли;
		
		СоответствиеБланковИЗасчЭт = Лико_Дополнительно.ПолучитьКоличествоЗасчитанныхЭтикетокПоЗаказу(Ссылка);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ЭтапыЗаказа.Период КАК Период,
		|	Лико_ЭтапыЗаказа.Заказ КАК Заказ,
		|	Лико_ЭтапыЗаказа.НомерБланка КАК НомерБланка,
		|	Лико_ЭтапыЗаказа.РабочийЦентр КАК РабочийЦентр,
		|	Лико_ЭтапыЗаказа.Ответственный КАК Ответственный,
		|	Лико_ЭтапыЗаказа.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.Лико_ЭтапыЗаказа КАК Лико_ЭтапыЗаказа
		|ГДЕ
		|	Лико_ЭтапыЗаказа.Заказ = &Заказ
		|	И Лико_ЭтапыЗаказа.Этап = ЗНАЧЕНИЕ(Справочник.Лико_ЭтапыВыполненияЗаказа.ПоперечнаяРезка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Лико_ЭтапыЗаказа.НомерБланка,
		|	Лико_ЭтапыЗаказа.Период";

		Запрос.УстановитьПараметр("Заказ", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ТекНомерПриложения = Неопределено;
			ТекПозицияПриложения = СтрНайти(Выборка.Комментарий, "прил. ", НаправлениеПоиска.СКонца);
			Если ТекПозицияПриложения <> 0 Тогда
				Попытка
					ТекНомерПриложения = Число(Сред(Выборка.Комментарий, ТекПозицияПриложения + 6, 1));
				Исключение
					Возврат;
				КонецПопытки;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ТекНомерПриложения) Тогда
				Возврат;
			КонецЕсли;
			ТекСотрудник = Лико_Дополнительно.ПолучитьСотрудникаПоФизЛицу(Выборка.Ответственный, Площадка);
			Если НЕ ЗначениеЗаполнено(ТекСотрудник) Тогда
				Возврат;
			КонецЕсли;
			
			// Проверим, нет ли такой строки в производстве. Если есть, то пропустим
			НайденныеСтроки = Производство.НайтиСтроки(Новый Структура("Сотрудник,НомерБланка,НомерПроката", ТекСотрудник, Выборка.НомерБланка, ТекНомерПроката));
			Если НайденныеСтроки.Количество() <> 0 Тогда
				Продолжить;
			КонецЕсли;
			
			стрпп = Производство.Добавить();
			стрпп.КлючСтроки =  Новый УникальныйИдентификатор;
			стрпп.Сотрудник = ТекСотрудник;
			стрпп.Дата = НачалоДня(Выборка.Период);
			стрпп.НомерБланка = Выборка.НомерБланка;
			стрпп.РабочийЦентр = Выборка.РабочийЦентр;
			стрпп.НомерПроката = ТекНомерПроката; 
			
			ЗначениеСоответствияТекБланк = СоответствиеБланковИЗасчЭт.Получить(Выборка.НомерБланка);
			Если ЗначениеСоответствияТекБланк <> Неопределено Тогда
				// Нужно найти свое приложение
				ЗначениеСоответствияТекПриложение = ЗначениеСоответствияТекБланк.Получить(ТекНомерПриложения);
				Если ЗначениеСоответствияТекПриложение <> Неопределено Тогда
					стрпп.ЭтикетокЗасчитано = ЗначениеСоответствияТекПриложение / КоличествоЭтикетокВРолике;
					ЗначениеСоответствияТекБланк.Удалить(ТекНомерПриложения);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;		

КонецПроцедуры


Функция СформироватьСоответствиеЗасчитанныхЭтикетокПоВыпускуТекущегоПроката(ТекНомерПроката)

	СоответствиеБланковИЗасчЭт = Новый Соответствие; 

	ЗапросПМ = Новый Запрос;
	ЗапросПМ.Текст = 
	"ВЫБРАТЬ
	|	Лико_БланкЭтапа.НомерБланка КАК НомерБланка,
	|	Лико_БланкЭтапа.ЗаказПокупателя КАК ЗаказКлиента,
	|	СУММА(Лико_БланкЭтапаВыпуск.Количество) КАК Количество
	|ИЗ
	|	Документ.Лико_БланкЭтапа КАК Лико_БланкЭтапа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_БланкЭтапа.Выпуск КАК Лико_БланкЭтапаВыпуск
	|		ПО Лико_БланкЭтапа.Ссылка = Лико_БланкЭтапаВыпуск.Ссылка
	|ГДЕ
	|	Лико_БланкЭтапа.Проведен
	|	И НЕ Лико_БланкЭтапа.ПометкаУдаления
	|	И Лико_БланкЭтапа.ЗаказПокупателя = &ЗаказКлиента
	|	И Лико_БланкЭтапа.НомерПроката = &НомерПроката
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_БланкЭтапа.ЗаказПокупателя,
	|	Лико_БланкЭтапа.НомерБланка";
	
	ЗапросПМ.УстановитьПараметр("ЗаказКлиента", Ссылка);
	ЗапросПМ.УстановитьПараметр("НомерПроката", ТекНомерПроката);
	
	ВыборкаПМ = ЗапросПМ.Выполнить().Выбрать();
	Если ВыборкаПМ.Количество() > 0 Тогда
		Пока ВыборкаПМ.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаПМ.Количество) Тогда
				ЗначениеСоответствия = Новый Структура;
				ЗначениеСоответствия.Вставить("ТипДанных", "ПогМетры");
				ЗначениеСоответствия.Вставить("Значение", ВыборкаПМ.Количество);
				СоответствиеБланковИЗасчЭт.Вставить(ВыборкаПМ.НомерБланка, ЗначениеСоответствия);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;  
	
	Возврат СоответствиеБланковИЗасчЭт;
КонецФункции

Функция СформироватьСоответствиеЗасчитанныхЭтикетокПоПотреблениюСледующегоПроката(ТекНомерПроката)

	СоответствиеБланковИЗасчЭт = Новый Соответствие; 
	Если ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Термоусадка Тогда
		// Смотрим ПМ материала, закрытого на РЦ вида Термоусадка и делим на Количество ручьев печати из заказа (т.к. на печатной машине нарезка широкая, а на склейку приходит узкая)
		НужноДелитьНаРучьи = Истина;
	ИначеЕсли ТипЗаказа = Перечисления.Лико_ТипыЗаказов.СамоклеящаясяЭтикетка Тогда
		// Чистые метры - это метры, потребленные следующей машиной
		НужноДелитьНаРучьи = Ложь;
	Иначе
		Возврат СоответствиеБланковИЗасчЭт;
	КонецЕсли;
	
	ЗапросПМ = Новый Запрос;
	ЗапросПМ.Текст = 
	"ВЫБРАТЬ
	|	Лико_БланкЭтапа.НомерБланка КАК НомерБланка,
	|	Лико_БланкЭтапа.ЗаказПокупателя КАК ЗаказКлиента,
	|	Лико_БланкЭтапа.ЗаказПокупателя.РучьиПечати КАК РучьиПечати,
	|	СУММА(Лико_БланкЭтапаТовары.КоличествоРасход) КАК КоличествоРасход,
	|	МАКСИМУМ(Лико_БланкЭтапа.РабочийЦентр.ВидРабочегоЦентра) КАК ВидРабочегоЦентра
	|ИЗ
	|	Документ.Лико_БланкЭтапа КАК Лико_БланкЭтапа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
	|		ПО Лико_БланкЭтапа.Ссылка = Лико_БланкЭтапаТовары.Ссылка
	|			И (Лико_БланкЭтапаТовары.Списать)
	|			И (ВЫБОР
	|				КОГДА &ТипЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЗаказов.Термоусадка)
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ Лико_БланкЭтапаТовары.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Печать)
	|			КОНЕЦ)
	|			И (Лико_БланкЭтапаТовары.Номенклатура.ВидНоменклатуры.Лико_РулонныйМатериал)
	|ГДЕ
	|	Лико_БланкЭтапа.Проведен
	|	И НЕ Лико_БланкЭтапа.ПометкаУдаления
	|	И Лико_БланкЭтапа.ЗаказПокупателя = &ЗаказКлиента
	|	И Лико_БланкЭтапа.НомерПроката = &НомерПроката
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_БланкЭтапа.ЗаказПокупателя,
	|	Лико_БланкЭтапа.ЗаказПокупателя.РучьиПечати,
	|	Лико_БланкЭтапа.НомерБланка";
	
	ЗапросПМ.УстановитьПараметр("ТипЗаказа", ТипЗаказа);
	ЗапросПМ.УстановитьПараметр("ЗаказКлиента", Ссылка);
	ЗапросПМ.УстановитьПараметр("НомерПроката", ТекНомерПроката + 1);
	
	ВыборкаПМ = ЗапросПМ.Выполнить().Выбрать();
	Если ВыборкаПМ.Количество() > 0 Тогда
		Пока ВыборкаПМ.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаПМ.КоличествоРасход) Тогда
				ЗначениеСоответствия = Новый Структура;
				ЗначениеСоответствия.Вставить("ТипДанных", "ПогМетры");
				ЗначениеСоответствия.Вставить("Значение", ВыборкаПМ.КоличествоРасход / ?(НужноДелитьНаРучьи И ВыборкаПМ.РучьиПечати <> 0 И ВыборкаПМ.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.СклейкаТермоусадки, ВыборкаПМ.РучьиПечати, 1));
				СоответствиеБланковИЗасчЭт.Вставить(ВыборкаПМ.НомерБланка, ЗначениеСоответствия);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;  
	
	Возврат СоответствиеБланковИЗасчЭт;
	
КонецФункции

Функция РассчитатьТиражНаСервере(ПогонныйМетраж, ВидРЦ = Неопределено) Экспорт
	
	ТекТираж = 0;
	
	Если ЕдиницаИзмеренияЗаказа = Справочники.Лико_ПредопределенныеЗначения.ЕИТысШт.ЗначениеПараметра Тогда 
		// --> Начало Лико Ефимов ЕВВ 09.04.2025
		Если ВидРЦ <> Неопределено И ВидРЦ = Справочники.ВидыРабочихЦентров.СклейкаТермоусадки Тогда
			// На собрании по ТУ договорились, что для склейки пог.м. = КоличествоТысШт * ВысотаЭтикетки
			ТекТираж = ?(ДлинаЭтикетки = 0, 0, ПогонныйМетраж / ДлинаЭтикетки);	
		Иначе
		// <-- Конец Лико Ефимов ЕВВ 09.04.2025
			ТекТираж =  Лико_ТиражМетраж.РассчитатьТираж(ПогонныйМетраж, Нарезка, ШтКВМ);
		КонецЕсли;
	ИначеЕсли ЕдиницаИзмеренияЗаказа = Справочники.Лико_ПредопределенныеЗначения.ЕИПогМетр.ЗначениеПараметра Тогда
		ТекТираж =  ПогонныйМетраж;
	ИначеЕсли ЕдиницаИзмеренияЗаказа = Справочники.Лико_ПредопределенныеЗначения.ЕИКвадрМетр.ЗначениеПараметра Тогда
		ТекТираж =  ПогонныйМетраж*Нарезка.Размер / 1000;		
	КонецЕсли;
		
	Возврат ТекТираж;
	
КонецФункции 	

Функция РассчитатьМетражНаСервере(Количество, ВидРЦ = Неопределено) Экспорт
	
	Если ЕдиницаИзмеренияЗаказа = Справочники.Лико_ПредопределенныеЗначения.ЕИТысШт.ЗначениеПараметра Тогда
		// --> Начало Лико Ефимов ЕВВ 09.04.2025
		Если ВидРЦ <> Неопределено И ВидРЦ = Справочники.ВидыРабочихЦентров.СклейкаТермоусадки Тогда
			// На собрании по ТУ договорились, что для склейки пог.м. = КоличествоТысШт * ВысотаЭтикетки
			ТекМетражПМ = Количество * ДлинаЭтикетки / 1000;	
		Иначе
		// <-- Конец Лико Ефимов ЕВВ 09.04.2025
			ТекМетражПМ = Лико_ТиражМетраж.РассчитатьМетраж(количество, Нарезка, ШтКВМ);
		КонецЕсли;
	ИначеЕсли ЕдиницаИзмеренияЗаказа = Справочники.Лико_ПредопределенныеЗначения.ЕИПогМетр.ЗначениеПараметра Тогда
		ТекМетражПМ = количество/1000;
	ИначеЕсли ЕдиницаИзмеренияЗаказа = Справочники.Лико_ПредопределенныеЗначения.ЕИКвадрМетр.ЗначениеПараметра Тогда
		ТекМетражПМ =  количество/Нарезка.Размер;		
	КонецЕсли;
	
	Возврат ТекМетражПМ;
	
КонецФункции	

Функция СформироватьСоответствиеЗасчитанныхЭтикетокПоПередачеСПоперечнойРезкиНаВК()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ЭтапыЗаказа.Заказ КАК Заказ,
		|	Лико_ЭтапыЗаказа.НомерБланка КАК НомерБланка,
		|	Лико_ЭтапыЗаказа.Комментарий КАК Комментарий,
		|	Лико_ЭтапыЗаказа.Количество КАК Количество,
		|	0 КАК НомерПриложения
		|ИЗ
		|	РегистрСведений.Лико_ЭтапыЗаказа КАК Лико_ЭтапыЗаказа
		|ГДЕ
		|	Лико_ЭтапыЗаказа.Заказ = &Заказ
		|	И Лико_ЭтапыЗаказа.Этап = ЗНАЧЕНИЕ(Справочник.Лико_ЭтапыВыполненияЗаказа.ПоперечнаяРезка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Лико_ЭтапыЗаказа.НомерБланка,
		|	Лико_ЭтапыЗаказа.Период
		|ИТОГИ ПО
		|	НомерБланка";
	
	Запрос.УстановитьПараметр("Заказ", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНомерБланка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СоответствиеБланков = Новый Соответствие;
	
	Пока ВыборкаНомерБланка.Следующий() Цикл
		СоответствиеПриложений = Новый Соответствие;
		Выборка = ВыборкаНомерБланка.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ТекНомерПриложения = Неопределено;
			ТекПозицияПриложения = СтрНайти(Выборка.Комментарий, "прил. ", НаправлениеПоиска.СКонца);
			Если ТекПозицияПриложения <> 0 Тогда
				Попытка
					ТекНомерПриложения = Число(Сред(Выборка.Комментарий, ТекПозицияПриложения + 6, 1));
				Исключение
					ТекНомерПриложения = 0;
				КонецПопытки;
			КонецЕсли;
			ТекЗначениеСоответствия = СоответствиеПриложений.Получить(ТекНомерПриложения);
			Если ТекЗначениеСоответствия = Неопределено Тогда
				СоответствиеПриложений.Вставить(ТекНомерПриложения, Выборка.Количество); 
			Иначе
				СоответствиеПриложений.Вставить(ТекНомерПриложения, ТекЗначениеСоответствия + Выборка.Количество); 
			КонецЕсли;
		КонецЦикла;
		СоответствиеБланков.Вставить(ВыборкаНомерБланка.НомерБланка, СоответствиеПриложений);
	КонецЦикла;

	Возврат СоответствиеБланков;

КонецФункции

