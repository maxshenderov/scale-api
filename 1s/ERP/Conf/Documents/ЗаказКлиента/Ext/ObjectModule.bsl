	Если НЕ ТолькоНовые Тогда
		// Перед заполнением очистим уже заполненные затраты по текущему прокату
		Для каждого ТекНомерПроката из МассивПрокатов Цикл
			НайденныеСтроки = Производство.НайтиСтроки(Новый Структура("НомерПроката", ТекНомерПроката));
			Для каждого Строка из НайденныеСтроки Цикл
				Производство.Удалить(Строка);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
