						ТаблицаНастроекТекПрокат.Удалить(ТекСтрокаКУдалению);
					КонецЦикла;
				КонецЕсли;
			Иначе 
				// Заполняем по-старому		
			// <-- Конец Лико Ефимов ЕВВ 08.12.2025
				Если НЕ БылаНастройка ИЛИ ЗаполнитьДополнительнуюНастройку Тогда
					Стрпп.КоличествоНастроек = 1;
					БылаНастройка = Истина;
					// <-- Начало Лико Яцун С. В. 28.04.2025 
					Если Площадка = Справочники.Лико_Площадки.Ликофлекс ИЛИ Площадка = Справочники.Лико_Площадки.Линкс ИЛИ Площадка = Справочники.Лико_Площадки.ИксПак Тогда
						ДатаНачалаИспользованияДокументовКартаСнятияПерерасхода = Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияДокументовКартаСнятияПерерасхода.ЗначениеПараметра;
						Если ЗначениеЗаполнено(ДатаНачалаИспользованияДокументовКартаСнятияПерерасхода) И ТекущаяДата() >= ДатаНачалаИспользованияДокументовКартаСнятияПерерасхода Тогда
							Если ЗаполнитьДополнительнуюНастройку Тогда
								ЗаполнитьДополнительнуюНастройку = Ложь;
								ЭтоДополнительнаяНастройка = Истина;
							Иначе
								ЭтоДополнительнаяНастройка = Ложь;
							КонецЕсли;
							Если ЗначениеЗаполнено(Выборка.ВидСнятия) И (Выборка.ВидСнятия = Перечисления.Лико_ВидыСнятия.ВинаПечатника ИЛИ Выборка.ВидСнятия = Перечисления.Лико_ВидыСнятия.НетВиныПечатника И НЕ ЗначениеЗаполнено(Выборка.КоличествоВыпускПМ)) Тогда
								Если ЭтоДополнительнаяНастройка Тогда
									Стрпп.КоличествоНастроек = 0;
									ЗаполнитьДополнительнуюНастройку = Истина;
								Иначе
									Стрпп.КоличествоНастроек = 0;
									БылаНастройка = Ложь;
								КонецЕсли;
							ИначеЕсли ЗначениеЗаполнено(Выборка.ВидСнятия) И Выборка.ВидСнятия = Перечисления.Лико_ВидыСнятия.НетВиныПечатника И ЗначениеЗаполнено(Выборка.КоличествоВыпускПМ) Тогда
								ЗаполнитьДополнительнуюНастройку = Истина;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					// <-- Конец Лико Яцун С. В. 28.04.2025
				КонецЕсли;
			КонецЕсли;
			стрпп.КлючСтроки =  Новый УникальныйИдентификатор;
			стрпп.НарезкаРазмер = ?(стрпп.КоличествоПМ = 0, 0, стрпп.Количество / стрпп.КоличествоПМ) * 1000;
			Если стрпп.НарезкаРазмер = 0 Тогда
				стрпп.НарезкаРазмер = Выборка.Нарезка.Размер;
			КонецЕсли;

			// --> Начало Лико Ефимов ЕВВ 07.07.2023
			Если НужноЗаполнятьЗасчитанныеЭтикетки Тогда
				ЗначениеСоответствияТекБланк = СоответствиеБланковИЗасчЭт.Получить(Выборка.НомерБланка);
				Если ЗначениеСоответствияТекБланк <> Неопределено Тогда
					Если ТипЗнч(ЗначениеСоответствияТекБланк) = Тип("Структура") И ЗначениеСоответствияТекБланк.ТипДанных = "ПогМетры" Тогда
						стрпп.ПогМетровЗасчитано = ЗначениеСоответствияТекБланк.Значение;
						Если стрпп.КоличествоПМ <> 0 И стрпп.Количество <> 0 Тогда
							стрпп.КвМетровЗасчитано = стрпп.ПогМетровЗасчитано * стрпп.НарезкаРазмер / 1000;
							стрпп.ЭтикетокЗасчитано = РассчитатьТиражНаСервере(стрпп.ПогМетровЗасчитано);
						КонецЕсли;
					ИначеЕсли ТипЗнч(ЗначениеСоответствияТекБланк) = Тип("Соответствие") Тогда 
