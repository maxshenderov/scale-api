Процедура ОснасткаСоздатьСообщение() //+Лико m.shenderov 02.09.2021
	УстановитьПривилегированныйРежим(Истина);	
	Если СтатусЗаказаНаПроизводствоОснасткиОснастки=Перечисления.Лико_СтатусыЗаказаНаПроизводствоОснастки.Программирование  Тогда		
		ЗаголовокСообщения="готов к программированию";
		ТипСообщения=Справочники.Лико_ТипыСообщений.ПрограммированиеОснастки;		
	Иначе
		ЗаголовокСообщения="готов к гравировке";
		ТипСообщения=Справочники.Лико_ТипыСообщений.ГотовКГравировкеОснастки;		
	КонецЕсли;
	
	Текст =  СтрШаблон("Заказ № %1 %2",НомерБезПрефикса,ЗаголовокСообщения);
	
	Тема  = Текст;
	Текст= Символы.ПС+ "Ссылка : "+Символы.ПС+Символы.ВК+ПолучитьНавигационнуюСсылку(Ссылка);
	Для каждого Товар  Из Товары  Цикл
		Текст=Текст+Символы.ПС+Символы.ВК;
		Текст=Текст+Товар.Артикул+ ";        Номенклатура =  "+Строка(Товар.Наименование);			
	КонецЦикла;	
	Текст=Текст+Символы.ПС+Символы.ВК;  
	
	Адресат = Справочники.Лико_ТипыСообщений.ПолучитьПочтовыеАдреса(ТипСообщения,Площадка); 		
	
	Лико_Планирование.ОтправитьПисьмо(текст, Тема, Адресат,,"textBody"); 
	
	
	
