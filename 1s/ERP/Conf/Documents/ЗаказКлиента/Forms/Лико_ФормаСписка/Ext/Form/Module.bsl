Процедура ПослеОтветаНаВопросОбИзмененииСтавкиНДС(РезультатВопроса, ДополнительныеПараметры) Экспорт // <-- Начало Лико Яцун С. В. 14.01.2026
    
	Результат = РезультатВопроса;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если ДополнительныеПараметры.Процедура = "ПослеВыбораЗаявкиНаОтгрузку" Тогда
			ПослеВыбораЗаявкиНаОтгрузку(ДополнительныеПараметры.Результат, Новый Структура("УвеличитьЦенуСНДС,МассивЗаказовДляУвеличенияЦены",Истина,ДополнительныеПараметры.МассивЗаказовДляУвеличенияЦены));
		ИначеЕсли ДополнительныеПараметры.Процедура = "ПослеВыбораШаблонаОтгрузки" Тогда	
			ПослеВыбораШаблонаОтгрузки(ДополнительныеПараметры.Результат, Новый Структура("УвеличитьЦенуСНДС,МассивЗаказовДляУвеличенияЦены",Истина,ДополнительныеПараметры.МассивЗаказовДляУвеличенияЦены));
		КонецЕсли;
	ИначеЕсли ДополнительныеПараметры.Процедура = "ПослеВыбораЗаявкиНаОтгрузку" Тогда
    	ПослеВыбораЗаявкиНаОтгрузку(ДополнительныеПараметры.Результат, Новый Структура());
	ИначеЕсли ДополнительныеПараметры.Процедура = "ПослеВыбораШаблонаОтгрузки" Тогда	
		ПослеВыбораШаблонаОтгрузки(ДополнительныеПараметры.Результат, Новый Структура());
	КонецЕсли;
	
