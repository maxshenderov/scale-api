Процедура СоздатьЗаявкуНаОтгрузку(Команда)      
	текстр = Элементы.Список.ТекущиеДанные;	
	Если Элементы.Найти("Заказ") <> Неопределено Тогда 
		Если текстр<>Неопределено Тогда       
			// <-- Начало Лико Яцун С. В. 13.01.2026
			СЗ = Новый СписокЗначений;  
			СЗ.ЗагрузитьЗначения(Элементы.Список.ВыделенныеСтроки);
			РезультатПроверки = ПроверитьСтавкуНДСВЗаказах(СЗ);
			// <-- Конец Лико Яцун С. В. 13.01.2026
			Партнер = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(текстр.Ссылка, "Партнер"); 
			//Если есть шаблоны отгрузки, выбираем шаблон, если нет, показываем список заявок этого партнера для копирования
            Если ЕстьШаблоныОтгрузок(Партнер) Тогда 
				ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораШаблонаОтгрузки", ЭтотОбъект, РезультатПроверки);
				Отбор = Новый Структура("Партнер",Партнер);
				ПараметрыФормы = Новый Структура("Отбор",Отбор);
				ОткрытьФорму("Справочник.Лико_ШаблоныЗаявокНаОтгрузку.ФормаВыбора",ПараметрыФормы,ЭтаФорма,Новый УникальныйИдентификатор,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
			Иначе   
				Контрагент = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(текстр.Ссылка, "Контрагент");
				ОрганизацияПродавец = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(текстр.Ссылка, "Организация");  
				Отбор = Новый Структура("Контрагент",Контрагент);
				Отбор.Вставить("ОрганизацияПродавец", ОрганизацияПродавец);
				ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораЗаявкиНаОтгрузку", ЭтотОбъект, РезультатПроверки);
				ПараметрыФормы = Новый Структура("Отбор",Отбор);
				ОткрытьФорму("Документ.Лико_ЗаявкаНаОтгрузку.ФормаВыбора",ПараметрыФормы,ЭтаФорма,Новый УникальныйИдентификатор,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	

			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры   

&НаСервереБезКонтекста
Функция ПроверитьСтавкуНДСВЗаказах(СписокЗаказов) // <-- Начало Лико Яцун С. В. 13.01.2026
	
	ЗадатьВопросОбИзмененииСтавкиНДС = Ложь;
	МассивЗаказовДляУвеличенияЦены = Новый Массив;
	Для каждого ВыделенныйЗаказ Из СписокЗаказов Цикл
		Если ВыделенныйЗаказ.Значение.ЦенаДляДокументовВключаетНДС Тогда
			Для каждого СтрТовар Из ВыделенныйЗаказ.Значение.Товары Цикл
				Если СтрТовар.СтавкаНДС.Ставка = 20 Тогда
					ЗадатьВопросОбИзмененииСтавкиНДС = Истина;
					МассивЗаказовДляУвеличенияЦены.Добавить(ВыделенныйЗаказ.Значение);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	СтруктураВозврата = Новый Структура("ЗадатьВопросОбИзмененииСтавкиНДС,МассивЗаказовДляУвеличенияЦены",ЗадатьВопросОбИзмененииСтавкиНДС,МассивЗаказовДляУвеличенияЦены);
	
	Возврат СтруктураВозврата;
	
КонецФункции // <-- Конец Лико Яцун С. В. 13.01.2026

