		КонецЕсли;
		
		Лико_Планирование.ОтправитьПисьмо("", СтрШаблон( "%1 приостановлен", Заказ ), СписокПолучателей);   
	КонецЕсли;   
	
	Если Заказ.Площадка = Справочники.Лико_Площадки.ИксПак Тогда 
		
		СписокПолучателей = "otk-xpack@okil-sato.ru; vplaksin@okil-sato.ru; psolodky@okil-sato.ru; 
							|rsalyakhov@okil-sato.ru; eshalaginova@okil-sato.ru; emoskvina@okil-sato.ru";	
		Лико_Планирование.ОтправитьПисьмо("", СтрШаблон( "%1 приостановлен", Заказ ), СписокПолучателей);   
		
	КонецЕсли;   
	
	Если Заказ.Площадка = Справочники.Лико_Площадки.Линкс Тогда 
		
		СписокПолучателей = "DSezemina@okil-sato.ru; TPetrova@okil-sato.ru; opp-uz@okil-sato.ru";	
