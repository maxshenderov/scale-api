&НаКлиенте
Процедура СоздатьПеределку(Команда)
	текстр = Элементы.Список.ТекущиеДанные;
	Если Элементы.Найти("Заказ")<>Неопределено Тогда 
		Если текстр<>Неопределено Тогда 
			Заказ = текстр.Ссылка;
			ИдентификаторПеределки = ПеределкаНаСервере(Заказ);		
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Ключ",Заказ);
			ПараметрыФормы.Вставить("Идентификатор",ИдентификаторПеределки);	
			ПараметрыФормы.Вставить("УбратьЦветоделение",Истина);	
			ОткрытьФорму("Документ.ЗаказКлиента.Форма.Лико_ФормаЗаявкиНаЦветоделение", ПараметрыФормы);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура АннулироватьЗаказНаСервере(Заказ)     
	Если Лико_Планирование.ЕстьЭтапыНеДоПечати(Заказ) И Не (РольДоступна("Лико_ИзменениеВыполненныхЗаказов") ИЛИ РольДоступна("ПолныеПрава")) Тогда 
		Сообщить("Заказ передавался в печать и не может быть аннулирован");
	Иначе
		Лико_Планирование.АннулироватьЗаказ(Заказ);                                                                     
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура АннулироватьЗаказ(Команда)
	текстр = Элементы.Список.ТекущиеДанные;
	Если Элементы.Найти("Заказ")<>Неопределено Тогда 
		Если текстр<>Неопределено Тогда 
			Режим = РежимДиалогаВопрос.ДаНет;
			ДопПараметры = Новый Структура("Заказ", текстр.Ссылка);
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбАнулировании", ЭтаФорма, ДопПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Вы уверены, что хотите аннулировать заказ??'"), Режим,0);	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбАнулировании(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	Иначе
		АннулироватьЗаказНаСервере(Параметры.Заказ);
		// --> Начало Лико Ефимов ЕВВ 09.06.2021 
		Элементы.Список.Обновить();
		// <-- Конец Лико Ефимов ЕВВ 09.06.2021 
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьАннулированныеПриИзменении(Элемент)
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьАннулированные",ПоказыватьАннулированные);
	Элементы.Список.Обновить();
	ОбновитьИнтерфейс();

КонецПроцедуры

&НаКлиенте
Процедура ОтборНомерПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Номер) Тогда 
		Заказ =  ПолучитьЗаказПоНомеру(Номер);
		Если ЗначениеЗаполнено(Заказ) Тогда 
			Элементы.Список.ТекущаяСтрока =  Заказ;
			// --> Начало Лико Ефимов ЕВВ 10.10.2018 
			ЭтаФорма.ТекущийЭлемент = Элементы.Номер;
			// <-- Конец Лико Ефимов ЕВВ 10.10.2018 
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявкиНаЦветоделение(Команда)
	текстр = Элементы.Список.ТекущиеДанные;
	Если Элементы.Найти("Заказ")<>Неопределено Тогда 
		Если текстр<>Неопределено Тогда 
			Заказ = текстр.Ссылка;
			ПараметрыФормы    = новый Структура("Заказ", Заказ);
			ОткрытьФорму("РегистрСведений.Лико_Цветоделение.ФормаСписка", ПараметрыФормы,,,,,,
			РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		КонецЕсли;
	КонецЕсли;		

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчетСостояниеЗаказа(Команда) // --> Начало Лико Ефимов ЕВВ 31.05.2018
	
	Если НЕ ЗначениеЗаполнено(Элементы.Список.ТекущаяСтрока) Тогда
		Сообщить("Сначала выберите заказ.");
		Возврат;	
	КонецЕсли;
	ПараметрыФормыОтчета = Новый Структура;
	ПараметрыФормыОтчета.Вставить("Отбор", Новый Структура("ЗаказКлиента", Элементы.Список.ТекущаяСтрока));
	ПараметрыФормыОтчета.Вставить("СформироватьПриОткрытии", Истина);
	
	Отчет = Лико_Дополнительно.ПолучитьПараметрыКомандыВнешнегоОтчета(,, "Лико_СостояниеЗаказа");
	Если Отчет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(Отчет.ДополнительнаяОбработкаСсылка);
	ОткрытьФорму("ВнешнийОтчет." + ИмяОбработки + ".Форма", ПараметрыФормыОтчета,, Новый УникальныйИдентификатор);

КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 31.05.2018

