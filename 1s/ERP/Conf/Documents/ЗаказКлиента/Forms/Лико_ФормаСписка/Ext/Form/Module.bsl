Функция ЗаказВПечати(Заказ) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ЭтапыЗаказа.Этап КАК Этап
		|ИЗ
		|	РегистрСведений.Лико_ЭтапыЗаказа КАК Лико_ЭтапыЗаказа
		|ГДЕ
		|	Лико_ЭтапыЗаказа.Заказ = &Заказ
		|	И Лико_ЭтапыЗаказа.Этап.ДоПечати = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);	
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Истина	
	КонецЕсли;
	
    Возврат Ложь
	
