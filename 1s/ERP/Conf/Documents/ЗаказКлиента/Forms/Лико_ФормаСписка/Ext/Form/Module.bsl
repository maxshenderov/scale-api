&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//+ Лико m.shenderov 26.01.2022
	Список.ТекстЗапроса=ПолучитьТекстЗапросаСпискаЗаказовСервер();
	//- Лико m.shenderov 26.01.2022
	
	Если РольДоступна("Лико_ЗаказыКлиентов") Тогда 
		Элементы.ГруппаПеределки.Видимость = Ложь;
	КонецЕсли;	
	
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьАннулированные", ЛОжь);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Пользователь = ПользователиКлиентСервер.ТекущийПользователь();
	Если Не  Пользователь.Лико_ПоказыватьЦеныВЗаказе Тогда 
		Элементы.Цена.Видимость = Ложь;
		Элементы.Валюта.Видимость = Ложь;
		Элементы.ЦенаДляДокументов.Видимость = Ложь;
		Элементы.СуммаДокумента.Видимость = Ложь;
		Элементы.Доходность.Видимость = Ложь;
		Элементы.Доход.Видимость = Ложь;
		Элементы.Рентабельность.Видимость = Ложь;

	КонецЕсли;
	
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПеределкаНаСервере(Заказ)
	КлючПеределки = Лико_Планирование.СоздатьПеределкуНаСервере(Заказ);
	Возврат КлючПеределки;
		
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗаказПоНомеру(Номер)
	Заказ = Документы.ЗаказКлиента.НайтиПоРеквизиту("НомерБезПрефикса", Номер);
	Возврат Заказ;
КонецФункции

