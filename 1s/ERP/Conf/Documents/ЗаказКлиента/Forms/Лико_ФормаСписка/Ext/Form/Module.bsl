        СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", Новый Структура("ЦенаВключаетНДС,СтавкаНДС", ДокСчет.ЦенаВключаетНДС, нстр.СтавкаНДС));
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
		СтруктураДействий.Вставить("ПересчитатьСумму", "Количество");
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(нстр, СтруктураДействий, КэшированныеЗначения);

		
	КонецЦикла;
	
	
	ЗначениеВДанныеФормы(ДокСчет,ДанныеФормы);

КонецПроцедуры



&НаКлиенте
Процедура СоздатьКП(Команда)
			
	МассивВыделенных = Элементы.Список.ВыделенныеСтроки;
    Если МассивВыделенных.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    // Платформа 1С умеет принимать МАССИВ в качестве параметра "Основание"
    ПараметрыОткрытия = Новый Структура("Основание", МассивВыделенных);
    ОткрытьФорму("Документ.КоммерческоеПредложениеКлиенту.Форма.ФормаДокумента", ПараметрыОткрытия);
КонецПроцедуры



&НаКлиенте
Процедура ЗаполнитьСвойстваМатериалов(Команда) // <-- Начало Лико Яцун С. В. 22.12.2025
	
	ВыделеноЗаказов = Элементы.Список.ВыделенныеСтроки.Количество();
	Если УстановленыОтборыЗаказов() ИЛИ ВыделеноЗаказов > 1 Тогда
		Обработка = НайтиВПФ("лк Список рулонных материалов");  
		ОбъектПередачи = Элементы.Список.ТекущаяСтрока;
		Лико_Площадка = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ОбъектПередачи,"Площадка");
		Организация = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Лико_Площадка,"Организация");
		Если Обработка <> Неопределено Тогда
			
			Если ЗначениеЗаполнено(Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Организация, "Лико_УчетНаСкладеПоBRC", Ложь)) Тогда 
				BRC = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Организация, "Лико_УчетНаСкладеПоBRC", Ложь);
			Иначе
				BRC = Ложь;
			КонецЕсли;
			
			Если BRC Тогда
				BRC_ДатаКарантина = ТекущаяДата() - Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ПредопределенноеЗначение("Справочник.Лико_ПредопределенныеЗначения.BRC_ДлительностьКарантинаЧас"),"ЗначениеПараметра")*60*60;
			Иначе
				BRC_ДатаКарантина = ТекущаяДата();
			КонецЕсли;
			
			ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(Обработка);
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("Дата", ТекущаяДата());
			ПараметрыОткрытия.Вставить("Партнер", Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ОбъектПередачи,"Партнер"));  
			ПараметрыОткрытия.Вставить("Заказ", ОбъектПередачи);  
			ПараметрыОткрытия.Вставить("BRC", BRC);
			ПараметрыОткрытия.Вставить("BRC_ДатаКарантина",BRC_ДатаКарантина);
			ПараметрыОткрытия.Вставить("Организация", Организация);
			ПараметрыОткрытия.Вставить("Площадка", Организация);
			ПараметрыОткрытия.Вставить("ИзСпискаЗаказов", Истина); 
			ПараметрыОткрытия.Вставить("Лико_Площадка", Лико_Площадка);
			Если ЗначениеЗаполнено(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ОбъектПередачи,"ОсновнойМатериал")) И ТипЗнч(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ОбъектПередачи,"ОсновнойМатериал")) = Тип("СправочникСсылка.ЦеновыеГруппы") Тогда
				ПараметрыОткрытия.Вставить("ЦеноваяГруппаОтбор", Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ОбъектПередачи,"ОсновнойМатериал"));
				ПараметрыОткрытия.Вставить("ПоЦенновойГруппеОтбор", Ложь);
				ПараметрыОткрытия.Вставить("НоменклатураОтбор", Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ОбъектПередачи,"ОсновнойМатериал"),"ОсновнаяНоменклатура"));
				ПоставщикОтбор = Новый  СписокЗначений;
				ПоставщикОтбор.Добавить(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ОбъектПередачи,"ОсновнойМатериал"),"ОсновнаяНоменклатура"),"Производитель"));
				ПараметрыОткрытия.Вставить("ПоставщикОтбор", ПоставщикОтбор);
				ПараметрыОткрытия.Вставить("ПоНоменклатуреОтбор", Ложь);
			ИначеЕсли ЗначениеЗаполнено(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ОбъектПередачи,"ОсновнойМатериал")) И ТипЗнч(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ОбъектПередачи,"ОсновнойМатериал")) = Тип("СправочникСсылка.Номенклатура") Тогда
				ПараметрыОткрытия.Вставить("ЦеноваяГруппаОтбор", Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ОбъектПередачи,"ОсновнойМатериал"),"ЦеноваяГруппа"));
				ПараметрыОткрытия.Вставить("ПоЦенновойГруппеОтбор", Ложь);
				ПараметрыОткрытия.Вставить("НоменклатураОтбор", Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ОбъектПередачи,"ОсновнойМатериал"));
				ПоставщикОтбор = Новый  СписокЗначений;
				ПоставщикОтбор.Добавить(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ОбъектПередачи,"ОсновнойМатериал"),"Производитель"));
				ПараметрыОткрытия.Вставить("ПоставщикОтбор", ПоставщикОтбор);
				ПараметрыОткрытия.Вставить("ПоНоменклатуреОтбор", Ложь);
			КонецЕсли;
			ПараметрыОткрытия.Вставить("КоличествоЗаказовДляСохраненияСвойств", ?(ВыделеноЗаказов > 1,ВыделеноЗаказов,ПолучитьКоличествоЗаказовДляСохраненияСвойств()));
			ПараметрыОткрытия.Вставить("ТекстЗапросаОстаткиНоменклатуры", Неопределено);
			ПараметрыДляОткрытия = Новый Структура("ДанныеЗаполненияОтборов",ПараметрыОткрытия);
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияФормыАналоговМатериала", ЭтаФорма);  
			ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.ФормаПодбораАналогаМатериала",ПараметрыДляОткрытия,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			//ОткрытьФорму("Обработка.Лико_СписокРулонныхМатериалов.Форма.ФормаПодбораАналогаМатериала",ПараметрыДляОткрытия,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
	Иначе
		Сообщить("Не установлен отбор заказов, установите отбор, для каких заказов хотите заполнить свойства материала");	
	КонецЕсли;
	
КонецПроцедуры // <-- Конец Лико Яцун С. В. 22.12.2025

&НаСервере
Функция УстановленыОтборыЗаказов() // <-- Начало Лико Яцун С. В. 22.12.2025

	Настройки = Элементы.Список.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	УстановленыОтборыЗаказов = Ложь;
	
	Для каждого ЭлементОтбора Из Настройки.Отбор.Элементы Цикл
		Если ЭлементОтбора.Использование Тогда
			УстановленыОтборыЗаказов = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат УстановленыОтборыЗаказов;

КонецФункции // <-- Конец Лико Яцун С. В. 22.12.2025

&НаСервере
Функция ПолучитьКоличествоЗаказовДляСохраненияСвойств() // <-- Начало Лико Яцун С. В. 22.12.2025
	
	ТЗизДинамическогоСписка = ПолучитьТЗизДинамическогоСписка();
	КоличествоЗаказовДляСохраненияСвойств = ТЗизДинамическогоСписка.Количество();
	
	Возврат КоличествоЗаказовДляСохраненияСвойств;

КонецФункции // <-- Конец Лико Яцун С. В. 22.12.2025

&НаСервере
Функция ПолучитьТЗизДинамическогоСписка() // <-- Начало Лико Яцун С. В. 22.12.2025

	Схема = Элементы.Список.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы.Список.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ТабЗначений = Новый ТаблицаЗначений;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТабЗначений);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Возврат ТабЗначений;

КонецФункции // <-- Конец Лико Яцун С. В. 22.12.2025

&НаКлиенте
Процедура ПослеЗакрытияФормыАналоговМатериала(Результат, Параметры) Экспорт // <-- Начало Лико Яцун С. В. 19.12.2025    
	
	Если Результат <> Неопределено Тогда
		СвойстваМатериалаДляХранилища = Результат;
		ЗаполнитьСвойстваМатериаловНаСервере(СвойстваМатериалаДляХранилища)
	КонецЕсли;
	
КонецПроцедуры // <-- Конец Лико Яцун С. В. 19.12.2025 

&НаСервере
Процедура ЗаполнитьСвойстваМатериаловНаСервере(СвойстваМатериалаДляХранилища) // <-- Начало Лико Яцун С. В. 22.12.2025
	
	ТЗизДинамическогоСписка = ПолучитьТЗизДинамическогоСписка();
	Для каждого Стр Из ТЗизДинамическогоСписка Цикл
		//Если выделено несколько строк, то заполняется только в них
		Если Элементы.Список.ВыделенныеСтроки.Количество() > 1 Тогда
			Если Элементы.Список.ВыделенныеСтроки.Найти(Стр.Ссылка) = Неопределено Тогда
				Продолжить;
			Иначе
				Если НЕ Стр.Ссылка.ПоставщикМатериалаЛюбой Тогда
					ЗаказОбъект = Стр.Ссылка.ПолучитьОбъект();
					
					ЗаказОбъект.СвойстваМатериала = Новый ХранилищеЗначения(СвойстваМатериалаДляХранилища);
					ЗаказОбъект.ОбменДанными.Загрузка = Истина;
					ЗаказОбъект.Записать();
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если НЕ Стр.Ссылка.ПоставщикМатериалаЛюбой Тогда
				ЗаказОбъект = Стр.Ссылка.ПолучитьОбъект();
				
				ЗаказОбъект.СвойстваМатериала = Новый ХранилищеЗначения(СвойстваМатериалаДляХранилища);
				ЗаказОбъект.ОбменДанными.Загрузка = Истина;
				ЗаказОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры  // <-- Конец Лико Яцун С. В. 22.12.2025

