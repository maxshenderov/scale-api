 &НаКлиенте
Процедура БлокироватьЗаказ(Команда)
	
	текстр = Элементы.Список.ТекущиеДанные;

	
	Если Элементы.Найти("Заказ") <> Неопределено Тогда 
		
		Если текстр <> Неопределено Тогда  
			
			Если ВозможноЗаблокироватьЗаказ(текстр.Ссылка) Тогда
				
				Режим = РежимДиалогаВопрос.ДаНет;
				ДопПараметры = Новый Структура("Заказ", текстр.Ссылка);
				Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОБлокировке", ЭтаФорма, ДопПараметры);
				ПоказатьВопрос(Оповещение, НСтр("ru = 'Вы уверены, что хотите заблокировать заказ??'"), Режим,0);
				
			Иначе
				Сообщить("Этот заказ нельзя заблокировать");
				
			КонецЕсли;
		
		КонецЕсли;  
		
	КонецЕсли;

	
	
