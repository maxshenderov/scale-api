&НаКлиенте
Процедура ПослеВыбораШаблонаОтгрузки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		// <-- Начало Лико Яцун С. В. 14.01.2026
		Если ДополнительныеПараметры.Свойство("ЗадатьВопросОбИзмененииСтавкиНДС") И ДополнительныеПараметры.ЗадатьВопросОбИзмененииСтавкиНДС Тогда
			ДопПараметры = Новый Структура("Результат,Процедура,МассивЗаказовДляУвеличенияЦены",Результат,"ПослеВыбораШаблонаОтгрузки",ДополнительныеПараметры.МассивЗаказовДляУвеличенияЦены);
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросОбИзмененииСтавкиНДС", ЭтотОбъект, ДопПараметры),"В заказе ставка НДС 20%. Увеличить цену в заявке до 22% НДС?",РежимДиалогаВопрос.ДаНет);
			Возврат;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("УвеличитьЦенуСНДС") И ДополнительныеПараметры.УвеличитьЦенуСНДС Тогда
			ДопПараметрыЗаполнения = ДополнительныеПараметры;
		Иначе
			ДопПараметрыЗаполнения = Новый Структура("УвеличитьЦенуСНДС,МассивЗаказовДляУвеличенияЦены",Ложь,Новый Массив);	
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 14.01.2026
		Если Элементы.Список.ВыделенныеСтроки.Количество() > 0 Тогда 
			Сп = Новый СписокЗначений;  
			сП.ЗагрузитьЗначения(Элементы.Список.ВыделенныеСтроки);	
			
			ФормаЗаявки = ПолучитьФорму("Документ.Лико_ЗаявкаНаОтгрузку.Форма.ФормаДокумента");
			ДанныеФормы = ФормаЗаявки.Объект; 
			ЗаполнитьЗаявкуНаОтгрузкуНаСервере(ДанныеФормы, Результат, СП, ДопПараметрыЗаполнения);
			КопироватьДанныеФормы(ДанныеФормы, ФормаЗаявки.Объект); // копируем наш объект в объект формы и далее открываем ее
			ФормаЗаявки.Открыть();

    			
		КонецЕсли;
   КонецЕсли;	
КонецПроцедуры  

&НаСервере
Функция ЗаполнитьЗаявкуНаОтгрузкуНаСервере(ДанныеФормы, ШаблонЗаявкиНаОтгрузку,СписокЗаказов,ДопПараметрыЗаполнения)   
		
	МетаданныеИсточник = Метаданные.Справочники.Лико_ШаблоныЗаявокНаОтгрузку;
	МетаданныеНазначение= Метаданные.Документы.Лико_ЗаявкаНаОтгрузку; 
	ДокЗаявка = Документы.Лико_ЗаявкаНаОтгрузку.СоздатьДокумент();
    ДокЗаявка.Дата = ТекущаяДата();  
	ДокЗаявка.СостояниеЗаявки = Перечисления.Лико_СостоянияЗаявокНаТранспортировку.Создан;  
	ДокЗаявка.Ответственный = ШаблонЗаявкиНаОтгрузку.Менеджер;

    Для Каждого Реквизит Из МетаданныеИсточник.Реквизиты Цикл
