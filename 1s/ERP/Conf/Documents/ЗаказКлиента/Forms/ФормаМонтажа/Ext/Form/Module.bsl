
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	СхемаПуста 				 =  Истина;
	
	КоличествоКолонокМонтажа =	Объект.Ручьи;
	КоличествоСтрокМонтажа 	 = Цел(Объект.ЭтикетокНаЛисте / Объект.Ручьи); 	
	
	УбратьВидимостьКолонокСхемы();
	УстановитьВидимостьКолонокСхемы();
	
	ПрочитатьСхемыМонтажей(Отказ);
	
	
КонецПроцедуры

&НаСервере 
Процедура СоздатьКолонкиСхемы()
	Схема.Очистить();
	УбратьВидимостьКолонокСхемы();
	УстановитьВидимостьКолонокСхемы();
	
	ДобавитьСтрокиСхемы();
	
КонецПроцедуры //СоздатьКолонкиСхемы

&НаСервере 
Процедура УбратьВидимостьКолонокСхемы () //+Лико m.shenderov 11/11/2019
	Для Индекс=1 По 40 Цикл
		Элементы["СхемаКолонка"+Строка(Индекс)].Видимость=Ложь;	
	КонецЦикла;  	
	
КонецПроцедуры //-Лико m.shenderov 11/11/2019

&НаСервере 
Процедура УстановитьВидимостьКолонокСхемы () //+Лико m.shenderov 11/11/2019
	Для Индекс=1 По КоличествоКолонокМонтажа Цикл
		Элементы["СхемаКолонка"+Строка(Индекс)].Видимость=Истина;	
	КонецЦикла;  
	
	
КонецПроцедуры //-Лико m.shenderov 11/11/2019

&НаСервере 
Процедура ДобавитьСтрокиСхемы () //+Лико m.shenderov 11/11/2019
	
	Для Индекс=1 По КоличествоСтрокМонтажа Цикл
		НоваяСтрока = Схема.Добавить();
	КонецЦикла;
	
	
КонецПроцедуры //-Лико m.shenderov 11/11/2019


&НаСервере 
Процедура ПрочитатьСхемыМонтажей(Отказ)
	
	Для Каждого СтрокаМонтаж Из Объект.МонтажСхема Цикл
		
		НомерМонтажа = Цел(СтрокаМонтаж.ИндексСтроки/1000000);
		ПроверитьСоздатьКнопкуНомераМонтажа(НомерМонтажа);
		
		КоличествоМонтажей = Макс(КоличествоМонтажей, НомерМонтажа);
		
	КонецЦикла;
	
	Если КоличествоМонтажей>0 Тогда
		
		НомерТекущегоМонтажа = 1;
		
		ПрочитатьСхемуМонтажа(НомерТекущегоМонтажа);
		ВключитьПометкуКнопкиВыбораМонтажа();
		
	КонецЕсли;
	
КонецПроцедуры //ПрочитатьСхемыМонтажей

&НаСервере 
Процедура ВключитьПометкуКнопкиВыбораМонтажа()
	
	// у всех выключим
	ПрефиксИмени = "Монтаж";
	ИмяКнопки=ПрефиксИмени+Строка(НомерТекущегоМонтажа);
	
	
	Если ЗначениеЗаполнено(ТекущаяКнопка) Тогда
		Элементы[ТекущаяКнопка].ЦветФона=	ЦветаСтиля.ЦветФонаКнопки;
	КонецЕсли;
	ТекущаяКнопка=ИмяКнопки;
	//Заголовок=  Сред(Элемент.Имя,3,СтрДлина(Элемент.Имя));
	Элементы[ТекущаяКнопка].ЦветФона =   Новый Цвет(200, 200, 255);
	
КонецПроцедуры //ВключитьПометкуКнопкиВыбораМонтажа



&НаСервере 
Процедура ПрочитатьСхемуМонтажа(НомерТекущегоМонтажа)
	
	
	СоздатьКолонкиСхемы();
	
	
	
	Попытка
		
		Для Каждого СтрокаМонтажа Из Объект.МонтажСхема Цикл
			
			ИндексСтроки = СтрокаМонтажа.ИндексСтроки;
			
			НомерМонтажа = Цел(ИндексСтроки/1000000);
			ИндексСтроки = ИндексСтроки - НомерМонтажа*1000000; // индекс без монтажа
			
			Если НомерМонтажа<>НомерТекущегоМонтажа Тогда
				Продолжить;
			КонецЕсли;
			
			НомерСтрокиМонтажа = Цел(ИндексСтроки/1000);
			ИндексСтроки = ИндексСтроки - НомерСтрокиМонтажа*1000; // индекс без строки
			
			НомерКолонкиМонтажа = ИндексСтроки;
			
			СтрокаСхемы = Схема[НомерСтрокиМонтажа-1];
			СтрокаСхемы["Колонка"+НомерКолонкиМонтажа] = СтрокаМонтажа.ИндексНоменклатуры;
			
			Если СтрокаМонтажа.ИндексНоменклатуры<>0 Тогда
				СхемаПуста = Ложь;
			КонецЕсли;
		КонецЦикла;
		
	Исключение
		
		Предупреждение="Ошибка заполнения сохраненной схемы монтажа"
		+Символы.ПС
		+"(скорее всего было изменено количество ручьев и/или этикеток на листе)."
		+Символы.ПС
		+"Сформируйте, пожалуйста, схему монтажа заново.";
		ТекстПредупреждения = НСтр("ru = "+Предупреждение);		
		
	КонецПопытки;
	
КонецПроцедуры //ПрочитатьСхемуМонтажа


&НаКлиенте
Процедура СформироватьПредупреждение() //+Лико m.shenderov 11/11/2019
	Если ЗначениеЗаполнено(ТекстПредупреждения) ТОгда
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
		ТекстПредупреждения=Неопределено;
	КонецЕсли;
КонецПроцедуры //-Лико m.shenderov 11/11/2019


&НаСервере 
Процедура ПроверитьСоздатьКнопкуНомераМонтажа(НомерМонтажа)
	
	ПрефиксИмени = "Монтаж";
	ИмяКнопки=ПрефиксИмени+Строка(НомерМонтажа);
	
	Если Элементы.ГруппаСхемыМонтажа.ПодчиненныеЭлементы.Найти(ИмяКнопки)=Неопределено Тогда
		
		
		КомандаФормы  = Команды.Добавить(ИмяКнопки);
		КомандаФормы.Действие = "КнопкаВыборМонтажаНажатие";
		Элементы.Добавить(ИмяКнопки,Тип("КнопкаФормы"), Элементы.ГруппаСхемыМонтажа);
		Элементы[ИмяКнопки].Заголовок = Строка(НомерМонтажа);
		Элементы[ИмяКнопки].ИмяКоманды = ИмяКнопки;
		Элементы[ИмяКнопки].Ширина = 5;
		Элементы[ИмяКнопки].Высота = 1;
		
		
	КонецЕсли;
	
КонецПроцедуры //ПроверитьСоздатьКнопкуНомераМонтажа

&НаКлиенте
Процедура КнопкаВыборМонтажаНажатие(Элемент)
	
	НомерТекущегоМонтажа = Число(СтрЗаменить(Элемент.Имя,"Монтаж",""));
	
	ПрочитатьСхемуМонтажа(НомерТекущегоМонтажа);
	ВключитьПометкуКнопкиВыбораМонтажа();
	
КонецПроцедуры //КнопкаВыборМонтажаНажатие


