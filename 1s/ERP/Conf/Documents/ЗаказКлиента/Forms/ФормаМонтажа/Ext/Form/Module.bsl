&НаКлиенте
Процедура ДобавитьМонтаж(Команда)
	КоличествоМонтажей = КоличествоМонтажей + 1;
	НомерТекущегоМонтажа = КоличествоМонтажей;
	
	ПроверитьСоздатьКнопкуНомераМонтажа(НомерТекущегоМонтажа);
	
	СоздатьКолонкиСхемы();
	ВключитьПометкуКнопкиВыбораМонтажа();
КонецПроцедуры


&НаКлиенте
Процедура ОчиститьМонтаж(Команда)
	Для Каждого СтрокаСхема Из Схема Цикл
		Для  Колонка=1 По 40 Цикл
			СтрокаСхема["Колонка"+Колонка] = 0;
		КонецЦикла;
	КонецЦикла;
	//Схема.Очистить();
	ЗаписатьМонтажиВТЧ();
		ЭтаФорма.Модифицированность=Истина;

КонецПроцедуры


&НаКлиенте
Процедура ЗаписатьМонтажиВТЧ()
	
	Если НомерТекущегоМонтажа=0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Индекс=1 По Схема.Количество() Цикл
		Для  Колонка=1 По КоличествоКолонокМонтажа Цикл
			СтрокаСхемы = Схема[Индекс-1];
			
			// x 00y 00z
			// x - порядковый номер монтажа
			// y - индекс строки конкретного монтажа
			// z - индекс колонки конкретного монтажа
			ТекущийИндексСтроки = НомерТекущегоМонтажа*1000000 + Индекс*1000 + Число(Колонка);
			
			ЗаписатьМонтажнуюСхему(ТекущийИндексСтроки,СтрокаСхемы["Колонка"+Колонка],Колонка);			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры //ЗаписатьМонтажСхему

&НаСервере
Процедура ЗаписатьМонтажнуюСхему(ТекущийИндексСтроки,СтрокаСхемы,Колонка) //+Лико m.shenderov 11/11/2019
	Структура = Новый Структура;
	Структура.Вставить("ИндексСтроки",ТекущийИндексСтроки);
	СтрокаПоиска = Объект.МонтажСхема.НайтиСтроки(Структура);
	Если СтрокаПоиска.Количество()=0 Тогда
		
		НоваяСтрока = Объект.МонтажСхема.Добавить();
		НоваяСтрока.ИндексСтроки = ТекущийИндексСтроки;
		НоваяСтрока.ИндексНоменклатуры = СтрокаСхемы;
		
	Иначе
		
		СтрокаПоиска[0].ИндексНоменклатуры = СтрокаСхемы;
		
	КонецЕсли;
	
КонецПроцедуры  //-Лико m.shenderov 11/11/2019


&НаКлиенте
Процедура ЗаполнитьПоПервойМонтаж(Команда)
	
	Для Счетчик=2 По Схема.Количество() Цикл
		
		Строка0Схемы = Схема[0];
		СтрокаСхемы = Схема[Счетчик-1];
		
		ЗаполнитьЗначенияСвойств(СтрокаСхемы, Строка0Схемы);
		
	КонецЦикла;
	
	СхемаПуста = Ложь;
	
	ЭтаФорма.Модифицированность = Истина;
	
	ЗаписатьМонтажиВТЧ();
	ЭтаФорма.Модифицированность=Истина;
КонецПроцедуры


&НаКлиенте
Процедура СхемаПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	Для каждого СторкаЗаказа Из Элементы.МонтажСоответствия.ВыделенныеСтроки Цикл
		Данные=Элементы.МонтажСоответствия.ДанныеСтроки(СторкаЗаказа);
		
		Если Поле=Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Схема.НайтиПоИдентификатору(Строка)[СтрЗаменить(Поле.Имя,"Схема","")]=Данные.НомерСтроки;
		//ПолеСтр = Данные.НомерСтроки;
		
		СхемаПуста = Ложь;
		
		ЭтаФорма.Модифицированность = Истина;
		
		ЗаписатьМонтажиВТЧ();
	КонецЦикла;
	
КонецПроцедуры


