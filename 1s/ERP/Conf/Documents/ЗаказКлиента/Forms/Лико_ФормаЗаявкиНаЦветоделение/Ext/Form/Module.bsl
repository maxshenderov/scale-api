&НаКлиенте
Процедура СкопироватьВБуфер(Команда)
	Текст = "";
	Для каждого стр из Объект.Цвета Цикл
		Если ЗначениеЗаполнено(стр.Форма) Тогда 
			//Текст = Текст +  ?(Текст="", ""," ")+ ?(ЗначениеЗаполнено(Стр.Название),Стр.Название, стр.ТипЦвета1)+"/"+ЗначениеРеквизита(стр.Форма,"Код");
			Если ЗначениеЗаполнено(Стр.ВидТМЦ) Тогда
				Если Стр.ВидТМЦ = ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Краска") Тогда
					НТекст = Строка(стр.ТипЦвета1) + ?(ЗначениеЗаполнено(стр.ТипЦвета1) И ЗначениеЗаполнено(Стр.Название)," ","") + Строка(Стр.Название) + "/" + ЗначениеРеквизита(стр.Форма,"Код");
				ИначеЕсли Стр.ВидТМЦ = ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Лак") ИЛИ Стр.ВидТМЦ = ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Праймер") Тогда
					НТекст = Строка(Стр.ТипКраски) + "/" + ЗначениеРеквизита(стр.Форма,"Код");
				Иначе
					НТекст = Строка(стр.ВидСекции) + "/" + ЗначениеРеквизита(стр.Форма,"Код");
				КонецЕсли
			Иначе
				НТекст = "/" + ЗначениеРеквизита(стр.Форма,"Код")	
			КонецЕсли;
			Текст = Текст + ?(Текст = "",""," ") + НТекст;
			
			//Текст = Текст +  ?(Текст="", ""," ")+ ?(ЗначениеЗаполнено(Стр.ВидТМЦ),?(Стр.ВидТМЦ = ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Краска"),Строка(стр.ТипЦвета1) + " " + Строка(Стр.Название), Строка(стр.ВидСекции)),"") + "/" + ЗначениеРеквизита(стр.Форма,"Код");
		КонецЕсли;
	КонецЦикла;
	Буфер =  УстановитьТекстВБуферОбмена(Текст);
КонецПроцедуры

