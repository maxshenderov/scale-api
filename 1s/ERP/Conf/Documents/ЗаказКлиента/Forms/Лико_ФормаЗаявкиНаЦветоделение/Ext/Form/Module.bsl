
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СтрокаСтандартныхПараметровДляСозданияНовойФормы = "ВидСекции,ТипЦвета1,ТипКраски,Название,Ссылка,Площадка,Контрагент,НомерБезПрефикса,Товары";
	ЭтаФорма.Пользователь = ПользователиКлиентСервер.ТекущийПользователь();
	УтверждениеЦветов();
	Если Параметры.Свойство("Идентификатор") Тогда
		Идентификатор = Параметры.Идентификатор;		
	КонецЕсли; 
	
	Если Параметры.Свойство("УбратьЦветоделение") Тогда 
		Для каждого стр из Объект.Цвета Цикл
			стр.цветоделение = Ложь;
		КонецЦикла;
	КонецЕсли;	
	Если Не РольДоступна("ПолныеПрава") Тогда 
		Элементы.Версия.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	Если Объект.Площадка = Справочники.Лико_Площадки.Урал ИЛИ Объект.Площадка = Справочники.Лико_Площадки.Сибирь Тогда 
		Элементы.ФормаПереданВОПП.Видимость = Ложь;
	Иначе 
		Элементы.ФормаПереданНаПроизводство.Видимость = Ложь;
	КонецЕсли;
	
	//--> o.pukhova 08102020
	Если (Объект.Состояние = Перечисления.Лико_СостоянияЗаказов.Закрыт ИЛИ Объект.Состояние = Перечисления.Лико_СостоянияЗаказов.Заблокирован ИЛИ Объект.Состояние = Перечисления.Лико_СостоянияЗаказов.Аннулирован) И НЕ РольДоступна("ПолныеПрава") Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы.ФормаПереданВОДП.Доступность = Ложь;
		Элементы.ФормаЦветоделение.Доступность = Ложь;
		Элементы.ФормаКоррекция1.Доступность = Ложь;
		Элементы.ФормаКоррекция2.Доступность = Ложь;
		Элементы.ФормаПереданВОПП.Доступность = Ложь;
		Элементы.ФормаСоздатьЗаявкуНаИзготовлениеФорм.Доступность = Ложь;
		Элементы.ЦветаСкопироватьВБуфер.Доступность = Ложь;
	
		Элементы.Монтаж.Доступность = Ложь;
		Элементы.СоздатьМонтаж.Доступность = Ложь;
		Элем = Элементы.Найти("УтвердитьЦвета");
		Если Элем <> Неопределено Тогда 
			Элементы.УтвердитьЦвета.Доступность = Ложь;
		КонецЕсли;
		Элем = Элементы.Найти("ОтменитьУтверждениеЦветов");
		Если Элем <> Неопределено Тогда 
			Элементы.ОтменитьУтверждениеЦветов.Доступность = Ложь;
		КонецЕсли;

	КонецЕсли;
	//<-- o.pukhova 08102020
	
	// --> Начало Лико Ефимов ЕВВ
	Элементы.ФормаСоздатьЗаявкуНаИзготовлениеФорм.Видимость = НЕ (Объект.Площадка = Справочники.Лико_Площадки.Ликофлекс ИЛИ Объект.Площадка = Справочники.Лико_Площадки.ИксПак ИЛИ Объект.Площадка = Справочники.Лико_Площадки.Линкс);
	НовыйМеханизмСозданияФорм = Лико_Дополнительно.НовыйМеханизмСозданияФорм(Объект.Площадка.Организация, ТекущаяДата());
	Элементы.ЦветаДистортВидПолимера.Видимость = НовыйМеханизмСозданияФорм;
	Элементы.ГруппаСозданияФорм.Видимость = НовыйМеханизмСозданияФорм;
	Элементы.ЦветаПерегравировка.Видимость = НЕ НовыйМеханизмСозданияФорм;
	Элементы.ЦветаВидПолимера.Видимость = НЕ НовыйМеханизмСозданияФорм;
	ДобавитьУсловноеОформление();
	Элементы.ЦветоделениеПлощадкаВыводаФорм.ТолькоПросмотр = Объект.Площадка <> Справочники.Лико_Площадки.Линкс;
	// <-- Конец Лико Ефимов ЕВВ 
	
КонецПроцедуры  

&НаСервереБезКонтекста 
Функция СостояниеИсключения(Состояние) 
	
	Если (Состояние = Перечисления.Лико_СостоянияЗаказов.Закрыт ИЛИ Состояние = Перечисления.Лико_СостоянияЗаказов.Заблокирован ИЛИ Состояние = Перечисления.Лико_СостоянияЗаказов.Аннулирован) И НЕ РольДоступна("ПолныеПрава") Тогда
		Возврат Истина
	Иначе
		Возврат Ложь
	КонецЕсли;
		
КонецФункции

