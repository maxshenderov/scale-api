&НаСервере
Процедура ЗаписатьПроцентЗаливкиВПараметрШтампа(Вал,ПроцентЗаливки)
	
	НаборЗаписей = РегистрыСведений.Лико_ПараметрыШтампа.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(Вал);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество()=1 Тогда
		ТекЗапись = НаборЗаписей[0];
		ТекЗапись.ПроцентЗаливки = ПроцентЗаливки;
	КонецЕсли;
		
	Попытка
     	НаборЗаписей.Записать();
  	Исключение
    	Сообщить(НСтр("Не удалось записать Процент заливки в РС Параметры штампа. " ) + НаборЗаписей[0].Номенклатура + "!"+ ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеПроцентаЗаливкиВПарамерахШтампа(Вал,ПроцентЗаливки)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Лико_ПараметрыШтампа.Номенклатура КАК Номенклатура,
	|	Лико_ПараметрыШтампа.ПроцентЗаливки КАК ПроцентЗаливки
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|ГДЕ
	|	Лико_ПараметрыШтампа.Номенклатура = &Вал";
	Запрос.УстановитьПараметр("Вал", Вал);
	
	ПараметрыВала = Запрос.Выполнить().Выбрать();
	
	Пока ПараметрыВала.Следующий() Цикл
		Если Не ЗначениеЗаполнено(ПараметрыВала.ПроцентЗаливки) Тогда
			ЗаписатьПроцентЗаливкиВПараметрШтампа(Вал,ПроцентЗаливки);
		КонецЕсли;
		
	КонецЦикла;
		
	
КонецПроцедуры

&НаСервере
Функция ПроверитьЗаполнениеПроцентаЗаливки() //Для всех пока отказались
	НомераСтрок = Новый Массив;
	Для Каждого Цвет Из Объект.Цвета Цикл
		Если ЗначениеЗаполнено(Цвет.Вал) Тогда
			Если Не ЗначениеЗаполнено(Цвет.ПроцентЗаливки)Тогда
				НомерСтроки = Цвет.НомерСтроки;
				НомераСтрок.Добавить(НомерСтроки)
			Иначе
				ПроверитьЗаполнениеПроцентаЗаливкиВПарамерахШтампа(Цвет.Вал,Цвет.ПроцентЗаливки);
			КонецЕсли;				
		КонецЕсли;
	КонецЦикла;
	Если НомераСтрок.Количество() = 0 Тогда
		Возврат Неопределено
	Иначе
		Возврат НомераСтрок;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ПроверитьЗаполнениеПроцентаЗаливкиИксПак()
	НомераСтрок = Новый Массив;
	Для Каждого Цвет Из Объект.Цвета Цикл
		Если Не ЗначениеЗаполнено(Цвет.ПроцентЗаливки) Тогда
			НомераСтрок.Добавить(Цвет.НомерСтроки)			
		КонецЕсли;
	КонецЦикла;
	
	Если НомераСтрок.Количество() = 0 Тогда
		Возврат Неопределено
	Иначе
		Возврат НомераСтрок
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура Цветоделение(Команда)
	
	Если Модифицированность Тогда
		Сообщить("Необходимо записать форму заявки");
		возврат;
	КонецЕсли; 
	
	Если СостояниеИсключения(объект.Состояние) Тогда  
		Сообщить("Заказ закрыт/аннулирован/заблокирован");
		возврат		
	КонецЕсли;

	
	Если Не ЗначениеЗаполнено(Пользователь)  Тогда 
		Сообщить("Не заполнен пользователь");
		возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДатаУтвержденияЦветов) Тогда 
		Сообщить("Необходимо утвердить цвета");
		возврат;
	КонецЕсли;   

	// --> Начало Лико Ефимов ЕВВ 03.02.2025
	Если НЕ Элементы.ЦветоделениеПлощадкаВыводаФорм.ТолькоПросмотр // Линкс
		И НЕ ЗначениеЗаполнено(Элементы.Цветоделение.ТекущиеДанные.ПлощадкаВыводаФорм) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить площадку вывода форм",,,"Элементы.Цветоделение.ТекущиеДанные.ПлощадкаВыводаФорм");
		Возврат;
	КонецЕсли;   
	// <-- Конец Лико Ефимов ЕВВ 03.02.2025
	
	// <-- Начало Лико Яцун С. В. 21.08.2024 
	Если Объект.Площадка = ГлЛико_Площадки.ИксПак ИЛИ Объект.Площадка = ГлЛико_Площадки.Ликофлекс Тогда
		ФормаНеСоответствуетЗаказу = Ложь;
		Для каждого Стр Из Объект.Цвета Цикл
			Если Стр.Цветоделение И ЗначениеРеквизита(Стр.Форма,"Заказ") <> Объект.Ссылка
				// --> Начало Лико Ефимов ЕВВ 13.09.2024
				// Аня сказала добавить исключения (письмо 13.09.24 11:47)
				И НЕ (Стр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Нумератор") 
					ИЛИ Стр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ЦифровоеТиснение"))
				// <-- Конец Лико Ефимов ЕВВ 13.09.2024
				И НЕ ((Стр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Инкджет")  
						ИЛИ Стр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ЦифровойЛак")) 
					И ЗначениеРеквизита(Стр.РабочийЦентр,"ПорядковыйНомер") = 9) Тогда
				Сообщить("В строке " + Стр.НомерСтроки + " указано цветоделение, но форма не соответствует заказу. Создайте новые формы");
				ФормаНеСоответствуетЗаказу = Истина;
		    КонецЕсли;
		КонецЦикла;
		Если ФормаНеСоответствуетЗаказу Тогда
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 21.08.2024
	 
	//--> o.pukhova 08102020
	Если Объект.Площадка = ГлЛико_Площадки.ИксПак Тогда
		НомераСтрок = ПроверитьЗаполнениеПроцентаЗаливкиИксПак();  //Есть отдельная Функция для всех ПроверитьЗаполнениеПроцентаЗаливки()
		Если НомераСтрок <> Неопределено Тогда
			Для каждого Ном Из НомераСтрок Цикл
				Сообщить("Не указан процент заливки в строке № " + Ном + ". Цветоделение не отмечено.");	
			КонецЦикла; 
			Возврат;
		КонецЕсли;
	КонецЕсли;
	//<-- o.pukhova 08102020   
	
	// <-- Начало Лико Яцун С. В. 27.06.2024 
	ПорядковыйНомерРЦ = ЗначениеРеквизитаОбъектаВПривилегированномРежиме(Объект.РабочийЦентр, "ПорядковыйНомер");
	Если ПорядковыйНомерРЦ = 17 ИЛИ ПорядковыйНомерРЦ = 3 ИЛИ ПорядковыйНомерРЦ = 1 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросООтправкеПДФВНикка", ЭтотОбъект),"Отправили PDF в NIKKA?",РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	Если Объект.НоменклатураDFM Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросОСохраненииФайловДФМ", ЭтотОбъект),"Сохранили файлы в DFM?",РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 27.06.2024
	
	
	ВыполнитьЦветоделение();
	
КонецПроцедуры

&НаСервере
Функция ЗначениеРеквизитаОбъектаВПривилегированномРежиме(ОбъектСсылка, РеквизитИмя)
	
	УстановитьПривилегированныйРежим(Истина);
	Возврат Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ОбъектСсылка, РеквизитИмя);

КонецФункции

&НаКлиенте
Процедура ВыполнитьЦветоделение() // <-- Начало Лико Яцун С. В. 27.06.2024
		
	стр = Элементы.Цветоделение.ТекущиеДанные ;
	стр.ДатаЦветоделения = ТекущаяДата();
	стр.Цветоделитель =  Пользователь;
	стр.количествоНаименований 	 = ПолучитьКоличествоНаименований();
	стр.количествоЦветовОфсет 	 = ПолучитьКоличествоЦветов(ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Офсет"));
	стр.количествоЦветовФлексо 	 = ПолучитьКоличествоЦветов(ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Флексо"));
	стр.КоличествоЦветовИнкджет  = ПолучитьКоличествоЦветов(ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Инкджет"));
	стр.количествоЦветовГлубокая = ПолучитьКоличествоЦветов(ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Глубокая"));
	стр.количествоЦветовТрафарет = ПолучитьКоличествоЦветов(ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Трафарет"));
	стр.количествоЦветовЦифровая = ПолучитьКоличествоЦветов(ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Цифровая"));	
	
	стр.КоличествоКонгревов 	 = ПолучитьКоличествоРабот(ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.Конгревы"));	
	стр.КоличествоТиснений 	 	 = ПолучитьКоличествоРабот(ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.Тиснение"));	
	стр.Версия = Объект.Версия; 
	
	ЗаполнитьРЦВФормахНаСервере();
	
	Если Не Объект.Площадка = ГлЛико_Площадки.ИксПак Тогда
		// <-- Начало Лико Яцун С. В.
		Переделка = Ложь;
		НайденныеСтроки = Объект.Цветоделение.НайтиСтроки(Новый Структура("КлючСтроки", Идентификатор));
		Для каждого Строка из НайденныеСтроки Цикл
			Если Строка.Переделка <> 0 Тогда
				Переделка = Истина;
			КонецЕсли;
		КонецЦикла;
		Если (Переделка = Истина И Объект.Цифровой) ИЛИ (Объект.Площадка = ГлЛико_Площадки.Ликофлекс И Объект.БезОМ) Тогда
			ПеренестиЗаказНаСервере( ПредопределенноеЗначение("Справочник.Лико_ЭтапыВыполненияЗаказа.Производство"));     
		Иначе
		// <-- Конец Лико Яцун С. В.	
			ПеренестиЗаказНаСервере( ПредопределенноеЗначение("Справочник.Лико_ЭтапыВыполненияЗаказа.Корректура"));     
		КонецЕсли;
	КонецЕсли;
	
	ЭтаФорма.Записать();
	
	// --> Начало Лико Ефимов ЕВВ 14.09.2021
	Если Элементы.Цветоделение.ТекущиеДанные.НеВыводитьФормы = Ложь Тогда
		СоздатьЗаявкиНаФормы(Объект.Ссылка, Идентификатор); 
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 14.09.2021
	
КонецПроцедуры // <-- Конец Лико Яцун С. В. 27.06.2024

&НаКлиенте
Процедура ПослеОтветаНаВопросООтправкеПДФВНикка(РезультатВопроса, ДополнительныеПараметры) Экспорт // <-- Начало Лико Яцун С. В. 27.06.2024
    
	Результат = РезультатВопроса;
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если Объект.НоменклатураDFM Тогда
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросОСохраненииФайловДФМ", ЭтотОбъект),"Сохранили файлы в DFM?",РежимДиалогаВопрос.ДаНет);
			Возврат;
		КонецЕсли;
		ВыполнитьЦветоделение();
	Иначе
		Сообщить("Цветоделение не выполнено!");
	КонецЕсли;
			
КонецПроцедуры // <-- Конец Лико Яцун С. В. 27.06.2024

&НаКлиенте
Процедура ПослеОтветаНаВопросОСохраненииФайловДФМ(РезультатВопроса, ДополнительныеПараметры) Экспорт // <-- Начало Лико Яцун С. В. 27.06.2024
    
	Результат = РезультатВопроса;
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВыполнитьЦветоделение();
	Иначе
		Сообщить("Цветоделение не выполнено!");
	КонецЕсли;
			
КонецПроцедуры // <-- Конец Лико Яцун С. В. 27.06.2024

&НаСервереБезКонтекста
Процедура СоздатьЗаявкиНаФормы(Заказ, Идентификатор) // --> Начало Лико Ефимов ЕВВ 14.09.2021 
	
	УстановитьПривилегированныйРежим(Истина);
	
	// --> Начало изменений Иванова  20210927
	Если Заказ.Состояние = Перечисления.Лико_СостоянияЗаказов.Закрыт Тогда 
		Возврат;
	КонецЕсли;
	// <-- Конец изменений Иванова  20210927
	
	Если Заказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ЦифроваяПроба Тогда
		Возврат;
	КонецЕсли; 
	
	Переделка = Ложь;
	КоррекцияЦветоделения = Ложь;
	ПлощадкаВыводаФорм = Заказ.Площадка;
	НайденныеСтроки = Заказ.Цветоделение.НайтиСтроки(Новый Структура("КлючСтроки", Идентификатор));
	Для каждого Строка из НайденныеСтроки Цикл
		Если Строка.Переделка <> 0 Тогда
			Переделка = Истина;
		КонецЕсли;
		Если Строка.КоррекцияЦветоделения <> 0 Тогда
			КоррекцияЦветоделения = Истина;
		КонецЕсли; 
		Если ЗначениеЗаполнено(Строка.ПлощадкаВыводаФорм) Тогда
			ПлощадкаВыводаФорм = Строка.ПлощадкаВыводаФорм;
		КонецЕсли;
	КонецЦикла;

	Если КоррекцияЦветоделения Тогда
		Возврат;
	КонецЕсли; 

	ДатаНачалаСозданияЗаявкиНаФормыИзЦветоделения = Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаСозданияЗаявкиНаФормыИзЦветоделения.ЗначениеПараметра;
	Если НЕ ЗначениеЗаполнено(ДатаНачалаСозданияЗаявкиНаФормыИзЦветоделения)
		ИЛИ ДатаНачалаСозданияЗаявкиНаФормыИзЦветоделения > ТекущаяДата()
		ИЛИ ПлощадкаВыводаФорм = Справочники.Лико_Площадки.Урал
		ИЛИ ПлощадкаВыводаФорм = Справочники.Лико_Площадки.Сибирь Тогда
		Возврат;
	КонецЕсли;
	
	// Будем создавать заявки на флеко-формы с галкой "Цветоделение". Причем на каждую машину (прокат) свою заявку
	
	МассивВидовФорм = Новый Массив;
	МассивВидовФорм.Добавить(Справочники.Лико_ВидыПечати.Флексо);
	Если Переделка Тогда
		МассивВидовФорм.Добавить(Справочники.Лико_ВидыПечати.Офсет);
	КонецЕсли;
	
	// Сначала проверим, может быть уже создана заявка (по заказу и идентификатору)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТС_ЗаявкаНаРемонтРабочихЦентров.Ссылка КАК Ссылка,
		|	ТС_ЗаявкаНаРемонтРабочихЦентров.ВидФорм КАК ВидФорм,
		|	ТС_ЗаявкаНаРемонтРабочихЦентров.Номер КАК Номер
		|ИЗ
		|	Документ.ТС_ЗаявкаНаРемонтРабочихЦентров КАК ТС_ЗаявкаНаРемонтРабочихЦентров
		|ГДЕ
		|	ТС_ЗаявкаНаРемонтРабочихЦентров.ЗаказКлиента = &ЗаказКлиента
		|	И ТС_ЗаявкаНаРемонтРабочихЦентров.ИдентификаторЦветоделения = &Идентификатор
		|	И НЕ ТС_ЗаявкаНаРемонтРабочихЦентров.ПометкаУдаления
		|	И ТС_ЗаявкаНаРемонтРабочихЦентров.ВидФорм В(&МассивВидовФорм)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номер";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", Заказ);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Запрос.УстановитьПараметр("МассивВидовФорм", МассивВидовФорм);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		//// Заявка уже создана, ничего не делаем
		//Выборка = РезультатЗапроса.Выбрать();
		//Сообщить("Заявки на формы по данному цветоделению уже созданы");
		//Возврат;
		
		// Теперь договорились, что будем удалять старые заявки (если они не выполнены) и создавать новые
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Состояние = Лико_ОбщегоНазначенияСервер.СостояниеЗаявкиНАРемонт(Выборка.Ссылка);
			Если Состояние <> Перечисления.ТС_СостоянияРемонтныхРабот.Выполнен Тогда
				// Удаляем заявку
				ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
				ДокументОбъект.ПометкаУдаления = Истина;
				ДокументОбъект.Записать(?(ДокументОбъект.Проведен, РежимЗаписиДокумента.ОтменаПроведения, РежимЗаписиДокумента.Запись));
				Сообщить("Удалена заявка на формы (" + ДокументОбъект.ВидФорм + ") " + ДокументОбъект.Номер);
			Иначе
				Сообщить("Заявка на формы (" + Выборка.ВидФорм + ") " + Выборка.Номер + " уже выполнена, поэтому удалять ее нельзя");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаЦвета.НомерПроката КАК НомерПроката
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
		|ГДЕ
		|	ЗаказКлиентаЦвета.Ссылка = &Ссылка
		|	И ЗаказКлиентаЦвета.ВидСекции.ВидПечати В(&МассивВидовФорм)
		|	И (ЗаказКлиентаЦвета.Цветоделение
		|			ИЛИ ЗаказКлиентаЦвета.ДистортВидПолимера
		|			ИЛИ ЗаказКлиентаЦвета.Форма.Заказ = ЗаказКлиентаЦвета.Ссылка
		|				И ЗаказКлиентаЦвета.Форма.Сплошная
		|				И ЗаказКлиентаЦвета.ВидСекции.ВидПечати = ЗНАЧЕНИЕ(Справочник.Лико_ВидыПечати.Флексо)
		|				И ЗаказКлиентаЦвета.ВидЗаливки = ЗНАЧЕНИЕ(Перечисление.Лико_ВидЗаливки.Сплошная)
		|				И (ЗаказКлиентаЦвета.ВидТМЦ = ЗНАЧЕНИЕ(Справочник.Лико_ВидыТМЦ.Лак)
		|					ИЛИ ЗаказКлиентаЦвета.ВидТМЦ = ЗНАЧЕНИЕ(Справочник.Лико_ВидыТМЦ.Праймер)
		|					ИЛИ ЗаказКлиентаЦвета.ВидТМЦ = ЗНАЧЕНИЕ(Справочник.Лико_ВидыТМЦ.Клей)))
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаЦвета.НомерПроката
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерПроката";
	
	Запрос.УстановитьПараметр("Ссылка", Заказ);
	Запрос.УстановитьПараметр("МассивВидовФорм", МассивВидовФорм);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ИмяФайла = ПолучитьИмяВременногоФайла();
		ВнОбработка = Лико_Дополнительно.НайтиДополнительнуюОбработкуПоИмениОбъекта("ТСРабочийСтолЕРП");
		Если НЕ ЗначениеЗаполнено(ВнОбработка) Тогда
			Сообщить("Не найдена дополнительная обработка с именем объекта ТСРабочийСтолЕРП");
			Возврат;
		КонецЕсли;
		ДвоичныеДанные = ВнОбработка.ХранилищеОбработки.Получить();
		ДвоичныеДанные.Записать(ИмяФайла);
		ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь);
		
		ПараметрыДляСозданияЗаявкиНаФормы = Новый Структура("РабочийЦентр,Заказ,Оператор,НомерПроката,ИдентификаторЦветоделения,Срочность,Причина,МестоСозданияЗаявки,Площадка");
		ПараметрыДляСозданияЗаявкиНаФормы.Заказ = Заказ;
		ПараметрыДляСозданияЗаявкиНаФормы.Оператор = ?(ЗначениеЗаполнено(ПараметрыСеанса.ТекущийПользователь.ФизическоеЛицо), ПараметрыСеанса.ТекущийПользователь.ФизическоеЛицо, ПараметрыСеанса.ТекущийПользователь);
		ПараметрыДляСозданияЗаявкиНаФормы.ИдентификаторЦветоделения = Идентификатор;
		ПараметрыДляСозданияЗаявкиНаФормы.Срочность = ?(Переделка, Перечисления.ТС_СрочностьРемонтныхРабот.Срочно, Перечисления.ТС_СрочностьРемонтныхРабот.Планово);
		ПараметрыДляСозданияЗаявкиНаФормы.Причина = ?(Переделка, Справочники.Лико_ПричиныЗаявокНаФормы.Переделка, Справочники.Лико_ПричиныЗаявокНаФормы.НовыеФормы);
		ПараметрыДляСозданияЗаявкиНаФормы.МестоСозданияЗаявки = "Цветоделение";
		ПараметрыДляСозданияЗаявкиНаФормы.Площадка = ПлощадкаВыводаФорм;
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			// Создаем заявку
			ПараметрыДляСозданияЗаявкиНаФормы.НомерПроката = Выборка.НомерПроката;
			ПараметрыДляСозданияЗаявкиНаФормы.РабочийЦентр = НайтиРЦПоЗаказуИНомеруПроката(Заказ, ПараметрыДляСозданияЗаявкиНаФормы.НомерПроката);
			Если НЕ ЗначениеЗаполнено(ПараметрыДляСозданияЗаявкиНаФормы.РабочийЦентр) Тогда
				Сообщить("По прокату " + ПараметрыДляСозданияЗаявкиНаФормы.НомерПроката + " не найден рабочий центр. Заявка на формы не создана");
				Продолжить;
			КонецЕсли;
			
			Для каждого ВидФорм из МассивВидовФорм Цикл // Дописал цикл, чтобы для переделок создавались формы на офсет
				ТаблицаЦветов = Документы.ТС_ЗаявкаНаРемонтРабочихЦентров.СформироватьТЗЦветовДляЗаявкиНаФормы(Заказ, ПараметрыДляСозданияЗаявкиНаФормы.НомерПроката, ВидФорм, Истина);
				Если ТаблицаЦветов.Количество() > 0 Тогда
					СообщениеРезультат = "";
					НоваяЗаявка = ВнешняяОбработка.СоздатьЗаявкуНаФормы(ПараметрыДляСозданияЗаявкиНаФормы, Лико_Дополнительно.ТаблицаВМассивСтруктур(ТаблицаЦветов), СообщениеРезультат,, Истина, Истина);
					Если ЗначениеЗаполнено(НоваяЗаявка) Тогда
						// Раз создалась заявка, значит в сообщении скорее всего написан ее номер. Привяжем сообщение к заявке, чтобы при нажатии на него открылась форма заявки
						СообщениеПользователю = Новый СообщениеПользователю;
						СообщениеПользователю.Текст = СообщениеРезультат;
						СообщениеПользователю.КлючДанных = НоваяЗаявка; 
						СообщениеПользователю.Сообщить();
					Иначе
						// Скорее всего там просто ошибка
						Сообщить(СообщениеРезультат);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Попытка
			УдалитьФайлы(ИмяФайла);
		Исключение
		КонецПопытки;
		
	КонецЕсли;
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 14.09.2021

&НаСервереБезКонтекста
Функция НайтиРЦПоЗаказуИНомеруПроката(Заказ, НомерПроката)
	
	// Попробуем найти заказ в плане. Если в плане нет, то в ТЧ ВидыРабот заказа
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаВидыРабот.Ссылка КАК Ссылка,
		|	ЗаказКлиентаВидыРабот.НомерПроката КАК НомерПроката,
		|	МАКСИМУМ(ЗаказКлиентаВидыРабот.РабочийЦентр) КАК РабочийЦентр
		|ПОМЕСТИТЬ ВТ_РабочийЦентрЗаказа
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаВидыРабот
		|ГДЕ
		|	ЗаказКлиентаВидыРабот.Ссылка = &Ссылка
		|	И ЗаказКлиентаВидыРабот.НомерПроката = &НомерПроката
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаВидыРабот.Ссылка,
		|	ЗаказКлиентаВидыРабот.НомерПроката
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_РабочийЦентрЗаказа.Ссылка КАК Ссылка,
		|	ВТ_РабочийЦентрЗаказа.НомерПроката КАК НомерПроката,
		|	ВТ_РабочийЦентрЗаказа.РабочийЦентр КАК РабочийЦентр,
		|	МАКСИМУМ(ПооперационноеРасписание2_2.РабочийЦентр) КАК РабочийЦентрИзПлана
		|ИЗ
		|	ВТ_РабочийЦентрЗаказа КАК ВТ_РабочийЦентрЗаказа
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК ЭтапПроизводства2_2
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2
		|			ПО ЭтапПроизводства2_2.Ссылка = ПооперационноеРасписание2_2.Этап
		|				И (НЕ ПооперационноеРасписание2_2.Моделирование)
		|		ПО ВТ_РабочийЦентрЗаказа.Ссылка = ЭтапПроизводства2_2.Лико_ЗаказКлиента
		|			И ВТ_РабочийЦентрЗаказа.НомерПроката = ЭтапПроизводства2_2.НомерПроката
		|			И (ЭтапПроизводства2_2.Проведен)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_РабочийЦентрЗаказа.Ссылка,
		|	ВТ_РабочийЦентрЗаказа.НомерПроката,
		|	ВТ_РабочийЦентрЗаказа.РабочийЦентр";
	
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);
	Запрос.УстановитьПараметр("Ссылка", Заказ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.РабочийЦентрИзПлана) Тогда
			Возврат ВыборкаДетальныеЗаписи.РабочийЦентрИзПлана;
		ИначеЕсли ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.РабочийЦентр) Тогда
			Возврат ВыборкаДетальныеЗаписи.РабочийЦентр;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

