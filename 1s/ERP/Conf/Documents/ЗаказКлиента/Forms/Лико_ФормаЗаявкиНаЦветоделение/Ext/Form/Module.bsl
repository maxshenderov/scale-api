Процедура СформироватьПодменюФорматаДляСкрипта()
	ДокОбъект=Объект.Ссылка.ПолучитьОбъект();
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");    
	
    
	Для Каждого СтрокаМонтаж Из Объект.МонтажСхема Цикл
		
		НомерМонтажа = Цел(СтрокаМонтаж.ИндексСтроки/1000000);
		ПроверитьСоздатьПодменюФорматаДляСкрипта(НомерМонтажа);
		
	КонецЦикла;
	
