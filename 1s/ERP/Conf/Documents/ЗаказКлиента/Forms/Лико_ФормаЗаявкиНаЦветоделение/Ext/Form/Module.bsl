&НаКлиенте
Процедура ОтветилиНаВопросОНеобходимостиСозданияФорм(Результат, ДопПараметры) Экспорт 
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Переделка = Ложь;
		НайденныеСтроки = Объект.Цветоделение.НайтиСтроки(Новый Структура("КлючСтроки", Идентификатор));
		Для каждого Строка из НайденныеСтроки Цикл
			Если Строка.Переделка <> 0 Тогда
				Переделка = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ДопПараметры = Неопределено ИЛИ НЕ ДопПараметры.Свойство("ПослеОтветаНаВопросСохранитьПредыдущиеФормы") Тогда
			// Сначала проверим, нужно ли создавать формы и все ли необходимые реквизиты заполнены
			Если НЕ ПроверкиПередСозданиемПройдены() Тогда
				Возврат;
			КонецЕсли;
			// <-- Начало Лико Яцун С. В. 11.02.2026 
			//Если Переделка и Вид печати = Флексо и Форма не Сплошная, то задать вопрос о хранении или утилизации старой формы (заполнить в реквизит Действия с формой)
			Если Переделка Тогда
				Для каждого ТекСтр из Объект.Цвета Цикл
					ВидПечати = ЗначениеРеквизита(ТекСтр.ВидСекции, "ВидПечати");
					Если ЗначениеЗаполнено(ТекСтр.Форма) 
						И ЗначениеРеквизита(ТекСтр.Форма, "ДействияСФормой") <> ПРедопределенноеЗначение("Перечисление.Лико_ДействияСФормой.Утилизировать") 
						И ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Флексо") 
						И НЕ ЗначениеРеквизита(ТекСтр.Форма, "Сплошная") 
						И (ТекСтр.Цветоделение ИЛИ ТекСтр.ДистортВидПолимера) Тогда
						ТекстВопроса = "Хранение/Утилизация Форм";
						ВопросКнопки = Новый СписокЗначений;
						ВопросКнопки.Добавить(КодВозвратаДиалога.Да,"Хранить");
						ВопросКнопки.Добавить(КодВозвратаДиалога.Нет,"Утилизировать");
						ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросСохранитьПредыдущиеФормы", ЭтотОбъект), ТекстВопроса, ВопросКнопки,,, "Сохранить предыдущие формы?");
						Возврат;	
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		СохранитьИлиУтилизироватьСтарыеФормы = Неопределено;
		Если ДопПараметры <> Неопределено И ДопПараметры.Свойство("СохранитьИлиУтилизироватьСтарыеФормы") Тогда
			СохранитьИлиУтилизироватьСтарыеФормы = ДопПараметры.СохранитьИлиУтилизироватьСтарыеФормы;
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 11.02.2026
		// Проверки пройдены, начинаем создавать формы 
		СоздатьФормыНаСервере(СохранитьИлиУтилизироватьСтарыеФормы);
		// <-- Начало Лико Яцун С. В. 13.05.2025
		Если ПеределкаФорм.Количество() <> 0 И Переделка Тогда
			ВыполняемаяОбработка = НайтиВПФ("Обработка ""лк Переделка форм""");
			Если ЗначениеЗаполнено(ВыполняемаяОбработка) Тогда
				МассивСтруктурПеределкаФорм = Новый Массив;
				Для каждого Стр Из ПеределкаФорм Цикл
					СтруктураПеределкаФорм = Новый Структура("СтараяФорма,НоваяФорма",Стр.СтараяФорма,Стр.НоваяФорма);
				    МассивСтруктурПеределкаФорм.Добавить(СтруктураПеределкаФорм);
				КонецЦикла;
				ПараметрыОткрытия = Новый Структура;
				ПараметрыОткрытия.Вставить("МассивСтруктурПеределкаФорм",МассивСтруктурПеределкаФорм);
				ПараметрыОткрытия.Вставить("Заказ",Объект.Ссылка);
				ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВыполняемаяОбработка);
				ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма", ПараметрыОткрытия, ЭтаФорма, УникальныйИдентификатор,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			КонецЕсли;
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 13.05.2025
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверкиПередСозданиемПройдены() 
	
    // Сначала проверим, нужно ли создавать формы и все ли необходимые реквизиты заполнены
	ТребоватьЗаполнитьДистортИлиВидПолимера = Ложь;
	ЕстьСтрокиДляСозданияФорм = Ложь;
	Для каждого ТекСтр из Объект.Цвета Цикл
		Если ТекСтр.ВидСекции.Родитель = Справочники.Лико_ВидыСекций.Флексо
			И (ТекСтр.Цветоделение
				ИЛИ ТекСтр.ДистортВидПолимера)
			Тогда
			ТребоватьЗаполнитьДистортИлиВидПолимера = Истина;
			ЕстьСтрокиДляСозданияФорм = Истина;
			Если ТекСтр.ДистортВидПолимера
				И НЕ ТекСтр.Цветоделение
				Тогда
				Если НЕ ЗначениеЗаполнено(ТекСтр.Форма) Тогда
					Сообщить("Для строки №" + ТекСтр.НомерСтроки + " установлен признак ДистортВидПолимера, но не указана форма");
					Возврат Ложь;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Лико_Дополнительно.ЭтоСтрокаСплошнойФормы(ТекСтр) Тогда
			ЕстьСтрокиДляСозданияФорм = Истина;
		ИначеЕсли ТекСтр.Цветоделение Тогда
			ЕстьСтрокиДляСозданияФорм = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьСтрокиДляСозданияФорм Тогда
		Сообщить("Нет строк для создания форм");
		Возврат Ложь;
	КонецЕсли;
	
	Если ТребоватьЗаполнитьДистортИлиВидПолимера Тогда
		Если НЕ ЗначениеЗаполнено(Дисторт) Тогда
			ОбщегоНазначения.СообщитьПользователю("Заполните дисторт",, "Дисторт");
			Возврат Ложь;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ВидПолимера) Тогда
			ОбщегоНазначения.СообщитьПользователю("Заполните вид полимера",, "ВидПолимера");
			Возврат Ложь;
		КонецЕсли; 
		ПрефиксВидПолимера = Лев(СокрЛП(ВидПолимера.Префикс), 1);
		ПрефиксДисторт = Дисторт.Префикс;
		Если НЕ ЗначениеЗаполнено(ПрефиксВидПолимера) Тогда
			ОбщегоНазначения.СообщитьПользователю("У данного вида полимера не заполнен префикс",, "ВидПолимера");
			Возврат Ложь;
		КонецЕсли; 
		Если НЕ ЗначениеЗаполнено(ПрефиксДисторт) Тогда
			ОбщегоНазначения.СообщитьПользователю("У данного дисторта не заполнен префикс",, "Дисторт");
			Возврат Ложь;
		КонецЕсли; 
	КонецЕсли;
	
	Для каждого ТекСтр из Объект.Цвета Цикл
		Если ТекСтр.ВидСекции.Родитель = Справочники.Лико_ВидыСекций.Флексо
			И ТекСтр.ДистортВидПолимера
			И НЕ ТекСтр.Цветоделение
			Тогда
			// Проверим, что для такого тела формы еще нет формы с таким же кодом
			Запрос  = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
			                       |	Лико_Формы.Наименование КАК Наименование,
			                       |	Лико_Формы.Код КАК Код
			                       |ИЗ
			                       |	Справочник.Лико_Формы КАК Лико_Формы
			                       |ГДЕ
			                       |	Лико_Формы.Код = &НовыйКод
			                       |
			                       |УПОРЯДОЧИТЬ ПО
			                       |	Код");
			
			Запрос.УстановитьПараметр("НовыйКод", Лев(ТекСтр.Форма.Код, 9) + ПрефиксВидПолимера + ПрефиксДисторт);
			
			РезультатЗапроса = Запрос.Выполнить();
			Если НЕ РезультатЗапроса.Пустой() Тогда
				Выборка = РезультатЗапроса.Выбрать();
				Выборка.Следующий();
				Сообщить("Для строки №" + ТекСтр.НомерСтроки + " установлен признак ""Дисторт вид полимера"", но форма с таким кодом уже существует: " + Выборка.Наименование + "(" + Выборка.Код + ")");
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции  

&НаКлиенте
Процедура ПослеОтветаНаВопросСохранитьПредыдущиеФормы(Результат, ДопПараметры) Экспорт 
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьИлиУтилизироватьСтарыеФормы = Истина;	
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		СохранитьИлиУтилизироватьСтарыеФормы = Ложь;	
	КонецЕсли; 
	
	ОтветилиНаВопросОНеобходимостиСозданияФорм(КодВозвратаДиалога.Да, Новый Структура("ПослеОтветаНаВопросСохранитьПредыдущиеФормы,СохранитьИлиУтилизироватьСтарыеФормы",Истина,СохранитьИлиУтилизироватьСтарыеФормы));
	
КонецПроцедуры

&НаСервере
Процедура СоздатьФормыНаСервере(СохранитьИлиУтилизироватьСтарыеФормы)

	// Проверки пройдены, начинаем создавать формы 
	КолСоздФорм = 0;
	ЦифроваяФормаОбработана = Ложь;
	МассивСтарыхФорм = Новый Массив;
	Для каждого ТекСтр из Объект.Цвета Цикл
		// <-- Начало Лико Яцун С. В. 13.05.2025 
		ТекФорма = ТекСтр.форма;
		НоваяФорма = Неопределено;
		// <-- Конец Лико Яцун С. В. 13.05.2025
		ПараметрыДляСозданияНовойФормы = Новый Структура(СтрокаСтандартныхПараметровДляСозданияНовойФормы);
		ЗаполнитьЗначенияСвойств(ПараметрыДляСозданияНовойФормы, ЭтаФорма);
		ЗаполнитьЗначенияСвойств(ПараметрыДляСозданияНовойФормы, Объект);
		ЗаполнитьЗначенияСвойств(ПараметрыДляСозданияНовойФормы, ТекСтр);
		Если ТекСтр.ВидСекции.Родитель = Справочники.Лико_ВидыСекций.Флексо
			И (ТекСтр.Цветоделение
			ИЛИ ТекСтр.ДистортВидПолимера)
			Тогда
			// Создаем форму флексо с дистортом и видом полимера
			ПараметрыДляСозданияНовойФормы.Вставить("Цветоделение", ТекСтр.Цветоделение);
			ПараметрыДляСозданияНовойФормы.Вставить("ДистортВидПолимера", ТекСтр.ДистортВидПолимера);
			ПараметрыДляСозданияНовойФормы.Вставить("Дисторт", Дисторт);
			ПараметрыДляСозданияНовойФормы.Вставить("ВидПолимера", ВидПолимера);
			ПараметрыДляСозданияНовойФормы.Вставить("СтараяФорма", ТекСтр.Форма);
			// <-- Начало Лико Яцун С. В. 11.02.2026 
			Если СохранитьИлиУтилизироватьСтарыеФормы <> Неопределено И ЗначениеЗаполнено(ТекСтр.Форма) И НЕ ТекСтр.Форма.Сплошная Тогда
				СтараяФормаОбъект = ТекСтр.Форма.ПолучитьОбъект();
				Если СохранитьИлиУтилизироватьСтарыеФормы Тогда
					СтараяФормаОбъект.ДействияСФормой = Перечисления.Лико_ДействияСФормой.Хранить;	
				ИначеЕсли НЕ СохранитьИлиУтилизироватьСтарыеФормы Тогда
					СтараяФормаОбъект.ДействияСФормой = Перечисления.Лико_ДействияСФормой.Утилизировать;	
				КонецЕсли;
				СтараяФормаОбъект.Записать();
			КонецЕсли;
			// <-- Конец Лико Яцун С. В. 11.02.2026
			НоваяФорма = Лико_Дополнительно.СоздатьНовуюФорму(ПараметрыДляСозданияНовойФормы);
			ТекСтр.форма = НоваяФорма;
			//Необходимо записать значение в табличную часть "Формы"
			УдалитьСтрокиПоКлючуНаСервере(ТекСтр.КлючСтроки, "Формы", "КлючСтроки");  
			стрФ = Объект.Формы.Добавить();
			стрФ.Ключстроки = ТекСтр.ключстроки;
			стрФ.Значение = НоваяФорма;  
			стрФ.Цветоделение = Истина;
			
			КолСоздФорм = КолСоздФорм + 1;
		// --> Начало Лико Ефимов ЕВВ 05.06.2025
		ИначеЕсли Лико_Дополнительно.ЭтоСтрокаСплошнойФормы(ТекСтр) Тогда
			// Это сплошная форма
			РезультатФункции = Лико_Дополнительно.ПроверитьПодобратьСоздатьСплошнуюФорму(Объект, ТекСтр, ПараметрыДляСозданияНовойФормы);
			Если РезультатФункции.СозданаНоваяФорма Тогда
				КолСоздФорм = КолСоздФорм + 1;
			КонецЕсли;
			Если РезультатФункции.Модифицированность Тогда
				Модифицированность = Истина;
			КонецЕсли;
		// <-- Конец Лико Ефимов ЕВВ 05.06.2025
		ИначеЕсли ТекСтр.Цветоделение Тогда
			// Создаем остальные формы
			// код взят из процедуры ЦветаЦветоделениеПриИзменении и немного преобразован
			ВидПечати = ТекСтр.ВидСекции.ВидПечати;  
			Если ВидПечати = Справочники.Лико_ВидыПечати.Флексо 
				ИЛИ ВидПечати = Справочники.Лико_ВидыПечати.Трафарет
				ИЛИ ВидПечати = Справочники.Лико_ВидыПечати.Офсет 
				ИЛИ ТекСтр.ВидСекции.Родитель = Справочники.Лико_ВидыСекций.Глубокая Тогда 
				НоваяФорма = Лико_Дополнительно.СоздатьНовуюФорму(ПараметрыДляСозданияНовойФормы);
				ТекСтр.форма = НоваяФорма;
				//Необходимо записать значение в табличную часть "Формы"
				УдалитьСтрокиПоКлючуНаСервере(ТекСтр.КлючСтроки, "Формы", "КлючСтроки");  
				стрФ = Объект.Формы.Добавить();
				стрФ.Ключстроки = ТекСтр.ключстроки;
				стрФ.Значение = НоваяФорма;  
				стрФ.Цветоделение = Истина;
				
				КолСоздФорм = КолСоздФорм + 1;
			ИначеЕсли ВидПечати = Справочники.Лико_ВидыПечати.Цифровая Тогда
				Если ЦифроваяФормаОбработана Тогда
					// цифровая форма уже обработана, нет смысла еще раз проходить
					Продолжить;
				КонецЕсли;
				НоваяФорма = НайтиЦифровуюФормуПоЗаказу();
				Если Не ЗначениеЗаполнено(НоваяФорма) Тогда
					НоваяФорма = Лико_Дополнительно.СоздатьНовуюФорму(ПараметрыДляСозданияНовойФормы);
					КолСоздФорм = КолСоздФорм + 1;
				КонецЕсли;
				Для каждого стр из Объект.Цвета Цикл
					Если стр.ВидСекции = Справочники.Лико_ВидыСекций.Цифровая Тогда
						Если стр.форма <> НоваяФорма Тогда 
							стр.форма = НоваяФорма;
							УдалитьСтрокиПоКлючуНаСервере(стр.КлючСтроки, "Формы", "КлючСтроки");  
							стриндиго = Объект.Формы.добавить();
							стриндиго.КлючСтроки = стр.ключстроки;	
							стриндиго.Значение = НоваяФорма;
						КонецЕсли;	
					КонецЕсли;
				КонецЦикла;
				ЦифроваяФормаОбработана = Истина;
			КонецЕсли;
		КонецЕсли;
		// <-- Начало Лико Яцун С. В. 13.05.2025
		Если ЗначениеЗаполнено(ТекФорма) И ЗначениеЗаполнено(НоваяФорма) И ТекФорма <> НоваяФорма Тогда
			НСПеределкаФорм = ПеределкаФорм.Добавить(); 
			НСПеределкаФорм.СтараяФорма = ТекФорма;
			НСПеределкаФорм.НоваяФорма = НоваяФорма;
			МассивСтарыхФорм.Добавить(ТекФорма);
		КонецЕсли;
		НоваяФорма = Неопределено;
		// <-- Конец Лико Яцун С. В. 13.05.2025
	КонецЦикла;
	
	// <-- Начало Лико Яцун С. В. 14.05.2025
	//Предлагать замену старых форм в еще не выполненных заказах 
	Если МассивСтарыхФорм.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказКлиентаЦвета.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
		|ГДЕ
		|	ЗаказКлиентаЦвета.Ссылка.Проведен
		|	И НЕ ЗаказКлиентаЦвета.Ссылка.ПометкаУдаления
		|	И (ЗаказКлиентаЦвета.Ссылка.Состояние = ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаказов.ВключенВПлан)
		|			ИЛИ ЗаказКлиентаЦвета.Ссылка.Состояние = ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаказов.Выполняется))
		|	И ЗаказКлиентаЦвета.Форма В(&МассивСтарыхФорм)
		|	И НЕ ЗаказКлиентаЦвета.Цветоделение
		|	И ЗаказКлиентаЦвета.Ссылка <> &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		Запрос.УстановитьПараметр("МассивСтарыхФорм", МассивСтарыхФорм);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Количество() = 0 Тогда
			ПеределкаФорм.Очистить();
		КонецЕсли;
	КонецЕсли; 
	// <-- Конец Лико Яцун С. В. 14.05.2025
	
	Если КолСоздФорм <> 0 Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
	Сообщить("Создание форм завершено (" + КолСоздФорм + " шт.)");
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиПоКлючуНаСервере(КлючСтроки, ИмяТЧ, ИмяКолонки)  
	МассивСтрок = Объект[ИмяТЧ].НайтиСтроки(Новый Структура(ИмяКолонки, КлючСтроки));
	Для каждого ЭлементМассива Из МассивСтрок Цикл
		Объект[ИмяТЧ].Удалить(ЭлементМассива);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ЦветаДистортВидПолимераПриИзменении(Элемент)
	
	ТекСтрока = Элементы.Цвета.ТекущиеДанные;
	Если ТекСтрока.ДистортВидПолимера И ТекСтрока.Цветоделение Тогда
		ТекСтрока.ДистортВидПолимера = Ложь;
		Сообщить("Для данной строки уже установлен признак ""Цветоделение"". Установка сразу двух признаков запрещена");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КопироватьФормы(Команда)
	
	Если Объект.ВидЗаказа <> ПредопределенноеЗначение("Перечисление.Лико_ВидыЗаказов.НовыйССохранениемФорм") Тогда
		ПовторЗаказаНомер = ЗначениеРеквизита(Объект.ПовторЗаказа, "НомерБезПрефикса");
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаНомераЗаказаДляКопированияФорм",ЭтаФорма); 
		ПоказатьВводСтроки(ОписаниеОповещения,ПовторЗаказаНомер,"Введите номер заказа для копирования форм");
		Возврат;
	КонецЕсли;

	КопироватьФормыНаСервере();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаНомераЗаказаДляКопированияФорм(РезультатФормы, ПараметрыФормы) Экспорт
	
	Если РезультатФормы <> Неопределено И РезультатФормы <> "" Тогда
		КопироватьФормыНаСервере(РезультатФормы);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КопироватьФормыНаСервере(НомерЗаказаДляКопированияФорм = Неопределено)
	
	НомерЗаказаДляКопированияФормСсылка = Неопределено;
	Если НомерЗаказаДляКопированияФорм <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.НомерБезПрефикса = &НомерБезПрефикса
		|	И ЗаказКлиента.Дата >= ДАТАВРЕМЯ(2024, 1, 1, 0, 0, 0)";
		
		Запрос.УстановитьПараметр("НомерБезПрефикса", НомерЗаказаДляКопированияФорм);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НомерЗаказаДляКопированияФормСсылка = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЦикла;
	КонецЕсли;

	Если НомерЗаказаДляКопированияФормСсылка <> Неопределено ИЛИ НомерЗаказаДляКопированияФорм = Неопределено Тогда
		Лико_Планирование.КопироватьФормыНаСервере(Объект.Цвета, НомерЗаказаДляКопированияФормСсылка, Объект.ВидЗаказа);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявкуНаСплошныеФормы(Команда)

	ОчиститьСообщения();
	
	Если Модифицированность Тогда
		Сообщить("Необходимо записать форму заявки");
		Возврат;
	КонецЕсли; 
	
	МассивСплошныхСтрок = ПолучитьМассивСтрокСоСплошнымиЦветами();
	Если МассивСплошныхСтрок.Количество() > 0 Тогда
		ТекФизЛицо = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Пользователь, "ФизическоеЛицо");
		Для каждого Строка из МассивСплошныхСтрок Цикл
			ПараметрыДляСоздания = Новый Структура;
			ПараметрыДляСоздания.Вставить("Заказ", Объект.Ссылка);
			ПараметрыДляСоздания.Вставить("НомерПроката", Строка.НомерПроката);
			ПараметрыДляСоздания.Вставить("РабочийЦентр", Строка.РабочийЦентр);
			ПараметрыДляСоздания.Вставить("Оператор", ТекФизЛицо); 
			ПараметрыДляСоздания.Вставить("Причина", ПредопределенноеЗначение("Справочник.Лико_ПричиныЗаявокНаФормы.ЛаковаяФорма")); 
			ПараметрыДляСоздания.Вставить("МестоСозданияЗаявки", "ОбработкаЗаявок");
			ПараметрыДляСоздания.Вставить("МассивОтмеченныхФорм", Строка.МассивОтмеченныхФорм);
			ПараметрыДляСоздания.Вставить("МассивФорм", Строка.МассивОтмеченныхФорм);
			
			ОписаниеОповещенияПриЗакрытииДругойФормы = Новый ОписаниеОповещения("ВыбраныФормыДляЗаявкиФормщику", ЭтотОбъект, ПараметрыДляСоздания);
			ОткрытьФорму("Документ.ТС_ЗаявкаНаРемонтРабочихЦентров.Форма.ФормаВыбораЦветовДляЗаявкиНаФормы", ПараметрыДляСоздания, ЭтаФорма,,,,ОписаниеОповещенияПриЗакрытииДругойФормы, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЦикла;
	Иначе
		Сообщить("В таблице цветов нет сплошных форм");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивСтрокСоСплошнымиЦветами()
	
	ТаблицаСтрок = Объект.Цвета.Выгрузить(, "НомерПроката,Форма");
	ТаблицаСтрок.Очистить();
	
	Для каждого Строка из Объект.Цвета Цикл
		Если ЗначениеЗаполнено(Строка.Форма) И Лико_Дополнительно.ЭтоСтрокаСплошнойФормы(Строка) Тогда
			НоваяСтрока = ТаблицаСтрок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаСвернута = ТаблицаСтрок.Скопировать();
	ТаблицаСвернута.Свернуть("НомерПроката");
	МассивСтрок = Новый Массив;
	Для каждого Строка из ТаблицаСвернута Цикл
		СтруктураСтрока = Новый Структура("НомерПроката", Строка.НомерПроката);
		СплошныеСтроки = ТаблицаСтрок.НайтиСтроки(СтруктураСтрока);
		СтруктураСтрока.Вставить("РабочийЦентр", НайтиРЦПоЗаказуИНомеруПроката(Объект.Ссылка, Строка.НомерПроката));
		СтруктураСтрока.Вставить("МассивОтмеченныхФорм", Новый Массив);
		Для каждого Строка из СплошныеСтроки Цикл
			СтруктураСтрока.МассивОтмеченныхФорм.Добавить(Строка.Форма);
		КонецЦикла;
		МассивСтрок.Добавить(СтруктураСтрока);
	КонецЦикла;
	
	Возврат МассивСтрок;
	
КонецФункции

&НаКлиенте
Процедура ВыбраныФормыДляЗаявкиФормщику(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ Результат.МассивСтрок.Количество() = 0 Тогда
		Сообщить("Не выбраны цвета для заказа форм");
		Возврат;
	КонецЕсли;
	
	ДопПараметры.Вставить("Причина", Результат.Причина);
	ДопПараметры.Вставить("Комментарий", Результат.Комментарий);
	ДопПараметры.Вставить("Площадка", Результат.Площадка);
	
	СоздатьЗаявкуНаФормы(Результат.МассивСтрок, ДопПараметры);

КонецПроцедуры

&НаСервере
Процедура СоздатьЗаявкуНаФормы(МассивСтрок, ДопПараметры)
	
	ИнформационныеСообщения = "";
	
	ИмяФайла = ПолучитьИмяВременногоФайла();
	ВнОбработка = Лико_Дополнительно.НайтиДополнительнуюОбработкуПоИмениОбъекта("ТСРабочийСтолЕРП");
	Если НЕ ЗначениеЗаполнено(ВнОбработка) Тогда
		Сообщить("Не найдена дополнительная обработка с именем объекта ТСРабочийСтолЕРП");
		Возврат;
	КонецЕсли;
	ДвоичныеДанные = ВнОбработка.ХранилищеОбработки.Получить();
	ДвоичныеДанные.Записать(ИмяФайла);
	ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь); 
	ВнешняяОбработка.СоздатьЗаявкуНаФормы(ДопПараметры, МассивСтрок, ИнформационныеСообщения,,,Истина); 
	Если ЗначениеЗаполнено(ИнформационныеСообщения) Тогда
		Сообщить(ИнформационныеСообщения);
	КонецЕсли;
	
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
	КонецПопытки;
	
КонецПроцедуры
