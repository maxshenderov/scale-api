Процедура ПроверитьСоздатьПодменюФорматаДляСкрипта(НомерМонтажа)
	
	ПрефиксИмени = "ФорматДляСкрипта";
	ИмяКнопки=ПрефиксИмени+НомерМонтажа;
	
	Если Элементы.Найти(ИмяКнопки)=Неопределено Тогда
		
		// добавим саму кнопку монтажа
		
		КомандаФормы  = Команды.Добавить(ИмяКнопки);
		КомандаФормы.Действие = "ПодменюФорматДляСкриптаНажатие";
		Элементы.Добавить(ИмяКнопки,Тип("КнопкаФормы"), Элементы.ФорматДляСкрипта); 
		Элементы[ИмяКнопки].Заголовок = НомерМонтажа;
		Элементы[ИмяКнопки].ИмяКоманды = ИмяКнопки;
		
		///Элементы.Переместить(Элементы[ИмяКнопки],ЭтаФорма.КоманднаяПанель,Элементы.ФорматДляСкрипта); 
	КонецЕсли;
	
	
КонецПроцедуры 	


&НаКлиенте
Процедура ПечатьМонтажа(НомерМонтажа) //+Лико m.shenderov 12/11/2019
	Отказ = Ложь;
	ТекстСкрипта = Лико_Дополнительно.СформироватьТекстДляСкрипта(Объект.Ссылка, НомерМонтажа, Отказ);
	
	Если Отказ Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось сформировать формат для скрипта!";
		Сообщение.Сообщить();
		
	Иначе
		ТекстДок = Новый ТекстовыйДокумент;
		ТекстДок.ДобавитьСтроку(ТекстСкрипта);
		
		ТекстДок.Показать();
	КонецЕсли;
	
	
