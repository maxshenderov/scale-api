&НаСервере 
Функция НайтиЦифровуюФормуПоЗаказу()
	
	// --> Начало Лико Ефимов ЕВВ 13.09.2024
	//НоваяФорма = Справочники.Лико_Формы.НайтиПоРеквизиту("Заказ", Объект.ссылка);
	// цифровую форму нужно искать не только по заказу, но и по виду секции
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_Формы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Лико_Формы КАК Лико_Формы
		|ГДЕ
		|	НЕ Лико_Формы.ПометкаУдаления
		|	И Лико_Формы.Заказ = &Заказ
		|	И Лико_Формы.ВидСекции = &ВидСекции";
	
	Запрос.УстановитьПараметр("ВидСекции", Справочники.Лико_ВидыСекций.Цифровая);
	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Ссылка) Тогда
		НоваяФорма = Выборка.Ссылка;
	Иначе
		НоваяФорма = Неопределено;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 13.09.2024

	Возврат НоваяФорма;
КонецФункции	

