//Цвета
&НаКлиенте
Процедура Утвердить(Команда)
	Если  Команда.имя = "УтвердитьЦвета" Тогда 
		СписокНеЦифровыхФорм = Новый СписокЗначений;
		Для каждого стр из объект.Цвета цикл  
			Если НЕ ЗначениеЗаполнено(стр.РабочийЦентр) Тогда
				СтрШ = СтрШаблон("Не заполнен Рабочий Центр в строке %1. Цвета не утверждены. Для исправления перезаполните Номер проката в строке %1", стр.НомерСтроки);
				Сообщить(СтрШ);
				Отказ = Истина;
				Возврат;
			КонецЕсли; 
			//В заказе не может быть одинаковых форм если они не цифровые
			Если ЗначениеЗаполнено(Стр.Форма)
				И Стр.ВидСекции <> ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Цифровая") 
				// --> Начало Лико Ефимов ЕВВ 18.06.2025
				// Сплошные тоже не проверяем
				И НЕ Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Стр.Форма, "Сплошная")
				// <-- Конец Лико Ефимов ЕВВ 18.06.2025
				Тогда
				Если СписокНеЦифровыхФорм.НайтиПоЗначению(Стр.Форма) = Неопределено Тогда
					СписокНеЦифровыхФорм.Добавить(Стр.Форма);
				Иначе
					СтрШ = СтрШаблон("Дублируется номер формы %1 в строке %2. Цвета не утверждены",ЗначениеРеквизита(Стр.Форма, "Код"),стр.НомерСтроки);
					Сообщить(СтрШ);
					Отказ = Истина;
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Объект.УтвердилЦвета = ПользователиКлиентСервер.ТекущийПользователь(); 
		Объект.ДатаУтвержденияЦветов = ТекущаяДата();
		УтверждениеЦветов();
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьУтверждение(Команда)
	Если  Команда.имя = "ОтменитьУтверждениеЦветов" Тогда 
		Объект.УтвердилЦвета = ПользователиКлиентСервер.ТекущийПользователь(); 
		Объект.ДатаУтвержденияЦветов =Дата(1,1,1);
		УтверждениеЦветов();
	КонецЕсли;			
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЦМИК(Команда)
	
	ТекСтр = Элементы.Цвета.ТекущиеДанные;
	Если ТекСтр <> Неопределено Тогда
		ТекСтр.ТипЦвета1 = ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.C");
		ВидСекции = ТекСтр.ВидСекции;
		НомерПроката = ТекСтр.НомерПроката;
		Нстр = Объект.Цвета.Добавить();
		Нстр.НомерПроката = НомерПроката;
		КлючСтроки = Новый УникальныйИдентификатор;
		Нстр.КлючСтроки = КлючСтроки;
		Нстр.ВидСекции = ВидСекции;
		Нстр.ТипЦвета1 = ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.M");
		Нстр = Объект.Цвета.Добавить();
		Нстр.НомерПроката = НомерПроката;
		КлючСтроки = Новый УникальныйИдентификатор;
		Нстр.КлючСтроки = КлючСтроки;
		Нстр.ВидСекции = ВидСекции;
		Нстр.ТипЦвета1 = ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.Y");
		Нстр = Объект.Цвета.Добавить();
		Нстр.НомерПроката = НомерПроката;
		КлючСтроки = Новый УникальныйИдентификатор;
		НСтр.КлючСтроки = КлючСтроки;
		Нстр.ВидСекции = ВидСекции;
		Нстр.ТипЦвета1 = ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.K");
	Иначе
		Сообщить("Укажите первую строку и заполните в ней Вид работ!");
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДистортФлексоВФормы()
	
	Для Каждого Стр Из Объект.Цвета Цикл
		Если ЗначениеЗаполнено(Стр.ДистортФлексо) И Стр.Форма.ДистортФлексо <> Стр.ДистортФлексо Тогда
			ФормаОбъект = Стр.Форма.ПолучитьОбъект();
			ФормаОбъект.ДистортФлексо = Стр.ДистортФлексо;
			ФормаОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦветаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.Цвета.ТекущиеДанные;
	
	Если НоваяСтрока Тогда
		КлючСтроки = Новый УникальныйИдентификатор;
		ТекущиеДанные.КлючСтроки = КлючСтроки;
		ТекущиеДанные.номерпроката =1;
		
		Если Копирование И ТекущиеДанные.ВидСекции <> ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Цифровая") Тогда
			ТекущиеДанные.Форма = Неопределено;
		КонецЕсли;
		
		Для каждого Стр Из Объект.Цвета Цикл
			Если Стр.НомерПроката = ТекущиеДанные.номерпроката И ЗначениеЗаполнено(Стр.РабочийЦентр)Тогда
				ТекущиеДанные.РабочийЦентр = Стр.РабочийЦентр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры


&НаКлиенте
Процедура ЦветаПередУдалением(Элемент, Отказ)
	ТекущиеДанные = Элементы.Цвета.ТекущиеДанные;
	УдалитьСписокЗначений("Формы", ТекущиеДанные.КлючСтроки);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСписокЗначений(ИмяТЧ, КлючСтроки);
	НайденныеСтроки = Объект[ИмяТЧ].НайтиСтроки(Новый Структура("КлючСтроки", КлючСтроки));	
	Для Каждого Строка из НайденныеСтроки Цикл	
		Объект[ИмяТЧ].Удалить(Строка);		
	КонецЦикла;
КонецПроцедуры


&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	НайденныеСтроки = Объект.Цветоделение.НайтиСтроки(Новый Структура("КлючСтроки", Идентификатор));	
	Для каждого Стр Из НайденныеСтроки Цикл
		Если Стр.Переделка > 0 И Объект.Дата > Дата('2024.06.05 00:00:01') И НЕ ЗначениеЗаполнено(Стр.ИнициаторПеределки) Тогда
			Отказ = Истина;
			Сообщить("Не заполнен Инициатор переделки");
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Объект.ДатаОтправкиВРаботу) Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.ДатаУтвержденияЦветов) Тогда 
			Сообщить("Цвета не утверждены");
			Отказ = Истина;
			Возврат;
		КонецЕсли;  
		
	КонецЕсли;
	
	ЗаполнитьДистортФлексоВФормы();
			
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ЗначениеЗаполнено(Идентификатор) Тогда 
		Элементы.Цветоделение.ОтборСтрок = Новый ФиксированнаяСтруктура("КлючСтроки", Идентификатор);
		Отбор =Новый Структура("КлючСтроки", Идентификатор);	
		стр = Объект.Цветоделение.НайтиСтроки(Отбор)[0] ;
		Если ЗначениеЗаполнено(стр.Версия) Тогда 
			Версия = стр.Версия;
		Иначе
			Версия = Объект.Версия;
		КонецЕсли;	
	КонецЕсли;
	СформироватьПодменюФорматаДляСкрипта();	
КонецПроцедуры

&НаКлиенте
Процедура ЦветоделениеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.Цветоделение.ТекущиеДанные;
	
	Если НоваяСтрока Тогда
		КлючСтроки = Новый УникальныйИдентификатор;
		ТекущиеДанные.КлючСтроки = КлючСтроки;
	КонецЕсли;	
КонецПроцедуры


&НаКлиенте
Процедура ЦветаЦветоделениеПриИзменении(Элемент)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Сообщить("Сначала необходимо записать заказ!");
		Возврат
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.НомерБезПрефикса) Тогда 
		Сообщить("Не установлен номер заказа");
		Возврат
	КонецЕсли; 
	
	// --> Начало Лико Ефимов ЕВВ 24.07.2024
	ТекСтрока = Элементы.Цвета.ТекущиеДанные;
	Если ТекСтрока.ДистортВидПолимера И ТекСтрока.Цветоделение Тогда
		ТекСтрока.Цветоделение = Ложь;
		Сообщить("Для данной строки уже установлен признак ""Дисторт вид полимера"". Установка сразу двух признаков запрещена");
		Возврат;
	КонецЕсли;
	
	Если Лико_Дополнительно.НовыйМеханизмСозданияФорм(ЗначениеРеквизита(Объект.Площадка, "Организация"), ТекущаяДата()) Тогда
		Возврат;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 24.07.2024
	
	ТекСтр = Элементы.Цвета.ТекущиеДанные;
	ВидПечати = ЗначениеРеквизита(ТекСтр.ВидСекции, "ВидПечати");  
	ЗаменаЦГ = Ложь;
	Если ТекСтр.Цветоделение = Истина Тогда
		Если ЗначениеЗаполнено(ТекСтр.ВидСекции)  Тогда
			// <-- Начало Лико Яцун С. В. 02.12.2025 
			Если Объект.Площадка = ГлЛико_Площадки.Сибирь 
				И ЭтоЦМИК(ТекСтр.типцвета1) 
				И ЗначениеЗаполнено(ТекСтр.типкраски) 
				И ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Флексо")
				И СокрЛП(ЗначениеРеквизита(ТекСтр.типкраски,"Код")) <> "3081" Тогда
				ЗаменаЦГ = Истина;
				ТекСтр.Цветоделение = Ложь;
			Иначе	
				СоздатьФорму(ТекСтр,ЗаменаЦГ,Ложь);
			КонецЕсли;
			Если ЗаменаЦГ И НЕ ТекСтр.типцвета1 = ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.K") Тогда
				Для каждого СтрЦМИК Из Объект.Цвета Цикл
					Если ЭтоЦМИК(СтрЦМИК.типцвета1) 
						И ЗначениеЗаполнено(СтрЦМИК.типкраски) 
						И ЗначениеРеквизита(СтрЦМИК.ВидСекции, "ВидПечати") = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Флексо")
						И СокрЛП(ЗначениеРеквизита(СтрЦМИК.типкраски,"Код")) <> "3081" Тогда
						СтрЦМИК.Цветоделение = Истина;
						СоздатьФорму(СтрЦМИК,ЗаменаЦГ,Истина);	
					КонецЕсли;
				КонецЦикла;
			ИначеЕсли ЗаменаЦГ И ТекСтр.типцвета1 = ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.K") Тогда
				СоздатьФорму(ТекСтр,ЗаменаЦГ,Ложь);	
			КонецЕсли;
			// <-- Конец Лико Яцун С. В. 02.12.2025
		Иначе 
			Сообщить("Укажите вид печати для данной строки!");
			ТекСтр.Цветоделение  = Ложь;
		КонецЕсли;
		//Если ТекСтрока.ВидПечати = Перечисления.Лико_ВидыПечати.Флексо  Тогда 
		//	МассивСтрок = Формы.НайтиСтроки(Новый Структура("Раздел",  ТекСтрока.КлючСтроки));
		//	Для каждого ЭлементМассива Из МассивСтрок Цикл
		//		ЭлементМассива.Цветоделение = ТекСтрока.Цветоделение;
		//	КонецЦикла;
		//КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОСозданииНовойФормы(Результат, ДопПараметры)  Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда 
		
		Если НЕ ДопПараметры.Свойство("ЗаменаЦГТипК") Тогда
			текстр = Объект.Цвета.НайтиПоИдентификатору(ДопПараметры.Идентификатор);
			ПараметрыДляСозданияНовойФормы = Новый Структура(СтрокаСтандартныхПараметровДляСозданияНовойФормы);
			ЗаполнитьЗначенияСвойств(ПараметрыДляСозданияНовойФормы, ЭтаФорма);
			ЗаполнитьЗначенияСвойств(ПараметрыДляСозданияНовойФормы, Объект);
			ЗаполнитьЗначенияСвойств(ПараметрыДляСозданияНовойФормы, ТекСтр);
			НоваяФорма = Лико_Дополнительно.СоздатьНовуюФорму(ПараметрыДляСозданияНовойФормы);
			текстр.форма = НоваяФорма;
			//Необходимо записать значение в табличную часть "Формы"
			УдалитьСтрокиПоКлючу(текстр.КлючСтроки,"Формы","КлючСтроки");  
			стрФ = Объект.Формы.Добавить();
			стрФ.Ключстроки = текстр.ключстроки;
			стрФ.Значение = НоваяФорма;  
			стрФ.Цветоделение = Истина;	
			// <-- Начало Лико Яцун С. В. 02.12.2025 
		КонецЕсли;
		Если ДопПараметры.Свойство("ЗаменаЦГТипК") Тогда
			Для каждого СтрЦМИК Из Объект.Цвета Цикл
				Если ЭтоЦМИК(СтрЦМИК.типцвета1) 
					И ЗначениеЗаполнено(СтрЦМИК.типкраски) 
					И ЗначениеРеквизита(СтрЦМИК.ВидСекции, "ВидПечати") = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Флексо")
					И СокрЛП(ЗначениеРеквизита(СтрЦМИК.типкраски,"Код")) <> "3081" Тогда
					СтрЦМИК.Цветоделение = Истина;
					СтрЦМИК.типкраски = ПолучитьЦГПоКоду("3081");
					ДопПараметры = Новый Структура;
					ДопПараметры.Вставить("Идентификатор", СтрЦМИК.ПолучитьИдентификатор());
					ПослеЗакрытияВопросаОСозданииНовойФормы(КодВозвратаДиалога.Да, ДопПараметры);	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли Результат = КодВозвратаДиалога.Нет И ДопПараметры.Свойство("ЗаменаЦГТипК") Тогда
		текстр = Объект.Цвета.НайтиПоИдентификатору(ДопПараметры.Идентификатор);
		текстр.Цветоделение = Истина;
		текстр.типкраски = ПолучитьЦГПоКоду("3081");
		ПараметрыДляСозданияНовойФормы = Новый Структура(СтрокаСтандартныхПараметровДляСозданияНовойФормы);
		ЗаполнитьЗначенияСвойств(ПараметрыДляСозданияНовойФормы, ЭтаФорма);
		ЗаполнитьЗначенияСвойств(ПараметрыДляСозданияНовойФормы, Объект);
		ЗаполнитьЗначенияСвойств(ПараметрыДляСозданияНовойФормы, ТекСтр);
		НоваяФорма = Лико_Дополнительно.СоздатьНовуюФорму(ПараметрыДляСозданияНовойФормы);
		текстр.форма = НоваяФорма;
		//Необходимо записать значение в табличную часть "Формы"
		УдалитьСтрокиПоКлючу(текстр.КлючСтроки,"Формы","КлючСтроки");  
		стрФ = Объект.Формы.Добавить();
		стрФ.Ключстроки = текстр.ключстроки;
		стрФ.Значение = НоваяФорма;  
		стрФ.Цветоделение = Истина;	
	ИначеЕсли Результат = КодВозвратаДиалога.Отмена И ДопПараметры.Свойство("ЗаменаЦГТипК") Тогда	
		текстр = Объект.Цвета.НайтиПоИдентификатору(ДопПараметры.Идентификатор);
		текстр.Цветоделение = Истина;
		// <-- Конец Лико Яцун С. В. 02.12.2025
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура СоздатьФорму(ТекСтр,ЗаменаЦГ,ЗаменаКомплектаЦМИК)
	
	ПараметрыДляСозданияНовойФормы = Новый Структура(СтрокаСтандартныхПараметровДляСозданияНовойФормы);
	ЗаполнитьЗначенияСвойств(ПараметрыДляСозданияНовойФормы, ЭтаФорма);
	ЗаполнитьЗначенияСвойств(ПараметрыДляСозданияНовойФормы, Объект);
	ЗаполнитьЗначенияСвойств(ПараметрыДляСозданияНовойФормы, ТекСтр);

	ВидПечати = ЗначениеРеквизита(ТекСтр.ВидСекции, "ВидПечати");
	
	Если  (Объект.Площадка = ГлЛико_Площадки.Урал ИЛИ Объект.Площадка = ГлЛико_Площадки.Сибирь) И ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Флексо") Тогда	
		Если ЗначениеЗаполнено(ТекСтр.форма) И НЕ ЗаменаЦГ Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Идентификатор", текстр.ПолучитьИдентификатор() );
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОСозданииНовойФормы", ЭтаФорма,ДопПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Создать новый элемент справочника Формы?'"), Режим,0);	
			// <-- Начало Лико Яцун С. В. 02.12.2025	
		ИначеЕсли ЗаменаЦГ И ТекСтр.типцвета1 = ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.K") И НЕ ЗаменаКомплектаЦМИК Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Идентификатор", текстр.ПолучитьИдентификатор() );
			ДопПараметры.Вставить("ЗаменаЦГТипК", ЗаменаЦГ);
			Режим = РежимДиалогаВопрос.ДаНетОтмена;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОСозданииНовойФормы", ЭтаФорма,ДопПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Если форма К используется для печати растра, необходимо перевывести весь комплект СМУК. Перевывести комплект?'"), Режим,0);
			// <-- Конец Лико Яцун С. В. 02.12.2025
		Иначе   
			Если ЗаменаЦГ Тогда
				ТекСтр.типкраски = ПолучитьЦГПоКоду("3081");
			КонецЕсли;
			НоваяФорма = Лико_Дополнительно.СоздатьНовуюФорму(ПараметрыДляСозданияНовойФормы);
			текстр.форма = НоваяФорма;
			//Необходимо записать значение в табличную часть "Формы"
			УдалитьСтрокиПоКлючу(текстр.КлючСтроки,"Формы","КлючСтроки");  
			стрФ = Объект.Формы.Добавить();
			стрФ.Ключстроки = текстр.ключстроки;
			стрФ.Значение = НоваяФорма;  
			стрФ.Цветоделение = Истина;	
		КонецЕсли;
	ИначеЕсли ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Флексо") ИЛИ  ВидПечати =  ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Трафарет")  ИЛИ  ВидПечати =  ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Офсет") 
		ИЛИ ЗначениеРеквизита(ТекСтр.ВидСекции,"Родитель") = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Глубокая") Тогда 
		ДатаГлубокихФорм = ЗначениеРеквизита(ПредопределенноеЗначение("Справочник.Лико_ПредопределенныеЗначения.ДатаГлубокихФорм"),"ЗначениеПараметра");
		Если (ЗначениеЗаполнено(ДатаГлубокихФорм) И ДатаГлубокихФорм < ТекущаяДата() И ЗначениеРеквизита(ТекСтр.ВидСекции,"Родитель") = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Глубокая"))
			ИЛИ ЗначениеРеквизита(ТекСтр.ВидСекции,"Родитель") <> ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Глубокая") Тогда 
			НоваяФорма = Лико_Дополнительно.СоздатьНовуюФорму(ПараметрыДляСозданияНовойФормы);
			текстр.форма = НоваяФорма;
			//Необходимо записать значение в табличную часть "Формы"
			УдалитьСтрокиПоКлючу(текстр.КлючСтроки,"Формы","КлючСтроки");  
			стрФ = Объект.Формы.Добавить();
			стрФ.Ключстроки = текстр.ключстроки;
			стрФ.Значение = НоваяФорма;  
			стрФ.Цветоделение = Истина;
		КонецЕсли;
	КонецЕсли;
	Если ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Цифровая") И Не Объект.Площадка = ГлЛико_Площадки.Урал Тогда	 
		//Проверим, есть ли уже форма для этого заказа
		НоваяФорма = НайтиЦифровуюФормуПоЗаказу();
		Если Не ЗначениеЗаполнено(НоваяФорма)  Тогда
			НоваяФорма = Лико_Дополнительно.СоздатьНовуюФорму(ПараметрыДляСозданияНовойФормы);
		КонецЕсли;
		Для каждого стр из Объект.Цвета Цикл
			Если стр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Цифровая") Тогда
				Если стр.форма <> НоваяФорма Тогда 
					стр.форма = НоваяФорма;
					УдалитьСтрокиПоКлючу(стр.КлючСтроки,"Формы","КлючСтроки");  
					стриндиго = Объект.Формы.добавить();
					стриндиго.КлючСтроки = стр.ключстроки;	
					стриндиго.Значение = НоваяФорма;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла	
	КонецЕсли;					

КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокиПоКлючу(КлючСтроки, ИмяТЧ, ИмяКолонки)  
	МассивСтрок =Объект[ИмяТЧ].НайтиСтроки(Новый Структура(ИмяКолонки,  КлючСтроки));
	Для каждого ЭлементМассива Из МассивСтрок Цикл
		Объект[ИмяТЧ].Удалить(ЭлементМассива);
	КонецЦикла;	
КонецПроцедуры

&НаСервереБезКонтекста 
Функция ЭтоЦМИК(ТипЦвета) 
	
	ЭтоЦМИК = ТипЦвета = Справочники.Лико_ТипыЦвета.C 
		ИЛИ ТипЦвета = Справочники.Лико_ТипыЦвета.M 
		ИЛИ ТипЦвета = Справочники.Лико_ТипыЦвета.Y 
		ИЛИ ТипЦвета = Справочники.Лико_ТипыЦвета.K;
	
	Возврат ЭтоЦМИК 	
	
