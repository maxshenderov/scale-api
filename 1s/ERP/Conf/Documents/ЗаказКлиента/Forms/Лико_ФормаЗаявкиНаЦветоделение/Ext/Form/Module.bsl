&НаСервере
Процедура УтверждениеЦветов()
	
	Если ЗначениеЗаполнено(Объект.ДатаУтвержденияЦветов) Тогда 
		//Проверяем, есть ли кнопка утверждения и убираем ее
		Элем = Элементы.Найти("УтвердитьЦвета");
		Если Элем <> Неопределено Тогда 
			Элементы.Удалить(Элем);
		КонецЕсли;	
		
		ОтменитьУтверждениеРабот=Элементы.Добавить("ОтменитьУтверждениеЦветов", Тип("КнопкаФормы"), Элементы.ГруппаЦветаКП);
		ОтменитьУтверждениеРабот.Заголовок="Утвердил: "+  Объект.УтвердилЦвета.Наименование+ " "+Строка(Объект.ДатаУтвержденияЦветов);
		ОтменитьУтверждениеРабот.ИмяКоманды="ОтменитьУтверждениеЦветов";
		ОтменитьУтверждениеРабот.Отображение = ОтображениеКнопки.КартинкаИТекст;
		ОтменитьУтверждениеРабот.Картинка = БиблиотекаКартинок.ОтметитьОперациюВыполненной;
		
		//Устанавливаем запрет на изменение работ
		Элементы.Цвета.ТолькоПросмотр = Истина;
		Элементы.ЦветаДобавитьЦМИК.Доступность = Ложь;
		Элементы.ГруппаСозданияФорм.Доступность = Ложь;
		
	Иначе
		Элем = Элементы.Найти("ОтменитьУтверждениеЦветов");
		Если Элем <> Неопределено Тогда 
			Элементы.Удалить(Элем);
		КонецЕсли;	
		УтвердитьРаботы=Элементы.Добавить("УтвердитьЦвета", Тип("КнопкаФормы"), Элементы.ГруппаЦветаКП);
		УтвердитьРаботы.Заголовок="Утвердить";
		УтвердитьРаботы.ИмяКоманды="УтвердитьЦвета";
		УтвердитьРаботы.Картинка = БиблиотекаКартинок.Успешно;
		Элементы.Цвета.ТолькоПросмотр = Ложь;
		Элементы.ЦветаДобавитьЦМИК.Доступность = Истина;
		Элементы.ГруппаСозданияФорм.Доступность = Истина;
		
	КонецЕсли;	
	
КонецПроцедуры

//&НаСервере
Функция  ПолучитьКоличествоНаименований()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиентаТовары.Номенклатура) КАК КоличествоНаименований
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ";
	Запрос.УстановитьПараметр("Заказ", Объект.ссылка);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Возврат Результат.КоличествоНаименований;
КонецФункции

Функция ПолучитьКоличествоЦветов(ВидСекции)
	
	КоличествоСекций = 0;
	Для каждого стр из Объект.Цвета Цикл
		Если стр.видсекции.видпечати = Видсекции
			И  (стр.Цветоделение
				ИЛИ стр.перегравировка
				ИЛИ стр.ДистортВидПолимера // --> Начало Лико Ефимов ЕВВ 01.08.2024
		) Тогда 
			КоличествоСекций = КоличествоСекций +1;
		КонецЕсли;		
	КонецЦикла;
	Возврат КоличествоСекций;
	
КонецФункции

Функция ПолучитьКоличествоРабот(ВидРаботы)
	
	КоличествоРабот = 0;
	
	Для Каждого стр из Объект.ВидыРабот Цикл
		Если  стр.ВидРабот.Родитель = ВидРаботы Тогда 
			Если стр.ВидРабот <> Справочники.видыРаботсотрудников.ХолодноеТиснение Тогда 
				КоличествоРабот = КоличествоРабот + 1;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	   
	
	Возврат КоличествоРабот
	
КонецФункции


