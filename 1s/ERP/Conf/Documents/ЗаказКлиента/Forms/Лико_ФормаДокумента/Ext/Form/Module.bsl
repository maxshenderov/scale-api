Процедура ЗаполнитьТипЗаливка() 
	
	Для каждого стр из Объект.Цвета Цикл
		Если стр.ВидТМЦ = Справочники.Лико_ВидыТМЦ.Краска Тогда
			стр.ТипЗаливка = стр.Типцвета1;
		ИначеЕсли  стр.ВидТМЦ = Справочники.Лико_ВидыТМЦ.Лак или стр.ВидТМЦ = Справочники.Лико_ВидыТМЦ.Праймер или стр.ВидТМЦ = Справочники.Лико_ВидыТМЦ.Клей или стр.ВидТМЦ = Справочники.Лико_ВидыТМЦ.БесцветнаяМасса  Тогда
			стр.ТипЗаливка = стр.ВидЗаливки;
		КонецЕсли;  
		
		Если ЗначениеЗаполнено(стр.Материал) Тогда 
			стр.КодМатериала = стр.Материал.Код;
		КонецЕсли;

	КонецЦикла;

	
КонецПроцедуры

Процедура ЗаполнитьВидОснастка() 
	
	Для каждого стр из Объект.Цвета Цикл
		Если ЗначениеЗаполнено(стр.Оснастка) Тогда
			стр.ВидОснастка = стр.Оснастка;
		ИначеЕсли ЗначениеЗаполнено(стр.ВидТМЦ) Тогда
			стр.ВидОснастка = стр.ВидТМЦ;
		ИначеЕсли Стр.ВидСекции.Оснастка Тогда
			стр.ВидОснастка = Справочники.Номенклатура.ПустаяСсылка();
		КонецЕсли;  
	КонецЦикла;
	
