&НаКлиенте
Процедура СоздатьФорму(ТекСтр,ЗаменаЦГ,ЗаменаКомплектаЦМИК)
	
	ВидПечати = ЗначениеРеквизита(ТекСтр.ВидСекции, "ВидПечати"); 
	
	Если  (Объект.Площадка = ГлЛико_Площадки.Урал ИЛИ Объект.Площадка = ГлЛико_Площадки.Сибирь) И ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Флексо") Тогда	
		Если ЗначениеЗаполнено(ТекСтр.форма) И НЕ ЗаменаЦГ Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Идентификатор", текстр.ПолучитьИдентификатор() );
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОСозданииНовойФормы", ЭтаФорма,ДопПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Создать новый элемент справочника Формы?'"), Режим,0);
			// <-- Начало Лико Яцун С. В. 02.12.2025	
		ИначеЕсли ЗаменаЦГ И ТекСтр.типцвета1 = ПредопределенноеЗначение("Справочник.Лико_ТипыЦвета.K") И НЕ ЗаменаКомплектаЦМИК Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Идентификатор", текстр.ПолучитьИдентификатор() );
			ДопПараметры.Вставить("ЗаменаЦГТипК", ЗаменаЦГ);
			Режим = РежимДиалогаВопрос.ДаНетОтмена;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОСозданииНовойФормы", ЭтаФорма,ДопПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Если форма К используется для печати растра, необходимо перевывести весь комплект СМУК. Перевывести комплект?'"), Режим,0);
			// <-- Конец Лико Яцун С. В. 02.12.2025
		Иначе
			Если ЗаменаЦГ Тогда
				ТекСтр.типкраски = ПолучитьЦГПоКоду("3081");
			КонецЕсли;
			НоваяФорма = СоздатьНовуюФорму(ТекСтр.ВидСекции, ТекСтр.типцвета1, ТекСтр.типкраски, ТекСтр.название);
			текстр.форма = НоваяФорма;
			//Необходимо записать значение в табличную часть "Формы"
			УдалитьСтрокиПоКлючу(текстр.КлючСтроки,"Формы","КлючСтроки");  
			стрФ = Объект.Формы.Добавить();
			стрФ.Ключстроки = текстр.ключстроки;
			стрФ.Значение = НоваяФорма;  
			стрФ.Цветоделение = Истина;	
		КонецЕсли;
	ИначеЕсли ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Флексо") ИЛИ  ВидПечати =  ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Трафарет")  ИЛИ  ВидПечати =  ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Офсет") 
		ИЛИ ЗначениеРеквизита(ТекСтр.ВидСекции,"Родитель") = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Глубокая") Тогда 
		ДатаГлубокихФорм = ЗначениеРеквизита(ПредопределенноеЗначение("Справочник.Лико_ПредопределенныеЗначения.ДатаГлубокихФорм"),"ЗначениеПараметра");
		Если (ЗначениеЗаполнено(ДатаГлубокихФорм) И ДатаГлубокихФорм < ТекущаяДата() И ЗначениеРеквизита(ТекСтр.ВидСекции,"Родитель") = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Глубокая"))
			ИЛИ ЗначениеРеквизита(ТекСтр.ВидСекции,"Родитель") <> ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Глубокая") Тогда
			НоваяФорма = СоздатьНовуюФорму(ТекСтр.ВидСекции, ТекСтр.типцвета1, ТекСтр.типкраски, ТекСтр.название);
			текстр.форма = НоваяФорма;
			//Необходимо записать значение в табличную часть "Формы"
			УдалитьСтрокиПоКлючу(текстр.КлючСтроки,"Формы","КлючСтроки");  
			стрФ = Объект.Формы.Добавить();
			стрФ.Ключстроки = текстр.ключстроки;
			стрФ.Значение = НоваяФорма;  
			стрФ.Цветоделение = Истина;
		КонецЕсли;	
	КонецЕсли;
	Если ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Цифровая") И Не Объект.Площадка = ГлЛико_Площадки.Урал Тогда	 
		//Проверим, есть ли уже форма для этого заказа
		НоваяФорма = НайтиЦифровуюФормуПоЗаказу();
		Если Не ЗначениеЗаполнено(НоваяФорма)  Тогда
			НоваяФорма = СоздатьНовуюФорму(ТекСтр.ВидСекции, ТекСтр.типцвета1, ТекСтр.типкраски, ТекСтр.название);
		КонецЕсли;
		Для каждого стр из Объект.Цвета Цикл
			Если стр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Цифровая") Тогда
				Если стр.форма <> НоваяФорма Тогда 
					стр.форма = НоваяФорма;
					УдалитьСтрокиПоКлючу(стр.КлючСтроки,"Формы","КлючСтроки");  
					стриндиго = Объект.Формы.добавить();
					стриндиго.КлючСтроки = стр.ключстроки;	
					стриндиго.Значение = НоваяФорма;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла	
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеЗакрытияВопросаОСозданииНовойФормы(Результат, ДопПараметры)  Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда 
		
		Если НЕ ДопПараметры.Свойство("ЗаменаЦГТипК") Тогда
			текстр = Объект.Цвета.НайтиПоИдентификатору(ДопПараметры.Идентификатор);
			НоваяФорма = СоздатьНовуюФорму(ТекСтр.ВидСекции, ТекСтр.типцвета1, ТекСтр.типкраски, ТекСтр.название);
			текстр.форма = НоваяФорма;
			//Необходимо записать значение в табличную часть "Формы"
			УдалитьСтрокиПоКлючу(текстр.КлючСтроки,"Формы","КлючСтроки");  
			стрФ = Объект.Формы.Добавить();
			стрФ.Ключстроки = текстр.ключстроки;
			стрФ.Значение = НоваяФорма;  
			стрФ.Цветоделение = Истина;
			// <-- Начало Лико Яцун С. В. 02.12.2025 
		КонецЕсли;
		Если ДопПараметры.Свойство("ЗаменаЦГТипК") Тогда
			Для каждого СтрЦМИК Из Объект.Цвета Цикл
				Если ЭтоЦМИК(СтрЦМИК.типцвета1) 
					И ЗначениеЗаполнено(СтрЦМИК.типкраски) 
					И ЗначениеРеквизита(СтрЦМИК.ВидСекции, "ВидПечати") = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Флексо")
					И СокрЛП(ЗначениеРеквизита(СтрЦМИК.типкраски,"Код")) <> "3081" Тогда
					СтрЦМИК.Цветоделение = Истина;
					СтрЦМИК.типкраски = ПолучитьЦГПоКоду("3081");
					ДопПараметры = Новый Структура;
					ДопПараметры.Вставить("Идентификатор", СтрЦМИК.ПолучитьИдентификатор());
					ПослеЗакрытияВопросаОСозданииНовойФормы(КодВозвратаДиалога.Да, ДопПараметры);	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли Результат = КодВозвратаДиалога.Нет И ДопПараметры.Свойство("ЗаменаЦГТипК") Тогда
		текстр = Объект.Цвета.НайтиПоИдентификатору(ДопПараметры.Идентификатор);
		текстр.Цветоделение = Истина;
		текстр.типкраски = ПолучитьЦГПоКоду("3081");
		НоваяФорма = СоздатьНовуюФорму(ТекСтр.ВидСекции, ТекСтр.типцвета1, ТекСтр.типкраски, ТекСтр.название);
		текстр.форма = НоваяФорма;
		//Необходимо записать значение в табличную часть "Формы"
		УдалитьСтрокиПоКлючу(текстр.КлючСтроки,"Формы","КлючСтроки");  
		стрФ = Объект.Формы.Добавить();
		стрФ.Ключстроки = текстр.ключстроки;
		стрФ.Значение = НоваяФорма;  
		стрФ.Цветоделение = Истина;	
	ИначеЕсли Результат = КодВозвратаДиалога.Отмена И ДопПараметры.Свойство("ЗаменаЦГТипК") Тогда	
		текстр = Объект.Цвета.НайтиПоИдентификатору(ДопПараметры.Идентификатор);
		текстр.Цветоделение = Истина;
		// <-- Конец Лико Яцун С. В. 02.12.2025
	КонецЕсли;
    ДобавитьУсловноеОформлениеЦветаВалФорма();
	
КонецПроцедуры	


