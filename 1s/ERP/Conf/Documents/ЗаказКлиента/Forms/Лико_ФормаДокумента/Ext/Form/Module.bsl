&НаСервере
Процедура РасчитатьТиражМетраж()
	
	МетражКвМ 		= 0;
	МетражПМ 		= 0;
	КоличествоОбщее = 0;
	ВесОбщий 		= 0;
	Нарезка 		= Объект.Нарезка.Размер/1000;
	ЕдиницаИзмеренияЗаказа = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	
	//Предопределенные значения
	МассивЛико_Предопределенные = Лико_ТиражМетраж.ПолучитьМассивЛико_Предопределенные();
	
	Для каждого стр из Объект.Товары Цикл
		Количество 			= 0;
		ПогонныйМетраж 		= 0;
		КвадратныйМетраж 	= 0;

		Если ЗначениеЗаполнено(Нарезка) Тогда 
			Лико_ТиражМетраж.ПолучитьМетражПоУсловиям(МассивЛико_Предопределенные, стр.Номенклатура.ЕдиницаИзмерения, Количество, ПогонныйМетраж, КвадратныйМетраж, Нарезка, стр.Количество, Объект);
		КонецЕсли;
		
		// <-- Начало Лико Яцун С. В. 05.12.2023
		//Только Омега с нумератором в режиме редактирования параметров (Вид вырубки = 0)
		текВидВырубки = Объект.ВидВырубки;
		Если НЕ ЗначениеЗаполнено(Объект.ШтампВырубной) И текВидВырубки = 0 И ОмегаСНумератором() Тогда
			Если стр.Номенклатура.ЕдиницаИзмерения = МассивЛико_Предопределенные[0] Тогда
				Количество = стр.Количество*1000;
				Если ВидРЦИндиго(Объект.РабочийЦентр) Тогда
					Если Объект.Ручьи = 0 ИЛИ Объект.ЭтикетокНаЛисте = 0  Тогда
						ПогонныйМетраж = 0;
					ИначеЕсли Объект.РучьиПечатиИндиго = 0 Тогда
						ПогонныйМетраж = Количество /Объект.ЭтикетокНаЛисте*Объект.ШагПечати;
					Иначе 
						ПогонныйМетраж = Количество /(Объект.ЭтикетокНаЛисте*Объект.РучьиПечатиИндиго/Объект.Ручьи)*Объект.ШагПечати;
					КонецЕсли;	
				Иначе
					Если Объект.Ручьи = 0 ИЛИ Объект.ЭтикетокНаЛисте = 0  Тогда
						ПогонныйМетраж = 0;
					ИначеЕсли Объект.РучьиПечати = 0 Тогда
						ПогонныйМетраж = Количество / Объект.ЭтикетокНаЛисте*Объект.ШагПечати;
					Иначе 
						ПогонныйМетраж = Количество /(Объект.ЭтикетокНаЛисте*Объект.РучьиПечати/Объект.Ручьи)*Объект.ШагПечати;
					КонецЕсли;
				КонецЕсли;
				КвадратныйМетраж = ПогонныйМетраж*Нарезка;
			ИначеЕсли стр.Номенклатура.ЕдиницаИзмерения = МассивЛико_Предопределенные[1] Тогда
				ПогонныйМетраж = стр.Количество;
				КвадратныйМетраж  = ПогонныйМетраж*Нарезка;
				Количество = ПогонныйМетраж; 
			ИначеЕсли  стр.Номенклатура.ЕдиницаИзмерения = МассивЛико_Предопределенные[2]  Тогда
				КвадратныйМетраж  = стр.Количество;
				ПогонныйМетраж = стр.Количество/Нарезка;
				Количество = КвадратныйМетраж;
			КонецЕсли;
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 05.12.2023	
			
		ВесОбщий 		= ВесОбщий + стр.Вес;		
		МетражКвМ 		= МетражКВМ + КвадратныйМетраж;
		МетражПМ 		= МетражПМ + ПогонныйМетраж;
		КоличествоОбщее = КоличествоОбщее + Количество;
		
		ЕдиницаИзмеренияЗаказа = стр.Номенклатура.ЕдиницаИзмерения;
		
	КонецЦикла;
	
	// --> Начало Лико Митюшин МФМ 29.03.2021
	текВидВырубки = Объект.ВидВырубки;
	ИзмененитьДоступностиПолейНаСервере(текВидВырубки);
	// <-- Конец Лико Митюшин МФМ 29.03.2021
	
	Если Объект.ЕдиницаИзмеренияЗаказа <> ЕдиницаИзмеренияЗаказа Тогда 
		Объект.ЕдиницаИзмеренияЗаказа = ЕдиницаИзмеренияЗаказа;
	КонецЕсли;
	
	Если Объект.МетражКВМ <> МетражКВМ Тогда 
		Объект.МетражКВМ = МетражКВМ;
	КонецЕсли;
	Если Объект.МетражПМ <> МетражПМ Тогда 
		Объект.МетражПМ = МетражПМ;
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(ЕдиницаИзмеренияЗаказа) ИЛИ ЕдиницаИзмеренияЗаказа = МассивЛико_Предопределенные[0] Тогда
		Если Объект.Тираж <> КоличествоОбщее/1000 Тогда 
			Объект.Тираж = КоличествоОбщее/1000;
		КонецЕсли;
	Иначе 
		 Если Объект.Тираж <> КоличествоОбщее Тогда 
			Объект.Тираж = КоличествоОбщее;
		КонецЕсли;
	КонецЕсли;

	Если Объект.Вес <> ВесОбщий Тогда
		Объект.Вес = ВесОбщий;
	КонецЕсли;
	
	текШтКВМ = Лико_ТиражМетраж.РассчитатьКВМ(Объект.ШТКВМ, МетражКВМ, КоличествоОбщее);
	Если текШтКВМ <> Неопределено И Объект.ШтКВМ <> текШтКВМ Тогда 
		Объект.ШтКВМ = текШтКВМ;
	КонецЕсли;
	
	Если текВидВырубки = 2 ИЛИ текВидВырубки = 9 ИЛИ текВидВырубки = 12 Тогда
		Объект.ДлинаПечатиИндиго = Лико_ТиражМетраж.ПолучитьДлинуПечатиИндиго(Объект, текВидВырубки);
	КонецЕсли;
	
	Если текВидВырубки = 5 ИЛИ (текВидВырубки = 6 И (Лико_ТиражМетраж.ЭтоТермоусадка(Объект)) ИЛИ Не ЗначениеЗаполнено(Объект.ЭтМЭР)) Тогда
		Объект.ЭтМЭР = Лико_ТиражМетраж.ПолучитьМежэтикеточноеРасстояние(Объект, текВидВырубки);	
	КонецЕсли;
	
	Если текВидВырубки = 6 Тогда
		Объект.ДлинаПечатиИндиго = Лико_ТиражМетраж.ПолучитьДлинуПечатиИндиго(Объект, текВидВырубки);
		Объект.ЭтикетокНаЛистеИндиго =  Лико_ТиражМетраж.ПолучитьЭтикетокНаЛистеИндиго(Объект, ТекВидВырубки);
	КонецЕсли;
	
	// --> Начало Лико Яцун 26.04.2022
	ДоступностьУтилизироватьИзлишки();
	// <-- Конец Лико Яцун 26.04.2022
	
КонецПроцедуры	

