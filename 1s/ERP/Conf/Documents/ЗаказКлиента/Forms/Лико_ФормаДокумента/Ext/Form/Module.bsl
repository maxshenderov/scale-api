&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	Если Поле = Элементы.ТоварыНоменклатура Тогда
		Если ЗначениеРеквизита(ТекущаяСтрока.Номенклатура, "Лико_DFM") Тогда
			СтандартнаяОбработка = Ложь;		
			// --> Начало Лико Ефимов ЕВВ 26.05.2021
			// Проверим, содержится ли эта позиция в других заказах. Если содержится, то запретим ее менять:
			//	- если 9-ка, то просто напишем соопщение о запрете;
			//	- если не 9-ка, то спросим нужно ли ее очистить. Если нужно очистить, то очищаем и убираем
			НомерПредыдущегоЗаказа = ПроверитьИспользованиеНоменклатурыВДругихЗаказах(ТекущаяСтрока.Номенклатура, Объект.Ссылка);
			Если ЗначениеЗаполнено(НомерПредыдущегоЗаказа) Тогда
				Если Объект.НоменклатураDFM Тогда
					// Просто запретим менять
					Сообщить("Номенклатура """ + ТекущаяСтрока.Номенклатура + """ является номенклатурой DFM и уже используется в заказе " + НомерПредыдущегоЗаказа + ". Изменять название запрещено");
				Иначе
					// Спросим, нужно ли очищать номенклатуру
					ОписаниеОповещения = Новый ОписаниеОповещения("ОтветНаВопросОНеобходимостиОчищатьНоменклатуру", ЭтотОбъект);
					ПоказатьВопрос(ОписаниеОповещения, "Номенклатура """ + ТекущаяСтрока.Номенклатура + """ является номенклатурой DFM, она используется в другом заказе (" + НомерПредыдущегоЗаказа + "). Очистить номенклатуру?", РежимДиалогаВопрос.ДаНетОтмена);
				КонецЕсли;
			Иначе
				ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаНаименованияНоменклатурыDFM",ЭтаФорма); 
				ПоказатьВводСтроки(ОписаниеОповещения,ЗначениеРеквизита(ТекущаяСтрока.Номенклатура, "Наименование"),"Введите новое наименование для Номенклатуры");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьИспользованиеНоменклатурыВДругихЗаказах(Номенклатура, Заказ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказКлиентаТовары.Ссылка КАК Ссылка,
		|	ЗаказКлиентаТовары.Ссылка.НомерБезПрефикса КАК НомерБезПрефикса
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Номенклатура = &Номенклатура
		|	И ЗаказКлиентаТовары.Ссылка <> &Ссылка
		|	И НЕ ЗаказКлиентаТовары.Ссылка.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказКлиентаТовары.Ссылка.Дата";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Ссылка", Заказ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.НомерБезПрефикса;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОтветНаВопросОНеобходимостиОчищатьНоменклатуру(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
		ТекущаяСтрока.Номенклатура = Неопределено;
		ТоварыНоменклатураПриИзменении(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаНаименованияНоменклатурыDFM(РезультатФормы, ПараметрыФормы) Экспорт
	Если РезультатФормы <> Неопределено Тогда
		ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
		ИдентификторСтроки = Элементы.Товары.ТекущиеДанные.ПолучитьИдентификатор();
		ЗаписатьНаименованиеНаСервере(ИдентификторСтроки, РезультатФормы, "Наименование");
		ЗаписатьНаименованиеНаСервере(ИдентификторСтроки, Строка(ЗначениеРеквизита(ТекущаяСтрока.Номенклатура,"Лико_ТипЭтикетки")) + " " + РезультатФормы, "НаименованиеПолное");
		ОповеститьОбИзменении(Тип("СправочникСсылка.Номенклатура"));
		ТекущаяСтрока.НаименованиеДляДокументов = ЗначениеРеквизита(ТекущаяСтрока.Номенклатура, "НаименованиеПолное");
		Элементы.Товары.Обновить();
	КонецЕсли;
КонецПроцедуры

