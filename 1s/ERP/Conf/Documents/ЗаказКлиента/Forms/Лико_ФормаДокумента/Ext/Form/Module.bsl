		//	КоличествоРучьев = ?(ЗначениеЗаполнено(Объект.РучьиПечати), Объект.РучьиПечати, Объект.Товары.Количество());
		//	КолНаОдинРучей = Объект.Товары.Итог("Количество") / КоличествоРучьев;
