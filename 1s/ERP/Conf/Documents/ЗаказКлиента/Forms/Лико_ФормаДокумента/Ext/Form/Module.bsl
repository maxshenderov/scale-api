Процедура НаправитьВРаботу(Команда)
	
	Отказ = Ложь;
	ЭтоПерваяОтправкаВРаботу = Ложь;
	// <-- Начало Лико Яцун С. В. 19.05.2025 
	Если объект.ВидЗаказа = ПредопределенноеЗначение("Перечисление.Лико_ВидыЗаказов.Шаблон") Тогда
