&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", ТекущаяСтрока.Характеристика);
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул",Новый Структура("Номенклатура", "Артикул"));
	Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
		ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		ТекущаяСтрока.НаименованиеДляДокументов = ЗначениеРеквизита(ТекущаяСтрока.Номенклатура, "НаименованиеПолное");
		// <-- Начало Лико Яцун С. В. 26.06.2025 
		Если ЗначениеРеквизита(Объект.Партнер, "Лико_GtinВНоменклатуре") Тогда
			Лико_Gtin = СокрЛП(ЗначениеРеквизита(ТекущаяСтрока.Номенклатура, "Лико_Gtin"));
			Если ЗначениеЗаполнено(Лико_Gtin) Тогда
				ТекущаяСтрока.Gtin = Лико_Gtin;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеРеквизита(Объект.Партнер, "Лико_КодЭтЗаказчикаВНоменклатуре") Тогда
			Лико_КодЭтикеткиЗаказчика = СокрЛП(ЗначениеРеквизита(ТекущаяСтрока.Номенклатура, "Лико_КодЭтикеткиЗаказчика"));
			Если ЗначениеЗаполнено(Лико_КодЭтикеткиЗаказчика) Тогда
				ТекущаяСтрока.КодЭтикеткиЗаказчика = Лико_КодЭтикеткиЗаказчика;	
			КонецЕсли;
		КонецЕсли;
		БылОтветНаВопросПроверкиGtinИКодЭтикеткиЗаказчикаВНоменклатуре = Ложь;
		// <-- Конец Лико Яцун С. В. 26.06.2025  
	Иначе
		ТекущаяСтрока.НаименованиеДляДокументов = "";
		ТекущаяСтрока.Артикул = "";
	КонецЕсли;
	СкрытьЛишниеКнопкиДляНоменклатурыDFM(ТекущаяСтрока.Номенклатура);
	ТекущаяСтрока.ДиаметрРоликаФакт = 0;
КонецПроцедуры

