&НаСервере
Процедура ЗаполнитьПереключательГруппыПроизводство()
	
	Элементы.ЗначениеПереключателяГруппыПроизводство.СписокВыбора.Очистить();
	ЗначениеПереключателяГруппыПроизводство = Неопределено;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТЗ.НомерПроката КАК ЧИСЛО(10, 0)) КАК НомерПроката,
		|	ВЫРАЗИТЬ(ТЗ.РабочийЦентр КАК Справочник.РабочиеЦентры) КАК РабочийЦентр
		|ПОМЕСТИТЬ ВТ_ТЗ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТЗ.НомерПроката КАК НомерПроката,
		|	МАКСИМУМ(ВТ_ТЗ.РабочийЦентр.ВидРабочегоЦентра.Наименование) КАК ВидРЦНаименование
		|ИЗ
		|	ВТ_ТЗ КАК ВТ_ТЗ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ТЗ.НомерПроката
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерПроката";

	Запрос.УстановитьПараметр("ТЗ", Объект["Цвета"].Выгрузить(, "НомерПроката,РабочийЦентр"));
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(ЗначениеПереключателяГруппыПроизводство) Тогда
			ЗначениеПереключателяГруппыПроизводство = Выборка.НомерПроката;
		КонецЕсли;
		Элементы.ЗначениеПереключателяГруппыПроизводство.СписокВыбора.Добавить(Выборка.НомерПроката, "" + Выборка.НомерПроката + " " + СокрЛП(Выборка.ВидРЦНаименование)); 
	КонецЦикла;
	
	Элементы.ЗначениеПереключателяГруппыПроизводство.СписокВыбора.Добавить(90, "Перемотка"); 
	Элементы.ЗначениеПереключателяГруппыПроизводство.СписокВыбора.Добавить(91, "Формщики");

КонецПроцедуры

&НаСервере 
Процедура УстановитьЦенуБезНДС(Идентификатор)
	стр = Объект.Товары.НайтиПоИдентификатору(Идентификатор);
	ТекПроцентНДС = стр.СтавкаНДС.Ставка;
	стр.ЦенаБезНДС = стр.цена/(1+ТекПроцентНДС/100);
КонецПроцедуры

&НаСервере 
Процедура УстановитьЦенуСНДС(Идентификатор)
	стр = Объект.Товары.НайтиПоИдентификатору(Идентификатор);
	ТекПроцентНДС = стр.СтавкаНДС.Ставка;
	стр.Цена = стр.ценаБезНДС*(1+ТекПроцентНДС/100);
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьНачалоПечати()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПооперационноеРасписание2_2.Начало КАК Начало
	|ИЗ
	|	РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2
	|ГДЕ
	|	ПооперационноеРасписание2_2.Этап.Распоряжение.ДокументОснование = &Заказ
	|	И ПооперационноеРасписание2_2.Этап.ВидЭтапа = ЗНАЧЕНИЕ(Справочник.Лико_ВидыЭтаповПроизводства.Прокат)
	|	И ПооперационноеРасписание2_2.Этап.НомерПроката = 1
	|	И ПооперационноеРасписание2_2.Моделирование = ЛОЖЬ
	|	И ПооперационноеРасписание2_2.Выполнено = 0";
	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.Начало) ТОгда
			НачалоПечати = Результат.Начало; 
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

&НаСервере
Процедура КоличествоКликовНаСервере()
	Объект.КоличествоКликов = Лико_Планирование.УстановитьЧислоКликов(Объект.Ссылка);
КонецПроцедуры

