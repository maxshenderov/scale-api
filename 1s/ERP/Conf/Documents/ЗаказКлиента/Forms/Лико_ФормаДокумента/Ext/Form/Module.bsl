&НаСервере
Процедура ПроставитьВидВырубки(ПересчетПараметров)		// --> Начало Лико Митюшин МФМ 19.05.2021
	// <-- Начало Лико Яцун С. В. 01.12.2023   
	ВРежимеРедактированияПараметров = Ложь;
	Если Объект.ВидВырубки = 0 Тогда
		ВРежимеРедактированияПараметров = Истина;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 01.12.2023
	текВидВырубки = ПолучитьВидВырубкиНаСервере();
	Если Объект.ВидВырубки <> текВидВырубки Тогда
		Объект.ВидВырубки = текВидВырубки;
		ЗаполнитьПараметрыИРасчитатьМетражНаСервере(текВидВырубки, ПересчетПараметров, ВРежимеРедактированияПараметров); 
		Сообщить("Изменен вид вырубки, проверьте параметры вырубки / печати", СтатусСообщения.Информация); 
		// <-- Начало Лико Яцун С. В. 08.12.2023
		Если РазрешеноМенятьПараметрыШтампа И Объект.ВидВырубки <> 0 Тогда
			РазрешеноМенятьПараметрыШтампа = Ложь;
			Элементы.Лико_РедактироватьПараметрыШтампов.ЦветТекста = WebЦвета.ТемноСерый;
			ИзмененитьДоступностиПолейНаСервере(Объект.ВидВырубки);
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 08.12.2023
	КонецЕсли;
КонецПроцедуры 		// <-- Конец Лико Митюшин МФМ 19.05.2021

&НаСервере
Процедура ЗаполнитьПараметрыИРасчитатьМетражНаСервере(текВидВырубки, ПересчетПараметров, ВРежимеРедактированияПараметров = Ложь)
	ЗаполнитьПараметрыПечати(Объект, текВидВырубки,, ПересчетПараметров,НЕ ВРежимеРедактированияПараметров);
	Лико_ТиражМетраж.РассчитатьМетражСВидомВырубки(Объект.Тираж*1000, Объект, текВидВырубки);	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВырубнойШтамп()
	Если ЗначениеЗаполнено(Объект.ШтампВырубной) Тогда 
		строки = Объект.Цвета.НайтиСтроки(Новый Структура("Оснастка", Объект.ШтампВырубной));
		Если строки.количество() = 0 Тогда 
			Объект.ШтампВырубной = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
			//ОчиститьВсеПараметрыШтампа();		
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыПечати(Заказ, текВидВырубки = Неопределено, СпецификацияСсылка = Неопределено, ПересчетПараметров = Ложь, ПересчитатьНарезку = Истина) Экспорт // --> Начало Лико Митюшин МФМ 18.05.2021

	Если текВидВырубки = 0 ИЛИ (РазрешеноМенятьПараметрыШтампа И ОмегаСНумератором()) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПересчетПараметров Тогда
		Лико_ТиражМетраж.ОчиститьНеИспользуемыПараметрыШтампа(Заказ, текВидВырубки)
	КонецЕсли;
	
	ДлинаСПрипуском = Неопределено;
	КоличествоПоДлинеРапорта = Неопределено;
	Если НЕ (текВидВырубки = 5 И ПересчетПараметров = Ложь ИЛИ текВидВырубки = 18 ИЛИ текВидВырубки = 19) Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ШагПечати) И текВидВырубки = 7 И ЗначениеЗаполнено(Объект.ШтампВырубной) Тогда
			ПараметрыШтампаВырубки = ПолучитьВсеПараметрыШтампа(Объект.ШтампВырубной);
			Если ПараметрыШтампаВырубки.Количество() <> 0 И ЗначениеЗаполнено(ПараметрыШтампаВырубки.ШагПечати) Тогда
				Объект.ШагПечати = ПараметрыШтампаВырубки.ШагПечати;
			КонецЕсли;
		КонецЕсли;
		Объект.ДлинаПечати 				= Лико_ТиражМетраж.ПолучитьДлинуПечати(Объект, Объект.ВидВырубки);
	КонецЕсли;
	Если текВидВырубки = 18 ИЛИ текВидВырубки = 19 Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ДопускМинус) И НЕ ЗначениеЗаполнено(Объект.ДопускПлюс) Тогда
			ВариантыДопусков = Неопределено;		
		КонецЕсли;
		РасчетнаяНарезкаДанные = ПолучитьРасчетнуюНарезку();
		Объект.НарезкаРасчетная = РасчетнаяНарезкаДанные.РасчетнаяНарезкаСсылка;
		Если НЕ ЗначениеЗаполнено(Объект.Нарезка) Тогда
			Объект.Нарезка = РасчетнаяНарезкаДанные.РасчетнаяНарезкаСсылка;
		КонецЕсли;
		ЗаполнитьРаппорт();
		Если ПересчитатьНарезку И НЕ Объект.РучнойВводНарезки Тогда
			Объект.Нарезка = РасчетнаяНарезкаДанные.РасчетнаяНарезкаСсылка;
			ЗаполнитьРаппорт();
		КонецЕсли;
		Если текВидВырубки = 18 Тогда
			Объект.КоличествоЭтПоДлинеПечати = Окр(Объект.ДлинаПечати/(Объект.ШиринаЭтикетки/1000)); 
		ИначеЕсли текВидВырубки = 19 Тогда
			Объект.КоличествоЭтПоДлинеПечати = Окр(Объект.ДлинаПечати/(Объект.ДлинаЭтикетки/1000)); 
		КонецЕсли;
		Объект.ПлощадьКлише = Лико_ТиражМетраж.ПолучитьПлощадьКлише(Объект, текВидВырубки);
	КонецЕсли;
	Объект.ЭтикетокНаЛистеПечати = ПолучитьЭтикетокНаЛистеПечатиНаСервере();
	
КонецПроцедуры // <-- Конец Лико Митюшин МФМ 18.05.2021 

&НаСервереБезКонтекста
Функция ПолучитьВсеПараметрыШтампа(Оснастка)
	
	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	Лико_ПараметрыШтампа.Номенклатура,
	|	Лико_ПараметрыШтампа.ТипШтампа,
	|	Лико_ПараметрыШтампа.ЭтикетокНаЛисте,
	|	Лико_ПараметрыШтампа.Нарезка,
	|	Лико_ПараметрыШтампа.ШагПечати,
	|	Лико_ПараметрыШтампа.Ручьи,
	|	Лико_ПараметрыШтампа.Z,
	|	Лико_ПараметрыШтампа.ДлинаЭтикетки,
	|	Лико_ПараметрыШтампа.ШиринаЭтикетки,
	|	Лико_ПараметрыШтампа.Цена,
	|	Лико_ПараметрыШтампа.Артикул
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|ГДЕ
	|	Лико_ПараметрыШтампа.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Оснастка);
		
	Выборка = Запрос.Выполнить().Выбрать();
	ПараметрыШтампаструктура = Новый Структура;
	Пока Выборка.Следующий() Цикл
		ПараметрыШтампаструктура.Вставить("ЭтикетокНаЛисте",Выборка.ЭтикетокНаЛисте);
		ПараметрыШтампаструктура.Вставить("Нарезка",Выборка.Нарезка);
		ПараметрыШтампаструктура.Вставить("Ручьи",Выборка.Ручьи);
		ПараметрыШтампаструктура.Вставить("Z",Выборка.Z);
		ПараметрыШтампаструктура.Вставить("ДлинаЭтикетки",Выборка.ДлинаЭтикетки);
		ПараметрыШтампаструктура.Вставить("ШиринаЭтикетки",Выборка.ШиринаЭтикетки);
		ПараметрыШтампаструктура.Вставить("ШагПечати",Выборка.ШагПечати);
		ПараметрыШтампаструктура.Вставить("РучьиПечати",Выборка.Ручьи);
	КонецЦикла;
	
	Возврат ПараметрыШтампаструктура;

КонецФункции	

&НаСервере
Процедура ЗаполнитьРаппорт()
	Если Объект.РаппортМеняли Тогда
		Возврат;	
	КонецЕсли;
	РаппортДлинаПечати = Лико_ТиражМетраж.ПолучитьДлинуПечати(Объект, Объект.ВидВырубки);
	Если РаппортДлинаПечати <> Неопределено Тогда
		Объект.Раппорт = РаппортДлинаПечати.Раппорт;
		Объект.ДлинаПечати = РаппортДлинаПечати.ДлинаПечати;
	Иначе
		Объект.Раппорт = Неопределено;
		Объект.ДлинаПечати = 0;
		Объект.КоличествоЭтПоДлинеПечати = 0;
		Объект.ЭтикетокНаЛистеПечати = 0;
		Объект.ПлощадьКлише = 0; 
		Возврат;
	КонецЕсли;
	
КонецПроцедуры    

&НаСервере
Функция ПолучитьРасчетнуюНарезку() // <-- Начало Лико Яцун С. В. 26.01.2026
	
	ДанныеВозврата = Новый Структура();
	текВидВырубки = Объект.ВидВырубки;
	РасчетнаяНарезкаСсылка = Справочники.ЯССМ_Нарезки.ПустаяСсылка();
	//ОМЕТ без вырубки
	Если текВидВырубки = 18 ИЛИ текВидВырубки = 19 Тогда
		
		Если текВидВырубки = 18 Тогда
			РасчетнаяНарезкаЗначениеБезОкругления = (Объект.ДлинаЭтикетки/1000) * Объект.РучьиПечати + 0.02;
		ИначеЕсли текВидВырубки = 19 Тогда
			РасчетнаяНарезкаЗначениеБезОкругления = (Объект.ШиринаЭтикетки/1000) * Объект.РучьиПечати + 0.025;
		КонецЕсли;
		
		РасчетнаяНарезкаЗначение = ЗарплатаКадрыКлиентСервер.Округлить(Цел(РасчетнаяНарезкаЗначениеБезОкругления*1000), 5,Перечисления.ПравилаОкругленияПриРасчетеЗарплаты.ВБольшуюСторону);
		РасчетнаяНарезкаСсылка = Справочники.ЯССМ_Нарезки.НайтиПоНаименованию(РасчетнаяНарезкаЗначение);
		
		ДанныеВозврата.Вставить("РасчетнаяНарезкаСсылка",РасчетнаяНарезкаСсылка);
		ДанныеВозврата.Вставить("ТекстПараметры","");
		
		Возврат ДанныеВозврата;
	КонецЕсли;	
		
	//Другие варианты расчета с вырубкой
	
	СтрВырубка = Объект.Цвета.НайтиСтроки(Новый Структура("ВидСекции",Справочники.Лико_ВидыСекций.Вырубка));
	Для каждого ЗначМ Из СтрВырубка Цикл
		РЦВырубки = ЗначМ.РабочийЦентр;
		ВидРЦВырубки = РЦВырубки.ВидРабочегоЦентра;
	КонецЦикла;		
	
	
	ЭтоЦифровой = Ложь;
	ЕстьОмега = Ложь;
	ЕстьКартес = Ложь;
	ИксФойлБуфойлУчтено = Ложь;
	ВидРЦИндигоИЛИОмега = (ВидРЦ = Справочники.ВидыРабочихЦентров.Indigo ИЛИ ВидРЦ = Справочники.ВидыРабочихЦентров.Omega);
	ЦифраПослеОсновногоЦеха = Ложь;
	ЕстьГорячееТиснениеПлоское = Ложь;
	ЕстьГорячееТиснениеВРегистрПлоское = Ложь;
	ЕстьНумератор = Ложь;
	ЕстьКонгрев = Ложь;
	
	МатериалСтр = НРег(Строка(Объект.ОсновнойМатериал));
	ИксФойл = Найти(МатериалСтр,"икс-фойл") > 0;
	Буфойл = Найти(МатериалСтр,"буфойл") > 0;

	Для каждого СтрЦ из Объект.Цвета Цикл
		Если ЗначениеЗаполнено(СтрЦ.РабочийЦентр) Тогда
			СтрЦВидРЦ = СтрЦ.РабочийЦентр.ВидРабочегоЦентра;
			Если СтрЦВидРЦ = Справочники.ВидыРабочихЦентров.Indigo Тогда  
				ЭтоЦифровой = Истина;
			КонецЕсли;  
			Если СтрЦВидРЦ = Справочники.ВидыРабочихЦентров.Omega Тогда  
				ЕстьОмега = Истина;
			КонецЕсли;  
			Если СтрЦВидРЦ = Справочники.ВидыРабочихЦентров.Cartes Тогда  
				ЕстьКартес = Истина;
			КонецЕсли;  
			Если СтрЦ.НомерПроката > 1
				И (СтрЦВидРЦ = Справочники.ВидыРабочихЦентров.Indigo 
				ИЛИ СтрЦВидРЦ = Справочники.ВидыРабочихЦентров.Omega)
				И (ВидРЦ <> Справочники.ВидыРабочихЦентров.Indigo 
				И ВидРЦ <> Справочники.ВидыРабочихЦентров.Omega)
				И Объект.РабочийЦентр.Лико_ОсновнаяМашина Тогда
				ЦифраПослеОсновногоЦеха = Истина; 
			КонецЕсли;
			Если СтрЦ.ВидСекции = Справочники.Лико_ВидыСекций.ГорячееТиснениеПлоское Тогда  
				ЕстьГорячееТиснениеПлоское = Истина;
			КонецЕсли;  
			Если СтрЦ.ВидСекции = Справочники.Лико_ВидыСекций.ГорячееТиснениеВРегистрПлоское Тогда  
				ЕстьГорячееТиснениеВРегистрПлоское = Истина;
			КонецЕсли;  
			Если СтрЦ.ВидСекции = Справочники.Лико_ВидыСекций.Нумератор Тогда  
				ЕстьНумератор = Истина;
			КонецЕсли;  
			Если СтрЦ.ВидСекции = Справочники.Лико_ВидыСекций.Конгрев И Строка(СтрЦ.Оснастка) <> "Штамп для ротационного конгрева" Тогда  
				ЕстьКонгрев = Истина;
			КонецЕсли;  
		КонецЕсли;
	КонецЦикла;
	Если Объект.Цифровой <> ЭтоЦифровой Тогда 
		Объект.Цифровой = ЭтоЦифровой;
	КонецЕсли;
	
	Ручьи = ?(ЭтоЦифровой, Объект.РучьиПечатиИндиго, Объект.РучьиПечати);
	ШагПоНарезке = ПолучитьШагПоНарезкеШтампа(Объект.ШтампВырубной);
	ШиринаПоНожам = ?(Ручьи = 1, Объект.ДлинаЭтикетки, ШагПоНарезке * (Ручьи - 1) + Объект.ДлинаЭтикетки);
	
	РасчетнаяНарезкаБезОкругления = ШиринаПоНожам + 15; //Стандарт
	СтрНарезка = "Шаг по нарезке: " + ШагПоНарезке + ", Высота эт.: " + Объект.ДлинаЭтикетки + ", Ручьи: " + Ручьи;
	
	РасчетныеНарезки = Новый Массив;
	РасчетныеНарезки.Добавить(РасчетнаяНарезкаБезОкругления); 
	
	//Расчет нарезки по условиям
	//Индиго или Омега (+ Картес) и осн. материал Икс-фойл или Буфойл
	Если ВидРЦИндигоИЛИОмега Тогда
		Если (ИксФойл И НЕ (ЕстьОмега И НЕ ЕстьКартес)) ИЛИ Буфойл Тогда
			РасчетнаяНарезкаБезОкругления = ШиринаПоНожам + 15 + ?(ЕстьКартес,15,?(ЕстьОмега,5,10));
			СтрНарезка = "Основной материал: " + Объект.ОсновнойМатериал + ". " + СтрНарезка  + ?(ЕстьКартес,". Cartes",?(ЕстьОмега,". Omega",""));
			РасчетныеНарезки.Добавить(РасчетнаяНарезкаБезОкругления);
			ИксФойлБуфойлУчтено = Истина;
		КонецЕсли;
	КонецЕсли;
	//Если 2 прокат цифра, а 1 - основной цех 
	Если ЦифраПослеОсновногоЦеха Тогда
		РасчетнаяНарезкаБезОкругления = ШиринаПоНожам + 15 + 5;
		СтрНарезка = СтрНарезка + ". Цифра после основной машины";
		РасчетныеНарезки.Добавить(РасчетнаяНарезкаБезОкругления); 
	КонецЕсли;
	Если НЕ ВидРЦИндигоИЛИОмега Тогда
		//Если есть Горячее тиснение плоское или Горячее тиснение в Регистр Плоское
		Если ЕстьГорячееТиснениеПлоское ИЛИ ЕстьГорячееТиснениеВРегистрПлоское Тогда
			РасчетнаяНарезкаБезОкругления = ШиринаПоНожам + 15 + 5;
			СтрНарезка = СтрНарезка + ?(ЕстьГорячееТиснениеПлоское,". Горячее тиснение плоское",". Горячее тиснение в регистр плоское");
			РасчетныеНарезки.Добавить(РасчетнаяНарезкаБезОкругления); 
		КонецЕсли;
		//Если есть Нумератор
		Если ЕстьНумератор Тогда
			РасчетнаяНарезкаБезОкругления = ШиринаПоНожам + 15 + 5;
			СтрНарезка = СтрНарезка + ". Нумератор";
			РасчетныеНарезки.Добавить(РасчетнаяНарезкаБезОкругления); 
		КонецЕсли;
		//Если есть Конгрев и оснастка наименование <> "Штамп для ротационного конгрева" или ГорячееТиснениеПлоское или есть Картес
		Если ЕстьКонгрев ИЛИ ЕстьГорячееТиснениеПлоское ИЛИ ЕстьКартес Тогда
			//если осн. материал (Икс-фойл или Буфойл)
			Если (ИксФойл И НЕ (ЕстьОмега И НЕ ЕстьКартес)) ИЛИ Буфойл Тогда
				НаименованиеСекции = "";
				Если ЕстьКонгрев Тогда
					НаименованиеСекции = НаименованиеСекции + ". " + "Конгрев";
				КонецЕсли;
				РасчетнаяНарезкаБезОкругления = ШиринаПоНожам + 15 + ?(ЕстьКартес,15,?(ЕстьОмега,5,10));
				СтрНарезка = "Основной материал: " + Объект.ОсновнойМатериал + ". " + СтрНарезка + НаименованиеСекции + ?(ЕстьКартес,". Cartes",?(ЕстьОмега,". Omega",""));
				РасчетныеНарезки.Добавить(РасчетнаяНарезкаБезОкругления);
				ИксФойлБуфойлУчтено = Истина;
			ИначеЕсли ЕстьКонгрев Тогда	
				РасчетнаяНарезкаБезОкругления = ШиринаПоНожам + 15 + 5;
				СтрНарезка = СтрНарезка + ". Конгрев";
				РасчетныеНарезки.Добавить(РасчетнаяНарезкаБезОкругления);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ИксФойлБуфойлУчтено Тогда
		Если (ИксФойл И НЕ (ЕстьОмега И НЕ ЕстьКартес)) ИЛИ Буфойл Тогда
			РасчетнаяНарезкаБезОкругления = ШиринаПоНожам + 15 + 5;
			СтрНарезка = "Основной материал: " + Объект.ОсновнойМатериал + ". " + СтрНарезка;
			РасчетныеНарезки.Добавить(РасчетнаяНарезкаБезОкругления);
		КонецЕсли;
	КонецЕсли;
	
	//Выбирается максимальное значение нарезки
	Для Каждого ВариантРасчетнойНарезки Из РасчетныеНарезки Цикл
		Если ВариантРасчетнойНарезки > РасчетнаяНарезкаБезОкругления Тогда
			РасчетнаяНарезкаБезОкругления = ВариантРасчетнойНарезки;	
		КонецЕсли;					
	КонецЦикла;
	
	РасчетнаяНарезкаЗначение = ЗарплатаКадрыКлиентСервер.Округлить(Цел(РасчетнаяНарезкаБезОкругления), 5,Перечисления.ПравилаОкругленияПриРасчетеЗарплаты.ВБольшуюСторону);
	
	//Если расчетная наоезка больше Максимальной для Вида РЦ, то выбираем максимальную для Вида РЦ
	Если ЗначениеЗаполнено(ВидРЦВырубки.лкМаксимальнаяНарезка) Тогда
		РасчетнаяНарезкаЗначение = Мин(РасчетнаяНарезкаЗначение,ВидРЦВырубки.лкМаксимальнаяНарезка);		
	КонецЕсли;
	
	//Для Цифры минимальная нарезка 190
	Если Объект.Цифровой И РасчетнаяНарезкаЗначение < 190 Тогда
		РасчетнаяНарезкаЗначение = 190;	
	КонецЕсли;
	РасчетнаяНарезкаСсылка = Справочники.ЯССМ_Нарезки.НайтиПоНаименованию(РасчетнаяНарезкаЗначение);
	
	//На случай, если получится нарезка больше существующей и никак не ограничена максимальной в Виде РЦ
	Если НЕ ЗначениеЗаполнено(РасчетнаяНарезкаСсылка) Тогда
		СтрНарезка = "Расчетная нарезка " + Строка(РасчетнаяНарезкаЗначение) + ". " + СтрНарезка;	
	КонецЕсли;
	
	ДанныеВозврата.Вставить("РасчетнаяНарезкаСсылка",РасчетнаяНарезкаСсылка);
	ДанныеВозврата.Вставить("ТекстПараметры",СтрНарезка);
	
	Возврат ДанныеВозврата;
			
КонецФункции // <-- Конец Лико Яцун С. В. 26.01.2026	


