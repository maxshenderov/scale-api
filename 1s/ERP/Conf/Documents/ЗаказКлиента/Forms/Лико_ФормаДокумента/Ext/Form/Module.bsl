	КонтрольныйХэш =  ВернутьКонтрольныйХэш();
	// <-- Конец Лико Субботин 09.09..2022 	   
	
	// <-- Начало Лико Яцун С. В.   
	К_Дох = Лико_Планирование.ПолучитьКоэффициентНалоговВДоходности(ТекущаяДата(), Объект.Площадка);
	// <-- Конец Лико Яцун С. В. 
	
