&НаКлиенте
Процедура ТЧПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	ИмяТЧ = Элемент.Имя;
	МассивСтрок = Новый Массив;
	Если Элементы[ИмяТЧ].ВыделенныеСтроки.Количество() > 0 Тогда
		МассивСтрок = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(Элементы[ИмяТЧ].ВыделенныеСтроки);
	ИначеЕсли Элементы[ИмяТЧ].ТекущаяСтрока <> Неопределено Тогда
		МассивСтрок.Добавить(Элементы[ИмяТЧ].ТекущаяСтрока);
	Иначе
		Сообщить("Не выбраны строки для удаления");
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура("ИмяТЧ,ВыделенныеСтроки", ИмяТЧ, МассивСтрок);
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросОбУдаленииСтроки", ЭтотОбъект, ДопПараметры), "Вы действительно хотите удалить " + ?(МассивСтрок.Количество() > 1, "строки?", "строку?"), РежимДиалогаВопрос.ДаНетОтмена,, КодВозвратаДиалога.Отмена, "Удаление строк");

КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОбУдаленииСтроки(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Для каждого ИдСтроки из ДопПараметры.ВыделенныеСтроки Цикл
			СтрокаДляУдаления = Объект[ДопПараметры.ИмяТЧ].НайтиПоИдентификатору(ИдСтроки);
			Если СтрокаДляУдаления <> Неопределено Тогда
				Если ДопПараметры.ИмяТЧ = "Цвета" Тогда
					УдалитьСписокЗначений("Формы", СтрокаДляУдаления.КлючСтроки);
				КонецЕсли;
				Объект[ДопПараметры.ИмяТЧ].Удалить(Объект[ДопПараметры.ИмяТЧ].Индекс(СтрокаДляУдаления));
				Модифицированность = Истина;
			КонецЕсли; 
		КонецЦикла;
		Если ДопПараметры.ИмяТЧ = "Цвета" Тогда
			ЦветаПослеУдаления();
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

