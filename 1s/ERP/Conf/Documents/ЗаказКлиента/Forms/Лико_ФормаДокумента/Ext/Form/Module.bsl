Функция ПроверитьСоответствиеЦеновойГруппыВидуСекции(ЦГ, ВидСекции, Площадка, ТипЦвета);    
	Запрос = Новый  Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеновыеГруппыЛико_ВидыСекций.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЦеновыеГруппы.Лико_ВидыСекций КАК ЦеновыеГруппыЛико_ВидыСекций
	|ГДЕ
	|	ЦеновыеГруппыЛико_ВидыСекций.Ссылка = &ЦГ
	|	И ЦеновыеГруппыЛико_ВидыСекций.ВидСекции = &ВидСекции
	|	И ВЫБОР
	|			КОГДА ЦеновыеГруппыЛико_ВидыСекций.Площадка = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЦеновыеГруппыЛико_ВидыСекций.Площадка = &Площадка
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА ЦеновыеГруппыЛико_ВидыСекций.Ссылка.Лико_ВидТМЦ = ЗНАЧЕНИЕ(Справочник.Лико_ВидыТМЦ.Краска)
	|				ТОГДА ЦеновыеГруппыЛико_ВидыСекций.ТипЦвета = &ТипЦвета
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";  
	Запрос.УстановитьПараметр("ЦГ", ЦГ);
	Запрос.УстановитьПараметр("ВидСекции", ВидСекции);
	Запрос.УстановитьПараметр("Площадка", Площадка.Организация);
	Запрос.УстановитьПараметр("ТипЦвета", ТипЦвета);
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда 
		Возврат Истина;
	Иначе 
		Возврат Ложь;
	КонецЕсли;   
	
КонецФункции	

&НаКлиенте
Процедура ЦветаТипКраскиПриИзменении(Элемент)   
	текстр = Элементы.Цвета.ТекущиеДанные;  

	Если ЗначениеЗаполнено(текстр.типкраски) Тогда  

			
		Если ЗначениеРеквизита(текстр.ТипКраски, "Лико_ВидТМЦ") <> текстр.ВидТМЦ Тогда 
			Сообщить("Выбранный тип не соответствует указанному Виду ТМЦ"); 
			текстр.типкраски = Неопределено;   
			Возврат ;
		КонецЕсли;
		
		Если Не ПроверитьСоответствиеЦеновойГруппыВидуСекции(текстр.ТипКраски,текстр.ВидСекции, Объект.Площадка,текстр.ТипЦвета1) Тогда 
            Сообщить("Выбранный тип не соответствует Виду работ или типу цвета (для краски)"); 
			текстр.типкраски = Неопределено; 
			Возврат ;
		КонецЕсли;

			
		
		ВидПечати = ЗначениеРеквизита(текстр.ВидСекции, "ВидПечати");
		Если (ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Глубокая") ИЛИ ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Бессольвент")) 
			И ЗначениеРеквизита(текстр.РабочийЦентр, "Лико_Площадка") = ГлЛико_Площадки.ИксПак Тогда
			текстр.Грамматура = ЗначениеРеквизита(текстр.типкраски, "КоэффициентКраскоПереноса");
			ЗаполнитьФормулуПантона(ТекСтр);	
		ИначеЕсли (текстр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ОфсетнаяПечать") ИЛИ текстр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ФлексоПечать")) 
			И ЗначениеРеквизита(текстр.РабочийЦентр, "Лико_Площадка") = ГлЛико_Площадки.ИксПак И НЕ ЗначениеЗаполнено(текстр.ФормулаПантона) Тогда
			текстр.Название = ЗначениеРеквизита(текстр.типкраски,"Наименование")	
		КонецЕсли;
		
	КонецЕсли;  
	
	Если  ЗначениеРеквизита(текстр.Номенклатура, "ЦеноваяГруппа") <> текстр.ТипКраски Тогда 
		текстр.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	КонецЕсли;
		
КонецПроцедуры

