																		|ИЛИ Лико_Формы.КодЛинкс = ""000"" + &Код
																		|ИЛИ Лико_Формы.КодЛинкс = ""0000"" + &Код
																		|ИЛИ Лико_Формы.КодЛинкс = ""00000"" + &Код
																		|ИЛИ Лико_Формы.КодЛинкс = ""000000"" + &Код
