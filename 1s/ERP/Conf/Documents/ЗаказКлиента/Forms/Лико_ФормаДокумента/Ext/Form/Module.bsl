	//субботин 06.06.23
	ЗаполнитьТипЗаливка(); 
    // <-- Начало Лико Яцун С. В. 18.10.2023 
	ЗаполнитьВидОснастка();
	//ЗаполнитьВалФорма();  
	// <-- Конец Лико Яцун С. В. 18.10.2023	
