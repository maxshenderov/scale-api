&НаСервере
Функция НуженРасчетНарезки(ВизЗаказаПроверки) // <-- Начало Лико Яцун С. В. 21.01.2026
	
	Если (ВизЗаказаПроверки = Перечисления.Лико_ВидыЗаказов.ПолныйПовтор ИЛИ ВизЗаказаПроверки = Перечисления.Лико_ВидыЗаказов.ПовторСНовымОбъединением) И НЕ (Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19) Тогда
		НуженРасчетНарезки = Ложь;                  
		Возврат НуженРасчетНарезки;
	КонецЕсли;

	Если ((Объект.Площадка = Справочники.Лико_Площадки.Ликофлекс ИЛИ Объект.Площадка = Справочники.Лико_Площадки.Линкс) 
		И Объект.ТипЗаказа <> Перечисления.Лико_ТипыЗаказов.Термоусадка 
		И ЗначениеЗаполнено(Объект.ШтампВырубной))
		ИЛИ (Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19) Тогда
		СтрВырубка = Объект.Цвета.НайтиСтроки(Новый Структура("ВидСекции",Справочники.Лико_ВидыСекций.Вырубка));
		НуженРасчетНарезки = Истина;
		Для каждого ЗначМ Из СтрВырубка Цикл
			Если ЗначМ.РабочийЦентр.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Schober Тогда
				НуженРасчетНарезки = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла
	Иначе
		НуженРасчетНарезки = Ложь;                  
	КонецЕсли;
	
	Если НуженРасчетНарезки И НЕ (Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19) Тогда
		ШагПоНарезке = ПолучитьШагПоНарезкеШтампа(Объект.ШтампВырубной);
		Если ШагПоНарезке = 0 Тогда
			НуженРасчетНарезки = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НуженРасчетНарезки;	
		
КонецФункции // <-- Конец Лико Яцун С. В. 21.01.2026

