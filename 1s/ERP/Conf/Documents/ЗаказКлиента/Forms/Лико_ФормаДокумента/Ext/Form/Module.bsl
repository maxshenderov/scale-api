&НаСервере
Процедура ЗаблокироватьЗаказИОтправитьПисьмо(ПричинаБлокировкиНаименование,ТекстПисьма)  
	
	Запись = РегистрыСведений.Лико_ЭтапыЗаказа.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДата();
	Запись.Заказ = Объект.Ссылка;
	Запись.Этап = Справочники.Лико_ЭтапыВыполненияЗаказа.Заблокирован;
	Запись.Площадка = Объект.Площадка;
	Запись.НомерБланка = 1;
	Запись.Ответственный = ПользователиКлиентСервер.ТекущийПользователь();
	Запись.ПричинаБлокировки = Справочники.Лико_ПричиныБлокировки.НайтиПоНаименованию(ПричинаБлокировкиНаименование);
	Текст = "";
	Тема = "Заблокирован заказ N " + Объект.НомерБезПрефикса + Символы.ПС + " Этикетки:" + Объект.Этикетки;
	ЗаказОб = Объект.Ссылка.ПолучитьОбъект();
	ЗаказОб.Заблокирован = Истина;
	ЗаказОб.Состояние = Перечисления.Лико_СостоянияЗаказов.Заблокирован;
	Попытка 
		ЭтапДоБлокировки = РегистрыСведений.Лико_ЭтапыЗаказа.ПолучитьПоследнее(,Новый Структура("Заказ",Объект.Ссылка)).Этап;
		
		ЗаказОб.Записать(РежимЗаписиДокумента.Запись);
		Запись.Записать();
		//Отправляем письмо менеджеру
		Текст = Тема + Символы.ПС + ПричинаБлокировкиНаименование + ":" + Символы.ПС + ТекстПисьма;
		Лико_Планирование.ОтправитьПисьмо(текст, Тема, Объект.Менеджер);
		
		// Нужно найти записи с пустой ДатаОбработкиЭтапа и заполнить дату
		Если ЭтапДоБлокировки = Справочники.Лико_ЭтапыВыполненияЗаказа.ОПП ИЛИ ЭтапДоБлокировки = Справочники.Лико_ЭтапыВыполненияЗаказа.КонтрольОТК Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Лико_ЭтапыЗаказа.Период КАК Период,
			|	Лико_ЭтапыЗаказа.Заказ КАК Заказ,
			|	Лико_ЭтапыЗаказа.Площадка КАК Площадка
			|ИЗ
			|	РегистрСведений.Лико_ЭтапыЗаказа КАК Лико_ЭтапыЗаказа
			|ГДЕ
			|	Лико_ЭтапыЗаказа.Заказ = &Заказ
			|	И Лико_ЭтапыЗаказа.Этап = &Этап
			|	И Лико_ЭтапыЗаказа.Период >= &ДатаНачалаИспользованияНовойСхемыЭтаповЗаказа
			|	И Лико_ЭтапыЗаказа.ДатаОбработкиЭтапа = ДАТАВРЕМЯ(1, 1, 1)
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период";
			
			Запрос.УстановитьПараметр("ДатаНачалаИспользованияНовойСхемыЭтаповЗаказа", Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияНовойСхемыЭтаповЗаказа.ЗначениеПараметра);
			Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
			Запрос.УстановитьПараметр("Этап", ЭтапДоБлокировки);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				МенеджерЗаписи = РегистрыСведений.Лико_ЭтапыЗаказа.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаДетальныеЗаписи);
				МенеджерЗаписи.Прочитать();
				МенеджерЗаписи.ДатаОбработкиЭтапа = ТекущаяДата();
				МенеджерЗаписи.Записать(Истина);
			КонецЦикла;
		КонецЕсли;
	Исключение
		Сообщить(ПричинаБлокировкиНаименование = ". Заблокировать заказ не удалось");
	КонецПопытки;
			
КонецПроцедуры

&НаСервере
Процедура ПроверкаТермоусадки() 
		
	МассивПричин = новый массив;
	
	Причина1 = " с белилами 3361 с грамматурой вала больше 10 ";   
	Причина2 = " с белилами 3411 с грамматурой вала больше 10 ";
	Причина3 = " с несколькими белилами 3361 ";	
    Причина4 = " с несколькими белилами грамматурой больше 15 ";
	
	Массив3361 = Объект.Цвета.НайтиСтроки(Новый Структура("ТипКраски", Справочники.ЦеновыеГруппы.НайтиПоКоду("3361")));
    Массив3411 = Объект.Цвета.НайтиСтроки(Новый Структура("ТипКраски", Справочники.ЦеновыеГруппы.НайтиПоКоду("3411")));
	
	//«с белилами с грамматурой вала больше 10» 
	Триггер = Ложь;
	Для каждого стр из Массив3361 Цикл	
		Если  стр.Грамматура > 10 Тогда 
			Триггер = Истина;	
		КонецЕсли; 
	КонецЦикла;	
	Если Триггер Тогда  
		МассивПричин.Добавить(Причина1);
	КонецЕсли;

	Триггер = Ложь;	
	Для каждого стр из Массив3411 Цикл
		Если  стр.Грамматура > 10 Тогда 
			Триггер = Истина;		
		КонецЕсли; 	
	КонецЦикла;
	Если Триггер Тогда  
		МассивПричин.Добавить(Причина2);
	КонецЕсли;
	
	//«с несколькими белилами 3361» 
	Если Массив3361.Количество() > 1  Тогда 
		МассивПричин.Добавить(Причина3);
	КонецЕсли;  
		
	
	//«с несколькими белилами грамматурой больше 15» 
	Если Массив3411.Количество() > 1  Тогда 
		СуммаГрамматура = 0;
		Для каждого стр из Массив3411 Цикл 
			СуммаГрамматура = СуммаГрамматура + стр.Грамматура;	 
		КонецЦикла;
		Если СуммаГрамматура > 15 Тогда
			МассивПричин.Добавить(Причина4);
		КонецЕсли;
	КонецЕсли;
	
	Если МассивПричин.Количество() > 0 Тогда
		ОтправитьПисьмо(СтрШаблон("Выписан заказ на термоусадку %1, %2", объект.НомерБезПрефикса, СтрСоединить(МассивПричин, Символы.ПС))
		,СтрШаблон("Выписан заказ на термоусадку %1 ", объект.НомерБезПрефикса)
		,"azjukov@okil-sato.ru"); 
	КонецЕсли;

	
КонецПроцедуры

