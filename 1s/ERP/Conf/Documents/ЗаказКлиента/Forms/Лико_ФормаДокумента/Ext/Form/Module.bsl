	аналоговые = 0;
	Цифровые = 0;
	ВысокаяПечать = 0;
	ОфсетнаяПечать = 0;
	ГлубокаяПечать = 0;
	НовыхСеток = 0;
	ПолотноОфсетное = 0;
	ПолотноДляТиснения = 0;
	Для каждого стр из Объект.ИзготовлениеФорм Цикл
		Если стр.ВидФормы = перечисления.Лико_ВидыФорм.Аналоговые Тогда 
			аналоговые  = аналоговые+стр.КоличествоНовых+стр.КоличествоПеределок;
		ИначеЕсли стр.ВидФормы = перечисления.Лико_ВидыФорм.Цифровые Тогда 
			Цифровые  = Цифровые+стр.КоличествоНовых+стр.КоличествоПеределок;
		ИначеЕсли стр.ВидФормы = перечисления.Лико_ВидыФорм.ВысокаяПечать Тогда 
			ВысокаяПечать  = ВысокаяПечать+стр.КоличествоНовых+стр.КоличествоПеределок;
		ИначеЕсли стр.ВидФормы = перечисления.Лико_ВидыФорм.ОфсетнаяПечать Тогда 
			ОфсетнаяПечать  = ОфсетнаяПечать+стр.КоличествоНовых+стр.КоличествоПеределок;
		ИначеЕсли стр.ВидФормы = перечисления.Лико_ВидыФорм.ГлубокаяПечать Тогда 
			ГлубокаяПечать  = ГлубокаяПечать+стр.КоличествоНовых+стр.КоличествоПеределок;
		КонецЕсли;
	КонецЦикла;
	КоличествоЗасветок = 0;
	Для каждого стр из Объект.ЗасветкаStork Цикл
		Если стр.Засветка Тогда
			КоличествоЗасветок = КоличествоЗасветок+1;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого стр из Объект.ТрафСетки Цикл
		НовыхСеток = НовыхСеток+ стр.НовыхСеток;
	КонецЦикла;
	

	// --> Начало Лико Ефимов ЕВВ 28.06.2018
	ЗаполнитьКоличествоКоробокИРоликовИзДокументовОтгрузок();	
	// <-- Конец Лико Ефимов ЕВВ 28.06.2018
	
КонецПроцедуры


&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если ТекущаяСтраница.Имя = "ГруппаОтгрузки" Тогда 
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 
			ОбновитьИтогиОтгрузки();
			ОбновитьИтоги();
			Для каждого стр из Объект.Отгрузки Цикл
				стр.кодматериала =ПОлучитьКодМатериалаНаСервере(стр.ОсновнойМатериал);

			КонецЦикла;		
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


Процедура ОбновитьИтогиОтгрузки()
	Заказано    = Объект.Товары.Итог("Количество");
	Запрос = новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(Лико_Отгрузки.Количество) КАК Количество,
	|	СУММА(Лико_Отгрузки.МетражКВМ) КАК МетражКВМ
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.Лико_Отгрузки КАК Лико_Отгрузки
	|ГДЕ
	|	Лико_Отгрузки.Заказ = &Заказ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СУММА(Лико_Отгрузки2Обороты.КоличествоОборот + Лико_Отгрузки2Обороты.КоличествоСписаноОборот),
	|	СУММА(Лико_Отгрузки2Обороты.МетражКВМОборот + Лико_Отгрузки2Обороты.МетражКВМСписаноОборот)
	|ИЗ
	|	РегистрНакопления.Лико_Отгрузки2.Обороты(, , , Заказ = &Заказ) КАК Лико_Отгрузки2Обороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТ.Количество) КАК Количество,
	|	СУММА(ВТ.МетражКВМ) КАК МетражКВМ
	|ИЗ
	|	ВТ КАК ВТ";
	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Отгружено    	= Результат.Количество;
    	ОтгруженоКвМ = Результат.МетражКВМ;
	КонецЕсли;	
		
КонецПроцедуры


&НаСервере  
Функция НайтиЗаказНаОснастку()
	ЗаказНаОснастку = Документы.Лико_ЗаказОснастки.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лико_ЗаказОснасткиОснастка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лико_ЗаказОснастки.Оснастка КАК Лико_ЗаказОснасткиОснастка
	|ГДЕ
	|	Лико_ЗаказОснасткиОснастка.Заказ = &Заказ";
	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.Ссылка) ТОгда
			ЗаказНаОснастку =  Результат.Ссылка;
		КонецЕсли;
	КонецЕсли;
	Возврат ЗаказНаОснастку;		
КонецФункции

&НаСервере
Функция ПроверитьЗаполнениеРеквизитовДляЗаказаНаОснастку()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЗаказКлиентаЦвета.Оснастка КАК Оснастка,
	               |	ЗаказКлиентаЦвета.ЗаказНовойОснастки КАК ЗаказНовойОснастки
	               |ИЗ
	               |	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	               |ГДЕ
	               |	ЗаказКлиентаЦвета.Ссылка = &Заказ
	               |	И (НЕ ЗаказКлиентаЦвета.Оснастка ЕСТЬ NULL
	               |				И ЗаказКлиентаЦвета.Оснастка <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |			ИЛИ ЗаказКлиентаЦвета.ЗаказНовойОснастки)"	;
	Запрос.УстановитьПараметр("Заказ",Объект.Ссылка);
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 0 Тогда
		Возврат Ложь
	Иначе
		Возврат Истина;
	КонецЕсли;	
КонецФункции

&НаКлиенте
Процедура СоздатьЗаказНаОснастку(Команда)
	Если ЭтаФорма.Модифицированность Тогда
		Сообщить("Необходимо записать документ!");
		Возврат;
	КонецЕсли;	
	Если ПроверитьЗаполнениеРеквизитовДляЗаказаНаОснастку() Тогда
		ЗаказНаОснастку = НайтиЗаказНаОснастку();
		Если ЗначениеЗаполнено(ЗаказНаОснастку) ТОгда		
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОНаличииЗаказаНаОснастку", ЭтаФорма, Параметры);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Для данного заказ покупателя уже есть заказ оснастки. Создать еще один?'"), Режим,0);
		Иначе	
			ПараметрыЗаполнения = Новый Структура("Основание", Объект.Ссылка);
			ОткрытьФорму("Документ.Лико_ЗаказОснастки.Форма.ФормаДокумента", ПараметрыЗаполнения);
		КонецЕсли;
	Иначе
		Сообщить("Для заказа Оснастки заполните поле ""Оснастка"" (для Перезаказа), либо поле ""Нов"" (для заказа Новой оснастки)");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОНаличииЗаказаНаОснастку(Результат, ДопПараметры)  Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
   	Иначе	
		ПараметрыЗаполнения = Новый Структура("Основание", Объект.Ссылка);
		ОткрытьФорму("Документ.Лико_ЗаказОснастки.Форма.ФормаДокумента", ПараметрыЗаполнения);
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ПроверитьНаличиеОснастки(Команда)
	ВыполняемаяОбработка=НайтиВПФ("Отчет ""Проверка оснастки""");
	Если ВыполняемаяОбработка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВыполняемаяОбработка);
	ДопПараметры = Новый Структура("Заказ", Объект.Ссылка);
	ОткрытьФорму("ВнешнийОтчет." + ИмяОбработки + ".Форма",ДопПараметры);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗаказыОснастки(Команда)
	ПараметрыФормы    = новый Структура("Заказ", Объект.Ссылка);
	ОткрытьФорму("Документ.Лико_ЗаказОснастки.ФормаСписка", ПараметрыФормы,,,,,,
						РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);	
