&НаСервереБезКонтекста
Функция ПолучитьКоличествоРучьев(Нумератор, РабочийЦентр) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	&РабочийЦентр КАК РабочийЦентр
	|ПОМЕСТИТЬ ВТРЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РабочиеЦентры.ВидРабочегоЦентра
	|ИЗ
	|	Справочник.РабочиеЦентры КАК РабочиеЦентры
	|ГДЕ
	|	РабочиеЦентры.Ссылка = &РабочийЦентр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Лико_ТипыНумераторовРабочиеЦентры.РабочийЦентр КАК РабочийЦентр,
	|	Лико_ТипыНумераторовРабочиеЦентры.МаксимальноеКоличествоРучьев КАК МаксимальноеКоличествоРучьев,
	|	Лико_ТипыНумераторовРабочиеЦентры.РабочийЦентр.Родитель КАК РабочийЦентрРодитель
	|ИЗ
	|	ВТРЦ КАК ВТРЦ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ТипыНумераторов.РабочиеЦентры КАК Лико_ТипыНумераторовРабочиеЦентры
	|		ПО ВТРЦ.РабочийЦентр = Лико_ТипыНумераторовРабочиеЦентры.РабочийЦентр
	|ГДЕ
	|	Лико_ТипыНумераторовРабочиеЦентры.Ссылка = &Нумератор
	|	И Лико_ТипыНумераторовРабочиеЦентры.МаксимальноеКоличествоРучьев > 0
	|	И Лико_ТипыНумераторовРабочиеЦентры.Ссылка.ПометкаУдаления <> ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	РабочийЦентрРодитель УБЫВ";
	
	Запрос.УстановитьПараметр("Нумератор", Нумератор);  
	Запрос.УстановитьПараметр("РабочийЦентр", РабочийЦентр);    
	
	Результат = Запрос.Выполнить();  
	

	
