	// <-- Конец Лико Яцун С. В. 24.03.2025
	// <-- Начало Лико Яцун С. В. 10.12.2025 
	Если ЗадатьВопросОбИзмененииСтавкиНДС Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросОбИзмененииСтавкиНДС", ЭтотОбъект),"Меняется ставка НДС, увеличить цену?",РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 10.12.2025
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.Свойство("ЗаписьПослеОтветаНаВопросОбИзмененииНДС") Тогда
		Возврат;
	КонецЕсли;
	
	ПроверкиИОбработкиПередЗаписью(Отказ,ПараметрыЗаписи);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	DFMКлиент.ПередЗаписью(ЭтаФорма,Отказ);
	////Подсистема DFM
					
	Если ЗначениеЗаполнено(Объект.ДатаОтправкиВРаботу) И НЕ ПроверитьДоступностьНаСервере("ПолныеПрава") Тогда 	
			//--> o.pukhova 05042021
			//Добавили возможность изменения собственных выполненных заказов Менеджера
			//Если Не (ПроверитьДоступностьНаСервере("Лико_ЗакрытиеОтгрузки") ИЛИ (ПроверитьДоступностьНаСервере("Лико_ИзменениеВыполненныхЗаказов") И ПользователиКлиентСервер.ТекущийПользователь() <> Объект.Менеджер)) Тогда 
			Если Не (ПроверитьДоступностьНаСервере("Лико_ЗакрытиеОтгрузки") ИЛИ ПроверитьДоступностьНаСервере("Лико_ИзменениеВыполненныхЗаказов")) Тогда 
				Если Объект.Состояние = ПредопределенноеЗначение("Перечисление.Лико_СостоянияЗаказов.Выполнен") ИЛИ Объект.Состояние = ПредопределенноеЗначение("Перечисление.Лико_СостоянияЗаказов.Закрыт") Тогда
					Сообщить("Данный заказ уже выполнен!");	
					Отказ = Истина;
				ИначеЕсли НЕ ПараметрыЗаписи.Свойство("БылВопросПередЗаписью") ТОгда
						Отказ = Истина;
						//Режим = РежимДиалогаВопрос.ДаНет;
						//Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОПереотправкеВРаботу", ЭтаФорма,Параметры);
						//ПоказатьВопрос(Оповещение, НСтр("ru = 'Данный заказ находится на производстве, 
						//|при его изменении необходимо направить его новую версию в работу. 
						//|Направить заказ в работу?'"), Режим,0);  
						
						//+ Субботин 11.10.22
						ВыполняемаяОбработка = НайтиВПФ("Обработка ""Причины замены заказов""");
						Если ВыполняемаяОбработка.Пустая() Тогда
							Возврат;
						КонецЕсли;
						ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВыполняемаяОбработка);
						ОповещениеЗакрытия = Новый ОписаниеОповещения("ПослеЗакрытияОбработкиПричиныЗаменыЗаказов", ЭтотОбъект);			
						ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма",  ,ЭтаФорма,,,,ОповещениеЗакрытия, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
						//-	Субботин 11.10.22
						
				КонецЕсли;	
			Иначе
				УсловиеНаправитьВработу = (Объект.Состояние = ПредопределенноеЗначение("Перечисление.Лико_СостоянияЗаказов.ВключенВПлан") ИЛИ Объект.Состояние = ПредопределенноеЗначение("Перечисление.Лико_СостоянияЗаказов.Выполняется"));
	            Пересчитать_ПереотправитьЗаказВРаботу(Отказ,УсловиеНаправитьВработу,Ложь) ;
				Прочитать(); 
			КонецЕсли;
	КонецЕсли; 

КонецПроцедуры 

&НаСервере
Процедура ПроверкиИОбработкиПередЗаписью(Отказ,ПараметрыЗаписи)

	// --> Начало Субботин 01.02.23 
	Если Объект.Дата<'20241231' Тогда  
		Отказ = Истина;
		Возврат;
    КонецЕсли;
		
	Если ЗначениеЗаполнено(Объект.ДатаОтправкиВРаботу) Тогда
		
		Если НЕ ЗначениеЗаполнено(объект.ДатаУтвержденияЦветов) Тогда 
			Сообщить("Цвета не утверждены");
			Отказ = Истина;
			Возврат;
		КонецЕсли;  
		
	КонецЕсли;  
	
	// --> Начало Лико Митюшин МФМ 05.07.2021
	Если Объект.Цвета.Количество() > 1 Тогда 
		НайденныеСтрокиНомерПроката = Объект.Цвета.НайтиСтроки(Новый Структура("НомерПроката",1));
		Если НайденныеСтрокиНомерПроката.Количество() = 0 Тогда
			Сообщить("Должен быть указан 1й прокат!");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;   
	
	ПроверятьВнахлест = Ложь;	 
	ПЗ_ТипЭтикеток_Кльр = Перечисления.Лико_ТипыЭтикеток.Кльр;
	Для каждого стр из Объект.Товары цикл 
		Если стр.Номенклатура.Лико_ТипЭтикетки = ПЗ_ТипЭтикеток_Кльр Тогда  
			ПроверятьВнахлест = Истина;	
			Прервать;
		КонецЕсли;			
	КонецЦикла;
	Если ПроверятьВнахлест И НЕ ЗначениеЗаполнено(объект.Внахлест) Тогда
		ОбщегоНазначения.СообщитьПользователю("поле ""Внахлест"" не заполнено", ,"Объект.Внахлест");		
		Отказ = Истина;	
		Возврат
	КонецЕсли;

	//Подсистема DFM                        
	Массив = Новый Массив(); 
	Для каждого Товар Из Объект.Товары Цикл
		Массив.Добавить(Товар.Номенклатура);
	КонецЦикла;
	
	Объект.НоменклатураDFM = DFMСервер.ЭтоНоменклатураDFM(
	Объект.РабочийЦентр,
	Объект.ТипЗаказа,
	ДатаНачалаСозданияНоменклатурыDFM,
	Объект.ДатаПервойОтправкиВРаботу,
	Массив,
	Объект.Партнер);	

	//DFMКлиент.ПередЗаписью(ЭтаФорма,Отказ);
	//Подсистема DFM

	
	// --> Начало Лико Ефимов ЕВВ 12.11.2019
	ВыполнитьПроверкуСоответствияНоменклатурыИЗаявокНаОтгрузку(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 12.11.2019

	// Кэшируем предопределенные значения, чтобы не дергать сервер в условиях и циклах
	ПЗ_ВидЗаказа_ПолныйПовтор  = Перечисления.Лико_ВидыЗаказов.ПолныйПовтор;
	ПЗ_ВидЗаказа_ПовторСИзм    = Перечисления.Лико_ВидыЗаказов.ПовторСИзменением;
	ПЗ_ВидЗаказа_Пробник       = Перечисления.Лико_ВидыЗаказов.Пробник;
	ПЗ_ВидЗаказа_Шаблон        = Перечисления.Лико_ВидыЗаказов.Шаблон;
	ПЗ_ТипЗаказа_Термоусадка   = Перечисления.Лико_ТипыЗаказов.Термоусадка;
	ПЗ_ВидТМЦ_Краска           = Справочники.Лико_ВидыТМЦ.Краска;
	
	// --> Начало Лико Ефимов ЕВВ 29.12.2020
	Если Объект.ВидЗаказа = ПЗ_ВидЗаказа_Пробник И НЕ ЗначениеЗаполнено(Объект.ВариантОтгрузки) Тогда
		ОбщегоНазначения.СообщитьПользователю("Для пробников необходимо заполнить вариант отгрузки", , "Объект.ВариантОтгрузки");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 29.12.2020
 	//--> o.pukhova 23042021	
	Если Объект.ТипЗаказа = ПЗ_ТипЗаказа_Термоусадка И Объект.ВидЗаказа <> ПЗ_ВидЗаказа_Пробник 
		И Объект.Цвета.Количество()>0 И НЕ Объект.ПоперечнаяРезкаТУ И Объект.Товары.Количество() > 0 И НЕ Объект.Товары[0].ПоперечнаяРезка Тогда
		Если Не ПроверитьКоректностьНаправленияТермоусадки() Тогда
			Сообщить("Для термоусадки необходимо выбирать напрвлене намотки, предназначенное только для термоусадки.");
			Отказ = Истина;
		КонецЕсли;	
	КонецЕсли;
	//<-- o.pukhova 23042021
	//--> o.pukhova 14052021	
	Если НЕ Объект.ЧестныйЗнак И ПроверитьНаличиеGTin() Тогда
		Сообщить("Вы заполнили GTin, необходимо поставить отметку Честный знак ");
		Отказ = Истина;
	КонецЕсли;
	
	Если Объект.Площадка = Справочники.Лико_Площадки.Ликофлекс И ВидРЦИндиго(Объект.РабочийЦентр) Тогда 
		МассивРазныхНоменклатур = Новый Массив;
		Для каждого Стр из Объект.Товары Цикл
			Если МассивРазныхНоменклатур.Найти(Стр.Номенклатура) = Неопределено Тогда
				МассивРазныхНоменклатур.Добавить(Стр.Номенклатура);	
			КонецЕсли;
		КонецЦикла;
		Если МассивРазныхНоменклатур.Количество() > 2 И Объект.ВидЗаказа <> ПЗ_ВидЗаказа_Шаблон И НЕ ПроверитьНаОдинаковыеGTin() Тогда
			Сообщить("Номера GTin в одном заказе должны быть одинаковыми!");
			Отказ = Истина;  
		КонецЕсли;
	КонецЕсли;
	//<-- o.pukhova 14052021
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ДокументНовый = НЕ ЗначениеЗаполнено(Объект.Ссылка);
	
	Если ДокументНовый Тогда
			// <-- Начало Лико Яцун С. В. 21.01.2026
		Если НуженРасчетНарезки(Объект.ВидЗаказа) Тогда
			Если Объект.ВидЗаказа <> ПЗ_ВидЗаказа_ПолныйПовтор Тогда
				Объект.РучнойВводНарезки = Неопределено;
			КонецЕсли;
			//РучнойВводНарезкиПриИзменении(Неопределено);
			Если ЗначениеЗаполнено(Объект.ШтампВырубной) Тогда
				Объект.НарезкаРасчетная = Неопределено;
				Объект.Нарезка = Неопределено;
			КонецЕсли;
			// <-- Конец Лико Яцун С. В. 21.01.2026
		КонецЕсли;
	КонецЕсли;

	УсловиеПоВидуЗаказа = (Объект.ВидЗаказа <> ПЗ_ВидЗаказа_ПолныйПовтор И Объект.ВидЗаказа <> ПЗ_ВидЗаказа_ПовторСИзм);
	Если (ДокументНовый И УсловиеПоВидуЗаказа) 
		ИЛИ НЕ Объект.ЧестныйЗнак 
		ИЛИ Объект.Цифровой Тогда
		Объект.ЗаказчикЭмиссииЧЗ = Неопределено;	
		Объект.ЭмитентЧЗ = Неопределено;	
		Объект.СтранаТовараЧЗ = Неопределено;	
		Объект.ТипКодаЧЗ = Неопределено;	
		Объект.ТипМаркировкиЧЗ = Неопределено;	
	КонецЕсли;
		
	СоответствиеВС = Новый Соответствие;
	
	Для каждого стр из Объект.Цвета Цикл
		// <-- Начало Лико Яцун С. В. 07.03.2024 
		//Если ЗначениеЗаполнено(Стр.ТипЗаливка) И Стр.ТипЗаливка = ПредопределенноеЗначение("Перечисление.Лико_ВидЗаливки.Сплошная") 
		//	И ЗначениеРеквизита(Стр.ВидСекции,"Родитель") <> ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Глубокая") 
		//	И НЕ Объект.Площадка = ГлЛико_Площадки.Урал Тогда
		//	стр.Форма = Неопределено;	
		//КонецЕсли;
		// <-- Конец Лико Яцун С. В. 07.03.2024
		Если стр.ВидСекции.ОтображатьВТЧРаботы Тогда 
			СоотвНомерПроката = СоответствиеВС[Стр.ВидСекции];
			Если СоотвНомерПроката = Неопределено Тогда
				СоотвНомерПроката = Новый Соответствие;
				СоответствиеВС.Вставить(Стр.ВидСекции, СоотвНомерПроката);
			КонецЕсли;
			
			НомерРаботы = СоотвНомерПроката[Стр.НомерПроката];
			НомерРаботы = ?(НомерРаботы = Неопределено, 1, НомерРаботы + 1);
			
			СоотвНомерПроката.Вставить(Стр.НомерПроката, НомерРаботы);
			Стр.НомерРаботы = НомерРаботы;       
		Иначе 
			стр.НомерРаботы = 1;
		КонецЕсли;                                                                                 
	КонецЦикла;
	
	// <-- Начало Лико Яцун С. В. 18.03.2024
	НоменклатураDatamatrix = Ложь; 
	Для Каждого Стр из Объект.Товары Цикл
		Если Найти(НРег(Строка(Стр.Номенклатура)),"datamatrix") <> 0 Тогда
			НоменклатураDatamatrix = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Объект.Datamatrix = НоменклатураDatamatrix;
	// <-- Конец Лико Яцун С. В. 18.03.2024 
	
	//ДоступностьУтилизироватьИзлишки(); //Выполняется в процедуре РасчитатьТиражМетраж()
	
	// <-- Начало Лико Яцун С. В. 28.10.2024 
	Если Объект.ЧестныйЗнак И НЕ Объект.ЧЗ И Объект.ШиринаЭтикетки <= 25 И Объект.ДлинаЭтикетки <= 25 Тогда
		НайденныеСтроки = Объект.Цвета.НайтиСтроки(Новый Структура("ВидТМЦ",ПЗ_ВидТМЦ_Краска));
		Если НайденныеСтроки.Количество() = 1 Тогда
			Объект.ЧЗ = Истина; 	
		КонецЕсли;
	ИначеЕсли Объект.ЧЗ Тогда
		НайденныеСтроки = Объект.Цвета.НайтиСтроки(Новый Структура("ВидТМЦ",ПЗ_ВидТМЦ_Краска));
		Если НЕ Объект.ЧестныйЗнак ИЛИ Объект.ШиринаЭтикетки > 25 ИЛИ Объект.ДлинаЭтикетки > 25 ИЛИ НайденныеСтроки.Количество() <> 1 Тогда
			Объект.ЧЗ = Ложь; 	
		КонецЕсли;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 28.10.2024
	
	//250423 
	Если НЕ ДокументНовый 
		И (Объект.Состояние = Перечисления.Лико_СостоянияЗаказов.ВключенВПлан 
		ИЛИ Объект.Состояние = Перечисления.Лико_СостоянияЗаказов.Выполняется
		ИЛИ Объект.Состояние = Перечисления.Лико_СостоянияЗаказов.Создан) Тогда
			
		ЗаказНаОснастку = ПолучитьЗаказНаОснастку(объект.Ссылка);
		МатериалДоЗамены = ПолучитьОсновнойМатериалДоЗамены(объект.Ссылка);
		Если МатериалДоЗамены <> объект.ОсновнойМатериал и ЗаказНаОснастку <> неопределено Тогда 
			ТекстПисьма = СтрШаблон("В заказе %1, по которому оформлены заявка на оснастку %2, изменился материал. Был %3, стал %4.",
									объект.НомерБезПрефикса, ЗаказНаОснастку, МатериалДоЗамены,  объект.ОсновнойМатериал);
			ТемаПисьма = СтрШаблон("Изменился материал в заказе %1", объект.НомерБезПрефикса);
			ОтправитьПисьмо(ТекстПисьма,ТемаПисьма,"ddavydov@okil-sato.ru");
		КонецЕсли;  
	КонецЕсли;
	// <-- Конец Субботин 01.02.23
	
	//+ Лико m.shenderov 29.12.2020
	СформироватьАвтоМонтаж(Отказ);
	//- Лико m.shenderov 29.12.2020
				
	Объект.НомерБезПрефикса = Прав(Объект.Номер,7);
	
	Объект.КоэффициентПеремотки = ПолучитьКоэффициентПеремотки();
	Если НЕ ДокументНовый Тогда
		Для каждого стр из Объект.Товары Цикл
			Если НоменклатураЯвляетсяГП(стр.номенклатура) Тогда 
				ЗаполнятьХарактеристику = ЛОжь;
				Если Не ЗначениеЗаполнено(стр.Характеристика) Тогда 
					заполнятьхарактеристику = истина; 
				Иначе
					ЗначенияРеквизитовХарактеристики = Лико_Дополнительно.ЗначенияРеквизитовОбъекта(стр.Характеристика,"Лико_ЗаказНоменклатуры,Владелец,Наименование");
					Если ЗначенияРеквизитовХарактеристики.Лико_ЗаказНоменклатуры <> Объект.Ссылка Тогда
						заполнятьхарактеристику = истина; 
					КонецЕсли;
					Если ЗначенияРеквизитовХарактеристики.Владелец <> стр.номенклатура Тогда 
						заполнятьхарактеристику = истина; 
					КонецЕсли;
				КонецЕсли;
				Если ЗаполнятьХарактеристику Тогда 
					стр.характеристика = ПолучитьХарактеристикуНаСервере(стр.номенклатура);
				Иначе 
					Если ЗначенияРеквизитовХарактеристики.Наименование <> "Заказ " + Объект.НомерБезПрефикса Тогда 
						УточнитьНаименованиеХарактеристики(стр.Характеристика, Объект.НомерБезПрефикса);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	РасчитатьТиражМетраж(); 
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если НЕ Отказ Тогда
		ПроверитьЧестныеЗнаки(ТекущийОбъект);
		Если ТекущийОбъект.ПоставщикМатериалаЛюбой Тогда
			ТекущийОбъект.СвойстваМатериала = Неопределено;
		ИначеЕсли ЗначениеЗаполнено(СвойстваМатериалаДляХранилища) Тогда
			ТекущийОбъект.СвойстваМатериала = Новый ХранилищеЗначения(СвойстваМатериалаДляХранилища.МассивОтборовСвойствМатериалов);
