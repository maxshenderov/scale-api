	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НаработкиИзРегистра КАК ВТ_НаработкиИзРегистра
	|		ПО ВТ_ОбщийОстаточныйПробег.Номенклатура = ВТ_НаработкиИзРегистра.Штамп
	|ГДЕ
	|	ВТ_ОбщийОстаточныйПробег.ОстаточтныйПробег - ЕСТЬNULL(ВТ_ПробегПлан.ПробегПлан, 0) + ЕСТЬNULL(ВТ_Оснастки.КоличествоЗаказОснастка, 0) * ЕСТЬNULL(ВТ_НаработкиИзРегистра.НормативПробега, 0) < 0
	|	И ЕСТЬNULL(ВТ_НаработкиИзРегистра.НормативПробега, 0) <> 0";
	
	Запрос.УстановитьПараметр("Штампы", 	МассивШтампов);
	Запрос.УстановитьПараметр("Заказ", 		Объект.Ссылка);
	Запрос.УстановитьПараметр("ТЗ",			текТабЗначений);   
////Надо разобраться, что это за Площадка Иванова 20241003	
	Запрос.УстановитьПараметр("Площадка",	Объект.Площадка.Организация);
	Выборка = Запрос.Выполнить();	
	
	Если Выборка.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТабВыгрузки = Выборка.Выгрузить();
    Для каждого КолонкаТЗ Из ТабВыгрузки.Колонки Цикл
    	СтруктураСНормативом.Вставить(КолонкаТЗ.Имя, ТабВыгрузки[0][КолонкаТЗ.Имя]);
	КонецЦикла; 
	
	Если ТабВыгрузки.Количество() > 0 Тогда 
		Возврат Истина;	
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции		// <-- Конец Лико Митюшин МФМ 29.07.2021

