Процедура Пантоны(Команда)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		ЗначениеОтбора = Новый Структура("Номенклатура", ТекущаяСтрока.Номенклатура);
		ПараметрыОткрытияФормы = Новый Структура("Отбор", ЗначениеОтбора);
		ОткрытьФорму("РегистрСведений.Лико_ПантоныНоменклатуры.ФормаСписка",ПараметрыОткрытияФормы,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПантоныНаСервере()
	
	ТЗ = Объект.Товары.Выгрузить(,"Номенклатура");
	ТЗ.Свернуть("Номенклатура");
	МассивНоменклатур = ТЗ.ВыгрузитьКолонку("Номенклатура");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ПантоныНоменклатуры.ВидСекции КАК ВидСекции,
		|	Лико_ПантоныНоменклатуры.Пантон КАК Пантон
		|ИЗ
		|	РегистрСведений.Лико_ПантоныНоменклатуры КАК Лико_ПантоныНоменклатуры
		|ГДЕ
		|	Лико_ПантоныНоменклатуры.Номенклатура В(&Номенклатура)
		|
		|СГРУППИРОВАТЬ ПО
		|	Лико_ПантоныНоменклатуры.ВидСекции,
		|	Лико_ПантоныНоменклатуры.Пантон";
	
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатур);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если Объект.Цвета.НайтиСтроки(Новый Структура("Название",ВыборкаДетальныеЗаписи.Пантон)).Количество() = 0 Тогда
			НС = Объект.Цвета.Добавить();
			НС.Название = ВыборкаДетальныеЗаписи.Пантон;
			НС.ВидСекции = ВыборкаДетальныеЗаписи.ВидСекции;
			Если Объект.Цвета.Количество() <> 0 Тогда
				НС.РабочийЦентр = Объект.Цвета[0].РабочийЦентр;
			КонецЕсли;
			НС.НомерПроката = 1;
			НС.НомерВарианта = 1;
			НС.ВидТМЦ = Справочники.Лико_ВидыТМЦ.Краска;
			НС.ТипЦвета1 = Справочники.Лико_ТипыЦвета.Pmc;
			НС.КлючСтроки = Новый УникальныйИдентификатор; 
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
	КонецЦикла;
	Если ЭтаФорма.Модифицированность Тогда
		ЗаполнитьВидОснастка();
		ЗаполнитьТипЗаливка(); 
	КонецЕсли;

КонецПроцедуры

