		|	Лико_БланкЭтапаТовары.Ссылка КАК Бланк
		|ИЗ
		|	Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
		|ГДЕ
		|	Лико_БланкЭтапаТовары.Списать = ИСТИНА
		|	И Лико_БланкЭтапаТовары.Ссылка.ЗаказПокупателя = &Заказ
		|	И Лико_БланкЭтапаТовары.Номенклатура.ВидНоменклатуры.Лико_РулонныйМатериал = ИСТИНА
		|	И Лико_БланкЭтапаТовары.Ссылка.Проведен = ИСТИНА
		|	И Лико_БланкЭтапаТовары.Номенклатура.ВидНоменклатуры <> &ВидНоменклатуры
		|
		|СГРУППИРОВАТЬ ПО
		|	Лико_БланкЭтапаТовары.Номенклатура,
		|	Лико_БланкЭтапаТовары.Ссылка.ЗаказПокупателя,
		|	Лико_БланкЭтапаТовары.Ссылка,
		|	ВЫБОР
		|		КОГДА Лико_БланкЭтапаТовары.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Печать)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ОсновнойМатериал)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ДополнительныеМатериалы)
		|	КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтатьяЗатрат";
	
	Запрос.УстановитьПараметр("ВидНоменклатуры", Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра);
	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат Истина;
	КонецЦикла;
	
	Возврат Ложь;
	
	//Схема = Элементы.ЗакрытыеМатериалы.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
