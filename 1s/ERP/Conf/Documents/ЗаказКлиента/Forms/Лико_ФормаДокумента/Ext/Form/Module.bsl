&НаКлиенте
Процедура РасчетТиражейДоходностьПриИзменении(Элемент) // --> Начало Лико Яцун 14.12.2022
	
	ТекСтр = Элементы.РасчетТиражей.ТекущиеДанные;
	текстр.доход = текстр.доходность*текстр.время; 
	текстр.стоимость = (текстр.доход+текстр.себестоимость)/К_Дох;
	текстр.Цена = текстр.стоимость/текстр.тираж; 
	текстр.ЦенаБезНДС = текстр.Цена *100/122; 
	Если ЗначениеЗаполнено(текстр.МетражКВМ) Тогда 
		текстр.ЦенаМ2 = текстр.стоимость/текстр.МетражКВМ;
    КонецЕсли;

	текстр.рентабельность = Окр(текстр.Доход/текстр.стоимость*100,2);
	
КонецПроцедуры // <-- Конец Лико Яцун 14.12.2022

&НаКлиенте
Процедура РасчетТиражейРентабельностьПриИзменении(Элемент) // --> Начало Лико Яцун 14.12.2022
	
	ТекСтр = Элементы.РасчетТиражей.ТекущиеДанные; 
	СтоимостьФакторинга = К_Факторинг*текстр.стоимость;
	текстр.стоимость = (текстр.Себестоимость-СтоимостьФакторинга) / (К_Дох -К_Факторинг-текстр.рентабельность / 100)  ;	
	текстр.Цена = текстр.стоимость/текстр.тираж; 
	текстр.ЦенаБезНДС = текстр.Цена*100/122;	
	Если ЗначениеЗаполнено(текстр.МетражКВМ) Тогда 
		текстр.ЦенаМ2 = текстр.стоимость/текстр.МетражКВМ;
    КонецЕсли;
    текстр.себестоимость =  текстр.себестоимость-СтоимостьФакторинга +К_Факторинг*текстр.стоимость;
	текстр.Доход = текстр.стоимость*К_Дох - текстр.себестоимость;   
	Если ЗначениеЗаполнено(текстр.Время) Тогда 
		текстр.Доходность = текстр.Доход/текстр.Время;
	КонецЕсли;  
	
КонецПроцедуры // <-- Конец Лико Яцун 14.12.2022

