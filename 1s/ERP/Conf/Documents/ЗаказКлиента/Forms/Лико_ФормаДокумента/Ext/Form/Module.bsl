    СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, "НачалоВыбораИзСписка");
    СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, "Очистка");
    СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, "Выбор");
    СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, "Регулирование");
    СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, "Открытие");
    СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, "ОбработкаВыбора");
    СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, "АвтоПодбор");
    СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, "ОкончаниеВводаТекста");
    СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, "ПриОбновленииСоставаПользовательскихНастроекНаСервере");
    СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, "ПриНачалеРедактирования");
    СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, "ПередНачаломДобавления");
    СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, "ПередНачаломИзменения");
    СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, "ПриАктивизацииСтроки");
    
КонецПроцедуры 

&НаСервере
Процедура СкопироватьСобытие(ЭлементПриемник, ЭлементИсточник, ИмяСобытия) 
    
    Действие = ЭлементИсточник.ПолучитьДействие(ИмяСобытия);
    
    Если Действие <> "" Тогда
        ЭлементПриемник.УстановитьДействие(ИмяСобытия, Действие);
    КонецЕсли; 
    
КонецПроцедуры

Процедура РазбитьСекцииНаПрокаты(НомерПроката) 
	
		
	ОтборПоНомерПроката = Объект.Секции.НайтиСтроки(новый Структура("НомерПроката", НомерПроката));	
	
	Если ОтборПоНомерПроката.Количество() <> 0 Тогда      
		
		МассивВидныВсегда = Новый Массив;
		МассивВидныВсегда.Добавить("ВидСекции"); 
		МассивВидныВсегда.Добавить("НомерСекции");
		МассивВидныВсегда.Добавить("ТипСекции");
		МассивВидныВсегда.Добавить("Подача");
		МассивВидныВсегда.Добавить("ЭтикетокВПодаче");
		
	
		Элементы["Прокат" + НомерПроката + "Секции"].ОтборСтрок = новый ФиксированнаяСтруктура("НомерПроката", НомерПроката);  		
		Элементы["ГруппаПрокат" + НомерПроката].Заголовок = "Прокат " + НомерПроката + " "  + строка(ОтборПоНомерПроката[0].РабочийЦентр);  
		//Элементы["ГруппаПрокат" + стрНомерПроката].Видимость = Истина;
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Лико_ВидыСекцийПараметрыСекций.ПараметрСекции.Наименование КАК ПараметрСекции
		|ИЗ
		|	Справочник.Лико_ВидыСекций.ПараметрыСекций КАК Лико_ВидыСекцийПараметрыСекций
		|ГДЕ
		|	Лико_ВидыСекцийПараметрыСекций.Ссылка В(&ПараметрыСекции)"; 
		
		ВидыСекцийПрокат = новый массив;
		Для Каждого стр из ОтборПоНомерПроката цикл  
			ВидыСекцийПрокат.Добавить(стр.ВидСекции);	
		КонецЦикла;
		
		Если ВидыСекцийПрокат.Количество() <>  0 Тогда 
					
			Запрос.УстановитьПараметр("ПараметрыСекции", ВидыСекцийПрокат);  
			
			текВыборка = Запрос.Выполнить();
			
			Если не  текВыборка.Пустой() Тогда
				
				текПараметрыСекции = текВыборка.Выгрузить().ВыгрузитьКолонку("ПараметрСекции");
				
				Для каждого ТекПараметр из Метаданные.Документы.ЗаказКлиента.ТабличныеЧасти.Секции.Реквизиты Цикл
					
					ИмяПараметра = ТекПараметр.Имя;  
					
					Если МассивВидныВсегда.Найти(ИмяПараметра) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Прокат" + НомерПроката +"Секции" + ИмяПараметра,   "Видимость", (текПараметрыСекции.Найти(ИмяПараметра) <> Неопределено));	
						
				КонецЦикла;	
				//    вр. изм.видимость = типпродукта.видимость 
