&НаКлиенте
Процедура ПроизводствоЭтикетокЗасчитаноПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Производство.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ПогМетровЗасчитано = 0;
		ТекущиеДанные.КвМетровЗасчитано = 0;
		Если ТекущиеДанные.КоличествоПМ <> 0 И ТекущиеДанные.Количество <> 0 И ТекущиеДанные.ЭтикетокЗасчитано <> 0 Тогда
			ТекущиеДанные.ПогМетровЗасчитано = РассчитатьМетражНаСервере(ТекущиеДанные.ЭтикетокЗасчитано * 1000,, ТекущиеДанные.РабочийЦентр);
			ТекущиеДанные.КвМетровЗасчитано = ТекущиеДанные.ПогМетровЗасчитано * ТекущиеДанные.НарезкаРазмер / 1000; 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизводствоПогМетровЗасчитаноПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Производство.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ЭтикетокЗасчитано = 0;
		ТекущиеДанные.КвМетровЗасчитано = 0;
		Если ТекущиеДанные.КоличествоПМ <> 0 И ТекущиеДанные.Количество <> 0 Тогда
			ТекущиеДанные.КвМетровЗасчитано = ТекущиеДанные.ПогМетровЗасчитано * ТекущиеДанные.НарезкаРазмер / 1000;
			ТекущиеДанные.ЭтикетокЗасчитано = РассчитатьТиражНаСервере(ТекущиеДанные.ПогМетровЗасчитано,, ТекущиеДанные.РабочийЦентр);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизводствоКвМетровЗасчитаноПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Производство.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ЭтикетокЗасчитано = 0;
		ТекущиеДанные.ПогМетровЗасчитано = 0;
		Если ТекущиеДанные.КоличествоПМ <> 0 И ТекущиеДанные.Количество <> 0 Тогда
			ТекущиеДанные.ПогМетровЗасчитано = ТекущиеДанные.КвМетровЗасчитано / ТекущиеДанные.НарезкаРазмер * 1000;
			ТекущиеДанные.ЭтикетокЗасчитано = РассчитатьТиражНаСервере(ТекущиеДанные.ПогМетровЗасчитано,, ТекущиеДанные.РабочийЦентр);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизводствоПриАктивизацииСтроки(Элемент)
	УстановитьПараметрыДинамическогоСпискаПроизводствоДетальныеЗаписи(Элементы.Производство.ТекущаяСтрока);		
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыДинамическогоСпискаПроизводствоДетальныеЗаписи(ТекущаяСтрока = Неопределено)

	Если ТекущаяСтрока = Неопределено Тогда
		ТекущийДанные = Неопределено;
	Иначе
		ТекущиеДанные = Объект.Производство.НайтиПоИдентификатору(ТекущаяСтрока);
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		ПроизводствоДетальныеЗаписи.Параметры.УстановитьЗначениеПараметра("Заказ", Объект.Ссылка);
		ПроизводствоДетальныеЗаписи.Параметры.УстановитьЗначениеПараметра("НомерПроката", Неопределено);
		ПроизводствоДетальныеЗаписи.Параметры.УстановитьЗначениеПараметра("НомерБланка", Неопределено);
		ПроизводствоДетальныеЗаписи.Параметры.УстановитьЗначениеПараметра("Сотрудник", Неопределено);
	Иначе
		ПроизводствоДетальныеЗаписи.Параметры.УстановитьЗначениеПараметра("Заказ", Объект.Ссылка);
		ПроизводствоДетальныеЗаписи.Параметры.УстановитьЗначениеПараметра("НомерПроката", ТекущиеДанные.НомерПроката);
		ПроизводствоДетальныеЗаписи.Параметры.УстановитьЗначениеПараметра("НомерБланка", ТекущиеДанные.НомерБланка);
		ПроизводствоДетальныеЗаписи.Параметры.УстановитьЗначениеПараметра("Сотрудник", ?(ЗначениеЗаполнено(ТекущиеДанные.СотрудникПоБланку), ТекущиеДанные.СотрудникПоБланку, ТекущиеДанные.Сотрудник));
	КонецЕсли;
	Элементы.ПроизводствоДетальныеЗаписи.Обновить();
	
КонецПроцедуры

