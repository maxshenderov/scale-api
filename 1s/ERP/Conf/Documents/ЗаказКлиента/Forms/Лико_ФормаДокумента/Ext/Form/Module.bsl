&НаСервере
Функция ПолучитьНоменклатуруGtinКодЭтикеткиЗаказчика(Лико_Gtin,Лико_КодЭтикеткиЗаказчика)
	
	Лико_GtinВНоменклатуре = Объект.Партнер.Лико_GtinВНоменклатуре И ЗначениеЗаполнено(Лико_Gtin);
	Лико_КодЭтЗаказчикаВНоменклатуре = Объект.Партнер.Лико_КодЭтЗаказчикаВНоменклатуре И ЗначениеЗаполнено(Лико_КодЭтикеткиЗаказчика);
	
	Если НЕ Лико_GtinВНоменклатуре И НЕ Лико_КодЭтЗаказчикаВНоменклатуре Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления
		|	И ВЫБОР
		|			КОГДА &GtinВНоменклатуре
		|				ТОГДА Номенклатура.Лико_Gtin = &Лико_Gtin
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &КодЭтикеткиЗаказчикаВНоменклатуре
		|				ТОГДА Номенклатура.Лико_КодЭтикеткиЗаказчика = &Лико_КодЭтикеткиЗаказчика
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("Лико_Gtin", Лико_Gtin);
	Запрос.УстановитьПараметр("Лико_КодЭтикеткиЗаказчика", Лико_КодЭтикеткиЗаказчика);
	Запрос.УстановитьПараметр("GtinВНоменклатуре", Лико_GtinВНоменклатуре);
	Запрос.УстановитьПараметр("КодЭтикеткиЗаказчикаВНоменклатуре", Лико_КодЭтЗаказчикаВНоменклатуре);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла; 
	
	Возврат Неопределено;
	
КонецФункции


&НаКлиенте
Процедура ТоварыGtinПриИзменении(Элемент)
	
	ТекСтр = Элементы.Товары.ТекущиеДанные;
	
	Если ЗначениеРеквизита(Объект.Партнер, "Лико_GtinВНоменклатуре") И ЗначениеЗаполнено(СокрЛП(ТекСтр.Gtin)) Тогда
		НоменклатураGtinКодЭтикеткиЗаказчика = ПолучитьНоменклатуруGtinКодЭтикеткиЗаказчика(СокрЛП(ТекСтр.Gtin),"");
		
		Если НоменклатураGtinКодЭтикеткиЗаказчика <> Неопределено Тогда
			ДругаяНоменклатура = ТекСтр.Номенклатура <> НоменклатураGtinКодЭтикеткиЗаказчика;
			Если ЗначениеРеквизита(Объект.Партнер, "Лико_КодЭтЗаказчикаВНоменклатуре") Тогда
				ТекСтр.КодЭтикеткиЗаказчика = ЗначениеРеквизита(НоменклатураGtinКодЭтикеткиЗаказчика, "Лико_КодЭтикеткиЗаказчика");	
			КонецЕсли;
			Если ДругаяНоменклатура Тогда
				ТекСтр.Номенклатура = НоменклатураGtinКодЭтикеткиЗаказчика;	
				ТоварыНоменклатураПриИзменении(Неопределено);
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ТоварыКодЭтикеткиЗаказчикаПриИзменении(Элемент)
	
	ТекСтр = Элементы.Товары.ТекущиеДанные;
	
	Если ЗначениеРеквизита(Объект.Партнер, "Лико_КодЭтЗаказчикаВНоменклатуре") И ЗначениеЗаполнено(СокрЛП(ТекСтр.КодЭтикеткиЗаказчика)) Тогда
		НоменклатураGtinКодЭтикеткиЗаказчика = ПолучитьНоменклатуруGtinКодЭтикеткиЗаказчика("",СокрЛП(ТекСтр.КодЭтикеткиЗаказчика));
		
		Если НоменклатураGtinКодЭтикеткиЗаказчика <> Неопределено Тогда
			ДругаяНоменклатура = ТекСтр.Номенклатура <> НоменклатураGtinКодЭтикеткиЗаказчика;
			Если ЗначениеРеквизита(Объект.Партнер, "Лико_GtinВНоменклатуре") Тогда
				ТекСтр.Gtin = ЗначениеРеквизита(НоменклатураGtinКодЭтикеткиЗаказчика, "Лико_Gtin");	
			КонецЕсли;
			Если ДругаяНоменклатура Тогда
				ТекСтр.Номенклатура = НоменклатураGtinКодЭтикеткиЗаказчика;
				ТоварыНоменклатураПриИзменении(Неопределено);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОткрытьРасчетЗаказа1С(Команда)
	ВыполняемаяОбработка=НайтиВПФ("Печатная форма ""Расчет заказа 1С""");
	Если ВыполняемаяОбработка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ОбъектыНазначения=Новый Массив;
	ОбъектыНазначения.Добавить(Объект.Ссылка);
	ПараметрыОткрытия=Новый Структура("ИсточникДанных, ПараметрыИсточника");
	ПараметрыОткрытия.ИсточникДанных=ВыполняемаяОбработка;
	ПараметрыОткрытия.ПараметрыИсточника=Новый Структура("ИдентификаторКоманды, ОбъектыНазначения");
	ПараметрыОткрытия.ПараметрыИсточника.ИдентификаторКоманды="ПечатнаяФормаРасчетЗаказа_1С";
	ПараметрыОткрытия.ПараметрыИсточника.ОбъектыНазначения=ОбъектыНазначения;
	
	ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыОткрытия); 
КонецПроцедуры


&НаКлиенте
Процедура РучнойВводНарезкиПриИзменении(Элемент) // <-- Начало Лико Яцун С. В. 22.01.2026
	
	Эл = Элементы.Нарезка;
	ТекШирина = Эл.Ширина; 
	ТекЦвет = Эл.ЦветФона;
	Эл.ТолькоПросмотр = НЕ Объект.РучнойВводНарезки;
	Если Эл.ТолькоПросмотр Тогда
		Эл.Вид = ВидПоляФормы.ПолеНадписи;
		Эл.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.Одинарная);
		Эл.Ширина = ТекШирина;
		Эл.ЦветФона = ТекЦвет;
		Элементы.НарезкаРасчет.Гиперссылка = Истина;
	Иначе
		Если Эл.Вид <> ВидПоляФормы.ПолеВвода Тогда
			Эл.Вид = ВидПоляФормы.ПолеВвода;
			Эл.Ширина = ТекШирина;
			Эл.ЦветФона = ТекЦвет;
		КонецЕсли;
		Элементы.НарезкаРасчет.Гиперссылка = Ложь;
	КонецЕсли;
	
КонецПроцедуры // <-- Конец Лико Яцун С. В. 22.01.2026


