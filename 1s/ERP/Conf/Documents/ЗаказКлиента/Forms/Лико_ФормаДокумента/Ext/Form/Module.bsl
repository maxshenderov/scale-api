			Для каждого стр из НайденныеСтроки Цикл
				Массив.Добавить(стр.Значение);
			КонецЦикла;	
			ПараметрыФормы.Вставить("Значения", Массив);
			ОткрытьФорму("ОбщаяФорма.РедактированиеСпискаЗначений", ПараметрыФормы , , , , , ОписаниеОповещения);
		ИначеЕсли ТекСтр.ВалФорма = Неопределено Тогда
			ТекСтр.ВалФорма = ПредопределенноеЗначение("Справочник.Лико_Формы.ПустаяСсылка");	
		КонецЕсли;  
		//Если НЕ (ЗначениеРеквизита(ТекСтр.ВидСекции,"Родитель") = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Глубокая")
		//	ИЛИ ТекСтр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.БессольвентнаяЛаминация")) И ТекСтр.ВалФорма = Неопределено Тогда
		//	ТекСтр.ВалФорма = ПредопределенноеЗначение("Справочник.Лико_Формы.ПустаяСсылка");	
		//КонецЕсли;
	Иначе
		Сообщить("Заполните Вид работ");
	КонецЕсли;
	
