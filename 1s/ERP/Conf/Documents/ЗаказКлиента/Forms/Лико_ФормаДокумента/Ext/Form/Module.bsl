&НаСервере
Функция  ОткрытиеРасчетЗаказа()
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Объект.Ссылка);
	//СсылкаНаВнешнююОбработку.ПечатьВнешнейПечатнойФормы(МассивОбъектов);

	ИмяФайла = ПолучитьИмяВременногоФайла();
	ВнОбработка = Лико_Дополнительно.НайтиДополнительнуюОбработкуПоИмениОбъекта("РасчетЗаказа");
	Если НЕ ЗначениеЗаполнено(ВнОбработка) Тогда
		Сообщить("Не найдена дополнительная обработка с именем объекта РасчетЗаказа");
		Возврат Неопределено;
	КонецЕсли;
	ДвоичныеДанные = ВнОбработка.ХранилищеОбработки.Получить();
	ДвоичныеДанные.Записать(ИмяФайла);
	ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь);
	
	ПечатьБезСуммы = Истина;
	Если  (РольДоступна("ПолныеПрава")  ИЛИ  РольДоступна("Лико_ЗаказыКлиентов")) Тогда 
		ПечатьБезСуммы = Ложь;
	КонецЕсли;	
	
	ТабличныеДокументы = ВнешняяОбработка.ПечатьВнешнейПечатнойФормы(МассивОбъектов, ПечатьБезСуммы);
	
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
	КонецПопытки;

	Возврат ТабличныеДокументы;

КонецФункции

