Процедура ПОслеВыбораНамотки(Результат, Параметры) Экспорт
	Если Результат<>Неопределено Тогда 
		Если ТипЗнч(Результат) = Тип("СправочникСсылка.Лико_Перемотка") ТОгда 
			текстр = Элементы.Товары.ТекущиеДанные;
			Если Текстр<>Неопределено Тогда 
				Идентификатор = текстр.ПолучитьИдентификатор();
				ЗаполнитьПараметрыПеремотки(Идентификатор, Результат);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНамоткиНаСервере()
	Если ЭтаФорма.Модифицированность Тогда
		Сообщить("Необходимо записать документ!");
		Возврат;
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.Ссылка.Партнер КАК Партнер,
		|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
		|	ЗаказКлиентаТовары.Направление КАК Направление,
		|	ЗаказКлиентаТовары.МаксимальныйДиаметрРулона КАК МаксимальныйДиаметрРулона,
		|	ЗаказКлиентаТовары.ВнутреннийДиаметр КАК ВнутреннийДиаметр,
		|	ЗаказКлиентаТовары.ПродольнаяРезка КАК ПродольнаяРезка,
		|	ЗаказКлиентаТовары.ПоперечнаяРезка КАК ПоперечнаяРезка,
		|	ЗаказКлиентаТовары.Кромка КАК Кромка,
		|	ЗаказКлиентаТовары.ПодрезкаКромки КАК ПодрезкаКромки,
		|	ЗаказКлиентаТовары.Город КАК Город,
		|	Лико_Перемотка.Ссылка КАК Перемотка,
		|	ЗаказКлиентаТовары.КоличествоЭтикетокВРолике КАК КоличествоЭтикетокВРолике
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_Перемотка КАК Лико_Перемотка
		|		ПО ЗаказКлиентаТовары.Ссылка.Партнер = Лико_Перемотка.Партнер
		|			И ЗаказКлиентаТовары.Номенклатура = Лико_Перемотка.Номенклатура
		|			И ЗаказКлиентаТовары.Направление = Лико_Перемотка.Направление
		|			И ЗаказКлиентаТовары.МаксимальныйДиаметрРулона = Лико_Перемотка.МаксимальныйДиаметрРулона
		|			И ЗаказКлиентаТовары.ВнутреннийДиаметр = Лико_Перемотка.ВнутреннийДиаметр
		|			И ЗаказКлиентаТовары.КоличествоЭтикетокВРолике = Лико_Перемотка.КоличествоЭтикетокВРолике
		|			И ЗаказКлиентаТовары.ПродольнаяРезка = Лико_Перемотка.ПродольнаяРезка
		|			И ЗаказКлиентаТовары.ПоперечнаяРезка = Лико_Перемотка.ПоперечнаяРезка
		|			И ЗаказКлиентаТовары.Кромка = Лико_Перемотка.Кромка
		|			И ЗаказКлиентаТовары.ПодрезкаКромки = Лико_Перемотка.ПодрезкаКромки
		|			И ЗаказКлиентаТовары.Город = Лико_Перемотка.Город
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка = &Заказ
		|	И Лико_Перемотка.Ссылка ЕСТЬ NULL";
		Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СпрОбъект = Справочники.Лико_Перемотка.СоздатьЭлемент();
			СпрОбъект.Партнер 					= Выборка.Партнер;
			СпрОбъект.Номенклатура				= Выборка.Номенклатура;
			СпрОбъект.Направление				= Выборка.Направление;
			СпрОбъект.МаксимальныйДиаметрРулона	= Выборка.МаксимальныйДиаметрРулона;
			СпрОбъект.ВнутреннийДиаметр			= Выборка.ВнутреннийДиаметр;
			СпрОбъект.КоличествоЭтикетокВРолике = Выборка.КоличествоЭтикетокВРОлике;
			СпрОбъект.ПродольнаяРезка 			= Выборка.ПродольнаяРезка;
			СпрОбъект.ПоперечнаяРезка 			= Выборка.ПоперечнаяРезка;
			СпрОбъект.Кромка 					= Выборка.Кромка;
			СпрОбъект.ПодрезкаКромки 			= Выборка.ПодрезкаКромки;
			СпрОбъект.Город 					= Выборка.Город;
			СпрОбъект.Записать();
		КонецЦикла;		
	КонецЕсли;
КонецПроцедуры

