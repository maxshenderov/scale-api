	//	Объект.НоменклатураDFM = Ложь;
	Иначе
		Объект.НоменклатураDFM = Ложь;
	КонецЕсли;
	
	Если Объект.НоменклатураDFM Тогда
		
		Элементы.ТоварыНоменклатура.ТолькоПросмотр = Истина;
		
		Если Не ОставитьНоменклатуру ТОгда
