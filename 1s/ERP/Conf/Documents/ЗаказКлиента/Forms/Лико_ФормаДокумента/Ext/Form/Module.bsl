	// <-- Конец Лико Митюшин МФМ 02.09.2021 "Кнопка 'Бога'"
	
	// <-- Начало Лико Яцун С. В. 04.12.2023
	Если НЕ (РольДоступна("ПолныеПрава") ИЛИ РольДоступна("Лико_ДобавлениеИзменениеЗаказовПоПлощадке")) Тогда
