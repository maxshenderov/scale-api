&НаКлиенте
Процедура ЦветаКоличествоРучьевНумератораПриИзменении(Элемент)
	
	ТекСтр = Элементы.Цвета.ТекущиеДанные;   
	
	Если не ЗначениеЗаполнено(ТекСтр.ВидСекции) и не ЗначениеЗаполнено(ТекСтр.РабочийЦентр) Тогда		
		Сообщить("Необходимо сперва заполнить Вид работ и Рабочий центр");
		ТекСтр.КоличествоРучьевНумератора = 0;
		Возврат		
	КонецЕсли;
	
	Если ТекСтр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Нумератор") Тогда
						
		Если  Не ЭтоЦифра(ТекСтр.РабочийЦентр)  Тогда  
			Если не ЗначениеЗаполнено(ТекСтр.ТипНумератора) Тогда  
	
				Сообщить( "Необходимо заполнить Тип нумератора");
				ТекСтр.КоличествоРучьевНумератора  = 0 ;

				Возврат
			КонецЕсли;

			МаксКолРучьев =  ПолучитьКоличествоРучьев(текстр.ТипНумератора, текстр.РабочийЦентр); 
			Если МаксКолРучьев = 0 Тогда  
				Сообщить(СтрШаблон("в спр ""Типы нумераторов"" для нумератора %1 не заполнено максимальное количество ручьев для рабочего цетнра %2",  
				текстр.ТипНумератора,  текстр.РабочийЦентр ));   
				ТекСтр.КоличествоРучьевНумератора  = 0 ;
				Возврат
			КонецЕсли; 
			
			Если  ТекСтр.КоличествоРучьевНумератора > МаксКолРучьев	Тогда 
				ТекСтр.КоличествоРучьевНумератора  = МаксКолРучьев;
				Сообщить(СтрШаблон("Максимум ручьев для РЦ %2 при нумераторе %3 - %1", МаксКолРучьев, текстр.РабочийЦентр, текстр.ТипНумератора ));			
			КонецЕсли; 				
		КонецЕсли;  
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПрокат(Команда)
	
	ВыполняемаяОбработка = НайтиВПФ("Обработка ""лк СхемаМашины""");
	Если ВыполняемаяОбработка.Пустая() Тогда
		Возврат
	КонецЕсли;    
	
	ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВыполняемаяОбработка);
   
	ОбработкаЗакрытия = Новый ОписаниеОповещения("ПриЗакрытииСхемыМашиныЦвета", ЭтаФорма);
	
		
	ПараметрыНаФорму = Новый Структура;
	ПараметрыНаФорму.Вставить("ПараметрыСекции", "");
    ПараметрыНаФорму.Вставить("Ссылка", Объект.Ссылка); 

    ПараметрыНаФорму.Вставить("НомерПроката", ?(Объект.Цвета.Количество() = 0, 1, ПолучитьМаксимумНомераПроката()));	

	

	ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма", ПараметрыНаФорму ,ЭтаФорма,,,,ОбработкаЗакрытия);

КонецПроцедуры 

 

&НаКлиенте
Процедура РедактироватьПрокатЦвета(Команда)

	Если Не ЗначениеЗаполнено(Объект.Площадка) Тогда
		Сообщить("Необходимо заполнить поле ""Площадка""", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	ТекСтр = Элементы.Цвета.ТекущиеДанные;
	
	Если ТекСтр = Неопределено Тогда 
		Сообщить("Не выбрана строка для редактирования", СтатусСообщения.Важное);
		Возврат;		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.РабочийЦентр) Тогда
		Сообщить("Необходимо заполнить поле ""Рабочий центр""", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;   
	
	ВыполняемаяОбработка = НайтиВПФ("Обработка ""лк СхемаМашины""");
	Если ВыполняемаяОбработка.Пустая() Тогда
		Возврат
	КонецЕсли;  
	
	ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВыполняемаяОбработка);
	
		
	ПараметрыНаФорму = Новый Структура;
	ПараметрыНаФорму.Вставить("Площадка", Объект.Площадка);  
	ПараметрыНаФорму.Вставить("Ссылка", Объект.Ссылка); 
	ПараметрыНаФорму.Вставить("НомерПроката", ТекСтр.НомерПроката);	
	ПараметрыНаФорму.Вставить("РабочийЦентр", ТекСтр.РабочийЦентр);  
	
	текТЗСекции = ПолучитьТаблицуДляПередачиДанныхПоПрокатуЦвета(ТекСтр.НомерПроката);

	ПараметрыНаФорму.Вставить("ТЗСекции", текТЗСекции);	
	
		
	ОбработкаЗакрытия = Новый ОписаниеОповещения("ПриЗакрытииСхемыМашиныЦвета", ЭтотОбъект, "");
			
	ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.Лико_СхемаМашины", ПараметрыНаФорму ,ЭтаФорма,,,,ОбработкаЗакрытия);   
	
КонецПроцедуры  

 &НаКлиенте
Процедура ПриЗакрытииСхемыМашиныЦвета(ВозвращенноеЗначение, ДопПараметры) Экспорт
	
	Если ВозвращенноеЗначение = Неопределено Тогда 
		Возврат
	КонецЕсли;   
	
	РЦ = ВозвращенноеЗначение.РабочийЦентр;
	НомерПроката = ВозвращенноеЗначение.НомерПроката; 

	НайденныеСтроки = Объект.цвета.НайтиСтроки(новый структура("РабочийЦентр, НомерПроката", РЦ, НомерПроката));

	Для каждого ТекСтр из НайденныеСтроки Цикл
		Объект.цвета.Удалить(ТекСтр); 
	КонецЦикла;    
		
	ДесериализованныйМассив = ДесериализоватьМассив(ВозвращенноеЗначение.МассивПараметровСекций); 
	сч = 0;
	Для каждого стр из ВозвращенноеЗначение.МассивПараметровСекций Цикл 
		новаяСтрока = Объект.Цвета.Добавить();	 
		ЗаполнитьЗначенияСвойств(новаяСтрока, ДесериализованныйМассив[сч]); 
		
		новаяСтрока.РабочийЦентр = РЦ;   
		новаяСтрока.НомерПроката = НомерПроката; 
        сч = сч + 1;
	КонецЦикла;  
	
	
КонецПроцедуры 

Функция ПолучитьТаблицуДляПередачиДанныхПоПрокатуЦвета(НомерПроката) 
	
	МассивДанныхПроката = новый массив;
			
	РеквизитыЦвета = ПолучитьМассивРеквизитовТЧ();
		
	НайденныеСтроки = Объект.Цвета.НайтиСтроки(Новый Структура("НомерПроката", НомерПроката)); 
	Для каждого стр из НайденныеСтроки Цикл 
		
		СтруктураТЧЦвета = Новый Структура;

		Для каждого рек из РеквизитыЦвета Цикл  
			СтруктураТЧЦвета.Вставить(рек, стр[рек]); 	
		КонецЦикла;  
		МассивДанныхПроката.Добавить(СтруктураТЧЦвета);
		
	КонецЦикла;
	
	Возврат МассивДанныхПроката
	
КонецФункции

