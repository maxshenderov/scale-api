		|				И АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры = &Заказ) КАК ТоварыОрганизацийОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры.ДополнительныеРеквизиты КАК ПартнерыДополнительныеРеквизиты
		|		ПО (ВЫБОР
		|				КОГДА ТоварыОрганизацийОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
		|					ТОГДА ТоварыОрганизацийОбороты.Регистратор.Партнер = ПартнерыДополнительныеРеквизиты.Ссылка
		|							И ПартнерыДополнительныеРеквизиты.Свойство.Имя = ""Лико_СобственнаяОрганизация""
		|							И ПартнерыДополнительныеРеквизиты.Значение В
		|								(ВЫБРАТЬ
		|									Лико_ПредопределенныеЗначения.ЗначениеПараметра КАК ЗначениеПараметра
		|								ИЗ
		|									Справочник.Лико_ПредопределенныеЗначения КАК Лико_ПредопределенныеЗначения
		|								ГДЕ
		|									(Лико_ПредопределенныеЗначения.Ссылка = ЗНАЧЕНИЕ(Справочник.Лико_ПредопределенныеЗначения.ОрганизацияОкил)
		|										ИЛИ Лико_ПредопределенныеЗначения.Ссылка = ЗНАЧЕНИЕ(Справочник.Лико_ПредопределенныеЗначения.ОрганизацияАвантаж)))
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)
		|ГДЕ
		|	ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
		|	И ВЫБОР
		|			КОГДА ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры.Площадка = &ИксПак
		|					И ТоварыОрганизацийОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
		|				ТОГДА ПартнерыДополнительныеРеквизиты.Значение ЕСТЬ NULL
		|			ИНАЧЕ ТоварыОрганизацийОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
		|					ИЛИ ТоварыОрганизацийОбороты.Регистратор ССЫЛКА Документ.ПеремещениеТоваров
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА ТоварыОрганизацийОбороты.Регистратор ССЫЛКА Документ.ПеремещениеТоваров
		|				ТОГДА ТоварыОрганизацийОбороты.Регистратор.СкладОтправитель.Родитель <> ТоварыОрганизацийОбороты.Регистратор.СкладПолучатель.Родитель
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры,
		|	ТоварыОрганизацийОбороты.Регистратор,
		|	ТоварыОрганизацийОбороты.Период,
		|	ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Заказ КАК Заказ,
		|	ВТ.ДокументОтгрузки КАК ДокументОтгрузки,
		|	ВТ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВТ.Дата КАК Дата,
		|	ВТ.Количество КАК Количество,
		|	СУММА(ВЫБОР
		|			КОГДА ВТ.ДокументОтгрузки ССЫЛКА Документ.РеализацияТоваровУслуг
		|				ТОГДА ВыручкаИСебестоимостьПродаж.СуммаВыручки
		|			КОГДА ВТ.ДокументОтгрузки ССЫЛКА Документ.ПеремещениеТоваров
		|				ТОГДА ВТ.Количество * ВТ.Заказ.ЦенаСредняя
		|		КОНЕЦ) КАК Стоимость
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК ВыручкаИСебестоимостьПродаж
		|		ПО ВТ.ДокументОтгрузки = ВыручкаИСебестоимостьПродаж.Регистратор
		|			И ВТ.Заказ = ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ.Заказ,
		|	ВТ.ДокументОтгрузки,
		|	ВТ.Дата,
		|	ВТ.Количество,
		|	ВТ.ЕдиницаИзмерения
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВыручкаИСебестоимостьПродаж.ЗаказКлиента.Лико_ЗаказКлиента,
		|	ВыручкаИСебестоимостьПродаж.Регистратор,
		|	ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения,
		|	ВыручкаИСебестоимостьПродаж.Период,
		|	СУММА(ВыручкаИСебестоимостьПродаж.Количество),
		|	СУММА(ВыручкаИСебестоимостьПродаж.СуммаВыручки)
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК ВыручкаИСебестоимостьПродаж
		|ГДЕ
		|	ВыручкаИСебестоимостьПродаж.ЗаказКлиента.Лико_ЗаказКлиента = &Заказ
		|	И ВыручкаИСебестоимостьПродаж.ЗаказКлиента.Лико_ЗаказКлиента.Площадка = &ИксПак
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыручкаИСебестоимостьПродаж.ЗаказКлиента.Лико_ЗаказКлиента,
		|	ВыручкаИСебестоимостьПродаж.Период,
		|	ВыручкаИСебестоимостьПродаж.Регистратор,
		|	ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Номенклатура.ЕдиницаИзмерения";	
		
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	Запрос.УстановитьПараметр("Организация", Объект.Площадка);
	Запрос.УстановитьПараметр("ИксПак",Справочники.Лико_Площадки.ИксПак); 
	СписокСкладов = Новый СписокЗначений;
	СписокСкладов.Добавить(Справочники.Лико_ПредопределенныеЗначения.СкладМеталлостройГП.ЗначениеПараметра);
	Запрос.УстановитьПараметр("СписокСкладов",СписокСкладов); 

	//Предопределенные значения
	МассивЛико_Предопределенные = Лико_ТиражМетраж.ПолучитьМассивЛико_Предопределенные();
	
	Выборка = Запрос.Выполнить().Выбрать();
	ВсегоОтгружено = 0;
	Пока Выборка.Следующий() Цикл
		нстр = Объект.Отгрузки.Добавить();
		ЗаполнитьЗначенияСвойств(нстр, Выборка);
		нстр.ключстроки = Новый УникальныйИдентификатор;
		
		// <-- Начало Лико Яцун С. В. 04.04.2023 
		Если Выборка.ЕдиницаИзмерения = МассивЛико_Предопределенные[0] Тогда 
			НарезкаМ = Объект.Нарезка.Размер/1000;
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 04.04.2023
		
		ВсегоЗаказано = 0;
		Лико_ТиражМетраж.ПолучитьМетражПоУсловиям(МассивЛико_Предопределенные, Выборка.ЕдиницаИзмерения, ВсегоЗаказано, нстр.ПогонныйМетраж, нстр.КвадратныйМетраж, 
		НарезкаМ, Выборка.Количество, Объект);
			
		нстр.ОсновнойМатериал = Объект.ОсновнойМатериал;
		Если ЗначениеЗаполнено(Объект.РабочийЦентр) Тогда 
			нстр.рабочийЦентр = Объект.рабочийцентр;
		КонецЕсли;
		нстр.КодПостпечатныхРабот =   Лико_Планирование.ПолучитьКодПостПечатныхработ(Объект.Ссылка);
		
		Если Объект.Площадка = Справочники.Лико_Площадки.ИксПак  И ТипЗнч(нстр.ДокументОтгрузки) = Тип("ДокументСсылка.ОтчетДавальцу") Тогда 
		//Настройку ставим для первой строки
		    Если нстр.номерстроки = 1 Тогда 
				нстр.Настройка = 1;
			КонецЕсли;	
		
		Иначе
		    ВсегоОтгружено = ВсегоОтгружено+ нстр.Количество;

			Если (ВсегоЗаказано-ВсегоОтгружено)*100/ВсегоЗаказано<=5 Тогда 
				нстр.Настройка = 1;
			КонецЕсли;
		КонецЕсли;
		
		
	КонецЦикла;
	// --> Начало Лико Митюшин МФМ 29.03.2021
	ИзмененитьДоступностиПолейНаСервере(Лико_ТиражМетраж.ПолучитьВидВырубки(Объект));
	// <-- Конец Лико Митюшин МФМ 29.03.2021
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


