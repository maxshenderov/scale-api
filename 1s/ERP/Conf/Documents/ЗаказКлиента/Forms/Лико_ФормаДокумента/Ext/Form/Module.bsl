&НаСервере 
Функция СоздатьНовуюФорму(ВидСекции, типцвета, типкраски, название, КодЛинкс = Неопределено)
	
	ВидПечати = ВидСекции.ВидПечати ;
	
	НоваяФормаЦвета = Справочники.Лико_Формы.СоздатьЭлемент(); 
	НоваяФормаЦвета.Контрагент = объект.Контрагент; 
	НоваяФормаЦвета.Заказ = Объект.Ссылка;
	НоваяФормаЦвета.ВидПечати = ВидПечати; 
	НоваяФормаЦвета.ВидСекции = ВидСекции;
	Если ВидПечати = Справочники.Лико_ВидыПечати.Флексо ИЛИ ВидПечати = Справочники.Лико_ВидыПечати.Трафарет ИЛИ ВидСекции = Справочники.Лико_ВидыСекций.ГлубокаяПечать Тогда
		НоваяФормаЦвета.ТипЦвета = ТипЦвета; 
		НоваяФормаЦвета.ТипКраски = ТипКраски; 
		НоваяФормаЦвета.Название = Название;
		НоваяФормаЦвета.Наименование = ?(ЗначениеЗаполнено(ТипЦвета), Строка(ТипЦвета)+ " ", "")+?(ЗначениеЗаполнено(ТипКраски), Строка(ТипКраски)+ " ", "")+ ?(ЗначениеЗаполнено(Название), Строка(Название), "");
	ИначеЕсли ВидПечати = Справочники.Лико_ВидыПечати.Цифровая Тогда 
		НоваяФормаЦвета.Наименование = Строка(ВидСекции) + " " + Объект.НомерБезПрефикса;
	КонецЕсли;	
	//Это надо переделать Площадки Иванова 20241003
	НоваяФормаЦвета.Организация = Объект.Площадка.Организация;
	
	Для каждого Эт из  Объект.Товары Цикл
		стрЭт = НоваяФормаЦвета.Этикетки.Добавить();
		стрэт.Номенклатура =  Эт.Номенклатура;
	КонецЦикла;
	
	Если КодЛинкс <> Неопределено Тогда
		НоваяФормаЦвета.КодЛинкс = КодЛинкс;
	КонецЕсли;
	
	НоваяФормаЦвета.Записать();  
	
	Возврат НоваяФормаЦвета.Ссылка	
	
КонецФункции

&НаСервере 
Функция НайтиЦифровуюФормуПоЗаказу()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_Формы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Лико_Формы КАК Лико_Формы
	|ГДЕ
	|	Лико_Формы.Заказ = &Заказ
	|	И Лико_Формы.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Цифровая)";
	
	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();

	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.Ссылка) Тогда 
			Возврат Результат.Ссылка;
		КонецЕсли;
	КонецЕсли; 
	
	Возврат Справочники.Лико_Формы.ПустаяСсылка()
	
КонецФункции	

