		Если ЗначениеЗаполнено(ТекСтр.ВидСекции)  Тогда
			// <-- Начало Лико Яцун С. В. 02.12.2025 
			Если Объект.Площадка = ГлЛико_Площадки.Сибирь 
				И ЭтоЦМИК(ТекСтр.типцвета1) 
				И ЗначениеЗаполнено(ТекСтр.типкраски) 
				И ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Флексо")
				И СокрЛП(ЗначениеРеквизита(ТекСтр.типкраски,"Код")) <> "3081" Тогда
				ЗаменаЦГ = Истина;
				ТекСтр.Цветоделение = Ложь;
			Иначе	
				СоздатьФорму(ТекСтр,ЗаменаЦГ,Ложь);
			КонецЕсли;
