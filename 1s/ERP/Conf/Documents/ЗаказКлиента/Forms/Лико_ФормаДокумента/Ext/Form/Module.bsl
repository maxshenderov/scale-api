		ВыработкаФормщиков.Параметры.УстановитьЗначениеПараметра("Заказ", Объект.Ссылка);
		// <-- Конец Лико Митюшин МФМ 29.09.2021
		
		ЗаполнитьНачалоПечати(); 
		// --> Начало Лико Ефимов ЕВВ 02.08.2021
	// Для пустой ссылки заполним связанные данные, т.к. для пустой ссылки не выполняется обработчик ПриЧтенииНаСервере
	Иначе
		ЗаполнитьСвязанныеДанныеНаСервере();
	// <-- Конец Лико Ефимов ЕВВ 02.08.2021
	КонецЕсли;

	//Если НЕ (Объект.ВидУпаковки=Справочники.Лико_ВидыУпаковки.Термопленка ИЛИ  Объект.ВидУпаковки=Справочники.Лико_ВидыУпаковки.ПакетыКоробки ИЛИ  Объект.ВидУпаковки=Справочники.Лико_ВидыУпаковки.Коробки
	//	ИЛИ  Объект.ВидУпаковки=Справочники.Лико_ВидыУпаковки.СтрейчПленкаКоробка  ИЛИ  Объект.ВидУпаковки=Справочники.Лико_ВидыУпаковки.ТермопленкаКоробки) Тогда 
	//КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Склад) Тогда 
