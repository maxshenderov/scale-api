Функция ВыполнитьПроверкуТехнологииПродукта(РЦ) //+Лико m.shenderov 05.05.2021
	Отказ=Ложь;
	ТехнологияПечати=РЦ.ВидРабочегоЦентра.лкТехнологияПечати;
	Если ТехнологияПечати=Справочники.Лико_ТехнологияПечати.GallusInkjet Тогда
		НомерСтроки=0;
		Для Каждого Товар Из Объект.Товары Цикл
			Если Товар.ВерсияНоменклатуры.ТехнологияПечати<>ТехнологияПечати Тогда
				Отказ=Истина;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтрШаблон("Продукт: %1 не соответсвует технологии! Создатйте версиию продукта с технологией:%2.",Товар.Номенклатура,ТехнологияПечати);
				Сообщение.Поле = "Объект.Товары["+НомерСтроки+"].Номенклатура"; //имя реквизита 
				Сообщение.УстановитьДанные(Объект);
				Сообщение.Сообщить(); 			
			КонецЕсли;
			НомерСтроки=НомерСтроки+1	
		КонецЦикла;
	КонецЕсли;
	Если  Отказ Тогда
			Возврат Ложь;		
	КонецЕсли;
	
	Объект.РабочийЦентр = РЦ;
	ЗаблокироватьНоменклатуруНаСервере(Истина);
	Возврат Истина;
КонецФункции //-Лико m.shenderov 05.05.2021




&НаСервере 
Функция ПолучитьНоменклатуруИВерсиюПоАртикулуНаСервере(Артикул)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Лико_ВерсииНоменклатуры.Номенклатура КАК Номенклатура,
	               |	Лико_ВерсииНоменклатуры.Артикул КАК Артикул,
	               |	Лико_ВерсииНоменклатуры.Версия КАК НомерВерсии,
	               |	Лико_ВерсииНоменклатуры.Ссылка КАК Версия
	               |ИЗ
	               |	Справочник.Лико_ВерсииНоменклатуры КАК Лико_ВерсииНоменклатуры
	               |ГДЕ
	               |	Лико_ВерсииНоменклатуры.Артикул = &Артикул";
	
	Запрос.УстановитьПараметр("Артикул", Артикул);
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 1 Тогда 
		Версия = Новый Структура("Номенклатура,Версия,НомерВерсии", Результат[0].Номенклатура, Результат[0].Версия, Результат[0].НомерВерсии);
