&НаСервере
Процедура ПоказатьКодМатериала()
	Если ЗначениеЗаполнено(Объект.ОсновнойМатериал) Тогда 
		Если ТипЗнч(Объект.ОсновнойМатериал)=Тип("СправочникСсылка.ЦеновыеГруппы") Тогда
			ЭтаФорма.НадписьКодМатериала = Объект.ОсновнойМатериал.Код;
		ИначеЕсли ТипЗнч(Объект.ОсновнойМатериал)=Тип("СправочникСсылка.Номенклатура") Тогда
			Если ЗначениеЗаполнено(Объект.ОсновнойМатериал.ЦеноваяГруппа) Тогда
				ЭтаФорма.НадписьКодМатериала = Объект.ОсновнойМатериал.Код + " " + Объект.ОсновнойМатериал.ЦеноваяГруппа.Код;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ЭтаФорма.НадписьКодМатериала = "";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПОлучитьКодМатериалаНаСервере(материал)	
	КодМатериала = "";
	Если ТипЗнч(Материал) = Тип("СправочникСсылка.Номенклатура") Тогда 
		Если ЗначениеЗаполнено (Материал.ЦеноваяГруппа) Тогда 
			КодМатериала = Материал.ЦеноваяГруппа.Код;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Материал) = Тип("СправочникСсылка.ЦеновыеГруппы") Тогда 
		КодМатериала = Материал.Код;
	КонецЕсли;
	Возврат КодМатериала;
КонецФункции

&НаСервере
Процедура ПоказатьДоходностьРентабельность()
	Объект.СуммаДокумента = Объект.Товары.Итог("СуммаСНДС")+Объект.СтоимостьОснастки;
	ЭтаФорма.НадписьСтоимость = Объект.СуммаДокумента;
	Если ЗначениеЗаполнено(Объект.Вес) Тогда
		ЭтаФорма.НадписьСтоимость1Кг = Объект.СуммаДокумента/Объект.Вес;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МИНИМУМ(Лико_ПараметрыПроизводстваЗаказа.Доход) КАК Доход,
	|	МИНИМУМ(Лико_ПараметрыПроизводстваЗаказа.Доходность) КАК Доходность,
	|	МИНИМУМ(Лико_ПараметрыПроизводстваЗаказа.Рентабельность) КАК Рентабельность,
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ КАК Заказ,
	|	Лико_ПараметрыПроизводстваЗаказа.Себестоимость КАК Себестоимость
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|ГДЕ
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ = &Заказ
	|	И Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ,
	|	Лико_ПараметрыПроизводстваЗаказа.Себестоимость";
	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.Заказ) Тогда 
			ЭтаФорма.НадписьДоход = Результат.Доход;
			ЭтаФорма.НадписьДоходность = Результат.Доходность;
			ЭтаФорма.НадписьРентабельность =  Результат.Рентабельность;
			ЭтаФорма.НадписьСебестоимость = Результат.Себестоимость;			
			Если ЗначениеЗаполнено(Объект.МетражКВМ) Тогда 
				ЭтаФорма.НадписьЦенаКвМ =  Объект.Товары.Итог("СуммаСНДС")/Объект.МетражКВМ;
				//// --> Начало Лико Митюшин МФМ 09.03.2021
				////ЭтаФорма.НадписьШтКВМ = Объект.Тираж*1000/Объект.МетражКВМ;
				//Объект.ШтКВМ = Объект.Тираж*1000/Объект.МетражКВМ;
				//// <-- Конец Лико Митюшин МФМ 09.03.2021
				ЭтаФорма.НадписьСебестоимостьКВМ =  Результат.Себестоимость/Объект.МетражКВМ;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

