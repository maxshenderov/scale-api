	// КонецЕсли; 
	
	ВидЗаказа = объект.ВидЗаказа;  
	ТипЗаказа = объект.ТипЗаказа; 
	
	Если Не объект.Площадка = ПредопределенноеЗначение("Справочник.Лико_Площадки.Линкс") Тогда 
		Если Не ТипЗаказа = ПредопределенноеЗначение("Перечисление.Лико_ТипыЗаказов.Полуфабрикат") Тогда 	
			Если ВидЗаказа = ПредопределенноеЗначение("Перечисление.Лико_ВидыЗаказов.ПолныйПовтор") Тогда 
