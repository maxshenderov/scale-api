&НаСервере
Процедура ВыполнитьПроверкуСоответствияНоменклатурыИЗаявокНаОтгрузку(Отказ)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивНоменклатурыВСсылке = Объект.Ссылка.Товары.ВыгрузитьКолонку("Номенклатура");
	МассивНоменклатурыВСсылке = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивНоменклатурыВСсылке);
	
	МассивНоменклатурыВОбъекте = Объект.Товары.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура");
	МассивНоменклатурыВОбъекте = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивНоменклатурыВОбъекте);
	
	МассивыНоменклатурыИдентичны = ОбщегоНазначения.КоллекцииИдентичны(МассивНоменклатурыВСсылке, МассивНоменклатурыВОбъекте);
	
	Если НЕ МассивыНоменклатурыИдентичны Тогда
		// Будем проверять, содержатся ли предыдущие номенклатуры в заявках на отгрузку
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Лико_ЗаявкаНаОтгрузкуТовары.Ссылка КАК Ссылка,
			|	Лико_ЗаявкаНаОтгрузкуТовары.НомерСтроки КАК НомерСтроки,
			|	Лико_ЗаявкаНаОтгрузкуТовары.Ссылка.Номер КАК Номер,
			|	Лико_ЗаявкаНаОтгрузкуТовары.Ссылка.Дата КАК Дата
			|ИЗ
			|	Документ.Лико_ЗаявкаНаОтгрузку.Товары КАК Лико_ЗаявкаНаОтгрузкуТовары
			|ГДЕ
			|	НЕ Лико_ЗаявкаНаОтгрузкуТовары.Ссылка.ПометкаУдаления
			|	И Лико_ЗаявкаНаОтгрузкуТовары.ЗаказКлиента = &ЗаказКлиента
			|	И Лико_ЗаявкаНаОтгрузкуТовары.Номенклатура В(&МассивНоменклатур)
			|	И Лико_ЗаявкаНаОтгрузкуТовары.Ссылка.СостояниеЗаявки <> ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаявокНаТранспортировку.Закрыт)
			|
			|СГРУППИРОВАТЬ ПО
			|	Лико_ЗаявкаНаОтгрузкуТовары.Ссылка,
			|	Лико_ЗаявкаНаОтгрузкуТовары.НомерСтроки,
			|	Лико_ЗаявкаНаОтгрузкуТовары.Ссылка.Номер,
			|	Лико_ЗаявкаНаОтгрузкуТовары.Ссылка.Дата";
		
		Запрос.УстановитьПараметр("ЗаказКлиента", Объект.Ссылка);
		Запрос.УстановитьПараметр("МассивНоменклатур", МассивНоменклатурыВСсылке);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		СтрокаЗаявок = "";
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СтрокаЗаявок = СтрокаЗаявок + ?(ЗначениеЗаполнено(СтрокаЗаявок), ", ", "") + ВыборкаДетальныеЗаписи.Номер + " от " + Формат(ВыборкаДетальныеЗаписи.Дата, "ДФ=dd.MM.yy") + " (строка " + ВыборкаДетальныеЗаписи.НомерСтроки + ")";	
		КонецЦикла;

		Если ЗначениеЗаполнено(СтрокаЗаявок) Тогда
			Отказ = Истина;
			Сообщить("Вы изменили номенклатуру в заказе, которая уже содержится в заявке на отгрузку. Чтобы записать заказ, сначала нужно удалить заявку на отгрузку. Список заявок: " + СтрокаЗаявок);
		КонецЕсли;
	
	КонецЕсли;		
	
КонецПроцедуры

&НаСервере
Процедура СформироватьАвтоМонтаж(Отказ)
	ЕстьИзмениеия=Ложь;
	
	Если Объект.Площадка=Справочники.Лико_Площадки.Урал Тогда
		Если Объект.Ручьи<>Объект.Ссылка.Ручьи Или
			 Объект.ЭтикетокНаЛисте<>Объект.Ссылка.ЭтикетокНаЛисте Или Объект.Товары.Количество()<>Объект.Ссылка.Товары.Количество() Тогда
			 ЕстьИзмениеия=Истина;
		 КонецЕсли;
		 	Индекс=0; 
		 Если Не ЕстьИзмениеия Тогда 
		 Для каждого Товар Из Объект.Товары Цикл
			 
			 Если Товар.Количество<>Объект.Ссылка.Товары[Индекс].Количество Или 
				 Товар.Номенклатура<>Объект.Ссылка.Товары[Индекс].Номенклатура Тогда
				 ЕстьИзмениеия=Истина;
				 Прервать;
			КонецЕсли;
			Индекс=Индекс+1;
	
		КонецЦикла;
	КонецЕсли;	 
			 
	КонецЕсли;
	Если ЕстьИзмениеия Тогда
		СоздатьМонтаж();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура СоздатьМонтаж()
	Отказ=Ложь;
	Тираж=Объект.Товары.итог("Количество");
	Если ЗначениеЗаполнено(Объект.РучьиПечатиИндиго) Тогда
		лРучьи=Объект.РучьиПечатиИндиго;
	ИначеЕсли ЗначениеЗаполнено(Объект.РучьиПечати) Тогда
		лРучьи=Объект.РучьиПечати;
	Иначе
		лРучьи=Объект.Ручьи;
	КонецЕсли;

	тираж_на_руч=Тираж/лРучьи;
	НомерТекущегоМонтажа=1;

	Для каждого Товар Из Объект.Товары Цикл
		//ручьев_эт= Товар.Количество/тираж_на_руч;
		ручьев_эт= Окр(Товар.Количество/тираж_на_руч,2);
		Если  ручьев_эт-Цел(ручьев_эт)<>0  Тогда
			Сообщить("По номенклатуре: "+Товар.Номенклатура.Наименование+" количество ручьев на этикетку дробное:"+Строка( ручьев_эт)+"."); 
			Отказ=Истина;
		КонецЕсли;
	КонецЦикла;

	Если Отказ Тогда
		Сообщить("Автозаполнение монтажа не выполнено!");
		Возврат;
	КонецЕсли;
	Объект.МонтажСхема.Очистить();
	Объект.МонтажСоответствия.Очистить();

	КоличествоСтрокМонтажа=Цел(Объект.ЭтикетокНаЛисте / лРучьи);
	Для каждого Товар Из Объект.Товары Цикл
		НовыйТовар= Объект.МонтажСоответствия.Добавить();
		НовыйТовар.Номенклатура= Товар.Номенклатура;
	КонецЦикла;
	Для Лист=1 По КоличествоСтрокМонтажа Цикл

		Ручей=0;
		Индекс=0;
		Для каждого Товар Из Объект.Товары Цикл
			Индекс=Индекс+1;
			//ручьев_эт= Товар.Количество/тираж_на_руч;
			ручьев_эт= Окр(Товар.Количество/тираж_на_руч,2);
			Если  ручьев_эт-Цел(ручьев_эт)<>0  Тогда
				//Сообщить("Количество ручьев рсчитано не првильно!"); 
				//Отказ=Истина;
			Иначе
				//Если Не Отказ Тогда
				Для Сч=1  По ручьев_эт Цикл
					Ручей=Ручей+1;
					//Индекс=Товар.ПолучитьИдентификатор()+1;

					ТекущийИндексСтроки = НомерТекущегоМонтажа*1000000 + Лист*1000 +Ручей;

					НовыйМС=Объект.МонтажСхема.Добавить();
					НовыйМС.ИндексСтроки=ТекущийИндексСтроки;
					НовыйМС.ИндексНоменклатуры=Индекс; 				 
				КонецЦикла;
				//КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

