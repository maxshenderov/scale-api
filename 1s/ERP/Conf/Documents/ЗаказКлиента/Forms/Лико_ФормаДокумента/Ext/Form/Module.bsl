&НаСервереБезКонтекста
Функция ЗаменитьСвойствоВСтрочнойСтруктуре(строка, Свойство, Замена)

	СтруктураИзСтроки = ЗначениеИзСтрокиВнутр(строка); 
	СтруктураИзСтроки.Вставить(Свойство, Замена);
	
	Возврат ЗначениеВСтрокуВнутр(СтруктураИзСтроки);
	
КонецФункции    

&НаСервереБезКонтекста
Функция ПолучитьИмяПоНомеруСекции(РЦ, НомерСекции)


	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РабочиеЦентрыСекции.Имя КАК Имя
		|ИЗ
		|	Справочник.РабочиеЦентры.Секции КАК РабочиеЦентрыСекции
		|ГДЕ
		|	РабочиеЦентрыСекции.Ссылка.Ссылка = &Ссылка
		|	И РабочиеЦентрыСекции.НомерСтроки = &НомерСтроки";
	
	Запрос.УстановитьПараметр("НомерСтроки", НомерСекции);
	Запрос.УстановитьПараметр("Ссылка", РЦ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	ИмяСекции = "";
	
	Пока Выборка.Следующий() Цикл
		 ИмяСекции = Выборка.Имя; 
	КонецЦикла;
	
	Возврат ИмяСекции
	
КонецФункции    

&НаСервереБезКонтекста
Функция ВозможноУстановитьЭтотНомер(РЦ, НомерСекции, ВидСекции)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РабочиеЦентрыВидыСекций.ВидСекции КАК ВидСекции
		|ИЗ
		|	Справочник.РабочиеЦентры.Секции КАК РабочиеЦентрыСекции
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РабочиеЦентры.ВидыСекций КАК РабочиеЦентрыВидыСекций
		|		ПО РабочиеЦентрыСекции.КлючСтроки = РабочиеЦентрыВидыСекций.КлючСтроки
		|ГДЕ
		|	РабочиеЦентрыСекции.НомерСтроки = &НомерСтроки
		|	И РабочиеЦентрыСекции.Ссылка.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("НомерСтроки", НомерСекции);  
	Запрос.УстановитьПараметр("Ссылка", РЦ);

	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидСекции");
	

	Если РезультатЗапроса.Найти(ВидСекции) <> Неопределено или РезультатЗапроса.Найти(ВидСекции.родитель) <> Неопределено  Тогда
		Возврат Истина
	Иначе
		возврат Ложь
	КонецЕсли;

	
КонецФункции


&НаСервере
Процедура ОбновитьРасчетТиражейНаСервере(ТолькоОбновитьТЧНормативовИЗатрат = Неопределено)
		
	Если ТолькоОбновитьТЧНормативовИЗатрат = Неопределено ИЛИ ТолькоОбновитьТЧНормативовИЗатрат = Ложь Тогда
		объект.РасчетТиражей.Очистить();
		РасчетТиражейНормативы.Очистить();
		РасчетТиражейЗатраты.Очистить();
	ИначеЕсли ТолькоОбновитьТЧНормативовИЗатрат Тогда
		РасчетТиражейНормативы.Очистить();
		РасчетТиражейЗатраты.Очистить();
	КонецЕсли;
	
	//Тираж = Объект.Тираж;
	//ШТКВМ = Объект.ШтКВМ;    
	//НарезкаРазмер = Объект.Нарезка.Размер/1000;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ЗаказКлиентаЦвета.ВидСекции.ОтображатьВТЧЦвета
	|				И НЕ ЗаказКлиентаЦвета.ВидСекции.ОтображатьВТЧРаботы
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Печать)
	|		ИНАЧЕ ЗаказКлиентаЦвета.ВидСекции
	|	КОНЕЦ КАК ВидРабот,
	|	ЗаказКлиентаЦвета.НомерРаботы КАК НомерРаботы,
	|	ЗаказКлиентаЦвета.НомерПроката КАК НомерПроката,
	|	СУММА(ВЫБОР
	|			КОГДА ЗаказКлиентаЦвета.ВидСекции.ВидРабот.Родитель <> ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Тиснение)
	|				ТОГДА 1
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ЗаказКлиентаЦвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ГорячееТиснениеРотационное)
	|						ТОГДА 1
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		КОНЕЦ) КАК КоличествоМатериалов,
	|	СУММА(ВЫБОР
	|			КОГДА ЗаказКлиентаЦвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ГорячееТиснениеРотационное)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоТиснений,
	|	ЗаказКлиентаЦвета.Ссылка КАК Заказ
	|ПОМЕСТИТЬ ВТМатериалы
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	|ГДЕ
	|	ЗаказКлиентаЦвета.Ссылка = &Заказ
	|	И ЗаказКлиентаЦвета.Материал <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
	|	И ЗаказКлиентаЦвета.Материал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И ЗаказКлиентаЦвета.Материал <> НЕОПРЕДЕЛЕНО
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ЗаказКлиентаЦвета.ВидСекции.ОтображатьВТЧЦвета
	|				И НЕ ЗаказКлиентаЦвета.ВидСекции.ОтображатьВТЧРаботы
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Печать)
	|		ИНАЧЕ ЗаказКлиентаЦвета.ВидСекции
	|	КОНЕЦ,
	|	ЗаказКлиентаЦвета.НомерРаботы,
	|	ЗаказКлиентаЦвета.Ссылка,
	|	ЗаказКлиентаЦвета.НомерПроката
	|;
