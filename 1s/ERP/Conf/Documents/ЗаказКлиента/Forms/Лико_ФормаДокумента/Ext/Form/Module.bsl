	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		Если Выборка.ЦГКодПлан <> Выборка.ЦГКодФакт Тогда
			СписокОтличий = СписокОтличий + "Различаются плановая "+ СокрЛП(Выборка.ЦГКодПлан)+ " и фактическая ценовая группа " + СокрЛП(Выборка.ЦГКодФакт) + Выборка.Описание  + символы.ПС;
		КонецЕсли;		
	КонецЦикла;	
	
	

	Возврат  СписокОтличий
	
КонецФункции	

&НаСервере
Функция СоздатьПовторЗаказаНаСервере(ВидЗаказа, Регион = Неопределено, ЗаменитьКоды = Ложь,Различия)
	УстановитьПривилегированныйРежим(Истина);
	НовыйЗаказ = Объект.Ссылка.скопировать();
	НовыйЗаказ.Руководитель = Справочники.ОтветственныеЛицаОрганизаций.ПустаяСсылка();
	НовыйЗаказ.ГлавныйБухгалтер = Справочники.ОтветственныеЛицаОрганизаций.ПустаяСсылка();
	
	//ОчиститьПараметрыНамотки(НовыйЗаказ);
	//НовыйЗаказ.Версия = 0;
	// <-- Начало Лико Яцун С. В. 30.10.2025 
	Если ВидЗаказа = "ПолныйПовторСТекНомером" Тогда
		НовыйЗаказ.ПовторЗаказа = Объект.Ссылка;
		ВидЗаказа = "ПолныйПовтор";
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 30.10.2025 
	НовыйЗаказ.ВидЗаказа =  Перечисления.Лико_ВидыЗаказов[ВидЗаказа];

	Если НовыйЗаказ.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПолныйПовтор 
		И НовыйЗаказ.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПовторСНовымОбъединением
		И НовыйЗаказ.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПовторСИзменением
		И НовыйЗаказ.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПолныйПовторСПереводомНаДругуюМашину
		И НовыйЗаказ.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.СложныйПовтор Тогда
		НовыйЗаказ.СвойстваМатериала = Неопределено;	
	КонецЕсли;
	Если НовыйЗаказ.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПолныйПовтор 
		И НовыйЗаказ.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПовторСИзменением Тогда
		НовыйЗаказ.ЗаказчикЭмиссииЧЗ = Неопределено;	
		НовыйЗаказ.ЭмитентЧЗ = Неопределено;	
		НовыйЗаказ.СтранаТовараЧЗ = Неопределено;	
		НовыйЗаказ.ТипКодаЧЗ = Неопределено;	
		НовыйЗаказ.ТипМаркировкиЧЗ = Неопределено;	
	КонецЕсли;

    // <-- Начало Лико Яцун С. В. 21.01.2026
	Если НуженРасчетНарезки(НовыйЗаказ.ВидЗаказа) Тогда
		Если НовыйЗаказ.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПолныйПовтор Тогда
			НовыйЗаказ.РучнойВводНарезки = Неопределено;	
		КонецЕсли;
		Если ЗначениеЗаполнено(НовыйЗаказ.ШтампВырубной) Тогда 
			НовыйЗаказ.НарезкаРасчетная = Неопределено;
			НовыйЗаказ.Нарезка = Неопределено;
		КонецЕсли; 
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 21.01.2026
	
	// <-- Начало Лико Яцун С. В. 28.08.2024   
	Если НовыйЗаказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Новый ИЛИ НовыйЗаказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Шаблон Тогда
		НовыйЗаказ.Формы.Очистить();
		Для каждого Стр Из НовыйЗаказ.Цвета Цикл
			// --> Начало Лико Ефимов ЕВВ 20.06.2025
			Если Лико_Дополнительно.ЭтоСтрокаСплошнойФормы(Стр) Тогда
				Продолжить;
			КонецЕсли; 
			// <-- Конец Лико Ефимов ЕВВ 20.06.2025
			Стр.Вал = Неопределено;
			Стр.Форма = Неопределено;
		КонецЦикла;
	// --> Начало Лико Ефимов ЕВВ 16.09.2024
	ИначеЕсли НовыйЗаказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.НовыйССохранениемФорм Тогда	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Лико_БланкЭтапа.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.Лико_БланкЭтапа КАК Лико_БланкЭтапа
			|ГДЕ
			|	Лико_БланкЭтапа.ЗаказПокупателя = &ЗаказПокупателя
			|	И Лико_БланкЭтапа.Проведен
			|	И НЕ Лико_БланкЭтапа.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ЗаказПокупателя", Объект.Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
		ПоЗаказуНетЗакрытий = РезультатЗапроса.Пустой();

		Для каждого Стр из НовыйЗаказ.Цвета Цикл
			Стр.ЗаказФорм = Объект.Ссылка;
			Если ПоЗаказуНетЗакрытий Тогда 
				Стр.Форма = Неопределено;
			КонецЕсли;
		КонецЦикла;
	// <-- Конец Лико Ефимов ЕВВ 16.09.2024
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 28.08.2024
	// --> Начало Лико Ефимов ЕВВ 03.04.2024
	Если НовыйЗаказ.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПолныйПовтор Тогда
		НовыйЗаказ.ДействиеСИзлишками = Неопределено;
	ИначеЕсли НЕ ЗначениеЗаполнено(НовыйЗаказ.ДействиеСИзлишками) И ЗначениеЗаполнено(Объект.ДействиеСИзлишками) Тогда // Для полного повтора заполним обратно, если при копировании очистили
		НовыйЗаказ.ДействиеСИзлишками = Объект.ДействиеСИзлишками;
	КонецЕсли;
	Если НовыйЗаказ.ЧестныйЗнак И Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(,НовыйЗаказ.Партнер,"УтилизироватьИзлишкиДляЧЗ",Ложь) Тогда
		НовыйЗаказ.ДействиеСИзлишками = Перечисления.Лико_ДействияСИзлишками.Утилизировать;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 03.04.2024
	
	// --> Начало Лико Митюшин МФМ 09.03.2021
	//ОчиститьПараметрыОтВидаЗаказа(НовыйЗаказ.ВидЗаказа);
	// <-- Конец Лико Митюшин МФМ 09.03.2021
	//НовыйЗаказ.РазрешитьОтрицательнуюДоходность = Ложь;

	Если Регион<>Неопределено Тогда 
		НовыйЗаказ.Регион = Регион;
	КонецЕсли;
	
	Если НовыйЗаказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПричинаРекламация Тогда
		НовыйЗаказ.Номер = Лев(Объект.Номер, 6)+"7"+Прав(Объект.Номер, 4);
		НовыйЗаказ.Менеджер = Объект.Менеджер;
		НовыйЗаказ.ИсходныйЗаказ = Объект.Ссылка;
	ИначеЕсли НовыйЗаказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка Тогда
		НовыйЗаказ.Номер = Лев(Объект.Номер, 6)+"8"+Прав(Объект.Номер, 4);	
		НовыйЗаказ.Менеджер = Объект.Менеджер;
		НовыйЗаказ.ИсходныйЗаказ = Объект.Ссылка;
	КонецЕсли;	
	//НовыйЗаказ.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний");
	//НовыйЗаказ.способдоставки = Перечисления.СпособыДоставки.Самовывоз;
	Если Не ЗначениеЗаполнено(НовыйЗаказ.НалогообложениеНДС) Тогда 
		НовыйЗаказ.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС; 
	КонецЕсли;	
	Если ЗаменитьКоды Тогда 
		
		//+ Субботин 11.01.2022
		//Различия - массив Структур("Название, НомерСтроки, Факт"); 
		Для Каждого стр из Различия цикл 
			  
			Если стр.Название = "Основной материал" Тогда 
				НовыйЗаказ.ОсновнойМатериал = стр.Факт;				
			КонецЕсли;   
			
			Если стр.Название = "Тип краски (Цвета)" Тогда 
				НовыйЗаказ.Цвета[стр.НомерСтроки-1].ТипКраски = стр.Факт;
				//НовыйЗаказ.Цвета[стр.НомерСтроки-1].ТипКраскиФакт = Неопределено;
			КонецЕсли;		
			
			Если лев(стр.Название, 8) = "Материал" Тогда 
				НовыйЗаказ.Цвета[стр.НомерСтроки-1].Материал = стр.Факт; 
				//НовыйЗаказ.Цвета[стр.НомерСтроки-1].МатериалФакт = Неопределено;
			КонецЕсли;   
			
			Если лев(стр.Название, 4) = "Клей" Тогда 
				//НовыйЗаказ.ВидыРабот[стр.НомерСтроки-1].Клей = стр.Факт;
				//НовыйЗаказ.ВидыРабот[стр.НомерСтроки-1].КлейФакт = Неопределено;
			КонецЕсли;
			
		КонецЦикла;
		//- Субботин 11.01.2022
		
	КонецЕсли;
	//Подсистема DFM
	НовыйЗаказ.НоменклатураDFM=DFMСервер.ЭтоНоменклатураDFM(
	НовыйЗаказ.РабочийЦентр,
	НовыйЗаказ.ТипЗаказа,
	ДатаНачалаСозданияНоменклатурыDFM И Объект.Цвета.Количество()>0,
	НовыйЗаказ.ДатаПервойОтправкиВРаботу,
	Объект.Товары.Выгрузить(),
	НовыйЗаказ.Партнер);
	ПроверитьНоменклатуруDFM(НовыйЗаказ.Товары,НовыйЗаказ.РабочийЦентр);  
	//Подсистема DFM
	
	НовыйЗаказ.Записать();
	НовыйЗаказ.НомерБезПрефикса = Прав(НовыйЗаказ.Номер,7);
	НовыйЗаказ.Записать();
	Возврат НовыйЗаказ.ссылка;
	УстановитьПривилегированныйРежим(Ложь);

КонецФункции


&НаКлиенте
Процедура СоздатьПовторЗаказа(Команда)
	Если ЭтаФорма.Модифицированность Тогда
		Сообщить("Необходимо записать документ!");
		Возврат;
	КонецЕсли;	

	ВидПовтора = Сред(Команда.Имя, 8);
	//ПодключитьОбработчикОжидания("ПредупредитьОбИзменениях", 0.1, Истина);
	
	СписокОтличий = ПолучитьСписокОтличийПланФакт();
	Если ЗначениеЗаполнено(СписокОтличий)  Тогда 
		//Режим = РежимДиалогаВопрос.ДаНет;
		//Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗаменеКодов", ЭтотОбъект, ВидПовтора);
		//ПоказатьВопрос(Оповещение,СписокОтличий+  НСтр("ru = 'Заменить плановые значения на фактические?';"), Режим, 0);
		
		//+ Субботин 11.01.22
		ВыполняемаяОбработка = НайтиВПФ("Обработка ""лк СписокОтличийПовтор""");
		Если ВыполняемаяОбработка.Пустая() Тогда
			Возврат;
		КонецЕсли;
		ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВыполняемаяОбработка);
		ПараметрыНаФорму = Новый Структура;  
////Надо поменять на Площадку новую Иванова 20241003		
		ПараметрыНаФорму.Вставить("Площадка", Объект.Площадка);	
		ПараметрыНаФорму.Вставить("Ссылка", Объект.Ссылка);
		ОбработкаЗакрытия = Новый ОписаниеОповещения("ПослеЗакрытияОбработкиСписокОтличийПовтор", ЭтотОбъект, ВидПовтора);			
		ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма", ПараметрыНаФорму ,ЭтаФорма,,,,ОбработкаЗакрытия);
		//-	Субботин 11.01.22
				
	Иначе
	
		Если ПроверитьДоступностьНаСервере("Лико_ДобавлениеИзменениеЗаказовПоПлощадке")
			ИЛИ ПроверитьДоступностьНаСервере("ПолныеПрава")
			// --> Начало Лико Ефимов ЕВВ 17.09.2024
			// письмо 17.09.24 15:13
			ИЛИ Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("ПараметрыСеанса.ТекущийПользователь.Наименование") = "Горе Марина Вадимовна"
			ИЛИ Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("ПараметрыСеанса.ТекущийПользователь.Наименование") = "Сергеева Марина"
			// <-- Конец Лико Ефимов ЕВВ 17.09.2024
			Тогда 
			ПараметрыСоздания = Новый Структура;
			ПараметрыСоздания.Вставить("ВидПовтора",ВидПовтора);
			ПараметрыСоздания.Вставить("ЗаменитьКоды",Ложь);  
			ПараметрыСоздания.Вставить("Различия", Неопределено);

			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораРегионаДляСозданияПовтора",ЭтотОбъект,ПараметрыСоздания);
			ПоказатьВводЗначения(ОписаниеОповещения, Неопределено, , Тип("СправочникСсылка.БизнесРегионы"));
		Иначе
			Повтор = СоздатьПовторЗаказаНаСервере(ВидПовтора, ,Ложь,);	
			ПараметрыФормы    = новый Структура("Ключ,ЗаказКопирования",Повтор,Объект.Ссылка);
			ОткрытьФорму("Документ.ЗаказКлиента.Форма.Лико_ФормаДокумента", ПараметрыФормы);
		//ЭтаФорма.Закрыть();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеЗакрытияОбработкиСписокОтличийПовтор(Результат, ВидПовтора) Экспорт
	
	Если Результат = неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если  Результат.Количество() <> 0 Тогда 
		ЗаменитьКоды = Истина;
	Иначе
		ЗаменитьКоды = Ложь;
	КонецЕсли;

	Если ПроверитьДоступностьНаСервере("Лико_ДобавлениеИзменениеЗаказовПоПлощадке")
		ИЛИ ПроверитьДоступностьНаСервере("ПолныеПрава")
		// --> Начало Лико Ефимов ЕВВ 17.09.2024
		// письмо 17.09.24 15:13
		ИЛИ Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("ПараметрыСеанса.ТекущийПользователь.Наименование") = "Горе Марина Вадимовна"
		ИЛИ Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("ПараметрыСеанса.ТекущийПользователь.Наименование") = "Сергеева Марина"
		// <-- Конец Лико Ефимов ЕВВ 17.09.2024
		Тогда 
		ПараметрыСоздания = Новый Структура;
		ПараметрыСоздания.Вставить("ВидПовтора", ВидПовтора);
		ПараметрыСоздания.Вставить("ЗаменитьКоды", ЗаменитьКоды); 
		ПараметрыСоздания.Вставить("Различия", Результат);

		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораРегионаДляСозданияПовтора",ЭтотОбъект, ПараметрыСоздания);
		ПоказатьВводЗначения(ОписаниеОповещения, Неопределено, , Тип("СправочникСсылка.БизнесРегионы"));
	Иначе
		Повтор = СоздатьПовторЗаказаНаСервере(ВидПовтора,, ЗаменитьКоды,Результат);	                               
		ПараметрыФормы    = новый Структура("Ключ,ЗаказКопирования",Повтор,Объект.Ссылка);
		ОткрытьФорму("Документ.ЗаказКлиента.Форма.Лико_ФормаДокумента", ПараметрыФормы);
	КонецЕсли;


КонецПроцедуры


&НаСервере
Процедура ОчиститьПараметрыНамотки(Заказ)
	Если Заказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Пробник И Заказ.Площадка.Организация = Справочники.Лико_Площадки.Ликофлекс.Организация Тогда
		Для Каждого стр Из Заказ.Товары Цикл
			стр.Направление = Справочники.Лико_Намотка.ПустаяСсылка();
			стр.ВнутреннийДиаметр = Справочники.Лико_Втулки.ПустаяСсылка();
			стр.МаксимальныйДиаметрРулона = 0;
			стр.КоличествоЭтикетокВРолике = 0;
			стр.ДиаметрРоликаФакт = 0;
			стр.ПродольнаяРезка = Ложь;
			стр.ПоперечнаяРезка = Ложь;
			стр.Кромка = 0;
			стр.БезКромки = Ложь;
			стр.ПодрезкаКромки = Ложь;
			стр.Город = "";
			стр.ДопЭтикетокВРолике = 0;
		КонецЦикла;				
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПредупредитьОбИзменениях()
	СписокОтличий = ПолучитьСписокОтличийПланФакт();
	Если ЗначениеЗаполнено(СписокОтличий)  Тогда 
		ПоказатьПредупреждение(, СписокОтличий);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОЗаменеКодов(Результат, ВидПовтора) Экспорт
	Если  Результат =  КодВозвратаДиалога.Да Тогда 
		ЗаменитьКоды = Истина;
	Иначе
		ЗаменитьКоды = Ложь;
	КонецЕсли;

	Если ПроверитьДоступностьНаСервере("Лико_ДобавлениеИзменениеЗаказовПоПлощадке")
		ИЛИ ПроверитьДоступностьНаСервере("ПолныеПрава")
		// --> Начало Лико Ефимов ЕВВ 17.09.2024
		// письмо 17.09.24 15:13
		ИЛИ Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("ПараметрыСеанса.ТекущийПользователь.Наименование") = "Горе Марина Вадимовна"
		ИЛИ Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("ПараметрыСеанса.ТекущийПользователь.Наименование") = "Сергеева Марина"
		// <-- Конец Лико Ефимов ЕВВ 17.09.2024
		Тогда 
		ПараметрыСоздания = Новый Структура;
		ПараметрыСоздания.Вставить("ВидПовтора", ВидПовтора);
		ПараметрыСоздания.Вставить("ЗаменитьКоды",ЗаменитьКоды);

		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораРегионаДляСозданияПовтора",ЭтотОбъект, ПараметрыСоздания);
		ПоказатьВводЗначения(ОписаниеОповещения, Неопределено, , Тип("СправочникСсылка.БизнесРегионы"));
	Иначе
		Повтор = СоздатьПовторЗаказаНаСервере(ВидПовтора,, ЗаменитьКоды,);	                               
		ПараметрыФормы    = новый Структура("Ключ,ЗаказКопирования",Повтор,Объект.Ссылка);
		ОткрытьФорму("Документ.ЗаказКлиента.Форма.Лико_ФормаДокумента", ПараметрыФормы);
	////ЭтаФорма.Закрыть();
	КонецЕсли;


КонецПроцедуры


