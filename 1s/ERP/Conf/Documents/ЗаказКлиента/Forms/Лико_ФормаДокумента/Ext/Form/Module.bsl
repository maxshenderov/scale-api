&НаСервере
Функция ПолучитьАртикулИзСправочникаВерсииНоменклатуры(Номенклатура, Версия)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Лико_ВерсииНоменклатуры.Номенклатура КАК Номенклатура,
	               |	Лико_ВерсииНоменклатуры.Версия КАК Версия,
	               |	Лико_ВерсииНоменклатуры.Артикул КАК Артикул
	               |ИЗ
	               |	Справочник.Лико_ВерсииНоменклатуры КАК Лико_ВерсииНоменклатуры
	               |ГДЕ
	               |	Лико_ВерсииНоменклатуры.Ссылка = &Версия
	               |	И Лико_ВерсииНоменклатуры.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Версия", Версия);
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() <> 1 Тогда
		Артикул = Номенклатура.Артикул;
	Иначе
		Артикул = Результат[0].Артикул;
	КонецЕсли;
	Возврат Артикул;
КонецФункции
	

