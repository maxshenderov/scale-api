	// <-- Конец Лико Яцун 26.04.2022
	
	Если НЕ (РольДоступна("Лико_ДобавлениеИзменениеГлубокойОснастки") ИЛИ РольДоступна("ПолныеПрава")) Тогда
		Элементы.ФормыГлубокой.Доступность = Ложь;	
