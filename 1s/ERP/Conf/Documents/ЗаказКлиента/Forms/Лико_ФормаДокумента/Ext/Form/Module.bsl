&НаКлиенте
//при утвердить цвета
Функция ПроверкаЗаполненияЦветовКлиент()
	
	ЕстьЦветоделение = Ложь;  
	БезЛака = Истина;
	ТолькоСплошнаяЗаливка = Истина;
	СписокНеЦифровыхФорм = Новый СписокЗначений;
	
	Для каждого стр из объект.Цвета цикл  
		
		ТипКраски = стр.ТипКраски;   
		ВидСекции = стр.ВидСекции;
		ВидПечати = ЗначениеРеквизита(ВидСекции, "ВидПечати"); 
		ТипЦвета  = стр.ТипЦвета1;
		НомерСтроки = стр.НомерСтроки;  
		
		Если стр.Цветоделение Тогда
			ЕстьЦветоделение = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВидСекции) Тогда
			Возврат СтрШаблон("Не указан Вид работ в строке %1. Цвета не утверждены", НомерСтроки)       
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(стр.РабочийЦентр) Тогда
			Возврат СтрШаблон("Не указан Рабочий Центр в строке %1. Цвета не утверждены", НомерСтроки)       
		КонецЕсли;  
		
		Если ЗначениеЗаполнено(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(стр.РабочийЦентр,"Лико_ДатаОкончания")) 
			И Лико_Дополнительно.ЗначениеРеквизитаОбъекта(стр.РабочийЦентр,"Лико_ДатаОкончания") < ТекущаяДата() Тогда
			Возврат СтрШаблон("Указан не действующий Рабочий Центр в строке %1. Цвета не утверждены", НомерСтроки)       
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(стр.НомерПроката) Тогда
			Возврат СтрШаблон("Не указан Номер проката в строке %1. Цвета не утверждены", НомерСтроки)       
		КонецЕсли;  
		//В заказе не может быть одинаковых форм если они не цифровые
		Если ЗначениеЗаполнено(Стр.Форма)
			И Стр.ВидСекции <> ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Цифровая")
			// --> Начало Лико Ефимов ЕВВ 14.07.2025
			// Сплошные тоже не проверяем
