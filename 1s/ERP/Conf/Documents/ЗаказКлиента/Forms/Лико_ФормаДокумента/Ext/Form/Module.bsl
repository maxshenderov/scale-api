Функция ВернутьКонтрольныйХэш()
	
	СтруктураДляПроверки = новый Структура;
	СтруктураДляПроверки.Вставить("ОсновнойМатериал", Объект.ОсновнойМатериал);  
	СтруктураДляПроверки.Вставить("МетражПМ", Объект.МетражПМ);    
	СтруктураДляПроверки.Вставить("Нарезка", Объект.Нарезка);  
	СтрокаКодов = "";
	Для каждого стр из Объект.Цвета Цикл   
		СтрокаКодов = СтрокаКодов + СтрШаблон("%1%2", ?(ЗначениеЗаполнено( стр.КодМатериала), стр.КодМатериала, ""), ?(ЗначениеЗаполнено( стр.Нарезка), стр.Нарезка, "") );
	КонецЦикла;
    СтруктураДляПроверки.Вставить("СтрокаКодов", СтрокаКодов);

	Возврат ОбщегоНазначения.КонтрольнаяСуммаСтрокой(СтруктураДляПроверки)

	
КонецФункции


