		//	НоменклатураОснМатериала = ?(ТипЗнч(Объект.ОсновнойМатериал) = Тип("СправочникСсылка.Номенклатура"),Объект.ОсновнойМатериал,Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Объект.ОсновнойМатериал,"ОсновнаяНоменклатура"));
		//	СвойстваОснМатериала = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(НоменклатураОснМатериала,"Лико_СвойстваМатериала");
