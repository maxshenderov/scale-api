&НаСервере
Процедура Пересчитать_ПереотправитьЗаказВРаботу(Отказ, НаправитьВработу = Истина, ПодниматьВерсию = Истина, ПричиныЗамены = Неопределено)
	НачатьТранзакцию();
	ВидЗаказа = Объект.ВидЗаказа;
	ПредыдущийВидЗаказа = Объект.Ссылка.ВидЗаказа;
	Записать();
	Если ВидЗаказа <> ПредыдущийВидЗаказа И Объект.Площадка <> Справочники.Лико_Площадки.Линкс Тогда 
		Если ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПовторСИзменением ИЛИ ВидЗаказа = Перечисления.Лико_ВидыЗаказов.СложныйПовтор ИЛИ ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Новый Тогда
			Если Не ( ПредыдущийВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПовторСИзменением ИЛИ ПредыдущийВидЗаказа = Перечисления.Лико_ВидыЗаказов.СложныйПовтор ИЛИ ПредыдущийВидЗаказа = Перечисления.Лико_ВидыЗаказов.Новый) Тогда
				Лико_Планирование.ПереписатьАртикулыНоменклатуры(Объект.Ссылка);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Не (рольДоступна("ПолныеПрава") ИЛИ РольДоступна("Лико_ЗакрытиеОтгрузки")) Тогда
		РезультатПроверки = ПроверкаЗаполненияЗаказаНаСервере();
		Если РезультатПроверки<>Истина Тогда 
			Сообщить(РезультатПроверки+ " "+ "Заказ не отправлен в работу!!!");
			ОтменитьТранзакцию();
			Отказ = Истина;
			Прочитать();
			Возврат
		КонецЕсли;
	КонецЕсли;

	РассчитатьЗаказНаСервере(Объект.Ссылка, Отказ);
	Если  Отказ Тогда
		ОтменитьТранзакцию();
		Сообщить("Заказ не отправлен в работу!!!");
		Прочитать();
		Возврат;
	КонецЕсли;
	
	Если НаправитьВРаботу Тогда 
		НаправитьВРаботуНаСервере(Объект.Ссылка, Отказ,ПодниматьВерсию, ПричиныЗамены);
		Если Отказ Тогда 
			ОтменитьТранзакцию();
			Сообщить("Заказ не отправлен в работу!!!");
			Прочитать();
			Возврат;
		КонецЕсли;
	КонецЕсли;	

	ЗафиксироватьТранзакцию();	
КонецПроцедуры

