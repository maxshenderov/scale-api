&НаСервере
Функция ПолучитьРЦПоНомеруНаСервере(ПорядковыйНомер)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(РабочиеЦентры.Ссылка, ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.ПустаяСсылка)) КАК РЦ
	|ИЗ
	|	Справочник.РабочиеЦентры КАК РабочиеЦентры
	|ГДЕ
	|	РабочиеЦентры.ПорядковыйНомер = &ПорядковыйНомер";
	Запрос.УстановитьПараметр("ПорядковыйНомер", ПорядковыйНомер);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Если ЗначениеЗаполнено(Результат.РЦ) Тогда
		Возврат Результат.РЦ
	Иначе
		Возврат Справочники.РабочиеЦентры.ПустаяСсылка();
	КонецЕсли;

КонецФункции

&НаСервере
Процедура РассчитатьНормативыПоОтгрузкеНаСервере(Идентификатор)
	текстр = Объект.Отгрузки.НайтиПоИдентификатору(Идентификатор);
	количество = текстр.количество*1000;

		
	ТаблицаРЦ =Лико_Планирование.ПолучитьРЦПоПеределам(Объект.Ссылка, текстр.РабочийЦентр);
	
	МетрыНаБрак = 0;
	МетрыНаНастройку = 0;
	МойкаСекций = 0;
	ОбщееВремяВыполненияЗаказа = 0;
	БракНастройкаГалакси = 0;
	БракНастройкаНьюФойл =0;
	ВремяИзготовления = 0;
	ВремяВыполненияЗаказаВЧасах=0;
	ВремяВыполненияНФ =0;
	ЗатратыНаМатериалы = 0;
	РасчетЗП=Ложь;
	РасчетноеКоличествоКликов = 0;
	//Необходимо очистить параметры
	Для каждого ТекРЦ из ТаблицаРЦ Цикл 
		КоличествоНастроек = текстр.Настройка;
		НормативыДляРЦ=  Лико_Планирование.РассчитатьНормативыДляРЦ(Объект.ссылка, текстр.ПогонныйМетраж,ТекРЦ.РЦ, МетрыНаБрак, МетрыНаНастройку, текРЦ.НомерПроката, количество);	
		стрНормативы = Объект.Нормативы.Добавить();
		стрНормативы.НомерОтгрузки =  текстр.ключстроки;
		стрНормативы.НомерПроката = текРЦ.НомерПроката;
		стрНормативы.РабочийЦентр = ТекРЦ.РЦ; //ТекРЦ.Значение;
	//	
	//	Если ТипЗнч(НормативыДляРЦ) <>Тип("Строка") Тогда
	//			
			МетрыНаБрак = МетрыНаБрак +НормативыДляРЦ.МетрыНаБрак;
			МетрыНаНастройку = МетрыНаНастройку+НормативыДляРЦ.МетрыНаНастройку*КоличествоНастроек;
			МойкаСекций = МойкаСекций+НормативыДляРЦ.МойкаСекций;
			//Т.к. настроек может быть несколько!
			ОбщееВремяВыполненияЗаказа =ОбщееВремяВыполненияЗаказа+НормативыДляРЦ.ВремяПечати+НормативыДляРЦ.ВремяНаНастройку*КоличествоНастроек;
					

			стрНормативы.МетрыНаНастройку = НормативыДляРЦ.МетрыНаНастройку*КоличествоНастроек;
			стрНормативы.МетрыНаБрак = НормативыДляРЦ.МетрыНаБрак;
			стрНормативы.ВремяПечати = Окр(НормативыДляРЦ.ВремяПечати/60,2);
			стрНормативы.ВремяНаНастройку = Окр(НормативыДляРЦ.ВремяНаНастройку/60,2)*КоличествоНастроек;
			стрНормативы.ВремяНаСменуРоликов = Окр(НормативыДляРЦ.ВремяНаСменуРоликов/60,2);

			стрНормативы.СкоростьПечати = НормативыДляРЦ.СкоростьПечати;
			стрНормативы.МетражДляРЦ = текстр.ПогонныйМетраж+ МетрыНаБрак+МетрыНаНастройку;
			стрНормативы.ПроцентНаБрак = НормативыДляРЦ.ПроцентНаБрак*100;

			ВремяВыполненияЗаказаВЧасах = ВремяВыполненияЗаказаВЧасах+Окр(НормативыДляРЦ.ВремяПечати/60,2)+Окр(НормативыДляРЦ.ВремяНаНастройку/60,2)*КоличествоНастроек+Окр(НормативыДляРЦ.ВремяНаСменуРоликов/60,2);
			ВремяИзготовления = ВремяИзготовления+НормативыДляРЦ.ВремяПечати+НормативыДляРЦ.ВремяНаНастройку *КоличествоНастроек+НормативыДляРЦ.ВремяНаСменуРоликов;
			//Если ТекРЦ.РЦ.ВидРабочегоЦентра= Справочники.ВидыРабочихЦентров.NewFoil Тогда 
			//ВремяВыполненияНФ = ВремяВыполненияНФ+НормативыДляРЦ.ВремяПечати+НормативыДляРЦ.ВремяНаНастройку*КоличествоНастроек;	
			//КонецЕсли;
			
	        Нарезка =  ?(ЗначениеЗаполнено(Объект.НарезкаФакт), Объект.НарезкаФакт.Размер, Объект.Нарезка.Размер)/1000;
			текстр.общийметраж = стрНормативы.МетражДляРЦ * Нарезка; 
		Если НормативыДляРЦ.Свойство("ВсегоКликов") Тогда
			РасчетноеКоличествоКликов = НормативыДляРЦ.ВсегоКликов+РасчетноеКоличествоКликов;
		КонецЕсли;

	КонецЦикла;
	Если текстр.РабочийЦентр.видРабочегоЦентра = Справочники.видырабочихцентров.Indigo Тогда 
		текстр.РасчетноеКоличествоКликов = НормативыДляРЦ.ВсегоКликов;
	КонецЕсли;
	
	текстр.времяизготовления = ВремяВыполненияЗаказаВЧасах;
	
КонецПроцедуры

