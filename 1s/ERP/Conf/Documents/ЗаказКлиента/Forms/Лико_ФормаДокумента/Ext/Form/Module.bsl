&НаКлиенте
Процедура ПриОткрытии(Отказ)
	//Элементы.ГруппаСекции.Видимость = ПроверитьДоступностьНаСервере("ПолныеПрава");
	
	// --> Начало Лико Ефимов ЕВВ 31.07.2023
	ЗначениеПереключателяГруппыПроизводствоПриИзменении();
	// <-- Конец Лико Ефимов ЕВВ 31.07.2023 
	
	// <-- Начало Лико Яцун С. В. 24.03.2025 
