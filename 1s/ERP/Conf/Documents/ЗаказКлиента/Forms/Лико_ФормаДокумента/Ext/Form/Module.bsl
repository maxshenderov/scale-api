&НаСервере
Процедура СкопироватьДанныеИзЗаказаНаСервере (Заказ, ТЧ)
	Если ТЧ = "ПараметрыШтампа" Тогда
		Объект.Нарезка = Заказ.Нарезка;
		Объект.ДлинаЭтикетки = Заказ.ДлинаЭтикетки;
		Объект.Ручьи = Заказ.Ручьи;
		Объект.ШагПечати = Заказ.ШагПечати;
		Объект.ЭтикетокНаЛистеИндиго = Заказ.ЭтикетокНаЛистеИндиго;
		Объект.ШтампВырубной = Заказ.ШтампВырубной;
		Объект.ЭтикетокНаЛисте = Заказ.ЭтикетокНаЛисте;
		Объект.ШиринаЭтикетки = Заказ.ШиринаЭтикетки;
		Объект.Z = Заказ.Z;
		Объект.ДлинаПечати = Заказ.ДлинаПечати;
		Объект.КоличествоКликов = Заказ.КоличествоКликов;
		// --> Начало Лико Митюшин МФМ 07.04.2021
		//Автоматическая замена ручьёв Печати при изменение параметров Штампа
		Объект.РучьиПечати = Заказ.РучьиПечати;
		// <-- Конец Лико Митюшин МФМ  07.04.2021
	Иначе
		ТЗОбъектаКопирования = Заказ[ТЧ].Выгрузить();
		Объект[ТЧ].Очистить();
		Объект[ТЧ].Загрузить(ТЗОбъектаКопирования);
	КонецЕсли;
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры
