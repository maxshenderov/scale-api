Процедура ЗаполнениеПараметровОснастки()
	текстр = Элементы.Цвета.ТекущиеДанные;   
	Если ЗначениеЗаполнено(текстр.Оснастка) Тогда 
		//Если ЗначениеЗаполнено(Текстр.ВидРабот) Тогда 
		//	РезультатПроверки = ПоверитьСоответствиеОснасткиВидыРабот(текстр.Оснастка, Текстр.ВидРабот);
		//	Если Не РезультатПроверки Тогда 
		//		текстр.Оснастка =  ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
		//Иначе		
		ЭтоТиснение = ЗначениеРеквизита(текстр.ВидСекции, "Тиснение");
		Если текстр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Вырубка") Тогда 
			Режим = РежимДиалогаВопрос.ДаНет;
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗаполненииПараметровШтампа", ЭтаФорма, текстр.Оснастка);
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Заполнить параметры основного вырубного штампа?'"), Режим,0);
		ИначеЕсли ЭтоТиснение ИЛИ текстр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Конгрев") Тогда	
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Оснастка", текстр.Оснастка);
			ДопПараметры.Вставить("Идентификатор", текстр.ПолучитьИдентификатор() );
			ЗаполнитьПараметрыШтампаТиснения(ДопПараметры);	
					
		КонецЕсли;

	Иначе
		ПроверитьВырубнойШтамп();
		РасчитатьТиражМетраж();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЦветаВРаботы()   
	Объект.ВидыРабот.Очистить();
	Для каждого стр Из объект.Цвета Цикл 
		ВидРабот =   ЗначениеРеквизита(стр.ВидСекции, "ВидРабот");
		Если стр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ГорячееТиснениеПлоское")  Тогда 
			Если стр.направлениепротяжки = ПредопределенноеЗначение("Перечисление.Лико_НаправленияПротяжки.Поперечное") Тогда 
				ВидРабот = ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПоперечное");
			Иначе
				ВидРабот = ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.ГорячееТиснениеПлоскоеПродольное");
			КонецЕсли;
		КонецЕсли;
			
		Отбор = Новый Структура("ВидРабот", ВидРабот); 
		Отбор.Вставить("НомерПроката", стр.НомерПроката);  
		Отбор.Вставить( "НомерРаботы", стр.НомерРаботы);

		строкиРабот = Объект.ВидыРабот.НайтиСтроки(Отбор);
		Если строкиРабот.Количество() = 0 Тогда    
			стрработа = Объект.ВидыРабот.Добавить();
			ЗаполнитьЗначенияСвойств(стрработа, стр); 
			Если Не ВидРабот = ПредопределенноеЗначение("Справочник.ВидыРаботСотрудников.Печать") Тогда 
				стрработа.Клей = стр.типкраски;  
			КонецЕсли;
			стрработа.видработ = видработ;
			Если стр.видсекции =  ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Нумератор")  Тогда 
				стрработа.дополнительно = стр.количестворучьевнумератора;
			Иначе
				стрработа.дополнительно = стр.подача;    
			Конецесли;
			стрработа.подача = стр.подачафакт;	
			Если стр.видсекции =  ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Инкджет") Тогда 
				стрработа.расходкраски = объект.расходкраски;       
			КонецЕсли;  
			Если стр.видсекции =  ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Цифровая") Тогда 
				стрработа.клей = ЗначениеРеквизита(объект.Праймер, "ЦеноваяГруппа");      
			КонецЕсли;  
		Иначе
			стрработа = строкиРабот[0];
			Если стр.видсекции =  ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Инкджет") Тогда 
				стрработа.расходкраски = объект.расходкраски;       
			КонецЕсли; 
			Если стр.видсекции =  ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Цифровая") Тогда 
				стрработа.клей = ЗначениеРеквизита(объект.Праймер, "ЦеноваяГруппа");      
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла;
	
	ПроставитьВидВырубки(Истина); 
	
	ИзмененитьДоступностиПолейНаСервере(Объект.ВидВырубки);

КонецПроцедуры

