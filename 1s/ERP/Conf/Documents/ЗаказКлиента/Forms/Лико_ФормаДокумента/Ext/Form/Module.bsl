&НаКлиенте
Процедура ОткрытьФормуРедактированияПараметровЦвета(Элемент)

	ВыполняемаяОбработка = НайтиВПФ("Обработка ""лк СхемаМашины""");	
	Если ВыполняемаяОбработка.Пустая() Тогда
		Возврат
	КонецЕсли;
	ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВыполняемаяОбработка);

	ТекСтр = Элемент.ТекущиеДанные; 
	
	РеквизитыЦвета = ПолучитьМассивРеквизитовТЧ();
	
	СтруктураПраметрыСекции = Новый Структура;

	Для каждого рек из РеквизитыЦвета Цикл  
		СтруктураПраметрыСекции.Вставить(рек, ТекСтр[рек]); 	
	КонецЦикла;
	
	СтруктураПраметрыСекции.Вставить("ТипЦвета",	 	ТекСтр.ТипЦвета1); 
	СтруктураПраметрыСекции.Вставить("НазваниеПантона", ТекСтр.Название);

	СтруктураПраметрыСекции.Вставить("ТипПродукта", 	ЗначениеРеквизита(текстр.Номенклатура,"ЦеноваяГруппа"));   


 
	СтруктураРедактирования = Новый Структура;
	СтруктураРедактирования.Вставить("РежимВыбора", Истина);
	СтруктураРедактирования.Вставить("Секция", ТекСтр.ВидСекции); 
	СтруктураРедактирования.Вставить("ИмяСекции", ТекСтр.НомерСекции);
	СтруктураРедактирования.Вставить("ПараметрыСекцииЦвета", СтруктураПраметрыСекции);  
	СтруктураРедактирования.Вставить("РабочийЦентр", ТекСтр.РабочийЦентр); 
	СтруктураРедактирования.Вставить("Ссылка", Объект.Ссылка); 
	СтруктураРедактирования.Вставить("Площадка", Объект.Площадка); 
	СтруктураРедактирования.Вставить("Комбинированный", Объект.Комбинированный); 



	допПараметры = Новый Структура;
	допПараметры.Вставить("КлючСтроки",  ТекСтр.КлючСтроки);
	допПараметры.Вставить("НомерПроката", ТекСтр.НомерПроката);

	ОбработкаЗакрытия = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированиеПараметровЦвета", ЭтаФорма, допПараметры);

	ФормаРедактированияСтрока =  ЗначениеРеквизита(ТекСтр.ВидСекции, "ИмяФормыРедактированияПараметров");

	ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.РедактированиеПараметровСекции" + ФормаРедактированияСтрока, СтруктураРедактирования, ЭтаФорма, , , , ОбработкаЗакрытия);

КонецПроцедуры  


&НаКлиенте
Процедура ПриЗакрытииФормыРедактированиеПараметровЦвета(Результат, ДопПараметры) Экспорт 
	
	Если Не ЗначениеЗаполнено(Результат) Тогда 
		Возврат
	КонецЕсли;
	
	СтруктураПараметров = Результат;
	
	ТекСтр = Объект.Цвета.НайтиСтроки(новый Структура("КлючСтроки", ДопПараметры.КлючСтроки));
	
	Если ТекСтр.Количество() > 0 Тогда   		
		
		ЗаполнитьЗначенияСвойств(ТекСтр[0], СтруктураПараметров);  
		
		Если НЕ (ЗначениеРеквизита(ТекСтр[0].ВидСекции,"ОтображатьВТЧЦвета") И НЕ ЗначениеРеквизита(ТекСтр[0].ВидСекции,"ОтображатьВТЧРаботы")) Тогда
			ЗаписатьЦветаВРаботы();
			Если ТекСтр[0].ВидСекции =  ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Вырубка")   Тогда 
		 		ЗаполнениеПараметровОснастки();			
			КонецЕсли;
		КонецЕсли;
				
	КонецЕсли;
	
	ДобавитьУсловноеОформлениеЦветаВалФорма();
	
КонецПроцедуры


