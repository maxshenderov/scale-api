	Для каждого стр из Объект.Товары Цикл
		Если ЗначениеЗаполнено(стр.цена) И ЗначениеЗаполнено(стр.ставкаНДС) Тогда 
			ТекПроцентНДС = стр.СтавкаНДС.Ставка;
			стр.ЦенаБезНДС = стр.цена/(1+ТекПроцентНДС/100);
		КонецЕсли;	
	
		Если ЗначениеЗаполнено(ОтображатьОбъемДляКлиента) Тогда
			Если ОтображатьОбъемДляКлиента Тогда
				Элементы.ТоварыОбъем.Видимость = Истина;
				стр.Объем = УправлениеСвойствами.ЗначениеСвойства(стр.Номенклатура,"Стикер_Объем");
			Иначе
				Элементы.ТоварыОбъем.Видимость = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		//СтруктураДействий = Новый Структура;
		//СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул",Новый Структура("Номенклатура", "Артикул"));
		//ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(стр, СтруктураДействий, КэшированныеЗначения);
		
		//Заполним Артикул по справочнику ВерсииНоменклатуры 
		Если ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			стр.Артикул = ПолучитьАртикулИзСправочникаВерсииНоменклатуры(стр.Номенклатура,стр.ВерсияНоменклатуры);
			стр.Версия = стр.ВерсияНоменклатуры.Версия;
			СкрытьЛишниеКнопкиДляНоменклатурыDFM(стр.Номенклатура);

			Стр.НаименованиеДляДокументов = Стр.Номенклатура.НаименованиеПолное;
		КонецЕсли;
		// --> Начало Лико Ефимов ЕВВ 13.05.2021
		//Если ЗначениеЗаполнено(Стр.ЧестныйЗнак) Тогда
		//	ЗаполнитьЗначенияСвойств(Стр, Стр.ЧестныйЗнак, "Gtin,ДатаЭмиссии");
		//КонецЕсли;
		// <-- Конец Лико Ефимов ЕВВ 13.05.2021 
		
		// <-- Начало Лико Яцун С. В. 21.04.2025 
		стр.КартинкаНамотки = ПолучитьКартинкуНамотки(стр.Направление.Код);
		// <-- Конец Лико Яцун С. В. 21.04.2025
		// <-- Начало Лико Яцун С. В. 10.12.2025 
		Если НЕ ЗадатьВопросОбИзмененииСтавкиНДС И ТекущаяДата() >= Дата('20260101') Тогда
			Если Параметры.Свойство("ЗаказКопирования") Тогда
				Для каждого СтрНДС из Параметры.ЗаказКопирования.Товары Цикл 
					Если СтрНДС.СтавкаНДС.Ставка = 20 Тогда
						ЗадатьВопросОбИзмененииСтавкиНДС = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			ИначеЕсли ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
				Для каждого СтрНДС из Параметры.ЗначениеКопирования.Товары Цикл 
					Если СтрНДС.СтавкаНДС.Ставка = 20 Тогда
						ЗадатьВопросОбИзмененииСтавкиНДС = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 10.12.2025
	КонецЦикла;	 
	
	Для каждого стр из Объект.РасчетТиражей Цикл 
