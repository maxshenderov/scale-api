	Если ТипЗнч(Результат) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;	
	ТекущиеДанные = Элементы.Цвета.ТекущиеДанные;
	УдалитьСписокЗначений("Формы", ТекущиеДанные.КлючСтроки);
	Если Результат.Количество() > 0 Тогда
		ТекущиеДанные.Форма = результат[0];
		//ТекущиеДанные.ВалФорма = результат[0];
		Для каждого элемент из результат Цикл
			стр = Объект.Формы.Добавить();
			стр.Значение =  Элемент;
			стр.КлючСтроки = ТекущиеДанные.КлючСтроки;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

