&НаСервереБезКонтекста 
Функция ЭтоЦМИК(ТипЦвета) 
	
	ЭтоЦМИК = ТипЦвета = Справочники.Лико_ТипыЦвета.C 
		ИЛИ ТипЦвета = Справочники.Лико_ТипыЦвета.M 
		ИЛИ ТипЦвета = Справочники.Лико_ТипыЦвета.Y 
		ИЛИ ТипЦвета = Справочники.Лико_ТипыЦвета.K;
	
	Возврат ЭтоЦМИК 	
	
КонецФункции 

&НаСервереБезКонтекста 
Функция ПолучитьЦГПоКоду(КодЦГ) 
	
	ЦГСсылка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеновыеГруппы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЦеновыеГруппы КАК ЦеновыеГруппы
		|ГДЕ
		|	ЦеновыеГруппы.Код = &КодЦГ
		|	И НЕ ЦеновыеГруппы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("КодЦГ", КодЦГ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЦГСсылка = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат ЦГСсылка 	
	
КонецФункции 
 
Функция ПолучитьГрамматуруВала(Номенклатура)
	
	Грамматура = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПараметрыШтампа.ГрамматураВала КАК ГрамматураВала,
	|	Лико_ПараметрыШтампа.ПроцентЗаливки КАК ПроцентЗаливки
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|ГДЕ
	|	Лико_ПараметрыШтампа.Номенклатура = &Номенклатура"; 
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Если ЗначениеЗаполнено(Результат.ГрамматураВала) Тогда
			Если Объект.Площадка = Справочники.Лико_Площадки.ИксПак Тогда 
				Грамматура =  Результат.ГрамматураВала ;
			Иначе
				Грамматура = Результат.ГрамматураВала * 0.5;
			КонецЕсли;
			ПроцентЗаливки = Результат.ПроцентЗаливки;
		КонецЕсли;
	КонецЕсли;
	ПараметрыВала = Новый Структура("Грамматура,ПроцентЗаливки", Грамматура, ПроцентЗаливки);  
	
	Возврат ПараметрыВала
	
