		КонецЕсли;
	КонецЕсли;
	
	Если (Объект.Ручьи > 0 И Объект.РучьиПечати > 0 И Объект.Ручьи <> Объект.РучьиПечати) ИЛИ (Объект.Ручьи > 0 И Объект.РучьиПечатиИндиго > 0 И Объект.Ручьи <> Объект.РучьиПечатиИндиго) Тогда
		ПоказатьВопрос(
		Новый ОписаниеОповещения("ПослеОтветаНаВопросКоличествоРучьевПечатиМеньшеЧемВШтампе", ЭтотОбъект), 
		"Количество ручьев печати меньше, чем в штампе. Утвердить цвета?",
		РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	Объект.УтвердилЦвета = ПользователиКлиентСервер.ТекущийПользователь(); 
	Объект.ДатаУтвержденияЦветов = ТекущаяДата();
	ИзменитьПриСменеВидаВырубки();
	УтверждениеЦветов();
	
	Объект.ДатаУтвержденияЗаказа = '0001.01.01'; 
	Объект.УтвердилЗаказ = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
	
КонецПроцедуры // <-- Конец Лико Яцун 30.01.2023

