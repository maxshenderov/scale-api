&НаКлиенте
Процедура ЦветаФормаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.Цвета.ТекущиеДанные;
	Если ЗначениеЗаполнено(Текст) Тогда 
		СпрФорма = ПолучитьФормуНаСервере(Текст);
		Если ЗначениеЗаполнено(СпрФорма) Тогда 
			УдалитьСписокЗначений("Формы", ТекущиеДанные.КлючСтроки);
			стр = Объект.Формы.Добавить();
			стр.Значение = СпрФорма;
			стр.КлючСтроки = ТекущиеДанные.КлючСтроки;
			текущиеДанные.Форма = СпрФорма;
			ТекущиеДанные.ФормаНомерЛинкс = Текст;
			ДобавитьУсловноеОформлениеЦветаВалФорма();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ПослеОтветаНаВопросОСозданииНовойФормыЛинкс(Результат, ДопПараметры)  Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда 
		текстр = Объект.Цвета.НайтиПоИдентификатору(ДопПараметры.Идентификатор);
		ВидПечати = ЗначениеРеквизита(ТекСтр.ВидСекции,"ВидПечати");  
		Если ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Флексо") 
			ИЛИ ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Трафарет")
			ИЛИ ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Офсет") 
			ИЛИ ЗначениеРеквизита(ТекСтр.ВидСекции,"Родитель") = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Глубокая") Тогда 
			НоваяФорма = СоздатьНовуюФорму(ТекСтр.ВидСекции, ТекСтр.типцвета1, ТекСтр.типкраски, ТекСтр.название,ДопПараметры.КодЛинкс);
			ТекСтр.форма = НоваяФорма;
			//Необходимо записать значение в табличную часть "Формы"
			УдалитьСтрокиПоКлючу(текстр.КлючСтроки,"Формы","КлючСтроки");  
			стрФ = Объект.Формы.Добавить();
			стрФ.Ключстроки = ТекСтр.ключстроки;
			стрФ.Значение = НоваяФорма;  
			//стрФ.Цветоделение = Истина;
		ИначеЕсли ВидПечати = ПредопределенноеЗначение("Справочник.Лико_ВидыПечати.Цифровая") Тогда
			НоваяФорма = СоздатьНовуюФорму(ТекСтр.ВидСекции, ТекСтр.типцвета1, ТекСтр.типкраски, ТекСтр.название,ДопПараметры.КодЛинкс);
			Для каждого стр из Объект.Цвета Цикл
				Если стр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Цифровая") Тогда
					Если стр.форма <> НоваяФорма Тогда 
						стр.форма = НоваяФорма;
						УдалитьСтрокиПоКлючу(текстр.КлючСтроки,"Формы","КлючСтроки"); 
						стриндиго = Объект.Формы.добавить();
						стриндиго.КлючСтроки = стр.ключстроки;	
						стриндиго.Значение = НоваяФорма;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;        
	КонецЕсли;
	ДобавитьУсловноеОформлениеЦветаВалФорма();
	
КонецПроцедуры	


&НаКлиенте
Процедура ПараметрыШтампаПриИзменении()
	
	Если ЗначениеЗаполнено(Объект.Z) И 
		НЕ (ЗначениеЗаполнено(Объект.ШтампВырубной) И ЗначениеЗаполнено(Объект.ШагПечати)) Тогда
		текКоличествоЗубьев = ПолучитьКоличествоЗубьев(Объект.Z) * 3.175 / 1000;
		Если Объект.ШагПечати <> текКоличествоЗубьев Тогда
			текПараметрыОтбора = Новый Структура;
			текПараметрыОтбора.Вставить("ВидСекции", ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Вырубка"));	
			текНайденныеСтроки = Объект.Цвета.НайтиСтроки(текПараметрыОтбора);
			Если текНайденныеСтроки.Количество() = 0 Тогда
				Объект.ШагПечати =  текКоличествоЗубьев;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	РасчитатьТиражМетраж();
	ЗаполнитьПлощадьКлишеНаСервере(Объект.ВидВырубки);
	ПоказатьДоходностьРентабельность();
	Для каждого стр из Объект.Отгрузки Цикл
		стр.КвадратныйМетраж = стр.ПогонныйМетраж* ПолучитьНарезкуНасервере(Объект.Нарезка);
	КонецЦикла;
	Если Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда	
		ЗаполнитьПлощадьКлишеНаСервере(Объект.ВидВырубки);
		Заказ = Объект;
		ЗаполнитьПараметрыПечати(Заказ, Объект.ВидВырубки);	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ШтампВырубной) И Объект.ВидВырубки = 0 И ОмегаСНумератором() Тогда
		ЗаполнитьПараметрыПечатиИВырубкиОмегаСНумератором();
	КонецЕсли;
	
КонецПроцедуры


