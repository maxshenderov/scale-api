	Если ВозвращенноеЗначение = Неопределено Тогда 
		Возврат;	
	КонецЕсли;   
	
	РЦ = ВозвращенноеЗначение.РабочийЦентр;
	НомерПроката = ВозвращенноеЗначение.НомерПроката; 

	НайденныеСтроки = Объект.Секции.НайтиСтроки(новый структура("РабочийЦентр, НомерПроката", РЦ, НомерПроката));

	Для каждого ТекСтр из НайденныеСтроки Цикл
		Объект.Секции.Удалить(ТекСтр); 
	КонецЦикла;    
		
	ДесериализованныйМассив = ДесериализоватьМассив(ВозвращенноеЗначение.МассивПараметровСекций); 
	сч = 0;
	Для каждого стр из ВозвращенноеЗначение.МассивПараметровСекций Цикл 
		новаяСтрока = Объект.Секции.Добавить();	 
		ЗаполнитьЗначенияСвойств(новаяСтрока, ДесериализованныйМассив[сч]); 
		новаяСтрока.ПараметрыСекции = стр;
		новаяСтрока.РабочийЦентр = РЦ;   
		новаяСтрока.НомерПроката = НомерПроката; 
        сч = сч + 1;
	КонецЦикла;  
	
	
	  //Десериализовать(ВозвращенноеЗначение);
	
КонецПроцедуры  

&НаСервереБезКонтекста
Функция ДесериализоватьМассив(СериализованныйМассив)
	
		

	ДесериализованныйМассив = новый Массив;
	Для каждого стр из СериализованныйМассив цикл 
		СтруктураМассива = ЗначениеИзСтрокиВнутр(стр);   
		Если  СтруктураМассива.Свойство("ТаблицаЦветовИнкджет") Тогда
			СтруктураМассива.Удалить("ТаблицаЦветовИнкджет");    
		КонецЕсли;  
		Если  СтруктураМассива.Свойство("ТаблицаЦветов") Тогда
			СтруктураМассива.Удалить("ТаблицаЦветов");    
		КонецЕсли;
		ДесериализованныйМассив.Добавить(СтруктураМассива);
	КонецЦикла;
	
	Возврат ДесериализованныйМассив;
	
КонецФункции

