Функция ПолучитьХарактеристикуНаСервере(номенклатура)
	СоздаватьХарактеристику = Ложь;
	ЗапросХарактеристики = Новый Запрос;
	ЗапросХарактеристики.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ХарактеристикиНоменклатуры.Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Владелец = &Номенклатура
	|	И ХарактеристикиНоменклатуры.Лико_ЗаказНоменклатуры = &Заказ";
	ЗапросХарактеристики.УстановитьПараметр("Номенклатура", Номенклатура);
	ЗапросХарактеристики.УстановитьПараметр("Заказ", Объект.Ссылка);
	РезультатЗапросаХ = ЗапросХарактеристики.Выполнить();
	Если РезультатЗапросаХ.Пустой() Тогда 
		СоздаватьХарактеристику = Истина;
	Иначе
		РезультатХ = РезультатЗапросаХ.Выбрать();
		РезультатХ.Следующий();
		Если ЗначениеЗаполнено(РезультатХ.Ссылка) Тогда 
			Возврат РезультатХ.Ссылка;
		Иначе 
			СоздаватьХарактеристику = Истина;
		КонецЕсли;
	КонецЕсли;	
	Если СоздаватьХарактеристику Тогда 
		СпрХар = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
		СпрХар.Владелец = Номенклатура;
		СпрХар.Лико_ЗаказНоменклатуры = Объект.ссылка;
		//Василий сказал, что наименование заполнять не надо (заполнится по шаблону)
		//СпрХар.Наименование = "Заказ" + Прав(Объект.Номер,7);
		СпрХар.Записать();
		Возврат СпрХар.Ссылка;
	КонецЕсли;
			
	
КонецФункции

	
