&НаКлиенте
Процедура ПослеВводаНомераЗаказа(РезультатФормы, ПараметрыФормы) Экспорт
	Если РезультатФормы <> Неопределено Тогда
		Заказ = ПолучитьЗаказПоНомеру(РезультатФормы);
		Если Заказ <> Неопределено Тогда		
			ДопПараметры  = Новый Структура("Заказ", Заказ);
			СписокЗаполнения = Новый СписокЗначений;
			СписокЗаполнения.Добавить("Этикетки");
			СписокЗаполнения.Добавить("Цвета");
			//СписокЗаполнения.Добавить("Виды работ");
			//СписокЗаполнения.Добавить("Параметры штампа"); 
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораТЧДляЗаполненияЗаказа", ЭтаФорма, ДопПараметры);
			СписокЗаполнения.ПоказатьОтметкуЭлементов(Оповещение,"Выберите ТЧ для копирования.");
		Иначе
			Сообщить("Заказа с данным номером нет в базе данных!");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораТЧДляЗаполненияЗаказа(Список, ПараметрыФормы) Экспорт
	Для Каждого Элемент Из Список Цикл
		Если Элемент.Пометка Тогда
			Если Элемент.Значение = "Этикетки" Тогда
				СкопироватьДанныеИзЗаказаНаСервере(ПараметрыФормы.Заказ,"Товары");
			ИначеЕсли Элемент.Значение = "Цвета" Тогда
				СкопироватьДанныеИзЗаказаНаСервере(ПараметрыФормы.Заказ,Элемент.Значение);
				СкопироватьДанныеИзЗаказаНаСервере(ПараметрыФормы.Заказ,"Формы");
				ЗаписатьЦветаВРаботы();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

