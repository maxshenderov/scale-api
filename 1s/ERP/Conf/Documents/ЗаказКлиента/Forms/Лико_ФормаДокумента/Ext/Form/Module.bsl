&НаКлиенте
Процедура ЗаказчикЭмиссииЧЗПриИзменении(Элемент)
	
	Если Объект.ЗаказчикЭмиссииЧЗ <> ПредопределенноеЗначение("Перечисление.Лико_ЗаказчикиЭмиссииЧЗ.Окил") Тогда
		Объект.ЭмитентЧЗ = Неопределено;
		Объект.СтранаТовараЧЗ = Неопределено;
		Объект.ТипКодаЧЗ = Неопределено;
		Объект.ТипМаркировкиЧЗ = Неопределено;
		Элементы.ЭмитентЧЗ.Видимость = Ложь;	
		Элементы.СтранаТовараЧЗ.Видимость = Ложь;	
		Элементы.ТипКодаЧЗ.Видимость = Ложь;	
		Элементы.ТипМаркировкиЧЗ.Видимость = Ложь;	
	ИначеЕсли Объект.ЗаказчикЭмиссииЧЗ = ПредопределенноеЗначение("Перечисление.Лико_ЗаказчикиЭмиссииЧЗ.Окил") Тогда
		Элементы.ЭмитентЧЗ.Видимость = Истина;	
		Элементы.СтранаТовараЧЗ.Видимость = Истина;	
		Элементы.ТипКодаЧЗ.Видимость = Истина;	
		Элементы.ТипМаркировкиЧЗ.Видимость = Истина;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НарезкаРасчетНажатие(Элемент)

	Если ЗначениеЗаполнено(Объект.РабочийЦентр) И НЕ ЗначениеЗаполнено(ВидРЦ) Тогда
		ВидРЦ = ЗначениеРеквизита(Объект.РабочийЦентр,"ВидРабочегоЦентра"); 
	КонецЕсли;
	РасчетнаяНарезкаДанные = ПолучитьРасчетнуюНарезку();
	Объект.НарезкаРасчетная = РасчетнаяНарезкаДанные.РасчетнаяНарезкаСсылка;
	Объект.Нарезка = Объект.НарезкаРасчетная;
	РасчитатьТиражМетраж();
	ПоказатьДоходностьРентабельность();
	Для каждого стр из Объект.Отгрузки Цикл
		стр.КвадратныйМетраж = стр.ПогонныйМетраж* ПолучитьНарезкуНасервере(Объект.Нарезка);
	КонецЦикла;

КонецПроцедуры




