&НаКлиенте
Процедура ПриЗакрытииФормыРедактированиеПараметровСекции(Значение, ДопПараметры) Экспорт 
	
	Если Не ЗначениеЗаполнено(Значение) Тогда 
		Возврат;
	КонецЕсли;
	
	//Модифицированность = Истина;
	
   // Элементы.ТаблицаСекции.ТекущиеДанные.Параметры = Значение;
	СтруктураПараметров = ПреобразоватьДанныеРедактирования(Значение, ДопПараметры.НомерПроката );
	
	ТекущаяСтрока = Объект.Секции.НайтиСтроки(новый Структура("КлючСтроки", ДопПараметры.КлючСтроки));
	Если ТекущаяСтрока.Количество() > 0 Тогда   		
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока[0], СтруктураПараметров);
		ТекущаяСтрока[0].ПараметрыСекции = Значение;
	КонецЕсли;    
	
КонецПроцедуры

&НаСервере
Функция  ПреобразоватьДанныеРедактирования(Значение, НомерПроката)
	//достать из структуры таблицы и удалить [удаление таблиц]
	СтруктураПараметров =  ЗначениеИзСтрокиВнутр(Значение); 
	Если СтруктураПараметров.Свойство("ТаблицаЦветов") Тогда  
		Для каждого стр из СтруктураПараметров.ТаблицаЦветов Цикл
			ТекСтр = Объект.Секции.НайтиСтроки(новый Структура("КлючСтроки", стр.КлючСтроки));	
			Если ТекСтр.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(ТекСтр[0], стр);  
				СтруктураДоЗаменыТаблицы = ЗначениеИзСтрокиВнутр(ТекСтр[0].ПараметрыСекции);
				СтруктураДоЗаменыТаблицы.Вставить("ТаблицаЦветов",СтруктураПараметров.ТаблицаЦветов );
				ТекСтр[0].ПараметрыСекции = ЗначениеВСтрокуВнутр(СтруктураДоЗаменыТаблицы);
				
			Иначе
				новСтр = Объект.Секции.Добавить();
				ЗаполнитьЗначенияСвойств(новСтр, стр);  
				новСтр.ВидСекции = Справочники.Лико_ВидыСекций.Цифровая;
                новСтр.ПараметрыСекции = Значение;
				новСтр.НомерПроката = НомерПроката; 
				новСтр.РабочийЦентр = СтруктураПараметров.РабочийЦентр;
			КонецЕсли;
		КонецЦикла;		
		СтруктураПараметров.Удалить("ТаблицаЦветов"); 

	КонецЕсли;      
	
	Если СтруктураПараметров.Свойство("ТаблицаЦветовИнкджет") Тогда  
		Для каждого стр из СтруктураПараметров.ТаблицаЦветовИнкджет Цикл
			ТекСтр = Объект.Секции.НайтиСтроки(новый Структура("КлючСтроки", стр.КлючСтроки));	
			Если ТекСтр.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(ТекСтр[0], стр);  
				СтруктураДоЗаменыТаблицы = ЗначениеИзСтрокиВнутр(ТекСтр[0].ПараметрыСекции);
				СтруктураДоЗаменыТаблицы.Вставить("ТаблицаЦветовИнкджет",СтруктураПараметров.ТаблицаЦветовИнкджет );
				ТекСтр[0].ПараметрыСекции = ЗначениеВСтрокуВнутр(СтруктураДоЗаменыТаблицы);
			Иначе
				новСтр = Объект.Секции.Добавить();
				ЗаполнитьЗначенияСвойств(новСтр, стр);  
				новСтр.ВидСекции = Справочники.Лико_ВидыСекций.Инкджет;
                новСтр.ПараметрыСекции = Значение;
				новСтр.НомерПроката = НомерПроката; 
				новСтр.РабочийЦентр = СтруктураПараметров.РабочийЦентр;
			КонецЕсли;
		КонецЦикла;

		СтруктураПараметров.Удалить("ТаблицаЦветовИнкджет"); 
				
	КонецЕсли;  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ВидыСекций.Ссылка КАК Ссылка,
		|	Лико_ВидыСекций.ИмяПредопределенныхДанных КАК ИмяСекции
		|ИЗ
		|	Справочник.Лико_ВидыСекций КАК Лико_ВидыСекций
		|ГДЕ
		|	Лико_ВидыСекций.Многострочный = ИСТИНА";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если СтруктураПараметров.Свойство("ТаблицаРабот_" + Выборка.ИмяСекции) Тогда  
			Для каждого стр из СтруктураПараметров["ТаблицаРабот_" + Выборка.ИмяСекции] Цикл
				ТекСтр = Объект.Секции.НайтиСтроки(новый Структура("КлючСтроки", стр.КлючСтроки));	
				Если ТекСтр.Количество() > 0 Тогда
					ЗаполнитьЗначенияСвойств(ТекСтр[0], стр);  
					СтруктураДоЗаменыТаблицы = ЗначениеИзСтрокиВнутр(ТекСтр[0].ПараметрыСекции);
					СтруктураДоЗаменыТаблицы.Вставить("ТаблицаРабот_"+ Выборка.ИмяСекции,СтруктураПараметров["ТаблицаРабот_" + Выборка.ИмяСекции] );
					ТекСтр[0].ПараметрыСекции = ЗначениеВСтрокуВнутр(СтруктураДоЗаменыТаблицы);
				Иначе
					новСтр = Объект.Секции.Добавить();
					ЗаполнитьЗначенияСвойств(новСтр, стр);  
					новСтр.ВидСекции = Выборка.Ссылка;
					новСтр.ПараметрыСекции = Значение;
					новСтр.НомерПроката = НомерПроката; 
					новСтр.РабочийЦентр = СтруктураПараметров.РабочийЦентр;
				КонецЕсли;
			КонецЦикла;
			
			СтруктураПараметров.Удалить("ТаблицаРабот_" + Выборка.ИмяСекции); 
			
		КонецЕсли;  
			
	КонецЦикла;
	

	
	
	Если СтруктураПараметров.Свойство("КлючиУдаленныхСтрок")  Тогда
		Для каждого эл из СтруктураПараметров.КлючиУдаленныхСтрок Цикл
			УдаляемыеСтроки = Объект.Секции.НайтиСтроки(новый Структура("КлючСтроки",  эл.Значение));
			Для каждого стр из УдаляемыеСтроки Цикл 
				Объект.Секции.Удалить(стр);
			КонецЦикла;
		КонецЦикла;	     
		СтруктураПараметров.Удалить("КлючиУдаленныхСтрок");
	КонецЕсли;


		
	Возврат СтруктураПараметров;
КонецФункции

