&НаКлиенте
Процедура ZПриИзменении(Элемент)
	// --> Начало Лико Митюшин МФМ 19.05.2021
	Если Не ЗначениеЗаполнено(Объект.ВидВырубки) Тогда
		Объект.ВидВырубки = ПолучитьВидВырубкиНаСервере();	
	КонецЕсли;
	// <-- Конец Лико Митюшин МФМ 19.05.2021

	Если Объект.ВидВырубки = 1 ИЛИ  Объект.ВидВырубки = 7 ИЛИ Объект.ВидВырубки = 13 Тогда
		ЗаполнитьДлинаПечатиНаКлиенте();
	ИначеЕсли Объект.ВидВырубки = 3 ИЛИ Объект.ВидВырубки = 9 Тогда 
		ЗаполнитьДлинаПечатиНаКлиенте();
	    ЗаполнитьЭтМЭР();
		ЗаполнитьЭтикетокНаЛистеПечатиФлексо();
		Объект.ЭтикетокНаЛистеПечати = ПолучитьЭтикетокНаЛистеПечатиНаСервере();
	КонецЕсли;
	ПараметрыШтампаПриИзменении();
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьЭтикетокНаЛистеПечатиФлексо()
	текКоличествоЭтПоДлинеПечати = ПолучитьЭтикетокНаЛистеПечатиФлексоНаСервере();
	Если Объект.КоличествоЭтПоДлинеПечати <> текКоличествоЭтПоДлинеПечати Тогда 
		Объект.КоличествоЭтПоДлинеПечати = текКоличествоЭтПоДлинеПечати;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЭтМЭР()
	
	текЭтМЭР = ПолучитьЭтМЭРНаСервере();
	Если Объект.ЭтМЭР <> текЭтМЭР Тогда
		Объект.ЭтМЭР = текЭтМЭР;		
	КонецЕсли;

	текВидВырубки = Объект.ВидВырубки;
	
	Если текВидВырубки = 2 ИЛИ текВидВырубки = 6 ИЛИ текВидВырубки = 9 ИЛИ текВидВырубки = 12 Тогда
		текКоличествоЭтПоДлинеПечатиИндиго = ПолучитьЭтикетокПоДлинеПечатиИндигоНаСервере(текВидВырубки);
		Если текКоличествоЭтПоДлинеПечатиИндиго <> Объект.КоличествоЭтПоДлинеПечатиИндиго Тогда 
			Объект.КоличествоЭтПоДлинеПечатиИндиго = текКоличествоЭтПоДлинеПечатиИндиго;	
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДлинаПечатиНаКлиенте()
	текДлинаПечати = ПолучитьДлинуПечатиНаСервере();
	Если текДлинаПечати <> Объект.ДлинаПечати Тогда
		Объект.ДлинаПечати = текДлинаПечати;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьZ()
	текZ = ПолучитьZНаСервере();
	Если Объект.Z <> текZ Тогда
		Объект.Z = текZ;
	КонецЕсли;
КонецПроцедуры
	
	
&НаКлиенте
Процедура ДлинаЭтикеткиПриИзменении(Элемент)
	Если Объект.ВидВырубки = 5 ИЛИ (Объект.ВидВырубки = 6 И Объект.ТипЗаказа = ПредопределенноеЗначение("Перечисление.Лико_ТипыЗаказов.Термоусадка")) Тогда
		ЗаполнитьЭтМЭР();
		ЭтикеткиИТиражМетражНаКлиенте();
		ЗаполнитьДлинаПечатиНаСервере();
	ИначеЕсли Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда	
		Заказ = Объект;
		ЗаполнитьПараметрыПечати(Заказ, Объект.ВидВырубки);	
	КонецЕсли;
	// <-- Начало Лико Яцун С. В. 27.09.2024 
	Если НеобходимоЗаполнятьРаппортТУ() Тогда
		ПредлагаемыеВариантыРаппортов = ПредложитьВариантыИлиЗаполнитьРаппортФлексо();
		//Если точный Раппорт не найден, выбирают из предложенных вариантов
		Если ПредлагаемыеВариантыРаппортов <> Неопределено Тогда
			ПараметыФормы = Новый Структура("Заголовок,ФормаОтбор,ВысотаЭтикетки,Заказ","Выберие размеры",ПредлагаемыеВариантыРаппортов,Объект.ДлинаЭтикетки,Объект);
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораПредложенногоРаппорта", ЭтаФорма);
			ОткрытьФорму("Справочник.Лико_Раппорты.Форма.ФормаПредложенияРазмераЭтикетки",ПараметыФормы,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			Возврат;
		Иначе
			ПараметрыШтампаПриИзменении();	
		КонецЕсли;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 27.09.2024
КонецПроцедуры

&НаСервере
Функция ПредложитьВариантыИлиЗаполнитьРаппортФлексо() 
	
	РазмерЭтикетки = Объект.ДлинаЭтикетки;
	
	ПодобранТочныйРаппорт = Ложь; 
	
	Для КоличествоЭтикеток = 1 По Цел(800/РазмерЭтикетки) Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Лико_РаппортыРабочиеЦентры.Ссылка КАК Ссылка,
		|	ОКР(Лико_РаппортыРабочиеЦентры.Ссылка.ДлинаПечати, 2) КАК ДлинаПечати,
		|	Лико_РаппортыРабочиеЦентры.Ссылка.Z КАК Z
		|ИЗ
		|	Справочник.Лико_Раппорты.РабочиеЦентры КАК Лико_РаппортыРабочиеЦентры
		|ГДЕ
		|	Лико_РаппортыРабочиеЦентры.РабочийЦентр = &РабочийЦентр
		|	И ОКР(ОКР(Лико_РаппортыРабочиеЦентры.Ссылка.ДлинаПечати, 2) / &КоличествоЭтикеток, 2) = &ВысотаЭтикетки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДлинаПечати";
		
		Запрос.УстановитьПараметр("РабочийЦентр", Объект.РабочийЦентр);
		Запрос.УстановитьПараметр("ВысотаЭтикетки", РазмерЭтикетки);
		Запрос.УстановитьПараметр("КоличествоЭтикеток", КоличествоЭтикеток);

		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Объект.Раппорт = ВыборкаДетальныеЗаписи.Ссылка;
			Объект.Z = ВыборкаДетальныеЗаписи.Z;
			Объект.ДлинаПечати = ВыборкаДетальныеЗаписи.ДлинаПечати/1000;
			Объект.ПлощадьКлише = Лико_ТиражМетраж.ПолучитьПлощадьКлише(Объект, Объект.ВидВырубки);
			текЭтМЭР = ПолучитьЭтМЭРНаСервере();
			Если Объект.ЭтМЭР <> текЭтМЭР Тогда
				Объект.ЭтМЭР = текЭтМЭР;		
			КонецЕсли;
			Объект.ЭтикетокНаЛистеПечати = ПолучитьЭтикетокНаЛистеПечатиНаСервере(); 
			ПодобранТочныйРаппорт = Истина;
			//Нашелся точный Раппорт, варианты предлагать не нужно
			Возврат Неопределено;
		КонецЦикла;
		Если ПодобранТочныйРаппорт Тогда
			Прервать;	
		КонецЕсли;
	КонецЦикла;

	Если НЕ ПодобранТочныйРаппорт Тогда
		ВозможныеРаппорты = Новый Массив;
		НайденыВариантыМинимумМаксимум = Ложь;
		ВозможныйМаксимальныйРаппорт = Неопределено;
		ВозможныйМинимальныйРаппорт = Неопределено;
		Для КоличествоЭтикеток = 1 По Цел(800/РазмерЭтикетки) Цикл
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Лико_РаппортыРабочиеЦентры.Ссылка.Ссылка КАК Ссылка,
			|	Лико_РаппортыРабочиеЦентры.Ссылка.ДлинаПечати КАК ДлинаПечати,
			|	Лико_РаппортыРабочиеЦентры.Ссылка.Z КАК Z
			|ПОМЕСТИТЬ ВТРаппортМинимум
			|ИЗ
			|	Справочник.Лико_Раппорты.РабочиеЦентры КАК Лико_РаппортыРабочиеЦентры
			|ГДЕ
			|	Лико_РаппортыРабочиеЦентры.РабочийЦентр = &РабочийЦентр
			|	И ОКР(Лико_РаппортыРабочиеЦентры.Ссылка.ДлинаПечати, 2) <= &ВысотаЭтикетки
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДлинаПечати УБЫВ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	Лико_РаппортыРабочиеЦентры.Ссылка КАК Ссылка,
			|	Лико_РаппортыРабочиеЦентры.Ссылка.ДлинаПечати КАК ДлинаПечати,
			|	Лико_РаппортыРабочиеЦентры.Ссылка.Z КАК Z
			|ПОМЕСТИТЬ ВРРаппортМаксимум
			|ИЗ
			|	Справочник.Лико_Раппорты.РабочиеЦентры КАК Лико_РаппортыРабочиеЦентры
			|ГДЕ
			|	Лико_РаппортыРабочиеЦентры.РабочийЦентр = &РабочийЦентр
			|	И ОКР(Лико_РаппортыРабочиеЦентры.Ссылка.ДлинаПечати, 2) >= &ВысотаЭтикетки
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДлинаПечати
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТРаппортМинимум.Ссылка КАК РаппортСсылкаМинимум,
			|	ЕСТЬNULL(ОКР(ВТРаппортМинимум.ДлинаПечати, 2), 0) КАК ДлинаПечатиМинимум,
			|	ВТРаппортМинимум.Z КАК ZМинимум,
			|	ВРРаппортМаксимум.Ссылка КАК РаппортСсылкаМаксимум,
			|	ЕСТЬNULL(ОКР(ВРРаппортМаксимум.ДлинаПечати, 2), 0) КАК ДлинаПечатиМаксимум,
			|	ВРРаппортМаксимум.Z КАК ZМаксимум
			|ИЗ
			|	ВТРаппортМинимум КАК ВТРаппортМинимум
			|		ПОЛНОЕ СОЕДИНЕНИЕ ВРРаппортМаксимум КАК ВРРаппортМаксимум
			|		ПО ВТРаппортМинимум.Ссылка <> ВРРаппортМаксимум.Ссылка";
			
			Запрос.УстановитьПараметр("ВысотаЭтикетки", РазмерЭтикетки * КоличествоЭтикеток);
			Запрос.УстановитьПараметр("РабочийЦентр", Объект.РабочийЦентр);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ДлинаПечатиМинимум = ВыборкаДетальныеЗаписи.ДлинаПечатиМинимум;
				ДлинаПечатиМаксимум = ВыборкаДетальныеЗаписи.ДлинаПечатиМаксимум;
				РазницаМеньшийРаппорт = РазмерЭтикетки * КоличествоЭтикеток - ДлинаПечатиМинимум;
				РазницаБольшийРаппорт = ДлинаПечатиМаксимум - РазмерЭтикетки * КоличествоЭтикеток;
				Если ДлинаПечатиМинимум <> 0 И ДлинаПечатиМаксимум <> 0 Тогда
					ВозможныеРаппорты = Новый Массив;
					НайденыВариантыМинимумМаксимум = Истина;	
					ВозможныеРаппорты.Добавить(Новый Структура("Раппорт,РазницаРазмера,КоличествоЭтикеток",ВыборкаДетальныеЗаписи.РаппортСсылкаМинимум,РазницаМеньшийРаппорт,КоличествоЭтикеток));
					ВозможныеРаппорты.Добавить(Новый Структура("Раппорт,РазницаРазмера,КоличествоЭтикеток",ВыборкаДетальныеЗаписи.РаппортСсылкаМаксимум,РазницаБольшийРаппорт,КоличествоЭтикеток));
				КонецЕсли;
				Если ДлинаПечатиМинимум = 0 Тогда
					Если ВозможныйМаксимальныйРаппорт = Неопределено ИЛИ (РазницаБольшийРаппорт < ВозможныйМаксимальныйРаппорт.РазницаРазмера) Тогда
						ВозможныйМаксимальныйРаппорт = Новый Структура("Раппорт,РазницаРазмера,КоличествоЭтикеток",ВыборкаДетальныеЗаписи.РаппортСсылкаМаксимум,РазницаБольшийРаппорт,КоличествоЭтикеток);
					КонецЕсли;
				ИначеЕсли ДлинаПечатиМаксимум = 0 Тогда
					Если ВозможныйМинимальныйРаппорт = Неопределено ИЛИ (РазницаМеньшийРаппорт < ВозможныйМинимальныйРаппорт.РазницаРазмера) Тогда
						ВозможныйМинимальныйРаппорт = Новый Структура("Раппорт,РазницаРазмера,КоличествоЭтикеток",ВыборкаДетальныеЗаписи.РаппортСсылкаМинимум,РазницаМеньшийРаппорт,КоличествоЭтикеток);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если НайденыВариантыМинимумМаксимум Тогда
				Прервать;	
			КонецЕсли;
		КонецЦикла;
		Если НЕ НайденыВариантыМинимумМаксимум Тогда
			Если ВозможныйМаксимальныйРаппорт <> Неопределено Тогда
				ВозможныеРаппорты.Добавить(ВозможныйМаксимальныйРаппорт);
			КонецЕсли;
			Если ВозможныйМинимальныйРаппорт <> Неопределено Тогда
				ВозможныеРаппорты.Добавить(ВозможныйМинимальныйРаппорт);
			КонецЕсли;
		КонецЕсли;
		Если ВозможныеРаппорты.Количество() <> 0 Тогда
			Возврат ВозможныеРаппорты;
		Иначе
			Сообщить("Не удалось подобрать Раппорт"); 
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПослеВыбораПредложенногоРаппорта(Результат, Параметры) Экспорт  
	
	Если Результат <> Неопределено Тогда 
		Объект.ДлинаЭтикетки = Результат.ВысотаЭтикетки;
		Объект.Раппорт = Результат.Раппорт;
		Объект.Z = ЗначениеРеквизита(Результат.Раппорт,"Z");
		Объект.ДлинаПечати = ЗначениеРеквизита(Результат.Раппорт,"ДлинаПечати")/1000;
		ЗаполнитьПлощадьКлишеНаСервере(Объект.ВидВырубки); 
		ЗаполнитьЭтМЭР();
		Объект.ЭтикетокНаЛистеПечати = ПолучитьЭтикетокНаЛистеПечатиНаСервере();  
		ПараметрыШтампаПриИзменении();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ШиринаЭтикеткиПриИзменении(Элемент)
	
	Если Объект.ВидВырубки = 5 ИЛИ (Объект.ВидВырубки = 6 И Объект.ТипЗаказа <> ПредопределенноеЗначение("Перечисление.Лико_ТипыЗаказов.Термоусадка"))  Тогда
		ЗаполнитьЭтМЭР();
		ЭтикеткиИТиражМетражНаКлиенте();
		ЗаполнитьДлинаПечатиНаСервере();
	ИначеЕсли Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда	
		Заказ = Объект;
		ЗаполнитьПараметрыПечати(Заказ, Объект.ВидВырубки);	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ШтампВырубной) И Объект.ВидВырубки = 0 И ОмегаСНумератором() Тогда
		ЗаполнитьПараметрыПечатиИВырубкиОмегаСНумератором();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДлинаПечатиНаСервере() 
	текДлинаПечати = ПолучитьДлинуПечатиНаСервере();
	Если Не ЗначениеЗаполнено(текДлинаПечати) И Объект.Ссылка.ВидВырубки = Объект.ВидВырубки Тогда
		Возврат;
	КонецЕсли;
	Если текДлинаПечати <> Объект.ДлинаПечати Тогда
		Объект.ДлинаПечати = текДлинаПечати;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеРеквизитовПриУтвержденииЦветов(текВидВырубки) 		// --> Начало Лико Митюшин МФМ 07.09.2021
	
	ЗаполнитьПлощадьКлишеНаСервере(Объект.ВидВырубки);
	Если Не ЗначениеЗаполнено(Объект.ДлинаПечати) И текВидВырубки = 6 Тогда 
		ЗаполнитьДлинаПечатиНаСервере();	
	КонецЕсли;
	
КонецПроцедуры		// <-- Конец Лико Митюшин МФМ 07.09.2021

&НаКлиенте
Процедура ДлинаПечатиПриИзменении(Элемент)
	текВидВырубки = Объект.ВидВырубки;
	Если текВидВырубки = 5 ИЛИ текВидВырубки = 4 ИЛИ текВидВырубки = 11 ИЛИ текВидВырубки = 12 Тогда
		Если текВидВырубки = 5 Тогда
			ЗаполнитьЭтМЭР();
			ЗаполнитьZ();
		ИначеЕсли текВидВырубки = 11 ИЛИ текВидВырубки = 12 ИЛИ текВидВырубки = 14 Тогда  
			ЗаполнитьZ();
			ЗаполнитьЭтикетокНаЛистеПечатиФлексо();
			ЗаполнитьЭтикеткиПечати(текВидВырубки);
		ИначеЕсли текВидВырубки = 4 Тогда
			ЗаполнитьZ();
		КонецЕсли;
		ЭтикеткиИТиражМетражНаКлиенте();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЭтМЭРПриИзменении(Элемент)
	текВидВырубки = Объект.ВидВырубки;
	Если текВидВырубки = 6 Тогда
		ЗаполнитьДлинуПечатиИндиго();		
	КонецЕсли;	
	Если текВидВырубки = 2 ИЛИ текВидВырубки = 6 ИЛИ текВидВырубки = 9 ИЛИ текВидВырубки = 12 Тогда
		текКоличествоЭтПоДлинеПечатиИндиго = ПолучитьЭтикетокПоДлинеПечатиИндигоНаСервере(текВидВырубки);
		Если текКоличествоЭтПоДлинеПечатиИндиго <> Объект.КоличествоЭтПоДлинеПечатиИндиго Тогда 
			Объект.КоличествоЭтПоДлинеПечатиИндиго = текКоличествоЭтПоДлинеПечатиИндиго;	
		КонецЕсли;
	КонецЕсли; 
	Если НЕ ЗначениеЗаполнено(Объект.ШтампВырубной) И текВидВырубки = 0 И ОмегаСНумератором() Тогда
		ЗаполнитьПараметрыПечатиИВырубкиОмегаСНумератором(Объект.ЭтМЭР);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура РассчитатьМетражПФНаСервере()
	
	Если Объект.Товары.Количество()>0 Тогда 
		стр = Объект.Товары[0];
		//Если  стр.ЕдиницаИзмерения = Справочники.Лико_ПредопределенныеЗначения.ЕИКвадрМетр.ЗначениеПараметра Тогда 
			Если Объект.ВидРЦГП = Справочники.ВидыРабочихЦентров.Ламинатор Тогда 
				КоличествоНастроек = ?(Объект.КоличествоЗаказовГП>1, Объект.КоличествоЗаказовГП/2, Объект.КоличествоЗаказовГП) ;
				стр.Количество =  Объект.МетражКВМЗаказовГП*1.02+(300* КоличествоНастроек+300)* Объект.Нарезка.Размер/1000;
				стр.КоличествоУпаковок = стр.Количество;
			ИначеЕсли Объект.ВидРЦГП = Справочники.ВидыРабочихЦентров.Аппликатор Тогда 
				стр.Количество =  Объект.МетражКВМЗаказовГП*1.02+300*Объект.Нарезка.Размер/1000 * Объект.КоличествоЗаказовГП;
				стр.КоличествоУпаковок = стр.Количество;
			КонецЕсли;
		//КонецЕсли;
	КонецЕсли;

КонецПроцедуры

