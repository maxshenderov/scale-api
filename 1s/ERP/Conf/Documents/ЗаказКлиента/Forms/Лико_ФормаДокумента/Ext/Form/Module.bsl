&НаСервере 
Функция ПолучитьФактическиеМетры()
	Количество = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(Лико_ЗатратыПоОтгрузке.Количество) КАК Количество
	|ИЗ
	|	РегистрНакопления.Лико_ЗатратыПоОтгрузке КАК Лико_ЗатратыПоОтгрузке
	|ГДЕ
	|	Лико_ЗатратыПоОтгрузке.ЗаказКлиента = &Заказ
	|	И Лико_ЗатратыПоОтгрузке.СтатьяЗатрат = ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ОсновнойМатериал)";
