&НаКлиенте
Процедура ЦветаВалФормаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Цвета.ТекущиеДанные;
	Если НЕ (ЗначениеРеквизита(ТекущиеДанные.ВидСекции,"Родитель") = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Глубокая")
		ИЛИ ТекущиеДанные.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.БессольвентнаяЛаминация")) Тогда   
		Если ЗначениеЗаполнено("Текст") Тогда 
			СпрФорма = ПолучитьФормуНаСервере(Текст);
			Если ЗначениеЗаполнено(СпрФорма) Тогда 
				УдалитьСписокЗначений("Формы", ТекущиеДанные.КлючСтроки);
				стр = Объект.Формы.Добавить();
				стр.Значение = СпрФорма;
				стр.КлючСтроки = ТекущиеДанные.КлючСтроки;
				текущиеДанные.Форма = СпрФорма;
				текущиеДанные.ВалФорма = СпрФорма;
				ДобавитьУсловноеОформлениеЦветаВалФорма();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦветаФормаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Цвета.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Форма) Тогда
		ДатаГлубокихФорм = ЗначениеРеквизита(ПредопределенноеЗначение("Справочник.Лико_ПредопределенныеЗначения.ДатаГлубокихФорм"),"ЗначениеПараметра");
		Если ЗначениеЗаполнено(ДатаГлубокихФорм) И ДатаГлубокихФорм < ТекущаяДата() И ЗначениеРеквизита(ТекущиеДанные.ВидСекции,"Родитель") = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Глубокая") Тогда
			Грамматура = ЗначениеРеквизита(ТекущиеДанные.Форма,"Грамматура");
			ПроцентЗаливки = ЗначениеРеквизита(ТекущиеДанные.Форма,"ПроцентЗаливки");
			Если ЗначениеЗаполнено(Грамматура) Тогда
				ТекущиеДанные.Грамматура = Грамматура * 0.5;
			Иначе
				
			КонецЕсли;
			Если ЗначениеЗаполнено(ПроцентЗаливки) Тогда
				ТекущиеДанные.ПроцентЗаливки = ПроцентЗаливки;
			Иначе
				
			КонецЕсли;
			ВалСвязанныйСФормой = ПолучитьВалСвязанныйСФормой(ТекущиеДанные.Форма); 
			Если ЗначениеЗаполнено(ВалСвязанныйСФормой) И ТипЗнч(ВалСвязанныйСФормой) = Тип("СправочникСсылка.Номенклатура") Тогда
				ТекущиеДанные.Вал = ВалСвязанныйСФормой;
				Элементы.Цвета.ЗакончитьРедактированиеСтроки(Ложь);	
			ИначеЕсли ЗначениеЗаполнено(ВалСвязанныйСФормой) И ТипЗнч(ВалСвязанныйСФормой) = Тип("Массив") Тогда
				ПараметыФормы = Новый Структура("Заголовок,ФормаОтбор","Выберие Вал",ТекущиеДанные.Форма);
				ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораВала", ЭтаФорма);
				ОткрытьФорму("РегистрСведений.Лико_ВалыФормы.Форма.ФормаВыбораВала",ПараметыФормы,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ТекущиеДанные.ФормаНомерЛинкс = Неопределено;	
	КонецЕсли;
	
	ДобавитьУсловноеОформлениеЦветаВалФорма();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВалСвязанныйСФормой(ФормаСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	//"ВЫБРАТЬ
	//|	Лико_ВалыФормыСрезПоследних.Период КАК ДатаПрихода,
	//|	Лико_ВалыФормыСрезПоследних.Вал.Артикул КАК ВалАртикул,
	//|	Лико_ВалыФормыСрезПоследних.Вал КАК Вал
	//|ИЗ
	//|	РегистрСведений.Лико_ВалыФормы.СрезПоследних(, Форма = &Форма) КАК Лико_ВалыФормыСрезПоследних";
	"ВЫБРАТЬ
	|	Лико_ЗаявкиНаГравировкуВаловОстатки.Вал КАК Вал
	|ПОМЕСТИТЬ ВТВалыПерегравировкаВсе
	|ИЗ
	|	РегистрНакопления.Лико_ЗаявкиНаГравировкуВалов.Остатки КАК Лико_ЗаявкиНаГравировкуВаловОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(, НЕ Ячейка.Помещение.Лико_ПомещениеБрака) КАК ТоварыВЯчейкахОстатки
	|		ПО Лико_ЗаявкиНаГравировкуВаловОстатки.Вал = ТоварыВЯчейкахОстатки.Номенклатура
	|ГДЕ
	|	Лико_ЗаявкиНаГравировкуВаловОстатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДАТАВРЕМЯ(3999, 12, 31) КАК ДатаПрихода,
	|	Лико_ЗаявкиНаГравировкуВаловОстатки.Вал.Артикул КАК ВалАртикул,
	|	Лико_ЗаявкиНаГравировкуВаловОстатки.Вал КАК Вал
	|ПОМЕСТИТЬ ВТВалыПерегравировка
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(, НЕ Ячейка.Помещение.Лико_ПомещениеБрака) КАК ТоварыВЯчейкахОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ЗаявкиНаГравировкуВалов.Остатки(, Форма = &Форма) КАК Лико_ЗаявкиНаГравировкуВаловОстатки
	|		ПО ТоварыВЯчейкахОстатки.Номенклатура = Лико_ЗаявкиНаГравировкуВаловОстатки.Вал
	|ГДЕ
	|	Лико_ЗаявкиНаГравировкуВаловОстатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_ВалыФормыСрезПоследних.Период КАК ДатаПрихода,
	|	Лико_ВалыФормыСрезПоследних.Вал.Артикул КАК ВалАртикул,
	|	Лико_ВалыФормыСрезПоследних.Вал КАК Вал
	|ПОМЕСТИТЬ ВТВалы
	|ИЗ
	|	РегистрСведений.Лико_ВалыФормы.СрезПоследних(, Форма = &Форма) КАК Лико_ВалыФормыСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
	|				,
	|				НЕ Ячейка.Помещение.Лико_ПомещениеБрака
	|					И НЕ Номенклатура В
	|							(ВЫБРАТЬ
	|								ВТВалыПерегравировка.Вал КАК Вал
	|							ИЗ
	|								ВТВалыПерегравировка КАК ВТВалыПерегравировка)
	|					И НЕ Номенклатура В
	|							(ВЫБРАТЬ
	|								ВТВалыПерегравировкаВсе.Вал КАК Вал
	|							ИЗ
	|								ВТВалыПерегравировкаВсе КАК ВТВалыПерегравировкаВсе)) КАК ТоварыВЯчейкахОстатки
	|		ПО Лико_ВалыФормыСрезПоследних.Вал = ТоварыВЯчейкахОстатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ВалыФормы.СрезПоследних КАК Лико_ВалыФормыСрезПоследнихТекущаяФорма
	|		ПО Лико_ВалыФормыСрезПоследних.Вал = Лико_ВалыФормыСрезПоследнихТекущаяФорма.Вал
	|ГДЕ
	|	Лико_ВалыФормыСрезПоследних.Форма = Лико_ВалыФормыСрезПоследнихТекущаяФорма.Форма
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТВалы.ДатаПрихода КАК ДатаПрихода,
	|	ВТВалы.ВалАртикул КАК ВалАртикул,
	|	ВТВалы.Вал КАК Вал
	|ПОМЕСТИТЬ ВТВсеВалы
	|ИЗ
	|	ВТВалы КАК ВТВалы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТВалыПерегравировка.ДатаПрихода,
	|	ВТВалыПерегравировка.ВалАртикул,
	|	ВТВалыПерегравировка.Вал
	|ИЗ
	|	ВТВалыПерегравировка КАК ВТВалыПерегравировка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТВсеВалы.ДатаПрихода КАК ДатаПрихода,
	|	ВТВсеВалы.ВалАртикул КАК ВалАртикул,
	|	ВТВсеВалы.Вал КАК Вал
	|ИЗ
	|	ВТВсеВалы КАК ВТВсеВалы
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПрихода";
	
	Запрос.УстановитьПараметр("Форма", ФормаСсылка);
	
	ТЗВалы = Запрос.Выполнить().Выгрузить();
	
	МассивВалы = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТЗВалы);
	Если МассивВалы.Количество() = 1 Тогда
		Возврат МассивВалы[0].Вал;
	ИначеЕсли МассивВалы.Количество() > 1 Тогда
		Возврат МассивВалы;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
					
КонецФункции

&НаКлиенте
Процедура ПослеВыбораВала(Результат, Параметры) Экспорт  
	
	текстр = Элементы.Цвета.ТекущиеДанные;
	Если Результат <> Неопределено И текстр <> Неопределено Тогда 
		текстр.Вал = Результат;
		Элементы.Цвета.ЗакончитьРедактированиеСтроки(Ложь);	
	Иначе
		Элементы.Цвета.ЗакончитьРедактированиеСтроки(Ложь);	
	КонецЕсли;
	
	ДобавитьУсловноеОформлениеЦветаВалФорма();
	
КонецПроцедуры

&НаКлиенте
Процедура ЦветаГрамматураАвтоПодбор(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	текстр = Элементы.Цвета.ТекущиеДанные;
	Если ЗначениеЗаполнено(текстр.ВидСекции) Тогда
		Если текстр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ТрафаретнаяПечать") Тогда 
			СтандартнаяОбработка = Ложь;
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораГр", ЭтаФорма);
			ОткрытьФорму("Справочник.Лико_ТрафаретныеСетки.ФормаВыбора", ,ЭтаФорма , , , , ОписаниеОповещения);
		ИначеЕсли ЗначениеРеквизита(текстр.ВидСекции,"Родитель") = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ЦифровойМодуль") Тогда
			СтандартнаяОбработка = Ложь;
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораГр", ЭтаФорма);
			ОткрытьФорму("Справочник.Лико_ГрамматураНаРЦ.ФормаВыбора", ,ЭтаФорма , , , , ОписаниеОповещения);
		КонецЕсли;
	Иначе
		Сообщить("Заполните Вид работ");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораГр(Результат, Параметры) Экспорт  
	
	текстр = Элементы.Цвета.ТекущиеДанные;
	Если Результат <> Неопределено И текстр <> Неопределено Тогда 
		Если ТипЗнч(Результат) = Тип("СправочникСсылка.Лико_ТрафаретныеСетки") ТОгда 
			текстр.ТрафаретнаяСетка = Результат;
			текстр.Грамматура = ЗначениеРеквизита(Результат,"Грамматура");
			Элементы.Цвета.ЗакончитьРедактированиеСтроки(Ложь);	
		ИначеЕсли ТипЗнч(Результат) = Тип("СправочникСсылка.Лико_ГрамматураНаРЦ") Тогда
			текстр.ГрамматураНаРЦ = Результат;
			текстр.Грамматура = ЗначениеРеквизита(Результат,"Грамматура");
			Элементы.Цвета.ЗакончитьРедактированиеСтроки(Ложь);	
		КонецЕсли;
	Иначе
		Элементы.Цвета.ЗакончитьРедактированиеСтроки(Ложь);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСШагом(Команда)
	
	Если Объект.РасчетТиражей.Количество() > 0 И Объект.РасчетТиражей[0].Тираж > 0 Тогда
		Обработка = НайтиВПФ("Отчет ""Расчет доходности тиражей заказа""");
		Если Обработка <> Неопределено Тогда 
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("Количество",Объект.РасчетТиражей[0].Тираж);
			ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(Обработка);
			ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.ЗапросДанныхУПользователя", ПараметрыОткрытия,ЭтаФорма,,,,Новый ОписаниеОповещения("ЗаполнитьСШагомЗавершение", ЭтотОбъект),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;	
	Иначе
		Сообщить("Не заполнен тираж в строке 1");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСШагомЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 	
			Если ЭтаФорма.Модифицированность Тогда
				Сообщить("Необходимо записать документ");
				Возврат
			КонецЕсли; 
		иначе  
			Сообщить("Необходимо записать заказ");
			Возврат	
		КонецЕсли;
		ТиражПредыдущейСтроки = Объект.РасчетТиражей[0].Тираж;
		ОбновитьРасчетТиражейНаСервере(Истина);
		Для КоличествоСтрок = 1 По (РезультатЗакрытия.До - РезультатЗакрытия.От) / РезультатЗакрытия.СШагом Цикл
			НС = Объект.РасчетТиражей.Добавить();
			ЗаполнитьЗначенияСвойств(НС,Объект.РасчетТиражей[0]);
			НС.Тираж = ТиражПредыдущейСтроки + РезультатЗакрытия.СШагом;
			РасчетТиражейПересчет(НС);
			ТиражПредыдущейСтроки = НС.Тираж;
		КонецЦикла
	КонецЕсли;
    
КонецПроцедуры   

&НаКлиенте
Процедура РасчетТиражейЦена(Команда)
	
	Если Объект.РасчетТиражей.Количество() > 0 Тогда
		ЦенаПервойСтроки = Объект.РасчетТиражей[0].Цена;
		Для каждого Стр Из Объект.РасчетТиражей Цикл
			Если Стр.НомерСтроки <> 1 Тогда
				Стр.Цена = ЦенаПервойСтроки;
				ПараметрыРасчетаПересчитатьДанные(Стр);
			КонецЕсли;
		КонецЦикла
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РасчетТиражейДоходность(Команда)
	
	Если Объект.РасчетТиражей.Количество() > 0 Тогда
		ДоходностьПервойСтроки = Объект.РасчетТиражей[0].Доходность;
		Для каждого Стр Из Объект.РасчетТиражей Цикл
			Если Стр.НомерСтроки <> 1 Тогда
				Стр.Доходность = ДоходностьПервойСтроки; 
				Стр.Доход = Стр.Доходность*Стр.Время; 
				Стр.Стоимость = (Стр.Доход+Стр.Себестоимость)/К_Дох;
				Стр.Цена = Стр.Стоимость/Стр.Тираж; 
				Стр.ЦенаБезНДС = Стр.Цена *100/122; 
				Если ЗначениеЗаполнено(Стр.МетражКВМ) Тогда 
					Стр.ЦенаМ2 = Стр.Стоимость/Стр.МетражКВМ;
				КонецЕсли;
				Стр.Рентабельность = Окр(Стр.Доход/Стр.Стоимость*100,2);
			КонецЕсли;
		КонецЦикла
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетТиражейРентабельность(Команда)
	
	Если Объект.РасчетТиражей.Количество() > 0 Тогда
		РентабельностьПервойСтроки = Объект.РасчетТиражей[0].Рентабельность;
		Для каждого Стр Из Объект.РасчетТиражей Цикл
			Если Стр.НомерСтроки <> 1 Тогда
				Стр.Рентабельность = РентабельностьПервойСтроки;
				Стр.Стоимость = Стр.Себестоимость / (К_Дох - Стр.Рентабельность / 100);	
				Стр.Цена = Стр.Стоимость/Стр.тираж; 
				Стр.ЦенаБезНДС = Стр.Цена*100/122;	
				Если ЗначениеЗаполнено(Стр.МетражКВМ) Тогда 
					Стр.ЦенаМ2 = Стр.Стоимость/Стр.МетражКВМ;
				КонецЕсли;
				
				Стр.Доход = Стр.Стоимость*К_Дох - Стр.Себестоимость;   
				Если ЗначениеЗаполнено(Стр.Время) Тогда 
					Стр.Доходность = Стр.Доход/Стр.Время;
				КонецЕсли;  
			КонецЕсли;
		КонецЦикла
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаппортПриИзменении(Элемент)
	
	текВидВырубки = ?(Объект.ТипЗаказа = ПредопределенноеЗначение("Перечисление.Лико_ТипыЗаказов.Термоусадка"),19,18);
	
	Объект.ДлинаПечати = ЗначениеРеквизита(Объект.Раппорт, "ДлинаПечати") / 1000;
	Если текВидВырубки = 19 Тогда
		Объект.КоличествоЭтПоДлинеПечати = Окр(Объект.ДлинаПечати/(Объект.ДлинаЭтикетки/1000));
	ИначеЕсли текВидВырубки = 18 Тогда
		Объект.КоличествоЭтПоДлинеПечати = Окр(Объект.ДлинаПечати/(Объект.ШиринаЭтикетки/1000)); 
	КонецЕсли;

	ЗаполнитьПлощадьКлишеНаСервере(текВидВырубки);
	Объект.ЭтикетокНаЛистеПечати = ПолучитьЭтикетокНаЛистеПечатиНаСервере(текВидВырубки);
	Объект.РаппортМеняли = Истина;

КонецПроцедуры

&НаСервере
Функция ОмегаСНумератором()
	
	текНайденныеСтрокиНумератор = Объект.Цвета.НайтиСтроки(Новый Структура("ВидСекции",Справочники.Лико_ВидыСекций.Нумератор));
	Для Каждого ТекСтрока Из текНайденныеСтрокиНумератор Цикл
		Если ВидРЦОмега(ТекСтрока.РабочийЦентр) Тогда
        	Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПараметрыПечатиИВырубкиОмегаСНумератором(иЭтМЭР = Неопределено) 
	
	Объект.ЭтМЭР = ?(ЗначениеЗаполнено(иЭтМЭР),иЭтМЭР,0.4826 / Цел(0.4826/(Объект.ШиринаЭтикетки / 1000 + 0.0027)));
	Если ЗначениеРеквизита(Объект.РабочийЦентр,"ВидРабочегоЦентра") = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.Indigo") Тогда
		Объект.ЭтикетокНаЛистеИндиго = Объект.КоличествоЭтПоДлинеПечатиИндиго * Объект.РучьиПечатиИндиго;
		Объект.ДлинаПечатиИндиго = Объект.КоличествоЭтПоДлинеПечатиИндиго * Объект.ЭтМЭР
	ИначеЕсли Объект.Ручьи <> 0 Тогда
		Объект.ЭтикетокНаЛистеПечати = Объект.ЭтикетокНаЛисте * Объект.РучьиПечати/Объект.Ручьи;
	КонецЕсли;
	Объект.ШагПечати = Объект.ЭтикетокНаЛисте / Объект.Ручьи * Объект.ЭтМЭР;
	Объект.ПлощадьКлише = (Объект.ШагПечати*100 + 2)*(ЗначениеРеквизита(Объект.Нарезка,"Размер")/10 + 2);
    РасчитатьТиражМетраж();
	
КонецПроцедуры

&НаКлиенте
Процедура РучьиПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.ШтампВырубной) И Объект.ВидВырубки = 0 И ОмегаСНумератором() Тогда
		ЗаполнитьПараметрыПечатиИВырубкиОмегаСНумератором();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидУпаковкиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Объект.Площадка = ГлЛико_Площадки.ИксПак ИЛИ Объект.Площадка = ГлЛико_Площадки.Ликофлекс Тогда    
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.СтрейчПленка"),"Стрейч пленка");
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.Коробки"),"Коробки"); 
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.ПакетыКоробки"),"Пакеты + Коробки");
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.БезКоробокНаПаллет"),"Без коробок на паллет");
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.УпаковкаНаПаллетПодСтрейчПленку"),"Упаковка на паллет под стрейч пленку");
	Иначе
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.СтрейчПленка"),"Стрейч пленка");
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.Коробки"),"Коробки"); 
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.ПакетыКоробки"),"Пакеты + Коробки");
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.СтрейчПленкаКоробка"),"Стрейч пленка + Коробки");
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.ТермопленкаКоробки"),"Термопленка + Коробки");
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.СтрейчПленкаПрокладкаРебраЖесткостиКоробка"),"СтрейчПленка+Прокладка+РебраЖесткости+Коробка");
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.БезКоробокНаПаллет"),"Без коробок на паллет");
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.УпаковкаНаПаллетПодСтрейчПленку"),"Упаковка на паллет под стрейч пленку");
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Справочник.Лико_ВидыУпаковки.ВкладышТермопленка"),"Вкладыш + термопленка");
	КонецЕсли;			
	
КонецПроцедуры

&НаСервере
Процедура АктуализироватьВалыНаСервере()
	
	БылиИзмененияВалАртикул = Ложь;
	Для Каждого Стр Из Объект.Цвета Цикл
		Если Стр.ВидСекции.Родитель = Справочники.Лико_ВидыСекций.Глубокая И ЗначениеЗаполнено(Стр.Вал) И СтрДлина(СокрЛП(Стр.Вал.Артикул)) > 6 Тогда	
			ВалОбъект = Стр.Вал.ПолучитьОбъект();
			ВалОбъект.Артикул = Сред(ВалОбъект.Артикул,1,6);
			//Проверка на существование номенклатуры с таким наименованием и артикулом из 6 цифр, добавляем "0" к артикулу, если находим
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.Наименование = &Наименование
			|	И Номенклатура.Артикул = &Артикул";
			
			Запрос.УстановитьПараметр("Артикул", ВалОбъект.Артикул);
			Запрос.УстановитьПараметр("Наименование", ВалОбъект.Наименование);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ВалОбъектДляПереименования = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект(); 
				ВалОбъектДляПереименования.Артикул = ВалОбъектДляПереименования.Артикул + "0";
				ВалОбъектДляПереименования.ОбменДанными.Загрузка = Истина;
				ВалОбъектДляПереименования.Записать();
			КонецЦикла;
			ВалОбъект.ОбменДанными.Загрузка = Истина;
			ВалОбъект.Записать();
			БылиИзмененияВалАртикул = Истина;
			
		КонецЕсли;
	КонецЦикла;
	
	Если БылиИзмененияВалАртикул Тогда
		ДобавитьУсловноеОформлениеЦветаВалФорма();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АктуализироватьВалы(Команда)
	
	ДатаГлубокихФорм = ЗначениеРеквизита(ПредопределенноеЗначение("Справочник.Лико_ПредопределенныеЗначения.ДатаГлубокихФорм"),"ЗначениеПараметра");
	Если ЗначениеЗаполнено(ДатаГлубокихФорм) И ДатаГлубокихФорм < ТекущаяДата() Тогда
		АктуализироватьВалыНаСервере();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьФормы(Команда)
	
    СоздатьФормыНаСервере();
	ДобавитьУсловноеОформлениеЦветаВалФорма();

КонецПроцедуры

&НаСервере
Процедура СоздатьФормыНаСервере()
	
	стрТовары = Объект.Товары[0];
	СоздатьТолькоТрафарет = Ложь;
	Если ЗначениеЗаполнено(стрТовары.ВерсияНоменклатуры) Тогда 
		Артикул = Прав(стрТовары.ВерсияНоменклатуры.АртикулНоменклатуры,4) + Формат(стрТовары.ВерсияНоменклатуры.Версия,"ЧЦ=2; ЧН=; ЧВН=");
		ФормаНайти = Справочники.Лико_Формы.НайтиПоРеквизиту("КодЛинкс",Артикул);	
		Если ЗначениеЗаполнено(ФормаНайти) Тогда			
			Если Объект.Цвета.НайтиСтроки(Новый Структура("ВидСекции",справочники.Лико_ВидыСекций.ТрафаретнаяПечать)).Количество() <> 0 Тогда	
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	Лико_Формы.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Лико_Формы КАК Лико_Формы
				|ГДЕ
				|	НЕ Лико_Формы.ПометкаУдаления
				|	И Лико_Формы.КодЛинкс = &КодЛинкс
				|	И Лико_Формы.ВидСекции = &ВидСекции";
				
				Запрос.УстановитьПараметр("ВидСекции", справочники.Лико_ВидыСекций.ТрафаретнаяПечать);
				Запрос.УстановитьПараметр("КодЛинкс", Артикул);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					Сообщить("Формы для выбранной версии номенклатуры уже существуют"); 
					Возврат;
				КонецЦикла; 
				СоздатьТолькоТрафарет = Истина;
			Иначе
				Сообщить("Формы для выбранной версии номенклатуры уже существуют"); 
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Номенклатура = Объект.Товары[0].Номенклатура;  
		сч = 1;
		Для каждого стр из Объект.Цвета Цикл 
			ВидПечати = стр.ВидСекции.ВидПечати;
			Если ВидПечати = справочники.Лико_ВидыПечати.Флексо ИЛИ ВидПечати = справочники.Лико_ВидыПечати.Трафарет Тогда 
				Если Не ЗначениеЗаполнено(стр.Форма) И стр.Цветоделение = Ложь И (стр.ВидТМЦ = Справочники.Лико_ВидыТМЦ.Краска или стр.ВидЗаливки = Перечисления.Лико_ВидЗаливки.НеСплошная) Тогда 
					Если (СоздатьТолькоТрафарет И ВидПечати = справочники.Лико_ВидыПечати.Трафарет) ИЛИ НЕ СоздатьТолькоТрафарет Тогда
						НоваяФормаЦвета = Справочники.Лико_Формы.СоздатьЭлемент(); 
						НоваяФормаЦвета.Контрагент = Объект.Контрагент; 
						НоваяФормаЦвета.Заказ = Объект.Ссылка;
						НоваяФормаЦвета.ВидПечати = ВидПечати; 
						НоваяФормаЦвета.ВидСекции = стр.ВидСекции;
						НоваяФормаЦвета.ТипЦвета = стр.ТипЦвета1; 
						НоваяФормаЦвета.ТипКраски = стр.ТипКраски; 
						НоваяФормаЦвета.Название = стр.Название;
						НоваяФормаЦвета.Наименование = ?(ЗначениеЗаполнено(стр.ТипЦвета1), Строка(стр.ТипЦвета1)+ " ", "") + ?(ЗначениеЗаполнено(стр.ТипКраски), Строка(стр.ТипКраски)+ " ", "") + ?(ЗначениеЗаполнено(стр.Название), Строка(стр.Название), "");
						НоваяФормаЦвета.Площадка = Объект.Площадка;
						НоваяФормаЦвета.Организация = Объект.Площадка.Организация;
						
						стрЭт = НоваяФормаЦвета.Этикетки.Добавить();
						стрэт.Номенклатура =  Номенклатура;
						Если СоздатьТолькоТрафарет Тогда
							Запрос = Новый Запрос;
							Запрос.Текст = 
							"ВЫБРАТЬ
							|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лико_Формы.Ссылка) КАК Ссылка
							|ИЗ
							|	Справочник.Лико_Формы КАК Лико_Формы
							|ГДЕ
							|	Лико_Формы.КодЛинкс = &КодЛинкс";
							
							Запрос.УстановитьПараметр("КодЛинкс", Артикул);
							
							РезультатЗапроса = Запрос.Выполнить();
							
							ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
							
							Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
								сч = ВыборкаДетальныеЗаписи.Ссылка + 1;
							КонецЦикла;
						КонецЕсли;
						НоваяФормаЦвета.Код = Артикул + Формат(сч,"ЧЦ=2; ЧВН=");
						НоваяФормаЦвета.КодЛинкс = Артикул;
						
						НоваяФормаЦвета.Записать();  
						стр.форма =  НоваяФормаЦвета.ссылка;
						сч = сч + 1;
						ЭтаФорма.Модифицированность = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СвязатьНаСервере()
	
	Для Каждого Стр Из Объект.Цвета Цикл
		Если Стр.ВидСекции.Родитель = Справочники.Лико_ВидыСекций.Глубокая И ЗначениеЗаполнено(Стр.Вал) И ЗначениеЗаполнено(Стр.Форма) Тогда
			//Регистратор - последний документ прихода формы
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Лико_ВозвратТоваровТовары.Ссылка КАК Ссылка,
			|	Лико_ВозвратТоваровТовары.Ссылка.Дата КАК Дата
			|ПОМЕСТИТЬ ВТ_ПоследнийПриход
			|ИЗ
			|	Документ.Лико_ВозвратТоваров.Товары КАК Лико_ВозвратТоваровТовары
			|ГДЕ
			|	Лико_ВозвратТоваровТовары.Номенклатура = &Вал
			|	И Лико_ВозвратТоваровТовары.Ссылка.Проведен
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ПриходныйОрдерНаТоварыТовары.Ссылка,
			|	ПриходныйОрдерНаТоварыТовары.Ссылка.Дата
			|ИЗ
			|	Документ.ПриходныйОрдерНаТовары.Товары КАК ПриходныйОрдерНаТоварыТовары
			|ГДЕ
			|	ПриходныйОрдерНаТоварыТовары.Ссылка.Проведен
			|	И ПриходныйОрдерНаТоварыТовары.Номенклатура = &Вал
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	ВТ_ПоследнийПриход.Ссылка КАК Ссылка
			|ИЗ
			|	ВТ_ПоследнийПриход КАК ВТ_ПоследнийПриход
			|
			|УПОРЯДОЧИТЬ ПО
			|	ВТ_ПоследнийПриход.Дата УБЫВ";
			
			Запрос.УстановитьПараметр("Вал", Стр.Вал);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Количество() = 0 Тогда
				Сообщить("Не удалось связать Вал " + Стр.Вал.Артикул + " с формой " + Стр.Форма.Код + " из строки " + Стр.НомерСтроки + ". Не найден документ прихода по Валу " + Стр.Вал.Артикул);	
			КонецЕсли;
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

				НаборЗаписей = РегистрыСведений.Лико_ВалыФормы.СоздатьНаборЗаписей();
				
				НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Ссылка);
				НаборЗаписей.Прочитать();
				ОбновитьСуществующуюЗапись = Ложь;
				Для Каждого Запись Из НаборЗаписей Цикл
					Если Запись.Вал = Стр.Вал Тогда
						ОбновитьСуществующуюЗапись = Истина;
						Запись.Форма = Стр.Форма; 
					КонецЕсли;
				КонецЦикла;
				Если НЕ ОбновитьСуществующуюЗапись Тогда
					НоваяЗапись = НаборЗаписей.Добавить();
					НоваяЗапись.Регистратор = ВыборкаДетальныеЗаписи.Ссылка;
					НоваяЗапись.Период = ВыборкаДетальныеЗаписи.Ссылка.Дата;
					НоваяЗапись.Вал = Стр.Вал;
					НоваяЗапись.Форма = Стр.Форма;
					НоваяЗапись.Заказ = Объект.Ссылка;
				КонецЕсли;
				
				НаборЗаписей.Записать();
				
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Сообщить("Готово");
	
КонецПроцедуры

&НаКлиенте
Процедура Связать(Команда)
	
	ДатаГлубокихФорм = ЗначениеРеквизита(ПредопределенноеЗначение("Справочник.Лико_ПредопределенныеЗначения.ДатаГлубокихФорм"),"ЗначениеПараметра");
	Если ЗначениеЗаполнено(ДатаГлубокихФорм) И ДатаГлубокихФорм < ТекущаяДата() Тогда
		Если ЭтаФорма.Модифицированность Тогда
			Сообщить("Необходимо записать заказ!");
			Возврат;
		КонецЕсли;
		СвязатьНаСервере();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЦветаНовыйВалПриИзменении(Элемент)
	
	ДатаГлубокихФорм = ЗначениеРеквизита(ПредопределенноеЗначение("Справочник.Лико_ПредопределенныеЗначения.ДатаГлубокихФорм"),"ЗначениеПараметра");
