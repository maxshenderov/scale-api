	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ВалыФормыСрезПоследних.Вал КАК Вал,
	|	Лико_ВалыФормыСрезПоследних.Форма КАК Форма,
	|	ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0) КАК ВНаличииОстаток
	|ИЗ
	|	РегистрСведений.Лико_ВалыФормы.СрезПоследних(, ) КАК Лико_ВалыФормыСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки КАК ТоварыВЯчейкахОстатки
	|		ПО Лико_ВалыФормыСрезПоследних.Вал = ТоварыВЯчейкахОстатки.Номенклатура
	|ГДЕ
	|	Лико_ВалыФормыСрезПоследних.Форма = &Форма";
	
	Запрос.УстановитьПараметр("Форма", ФормаВала);
	
