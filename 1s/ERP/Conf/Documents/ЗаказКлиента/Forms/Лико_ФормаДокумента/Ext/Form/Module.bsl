		ФормаШтампаМассив = Объект.ШтампВырубной.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство",ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя", "ОснасткаВидФормаШтампа")));
		Если ФормаШтампаМассив.Количество() <> 0 Тогда
			ФормаШтампа = ФормаШтампаМассив[0].Значение;	
		КонецЕсли;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 06.05.2025
