&НаСервере
Функция ПроверкаПробеговШтампов(СтруктураСНормативом)		// <-- Начало Лико Митюшин МФМ 29.07.2021
	
	УстановитьПривилегированныйРежим(Истина);


	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ВидСекции", Справочники.Лико_ВидыСекций.Вырубка);	
	НайденныеСтроки = Объект.Цвета.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество() = 0 Тогда 
		Возврат Ложь;
	КонецЕсли;
		
	текТабЗначений = Новый ТаблицаЗначений;
	текТабЗначений.Колонки.Добавить("Оснастка", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	текТабЗначений.Колонки.Добавить("РабочийЦентр", Новый ОписаниеТипов("СправочникСсылка.РабочиеЦентры"));
	
	МассивШтампов = Новый Массив;
	Для каждого ТекСтр из НайденныеСтроки Цикл  
		Если ЗначениеЗаполнено(ТекСтр.Оснастка) Тогда 
			НовСтр = текТабЗначений.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, ТекСтр);
			МассивШтампов.Добавить(ТекСтр.Оснастка);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивШтампов.Количество() = 0 Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПооперационноеРасписание2_2.Этап.Распоряжение.ДокументОснование) = ТИП(Документ.ЗаказДавальца)
