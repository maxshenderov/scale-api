		ПолучитьЗагруженныеДанныеИзХранилища(ВыбранноеЗначение.АдресЦветовВХранилище);
		ЗаписатьЦветаВРаботы();
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПолучитьЗагруженныеДанныеИзХранилища(АдресЦветовВХранилище)
	
	ЦветаИзХранилища = ПолучитьИзВременногоХранилища(АдресЦветовВХранилище);
	
	ОбновитьОтображениеФорм = Ложь;
	
	Для каждого Строка из ЦветаИзХранилища Цикл
		НайденнаяСтрока = Объект.Цвета.НайтиСтроки(Новый Структура("НомерСтроки",Строка.НомерСтроки));
		
		Если НайденнаяСтрока.Количество() = 0 Тогда
			Возврат;
		Иначе
			НоваяСтрока = НайденнаяСтрока[0];	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.Название) Тогда
			НоваяСтрока.Название = Строка.Название;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			НоваяСтрока.Номенклатура = Строка.Номенклатура;
			Если НоваяСтрока.ТипКраски <> НоваяСтрока.Номенклатура.ЦеноваяГруппа Тогда
				НоваяСтрока.ТипКраски = НоваяСтрока.Номенклатура.ЦеноваяГруппа;	
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.Анилокс) Тогда
			НоваяСтрока.Анилокс = Строка.Анилокс;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.ТрафаретнаяСетка) Тогда
			НоваяСтрока.ТрафаретнаяСетка = Строка.ТрафаретнаяСетка;
			ГрамматураСетки = НоваяСтрока.ТрафаретнаяСетка.Грамматура;
			Если ЗначениеЗаполнено(ГрамматураСетки)  Тогда
				НоваяСтрока.Грамматура = ГрамматураСетки;
			КонецЕсли;
		КонецЕсли;
		
		СпрФорма = ?(ЗначениеЗаполнено(Строка.ФормаНомерЛинкс),ПолучитьФормуНаСервере(Строка.ФормаНомерЛинкс),Неопределено);
		Если ЗначениеЗаполнено(СпрФорма) Тогда
			НоваяСтрока.Форма = СпрФорма;	
		ИначеЕсли ЗначениеЗаполнено(НоваяСтрока.ВидСекции) И ЗначениеЗаполнено(Строка.ФормаНомерЛинкс) Тогда
			ВидПечати = НоваяСтрока.ВидСекции.ВидПечати;  
			Если ВидПечати = Справочники.Лико_ВидыПечати.Флексо Тогда 
				НоваяФорма = СоздатьНовуюФорму(НоваяСтрока.ВидСекции, НоваяСтрока.типцвета1, НоваяСтрока.типкраски, НоваяСтрока.название,Строка.ФормаНомерЛинкс);
				НоваяСтрока.форма = НоваяФорма;
				//Необходимо записать значение в табличную часть "Формы"
				стрФ = Объект.Формы.Добавить();
				стрФ.Ключстроки = НоваяСтрока.ключстроки;
				стрФ.Значение = НоваяФорма;  
			КонецЕсли;        		
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НоваяСтрока.Форма) Тогда
			ОбновитьОтображениеФорм = Истина;	
		КонецЕсли;
	КонецЦикла;
	
	Если ОбновитьОтображениеФорм Тогда
		ДобавитьУсловноеОформлениеЦветаВалФорма();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНомераПовторовНаСервере()
	
	НомераЗаказов = "";
	УстановитьПривилегированныйРежим(Истина);
	Для каждого Стр Из Объект.Товары Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказКлиентаТовары.Ссылка.НомерБезПрефикса КАК НомерБезПрефикса
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Номенклатура = &Номенклатура
		|	И ЗаказКлиентаТовары.Ссылка.ДатаОтправкиВРаботу <> ДАТАВРЕМЯ(1, 1, 1)
		|	И НЕ ЗаказКлиентаТовары.Ссылка.ПометкаУдаления
		|	И ЗаказКлиентаТовары.Ссылка <> &Ссылка
		|	И ЗаказКлиентаТовары.Ссылка.Состояние <> ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаказов.Аннулирован)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказКлиентаТовары.Ссылка.Дата УБЫВ";
		
		Запрос.УстановитьПараметр("Номенклатура", Стр.Номенклатура);
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если Найти(НомераЗаказов,Выборка.НомерБезПрефикса) = 0 Тогда
				НомераЗаказов = ?(ЗначениеЗаполнено(НомераЗаказов),НомераЗаказов + ", " + Выборка.НомерБезПрефикса,Выборка.НомерБезПрефикса); 
			КонецЕсли;
		КонецЦикла; 
	КонецЦикла;
	
	Объект.Комментарий = ?(ЗначениеЗаполнено(Объект.Комментарий),Объект.Комментарий + Символы.ПС + НомераЗаказов,НомераЗаказов); 
	Модифицированность = Истина;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

