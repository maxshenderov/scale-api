&НаСервере
Функция ПроверкаПараметровВурыбкиСовпадает(ВырубнойШтамп, ВидВырубки)
	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	Лико_ПараметрыШтампа.ЭтикетокНаЛисте КАК ЭтикетокНаЛисте,
	|	Лико_ПараметрыШтампа.ШагПечати КАК ШагПечати,
	|	Лико_ПараметрыШтампа.Ручьи КАК Ручьи,
	|	Лико_ПараметрыШтампа.Z КАК Z
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|ГДЕ
	|	Лико_ПараметрыШтампа.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", ВырубнойШтамп);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ВидВырубки = 1 ИЛИ ВидВырубки = 7 ИЛИ ВидВырубки = 13 Тогда
			Если Объект.Z <> Выборка.Z Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли НЕ (ВидВырубки = 1 ИЛИ ВидВырубки = 5 ИЛИ ВидВырубки = 6 ИЛИ ВидВырубки = 7 ИЛИ ВидВырубки = 13) Тогда
			Если Объект.ШагПечати <> Выборка.ШагПечати Тогда
				Если (ВидВырубки = 3 ИЛИ ВидВырубки = 8 ИЛИ ВидВырубки = 11 ИЛИ ВидВырубки = 12) И Объект.Ручьи = Объект.ЭтикетокНаЛисте Тогда 

				Иначе
					Возврат Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Объект.Ручьи <> Выборка.Ручьи Тогда 
			Возврат Ложь;
		КонецЕсли;
		Если НЕ(ВидВырубки = 4 ИЛИ ВидВырубки = 6 ИЛИ ВидВырубки = 10) Тогда
			текРазница = Объект.ЭтМЭР - Лико_ТиражМетраж.ПолучитьМежэтикеточноеРасстояние(Объект, ВидВырубки);
			Если Макс(текРазница, -текРазница) > 0.0001 Тогда
				Если (ВидВырубки = 3 ИЛИ ВидВырубки = 8 ИЛИ ВидВырубки = 11 ИЛИ ВидВырубки = 12) И Объект.Ручьи = Объект.ЭтикетокНаЛисте Тогда 

				Иначе
					Возврат Ложь;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;

КонецФункции

