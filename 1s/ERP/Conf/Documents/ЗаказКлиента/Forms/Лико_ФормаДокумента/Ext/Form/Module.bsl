&НаКлиенте
Процедура ЦветаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.Цвета.ТекущиеДанные;	
	Если НоваяСтрока Тогда
		КлючСтроки = Новый УникальныйИдентификатор;
		ТекущиеДанные.КлючСтроки = КлючСтроки;
		ТекущиеДанные.НомерВарианта = 1; 
		Если Не ЗначениеЗаполнено(ТекущиеДанные.номерпроката) Тогда 
			ТекущиеДанные.номерпроката =1;
		КонецЕсли; 
		Если Не ЗначениеЗаполнено(ТекущиеДанные.НомерРаботы) Тогда 
			ТекущиеДанные.НомерРаботы = 1;
		КонецЕсли;
		Если Копирование И ТекущиеДанные.ВидСекции <> ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Цифровая") Тогда
			ТекущиеДанные.Форма = Неопределено;
			//Если ТипЗнч(ТекущиеДанные.ВалФорма) = Тип("СправочникСсылка.Лико_Формы") Тогда
			//	ТекущиеДанные.ВалФорма = Неопределено;
			//КонецЕсли;
		КонецЕсли;
		Если Копирование Тогда
			ДобавитьУсловноеОформлениеЦветаВалФорма();
			ДобавитьУсловноеОформлениеЦветаВидОснастка();
			ДобавитьУсловноеОформлениеЦветаРабочийЦентр();
		КонецЕсли;
		Если Объект.Цвета.Количество() >= 10 Тогда
			Элементы.Цвета.ВариантУправленияВысотой = ВариантУправленияВысотойТаблицы.ПоСодержимому;
		Иначе
			Элементы.Цвета.ВариантУправленияВысотой = ВариантУправленияВысотойТаблицы.Авто;
		КонецЕсли;
	КонецЕсли;	

КонецПроцедуры

