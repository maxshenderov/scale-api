&НаСервере
Функция ЗаполнитьПараметрыПоИсходномуЗаказу()  // --> Начало Лико Митюшин МФМ 13.09.2021
	
	текБылиИзменения = Ложь;
	ИсходныйЗаказ = Объект.ИсходныйЗаказ;
	
	Если НЕ ЗначениеЗаполнено(Объект.РучьиПечати) Тогда 
		Объект.РучьиПечати 				= ?(ЗначениеЗаполнено(ИсходныйЗаказ.РучьиПечати), ИсходныйЗаказ.РучьиПечати, 
		?(ЗначениеЗаполнено(ИсходныйЗаказ.Ручьи), ИсходныйЗаказ.Ручьи, ИсходныйЗаказ.РучьиПечатиИндиго)); 
		текБылиИзменения = Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.ДлинаПечати) Тогда 
		Объект.ДлинаПечати 				= ?(ЗначениеЗаполнено(ИсходныйЗаказ.ДлинаПечати), ИсходныйЗаказ.ДлинаПечати, 
		?(ЗначениеЗаполнено(ИсходныйЗаказ.ШагПечати), ИсходныйЗаказ.ШагПечати, ИсходныйЗаказ.ДлинаПечатиИндиго));
		текБылиИзменения = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ЭтикетокНаЛистеПечати) Тогда 
		Объект.ЭтикетокНаЛистеПечати 	= ?(ЗначениеЗаполнено(ИсходныйЗаказ.ЭтикетокНаЛистеПечати), ИсходныйЗаказ.ЭтикетокНаЛистеПечати, 
		?(ЗначениеЗаполнено(ИсходныйЗаказ.ЭтикетокНаЛисте), ИсходныйЗаказ.ЭтикетокНаЛисте, ИсходныйЗаказ.ЭтикетокНаЛистеИндиго)); 
		текБылиИзменения = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ЭтМЭР) Тогда
		Объект.ЭтМЭР = ПолучитьЭтМЭРНаСервере();
	КонецЕсли;	
	Возврат текБылиИзменения;
КонецФункции		// <-- Конец Лико Митюшин МФМ 13.09.2021

