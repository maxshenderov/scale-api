&НаСервереБезКонтекста
Функция ПолучитьЦенуШтампа(Штамп, РабочийЦентр, ВидСекции) // --> Начало Лико Субботин 01.02.23	
	
	Цена = 0;
	
	Выборка = РегистрыСведений.Лико_ПараметрыШтампа.Выбрать(Новый Структура("Номенклатура", Штамп));
	
	Пока Выборка.Следующий() Цикл
		Цена = Выборка.Цена
	КонецЦикла;  
	
	Если Цена = 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыРабочихЦентровЛико_СтоимостьОснастки.Стоимость КАК Стоимость
		|ИЗ
		|	Справочник.ВидыРабочихЦентров.Лико_СтоимостьОснастки КАК ВидыРабочихЦентровЛико_СтоимостьОснастки
		|ГДЕ
		|	ВидыРабочихЦентровЛико_СтоимостьОснастки.ВидСекции = &ВидСекции
		|	И ВидыРабочихЦентровЛико_СтоимостьОснастки.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("ВидСекции", ВидСекции);
		Запрос.УстановитьПараметр("Ссылка", РабочийЦентр.ВидРабочегоЦентра);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Цена = Выборка.Стоимость;	
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Цена
	
КонецФункции // <-- Конец Лико Субботин 01.02.23	

&НаКлиенте
Процедура ПослеОтветаНаВопросОНарезке(РезультатВопроса, ДополнительныеПараметры) Экспорт // --> Начало Лико Яцун 22.12.2022
    
	Результат = РезультатВопроса;
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.Нарезка = ПолучитьНарезку(ДополнительныеПараметры.РасчетнаяНарезка);
		ЭтаФорма.Модифицированность = Истина;
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Тема = "В заказе " + Объект.НомерБезПрефикса + " менеджера " + Объект.Менеджер + " указана нарезка " + Объект.Нарезка + ". Расчетная нарезка " + ДополнительныеПараметры.РасчетнаяНарезка + ".";
		ТекстПисьма = "В заказе " + Объект.НомерБезПрефикса + " менеджера " + Объект.Менеджер + " указана нарезка " + Объект.Нарезка + ". Расчетная нарезка " + ДополнительныеПараметры.РасчетнаяНарезка + "." + Символы.ПС + ДополнительныеПараметры.ТекстПараметры;
		Если ДополнительныеПараметры.ВидРЦ = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.Gallus")
			ИЛИ ДополнительныеПараметры.ВидРЦ = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.GallusGranitic") Тогда
			Кому = "IMachula@okil-sato.ru;OlegPak@okil.ru";
		ИначеЕсли ДополнительныеПараметры.ВидРЦ = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.GallusInkjet") Тогда
			Кому = "AChirva@okil-sato.ru;OlegPak@okil.ru";
		ИначеЕсли ДополнительныеПараметры.ВидРЦ = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.MPS") Тогда
			Кому = "MBaranov@okil-sato.ru;OlegPak@okil.ru";
		ИначеЕсли ДополнительныеПараметры.ВидРЦ = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.MPSOfset") Тогда
			Кому = "inabatov@okil-sato.ru;OlegPak@okil.ru";
		ИначеЕсли ДополнительныеПараметры.ВидРЦ = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.Drent") 
			ИЛИ ДополнительныеПараметры.ВидРЦ = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.MO3300") Тогда
			Кому = "gkan@okil-sato.ru;inabatov@okil-sato.ru";
		КонецЕсли;
		ОтправитьПисьмо(ТекстПисьма, Тема, Кому);
	ИначеЕсли Результат = КодВозвратаДиалога.Отмена Тогда
		Сообщить("Указанная нарезка меньше, чем расчетная " + ДополнительныеПараметры.РасчетнаяНарезка + ". Заменить нарезку на расчетную?");
		Возврат;
	КонецЕсли;
	
	Если Объект.Площадка = ГлЛико_Площадки.Ликофлекс 
		И Объект.ТипЗаказа <> ПредопределенноеЗначение("Перечисление.Лико_ТипыЗаказов.Полуфабрикат")
		И Объект.ТипЗаказа <> ПредопределенноеЗначение("Перечисление.Лико_ТипыЗаказов.Термоусадка") 
		И ПолучитьРазмерНарезки() - ДополнительныеПараметры.РасчетнаяНарезка >= ДополнительныеПараметры.ШагПоНарезке
		И ДополнительныеПараметры.Ручьи <> Объект.Ручьи Тогда
		Если ДлинаКонтрКолье(ДополнительныеПараметры.Штамп).ДлинаКонтрЭтикетки <> 0 ИЛИ ДлинаКонтрКолье(ДополнительныеПараметры.Штамп).ДлинаКольеретки <> 0 Тогда
			ЗначениеДлинаКонтрКолье = ?(ДлинаКонтрКолье(ДополнительныеПараметры.Штамп).ДлинаКонтрЭтикетки = 0, ДлинаКонтрКолье(ДополнительныеПараметры.Штамп).ДлинаКольеретки, ДлинаКонтрКолье(ДополнительныеПараметры.Штамп).ДлинаКонтрЭтикетки);
			Если Объект.ДлинаЭтикетки = ЗначениеДлинаКонтрКолье Тогда
				ПоказатьВопрос(
				Новый ОписаниеОповещения("ПослеОтветаНаВопросОНарезкеИРучьяхПечати", ЭтотОбъект,Новый Структура("РасчетнаяНарезка,Ручьи,ШагПоНарезке,ВидРЦ",ДополнительныеПараметры.РасчетнаяНарезка,ДополнительныеПараметры.Ручьи,ДополнительныеПараметры.ШагПоНарезке,ВидРЦ)), 
				"Некорректно указана нарезка или количество ручьев печати. Заменить нарезку на расчетную " + ДополнительныеПараметры.РасчетнаяНарезка + " мм?",
				РежимДиалогаВопрос.ДаНетОтмена);
				//Сообщить("Не корректно указана нарезка или количество ручьев печати");	
				Возврат;
			КонецЕсли;
		Иначе
			ПоказатьВопрос(
			Новый ОписаниеОповещения("ПослеОтветаНаВопросОНарезкеИРучьяхПечати", ЭтотОбъект,Новый Структура("РасчетнаяНарезка,Ручьи,ШагПоНарезке,ВидРЦ",ДополнительныеПараметры.РасчетнаяНарезка,ДополнительныеПараметры.Ручьи,ДополнительныеПараметры.ШагПоНарезке,ВидРЦ)), 
			"Некорректно указана нарезка или количество ручьев печати. Заменить нарезку на расчетную " + ДополнительныеПараметры.РасчетнаяНарезка + " мм?",
			РежимДиалогаВопрос.ДаНетОтмена);
			//Сообщить("Не корректно указана нарезка или количество ручьев печати");	
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ШтампВырубной) И Объект.Площадка = ГлЛико_Площадки.Ликофлекс Тогда 
		ШтампМатериал = ВРег(Сред(ЗначениеРеквизита(Объект.ШтампВырубной,"Артикул"),8,1));
		Если ТипЗнч(Объект.ОсновнойМатериал) = Тип("СправочникСсылка.Номенклатура") Тогда
			ЦГОсновногоМатериала = ЗначениеРеквизита(Объект.ОсновнойМатериал,"ЦеноваяГруппа");
		Иначе
			ЦГОсновногоМатериала = Объект.ОсновнойМатериал;
		КонецЕсли;
		Если ЗначениеЗаполнено(ЦГОсновногоМатериала) Тогда
			Если ШтампМатериал = "П" И НЕ ЭлементПринадлежитИерархии(ЦГОсновногоМатериала,ПредопределенноеЗначение("Справочник.ЦеновыеГруппы.Пленки")) И Найти(ВРег(Объект.ОсновнойМатериал),"BUMELEN") = 0 Тогда 
				ПоказатьВопрос(
				Новый ОписаниеОповещения("ПослеОтветаНаВопросОШтампеМатериале", ЭтотОбъект), 
				"Указан штамп с буквой " + ШтампМатериал + ", не соответствующий материалу " + Объект.ОсновнойМатериал + ", отменить утверждение?",
				РежимДиалогаВопрос.ДаНет);
				Возврат;
			ИначеЕсли ШтампМатериал = "Б" И НЕ ЭлементПринадлежитИерархии(ЦГОсновногоМатериала,ПредопределенноеЗначение("Справочник.ЦеновыеГруппы.Бумага")) Тогда
				ПоказатьВопрос(
				Новый ОписаниеОповещения("ПослеОтветаНаВопросОШтампеМатериале", ЭтотОбъект), 
				"Указан штамп с буквой " + ШтампМатериал + ", не соответствующий материалу " + Объект.ОсновнойМатериал + ", отменить утверждение?",
				РежимДиалогаВопрос.ДаНет);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если (Объект.Ручьи > 0 И Объект.РучьиПечати > 0 И Объект.Ручьи <> Объект.РучьиПечати) ИЛИ (Объект.Ручьи > 0 И Объект.РучьиПечатиИндиго > 0 И Объект.Ручьи <> Объект.РучьиПечатиИндиго) Тогда
		ПоказатьВопрос(
		Новый ОписаниеОповещения("ПослеОтветаНаВопросКоличествоРучьевПечатиМеньшеЧемВШтампе", ЭтотОбъект), 
		"Количество ручьев печати меньше, чем в штампе. Утвердить цвета?",
		РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	Объект.УтвердилЦвета = ПользователиКлиентСервер.ТекущийПользователь(); 
	Объект.ДатаУтвержденияЦветов = ТекущаяДата();
	ИзменитьПриСменеВидаВырубки();
	УтверждениеЦветов();
	
	Объект.ДатаУтвержденияЗаказа = '0001.01.01'; 
	Объект.УтвердилЗаказ = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
	
КонецПроцедуры // <-- Конец Лико Яцун 22.12.2022

