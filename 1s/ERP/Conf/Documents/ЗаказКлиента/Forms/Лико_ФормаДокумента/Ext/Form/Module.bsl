&НаСервереБезКонтекста
Функция ПолучитьЗаказНаОснастку(Заказ)  
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ЗаказОснасткиОснастка.Ссылка КАК Ссылка,
		|	Лико_ЗаказОснасткиОснастка.Ссылка.Номер КАК Номер
		|ИЗ
		|	Документ.Лико_ЗаказОснастки.Оснастка КАК Лико_ЗаказОснасткиОснастка
		|ГДЕ
		|	Лико_ЗаказОснасткиОснастка.Заказ = &Заказ
		|	И Лико_ЗаказОснасткиОснастка.ВнутреннийЗаказ = ИСТИНА
		|	И Не Лико_ЗаказОснасткиОснастка.Ссылка.ПометкаУдаления 
		|	И Лико_ЗаказОснасткиОснастка.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда		
		возврат РезультатЗапроса.Номер 	
	Иначе 
		возврат Неопределено
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияОбработкиПричиныЗаменыЗаказов(Результат, ДопПараметры)  Экспорт
	
	Если Результат = "ОтменаОтправки" или Результат =  неопределено Тогда
        Возврат;
	Иначе
		НомерВерсии = 0;
		для каждого стр из Объект.ПричиныЗамены цикл
			НомерВерсии = Макс(НомерВерсии, стр.НомерВерсии); 
		конеццикла; 
		
		НомерВерсии = НомерВерсии + 1;
		
		Для каждого стр из Результат Цикл
			НовСтр = Объект.ПричиныЗамены.Добавить();
			НовСтр.Дата = ТекущаяДата();
			НовСтр.Автор = ПользователиКлиентСервер.ТекущийПользователь();  
			НовСтр.НомерВерсии = НомерВерсии;  
			Если стр.Ключ = "Другое" Тогда
				НовСтр.ПричинаЗамены = ПредопределенноеЗначение("Справочник.Лико_ПричиныЗамены.другое") ;
				Новстр.Комментарий = стр.Значение;
			Иначе
				НовСтр.ПричинаЗамены = стр.Значение;
			КонецЕсли;
		КонецЦикла;
		
		Отказ = Ложь;
		Пересчитать_ПереотправитьЗаказВРаботу(Отказ,,, Результат);
		
		Если Не Отказ Тогда 
			ЭтаФорма.Закрыть();
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция ПроверитьНаОдинаковыеGTin() //--> o.pukhova 14052021	
	ТекущийGTin = "";
	Для Каждого стр Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(стр.GTin) Тогда
			Если ТекущийGTin = "" Тогда
				ТекущийGTin = стр.GTin;
				Продолжить;
			КонецЕсли;	
			Если ТекущийGTin <> стр.GTin Тогда
				Возврат Ложь
			Иначе
				ТекущийGTin = стр.GTin;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
КонецФункции  //<-- o.pukhova 14052021

