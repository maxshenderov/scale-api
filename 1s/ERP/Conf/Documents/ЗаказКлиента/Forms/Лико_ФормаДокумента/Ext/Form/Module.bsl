Функция ПолучитьКоэффициентПеремотки()  
	Коэффициент = 1;
	Если ЗначениеЗаполнено(Объект.Ручьи) Тогда 
		Если Объект.Ручьи >2 И Объект.Ручьи<6 Тогда 
			Коэффициент = Коэффициент+0.2;
		ИначеЕсли Объект.ручьи >5 Тогда 
			Коэффициент = Коэффициент+0.5;
		КонецЕсли;
		
		Если Объект.ТОвары.Количество()>0 Тогда 
			Если Объект.Товары[0].МаксимальныйДиаметрРулона<100 Тогда 
				Коэффициент = Коэффициент+0.5;
			КонецЕсли;
		КонецЕсли;
			Если Объект.СпособНаклейки = Перечисления.Лико_СпособыНаклейки.Этикеровщик Тогда 
				Коэффициент = Коэффициент+0.5;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.ОсновнойМатериалФакт) Тогда 
				ЦГ = Объект.ОсновнойМатериалФакт;
			Иначе	
				Если ТипЗнч(Объект.ОсновнойМатериал) = Тип("СправочникСсылка.Номенклатура") Тогда
					ЦГ =  Объект.ОсновнойМатериал.ЦеноваяГруппа;
				Иначе
					ЦГ = Объект.ОсновнойМатериал;
				КонецЕсли;
			КонецЕсли;	
			Если ЗначениеЗаполнено(ЦГ) Тогда
				КодЦГ = СокрЛП(ЦГ.Код);
				Если Прав(КодЦГ,2)="30" ИЛИ Прав(КодЦГ,2)="70" ИЛИ Прав(КодЦГ,2)="71" Тогда
					Коэффициент = 3;
				КонецЕсли;
			КонецЕсли;
	
	КонецЕсли;	
	

	
	Если Объект.Площадка = Справочники.Лико_Площадки.Сибирь Тогда 
		ДлинаГотовогоРоликаПМ = ПОлучитьДлинуГотовогоРОлика();
		Если ЗначениеЗаполнено(ДлинаГотовогоРоликаПМ) Тогда 
			Если ДлинаГотовогоРоликаПМ<20 Тогда 
				Коэффициент = Коэффициент+7;
			ИначеЕсли ДлинаГотовогоРоликаПМ<40 Тогда 
				Коэффициент = Коэффициент+4;
			ИначеЕсли ДлинаГотовогоРоликаПМ<80 Тогда 
				Коэффициент = Коэффициент+2;
			ИначеЕсли ДлинаГотовогоРоликаПМ<120 Тогда 
				Коэффициент = Коэффициент+1;
			ИначеЕсли ДлинаГотовогоРоликаПМ<160 Тогда 
				Коэффициент = Коэффициент+0.5;
			КонецЕсли;
		КонецЕсли;
			
	//	Если весь тираж по заказу пог. м.:
	    МетражПМЧистый = Объект.МетражПМ;
		Если МетражПМЧистый<100 Тогда 
	//меньше 100
			Коэффициент = Коэффициент+7;
		ИначеЕсли МетражПМЧистый<200 Тогда 
			Коэффициент = Коэффициент+4;
		ИначеЕсли МетражПМЧистый<300 Тогда 
			Коэффициент = Коэффициент+2;
		ИначеЕсли МетражПМЧистый<500 Тогда 
			Коэффициент = Коэффициент+1;
		ИначеЕсли МетражПМЧистый<800 Тогда 
			Коэффициент = Коэффициент+0.5;
		КонецЕсли;
		
		Если Объект.ЧестныйЗнак Тогда
			Коэффициент = Коэффициент+1;
		КонецЕсли;
		// <-- Начало Лико Яцун С. В. 03.09.2025 
		Если Объект.ЧестныйЗнак Тогда
			Коэффициент = Коэффициент * 2 
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 03.09.2025 
		
	КонецЕсли;
	
	Возврат коэффициент;



	
КонецФункции

Функция ПОлучитьДлинуГотовогоРОлика()
	ДлинаГотовогоРоликаПМ=0;
	Если Объект.Товары.Количество() > 0 Тогда 
		стрТОвары = Объект.ТОвары[0];
		Ручьи = Объект.Ручьи;

		МаксимальныйДиаметр = стрТОвары.МаксимальныйДиаметрРулона;
		КоличествоЭтикетокВРолике = стрТовары.КоличествоЭтикетокВРолике +  стрТовары.ДопЭтикетокВРолике;
		Если ЗначениеЗаполнено(МаксимальныйДиаметр) И ЗначениеЗаполнено(стрТовары.ВнутреннийДиаметр) Тогда 
			ВнутреннийДиаметр = стрТовары.ВнутреннийДиаметр.Размер;				
			ДлинаГотовогоРоликаПМ= (Pow(МаксимальныйДиаметр/2,2)-Pow((ВнутреннийДиаметр+6)/2,2))*3.14/125   ;
		КонецЕсли;

		РЦЦифры = Справочники.РабочиеЦентры.ПустаяСсылка();
		Для каждого стр из Объект.Цвета Цикл
			Если стр.рабочийЦентр.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Indigo Тогда 
				РЦЦифры = стр.РабочийЦентр;
			КонецЕсли;
		КонецЦикла;
		Если Не ЗначениеЗаполнено(РЦЦифры) ТОгда 
			Если Не ЗначениеЗаполнено(ДлинаГотовогоРоликаПМ) И значениеЗаполнено(Объект.ЭтикетокНаЛисте)  Тогда 
				ДлинаГотовогоРоликаПМ = КоличествоЭтикетокВРолике *Объект.Z.КоличествоЗубьев * 3.175 * ручьи / (Объект.ЭтикетокНаЛисте*1000);
			КонецЕсли;
		Иначе 
			Если ЗначениеЗаполнено(Объект.ЭтикетокНаЛисте) И ЗначениеЗаполнено(Ручьи) ТОгда  
				ДлинаПечати = 0;
				КоличествоЭтикетокВРаппорте = 0;
				ДлинаЭтикеткиСПрипуском = Объект.ШагПечати / (Объект.ЭтикетокНаЛисте / Ручьи);
				Если  РЦЦифры.Раппорт= 0.45 Тогда
					ДлинаПечати = Окр(Цел(0.45/ДлинаЭтикеткиСПрипуском)*ДлинаЭтикеткиСПрипуском,3);
					КоличествоЭтикетокВРаппорте = Цел(0.45/ДлинаЭтикеткиСПрипуском)* Ручьи;
				ИначеЕсли  РЦЦифры.Раппорт= 0.98   Тогда
					ДлинаПечати = Окр(Цел(0.98/ДлинаЭтикеткиСПрипуском)*ДлинаЭтикеткиСПрипуском,3);
					КоличествоЭтикетокВРаппорте = Цел(0.98/ДлинаЭтикеткиСПрипуском)* Ручьи;
				КонецЕсли;

				Если Не ЗначениеЗаполнено(ДлинаГотовогоРоликаПМ) Тогда 
					ДлинаГотовогоРоликаПМ = (КоличествоЭтикетокВРолике *ДлинаПечати * Ручьи) /КоличествоЭтикетокВРаппорте;
				КонецЕсли;	
			КонецЕсли;	

			
		КонецЕсли;	

		Возврат ДлинаГотовогоРоликаПМ;
	КонецЕсли;				
КонецФункции

&НаСервере 
Процедура ЗаполнитьСвязанныеДанныеНаСервере()

	Лико_Планирование.ЗаполнитьСвязанныеДанные(Объект.Ссылка);
	Для каждого стр из Объект.Цвета Цикл
		Если ЗначениеЗаполнено(стр.Материал) Тогда 
			стр.кодматериала = стр.материал.Код;
		КонецЕсли;
		//Если ЗначениеЗаполнено(стр.Клей) Тогда 
		//	стр.кодКлея = стр.клей.Код;
		//КонецЕсли;	
	КонецЦикла; 
	
	ЗаполнитьТипЗаливка(); 
	ЗаполнитьВидОснастка();
	//ЗаполнитьВалФорма();
	
	ОтображатьОбъемДляКлиента = УправлениеСвойствами.ЗначениеСвойства(Объект.Партнер,"Стикер_ОтображатьОбъем");
	Для каждого стр из Объект.Товары Цикл
		Если ЗначениеЗаполнено(стр.цена) И ЗначениеЗаполнено(стр.ставкаНДС) Тогда 
			ТекПроцентНДС = стр.СтавкаНДС.Ставка;
			стр.ЦенаБезНДС = стр.цена/(1+ТекПроцентНДС/100);
		КонецЕсли;	
	
		Если ЗначениеЗаполнено(ОтображатьОбъемДляКлиента) Тогда
			Если ОтображатьОбъемДляКлиента Тогда
				стр.Объем = УправлениеСвойствами.ЗначениеСвойства(стр.Номенклатура,"Стикер_Объем");
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(стр.Номенклатура) Тогда
			стр.Артикул = ПолучитьАртикулИзСправочникаВерсииНоменклатуры(стр.Номенклатура,стр.ВерсияНоменклатуры);
			стр.НаименованиеДляДокументов = стр.Номенклатура.НаименованиеПолное;
		КонецЕсли;
		
		// --> Начало Лико Ефимов ЕВВ 13.05.2021
		Если ЗначениеЗаполнено(Стр.ЧестныйЗнак) Тогда
			ЗаполнитьЗначенияСвойств(Стр, Стр.ЧестныйЗнак, "Gtin,ДатаЭмиссии");
		КонецЕсли;
		// <-- Конец Лико Ефимов ЕВВ 13.05.2021
		
		//+ Лико m.shenderov 25.07.2021
		   Если ЗначениеЗаполнено(стр.Номенклатура) Тогда
