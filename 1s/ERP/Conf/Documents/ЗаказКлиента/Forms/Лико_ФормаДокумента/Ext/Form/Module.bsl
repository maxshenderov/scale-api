&НаСервере
Процедура ПересчитатьОтгрузкиНаСервере()
УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_Отгрузки2Обороты.Регистратор КАК Регистратор,
	|	МИНИМУМ(Лико_Отгрузки2Обороты.Период) КАК Период,
	|	ВЫБОР
	|		КОГДА Лико_Отгрузки2Обороты.Регистратор ССЫЛКА Документ.ВнутреннееПотреблениеТоваров
	|			ТОГДА 2
	|		КОГДА Лико_Отгрузки2Обороты.Регистратор ССЫЛКА Документ.АктВыполненныхРабот
	|			ТОГДА 4
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ТипРегистратора
	|ИЗ
	|	РегистрНакопления.Лико_Отгрузки2.Обороты(, , Регистратор, Заказ = &Заказ) КАК Лико_Отгрузки2Обороты
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_Отгрузки2Обороты.Регистратор,
	|	ВЫБОР
	|		КОГДА Лико_Отгрузки2Обороты.Регистратор ССЫЛКА Документ.ВнутреннееПотреблениеТоваров
	|			ТОГДА 2
	|		КОГДА Лико_Отгрузки2Обороты.Регистратор ССЫЛКА Документ.АктВыполненныхРабот
	|			ТОГДА 4
	|		ИНАЧЕ 1
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Запрос.УстановитьПараметр("Заказ", Объект.ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	НачатьТранзакцию();
	Пока Выборка.Следующий() Цикл
		НаборЗаписейЗатратыПоЗаказу = РегистрыНакопления.Лико_ЗатратыПоЗаказуДляОтгрузки.СоздатьНаборЗаписей();
    	НаборЗаписейЗатратыПоЗаказу.Отбор.Регистратор.Установить(Выборка.Регистратор);
    	НаборЗаписейЗатратыПоЗаказу.Записать();
		
		НаборЗаписейОтгрузки = РегистрыНакопления.Лико_Отгрузки2.СоздатьНаборЗаписей();
	    НаборЗаписейОтгрузки.Отбор.Регистратор.Установить(Выборка.Регистратор);
	    НаборЗаписейОтгрузки.Записать();
	    
	    НаборЗаписейНормативы = РегистрыСведений.Лико_НормативыОтгрузки.СоздатьНаборЗаписей();
	    НаборЗаписейНормативы.Отбор.Регистратор.Установить(Выборка.Регистратор);
	    НаборЗаписейНормативы.Записать();


	КонецЦикла;
	Выборка.Сбросить();		
	Пока Выборка.Следующий() Цикл
		Отказ = Ложь;
		Если Выборка.ТипРегистратора = 1 Тогда
			Лико_Планирование.ЗаполнениеПараметровОтгрузки(Выборка.Регистратор.ПолучитьОбъект(), Отказ);
		иначеЕсли Выборка.ТипРегистратора = 2 Тогда
			Лико_Планирование.ЗаполнениеПараметровСписания(Выборка.Регистратор.ПолучитьОбъект(), Отказ);
		ИначеЕсли Выборка.ТипРегистратора = 4 Тогда
			Лико_Планирование.ЗаполнениеПродажпоАктамРабот(Выборка.Регистратор.ПолучитьОбъект(), Отказ);
		КонецЕсли;
		
		Если Отказ Тогда 
			ОтменитьТранзакцию();
		КонецЕсли;
	КонецЦикла;
	ЗафиксироватьТранзакцию();

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

