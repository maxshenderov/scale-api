&НаСервере
Функция ПроверитьЗаполнениеРабот()	
	//направляем письмо, если не заполнены параметры штампа тиснения
	ПроверитьЗаполнениеПараметровШтампа();
	Цвета = Объект.Цвета.Выгрузить();
		
	ТекстОшибки = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Работы.НомерСтроки КАК НомерСтроки,
	|	Работы.ВидСекции КАК ВидРабот,
	|	Работы.Оснастка КАК Оснастка,
	|	Работы.Материал КАК Материал,
	|	Работы.РабочийЦентр КАК РабочийЦентр,
	|	Работы.Нарезка КАК Нарезка,
	|	Работы.КоличествоРучьевНумератора КАК КоличествоРучьевНумератора,
	|	Работы.ЗаказНовойОснастки КАК ЗаказНовойОснастки
	|ПОМЕСТИТЬ ВТРаботы
	|ИЗ
	|	&Работы КАК Работы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРаботы.НомерСтроки КАК НомерСтроки,
	|	ВТРаботы.ВидРабот КАК ВидРабот,
	|	ВЫБОР
	|		КОГДА ВТРаботы.ВидРабот ЕСТЬ NULL
	|			ТОГДА ""указан не корректный вид работ, ""
	|		КОГДА ВТРаботы.ВидРабот.Оснастка = ИСТИНА
	|				И ВТРаботы.Оснастка = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ""не указана оснастка, ""
	|		КОГДА ВТРаботы.ВидРабот.Материал = ИСТИНА
	|				И (ВТРаботы.Материал = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|					ИЛИ ВТРаботы.Материал = ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
	|					ИЛИ ВТРаботы.Материал = НЕОПРЕДЕЛЕНО)
	|			ТОГДА ""не указан материал, ""
	|		КОГДА ВТРаботы.ВидРабот.Материал = ИСТИНА
	|				И ВТРаботы.Нарезка = ЗНАЧЕНИЕ(Справочник.ЯССМ_Нарезки.ПустаяСсылка)
	|			ТОГДА ""не указана нарека, ""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ОписаниеОшибки,
	|	ВТРаботы.Оснастка КАК Оснастка,
	|	ВТРаботы.РабочийЦентр В
	|		(ВЫБРАТЬ
	|			РабочиеЦентры.Ссылка КАК Ссылка
	|		ИЗ
	|			Справочник.РабочиеЦентры КАК РабочиеЦентры
	|		ГДЕ
	|			РабочиеЦентры.ПорядковыйНомер = 2) КАК Поле1
	|ИЗ
	|	ВТРаботы КАК ВТРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|		ПО ВТРаботы.Оснастка = Лико_ПараметрыШтампа.Номенклатура";

		
	Запрос.УстановитьПараметр("Работы", Цвета);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ОписаниеОшибки) Тогда 
			ТекстОшибки = ТекстОшибки+	"В строке "+ Выборка.НомерСтроки+ " "+Выборка.ОписаниеОшибки;
		Иначе
			Если ЗначениеЗаполнено(Выборка.Оснастка) Тогда
				Если Выборка.Оснастка.Лико_НеИспользовать Тогда
					ТекстОшибки = ТекстОшибки + "В строке "+ Выборка.НомерСтроки+ " указана оснастка, которая не используется!"+ Выборка.Оснастка.НаименованиеПолное;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	Если ТекстОШибки <> "" Тогда 
		Возврат ТекстОшибки;
	Иначе 
		Возврат Истина;
		
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ПроверитьЗаполнениеПараметровШтампа() 
	
	Цвета = Объект.Цвета.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Работы.ВидСекции КАК ВидРабот,
	|	Работы.Оснастка КАК Оснастка,
	|	Работы.Подача КАК Подача,
	|	Работы.ЭтикетокВПодаче КАК ЭтикетокВПодаче
	|ПОМЕСТИТЬ ВТРаботы
	|ИЗ
	|	&Работы КАК Работы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРаботы.Оснастка КАК Оснастка,
	|	Лико_ПараметрыШтампа.ЭтикетокВПодаче КАК ЭтикетокВПодаче,
	|	Лико_ПараметрыШтампа.Подача КАК Подача
	|ИЗ
	|	ВТРаботы КАК ВТРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|		ПО ВТРаботы.Оснастка = Лико_ПараметрыШтампа.Номенклатура
	|ГДЕ
	|	ВТРаботы.ВидРабот = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ГорячееТиснениеПлоское)
	|	И ВТРаботы.Оснастка <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Работы", Цвета);
	Выборка = Запрос.Выполнить().Выбрать();
	Текст = "";
	Пока Выборка.Следующий() Цикл
		Если Не (ЗначениеЗаполнено(Выборка.Подача) И ЗначениеЗаполнено(Выборка.ЭтикетокВПодаче)) Тогда 
			Текст = Текст+ " "+Выборка.Оснастка.Артикул;
		КонецЕсли;		
	КонецЦикла;
	Если ЗначениеЗаполнено(Текст) Тогда 
		Текст= "Не заполнены параметры штампа тиснения (подача, этикеток в подаче) для штампов: "+Текст;
		Тема = Текст;
		Адресат = Справочники.Лико_ПредопределенныеЗначения.ПользовательОтветственныйЗаОснастку.ЗначениеПараметра;
		ОтправитьПисьмо(текст, Тема, Адресат) ;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыгрузкаВТабашНаСервере(Заказ, Ключстроки=  Неопределено , ПечатьПоПрокатам = Ложь, Регистратор= Неопределено,ИксПакНовая = Ложь)
	ВПФ = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("Обработка ""Выгрузка в табаш""");
	ВнешняяОбработкаОбъект = ДополнительныеОтчетыИОбработкиВызовСервера.ОбъектВнешнейОбработки(ВПФ);
	ВнешняяОбработкаОбъект.Заказ = Заказ;
	Если КлючСтроки = Неопределено Тогда 
		ВнешняяОбработкаОбъект.КлючСтроки = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Иначе   
		ВнешняяОбработкаОбъект.КлючСтроки = ключСтроки;
	КонецЕсли;       
	ВнешняяОбработкаОбъект.ПечатьПоПрокатам = ПечатьПоПрокатам;
	Если ПечатьПоПрокатам Тогда 
		ВнешняяОбработкаОбъект.СписокПрокатов = СписокПрокатов;
	КонецЕсли;
	Если Объект.Площадка = Справочники.Лико_Площадки.ИксПак Тогда 
