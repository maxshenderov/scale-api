Процедура ЗаполнитьКоличествоКоробокИРоликовИзДокументовОтгрузок() // --> Начало Лико Ефимов ЕВВ 28.06.2018
	
	Объект.КоличествоРоликов = 0;
	Объект.КоличествоКоробок = 0;
	МассивДокументов = Новый Массив;
	Для каждого Строка из Объект.Отгрузки Цикл
		Если ЗначениеЗаполнено(Строка.ДокументОтгрузки) И МассивДокументов.Найти(Строка.ДокументОтгрузки) = Неопределено Тогда
			МассивДокументов.Добавить(Строка.ДокументОтгрузки);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(РасходныйОрдерНаТоварыОтгружаемыеТовары.Серия.Лико_КоличествоРоликов) КАК КоличествоРоликов,
		|	СУММА(1) КАК КоличествоКоробок
		|ИЗ
		|	Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерНаТовары.ОтгружаемыеТовары КАК РасходныйОрдерНаТоварыОтгружаемыеТовары
		|		ПО РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка = РасходныйОрдерНаТоварыОтгружаемыеТовары.Ссылка
		|			И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Номенклатура = РасходныйОрдерНаТоварыОтгружаемыеТовары.Номенклатура
		|			И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Характеристика = РасходныйОрдерНаТоварыОтгружаемыеТовары.Характеристика
		|ГДЕ
		|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка.Проведен
		|	И НЕ РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка.ПометкаУдаления
		|	И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение В(&МассивДокументов)
		|	И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Характеристика.Лико_ЗаказНоменклатуры = &Заказ";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Объект.КоличествоРоликов = ВыборкаДетальныеЗаписи.КоличествоРоликов;
		Объект.КоличествоКоробок = ВыборкаДетальныеЗаписи.КоличествоКоробок;
	КонецЕсли;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 28.06.2018


&НаСервере
Функция ВыходноеИзделиеЗаказаНаСервере(Заказ)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда 
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		Возврат Результат.Номенклатура;
	Иначе 
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПроверитьНаПолуфабрикатНаСервере(Заказ, ОсновнойМатериал = Ложь)
	// --> Начало Лико Ефимов ЕВВ 15.09.2021
	// дописал ПолуфабрикатПодАппликатор
	
	Если Заказ.ТипЗаказа <> Перечисления.Лико_ТипыЗаказов.Полуфабрикат И Заказ.ТипЗаказа <> Перечисления.Лико_ТипыЗаказов.ПолуфабрикатПодАппликатор Тогда
		Сообщить("Вы можете указывать только заказ с типом """ + Перечисления.Лико_ТипыЗаказов.Полуфабрикат + """ или """ + Перечисления.Лико_ТипыЗаказов.ПолуфабрикатПодАппликатор);
		Возврат Ложь;
	ИначеЕсли Заказ.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.ПолуфабрикатПодАппликатор И Заказ.ВидПолуфабрикатаПодАппликтор <> ?(ОсновнойМатериал, Перечисления.Лико_ВидыПолуфабрикатаПодАппликтор.Нижний, Перечисления.Лико_ВидыПолуфабрикатаПодАппликтор.Верхний) Тогда
		Сообщить("Вы можете указывать только заказ с " + ?(ОсновнойМатериал, "нижним", "верхним") + " видом полуфабриката под аппликатор");
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ЗаказОсновногоМатериалаПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.ЗаказОсновногоМатериала) Тогда 
		Если НЕ ПроверитьНаПолуфабрикатНаСервере(Объект.ЗаказОсновногоМатериала, Истина) Тогда
			Объект.ЗаказОсновногоМатериала = Неопределено;
		КонецЕсли;
		
		Объект.ОсновнойМатериал = ВыходноеИзделиеЗаказаНаСервере(Объект.ЗаказОсновногоМатериала);		
	Иначе
		Объект.ОсновнойМатериал = ПустаяСсылка("Номенклатура");
	КонецЕсли;	
КонецПроцедуры

