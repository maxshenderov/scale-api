&НаСервере
Функция ОтличаетсяGtinИКодЭтикеткиЗаказчикаВНоменклатуре()
	
	Лико_GtinВНоменклатуре = Объект.Партнер.Лико_GtinВНоменклатуре;
	Лико_КодЭтЗаказчикаВНоменклатуре = Объект.Партнер.Лико_КодЭтЗаказчикаВНоменклатуре;
	ЕстьОтличия = Ложь;
    НеЗаполненоВНоменклатуре = "";
	НеЗаполненоВНоменклатуреGtin = ""; 
	НеЗаполненоВНоменклатуреКодЭтикеткиЗаказчика = "";
	Если Лико_GtinВНоменклатуре ИЛИ Лико_КодЭтЗаказчикаВНоменклатуре Тогда
		Для каждого Стр Из Объект.Товары Цикл
			Если Лико_GtinВНоменклатуре И ЗначениеЗаполнено(СокрЛП(Стр.Gtin)) И СокрЛП(Стр.Gtin) <> СокрЛП(Стр.Номенклатура.Лико_Gtin) Тогда
				Если ЗначениеЗаполнено(СокрЛП(Стр.Номенклатура.Лико_Gtin)) Тогда
					Сообщить("Не совпадает ""Gtin"" в строке №" + Стр.НомерСтроки + " (" + СокрЛП(Стр.Gtin) + ")" + " и Номенклатуре (" + СокрЛП(Стр.Номенклатура.Лико_Gtin) + ")");	
					ЕстьОтличия = Истина; 
				Иначе
					НеЗаполненоВНоменклатуреGtin = ?(ЗначениеЗаполнено(НеЗаполненоВНоменклатуреGtin),НеЗаполненоВНоменклатуреGtin + ", " + Стр.НомерСтроки,Стр.НомерСтроки);	
				КонецЕсли;
			КонецЕсли;
			Если Лико_КодЭтЗаказчикаВНоменклатуре И ЗначениеЗаполнено(СокрЛП(Стр.КодЭтикеткиЗаказчика)) И СокрЛП(Стр.КодЭтикеткиЗаказчика) <> СокрЛП(Стр.Номенклатура.Лико_КодЭтикеткиЗаказчика) Тогда
				Если ЗначениеЗаполнено(СокрЛП(Стр.Номенклатура.Лико_КодЭтикеткиЗаказчика)) Тогда
					Сообщить("Не совпадает ""Код этикетки заказчика"" в строке №" + Стр.НомерСтроки + " (" + СокрЛП(Стр.КодЭтикеткиЗаказчика) + ")" + " и Номенклатуре (" + СокрЛП(Стр.Номенклатура.Лико_КодЭтикеткиЗаказчика) + ")");	
					ЕстьОтличия = Истина;
				Иначе
					НеЗаполненоВНоменклатуреКодЭтикеткиЗаказчика = ?(ЗначениеЗаполнено(НеЗаполненоВНоменклатуреКодЭтикеткиЗаказчика),НеЗаполненоВНоменклатуреКодЭтикеткиЗаказчика + ", " + Стр.НомерСтроки,Стр.НомерСтроки);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьОтличия Тогда
			Возврат Новый Структура("ЕстьОтличия,НеЗаполненоВНоменклатуре",ЕстьОтличия,НеЗаполненоВНоменклатуре);;	
		Иначе
			Если Лико_GtinВНоменклатуре И Лико_КодЭтЗаказчикаВНоменклатуре И ЗначениеЗаполнено(НеЗаполненоВНоменклатуреGtin) И ЗначениеЗаполнено(НеЗаполненоВНоменклатуреКодЭтикеткиЗаказчика) Тогда
				ТекстВопроса = "Записать ""Gtin"" и ""Код этикетки заказчика"" в Номенклатуры?";	
			ИначеЕсли Лико_GtinВНоменклатуре И ЗначениеЗаполнено(НеЗаполненоВНоменклатуреGtin) Тогда
				ТекстВопроса = "Записать ""Gtin"" в Номенклатуры?";	
			ИначеЕсли ЗначениеЗаполнено(НеЗаполненоВНоменклатуреКодЭтикеткиЗаказчика) Тогда
				ТекстВопроса = "Записать ""Код этикетки заказчика"" в Номенклатуры?";	
			КонецЕсли;
			Если ЗначениеЗаполнено(НеЗаполненоВНоменклатуреGtin) ИЛИ ЗначениеЗаполнено(НеЗаполненоВНоменклатуреКодЭтикеткиЗаказчика) Тогда
				НеЗаполненоВНоменклатуре = ?(ЗначениеЗаполнено(НеЗаполненоВНоменклатуреGtin),"Не заполнен ""Gtin"" в Номенклатуре" + Символы.ПС + "в строках: " + НеЗаполненоВНоменклатуреGtin,"") + Символы.ПС 
				+ ?(ЗначениеЗаполнено(НеЗаполненоВНоменклатуреКодЭтикеткиЗаказчика),"Не заполнен ""Код этикетки заказчика"" в Номенклатуре" + Символы.ПС + "в строках: " + НеЗаполненоВНоменклатуреКодЭтикеткиЗаказчика,"")
				+ Символы.ПС + Символы.ПС;
				ЧастиСтроки = Новый Массив;
				ЧастиСтроки.Добавить(НеЗаполненоВНоменклатуре);
				ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(ТекстВопроса,Новый Шрифт(,,Истина)));
				СтрокаРезультат = Новый ФорматированнаяСтрока(ЧастиСтроки);
				Возврат Новый Структура("ЕстьОтличия,НеЗаполненоВНоменклатуре",ЕстьОтличия,СтрокаРезультат);
			Иначе
				Возврат Новый Структура("ЕстьОтличия,НеЗаполненоВНоменклатуре",ЕстьОтличия,НеЗаполненоВНоменклатуре);
			КонецЕсли;
		КонецЕсли;
	Иначе
		Возврат Новый Структура("ЕстьОтличия,НеЗаполненоВНоменклатуре",ЕстьОтличия,НеЗаполненоВНоменклатуре);	
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПослеОтветаНаВопросЗаписатьДанныеВНоменклатуры(РезультатВопроса, ДополнительныеПараметры) Экспорт 
    
	Результат = РезультатВопроса;
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьGtinИКодЭтикеткиЗаказчикаВНоменклатуре();
		БылОтветНаВопросПроверкиGtinИКодЭтикеткиЗаказчикаВНоменклатуре = Истина;
		НаправитьВРаботу(Неопределено);
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		БылОтветНаВопросПроверкиGtinИКодЭтикеткиЗаказчикаВНоменклатуре = Истина;
		НаправитьВРаботу(Неопределено);
	КонецЕсли;
		
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьGtinИКодЭтикеткиЗаказчикаВНоменклатуре()
	
		Для каждого Стр Из Объект.Товары Цикл
			Если ЗначениеЗаполнено(СокрЛП(Стр.Gtin)) И НЕ ЗначениеЗаполнено(СокрЛП(Стр.Номенклатура.Лико_Gtin)) 
				ИЛИ ЗначениеЗаполнено(СокрЛП(Стр.КодЭтикеткиЗаказчика)) И НЕ ЗначениеЗаполнено(СокрЛП(Стр.Номенклатура.Лико_КодЭтикеткиЗаказчика)) Тогда
				НоменкклатураОбъект = Стр.Номенклатура.ПолучитьОбъект();
				Если Объект.Партнер.Лико_GtinВНоменклатуре Тогда
					НоменкклатураОбъект.Лико_Gtin = СокрЛП(Стр.Gtin);
				КонецЕсли;
				Если Объект.Партнер.Лико_КодЭтЗаказчикаВНоменклатуре Тогда
					НоменкклатураОбъект.Лико_КодЭтикеткиЗаказчика = СокрЛП(Стр.КодЭтикеткиЗаказчика);
				КонецЕсли;
				НоменкклатураОбъект.ОбменДанными.Загрузка = Истина;   
				НоменкклатураОбъект.Записать();
			КонецЕсли;
		КонецЦикла;
	
КонецПроцедуры


&НаСервере
Процедура ПроверитьСплошныеФормыПриОтправкеВРаботу()
	
	НужноЗаписатьЗаказ = Ложь;
	Для каждого Стр Из Объект.Цвета Цикл
		Если ЗначениеЗаполнено(Стр.Форма) И Лико_Дополнительно.ЭтоСтрокаСплошнойФормы(Стр) Тогда
			// Если форма не соответствует, то она очистится, значит нужно будет записать заказ
			Если НЕ Лико_Дополнительно.ПроверитьСплошнуюФормуНаСоответствиеПараметрамЗаказа(Объект, Стр) Тогда
				НужноЗаписатьЗаказ = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
