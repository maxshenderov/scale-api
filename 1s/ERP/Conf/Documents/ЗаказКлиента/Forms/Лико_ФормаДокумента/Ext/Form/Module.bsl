Функция СоздатьНоменклатуруПолуфабриката(НаименованиеПолуфабриката,Артикул) //+Лико m.shenderov 19.05.2021
	
	НоваяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	
	НачатьТранзакцию();
	
	НоваяНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
	НоваяНоменклатура.Наименование =НаименованиеПолуфабриката;
	//НоваяНоменклатура.НаименованиеПолное = Текст;
	НоваяНоменклатура.Артикул = Артикул;
	ВидНоменклатуры = Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыПолуфабрикат.ЗначениеПараметра;
	НоваяНоменклатура.ВидНоменклатуры = ВидНоменклатуры;
	НоваяНоменклатура.ГруппаФинансовогоУчета = ВидНоменклатуры.ГруппаФинансовогоУчета;
	НоваяНоменклатура.ГруппаАналитическогоУчета = ВидНоменклатуры.ГруппаАналитическогоУчета;
	//НоваяНоменклатура.Код = Выборка.НоменклатураКод;
	НоваяНоменклатура.СтавкаНДС = УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС20);
	//НоваяНоменклатура.ЕдиницаИзмерения =  Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("тыс.шт");
	НоваяНоменклатура.ЕдиницаИзмерения =  ВидНоменклатуры.ЕдиницаИзмерения;
	НоваяНоменклатура.ЕдиницаДляОтчетов = ВидНоменклатуры.ЕдиницаДляОтчетов;
	НоваяНоменклатура.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	НоваяНоменклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
	НоваяНоменклатура.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры;
	НоваяНоменклатура.ВладелецХарактеристик =Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыДляХраненияХарактеристикНарезки.ЗначениеПараметра;
	НоваяНоменклатура.ИспользоватьУпаковки = Истина;
	//НоваяНоменклатура.НаборУпаковок =  Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("тыс.шт");
	НоваяНоменклатура.НаборУпаковок = ВидНоменклатуры.НаборУпаковок;
	НоваяНоменклатура.ГруппаДоступа = Справочники.ГруппыДоступаНоменклатуры.НайтиПоНаименованию("Материалы товары");
	НоваяНоменклатура.СкладскаяГруппа =  Справочники.Лико_ПредопределенныеЗначения.СкладскаяГруппаНоменклатурыДляГП.ЗначениеПараметра;
	//НоваяНоменклатура.Лико_ТипЭтикетки = ТипЭтикетки;
	
	
	
	
	
	
	НоваяНоменклатура.Записать();
	//Если  Не ЗначениеЗаполнено(Артикул) Тогда 
	//	НоваяНоменклатура.Артикул =  Лико_Планирование.КодБезНулей(НоваяНоменклатура.Код) + "-0";
	//	НоваяНоменклатура.Записать();
	//КонецЕсли;
	
	МассивСтруктур = Новый Массив;
	МассивСтруктур.Добавить(Новый Структура("Свойство, Значение",ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Партнер", Истина),Объект.Партнер));
	УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(НоваяНоменклатура.Ссылка,МассивСтруктур);
	
	ЗафиксироватьТранзакцию();
	
	
	Возврат НоваяНоменклатура.Ссылка; 
	
	
КонецФункции //-Лико m.shenderov 19.05.2021

