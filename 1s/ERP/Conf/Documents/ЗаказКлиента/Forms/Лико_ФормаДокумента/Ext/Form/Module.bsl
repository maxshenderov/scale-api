				КонецЕсли;	 
				
			ИначеЕсли 	ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ЦифровоеТиснение" ) или ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.ЦифровойЛак" )  Тогда 
