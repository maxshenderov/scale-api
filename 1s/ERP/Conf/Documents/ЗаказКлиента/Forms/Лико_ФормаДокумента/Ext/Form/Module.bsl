		Возврат;		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.РабочийЦентр) Тогда
		Сообщить("Необходимо заполнить поле ""Рабочий центр""", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;   
	
	//+ повторяющийся код, надо будет улучшить
	ВыполняемаяОбработка = НайтиВПФ("Обработка ""лк СхемаМашины""");
	Если ВыполняемаяОбработка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВыполняемаяОбработка);
	//-	
	
	

		
	ПараметрыНаФорму = Новый Структура;
	ПараметрыНаФорму.Вставить("Площадка", Объект.Площадка);  
	ПараметрыНаФорму.Вставить("Ссылка", Объект.Ссылка); 
	ПараметрыНаФорму.Вставить("НомерПроката", текДанные.НомерПроката);	
	ПараметрыНаФорму.Вставить("РабочийЦентр", текДанные.РабочийЦентр);  
		текТЗСекции = ПолучитьТаблицуДляпередачиДанныхПоПрокату(текДанные.НомерПроката, ПараметрыНаФорму);

	ПараметрыНаФорму.Вставить("ТЗСекции", текТЗСекции);
	
	
		
	ОбработкаЗакрытия = Новый ОписаниеОповещения("ПриЗакрытииСхемыМашины", ЭтотОбъект, "");
			
	ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.Лико_СхемаМашины", ПараметрыНаФорму ,ЭтаФорма,,,,ОбработкаЗакрытия);


	
