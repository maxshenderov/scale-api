			Если ТекущийОбъект.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПолныйПовтор 
				И ТекущийОбъект.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПовторСНовымОбъединением
				И ТекущийОбъект.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПовторСИзменением
				И ТекущийОбъект.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПолныйПовторСПереводомНаДругуюМашину
				И ТекущийОбъект.ВидЗаказа <>Перечисления.Лико_ВидыЗаказов.СложныйПовтор Тогда
				ТекущийОбъект.СвойстваМатериала = Неопределено;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;  
	// --> Начало Лико Субботин 23.05.2023 	
	сч = 1;      
	
	Для каждого стр из ТекущийОбъект.Цвета Цикл
    					
		Если не ЗначениеЗаполнено(стр.ВидПечати) И ЗначениеЗаполнено(стр.ВидСекции.ВидПечати) Тогда 
			стр.ВидПечати = стр.ВидСекции.ВидПечати.ВидПечати;			
		Конецесли; 
		Если стр.ВидСекции = Справочники.Лико_ВидыСекций.ТрафаретнаяПечать Тогда
			стр.ВидПечати = стр.ВидСекции.ВидПечати.ВидПечати;	
		КонецЕсли;
	
	КонецЦикла; 
	
   // <-- Конец Лико Субботин 23.05.2023         

КонецПроцедуры

