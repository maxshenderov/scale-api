Процедура ОтгрузкиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	текстр = Элементы.Отгрузки.ТекущиеДанные;
	Если НоваяСтрока Тогда
		КлючСтроки = Новый УникальныйИдентификатор;
		текстр.КлючСтроки = КлючСтроки;
		текстр.рабочийцентр = объект.рабочийЦентр;
		Если ЗначениеЗаполнено(Объект.ОсновнойМатериалФакт) Тогда 
			текстр.ОсновнойМатериал = Объект.ОсновнойМатериалФакт;
		Иначе	
			текстр.ОсновнойМатериал = Объект.ОсновнойМатериал;
		КонецЕсли;	
	КонецЕсли;
	Если Не Копирование Тогда 
		Если Не ЗначениеЗаполнено(текстр.КодПостпечатныхРабот) Тогда 
			текстр.КодПостпечатныхРабот = ПолучитьКодПостПечатныхработ();
		КонецЕсли;	
	КонецЕсли;
	ОтгрузкиПриАктивизацииСтроки(Элемент);
КонецПроцедуры

