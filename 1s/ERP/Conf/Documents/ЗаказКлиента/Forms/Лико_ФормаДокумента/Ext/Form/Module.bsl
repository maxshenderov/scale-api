		Если Объект.ЕдиницаИзмеренияЗаказа = ПолучитьЕИТысШтСервер() Тогда  
			Если ПроверкаЗаполненияПоВидуВырубки() Тогда 
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		Иначе
			Если Не ЗначениеЗаполнено(Объект.Нарезка) Тогда 
				Сообщить("Не заполнено поле Нарезка");
