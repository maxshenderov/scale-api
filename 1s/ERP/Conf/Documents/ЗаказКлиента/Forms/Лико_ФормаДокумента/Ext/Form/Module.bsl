&НаСервереБезКонтекста
Функция ПроверкаТипНумератораСоответствует(ТипНумератора,РЦ)
	
	СтрокаВидРЦ = ТипНумератора.РабочиеЦентры.НайтиСтроки(Новый Структура("РабочийЦентр",РЦ.ВидРабочегоЦентра));
	СтрокиРЦ = ТипНумератора.РабочиеЦентры.НайтиСтроки(Новый Структура("РабочийЦентр",РЦ));
	Если СтрокаВидРЦ.Количество() = 0 И СтрокиРЦ.Количество() = 0 Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьОсновнойВидПечати(НомерПроката) 
	
	РабочийЦентр = объект.Цвета.НайтиСтроки(новый структура("НомерПроката", НомерПроката ))[0].РабочийЦентр;
	
	Возврат РабочийЦентр.ВидРабочегоЦентра.лкОсновнойВидПечати
	
КонецФункции

&НаКлиенте
Функция НужноЗаполнятьВидЗаливки(ВидТМЦ) 
	
	Возврат  ВидТМЦ = ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Лак") 
			 или ВидТМЦ = ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Клей")
			 или ВидТМЦ = ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.Праймер") 
			 или ВидТМЦ = ПредопределенноеЗначение("Справочник.Лико_ВидыТМЦ.БесцветнаяМасса") 
	
КонецФункции

&НаКлиенте
Функция ПроверкаЗаполненияРаботКлиент()// --> Начало Субботин
	
	Если (Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19) И НЕ ЗначениеЗаполнено(Объект.ДопускМинус) И НЕ ЗначениеЗаполнено(Объект.ДопускПлюс) Тогда
		Возврат СтрШаблон("Не указан вариант допусков в параметрах печати и вырубки. Работы не утверждены")       
	КонецЕсли; 
	
	// <-- Начало Лико Яцун С. В. 01.10.2024 
	Если НеобходимоЗаполнятьРаппортТУ() И НЕ ЗначениеЗаполнено(Объект.Раппорт) И НЕ Объект.ВидЗаказа = ПредопределенноеЗначение("Перечисление.Лико_ВидыЗаказов.ПолныйПовтор") Тогда
		Возврат СтрШаблон("Не заполнено поле Раппорт в параметрах печати и вырубки. Введите Высоту этикетки для заполнения Раппорта. Работы не утверждены")       
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 01.10.2024
	
	Для каждого стр из объект.Цвета цикл  

		Если Лико_Дополнительно.ЗначениеРеквизитаОбъекта(стр.ВидСекции, "ОтображатьВТЧЦвета") И НЕ Лико_Дополнительно.ЗначениеРеквизитаОбъекта(стр.ВидСекции, "ОтображатьВТЧРаботы") И ВидРЦИндиго(стр.РабочийЦентр) Тогда 

			Если не ЗначениеЗаполнено(Объект.Праймер) Тогда  
				Возврат СтрШаблон("Не указан праймер для цифровой печати. Работы не утверждены")
			КонецЕсли;

		КонецЕсли;

			//28.06.22 
		//Если ЭтоЛико_ШтампСЛаминацией(стр.Оснастка) Тогда  
		//	Возврат СтрШаблон("При использовании указанного вырубного штампа (""%1"") требуется ламинация для поднятия облоя или консультация технолога", стр.Оснастка);
		//КонецЕсли;  

		//16.09.22
		Если  стр.ВидСекции = ПредопределенноеЗначение("Справочник.Лико_ВидыСекций.Конгрев")  Тогда

			Если ЗначениеЗаполнено(стр.Оснастка) Тогда

				Если ВидРЦОмега(стр.РабочийЦентр) и  объект.ВидЗаказа <> ПредопределенноеЗначение("Перечисление.Лико_ВидыЗаказов.Пробник") Тогда

					ЧислоУдаров = ПолучитьСкоростьРино(стр.РабочийЦентр);
					Если ЧислоУдаров = 0 Тогда
						Возврат "не заполнена скорость рино на РЦ, обратитесь к программистам" 			
					КонецЕсли;
					ДлинаШтампа = ДлинаКонгревногоШтампа(стр.Оснастка, объект.ЭтМЭР);	

					СтоимостьЧаса = 100;
					ЦенаШтампа = ПолучитьЦенуШтампа(стр.Оснастка, стр.РабочийЦентр, стр.ВидСекции );   


					Если  ДлинаШтампа < 70 Тогда 
						Если (объект.МетражПМ/(ДлинаШтампа * ЧислоУдаров)*СтоимостьЧаса)/2 > ЦенаШтампа Тогда
							Возврат СтрШаблон("Длина конгревного штампа менее 70 мм (%1 мм), требуется заказать другой штамп", ДлинаШтампа) 

						КонецЕсли;
					КонецЕсли;  

				КонецЕсли;  

			КонецЕсли; 

		КонецЕсли;

	КонецЦикла;	  

	Возврат Истина
		
КонецФункции // <-- Конец Субботин

