				Если Не ЗначениеЗаполнено(стр.ТипНумератора) Тогда
					Возврат  СтрШаблон("не заполнен Тип нумератора в строке %1", стр.НомерСтроки) 					
				КонецЕсли;	

				Если Не  ЗначениеЗаполнено(стр.ТипКраски) Тогда
					Возврат СтрШаблон("не заполнены Чернила в строке %1", стр.НомерСтроки)				
				КонецЕсли;  

				Если Не  ЗначениеЗаполнено(стр.ТипКода) Тогда
					Возврат СтрШаблон("не заполнен Тип кода в строке %1", стр.НомерСтроки)				
				КонецЕсли;   

				Если Не  ЗначениеЗаполнено(стр.КоличествоКодовНаЛисте)  Тогда
					Возврат СтрШаблон("не заполнено количество кодов на листе в строке %1", стр.НомерСтроки)			
				КонецЕсли;

				Если Не  ЗначениеЗаполнено(стр.КоличествоРучьевНумератора)  Тогда
					Возврат СтрШаблон("не заполнено количество ручьев нумератора) в строке %1", стр.НомерСтроки)				
				КонецЕсли;   			
			КонецЕсли; 
			
		// <-- Начало Лико Яцун С. В. 01.11.2024 
		Если ЗначениеЗаполнено(Стр.ТипНумератора) Тогда
			Если НЕ ПроверкаТипНумератораСоответствует(Стр.ТипНумератора,Стр.Рабочийцентр) Тогда
				Возврат СтрШаблон("указанный Тип нумератора не соответствует выбранному Рабочему центру в строке %1", стр.НомерСтроки)				
			КонецЕсли;
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 01.11.2024  
		
