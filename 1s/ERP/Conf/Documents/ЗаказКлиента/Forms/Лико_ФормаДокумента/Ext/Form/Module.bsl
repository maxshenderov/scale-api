Процедура ОчиститьПараметрыОтВидаЗаказа(ВидЗаказа, ЗаказОбъект) // --> Начало Лико Митюшин МФМ 09.03.2021
	
	Если ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Новый Тогда
		ЗаказОбъект.УдалитьНомерПовторЗаказа = "";
		ЗаказОбъект.ПовторЗаказа = Неопределено;
	КонецЕсли;
	
	Если ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ПолныйПовтор Тогда
		ПустаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
		ЗаказОбъект.МонтажСхема.Очистить();
		ЗаказОбъект.МонтажСоответствия.Очистить();
		Для каждого стр из Объект.Цвета Цикл
			Стр.Анилокс = ПустаяНоменклатура;
			стр.ВидПолимера = Справочники.Лико_ВидыПолимеров.ПустаяСсылка();	
		КонецЦикла;
	
	КонецЕсли;
	
	Если ЗаказОбъект.Товары.Количество()>0 Тогда 
		//20200712 - пробник, пф, цифровая проба - без цены
		Если    ((ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Пробник ИЛИ ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка) И Не ЗаказОбъект.ЗаДеньги) ИЛИ  ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ЦифроваяПроба ИЛИ ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ТестированиеМатериалов Тогда
			Для каждого стр из ЗаказОбъект.Товары Цикл
				стр.Цена = 0;
				стр.сумма = 0;
				стр.суммаСНДС = 0;
				стр.СуммаНДС = 0 ;
				Стр.ЦенаДляДокументов = 0;
			КонецЦикла;
			//ЦенаДляДокументовСредняя = 0			
		КонецЕсли;
		СуммаДокумента = ЗаказОбъект.Товары.Итог("СуммаСНДС")+ЗаказОбъект.СтоимостьОснастки;
	КонецЕсли;
	
	
		
КонецПроцедуры // <-- Конец Лико Митюшин МФМ 09.03.2021

