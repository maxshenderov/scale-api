&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	текстр = Элементы.Товары.ТекущиеДанные;
	Если текстр<> Неопределено Тогда
		ВерсияНоменклатуры = текстр.ВерсияНоменклатуры;
		Если ЗначениеЗаполнено(текстр.Направление) Тогда 
			идентификатор = текстр.ПолучитьИдентификатор();
			ПоказатьКартинкуНамотки(идентификатор);
		КонецЕсли;	
		СтавкаНДСТекущейСтроки = текстр.ставкаНДС;
		
	КонецЕсли; 
	
	DFMКлиент.ОригиналМакет(ЭтаФорма);	
	
		
	
КонецПроцедуры 




&НаКлиенте
Процедура НадписьСтоимостьНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Отказ = Истина;
	Если ЭтаФорма.Модифицированность Тогда
		Записать();
	КонецЕсли;
	РассчитатьЗаказНаСервере(Объект.Ссылка, Отказ);
	Если Отказ Тогда 
		Сообщить("Заказ не рассчитан!")
	Иначе
		ПоказатьДоходностьРентабельность();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПечатьОМСКартинкой(Команда)
	РабочееМесто = ПолучитьРабочееМестоНаСервере();
	Если Не ЗначениеЗаполнено(РабочееМесто) Тогда 
		Сообщить("Не указано рабочее место!");
	КонецЕсли;
	//ИмяПринтера = "\\spb-srv-print01\it";   
	//ИмяПрограммыПечатиPDF = "C:\Foxit Software\Foxit Reader\FoxitReader.exe";
	ИмяПринтера = ЗначениеРеквизита(РабочееМесто,"ИмяПринтераДляЦветнойПечати");  
	ИмяПрограммыПечатиPDF = ЗначениеРеквизита(РабочееМесто,"ИмяПрограммыПечатиPDF");  
	Если Не (ЗначениеЗаполнено(ИмяПринтера) Или  ЗначениеЗаполнено(ИмяПрограммыПечатиPDF)) Тогда 
		Сообщить("Для рабочего места указана программа для печати PDF или принтер цветной печати!");
		Возврат;
	КонецЕсли;
	
	ОригиналМакеты = ПолучитьОМНаСервере();
