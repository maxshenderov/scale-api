	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьВалНаСервере(РЦ,АртикулНовогоВала,Площадка)
	
	ВидРЦентра = РЦ.ВидРабочегоЦентра;
	 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Номенклатура.Ссылка КАК Ссылка,
		|	ПОДСТРОКА(Номенклатура.Артикул, 1, 6) КАК Артикул
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		|		ПО Номенклатура.Ссылка = НоменклатураДополнительныеРеквизиты.Ссылка
		|			И (НоменклатураДополнительныеРеквизиты.Свойство.Имя = ""ОснасткаВид"")
		|			И (НоменклатураДополнительныеРеквизиты.Значение = ЗНАЧЕНИЕ(Перечисление.Лико_ВидОснастки.Вал))
		|ГДЕ
		|	Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
		|	И Номенклатура.Артикул ПОДОБНО ""[0-9][0-9][0-9][0-9][0-9][0-9]%""
		|
		|УПОРЯДОЧИТЬ ПО
		|	Артикул УБЫВ";
	
	Запрос.УстановитьПараметр("ВидНоменклатуры", Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Оснастка"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовыйВалОбъект = ВыборкаДетальныеЗаписи.Ссылка.Скопировать();
		Для Каждого Стр Из НовыйВалОбъект.ДополнительныеРеквизиты Цикл
			Если Стр.Свойство.Имя = "ОснасткаВидРЦ_bd9a610a9b884053add3f931c692aa10" Тогда
				Стр.Значение = ВидРЦентра;	
			КонецЕсли;
			Если Стр.Свойство.Имя = "ОснасткаПлощадка" Тогда
				Стр.Значение = Площадка;	
			КонецЕсли;
		КонецЦикла;
		Если АртикулНовогоВала = "" Тогда
			НовыйВалОбъект.Артикул = Строка(Формат(Число(ВыборкаДетальныеЗаписи.Артикул) + 1,"ЧГ="));
		ИначеЕсли ЗначениеЗаполнено(Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",СокрЛП(АртикулНовогоВала))) Тогда
			Возврат "Вал с Артикулом " + СокрЛП(АртикулНовогоВала) + " уже существует";
		Иначе
			НовыйВалОбъект.Артикул = СокрЛП(АртикулНовогоВала);
		КонецЕсли;
		НовыйВалОбъект.Наименование = "Вал для глубокой печати " + Строка(ВидРЦентра);
		НовыйВалОбъект.Записать(); 
		Возврат НовыйВалОбъект.Ссылка;
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура СоздатьВал(Команда)
	
	ТекСтр = Элементы.Цвета.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекСтр.РабочийЦентр) Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаАртикулаВала",ЭтаФорма); 
		ПоказатьВводСтроки(ОписаниеОповещения,,"Введите нужный Артикул нового Вала или нажмите ОК");
	Иначе
		Сообщить("Не заполнен рабочий центр");
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеВводаАртикулаВала(РезультатФормы, ПараметрыФормы) Экспорт
	
	ТекСтр = Элементы.Цвета.ТекущиеДанные;
	Если РезультатФормы <> Неопределено Тогда
		НовыйВал = СоздатьВалНаСервере(ТекСтр.РабочийЦентр,РезультатФормы,Объект.Площадка);	
		Если ТипЗнч(НовыйВал) = Тип("Строка") Тогда
			Сообщить(НовыйВал); 
		Иначе
			ТекСтр.Вал = НовыйВал; 
			ДобавитьУсловноеОформлениеЦветаВалФорма(); 
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказатьВыделенные(Команда)
	
	ДатаГлубокихФорм = ЗначениеРеквизита(ПредопределенноеЗначение("Справочник.Лико_ПредопределенныеЗначения.ДатаГлубокихФорм"),"ЗначениеПараметра");
	Если ЗначениеЗаполнено(ДатаГлубокихФорм) И ДатаГлубокихФорм < ТекущаяДата() Тогда
		Если ЭтаФорма.Модифицированность Тогда
			Сообщить("Необходимо записать заказ!");
			Возврат;
		КонецЕсли;
		МассивВалФорма = Новый Массив;
		Для Каждого СтрЦвета Из Элементы.Цвета.ВыделенныеСтроки Цикл
			СтрокаЦвета = Элементы.Цвета.ДанныеСтроки(СтрЦвета);
			СтруктураВалФорма = Новый Структура("Вал,Форма",СтрокаЦвета.Вал,СтрокаЦвета.Форма);
			МассивВалФорма.Добавить(СтруктураВалФорма);
		КонецЦикла;
		
		ПараметрыОткрытия = Новый Структура("Заказ,ВалФорма",Объект.Ссылка,МассивВалФорма);
		ОткрытьФорму("Документ.Лико_ЗаявкаНаГравировкуВалов.ФормаОбъекта",ПараметрыОткрытия,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦветаФормаОткрытие(Элемент, СтандартнаяОбработка)
	
	ТекСтр = Элементы.Цвета.ТекущиеДанные;
	
	СтандартнаяОбработка = Ложь;
    
    ПараметрыОткрытия = Новый Структура("Ключ,Заказ", ТекСтр.Форма,Объект.Ссылка);
    
    Обработчик = Новый ОписаниеОповещения("ФормаЗавершениеОткрытия", ЭтотОбъект);
    
    ОткрытьФорму("Справочник.Лико_Формы.ФормаОбъекта", ПараметрыОткрытия, ЭтаФорма, , , , Обработчик,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ФормаЗавершениеОткрытия(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	ТекСтр = Элементы.Цвета.ТекущиеДанные;
	
	Если ТекСтр.Грамматура <> ЗначениеРеквизита(ТекСтр.Форма,"Грамматура") ИЛИ ТекСтр.ПроцентЗаливки <> ЗначениеРеквизита(ТекСтр.Форма,"ПроцентЗаливки") Тогда
		
		ТекСтр.Грамматура = ЗначениеРеквизита(ТекСтр.Форма,"Грамматура") * 0.5;
		ТекСтр.ПроцентЗаливки = ЗначениеРеквизита(ТекСтр.Форма,"ПроцентЗаливки");
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НомерПовторЗаказаПриИзмененииНаСервере()
	
	Модифицированность = Истина;
	
	Если НЕ ЗначениеЗаполнено(ПовторЗаказаНомер) Тогда
		Объект.ПовторЗаказа = Неопределено;
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказКлиента.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.НомерБезПрефикса = &НомерБезПрефикса";
	
	Запрос.УстановитьПараметр("НомерБезПрефикса", ПовторЗаказаНомер);
	
	УстановитьПривилегированныйРежим(Истина);

	ЗаказСуществует = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Ссылка) Тогда
		ЗаказСуществует = Истина;
	Иначе
		Сообщить("Не найден заказ с номером " + ПовторЗаказаНомер);
		ПовторЗаказаНомер = Неопределено;
		Объект.ПовторЗаказа = Неопределено;
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Ссылка) Тогда
		Объект.ПовторЗаказа = Выборка.Ссылка;
	Иначе
		Сообщить("У вас нет доступа к заказу с номером " + ПовторЗаказаНомер);
		ПовторЗаказаНомер = Неопределено;
		Объект.ПовторЗаказа = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НомерПовторЗаказаПриИзменении(Элемент)
	НомерПовторЗаказаПриИзмененииНаСервере();
КонецПроцедуры


&НаКлиенте
Процедура НомерПовторЗаказаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(Объект.ПовторЗаказа) Тогда
		ПоказатьЗначение(, Объект.ПовторЗаказа);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура НомерПовторЗаказаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	фиксНастройки = Новый НастройкиКомпоновкиДанных;
	
	эОтбор = фиксНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	эОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Родитель");
	эОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	эОтбор.ПравоеЗначение = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Справочники.Лико_ПредопределенныеЗначения.ГруппаФизическихЛицВодители.ЗначениеПараметра");
	эОтбор.Использование = Истина;
	
	ПараметрыОтбора = Новый Структура;    
	//ПараметрыОтбора.Вставить("ФиксированныеНастройки", фиксНастройки);
	ПараметрыОтбора.Вставить("РежимВыбора", Истина);
	Если ЗначениеЗаполнено(Объект.ПовторЗаказа) Тогда
		ПараметрыОтбора.Вставить("ТекущаяСтрока", Объект.ПовторЗаказа);
	КонецЕсли;
	
	ОткрытьФорму("Документ.ЗаказКлиента.ФормаВыбора", ПараметрыОтбора,,,,, Новый ОписаниеОповещения("ВыбранПовторЗаказа", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранПовторЗаказа(Результат, ДопПараметры) Экспорт
	
	Модифицированность = Истина;

	Если ЗначениеЗаполнено(Результат) Тогда
		Объект.ПовторЗаказа = Результат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ПовторЗаказа) Тогда
		ПовторЗаказаНомер = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Объект.ПовторЗаказа, "НомерБезПрефикса");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КопироватьФормы(Команда)
	
	Если Объект.ВидЗаказа <> ПредопределенноеЗначение("Перечисление.Лико_ВидыЗаказов.НовыйССохранениемФорм") Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаНомераЗаказаДляКопированияФорм",ЭтаФорма); 
		ПоказатьВводСтроки(ОписаниеОповещения,ПовторЗаказаНомер,"Введите номер заказа для копирования форм");
		Возврат;
	КонецЕсли;

	КопироватьФормыНаСервере();
	Модифицированность = Истина;
	ДобавитьУсловноеОформлениеЦветаВалФорма();

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаНомераЗаказаДляКопированияФорм(РезультатФормы, ПараметрыФормы) Экспорт
	
	Если РезультатФормы <> Неопределено И РезультатФормы <> "" Тогда
		КопироватьФормыНаСервере(РезультатФормы);
		Модифицированность = Истина;
		ДобавитьУсловноеОформлениеЦветаВалФорма();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КопироватьФормыНаСервере(НомерЗаказаДляКопированияФорм = Неопределено)

	НомерЗаказаДляКопированияФормСсылка = Неопределено;
	Если НомерЗаказаДляКопированияФорм <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.НомерБезПрефикса = &НомерБезПрефикса
		|	И ЗаказКлиента.Дата >= ДАТАВРЕМЯ(2024, 1, 1, 0, 0, 0)";
		
		Запрос.УстановитьПараметр("НомерБезПрефикса", НомерЗаказаДляКопированияФорм);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НомерЗаказаДляКопированияФормСсылка = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЦикла;
	КонецЕсли;
	
	Если НомерЗаказаДляКопированияФормСсылка <> Неопределено ИЛИ НомерЗаказаДляКопированияФорм = Неопределено Тогда
		Лико_Планирование.КопироватьФормыНаСервере(Объект.Цвета, НомерЗаказаДляКопированияФормСсылка, Объект.ВидЗаказа);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВидимостьФормыГлубокой()
	
	СтрокиГлубокаяПечать = Объект.Цвета.НайтиСтроки(Новый Структура("ВидСекции",Справочники.Лико_ВидыСекций.ГлубокаяПечать));
	СтрокиГлубокаяЛаминация = Объект.Цвета.НайтиСтроки(Новый Структура("ВидСекции",Справочники.Лико_ВидыСекций.ГлубокаяЛаминация));
	Если СтрокиГлубокаяПечать.Количество() = 0 И СтрокиГлубокаяЛаминация.Количество() = 0 Тогда
		Элементы.ФормыГлубокой.Видимость = Ложь;
	Иначе
		Элементы.ФормыГлубокой.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьАналоги(Команда) // <-- Начало Лико Яцун С. В. 18.03.2024
	//УстановитьПараметрыОстатковКлиент();
	
	Обработка = НайтиВПФ("лк Список рулонных материалов");
	Если Обработка <> Неопределено Тогда
		Если ТипЗнч(Объект.ОсновнойМатериал) = Тип("СправочникСсылка.ЦеновыеГруппы") Тогда
			СвойстваМатериала = ПолучитьСвойстваМатериала(ЗначениеРеквизита(Объект.ОсновнойМатериал,"ОсновнаяНоменклатура"),Объект.Площадка);
		Иначе
			СвойстваМатериала = ПолучитьСвойстваМатериала(Объект.ОсновнойМатериал,Объект.Площадка);
		КонецЕсли;
		BRC = СвойстваМатериала.BRC;
		BRC_ДатаКарантина = СвойстваМатериала.BRC_ДатаКарантина;
		СписокЗначений = Новый СписокЗначений;
		СписокЗначений.Добавить(ПредопределенноеЗначение("Справочник.Партнеры.ПустаяСсылка")); 
		СписокЗначений.Добавить(Объект.Партнер);
		ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(Обработка);
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Дата", Объект.Дата);
		ПараметрыОткрытия.Вставить("ПартнерОтбор", СписокЗначений);
		ПараметрыОткрытия.Вставить("Партнер", Объект.Партнер);  
		ПараметрыОткрытия.Вставить("Заказ", Объект.Ссылка);  
		ПараметрыОткрытия.Вставить("BRC", BRC);
		ПараметрыОткрытия.Вставить("BRC_ДатаКарантина",BRC_ДатаКарантина);
		ПараметрыОткрытия.Вставить("АртикулОтбор", Неопределено);
		ПараметрыОткрытия.Вставить("КодНоменклатурыОтбор",Неопределено);
		ПараметрыОткрытия.Вставить("НарезкаОтбор", Неопределено);
		ПараметрыОткрытия.Вставить("НаименованиеОтбор", Неопределено);
		ПараметрыОткрытия.Вставить("ГруппаМатериаловОтбор", СвойстваМатериала.ГруппаМатериаловОтбор);
		ПараметрыОткрытия.Вставить("ГруппаМатериаловОтборИспользовать", Ложь);
		ПараметрыОткрытия.Вставить("ПсевдонимОтбор", СвойстваМатериала.ПсевдонимОтбор);
		ПараметрыОткрытия.Вставить("ПсевдонимОтборИспользовать", Ложь);
		ЛицевойМатериалОтбор = Новый  СписокЗначений;
		Если ЗначениеЗаполнено(СвойстваМатериала.ЛицевойМатериалОтбор) Тогда
			ЛицевойМатериалОтбор.Добавить(СвойстваМатериала.ЛицевойМатериалОтбор);
		КонецЕсли;
		ПараметрыОткрытия.Вставить("ЛицевойМатериалОтбор", ЛицевойМатериалОтбор);
		ПараметрыОткрытия.Вставить("ЛицевойМатериалОтборИспользовать", Ложь);
		ПокрытиеОтбор = Новый  СписокЗначений;
		Если ЗначениеЗаполнено(СвойстваМатериала.ПокрытиеОтбор) Тогда
			ПокрытиеОтбор.Добавить(СвойстваМатериала.ПокрытиеОтбор);
		КонецЕсли;
		ПараметрыОткрытия.Вставить("ПокрытиеОтбор", ПокрытиеОтбор);
		ПараметрыОткрытия.Вставить("ПокрытиеОтборИспользовать", Ложь);
		ПодложкаОтбор = Новый  СписокЗначений;
		Если ЗначениеЗаполнено(СвойстваМатериала.ПодложкаОтбор) Тогда
			ПодложкаОтбор.Добавить(СвойстваМатериала.ПодложкаОтбор);
		КонецЕсли;
		ПараметрыОткрытия.Вставить("ПодложкаОтбор", ПодложкаОтбор);
		ПараметрыОткрытия.Вставить("ПодложкаОтборИспользовать", Ложь);
		//ПараметрыОткрытия.Вставить("КодКлеяОтбор", КодКлеяОтбор);
		//ПараметрыОткрытия.Вставить("КодКлеяОтборИспользовать", Ложь);
		ПараметрыОткрытия.Вставить("ВидКлеяОтбор", СвойстваМатериала.ВидКлеяОтбор);
		ПараметрыОткрытия.Вставить("ВидКлеяОтборИспользовать", Ложь);
		ПараметрыОткрытия.Вставить("ТипКлеяОтбор", СвойстваМатериала.ТипКлеяОтбор);
		ПараметрыОткрытия.Вставить("ТипКлеяОтборИспользовать", Ложь);
		ПараметрыОткрытия.Вставить("МинимальнаяТемператураЭтикерованияОтбор", СвойстваМатериала.МинимальнаяТемператураЭтикерованияОтбор);
		ПараметрыОткрытия.Вставить("МинимальнаяТемператураЭтикерованияОтборИспользовать", Ложь);
		ПараметрыОткрытия.Вставить("МинимальнаяТемператураЭксплуатацииОтбор", СвойстваМатериала.МинимальнаяТемператураЭксплуатацииОтбор);
		ПараметрыОткрытия.Вставить("МинимальнаяТемператураЭксплуатацииОтборИспользовать", Ложь);
		ПараметрыОткрытия.Вставить("МаксимальнаяТемператураЭксплуатацииОтбор", СвойстваМатериала.МаксимальнаяТемператураЭксплуатацииОтбор); 
		ПараметрыОткрытия.Вставить("МаксимальнаяТемператураЭксплуатацииОтборИспользовать", Ложь);
		//ПараметрыОткрытия.Вставить("КлейДляЛаминацииОтбор", КлейДляЛаминацииОтбор);
		//ПараметрыОткрытия.Вставить("КлейДляЛаминацииОтборИспользовать", Ложь);
		ПараметрыОткрытия.Вставить("НаличиеПраймераОтбор", СвойстваМатериала.НаличиеПраймераОтбор);
		ПараметрыОткрытия.Вставить("НаличиеПраймераОтборИспользовать", Ложь);
		ПараметрыОткрытия.Вставить("КольеИлиМаленькийРадиусОтбор", СвойстваМатериала.КольеИлиМаленькийРадиусОтбор);
		ПараметрыОткрытия.Вставить("КольеИлиМаленькийРадиусОтборИспользовать", Ложь);
		ПараметрыОткрытия.Вставить("ЭтикеткаОтбор", СвойстваМатериала.ЭтикеткаОтбор);
		ПараметрыОткрытия.Вставить("ЭтикеткаОтборИспользовать", Ложь);
		ПараметрыОткрытия.Вставить("ПЕФлаконОтбор", СвойстваМатериала.ПЕФлаконОтбор);
		ПараметрыОткрытия.Вставить("ПЕФлаконОтборИспользовать", Ложь);
		ПараметрыОткрытия.Вставить("ПослеЗаморозкиОтбор", СвойстваМатериала.ПослеЗаморозкиОтбор);
		ПараметрыОткрытия.Вставить("ПослеЗаморозкиОтборИспользовать", Ложь);
		ПараметрыОткрытия.Вставить("ЧестныйЗнакОтбор", СвойстваМатериала.ЧестныйЗнакОтбор);
		ПараметрыОткрытия.Вставить("ЧестныйЗнакОтборИспользовать", Ложь);
		Если ЗначениеЗаполнено(Объект.ОсновнойМатериал) И ТипЗнч(Объект.ОсновнойМатериал) = Тип("СправочникСсылка.ЦеновыеГруппы") Тогда
			ПараметрыОткрытия.Вставить("ЦеноваяГруппаОтбор", Объект.ОсновнойМатериал);
			ПараметрыОткрытия.Вставить("ПоЦенновойГруппеОтбор", Ложь);
			ПараметрыОткрытия.Вставить("НоменклатураОтбор", ЗначениеРеквизита(Объект.ОсновнойМатериал,"ОсновнаяНоменклатура"));
			ПоставщикОтбор = Новый  СписокЗначений;
			Если ЗначениеЗаполнено(ЗначениеРеквизита(ЗначениеРеквизита(Объект.ОсновнойМатериал,"ОсновнаяНоменклатура"),"Производитель")) Тогда
				ПоставщикОтбор.Добавить(ЗначениеРеквизита(ЗначениеРеквизита(Объект.ОсновнойМатериал,"ОсновнаяНоменклатура"),"Производитель"));
			КонецЕсли;
			ПараметрыОткрытия.Вставить("ПоставщикОтбор", ПоставщикОтбор);
			ПараметрыОткрытия.Вставить("ПоНоменклатуреОтбор", Ложь);
		ИначеЕсли ЗначениеЗаполнено(Объект.ОсновнойМатериал) И ТипЗнч(Объект.ОсновнойМатериал) = Тип("СправочникСсылка.Номенклатура") Тогда
			ПараметрыОткрытия.Вставить("ЦеноваяГруппаОтбор", ЗначениеРеквизита(Объект.ОсновнойМатериал,"ЦеноваяГруппа"));
			ПараметрыОткрытия.Вставить("ПоЦенновойГруппеОтбор", Ложь);
			ПараметрыОткрытия.Вставить("НоменклатураОтбор", Объект.ОсновнойМатериал);
			ПоставщикОтбор = Новый  СписокЗначений;
			Если ЗначениеЗаполнено(ЗначениеРеквизита(Объект.ОсновнойМатериал,"Производитель")) Тогда
				ПоставщикОтбор.Добавить(ЗначениеРеквизита(Объект.ОсновнойМатериал,"Производитель"));
			КонецЕсли;
			ПараметрыОткрытия.Вставить("ПоставщикОтбор", ПоставщикОтбор);
			ПараметрыОткрытия.Вставить("ПоНоменклатуреОтбор", Ложь);
		Иначе
			ПараметрыОткрытия.Вставить("ЦеноваяГруппаОтбор", Неопределено);
			ПараметрыОткрытия.Вставить("ПоЦенновойГруппеОтбор", Ложь);
			ПараметрыОткрытия.Вставить("НоменклатураОтбор", Неопределено);
			ПараметрыОткрытия.Вставить("ПоставщикОтбор", Неопределено);
			ПараметрыОткрытия.Вставить("ПоНоменклатуреОтбор", Ложь);
		КонецЕсли;
		//ПараметрыОткрытия.Вставить("Склад", Объект.Склад);
		ПараметрыОткрытия.Вставить("Организация", ЗначениеРеквизита(Объект.Площадка,"Организация"));
		ПараметрыОткрытия.Вставить("Площадка", ЗначениеРеквизита(Объект.Площадка,"Организация"));
		ПараметрыОткрытия.Вставить("НаНастройку", Ложь);  
		ПараметрыОткрытия.Вставить("ПроизводственноеПомещениеОтбор", Неопределено);
		ПараметрыОткрытия.Вставить("ИзЗаказа", Истина); 
		ПараметрыОткрытия.Вставить("Лико_Площадка", Объект.Площадка);


		ПараметрыОткрытия.Вставить("ТекстЗапросаОстаткиНоменклатуры", Неопределено);
		ПараметрыДляОткрытия = Новый Структура("ДанныеЗаполненияОтборов",ПараметрыОткрытия);
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораАналогаМатериала", ЭтаФорма);  
		ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.ФормаПодбораАналогаМатериала",ПараметрыДляОткрытия,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		//ОткрытьФорму("Обработка.Лико_СписокРулонныхМатериалов.Форма.ФормаПодбораАналогаМатериала",ПараметрыДляОткрытия,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры // <-- Конец Лико Яцун С. В. 18.03.2024 

&НаКлиенте
Процедура ПослеВыбораАналогаМатериала(Результат, Параметры) Экспорт // <-- Начало Лико Яцун С. В. 25.04.2024    
	
	Если Результат <> Неопределено Тогда
		Если Результат.ВыбраннаяСтрока <> Неопределено Тогда
			Объект.ОсновнойМатериал = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Результат.ВыбраннаяСтрока.Номенклатура,"ЦеноваяГруппа");
			ПоказатьКодМатериала();
		КонецЕсли;
		СвойстваМатериалаДляХранилища = Новый Структура("МассивОтборовСвойствМатериалов",Результат.МассивОтборовСвойствМатериалов);
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры // <-- Конец Лико Яцун С. В. 25.04.2024 

&НаСервереБезКонтекста
Функция ПолучитьСвойстваМатериала(НоменклатураМатериала,Площадка)
	
	СвойстваМатериала = Новый Структура();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_СвойстваМатериала.Ссылка КАК Ссылка,
		|	Лико_СвойстваМатериала.ВерсияДанных КАК ВерсияДанных,
		|	Лико_СвойстваМатериала.ПометкаУдаления КАК ПометкаУдаления,
		|	Лико_СвойстваМатериала.Код КАК Код,
		|	Лико_СвойстваМатериала.Наименование КАК Наименование,
		|	Лико_СвойстваМатериала.Номенклатура КАК Номенклатура,
		|	Лико_СвойстваМатериала.ГруппаМатериалов КАК ГруппаМатериалов,
		|	Лико_СвойстваМатериала.Псевдоним КАК Псевдоним,
		|	Лико_СвойстваМатериала.ЛицевойМатериал КАК ЛицевойМатериал,
		|	Лико_СвойстваМатериала.КодКлея КАК КодКлея,
		|	Лико_СвойстваМатериала.КлейДляЛаминации КАК КлейДляЛаминации,
		|	Лико_СвойстваМатериала.ПокрытиеРулонногоМатериала КАК ПокрытиеРулонногоМатериала,
		|	Лико_СвойстваМатериала.НаличиеПраймера КАК НаличиеПраймера,
		|	Лико_СвойстваМатериала.КольеИлиМаленькийРадиус КАК КольеИлиМаленькийРадиус,
		|	Лико_СвойстваМатериала.Этикетка КАК Этикетка,
		|	Лико_СвойстваМатериала.ПЕФлакон КАК ПЕФлакон,
		|	Лико_СвойстваМатериала.ПослеЗаморозки КАК ПослеЗаморозки,
		|	Лико_СвойстваМатериала.ЧестныйЗнак КАК ЧестныйЗнак,
		|	Лико_СвойстваМатериала.Примечание КАК Примечание,
		|	Лико_СвойстваМатериала.Подложка КАК Подложка,
		|	Лико_СвойстваМатериала.Предопределенный КАК Предопределенный,
		|	Лико_СвойстваМатериала.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
		|ИЗ
		|	Справочник.Лико_СвойстваМатериала КАК Лико_СвойстваМатериала
		|ГДЕ
		|	Лико_СвойстваМатериала.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураМатериала);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Если ВыборкаДетальныеЗаписи.Количество() > 0 Тогда
		ВыборкаДетальныеЗаписи.Следующий();
		СвойстваМатериала.Вставить("ГруппаМатериаловОтбор",ВыборкаДетальныеЗаписи.ГруппаМатериалов);
		СвойстваМатериала.Вставить("ПсевдонимОтбор",ВыборкаДетальныеЗаписи.Псевдоним);
		СвойстваМатериала.Вставить("ЛицевойМатериалОтбор",ВыборкаДетальныеЗаписи.ЛицевойМатериал);
		СвойстваМатериала.Вставить("ПокрытиеОтбор",ВыборкаДетальныеЗаписи.ПокрытиеРулонногоМатериала);
		СвойстваМатериала.Вставить("ПодложкаОтбор",ВыборкаДетальныеЗаписи.Подложка);
		СвойстваМатериала.Вставить("ВидКлеяОтбор",ВыборкаДетальныеЗаписи.КодКлея.ВидКлея);
		СвойстваМатериала.Вставить("ТипКлеяОтбор",ВыборкаДетальныеЗаписи.КодКлея.ТипКлея);
		СвойстваМатериала.Вставить("МинимальнаяТемператураЭтикерованияОтбор",ВыборкаДетальныеЗаписи.КодКлея.МинимальнаяТемператураЭтикерования);
		СвойстваМатериала.Вставить("МинимальнаяТемператураЭксплуатацииОтбор",ВыборкаДетальныеЗаписи.КодКлея.МинимальнаяТемператураЭксплуатации);
		СвойстваМатериала.Вставить("МаксимальнаяТемператураЭксплуатацииОтбор",ВыборкаДетальныеЗаписи.КодКлея.МаксимальнаяТемператураЭксплуатации);
		СвойстваМатериала.Вставить("НаличиеПраймераОтбор",ВыборкаДетальныеЗаписи.НаличиеПраймера);
		СвойстваМатериала.Вставить("КольеИлиМаленькийРадиусОтбор",ВыборкаДетальныеЗаписи.КольеИлиМаленькийРадиус);
		СвойстваМатериала.Вставить("ЭтикеткаОтбор",ВыборкаДетальныеЗаписи.Этикетка);
		СвойстваМатериала.Вставить("ПЕФлаконОтбор",ВыборкаДетальныеЗаписи.ПЕФлакон);
		СвойстваМатериала.Вставить("ПослеЗаморозкиОтбор",ВыборкаДетальныеЗаписи.ПослеЗаморозки);
		СвойстваМатериала.Вставить("ЧестныйЗнакОтбор",ВыборкаДетальныеЗаписи.ЧестныйЗнак); 
	Иначе
		СвойстваМатериала.Вставить("ГруппаМатериаловОтбор",Неопределено);
		СвойстваМатериала.Вставить("ПсевдонимОтбор",Неопределено);
		СвойстваМатериала.Вставить("ЛицевойМатериалОтбор",Неопределено);
		СвойстваМатериала.Вставить("ПокрытиеОтбор",Неопределено);
		СвойстваМатериала.Вставить("ПодложкаОтбор",Неопределено);
		СвойстваМатериала.Вставить("ВидКлеяОтбор",Неопределено);
		СвойстваМатериала.Вставить("ТипКлеяОтбор",Неопределено);
		СвойстваМатериала.Вставить("МинимальнаяТемператураЭтикерованияОтбор",Неопределено);
		СвойстваМатериала.Вставить("МинимальнаяТемператураЭксплуатацииОтбор",Неопределено);
		СвойстваМатериала.Вставить("МаксимальнаяТемператураЭксплуатацииОтбор",Неопределено);
		СвойстваМатериала.Вставить("НаличиеПраймераОтбор",Неопределено);
		СвойстваМатериала.Вставить("КольеИлиМаленькийРадиусОтбор",Неопределено);
		СвойстваМатериала.Вставить("ЭтикеткаОтбор",Неопределено);
		СвойстваМатериала.Вставить("ПЕФлаконОтбор",Неопределено);
		СвойстваМатериала.Вставить("ПослеЗаморозкиОтбор",Неопределено);
		СвойстваМатериала.Вставить("ЧестныйЗнакОтбор",Неопределено); 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УправлениеСвойствами.ЗначениеСвойства(Площадка.Организация,"Лико_УчетНаСкладеПоBRC")) Тогда 
		BRC = УправлениеСвойствами.ЗначениеСвойства(Площадка.Организация,"Лико_УчетНаСкладеПоBRC");
	Иначе
		BRC = Ложь;
	КонецЕсли;
	
	СвойстваМатериала.Вставить("BRC",BRC);
	
	Если BRC Тогда
		BRC_ДатаКарантина = ТекущаяДата() - Справочники.Лико_ПредопределенныеЗначения.BRC_ДлительностьКарантинаЧас.ЗначениеПараметра*60*60;
		СвойстваМатериала.Вставить("BRC_ДатаКарантина",BRC_ДатаКарантина);
	Иначе
		СвойстваМатериала.Вставить("BRC_ДатаКарантина",ТекущаяДата());
	КонецЕсли;
	
	Возврат СвойстваМатериала;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ВБЗСебеНаСервере(Заказ)
	
	ВПФ = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию("Печатная форма ""Внутренний бланк заказа""");
	ВнешняяОбработкаОбъект = ДополнительныеОтчетыИОбработкиВызовСервера.ОбъектВнешнейОбработки(ВПФ);
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Заказ);
	ТабДокумент = ВнешняяОбработкаОбъект.ПечатьВБЗ(МассивОбъектов);
	ИмяФайла = КаталогВременныхФайлов() + "ВБЗ - " + Заказ.НомерБезПрефикса + ".pdf";
	//ВременныйФайл = ПолучитьИмяВременногоФайла("pdf");
	ТабДокумент[0].ТабДок.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.PDF);
	ТекПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	Лико_Планирование.ОтправитьПисьмо("", "ВБЗ - " + Заказ.НомерБезПрефикса,ТекПользователь,,,,,ИмяФайла);
	УдалитьФайлы(ИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ВБЗСебе(Команда)
	ВБЗСебеНаСервере(Объект.Ссылка);
КонецПроцедуры


&НаКлиенте
Процедура ЦветаФормаНомерЛинксОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.Цвета.ТекущиеДанные;
	Если ЗначениеЗаполнено(Текст) Тогда
		Текст = СокрЛП(Формат(Число(Текст),"ЧГ=0"));
		СпрФорма = ПолучитьФормуНаСервере(Текст);
		Если ЗначениеЗаполнено(СпрФорма) Тогда 
			УдалитьСписокЗначений("Формы", ТекущиеДанные.КлючСтроки);
			стр = Объект.Формы.Добавить();
			стр.Значение = СпрФорма;
			стр.КлючСтроки = ТекущиеДанные.КлючСтроки;
			текущиеДанные.Форма = СпрФорма;
			ТекущиеДанные.ФормаНомерЛинкс = Текст;
			ДобавитьУсловноеОформлениеЦветаВалФорма();
		ИначеЕсли ПлощадкаЛинкс(Объект.Площадка) И СтрДлина(Текст) <= 3 Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("Идентификатор", ТекущиеДанные.ПолучитьИдентификатор());
			ДопПараметры.Вставить("КодЛинкс", Текст);
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеОтветаНаВопросОСозданииНовойФормыЛинкс", ЭтотОбъект,ДопПараметры),"Нет общей формы с таким номером Линкс, создать?",РежимДиалогаВопрос.ДаНет);
			Возврат;
		Иначе
