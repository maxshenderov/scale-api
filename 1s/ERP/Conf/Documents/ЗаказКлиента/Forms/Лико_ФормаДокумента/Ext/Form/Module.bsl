&НаСервере
Процедура ТоварыНаправлениеПриИзмененииНаСервере()
	текстр = Элементы.Товары.ТекущиеДанные;

	Если ЗначениеЗаполнено(текстр.Направление) Тогда
		
		Если Не текстр.Направление.ФайлКартинки.Пустая() Тогда
			текстр.КартинкаНамотки = НавигационнаяСсылкаКартинки(текстр.Направление.ФайлКартинки, УникальныйИдентификатор);
		Иначе
			текстр.КартинкаНамотки = "";
		Конецесли;
	КонецЕсли;
КонецПроцедуры

