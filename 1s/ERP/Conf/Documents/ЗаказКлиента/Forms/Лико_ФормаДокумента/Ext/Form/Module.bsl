&НаКлиенте
Функция ПолучитьФайлИзБазыSQL(ОригиналМакет, ИдентификаторФайла) Экспорт
	ПараметрыСоединения =   Лико_ДополнительноКлиент.УстановитьСоединениеССервером();
	Подключение = ПараметрыСоединения.ADOConnection;
	
	Если Подключение = Неопределено Тогда
		Сообщить("Отсутствует подключение к SQL серверу! Обратитесь, пожалуйста, в IT - отдел.");
		Возврат Неопределено;
	КонецЕсли;
	
	Файл = Неопределено;
	ИмяТаблицы = "FileStore";
	Замещать = Истина;
	
	ИДСсылки = ЗначениеВСтрокуВнутрНаСервере(ОригиналМакет);
	ИДСсылкиМакета = ЗначениеВСтрокуВнутрНаСервере(ИдентификаторФайла);
	
	
	Stream = Новый COMОбъект("ADODB.Stream");
	Stream.Type = 1;
	Stream.Open();
	
	RecordSet = Новый COMОбъект("ADODB.RecordSet");
	RecordSet.CursorLocation = 3;
	RecordSet.LockType = 2;
	
	//Запрос = "SELECT Data FROM [" + ИмяТаблицы + "] WHERE GUID = '" + ИДСсылки + "' AND GUIDMaket  = '" + ИДСсылкиМакета + "'";
	Запрос = "SELECT Data FROM [" + ИмяТаблицы + "] WHERE GUIDOM = '" + ИДСсылки + "' AND GUIDRow  = '" + ИДСсылкиМакета + "'";

	RecordSet.Open(Запрос,Подключение);
	
	
	Если RecordSet.RecordCount > 0 Тогда
		//Попытка
		RecordSet.MoveFirst();
		Stream.Write(RecordSet.Fields("Data").Value);
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		Stream.SaveToFile(ИмяВременногоФайла);
		
		Stream.Close();
		RecordSet.Close();
		Файл = Новый ДвоичныеДанные(ИмяВременногоФайла);
		Возврат Файл;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

