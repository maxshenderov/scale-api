&НаСервере
Функция ПолучитьСписокВидовЗаказов()  
	СписокВидовЗаказов = Новый СписокЗначений;
	Для Сч = 0 По 12 Цикл
        СписокВидовЗаказов.Добавить(Перечисления.Лико_ВидыЗаказов.Получить(Сч));
	КонецЦикла;
	Если НЕ Объект.Ссылка.Пустая() Тогда
		Если Не РольДоступна("ПолныеПрава") Тогда 
			СписокВидовЗаказов.Удалить(1);
		КонецЕсли;
	КонецЕсли; 
	// <-- Начало Лико Яцун С. В. 29.05.2024
	ПолныйповторСПеревыводомВСпискеВидовЗаказов = СписокВидовЗаказов.НайтиПоЗначению(Перечисления.Лико_ВидыЗаказов.ПолныйповторСПеревыводом);
	Если ПолныйповторСПеревыводомВСпискеВидовЗаказов <> Неопределено Тогда
		СписокВидовЗаказов.Удалить(ПолныйповторСПеревыводомВСпискеВидовЗаказов);
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 29.05.2024
	СписокВидовЗаказов.Добавить(Перечисления.Лико_ВидыЗаказов.ВнутренниеНужды);
	Возврат СписокВидовЗаказов  ;
