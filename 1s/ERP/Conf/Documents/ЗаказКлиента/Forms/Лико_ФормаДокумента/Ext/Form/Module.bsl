&НаСервере
Процедура ПроверитьЧестныеЗнаки(ТекущийОбъект) // --> Начало Лико Ефимов ЕВВ 13.05.2021
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Проверим gtin
	МассивЧестныхЗнаковЗаказа = Новый Массив;
	Для каждого Строка из Объект.Товары Цикл
		Если ЗначениеЗаполнено(Строка.ЧестныйЗнак) Тогда
			МассивЧестныхЗнаковЗаказа.Добавить(Строка.ЧестныйЗнак);
		КонецЕсли;
	КонецЦикла;
	МассивЧестныхЗнаковЗаказа = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивЧестныхЗнаковЗаказа);
	//Если МассивЧестныхЗнаковЗаказа.Количество() = 0 Тогда
	//	Возврат;
	//КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.ЧестныйЗнак КАК ЧестныйЗнак
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка <> &Ссылка
		|	И ЗаказКлиентаТовары.ЧестныйЗнак В(&МассивЧестныхЗнаков)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаТовары.ЧестныйЗнак";
	
	Запрос.УстановитьПараметр("МассивЧестныхЗнаков", МассивЧестныхЗнаковЗаказа);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	МассивЧестныхЗнаковИспользуютсяВДругихЗаказах = Новый Массив;
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивЧестныхЗнаковИспользуютсяВДругихЗаказах.Добавить(ВыборкаДетальныеЗаписи.ЧестныйЗнак);
	КонецЦикла;
	МассивЧестныхЗнаковИспользуютсяВДругихЗаказах = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивЧестныхЗнаковИспользуютсяВДругихЗаказах);
	МассивЧестныхЗнаковИзмененных = Новый Массив;
	МассивЧестныхЗнаковПройденных = Новый Массив;
	
	Для каждого Строка из Объект.Товары Цикл
		СтрокаТекущегоОбъекта = ТекущийОбъект.Товары[Строка.НомерСтроки-1];
		Если НЕ ЗначениеЗаполнено(Строка.Gtin) Тогда
			// Уберем честный знак
			СтрокаТекущегоОбъекта.ЧестныйЗнак = Неопределено;
		ИначеЕсли Строка.Gtin <> Строка.ЧестныйЗнак.Gtin ИЛИ Строка.ДатаЭмиссии <> Строка.ЧестныйЗнак.ДатаЭмиссии Тогда
			// Нужно обновлять данные. Причем если данный честный знак используется в других местах, то нужно создать новый честный знак
			Если ЗначениеЗаполнено(Строка.ЧестныйЗнак) И МассивЧестныхЗнаковИспользуютсяВДругихЗаказах.Найти(Строка.ЧестныйЗнак) = Неопределено И МассивЧестныхЗнаковПройденных.Найти(Строка.ЧестныйЗнак) = Неопределено Тогда
				// Сначала попробуем найти этот знак
				НайденныйЧестныйЗнак = Лико_Дополнительно.НайтиСоздатьЧестныйЗнак(Строка.Gtin, Строка.ДатаЭмиссии, Ложь);
				Если ЗначениеЗаполнено(НайденныйЧестныйЗнак) Тогда
					СтрокаТекущегоОбъекта.ЧестныйЗнак = НайденныйЧестныйЗнак;
				Иначе
					// Этот честный знак нигде не используется и его не меняли, изменим значение прямо в нем
					ЧестныйЗнакОбъект = СтрокаТекущегоОбъекта.ЧестныйЗнак.ПолучитьОбъект();
					ЗаполнитьЗначенияСвойств(ЧестныйЗнакОбъект, Строка, "Gtin,ДатаЭмиссии");
					ЧестныйЗнакОбъект.Наименование = Лико_ДополнительноКлиентСервер.ПолучитьНаименованиеЧестногоЗнака(ЧестныйЗнакОбъект);
					ЧестныйЗнакОбъект.Записать();
				КонецЕсли;
			Иначе
				// Этот честный знак используется в других заказах, нужно создать новый
				СтрокаТекущегоОбъекта.ЧестныйЗнак = Лико_Дополнительно.НайтиСоздатьЧестныйЗнак(Строка.Gtin, Строка.ДатаЭмиссии);
			КонецЕсли;			
		КонецЕсли;
		МассивЧестныхЗнаковПройденных.Добавить(СтрокаТекущегоОбъекта.ЧестныйЗнак);
	КонецЦикла;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 13.05.2021


&НаКлиенте
Процедура ЧестныйЗнакПриИзменении(Элемент)
	УстановитьВидимостьЭлементов(); 
	ДоступностьУтилизироватьИзлишки();
КонецПроцедуры

&НаКлиенте
Процедура РучьиПечатиПриИзменении(Элемент)
	
	Если Объект.ВидВырубки = 18 ИЛИ Объект.ВидВырубки = 19 Тогда	
		Заказ = Объект;
		ЗаполнитьПараметрыПечати(Заказ, Объект.ВидВырубки);	
	КонецЕсли;
	
	ЭтикеткиИТиражМетражНаКлиенте();

	Если Объект.ВидВырубки = 1 Тогда
		Объект.ЭтМЭР = ПолучитьЭтМЭРНаСервере();	
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.ШтампВырубной) И Объект.ВидВырубки = 0 И ВидРЦИндиго(Объект.РабочийЦентр) И ОмегаСНумератором() Тогда
		ЗаполнитьПараметрыПечатиИВырубкиОмегаСНумератором();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтикеткиИТиражМетражНаКлиенте()
	Лико_ЭтикеткиИТиражМетражНаСервере(Объект.ВидВырубки);
	ПараметрыШтампаПриИзменении();
КонецПроцедуры	

