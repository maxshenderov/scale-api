Функция ПроверкаЗаполненияПоВидуВырубки()		// --> Начало Лико Митюшин МФМ 25.03.2021
	
		ВидВырубки = ПолучитьВидВырубкиНаСервере();
	
	Если ВидВырубки = 0 Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	ЦветАвто 	= Новый Цвет();
	Коричневый = WebЦвета.Золотистый;
	
	текОшибка = Ложь;
	Для Каждого элМассива Из МассивПараметровШтампа() Цикл
		Если элМассива = Элементы.ШтампВырубнойАртикул ИЛИ элМассива = Элементы.ФормаШтампа ИЛИ элМассива = Элементы.Раппорт ИЛИ элМассива = Элементы.ВариантыДопусков ИЛИ элМассива = Элементы.ДопускМинус ИЛИ элМассива = Элементы.ДопускПлюс Тогда 
			Продолжить;
		КонецЕсли; 
		
		
		Если элМассива.ЦветФона <> ЦветАвто Тогда
			Если Не ЗначениеЗаполнено(Объект[СтрЗаменить(элМассива.ПутьКДанным, "Объект.", "")]) Тогда
				Если элМассива = Элементы.Z Тогда
					Если элМассива.ЦветФона = Коричневый ИЛИ ВидВырубки = 7 Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				текОшибка = Истина;
				Сообщить("Не заполнено поле " + элМассива.Заголовок);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат текОшибка;

