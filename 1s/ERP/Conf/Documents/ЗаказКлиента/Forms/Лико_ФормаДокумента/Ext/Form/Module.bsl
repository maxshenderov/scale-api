&НаСервере
Функция  СоздатьЗаказНаполуфабрикат(ДопПараметры)
	НовыйЗаказ =  Документы.ЗаказКлиента.СоздатьДокумент();
	НовыйЗаказ.ИнициализироватьНачальныеПараметры(Неопределено);
	НовыйЗаказ.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Полуфабрикат;
	НовыйЗаказ.Партнер = Объект.Партнер;
	НовыйЗаказ.Контрагент = Объект.Контрагент;
	НовыйЗаказ.Соглашение = Объект.Соглашение;
	НовыйЗаказ.Договор = Объект.Договор;
	НовыйЗаказ.Организация = Объект.Организация;
	НовыйЗаказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Новый;
	НовыйЗаказ.Регион = Объект.Регион;
	НовыйЗаказ.Площадка = Объект.Площадка;
	НовыйЗаказ.Валюта = Объект.Валюта;
	НовыйЗаказ.ВалютаДляДокументов = Объект.ВалютаДляДокументов;
	НовыйЗаказ.Дата = ТекущаяДата();
	НоменклатураИсходногоЗаказа = Объект.Товары[0].Номенклатура;
	
	ТЧТовары = НовыйЗаказ.Товары;
	НоваяСтрокаПФ = ТЧТовары.Добавить();
	НоваяСтрокаПФ.Номенклатура = Лико_Планирование.СоздатьНоменклатуруНаСервере(?(ДопПараметры.ОсновнойМатериал, "Оснаование ", "Вклейка ") + НоменклатураИсходногоЗаказа.Наименование, Перечисления.Лико_ТипыЭтикеток.ЭТ, Объект.Регион, Объект.Партнер);
	НоваяСтрокаПФ.КоличествоУпаковок = Объект.Товары[0].КоличествоУпаковок;
	НоваяСтрокаПФ.Количество = Объект.Товары[0].Количество;
	НовыйЗаказ.Записать();
	Возврат НовыйЗаказ.Ссылка;	
КонецФункции


