&НаКлиенте
Перем ДобавлениеСтроки;
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("КорректировкаЦветов") Тогда	
		Элементы.ВидыРабот.Видимость=Ложь;
		Элементы.Цвета.ИзменятьСоставСтрок=Ложь;
	Иначе
		Элементы.Цвета.ИзменятьСоставСтрок=Истина;
		
		Если Параметры.Свойство("НомерПроката") Тогда
			НомерПроката =  Параметры.НомерПроката;
		КонецЕсли;
		
	КонецЕсли;
	ДобавитьУсловноеОформление();

	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЗаказ(Команда)
	неЗаписывать=Ложь;
	Для Каждого стр из Объект.Цвета Цикл
		Если стр.номерпроката = НомерПроката И ЗначениеЗаполнено(стр.ТипКраски) и Не ЗначениеЗаполнено(стр.ТипКраскиФакт) Тогда 
			неЗаписывать=Истина;
			
			НомерСтроки=Строка(Объект.Цвета.Индекс(стр));	
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не заполнен тип краски в строке № "+ стр.номерстроки;
			Сообщение.Поле = "Объект.Цвета["+НомерСтроки+"].ТипКраскиФакт"; //имя реквизита 
			Сообщение.УстановитьДанные(Объект); //Ссылка на объект ИБ
			Сообщение.Сообщить();
			
			//Сообщить("Не заполнен тип краски в строке № "+ стр.номерстроки);
			//Возврат;
		КонецЕсли;
	КонецЦикла;	
	Для Каждого стр из Объект.ВидыРабот Цикл
		Если стр.номерпроката = НомерПроката И ЗначениеЗаполнено(стр.Клей) и Не ЗначениеЗаполнено(стр.КлейФакт) Тогда 
			
			неЗаписывать=Истина;
			
			НомерСтроки=Строка(Объект.ВидыРабот.Индекс(стр));	
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не заполнен тип клей в строке № "+ стр.номерстроки;
			Сообщение.Поле = "Объект.ВидыРабот["+НомерСтроки+"].КлейФакт"; //имя реквизита 
			Сообщение.УстановитьДанные(Объект); //Ссылка на объект ИБ
			Сообщение.Сообщить();
			
			//Сообщить("Не заполнен тип клей в строке № "+ стр.номерстроки);
			//Возврат;
		КонецЕсли;
	КонецЦикла;
	Если неЗаписывать Тогда
		Возврат;
	КонецЕсли;
	
	Объект.УтвердилРаботы = ПользователиКлиентСервер.ТекущийПользователь(); 
	Объект.ДатаУтвержденияРабот = ТекущаяДата();
	Объект.УтвердилЦвета = ПользователиКлиентСервер.ТекущийПользователь(); 
	Объект.ДатаУтвержденияЦветов = ТекущаяДата();
	УстановкаПараметраЗагрузка();
	Модифицированность=ЛОжь;
	//Записать(Новый Структура("РежимЗаписи,Лико_Загрузка",РежимЗаписиДокумента.Запись,Истина));
	Закрыть(Истина);
КонецПроцедуры

&НаСервере
Процедура УстановкаПараметраЗагрузка() //+Лико m.shenderov 12.10.2019
	
	РеквизитОбъект=РеквизитФормыВЗначение("Объект");
	РеквизитОбъект.ОбменДанными.Загрузка=Истина;
	РеквизитОбъект.Записать();
	
КонецПроцедуры  //-Лико m.shenderov 12.10.2019


