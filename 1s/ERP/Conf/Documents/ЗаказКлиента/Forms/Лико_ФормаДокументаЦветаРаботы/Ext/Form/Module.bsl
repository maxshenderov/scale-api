&НаКлиенте
Процедура ЦветаПередУдалением(Элемент, Отказ)
	текстр = Элементы.цвета.текущиеданные;
	Если текстр.номерпроката <>НомерПроката Тогда 
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидыРаботПередУдалением(Элемент, Отказ)
	текстр = Элементы.ВидыРабот.текущиеданные;
	Если текстр.номерпроката <>НомерПроката Тогда 
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

