&НаСервере
Процедура НаправитьВРаботуНаСервере()
	
	НачатьТранзакцию();	
	Если Объект.СтатусЗаказаНаПроизводствоОснасткиОснастки=Перечисления.Лико_СтатусыЗаказаНаПроизводствоОснастки.ВключенВПлан Тогда		
		Статус=Перечисления.Лико_СтатусыЗаказаНаПроизводствоОснастки.Программирование;
		Этап=Справочники.Лико_ЭтапыВыполненияЗаказа.Программирование;
	ИначеЕсли Объект.СтатусЗаказаНаПроизводствоОснасткиОснастки=Перечисления.Лико_СтатусыЗаказаНаПроизводствоОснастки.Программирование Тогда 
		Статус=Перечисления.Лико_СтатусыЗаказаНаПроизводствоОснастки.ГотовКГравировке;
		Этап=Справочники.Лико_ЭтапыВыполненияЗаказа.ГотовКГравировке;
		
	КонецЕсли;	
	ЗаписатьСтатусВЗаказСервер(Объект.Ссылка,Статус);
	
	Лико_ОбщегоНазначенияСервер.ЗаписатьРСЛико_ЭтапыЗаказа(
															Объект.Ссылка,
															Объект.Площадка,
															Этап,
															ТекущаяДата(),
															Новый Структура("Ответственный,Количество",Пользователи.ТекущийПользователь(),1)	
														  );
	
	
	ЗафиксироватьТранзакцию();	
	
КонецПроцедуры


&НаСервереБезКонтекста
Процедура ЗаписатьСтатусВЗаказСервер(Заказ,Статус) //+Лико m.shenderov 01.09.2021
	
	ДокОбъект=Заказ.ПолучитьОбъект();
	ДокОбъект.СтатусЗаказаНаПроизводствоОснасткиОснастки=Статус;
	ДокОбъект.ОбменДанными.Загрузка=Истина;
	ДокОбъект.Записать(); 
	Если Статус<>Перечисления.Лико_СтатусыЗаказаНаПроизводствоОснастки.Программирование Тогда 
		Документы.Лико_ЗаказОснастки.ОснасткаСоздатьСообщение(Заказ);
	КонецЕсли;
	
КонецПроцедуры //-Лико m.shenderov 01.09.2021


//+ Лико m.shenderov 02.09.2021
&НаСервереБезКонтекста
Процедура ОснасткаСоздатьСообщение(Заказ) //+Лико m.shenderov 02.09.2021
	УстановитьПривилегированныйРежим(Истина);	
	Если Заказ.СтатусЗаказаНаПроизводствоОснасткиОснастки=Перечисления.Лико_СтатусыЗаказаНаПроизводствоОснастки.Программирование  Тогда		
		ЗаголовокСообщения="готов к программированию.";
		ТипСообщения=Справочники.Лико_ТипыСообщений.ПрограммированиеОснастки;		
	Иначе
		ЗаголовокСообщения="готов к гравировке.";
		ТипСообщения=Справочники.Лико_ТипыСообщений.ГотовКГравировкеОснастки;		
	КонецЕсли;
	
	Текст =  СтрШаблон("Заказ N %1 %2",Заказ.НомерБезПрефикса,ЗаголовокСообщения);
	
	Тема  = Текст;
	Текст=Текст+ Символы.ПС+ "Ссылка : "+Символы.ПС+Символы.ВК+ПолучитьНавигационнуюСсылку(Заказ.Ссылка);
	Для каждого Товар  Из Заказ.Товары  Цикл
		Текст=Текст+Символы.ПС+Символы.ВК;
		Текст=Текст+ "        Номенклатура :  "+ СокрЛП(Товар.Номенклатура.Артикул)+" "+Строка(Товар.Номенклатура.Наименование);			
	КонецЦикла;	
	Текст=Текст+Символы.ПС+Символы.ВК;
	Текст=Текст+Заказ.Комментарий+Символы.ПС+Символы.ВК;
	
	
	Адресат = Справочники.Лико_ТипыСообщений.ПолучитьПочтовыеАдреса(ТипСообщения,Заказ.Площадка); 		
	
	Лико_Планирование.ОтправитьПисьмо(Текст, Тема, Адресат,,"textBody"); 
	
	
	
КонецПроцедуры //-Лико m.shenderov 02.09.2021


&НаСервере
Процедура УстановитьНазаваниеРаботы() //+Лико m.shenderov 31.08.2021
	
	Элементы.ФормаНаправитьВРаботу.Видимость=Истина;
	
	Если Объект.СтатусЗаказаНаПроизводствоОснасткиОснастки=ПредопределенноеЗначение("Перечисление.Лико_СтатусыЗаказаНаПроизводствоОснастки.ВключенВПлан") ТОгда
		Элементы.ФормаНаправитьВРаботу.Заголовок="Взять в работу";
		Элементы.Разработчик.АвтоОтметкаНезаполненного        =Истина;
		Элементы.ТрудозатратыЧас.АвтоВыборНезаполненного      =Ложь;
		Элементы.ТрудозатратыМин.АвтоВыборНезаполненного      =Ложь;
		
		Элементы.ВремяРаботыСтанкаЧас.АвтоВыборНезаполненного =Ложь;
		Элементы.ВремяРаботыСтанкаМин.АвтоВыборНезаполненного =Ложь;


	ИначеЕсли Объект.СтатусЗаказаНаПроизводствоОснасткиОснастки=ПредопределенноеЗначение("Перечисление.Лико_СтатусыЗаказаНаПроизводствоОснастки.Программирование") ТОгда
		
		Элементы.ФормаНаправитьВРаботу.Заголовок="Готов к гравировке";
		Элементы.Трудозатраты.АвтоОтметкаНезаполненного      =Истина;
		Элементы.Разработчик.АвтоОтметкаНезаполненного       =Истина;
		Элементы.ВремяРаботыСтанка.АвтоОтметкаНезаполненного =Истина;
		Элементы.ЗаготовкаРазмер1.АвтоОтметкаНезаполненного  =Истина;
		Элементы.ЗаготовкаРазмер2.АвтоОтметкаНезаполненного  =Истина;
		
		//Элементы.ТрудозатратыЧас.АвтоВыборНезаполненного     =Истина;
		//Элементы.ТрудозатратыМин.АвтоВыборНезаполненного     =Истина;
		//
		//Элементы.ВремяРаботыСтанкаЧас.АвтоВыборНезаполненного =Истина;
		//Элементы.ВремяРаботыСтанкаМин.АвтоВыборНезаполненного =Истина;

	Иначе
		Элементы.ФормаНаправитьВРаботу.Видимость              =Ложь;
	КонецЕсли;
	
	
	
КонецПроцедуры //-Лико m.shenderov 31.08.2021


&НаСервере
Функция ПроверкаЗаполненияПолей() //+Лико m.shenderov 28.04.2021
	Результат=Истина;
	Если Объект.СтатусЗаказаНаПроизводствоОснасткиОснастки=ПредопределенноеЗначение("Перечисление.Лико_СтатусыЗаказаНаПроизводствоОснастки.ВключенВПлан") Тогда
	
		СообщитьПользователю(Объект.Разработчик,"Объект.Разработчик","Разработчик",Результат);
			КонецЕсли;
	Если Объект.СтатусЗаказаНаПроизводствоОснасткиОснастки=ПредопределенноеЗначение("Перечисление.Лико_СтатусыЗаказаНаПроизводствоОснастки.Программирование") Тогда
		СообщитьПользователю(Объект.Трудозатраты,"ТрудозатратыЧас","Трудозатраты",Результат);
		СообщитьПользователю(Объект.Разработчик,"Объект.Разработчик","Разработчик",Результат);
		СообщитьПользователю(Объект.ВремяРаботыСтанка,"ВремяРаботыСтанкаЧас","Время работы станка",Результат);
		СообщитьПользователю(Объект.ЗаготовкаРазмер1,"Объект.ЗаготовкаРазмер1","Ширина заготовки",Результат);
		СообщитьПользователю(Объект.ЗаготовкаРазмер2,"Объект.ЗаготовкаРазмер2","Высота загатовки",Результат); 	
	КонецЕсли;

	Возврат Результат;	
КонецФункции //-Лико m.shenderov 28.04.2021 


