&НаКлиенте
Асинх Процедура НаправитьВРаботуКлиент() //+Лико m.shenderov 07.09.2021
	 Отказ=Ложь;
	Отказ=Не ПроверкаЗаполненияПолей();
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Если ЭтаФорма.Модифицированность Тогда
			//Сообщить("Необходимо записать документ!");
			//Возврат;
			Записать();
		КонецЕсли;
		
		//Вопрос
		Если Объект.Состояние = ПредопределенноеЗначение("Перечисление.Лико_СостоянияЗаказов.Выполнен")  ИЛИ Объект.Состояние= ПредопределенноеЗначение("Перечисление.Лико_СостоянияЗаказов.Закрыт") Тогда
			Сообщить ("Данный заказ уже выполнен!");
			Возврат;
		КонецЕсли; 		
		
		ЕСли Объект.СтатусЗаказаНаПроизводствоОснасткиОснастки=ПредопределенноеЗначение("Перечисление.Лико_СтатусыЗаказаНаПроизводствоОснастки.ВключенВПлан") Тогда
			ТекстВопроса="Взять в работу заказ?";
		Иначе
				ТекстВопроса="Заказ готов к гравировке?";
		КонецЕсли;
		
		Если Отказ Тогда 
			Возврат;
		КонецЕсли;  	
			
		
		Режим = РежимДиалогаВопрос.ДаНет;
		
		Ответ = Ждать ВопросАсинх(НСтр(СтрШаблон("ru = '%1'",ТекстВопроса)), Режим, 0);
		
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
		НаправитьВРаботуНаСервере();
		
	Иначе
		Сообщить("Необходимо записать заказ!");
		Возврат;
	КонецЕсли;
	Если Не Отказ Тогда 
		ЭтаФорма.Закрыть();
	КонецЕсли;

КонецПроцедуры //-Лико m.shenderov 07.09.2021

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	Если ПересчитатьПлан Тогда 
	ПересчитатьПлан=Ложь;	
	РабочийЦентПланирования=ПолучитьРабочийЦентрЗаказВПланеСервер();
		Если ЗначениеЗаполнено(РабочийЦентПланирования) Тогда
			Массив = Новый Массив();
			Массив.Добавить(РабочийЦентПланирования);
			Лико_Дополнительно.ПересчитатьМассивРЦВПлане(Массив);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

