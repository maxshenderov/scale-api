&НаСервере
Процедура ДобавлениеУсловногоОформления(РазмерТаблицы)
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ОтборУО = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУО.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаСекции.Колонка_" + РазмерТаблицы + "Доступность");
	ОтборУО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборУО.ПравоеЗначение = Истина;
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаСекцииКолонка_" + РазмерТаблицы);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.НейтральноЗеленый);
	
	//Добавочное УО когда Количество 0
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ОтборУО = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУО.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Колонка_" + РазмерТаблицы + "Количество");
	ОтборУО.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	ОтборУО.ПравоеЗначение = 0;
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаСекцииКолонка_" + РазмерТаблицы);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Перламутровый);
	
	//Добавочное УО когда Количество 0 И чтобы были видны доступные поля
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ГруппаОтбора           = ЭлементУО.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	ОтборУО = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУО.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаСекции.Колонка_" + РазмерТаблицы + "Доступность");
	ОтборУО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборУО.ПравоеЗначение = Истина;  
	ОтборУО.Использование  = Истина;
	
	ОтборУО = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУО.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Колонка_" + РазмерТаблицы + "Количество");
	ОтборУО.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	ОтборУО.ПравоеЗначение = 0;   
	ОтборУО.Использование  = Истина;
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаСекцииКолонка_" + РазмерТаблицы);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лимонный);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСекцииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Элемент.ТекущиеДанные.Секция) Тогда
		Сообщить("Вид секции не задан!");    
		Возврат;
	КонецЕсли;

	текПараметрыВыбора = Новый Структура;
	текПараметрыВыбора.Вставить("РежимВыбора", Истина);
	текПараметрыВыбора.Вставить("МножественныйВыбор", Ложь);	
	текПараметрыВыбора.Вставить("Секция", Элемент.ТекущиеДанные.Секция);
	текПараметрыВыбора.Вставить("ПараметрыСекции", Элемент.ТекущиеДанные.Параметры);

	ОбработкаВыбора = Новый ОписаниеОповещения("ПриЗакрытииФормыРедактированиеПараметровСекции", ЭтотОбъект,"Подбор");

	ОткрытьФорму("Справочник.Лико_ВидыСекций.Форма.Лико_РедактированиеПараметровСекции",текПараметрыВыбора,
	        ЭтаФорма, , , , ОбработкаВыбора);
			
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыРедактированиеПараметровСекции(Значение, ДопПараметры) Экспорт 
	
	Если Не ЗначениеЗаполнено(Значение) Тогда 
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
    Элементы.ТаблицаСекции.ТекущиеДанные.Параметры = Значение;
	СтруктураПараметров = ЗначениеИзСтрокиВнутрНаСервере(Значение);
	
	Элементы.ТаблицаСекции.ТекущиеДанные.ПараметрыПредставление = ПолучитьПредставлениеПараметра(СтруктураПараметров);
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПредставлениеПараметра(СтруктураПараметров)
	текТекст = "";
	
	Для Каждого текПарамер из СтруктураПараметров Цикл
		текТекст = текТекст + текПарамер.Ключ + ": " + текПарамер.Значение + ", ";
	КонецЦикла;
	
	Если текТекст <> "" Тогда
		текТекст = Лев(текТекст, СтрДлина(текТекст) - 2);
	КонецЕсли;
	Возврат текТекст;
КонецФункции

&НаСервере
Функция ПолучитьПредставлениеПараметраНаСервере(СтруктураПараметров)
	текТекст = "";
	
	Для Каждого текПарамер из СтруктураПараметров Цикл
		текТекст = текТекст + текПарамер.Ключ + ": " + текПарамер.Значение + ", ";
	КонецЦикла;
	
	Если текТекст <> "" Тогда
		текТекст = Лев(текТекст, СтрДлина(текТекст) - 2);
	КонецЕсли;
	Возврат текТекст;
КонецФункции

&НаКлиенте
Процедура ТаблицаСекцииИспользуетсяПриИзменении(Элемент)
	текТекущиеДанные = Элементы.ТаблицаСекции.ТекущиеДанные;
	Если Не текТекущиеДанные.Используется И (ЗначениеЗаполнено(текТекущиеДанные.ПараметрыПредставление)
