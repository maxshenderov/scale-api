		текТекущиеДанные.Параметры = "";
		текТекущиеДанные.ПараметрыПредставление = "";
	КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьИЗакрыть(Команда)
	ПередаваемыеДанные  = ПолучитьСекции();
    Оповестить("ПередаваемыеДанные",ПередаваемыеДанные,);
