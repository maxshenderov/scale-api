&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт 
    Если Результат = КодВозвратаДиалога.Да Тогда
		Закрыть();
	Иначе
		Возврат;
    КонецЕсли;	 
КонецПроцедуры

&НаСервере
Функция ПолучитьСекции()
	текТЗ = ТаблицаСекции.Выгрузить();

	МассивДанных = Новый Массив;
	
	Для Каждого СтрокаТЗ из текТЗ Цикл		
		СтруктураДанных = Новый Структура;
		
		Если ЗначениеЗаполнено(СтрокаТЗ.Параметры) Тогда 
			Для Каждого СтрПараметры из ЗначениеИзСтрокиВнутрНаСервере(СтрокаТЗ.Параметры) Цикл 
				СтруктураДанных.Вставить(СтрПараметры.Ключ , СтрПараметры.Значение);
			КонецЦикла;
		КонецЕсли;
		
		СтруктураДанных.Вставить("НомерПроката", НомерПроката);
		СтруктураДанных.Вставить("НомерВарианта", 1);
		СтруктураДанных.Вставить("РабочийЦентр", РабочийЦентр);
		СтруктураДанных.Вставить("ВидСекции", 	СтрокаТЗ.Секция);
		СтруктураДанных.Вставить("Номер", 		СтрокаТЗ.Номер);
		
		МассивДанных.Добавить(СтруктураДанных);
	КонецЦикла;	
	
    Возврат МассивДанных; 
КонецФункции

&НаКлиенте
Процедура ОбходДереваТаблицаДопСекций()
	//Разворачиваем все Эллементы
	ЭлементыДерева = ТаблицаДопСекций.ПолучитьЭлементы();
	МассивИндексовУдаляемыхСтрок = Новый Массив;
	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
        Элементы.ТаблицаДопСекций.Развернуть(ЭлементДерева.ПолучитьИдентификатор(), Истина);
		//ЭлементДерева - строка Первого уровня
		//ПодСтроки - строка Второго уровня уровня
		ПодСтроки = ЭлементДерева.ПолучитьЭлементы();
		Если  ПодСтроки.Количество() > 1 Тогда 
			ЭтоПервый = Истина;
			Для каждого ЭлементПодДерева  из ПодСтроки Цикл
				Если ЭтоПервый Тогда 
					ЭтоПервый = Ложь;
					ЗаполнитьЗначенияСвойств(ЭлементДерева, ЭлементПодДерева);
					ЭлементДерева.ВидыРабот = Неопределено;
					ЭлементДерева.Параметры = ЗаполнитьПараметрыСекций(ЭлементПодДерева);
				КонецЕсли;
				ЭлементПодДерева.Количество = 0;				
			КонецЦикла;
		Иначе 
			//В групперовке всего 1на строка
			Для каждого ЭлементПодДерева из ПодСтроки Цикл
				ЗаполнитьЗначенияСвойств(ЭлементДерева, ЭлементПодДерева);
				ЭлементДерева.ВидыРабот = Неопределено;
				ЭлементДерева.Параметры = ЗаполнитьПараметрыСекций(ЭлементПодДерева);
				ПодСтроки.Удалить(0);	
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьПараметрыСекций(СтрокаСПараметрами)
	СтрокаПараметры = "";
	ЭтоЕдинственный = Истина;
	Для РазмерТаблицы = 1 По 20 Цикл
		Если СтрокаСПараметрами["Номер" + РазмерТаблицы] Тогда
			СтрокаПараметры = СтрокаПараметры + Строка(РазмерТаблицы) + ", ";
			Если ЭтоЕдинственный Тогда 
				ЭтоЕдинственный = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Не ЭтоЕдинственный Тогда 
		СтрокаПараметры = Лев(СтрокаПараметры, СтрДлина(СтрокаПараметры)-2);
	КонецЕсли;
	
	Возврат СтрокаПараметры;
КонецФункции

&НаКлиенте
Процедура ТаблицаСекцииПередНачаломИзменения(Элемент, Отказ)
	
	ИсхИмя = ТекущийЭлемент.ТекущийЭлемент.Имя;
	текИмя = СтрЗаменить(ИсхИмя, "ТаблицаСекции", "");	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Номер", Элемент.ТекущиеДанные.Номер);
	НайденныеСтроки = ТаблицаСекции.НайтиСтроки(ПараметрыОтбора);
	
	ЭтоКолонкаПараметров = СтрНайти(ИсхИмя, "ТаблицаСекцииКолонка_") <> 0;
	
	Если НЕ ЭтоКолонкаПараметров Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ЭтоКолонкаПараметров И НЕ НайденныеСтроки[0][текИмя+"Доступность"] Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ИсхИмя <> текИмя Тогда 
		Если (ЭтаФорма[текИмя+"Количество"] = 0 И (НЕ НайденныеСтроки[0][текИмя])) тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСекцииКолонкиСекцийПриИзменении(Элемент)
	ИмяТекЭлемента 	= Элемент.ТекущийЭлемент.Имя;
	ИмяПоля 		= "Колонка_";
		
	Если  СтрНайти(ИмяТекЭлемента, ИмяПоля) = 0 Тогда
		Возврат;
	КонецЕсли;
	ИмяТаблицы 		= "ТаблицаСекции";
	ИмяКоличество 	= "Количество";

	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Номер", Элемент.ТекущиеДанные.Номер);
	НайденныеСтроки = ТаблицаСекции.НайтиСтроки(ПараметрыОтбора);
	
	текСтрокаТаблицыСекции = НайденныеСтроки[0];
	текИмяКолонки = СтрЗаменить(имяТекЭлемента, ИмяТаблицы, "");
	текКоличествоВПадвале = ЭтаФорма[текИмяКолонки+ИмяКоличество];
	ТекЗначение = текСтрокаТаблицыСекции[текИмяКолонки];
	
	Если Не ТекЗначение Тогда 
		текСтрокаТаблицыСекции.Параметры = "";
		текСтрокаТаблицыСекции.ПараметрыПредставление = "";
		текСтрокаТаблицыСекции.Секция = Неопределено;
		ЭтаФорма[текИмяКолонки+ИмяКоличество] = текКоличествоВПадвале + 1;
		Возврат;
	КонецЕсли;
	
	ТекНомерСекции = Число(СтрЗаменить(имяТекЭлемента, ИмяТаблицы + ИмяПоля, ""));
	
	Для ТекКолонка = 1 По ЧислоСекций Цикл
		Если ТекНомерСекции = ТекКолонка Тогда 
			текСтрокаТаблицыСекции.Секция = ПолучитьВидСекцийНаСервере(Элемент.ТекущийЭлемент.Подсказка);
			СтруктураЭлементов = Новый Структура;
			СтруктураЭлементов.Вставить("Секция", текСтрокаТаблицыСекции.Секция); 	
			текСтрокаТаблицыСекции.Параметры = ЗначениеВСтрокуВнутрНаСервере(СтруктураЭлементов);
			текСтрокаТаблицыСекции.ПараметрыПредставление = ПолучитьПредставлениеПараметра(СтруктураЭлементов);
			Продолжить;
		КонецЕсли;
		КолонкаТаблицы = текСтрокаТаблицыСекции[ИмяПоля + ТекКолонка];
		Если КолонкаТаблицы Тогда 
			текСтрокаТаблицыСекции[ИмяПоля + ТекКолонка] = Ложь;
			текНовоеКоличество = ЭтаФорма[ИмяПоля + ТекКолонка+ИмяКоличество] + 1;
			ЭтаФорма[ИмяПоля + ТекКолонка+ИмяКоличество] = текНовоеКоличество;
		КонецЕсли;
	КонецЦикла;
	
	ЭтаФорма[текИмяКолонки+ИмяКоличество] = текКоличествоВПадвале - 1;
	
КонецПроцедуры

&НаСервере
Функция ЗначениеВСтрокуВнутрНаСервере(СтруктураЭлементов)
	Возврат ЗначениеВСтрокуВнутр(СтруктураЭлементов);
КонецФункции

&НаСервере
Функция  ЗначениеИзСтрокиВнутрНаСервере(Значение)
	Возврат ЗначениеИзСтрокиВнутр(Значение);
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицаСекцииПриОткрытии(пМассивДопСекций)
	МассивСекций = Новый Массив;
	Для текКолонка = 1 По ЧислоСекций Цикл
		МассивСекций.Добавить(Элементы.ТаблицаСекции.ПодчиненныеЭлементы["ТаблицаСекцииКолонка_" + текКолонка].Заголовок);
	КонецЦикла;
	
	ТекТабСекции = РеквизитФормыВЗначение("ТаблицаСекции");
	ПолученнаяТЗ = ЗначениеИзСтрокиВнутрНаСервере(ДанныеПоСекциям);
	
	
	Для каждого ТекСтр из ПолученнаяТЗ Цикл
		текНомерСекции = МассивСекций.Найти(Строка(ТекСтр.ВидСекции));
		Если текНомерСекции = Неопределено  Тогда
			Если СтрНайти(ТекСтр.Номер, "/") = 0 Тогда 
				Продолжить;
			Иначе
				//Тут доп секции
				ДобавитьДопСекцииВМассив(пМассивДопСекций, ТекСтр);
			КонецЕсли;
		Иначе 
			Если СтрНайти(ТекСтр.Номер, "/") = 0 Тогда 
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Номер", ТекСтр.Номер);
				НайденныеСтроки = ТекТабСекции.НайтиСтроки(ПараметрыОтбора);
				//Значение должно быть одно если оно найдено или не быть вовсе
				Если НайденныеСтроки.Количество() = 0 Тогда 
					Продолжить;
				КонецЕсли;
				НайденныеСтроки[0]["Колонка_"+(текНомерСекции+1)] = Истина;
				
				этаформа["Колонка_"+(текНомерСекции+1)+"количество"] = этаформа["Колонка_"+(текНомерСекции+1)+"количество"] - 1;

				ЗаполнитьПараметрыПоСтроке(ТекСтр, НайденныеСтроки[0]);
			Иначе 
				//Тут доп секции, и вид Секции совпадает с одной из колонок!
				ДобавитьДопСекцииВМассив(пМассивДопСекций, ТекСтр);
			КонецЕсли;		
		КонецЕсли;	
	КонецЦикла;
	ЗначениеВРеквизитФормы(ТекТабСекции, "ТаблицаСекции");
	ДанныеПоСекциям = "";
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыПоСтроке(ТекСтрИзТЗ, НоваяСтрокаПарам, пНомер = "")
	НоваяСтрокаПарам.Секция = ТекСтрИзТЗ.ВидСекции;
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Секция", ТекСтрИзТЗ.ВидСекции);
	Для каждого ПараметрСекции Из ТекСтрИзТЗ.ВидСекции.ПараметрыСекций Цикл
		текНаименованиеПараметра = ПараметрСекции.ПараметрСекции.Наименование;
		Попытка
			Если ЗначениеЗаполнено(ТекСтрИзТЗ[текНаименованиеПараметра]) Тогда
				СтруктураПараметров.Вставить(текНаименованиеПараметра, ТекСтрИзТЗ[текНаименованиеПараметра]);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	НоваяСтрокаПарам.Параметры = ЗначениеВСтрокуВнутрНаСервере(СтруктураПараметров);
	НоваяСтрокаПарам.ПараметрыПредставление = ПолучитьПредставлениеПараметраНаСервере(СтруктураПараметров);
	Если пНомер <> "" Тогда
		НоваяСтрокаПарам.Номер = пНомер;
	КонецЕсли;
КонецПроцедуры
			
