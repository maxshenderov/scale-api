&НаКлиенте
Процедура ТаблицаСекцииПередУдалением(Элемент, Отказ)
	Если Элемент.ТекущиеДанные.ТипСекции = ПредопределенноеЗначение("Перечисление.Лико_ТипСекции.Основная") Тогда
		Отказ = Истина;
		Возврат;
	Иначе
		ЭлементыДерева = ТаблицаДопСекций.ПолучитьЭлементы();
		Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
			//ЭлементДерева - строка Первого уровня
			//ПодСтроки - строка Второго уровня уровня
			Если Элемент.ТекущиеДанные.Секция = ЭлементДерева.Секция Тогда
				 ЭлементДерева.Количество = ЭлементДерева.Количество + 1;
				 Прервать;
			КонецЕсли;
			СекцияБылаНайдена = Ложь; 
			ПодСтроки = ЭлементДерева.ПолучитьЭлементы();
			Если  ПодСтроки.Количество() > 0 Тогда 
				ЭтоПервый = Истина;
				Для каждого ЭлементПодДерева  из ПодСтроки Цикл
					Если Элемент.ТекущиеДанные.Секция = ЭлементПодДерева.ВидыРабот Тогда
						ЭлементДерева.Количество = ЭлементДерева.Количество + 1;
						СекцияБылаНайдена = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если СекцияБылаНайдена Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ЧислоУдаленныхСтрок = ЧислоУдаленныхСтрок + 1;
	КонецЕсли;
КонецПроцедуры

