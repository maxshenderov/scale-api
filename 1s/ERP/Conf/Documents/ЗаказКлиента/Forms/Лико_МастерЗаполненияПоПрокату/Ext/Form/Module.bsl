	ИзменитьВидимостьРабочийЦентр();
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВидимостьРабочийЦентр()
	Элементы.РабочийЦентр.Видимость = ЗначениеЗаполнено(НомерПроката);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	текПараметрыВыбора = Новый Структура;
	текПараметрыВыбора.Вставить("РежимВыбора", Истина);
	текПараметрыВыбора.Вставить("МножественныйВыбор", Ложь);
	текПараметрыВыбора.Вставить("Площадка", фПлощадка);
	
	Если Не ЗначениеЗаполнено(РабочийЦентр) Тогда
		ОбработкаВыбора = Новый ОписаниеОповещения("ПриЗакрытииФормыВыбора", ЭтотОбъект,"Подбор");
		
		ОткрытьФорму("Справочник.РабочиеЦентры.Форма.Лико_ФормаВыбора",текПараметрыВыбора,
		ЭтаФорма, , , , ОбработкаВыбора);
	Иначе 
		ЗаполнитьТаблицыПоРЦ();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыВыбора(Значение, ДопПараметры) Экспорт	
	Если Значение = Неопределено Тогда
		ЭтаФорма.Закрыть();
        Возврат;
    КонецЕсли;
	
	РабочийЦентр = Значение;

	ЗаполнитьТаблицыПоРЦ();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицыПоРЦ()
	
	Если Не ЗначениеЗаполнено(НомерПроката) Тогда
		НомерПроката = 1;
	КонецЕсли;
	
	ЭтоОшибка = Ложь;
	ЗаполнитьТаблицуСекцийНаСервере(ЭтоОшибка);
		
	Если ЭтоОшибка Тогда
		ЭтаФорма.Закрыть();
	КонецЕсли;	
	
	МассивДопСекций = Новый Массив;
	Если ЗначениеЗаполнено(ДанныеПоСекциям) Тогда
		ЗаполнитьТаблицаСекцииПриОткрытии(МассивДопСекций);
		НомерНачальнойСтроки = ЭтаФорма.ТаблицаСекции[0].ПолучитьИдентификатор(); 
	КонецЕсли;
	
	НомерКонечнойСтроки = ЭтаФорма.ТаблицаСекции[ТаблицаСекции.Количество()-1].ПолучитьИдентификатор();
	
	ОбходДереваТаблицаДопСекций();
	
	Если МассивДопСекций.Количество() <> 0 Тогда 
		Для Каждого элМассива из МассивДопСекций Цикл
			НовСтр = ТаблицаСекцийДобавитьСтроку(Лев(элМассива.Номер, СтрНайти(элМассива.Номер, "/")-1));
			ЗаполнитьЗначенияСвойств(НовСтр, элМассива);			
			//Изменяем данные в таблице источнике	
			УдалениеСтрокКоличестваВДопСекциях(НовСтр);
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалениеСтрокКоличестваВДопСекциях(НовСтр)
	ЭлементыДерева = ТаблицаДопСекций.ПолучитьЭлементы();
	СекцияБылаНайдена = Ложь;
	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		Если СекцияБылаНайдена Тогда
			Прервать;
		КонецЕсли;
		//ЭлементДерева - строка Первого уровня
		//ПодСтроки - строка Второго уровня уровня
		Если НовСтр.Секция = ЭлементДерева.Секция Тогда
			Если ЭлементДерева.Количество <> 0 Тогда
				ЭлементДерева.Количество = ЭлементДерева.Количество - 1;
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
		ПодСтроки = ЭлементДерева.ПолучитьЭлементы();
		Если ПодСтроки.Количество() > 0 Тогда 
			Для каждого ЭлементПодДерева  из ПодСтроки Цикл
				Если НовСтр.Секция = ЭлементПодДерева.ВидыРабот И  ЭлементДерева.Количество <> 0 Тогда
					ЭлементДерева.Количество = ЭлементДерева.Количество - 1;
					СекцияБылаНайдена = Истина;
					Прервать;
				ИначеЕсли НовСтр.Секция = ЭлементПодДерева.ВидыРабот И ЭлементПодДерева.Количество <> 0 Тогда
					ЭлементПодДерева.Количество = ЭлементПодДерева.Количество - 1;
					СекцияБылаНайдена = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если СекцияБылаНайдена Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("РабочийЦентр") Тогда
		РабочийЦентр = Параметры.РабочийЦентр; 
		НомерПроката = Параметры.НомерПроката;
			
		Если Параметры.Свойство("ТЗСекции") Тогда
			ДанныеПоСекциям = Параметры.ТЗСекции;
		КонецЕсли;
	
	Иначе 		
		НомерПроката = Параметры.НомерПроката + 1;
	КонецЕсли;
	фПлощадка = Параметры.Площадка;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСекцийНаСервере(ЭтоОшибка = Ложь)	

	Пакет = ПолучитьТаблицуСекцийПоРЦ(РабочийЦентр);
	
	ТаблицаРезультат = Пакет[1].Выгрузить();
	Если ТаблицаРезультат.Количество() = 0 Тогда 
		ЭтоОшибка = Истина;
		Сообщить("Для данного РЦ не указанны Секции");
		Возврат;
	КонецЕсли;	
	//Определение параметров	
	ИмяПоля 			= "Колонка_";
	ИмяКоличество 		= "Количество";
	ИмяТаблицы 			= "ТаблицаСекции";
	ТипСекцииОсновная 	= Перечисления.Лико_ТипСекции.Основная;
	
	ЭлементТаблица = Элементы.ТаблицаСекции;
	
	ОписаниеБулева = Новый ОписаниеТипов("Булево");
	ОписаниеЧисла = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4,0));
	МассивРеквизитов = Новый Массив;
	
	РазмерТаблицы = 1;
	Для Каждого Строка Из ТаблицаРезультат Цикл
		СтрокаВид = Строка.ВидыРабот.Наименование;
		
		МассивРеквизитов.Добавить(Новый РеквизитФормы(ИмяПоля + РазмерТаблицы, ОписаниеБулева, ИмяТаблицы, СтрокаВид));
		МассивРеквизитов.Добавить(Новый РеквизитФормы(ИмяПоля + РазмерТаблицы + "Доступность", ОписаниеБулева, ИмяТаблицы, СтрокаВид + "Доступность"));
		МассивРеквизитов.Добавить(Новый РеквизитФормы(ИмяПоля + РазмерТаблицы + ИмяКоличество, ОписаниеЧисла));

		РазмерТаблицы = РазмерТаблицы + 1;	
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивРеквизитов);  
	//Заполнение таблицы Доп в дерево
    ЗначениеВДанныеФормы(Пакет[2].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией), ТаблицаДопСекций); 
	//ОбойтиДеревоДопСекций();
	
	РазмерТаблицы = 0;
	Для Каждого Колонка Из ТаблицаРезультат Цикл

		РазмерТаблицы = РазмерТаблицы + 1;
		ИмяКолонки = ИмяПоля + РазмерТаблицы;
				
		НовыйЭлемент = Элементы.Добавить(ИмяТаблицы + ИмяКолонки, Тип("ПолеФормы"), ЭлементТаблица);       
		НовыйЭлемент.Вид 			= ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.Заголовок 		= Колонка.ВидыРабот.Наименование;
		НовыйЭлемент.ПутьКДанным 	= "ТаблицаСекции." + ИмяКолонки;
		НовыйЭлемент.ШиринаЭлемента = 1;
		НовыйЭлемент.ПутьКДаннымПодвала = ИмяПоля + РазмерТаблицы + ИмяКоличество;
		НовыйЭлемент.Подсказка		= Колонка.ВидыРабот.Код;
		ЭлементТаблица.УстановитьДействие("ПриИзменении","ТаблицаСекцииКолонкиСекцийПриИзменении");      
				
		НовыйЭлемент = Элементы.Добавить(ИмяТаблицы + ИмяКолонки + "Доступность", Тип("ПолеФормы"), ЭлементТаблица);       
		НовыйЭлемент.Вид 			= ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.Заголовок 		= Колонка.ВидыРабот.Наименование + "Доступность";
		НовыйЭлемент.ПутьКДанным 	= "ТаблицаСекции." + ИмяКолонки + "Доступность";
		НовыйЭлемент.ШиринаЭлемента = 1;
		НовыйЭлемент.Видимость = Ложь;
	КонецЦикла;	
	ЧислоСекций = РазмерТаблицы;
	ЧислоУдаленныхСтрок = 0;
	
	СтрокаКоличество = ТаблицаРезультат.ВыгрузитьКолонку(ИмяКоличество);
	
	РазмерТаблицы = 0;
	Для каждого КолонкаКоличества из СтрокаКоличество Цикл
		РазмерТаблицы = РазмерТаблицы +1;
		ЭтаФорма[ИмяПоля + РазмерТаблицы + ИмяКоличество] = КолонкаКоличества;
	КонецЦикла;
	
	ЗаполнитьСтрокиТаблицыСекций(ТаблицаРезультат, ИмяТаблицы, ИмяПоля);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиТаблицыСекций(ТаблицаРезультат, ИмяТаблицы, ИмяПоля)
	
	ОбъектТаблицаСекции = ЭтаФорма[ИмяТаблицы];

	Для РазмерТаблицы = 1 По 20 Цикл
		НовСтр = ОбъектТаблицаСекции.Добавить();
		НовСтр.Номер = РазмерТаблицы;
		НовСтр.ТипСекции = Перечисления.Лико_ТипСекции.Основная;
		СтрокаДанныхСНомером = ТаблицаРезультат.ВыгрузитьКолонку("Номер" + РазмерТаблицы);
		НомерКолонки = 1;
		//СекцийНет - проверяет, что все колонки пусты
		СекцийНет = Истина;
		Для каждого КолонкаДанных из СтрокаДанныхСНомером Цикл
			НовСтр[ИмяПоля+ НомерКолонки+ "Доступность"] = КолонкаДанных;
			НомерКолонки = НомерКолонки + 1;
			//Если СекцийНет еще не проставлена, то когда Поле - Истина, проставляем
			Если КолонкаДанных И СекцийНет Тогда
				СекцийНет = Ложь
			КонецЕсли;
		КонецЦикла;
		//У данной Строки все поля пусты, удаляем пустую строку и прекращаем заполнение строк
		Если СекцийНет Тогда 
			ОбъектТаблицаСекции.Удалить(НовСтр);
			Прервать;
		КонецЕсли;
	  	ДобавлениеУсловногоОформления(РазмерТаблицы);
	КонецЦикла;
	
КонецПроцедуры

