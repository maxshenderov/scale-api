&НаКлиенте
Процедура ТаблицаСекцииПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	Если Строка > НомерКонечнойСтроки Тогда 
		Возврат
	КонецЕсли;
	
	НомерСтроки = Строка+1 - НомерНачальнойСтроки; 
	Если Элемент.Имя = "ТаблицаСекции" И ПараметрыПеретаскивания.Значение[0]["Номер"+(НомерСтроки)] 
		И типЗнч(ПараметрыПеретаскивания.Значение[0]) = Тип("ДанныеФормыЭлементДерева") Тогда
		
		НовыйНомерСтроки = "" + НомерСтроки + "/" + (НомерСтроки + 1);
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номер", НовыйНомерСтроки);
		НайденныеСтроки = ТаблицаСекции.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Возврат;
		КонецЕсли;
		
		НовСтр = ТаблицаСекцийДобавитьСтроку(Строка(НомерСтроки));
		
		СтрокаПеренос = ПараметрыПеретаскивания.Значение[0];
		НовСтр.Секция = ?(ЗначениеЗаполнено(СтрокаПеренос.ВидыРабот), СтрокаПеренос.ВидыРабот, СтрокаПеренос.Секция);
		СтруктураЭлементов = Новый Структура;
		СтруктураЭлементов.Вставить("Секция", НовСтр.Секция);
		НовСтр.Параметры = ЗначениеВСтрокуВнутрНаСервере(СтруктураЭлементов);
		НовСтр.ПараметрыПредставление = ПолучитьПредставлениеПараметра(СтруктураЭлементов);
		НовСтр.Номер = НовыйНомерСтроки; 
		//Изменяем данные в таблице источнике
		текРодитель = ПолучитьРодителяВДереве(ПараметрыПеретаскивания.Значение[0], ПараметрыПеретаскивания.Значение[0]);
		текРодитель.Количество = текРодитель.Количество - 1;
	КонецЕсли;
КонецПроцедуры  

&НаКлиенте
Функция ТаблицаСекцийДобавитьСтроку(пНомерСтроки)
	НовСтр = ТаблицаСекции.Добавить();
	ТекНомерСтроки = НовСтр.ПолучитьИдентификатор() - 1 - ЧислоУдаленныхСтрок ;
	ТаблицаСекции.Сдвинуть(ТаблицаСекции.Индекс(НовСтр), ?(НомерНачальнойСтроки = 0, 0, НомерНачальнойСтроки-1) + ПолучитьЧислоСдвига(пНомерСтроки) - ТекНомерСтроки);
	
	Возврат НовСтр;
КонецФункции	

&НаКлиенте
Функция ПолучитьЧислоСдвига(ИскомыйНомер)
	КоличествоСдвигов = 0;
	Для каждого ТекСтр Из ТаблицаСекции Цикл
		КоличествоСдвигов = КоличествоСдвигов + 1;
		Если ТекСтр.Номер = ИскомыйНомер Тогда
			Возврат КоличествоСдвигов 
		КонецЕсли;
	КонецЦикла;
 	
	Возврат КоличествоСдвигов; 
КонецФункции

&НаКлиенте
Процедура ТаблицаДопСекцийНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	текРодитель = ПолучитьРодителяВДереве(Элемент.ТекущиеДанные, ТаблицаДопСекций.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение[0]));  
	Если текРодитель.Количество <= 0 
		ИЛИ ТаблицаДопСекций.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение[0]).ПолучитьЭлементы().Количество() > 0 Тогда
		Выполнение = Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьРодителяВДереве(Элемент, ПараметрыПеретаскивания)
	Если ЗначениеЗаполнено(Элемент.ВидыРабот) Тогда
		Возврат ПараметрыПеретаскивания.ПолучитьРодителя();
	Иначе
		Возврат ПараметрыПеретаскивания;
	КонецЕсли;                                                    
КонецФункции

