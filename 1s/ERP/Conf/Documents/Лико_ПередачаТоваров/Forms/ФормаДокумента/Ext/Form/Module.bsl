&НаКлиенте
Процедура РезультатЧтенияПропускаОтвЛица(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.Ошибка)
		ИЛИ НЕ ЗначениеЗаполнено(Результат.СчитанноеЗначение)
		ИЛИ ТипЗнч(Результат.СчитанноеЗначение) <> Тип("СправочникСсылка.ФизическиеЛица")
		Тогда
		Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
			Сообщить(Результат.Ошибка);
		Иначе
			Сообщить("Пропуск не был считан");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	
	НомерТелефона = "";
	ЗапрашиватьСМС = Ложь;
	Должности = "";
	ДопПараметры.Свойство("Должности", Должности);
	Если ФизЛицоОбладаетПравамиНачальникаСмены(Результат.СчитанноеЗначение, НомерТелефона, ЗапрашиватьСМС, Должности) Тогда
		ЗапрашиватьСМС = Ложь; // для упаковки поставим принудительно
		ДопПараметры.Вставить("ФизЛицоПодтверждения", Результат.СчитанноеЗначение);
		ДопПараметры.Вставить("СчитанПропускБригадира");
		Если ЗапрашиватьСМС Тогда
			// Потребуем подтверждение пропуска по смс
			Если НЕ ЗначениеЗаполнено(НомерТелефона) Тогда
				Сообщить("У физ лица " + Результат.СчитанноеЗначение + " не заполнен номер телефона, подтверждение невозможно");
				Возврат;
			КонецЕсли;
			
			// Сформируем код подверждения через генератор случайных чисел
			КодПотверждения = ОтправитьКодПодтвержденияПоСмс(НомерТелефона);
			
			// Запросим код подтверждения
			ДопПараметры.Вставить("КодПодтверждения", КодПотверждения);
			ОписаниеОповещенияПослеВводаВозврата = Новый ОписаниеОповещения("ВведенКодПодтвержденияДляПодтвержденияПропускаОтвЛица", ЭтотОбъект, ДопПараметры);
			//ПараметрыДляКлавиатуры = Новый Структура("НабираемыйТекст,ТекстЗаголовка", "", "Введите код из смс на номер " + НомерТелефона);
			//ОткрытьФорму("ОбщаяФорма.ТСВиртуальнаяКлавиатураЦифровая", ПараметрыДляКлавиатуры,,,,, ОписаниеОповещенияПослеВводаВозврата, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);  
			ПоказатьВводСтроки(ОписаниеОповещенияПослеВводаВозврата, "", "Введите код из смс на номер " + НомерТелефона, 4, Ложь);
		Иначе	
			// СМС не нужны, считаем проверку пройденной
			//Выполнить("" + ДопПараметры.ИмяПроцедурыПриУспешномПодтверждении); 
			Объект.ПодписьДокументаСотрудником=Результат.СчитанноеЗначение;
		КонецЕсли;
		
	Иначе
		Сообщить("Считан пропуск сотрудника, не обладающего требуемыми правами");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ФизЛицоОбладаетПравамиНачальникаСмены(ФизЛицо, НомерТелефона = "", ЗапрашиватьСМС = Ложь, СтрокаДолжностей = "")
	
	ИмяФайла = ПолучитьИмяВременногоФайла();
	ВнОбработка = Лико_Дополнительно.НайтиДополнительнуюОбработкуПоИмениОбъекта("ТСРабочийСтолЕРП");
	Если НЕ ЗначениеЗаполнено(ВнОбработка) Тогда
		Сообщить("Не найдена дополнительная обработка с именем объекта ТСРабочийСтолЕРП");
		Возврат Неопределено;
	КонецЕсли;
	ДвоичныеДанные = ВнОбработка.ХранилищеОбработки.Получить();
	ДвоичныеДанные.Записать(ИмяФайла);
	ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь);
	
	ОрганизацияПартнера=УправлениеСвойствами.ЗначениеСвойства(Объект.Партнер,"Лико_СобственнаяОрганизация");
	
	Результат = ФизЛицоОбладаетПравамиНачальникаСменыСервер(ФизЛицо, ОрганизацияПартнера, НомерТелефона, ЗапрашиватьСМС, СтрокаДолжностей,Истина);
	
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
	КонецПопытки;
	
	Возврат Результат;

КонецФункции 

Функция ФизЛицоОбладаетПравамиНачальникаСменыСервер(ФизЛицо, Организация, НомерТелефона = "", ЗапрашиватьСМС = Ложь, СтрокаДолжностей = "",НеПроверятьБезОрганизации=Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	МассивДолжностей = Новый Массив;
	Если НЕ ЗначениеЗаполнено(СтрокаДолжностей) Тогда
		МассивДолжностей.Добавить(Справочники.Лико_ПредопределенныеЗначения.ДолжностьНачальникПроизводства.ЗначениеПараметра);
		МассивДолжностей.Добавить(Справочники.Лико_ПредопределенныеЗначения.ДолжностьНачальникСмены.ЗначениеПараметра);
		//МассивДолжностей.Добавить(Справочники.Лико_ПредопределенныеЗначения.ДолжностьМенеджерПоПланированиюПроизводства.ЗначениеПараметра);
		МассивДолжностей.Добавить(Справочники.Лико_ПредопределенныеЗначения.ДолжностьТехнолог.ЗначениеПараметра);
		МассивДолжностей.Добавить(Справочники.Лико_ПредопределенныеЗначения.ДолжностьЗамГлТехнолога.ЗначениеПараметра);
		МассивДолжностей.Добавить(Справочники.Лико_ПредопределенныеЗначения.ДолжностьНачальникЦУ.ЗначениеПараметра);
	Иначе
		МассивДолжностейСтрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаДолжностей, ",");
		Для каждого ДолжностьСтрока из МассивДолжностейСтрок Цикл
			Если   ДолжностьСтрока="ДолжностьКладовщик" Тогда
				МассивДолжностей.Добавить(Справочники.Должности.НайтиПоНаименованию("Кладовщик"));
				МассивДолжностей.Добавить(Справочники.Должности.НайтиПоНаименованию("Кладовщик 3 категории"));
				МассивДолжностей.Добавить(Справочники.Должности.НайтиПоНаименованию("Кладовщик 2 категории"));
				МассивДолжностей.Добавить(Справочники.Должности.НайтиПоНаименованию("Кладовщик 1 категории"));
				МассивДолжностей.Добавить(Справочники.Должности.НайтиПоНаименованию("Начальник складского комплекса"));
				МассивДолжностей.Добавить(Справочники.Должности.НайтиПоНаименованию("Менеджер по планированию производства"));
				МассивДолжностей.Добавить(Справочники.Должности.НайтиПоНаименованию("Диспетчер склада"));

			Иначе
				МассивДолжностей.Добавить(Справочники.Лико_ПредопределенныеЗначения[ДолжностьСтрока].ЗначениеПараметра); 
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ДолжностьФизЛица = Лико_Дополнительно.НайтиДолжностьФизЛица(ФизЛицо, Организация, ТекущаяДата(),НеПроверятьБезОрганизации);
	
	Если МассивДолжностей.Найти(ДолжностьФизЛица) = Неопределено Тогда
		Возврат Ложь;
	Иначе
		// найдем номер телефона
		НомерТелефона = Лико_Дополнительно.НайтиСотовыйНомерФизЛица(ФизЛицо);
		ЗапрашиватьСМС = ПараметрыСеанса.Лико_РабочееМесто.ТСПодтверждениеСчитыванияПропускаБригадираПоСмс;
		
		Возврат Истина;
	КонецЕсли;

КонецФункции


&НаСервере
Функция ОтправитьКодПодтвержденияПоСмс(НомерТелефона)
	
	ИмяФайла = ПолучитьИмяВременногоФайла();
	ВнОбработка = Лико_Дополнительно.НайтиДополнительнуюОбработкуПоИмениОбъекта("ТСРабочийСтолЕРП");
	Если НЕ ЗначениеЗаполнено(ВнОбработка) Тогда
		Сообщить("Не найдена дополнительная обработка с именем объекта ТСРабочийСтолЕРП");
		Возврат Неопределено;
	КонецЕсли;
	ДвоичныеДанные = ВнОбработка.ХранилищеОбработки.Получить();
	ДвоичныеДанные.Записать(ИмяФайла);
	ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяФайла, Ложь);

	Результат =  ВнешняяОбработка.ОтправитьКодПодтвержденияПоСмс(НомерТелефона, Объект.РабочееМесто);
	
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
	КонецПопытки;
	
	Возврат Результат;

КонецФункции


