&НаСервере
Процедура ТоварыОписаниеБракаК2ПриИзмененииНаСервере(Серия,ОписаниеБракаК2)
	
	НайденныеСтроки=Объект.ЗабраковкаСерий.НайтиСтроки( Новый Структура("Серия",Серия));
	Если ЗначениеЗаполнено(ОписаниеБракаК2) И НайденныеСтроки.Количество()>0 Тогда
		
		Для каждого НСтр Из НайденныеСтроки Цикл
			НСтр.Серия=Серия; 
			НСтр.ОписаниеДефекта=ОписаниеБракаК2;
			НСтр.Решение=Справочники.Лико_РешенияПоБракуМатериалов.ПеревестиНаК2;
		КонецЦикла;
		
	ИначеЕсли ЗначениеЗаполнено(ОписаниеБракаК2) Тогда
		НСтр= Объект.ЗабраковкаСерий.Добавить();
		НСтр.Серия=Серия; 
		НСтр.ОписаниеДефекта=ОписаниеБракаК2;
		НСтр.Решение=Справочники.Лико_РешенияПоБракуМатериалов.ПеревестиНаК2;
		
		
	ИначеЕсли Не ЗначениеЗаполнено(ОписаниеБракаК2) И НайденныеСтроки.Количество()>0 Тогда
		Для каждого НСтр Из НайденныеСтроки Цикл
			Объект.ЗабраковкаСерий.Удалить(Объект.ЗабраковкаСерий.Индекс(НСтр)); 		
		КонецЦикла;
	КонецЕсли;
	
	
КонецПроцедуры


