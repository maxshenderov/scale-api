&НаСервере 
Процедура ОбработатьШтрихКодДокумента(МассивСсылок)

	Для каждого СсылкаДокумента Из МассивСсылок Цикл

		Если ТипЗНЧ(СсылкаДокумента)=Тип("ДокументСсылка.Лико_ЗаявкаНаСклад") Тогда
			Объект.ЗаявкаНаСклад=СсылкаДокумента;
			Объект.ЗаказКлиента= СсылкаДокумента.ЗаказКлиента;
			Объект.Получатель= СсылкаДокумента.РабочийЦентр; 
			Объект.Партнер =  СсылкаДокумента.Партнер;
			Объект.Контрагент =  СсылкаДокумента.Контрагент;
			Если Не Объект.Проведен И Не ЗначениеЗаполнено(Объект.Распоряжение) И ЗначениеЗаполнено(СсылкаДокумента.ВидОперации) Тогда
				Объект.ВидОперации= СсылкаДокумента.ВидОперации;
			КонецЕсли;
			
			Если Объект.ЗаказКлиента.ДавальческоеСырье И объект.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПереработку ТОгда
				Контрагент=УправлениеСвойствами.ЗначениеСвойства(Объект.ЗаказКлиента.Площадка.Организация,"КонтрагентОрганизации_8e3f712fdca94791a890e1aa7853a0d2");
				Объект.Партнер=Контрагент.Партнер;
				Объект.Контрагент=Контрагент;
				Объект.АдресХранения= УправлениеСвойствами.ЗначениеСвойства(Объект.ЗаказКлиента.Площадка.Организация,"Лико_ЗонаПриемкиСИМ"); 
				ОБъект.ВнутренняяПереработка=Истина;


			КонецЕсли;
			Объект.Товары.Загрузить(СсылкаДокумента.Товары.Выгрузить());

		КонецЕсли;


	КонецЦикла;


КонецПроцедуры



&НаКлиенте
Процедура ОбработатьШтрихкоды(ДанныеШтрихкода)
	
	
	
	Результат = Лико_ДополнительноКлиент.ОбработатьШтрихКодНеТовара(ДанныеШтрихкода.Штрихкод);
	Если Результат.Ошибка <> "" Тогда
		МенеджерыОбъектов = Новый Массив();
		МенеджерыОбъектов.Добавить(ПредопределенноеЗначение("Документ.Лико_ЗаявкаНаСклад.ПустаяСсылка"));
		МенеджерыОбъектов.Добавить(ПредопределенноеЗначение("Документ.Лико_ЗаказНаРаскрой.ПустаяСсылка"));

		МассивСсылок =ПолучитьСсылкуПоШтрихкодуТабличногоДокументаСервер(ДанныеШтрихкода.Штрихкод);
		Если МассивСсылок.Количество()<>0 Тогда
			ОбработатьШтрихКодДокумента(МассивСсылок);
			УстановитьВидимость();
		Иначе
			
			
			Сообщить(Результат.Ошибка);
		КонецЕсли;
		
	Иначе
		Если Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ЗаказаСпецификации") Тогда
			Объект.ЗаказКлиента=ПолучитьЗаказКлиентаПоНомеру(Результат.НомерЗаказа);
			Объект.НомерБланка=Результат.НомерБланка;
		ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Заказа") Тогда
			Объект.ЗаказКлиента=ПолучитьЗаказКлиентаПоНомеру(Результат.НомерЗаказа); 			
			
		ИначеЕсли Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Сотрудника") Тогда
			//Это физ. лицо
			
			Объект.Сотрудник = Результат.Сотрудник;
		ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры_Короткий") Или 			
			Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры") Тогда
			
			
			Если Не ЗначениеЗаполнено(Результат.ОбъектНоменклатуры) Тогда
				
				Сообщить("Штрих код не найден! "+ Результат.ШК);
				Возврат;	
			КонецЕсли;
			
			ОбработатьШКНоменклатуры(Результат);
			
		ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Конверта") Тогда
			
							
			
			Конверт= Результат.Конверт;
			
			Если  ТекущийЭлемент = Элементы.КонвертПолучатель Тогда
				Объект.КонвертПолучатель = Конверт;
			Иначе
				
				
				Структура = Новый Структура;
				Структура.Вставить("Конверт",Конверт);
				
				ОписаниеОповещения= Новый ОписаниеОповещения("ПодборФормЗавершение",ЭтаФорма);
				ОткрытьФорму("Справочник.Лико_Формы.Форма.ФормаПодбора",Структура,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			КонецЕсли;
		
		ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_РабочегоЦентра") Тогда
			ОБъект.Получатель=Результат.РабочийЦентр;
			
			
		ИначеЕсли Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Адреса")
			ИЛИ Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Адреса_Короткий") Тогда
			//Это ячейка
			Если  ТекущийЭлемент = Элементы.АдресХранения или Элементы.Товары.ТекущиеДанные=Неопределено Тогда
				Объект.АдресХранения=Результат.АдресаХранения;
			Иначе
				
				Элементы.Товары.ТекущиеДанные.АдресХраненияНовый = Результат.АдресаХранения;
			КонецЕсли;
			
		//ИначеЕсли Не ЗначениеЗаполнено(Результат.ВидШК) Тогда
		//	ОбработатьШтрихкодыТиповой(ДанныеШтрихкода);			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

