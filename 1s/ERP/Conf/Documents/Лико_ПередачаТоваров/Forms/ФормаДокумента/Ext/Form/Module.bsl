КонецПроцедуры

Процедура ПроверитьНаличиеЦеныНаОснастку() //+Лико m.shenderov 26.03.2021
		
	 Массив = Новый Массив();
	
	Для каждого Номен Из Объект.ЦеныНоменклатуры Цикл
		Если Номен.Номенклатура.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыОснастка.ЗначениеПараметра  Тогда
			Массив.Добавить(Номен.Номенклатура);			
		КонецЕсли;		
	КонецЦикла;
	
	
	Если Массив.Количество()=0 ТОгда
		Возврат;
	КонецЕсли;
	ВалютаEur=Константы.ВалютаУправленческогоУчета.Получить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПараметрыШтампа.Цена КАК Цена,
	|	Лико_ПараметрыШтампа.Номенклатура КАК Номенклатура,
	|	КурсыВалютСрезПоследних.Курс КАК КурсEur,
	|	КурсыВалютСрезПоследних1.Курс КАК Курс,
	|	Лико_ПараметрыШтампа.Цена * КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних1.Курс КАК ЦенаИтог
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа,
	|	РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &ВалютаEuro) КАК КурсыВалютСрезПоследних,
	|	РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &Валюта) КАК КурсыВалютСрезПоследних1
	|ГДЕ
	|	Лико_ПараметрыШтампа.Номенклатура В(&Номенклатура)";
	Запрос.УстановитьПараметр("Номенклатура",Массив);
	Запрос.УстановитьПараметр("Дата",Объект.Дата);
	Запрос.УстановитьПараметр("ВалютаEuro",ВалютаEur);
	Запрос.УстановитьПараметр("Валюта",Объект.Валюта);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл		
		СтрНоменклатуры=Объект.ЦеныНоменклатуры.НайтиСтроки(Новый Структура("Номенклатура",Выборка.Номенклатура));		
		Если СтрНоменклатуры.Количество()>0 Тогда			
			СтрНоменклатуры[0].Цена=Выборка.ЦенаИтог;		
		КонецЕсли;			
		
	КонецЦикла;	
КонецПроцедуры //-Лико m.shenderov 26.03.2021


&НаСервере
Функция ЭтоПеремещениеРезерваМеждуПомещениямиСервер() //+Лико m.shenderov 17.02.2023  
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивАдресов= Новый Массив;
	
	ТзТовары=Объект.Товары.Выгрузить();
	Тз=ТзТовары.Скопировать(,"АдресХранения");
	Тз.Свернуть("АдресХранения");
	
	Для каждого СтрТз Из Тз Цикл
		Если ЗначениеЗаполнено(СтрТз.АдресХранения) Тогда
			МассивАдресов.Добавить(СтрТз.АдресХранения);
		КонецЕсли;	 
	КонецЦикла;
	
	Тз=ТзТовары.Скопировать(,"АдресХраненияНовый");
	Тз.Свернуть("АдресХраненияНовый");
	
	Для каждого СтрТз Из Тз Цикл
		Если ЗначениеЗаполнено(СтрТз.АдресХраненияНовый) Тогда
			МассивАдресов.Добавить(СтрТз.АдресХраненияНовый);
		КонецЕсли;	 
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Объект.АдресХранения) Тогда
		
		МассивАдресов.Добавить(Объект.АдресХранения);
		
	КонецЕсли; 
	
	
	ТзТовары.Свернуть("Серия");
	
	МассивСерий=ТзТовары.ВыгрузитьКолонку("Серия");
	
	
	Если Объект.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СкладскиеЯчейки.Помещение КАК Помещение
		|ИЗ
		|	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
		|ГДЕ
		|	СкладскиеЯчейки.Ссылка В(&МассивАдресов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЯССМ_ОбъектыНоменклатуры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЯССМ_ОбъектыНоменклатуры КАК ЯССМ_ОбъектыНоменклатуры
		|ГДЕ
		|	ЯССМ_ОбъектыНоменклатуры.Серия В(&МассивСерий)
		|	И ЯССМ_ОбъектыНоменклатуры.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)";
		Запрос.УстановитьПараметр("МассивАдресов",МассивАдресов ); 
		Запрос.УстановитьПараметр("МассивСерий",МассивСерий );
		
		Пакеты = Запрос.ВыполнитьПакет();
		Если Пакеты[0].Выбрать().Количество()>1 И  Пакеты[1].Выбрать().Количество()>0 Тогда
			Возврат Истина;
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции  //-Лико m.shenderov 17.02.2023



