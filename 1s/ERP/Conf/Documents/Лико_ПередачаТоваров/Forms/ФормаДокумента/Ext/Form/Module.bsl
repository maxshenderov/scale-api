		Объект.Руководитель 		= Лико_Дополнительно.НайтиЛицоСПравомПодписи(Объект.Организация, ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"), Объект.Отпустил,Объект.Дата); 
		Объект.ГлавныйБухгалтер 	= Лико_Дополнительно.НайтиЛицоСПравомПодписи(Объект.Организация, ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер"), Объект.Отпустил,Объект.Дата); 
	 	ЭтаФорма.Записать(Новый Структура("РежимЗаписи,", РежимЗаписиДокумента.Запись));	
		
