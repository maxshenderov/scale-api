&НаКлиенте
Перем ПропуститьВопросПередЗаписью; // Для отработки записи после вопроса

&НаКлиенте
Перем КэшированныеЗначения; //используется механизмом обработки изменения реквизитов ТЧ

&НаКлиенте
Перем ТекущиеДанныеИдентификатор; //используется для передачи текущей строки в обработчик ожидания

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли; 
	
	ПрослеживаемостьТоваров=УправлениеСвойствами.ЗначениеСвойства(Объект.Организация,"Лико_ПрослеживаемостьТоваров");
	
	Если Параметры.Свойство("ЛикоЗначенияЗаполнения") Тогда
		ЗаполнитьЗначенияСвойств(Объект,Параметры.ЛикоЗначенияЗаполнения);
	КонецЕсли;
	
	УстановитьУсловноеОформление(); 
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);	
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	ПриЧтенииСозданииНаСервере();
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда		
		
		НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий); 		
		//Элементы.ГруппаИнформация.Картинка = ОбщегоНазначенияКлиентСервер.КартинкаКомментария(Объект.Комментарий);
		Если Параметры.Свойство("ВидОперации") и ЗначениеЗаполнено(Параметры.ВидОперации) Тогда
			Объект.ВидОперации=Параметры.ВидОперации;
		КонецЕсли;
		ЭтоБылНовый=Истина;
		
	Иначе
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаТоварыОтбор;
		
		Если Объект.Проведен Тогда
			ЭтоБылПроведенный=Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 	
	
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	ПечататьСкладОперацииДокументаПриПроведении=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ПечататьСкладОперацииДокументаПриПроведении",Ложь);
	ПроставитьЗаказВФормах();
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма); 
	
	Если  РольДоступна("АдминистраторСистемы") Или РольДоступна("Лико_РедактированиеКоличестоУУ") Тогда
		Элементы.ТоварыКоличество.Видимость		=Истина;
		Элементы.АвторДокумента.Вид=ВидПоляФормы.ПолеВвода;
		Элементы.РабочееМесто.Вид=ВидПоляФормы.ПолеВвода;
		Элементы.БезПеремещения.ТолькоПросмотр = Ложь;
		Элементы.ТоварыКоличество.ТолькоПросмотр	=Ложь; 	
		
	Иначе
		Элементы.АвторДокумента.Вид=ВидПоляФормы.ПолеНадписи;
		Элементы.РабочееМесто.Вид=ВидПоляФормы.ПолеНадписи;
		Элементы.БезПеремещения.ТолькоПросмотр = Истина;
		Элементы.ТоварыКоличество.ТолькоПросмотр=Истина;		  
	КонецЕсли;
	//
	//Если  Объект.Проведен  Тогда
	//ЭтотОбъект.ТолькоПросмотр=Истина;
	//КонецЕсли;
	
	КонтролироватьСкладПриходаРасхода=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("КонтролироватьСкладПриходаРасхода",ЛОжь);
	ЗаполнитьРаспоряжениеВнутреннейПереработки();
	ПолучитьОбновитьИнформациюТранспортныхНакладных();
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ЦенаВключаетНДС = Истина;
	КонецЕсли;
	
	//Подсистема WebSocket
	ПоказыватьQRCode=Ложь;
	WebSocketСервер.Инициализация(ЭтаФорма,ПоказыватьQRCode);
	// Подсистема WebSocket
	
  УчетПравилПеремещенияТМЦ = Справочники.Лико_ПравилаПеремещенияТМЦ.СтартСистемы(Объект.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	МенеджерОборудованияКлиентПереопределяемый.НачатьОтключениеОборудованиеПриЗакрытииФормы(ЭтаФорма);

	//Сервер взаимодействия. Мобильные устройства.
	Лико_СерверВзаимодействияКлиент.ОтключениеМобильныхУстройств(ЭтаФорма);

КонецПроцедуры




&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	
	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтаФорма); 
	НоменклатураСервер.УстановитьУсловноеОформлениеСерийНоменклатуры(ЭтаФорма, "СерииВсегдаВТЧТовары");
	НоменклатураСервер.УстановитьУсловноеОформлениеЕдиницИзмерения(ЭтаФорма);
	
	УстановитьУсловноеОформлениеВидаОпераци(ЭтаФорма);
	УстановитьУсловноеОформлениеТолькоПросмотр(ЭтаФорма,"ФормыКонверт","Объект.ВидОперации",Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаФорм); 
	УстановитьУсловноеОформлениеТолькоПросмотр(ЭтаФорма,"ФормыКонверт","Объект.ВидОперации",Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.СписаниеФорм); 
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(Объект, Документы.Лико_ПередачаТоваров);
	
	
	СтруктураУстанавливаемыхПараметров = Новый Структура;
	СтруктураУстанавливаемыхПараметров.Вставить("Склад",Объект.Склад);
	
	//УстановитьПараметрыФункциональныхОпцийФормы(СтруктураУстанавливаемыхПараметров);
	
	ПараметрыЗаполненияРеквизитов = Новый Структура;
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются",
	Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипНоменклатуры",
	Новый Структура("Номенклатура", "ТипНоменклатуры"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакАртикул",
	Новый Структура("Номенклатура", "Артикул"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьПризнакТипИзмеряемойВеличины", Новый Структура("Номенклатура", "ТипИзмеряемойВеличины"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьВесУпаковки",Новый Структура("Номенклатура, Упаковка", "ВесУпаковки"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьОбъемУпаковки",Новый Структура("Номенклатура, Упаковка", "ОбъемУпаковки"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьЕдиницуИзмеренияВеса",Новый Структура("Номенклатура, Упаковка", "ЕдиницаИзмеренияВеса"));
	ПараметрыЗаполненияРеквизитов.Вставить("ЗаполнитьЕдиницуИзмеренияОбъема",Новый Структура("Номенклатура, Упаковка", "ЕдиницаИзмеренияОбъема"));
	
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Товары, ПараметрыЗаполненияРеквизитов);
	
	
	ПересчитатьВесОбъемВСтрокахТЧ();
	//Элементы.ГруппаИнформация.Картинка = ОбщегоНазначенияКлиентСервер.КартинкаКомментария(Объект.Комментарий);
	
	ЗаполнитьОписаниеБракаК2Сервер();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект,Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры


&НаКлиенте
Процедура УстановитьВидимость() 	
	Элементы.Получатель.Заголовок="Получатель";
	Элементы.ГруппаНомерЗаказа.Видимость=Ложь;
	Элементы.ТоварыАдресХраненияНовый.Видимость=Ложь;
	Элементы.АдресХранения.Видимость=Истина;
	Элементы.ЗаказВПереработку.Видимость=Ложь;
	Элементы.ЗаказКлиента.Видимость=Истина;
	Элементы.НомерБланка.Видимость=Истина;
	Элементы.БракМатериала.Видимость=Ложь;
	Элементы.ПричинаСписания.Видимость=Ложь;
	Элементы.ВнутренняяПродажаПеремещение.Видимость=Ложь;
	Элементы.ГруппаРеквизитовДляРеализации.Видимость=Ложь;
	Элементы.ГруппаПодписьДокумента.Видимость=Ложь;
	Элементы.КонвертПолучатель.Видимость = Ложь;
	
	Если Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство") Тогда
		Элементы.ГруппаТоварыОтбор.Видимость=Истина;
		Элементы.ГруппаФормы.Видимость=Ложь;
		Элементы.ГруппаБрак.Видимость=Ложь;
		Элементы.ГруппаНомерЗаказа.Видимость=ИСтина;		
		Элементы.ГруппаДополнительно.Видимость=Ложь;
		Элементы.АдресХранения.Видимость=Ложь;		
		Элементы.Получатель.Заголовок="Рабочий центр";
		Если Не ЗначениеЗаполнено(Объект.Получатель) Тогда
			Объект.Получатель=ПредопределенноеЗначение("Справочник.РабочиеЦентры.ПустаяСсылка");			
		КонецЕсли;
		Элементы.Получатель.Видимость=Истина;
		Элементы.ГруппаПартнерКонтрагент.Видимость=Ложь;
		
		Элементы.ВнутренняяПродажаПеремещение.Видимость=Истина;
	ИначеЕсли Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение") Тогда
		Элементы.ГруппаТоварыОтбор.Видимость=Истина;
		Элементы.ГруппаФормы.Видимость=Ложь;
		Элементы.ГруппаБрак.Видимость=Ложь;
		Элементы.ГруппаНомерЗаказа.Видимость=Ложь;		
		Элементы.ГруппаДополнительно.Видимость=Ложь;
		Элементы.Получатель.Видимость=Ложь;
		Элементы.ТоварыАдресХраненияНовый.Видимость=Истина;
		Элементы.Распоряжение.Видимость=Ложь;
		Элементы.АдресХранения.Видимость=Истина;
		Элементы.Получатель.Видимость=Ложь;
		Элементы.ВнутренняяПродажаПеремещение.Видимость=Истина;
ИначеЕсли Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаМОЛ") Тогда
		Элементы.ГруппаТоварыОтбор.Видимость=Истина;
		Элементы.ГруппаФормы.Видимость=Ложь;
		Элементы.ГруппаБрак.Видимость=Ложь;
		Элементы.ГруппаНомерЗаказа.Видимость=Истина;
		Элементы.ЗаказКлиентка.Видимость=Ложь;
		Элементы.НомерБланка.Видимость=Ложь;
		Элементы.ГруппаДополнительно.Видимость=Ложь;
		Элементы.Получатель.Видимость=Ложь;
		Элементы.ТоварыАдресХраненияНовый.Видимость=ЛОжь;
		Элементы.Распоряжение.Видимость=Ложь;
		Элементы.АдресХранения.Видимость=Ложь;
		Элементы.Получатель.Видимость=Ложь;
		Элементы.ВнутренняяПродажаПеремещение.Видимость=Истина;
		
		
		
		Элементы.ГруппаПартнерКонтрагент.Видимость=Ложь;
	ИначеЕсли  Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаДавальцу") Тогда	
		Элементы.ГруппаДавальца.Видимость			=Истина;
		Элементы.ГруппаПереработка.Видимость		=Ложь;
		
		//Если Объект.ВозвратДавальцу Тогда
		//	Элементы.БракМатериала.Видимость		    = Истина; 
		//Иначе 
		//	Элементы.БракМатериала.Видимость		    = Ложь;
		//	
		//КонецЕсли;
		
		Если Объект.БракМатериала И  Объект.ВозвратДавальцу Тогда 
			
			Элементы.ГруппаПодписьДокумента.Видимость=Истина;
		Иначе
			
			Элементы.ГруппаПодписьДокумента.Видимость=Ложь;
			
		КонецЕсли;
		
			
		
		Элементы.ГруппаТоварыОтбор.Видимость		=Истина;
		Элементы.ГруппаФормы.Видимость				=Ложь;
		Элементы.ГруппаБрак.Видимость				=Ложь;
		Элементы.ГруппаДополнительно.Видимость		=Истина;
		Если Не ЗначениеЗаполнено(Объект.Получатель) Тогда
			Объект.Получатель=ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		КонецЕсли;  
		Элементы.Получатель.Видимость					=Ложь;
		Элементы.ГруппаПартнерКонтрагент.Видимость		=Истина;
		//Элементы.ЗаказВПереработку.Видимость=Истина;
		
		
	ИначеЕсли  Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПереработку") Тогда	
		Элементы.ГруппаДавальца.Видимость			=Ложь;
		Элементы.ГруппаПереработка.Видимость		=Истина;
		
		ОбработатьПолеЗаказПереработчику();
		
		Элементы.ГруппаТоварыОтбор.Видимость=Истина;
		Элементы.ГруппаФормы.Видимость=Ложь;
		Элементы.ГруппаБрак.Видимость=Ложь;
		Элементы.ГруппаДополнительно.Видимость=Истина;
		Если Не ЗначениеЗаполнено(Объект.Получатель) Тогда
			Объект.Получатель=ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		КонецЕсли;  
		Элементы.Получатель.Видимость=Ложь;
		Элементы.ГруппаПартнерКонтрагент.Видимость=Истина;
		//Элементы.ЗаказВПереработку.Видимость=Истина;
		
	ИначеЕсли  Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ВозвратПоставщику") Тогда	
		Элементы.ГруппаТоварыОтбор.Видимость=Истина;
		Элементы.ГруппаФормы.Видимость=Ложь;
		Элементы.ГруппаБрак.Видимость=ИСтина;
		Элементы.ГруппаДополнительно.Видимость=Ложь;
		Если Не ЗначениеЗаполнено(Объект.Получатель) Тогда
			Объект.Получатель=ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		КонецЕсли;
		Элементы.Получатель.Видимость=Ложь;
		Элементы.ГруппаПартнерКонтрагент.Видимость=Истина;
	ИначеЕсли  Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВРемонт") Тогда
		Элементы.ГруппаТоварыОтбор.Видимость=Истина;
		Элементы.ГруппаФормы.Видимость=Ложь;
		Элементы.ГруппаБрак.Видимость=Ложь;
		Элементы.ГруппаДополнительно.Видимость=Ложь;
		Если Не ЗначениеЗаполнено(Объект.Получатель) Тогда
			Объект.Получатель=ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		КонецЕсли; 	
		Элементы.Получатель.Видимость=Ложь;
		Элементы.ГруппаПартнерКонтрагент.Видимость=Истина;
		
	ИначеЕсли  Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.СОтветственногоХранения") ИЛИ
		Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПеремещениеНаОтветственноеХранение") Тогда
		Элементы.ГруппаТоварыОтбор.Видимость=Истина;
		Элементы.ГруппаФормы.Видимость=Ложь;
