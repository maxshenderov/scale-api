		ТзНоменклатура=Объект.Товары.Выгрузить();
		ТзНоменклатура.Свернуть("Номенклатура","Количество");
		Объект.ЦеныНоменклатуры.Загрузить(ТзНоменклатура);
	Иначе
		Объект.ЦеныНоменклатуры.Очистить();
		
		
	КонецЕсли;
	
	Если Объект.ВнутренняяПродажа  Тогда
		Для каждого Номенклатура Из Объект.ЦеныНоменклатуры Цикл
			
			//Если ЗначениеЗаполнено(Объект.ЗаказКлиента) Тогда
			//	Сумма=Лико_Планирование.СтоимостьЗаказаДляПередачиМеждуОрганизациями(ОБъект.ЗаказКлиента,ПолучитьОрганизациюПоКонтрагенту(Объект.Контрагент));  
			//	Цена=Сумма/Объект.Товары.Итог("Количество");
			//	Номенклатура.Цена=Цена;
			//Иначе
				Для каждого Товар Из Объект.Товары Цикл
					Если Товар.Номенклатура=Номенклатура.Номенклатура Тогда
						СтруктураЦены=Лико_ОбщегоНазначенияСервер.ПолучитьСтруктуруЦеныНоменклатуры(Объект.Организация,Товар.Номенклатура,Объект.Дата,Товар.Серия);
						Если ТипЗнч(СтруктураЦены)=Тип("Структура") Тогда 							
							Цена=?(ЗначениеЗаполнено(СтруктураЦены.ЦенаИзПоставкиУпр),СтруктураЦены.ЦенаИзПоставкиУпр,СтруктураЦены.ЦенаИзПоследнейПоставкиУпр);
							Если ЗначениеЗаполнено(Цена) Тогда
								Номенклатура.Цена=Цена*1.01;
							КонецЕсли; 													
							Прервать;
						КонецЕсли;						
					КонецЕсли;			
				КонецЦикла;				
			//КонецЕсли;
			//СтруктураЦены=Лико_ОбщегоНазначенияСервер.СтруктураЦеныПоЦенновойГрупе(Номенклатура.Номенклатура.ЦеноваяГруппа,Объект.Организация);
			//Номенклатура.Цена=СтруктураЦены.ЦенаПоставщика*1.01;

		КонецЦикла;
	КонецЕсли;
	
	
	
