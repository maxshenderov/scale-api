&НаКлиенте
Процедура ПередЗаписью180326(Отказ, ПараметрыЗаписи)
	 
	 Если НеВыполнятьПроверкуПередЗаписью Тогда
		НеВыполнятьПроверкуПередЗаписью = Ложь;
		Возврат;
	КонецЕсли;
	
	
	
	Если  КонтролироватьСкладПриходаРасхода Тогда
		Стоп=Ложь;
		Для каждого Товар Из Объект.Товары Цикл
			НомерСтроки=Товар.ПолучитьИдентификатор();
			
			ПомещениеРасход=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Товар.АдресХранения,"Помещение");
			Если Объект.Помещение<>	ПомещениеРасход Тогда
				Стоп=Истина;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Расход товара с помещения:"""+Строка(ПомещениеРасход)+""" запрещено!";
				Сообщение.Поле = "Объект.Товары["+Формат(НомерСтроки,"ЧГ=")+"].АдресХранения"; //имя реквизита 
				Сообщение.УстановитьДанные(Объект); //Ссылка на объект ИБ
				Сообщение.Сообщить();
			КонецЕсли;
			
			
		КонецЦикла;	
		Если  Стоп Тогда
			Отказ=Истина;
			Возврат; 		
			
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.Проведен и Не ПараметрыЗаписи.РежимЗаписи=РежимЗаписиДокумента.ОтменаПроведения Тогда
		ПоказатьПредупреждение(Неопределено, "Перед записью документа необходимо отменить проведение!");
		Отказ=Истина;
	КонецЕсли;
	
	
	Если Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Продажа") и  Не ПараметрыЗаписи.РежимЗаписи=РежимЗаписиДокумента.ОтменаПроведения ТОгда
		Ликофлекс=ОрганизацияЛикофлекс();
		ИксПак=ОрганизацияИксПак();
		Если Объект.Контрагент=УправлениеСвойствамиСервер(Ликофлекс,"КонтрагентОрганизации_8e3f712fdca94791a890e1aa7853a0d2") И Объект.Организация=ИксПак Тогда
			Объект.ВнутренняяПродажа=Истина;  				
			Если Не ЗначениеЗаполнено(Объект.АдресХранения) Тогда
				Объект.АдресХранения=УправлениеСвойствамиСервер(Ликофлекс,"Лико_ЗонаПриемкиСИМ"); 			
			КонецЕсли;
			
		КонецЕсли;
		Если Объект.Контрагент=УправлениеСвойствамиСервер(ИксПак,"КонтрагентОрганизации_8e3f712fdca94791a890e1aa7853a0d2") И Объект.Организация=Ликофлекс  Тогда
			Объект.ВнутренняяПродажа=Истина;  				
			Если Не ЗначениеЗаполнено(Объект.АдресХранения) Тогда
				Объект.АдресХранения=УправлениеСвойствамиСервер(ИксПак,"Лико_ЗонаПриемкиСИМ"); 			
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не Объект.ОтражатьВБухгалтерскомУчете Тогда
			Объект.ОтражатьВБухгалтерскомУчете=Истина;
			ЗаполнитьТаблицуСЦенами();
			УстановитьВидимость();
			
		КонецЕсли; 	
		
		Для каждого ТекЦена Из Объект.ЦеныНоменклатуры Цикл
			
