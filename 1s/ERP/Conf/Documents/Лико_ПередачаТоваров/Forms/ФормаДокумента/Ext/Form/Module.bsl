Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи) 
	
	Если Объект.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Продажа И 
		Не Объект.ВнутренняяПродажа И 
		Не ЗначениеЗаполнено(Объект.Договор) Тогда
		
		
		ДляДокумента	                =	Лико_ОбщегоНазначенияСервер.ПолучитьСтруктуруДляЗаполненияТиповыхДокументов(Объект.Контрагент,Объект.Валюта,Объект.ВидОперации);
		
		Объект.Договор					=	ДляДокумента.Договор;
		Объект.СоглашениеСКлиентами	    =	ДляДокумента.Соглашение;
		Объект.СпособДоставки			=	ДляДокумента.СпособДоставки;
		Объект.ИнтерКампани             =	ДляДокумента.ИнтерКампани;
		
		
		
	КонецЕсли;
	
	
	
