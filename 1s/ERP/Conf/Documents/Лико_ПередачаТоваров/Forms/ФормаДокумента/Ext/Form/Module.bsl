	Структура.Вставить("Склад",Объект.Склад);
	Структура.Вставить("Помещение",Объект.Помещение);
	Структура.Вставить("Период",?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата,ТекущаяДата()));
	Структура.Вставить("ТолькоОстатки",Истина);
	
	
	ОписаниеОповещения=Новый ОписаниеОповещения("ПодборНоменклатурыЗавершение",ЭтаФорма);
	ОткрытьФорму("Справочник.Номенклатура.Форма.Лико_ФормаВыбора_Склад",Структура,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборНоменклатурыЗавершение(РезультатФормы,ПараметрыФормы) Экспорт //+Лико m.shenderov 25.10.2017
	Если ТипЗнч(РезультатФормы)=Тип("Массив") Тогда
		
		Для каждого Товар Из РезультатФормы  Цикл
			ТекущаяСтрока = Товар;
			СтруктураДействий = Новый Структура;
			ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий,"");
			ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения); 
			
			// Если  ЗначениеЗаполнено(Товар.Серия) Тогда
			//    
			// СтруктураСерии= ПолучитьСтруктуруСерии(Товар.Серия);
			// 
			// 
			//КонецЕсли;
			
			
			СтруктураНоменклатуры = Новый Структура;
			СтруктураНоменклатуры.Вставить("Номенклатура");
			СтруктураНоменклатуры.Вставить("Характеристика");
			СтруктураНоменклатуры.Вставить("Серия");
			
			ЗаполнитьЗначенияСвойств(СтруктураНоменклатуры,Товар);
			Если Объект.Товары.НайтиСтроки(СтруктураНоменклатуры).Количество()=0 Тогда
				НовыйТовар=Объект.Товары.Добавить(); 			 
				
				ЗаполнитьЗначенияСвойств(НовыйТовар,Товар);
				
				НовыйТовар.АдресХранения=Товар.Ячейка;
				
				
				НовыйТовар.ХарактеристикиИспользуются=ЗначениеЗаполнено(НовыйТовар.Характеристика);
				НовыйТовар.СтатусУказанияСерий=?(ЗначениеЗаполнено(НовыйТовар.Серия),8,0);
				НовыйТовар.ТипНоменклатуры=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(НовыйТовар.Номенклатура,"ТипНоменклатуры");  
				
				
				
				
				
				
			КонецЕсли;
			
			
		КонецЦикла;
		
		
		
		ПослеЗаписиНаСервере();
		
		
		
		
	КонецЕсли;
	
	
	
	
КонецПроцедуры //-Лико m.shenderov 25.10.2017


&НаСервереБезКонтекста
Функция ПолучитьСтруктуруСерии(Серия) //+Лико m.shenderov 24.10.2017
	Структура = Новый Структура;
	Структура.Вставить("Номенклатура",Неопределено);
	Структура.Вставить("Характеристика",Неопределено);
	Структура.Вставить("КоличествоУпаковок",Неопределено);
	Структура.Вставить("Серия",Неопределено);
	Структура.Вставить("Упаковка",Неопределено);
	Структура.Вставить("Количество",Неопределено); 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СерииНоменклатуры.ЯССМ_ОбъектНоменклатуры.Номенклатура КАК Номенклатура,
	|	СерииНоменклатуры.Ссылка КАК Серия,
	|	СерииНоменклатуры.ЯССМ_ОбъектНоменклатуры.Характеристика КАК Характеристика,
	|	СерииНоменклатуры.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения КАК Упаковка,
	|	СерииНоменклатуры.ЯССМ_ОбъектНоменклатуры.Количество КАК КоличествоУпаковок,
	|	СерииНоменклатуры.ЯССМ_ОбъектНоменклатуры.Количество * СерииНоменклатуры.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель КАК Количество
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|ГДЕ
	|	СерииНоменклатуры.Ссылка = &Серия";
	Запрос.УстановитьПараметр("Серия",Серия );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Структура,Выборка);
	КонецЦикла; 
	Возврат Структура;
	
КонецФункции  //-Лико m.shenderov 24.10.2017

&НаСервере
Процедура ЗаявкаНаСкладПриИзмененииНаСервере()
	ЗаполнитьПоЗаявке();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоЗаявке()
	
	Если ЗначениеЗаполнено(Объект.ЗаявкаНаСклад) Тогда
		//Объект.Получатель=Объект.ЗаявкаНаСклад.РабочийЦентр;
		//Объект.ЗаказКлиента=Объект.ЗаявкаНаСклад.ЗаказКлиента;
		//Объект.НомерБланка=Объект.ЗаявкаНаСклад.НомерБланка;
		
		Объект.ЗаказКлиента= Объект.ЗаявкаНаСклад.ЗаказКлиента;
		Объект.Получатель= Объект.ЗаявкаНаСклад.РабочийЦентр; 
		Объект.Партнер =  Объект.ЗаявкаНаСклад.Партнер;
		Объект.Контрагент =  Объект.ЗаявкаНаСклад.Контрагент;
		Если Не Объект.Проведен И Не ЗначениеЗаполнено(Объект.Распоряжение) И ЗначениеЗаполнено(Объект.ЗаявкаНаСклад.ВидОперации) Тогда
			Объект.ВидОперации= Объект.ЗаявкаНаСклад.ВидОперации;
