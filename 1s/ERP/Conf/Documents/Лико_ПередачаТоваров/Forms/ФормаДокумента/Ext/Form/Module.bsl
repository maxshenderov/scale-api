Процедура ВидОперацииПриИзменении(Элемент)
	Объект.Получатель=Неопределено;
	Если ЗначениеЗаполнено(Объект.Распоряжение) Тогда
		ПометитьНаУдалениеРаспоряжение(Объект.Распоряжение);	
		Объект.Распоряжение=Неопределено;	
	КонецЕсли;
	УстановитьВидимость();
	Если Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство") Или
		Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение") Или 
		Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Списание") Или
		Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.СписаниеФорм") Или
		Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаФорм") ТОгда
		Объект.Партнер=Неопределено;
		Объект.Контрагент=Неопределено;
	Иначе
		Объект.Получатель=Неопределено;
	КонецЕсли;
	Объект.ВозвратДавальцу			=Ложь;
	Объект.ВнутренняяПереработка	=Ложь;
	Объект.ВнутренняяПродажа		=ложь;
 ПересчитатьВесОбъемВСтрокахТЧ();
	
КонецПроцедуры

