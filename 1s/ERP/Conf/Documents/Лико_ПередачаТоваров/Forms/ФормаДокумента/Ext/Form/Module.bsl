&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// <-- Начало Лико Яцун С. В. 27.10.2025 
	Если ПараметрыЗаписи.Свойство("НарушинПринципФИФОЛИФО") И ПараметрыЗаписи.НарушинПринципФИФОЛИФО.Письмо <> "" Тогда
		Если Найти(ПараметрыЗаписи.НарушинПринципФИФОЛИФО.Вопрос,"ФИФО") > 0 Тогда
			МетодУчета = "ФИФО";
		Иначе
			МетодУчета = "ЛИФО";
		КонецЕсли;
		Если ПараметрыЗаписи.НарушинПринципФИФОЛИФО.ВидОперации = ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.СОтветственногоХранения") Тогда
			ТемаПисьма = "В перемещении С ответственного хранения " + Объект.Номер + " от " + Формат(Объект.Дата,"ДФ=dd.MM.yyyy") + " нарушен принцип " + МетодУчета;
			ТекстПисьма = "В перемещении С ответственного хранения " + Объект.Номер + " от " + Формат(Объект.Дата,"ДФ=dd.MM.yyyy") + " нарушен принцип " + МетодУчета + "<br>" + "<br>" + ПараметрыЗаписи.НарушинПринципФИФОЛИФО.Письмо;
		ИначеЕсли ПараметрыЗаписи.НарушинПринципФИФОЛИФО.ВидОперации = ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение") Тогда
			ТемаПисьма = "В Перемещении " + Объект.Номер + " от " + Формат(Объект.Дата,"ДФ=dd.MM.yyyy") + " нарушен принцип " + МетодУчета;
			ТекстПисьма = "В Перемещении " + Объект.Номер + " от " + Формат(Объект.Дата,"ДФ=dd.MM.yyyy") + " нарушен принцип " + МетодУчета + "<br>" + "<br>" + ПараметрыЗаписи.НарушинПринципФИФОЛИФО.Письмо;
		Иначе
			ТемаПисьма = "В Передаче в производство " + Объект.Номер + " от " + Формат(Объект.Дата,"ДФ=dd.MM.yyyy") + " нарушен принцип " + МетодУчета;
			ТекстПисьма = "В Передаче в производство " + Объект.Номер + " от " + Формат(Объект.Дата,"ДФ=dd.MM.yyyy") + " нарушен принцип " + МетодУчета + "<br>" + "<br>" + ПараметрыЗаписи.НарушинПринципФИФОЛИФО.Письмо;
		КонецЕсли;
		ОтправитьПисьмо(ТекстПисьма, ТемаПисьма, ПараметрыЗаписи.НарушинПринципФИФОЛИФО.Адресаты);
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 27.10.2025
	
	СформироватьТаблицуТиповыхДокументов();
	ПослеЗаписиНаСервере();
	УстановитьВидимость();
	ЗаполнитьТаблицуТиповыеДокументы();
	
	Если ЭтоБылНовый И ПечататьСкладОперацииДокументаПриПроведении И Объект.Проведен Тогда
		Если Объект.Товары.Количество()>5 
			и (Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Списание")
			Или Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение")) Тогда
			ОписаниеОповещения= Новый ОписаниеОповещения("ПослеЗаписиПечатьСкладскойКарточки",ЭтаФорма);
			ПоказатьВопрос(ОписаниеОповещения,"Пеатать карточку складской операции?",РежимДиалогаВопрос.ДаНет);
		Иначе 			
			ПечатьСкладскойКарточки(Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	
	ЗаполнитьРаспоряжениеВнутреннейПереработки();	
	
КонецПроцедуры

