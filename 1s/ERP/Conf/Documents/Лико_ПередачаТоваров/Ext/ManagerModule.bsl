Функция ЭтоОтветственноеХранение(Документ) //+Лико m.shenderov 15.02.2026
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения
	|ИЗ
	|	Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
	|ГДЕ
	|	Лико_ПередачаТоваровТовары.Ссылка = &Ссылка
	|	И ВЫБОР
	|			КОГДА Лико_ПередачаТоваровТовары.АдресХраненияНовый = ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
	|				ТОГДА Лико_ПередачаТоваровТовары.Ссылка.АдресХранения.Лико_ОрганизацияОтветственногоХранения <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ИНАЧЕ Лико_ПередачаТоваровТовары.АдресХраненияНовый.Лико_ОрганизацияОтветственногоХранения <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА Лико_ПередачаТоваровТовары.АдресХраненияНовый = ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
	|				ТОГДА Лико_ПередачаТоваровТовары.Ссылка.АдресХранения.Помещение
	|			ИНАЧЕ Лико_ПередачаТоваровТовары.АдресХраненияНовый.Помещение
	|		КОНЕЦ <> Лико_ПередачаТоваровТовары.АдресХранения.Помещение
	|	И Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|ИЗ
	|	Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
	|ГДЕ
	|	Лико_ПередачаТоваровТовары.Ссылка = &Ссылка
	|	И Лико_ПередачаТоваровТовары.АдресХранения.Лико_ОрганизацияОтветственногоХранения <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|	И ВЫБОР
	|			КОГДА Лико_ПередачаТоваровТовары.АдресХраненияНовый = ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
	|				ТОГДА Лико_ПередачаТоваровТовары.Ссылка.АдресХранения.Помещение
	|			ИНАЧЕ Лико_ПередачаТоваровТовары.АдресХраненияНовый.Помещение
	|		КОНЕЦ <> Лико_ПередачаТоваровТовары.АдресХранения.Помещение
	|	И Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение)";
	Запрос.УстановитьПараметр("Ссылка",Документ.Ссылка);
	Возврат  Не Запрос.Выполнить().Пустой();
	
	
	
	
	
КонецФункции //-Лико m.shenderov 15.02.2026 


