Функция ДополнительныеИсточникиДанныхДляДвижений(ИмяРегистра) Экспорт
	
	ИсточникиДанных = Новый Соответствие;
	
	Возврат ИсточникиДанных; 
	
КонецФункции
 
Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументОбъект, ТаблицаСписанияНоменклатуры)  
	
	ДокументСсылка = ДокументОбъект.Ссылка;
	СтруктураНоменклатуры = ПолучитьСтруктуруНоменклатуры(ДокументСсылка);

	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = 

	"ВЫБРАТЬ
	|	Лико_ПередачаТоваров.Дата КАК Период,
	|	Лико_ПередачаТоваров.Склад КАК Склад,
	|	Лико_ПередачаТоваров.Помещение КАК Помещение,
	|	Лико_ПередачаТоваров.ВидОперации КАК ВидОперации,
	|	Лико_ПередачаТоваров.ЗаданиеНаПеревозку КАК ЗаданиеНаПеревозку,
	|	ВЫБОР
	|		КОГДА Лико_ПередачаТоваров.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Списание)
	|			ТОГДА Лико_ПередачаТоваров.Подразделение
	|		ИНАЧЕ Лико_ПередачаТоваров.Партнер
	|	КОНЕЦ КАК Получатель,
	|	Лико_ПередачаТоваров.Организация КАК Организация,
	|	Лико_ПередачаТоваров.Подразделение КАК Подразделение,
	|	Лико_ПередачаТоваров.ЗаказВПереработку КАК РаспоряжениеДляПереработки 
	|ИЗ
	|	Документ.Лико_ПередачаТоваров КАК Лико_ПередачаТоваров
	|ГДЕ
	|	Лико_ПередачаТоваров.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	Запрос.УстановитьПараметр("Склад",       				Реквизиты.Склад);
	Запрос.УстановитьПараметр("Период",      				Реквизиты.Период);
	Запрос.УстановитьПараметр("ВидОперации", 				Реквизиты.ВидОперации);
	Запрос.УстановитьПараметр("ЗаданиеНаПеревозку", 		Реквизиты.ЗаданиеНаПеревозку); 
	Запрос.УстановитьПараметр("Получатель", 				
	?(ДокументСсылка.ИнтерКампани,Справочники.Лико_ПредопределенныеЗначения.СкладИнтеркампани.ЗначениеПараметра,Реквизиты.Получатель));
	Запрос.УстановитьПараметр("Помещение",         			Реквизиты.Помещение);
	Запрос.УстановитьПараметр("Организация",    			Реквизиты.Организация);
	Запрос.УстановитьПараметр("Подразделение",      		Реквизиты.Подразделение);
	Запрос.УстановитьПараметр("ТаблицаТмцВЭксплуатации",    ПолучитьТаблицуТмцВЭксплуатации(ДокументСсылка));
	//Запрос.УстановитьПараметр("МомВрем", Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("МомВрем"						,КонецДня(Реквизиты.Период));
	Запрос.УстановитьПараметр("ВидНоменклатурыОснастка"		,Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыОснастка.ЗначениеПараметра);
	
	//Запрос.УстановитьПараметр("НоменклатураПодЗаказ"		,ПолучитьНоменклатуруПодЗаказ(ДокументСсылка));
	//Запрос.УстановитьПараметр("НоменклатураСписания"		,ПолучитьНоменклатуруСписания(ДокументСсылка));
	//Запрос.УстановитьПараметр("ТмцВЭксплуатации"            ,ПолучитьНоменклатуруПодПередачуВЭксплуатацию(ДокументСсылка.Товары.Выгрузить(),ДокументСсылка)); 
	
	Запрос.УстановитьПараметр("НоменклатураПодЗаказ"		,СтруктураНоменклатуры.ПодЗаказ);
	Запрос.УстановитьПараметр("НоменклатураСписания"		,СтруктураНоменклатуры.Списание);
	Запрос.УстановитьПараметр("ТмцВЭксплуатации"            ,СтруктураНоменклатуры.ПередачуВЭксплуатацию);

	ЯчейкаПолучательПроизводство  = ДокументСсылка.Получатель.ЛикоЯчейка;
	
	Обработки.ПеремещениеТоваровДоп.КорректировкаЯчейкиРабочегоЦентра(
	ДокументСсылка.Организация,
	ДокументСсылка.Дата, 
	ЯчейкаПолучательПроизводство);
	
	Запрос.УстановитьПараметр("ЯчейкаПолучательПроизводство"            ,ЯчейкаПолучательПроизводство);

	//Распределение краски через колористическую
	ЦеховаяКладоваяКраски = Реквизиты.Склад.Лико_Площадка.ЦеховаяКладовая;
	//ЦеховаяКладоваяКраски=УправлениеСвойствами.ЗначениеСвойства(ДокументСсылка.Организация,"Лико_Колористическая");
	Если  ДокументСсылка.БракМатериала Тогда
		ЦеховаяКладоваяКраски=Неопределено;
	КонецЕсли;
	
		СписаниеКраскиЧерезЦеховуюКладовую=ЗначениеЗаполнено(ЦеховаяКладоваяКраски)
	И  Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаСписаниеКраскиЧерезЦеховуюКладовую.ЗначениеПараметра<ДокументСсылка.Дата;
	
	РаспоряжениеНаКраску=Документы.ЗаказМатериаловВПроизводство.ПустаяСсылка();
	Если ДокументСсылка.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Списание Тогда
		Если СписаниеКраскиЧерезЦеховуюКладовую	Тогда
			РаспоряжениеНаКраску=Лико_ОбщегоНазначенияСервер.СоздатьПолучитьРаспоряжениеНаКраску(ДокументСсылка);			
		Иначе
			РаспоряжениеНаКраску=Документы.ЗаказМатериаловВПроизводство.ПустаяСсылка();
		КонецЕсли; 
	КонецЕсли;
	Запрос.УстановитьПараметр("СписаниеКраскиЧерезЦеховуюКладовую",СписаниеКраскиЧерезЦеховуюКладовую);
	Запрос.УстановитьПараметр("ЦеховаяКладоваяКраски",ЦеховаяКладоваяКраски);
	Запрос.УстановитьПараметр("СписаниеКраскиЧерезЦеховуюКладовую",СписаниеКраскиЧерезЦеховуюКладовую);
	Запрос.УстановитьПараметр("РаспоряжениеНаКраску",РаспоряжениеНаКраску);
	Запрос.УстановитьПараметр("ВидНоменклатурыКраска",Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыКраска.ЗначениеПараметра);
	Запрос.УстановитьПараметр("ТзСписанияНоменклатуры",ТаблицаСписанияНоменклатуры);
	Запрос.УстановитьПараметр("РазделУчетаТоваровНаСкладах",Перечисления.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах);
	Запрос.УстановитьПараметр("ВалютаТоветственногоХранения",Константы.ВалютаРегламентированногоУчета.Получить());

КонецПроцедуры
 
Функция ТекстЗапросаТаблицаТоварыВЯчейках(Запрос, ТекстыЗапроса, Регистры,ТаблицаСписанияНоменклатуры)
	
	ИмяРегистра = "ТоварыВЯчейках";
	
	Если НЕ ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ ПроведениеДокументов.ЕстьТаблицаЗапроса("ВтСписанияНоменклатуры", ТекстыЗапроса) Тогда
		ТекстЗапросаВтСписанияНоменклатуры(Запрос, ТекстыЗапроса,ТаблицаСписанияНоменклатуры);
	КонецЕсли;
	

	ТекстЗапроса = 
	//Выполнено - Приходуем всю таблицу размещения
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ВтСписанияНоменклатуры.Номенклатура КАК Номенклатура,
	|	ВтСписанияНоменклатуры.Характеристика КАК Характеристика,
	|	ВтСписанияНоменклатуры.Серия КАК Серия,
	|	ВЫБОР
	|		КОГДА ВтСписанияНоменклатуры.Серия.ЯССМ_ОбъектНоменклатуры <> ЗНАЧЕНИЕ(Справочник.ЯССМ_ОбъектыНоменклатуры.ПустаяСсылка)
	|			ТОГДА ВтСписанияНоменклатуры.Серия.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|	КОНЕЦ КАК Упаковка,
	|	&ЯчейкаПолучательПроизводство КАК Ячейка,
	|	ВтСписанияНоменклатуры.КоличествоУпаковок КАК ВНаличии,
	|	0 КАК КОтбору,
	|	0 КАК КРазмещению,
	|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение
	|ИЗ
	|	ВтСписанияНоменклатуры КАК ВтСписанияНоменклатуры
	|ГДЕ
	|	НЕ ВтСписанияНоменклатуры.СписатьСЯчейки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	Лико_ПередачаТоваровТовары.Номенклатура,
	|	Лико_ПередачаТоваровТовары.Характеристика,
	|	ВЫБОР
	|		КОГДА Лико_ПередачаТоваровТовары.СтатусУказанияСерий В (4, 6, 8, 10, 14)
	|			ТОГДА Лико_ПередачаТоваровТовары.Серия
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Лико_ПередачаТоваровТовары.Серия.ЯССМ_ОбъектНоменклатуры <> ЗНАЧЕНИЕ(Справочник.ЯССМ_ОбъектыНоменклатуры.ПустаяСсылка)
	|			ТОГДА Лико_ПередачаТоваровТовары.Серия.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Лико_ПередачаТоваровТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Упаковка)
	|					ТОГДА Лико_ПередачаТоваровТовары.Упаковка
	|				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|			КОНЕЦ
	|	КОНЕЦ,
	|	Лико_ПередачаТоваровТовары.АдресХранения,
	|	Лико_ПередачаТоваровТовары.КоличествоУпаковок,
	|	0,
	|	0,
	|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|ИЗ
	|	Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
	|ГДЕ
	|	Лико_ПередачаТоваровТовары.Ссылка = &Ссылка
	|	И (Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство)
	|			ИЛИ Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение)
	|			ИЛИ Лико_ПередачаТоваровТовары.Ссылка.ВнутренняяПереработка
	|			ИЛИ Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаДавальцу)
	|			ИЛИ Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПеремещениеНаОтветственноеХранение)
	|			ИЛИ Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаМол))
	|	И Лико_ПередачаТоваровТовары.Ссылка.БезПеремещения = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	Лико_ПередачаТоваровТовары.Номенклатура,
	|	Лико_ПередачаТоваровТовары.Характеристика,
	|	ВЫБОР
	|		КОГДА Лико_ПередачаТоваровТовары.СтатусУказанияСерий В (4, 6, 8, 10, 14)
	|			ТОГДА Лико_ПередачаТоваровТовары.Серия
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Лико_ПередачаТоваровТовары.Серия.ЯССМ_ОбъектНоменклатуры <> ЗНАЧЕНИЕ(Справочник.ЯССМ_ОбъектыНоменклатуры.ПустаяСсылка)
	|			ТОГДА Лико_ПередачаТоваровТовары.Серия.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Лико_ПередачаТоваровТовары.Упаковка.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Упаковка)
	|					ТОГДА Лико_ПередачаТоваровТовары.Упаковка
	|				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|			КОНЕЦ
	|	КОНЕЦ,
	|	Лико_ПередачаТоваровТовары.АдресХранения,
	|	Лико_ПередачаТоваровТовары.КоличествоУпаковок,
	|	0,
	|	0,
	|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|ИЗ
	|	Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
	|ГДЕ
	|	Лико_ПередачаТоваровТовары.Ссылка = &Ссылка
	|	И (Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПереработку)
	|			ИЛИ Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ВозвратПоставщику)
	|			ИЛИ Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВРемонт)
	|			ИЛИ Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.СответственногоХранения)
	|			ИЛИ Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Продажа)
	|			ИЛИ Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Списание))
	|	И НЕ Лико_ПередачаТоваровТовары.Ссылка.ВнутренняяПереработка
	|	И Лико_ПередачаТоваровТовары.Ссылка.БезПеремещения = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	Лико_ПередачаТоваровТовары.Номенклатура,
	|	Лико_ПередачаТоваровТовары.Характеристика,
	|	ВЫБОР
	|		КОГДА Лико_ПередачаТоваровТовары.СтатусУказанияСерий В (4, 6, 8, 10, 14)
	|			ТОГДА Лико_ПередачаТоваровТовары.Серия
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Лико_ПередачаТоваровТовары.Серия.ЯССМ_ОбъектНоменклатуры <> ЗНАЧЕНИЕ(Справочник.ЯССМ_ОбъектыНоменклатуры.ПустаяСсылка)
	|			ТОГДА Лико_ПередачаТоваровТовары.Серия.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения
