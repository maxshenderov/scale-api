		ИмяРегистра = "Лико_КонтрольВозвратовПоставщику";
		
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
