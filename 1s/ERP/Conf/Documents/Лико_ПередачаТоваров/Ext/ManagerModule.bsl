	|					ИЗ
	|						Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
	|					ГДЕ
	|						Лико_ПередачаТоваровТовары.Ссылка = &Ссылка)) КАК ТоварыНаСкладахОстатки
	|		ПО Лико_ПередачаТоваровТовары.Серия = ТоварыНаСкладахОстатки.Серия
	|ГДЕ
	|	Лико_ПередачаТоваровТовары.Ссылка = &Ссылка
	|	И Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Продажа)
	|	И Лико_ПередачаТоваровТовары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.Пустаяссылка)
	|	И ТоварыНаСкладахОстатки.ВНаличииОстаток > 0
	|	И НЕ Лико_ПередачаТоваровТовары.АдресХранения.Лико_ОтветственноеХранение
	|	И Лико_ПередачаТоваровТовары.Ссылка.ВнутренняяПродажа
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	СписанияНоменклатуры.Номенклатура,
	|	СписанияНоменклатуры.Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка),
	|	СписанияНоменклатуры.Серия,
	|	СписанияНоменклатуры.КоличествоБУ,
	|	&Склад,
	|	&Помещение,
	|	&Получатель,
	|	ЗНАЧЕНИЕ(Справочник.СкладскиеПомещения.ПустаяСсылка),
	|	&Ссылка,
	|	ЗНАЧЕНИЕ(Перечисление.СкладскиеОперации.ОтгрузкаКлиенту),
	|	ИСТИНА
	|ИЗ
	|	ВтСписанияНоменклатуры КАК СписанияНоменклатуры
	|ГДЕ
	|	СписанияНоменклатуры.КоличествоБУ > 0";

	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

	Возврат ТекстЗапроса

