Функция ПроверитьФИФОЛИФО_в1(Отказ,РежимЗаписи,Объект) // <-- Начало Лико Яцун С. В. 16.10.2025
	
	УстановитьПривилегированныйРежим(Истина);
	
	Вопрос = "";
	Письмо = "";
	Адресаты = "";
	МеждуАнгарИОсновной = "";
	//Если Объект.ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение 
	//	И Объект.Товары[0].АдресХранения.Помещение.Наименование = "Склад №2  (Ликофлекс)" 
	//	И Объект.АдресХранения.Помещение.Наименование = "СИМ  (Ликофлекс)" Тогда
	//	МеждуАнгарИОсновной = "ФИФО"
	//ИначеЕсли Объект.ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение 
	//	И Объект.Товары[0].АдресХранения.Помещение.Наименование = "СИМ  (Ликофлекс)" 
	//	И Объект.АдресХранения.Помещение.Наименование = "Склад №2  (Ликофлекс)" Тогда
	//	МеждуАнгарИОсновной = "ЛИФО"
	//КонецЕсли;
	
	Если НЕ (Объект.ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение 
			ИЛИ Объект.ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.СОтветственногоХранения 
			ИЛИ Объект.ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство) 
		ИЛИ (ЗначениеЗаполнено(Объект.ЗаявкаНаСклад) И Объект.ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение И МеждуАнгарИОсновной = "") Тогда
		Вопрос = Новый Структура("Вопрос,ВидОперации,Письмо,Адресаты",Вопрос,Объект.ВидОперации,Письмо,Адресаты);
		Возврат Вопрос;	
	КонецЕсли;
	
	
	ТзТоварыСтарые =   Объект.Ссылка.Товары.Выгрузить(,"Серия");
	ТзТоварыНовые  = Объект.Товары.Выгрузить(,"Серия");
	
	ТзТоварыСтарые.Свернуть("Серия");
	ТзТоварыНовые.Свернуть("Серия");
	
	ЕстьИзмененияТоваров = Лико_Дополнительно.СравнениеДвухОдинаковыхТаблицЗначенийПоСодержимому(ТзТоварыСтарые,ТзТоварыНовые);
	
	Если ЕстьИзмененияТоваров 
		И РежимЗаписи = РежимЗаписиДокумента.Проведение 
		И НЕ Отказ 
		И Объект.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра
		И (Объект.АдресХранения.Лико_Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра 
			ИЛИ Объект.ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство И Объект.Получатель.Лико_Площадка = Справочники.Лико_Площадки.Ликофлекс) Тогда
		ТЗ = Объект.Товары.Выгрузить();
		КвалификаторыДаты = Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя);
		ТЗ.Колонки.Добавить("ДатаФормирования",Новый ОписаниеТипов("Дата", , ,КвалификаторыДаты));	
		Для каждого СтрТЗ Из ТЗ Цикл
			СтрТЗ.ДатаФормирования = СтрТЗ.Серия.ЯССМ_ОбъектНоменклатуры.ДатаФормирования;
		КонецЦикла;
		Если (ТЗ[0].АдресХранения.Лико_УдаленныйСклад ИЛИ ТЗ[0].АдресХранения.Лико_ОтветственноеХранение) 
			И НЕ Объект.АдресХранения.Лико_УдаленныйСклад 
			ИЛИ Объект.ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство 
			ИЛИ МеждуАнгарИОсновной = "ФИФО" Тогда
			//ФИФО проверяем сначала более свежие
			ТЗ.Сортировать("ДатаФормирования Убыв");
		ИначеЕсли (НЕ ТЗ[0].АдресХранения.Лико_УдаленныйСклад ИЛИ ТЗ[0].АдресХранения.Лико_ОтветственноеХранение) И Объект.АдресХранения.Лико_УдаленныйСклад Тогда
			//ЛИФО проверяем сначала более старые
			ТЗ.Сортировать("ДатаФормирования");
		КонецЕсли;		
		МассивСерийПеремещения = ТЗ.ВыгрузитьКолонку("Серия");
		МассивПодобранныхСерий = Новый Массив;
		Для каждого Стр Из ТЗ Цикл
			Если Стр.АдресХранения.Лико_Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра 
				И Стр.АдресХранения.Владелец.Лико_Площадка = Справочники.Лико_Площадки.Ликофлекс
				И НЕ Стр.АдресХранения.Лико_ПомещениеБрака
				И ЗначениеЗаполнено(Стр.Серия) 
				И (Стр.Номенклатура.ВидНоменклатуры.Наименование = "Краска" И Стр.Серия.ЯССМ_ОбъектНоменклатуры.Уникальный ИЛИ Стр.Номенклатура.ЦеноваяГруппа.Лико_ВидТМЦ = Справочники.Лико_ВидыТМЦ.Чернила) Тогда
				Если (Стр.АдресХранения.Лико_УдаленныйСклад ИЛИ Стр.АдресХранения.Лико_ОтветственноеХранение) И НЕ Объект.АдресХранения.Лико_УдаленныйСклад 
					ИЛИ Объект.ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство 
					ИЛИ МеждуАнгарИОсновной = "ФИФО" Тогда
					МетодУчета = "ФИФО";
					ВопросНайден = "ранний";
				ИначеЕсли (НЕ Стр.АдресХранения.Лико_УдаленныйСклад ИЛИ Стр.АдресХранения.Лико_ОтветственноеХранение) И Объект.АдресХранения.Лико_УдаленныйСклад Тогда
					МетодУчета = "ЛИФО";
					ВопросНайден = "свежий";
				Иначе
					Продолжить;
				КонецЕсли;	
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.ДатаФормирования КАК ДатаФормирования,
				|	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.НомерПоставки КАК НомерПоставки,
				|	ТоварыВЯчейкахОстатки.Серия КАК Серия
				|ИЗ
				|	РегистрНакопления.ТоварыВЯчейках.Остатки(
				|			&ДатаОстатков,
				|			Номенклатура = &Номенклатура
				|				И НАЧАЛОПЕРИОДА(Серия.ЯССМ_ОбъектНоменклатуры.ДатаФормирования, ДЕНЬ) < НАЧАЛОПЕРИОДА(&ДатаФормированияТМЦ, ДЕНЬ)
				|				И НЕ Серия В (&МассивСерийПеремещения)
				|				И НЕ Серия В (&МассивПодобранныхСерий)
				|				И НЕ Ячейка.Лико_ПомещениеБрака
				|				И ВЫБОР
				|					КОГДА &УдаленныйСклад
				|							ИЛИ &ОтветХранение
				|							ИЛИ &МеждуАнгарИОсновной
				|						ТОГДА Ячейка.Помещение = &Помещение
				|					ИНАЧЕ Ячейка.Лико_ТипСклада = &ТипСклада
				|							И Ячейка.Лико_Организация = &Организация
				|							И Ячейка.Владелец = &Склад
				|							И НЕ Ячейка.Лико_ОтветственноеХранение
				|							И НЕ Ячейка.Лико_УдаленныйСклад
				|				КОНЕЦ) КАК ТоварыВЯчейкахОстатки
				|
				|СГРУППИРОВАТЬ ПО
				|	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.ДатаФормирования,
				|	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.НомерПоставки,
				|	ТоварыВЯчейкахОстатки.Серия
				|
				|УПОРЯДОЧИТЬ ПО
				|	ДатаФормирования";
				
				Запрос.УстановитьПараметр("ДатаОстатков", ?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата,ТекущаяДата()));
				Запрос.УстановитьПараметр("ДатаФормированияТМЦ", Стр.Серия.ЯССМ_ОбъектНоменклатуры.ДатаФормирования);
				Запрос.УстановитьПараметр("МассивСерийПеремещения", МассивСерийПеремещения);
				Запрос.УстановитьПараметр("МассивПодобранныхСерий", МассивПодобранныхСерий);
				Запрос.УстановитьПараметр("Номенклатура", Стр.Номенклатура);
				Запрос.УстановитьПараметр("Помещение", Стр.АдресХранения.Помещение);
				Запрос.УстановитьПараметр("Организация", Стр.АдресХранения.Лико_Организация);
				Запрос.УстановитьПараметр("Склад", Стр.АдресХранения.Владелец);
				Запрос.УстановитьПараметр("ТипСклада", Стр.АдресХранения.Лико_ТипСклада);
				Запрос.УстановитьПараметр("УдаленныйСклад", Стр.АдресХранения.Лико_УдаленныйСклад);
				Запрос.УстановитьПараметр("ОтветХранение", Стр.АдресХранения.Лико_ОтветственноеХранение);
				Запрос.УстановитьПараметр("МеждуАнгарИОсновной", МеждуАнгарИОсновной <> "");
				
				Если МетодУчета = "ЛИФО" Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст,"<",">");	
					Запрос.Текст = СтрЗаменить(Запрос.Текст,"УПОРЯДОЧИТЬ ПО
															|	ДатаФормирования","УПОРЯДОЧИТЬ ПО
															|	ДатаФормирования УБЫВ");	
				КонецЕсли;
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					МассивПодобранныхСерий.Добавить(ВыборкаДетальныеЗаписи.Серия); 
					НомерПоставки = Стр.Серия.ЯССМ_ОбъектНоменклатуры.НомерПоставки;
					ДатаФормирования = Стр.Серия.ЯССМ_ОбъектНоменклатуры.ДатаФормирования;
					ТекстВопроса = "Нарушен принцип "+ МетодУчета + ", для ТМЦ """ + Стр.Номенклатура.Наименование + """, #" + НомерПоставки + " от " + Формат(ДатаФормирования,"ДФ=dd.MM.yyyy") 
					+ " - есть более " + ВопросНайден + " - " + "#" + ВыборкаДетальныеЗаписи.НомерПоставки + " от " + Формат(ВыборкаДетальныеЗаписи.ДатаФормирования,"ДФ=dd.MM.yyyy");
					Вопрос = ?(Вопрос = "", ТекстВопроса,Вопрос + "; " + Символы.ПС + Символы.ПС + ТекстВопроса);
					ТекстПисьма = "Для ТМЦ """ + Стр.Номенклатура.НаименованиеПолное
					+ ?(Найти(НРег(Стр.Номенклатура.НаименованиеПолное),НРег(Стр.Номенклатура.Артикул)) > 0,""," (" + Стр.Номенклатура.Артикул +")") 
					+ """, #" + НомерПоставки + " от " + Формат(ДатаФормирования,"ДФ=dd.MM.yyyy") 
					+ " - есть более " + ВопросНайден + " - " + "#" + ВыборкаДетальныеЗаписи.НомерПоставки + " от " + Формат(ВыборкаДетальныеЗаписи.ДатаФормирования,"ДФ=dd.MM.yyyy");
					Письмо = ?(Письмо = "", ТекстПисьма,Письмо + "<br>" + "<br>" + ТекстПисьма);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Вопрос = Новый Структура("Вопрос,ВидОперации,Письмо,Адресаты",Вопрос,Объект.ВидОперации,Письмо,Адресаты);
		Возврат Вопрос; 
	КонецЕсли;
	                                        	
	Если МеждуАнгарИОсновной <> "" Тогда
		Адресаты = "sklad_sm@okil-sato.ru";
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство") Тогда
		Адресаты = "OlegPak@okil.ru;ALeshev@okil-sato.ru;MBuyanov@okil-sato.ru;OLyaskovskaya@okil-sato.ru;sklad_sm@okil-sato.ru";
		Если Объект.Товары.Количество() > 0 И ЗначениеЗаполнено(Объект.Товары[0].АдресХранения.Помещение) И Объект.Товары[0].АдресХранения.Помещение.Наименование = "Цифровой участок  (Ликофлекс)" Тогда
			Адресаты = "OlegPak@okil.ru;sboreckiy@okil-sato.ru;cifrasklad@okil-sato.ru;OLyaskovskaya@okil-sato.ru;MBuyanov@okil-sato.ru";
		КонецЕсли;
	Иначе
		Адресаты = "MBuyanov@okil-sato.ru;ALeshev@okil-sato.ru;OlegPak@okil.ru;OLyaskovskaya@okil-sato.ru";
