	//ТекстЗапросаТаблицаТМЦВЭксплуатации(Запрос, ТекстыЗапроса, Регистры);
	
	//Начало изменений Иванова Анна 20181027
	ТекстЗапросаТаблицаЛикоОснасткаПоЗаказу(Запрос, ТекстыЗапроса, Регистры);
	//КонецИзменений Иванова Анна 20181027   
	ТекстЗапросаТаблицаЛико_СписаниеНаЗаказ(Запрос, ТекстыЗапроса, Регистры);
	//ТекстЗапросаВтСписанияНоменклатуры(Запрос, ТекстыЗапроса,ТаблицаСписанияНоменклатуры);
    ТекстЗапросаТаблицаЛико_КонтрольВозвратовПоставщику(Запрос, ТекстыЗапроса, Регистры); 			
		
	КонецЕсли;
	
	////////////////////////////////////////////////////////////////////////////
	// Получим таблицы для движений
	
	Возврат ПроведениеДокументов.ИнициализироватьДанныеДокументаДляПроведения(Запрос, ТекстыЗапроса, ДопПараметры);
	
КонецФункции 

