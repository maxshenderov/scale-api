	Перемещение						= ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение");
	ВозвратПоставщику				= ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ВозвратПоставщику");
	ПередачаВРемонт					= ПредопределенноеЗначение("Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВРемонт");
