Функция ТекстЗапросаВтСписанияНоменклатуры(Запрос, ТекстыЗапроса,ТаблицаСписанияНоменклатуры)
	ИмяРегистра = "ВтСписанияНоменклатуры";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВтСписанияНоменклатуры.Номенклатура КАК Номенклатура,
	|	ВтСписанияНоменклатуры.Характеристика КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение,
	|	ВтСписанияНоменклатуры.Серия КАК Серия,
	|	ВЫБОР
	|		КОГДА ВтСписанияНоменклатуры.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.Пустаяссылка)
	|			ТОГДА 0
	|		ИНАЧЕ 8
	|	КОНЕЦ КАК СтатусУказанияСерий,
	|	ВтСписанияНоменклатуры.СписатьСЯчейки КАК СписатьСЯчейки,
	|	ВтСписанияНоменклатуры.Склад КАК Склад,
	|	ВтСписанияНоменклатуры.Получатель КАК Получатель,
	|	ВтСписанияНоменклатуры.Распоряжение КАК Распоряжение,
	|	ВтСписанияНоменклатуры.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ВтСписанияНоменклатуры.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ВтСписанияНоменклатуры.КоличествоБУ < ВтСписанияНоменклатуры.Количество
	|			ТОГДА ВтСписанияНоменклатуры.КоличествоБУ
	|		ИНАЧЕ ВтСписанияНоменклатуры.Количество
	|	КОНЕЦ КАК КоличествоБУ,
	|	ВЫБОР
	|		КОГДА ВтСписанияНоменклатуры.Количество > 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК МожноСписать,
	|	ИСТИНА КАК ДопРасход
	|ПОМЕСТИТЬ ВтСписанияНоменклатуры
	|ИЗ
	|	&ТзСписанияНоменклатуры КАК ВтСписанияНоменклатуры";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;
	
	
	
