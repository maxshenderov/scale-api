Функция ПроверитьФИФОЛИФО(Отказ,РежимЗаписи,Объект, УчетПравилПеремещенияТМЦ) Экспорт // <-- Начало Лико Яцун С. В. 16.10.2025
Ответ = "";	
	
	Если УчетПравилПеремещенияТМЦ Тогда
		
		Результат  = Неопределено; 
		Если 	РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			
			Справочники.Лико_ПравилаПеремещенияТМЦ.ВыполнитьПроверку(Объект,Отказ,Результат);
			
		КонецЕсли;
		
		
		Если ТипЗнч(Результат)=Тип("Структура") И Результат.Свойство("ПроверкаПравил") Тогда
			
			Если ТипЗнч(Результат.ПроверкаПравил)=Тип("ТаблицаЗначений") Тогда
				
				Ответ=Результат.ПроверкаПравил.ВыгрузитьКолонку("Комментарий");	
				
			КонецЕсли;
			
		КонецЕсли;
		
		
	Иначе
		
		Ответ  = ПроверитьФИФОЛИФО_в1(Отказ,РежимЗаписи,Объект);
		
	КонецЕсли;
Возврат  Ответ;
КонецФункции  // <-- Конец Лико Яцун С. В. 16.10.2025   

