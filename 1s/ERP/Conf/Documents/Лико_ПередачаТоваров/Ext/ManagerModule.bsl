		|	Лико_ПередачаТоваровТовары.Ссылка.Организация КАК Организация,
		|	Лико_ПередачаТоваровТовары.ДокументПоступления.Партнер КАК Поставщик,
		|	Лико_ПередачаТоваровТовары.ДокументПоступления КАК ДокументПоступления,
		|	Лико_ПередачаТоваровТовары.Номенклатура КАК Номенклатура,
		|	Лико_ПередачаТоваровТовары.ХарактеристикаПоступления КАК Характеристика,
		|	Лико_ПередачаТоваровТовары.Количество КАК Количество
		|ИЗ
		|	Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
		|ГДЕ
		|	Лико_ПередачаТоваровТовары.Ссылка = &Ссылка
		|	И Лико_ПередачаТоваровТовары.Ссылка.Склад.Лико_ДатаНачалаКонтроляВозвратов <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	И Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ВозвратПоставщику)
		|	И Лико_ПередачаТоваровТовары.Ссылка.Склад.Лико_ДатаНачалаКонтроляВозвратов <= &Период";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;

