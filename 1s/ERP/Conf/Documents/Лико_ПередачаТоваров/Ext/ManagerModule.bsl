	|	Лико_ПередачаТоваровТовары.Характеристика КАК Характеристика,
	|	СУММА(Лико_ПередачаТоваровТовары.Количество) КАК Количество,
	|	Лико_ПередачаТоваровТовары.Ссылка.Организация КАК Организация,
	|	Лико_ПередачаТоваровТовары.Ссылка.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ ВтТМЦ
	|ИЗ
	|	Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
	|ГДЕ
	|	Лико_ПередачаТоваровТовары.Ссылка = &Ссылка
	|	И (Лико_ПередачаТоваровТовары.Номенклатура.ВидНоменклатуры.Лико_ТМЦ_ВЭксплуатации
	|			ИЛИ Лико_ПередачаТоваровТовары.Номенклатура.Лико_ТМЦ_ВЭксплуатации)
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ПередачаТоваровТовары.Номенклатура,
	|	Лико_ПередачаТоваровТовары.Характеристика,
	|	Лико_ПередачаТоваровТовары.Ссылка.Организация,
	|	Лико_ПередачаТоваровТовары.Ссылка.Подразделение
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	Подразделение,
	|	Номенклатура,
	|	Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ТМЦВЭксплуатацииОбороты.Организация, ВтДвижениеДокумента.Организация) КАК Организация,
	|	ЕСТЬNULL(ТМЦВЭксплуатацииОбороты.Подразделение, ВтДвижениеДокумента.Подразделение) КАК Подразделение,
	|	ЕСТЬNULL(ТМЦВЭксплуатацииОбороты.ФизическоеЛицо, ВтДвижениеДокумента.ФизическоеЛицо) КАК ФизическоеЛицо,
	|	ЕСТЬNULL(ТМЦВЭксплуатацииОбороты.Номенклатура, ВтДвижениеДокумента.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(ТМЦВЭксплуатацииОбороты.Характеристика, ВтДвижениеДокумента.Характеристика) КАК Характеристика,
	|	ЕСТЬNULL(ТМЦВЭксплуатацииОбороты.Партия, ВтДвижениеДокумента.Партия) КАК Партия,
	|	СУММА(ЕСТЬNULL(ТМЦВЭксплуатацииОбороты.КоличествоОборот, 0) + ЕСТЬNULL(ВтДвижениеДокумента.Количество, 0)) КАК КоличествоПартия
	|ПОМЕСТИТЬ ВтОстатки
	|ИЗ
	|	РегистрНакопления.ТМЦВЭксплуатации.Обороты(
	|			,
	|			&Дата,
	|			,
	|			(Организация, Подразделение, Номенклатура, Характеристика) В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					ВтТМЦ.Организация КАК Организация,
	|					ВтТМЦ.Подразделение КАК Подразделение,
	|					ВтТМЦ.Номенклатура КАК Номенклатура,
	|					ВтТМЦ.Характеристика КАК Характеристика
	|				ИЗ
	|					ВтТМЦ КАК ВтТМЦ)) КАК ТМЦВЭксплуатацииОбороты
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВтДвижениеДокумента КАК ВтДвижениеДокумента
	|		ПО ТМЦВЭксплуатацииОбороты.Организация = ВтДвижениеДокумента.Организация
	|			И ТМЦВЭксплуатацииОбороты.Подразделение = ВтДвижениеДокумента.Подразделение
	|			И ТМЦВЭксплуатацииОбороты.ФизическоеЛицо = ВтДвижениеДокумента.ФизическоеЛицо
	|			И ТМЦВЭксплуатацииОбороты.Номенклатура = ВтДвижениеДокумента.Номенклатура
	|			И ТМЦВЭксплуатацииОбороты.Характеристика = ВтДвижениеДокумента.Характеристика
	|			И ТМЦВЭксплуатацииОбороты.Партия = ВтДвижениеДокумента.Партия
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(ТМЦВЭксплуатацииОбороты.Организация, ВтДвижениеДокумента.Организация),
	|	ЕСТЬNULL(ТМЦВЭксплуатацииОбороты.Подразделение, ВтДвижениеДокумента.Подразделение),
	|	ЕСТЬNULL(ТМЦВЭксплуатацииОбороты.ФизическоеЛицо, ВтДвижениеДокумента.ФизическоеЛицо),
	|	ЕСТЬNULL(ТМЦВЭксплуатацииОбороты.Номенклатура, ВтДвижениеДокумента.Номенклатура),
	|	ЕСТЬNULL(ТМЦВЭксплуатацииОбороты.Характеристика, ВтДвижениеДокумента.Характеристика),
	|	ЕСТЬNULL(ТМЦВЭксплуатацииОбороты.Партия, ВтДвижениеДокумента.Партия)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтОстатки.Организация КАК Организация,
	|	ВтОстатки.Подразделение КАК Подразделение,
	|	ВтОстатки.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВтОстатки.Номенклатура КАК Номенклатура,
	|	ВтОстатки.Характеристика КАК Характеристика,
	|	ВтОстатки.Партия КАК Партия,
	|	ВтОстатки.КоличествоПартия КАК КоличествоПартия,
	|	МАКСИМУМ(ВтТМЦ.Количество) КАК Количество
	|ИЗ
	|	ВтОстатки КАК ВтОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтТМЦ КАК ВтТМЦ
	|		ПО ВтОстатки.Организация = ВтТМЦ.Организация
	|			И ВтОстатки.Подразделение = ВтТМЦ.Подразделение
	|			И ВтОстатки.Номенклатура = ВтТМЦ.Номенклатура
	|			И ВтОстатки.Характеристика = ВтТМЦ.Характеристика
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтОстатки.Организация,
	|	ВтОстатки.Подразделение,
	|	ВтОстатки.ФизическоеЛицо,
	|	ВтОстатки.Номенклатура,
	|	ВтОстатки.Характеристика,
	|	ВтОстатки.Партия,
	|	ВтОстатки.КоличествоПартия
	|ИТОГИ
	|	МИНИМУМ(Количество)
	|ПО
	|	Номенклатура,
	|	Характеристика";
	Запрос.УстановитьПараметр("Ссылка",ДокументСсылка.Ссылка );
	Запрос.УстановитьПараметр("Дата",ДокументСсылка.Дата );
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаНоменклатура = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаНоменклатура.Следующий() Цикл
		ВыборкаХарактеристика = ВыборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаХарактеристика.Следующий() Цикл
			ОсталосьСписать=ВыборкаХарактеристика.Количество;
			Выборка=ВыборкаХарактеристика.Выбрать();
			Пока Выборка.Следующий() Цикл 
				Если ОсталосьСписать<=0 Тогда
					Прервать;
				КонецЕсли;				
				Тмц=ТЗ.Добавить();
				ЗаполнитьЗначенияСвойств(ТМц,Выборка,,"Количество");
				Списать=Мин(ОсталосьСписать,Выборка.КоличествоПартия);
				Тмц.Количество=Списать;
				ОсталосьСписать=ОсталосьСписать-Списать;
			КонецЦикла; 			
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТЗ;
	
	
КонецФункции  


Функция ПолучитьСтруктуруНоменклатуры(ДокументСсылка)

	СтруктураНоменклатуры = Новый Структура;
	СтруктураНоменклатуры.Вставить("ПодЗаказ", Новый Массив());
	СтруктураНоменклатуры.Вставить("Списание", Новый Массив());
	СтруктураНоменклатуры.Вставить("ВнутреннееПотребление", Новый Массив());
	СтруктураНоменклатуры.Вставить("ПередачуВЭксплуатацию", Новый Массив());
	СтруктураНоменклатуры.Вставить("СтруктураПередачиВЭксплуатацию", Новый Массив()); 

	Для каждого Товар Из ДокументСсылка.Товары Цикл
		Правило=Товар.ПравилоСписания;

		Если ЗначениеЗаполнено(Правило) И Правило.ТипСписания=Перечисления.Лико_ТипыСписанияНоменклатурыВПроизводство.ПодЗаказ Тогда

			СтруктураНоменклатуры.ПодЗаказ.Добавить(Товар.Номенклатура);

		КонецЕсли; 

		Если ЗначениеЗаполнено(Правило) И (Правило.ТипСписания=Перечисления.Лико_ТипыСписанияНоменклатурыВПроизводство.ПередачаВЭксплуатацию Или Правило.ТипСписания=Перечисления.Лико_ТипыСписанияНоменклатурыВПроизводство.ПередачаВЭксплуатацию) Тогда

			СтруктураНоменклатуры.Списание.Добавить(Товар.Номенклатура);

		КонецЕсли; 

		Если ЗначениеЗаполнено(Правило) И (Правило.ТипСписания=Перечисления.Лико_ТипыСписанияНоменклатурыВПроизводство.СписаниеНаВнутреннееПотребление) Тогда

			СтруктураНоменклатуры.ВнутреннееПотребление.Добавить(Товар.Номенклатура); 

		КонецЕсли; 

		Если ЗначениеЗаполнено(Правило) И (Правило.ТипСписания=Перечисления.Лико_ТипыСписанияНоменклатурыВПроизводство.ПередачаВЭксплуатацию) Тогда

			СтруктураНоменклатуры.ПередачуВЭксплуатацию.Добавить(Товар.Номенклатура);

		КонецЕсли; 

		Если ЗначениеЗаполнено(Правило) И (Правило.ТипСписания=Перечисления.Лико_ТипыСписанияНоменклатурыВПроизводство.ПередачаВЭксплуатацию ) Тогда

			Структура = Новый Структура;
			Структура.Вставить("Номенклатура",Товар.Номенклатура);
			Структура.Вставить("КатегорияЭксплуатации",Правило.КатегорияЭксплуатации);
			Структура.Вставить("Правило",Правило); 			
			СтруктураНоменклатуры.СтруктураПередачиВЭксплуатацию.Добавить(Структура);

		КонецЕсли; 

	КонецЦикла; 


	Возврат СтруктураНоменклатуры;

КонецФункции


