#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ИнициализироватьДокумент(ДанныеЗаполнения); 		
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    УстановитьПривилегированныйРежим(Истина);
	
	УстановитьПризакБрак();
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ИнтерКампани=Ложь;

	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	
	Если ЭтоНовый() Тогда
		ЭтотОбъект.ОбменДанными.Загрузка = Истина;
		ЭтотОбъект.Записать();
		ЭтотОбъект.ОбменДанными.Загрузка = Ложь;
		
	КонецЕсли; 
	
	Если Проведен и РежимЗаписи<>РежимЗаписиДокумента.ОтменаПроведения Тогда
		Отказ=Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Перед записью документа необходимо отменить проведение!";
		Сообщение.Сообщить();
	КонецЕсли;
	
	
	ПроверкаЯССМСклада(Отказ,РежимЗаписи,РежимПроведения);
	ОбработкаВидаОперации(Отказ,РежимЗаписи,РежимПроведения);
	ОбработкаСерий();
	ПроверкаБлокировкиНоменклатурыПриВыдачиНаРц(Отказ,РежимЗаписи);
	BrcПроверкаБлокировкиНоментклатуры(Отказ);
	
	ПроверкаОтсутсвияМатериаловНаОтветственномХранении(Отказ,РежимЗаписи);
	
	ПроверкаРезерваМатериалов(Отказ,РежимЗаписи);
	КонтрольЗаполненияПартииПроизводства(Отказ,РежимЗаписи);
	ЗаполнитьПравилоСписанияНоменклатурыПриПередачеВПроизводство(Отказ, РежимЗаписи);
	ЗаполнитьСклады(Отказ, РежимЗаписи);

	// --> Начало Лико Ефимов ЕВВ 24.08.2021
	ПроверитьЯчейкиНаСоответствиеРабочимЦентрам(Отказ, РежимЗаписи);
	ПроверитьПередачуОснасткиНаМашину(Отказ, РежимЗаписи, РежимПроведения);
	// <-- Конец Лико Ефимов ЕВВ 24.08.2021 

	// -->   Субботин 02.12.2022
	Если Получатель.ПорядковыйНомер = 17 Тогда  
		//проверка на 2 любых глубоких вала
		ПроверитьГлубокиеВалы(Отказ, РежимЗаписи, РежимПроведения);
	КонецЕсли;
	// <--

	
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	ДополнительныеСвойства.Вставить("БылПроведен", Проведен); 

	//Если Не ДополнительныеСвойства.БылПроведен  Тогда	
	//	ОбработатьРаспоряжение(РежимЗаписи,Отказ);
	//КонецЕсли;		

	СписаниеИзЭксплуатации();  		

	Если Не Отказ Тогда
		ЯчекаПереработка=ОпределитьЯчейкуДляПереработки();
		ЯчейкаМОЛ=ОпределитьЯчейкуМОЛ();
	КонецЕсли;

	ЗаполнитьРеквизитыДляПечати();
	ПроверкаОрганизацииСкладаИлиРЦ(Отказ,РежимЗаписи);
	ПроверкаВидаОперацииДляСкладаОтветственноеХранениеBRC(Отказ,РежимЗаписи);
	ЗаполнитьДопРеквизитыВТчТоварыДляВозвратаПоставщику(РежимЗаписи);
	//ПроверитьНаличиеЦеныНаОснастку();
	ПроведениеДокументов.ПередЗаписьюДокумента(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	ВозможностьИспользованияВнутреннийПереработки(Отказ,РежимЗаписи); 
	КонтрольНаличияФотоРулонногоМатериала(Отказ, РежимЗаписи);
	КонтрольПеремещенияОтветХранения(Отказ, РежимЗаписи);
КонецПроцедуры

Процедура УстановитьПризакБрак() 
	
	Если ЗначениеЗаполнено(ПричинаСписания) И ПричинаСписания=Справочники.Лико_ПричиныСписания.Брак Тогда
		БракМатериала=Истина;
	КонецЕсли;
	

КонецПроцедуры 


Процедура  ПроверитьГлубокиеВалы(Отказ, РежимЗаписи, РежимПроведения)  
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ВидОперации <> Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство Тогда
		Возврат;
	КонецЕсли;
		
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РабочиеЦентры.ЛикоЯчейка КАК Ячейка
		|ПОМЕСТИТЬ ВТ_ЯчейкиРабочихЦентров
		|ИЗ
		|	Справочник.РабочиеЦентры КАК РабочиеЦентры
		|ГДЕ
		|	НЕ РабочиеЦентры.ВидРабочегоЦентра В (&ВидыРЦИсключения)
		|	И РабочиеЦентры.ЛикоЯчейка <> ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	РабочиеЦентры.ЛикоЯчейка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТЗ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ВЫРАЗИТЬ(ТЗ.Серия КАК Справочник.СерииНоменклатуры) КАК Серия,
		|	ВЫРАЗИТЬ(ТЗ.НомерСтроки КАК ЧИСЛО(15, 0)) КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА (ВЫРАЗИТЬ(ТЗ.АдресХраненияНовый КАК Справочник.СкладскиеЯчейки)) = ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
		|			ТОГДА &АдресИзШапки
		|		ИНАЧЕ ВЫРАЗИТЬ(ТЗ.АдресХраненияНовый КАК Справочник.СкладскиеЯчейки)
		|	КОНЕЦ КАК АдресХранения
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Серия КАК Серия,
		|	ВТ.НомерСтроки КАК НомерСтроки,
		|	ВТ.АдресХранения КАК АдресХранения,
		|	ДопРеквизитОснасткаВид.Значение КАК Вал,
		|	ДопРеквизитВидШтампа.Значение КАК ГлубокаяПечать
		|ПОМЕСТИТЬ ВТ_ТолькоОснасткаПередающаясяНаРЦ
		|ИЗ
		|	ВТ КАК ВТ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ЯчейкиРабочихЦентров КАК ВТ_ЯчейкиРабочихЦентров
		|		ПО ВТ.АдресХранения = ВТ_ЯчейкиРабочихЦентров.Ячейка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДопРеквизитВидШтампа
		|		ПО ВТ.Номенклатура = ДопРеквизитВидШтампа.Ссылка
		|			И (ДопРеквизитВидШтампа.Свойство.Имя = ""ОстасткаВидШтампа"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДопРеквизитОснасткаВид
		|		ПО ВТ.Номенклатура = ДопРеквизитОснасткаВид.Ссылка
		|			И (ДопРеквизитОснасткаВид.Свойство.Имя = ""ОснасткаВид"")
		|ГДЕ
		|	ВТ.Номенклатура.ВидНоменклатуры = &ВидНоменклатурыОснастка
		|	И ДопРеквизитВидШтампа.Значение = ЗНАЧЕНИЕ(Справочник.Лико_видШтампа.ГлубокаяПечать)
		|	И ДопРеквизитОснасткаВид.Значение = ЗНАЧЕНИЕ(Перечисление.Лико_ВидОснастки.Вал)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(1) КАК КоличествоРазличныхВДокументе
		|ПОМЕСТИТЬ ВТ_КоличествоРазличныхВДокументе
		|ИЗ
		|	ВТ_ТолькоОснасткаПередающаясяНаРЦ КАК ВТ_ТолькоОснасткаПередающаясяНаРЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ТолькоОснасткаПередающаясяНаРЦ.Вал,
		|	ВТ_ТолькоОснасткаПередающаясяНаРЦ.ГлубокаяПечать
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Серия КАК Серия,
		|	ВТ.НомерСтроки КАК НомерСтроки,
		|	ВТ.АдресХранения КАК АдресХранения,
		|	ВТ_КоличествоРазличныхВДокументе.КоличествоРазличныхВДокументе КАК КоличествоРазличныхВДокументе,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТоварыВЯчейкахОстатки.Серия) КАК КоличествоШтамповНаМашинеСТакойЖеНоменклатурой
		|ПОМЕСТИТЬ ВТ_Итог
		|ИЗ
		|	ВТ_ТолькоОснасткаПередающаясяНаРЦ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
		|				&ДатаОстатков,
		|				(Номенклатура, Ячейка) В
		|					(ВЫБРАТЬ
		|						ВТ.Номенклатура,
		|						ВТ.АдресХранения
		|					ИЗ
		|						ВТ)) КАК ТоварыВЯчейкахОстатки
		|		ПО ВТ.Серия <> ТоварыВЯчейкахОстатки.Серия
		|			И ВТ.АдресХранения = ТоварыВЯчейкахОстатки.Ячейка,
		|	ВТ_КоличествоРазличныхВДокументе КАК ВТ_КоличествоРазличныхВДокументе
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ.Серия,
		|	ВТ.НомерСтроки,
		|	ВТ.АдресХранения,
		|	ВТ_КоличествоРазличныхВДокументе.КоличествоРазличныхВДокументе
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Итог.Серия КАК Серия,
		|	ВТ_Итог.НомерСтроки КАК НомерСтроки,
		|	ВТ_Итог.АдресХранения КАК АдресХранения,
		|	ВТ_Итог.КоличествоРазличныхВДокументе КАК КоличествоРазличныхВДокументе,
		|	ВТ_Итог.КоличествоШтамповНаМашинеСТакойЖеНоменклатурой КАК КоличествоШтамповНаМашинеСТакойЖеНоменклатурой
		|ИЗ
		|	ВТ_Итог КАК ВТ_Итог
		|ГДЕ
		|	ВТ_Итог.КоличествоРазличныхВДокументе > 1";
	
	Запрос.УстановитьПараметр("ТЗ", Товары.Выгрузить(, "Номенклатура,Серия,НомерСтроки,АдресХраненияНовый"));
	Запрос.УстановитьПараметр("АдресИзШапки", ?(ЗначениеЗаполнено(Получатель.ЛикоЯчейка), Получатель.ЛикоЯчейка, АдресХранения));
	Запрос.УстановитьПараметр("ДатаОстатков", ?(РежимПроведения = РежимПроведенияДокумента.Оперативный, Дата('39991231235959'), Дата));
	Запрос.УстановитьПараметр("ВидНоменклатурыОснастка", Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыОснастка.ЗначениеПараметра);
	Запрос.УстановитьПараметр("ВидыРЦИсключения", Лико_Дополнительно.СформироватьМассивИсключенийВидовРЦДляПоискаЯчеекРЦ());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка= РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Сообщение = Новый СообщениеПользователю;
		Если Выборка.КоличествоРазличныхВДокументе > 1 Тогда
			Сообщение.Текст = ?(ЗначениеЗаполнено(Ссылка), "" + Ссылка + " ", "") + "Строка №" + Выборка.НомерСтроки + ": по номенклатуре """ + Выборка.НоменклатураНаименованиеПолное + """ вы пытаетесь передать сразу " + Выборка.КоличествоРазличныхВДокументе + " шт. Разрешено передавать не более 1 вала глубокой печати.";
		Иначе
			Продолжить;
		КонецЕсли;	
		Сообщение.Поле = "Товары["+(Выборка.НомерСтроки-1)+"].Номенклатура";
		Сообщение.ПутьКДанным = "Объект";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;

	
	
КонецПроцедуры	

Процедура ПроверитьЯчейкиНаСоответствиеРабочимЦентрам(Отказ, РежимЗаписи) // --> Начало Лико Ефимов ЕВВ 27.08.2021
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	ДатаНачалаПроверкиЯчеекВПередачеСоСклада = Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаПроверкиЯчеекВПередачеСоСклада.ЗначениеПараметра;
	Если НЕ ЗначениеЗаполнено(ДатаНачалаПроверкиЯчеекВПередачеСоСклада) ИЛИ Дата < ДатаНачалаПроверкиЯчеекВПередачеСоСклада Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоПередачаВПроизводство = ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство;
	Если НЕ (ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение
		ИЛИ ЭтоПередачаВПроизводство
		ИЛИ ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПереработку
		) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РабочиеЦентры.ЛикоЯчейка КАК Ячейка
		|ПОМЕСТИТЬ ВТ_ЯчейкиРабочихЦентров
		|ИЗ
		|	Справочник.РабочиеЦентры КАК РабочиеЦентры
		|ГДЕ
		|	НЕ РабочиеЦентры.ВидРабочегоЦентра В (&ВидыРЦИсключения)
		|	И РабочиеЦентры.ЛикоЯчейка <> ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	РабочиеЦентры.ЛикоЯчейка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТЗ.АдресХранения КАК Справочник.СкладскиеЯчейки) КАК АдресХранения,
		|	ВЫРАЗИТЬ(ТЗ.АдресХраненияНовый КАК Справочник.СкладскиеЯчейки) КАК АдресХраненияНовый,
		|	ВЫРАЗИТЬ(ТЗ.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
		|	ВЫРАЗИТЬ(ТЗ.НомерСтроки КАК ЧИСЛО(15, 0)) КАК НомерСтроки
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.АдресХранения КАК АдресХранения,
		|	ВЫБОР
		|		КОГДА ВТ.АдресХраненияНовый = ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
		|			ТОГДА &ЯчейкаИзШапки
		|		ИНАЧЕ ВТ.АдресХраненияНовый
		|	КОНЕЦ КАК АдресХраненияНовыйСУчетомТЧ,
		|	ВТ.НомерСтроки КАК НомерСтроки,
		|	ВТ.Номенклатура КАК Номенклатура,
		|	ВТ.АдресХраненияНовый КАК АдресХраненияНовый
		|ПОМЕСТИТЬ ВТ2
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	ВТ.Номенклатура.ВидНоменклатуры = &ВидНоменклатурыОснастка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ2.АдресХранения КАК АдресХранения,
		|	ВТ2.АдресХраненияНовыйСУчетомТЧ КАК АдресХраненияНовыйСУчетомТЧ,
		|	ВТ2.НомерСтроки КАК НомерСтроки,
		|	ВЫБОР
		|		КОГДА ВТ_ЯчейкиРабочихЦентров.Ячейка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК АдресХраненияЯчейкаРЦ,
		|	ВЫБОР
		|		КОГДА ВТ_ЯчейкиРабочихЦентровНовый.Ячейка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК АдресХраненияНовыйЯчейкаРЦ,
		|	ВТ2.АдресХраненияНовый КАК АдресХраненияНовый
		|ПОМЕСТИТЬ ВТ3
		|ИЗ
		|	ВТ2 КАК ВТ2
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЯчейкиРабочихЦентров КАК ВТ_ЯчейкиРабочихЦентров
