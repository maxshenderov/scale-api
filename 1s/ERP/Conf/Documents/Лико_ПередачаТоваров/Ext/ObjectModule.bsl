		//КонецЕсли;


		Если Товар.Номенклатура.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыКраска.ЗначениеПараметра Или 
			Товар.Серия.ЯССМ_ОбъектНоменклатуры.Рулонный Тогда
			Нпор=Нпор+1;

			Продолжить;	
		КонецЕсли;
		//лОрганизацияНовая=?(ЗначениеЗаполнено(Товар.АдресХраненияНовый),Товар.АдресХраненияНовый.Помещение.Лико_Организация,АдресХранения.Помещение.Лико_Организация);
		//лОрганизация=Товар.АдресХранения.Помещение.Лико_Организация; 

		Если Не ЗначениеЗаполнено(лОрганизацияНовая) Тогда
			лОрганизацияНовая = товар.СкладПолучатель.Лико_Площадка.Организация;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(лОрганизация) Тогда
			лОрганизация = товар.СкладОтправитель.Лико_Площадка.Организация;
		КонецЕсли;

		Если  ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство Тогда
			лОрганизацияНовая=Получатель.Лико_Площадка.Организация;
		КонецЕсли;


		Если лОрганизация<>лОрганизацияНовая Тогда

			Отказ=Истина;	
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Товар: "+ Строка(Товар.Серия) +" нельзя перемещать в другую организацию. Оформите продажу!";
			Сообщение.Поле = "Товары["+Нпор+"].АдресХранения";; //имя реквизита 
			//Сообщение.КлючДанных = Ссылка;
			Сообщение.ПутьКДанным = "Объект";

			Сообщение.Сообщить();


		КонецЕсли;

		Нпор=Нпор+1;

	КонецЦикла;

КонецПроцедуры


Процедура ПроверитьНаличиеЦеныНаОснастку() //+Лико m.shenderov 26.03.2021
	Если ВидОперации<>Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Продажа Тогда
		Возврат;
	КонецЕсли;
	
	
	Массив = Новый Массив();
	
	
	
	Для каждого Номен Из ЦеныНоменклатуры Цикл
		Если Номен.Номенклатура.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыОснастка.ЗначениеПараметра 
			И Не ЗначениеЗаполнено(Номен.Цена)  Тогда
			Массив.Добавить(Номен.Номенклатура);			
		КонецЕсли;		
	КонецЦикла;
	
	
	Если Массив.Количество()=0 ТОгда
		Возврат;
	КонецЕсли;
	ВалютаEur=Константы.ВалютаУправленческогоУчета.Получить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПараметрыШтампа.Цена КАК Цена,
	|	Лико_ПараметрыШтампа.Номенклатура КАК Номенклатура,
	|	КурсыВалютСрезПоследних.Курс КАК КурсEur,
	|	КурсыВалютСрезПоследних1.Курс КАК Курс,
	|	Лико_ПараметрыШтампа.Цена * КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних1.Курс КАК ЦенаИтог
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа,
	|	РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &ВалютаEuro) КАК КурсыВалютСрезПоследних,
	|	РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &Валюта) КАК КурсыВалютСрезПоследних1
	|ГДЕ
	|	Лико_ПараметрыШтампа.Номенклатура В(&Номенклатура)";
	Запрос.УстановитьПараметр("Номенклатура",Массив);
	Запрос.УстановитьПараметр("Дата",Дата);
	Запрос.УстановитьПараметр("ВалютаEuro",ВалютаEur);
	Запрос.УстановитьПараметр("Валюта",Валюта);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл		
		СтрНоменклатуры=ЦеныНоменклатуры.Найти(Выборка.Номенклатура,"Номенклатура");		
		Если СтрНоменклатуры<>Неопределено Тогда			
			СтрНоменклатуры.Цена=Выборка.ЦенаИтог;		
		КонецЕсли;			
		
	КонецЦикла;	
КонецПроцедуры //-Лико m.shenderov 26.03.2021


Процедура ПроверкаБлокировкиНоменклатурыПриВыдачиНаРц(Отказ, РежимЗаписи)
	Если РежимЗаписи<>РежимЗаписиДокумента.Проведение Или
		ВидОперации<>Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство Или
		Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаБлокировкиПередачиНоменклатурыНаРЦ.ЗначениеПараметра>Дата Тогда
		Возврат;
	КонецЕсли;
	НомерСтроки=0;

	Для каждого Товар Из Товары Цикл
		Если ЗначениеЗаполнено(УправлениеСвойствами.ЗначениеСвойства(Товар.Номенклатура,"Лико_НеПередаватьНаРЦ")) Тогда
			Отказ=Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Материал:""%3. %1 %2"" заблокирован для выдачи на рабочий центр! Обратитесь в отдел снабжения.",
			Товар.Номенклатура.Код,
			Товар.Номенклатура,
			НомерСтроки+1);
			Сообщение.Поле = "Товары["+НомерСтроки+"].Номенклатура"; //имя реквизита
			Сообщение.ПутьКДанным = "Объект";
			Сообщение.Сообщить();
		КонецЕсли;
		Если Товар.Серия.ЯССМ_ОбъектНоменклатуры.Категория2=Истина И ОснасткаВыпускалась(Товар.Серия) Тогда
			Отказ=Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Оснастка:"" %1 "" не соответствует требованиям (категория К2)! Заблокирована для выдачи на рабочий центр.",
			Товар.Серия);
			Сообщение.Поле = "Товары["+НомерСтроки+"].Номенклатура"; //имя реквизита
			Сообщение.ПутьКДанным = "Объект";
			Сообщение.Сообщить();

		КонецЕсли;


		НомерСтроки=НомерСтроки+1;

	КонецЦикла;



КонецПроцедуры


Процедура ПроверкаРезерваМатериаловБезРегионов(Отказ, РежимЗаписи)

	Если Не Документы.Лико_УстановкаРезерваМатериалов.СтартСистемы() Тогда 
		Возврат;
	КонецЕсли;

	Если РежимЗаписи<>РежимЗаписиДокумента.Проведение Или
		ВидОперации<>Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство Тогда
		Возврат;
	КонецЕсли;



	НомерСтроки=0;

	Если Получатель.Лико_Резак Тогда 

		Партнер=ЗаявкаНаСклад.ЗаказНаРаскрой.Партнер;

	Иначе

		Партнер=ЗаказКлиента.Партнер; 

	КонецЕсли;

	Для каждого Товар Из Товары Цикл
		ОбъектНоменклатуры=Товар.Серия.ЯССМ_ОбъектНоменклатуры;
		ОбъектНоменклатуры_Партнер=ОбъектНоменклатуры.Партнер;
		Если ЗначениеЗаполнено(ОбъектНоменклатуры_Партнер) И ОбъектНоменклатуры_Партнер<> Партнер Тогда
			Отказ=Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Материал: №%3 (%1) - %2 - #%4, зарезервирован под заказы клиента: ""%5""!",
			Товар.Номенклатура.Код,
			Товар.Номенклатура,
			НомерСтроки+1,
			Формат(ОбъектНоменклатуры.НомерПоставки,"ЧДЦ=0; ЧГ="),
			ОбъектНоменклатуры_Партнер);
			Сообщение.Поле = "Товары["+НомерСтроки+"].Номенклатура"; //имя реквизита
			Сообщение.ПутьКДанным = "Объект";
			Сообщение.Сообщить();
		КонецЕсли;


		НомерСтроки=НомерСтроки+1;

	КонецЦикла;



КонецПроцедуры


Процедура ПроверкаРезерваМатериалов(Отказ, РежимЗаписи)

	Если Не Документы.Лико_УстановкаРезерваМатериалов.СтартСистемы() Тогда 
		Возврат;
	КонецЕсли;
	
	Если Не Документы.Лико_УстановкаРезерваМатериалов.СтартРезевированияПодРегионы() Тогда
		
		ПроверкаРезерваМатериаловБезРегионов(Отказ, РежимЗаписи);
		
		Возврат;
		
	КонецЕсли;


	Если РежимЗаписи<>РежимЗаписиДокумента.Проведение Или
		ВидОперации<>Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство Тогда
		Возврат;
	КонецЕсли;



	НомерСтроки=0;

	Если Получатель.Лико_Резак Тогда 

		Резерв=ЗаявкаНаСклад.ЗаказНаРаскрой.Резерв;
		БизнесРегион = Резерв;

	Иначе

		Резерв=ЗаказКлиента.Партнер;
		БизнесРегион = ЗаказКлиента.Регион;

	КонецЕсли;

	Для каждого Товар Из Товары Цикл
		ОбъектНоменклатуры=Товар.Серия.ЯССМ_ОбъектНоменклатуры;
		ОбъектНоменклатуры_Резерв=ОбъектНоменклатуры.Резерв;
		Если ЗначениеЗаполнено(ОбъектНоменклатуры_Резерв) И ОбъектНоменклатуры_Резерв<> Резерв И  ОбъектНоменклатуры_Резерв<> БизнесРегион Тогда
			Отказ=Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Материал: №%3 (%1) - %2 - #%4, зарезервирован под заказы : ""%5""!",
			Товар.Номенклатура.Код,
			Товар.Номенклатура,
			НомерСтроки+1,
			Формат(ОбъектНоменклатуры.НомерПоставки,"ЧДЦ=0; ЧГ="),
			ОбъектНоменклатуры_Резерв);
			Сообщение.Поле = "Товары["+НомерСтроки+"].Номенклатура"; //имя реквизита
			Сообщение.ПутьКДанным = "Объект";
			Сообщение.Сообщить();
		КонецЕсли;


		НомерСтроки=НомерСтроки+1;

	КонецЦикла;



КонецПроцедуры

Процедура КонтрольЗаполненияПартииПроизводства(Отказ, РежимЗаписи)
	
	Если Не ЗначениеЗаполнено(УправлениеСвойствами.ЗначениеСвойства(Организация,"Лико_ПрослеживаемостьТоваров")) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Справочники.Лико_КонтрольПартийПоризводстваНоменклатуры.Старт() Тогда 
		Возврат;
	КонецЕсли;

	Если Не (РежимЗаписи=РежимЗаписиДокумента.Проведение И 
		ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство Или 
		(ВидОперации<>Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПереработку и ВнутренняяПереработка))
		Тогда
		Возврат;
	КонецЕсли;



	НомерСтроки=0;


	Для каждого Товар Из Товары Цикл
		ОбъектНоменклатуры=Товар.Серия.ЯССМ_ОбъектНоменклатуры;

		Если Справочники.Лико_КонтрольПартийПоризводстваНоменклатуры.ТребоватьПартию(ОбъектНоменклатуры) Тогда
			Отказ=Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("У серии : № %1 , не заполнены данные о партии производства!",
			Товар.Серия);
			Сообщение.Поле = "Товары["+НомерСтроки+"].ПартияПроизводства"; //имя реквизита
			Сообщение.ПутьКДанным = "Объект";
			Сообщение.Сообщить();
		КонецЕсли; 
		НомерСтроки=НомерСтроки+1;

	КонецЦикла;





КонецПроцедуры

Процедура НаписатьПисьмоВыданНовыйШтамп()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПередачаТоваровТовары.Номенклатура КАК Номенклатура,
	|	Лико_ПередачаТоваровТовары.Ссылка.Получатель КАК РабочийЦентр,
	|	Лико_ПередачаТоваровТовары.Серия КАК Серия,
	|	СУММА(ЕСТЬNULL(ТоварыВЯчейках.ВНаличии, 0)) КАК КоличествоВыданных
	|ПОМЕСТИТЬ Вт
	|ИЗ
	|	Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
	|		ПО Лико_ПередачаТоваровТовары.Номенклатура = Лико_ПараметрыШтампа.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
	|		ПО Лико_ПередачаТоваровТовары.Серия = ТоварыВЯчейках.Серия
	|			И (ТоварыВЯчейках.Ячейка.Владелец = &Склад)
	|			И (ТоварыВЯчейках.Ячейка.Помещение = &ПомещениеПроизводство)
	|			И (ТоварыВЯчейках.Ячейка.Помещение.Лико_Организация = &Организация)
	|ГДЕ
	|	Лико_ПараметрыШтампа.ВидРабот.Родитель В(&ВидыРабот)
	|	И Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = &ВидОперации
	|	И Лико_ПередачаТоваровТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ПередачаТоваровТовары.Номенклатура,
	|	Лико_ПередачаТоваровТовары.Серия,
	|	Лико_ПередачаТоваровТовары.Ссылка.Получатель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт.Номенклатура КАК Номенклатура,
	|	Вт.РабочийЦентр КАК РабочийЦентр,
	|	Вт.Серия КАК Серия,
	|	Вт.КоличествоВыданных КАК КоличествоВыданных
	|ИЗ
	|	Вт КАК Вт
	|ГДЕ
	|	Вт.КоличествоВыданных = 0";
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("ВидОперации",Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство);
   Массив = Новый Массив();
   Массив.Добавить(Справочники.ВидыРаботСотрудников.Конгревы);
   Массив.Добавить(Справочники.ВидыРаботСотрудников.Тиснение);
	Запрос.УстановитьПараметр("ВидыРабот",Массив);
	Запрос.УстановитьПараметр("ПомещениеПроизводство",Получатель.ЛикоЯчейка.Помещение);
	Запрос.УстановитьПараметр("Склад",Склад);
	Запрос.УстановитьПараметр("Ссылка",Ссылка);

	Тз = Запрос.Выполнить().Выгрузить();
	Если Тз.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);  	
	
	ОтборНастройки				= Новый КомпоновщикНастроекКомпоновкиДанных;
	СхемаКомпоновкиДанных 		= Документы.Лико_ПередачаТоваров.ПолучитьМакет("НаписатьПисьмоВыданНовыйШтамп");
	ИсточникНастроек 			= Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных);
	ОтборНастройки.Инициализировать(ИсточникНастроек);
		

		ОтборНастройки.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
		//ОтборНастройки.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);

	УстановитьЗначениеПараметраНастроек(ОтборНастройки.Настройки, "Организация", Ссылка);
	УстановитьЗначениеПараметраНастроек(ОтборНастройки.Настройки,"ВидОперации",Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство); 
	УстановитьЗначениеПараметраНастроек(ОтборНастройки.Настройки,"ВидыРабот",Массив);
	УстановитьЗначениеПараметраНастроек(ОтборНастройки.Настройки,"ПомещениеПроизводство",Получатель.ЛикоЯчейка.Помещение);
	УстановитьЗначениеПараметраНастроек(ОтборНастройки.Настройки,"Склад",Склад);
	УстановитьЗначениеПараметраНастроек(ОтборНастройки.Настройки,"Ссылка",Ссылка);




	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
