 Процедура ЗаполнитьСклады(Отказ, РежимЗаписи) //+--->Лико m.shenderov 28.06.2024
	 
	 Если Отказ 
		 Или  РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		 
		 Возврат; 
		 
	 КонецЕсли;
	 
	 МассивАдресов = Новый Массив();  
	 МассивАдресов.Добавить(АдресХранения); 
	 
	 Если ЗначениеЗаполнено(Получатель) Тогда
		 
		 АдресРЦ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Получатель,"ЛикоЯчейка"); 
		 
		 Обработки.ПеремещениеТоваровДоп.КорректировкаЯчейкиРабочегоЦентра(Организация, Дата, АдресРЦ); 
		 
		 МассивАдресов.Добавить(АдресРЦ); 
		 
	 КонецЕсли; 
	 
	 Для каждого Товар Из  Товары Цикл
		 
		 Если МассивАдресов.Найти(Товар.АдресХранения)=Неопределено Тогда
			 МассивАдресов.Добавить(Товар.АдресХранения); 
		 КонецЕсли;
		 
		 Если ЗначениеЗаполнено(Товар.АдресХраненияНовый) 
			 И МассивАдресов.Найти(Товар.АдресХраненияНовый)=Неопределено Тогда
			 МассивАдресов.Добавить(Товар.АдресХраненияНовый); 
		 КонецЕсли; 	 
		 
	 КонецЦикла;
	 
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ РАЗЛИЧНЫЕ
	 |	СкладскиеЯчейки.Ссылка КАК Ссылка,
	 |	ВЫБОР
	 |		КОГДА СкладскиеЯчейки.Лико_СкладОтветственногоХранения = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	 |			ТОГДА СкладскиеЯчейки.Владелец
	 |		ИНАЧЕ СкладскиеЯчейки.Лико_СкладОтветственногоХранения
	 |	КОНЕЦ КАК Владелец,
	 |	СкладскиеЯчейки.Помещение КАК Помещение
	 |ИЗ
	 |	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
	 |ГДЕ
	 |	СкладскиеЯчейки.Ссылка В(&МассивАдресов)";
	 Запрос.УстановитьПараметр("МассивАдресов",МассивАдресов );
	 РезультатЗапроса = Запрос.Выполнить();
	 
	 Выборка = РезультатЗапроса.Выбрать();
	 СооАдресов = Новый Соответствие;
	 
	 Пока Выборка.Следующий() Цикл
		 
		 СооАдресов.Вставить(Выборка.Ссылка,Выборка.Владелец);
		 
	 КонецЦикла; 
	 
	 Для каждого Товар Из  Товары Цикл
		 
		 Товар.СкладОтправитель = СооАдресов[Товар.АдресХранения];
		 Склад =    Товар.СкладОтправитель;
		 
		 Если ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство Тогда
			 
			 НовыйАдрес = АдресРЦ;
			 
		 ИначеЕсли ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение Тогда 
			 
			 НовыйАдрес = ?(ЗначениеЗаполнено(Товар.АдресХраненияНовый),Товар.АдресХраненияНовый,АдресХранения);
			 
		 ИначеЕсли  ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Списание Тогда
			 
			 
			НовыйАдрес = Неопределено;
		Иначе
			
			 НовыйАдрес =АдресХранения;
			 
			 
		 КонецЕсли;
				 
		 Товар.СкладПолучатель = СооАдресов[НовыйАдрес]; 
		 
		 СкладОтветственногоХранения = Неопределено;
		 СкладОтветственногоХраненияНовый = Неопределено;
 
		 Если ЗначениеЗаполнено(Товар.АдресХранения) Тогда 
			 СкладОтветственногоХранения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Товар.АдресХранения,"Лико_СкладОтветственногоХранения"); 
		 КонецЕсли;
		 
		 Если ЗначениеЗаполнено(НовыйАдрес) Тогда
			 СкладОтветственногоХраненияНовый = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НовыйАдрес,"Лико_СкладОтветственногоХранения");
		 КонецЕсли;
		 
		 Если ЗначениеЗаполнено(СкладОтветственногоХранения) Или
			 
			 ЗначениеЗаполнено(СкладОтветственногоХраненияНовый) Тогда
			 Товар.ОтветственноеХранение =Истина; 
			 
		 Иначе
			 
			 Товар.ОтветственноеХранение =Ложь;
			 
			 
		 КонецЕсли;
		 
		 
	 КонецЦикла; 
	 
	 ТзСкладОтправитель = Товары.Выгрузить(,"СкладОтправитель");
	 ТзСкладОтправитель.Свернуть("СкладОтправитель");
	 
	 ТзСкладПолучатель = Товары.Выгрузить(,"СкладПолучатель");
	 ТзСкладПолучатель.Свернуть("СкладПолучатель");
	 
	 Если ТзСкладОтправитель.Количество()>1 Или  ТзСкладПолучатель.Количество()>1 Тогда
		 
		 Отказ = Истина;
		 
		 Сообщить("Перемещение или оприходование с более чем одного склада запрещено. Разбейте операцию на несколько документов.");  
		 
	 КонецЕсли;
	 
	 
	 
	 
 КонецПроцедуры //-<---Лико m.shenderov 28.06.2024
 
 
