  Brc=УправлениеСвойствами.ЗначениеСвойства(Организация,"Лико_УчетНаСкладеПоBRC");
	Brc=?(Brc=Неопределено,Ложь,Brc);
	Нпор=0;
	Если Brc и ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство и НЕ Получатель.Лико_Резак Тогда
		Для каждого Товар Из Товары Цикл
			Если Товар.Серия.ЯССМ_ОбъектНоменклатуры.BRC_БлокировкаВК ТОгда
				Отказ=Истина;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Объект номенклатуры: "+ Строка(Товар.Серия) +" заблокирован! Товар можно только перемещать!";
				Сообщение.Поле = "Товары["+Нпор+"].Номенклатура"; //имя реквизита	
				Сообщение.ПутьКДанным = "Объект";
				Сообщение.Сообщить();
				
			КонецЕсли;
			
			Нпор=Нпор+1;			
		КонецЦикла;	 
	КонецЕсли; 
	
	Если Brc и ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство Тогда
		Для каждого Товар Из Товары Цикл
			//Если Товар.Номенклатура.Лико_ВидКонтактаСПищевойПродукцией=Справочники.Лико_ВидыКонтактовСПищевойПродукцией.НетКонтактаСКонтролемСрокаГодности 
			Если ЗначениеЗаполнено(Товар.Серия.ЯССМ_ОбъектНоменклатуры.УпотребитьДо)
				И Товар.Серия.ЯССМ_ОбъектНоменклатуры.УпотребитьДо<Дата ТОгда
				Отказ=Истина;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = СтрШаблон("У Объект номенклатуры: %1 истек срок годности.Товар можно только перемещать!",Строка(Товар.Серия));
				Сообщение.Поле = "Товары["+Нпор+"].Номенклатура"; //имя реквизита	
				Сообщение.ПутьКДанным = "Объект";
				Сообщение.Сообщить();
				
			КонецЕсли;
			
			Нпор=Нпор+1;			
		КонецЦикла;	 
	КонецЕсли;



		
