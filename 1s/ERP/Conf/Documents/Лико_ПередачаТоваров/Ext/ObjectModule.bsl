Процедура ПроверкаТермоусадки(Отказ)


	ЭтоИкспак  = Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра;
	ЭтоТермоусадка = Получатель.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.СклейкаТермоусадки ;
	ЕстьКраска = Ложь;
	Если  ЭтоТермоусадка и ЭтоИкспак Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Лико_ПередачаТоваровТовары.Номенклатура КАК Номенклатура
		|ИЗ
		|	Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
		|ГДЕ
		|	Лико_ПередачаТоваровТовары.Ссылка = &Ссылка
		|	И Лико_ПередачаТоваровТовары.Номенклатура.ВидНоменклатуры = &ВидНоменклатуры";

		Запрос.УстановитьПараметр("ВидНоменклатуры", Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыКраска.ЗначениеПараметра);
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);

		РезультатЗапроса = Запрос.Выполнить();
		Если не  РезультатЗапроса.Пустой() Тогда
			ЕстьКраска = Истина	;
		КонецЕсли;

		Если ЕстьКраска Тогда

			Если не ЗначениеЗаполнено(ЗаказКлиента) Тогда
				Сообщить("установлен запрет на передачу в производство клея на машину с видом «Склейка термоусадки» без указания Заказа клиента, укажите Заказ клиента.");
				Отказ = Истина;
				Возврат;
			КонецЕсли;

			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ЗаказКлиентаЦвета.Номенклатура КАК Номенклатура
			|ПОМЕСТИТЬ ВТКлей
			|ИЗ
			|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
			|ГДЕ
			|	ЗаказКлиентаЦвета.Ссылка = &Ссылка
			|	И ЗаказКлиентаЦвета.ВидСекции = ЗНАЧЕНИЕ(справочник.лико_видысекций.склейкату)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Лико_ФормулыПантоновСостав.Номенклатура КАК Ссылка
			|ИЗ
			|	Справочник.Лико_ФормулыПантонов.Состав КАК Лико_ФормулыПантоновСостав,
			|	ВТКлей КАК ВТКлей
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ВТКлей.Номенклатура
			|ИЗ
			|	ВТКлей КАК ВТКлей";


			Запрос.УстановитьПараметр("Ссылка", ЗаказКлиента);
			ДопустимыеЗначения = новый массив;

			ДопустимыеЗначения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ссылка");

			Для каждого стр из Товары Цикл
				Если стр.Номенклатура.ВидНоменклатуры = Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыКраска.ЗначениеПараметра Тогда
					Если  ДопустимыеЗначения.Найти(стр.Номенклатура) = Неопределено  Тогда
						Сообщить("В документе выбран клей (компонент клея) для термоусадки, отличающийся от данных заказа. Номер строки " + стр.НомерСтроки);
						Отказ = Истина;
						Возврат;
					КонецЕсли;

				КонецЕсли;
			КонецЦикла;

		КонецЕсли;

	КонецЕсли;




