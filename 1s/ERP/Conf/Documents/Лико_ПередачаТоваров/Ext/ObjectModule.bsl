			Для каждого СтрокаТЧ из ЗаказКлиента.Цвета Цикл
				Если ЗначениеЗаполнено(СтрокаТЧ.Вал) Тогда
					МассивВаловВЗаказе.Добавить(СтрокаТЧ.Вал);
				КонецЕсли;
			КонецЦикла;
			КоличествоВаловВЗаказе = МассивВаловВЗаказе.Количество();
			Если КоличествоВаловВДокументе > КоличествоВаловВЗаказе Тогда
				Отказ = Истина;
				Сообщить(?(ЗначениеЗаполнено(Ссылка), "" + Ссылка + ": ", "") + "в заказе " + ЗаказКлиента.НомерБезПрефикса + " указано " + КоличествоВаловВЗаказе
							+ " шт. валов, а вы хотите передать " + КоличествоВаловВДокументе + " шт.");
			КонецЕсли;
			Если НЕ Отказ Тогда
				//Теперь посчитаем, сколько выданных на этот заказ валов находятся на машине
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ
					|	Лико_ПередачаТоваровТовары.Номенклатура КАК Номенклатура
					|ПОМЕСТИТЬ ВТ_ВалыВыданныеНаЗаказ
					|ИЗ
					|	Документ.Лико_ПередачаТоваров КАК Лико_ПередачаТоваров
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
					|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
					|			ПО Лико_ПередачаТоваровТовары.Номенклатура = НоменклатураДополнительныеРеквизиты.Ссылка
					|				И (НоменклатураДополнительныеРеквизиты.Свойство.Имя = ""ОснасткаВид"")
					|				И ((ВЫРАЗИТЬ(НоменклатураДополнительныеРеквизиты.Значение КАК Перечисление.Лико_ВидОснастки)) = ЗНАЧЕНИЕ(Перечисление.Лико_ВидОснастки.Вал))
					|		ПО Лико_ПередачаТоваров.Ссылка = Лико_ПередачаТоваровТовары.Ссылка
					|ГДЕ
					|	Лико_ПередачаТоваров.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство)
					|	И Лико_ПередачаТоваров.Проведен
					|	И Лико_ПередачаТоваров.Получатель = &Получатель
					|	И Лико_ПередачаТоваров.ЗаказКлиента = &ЗаказКлиента
					|	И Лико_ПередачаТоваров.Ссылка <> &Ссылка
					|	И Лико_ПередачаТоваров.Дата <= &Дата
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
					|	ТоварыВЯчейкахОстатки.Номенклатура.Артикул КАК НоменклатураАртикул,
					|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК ВНаличииОстаток
					|ИЗ
					|	РегистрНакопления.ТоварыВЯчейках.Остатки(
					|			&ДатаОстатков,
					|			Ячейка = &Ячейка
					|				И Номенклатура В
					|					(ВЫБРАТЬ
					|						Т.Номенклатура
					|					ИЗ
					|						ВТ_ВалыВыданныеНаЗаказ КАК Т)) КАК ТоварыВЯчейкахОстатки
					|ГДЕ
					|	ТоварыВЯчейкахОстатки.ВНаличииОстаток > 0";
				
				Запрос.УстановитьПараметр("Ссылка", Ссылка);
				Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Дата) И ЗначениеЗаполнено(Ссылка), Дата, Дата('39991231235959')));
				Запрос.УстановитьПараметр("ДатаОстатков", Новый Граница(Запрос.Параметры.Дата, ВидГраницы.Включая));
				Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
				Запрос.УстановитьПараметр("Получатель", Получатель);
				Запрос.УстановитьПараметр("Ячейка", ?(ЗначениеЗаполнено(Получатель.ЛикоЯчейка), Получатель.ЛикоЯчейка, АдресХранения));
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				КоличествоВаловУжеВыдано = 0;
				СтрокаВыданныхВалов = "";
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					КоличествоВаловУжеВыдано = КоличествоВаловУжеВыдано + ВыборкаДетальныеЗаписи.ВНаличииОстаток;
					СтрокаВыданныхВалов = СтрокаВыданныхВалов + ?(ЗначениеЗаполнено(СтрокаВыданныхВалов), ", ", "") + ВыборкаДетальныеЗаписи.НоменклатураАртикул;
				КонецЦикла;
				Если КоличествоВаловВДокументе + КоличествоВаловУжеВыдано > КоличествоВаловВЗаказе Тогда
					Отказ = Истина;
					Сообщить(?(ЗначениеЗаполнено(Ссылка), "" + Ссылка + ": ", "") + "в заказе " + ЗаказКлиента.НомерБезПрефикса + " указано " + КоличествоВаловВЗаказе
								+ " шт. валов, вы хотите передать " + КоличествоВаловВДокументе + " шт., а также ранее уже выдано " + КоличествоВаловУжеВыдано + " шт.: "
								+ СтрокаВыданныхВалов);
				КонецЕсли;
			КонецЕсли;		
		КонецЕсли;		
	КонецЕсли;
