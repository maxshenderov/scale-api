Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Если ДополнительныеСвойства.Свойство("ПараметрыПроверки") Тогда	
		ПараметрыПроверки = ДополнительныеСвойства.ПараметрыПроверки;
		НепроверяемыеРеквизитыМассив = ПараметрыПроверки.НепроверяемыеРеквизиты;
		Для Каждого СтрМас из НепроверяемыеРеквизитыМассив Цикл
			МассивНепроверяемыхРеквизитов.Добавить(СтрМас);
		КонецЦикла;
	Иначе
		
	КонецЕсли;
	
	Если Не СкладыСервер.ИспользоватьСкладскиеПомещения(Склад,Дата) Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Помещение");
	КонецЕсли; 
	
	ПараметрыПроверки = НоменклатураСервер.ПараметрыПроверкиЗаполненияХарактеристик();
	ПараметрыПроверки.ИмяТЧ = "Товары";
	НоменклатураСервер.ПроверитьЗаполнениеХарактеристик(ЭтотОбъект,МассивНепроверяемыхРеквизитов,Отказ,ПараметрыПроверки);
	
	
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУпаковкиНоменклатуры") Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Упаковка");
		МассивНепроверяемыхРеквизитов.Добавить("Товары.Упаковка");
		ТекстСообщения = НСтр("ru='В настройках программы не включено использование упаковок номенклатуры, 
		|поэтому нельзя оформить документ по складу с адресным хранением остатков. Обратитесь к администратору'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
	КонецЕсли;
	
	//Если ВидОперации<>Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство Тогда
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПереработку и Не ВнутренняяПереработка Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ЗаказКлиента");
	КонецЕсли;
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Продажа и Не ВнутренняяПродажа Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ЗаказКлиента");  
		//ПроверяемыеРеквизиты.Добавить("Договор");
		//Если Не ИнтерКампани Тогда
		//	ПроверяемыеРеквизиты.Добавить("СоглашениеСКлиентами");	
		//КонецЕсли;
		
	
		
	КонецЕсли;
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПереработку и Не ВнутренняяПереработка Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ЗаказКлиента");
	КонецЕсли;
	МассивНепроверяемыхРеквизитов.Добавить("НомерБланка");
	
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство Тогда	
		
		МассивНепроверяемыхРеквизитов.Добавить("ЗаказКлиента");
		
		
	КонецЕсли;
	МассивНепроверяемыхРеквизитов.Добавить("Сотрудник");
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаФорм Или ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство Тогда
	Иначе
		МассивНепроверяемыхРеквизитов.Добавить("Получатель");
	КонецЕсли;
	//Иначе
