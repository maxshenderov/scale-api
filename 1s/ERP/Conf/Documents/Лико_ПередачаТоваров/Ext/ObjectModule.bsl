Процедура СоздатьЗаказМатериаловПроизводствоПоТоварыКОтгрузке(ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	Если ВидОперации<>Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Списание Тогда
		Возврат;
	КонецЕсли;      
	
	Таблица =  Движения.ТоварыКОтгрузке.Выгрузить();

	
	
	Если Отказ ИЛИ Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	лЗаказМатериаловВПроизводство=Неопределено;
	Для каждого СтрокаТаблицы Из Таблица Цикл
		Если ТипЗнч(СтрокаТаблицы.ДокументОтгрузки)=Тип("ДокументСсылка.ЗаказМатериаловВПроизводство") Тогда
			лЗаказМатериаловВПроизводство=СтрокаТаблицы.ДокументОтгрузки;
			Прервать;
		КонецЕсли;
		
		
	КонецЦикла;
	Если лЗаказМатериаловВПроизводство=Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ДокументОтгрузки",лЗаказМатериаловВПроизводство);
	НайденыеТовары=Таблица.НайтиСтроки(СтруктураОтбора);
	
	
	
	НовоеРаспоряжение					=лЗаказМатериаловВПроизводство.ПолучитьОбъект();
	НовоеРаспоряжение.Дата				=Дата;
	НовоеРаспоряжение.ПометкаУдаления	=Ложь;
	НовоеРаспоряжение.Товары.Очистить();
	
	Для каждого Товар Из НайденыеТовары Цикл
		НовыйТовар							=НовоеРаспоряжение.Товары.Добавить();
		НовыйТовар.Номенклатура				=Товар.Номенклатура;
		НовыйТовар.Характеристика			=Товар.Характеристика;
		НовыйТовар.Количество				=Товар.КОтгрузке;
		НовыйТовар.КоличествоУпаковок		=Товар.КОтгрузке;				
		НовыйТовар.ВариантОбеспечения		=Перечисления.ВариантыОбеспечения.Отгрузить;
		НовыйТовар.НачалоОтгрузки			=Дата;
		НовыйТовар.ОкончаниеПоступления		=Дата; 
	КонецЦикла;
	
	Ошибка=Неопределено;
	Попытка 				
		НовоеРаспоряжение.ПометкаУдаления=Ложь;
		НовоеРаспоряжение.Записать(РежимЗаписиДокумента.Проведение); 	
	Исключение
		Отказ=Истина;
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + Ссылка + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
	КонецПопытки;	
	
	Если Не Отказ Тогда
		СоздатьДокументДвижениеМатериалов(лЗаказМатериаловВПроизводство,Отказ);	
	КонецЕсли;
	
КонецПроцедуры 

Процедура СоздатьДокументДвижениеМатериалов(ЗаказМатериаловВПроизводство,Отказ)		
	
	
	НовыйДокОбъект 					= Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент();
	НовыйДокОбъект.Дата 			= Дата;		
	Массив 							= Новый Массив();
	Массив.Добавить(ЗаказМатериаловВПроизводство);		
	ПараметрыОткрытия = ПроизводствоВызовСервера.ПараметрыСозданияДвиженияПродукцииИМатериаловНаОсновании(
	Массив, ЗаказМатериаловВПроизводство.ХозяйственнаяОперация);
	
	
	ДанныеЗаполнения = ПараметрыОткрытия.Основание;
	ДанныеЗаполнения.Вставить("Товары", ЗаказМатериаловВПроизводство.Товары.Выгрузить());
	НовыйДокОбъект.Заполнить(ДанныеЗаполнения);
	НовыйДокОбъект.Лико_Документ=Ссылка;
	НовыйДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	НовыйДокОбъект.Статус=Перечисления.СтатусыДвиженияПродукцииИМатериалов.Принято;
	ПередачаМатериаловВКладовую=НайтиДокументПередачиМатериаловВКладовую(ЗаказМатериаловВПроизводство);
	Если  ЗначениеЗаполнено(ПередачаМатериаловВКладовую)  Тогда
		УжеСозданныйДокументОбъект = ПередачаМатериаловВКладовую.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки()); 			
		ВызватьИсключение;
	КонецПопытки;		
КонецПроцедуры

