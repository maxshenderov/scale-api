//Процедура формирования движений по регистру "Лико_ТоварыНаОтветственномХранении".
//
// Параметры:
//	ДополнительныеСвойства - Структура - дополнительные свойства для записи движений 
//	Движения - КоллекцияДвижений - движения по которым двигается документ
//	Отказ - Булево - признак отказа от проведения документа
//
Процедура ОтразитьЛико_ТоварыНаОтветственномХранении(ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	ОрганизацияДокумента   		= Неопределено;
	Таблица                		= Движения.Лико_ТоварыНаОтветственномХранении.Выгрузить();
	ТаблицаТоварыНаСкладах 		= Движения.ТоварыНаСкладах.Выгрузить();
	ПерезаписатьТоварыНаСкладах	= Ложь;
	
	Если Отказ Или Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Структура;  	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Характеристика",Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТЗ.Колонки.Добавить("Упаковка",Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	ТЗ.Колонки.Добавить("СкладОтправитель",Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТЗ.Колонки.Добавить("СкладПолучатель",Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТЗ.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
	ТЗ.Колонки.Добавить("КоличествоУпаковок",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
	ТзПриход=Тз.Скопировать();
	ТзРасход=Тз.Скопировать();
	НаборЗаписей = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.Регистратор.Установить(Ссылка); 

	СкладПолучатель=Неопределено;
	СкладОтправитель=Неопределено;
	
	Для каждого СтрТаблицы Из Таблица  Цикл 
		Если СтрТаблицы.ВидДвижения=ВидДвиженияНакопления.Приход Тогда
			СкладПолучатель= СтрТаблицы.Склад;
			
		Иначе
			СкладОтправитель= СтрТаблицы.Склад; 
		КонецЕсли;
		Если ЗначениеЗаполнено(СкладПолучатель) И ЗначениеЗаполнено(СкладОтправитель) Тогда
			Прервать;
		КонецЕсли;		
	КонецЦикла;
	
	
	СкладОтправитель =?(ЗначениеЗаполнено(СкладОтправитель),СкладОтправитель,Товары[0].СкладОтправитель); 
	СкладПолучатель  =?(ЗначениеЗаполнено(СкладПолучатель),СкладПолучатель,Товары[0].СкладПолучатель);
	
	
	
	
	Для каждого СтрТаблицы Из Таблица  Цикл 
		
		
		Если СтрТаблицы.ВидДвижения=ВидДвиженияНакопления.Приход Тогда
					Если СкладОтправитель=СкладПолучатель Тогда
				Продолжить;
			КонецЕсли;
			
			НовяСтрТз=ТзПриход.Добавить();
			НовяСтрТз.СкладОтправитель=СкладОтправитель;
			НовяСтрТз.СкладПолучатель=СкладПолучатель;
			
			Движение 				= НаборЗаписей.Добавить(); 
			Движение.Регистратор 	= Ссылка; 
			Движение.Период			= Дата;
			Движение.Организация	= СтрТаблицы.ОрганизацияОтветственногоХранения;
			ОрганизацияДокумента    =  СтрТаблицы.Организация;
			// Заполнить счет дебета. 
			Движение.СчетДт 		= ПланыСчетов.Хозрасчетный.ТМЦнаскладах;
			// Заполнить аналитику счета дебета. 
