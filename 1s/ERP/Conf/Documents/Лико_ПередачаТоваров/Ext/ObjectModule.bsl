Функция СоздатьТаблицуСписанияНоменклатуры(ТаблицаСвязанныхДокументов) //+Лико m.shenderov 28.05.2020
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПередачаТоваровТовары.Номенклатура КАК Номенклатура,
	|	Лико_ПередачаТоваровТовары.Характеристика КАК Характеристика,
	|	Лико_ПередачаТоваровТовары.Упаковка КАК Упаковка,
	|	СУММА(Лико_ПередачаТоваровТовары.КоличествоУпаковок) КАК КоличествоУпаковок,
	|	СУММА(Лико_ПередачаТоваровТовары.Количество) КАК Количество,
	|	Лико_ПередачаТоваровТовары.Серия КАК Серия,
	|	Лико_ПередачаТоваровТовары.Ссылка.Склад КАК Склад
	|ПОМЕСТИТЬ ВтТовары
	|ИЗ
	|	Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
	|ГДЕ
	|	Лико_ПередачаТоваровТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ПередачаТоваровТовары.Номенклатура,
	|	Лико_ПередачаТоваровТовары.Упаковка,
	|	Лико_ПередачаТоваровТовары.Характеристика,
	|	Лико_ПередачаТоваровТовары.Серия,
	|	Лико_ПередачаТоваровТовары.Ссылка.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтТовары.Номенклатура КАК Номенклатура,
	|	ВтТовары.Характеристика КАК Характеристика,
	|	ВтТовары.Серия КАК Серия,
	|	ВтТовары.Склад КАК Склад,
	|	ВтТовары.Упаковка КАК Упаковка,
	|	ВтТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ВтТовары.Количество КАК Количество,
	|	ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0) КАК КоличествоБУ,
	|	НЕОПРЕДЕЛЕНО КАК Правило,
	|	ЛОЖЬ КАК СписатьСЯчейки,
	|	НЕОПРЕДЕЛЕНО КАК Распоряжение
	|ИЗ
	|	ВтТовары КАК ВтТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				&Период,
	|				(Серия, Склад) В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ВтТовары.Серия КАК Серия,
	|						ВтТовары.Склад КАК Склад
	|					ИЗ
	|						ВтТовары КАК ВтТовары)) КАК ТоварыНаСкладахОстатки
	|		ПО ВтТовары.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
	|			И ВтТовары.Характеристика = ТоварыНаСкладахОстатки.Характеристика
	|			И ВтТовары.Серия = ТоварыНаСкладахОстатки.Серия
	|			И ВтТовары.Склад = ТоварыНаСкладахОстатки.Склад";
	Запрос.УстановитьПараметр("Ссылка",Ссылка );
	Запрос.УстановитьПараметр("Период",КонецДня(Дата));
	
	
	Возврат Запрос.Выполнить().Выгрузить();
	
	
	
	
