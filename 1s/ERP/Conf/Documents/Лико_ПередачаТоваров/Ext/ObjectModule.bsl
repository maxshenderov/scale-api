Процедура НаписатьПисмоОПередачеТМЦНаСкладОтветственногоХранения(ТзПриход)
	УстановитьПривилегированныйРежим(Истина);	
	
	Текст =  "Перемещение на склад ответственного хранения " + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Ссылка) + " от " + Формат(ДатаФормированияАктаБрака, "ДФ='дд ММММ гггг'");
	Тема  = текст;  		
	Для каждого Товар  Из ТзПриход  Цикл
		Текст=Текст+Символы.ПС+Символы.ВК;
		Текст=Текст+Товар.Номенклатура.Код+" "+Товар.Номенклатура+" "+Товар.характеристика+";        Кол =  "+Строка(Товар.Количество);			
	КонецЦикла;	
	Текст=Текст+Символы.ПС+Символы.ВК;
	//Текст=Текст+" Причины брака: "+ ПричинаБрака;
	
	
	Адресат = Справочники.Лико_ТипыСообщений.ПолучитьПочтовыеАдреса(Справочники.Лико_ТипыСообщений.ПеремещениеНаСкладОтветственнгоХраненияИксПак,Организация);
	Если ЗначениеЗаполнено(Адресат) Тогда 
		Лико_Планирование.ОтправитьПисьмо(текст, Тема, Адресат,,"textBody");  		
	КонецЕсли;
	; 	
	//-m.shenderov 23.09.2016
	
	
	
	
	
	УстановитьПривилегированныйРежим(Ложь);	
	
	
КонецПроцедуры


Процедура СтруктураПараметровЗаписиОбъекта() 	
	
	Если Не ДополнительныеСвойства.Свойство("ЕстьВопросыПередЗаписью") ТОгда
		ДополнительныеСвойства.Вставить("ЕстьВопросыПередЗаписью", Ложь);
	КонецЕсли;
	Если Не ДополнительныеСвойства.Свойство("НовыйОбъект") ТОгда
		ДополнительныеСвойства.Вставить("НовыйОбъект", Ложь); 		
	КонецЕсли;
	Если Не ДополнительныеСвойства.Свойство("ПринудительноЗакрытьФорму") ТОгда
		ДополнительныеСвойства.Вставить("ПринудительноЗакрытьФорму", Ложь); 		
	КонецЕсли;
	Если Не ДополнительныеСвойства.Свойство("РежимЗаписи") ТОгда
		ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписиДокумента.Запись);		
	КонецЕсли; 	
	Если Не ДополнительныеСвойства.Свойство("РежимПроведения") ТОгда
		ДополнительныеСвойства.Вставить("РежимПроведения", РежимПроведенияДокумента.Неоперативный); 	
	КонецЕсли;
	
Конецпроцедуры
  

Процедура УстановитьСтатусзаявки(Отказ, УдалениеДОкументаПоЗаявке=Ложь)
	Если Не Отказ Тогда
		Если ЗначениеЗаполнено(ЗаявкаНаСклад) Тогда
			ДокументОбъект=ЗаявкаНаСклад.ПолучитьОбъект();
			Если  УдалениеДОкументаПоЗаявке Тогда
				ДокументОбъект.ДополнительныеСвойства.Вставить("УдалениеДОкументаПоЗаявке",Истина);
			КонецЕсли;
				ДокументОбъект.ДополнительныеСвойства.Вставить("УстановитьСтатусзаявки",Истина);

			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;

	КонецЕсли;



КонецПроцедуры


Функция ЕстьОснастка()
	УстановитьПривилегированныйРежим(Истина);
	Для каждого Товар Из Товары Цикл
		
		Если Товар.Номенклатура.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыОснастка.ЗначениеПараметра Тогда
			Возврат Истина;
		КонецЕсли;
		Правило=Справочники.Лико_ПравилаСписанияНоменклатурыПодЗаказ.ОпределитьПравило(Товар.Номенклатура, Ссылка);
		Если ЗначениеЗаполнено(Правило) И Правило.ТипСписания=Перечисления.Лико_ТипыСписанияНоменклатурыВПроизводство.ПодЗаказ Тогда
			Возврат Истина; 			
		КонецЕсли;
		
		
	КонецЦикла;
	
	Возврат Ложь;
	
