				И Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(,Стр.Номенклатура,"ОснасткаВид", Перечисления.Лико_ВидОснастки.ПустаяСсылка()) = Перечисления.Лико_ВидОснастки.Вал Тогда 
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	Лико_ВалыФормыСрезПоследних.Вал КАК Вал,
				|	Лико_ВалыФормыСрезПоследних.Форма КАК Форма
				|ПОМЕСТИТЬ ВТПередаютВалСФормой
				|ИЗ
				|	РегистрСведений.Лико_ВалыФормы.СрезПоследних(, Вал = &Вал) КАК Лико_ВалыФормыСрезПоследних
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВТПередаютВалСФормой.Вал КАК ВалПередают,
				|	ВТПередаютВалСФормой.Форма КАК ФормаВалов,
				|	Лико_ВалыФормыСрезПоследних.Вал КАК ВалНаОстаткахРЦ
				|ИЗ
				|	РегистрСведений.Лико_ВалыФормы.СрезПоследних(, Вал <> &Вал) КАК Лико_ВалыФормыСрезПоследних
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПередаютВалСФормой КАК ВТПередаютВалСФормой
				|		ПО Лико_ВалыФормыСрезПоследних.Форма = ВТПередаютВалСФормой.Форма
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(&ДатаОстатков, Ячейка = &Ячейка) КАК ТоварыВЯчейкахОстатки
				|		ПО Лико_ВалыФормыСрезПоследних.Вал = ТоварыВЯчейкахОстатки.Номенклатура";
				
				Запрос.УстановитьПараметр("Вал", Стр.Номенклатура);
				Запрос.УстановитьПараметр("Ячейка", Получатель.ЛикоЯчейка);
				Запрос.УстановитьПараметр("ДатаОстатков", ?(РежимПроведения = РежимПроведенияДокумента.Оперативный, Дата('39991231235959'), Дата));
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					ИндексСтроки = Товары.Индекс(Стр);	
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = ?(ЗначениеЗаполнено(Ссылка), "" + Ссылка + Символы.ПС, "") + "Строка №" + Стр.НомерСтроки 
					+ "  - " + Стр.Номенклатура + ", (" + Стр.Номенклатура.Артикул + "), форма - " + ВыборкаДетальныеЗаписи.ФормаВалов.Код + ": " + Символы.ПС + "На указанном Рабочем центре " + Получатель 
					+ " уже числится " + ВыборкаДетальныеЗаписи.ВалНаОстаткахРЦ + ", (" + ВыборкаДетальныеЗаписи.ВалНаОстаткахРЦ.Артикул + ") с таким же номером формы - " + ВыборкаДетальныеЗаписи.ФормаВалов.Код + ". Для передачи нового Вала - " + Стр.Номенклатура.Артикул + " сначала верните на склад Вал - " + ВыборкаДетальныеЗаписи.ВалНаОстаткахРЦ.Артикул;
					Сообщение.Сообщить();
					Отказ = Истина;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;

