	  Отказ=Истина;
  КонецЕсли;

  Выборка = Пакеты[1].Выбрать();
  Сч=0;

  Пока Выборка.Следующий() Цикл
	  Сч=Сч+1;
  КонецЦикла;
  Если Сч>1 Тогда
	  Сообщить("Оприходовать  материалы в разные помещения в одном документе запрещено!");
	   Отказ=Истина;

  КонецЕсли;







