 Процедура ПроверитьЯчейкиОтветственногоХранения(АдресХранения, НовыйАдресХранения, Ошибка)
	 
	 Результат = Ложь;
	 
	 Результат = ЭтоПередачаНаОтветственноеХранение(АдресХранения, НовыйАдресХранения, Ошибка);
 	 Результат = ЭтоВозвратСОтветственноеХранение(АдресХранения, НовыйАдресХранения, Ошибка);	 
	 Результат = ЭтоСотрудникиСкладаОтветственногоХранения(АдресХранения, НовыйАдресХранения, Ошибка);
 
 КонецПроцедуры
  
Функция ЭтоПередачаНаОтветственноеХранение(АдресХранения, НовыйАдресХранения, Ошибка)

	Если НЕ ЗначениеЗаполнено(АдресХранения.Лико_ОрганизацияОтветственногоХранения) И 
		ЗначениеЗаполнено(НовыйАдресХранения.Лико_ОрганизацияОтветственногоХранения)Тогда 
		
		
		Если Не НовыйАдресХранения.Лико_БуферОтветственногоХранения Тогда 
			
			Ошибка = "Передача материалов на ответственное хранение возможна только через буферную зону!";
			
		КонецЕсли;
		
	Возврат Истина;	
		
	КонецЕсли;
	
Возврат Ложь;	

КонецФункции

Функция ЭтоВозвратСОтветственноеХранение(АдресХранения, НовыйАдресХранения, Ошибка)

	Если ЗначениеЗаполнено(АдресХранения.Лико_ОрганизацияОтветственногоХранения) И 
		Не ЗначениеЗаполнено(НовыйАдресХранения.Лико_ОрганизацияОтветственногоХранения)Тогда 
		
		
		Если Не НовыйАдресХранения.Лико_БуферОтветственногоХранения Тогда 
			
			Ошибка = "Возврат  материалов с ответственного хранения возможно только через буферную зону!";
			
		КонецЕсли;
		
		Если Не АдресХранения.Лико_БуферОтветственногоХранения Тогда 
			
			Ошибка = "Возврат материалов с ответственного хранения возможен только со специализированной ячейки возврата с ответственного хранения!";
			
		КонецЕсли;

		
	Возврат Истина;	
		
	КонецЕсли;
	
Возврат Ложь;	

КонецФункции 

Функция ЭтоСотрудникиСкладаОтветственногоХранения(АдресХранения, НовыйАдресХранения, Ошибка)

	Если ЗначениеЗаполнено(АдресХранения.Лико_ОрганизацияОтветственногоХранения) И 
	     ЗначениеЗаполнено(НовыйАдресХранения.Лико_ОрганизацияОтветственногоХранения)Тогда 
		
		
		 Если АдресХранения.Лико_ОрганизацияОтветственногоХранения = НовыйАдресХранения.Лико_ОрганизацияОтветственногоХранения 
			 И АдресХранения.Лико_ОрганизацияОтветственногоХранения<>Организация  Тогда 
			
			Ошибка = СтрШаблон("Операция должна быть выполнена сотрудниками организации: ""%1""!",АдресХранения.Лико_ОрганизацияОтветственногоХранения);
		Возврат Ложь;	
	
		КонецЕсли;
		
			
		
	КонецЕсли;
	Возврат Истина;	
	

КонецФункции 



Процедура СформироватьДвиженияСоставаПаллеты()
	
	
	Движения.Лико_ТоварыНаПаллетах.Записывать = Истина;
	
	ОстаткиТоваровСПаллет=ОстаткиТоваровСПаллет(); 
	
	Для Каждого СтрокаОстатков Из ОстаткиТоваровСПаллет Цикл
		
		// Если количество к перемещению = 0, пропускаем строку
		Если СтрокаОстатков.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
