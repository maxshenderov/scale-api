	Пока Выборка.Следующий() Цикл

		ЗаполнитьЗначенияСвойств(ДокОбъект,Выборка);

	КонецЦикла; 




	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);

	//НовыйДокОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
