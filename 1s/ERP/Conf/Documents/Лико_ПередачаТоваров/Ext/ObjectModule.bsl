Функция НайтиПомещениеПереработки() //+Лико m.shenderov 01/11/2019
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СкладскиеПомещения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СкладскиеПомещения КАК СкладскиеПомещения
	|ГДЕ
	|	СкладскиеПомещения.Владелец = &Склад
	|	И СкладскиеПомещения.Лико_Организация = &Организация
	|	И СкладскиеПомещения.Лико_ТипСклада = &Лико_ТипСклада";
	Запрос.УстановитьПараметр("Склад",Склад );
	Запрос.УстановитьПараметр("Организация",Организация );
	Запрос.УстановитьПараметр("Лико_ТипСклада",Перечисления.Лико_ТипСклада.Переработка );
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла; 
	
	
	
	
