		ДанныеЗаполнения.Вставить("СкладОтправитель",ТзПриход[0].СкладОтправитель);
		ДанныеЗаполнения.Вставить("СкладПолучатель",ТзПриход[0].СкладПолучатель);
		ДанныеЗаполнения.Вставить("Товары",ТзПриход); 
		СоздатьРедактироватьПеремещениеНаОтветственноеХранение(ДанныеЗаполнения,Отказ);
		Если ДополнительныеСвойства.ЭтоНовый Тогда
			НаписатьПисмоОПередачеТМЦНаСкладОтветственногоХранения(ТзПриход); 
		КонецЕсли;
		
		
		
	ИначеЕсли ТзРасход.Количество()>0 Тогда		
		ДанныеЗаполнения = Новый Структура;  
		ДанныеЗаполнения.Вставить("Организация",ОрганизацияДокумента);
		ДанныеЗаполнения.Вставить("СкладОтправитель",ТзРасход[0].СкладОтправитель);
		ДанныеЗаполнения.Вставить("СкладПолучатель",ТзРасход[0].СкладПолучатель);
		ДанныеЗаполнения.Вставить("Товары",ТзРасход); 
		СоздатьРедактироватьПеремещениеНаОтветственноеХранение(ДанныеЗаполнения,Отказ);
	КонецЕсли;
	
	
	
	
	ДвиженияЛико_ТоварыНаОтветственномХранении = Движения.Лико_ТоварыНаОтветственномХранении;
	ДвиженияЛико_ТоварыНаОтветственномХранении.Записывать = Истина;
	ДвиженияЛико_ТоварыНаОтветственномХранении.Загрузить(Таблица);
	
	
	Если ПерезаписатьТоварыНаСкладах Тогда
		
		ДвиженияТоварыНаСкладах = Движения.ТоварыНаСкладах;
		ДвиженияТоварыНаСкладах.Записывать = Истина;
		ДвиженияТоварыНаСкладах.Загрузить(ТаблицаТоварыНаСкладах);
		Для каждого Движение Из ДвиженияТоварыНаСкладах Цикл
		
			 Движение.Активность=Истина;
		
		КонецЦикла;
		
	КонецЕсли;
	
