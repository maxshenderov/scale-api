		МассивНепроверяемыхРеквизитов.Добавить("Сотрудник");
		МассивНепроверяемыхРеквизитов.Добавить("Получатель");                        
		//МассивНепроверяемыхРеквизитов.Добавить("Контрагент");
		//МассивНепроверяемыхРеквизитов.Добавить("Партнер");
		
		
	КонецЕсли;
	
	
	
	
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаФорм Или
		ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.СписаниеФорм ИЛИ 
		ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПеремещениеФорм ИЛИ 
		ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаМОЛ Тогда
		
		МассивНепроверяемыхРеквизитов.Добавить("ЗаказКлиента");
		МассивНепроверяемыхРеквизитов.Добавить("НомерБланка");
		МассивНепроверяемыхРеквизитов.Добавить("Товары");
		МассивНепроверяемыхРеквизитов.Добавить("Контрагент");
		МассивНепроверяемыхРеквизитов.Добавить("Партнер");
		
		
	КонецЕсли; 
	
	
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаФорм Или
		ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.СписаниеФорм  Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Формы.Конверт");
		
		
	КонецЕсли;
	

	
	
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Списание Тогда
		
		МассивНепроверяемыхРеквизитов.Добавить("ЗаказКлиента");
