Функция НайтиДокументСборки(Номенклатура) //+Лико m.shenderov 07.06.2021
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СборкаТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СборкаТоваров КАК СборкаТоваров
	|ГДЕ
	|	СборкаТоваров.Лико_Документ = &Лико_Документ
	|	И СборкаТоваров.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура );
	Запрос.УстановитьПараметр("Лико_Документ",Ссылка );

	РезультатЗапроса = Запрос.Выполнить(); 
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
	        Возврат Выборка.Ссылка;
	КонецЦикла; 
	
	
КонецФункции //-Лико m.shenderov 07.06.2021 





