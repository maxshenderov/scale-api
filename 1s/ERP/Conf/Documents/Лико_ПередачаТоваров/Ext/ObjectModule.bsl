  |		ИНАЧЕ Лико_ПередачаТоваровТовары.АдресХраненияНовый.Помещение
  |	КОНЕЦ";
  Запрос.УстановитьПараметр("Ссылка",Ссылка);
  Пакеты = Запрос.ВыполнитьПакет();
  Выборка = Пакеты[0].Выбрать();
