Процедура СоздатьРедактироватьПередачуВРемонт(Распоряжение, ДанныеЗаполнения, РежимЗаписи,Отказ) 
	Если Не РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеЗаполнения.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВРемонт Тогда
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Распоряжение) Тогда
			НовоеРаспоряжение=Распоряжение.ПолучитьОбъект();
			Если НовоеРаспоряжение=Неопределено Тогда
				НовоеРаспоряжение=Документы.ПередачаСырьяПереработчику.СоздатьДокумент();	
				НовоеРаспоряжение.УстановитьСсылкуНового(ДанныеЗаполнения.Распоряжение); 
			КонецЕсли;  				
		Иначе
			НовоеРаспоряжение=Документы.ПередачаСырьяПереработчику.СоздатьДокумент();	
			НовоеРаспоряжение.УстановитьСсылкуНового(ДанныеЗаполнения.Распоряжение); 				
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НовоеРаспоряжение,ДанныеЗаполнения);
		НовоеРаспоряжение.Товары.Загрузить(ДанныеЗаполнения.Товары.Выгрузить(,ПоляТаблицыТоваров())); 			
		Попытка 				
			НовоеРаспоряжение.Записать(РежимЗаписи); 				
		Исключение
			НовоеРаспоряжение.Записать();
		КонецПопытки;
		
		Распоряжение=НовоеРаспоряжение.Ссылка;
		
	КонецЕсли;	
	
КонецПроцедуры 



