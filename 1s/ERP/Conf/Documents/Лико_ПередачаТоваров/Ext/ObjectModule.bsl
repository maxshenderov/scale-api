Процедура ПроверкаВидаОперацииДляСкладаОтветственноеХранениеBRC(Отказ,РежимЗаписи)
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;

	
	Нпор=0;
	
	Для каждого Товар Из  Товары Цикл
		Если ЗначениеЗаполнено(Товар.АдресХранения.Помещение.Лико_ОрганизацияОтветственногоХранения) и
			ВидОперации<>Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение Тогда
			Отказ=Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Со склада: "+ Строка(Товар.АдресХранения.Помещение) +" товар можно только перемещать!";
			Сообщение.Поле = "Товары["+Нпор+"].АдресХранения"; //имя реквизита 
			//Сообщение.КлючДанных = Ссылка;
			Сообщение.ПутьКДанным = "Объект";
			
			Сообщение.Сообщить();
		КонецЕсли;
	
		Если ЗначениеЗаполнено(Товар.АдресХранения.Помещение.Лико_ОрганизацияОтветственногоХранения) и
			ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Перемещение Тогда
			
			лОрганизацияНовая=?(ЗначениеЗаполнено(Товар.АдресХраненияНовый),Товар.АдресХраненияНовый.Лико_Организация,АдресХранения.Лико_Организация);
			лОрганизация=Товар.АдресХранения.Помещение.Лико_Организация;
			Если лОрганизация<>лОрганизацияНовая Тогда
				
			Отказ=Истина;	
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Товар: "+ Строка(Товар.Серия) +" можно  перемещать только на ячейки организации: "+лОрганизация+" !";
			Сообщение.Поле = "Товары["+Нпор+"].АдресХранения";; //имя реквизита 
			//Сообщение.КлючДанных = Ссылка;
			Сообщение.ПутьКДанным = "Объект";
			
			Сообщение.Сообщить();

				
			КонецЕсли;
	
		КонецЕсли;
		Нпор=Нпор+1;
		
	КонецЦикла;
	
КонецПроцедуры

 
