		Запрос.УстановитьПараметр("ТмцВЭксплуатации", Документы.Лико_ПередачаТоваров.ПолучитьНоменклатуруПодПередачуВЭксплуатацию(ТзТовары,Ссылка));
		Запрос.УстановитьПараметр("МомВрем",?(ЗначениеЗаполнено(Ссылка), Новый Граница(Ссылка.МоментВремени(), ВидГраницы.Исключая),ТекущаяДата()));
		
		//Запрос.УстановитьПараметр("Ссылка", Ссылка);

		
		//ЦеховаяКладоваяКраски=УправлениеСвойствами.ЗначениеСвойства(Организация,"Лико_Колористическая");
		ЦеховаяКладоваяКраски=Склад.Лико_Площадка.ЦеховаяКладовая;
		Если  Ссылка.БракМатериала Тогда
			ЦеховаяКладоваяКраски=Неопределено;
		КонецЕсли;

		СписаниеКраскиЧерезЦеховуюКладовую=ЗначениеЗаполнено(ЦеховаяКладоваяКраски)
		и Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаСписаниеКраскиЧерезЦеховуюКладовую.ЗначениеПараметра<Дата;
		Запрос.УстановитьПараметр("СписаниеКраскиЧерезЦеховуюКладовую",СписаниеКраскиЧерезЦеховуюКладовую);
		Запрос.УстановитьПараметр("ВидНоменклатурыКраска",Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыКраска.ЗначениеПараметра);



		Тз = Запрос.Выполнить().Выгрузить();


		НовоеРаспоряжение.Товары.Загрузить(Тз);
		НовоеРаспоряжение.ХозяйственнаяОперация=Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию;
		Для каждого Товар Из НовоеРаспоряжение.Товары  Цикл
			Если ЗначениеЗаполнено(Товар.Номенклатура.Лико_СтатьяРасходов) Тогда
				Товар.СтатьяРасходов=Товар.Номенклатура.Лико_СтатьяРасходов;
			Иначе
				Товар.СтатьяРасходов=Справочники.Лико_МастерНастройкиСтатьиРасходаДляНоменклатуры.ОпределитьСтатьюРасходов(Товар.Номенклатура);
				Если Не ЗначениеЗаполнено(Товар.СтатьяРасходов) Тогда
					Товар.СтатьяРасходов=Справочники.Лико_ПредопределенныеЗначения.СтатьяСписанияМатериаловНеопределена.ЗначениеПараметра;
				КонецЕсли;

			КонецЕсли;

			Если БракМатериала Тогда
				Товар.СтатьяРасходов=Справочники.Лико_ПредопределенныеЗначения.СтатьяРасходовДляСписанияБракаМатериалов.ЗначениеПараметра;
			КонецЕсли;




			Товар.АналитикаРасходов=Справочники.Лико_ПредопределенныеЗначения.АналитикаРасходовСписанияМатериалов.ЗначениеПараметра;
			//Товар.Упаковка=Товар.Номенклатура.ЕдиницаИзмерения;
			//Товар.КоличествоУпаковок=Товар.Количество;
		КонецЦикла;
		Если  НовоеРаспоряжение.Товары.Количество()=0 Тогда
			Возврат ;
		КонецЕсли;

		Попытка

			НовоеРаспоряжение.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Отказ = Истина;
			Сообщить("Документ """ + НовоеРаспоряжение + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());

		КонецПопытки;
		Распоряжение=НовоеРаспоряжение.Ссылка;
		ОбменДанными.Загрузка=Истина;
		Записать(РежимЗаписиДокумента.Запись);

	КонецЕсли;


КонецПроцедуры


Процедура СоздатьРедактироватьПродажа(Распоряжение, ДанныеЗаполнения, РежимЗаписи, Отказ)
	УстановитьПривилегированныйРежим(Истина);
	Если Не РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли; 
	ДляДокумента=ПолучитьСтруктуруДляЗаполненияТиповыхДокументов();
	Если ДляДокумента.Интеркампани Тогда
		Возврат;
	КонецЕсли;

	Если ДанныеЗаполнения.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Продажа И Не ВнутренняяПродажа Тогда
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Распоряжение) Тогда
			НовоеРаспоряжение=Распоряжение.ПолучитьОбъект();
			Если НовоеРаспоряжение=Неопределено Тогда
				НовоеРаспоряжение=Документы.РеализацияТоваровУслуг.СоздатьДокумент();	
				//НовоеРаспоряжение.УстановитьСсылкуНового(ДанныеЗаполнения.Распоряжение); 
			КонецЕсли;  				
		Иначе
			НовоеРаспоряжение=Документы.РеализацияТоваровУслуг.СоздатьДокумент();	
			//НовоеРаспоряжение.УстановитьСсылкуНового(ДанныеЗаполнения.Распоряжение); 				
		КонецЕсли; 

		Если  ТипЗнч(НовоеРаспоряжение)<>Тип("ДокументОбъект.РеализацияТоваровУслуг") ТОгда
			НовоеРаспоряжение=Документы.РеализацияТоваровУслуг.СоздатьДокумент();	
		КонецЕсли;	

		ЗаполнитьЗначенияСвойств(НовоеРаспоряжение,ДанныеЗаполнения);
		//***************************************************
		//******************************************************
		//ДляДокумента=ПолучитьСтруктуруДляЗаполненияТиповыхДокументов();
		ВалютаРуб = Константы.ВалютаРегламентированногоУчета.Получить();
		ВалютаЕвр = Константы.ВалютаУправленческогоУчета.Получить();

		НовоеРаспоряжение.БанковскийСчетОрганизации = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитОрганизацииБанковскийСчетПоУмолчанию", НовоеРаспоряжение.Организация);
		Если НЕ ЗначениеЗаполнено(НовоеРаспоряжение.БанковскийСчетОрганизации) Тогда
			НовоеРаспоряжение.БанковскийСчетОрганизации = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(НовоеРаспоряжение.Организация, ВалютаРуб);
		КонецЕсли;
		НовоеРаспоряжение.БанковскийСчетКонтрагента = Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(Контрагент, ВалютаРуб);
		НовоеРаспоряжение.Валюта =Валюта;
		НакладнаяНаЭкспорт = Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент;

		НовоеРаспоряжение.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		НовоеРаспоряжение.ВалютаВзаиморасчетов = НовоеРаспоряжение.Валюта;
		НовоеРаспоряжение.Контрагент = Контрагент;
		НовоеРаспоряжение.Партнер = Партнер;
		//НовоеРаспоряжение.Подразделение = ПолучитьПодразделениеПоРегиону(ПерваяСтрока.ЗаказКлиента.Регион);
		НовоеРаспоряжение.Склад = Склад;
		НовоеРаспоряжение.Согласован = Истина;

		НовоеРаспоряжение.Соглашение = ДляДокумента.Соглашение;
		НовоеРаспоряжение.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
		НовоеРаспоряжение.ЦенаВключаетНДС = Истина;
		НовоеРаспоряжение.Автор = ПараметрыСеанса.ТекущийПользователь;
		НовоеРаспоряжение.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
		Отбор = Новый Структура("Валюта", Валюта);
		//КурсВалюты = РегистрыСведений.КурсыВалют.СрезПоследних(ДатаОтгрузки, Отбор);
		//НовоеРаспоряжение.Курс = КурсВалюты[0].Курс;
		//НовоеРаспоряжение.Кратность = КурсВалюты[0].Кратность;
		НовоеРаспоряжение.КурсЧислитель = 1;
		НовоеРаспоряжение.Курсзнаменатель = 1;
		НовоеРаспоряжение.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;  		
		НовоеРаспоряжение.СпособДоставки = ?(ЗначениеЗаполнено(ДляДокумента.СпособДоставки),ДляДокумента.СпособДоставки,Перечисления.СпособыДоставки.Самовывоз);		
		НовоеРаспоряжение.Комментарий = "" + НовоеРаспоряжение.Комментарий + "Создан автоматически на основании документа """ + Ссылка + """";


		ФизЛицо = АвторДокумента;
		НовоеРаспоряжение.Отпустил = ФизЛицо;
		НовоеРаспоряжение.ОтпустилДолжность = Лико_Дополнительно.НайтиДолжностьФизЛица(НовоеРаспоряжение.Отпустил, НовоеРаспоряжение.Организация, НовоеРаспоряжение.Дата);
		Если НЕ ЗначениеЗаполнено(НовоеРаспоряжение.ОтпустилДолжность) Тогда
			НовоеРаспоряжение.ОтпустилДолжность = "Кладовщик";
		КонецЕсли;
		НовоеРаспоряжение.Менеджер = Автор;
		НовоеРаспоряжение.Руководитель = Лико_Дополнительно.НайтиЛицоСПравомПодписи(НовоеРаспоряжение.Организация, Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, НовоеРаспоряжение.Отпустил, НовоеРаспоряжение.Дата); 
		НовоеРаспоряжение.ГлавныйБухгалтер = Лико_Дополнительно.НайтиЛицоСПравомПодписи(НовоеРаспоряжение.Организация, Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, НовоеРаспоряжение.Отпустил, НовоеРаспоряжение.Дата); 

		Если НовоеРаспоряжение.ВалютаВзаиморасчетов = ВалютаРуб Тогда
			// резидент
			Если НовоеРаспоряжение.Валюта = ВалютаРуб Тогда
				//НовоеРаспоряжение.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВРубляхОплатаВРублях;
			Иначе
				//НовоеРаспоряжение.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВРублях;
			КонецЕсли;
		Иначе
			// не резидент
			Если НакладнаяНаЭкспорт Тогда
				// не резидент, ставка НДС = 0
				//НовоеРаспоряжение.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВВалюте;
			Иначе
				// резидент
				//НовоеРаспоряжение.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВРублях;
			КонецЕсли;
		КонецЕсли;

		НовоеРаспоряжение.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено;


		// Заполняем договор
		//ДляДокумента=ПолучитьСтруктуруДляЗаполненияТиповыхДокументов();
		НовоеРаспоряжение.Договор        =ДляДокумента.Договор; 			
		НовоеРаспоряжение.Основание		=НовоеРаспоряжение.Договор.Наименование;
		НовоеРаспоряжение.ОснованиеДата	=НовоеРаспоряжение.Договор.Дата;
		НовоеРаспоряжение.ОснованиеНомер=НовоеРаспоряжение.Договор.Номер;

		//Если НЕ ЗначениеЗаполнено(НовоеРаспоряжение.ДатаПлатежа) Тогда
		//	НовоеРаспоряжение.ДатаПлатежа = НовоеРаспоряжение.Дата;
		//КонецЕсли;

		//********************************
		//************************************
		Тз=ДанныеЗаполнения.Товары.Выгрузить(,ПоляТаблицыТоваров());
		Для каждого СтрТЗ Из Тз Цикл
			СтрТЗ.КоличествоУпаковок= СтрТЗ.Количество;
			СтрТЗ.Упаковка= СтрТЗ.Номенклатура.ЕдиницаИзмерения;			
		КонецЦикла;
		Тз.Свернуть("Номенклатура,Характеристика,Упаковка","Количество,КоличествоУпаковок");
		НовоеРаспоряжение.Товары.Загрузить(Тз); 			

		Для каждого Товар Из НовоеРаспоряжение.Товары Цикл
			Товар.Склад=Склад;			
			Товар.Цена = ЦеныНоменклатуры.Найти(Товар.Номенклатура,"Номенклатура").Цена;
			// резидент
			Товар.СтавкаНДС =  УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС18);

			ЕСли НовоеРаспоряжение.Дата>=Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаИспользованияСтавкиНДС20.ЗначениеПараметра Тогда
				Если  Год(НовоеРаспоряжение.Дата)>=2026 Тогда
					Товар.СтавкаНДС   =    УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС22);
				Иначе
					Товар.СтавкаНДС   =    УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС20);
				КонецЕсли;
			Иначе
				Товар.СтавкаНДС   =    УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС18); 
			КонецЕсли;


			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ПересчитатьСумму");
			//СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", НовоеРаспоряжение.НалогообложениеНДС);
			СтруктураДействий.Вставить("ПересчитатьСуммуНДС", Новый Структура("ЦенаВключаетНДС,СтавкаНДС", НовоеРаспоряжение.ЦенаВключаетНДС, Товар.СтавкаНДС));
			СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
			ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(Товар, СтруктураДействий, Неопределено);

		КонецЦикла;


		//ВидОперации=Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
		НовоеРаспоряжение.Товары.Сортировать("Номенклатура,Характеристика");
		//НовоеРаспоряжение.ЗаполнитьЭтапыГрафикаОплаты();

		Попытка 				
			НовоеРаспоряжение.Записать(РежимЗаписиДокумента.Проведение); 				
		Исключение
			Отказ = Истина;
			Сообщить("Документ """ + НовоеРаспоряжение + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());

		КонецПопытки;

		ЕСли Не Отказ Тогда
			Распоряжение=НовоеРаспоряжение.Ссылка;
			СоздатьДокументСчетФактураВыданный(,Распоряжение);
			СоздатьДокументСчетНаОплатуКлиенту(,Распоряжение);
			ОбменДанными.Загрузка=Истина;
			Записать(РежимЗаписиДокумента.Запись);

		КонецЕсли;


	КонецЕсли;	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры


Процедура СоздатьРедактироватьПродажаИнтеркампани(Распоряжение, ДанныеЗаполнения, РежимЗаписи,Отказ) 
	УстановитьПривилегированныйРежим(Истина);
	Если Не РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли; 
	ДляДокумента=ПолучитьСтруктуруДляЗаполненияТиповыхДокументов();
	Если НЕ ДляДокумента.Интеркампани Тогда
		Возврат;
	КонецЕсли;
	ИнтерКампани=Истина;
	Если ДанныеЗаполнения.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Продажа И Не ВнутренняяПродажа Тогда
		СоздатьРедактироватьПеремещение(Распоряжение, ДанныеЗаполнения, РежимЗаписи,Отказ);
		СоздатьДокументЛико_ПередачаТоваровМеждуОрганизациями(Распоряжение, ДанныеЗаполнения, РежимЗаписи,Отказ);
		
		
		
	КонецЕсли;	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры 

Процедура СоздатьРедактироватьПеремещение(Распоряжение, ДанныеЗаполнения, РежимЗаписи, Отказ)
	Если ЗначениеЗаполнено(ДанныеЗаполнения.Распоряжение) Тогда
		НовоеРаспоряжение=Распоряжение.ПолучитьОбъект();
		Если НовоеРаспоряжение=Неопределено Тогда
			НовоеРаспоряжение=Документы.ПеремещениеТоваров.СоздатьДокумент();	
			//НовоеРаспоряжение.УстановитьСсылкуНового(ДанныеЗаполнения.Распоряжение); 
		КонецЕсли;  				
	Иначе
		НовоеРаспоряжение=Документы.ПеремещениеТоваров.СоздатьДокумент();	
