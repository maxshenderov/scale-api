Процедура ОбработкаВидаОперации(Отказ,РежимЗаписи,РежимПроведения)

	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ВозвратПоставщику Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыВЯчейкахОстатки.Серия КАК Серия,
		|	ТоварыВЯчейкахОстатки.Ячейка КАК Ячейка,
		|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК ВНаличииОстаток
		|ИЗ
		|	РегистрНакопления.ТоварыВЯчейках.Остатки(&Дата, Серия В (&Серии)) КАК ТоварыВЯчейкахОстатки
		|ГДЕ
		|	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.Уникальный";
		Запрос.УстановитьПараметр("Дата",Дата);
		Запрос.УстановитьПараметр("Серии",ТОвары.ВыгрузитьКолонку("Серия"));

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Структура = Новый Структура;
			Структура.Вставить("Серия",Выборка.Серия);
			НайденныеСтроки=Товары.НайтиСтроки(Структура);
			Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл

				Если Выборка.Ячейка<>НайденнаяСтрока.АдресХранения Тогда
					НайденнаяСтрока.АдресХранения=Выборка.Ячейка;
				КонецЕсли;		
			КонецЦикла;
		КонецЦикла;	
	КонецЕсли;



	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаФорм Или 
		ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.СписаниеФорм Или 
		ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПеремещениеФорм Тогда 		
		Товары.Очистить();
	Иначе
		Формы.Очистить();
	КонецЕсли;

	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Списание Тогда
		Организация=ОрганизацияЯчейки();
	КонецЕсли;	


	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПеремещениеНаОтветственноеХранение и РежимЗаписи = РежимЗаписиДокумента.Проведение ТОгда
		Если Не ЗначениеЗаполнено(АдресХранения) Тогда
			АдресХранения=УправлениеСвойствами.ЗначениеСвойства(Организация,"Лико_СкладОтветственногоХранениеУПоставщика");

		КонецЕсли;

	КонецЕсли;

	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Продажа и РежимЗаписи = РежимЗаписиДокумента.Проведение ТОгда
		Ликофлекс=Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра;
		ИксПак=Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра;
		Если Контрагент=УправлениеСвойствами.ЗначениеСвойства(Ликофлекс,"КонтрагентОрганизации_8e3f712fdca94791a890e1aa7853a0d2") И Организация=ИксПак  Тогда
			ВнутренняяПродажа=Истина;

			Если Не ЗначениеЗаполнено(АдресХранения) Тогда
				АдресХранения=УправлениеСвойствами.ЗначениеСвойства(Ликофлекс,"Лико_ЗонаПриемкиСИМ"); 			
			КонецЕсли;

		КонецЕсли;


		Если Не ЗначениеЗаполнено(АдресХранения) Тогда
			//АдресХранения=УправлениеСвойствами.ЗначениеСвойства(Организация,"Лико_СкладОтветственногоХранениеУПоставщика"); 			
		КонецЕсли; 		
	КонецЕсли;



