Процедура СозатьНаборЗаписейИсторяФорм(Отказ) 
	Если  Отказ Тогда 	
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаФорм Тогда
		Движения.Лико_ИсторияДвиженийФорм.Записывать = Истина;
		
		Для Каждого ТекСтрокаФормы Из Формы Цикл
			Движение                  = Движения.Лико_ИсторияДвиженийФорм.Добавить();  			
			Движение.Период           = Дата;
			Движение.Организация      = Организация;
			Движение.Форма            = ТекСтрокаФормы.Форма;			
			Движение.Расположение     = Получатель;
			Движение.ЗаказПокупателя  = ЗаказКлиента;
			Движение.Ответственный    = АвторДокумента;
		КонецЦикла;
		
	КонецЕсли;
	
	
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.СписаниеФорм Тогда
		Движения.Лико_ИсторияДвиженийФорм.Записывать = Истина;
		
		Для Каждого ТекСтрокаФормы Из Формы Цикл
			Движение                  = Движения.Лико_ИсторияДвиженийФорм.Добавить();  			
			Движение.Период           = Дата;
			Движение.Организация      = Организация;
			Движение.Форма            = ТекСтрокаФормы.Форма;			
			Движение.Расположение     = Справочники.Лико_Конверты.СписанныеФормы;
			;
			Движение.Ответственный    = АвторДокумента;
		КонецЦикла;
		
	КонецЕсли;
	
	
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПеремещениеФорм Тогда
		Движения.Лико_ИсторияДвиженийФорм.Записывать = Истина;
		
		Для Каждого ТекСтрокаФормы Из Формы Цикл
			ПолучательФорм = ?(ЗначениеЗаполнено(ТекСтрокаФормы.КонвертПолучатель),ТекСтрокаФормы.КонвертПолучатель,КонвертПолучатель);
			Движение                  = Движения.Лико_ИсторияДвиженийФорм.Добавить();  			
			Движение.Период           = Дата;
			Движение.Организация      = Организация;
			Движение.Форма            = ТекСтрокаФормы.Форма;			
			Движение.Расположение     = ПолучательФорм;
			Движение.ЗаказПокупателя  = ТекСтрокаФормы.Форма.Заказ;
			Движение.Ответственный    = АвторДокумента;
		КонецЦикла;
		
	КонецЕсли;
	
	
	УстановитьПривилегированныйРежим(Ложь);
	
	
КонецПроцедуры 

Процедура СозатьНаборЗаписейЗабраковкаСерий(Отказ) 
	Если  Отказ Тогда 	
		Возврат;
	КонецЕсли;
//+ ---> Лико m.shenderov 12.12.2022
	УстановитьПривилегированныйРежим(Истина);	
	Движения.Лико_БракСерий.Записывать = Истина;
	
	Для каждого Материал Из ЗабраковкаСерий  Цикл 
		
		Движение 						=	Движения.Лико_БракСерий.Добавить();
		Движение.Серия					=	Материал.Серия;
		Движение.ОбъектНоменклатуры		=	Материал.Серия.ЯССМ_ОбъектНоменклатуры;
