Процедура СоздатьДокументЛико_ПередачаТоваровМеждуОрганизациями(Распоряжение, ДанныеЗаполнения, РежимЗаписи, Отказ)
	УстановитьПривилегированныйРежим(Истина); 
	Если ЗначениеЗаполнено(РаспоряжениеИнтеркампани) Тогда 
		НовоеРаспоряжение=РаспоряжениеИнтеркампани.ПолучитьОбъект();
		Если НовоеРаспоряжение=Неопределено Тогда
			НовоеРаспоряжение=Документы.Лико_ПередачаТоваровМеждуОрганизациями.СоздатьДокумент();				
		КонецЕсли;  				
	Иначе
		НовоеРаспоряжение=Документы.Лико_ПередачаТоваровМеждуОрганизациями.СоздатьДокумент();			
	КонецЕсли;  		
	Если  ТипЗнч(НовоеРаспоряжение)<>Тип("ДокументОбъект.Лико_ПередачаТоваровМеждуОрганизациями") ТОгда
		НовоеРаспоряжение=Документы.Лико_ПередачаТоваровМеждуОрганизациями.СоздатьДокумент();	
	КонецЕсли;	
	
	
	
	НовоеРаспоряжение.Дата	 					 = Дата;
	НовоеРаспоряжение.ТипДокумента	 			 = Перечисления.Лико_ТипПередачиТоваровМеждуОрганизациями.Интеркампани;
	НовоеРаспоряжение.СкладПродажи  			 = Справочники.Лико_ПредопределенныеЗначения.СкладИнтеркампани.ЗначениеПараметра;
	НовоеРаспоряжение.Валюта   					 = Валюта;
	НовоеРаспоряжение.НалогообложениеНДС  		 = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	НовоеРаспоряжение.ЦенаВключаетНДС   		 = ЦенаВключаетНДС;
	НовоеРаспоряжение.Автор   					 = ПараметрыСеанса.ТекущийПользователь;
	НовоеРаспоряжение.ПодписьЗаГлавногоБухгалтера= АвторДокумента;
	НовоеРаспоряжение.ПодписьЗаРуководителя		 = АвторДокумента;
	НовоеРаспоряжение.ПодписьОтпустил            = АвторДокумента;
	
	
	НовоеРаспоряжение.ОрганизацияПродавец   	= Организация;
	НовоеРаспоряжение.ПометкаУдаления			= Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОрганизацииДополнительныеРеквизиты.Ссылка КАК Организация
	|ИЗ
	|	Справочник.Организации.ДополнительныеРеквизиты КАК ОрганизацииДополнительныеРеквизиты
	|ГДЕ
	|	ОрганизацииДополнительныеРеквизиты.Значение = &Контрагент
	|	И ОрганизацииДополнительныеРеквизиты.Свойство.Имя = &Имя";
	Запрос.УстановитьПараметр("Имя","КонтрагентОрганизации_8e3f712fdca94791a890e1aa7853a0d2" );
	Запрос.УстановитьПараметр("Контрагент",Контрагент );                                                                            
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НовоеРаспоряжение.ОрганизацияПокупатель=Выборка.Организация; 
	КонецЦикла;	
	ДляДокумента=ПолучитьСтруктуруДляЗаполненияТиповыхДокументов();
	НовоеРаспоряжение.ДоговорМеждуОрганизациями =ДляДокумента.Договор; 
	Если НЕ ЗначениеЗаполнено(НовоеРаспоряжение.ДоговорМеждуОрганизациями) Тогда  			
		Возврат ;
	КонецЕсли;
	
	НовоеРаспоряжение.Комментарий 	= "Создан автоматически на основании документа """ + Ссылка + """"; 		
	
	
	Тз=ДанныеЗаполнения.Товары.Выгрузить(,ПоляТаблицыТоваров());
	Для каждого СтрТЗ Из Тз Цикл
		СтрТЗ.КоличествоУпаковок= СтрТЗ.Количество;
		СтрТЗ.Упаковка= СтрТЗ.Номенклатура.ЕдиницаИзмерения;			
	КонецЦикла;
	Тз.Свернуть("Номенклатура,Характеристика","Количество");
	НовоеРаспоряжение.Товары.Загрузить(Тз); 			
	
	Для каждого Товар Из НовоеРаспоряжение.Товары Цикл
		
		Товар.Цена 			= ЦеныНоменклатуры.Найти(Товар.Номенклатура,"Номенклатура").Цена; 
		
	 	Если  Год(НовоеРаспоряжение.Дата)>=2026 Тогда
			
			Товар.СтавкаНДС   	=  УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС22); 
			
		Иначе 			
			
			Товар.СтавкаНДС   	=  УчетНДСРФКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.НДС20); 
			
		КонецЕсли;
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСумму","Количество");
		
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", Новый Структура("ЦенаВключаетНДС,СтавкаНДС", НовоеРаспоряжение.ЦенаВключаетНДС, Товар.СтавкаНДС));
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(Товар, СтруктураДействий, Неопределено);
		
	КонецЦикла;
	НовоеРаспоряжение.Товары.Сортировать("Номенклатура,Характеристика");	
	НовоеРаспоряжение.Лико_Документ=Ссылка;	
	
	Если  НовоеРаспоряжение.Товары.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка			
		НовоеРаспоряжение.Записать(РежимЗаписиДокумента.Проведение); 				
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовоеРаспоряжение + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		
	КонецПопытки;
	РаспоряжениеИнтеркампани			=НовоеРаспоряжение.Ссылка;
	ОбменДанными.Загрузка	=Истина;
	Записать(РежимЗаписиДокумента.Запись);
	
	
КонецПроцедуры

Функция ПолучитьСтруктуруДляЗаполненияТиповыхДокументов() //+Лико m.shenderov 24.02.2018
	
	Структура = Новый Структура;
	Структура.Вставить("Договор"		,Неопределено) ;
	Структура.Вставить("Соглашение"		,Неопределено) ;
	Структура.Вставить("СпособДоставки"	,Неопределено) ;
	Структура.Вставить("Интеркампани"	,ложь) ;
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗаполениеРегламентированныхДокументов.Договор КАК Договор,
	|	Лико_ЗаполениеРегламентированныхДокументов.Соглашение КАК Соглашение,
	|	Лико_ЗаполениеРегламентированныхДокументов.СпособДоставки КАК СпособДоставки,
	|	Лико_ЗаполениеРегламентированныхДокументов.Интеркампани КАК Интеркампани
	|ИЗ
	|	РегистрСведений.Лико_ЗаполениеРегламентированныхДокументов КАК Лико_ЗаполениеРегламентированныхДокументов
	|ГДЕ
	|	Лико_ЗаполениеРегламентированныхДокументов.Контрагент = &Контрагент
	|	И Лико_ЗаполениеРегламентированныхДокументов.Валюта = &Валюта
	|	И Лико_ЗаполениеРегламентированныхДокументов.ТипОперации = &ВидОперации
	|	И Лико_ЗаполениеРегламентированныхДокументов.Организация = &Организация";
	Запрос.УстановитьПараметр("Контрагент",Контрагент );
	Запрос.УстановитьПараметр("Валюта",Валюта );
	Запрос.УстановитьПараметр("ВидОперации",ВидОперации);
	Запрос.УстановитьПараметр("Организация",Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Структура.Договор			=Выборка.Договор;
		Структура.Соглашение		=Выборка.Соглашение;
		Структура.СпособДоставки	=Выборка.СпособДоставки;
		Структура.Интеркампани	    =Выборка.Интеркампани;
		
	КонецЦикла; 
	
	
	Возврат Структура;
	
	
КонецФункции //-Лико m.shenderov 24.02.2018 


Функция СоздатьДокументСчетФактураВыданный(УжеСозданныйДокумент = Неопределено, Основание)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Док.Ссылка КАК Ссылка ИЗ Документ.СчетФактураВыданный КАК Док ГДЕ Док.ДокументОснование = &Основание";
	Запрос.УстановитьПараметр("Основание",Основание);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		УжеСозданныйДокумент=Выборка.Ссылка;
	КонецЦикла; 
	
	
	Отказ = Ложь;
	УстановитьПривилегированныйРежим(Истина);
	
	НовыйДокОбъект = Документы.СчетФактураВыданный.СоздатьДокумент();
	НовыйДокОбъект.Дата = Основание.Дата;
	НовыйДокОбъект.Номер = Основание.Номер;
	НовыйДокОбъект.ПредставлениеНомера = Документы.СчетФактураВыданный.ПолучитьПредставлениеНомера(НовыйДокОбъект);
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ДокументОснование", Основание);
	ДанныеЗаполнения.Вставить("Организация", Основание.Организация);
	ДанныеЗаполнения.Вставить("ДатаВыставления", Основание.Дата);
	НовыйДокОбъект.Заполнить(ДанныеЗаполнения);
	Если НовыйДокОбъект.Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент Тогда
		НовыйДокОбъект.Валюта = Основание.Валюта;
	КонецЕсли;
	НовыйДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//НовыйДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;                  
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

