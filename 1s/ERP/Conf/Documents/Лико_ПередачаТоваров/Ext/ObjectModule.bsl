Процедура ПодобратьРаспоряжение(Товар,ТаблицаСвязанныхДокументов) //+Лико m.shenderov 31.05.2020
	Если Не ЗначениеЗаполнено(Товар.Правило) или Товар.КоличествоБУ=0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипРаспоряжение=ОпределитьТипДокументаСписания(Товар.Правило);
	ТипРаспоряжениеСсылка=ТипРаспоряжение.Ссылка;
	Если    ТипРаспоряжениеСсылка=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	лРаспоряжение=Неопределено;	
	Для каждого СтрРаспоряжение Из ТаблицаСвязанныхДокументов Цикл
		Если ТипЗнч(СтрРаспоряжение.Ссылка)=ТипЗнч(ТипРаспоряжениеСсылка) Тогда
			Если ТипЗнч(СтрРаспоряжение.Ссылка)=тип("ДокументСсылка.ВнутреннееПотребление")и
				Не СтрРаспоряжение.Ссылка.ХозяйственнаяОперация=ХозяйственнаяОперацияСписания(Товар.Правило) Тогда
				Продолжить;
			КонецЕсли;
			
			лРаспоряжение=СтрРаспоряжение.Ссылка;
			Прервать;
		КонецЕсли;	 
	КонецЦикла;
	Если лРаспоряжение=Неопределено Тогда
		лРаспоряжениеОбъект=ТипРаспоряжение;
		Если ТипЗнч(ТипРаспоряжениеСсылка)=тип("ДокументСсылка.ВнутреннееПотребление")Тогда
			
			лРаспоряжениеОбъект.ХозяйственнаяОперация=ХозяйственнаяОперацияСписания(Товар.Правило); 
		КонецЕсли;
		лРаспоряжениеОбъект.Дата=Дата;
		лРаспоряжениеОбъект.Организация=Организация;
		лРаспоряжениеОбъект.Подразделение=Подразделение;
		//лРаспоряжениеОбъект.Склад=Склад;
		лРаспоряжениеОбъект.Лико_Документ=Ссылка;
		лРаспоряжениеОбъект.Записать(РежимЗаписиДокумента.Запись);
		лРаспоряжение=лРаспоряжениеОбъект.Ссылка;
		НоваяСтр=ТаблицаСвязанныхДокументов.Добавить();
		НоваяСтр.Ссылка=лРаспоряжение;
	КонецЕсли;
	Товар.Распоряжение=лРаспоряжение;
	
	
КонецПроцедуры //-Лико m.shenderov 31.05.2020

Функция ХозяйственнаяОперацияСписания(Правило) //+Лико m.shenderov 31.05.2020
	Если Правило.ТипСписания=Перечисления.Лико_ТипыСписанияНоменклатурыВПроизводство.ПередачаВЭксплуатацию Тогда 
		Возврат Перечисления.ХозяйственныеОперации.ПередачаВЭксплуатацию;
	Иначе
		Возврат Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию;
	КонецЕсли;
	
