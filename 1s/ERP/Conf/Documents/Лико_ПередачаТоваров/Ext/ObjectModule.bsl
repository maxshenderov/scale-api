			МассивНепроверяемыхРеквизитов.Удалить(ИндексРеквизита);
		КонецЕсли;
		
		
	КонецЕсли;	
	
	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПеремещениеНаОтветственноеХранение Тогда	
		
		
		
		ИндексРеквизита=МассивНепроверяемыхРеквизитов.Найти("Партнер");
		Если ИндексРеквизита<>Неопределено Тогда 
			МассивНепроверяемыхРеквизитов.Удалить(ИндексРеквизита);
		КонецЕсли;
		
		ИндексРеквизита=МассивНепроверяемыхРеквизитов.Найти("Контрагент");
		Если ИндексРеквизита<>Неопределено Тогда 
			МассивНепроверяемыхРеквизитов.Удалить(ИндексРеквизита);
		КонецЕсли;
		
		
	КонецЕсли;	
		Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаДавальцу Тогда
			
			 ПроверяемыеРеквизиты.Добавить("АдресХранения");
			
		 КонецЕсли; 
		 Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаДавальцу И 
			  ВозвратДавальцу И БракМатериала  Тогда 
			   ПроверяемыеРеквизиты.Добавить("ПодписьДокументаСотрудником");

		 КонецЕсли;

		
	МассивНепроверяемыхРеквизитов.Добавить("Отпустил");
	
	//Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Списание И
	//	ТипЗнч(Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаРегистрацииПричинСписанияОснастки.ЗначениеПараметра)=Тип("Дата") И
	//	 Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаРегистрацииПричинСписанияОснастки.ЗначениеПараметра< ТекущаяДата() И
	//	 ЕстьОснасткаБезПравил() Тогда
	//	 ПроверяемыеРеквизиты.Добавить("ПричинаСписания");  	
	//	
	// КонецЕсли; 
	 
	 Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Списание Тогда
		 ПроверяемыеРеквизиты.Добавить("ПричинаСписания");  	
		
	 КонецЕсли;

	 
	 
	 	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
	
	//ПараметрыПроверки = ОбщегоНазначенияУТ.ПараметрыПроверкиЗаполненияКоличества();
