Процедура ЗаполнитьДокументСписания2(ДокументОбъект, тчТовары)
	Если ТипЗнч(ДокументОбъект.Ссылка)<>Тип("ДокументСсылка.ВнутреннееПотребление") Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	_Подразделение= Подразделение;

	Если ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПроизводство И
		ЗначениеЗаполнено(Получатель.ВидРабочегоЦентра.Подразделение) Тогда
		_Подразделение= Получатель.ВидРабочегоЦентра.Подразделение;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Склад.Лико_Площадка.ПодразделениеПроизводство) Тогда
		
		_Подразделение= Склад.Лико_Площадка.ПодразделениеПроизводство;
		
	КонецЕсли;
	

	//НовыйДокОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
	ДокументОбъект.Дата 					= Дата;
	//ДокументОбъект.ДатаРаспоряжения 		= ДокументОбъект.Дата;
	ДокументОбъект.ПометкаУдаления			= Ложь;
	ДокументОбъект.Организация 				= Организация;
	ДокументОбъект.Ответственный 			= ПараметрыСеанса.ТекущийПользователь;
	ДокументОбъект.Подразделение 			= _Подразделение;
	ДокументОбъект.Склад 					= Склад;

	//ДокументОбъект.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
	//ДокументОбъект.СпособДоставки 			= Перечисления.СпособыДоставки.Самовывоз;
	ДокументОбъект.Комментарий 				= "Создан автоматически на основании документа """ + Ссылка + """";

	ДокументОбъект.Товары.Очистить();
	Для каждого Тч Из тчТовары Цикл
		Если Тч.Номенклатура.ГруппаФинансовогоУчета=Справочники.Лико_ПредопределенныеЗначения.ГруппаФинУчетаРасчетовДля08Счетов.ЗначениеПараметра Тогда
			Продолжить;
		КонецЕсли;

		Списать = Мин(Тч.Количество,Тч.КоличествоБу);
		Если Списать=0 тогда
			Продолжить;
		КонецЕсли;

		Стр=ДокументОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Стр,Тч);
		Стр.КоличествоУпаковок	= Списать;
		Стр.Количество			= Списать;
		Стр.Упаковка			= Стр.Номенклатура.ЕдиницаИзмерения;
		Стр.СтатьяРасходов      = Стр.Номенклатура.Лико_СтатьяРасходов;


		Если Стр.СтатьяРасходов.ТипЗначения=Новый ОписаниеТипов("СправочникСсылка.ВидыРабочихЦентров") Тогда
			Стр.АналитикаРасходов=Получатель.ВидРабочегоЦентра;
		КонецЕсли;
		Стр.АналитикаРасходов   = ?(ЗначениеЗаполнено(Стр.АналитикаРасходов),Стр.АналитикаРасходов,_Подразделение);

		Если ДокументОбъект.ХозяйственнаяОперация= Перечисления.ХозяйственныеОперации.ПередачаВЭксплуатацию Тогда
			Стр.ФизическоеЛицо   		= Сотрудник;
			Стр.КатегорияЭксплуатации   = Тч.Правило.КатегорияЭксплуатации;
		КонецЕсли;




	КонецЦикла;
	Если ДокументОбъект.ХозяйственнаяОперация= Перечисления.ХозяйственныеОперации.ПередачаВЭксплуатацию Тогда

		ДокументОбъект.Товары.Свернуть("Номенклатура,Характеристика,СтатьяРасходов,АналитикаРасходов,ФизическоеЛицо,КатегорияЭксплуатации","Количество,КоличествоУпаковок");

	Иначе

		ДокументОбъект.Товары.Свернуть("Номенклатура,Характеристика,СтатьяРасходов,АналитикаРасходов","Количество,КоличествоУпаковок");
	КонецЕсли;

	Если ДокументОбъект.Товары.Количество()=0 Тогда
		ДокументОбъект.Записать();
		ДокументОбъект.Удалить();
		Возврат;
	КонецЕсли;
	ДокументОбъект.Лико_Документ=Ссылка;
	ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьКонтрольПриПроведении",Истина);



