			КонецЕсли;
			
			НовяСтрТз=ТзРасход.Добавить();
			НовяСтрТз.СкладОтправитель=СкладОтправитель;
			НовяСтрТз.СкладПолучатель=СкладПолучатель;
			
			Движение 				= НаборЗаписей.Добавить(); 
			Движение.Регистратор 	= Ссылка; 
			Движение.Период			= Дата;
			Движение.Организация	= СтрТаблицы.ОрганизацияОтветственногоХранения;
			ОрганизацияДокумента    =  СтрТаблицы.Организация;
			// Заполнить счет дебета. 
			Движение.СчетКт 		= ПланыСчетов.Хозрасчетный.ТМЦнаскладах;
			// Заполнить аналитику счета дебета. 
			Движение.СубконтоКт.Контрагенты 	= 	УправлениеСвойствами.ЗначениеСвойства(ОрганизацияДокумента,"КонтрагентОрганизации_8e3f712fdca94791a890e1aa7853a0d2"); 
			Движение.СубконтоКт.Номенклатура 	= 	СтрТаблицы.Серия.ЯССМ_ОбъектНоменклатуры.Номенклатура; 
			Движение.СубконтоКт.Склады 			= 	СкладОтправитель; 
					
			
			Движение.КоличествоКт				=	СтрТаблицы.Количество;
			// Балансовый ресурс. 
			Движение.Сумма 						= 	СтрТаблицы.Сумма; 
			// Реквизиты.Движение.НомерЖурнала = "БК"; 
			Движение.Содержание 				= "Расход с  ответственного хранения BRC";   
			
			
		КонецЕсли;	
		ОрганизацияВладелецПолучатель	= УправлениеСвойствами.ЗначениеСвойства(СкладПолучатель,"ОрганизациявладелецТовара_45268c9975cc4604bdcfde6c95172d5f");
		ОрганизацияВладелецОтправитель	= УправлениеСвойствами.ЗначениеСвойства(СкладОтправитель,"ОрганизациявладелецТовара_45268c9975cc4604bdcfde6c95172d5f");
			
		НовяСтрТз.Номенклатура		=СтрТаблицы.Серия.ЯССМ_ОбъектНоменклатуры.Номенклатура;
		НовяСтрТз.Характеристика	=СтрТаблицы.Серия.ЯССМ_ОбъектНоменклатуры.Характеристика;
		НовяСтрТз.Упаковка			=СтрТаблицы.Серия.ЯССМ_ОбъектНоменклатуры.Номенклатура.ЕдиницаИзмерения;
		НовяСтрТз.Количество		=СтрТаблицы.Количество;
		НовяСтрТз.КоличествоУпаковок=СтрТаблицы.Количество; 		
			
		
		Если ЗначениеЗаполнено(ОрганизацияВладелецПолучатель) И  ОрганизацияВладелецПолучатель=ОрганизацияВладелецОтправитель Тогда
			Продолжить;
		КонецЕсли;
		

		
		НоваяСтрокаТоварыНаСкладах				=ТаблицаТоварыНаСкладах.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТоварыНаСкладах,НовяСтрТз);
		НоваяСтрокаТоварыНаСкладах.ВидДвижения	=?(СтрТаблицы.ВидДвижения=ВидДвиженияНакопления.Приход,ВидДвиженияНакопления.Расход,ВидДвиженияНакопления.Приход);
		НоваяСтрокаТоварыНаСкладах.Период		=Дата;
		НоваяСтрокаТоварыНаСкладах.Серия		=СтрТаблицы.Серия;
		НоваяСтрокаТоварыНаСкладах.Склад		=?(СтрТаблицы.ВидДвижения=ВидДвиженияНакопления.Приход,НовяСтрТз.СкладОтправитель,НовяСтрТз.СкладПолучатель);
		НоваяСтрокаТоварыНаСкладах.ВНаличии		=СтрТаблицы.Количество;		
		ПерезаписатьТоварыНаСкладах				=Истина;  		
	КонецЦикла;
	
	
	// Записать набор записей. 
	НаборЗаписей.Записать();	
	
	Если ТзПриход.Количество()>0 Тогда	
		ДанныеЗаполнения = Новый Структура;  
