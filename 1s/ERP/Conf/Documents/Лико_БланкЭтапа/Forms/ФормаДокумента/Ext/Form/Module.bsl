&НаКлиенте
Процедура РасчетКоличестваТаблицыТовары(ВозвратКоличества=Ложь,УУ=Ложь) //+Лико m.shenderov 24.12.2017
	Данные=Элементы.Товары.ТекущиеДанные;
	НомерСтроки=Строка(Элементы.Товары.ТекущаяСтрока);
	Если ВозвратКоличества Тогда 
		Если УУ Тогда 
			Данные.ВозвратКоличество	= Лико_ОбщегоНазначенияСервер.КоличествоПоСерии(Данные.Серия,Данные.ВозвратКоличествоУУ,УУ);
		Иначе
			
		Данные.ВозвратКоличествоУУ		= Лико_ОбщегоНазначенияСервер.КоличествоПоСерии(Данные.Серия,Данные.ВозвратКоличество);
		КонецЕсли;
		Данные.КоличествоРасход			= Данные.Количество		- Данные.ВозвратКоличество;
		Данные.КоличествоРасходУУ		= Данные.КоличествоУУ	- Данные.ВозвратКоличествоУУ;
	Иначе
		Если УУ Тогда
			Данные.КоличествоРасход		= Лико_ОбщегоНазначенияСервер.КоличествоПоСерии(Данные.Серия,Данные.КоличествоРасходУУ,УУ); 			
		Иначе
			Данные.КоличествоРасходУУ		= Лико_ОбщегоНазначенияСервер.КоличествоПоСерии(Данные.Серия,Данные.КоличествоРасход);
		КонецЕсли;
		Данные.ВозвратКоличество		= Макс(Данные.Количество		- Данные.КоличествоРасход,0);
		Данные.ВозвратКоличествоУУ		= Макс(Данные.КоличествоУУ	- Данные.КоличествоРасходУУ,0); 		
	КонецЕсли;
	Если  Данные.ВозвратКоличество<>0 Или Данные.КоличествоРасход<>0 Тогда
		Данные.Списать=Истина;
		//Начало изменений Иванова Анна 20181023
		
		Если ЗначениеЗаполнено(Данные.Номенклатура) И  ЗначениеЗаполнено(Объект.ЗаказПокупателя) ТОгда 
			ЗаполнитьВидРаботНаСервере(Данные.ПолучитьИдентификатор());	
		КонецЕсли;
		//Начало изменений Иванова Анна 20181023
		
	Иначе
		Данные.Списать=ЛОжь;
	КонецЕсли;
	
	
КонецПроцедуры //-Лико m.shenderov 24.12.2017

