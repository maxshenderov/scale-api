Процедура НайтиНаСкладе (РЦ,СтруктураНоменклатуры) //+Лико m.shenderov 08.12.2017
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РабочиеЦентры.Ссылка КАК РЦ
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|				И Серия = &Серия
	|				И Характеристика = &Характеристика) КАК ТоварыВЯчейкахОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РабочиеЦентры КАК РабочиеЦентры
	|		ПО ТоварыВЯчейкахОстатки.Ячейка = РабочиеЦентры.ЛикоЯчейка";
	Запрос.УстановитьПараметр("Номенклатура",СтруктураНоменклатуры.Номенклатура );
	Запрос.УстановитьПараметр("Серия",?(ЗначениеЗаполнено(СтруктураНоменклатуры.Серия),СтруктураНоменклатуры.Серия,Справочники.СерииНоменклатуры.ПустаяСсылка()));
	Запрос.УстановитьПараметр("Характеристика",?(ЗначениеЗаполнено(СтруктураНоменклатуры.Характеристика),СтруктураНоменклатуры.Характеристика,Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка()));
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Рц=Выборка.РЦ;
	КонецЦикла; 
	
	
КонецПроцедуры  //-Лико m.shenderov 08.12.2017



