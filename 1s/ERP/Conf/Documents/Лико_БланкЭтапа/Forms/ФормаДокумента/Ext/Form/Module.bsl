&НаКлиенте
Процедура ДобавитьРолик(Команда)
	Товар=Элементы.Товары.ТекущиеДанные;	
	Структура = Новый Структура;
	Структура.Вставить("ВидОперации","ДобавитьВОрдер");
	Структура.Вставить("BRC",Ложь); 
	Структура.Вставить("ЗакрытиеБланка",Истина);


	Если Товар<>Неопределено  Тогда  
		Структура.Вставить("Номенклатура",Товар.Номенклатура);
		Структура.Вставить("Характеристика",Товар.Характеристика);
		Структура.Вставить("Количество",Товар.КоличествоУУ);
		Структура.Вставить("КоличествоУпаковок",Товар.Количество);
		Нарезка= Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Товар.Характеристика,"ЯССМ_Нарезка");
		Если ЗначениеЗаполнено(Нарезка) Тогда
			
			Структура.Вставить("Упаковка",ПолучтьУпаковкуПоНарезкеСервер(Нарезка));
		КонецЕсли;
		
	КонецЕсли;
	ОписаниеОповещения= Новый ОписаниеОповещения("Лико_ПодборСерийЗавершение",ЭтаФорма);
	ОткрытьФорму("Обработка.Лико_СозданиеОбъектовНоменклатурыГрупповое.Форма.Форма",Структура,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	//КонецЕсли;
	
КонецПроцедуры

