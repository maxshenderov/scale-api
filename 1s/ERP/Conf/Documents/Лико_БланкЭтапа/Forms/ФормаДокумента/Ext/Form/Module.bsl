			Если ТекущаяСтрока.ВозвратКоличество>0 и  ТекущаяСтрока.Количество<>ТекущаяСтрока.ВозвратКоличество ТОгда
				КоличествоНаПечать=ТекущаяСтрока.ВозвратКоличество;
			Иначе
				КоличествоНаПечать=0;
			КонецЕсли;
			
			Если КоличествоНаПечать>0 Тогда	
				
				//+m.shenderov 03.10.2016 			
				//ЯССМ_Печать.ПечатьШтрихкодаОбъектаНоменклатуры(СтрокаТовары.ОбъектНоменклатуры, 1, СразуНаПринтер, , );
				
				КолНаПечать=КоличествоНаПечать;
				ТекСерия=ТекущаяСтрока.Серия;
				ПодключитьОбработчикОжидания("ПечатьБиркиОстаток",1,Истина);
				////Лико_ДополнительноКлиент.ПечатьЯрлыкаОбъектаНоменклатуры(ЗначениеРеквизитаОбъектаСервер(ТекущаяСтрока.Серия,"ЯССМ_ОбъектНоменклатуры"),,,КоличествоНаПечать);
				
				//-m.shenderov 03.10.2016 			
			КонецЕсли; 				
			//КонецЕсли;
		КонецЕсли;
	КонецЕсли;  	
КонецПроцедуры

