&НаКлиенте
Процедура ИзминенияФлагаСписания() //+Лико m.shenderov 24.12.2017
	Данные=Элементы.Товары.ТекущиеДанные;
	
	Если Данные.Списать Тогда
		Если Данные.КоличествоРасход=0 И Данные.ВозвратКоличество=0 Тогда
			Данные.КоличествоРасход=Данные.Количество;
			РасчетКоличестваТаблицыТовары();
		КонецЕсли;
		//Начало изменений Иванова Анна 20181022
		
		
		Если ЗначениеЗаполнено(Объект.ЗаказПокупателя) И ЗначениеЗаполнено(Данные.Номенклатура) Тогда
			ЗаполнитьВидРаботНаСервере(Данные.ПолучитьИдентификатор());
		КонецЕсли;	
		//Конец изменений Иванова Анна 20181022
		
		//+ Лико m.shenderov 16.11.2018
		//Если НЕ ЗначениеЗаполнено(Данные.ВидРабот) Тогда
		//	Данные.ВидРабот = ТекущийВидРабот;
		//КонецЕсли;
		//Если НЕ ЗначениеЗаполнено(Данные.КлючСтрокиЗаказа) Тогда
		//	Данные.КлючСтрокиЗаказа = ТекущийИдентификаторВидаРаботы;
		//КонецЕсли;
		
		//- Лико m.shenderov 16.11.2018
		
	Иначе
		Данные.КоличествоРасход		=0;
		Данные.КоличествоРасходУУ	=0;
		Данные.ВозвратКоличество	=0;
		Данные.ВозвратКоличествоУУ	=0;	
		Данные.ВидРабот = Неопределено;
		Данные.КлючСтрокиЗаказа = Неопределено;
		Данные.НомерРаботы = Неопределено;
		Данные.ВидСекции=Неопределено;
	КонецЕсли;
	
	
КонецПроцедуры //-Лико m.shenderov 24.12.2017

//Начало изменений Иванова Анна 20181022
&НаСервере
Процедура ЗаполнитьВидРаботНаСервере(идентификатор)
	
	Если УчетПоВидуСекций Тогда 
		
		ЗаполнитьВидСекцииНаСервере(идентификатор); 
		
		Возврат;	
	КонецЕсли;
	 
		 
	
	стр = Объект.Товары.НайтиПоИдентификатору(Идентификатор);
	Ном = стр.Номенклатура;
	Если Ном.ВидНоменклатуры.Лико_РулонныйМатериал И стрНайти(Ном.Наименование, "Незавершенное производство")=0 Тогда 
		//ЗаполнитьВидыРабот();
		
		
		НайденныйВидРабот=Лико_Планирование.НайтиРаботуПоНоменклатуре(Объект.ЗаказПокупателя,Объект.НомерПроката,Ном);
		стр.видРабот = НайденныйВидРабот.ВидРабот;
		Стр.НомерРаботы=НайденныйВидРабот.НомерРаботы;
		
		НайденныйВидРабот=Документы.Лико_ПодготовкаМатериалов.ПолучитьВидРаботыИзРезерваМатериала(Объект.ЗаказПокупателя,Ном);
		
		ЕСли ЗначениеЗаполнено(НайденныйВидРабот.ВидРабот) Тогда
			стр.видРабот = НайденныйВидРабот.ВидРабот;
			Стр.НомерРаботы=НайденныйВидРабот.НомерРаботы;
			
		КонецЕсли; 	
			
	КонецЕсли;	
КонецПроцедуры


&НаСервере
Процедура ЗаполнитьВидСекцииНаСервере(идентификатор)
	стр = Объект.Товары.НайтиПоИдентификатору(Идентификатор);
	Ном = стр.Номенклатура;
	Если Ном.ВидНоменклатуры.Лико_РулонныйМатериал И стрНайти(Ном.Наименование, "Незавершенное производство")=0 Тогда 
		//ЗаполнитьВидыРабот();
		
		
		НайденныйВидСекции=Лико_Планирование.НайтиВидСекцииПоНоменклатуре(Объект.ЗаказПокупателя,Объект.НомерПроката,Ном);
		стр.ВидСекции = НайденныйВидСекции.ВидСекции;
		Стр.НомерРаботы=НайденныйВидСекции.НомерРаботы;
		НайденныйВидСекции=Документы.Лико_ПодготовкаМатериалов.ПолучитьВидРаботыИзРезерваМатериала(Объект.ЗаказПокупателя,Ном);
		
		ЕСли ЗначениеЗаполнено(НайденныйВидСекции.ВидСекции) Тогда
			стр.ВидСекции = НайденныйВидСекции.ВидСекции;
			Стр.НомерРаботы=НайденныйВидСекции.НомерРаботы; 
		КонецЕсли;
		
			
	КонецЕсли;	
КонецПроцедуры

//Конец изменений Иванова Анна 20181022

