&НаКлиенте
Процедура УстановитьВидимость()
	
	Если Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОперацийЗакрытияБланка.ЗакрытиеБланка") Тогда
		Элементы.ХозяйственнаяОперация.Видимость						=Ложь;
		Элементы.РежимЗакрытия.Видимость								=Истина;
		Объект.ХозяйственнаяОперация									=Неопределено;
		Элементы.ГруппаОрганизацияПодразделение.Видимость				=Истина;
		Элементы.ГруппаПериод.Видимость									=Истина;
		Элементы.ГруппаЗаказ.Видимость									=Истина;

		Элементы.ТоварыРабочийЦентр.Видимость							=Истина;
		Элементы.ТоварыСерияЯССМ_ОбъектНоменклатурыНомерБланка.Видимость=Истина;
		Элементы.ТоварыАдресХранения.Видимость							=Ложь;
		Элементы.ТоварыКоличество.Видимость								=Истина;
		Элементы.ТоварыВозвратКоличество.Видимость						=Истина;
		Элементы.ВыпускСоздатьРоликиВыпущеннойПродукции.Видимость		=Истина;
		Элементы.ВыпускРабочийЦентрПолучатель.Видимость					=Истина;
		Элементы.ВыпускАдресХранения.Видимость							=Ложь;

		Элементы.ТоварыЗагрузитьПоРабочемуЦентру.Видимость             =Истина;
		Элементы.ТоварыРасчитатьДлинуРолика.Видимость                  =Истина;
		Элементы.ТоварыУказатьСерии.Видимость                          =Ложь;
		Элементы.ТоварыПодборНоменклатуры.Видимость                    =ЛОжь;
		Элементы.ВыпускПодборНоменклатуры.Видимость                    =ЛОжь;


	ИначеЕсли Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОперацийЗакрытияБланка.СборкаРазборка") Тогда
		Элементы.ХозяйственнаяОперация.Видимость=Истина;
		Элементы.РежимЗакрытия.Видимость=Ложь;
		Если НЕ ЗначениеЗаполнено(Объект.ХозяйственнаяОперация) Тогда
			Объект.ХозяйственнаяОперация=ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РазборкаТоваров");

		КонецЕсли;
		Элементы.ГруппаОрганизацияПодразделение.Видимость=Ложь;
		Элементы.ГруппаПериод.Видимость=Ложь;
		Элементы.ГруппаЗаказ.Видимость=Ложь;

		Элементы.ТоварыРабочийЦентр.Видимость							=Ложь;
		Элементы.ТоварыСерияЯССМ_ОбъектНоменклатурыНомерБланка.Видимость=Ложь;
		Элементы.ТоварыАдресХранения.Видимость							=Истина;
		Элементы.ТоварыКоличество.Видимость								=Ложь;
		Элементы.ТоварыВозвратКоличество.Видимость						=Ложь;
		Элементы.ВыпускСоздатьРоликиВыпущеннойПродукции.Видимость		=Ложь;
		Элементы.ВыпускРабочийЦентрПолучатель.Видимость					=Ложь;
		Элементы.ВыпускАдресХранения.Видимость			                =Истина;

		Элементы.ТоварыЗагрузитьПоРабочемуЦентру.Видимость             =Ложь;
		Элементы.ТоварыРасчитатьДлинуРолика.Видимость                  =Ложь;
		Элементы.ТоварыУказатьСерии.Видимость                          =Истина;
		Элементы.ТоварыПодборНоменклатуры.Видимость                    =Истина;
		Элементы.ВыпускПодборНоменклатуры.Видимость                    =ЛОжь;

	КонецЕсли;

	УстановитьВидимостьПодбораНоменклатуры();
    УстановитьВидимостьПодписиДокумента(); 
	УстановитьВидимостьУчетПоСекции();
	//УстановитьВидимостьПеремотка();

КонецПроцедуры


   &НаКлиенте
   Процедура УстановитьВидимостьПодписиДокумента() //+Лико m.shenderov 25.07.2023
	   
	   Если ТребуетсяПодписьДокумента И ЗначениеЗаполнено(Объект.Ссылка) Тогда
		   
		   Элементы.ГруппаПодписьДокумента.Видимость=Истина;
	   Иначе
		   Элементы.ГруппаПодписьДокумента.Видимость=Ложь; 	   
	   КонецЕсли; 	   
	   
   КонецПроцедуры //-Лико m.shenderov 25.07.2023
   
   
   
   &НаКлиенте
  Процедура УстановитьВидимостьУчетПоСекции() //+Лико m.shenderov 12.10.2023
	   
	   Если УчетПоВидуСекций Тогда 
		   
		   Элементы.ТоварыВидСекции.Видимость	=Истина;
		   Элементы.ТоварыВидСекции.Заголовок	="Вид работы";
		   Элементы.ТоварыВидРабот.Видимость	=Ложь;
		   
	   Иначе
		   
		   Элементы.ТоварыВидСекции.Видимость	=Ложь;
		   Элементы.ТоварыВидРабот.Видимость	=Истина; 
		   
	   КонецЕсли;
	   
	   Если РольДоступнаСервер("ПолныеПрава") Тогда
		   
		   Элементы.ТоварыВидСекции.Видимость	=Истина;
		   Элементы.ТоварыВидРабот.Заголовок	="Вид работы(старый)";
		   Элементы.ТоварыВидРабот.Видимость	=Истина;
		   
	   КонецЕсли;
	   
	   
	   
   КонецПроцедуры //-Лико m.shenderov 12.10.2023
   
      &НаКлиенте
  Процедура УстановитьВидимостьПеремотка() //+Лико m.shenderov 12.10.2023
	   
	   Элементы.ГруппаПеремотка.Видимость = Ложь;
	   
	  
	   Если РольДоступнаСервер("ПолныеПрава") Тогда
		   
		   Элементы.ГруппаПеремотка.Видимость	=Истина;
		   
	   Иначе
		   Если  ЗначениеЗаполнено(Объект.СтатусВыпуска) Тогда 
			   
			    Элементы.ГруппаПеремотка.Видимость = Истина;
				Элементы.СтатусВыпуска.Доступность = Ложь; 
				Элементы.СерияУпаковки.Доступность = Ложь;
				
			   
		   КонецЕсли;
		   
			   
		   
			   
	   КонецЕсли;
	   
	   
	   
   КонецПроцедуры //-Лико m.shenderov 12.10.2023

   
   
