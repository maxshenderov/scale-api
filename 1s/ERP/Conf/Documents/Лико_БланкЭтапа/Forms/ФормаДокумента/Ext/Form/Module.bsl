		//Если ТекущаяСтрока.ВозвратКоличество<>0 Тогда
		ТекущаяСтрока.Списать = Истина;
		//КонецЕсли;
		//Иванова Анна 20181023
		Если ЗначениеЗаполнено(текущаяСтрока.Номенклатура) И  ЗначениеЗаполнено(Объект.ЗаказПокупателя) ТОгда 
			ЗаполнитьВидРаботНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());	
		КонецЕсли;
		
		СразуНаПринтер=ПолучитьСвойствоСерверСразуНапринтер();
		Если СразуНаПринтер И ЗначениеЗаполнено(ТекущаяСтрока.Серия) Тогда
			//Если ИспользоватьАлгоритмПоФакту Тогда
			ОбъектНоменклатуры=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.Серия,"ЯССМ_ОбъектНоменклатуры");
