&НаСервере
Функция ПолучиьСтруктуруПараметровДляРоликовВыпущеннойПродукции()
	Структура = Новый Структура;
	
	//=--------- попробуем определить нарезку -----
	ЗапросВТ = Новый Запрос;
	ЗапросВТ.Текст =
	"ВЫБРАТЬ
	|	Таблица.Серия КАК Серия
	|ПОМЕСТИТЬ ТаблицаНарезок
	|ИЗ
	|	&Таб КАК Таблица";
	
	ЗапросВТ.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗапросВТ.УстановитьПараметр("Таб", Объект.Товары.Выгрузить());
	ЗапросВТ.Выполнить();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц=ЗапросВТ.МенеджерВременныхТаблиц; 
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаНарезок.Серия.ЯССМ_ОбъектНоменклатуры.Нарезка КАК Нарезка
	|ИЗ
	|	ТаблицаНарезок КАК ТаблицаНарезок
	|ГДЕ
	|	ТаблицаНарезок.Серия.ЯССМ_ОбъектНоменклатуры.Нарезка <> ЗНАЧЕНИЕ(Справочник.ЯССМ_Нарезки.ПустаяСсылка)"; 
	
	ТЗНарезки = Запрос.Выполнить().Выгрузить();
	
	
	//Запрос = Новый Запрос;
	//Запрос.Текст = 
	//"ВЫБРАТЬ
	//|	ЯССМ_ОбъектыНоменклатуры.Нарезка КАК Нарезка
	//|ИЗ
	//|	Справочник.ЯССМ_ОбъектыНоменклатуры КАК ЯССМ_ОбъектыНоменклатуры
	//|ГДЕ
	//|	ЯССМ_ОбъектыНоменклатуры.Нарезка <> ЗНАЧЕНИЕ(Справочник.ЯССМ_Нарезки.ПустаяСсылка)
	//|	И ЯССМ_ОбъектыНоменклатуры.Серия В(&Серия)";
	//Запрос.УстановитьПараметр("Серия",Объект.Товары.Выгрузить().ВыгрузитьКолонку("Серия"));
	//РезультатЗапроса = Запрос.Выполнить().Выгузить;
	
	
	
	
	
	
	Если ТЗНарезки.Количество()=1 Тогда
		Нарезка = ТЗНарезки[0].Нарезка;
	Иначе
		Нарезка = Справочники.ЯССМ_Нарезки.ПустаяСсылка();
	КонецЕсли;
	
	Втулка = Справочники.Лико_Втулки.НайтиПоРеквизиту("Размер", 76);
	
	//--------== Конец попробуем определить нарезку
	
	// !!!!!????? пока "забыдлокодил"
	ОбъектНоменклатураAmcor = Неопределено;
	//ГруппаЯССМ_ОбъектыНоменклатурыAmcor = Справочники.ЯССМ_ОбъектыНоменклатуры.НайтиПоКоду("647918");
	ГруппаЯССМ_ОбъектыНоменклатурыAmcor = Справочники.Лико_ПредопределенныеЗначения.ГруппаЛиматор.ЗначениеПараметра;
	
	Если ЗначениеЗаполнено(ГруппаЯССМ_ОбъектыНоменклатурыAmcor) Тогда
		
		Для Каждого СтрокаТовары Из Объект.Товары Цикл
			Если ЗначениеЗаполнено(СтрокаТовары.Серия.ЯССМ_ОбъектНоменклатуры) Тогда
				Если СтрокаТовары.Серия.ЯССМ_ОбъектНоменклатуры.ПринадлежитЭлементу(ГруппаЯССМ_ОбъектыНоменклатурыAmcor) Тогда
					ОбъектНоменклатураAmcor = СтрокаТовары.Серия.ЯССМ_ОбъектНоменклатуры;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	РабочийЦентрПолучатель = Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ТСРабочийЦентрДляВыпущеннойПродукции",Неопределено);
	
	
	
	Структура.Вставить("НомерЗаказа",Объект.НомерЗаказа);
	Структура.Вставить("НомерБланка",Объект.НомерБланка);
	Структура.Вставить("Нарезка",Нарезка);
	Структура.Вставить("Втулка",Втулка);
	Структура.Вставить("АвторДокумента",Объект.АвторДокумента);
	Структура.Вставить("ОбъектНоменклатураAmcor",ОбъектНоменклатураAmcor);
	
	Возврат Структура;
	
	
	
	
	
КонецФункции

&НаКлиенте
Процедура СоздатьРоликиВыпущеннойПродукции(Команда)
	Если Не ЗначениеЗаполнено(Объект.НомерЗаказа) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не заполнен номер заказа. Заполните его.";
		Сообщение.Поле = "Объект.НомерЗаказа";
		Сообщение.УстановитьДанные(Объект);
		Сообщение.Сообщить(); 		
		Возврат;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Объект.НомерБланка) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не заполнен номер бланка. Заполните его.";
		Сообщение.Поле = "Объект.НомерБланка";
		Сообщение.УстановитьДанные(Объект);
		Сообщение.Сообщить(); 		
		Возврат;
	КонецЕсли; 	
	
	ОписаниеОповещения= Новый ОписаниеОповещения("СоздатьРоликиВыпущеннойПродукцииЗавершение",ЭтаФорма);
	СтруктураПараметров=ПолучиьСтруктуруПараметровДляРоликовВыпущеннойПродукции();
	ОткрытьФорму("Документ.Лико_БланкЭтапа.Форма.ФормаСозданияРоликовВыпущеннойПродукции",СтруктураПараметров,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРоликиВыпущеннойПродукцииЗавершение (РезультатФормы,ПараметрыФормы) Экспорт //+Лико m.shenderov 14.09.2017
	МассивРоликов= РезультатФормы;
	Если МассивРоликов<>Неопределено Тогда
		Для Каждого РоликМассива Из МассивРоликов Цикл
			НоваяСтрока = Объект.Выпуск.Добавить();
			НоваяСтрока.Серия=ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(РоликМассива,"Серия");
			НоваяСтрока.Характеристика=ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(РоликМассива,"Характеристика");
			НоваяСтрока.Номенклатура=ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(РоликМассива,"Номенклатура");
		КонецЦикла;
	КонецЕсли; 	
КонецПроцедуры //-Лико m.shenderov 14.09.2017


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	
	
	ГруппаПользователя=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ГруппаПользователя");
	
	ТиповыеДокументы.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	УстановитьДоступностьЭлементов();
	Если Параметры.Ключ.Пустая() Тогда 		
		Структура = Новый Структура; 		
		Лико_ОбщегоНазначенияСервер.РеквизитыШапки(Структура); 	
		ЗаполнитьЗначенияСвойств(Объект,Структура);
		Объект.ДатаОкончания=ТекущаяДата();
		Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОперацийЗакрытияБланка.ЗакрытиеБланка");
		
	КонецЕсли; 
	
	
	Если ЦифорвоеРЦСервер(Объект.РабочийЦентр) Тогда
		ВводитьКликиПриЗакрытииЗаказа=Истина;
	КонецЕсли;
	
	УстановитьУсловноеОформление(); 
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);	
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	ПриЧтенииСозданииНаСервере();
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда 		
		//НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий); 		
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 	
	
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка); 
	
	ОпределитьРежимЗакрытия(Отказ);
	ПечататьСтикерыТЧВыпуска=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ПечататьСтикерыТЧВыпуска");
	Если  Объект.Проведен  Тогда
		ЭтотОбъект.ТолькоПросмотр=Истина;

		Если   РольДоступна("АдминистраторСистемы") Или РольДоступна("ПолныеПраваЯССМ_Склад") Тогда 
			ЭтотОбъект.ТолькоПросмотр=Ложь;
		КонецЕсли;
		//ЭтотОбъект.КоманднаяПанель.ПодчиненныеЭлементы.ФормаПровестиДокумент.Доступность=Ложь;
		//ЭтотОбъект.КоманднаяПанель.ПодчиненныеЭлементы.ФормаЗаписатьДокумент.Доступность=Ложь;
		//ЭтотОбъект.КоманднаяПанель.ПодчиненныеЭлементы.ФормаПровестиИЗакрыть.Доступность=Ложь;
		//Иначе
		//ЭтотОбъект.КоманднаяПанель.ПодчиненныеЭлементы.ФормаПровестиДокумент.Доступность=Истина;
		//ЭтотОбъект.КоманднаяПанель.ПодчиненныеЭлементы.ФормаЗаписатьДокумент.Доступность=Истина;
		//ЭтотОбъект.КоманднаяПанель.ПодчиненныеЭлементы.ФормаПровестиИЗакрыть.Доступность=Истина;
	КонецЕсли;
	Если  РольДоступна("АдминистраторСистемы") Или РольДоступна("Лико_РедактированиеКоличестоУУ") Тогда
		Элементы.ТоварыКоличествоРасходУУ.Видимость			=Истина;
		Элементы.ВыпускКоличествоУУ.Видимость				=Истина;
		Элементы.ТоварыКоличествоРасходУУ.ТолькоПросмотр	=Ложь;
		Элементы.ТоварыКоличество.ТолькоПросмотр			=Ложь;
		
		Элементы.ВыпускКоличествоУУ.ТолькоПросмотр			=Ложь;
		Элементы.СтраницаДоплнительно.Видимость				=Истина;
		Элементы.НомерПроката.Доступность					=Истина;
		Элементы.ТоварыНомерРаботы.РедактированиеТекста		=Истина;
		Элементы.ОстаткиПоЗатратам.Видимость				=Истина;
		Элементы.ТоварыНомерРаботыАдм.Видимость				=Истина;
		Элементы.ТоварыСтатусЗаказа.Видимость				=Истина;
	Иначе
		Элементы.ТоварыКоличество.ТолькоПросмотр		=Истина;
		
		Элементы.ТоварыКоличествоРасходУУ.Видимость		=Ложь;
		Элементы.ВыпускКоличествоУУ.Видимость			=Ложь;
		Элементы.ТоварыКоличествоРасходУУ.ТолькоПросмотр=Истина;
		Элементы.ВыпускКоличествоУУ.ТолькоПросмотр		=Истина;
		Элементы.СтраницаДоплнительно.Видимость			=Ложь;
		Элементы.ТоварыНомерРаботы.РедактированиеТекста =Ложь;
		Элементы.НомерПроката.Доступность=Истина;
		Элементы.ОстаткиПоЗатратам.Видимость=Истина;
		Элементы.ТоварыНомерРаботыАдм.Видимость         =Ложь;
		Элементы.ТоварыСтатусЗаказа.Видимость			=Ложь;

	КонецЕсли;
	
	Если Объект.Организация=Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра Тогда
		Элементы.НомерПроката.Доступность=Истина;
		
	КонецЕсли;
	
	Если РольДоступна("ПолныеПрава") Или РольДоступна("Лико_НеВосстанавливатьЭтапЛико_БланкЭтапа") Тогда 
		Элементы.НеВосстанавливатьЭтап.Видимость=Истина;
	КонецЕсли;
	
	Если РольДоступна("Лико_КонтрольИзмененияЗакрытияБланка") И  Не РольДоступна("ПолныеПрава") Тогда 
		ТребуетсяПодписьДокумента=Истина;
	КонецЕсли;

	
		
	
	
	лкЗакрытиеБланкаЗаказаНеНомерБланкаИзВБЗ=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("лкЗакрытиеБланкаЗаказаНеНомерБланкаИзВБЗ",Ложь);
	
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма); 	
	
	//Пока Отказ
	ЗаполнитьВидыРабот();
	ЗаполнитьНомерВидаРабот();
	РаспределяемыеМатериалы();
	ЗаполнитьТаблицуТиповыеДокументы();
	
	
	// Подсистема WebSocket
	ПоказыватьQRCode=Ложь;
	WebSocketСервер.Инициализация(ЭтаФорма,ПоказыватьQRCode);
	// Подсистема WebSocket

	 УчетПравилПеремещенияТМЦ = Справочники.Лико_ПравилаПеремещенияТМЦ.СтартСистемы(Объект.Дата);


КонецПроцедуры


&НаСервере
Процедура ОпределитьРежимЗакрытия(Отказ)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если ГруппаПользователя=Перечисления.Лико_ГруппаПользователя.ЦифровойУчасток Тогда
			РежимЗакрытия = Перечисления.Лико_РежимЗакрытияЗаказа.ОставитьНаРабочемЦентре;
		Иначе
			РежимЗакрытия = Перечисления.Лико_РежимЗакрытияЗаказа.ПереместитьНаСклад;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //ОпределитьРежимЗакрытия


&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Если ГруппаПользователя=Перечисления.Лико_ГруппаПользователя.ЦифровойУчасток Тогда
		Элементы.ТоварыВозвратКоличество.Видимость=Ложь;
	Иначе
		Элементы.ТоварыВозвратКоличество.Видимость=Истина;
	КонецЕсли;
	
	
