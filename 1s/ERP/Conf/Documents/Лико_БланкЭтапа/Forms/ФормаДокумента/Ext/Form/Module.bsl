&НаСервереБезКонтекста
Функция ПолучитьСотрудникаПоФизЛицуСервер(ФизЛицо) //+Лико m.shenderov 04.01.2018
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.ПометкаУдаления = ЛОЖЬ
	|	И НЕ Сотрудники.ВАрхиве
	|	И Сотрудники.ФизическоеЛицо = &ФизЛицо";
	Запрос.УстановитьПараметр("ФизЛицо",ФизЛицо );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла; 
	Возврат Неопределено;
	
КонецФункции  //-Лико m.shenderov 04.01.2018


&НаКлиенте
Процедура ОбработатьНоменклатуру(Результат) //+Лико m.shenderov 08.12.2017
	Если Объект.ВидОперации=ПредопределенноеЗначение("Перечисление.Лико_ВидыОперацийЗакрытияБланка.СборкаРазборка") Тогда
		
		СтруктураНоменклатура = Новый Структура;
		ПолучитьСтруктуруОбъектаНоменклатуры(СтруктураНоменклатура,Результат.ОбъектНоменклатуры);
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Номенклатура",СтруктураНоменклатура.Номенклатура);
		СтруктураПоиска.Вставить("Характеристика",СтруктураНоменклатура.Характеристика);
		СтруктураПоиска.Вставить("Серия",СтруктураНоменклатура.Серия);
		
		НайденныеСтроки=Объект.Товары.НайтиСтроки(СтруктураПоиска);	
		
		Если  НайденныеСтроки.Количество()=0 Тогда
			
			НовыйТовар = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйТовар,СтруктураНоменклатура);
			//Если СтруктураНоменклатура.Уникальный Тогда
			//НовыйТовар.СтатусУказанияСерий=8;		
			
			//КонецЕсли;
			Элементы.Товары.ТекущаяСтрока=НовыйТовар.ПолучитьИдентификатор(); 
			//ТоварыНоменклатураПриИзменении(Неопределено);
			//ТоварыКоличествоУпаковокПриИзменении(Неопределено);
			//ПослеЗаписиНаСервере();
			Если Не ЗначениеЗаполнено(Элементы.Товары.ТекущиеДанные.АдресХранения) Тогда
				
				ОткрытьПодборСерий("Товары");
			КонецЕсли;
		КонецЕсли;
		
		
		
		
	Иначе
		
		
		СтруктураНоменклатуры= СформироватьСтруктуруНоменклатуры();
		ПолучитьСтруктуруНоменклатурыСервер(СтруктураНоменклатуры,Результат.ОбъектНоменклатуры);
		Если ЗначениеЗаполнено(СтруктураНоменклатуры.Номенклатура) Тогда
			СтруктураПоиска = Новый Структура;
			
			СтруктураПоиска.Вставить("Номенклатура",СтруктураНоменклатуры.Номенклатура);
			СтруктураПоиска.Вставить("Характеристика",СтруктураНоменклатуры.Характеристика);
			СтруктураПоиска.Вставить("Серия",СтруктураНоменклатуры.Серия);
			НайденныеСтроки=Объект.Товары.НайтиСтроки(СтруктураПоиска);	
			
			Если НайденныеСтроки.Количество()>0  Тогда
				Возврат;		
			КонецЕсли;
			РЦ=Неопределено;
			НайтиНаСкладе(РЦ,СтруктураНоменклатуры);
			Если РЦ=Неопределено Тогда
				
				ОчиститьСообщения(); 	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не найден материал!'"), ,
				"Объект.КоличествоКликов");  
				
				
			Иначе
				НоваяСтрока=Объект.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтруктураНоменклатуры);
				НоваяСтрока.РабочийЦентр=РЦ;
				Элементы.Товары.ТекущаяСтрока=НоваяСтрока.ПолучитьИдентификатор();
				Если ИспользоватьАлгоритмПоФакту Тогда
					РасчитатьДлинуРолика("ПриСканировании");
				Иначе
					ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаКоличестваНоменклатуры", ЭтаФорма);
					ПоказатьВводЧисла(ОписаниеОповещения,,"Введите количество:",15,3); 			
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //-Лико m.shenderov 08.12.2017

&НаСервереБезКонтекста
Процедура ПолучитьСтруктуруОбъектаНоменклатуры(Структура,ОбъектНоменклатуры) //+Лико m.shenderov 14.01.2018
	
	Структура.Вставить("Номенклатура"	,	ОбъектНоменклатуры.Номенклатура);
	Структура.Вставить("Характеристика" ,	ОбъектНоменклатуры.Характеристика);
	Структура.Вставить("Упаковка"       ,   ОбъектНоменклатуры.БазоваяЕдиницаИзмерения);
	Структура.Вставить("Количество",        ОбъектНоменклатуры.Количество);
	Структура.Вставить("КоличествоУУ"     ,	ОбъектНоменклатуры.Количество*ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель);
	Структура.Вставить("КоличествоРасход",        ОбъектНоменклатуры.Количество);
	Структура.Вставить("КоличествоРасходУУ"     ,	ОбъектНоменклатуры.Количество*ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель);
	
	
	Структура.Вставить("Серия"          ,	ОбъектНоменклатуры.Серия);
	Структура.Вставить("Уникальный"     ,   ОбъектНоменклатуры.Уникальный);
	
	АдресХранения=Неопределено;
	
	
	
	Если ОбъектНоменклатуры.Уникальный И ЗначениеЗаполнено(ОбъектНоменклатуры.Серия) Тогда
		
		АдресХранения=Лико_ОбщегоНазначенияСервер.ПолучитьАдресХраненияПоСерии(ОбъектНоменклатуры.Серия);
	КонецЕсли;
	Структура.Вставить("АдресХранения" ,АдресХранения);
	
	
	
