&НаСервере
Процедура ЗагрузитьПоРабочемуЦентруНаСервере()
	
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка)  Тогда
		Объект.Товары.Очистить(); 		
	КонецЕсли; 	
	
	ТоварыВДокументе = Объект.Товары.Выгрузить();
	ТоварыВОстатках = Лико_Склады.ОстаткиПоСкладу(Объект.РабочийЦентр,Неопределено).Выгрузить();
	
	
	ТоварыОбщее = ТоварыВДокументе.СкопироватьКолонки();
	
	Для Каждого СтрокаТоварыВДокументе Из ТоварыВДокументе Цикл
		НоваяСтрока = ТоварыОбщее.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТоварыВДокументе, , "Количество,КоличествоУУ");
	КонецЦикла;
	Для Каждого СтрокаТоварыВОстатках Из ТоварыВОстатках Цикл
		НоваяСтрока = ТоварыОбщее.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТоварыВОстатках);
	КонецЦикла;
	
	ТоварыОбщее.Свернуть("Номенклатура,Характеристика,Серия,РабочийЦентр","Списать, Количество, КоличествоУУ, ВозвратКоличество, ВозвратКоличествоУУ, ГотоваяПродукцияКоличество, ГотоваяПродукцияКоличествоУУ");
	
	Объект.Товары.Загрузить(ТоварыОбщее);
	Объект.Товары.Сортировать("Серия Возр");
	
	//+ Лико m.shenderov 09.04.2018
	//+m.shenderov 22.12.2016
	Если ЗначениеЗаполнено(Объект.ЗаказПокупателя) Тогда
		ТзНоменклатура=Объект.Товары.Выгрузить(,"Серия");
		НоменклатураКСписанию=ПолучитьНоменклатуруКСписаниюНаЗаказ(ТзНоменклатура,(Объект.ЗаказПокупателя));
		Для каждого Ном  Из НоменклатураКСписанию Цикл
			Структура = Новый Структура;
			Структура.Вставить("Серия",Ном.Серия);
			//СтрНом=Объект.Товары.НайтиСтроки(Ном.Серия,"Серия");
			НайденныеСтроки=Объект.Товары.НайтиСтроки(Структура);
			Для каждого СтрНом Из НайденныеСтроки Цикл
				СтрНом.Списать=Истина;
				Если СтрНом.КоличествоРасход=0 И СтрНом.ВозвратКоличество=0 Тогда
					СтрНом.КоличествоРасход=СтрНом.Количество;
					РасчетКоличестваТаблицыТоварыСервер(СтрНом);
				КонецЕсли;
				
				
			КонецЦикла;
			
			//		Если СтрНом<>Неопределено Тогда 
			//			СтрНом.Списать=Истина;
			//		КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	//- Лико m.shenderov 09.04.2018
	
	
	
	//Объект.Товары.Загрузить(Лико_Склады.ОстаткиПоСкладу(Объект.СкладОтправитель).Выгрузить());
КонецПроцедуры

&НаСервере
Функция  	ПолучитьНоменклатуруКСписаниюНаЗаказ(ТзНоменклатура,НомерЗаказа)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЯССМ_ТоварыНаРабочихЦентрах.Серия
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках КАК ЯССМ_ТоварыНаРабочихЦентрах
	|ГДЕ
	|	ЯССМ_ТоварыНаРабочихЦентрах.Серия В(&Серии)
	|	И ЯССМ_ТоварыНаРабочихЦентрах.Регистратор.ЗаказКлиента = &НомерЗаказа
	|	И ЯССМ_ТоварыНаРабочихЦентрах.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И (ЯССМ_ТоварыНаРабочихЦентрах.Номенклатура.ВидНоменклатуры=&ГруппаКраска
	|			ИЛИ ЯССМ_ТоварыНаРабочихЦентрах.Номенклатура.ВидНоменклатуры=&ГруппаХимия)";
	Запрос.УстановитьПараметр("Серии",ТзНоменклатура );
	Запрос.УстановитьПараметр("НомерЗаказа",НомерЗаказа );
	Запрос.УстановитьПараметр("ГруппаКраска",Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Краска"));
	Запрос.УстановитьПараметр("ГруппаХимия",Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Краска"));
	
	
	Возврат  Запрос.Выполнить().Выгрузить();
	
	
	
КонецФункции



