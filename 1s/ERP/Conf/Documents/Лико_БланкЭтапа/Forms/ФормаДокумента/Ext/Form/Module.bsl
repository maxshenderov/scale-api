&НаКлиенте
Процедура ПолучитьНомерПроката() //+Лико m.shenderov 21.11.2017
	Объект.НомерПроката=0;
	МассивНомеровПроката=Лико_ОбщегоНазначенияСервер.ПолучитьНомерПроката(Объект.ЗаказПокупателя,Объект.РабочийЦентр);

	Если МассивНомеровПроката.Количество()=1 Тогда
		Объект.НомерПроката=МассивНомеровПроката[0];
	ИначеЕсли  МассивНомеровПроката.Количество()>1 Тогда
		ОписаниеОповещение= Новый ОписаниеОповещения("ПолучитьНомерПрокатаЗавершение",ЭтаФорма);
		СЗ = Новый СписокЗначений;
		Сз.ЗагрузитьЗначения(МассивНомеровПроката);
		Структура = Новый Структура;
		Структура.Вставить("Прокаты",МассивНомеровПроката);
		ОткрытьФорму("Документ.Лико_БланкЭтапа.Форма.ФормаВыбораПроката",Структура,,,,,ОписаниеОповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	КонецЕсли;


	//Объект.НомерПроката=Лико_ОбщегоНазначенияСервер.ПолучитьНомерПроката(Объект.ЗаказПокупателя,Объект.РабочийЦентр);
	Если Не ЗначениеЗаполнено(Объект.НомерБланка) и ЗначениеЗаполнено(Объект.ЗаказПокупателя) Тогда
		Объект.НомерБланка= ПолучитьНомерБланкаСервер(Объект.ЗаказПокупателя);
	КонецЕсли;

КонецПроцедуры //-Лико m.shenderov 21.11.2017

