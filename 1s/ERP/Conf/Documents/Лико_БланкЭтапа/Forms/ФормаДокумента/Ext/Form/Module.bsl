			Сообщение.Поле = "Объект.Товары["+НомерСтроки+"].ВозвратКоличество"; //имя реквизита 
			Сообщение.УстановитьДанные(Объект); //Ссылка на объект ИБ
			Сообщение.Сообщить();
			ОтменаРедактирования=Истина;
			Возврат;			
		КонецЕсли;
	КонецЕсли; 
	ТоварыПриОкончанииРедактированияНаСервере();
