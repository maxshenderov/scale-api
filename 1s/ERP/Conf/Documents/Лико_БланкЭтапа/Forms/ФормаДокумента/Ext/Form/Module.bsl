&НаКлиенте 
Процедура Лико_ПодборСерийЗавершение(РезультатФорма,ПараметрыФорма) Экспорт 
	
	Если ТипЗнч(РезультатФорма)=Тип("Массив") Тогда
		
		Для каждого ОбъектНоменклатуры Из РезультатФорма  Цикл
			
			СтруктураНоменклатуры=ПолучитьСтруктуруОбъектНоменклатуры(ОбъектНоменклатуры);
			
			СтруктураОтбора=Новый Структура;
			СтруктураОтбора.Вставить("Номенклатура",СтруктураНоменклатуры.Номенклатура);
			СтруктураОтбора.Вставить("Характеристика",СтруктураНоменклатуры.Характеристика);
			СтруктураОтбора.Вставить("Серия",ПредопределенноеЗначение("Справочник.СерииНоменклатуры.ПустаяСсылка"));
			
			СтрокиСПустымиСериями=Объект.Выпуск.НайтиСтроки(СтруктураОтбора);
			Для каждого СтрокаСПустйСерией Из СтрокиСПустымиСериями Цикл				
				Объект.Выпуск.Удалить(Объект.Товары.Индекс(СтрокаСПустйСерией));				
			КонецЦикла;
			//Если Объект.Выпуск.НайтиСтроки(СтруктураНоменклатуры).Количество()=0 Тогда
			НовыйТовар=Объект.Выпуск.Добавить(); 				 
			
			ЗаполнитьЗначенияСвойств(НовыйТовар,СтруктураНоменклатуры);
			//НовыйТовар.ХарактеристикиИспользуются=ЗначениеЗаполнено(НовыйТовар.Характеристика);
			//НовыйТовар.СтатусУказанияСерий=?(ЗначениеЗаполнено(НовыйТовар.Серия),8,0);
			//НовыйТовар.ТипНоменклатуры=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(НовыйТовар.Номенклатура,"ТипНоменклатуры");      
			
			
			
			//КонецЕсли;
			
			
		КонецЦикла;
		
		
		
		
		
		
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруОбъектНоменклатуры(Ссылка) //+Лико m.shenderov 24.10.2017
	Структура = Новый Структура;
	Структура.Вставить("Номенклатура",Неопределено);
	Структура.Вставить("Характеристика",Неопределено);
	Структура.Вставить("Количество",Неопределено);
	Структура.Вставить("Серия",Неопределено);
	Структура.Вставить("Упаковка",Неопределено);
	Структура.Вставить("КоличествоУУ",Неопределено); 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЯССМ_ОбъектыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ЯССМ_ОбъектыНоменклатуры.Серия КАК Серия,
	|	ЯССМ_ОбъектыНоменклатуры.Характеристика КАК Характеристика,
	|	ЯССМ_ОбъектыНоменклатуры.БазоваяЕдиницаИзмерения КАК Упаковка,
	|	ЯССМ_ОбъектыНоменклатуры.Количество КАК Количество,
	|	ЯССМ_ОбъектыНоменклатуры.Количество * ЯССМ_ОбъектыНоменклатуры.БазоваяЕдиницаИзмерения.Числитель КАК КоличествоУУ
	|ИЗ
	|	Справочник.ЯССМ_ОбъектыНоменклатуры КАК ЯССМ_ОбъектыНоменклатуры
	|ГДЕ
	|	ЯССМ_ОбъектыНоменклатуры.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Ссылка );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Структура,Выборка);
	КонецЦикла; 
	Возврат Структура;
	
КонецФункции  //-Лико m.shenderov 24.10.2017

