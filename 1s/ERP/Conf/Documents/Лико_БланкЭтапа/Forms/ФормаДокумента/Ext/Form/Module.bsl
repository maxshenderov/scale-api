&НаСервере
Функция ПроверитьЗаполнениеПараметровТУ() // <-- Начало Лико Яцун С. В. 25.06.2024
	
	РезультатПроверкиЗаполненияТУ = "";
	
	Если ЗначениеЗаполнено(Объект.РабочийЦентр)
		И Объект.РабочийЦентр.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.СклейкаТермоусадки
		И ЗначениеЗаполнено(Объект.ЗаказПокупателя)
		// --> Начало Лико Ефимов ЕВВ 10.07.2024
		И Объект.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра
		// <-- Конец Лико Ефимов ЕВВ 10.07.2024
		Тогда
		НайденныеСтрокиПараметрыСклейки = Объект.ЗаказПокупателя.ПараметрыСклейки.НайтиСтроки(Новый Структура("РабочийЦентр",Объект.РабочийЦентр));
		НайденныеСтрокиПараметрыПродувки = Объект.ЗаказПокупателя.ПараметрыПродувки.Количество();
		Если НайденныеСтрокиПараметрыСклейки.Количество() = 0 Тогда
			РезультатПроверкиЗаполненияТУ = "Для заказа " + Объект.ЗаказПокупателя.НомерБезПрефикса + " не заполнены параметры склейки ТУ по указанному рабочему центру " + Объект.РабочийЦентр;
		КонецЕсли;
		Если НайденныеСтрокиПараметрыПродувки = 0 Тогда
			РезультатПроверкиЗаполненияТУ = ?(ЗначениеЗаполнено(РезультатПроверкиЗаполненияТУ),
			"Для заказа " + Объект.ЗаказПокупателя.НомерБезПрефикса + " не заполнены параметры склейки ТУ по указанному рабочему центру " + Объект.РабочийЦентр + ". Не заполнены параметры продувки ТУ",
			"Для заказа " + Объект.ЗаказПокупателя.НомерБезПрефикса + " не заполнены параметры продувки ТУ");
		КонецЕсли; 
	КонецЕсли;
	
	Возврат РезультатПроверкиЗаполненияТУ;
		
КонецФункции // <-- Конец Лико Яцун С. В. 25.06.2024

