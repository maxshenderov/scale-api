&НаКлиенте
Процедура ОбработатьШтрихкоды(ДанныеШтрихкода)
	
	
	
	
	Результат = Лико_ДополнительноКлиент.ОбработатьШтрихКодНеТовара(ДанныеШтрихкода.Штрихкод);
	Если Результат.Ошибка <> "" Тогда
		
		МенеджерыОбъектов = Новый Массив();
		
		МенеджерыОбъектов.Добавить(ПредопределенноеЗначение("Документ.Лико_ЗаказНаРаскрой.ПустаяСсылка"));       
		
		
		МассивСсылок = ПолучитьМассивСсылокСервер(ДанныеШтрихкода.Штрихкод, МенеджерыОбъектов);
		
		
		
		
		Если МассивСсылок.Количество() > 0 Тогда
			Объект.ЗаказНаРаскрой = МассивСсылок[0]; 				
		Иначе 	
			
			Сообщить(Результат.Ошибка);
		КонецЕсли;
		
		
	Иначе
		Если Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Сотрудника") Тогда
			//Это физ. лицо
			//Объект.Сотрудник = Результат.Сотрудник;
			Объект.Сотрудник = ПолучитьСотрудникаПоФизЛицуСервер(Результат.Сотрудник);
			
			//Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаДоплнительно;
		ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры_Короткий") Или 
			Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры") Тогда
			ОбработатьНоменклатуру(Результат);
		ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ЗаказаСпецификации") Тогда
			Объект.ЗаказПокупателя=ПолучитьЗаказКлиентаПоНомеру(Результат.НомерЗаказа);
			ОчиститьВидыРабот();
			ЗаполнитьВидыРабот();
			Если Не лкЗакрытиеБланкаЗаказаНеНомерБланкаИзВБЗ ТОгда	
				Объект.НомерБланка=Результат.НомерБланка;
			КонецЕсли;
			
			ПолучитьНомерПроката();
			Попытка
				
				
				//ОписаниеОшибки()
				
				Объект.НомерЗаказа=Число(Прав(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Объект.ЗаказПокупателя,"Номер"),7));
				
			Исключение
			КонецПопытки;
			
			
		ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_РабочегоЦентра") Тогда
			Объект.РабочийЦентр=Результат.РабочийЦентр;
			ОчиститьВидыРабот();
			ЗаполнитьВидыРабот();
			ПолучитьНомерПроката(); 			
			ВводКликов();
			РаспределяемыеМатериалы();
			УстановитьПодразделение();
			
			
			
		ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Заказа") Тогда
			Объект.ЗаказПокупателя=ПолучитьЗаказКлиентаПоНомеру(Результат.НомерЗаказа);
			Если Не лкЗакрытиеБланкаЗаказаНеНомерБланкаИзВБЗ ТОгда	
				
				Объект.НомерБланка=Результат.НомерБланка; 
			КонецЕсли;
			
			ПолучитьНомерПроката();  			
			Попытка				
				//ОписаниеОшибки()				
				Объект.НомерЗаказа=Число(Прав(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Объект.ЗаказПокупателя,"Номер"),7));
				
			Исключение
			КонецПопытки;
			
		ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Адреса")
			ИЛИ Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Адреса_Короткий") Тогда
			//Это ячейка
			Объект.ЯчейкаПолучатель = Результат.АдресаХранения;
			ЯчейкаПолучательПриИзмененииНаСервере();
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаДоплнительно;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
