&НаКлиенте
Процедура РасчитатьДлинуРолика(Команда)
	ТекущиеДанные= Элементы.Товары.ТекущиеДанные;
	
	//ТекущаяСтрока= Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	Структура = Новый Структура;
	Структура.Вставить("Номенклатура",ТекущиеДанные.Номенклатура);
	Структура.Вставить("НачальныйДиаметр",РазмерНаружногоДиаметра(ТекущиеДанные.Серия));
	
	ОписаниеОповещения= Новый ОписаниеОповещения("РассчитатьДлинуРоликаЗавершение",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.Лико_РасчетДлиныРолика",Структура,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьДлинуРоликаЗавершение(РезультатФормы,ПараметрыФормы) Экспорт//+Лико m.shenderov 12.09.2017
	ТекущаяСтрока= Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	
	Если РезультатФормы<>Неопределено Тогда
		Если ТипЗнч(РезультатФормы)=Тип("Структура") Тогда
			
			Если ГруппаПользователя=ПредопределенноеЗначение("Перечисление.Лико_ГруппаПользователя.ЦифровойУчасток") Тогда
				ТекущаяСтрока.КоличествоРасход = РезультатФормы.ДлинаРолика;
				ТекущаяСтрока.КоличествоРасходУУ= Лико_ОбщегоНазначенияСервер.КоличествоПоСерии(ТекущаяСтрока.Серия,текущаяСтрока.Количество);
				ТекущаяСтрока.Списать = Истина;
				РасчетКоличестваТаблицыТовары();
			Иначе
				
				ТекущаяСтрока.ВозвратКоличество = РезультатФормы.ДлинаРолика;
				ТекущаяСтрока.ВозвратКоличествоУУ= Лико_ОбщегоНазначенияСервер.КоличествоПоСерии(ТекущаяСтрока.Серия,текущаяСтрока.ВозвратКоличество);
				
				Если ТекущаяСтрока.ВозвратКоличество<>0 Тогда
					ТекущаяСтрока.Списать = Истина;
				КонецЕсли;
				РасчетКоличестваТаблицыТовары(Истина);
				
			КонецЕсли;
		КонецЕсли;
		
		
	КонецЕсли;
	
	
КонецПроцедуры //-Лико m.shenderov 12.09.2017



&НаСервереБезКонтекста
Функция РазмерНаружногоДиаметра(Серия) //+Лико m.shenderov 12.09.2017
	РазмерНаружногоДиаметра=0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СерииНоменклатуры.ЯССМ_ОбъектНоменклатуры.Втулка.РазмерНаружногоДиаметра КАК Размер
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|ГДЕ
	|	СерииНоменклатуры.Ссылка = &Серия";
	Запрос.УстановитьПараметр("Серия",Серия );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		РазмерНаружногоДиаметра=Выборка.Размер;
	КонецЦикла; 
	Возврат РазмерНаружногоДиаметра;
	
КонецФункции //РазмерНаружногоДиаметра -Лико m.shenderov 12.09.2017


