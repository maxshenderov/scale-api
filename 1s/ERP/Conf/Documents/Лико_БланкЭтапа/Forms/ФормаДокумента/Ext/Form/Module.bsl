&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// <-- Начало Лико Яцун С. В. 25.06.2024
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		РезультатПроверкиЗаполненияТУ = ПроверитьЗаполнениеПараметровТУ();
		Если ЗначениеЗаполнено(РезультатПроверкиЗаполненияТУ) Тогда
			Сообщить(РезультатПроверкиЗаполненияТУ);
			Отказ = Истина;
			Возврат; 
		КонецЕсли;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 25.06.2024
	
	//Если Объект.Проведен  Тогда
		//	Отказ=Истина;
		//Лико_ДополнительноКлиент.СообщитьДляКлиента("Для записи документа необходимо сделать отмену проведения!");
		
		
		
				
	//КонецЕсли; 
	
	
	Если  УчетПравилПеремещенияТМЦ Тогда
		
		Если ПараметрыЗаписи.РежимЗаписи=РежимЗаписиДокумента.Проведение  
			И Не ПараметрыЗаписи.Свойство("ПроверкаПравилПеремещенияТМЦПередЗаписью") Тогда
			
			
			Ответ = ПроверитьПеремещенияТМЦСервер(Отказ,ПараметрыЗаписи.РежимЗаписи, УчетПравилПеремещенияТМЦ);
			
			Если ТипЗнч(Ответ)=Тип("Массив") И  Ответ.Количество()>0 Тогда
				
				Текст ="";
				Для каждого Комментарий Из Ответ Цикл
					Текст = Текст+?(ЗначениеЗаполнено(Текст),"|"+Комментарий,Комментарий);
					Сообщить(Комментарий);
					
				КонецЦикла;
				
				Если ЗначениеЗаполнено(Текст) Тогда
					
					Текст=Текст+"
					| Продолжить?";
					
					Режим = РежимДиалогаВопрос.ДаНет;
					Оповещение = Новый ОписаниеОповещения("ПроверкаПравилПеремещенияТМЦПередЗаписью", ЭтотОбъект, Новый Структура("Отказ,ПроверкаПравилПеремещенияТМЦПередЗаписью",Отказ,Ложь));
					ПоказатьВопрос(Оповещение, Текст, Режим, 0); 
					Отказ=Истина;
					Возврат;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;

	
	// Вставить содержимое обработчика.
КонецПроцедуры 

&НаСервере
Функция ПроверитьПеремещенияТМЦСервер(Отказ,РежимЗаписи, УчетПравилПеремещенияТМЦ)  //+Лико m.shenderov 16.02.2026

	Ответ = "";		
	Если УчетПравилПеремещенияТМЦ Тогда
		
		Результат  = Неопределено; 
		Если 	РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			
			Справочники.Лико_ПравилаПеремещенияТМЦ.ВыполнитьПроверку(Объект,Отказ,Результат);
			
		КонецЕсли;
		
		
		Если ТипЗнч(Результат)=Тип("Структура") И Результат.Свойство("ПроверкаПравил") Тогда
			
			Если ТипЗнч(Результат.ПроверкаПравил)=Тип("ТаблицаЗначений") Тогда
				
				Ответ=Результат.ПроверкаПравил.ВыгрузитьКолонку("Комментарий");	
				
			КонецЕсли;
			
		КонецЕсли;
		
		
	КонецЕсли;
		
  Возврат Ответ;
	
КонецФункции  //-Лико m.shenderov 16.02.2026


