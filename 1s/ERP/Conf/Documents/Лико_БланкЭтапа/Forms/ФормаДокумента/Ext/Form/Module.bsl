&НаСервереБезКонтекста
Функция ПолучитьНомерБланкаСервер(ЗаказКлиента) //+Лико m.shenderov 18.12.2017
	Если Не Справочники.Лико_РабочиеМеста.ПолучитьСвойство("АвтоНумерацияБланковВЗакрытии",Ложь) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Лико_БланкЭтапа.НомерБланка), 0) КАК НомерБланка
	|ИЗ
	|	Документ.Лико_БланкЭтапа КАК Лико_БланкЭтапа
	|ГДЕ
	|	Лико_БланкЭтапа.ЗаказПокупателя = &ЗаказКлиента
	|	И Лико_БланкЭтапа.Проведен
	|	И НЕ Лико_БланкЭтапа.ПометкаУдаления";
	Запрос.УстановитьПараметр("ЗаказКлиента",ЗаказКлиента );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.НомерБланка+1;
	КонецЦикла; 
	
	Возврат 1;	
КонецФункции  //-Лико m.shenderov 18.12.2017



&НаКлиенте
Процедура ВводКликов() //+Лико m.shenderov 08.12.2017
	Если  ЗначениеЗаполнено(Объект.РабочийЦентр) Тогда
		ИспользоватьАлгоритмПоФакту=ИспользоватьАлгоритмПоФактуСервер(Объект.РабочийЦентр);	
		
		
		
		Если ЦифорвоеРЦСервер(Объект.РабочийЦентр) Тогда
			ВводитьКликиПриЗакрытииЗаказа=Истина;
			КликИндиго=ПолучитьКликИндигоСервер();
			Объект.КоличествоКликов=0;
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаКоличества", ЭтаФорма);
			ПоказатьВводЧисла(ОписаниеОповещения,,"Введите количество кликов:",15,3); 		
			
		КонецЕсли;
		
		
	Иначе
		ИспользоватьАлгоритмПоФакту=Ложь;
		ВводитьКликиПриЗакрытииЗаказа=Ложь;
		
		
	КонецЕсли;
	
	
КонецПроцедуры //-Лико m.shenderov 08.12.2017

&НаКлиенте
Процедура ПослеВводаКоличества(Число, Параметры) Экспорт
	Если НЕ Число = Неопределено Тогда
		КликИндиго=ПолучитьКликИндигоСервер();
		
		НайденаяСтроки = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура",КликИндиго));
		Если   НайденаяСтроки.Количество()>0 Тогда
			НовыйТовар=НайденаяСтроки[0];
		Иначе
			НовыйТовар					=Объект.Товары.Добавить();
		КонецЕсли;
		
		
		НовыйТовар.Номенклатура	=КликИндиго;
		НовыйТовар.КоличествоРасход			=Число;
		НовыйТовар.КоличествоРасходУУ		=Число;
		НовыйТовар.Списать					=Истина;
		УстановитьВидимостьКликов();
		
		
		
	КонецЕсли;
КонецПроцедуры


