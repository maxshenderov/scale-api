&НаКлиенте
Процедура ПечатьПослеПроведения()  //+Лико m.shenderov 19.10.2017
	
	Если ПечататьБиркиПриЗакрытииБланка() Тогда
		Если Объект.РежимЗакрытия=ПредопределенноеЗначение("Перечисление.Лико_РежимЗакрытияЗаказа.ПереместитьНаСклад") Или ИспользоватьАлгоритмПоФакту Тогда
			
			ПечатьИзмененныхОбъектовНоменклатуры() ;
		КонецЕсли;
	КонецЕсли;
	
	Если ПечататьСтикерыТЧВыпуска Тогда
		ПечатьВыпущеннойПродукции();
		Если ЦифорвоеРЦСервер(Объект.РабочийЦентр) Тогда
			ПечатьВыпущеннойПродукции(); 				 
		КонецЕсли;
		
		
		ПечатьСтикераДокумента();
	КонецЕсли;
	
	
КонецПроцедуры //-Лико m.shenderov 19.10.2017

