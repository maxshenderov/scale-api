&НаКлиенте
Процедура КоличествоКликовПриИзменении(Элемент)
	Если значениеЗаполнено(Объект.РабочийЦентр) Тогда 
		Если ЗначениеЗаполнено(Объект.КоличествоКликов) Тогда 
			Раппорт=РабочийЦентрРаппортСервер(Объект.РабочийЦентр);
			Если Раппорт =0.98 Тогда
				Если Объект.КоличествоКликов/2 > Цел(Объект.КоличествоКликов/2) Тогда
					
					ОчиститьСообщения(); 	
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Проверьте количество кликов для раппорта 0.98. Должно быть четное число'"), ,
					"Объект.КоличествоКликов");  
					Объект.КоличествоКликов = 0;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

