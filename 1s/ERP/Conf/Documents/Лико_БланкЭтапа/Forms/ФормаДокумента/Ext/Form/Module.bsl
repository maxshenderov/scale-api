&НаКлиенте
Процедура ВведенКодПодтвержденияДляПодтвержденияПропускаОтвЛица(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Результат) Тогда
		//ИнформационныеСообщения = "Не введен код подтверждения из смс";
		//ОбновилосьИнформационноеСообщение = Истина;
		//ПомигатьСообщением();
		Возврат;
	КонецЕсли;
	
	ВведенныйКод = Формат(Результат, "ЧЦ=4; ЧВН=; ЧГ=0");
	
	ТекущаяДата = ТекущаяДатаСеансаСервер();
	
	// на всякий случай будем генерить код на сегодня
	КодНаСегодня = Прав(Формат(День(ТекущаяДата) * Месяц(ТекущаяДата) * Год(ТекущаяДата) - День(ТекущаяДата) - Месяц(ТекущаяДата) - Год(ТекущаяДата), "ЧЦ=10; ЧВН=; ЧГ=0"), 4);
	
	Если ВведенныйКод <> ДопПараметры.КодПодтверждения И ВведенныйКод <> КодНаСегодня Тогда
		//ИнформационныеСообщения = "Код подтверждения не совпал: вы ввели " + ВведенныйКод + ", был отправлен " + ДопПараметры.КодПодтверждения;
		//ОбновилосьИнформационноеСообщение = Истина;
		//ПомигатьСообщением();
		Возврат;
	КонецЕсли;
	
	// Если дошло до сюда, значит все проверки пройдены, вызовем нужную процедуру, имя которой сохранено в ДопПараметры
	Выполнить("" + ДопПараметры.ИмяПроцедурыПриУспешномПодтверждении);
	
КонецПроцедуры 

