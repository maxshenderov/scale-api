Функция СтруктураДанныхДляЗаполненияРаспоряжения() 
	Структура = Новый Структура; 	
	
	Структура.Вставить("Распоряжение",Распоряжение);
	Структура.Вставить("Дата",Дата);
	Структура.Вставить("Организация",Организация);
	Структура.Вставить("Подразделение",Подразделение);
