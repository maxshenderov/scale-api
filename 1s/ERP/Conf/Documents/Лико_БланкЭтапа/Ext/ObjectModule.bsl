Функция ПолучитьСтруктуруЦенДляГравировальногоУчастка() //+Лико m.shenderov 10.08.2021
	УстановитьПривилегированныйРежим(Истина);
	Структура = Новый Структура;
	Структура.Вставить("ЦенаЛатуни",0);
	Структура.Вставить("ЦенаРасходных",0);
	Структура.Вставить("ЦенаНЧ",0);
	Структура.Вставить("ЦенаКонтрматрица",0);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦенаЛатуни.Цена КАК ЦенаЛатуни,
	|	ЦенаНЧ.Цена КАК ЦенаНЧ,
	|	ЦенаКонтрматрица.Цена КАК ЦенаКонтрматрица,
	|	ЦенаРасходных.Цена КАК ЦенаРасходных
	|ИЗ
	|	РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(&КонецПериода, ЦеноваяГруппа = ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.Латунь)) КАК ЦенаЛатуни,
	|	РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(&КонецПериода, ЦеноваяГруппа = ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.Контрматрица)) КАК ЦенаКонтрматрица,
	|	РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(&КонецПериода, ЦеноваяГруппа = ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.РасходныеМатериалыГравировальногоУчастка)) КАК ЦенаРасходных,
	|	РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(&КонецПериода, ЦеноваяГруппа = ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.НЧГравировальногоУчастка)) КАК ЦенаНЧ";
	Запрос.УстановитьПараметр("КонецПериода",Дата );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
	     ЗаполнитьЗначенияСвойств(Структура,Выборка);
	КонецЦикла; 
	
	
	Возврат Структура;
	
