  Процедура ВыполнитьПродажуМатериалов(Тз, лКонтрагент)  
	  
	  ПроверитьОрганизациюСерий(Тз); 
	  
	  	ИмяНакладной                               ="ПередачаСырьяПереработчику";
	ДокументСсылка                          =Лико_ОбщегоНазначенияСервер.НайтиДокумент(ИмяНакладной,"Лико_Документ",Ссылка);

	  
	  ДокОбъект = Документы.Лико_ПередачаТоваров.СоздатьДокумент();
	  СтруктураДокумента = Новый Структура;
	  ДокОбъект.Заполнить(СтруктураДокумента);
	  ДокОбъект.АвторДокумента=АвторДокумента;
	  
	  ДокОбъект.Сотрудник = ДокОбъект.АвторДокумента;
	  ДокОбъект.ВидОперации = Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.Продажа;
	  ДокОбъект.БезПеремещения = Истина;
	  
	  ДокОбъект.Товары.Загрузить(Тз.Выгрузить());
	  ДокОбъект.ЦеныНоменклатуры.Загрузить(ПолучитьЦеныПоНоменклатуре(Тз));
	  ДокОбъект.ЦенаВключаетНДС = Истина;
	  ДокОбъект.ОтражатьВБухгалтерскомУчете = Истина;
	  ДокОбъект.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	  
	  
	  Попытка
		  ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	  Исключение
		  Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + ДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки()); 
	  КонецПопытки;   
	  
  КонецПроцедуры
  
  Процедура  ПроверитьОрганизациюСерий(знач Тз);
	  
	  Тз.Свернуть("Организация");
	  Если Тз.Количество()>1 Тогда
		  ВызватьИсключение("Нельзя оформить продажу по разным организациям!"); 
	  КонецЕсли;
	  
  КонецПроцедуры 
  
  Функция ПолучитьЦеныПоНоменклатуре(Тз) //+Лико m.shenderov 11.09.2024
	  
	  Запрос = Новый Запрос;
	  Запрос.Текст = 
	  "ВЫБРАТЬ
	  |	ТЗ.Номенклатура КАК Номенклатура,
	  |	СУММА(ТЗ.Количество) КАК Количество
	  |ПОМЕСТИТЬ ВтНоменклатура
	  |ИЗ
	  |	&ТЗ КАК ТЗ
	  |
	  |СГРУППИРОВАТЬ ПО
	  |	ТЗ.Номенклатура
	  |;
	  |
	  |////////////////////////////////////////////////////////////////////////////////
	  |ВЫБРАТЬ
	  |	ВтНоменклатура.Номенклатура КАК Номенклатура,
	  |	ВтНоменклатура.Количество КАК Количество,
	  |	1 КАК Цена,
	  |	ВтНоменклатура.Количество КАК Сумма
	  |ИЗ
	  |	ВтНоменклатура КАК ВтНоменклатура";
	  Запрос.УстановитьПараметр("ТЗ",Тз );
	  Возврат Запрос.Выполнить().Выгрузить();;
	  
	  
	  
	  
  КонецФункции //-Лико m.shenderov 11.09.2024 
  
  
  
