Функция ПроверитьВозможностьПроведенияДокумента(Документ, Объекты, РежимЗаписи, РежимПроведения, Расшифровка="") Экспорт
	
	Успех = Истина;
	
	Если РежимЗаписи<>РежимЗаписиДокумента.Проведение и РежимЗаписи<>РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат Успех;
	КонецЕсли;
	
	Если РежимПроведения=РежимПроведенияДокумента.Оперативный Тогда
		Возврат Успех;
	КонецЕсли;
	
	ПроверкаДатыЗапретаРедактированияДокументов(Документ, Объекты, РежимЗаписи, РежимПроведения, Успех, Расшифровка);
	
	ПроверкаБолееПозднихПроведенныхДокументов(Документ, Объекты, РежимЗаписи, РежимПроведения, Успех, Расшифровка);
	
	//ПроверкаУникальностиЗакрытияЗаказа(Документ, Объекты, РежимЗаписи, РежимПроведения, Успех, Расшифровка);
	
	Возврат Успех;
	
КонецФункции //ПроверитьВозможностьПроведенияДокумента Экспорт



Процедура ПроверкаБолееПозднихПроведенныхДокументов(Документ, Объекты, РежимЗаписи, РежимПроведения, Успех, Расшифровка)
	
	ЗапросДокументов = Новый Запрос;
	
	ЗапросДокументов.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЯССМ_ТоварыНаСкладахПоЯчейкамОбороты.Регистратор КАК Документ,
	|	ЯССМ_ТоварыНаСкладахПоЯчейкамОбороты.Регистратор.МоментВремени КАК РегистраторМоментВремени
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Обороты(&ДатаДокумента, , Регистратор, Серия В (&Объекты)) КАК ЯССМ_ТоварыНаСкладахПоЯчейкамОбороты
	|ГДЕ
	|	ЯССМ_ТоварыНаСкладахПоЯчейкамОбороты.Регистратор <> &ЭтотДокументСсылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЯССМ_ТоварыНаСкладахПоЯчейкамОбороты.Регистратор,
	|	ЯССМ_ТоварыНаСкладахПоЯчейкамОбороты.Регистратор.МоментВремени
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЯССМ_ТоварыНаСкладахПоЯчейкамОбороты.Регистратор.МоментВремени";
	
	ЗапросДокументов.УстановитьПараметр("ДатаДокумента", Документ.МоментВремени());
	ЗапросДокументов.УстановитьПараметр("ЭтотДокументСсылка", Документ.Ссылка);
	ЗапросДокументов.УстановитьПараметр("Объекты", Объекты);
	
	РезультатЗапросаДокументов = ЗапросДокументов.Выполнить();
	Если Не РезультатЗапросаДокументов.Пустой() Тогда
		
		ВыборкаЗапросаДокументов = РезультатЗапросаДокументов.Выбрать();
		Пока ВыборкаЗапросаДокументов.Следующий() Цикл
			
			Расшифровка = Расшифровка + Символы.ПС + "Вначале должен быть отменен документ : "+ВыборкаЗапросаДокументов.Документ+" !";
			Успех = Ложь;
			
		КонецЦикла;	//выборка запроса Документов
		
	КонецЕсли;
	
КонецПроцедуры //ПроверкаДатыЗапретаРедактированияДокументов


Процедура ПроверкаДатыЗапретаРедактированияДокументов(Документ, Объекты, РежимЗаписи, РежимПроведения, Успех, Расшифровка)
	
	//ДатаЗапрета = Константы.ЯССМ_ДатаЗапретаРедактированияДокументов.Получить();
	ДатаЗапрета=ТекущаяДата()-60*60*24;
	
	Если ЗначениеЗаполнено(ДатаЗапрета) И ДатаЗапрета>НачалоДня(Документ.Дата) Тогда
		
		Расшифровка = Расшифровка + Символы.ПС + "Дата запрета редактирования документов установлена на : "+Формат(ДатаЗапрета, "ДФ=dd.MM.yyyy")+"!";
		Успех = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры //ПроверкаДатыЗапретаРедактированияДокументов


Процедура ВыпускГотовойПродукции() //+Лико m.shenderov 31.08.2018
	ГруппаФинансовогоУчетаГП=ПолучитьГруппуФинансовогоУчетаДляГП(РабочийЦентр.Лико_Площадка.Организация);
	ГруппаФинансовогоУчета=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра.ГруппаФинансовогоУчета;
	Если Не ЗначениеЗаполнено(ГруппаФинансовогоУчетаГП) И ГотоваяПродукция Тогда
		Возврат; 
	КонецЕсли;
	
	
	Для каждого Продукция Из Выпуск Цикл
		
		Если Продукция.Номенклатура.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра Тогда
			
			ЕСли ГотоваяПродукция И  Продукция.Номенклатура.ГруппаФинансовогоУчета<>ГруппаФинансовогоУчетаГП Тогда
				СправочникОбъект=  Продукция.Номенклатура.ПолучитьОбъект();
				СправочникОбъект.ГруппаФинансовогоУчета= ГруппаФинансовогоУчетаГП;
				СправочникОбъект.Наименование=СтрЗаменить(СправочникОбъект.Наименование,"Незавершенное производство","Полуфабрикат");
				СправочникОбъект.НаименованиеПолное=СтрЗаменить(СправочникОбъект.Наименование,"Незавершенное производство","Полуфабрикат");
				
				СправочникОбъект.Записать();					
			КонецЕсли;
			
			ЕСли Не ГотоваяПродукция И  Продукция.Номенклатура.ГруппаФинансовогоУчета<>ГруппаФинансовогоУчета И Не БылВыпускГотовойПродукции(Продукция.Номенклатура) Тогда
				
				СправочникОбъект=  Продукция.Номенклатура.ПолучитьОбъект();   				
				СправочникОбъект.ГруппаФинансовогоУчета= ГруппаФинансовогоУчета;
				СправочникОбъект.Наименование=СтрЗаменить(СправочникОбъект.Наименование,"Полуфабрикат","Незавершенное производство");
				СправочникОбъект.НаименованиеПолное=СтрЗаменить(СправочникОбъект.Наименование,"Полуфабрикат","Незавершенное производство");
				
				СправочникОбъект.Записать();					
			КонецЕсли;
			
			
		КонецЕсли;
		
		
	КонецЦикла;	
	
	
	
	
КонецПроцедуры //-Лико m.shenderov 31.08.2018


Функция ПолучитьГруппуФинансовогоУчетаДляГП(Организация) //+Лико m.shenderov 31.08.2018
	УстановитьПривилегированныйРежим(Истина);	
