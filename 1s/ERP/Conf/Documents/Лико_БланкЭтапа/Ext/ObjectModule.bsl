Процедура ПроверкаРЦИксПак(Отказ)

	Если Организация<>Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра 
		Или Не ЗначениеЗаполнено(РабочийЦентр) ТОгда
		Возврат;
	КонецЕсли; 
	
	Если РабочийЦентр.Лико_СнятьОграниченияВЗакрытииБланка Тогда
		Возврат;
	КонецЕсли;
	

	лРабочийЦентр=РабочийЦентр;


	Если РабочийЦентр.Лико_Резак Тогда		

		Для каждого Работа Из ЗаказПокупателя.Цвета Цикл

			Если Работа.РабочийЦентр.Лико_Резак Тогда
				лРабочийЦентр=Работа.РабочийЦентр;
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;


	Если лРабочийЦентр.Лико_Резак Тогда
		Структура = Новый Структура;
		Структура.Вставить("РабочийЦентр",лРабочийЦентр);
		НайденныеСтроки=ЗаказПокупателя.Цвета.НайтиСтроки(Структура);
		Если        НайденныеСтроки.Количество()=0 Тогда
			НомерПроката=0;
			Возврат;  	
		КонецЕсли;	
	КонецЕсли;

	Структура = Новый Структура;
	Структура.Вставить("РабочийЦентр",лРабочийЦентр);
	Структура.Вставить("НомерПроката",НомерПроката);
	НайденныеСтроки=ЗаказПокупателя.Цвета.НайтиСтроки(Структура);
	Если        НайденныеСтроки.Количество()=0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Рабочий центр и номер проката не соответсвуют заказу!";
		Сообщение.Поле = "РабочийЦентр"; //имя
		Сообщение.ПутьКДанным = "Объект";
		Сообщение.Сообщить();
		Отказ=Истина;


	КонецЕсли;



КонецПроцедуры


