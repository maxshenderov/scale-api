Процедура ПеренестиЗаказ()	Экспорт
	Площадка 				= ЗаказПокупателя.Площадка;
	Ответственный		 	= АвторДокумента;
	Запись 					= РегистрыСведений.Лико_ЭтапыЗаказа.СоздатьМенеджерЗаписи();
	Запись.Период 			= Дата;
	Запись.Заказ 			=ЗаказПокупателя;
	Запись.Этап 			= Справочники.Лико_ЭтапыВыполненияЗаказа.ОкончаниеПечати;
	Запись.Площадка 		=  ЗаказПокупателя.Площадка;
	Если ЗначениеЗаполнено(НомерБланка) Тогда 
		Запись.НомерБланка = НомерБланка;
	Иначе	
		Запись.НомерБланка = 1;
	КонецЕсли;
	Если ЗначениеЗаполнено(РабочийЦентр) Тогда 
		Запись.РабочийЦентр = РабочийЦентр;
	КонецЕсли;
	
	Запись.Ответственный = Сотрудник.ФизическоеЛицо;
	Если ЗначениеЗаполнено("Количество") Тогда 
		Запись.Количество = Выпуск.Итог("Количество");
	КонецЕсли;
	
	Запись.Записать();	
