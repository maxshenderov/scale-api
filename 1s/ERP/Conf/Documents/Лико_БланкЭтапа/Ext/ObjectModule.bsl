Процедура УдалениеДокуметовПеремещенияВКолористическую(Отказ)
	
	
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Лико_Документ",Ссылка);
	СтруктураПараметров.Вставить("ХозяйственнаяОперация",Перечисления.ХозяйственныеОперации.ПередачаМатериаловВКладовую);	
	Лико_ОбщегоНазначенияСервер.НайтиДокументИПометитьНаУдалениеРасш("ДвижениеПродукцииИМатериалов",СтруктураПараметров,Отказ);	
	Лико_ОбщегоНазначенияСервер.НайтиДокументИПометитьНаУдаление("ЗаказМатериаловВПроизводство","Лико_Документ",Ссылка,Отказ);
	
