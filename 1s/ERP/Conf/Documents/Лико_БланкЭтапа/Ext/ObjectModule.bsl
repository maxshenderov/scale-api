Процедура ОпределитьТипРаспоряжения(ТипРаспоряжения, Отказ)
	
	ТипРаспоряжения="ЭтапПроизводства";
	ЕстьРаспоряжениеЭтап   =Ложь;
	ЕстьРаспоряжениеСборка =Ложь;
	//Если РабочийЦентр.Наименование="Резак Kampf" Или РабочийЦентр.Наименование="Резак Kampf2"   Тогда
	//		ТипРаспоряжения="СборкаТоваров";
	//Возврат;		
	//КонецЕсли;
	
	Для каждого СтрокаВыпуска Из Выпуск Цикл
		
		Если СтрокаВыпуска.Номенклатура.ВидНоменклатуры<>
			Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра
			Тогда
			ТипРаспоряжения="СборкаТоваров";
		Иначе
			Если ТипРаспоряжения="СборкаТоваров" Тогда
				Отказ=Истина;
				ТипРаспоряжения=Неопределено;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр(
				"ru = 'Нельзя в одном документе оформлять выпуск незавершенной продукции и материала!'"), ,
				"Объект.Выпуск");
				
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если ЗаказПокупателя.ТипЗаказа=Перечисления.Лико_ТипыЗаказов.Полуфабрикат И  Не РабочийЦентр.Лико_Резак Тогда
		//Если РабочийЦентр.ПорядковыйНомер=20 Или РабочийЦентр.ПорядковыйНомер=300 Или РабочийЦентр.ПорядковыйНомер=21  Тогда
		//	Если 	ТипРаспоряжения="СборкаТоваров" Тогда
		//		
		//	КонецЕсли;
		Если Не СвязатьСЭтапом Тогда
			ФиксироватьВыпуск=Истина; 
		КонецЕсли;
		ТипРаспоряжения="ЭтапПроизводства";
	КонецЕсли;
	
	Если ЗаказПокупателя.ВидЗаказа=Перечисления.Лико_ВидыЗаказов.ТестированиеМатериалов Тогда
		ТипРаспоряжения="СписаниеНаРасходы"
	КонецЕсли;
	
	
	Если РабочийЦентр.Лико_Резак и
		Не (ЗначениеЗаполнено(Распоряжение) И ТипЗнч(Распоряжение)=Тип("ДокументСсылка.ЭтапПроизводства2_2"))  Тогда
		ТипРаспоряжения="СборкаТоваров"
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаказНаРаскрой) Тогда
		ТипРаспоряжения="СборкаТоваров"
	КонецЕсли;
	
	Если РабочийЦентр.ВидРабочегоЦентра=Справочники.ВидыРабочихЦентров.Перемотка ТОгда
		Если Товары.Количество()>0 Тогда 
			ЭтоСборка=Ложь;			
			Для каждого Товар Из Товары Цикл 		
				Если 	Товар.Списать Тогда
					Структура = Новый Структура;
					Структура.Вставить("Номенклатура",Товар.Номенклатура);
					
					Если Выпуск.НайтиСтроки(Структура).Количество()>0 Тогда 
						
						ЭтоСборка=Истина;
						Прервать;
					КонецЕсли;   	
				КонецЕсли;
				
			КонецЦикла;	
			
			Если ЭтоСборка Тогда
				ТипРаспоряжения="СборкаТоваров"
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаказПокупателя) 
		И ЗначениеЗаполнено(НомерПроката) 
		И Выпуск.Количество()=0 Тогда
		
		ТипРаспоряжения="ЭтапПроизводства";
		
	КонецЕсли;   
	
	
	
КонецПроцедуры


// Процедура формирования движений по регистру "Лико_ЗакрытиеБланка".
//
// Параметры:
//	ДополнительныеСвойства - Структура - дополнительные свойства для записи движений 
//	Движения - КоллекцияДвижений - движения по которым двигается документ
//	Отказ - Булево - признак отказа от проведения документа
//
Процедура ОтразитьЛико_ЗакрытиеБланка(ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	Таблица = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаЛико_ЗакрытиеБланка;
	
	Если Отказ Или Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДвиженияЛико_ЗакрытиеБланка = Движения.Лико_ЗакрытиеБланка;
	ДвиженияЛико_ЗакрытиеБланка.Записывать = Истина;
	ДвиженияЛико_ЗакрытиеБланка.Загрузить(Таблица);
	
