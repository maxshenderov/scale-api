Процедура ЗаполнитьПаритииПроизводства() //+Лико m.shenderov 22.03.2023
    УстановитьПривилегированныйРежим(Истина);
		ТзПартий 	= 	Новый ТаблицаЗначений;
		ТзПартий.Колонки.Добавить("Серия",Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
		МассивСерий		=	Новый Массив();  

	Для каждого Товар  Из Товары.НайтиСтроки( Новый Структура("Списать",Истина)) Цикл
		
				
		ОН				=	Товар.Серия.ЯССМ_ОбъектНоменклатуры;
		
		Если ОН.Уникальный Тогда 
			
			Если ОН.ЕстьПартияПроизводства Тогда				
				НоваяПартия=ТзПартий.Добавить();
				НоваяПартия.Серия=Товар.Серия;
			Иначе
				МассивСерий.Добавить(Товар.Серия);
			КонецЕсли; 	
			
		КонецЕсли;		
	КонецЦикла;
	
	Если МассивСерий.Количество()>0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Лико_ПартииПроизводства.Партия КАК Партия
		|ИЗ
		|	РегистрСведений.Лико_ПартииПроизводства КАК Лико_ПартииПроизводства
		|ГДЕ
		|	Лико_ПартииПроизводства.Серия В(&МассивСерий)";
		Запрос.УстановитьПараметр("МассивСерий",МассивСерий );
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
				НоваяПартия=ТзПартий.Добавить();
				НоваяПартия.Серия=Выборка.Партия;

					
			КонецЦикла;
			
			
		
		КонецЕсли; 
	ТзПартий.Свернуть("Серия");
	МассивПартий=ТзПартий.ВыгрузитьКолонку("Серия");
	
	Движения.Лико_ПартииПроизводства.Записывать=Истина;
	
	Для каждого СтрВыпуска Из Выпуск Цикл 
		
		Для каждого Партия Из МассивПартий Цикл 
			
			Движение=Движения.Лико_ПартииПроизводства.Добавить();
			
			Движение.Партия						=	Партия;
			Движение.Серия						=	СтрВыпуска.Серия;
			Движение.ПартияОбъектНоменклатуры	=	Партия.ЯССМ_ОбъектНоменклатуры;
			Движение.СерияОбъектНоменклатуры	=	СтрВыпуска.Серия.ЯССМ_ОбъектНоменклатуры;			
			
		КонецЦикла;		
	КонецЦикла;
	
		
КонецПроцедуры //-Лико m.shenderov 22.03.2023


