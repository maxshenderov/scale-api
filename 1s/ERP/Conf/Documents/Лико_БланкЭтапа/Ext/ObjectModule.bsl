Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;	
	
	ОбработатьТабличнуюЧастьТовары();
	ЗаполнитьСклады(Отказ, РежимЗаписи);
	
	
	ТипРаспоряжения=Неопределено; 		
	ОпределитьТипРаспоряжения(ТипРаспоряжения,Отказ);	
	ДополнительныеСвойства.Вставить("ТипРаспоряжения",ТипРаспоряжения);
	
	Если ТипРаспоряжения="ЭтапПроизводства" Тогда
		ПроверкаРезерваМатериалов(Отказ,РежимЗаписи);
	КонецЕсли;
	
	
	
	ПроверкаИЗаполнениеДокумента(Отказ,РежимЗаписи,РежимПроведения);
	
	
	
	ВыполнитьСборкуРазборку(Отказ,РежимЗаписи,РежимПроведения); 	
	ВыпускГотовойПродукции();

	Если РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда 		
		ЗаполнитьТаблицуРаспределениеМатериалов();
	КонецЕсли;

	BRCНаследованиеОбъектовНоменклатуры();
	
	//+ ---> Лико2.5 m.shenderov 30.03.2022
	ПроведениеДокументов.ПередЗаписьюДокумента(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	//- <--- Лико2.5 m.shenderov 30.03.2022
	
		
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	УстановитьПривилегированныйРежим(Истина);

	Если Не Отказ Тогда
	КонецЕсли;

	// --> Начало Лико Ефимов ЕВВ 20.05.2022
	Если ЗначениеЗаполнено(ДатаПроведенияПоОбязательнымРегистрам) Тогда
		Документы.Лико_БланкЭтапа.ОтразитьТолькоТоварыВЯчейках(ЭтотОбъект);
		Возврат;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 20.05.2022

	Движения.Лико_СписаниеНаЗаказ.Очистить();	
	Движения.Лико_СписаниеНаЗаказ.Записать();	
	Движения.ТоварыКОтгрузке.Очистить();
	Движения.ТоварыКОтгрузке.Записать();
	Движения.ТоварыНаСкладах.Очистить();
	Движения.ТоварыНаСкладах.Записать();

	УдалениеДокуметовПеремещенияВКолористическую(Отказ);   

	ПроведениеДокументов.ОбработкаПроведенияДокумента(ЭтотОбъект, Отказ);


	//Начало изменений Иванова А.В. 20200728
	Лико_Планирование.ЗаполнениеЗатратЗаказаПоБланку(ЭтотОбъект.Ссылка, Отказ);
	//Конец изменений Иванова А.В. 20200728

	// --> Начало Лико Ефимов ЕВВ 07.01.2018
	ОбработатьПланРЦ();
	// <-- Конец Лико Ефимов ЕВВ 07.01.2018

	//+ Лико m.shenderov 16.01.2018
	ОбработатьЭтапЗаказа();
	СнятиеСРезерва();//2.5 Необходимо переделать документ подготовка заказов
	//- Лико m.shenderov 16.01.2018


	Если ВидОперации<>Перечисления.Лико_ВидыОперацийЗакрытияБланка.СборкаРазборка Тогда	
		Если ТипЗнч(Распоряжение)=Тип("ДокументСсылка.СборкаТоваров") Тогда
			////ОбработатьРаспоряжение(РежимЗаписиДокумента.Проведение,Отказ);
		КонецЕсли	
	КонецЕсли;

	// --> Начало Лико Иванова Анна  03.11.2020 - для Икс-Пака в заказе по бланку ничего не меняем
	Если Организация <> Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра Тогда 
		Если Не ДополнительныеСвойства.Свойство("НеЗаполнятьЗатратыВЗаказеКлиента") Тогда
			Лико_Планирование.ЗаполнениеЗатратИзЗакрытиеБланка(ЭтотОбъект.Ссылка, Отказ);
		КонецЕсли;
	КонецЕсли;	
	// <-- Конец Лико Иванова Анна  03.11.2020



	//+ Лико m.shenderov 29.09.2018
	Массив = Новый Массив();
	Для каждого Товар Из Товары Цикл
		Если Товар.Списать Тогда
			Массив.Добавить(Товар.Серия);
		КонецЕсли;  	

	КонецЦикла;
	ПроверитьКоличествоОбъектаНоменклатуры(Массив);
	//- Лико m.shenderov 29.09.2018

	Если Не ДополнительныеСвойства.Свойство("НеВосстанавливатьЭтапы") Тогда

		Лико_ОбщегоНазначенияСервер.ВосстановитьЭтапыАсинхронно(Ссылка);
	КонецЕсли;
	ПроверитьДатуФормированияОбъектаНоменклатуры();	
	Документы.Лико_БланкЭтапа.ЗаполнениеЗакрытияБланкаВОбъектеНоменклатуры(Ссылка);

	УчетТехОтхода();
	
	 //СформироватьПродажуМатериаловМеждуОрганизациями();
	 
	//+ o.pukhova 20.08.2020
	Если Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЭкоФлекс.ЗначениеПараметра И НомерПроката = 1 Тогда 
		
		ЗакрытиеЗаявокДизайнерам(); 
		
	КонецЕсли;
	//- o.pukhova 20.08.2020
	ЗакрытиеЗаказаНаРаскрой();

	Если ДополнительныеСвойства.ТипРаспоряжения="СборкаТоваров" Тогда	

		ЗарезервироватьМатериталСборки();

		ЗаполнитьПаритииПроизводства();

	КонецЕсли;

РегистрыСведений.Лико_СерииНоменклатурыДоп.Записать(ЭтотОбъект); 
