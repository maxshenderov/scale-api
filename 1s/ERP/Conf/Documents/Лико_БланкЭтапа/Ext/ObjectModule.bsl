//	Движения - КоллекцияДвижений - движения по которым двигается документ
//	Отказ - Булево - признак отказа от проведения документа
//
Процедура Отразить_Лико_ЗатратыПоЗаказуДляОтгрузки(ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	Таблица = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаЛико_ЗатратыПоЗаказуДляОтгрузки;
	
	Если Отказ Или Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Движения_Лико_ЗатратыПоЗаказу = Движения.Лико_ЗатратыПоЗаказуДляОтгрузки;
	Движения_Лико_ЗатратыПоЗаказу.Записывать = Истина;
	Движения_Лико_ЗатратыПоЗаказу.Загрузить(Таблица);
	
	Движения_Лико_ЗатратыПоЗаказуДляВыпуска = Движения.Лико_ЗатратыПоЗаказуДляВыпуска;
	Движения_Лико_ЗатратыПоЗаказуДляВыпуска.Записывать = Истина;
	Движения_Лико_ЗатратыПоЗаказуДляВыпуска.Загрузить(Таблица);


КонецПроцедуры

