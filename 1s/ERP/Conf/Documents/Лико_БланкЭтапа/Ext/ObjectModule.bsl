Процедура СоздатьРедактироватьВыпускПродукции(Отказ)
	Возврат;
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 	
	ОбъектыОснований = Новый Массив;
	ОбъектыОснований.Добавить(Распоряжение); 	
	
	ПараметрыОткрытия = ПроизводствоВызовСервера.ПараметрыСозданияДвиженияПродукцииИМатериаловНаОсновании(
	ОбъектыОснований, Перечисления.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства);	
	
	НовыйДокОбъект = Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент(); 	
	НовыйДокОбъект.Заполнить(ПараметрыОткрытия.Основание);
	НовыйДокОбъект.Дата = Дата;
	НовыйДокОбъект.Статус = Перечисления.СтатусыДвиженияПродукцииИМатериалов.Принято;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_БланкЭтапаВыпуск.Номенклатура КАК Номенклатура,
	|	Лико_БланкЭтапаВыпуск.Серия КАК Серия,
	|	Лико_БланкЭтапаВыпуск.Характеристика КАК Характеристика,
	|	Лико_БланкЭтапаВыпуск.КоличествоУУ КАК Количество,
	|	Лико_БланкЭтапаВыпуск.Количество КАК КоличествоУпаковок,
	|	Лико_БланкЭтапаВыпуск.Серия.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения КАК Упаковка,
	|	Лико_БланкЭтапаВыпуск.Ссылка.Распоряжение КАК Распоряжение,
	|	Лико_БланкЭтапаВыпуск.НомерСтроки КАК КодСтроки
	|ИЗ
	|	Документ.Лико_БланкЭтапа.Выпуск КАК Лико_БланкЭтапаВыпуск
	|ГДЕ
	|	Лико_БланкЭтапаВыпуск.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	НовыйДокОбъект.Товары.Загрузить( Запрос.Выполнить().Выгрузить());	
	
	Если ЗначениеЗаполнено(ДокументВыпуска)  Тогда
		ДокументВыпускаОбъект = ДокументВыпуска.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(ДокументВыпускаОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из ДокументВыпускаОбъект.Метаданные().ТабличныеЧасти Цикл
			ДокументВыпускаОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = ДокументВыпускаОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(); 		
	Исключение
		Отказ = Истина;
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
	КонецПопытки; 	
	Если Отказ Тогда
		Возврат ;
	КонецЕсли;
	ДокументВыпуска= НовыйДокОбъект.Ссылка;  	
КОнецПроцедуры

Процедура СоздатьРедактироватьПередачуМатериалов(Отказ)
	Возврат;
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 	
	ОбъектыОснований = Новый Массив;
	ОбъектыОснований.Добавить(Распоряжение); 	
	
	ПараметрыОткрытия = ПроизводствоВызовСервера.ПараметрыСозданияДвиженияПродукцииИМатериаловНаОсновании(
	ОбъектыОснований, Перечисления.ХозяйственныеОперации.ПередачаМатериаловВПроизводство);	
	
	НовыйДокОбъект = Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент(); 	
	НовыйДокОбъект.Заполнить(ПараметрыОткрытия.Основание);
	НовыйДокОбъект.Дата = Дата;
	НовыйДокОбъект.Статус = Перечисления.СтатусыДвиженияПродукцииИМатериалов.Принято;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_БланкЭтапаТовары.Номенклатура КАК Номенклатура,
	|	Лико_БланкЭтапаТовары.Серия КАК Серия,
	|	Лико_БланкЭтапаТовары.Характеристика КАК Характеристика,
	|	Лико_БланкЭтапаТовары.КоличествоУУ - Лико_БланкЭтапаТовары.ВозвратКоличествоУУ КАК Количество,
	|	Лико_БланкЭтапаТовары.Количество - Лико_БланкЭтапаТовары.ВозвратКоличество КАК КоличествоУпаковок,
	|	Лико_БланкЭтапаТовары.Серия.ЯССМ_ОбъектНоменклатуры.БазоваяЕдиницаИзмерения КАК Упаковка,
	|	Лико_БланкЭтапаТовары.Ссылка.Распоряжение КАК Распоряжение,
	|	Лико_БланкЭтапаТовары.НомерСтроки КАК КодСтроки
	|ИЗ
	|	Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
	|ГДЕ
	|	Лико_БланкЭтапаТовары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	НовыйДокОбъект.Товары.Загрузить( Запрос.Выполнить().Выгрузить());	
	
	Если ЗначениеЗаполнено(ДокументПередачиВПроизводство)  Тогда
		ДокументПередачиОбъект = ДокументПередачиВПроизводство.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(ДокументПередачиОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из ДокументПередачиОбъект.Метаданные().ТабличныеЧасти Цикл
			ДокументПередачиОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = ДокументПередачиОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(); 		
	Исключение
		Отказ = Истина;
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
	КонецПопытки; 	
	Если Отказ Тогда
		Возврат ;
	КонецЕсли;
	ДокументПередачиВПроизводство= НовыйДокОбъект.Ссылка;  	
