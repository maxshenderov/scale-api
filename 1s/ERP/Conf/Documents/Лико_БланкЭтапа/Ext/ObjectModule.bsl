Процедура ПроверкаИЗаполнениеДокумента(Отказ, РежимЗаписи, РежимПроведения)
	// --> Начало Лико Ефимов ЕВВ 18.10.2019
	Если (ЭтоСлужебныйДокументДляТачпадов ИЛИ Ссылка.ЭтоСлужебныйДокументДляТачпадов)
		И НЕ (ДополнительныеСвойства.Свойство("ЗаписьСТачпада") ИЛИ РольДоступна("ПолныеПрава")) Тогда
		Отказ = Истина;
		Сообщить("" + Ссылка + ": это служебный документ для тачпадов, изменение запрещено");
		Возврат;
	КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 18.10.2019

	Если РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда
		УстановкаЦеныНаВыпускГравировальногоУчастка(Отказ);  
		КонтрольВыполненияПоНесколькимОсонваниям(Отказ);
		ПроверкаРЦИксПак(Отказ);

		// --> Начало Лико Субботин 14.04.2022
		ЭтоИкспак  = Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра;
		ЭтоТермоусадка = РабочийЦентр.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.СклейкаТермоусадки ;
		Если  ЭтоТермоусадка и ЭтоИкспак Тогда

			Запрос = Новый Запрос;
