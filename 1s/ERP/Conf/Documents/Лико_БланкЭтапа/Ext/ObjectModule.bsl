		Структура.Вставить("Количество",Выборка.КоличествоУУ);
		Структура.Вставить("КоличествоУпаковок",Выборка.КоличествоУУ);
		
		
	КонецЦикла; 
	
	
	
	//Структура.Вставить("Номенклатура",Товары[0].Номенклатура); 
	//Структура.Вставить("Характеристика",Товары[0].Характеристика); 
