//	Отказ - Булево - признак отказа от проведения документа
//
Процедура ОтразитьЛико_Лико_ТоварыКРаспределению(ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	Таблица = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаЛико_ТоварыКРаспределению;
	
	Если Отказ Или Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Движения_Лико_ТоварыКРаспределению = Движения.Лико_ТоварыКРаспределению;
	Движения_Лико_ТоварыКРаспределению.Записывать = Истина;
	Движения_Лико_ТоварыКРаспределению.Загрузить(Таблица);
	
КонецПроцедуры






//Процедура формирования движений по регистру "Лико_СписаниеНаЗаказ".
//
// Параметры:
//	ДополнительныеСвойства - Структура - дополнительные свойства для записи движений 
//	Движения - КоллекцияДвижений - движения по которым двигается документ
//	Отказ - Булево - признак отказа от проведения документа
//
Процедура Отразить_Лико_СписаниеНаЗаказ(ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	Таблица = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаЛико_СписаниеНаЗаказ;
	
	Если Отказ Или Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Движения_Лико_СписаниеНаЗаказ = Движения.Лико_СписаниеНаЗаказ;
	Движения_Лико_СписаниеНаЗаказ.Записывать = Истина;
	Движения_Лико_СписаниеНаЗаказ.Загрузить(Таблица);
	
КонецПроцедуры



// Процедура формирования движений по регистру "Лико_ЗатратыПоЗаказу".
//
// Параметры:
//	ДополнительныеСвойства - Структура - дополнительные свойства для записи движений 
//	Движения - КоллекцияДвижений - движения по которым двигается документ
//	Отказ - Булево - признак отказа от проведения документа
//
Процедура ОтразитьЛико_Лико_ТоварыЗатратыПоЗаказу(ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	Возврат;
	
	Таблица = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаЛико_ЗатратыПоЗаказу;
	
	Если Отказ Или Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Движения_Лико_ЗатратыПоЗаказу = Движения.Лико_ЗатратыПОЗаказу;
	Движения_Лико_ЗатратыПоЗаказу.Записывать = Истина;
	Движения_Лико_ЗатратыПоЗаказу.Загрузить(Таблица);
	
КонецПроцедуры


//Процедура по формированию движений по расчетным затратам лаков/красок

Процедура ЗаполнитьРасчетныеЗатратыПоЛакамКраскам()
	
	Движения.Лико_ЗатратыПоЗаказу.Записывать = Истина;
	Движения.Лико_ЗатратыПоЗаказу.Записать();
	Движения.Лико_ТоварыКРаспределению.Записать();
	
	//НаборЗаписей = РегистрыНакопления.Лико_ЗатратыПоЗаказу.СоздатьНаборЗаписей();
	//НаборЗаписей.Отбор.Регистратор.Установить(Ссылка);
	//НаборЗаписей.Прочитать();
	
	//	НаборЗаписей.Записать();
	
	//Заполняем краски лаки
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Лико_ЗатратыПоЗаказу.Период КАК Период,
	|	Лико_ЗатратыПоЗаказу.Регистратор КАК Регистратор,
	|	Лико_ЗатратыПоЗаказу.ЗаказКлиента КАК ЗаказКлиента,
	|	МАКСИМУМ(Лико_ЗатратыПоЗаказу.РабочийЦентр) КАК РабочийЦентр,
	|	МИНИМУМ(Лико_ЗатратыПоЗаказу.НомерПроката) КАК НомерПроката,
	|	СУММА(Лико_ЗатратыПоЗаказу.Количество) КАК Количество,
	|	СУММА(Лико_ЗатратыПоЗаказу.КоличествоПМ) КАК КоличествоПМ
	|ИЗ
	|	РегистрНакопления.Лико_ЗатратыПоЗаказу КАК Лико_ЗатратыПоЗаказу
	|ГДЕ
	|	Лико_ЗатратыПоЗаказу.Регистратор = &Ссылка
	|	И Лико_ЗатратыПоЗаказу.СтатьяЗатрат = ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ОсновнойМатериал)
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ЗатратыПоЗаказу.Период,
	|	Лико_ЗатратыПоЗаказу.Регистратор,
	|	Лико_ЗатратыПоЗаказу.ЗаказКлиента
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Лико_ТоварыКРаспределению.Период,
	|	Лико_ТоварыКРаспределению.Регистратор,
	|	Лико_ТоварыКРаспределению.ЗаказКлиента,
	|	Лико_ТоварыКРаспределению.РабочийЦентр,
	|	Лико_ТоварыКРаспределению.НомерПроката,
	|	СУММА(Лико_ТоварыКРаспределению.КоличествоУУ),
	|	СУММА(Лико_ТоварыКРаспределению.Количество)
	|ИЗ
	|	РегистрНакопления.Лико_ТоварыКРаспределению КАК Лико_ТоварыКРаспределению
	|ГДЕ
	|	Лико_ТоварыКРаспределению.Регистратор = &ссылка
	|	И Лико_ТоварыКРаспределению.Номенклатура.ВидНоменклатуры В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				Лико_ПредопределенныеЗначения.ЗначениеПараметра КАК ЗначениеПараметра
	|			ИЗ
	|				Справочник.Лико_ПредопределенныеЗначения КАК Лико_ПредопределенныеЗначения
	|			ГДЕ
	|				Лико_ПредопределенныеЗначения.Ссылка = ЗНАЧЕНИЕ(Справочник.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция))
	|	И НЕ Лико_ТоварыКРаспределению.Серия.ЯССМ_ОбъектНоменклатуры.ЗакрытиеБланка ЕСТЬ NULL
	|	И НЕ Лико_ТоварыКРаспределению.Серия.ЯССМ_ОбъектНоменклатуры.ЗакрытиеБланка = ЗНАЧЕНИЕ(Документ.Лико_БланкЭтапа.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ТоварыКРаспределению.Период,
	|	Лико_ТоварыКРаспределению.Регистратор,
	|	Лико_ТоварыКРаспределению.ЗаказКлиента,
	|	Лико_ТоварыКРаспределению.РабочийЦентр,
	|	Лико_ТоварыКРаспределению.НомерПроката";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.выполнить().Выбрать();
	Пока Выборка.Следующий()  Цикл
		РабочийЦентр = Выборка.рабочийЦентр;
		ТЗ = Лико_Планирование.ПолучитьСтоимостьКраскиЛаков(Выборка.ЗаказКлиента,"Документ.ЗаказКлиента", Выборка.Количество, Выборка.КоличествоПМ, 1, НачалоМесяца(Выборка.Период), Выборка.НомерПроката, Истина);
		Для каждого стр ИЗ ТЗ Цикл
			Запись = Движения.Лико_ЗатратыПоЗаказу.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, стр, "Затрата, СтатьяЗатрат, НомерПроката, Грамматура, ПроцентЗаливки");
			Запись.КоличествоПлан = стр.Количество;
			Запись.СуммаПлан = стр.сумма;
			ЗаполнитьЗначенияСвойств(Запись, Выборка, "Регистратор, ЗаказКлиента, Период,РабочийЦентр");
		КонецЦикла;
	КонецЦикла;
	
	//Стоимость клея для ТУ
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ТоварыКРаспределениюОбороты.ЗаказКлиента КАК ЗаказКлиента,
	|	Лико_ТоварыКРаспределениюОбороты.ЗаказКлиента.Ручьи КАК Ручьи,
	|	СУММА(Лико_ТоварыКРаспределениюОбороты.КоличествоОборот) КАК КоличествоПМ,
	|	Лико_ТоварыКРаспределениюОбороты.Регистратор КАК Регистратор,
	|	Лико_ТоварыКРаспределениюОбороты.Период КАК Период,
	|	Лико_ТоварыКРаспределениюОбороты.РабочийЦентр КАК РабочийЦентр
	|ИЗ
	|	РегистрНакопления.Лико_ТоварыКРаспределению.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			Номенклатура.ВидНоменклатуры.Лико_РулонныйМатериал = ИСТИНА
	|				И РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.СклейкаТермоусадки)) КАК Лико_ТоварыКРаспределениюОбороты
	|ГДЕ
	|	Лико_ТоварыКРаспределениюОбороты.Регистратор = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ТоварыКРаспределениюОбороты.ЗаказКлиента,
	|	Лико_ТоварыКРаспределениюОбороты.ЗаказКлиента.Ручьи,
	|	Лико_ТоварыКРаспределениюОбороты.Регистратор,
	|	Лико_ТоварыКРаспределениюОбороты.Период,
	|	Лико_ТоварыКРаспределениюОбороты.РабочийЦентр";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.выполнить().Выбрать();
	Пока Выборка.Следующий()  Цикл
		ВыборкаКлеяТУ = Лико_Планирование.ПолучитьСтоимостьКлеяТУ(Выборка.ЗаказКлиента,1, Выборка.КоличествоПМ, Дата, Выборка.Ручьи  );
		Запись = Движения.Лико_ЗатратыПоЗаказу.Добавить();
		ЗаполнитьЗначенияСвойств(Запись,ВыборкаКлеяТУ, "Затрата, СтатьяЗатрат, НомерПроката");
		Запись.КоличествоПлан = ВыборкаКлеяТУ.Количество;
		Запись.СуммаПлан = ВыборкаКлеяТУ.сумма;
		ЗаполнитьЗначенияСвойств(Запись, Выборка, "Регистратор, ЗаказКлиента, Период,РабочийЦентр");
	КонецЦикла;
	
	
	
	//Стоимость Клея
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗатратыПоЗаказу.Период КАК Период,
	|	Лико_ЗатратыПоЗаказу.Регистратор КАК Регистратор,
	|	Лико_ЗатратыПоЗаказу.ЗаказКлиента КАК ЗаказКлиента,
	|	Лико_ЗатратыПоЗаказу.РабочийЦентр КАК РабочийЦентр,
	|	Лико_ЗатратыПоЗаказу.НомерПроката КАК НомерПроката,
	|	Лико_ЗатратыПоЗаказу.ВидРабот КАК ВидРабот,
	|	Лико_ЗатратыПоЗаказу.НомерРаботы КАК НомерРаботы,
	|	СУММА(Лико_ЗатратыПоЗаказу.Количество) КАК Количество,
	|	ВЫБОР
	|		КОГДА ЗаказКлиентаВидыРабот.КлейФакт <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				И ЗаказКлиентаВидыРабот.КлейФакт <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
	|				И ЗаказКлиентаВидыРабот.КлейФакт <> НЕОПРЕДЕЛЕНО
	|			ТОГДА ЗаказКлиентаВидыРабот.КлейФакт
	|		ИНАЧЕ ЗаказКлиентаВидыРабот.Клей
	|	КОНЕЦ КАК Клей,
	|	СУММА(ЗаказКлиентаВидыРабот.ПроцентЗаливки) КАК ПроцентЗаливки,
	|	ЕСТЬNULL(Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение, Лико_ЗначенияКоэффициентовПереносаСрезПоследних1.Значение) КАК КоэффициентПереноса
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрНакопления.Лико_ЗатратыПоЗаказу КАК Лико_ЗатратыПоЗаказу
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|		ПО Лико_ЗатратыПоЗаказу.ЗаказКлиента = ЗаказКлиентаВидыРабот.Ссылка
	|			И Лико_ЗатратыПоЗаказу.ВидРабот = ЗаказКлиентаВидыРабот.ВидРабот
	|			И Лико_ЗатратыПоЗаказу.НомерРаботы = ЗаказКлиентаВидыРабот.НомерРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_КоэффициентыКраскоПереноса.ВидыРабот КАК Лико_КоэффициентыКраскоПереносаВидыРабот
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЗначенияКоэффициентовПереноса.СрезПоследних(&Дата, Площадка = &Площадка) КАК Лико_ЗначенияКоэффициентовПереносаСрезПоследних
	|			ПО Лико_КоэффициентыКраскоПереносаВидыРабот.Ссылка = Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Коэффициент
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЗначенияКоэффициентовПереноса.СрезПоследних(&Дата, Площадка = &ПлощадкаЛикофлекс) КАК Лико_ЗначенияКоэффициентовПереносаСрезПоследних1
	|			ПО Лико_КоэффициентыКраскоПереносаВидыРабот.Ссылка = Лико_ЗначенияКоэффициентовПереносаСрезПоследних1.Коэффициент
	|		ПО Лико_ЗатратыПоЗаказу.ВидРабот = Лико_КоэффициентыКраскоПереносаВидыРабот.ВидРабот
	|ГДЕ
	|	Лико_ЗатратыПоЗаказу.Регистратор = &Ссылка
	|	И Лико_ЗатратыПоЗаказу.СтатьяЗатрат = ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.ДополнительныеМатериалы)
	|	И (ЗаказКлиентаВидыРабот.Клей <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				И ЗаказКлиентаВидыРабот.Клей <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
	|				И ЗаказКлиентаВидыРабот.Клей <> НЕОПРЕДЕЛЕНО
	|			ИЛИ ЗаказКлиентаВидыРабот.КлейФакт <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				И ЗаказКлиентаВидыРабот.КлейФакт <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
	|				И ЗаказКлиентаВидыРабот.КлейФакт <> НЕОПРЕДЕЛЕНО)
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ЗатратыПоЗаказу.Период,
	|	Лико_ЗатратыПоЗаказу.Регистратор,
	|	Лико_ЗатратыПоЗаказу.ЗаказКлиента,
	|	Лико_ЗатратыПоЗаказу.РабочийЦентр,
	|	Лико_ЗатратыПоЗаказу.НомерПроката,
	|	Лико_ЗатратыПоЗаказу.ВидРабот,
	|	Лико_ЗатратыПоЗаказу.НомерРаботы,
	|	ВЫБОР
	|		КОГДА ЗаказКлиентаВидыРабот.КлейФакт <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				И ЗаказКлиентаВидыРабот.КлейФакт <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
	|				И ЗаказКлиентаВидыРабот.КлейФакт <> НЕОПРЕДЕЛЕНО
	|			ТОГДА ЗаказКлиентаВидыРабот.КлейФакт
	|		ИНАЧЕ ЗаказКлиентаВидыРабот.Клей
	|	КОНЕЦ,
	|	ЕСТЬNULL(Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение, Лико_ЗначенияКоэффициентовПереносаСрезПоследних1.Значение)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Период КАК Период,
	|	ВТ.Регистратор КАК Регистратор,
	|	ВТ.ЗаказКлиента КАК ЗаказКлиента,
	|	ВТ.НомерПроката КАК НомерПроката,
	|	ВТ.РабочийЦентр КАК РабочийЦентр,
	|	ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.Клей) КАК СтатьяЗатрат,
	|	ВТ.ВидРабот КАК ВидРабот,
	|	ВТ.НомерРаботы КАК НомерРаботы,
	|	ВТ.Клей КАК Затрата,
	|	ВТ.Количество * ВЫБОР
	|		КОГДА ВТ.ПроцентЗаливки = 0
	|			ТОГДА 1
	|		ИНАЧЕ ВТ.ПроцентЗаливки / 100
	|	КОНЕЦ * ЕСТЬNULL(ЕСТЬNULL(Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение, Лико_ЗначенияКоэффициентовПереносаСрезПоследних1.Значение), ВТ.КоэффициентПереноса) / 1000 КАК КоличествоПлан,
	|	ВТ.Количество * ВЫБОР
	|		КОГДА ВТ.ПроцентЗаливки = 0
	|			ТОГДА 1
	|		ИНАЧЕ ВТ.ПроцентЗаливки / 100
