Функция СоздатьВозвратИзПроизводства(НовыйЭтапСсылка, УжеСозданныйДокумент)
	НовыйДокОбъект=Неопределено;
	
	Отказ = Ложь;
	ОбъектыОснований = Новый Массив;
	ОбъектыОснований.Добавить(НовыйЭтапСсылка);
	
	ПараметрыОткрытия = ПроизводствоВызовСервера.ПараметрыСозданияДвиженияПродукцииИМатериаловНаОсновании(
	ОбъектыОснований,
	ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВозвратМатериаловИзПроизводства"));
	
	НовыйДокОбъект = Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент();
	
	НовыйДокОбъект.Заполнить(ПараметрыОткрытия.Основание);
	НовыйДокОбъект.Дата = Дата;
	НовыйДокОбъект.Статус = Перечисления.СтатусыДвиженияПродукцииИМатериалов.Принято;
	НовыйДокОбъект.Организация=НовыйЭтапСсылка.Организация;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.Документ.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	//Добавляем серии в документ
	НовыйДокОбъект.Серии.Очистить();
	Для каждого СтрокаСерии Из Товары Цикл
		Если СтрокаСерии.Списать И СтрокаСерии.ВозвратКоличество>0 Тогда
			НоваяСерия=НовыйДокОбъект.Серии.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСерия,СтрокаСерии);
		КонецЕсли;
		
		Для каждого НовыйТовар Из НовыйДокОбъект.Товары Цикл
			НовыйТовар.СтатусУказанияСерий=8;
			НовыйТовар.СтатусУказанияСерийОтправитель=8;
			НовыйТовар.СтатусУказанияСерийПолучатель=8;	
			
		КонецЦикла;
		
		
		
	КонецЦикла;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//Лико_ДополнительноКлиентСервер.СообщитьДляКлиента(?(УжеСозданныйДокумент = Неопределено, "Создан", "Перезаполнен") + " документ """ + НовыйДокОбъект + """");
	Исключение
		Отказ = Истина;
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция СоздатьПриходныйОрдер(НовыйЭтапСсылка, Приемка, УжеСозданныйДокумент)
	
	Отказ = Ложь;
	Основание = Новый Структура;
	Основание.Вставить("Распоряжение",НовыйЭтапСсылка.Ссылка);
	Основание.Вставить("Отправитель",НовыйЭтапСсылка.Подразделение);
	Основание.Вставить("ЗакрыватьГрафикПоступления",Истина);
	Основание.Вставить("Склад", ЯчейкаПолучатель.Владелец);
	Основание.Вставить("Помещение", Справочники.СкладскиеПомещения.ПустаяСсылка());
	Основание.Вставить("ЗонаПриемки", Приемка);
	Основание.Вставить("ДатаВходящегоДокумента", НовыйЭтапСсылка.Дата);
	Основание.Вставить("НомерВходящегоДокумента", НовыйЭтапСсылка.Номер);
	Основание.Вставить("ДатаПоступления", НовыйЭтапСсылка.Дата);
	
	НовыйДокОбъект = Документы.ПриходныйОрдерНаТовары.СоздатьДокумент();
	
	НовыйДокОбъект.Заполнить(Основание);
	НовыйДокОбъект.Дата = Дата;
	НовыйДокОбъект.Статус = Перечисления.СтатусыПриходныхОрдеров.Принят;
	НовыйДокОбъект.Товары.Очистить();
	Для каждого ВыборкаСерии Из Товары Цикл
		
		Если ВыборкаСерии.Количество = 0 Тогда
			Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("У серии " + ВыборкаСерии.Серия + " не заполнен реквизит ""Количество в упаковке""! Данная серия пропущена.");
			Продолжить;
		КонецЕсли;
		Если ВыборкаСерии.Списать и ВыборкаСерии.ВозвратКоличество>0 Тогда
			НоваяСтрока = НовыйДокОбъект.Товары.Добавить();
			НоваяСтрока.Номенклатура = ВыборкаСерии.Номенклатура;
			НоваяСтрока.Характеристика = ВыборкаСерии.Характеристика;
			НоваяСтрока.Упаковка =Справочники.ЯССМ_Нарезки.УпаковкаПоНарезке(ВыборкаСерии.Серия.ЯССМ_ОбъектНоменклатуры.Нарезка) ;
			НоваяСтрока.КоличествоУпаковок = ВыборкаСерии.ВозвратКоличество;
			НоваяСтрока.Количество = ВыборкаСерии.ВозвратКоличествоУУ;
			НоваяСтрока.СтатусУказанияСерий = 8;
			НоваяСтрока.Серия = ВыборкаСерии.Серия;
		КонецЕсли;
		
	КонецЦикла;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.Документ.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//Лико_ДополнительноКлиентСервер.СообщитьДляКлиента(?(УжеСозданныйДокумент = Неопределено, "Создан", "Перезаполнен") + " документ """ + НовыйДокОбъект + """");
	Исключение
		Отказ = Истина;
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;
	
КонецФункции

Функция СоздатьРазмещениеТоваров(НовыйДокументПриходныйОрдерСсылка, УжеСозданныйДокумент)
	
	Отказ = Ложь;
	
	НовыйДокОбъект = Документы.ОтборРазмещениеТоваров.СоздатьДокумент();
	
	НовыйДокОбъект.Заполнить(НовыйДокументПриходныйОрдерСсылка);
	НовыйДокОбъект.Дата = Дата;
	
	//Система автоматом распределила товар по ячейкам, а нам нужно весть товар положить в ЯчейкаПолучатель
	Для каждого СтрокаТЧ из НовыйДокОбъект.ТоварыРазмещение Цикл
		СтрокаТЧ.Ячейка = ЯчейкаПолучатель;
	КонецЦикла;
	
	Если УжеСозданныйДокумент <> Неопределено Тогда
		УжеСозданныйДокументОбъект = УжеСозданныйДокумент.Документ.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		//чтобы отработали проверки при проведении отбора, его сперва нужно провести в статусе "В работе" или "Подготовлено", а уже потом в статусе "Выполнено без ошибок"
		//(если провести сразу в статусе "Выполнено без ошибок", то проверок не будет и документ без проблем проведется)
		Если НЕ ОтключитьЧастьПроверок Тогда
			// С такими проверками невозможно перепровести документ задним числом (если коробки после этого имеют другие движения), закомментим пока
			//НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		//меняем статус и проводим еще раз
		НовыйДокОбъект.Статус = Перечисления.СтатусыОтборовРазмещенийТоваров.ВыполненоБезОшибок;
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//Лико_ДополнительноКлиентСервер.СообщитьДляКлиента(?(УжеСозданныйДокумент = Неопределено, "Создан", "Перезаполнен") + " документ """ + НовыйДокОбъект + """");
	Исключение
		Отказ = Истина;
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		ОтменитьТранзакцию();
	КонецПопытки;
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовыйДокОбъект.Ссылка;	
	
КонецФункции

#Область Распределение_Краски


Процедура СоздатьЗаказМатериаловПроизводствоПоТоварыКОтгрузке(ДополнительныеСвойства, Движения, Отказ) Экспорт
	Если ЗначениеЗаполнено(ХозяйственнаяОперация) ТОгда
		Возврат;
	КонецЕсли;
	
	
	Таблица = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаТоварыКОтгрузке;
	
	
	Если Отказ ИЛИ Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	лЗаказМатериаловВПроизводство=Неопределено;
	Для каждого СтрокаТаблицы Из Таблица Цикл
		Если ТипЗнч(СтрокаТаблицы.ДокументОтгрузки)=Тип("ДокументСсылка.ЗаказМатериаловВПроизводство") Тогда
			лЗаказМатериаловВПроизводство=СтрокаТаблицы.ДокументОтгрузки;
			Прервать;
		КонецЕсли;
		
		
	КонецЦикла;
	Если лЗаказМатериаловВПроизводство=Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ДокументОтгрузки",лЗаказМатериаловВПроизводство);
	НайденыеТовары=Таблица.НайтиСтроки(СтруктураОтбора);
	
	
	
	НовоеРаспоряжение					=лЗаказМатериаловВПроизводство.ПолучитьОбъект();
	НовоеРаспоряжение.Дата				=Дата;
	Если ЗначениеЗаполнено(ДатаДляТиповыхДокументов) Тогда
		  НовоеРаспоряжение.Дата				=ДатаДляТиповыхДокументов;		
	КонецЕсли;
	НовоеРаспоряжение.ПометкаУдаления	=Ложь;				
	НовоеРаспоряжение.Товары.Очистить();
	
	Для каждого Товар Из НайденыеТовары Цикл
		НовыйТовар							=НовоеРаспоряжение.Товары.Добавить();
		НовыйТовар.Номенклатура				=Товар.Номенклатура;
		НовыйТовар.Характеристика			=Товар.Характеристика;
		НовыйТовар.Количество				=Товар.КОтгрузке;
		НовыйТовар.КоличествоУпаковок		=Товар.КОтгрузке;				
		НовыйТовар.ВариантОбеспечения		=Перечисления.ВариантыОбеспечения.Отгрузить;
		НовыйТовар.НачалоОтгрузки			=Дата;
		НовыйТовар.ОкончаниеПоступления		=Дата; 
	КонецЦикла;
	
	Ошибка=Неопределено;
	Попытка 				
		НовоеРаспоряжение.ПометкаУдаления=Ложь;
		НовоеРаспоряжение.Записать(РежимЗаписиДокумента.Проведение); 	
	Исключение
		Отказ=Истина;
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + Ссылка + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
	КонецПопытки;	
	
	Если Не Отказ Тогда
		СоздатьДокументДвижениеМатериалов(лЗаказМатериаловВПроизводство,Отказ);	
	КонецЕсли;
	
КонецПроцедуры 

Процедура СоздатьДокументДвижениеМатериалов(ЗаказМатериаловВПроизводство,Отказ)		
	
	
	НовыйДокОбъект 					= Документы.ДвижениеПродукцииИМатериалов.СоздатьДокумент();
	НовыйДокОбъект.Дата 			= Дата;		
	Если ЗначениеЗаполнено(ДатаДляТиповыхДокументов) Тогда
		  НовыйДокОбъект.Дата				=ДатаДляТиповыхДокументов;		
	КонецЕсли;

	Массив 							= Новый Массив();
	Массив.Добавить(ЗаказМатериаловВПроизводство);		
	ПараметрыОткрытия = ПроизводствоВызовСервера.ПараметрыСозданияДвиженияПродукцииИМатериаловНаОсновании(
	Массив, ЗаказМатериаловВПроизводство.ХозяйственнаяОперация);
	
	
	ДанныеЗаполнения = ПараметрыОткрытия.Основание;
	ДанныеЗаполнения.Вставить("Товары", ЗаказМатериаловВПроизводство.Товары.Выгрузить());
	НовыйДокОбъект.Заполнить(ДанныеЗаполнения);
	НовыйДокОбъект.Лико_Документ=Ссылка;
	НовыйДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	НовыйДокОбъект.Статус=Перечисления.СтатусыДвиженияПродукцииИМатериалов.Принято;
	ПередачаМатериаловВКладовую=НайтиДокументПередачиМатериаловВКладовую(ЗаказМатериаловВПроизводство);
	Если  ЗначениеЗаполнено(ПередачаМатериаловВКладовую)  Тогда
		УжеСозданныйДокументОбъект = ПередачаМатериаловВКладовую.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(УжеСозданныйДокументОбъект, НовыйДокОбъект,,"Ссылка,Номер");
		Для Каждого	ТабличнаяЧасть из УжеСозданныйДокументОбъект.Метаданные().ТабличныеЧасти Цикл
			УжеСозданныйДокументОбъект[ТабличнаяЧасть.Имя].Загрузить(НовыйДокОбъект[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЦикла;
		НовыйДокОбъект = УжеСозданныйДокументОбъект;
	КонецЕсли;
	
	Попытка
		НовыйДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + НовыйДокОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки()); 			
		ВызватьИсключение;
	КонецПопытки;		
КонецПроцедуры

Функция НайтиДокументПередачиМатериаловВКладовую(ЗаказМатериаловВПроизводство) //+Лико m.shenderov 30.05.2019
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДвижениеПродукцииИМатериалов.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ДвижениеПродукцииИМатериалов КАК ДвижениеПродукцииИМатериалов
	|ГДЕ
	|	ДвижениеПродукцииИМатериалов.Лико_Документ = &Лико_Документ
	|	И ДвижениеПродукцииИМатериалов.Распоряжение = &Распоряжение
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДвижениеПродукцииИМатериалов.Дата";
	Запрос.УстановитьПараметр("Лико_Документ",Ссылка);
	Запрос.УстановитьПараметр("Распоряжение",ЗаказМатериаловВПроизводство);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка; 	
	КонецЦикла;	
	
КонецФункции //-Лико m.shenderov 30.05.2019 

