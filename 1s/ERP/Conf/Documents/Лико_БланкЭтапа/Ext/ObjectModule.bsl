Функция СтруктураДанныхДляЗаполненияРаспоряженияВерсия1(ТзНовая)

	Структура = Новый Структура; 	

	Структура.Вставить("Распоряжение"    ,Распоряжение);
	Структура.Вставить("Дата"            ,Дата);
	Структура.Вставить("Организация"     ,Организация);
	Структура.Вставить("Подразделение"   ,Подразделение);
	Структура.Вставить("ПометкаУдаления" ,Ложь);  	

	Структура.Вставить("Ответственный"   ,АвторДокумента);
	Структура.Вставить("Комментарий"); 
	Структура.Вставить("Склад"           ,Склад);
	КоличествоУУ=0;
	Для каждого Товар Из Товары Цикл
		КоличествоУУ=КоличествоУУ+Товар.КоличествоУУ ;
	КонецЦикла;
	Если ХозяйственнаяОперация=Перечисления.ХозяйственныеОперации.СборкаТоваров Тогда	

		ЕСли ЗначениеЗаполнено(ТзНовая) Тогда 
			Тз=ТзНовая;
			Если Тз.Колонки.Найти("КоличествоУУ")=Неопределено Тогда
				Тз.Колонки.Добавить("КоличествоУУ",Новый ОписаниеТипов("Число",
				Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
				Для каждого СтрТз Из Тз Цикл
					СтрТз.КоличествоУУ=СтрТз.КоличествоРасходУУ;
				КонецЦикла;	  
			КонецЕсли;	
		Иначе
			Тз=Выпуск.Выгрузить();
			Тз.Свернуть("Номенклатура,Характеристика","КоличествоУУ");
		КонецЕсли;
		
		
		лВыпуск = Выпуск.Выгрузить();
		лВыпуск.Свернуть("Номенклатура,Характеристика","КоличествоУУ");
		
		Структура.Вставить("Номенклатура"       ,лВыпуск[0].Номенклатура); 
		Структура.Вставить("Характеристика"     ,лВыпуск[0].Характеристика); 
		Структура.Вставить("Количество"         ,лВыпуск[0].КоличествоУУ);
		Структура.Вставить("КоличествоУпаковок" ,лВыпуск[0].КоличествоУУ);
		
		


		ЕСли ЗначениеЗаполнено(ТзНовая) Тогда 
			Структура.Вставить("Товары",ТзНовая); 
		Иначе	
			Структура.Вставить("Товары",Товары.Выгрузить());
		КонецЕсли;
	Иначе
		ЕСли ЗначениеЗаполнено(ТзНовая) Тогда 
			Тз=ТзНовая;
		Иначе
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("Списать",Истина);
			МассивСтрок=Товары.НайтиСтроки(СтруктураПоиска);

			Тз         =Товары.Выгрузить(МассивСтрок);
		КонецЕсли;

		Тз.Свернуть("Номенклатура,Характеристика","КоличествоРасходУУ");

		Для каждого СтрокаТЗ  Из Тз Цикл
			Структура.Вставить("Номенклатура",СтрокаТЗ.Номенклатура); 
			Структура.Вставить("Характеристика",СтрокаТЗ.Характеристика); 
			Структура.Вставить("Количество",СтрокаТЗ.КоличествоРасходУУ);
			Структура.Вставить("КоличествоУпаковок",СтрокаТЗ.КоличествоРасходУУ); 		
		КонецЦикла;
		//Структура.Вставить("Номенклатура",Тз[0].Номенклатура); 
		//Структура.Вставить("Характеристика",Тз[0].Характеристика); 
		//Структура.Вставить("Количество",Тз[0].КоличествоРасходУУ);
		//Структура.Вставить("КоличествоУпаковок",Тз[0].КоличествоРасходУУ); 		
		Структура.Вставить("Товары",Выпуск.Выгрузить());
	КонецЕсли;



	Структура.Вставить("Статус",Перечисления.СтатусыСборокТоваров.СобраноРазобрано); 
	Структура.Вставить("ХозяйственнаяОперация",ХозяйственнаяОперация); 
	Структура.Вставить("СборкаПодДеятельность",Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС); 

	Возврат Структура; 		
КонецФункции


