	Если ПризнакРЦУбиратьИзПлана Тогда
		УстановилиПривелигерованныйРежим = Ложь;
		Если НЕ ПривилегированныйРежим() Тогда
			УстановитьПривилегированныйРежим(Истина);
			УстановилиПривелигерованныйРежим = Истина;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПооперационноеРасписание2_2.Этап КАК Этап,
		|	ПооперационноеРасписание2_2.Операция КАК Операция,
		|	ПооперационноеРасписание2_2.ИдентификаторОперации КАК ИдентификаторОперации,
		|	ПооперационноеРасписание2_2.НомерПартии КАК НомерПартии,
		|	ПооперационноеРасписание2_2.РабочийЦентр КАК РабочийЦентр,
		|	ПооперационноеРасписание2_2.МодельРасписания КАК МодельРасписания,
		|	ПооперационноеРасписание2_2.МодельПланирования КАК МодельПланирования,
		|	ПооперационноеРасписание2_2.ЭтоУдалениеОперации КАК ЭтоУдалениеОперации,
		|	ПооперационноеРасписание2_2.Начало КАК Начало,
		|	ПооперационноеРасписание2_2.Окончание КАК Окончание,
		|	ПооперационноеРасписание2_2.ТактПараллельнойЗагрузки КАК ТактПараллельнойЗагрузки
		|ИЗ
		|	РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2
		|ГДЕ
		|	(ВЫРАЗИТЬ(ПооперационноеРасписание2_2.Этап.Распоряжение.ДокументОснование КАК Документ.ЗаказКлиента)) = &ЗаказКлиента
		|	И ВЫБОР
		|			КОГДА &ВидРЦ = НЕОПРЕДЕЛЕНО
		|				ТОГДА ПооперационноеРасписание2_2.РабочийЦентр = &РабочийЦентр
		|			ИНАЧЕ ПооперационноеРасписание2_2.РабочийЦентр.ВидРабочегоЦентра = &ВидРЦ
		|		КОНЕЦ
		|	И ПооперационноеРасписание2_2.Выполнено = 0
		|	И НЕ ПооперационноеРасписание2_2.ЭтоУдалениеОперации";
		
		Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказПокупателя);
		Запрос.УстановитьПараметр("РабочийЦентр", РабочийЦентр);
		Запрос.УстановитьПараметр("ВидРЦ", Неопределено);
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			// Попробуем найти по виду рабочего центра
			Запрос.УстановитьПараметр("ВидРЦ", РабочийЦентр.ВидРабочегоЦентра);
			РезультатЗапроса = Запрос.Выполнить();
		КонецЕсли;
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Лико_Дополнительно.ОтметитьВыполнениеЭтапаПлана(ВыборкаДетальныеЗаписи, Ссылка);
		КонецЦикла;
		Если УстановилиПривелигерованныйРежим И ПривилегированныйРежим() Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // <-- Конец Лико Ефимов ЕВВ 07.01.2018 

Процедура ОбработатьЭтапЗаказа()
УстановитьПривилегированныйРежим(Истина);
Если РабочийЦентр.ВидРабочегоЦентра=Справочники.ВидыРабочихЦентров.Indigo  
	Или Организация=Справочники.Лико_ПредопределенныеЗначения.ОрганизацияАвантаж.ЗначениеПараметра Тогда		
	Если Не ЗначениеЗаполнено(ЗаказПокупателя) Или ЗаказПокупателя.Состояние=Перечисления.Лико_СостоянияЗаказов.Закрыт Тогда
		
	Иначе
		 Подготовка=Документы.Лико_ПодготовкаМатериалов.ПолучитьДокумент(ЗаказПокупателя,НомерПроката);
		 Если ТипЗнч(Подготовка)=Тип("ДокументСсылка.Лико_ПодготовкаМатериалов") И Подготовка.НеСниматьРезервПослеЗакрытияБланка Тогда
			Возврат; 
		 КонецЕсли;
		ЗаказОбъект = ЗаказПокупателя.ПолучитьОбъект();
		ЗаказОбъект.Состояние = Перечисления. Лико_СостоянияЗаказов .Выполнен;
		Попытка
			ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись); 
			
		Исключение
			
		КонецПопытки;
		
	КонецЕсли;	
КонецЕсли;
 


УстановитьПривилегированныйРежим(Ложь);


КонецПроцедуры




