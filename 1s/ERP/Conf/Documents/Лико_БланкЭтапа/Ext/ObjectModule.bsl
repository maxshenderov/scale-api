//
Процедура ОтразитьЛико_ПартииКликов(ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	Таблица = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаЛико_ПартииКликов;
	
	Если Отказ Или Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДвиженияЛико_ЛикоПартииКликов = Движения.ЛикоПартииКликов;
	ДвиженияЛико_ЛикоПартииКликов.Записывать = Истина;
	ДвиженияЛико_ЛикоПартииКликов.Загрузить(Таблица);
	
