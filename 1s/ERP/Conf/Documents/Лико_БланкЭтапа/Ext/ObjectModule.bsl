Процедура ОпределитьТипДокументаЗакрытияБланка(BRCОбъектНоменклатуры,ЭтоСборка)
	НоменклатураКоличествоРасход=0;
	
	Для каждого Товар Из Товары Цикл
		Если Товар.Списать Тогда
			Если  BRCОбъектНоменклатуры.Номенклатура<>Товар.Номенклатура Тогда
				НоменклатураКоличествоРасход=НоменклатураКоличествоРасход+1;				
			КонецЕсли;
			Если Не ЗначениеЗаполнено( BRCОбъектНоменклатуры) Тогда
				BRCОбъектНоменклатуры=Товар.Серия.ЯССМ_ОбъектНоменклатуры;
			Иначе
				УпотребитьДо=Товар.Серия.ЯССМ_ОбъектНоменклатуры.УпотребитьДо;
				Если  ЗначениеЗаполнено(УпотребитьДо) и BRCОбъектНоменклатуры.УпотребитьДо>УпотребитьДо Тогда
					BRCОбъектНоменклатуры=Товар.Серия.ЯССМ_ОбъектНоменклатуры;
				КонецЕсли;				   
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла;
	ТзВыпуск=Выпуск.Выгрузить();
	ТзВыпуск.Свернуть("Номенклатура");
	Если НоменклатураКоличествоРасход=1  и 
		ТзВыпуск.Количество()=1 и 
		BRCОбъектНоменклатуры.Номенклатура=ТзВыпуск[0].Номенклатура Тогда
		ЭтоСборка=Истина;
	Иначе
		ЭтоСборка=Ложь;
	КонецЕсли;
	
	Если ВидОперации=Перечисления.Лико_ВидыОперацийЗакрытияБланка.СборкаРазборка Тогда
		ЭтоСборка=Истина; 
	КонецЕсли;
	
	
	
КонецПроцедуры


Процедура ЗаполнитьОбъектыНоменклатурыСборки(BRCОбъектНоменклатуры)
		     	Для каждого СтрВыпуск Из Выпуск Цикл
				ТекОбъектНоменклатуры=СтрВыпуск.Серия.ЯССМ_ОбъектНоменклатуры;				
								
					Если  
						BRCОбъектНоменклатуры.ВидКонтактаСПищевойПродукцией<> ТекОбъектНоменклатуры.ВидКонтактаСПищевойПродукцией Или  
						BRCОбъектНоменклатуры.УпотребитьДо<> ТекОбъектНоменклатуры.УпотребитьДо Или 
						BRCОбъектНоменклатуры.ДатаПроизводства<> ТекОбъектНоменклатуры.ДатаПроизводства Или 
						BRCОбъектНоменклатуры.НомерПартииИзготовления<> ТекОбъектНоменклатуры.НомерПартииИзготовления Тогда
						ОбъектОбъектНоменклатуры									=ТекОбъектНоменклатуры.ПолучитьОбъект();
						ОбъектОбъектНоменклатуры.ВидКонтактаСПищевойПродукцией		= BRCОбъектНоменклатуры.ВидКонтактаСПищевойПродукцией; 
						ОбъектОбъектНоменклатуры.УпотребитьДо						= BRCОбъектНоменклатуры.УпотребитьДо; 
						ОбъектОбъектНоменклатуры.ДатаПроизводства					= BRCОбъектНоменклатуры.ДатаПроизводства; 
						ОбъектОбъектНоменклатуры.НомерПартииИзготовления			= BRCОбъектНоменклатуры.НомерПартииИзготовления;
						ОбъектОбъектНоменклатуры.Записать();
						
					КонецЕсли;					
			КонецЦикла;			

КонецПроцедуры


Процедура ЗаполнитьОбъектыНоменклатурыВыпуска(BRCОбъектНоменклатуры)
	Если  НЕ ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Возврат;
	КонецЕсли;
	УпотребитьДо=ПолучитьСрокГодностиИзЗакрытийБланка();
	Если ЗначениеЗаполнено(УпотребитьДо) И BRCОбъектНоменклатуры.УпотребитьДо>УпотребитьДо Тогда
	Иначе
		УпотребитьДо=BRCОбъектНоменклатуры.УпотребитьДо;
	КонецЕсли;
	
	Для каждого СтрВыпуск Из Выпуск Цикл
		ТекОбъектНоменклатуры=СтрВыпуск.Серия.ЯССМ_ОбъектНоменклатуры;				
		
		Если  
			BRCОбъектНоменклатуры.ВидКонтактаСПищевойПродукцией<> ЗаказПокупателя.ВидКонтактаСПищевойПродукцией Или  
			BRCОбъектНоменклатуры.УпотребитьДо<> УпотребитьДо Или 
			BRCОбъектНоменклатуры.ДатаПроизводства<> Дата Или 
			BRCОбъектНоменклатуры.НомерПартииИзготовления<> ЗаказПокупателя.НомерБезПрефикса Тогда
			ОбъектОбъектНоменклатуры									=ТекОбъектНоменклатуры.ПолучитьОбъект();
			ОбъектОбъектНоменклатуры.УпотребитьДо						= ?(ЗначениеЗаполнено(BRCОбъектНоменклатуры.УпотребитьДо),BRCОбъектНоменклатуры.УпотребитьДо,Дата+(60*60*24*182)); 
			ОбъектОбъектНоменклатуры.ДатаПроизводства					= Дата; 
			ОбъектОбъектНоменклатуры.НомерПартииИзготовления			= ЗаказПокупателя.НомерБезПрефикса;
			ОбъектОбъектНоменклатуры.Записать(); 				
			
		КонецЕсли;					
	КонецЦикла;			
	
КонецПроцедуры


Функция ПолучитьСрокГодностиИзЗакрытийБланка()
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИНИМУМ(Лико_БланкЭтапаТовары.Серия.ЯССМ_ОбъектНоменклатуры.УпотребитьДо) КАК УпотребитьДо
		|ИЗ
		|	Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
		|ГДЕ
		|	Лико_БланкЭтапаТовары.Ссылка.Проведен
		|	И Лико_БланкЭтапаТовары.Ссылка.ЗаказПокупателя = &ЗаказПокупателя
		|	И Лико_БланкЭтапаТовары.Ссылка.НомерПроката = &НомерПроката
		|	И Лико_БланкЭтапаТовары.Ссылка.НомерБланка = &НомерБланка
		|	И Лико_БланкЭтапаТовары.Списать
		|	И Лико_БланкЭтапаТовары.Серия.ЯССМ_ОбъектНоменклатуры.УпотребитьДо <> ДАТАВРЕМЯ(1, 1, 1)";
		Запрос.УстановитьПараметр("ЗаказПокупателя",ЗаказПокупателя );
		Запрос.УстановитьПараметр("НомерПроката",НомерПроката );
		Запрос.УстановитьПараметр("НомерБланка",НомерБланка );

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
		     Возврат Выборка.УпотребитьДо;
		КонецЦикла; 
		
		
КонецФункции






