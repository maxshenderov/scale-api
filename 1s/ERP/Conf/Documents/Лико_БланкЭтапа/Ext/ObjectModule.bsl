Процедура СоздатьРедактироватьСборкаТоваровВерсия1(Распоряжение, ДанныеЗаполнения, РежимЗаписи,Отказ) 
	
	УстановитьПривилегированныйРежим(Истина);
	//Если Не РежимЗаписи=РежимЗаписиДокумента.Проведение Или ДополнительныеСвойства.БылПроведен Тогда
	//	Возврат;
	//КонецЕсли;
	
	Если Не РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	
	РаспоряжениеНаОтгрузку=Неопределено;
	
	ИмяНакладной		="СборкаТоваров";
	ДокументСсылка		=Лико_ОбщегоНазначенияСервер.НайтиДокумент(ИмяНакладной,"Лико_Документ",Ссылка);	
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения.Распоряжение) Тогда
		НовоеРаспоряжение=Распоряжение.ПолучитьОбъект();
		Если НовоеРаспоряжение=Неопределено Тогда
			//НовоеРаспоряжение=Документы.СборкаТоваров.СоздатьДокумент();	
			НовоеРаспоряжение=ДокументСсылка;
		КонецЕсли;  				
	Иначе                   
		
		НовоеРаспоряжение=Неопределено;	
		
	КонецЕсли;
	
	Если НовоеРаспоряжение=Неопределено Тогда
		Если   ЗначениеЗаполнено(ДокументСсылка) Тогда
			НовоеРаспоряжение=ДокументСсылка.ПолучитьОбъект();
		Иначе
			НовоеРаспоряжение=Документы.СборкаТоваров.СоздатьДокумент();	
		КонецЕсли; 		
	КонецЕсли;
	
	
	
	
	
	ЗаполнитьЗначенияСвойств(НовоеРаспоряжение,ДанныеЗаполнения);
	НовоеРаспоряжение.ВариантПриемкиТоваров=Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
	НовоеРаспоряжение.СборкаПодДеятельность=Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	
	НовоеРаспоряжение.Товары.Очистить(); 	
	Для каждого Товар Из ДанныеЗаполнения.Товары Цикл
		НовыйТовар					=НовоеРаспоряжение.Товары.Добавить();
		НовыйТовар.Номенклатура		=Товар.Номенклатура;
		НовыйТовар.Характеристика	=Товар.Характеристика;
		Если ХозяйственнаяОперация=Перечисления.ХозяйственныеОперации.РазборкаТоваров Тогда
			НовыйТовар.Количество		=Товар.КоличествоУУ;
			НовыйТовар.КоличествоУпаковок=Товар.КоличествоУУ;
		Иначе
			НовыйТовар.Количество		 =Товар.КоличествоРасходУУ;
			НовыйТовар.КоличествоУпаковок=Товар.КоличествоРасходУУ;			
		КонецЕсли;
		
		НовыйТовар.ДоляСтоимости=НовыйТовар.Количество*1000;
	КонецЦикла;
	
	Ошибка=Неопределено;
	ОрганизацияСерии=Неопределено;
	Если РабочийЦентр.Лико_ДавальческаяСхема Или ЗначениеЗаполнено(ЗаказНаРаскрой) Тогда
		
		Для каждого Товар Из Товары Цикл
			
			
			Если Товар.Списать Тогда
				ОрганизацияСерии=ОпрделитьОрганизацию(Товар.Серия.ЯССМ_ОбъектНоменклатуры,Дата);
				Прервать;
			КонецЕсли;
			
			
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОрганизацияСерии) ТОгда
		НовоеРаспоряжение.Организация=ОрганизацияСерии;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаказНаРаскрой) Тогда
		НовоеРаспоряжение.Организация=ЗаказНаРаскрой.Организация;
	КонецЕсли;
	НовоеРаспоряжение.Лико_Документ=ДополнительныеСвойства.Ссылка;
	Если ЗначениеЗаполнено(ДатаДляТиповыхДокументов) Тогда
		НовоеРаспоряжение.Дата=ДатаДляТиповыхДокументов; 		
	КонецЕсли;
	


Попытка 				
	НовоеРаспоряжение.Записать(РежимЗаписиДокумента.Проведение); 	
Исключение
	Отказ=Истина;
	Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + Ссылка + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
КонецПопытки;	
Распоряжение=НовоеРаспоряжение.Ссылка;	
УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры 


Процедура СоздатьРедактироватьСписаниеНаРасходы(ДанныеЗаполнения, РежимЗаписи, Отказ)
	УстановитьПривилегированныйРежим(Истина);
	
	
	Если Не РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	
	Распоряжение=Неопределено;
	ИмяНакладной		="ВнутреннееПотребление";
	ДокументСсылка		=Лико_ОбщегоНазначенияСервер.НайтиДокумент(ИмяНакладной,"Лико_Документ",Ссылка);	
	
	
	Если ЗначениеЗаполнено(РаспоряжениеНаОтгрузку) и ТипЗнч(РаспоряжениеНаОтгрузку)=Тип("ДокументСсылка.ВнутреннееПотребление") Тогда
		НовоеРаспоряжение=РаспоряжениеНаОтгрузку.ПолучитьОбъект();
		Если НовоеРаспоряжение=Неопределено Тогда
			НовоеРаспоряжение=Документы.ВнутреннееПотребление.СоздатьДокумент();	
		КонецЕсли;  				
	Иначе
		//НовоеРаспоряжение=Документы.ВнутреннееПотребление.СоздатьДокумент();	
		НовоеРаспоряжение=Неопределено;
	КонецЕсли;
	
	
	Если НовоеРаспоряжение=Неопределено Тогда
		Если   ЗначениеЗаполнено(ДокументСсылка) Тогда
			НовоеРаспоряжение=ДокументСсылка.ПолучитьОбъект();
		Иначе
			НовоеРаспоряжение=Документы.ВнутреннееПотребление.СоздатьДокумент();	
		КонецЕсли; 		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НовоеРаспоряжение,ДанныеЗаполнения);
	
	НовоеРаспоряжение.Товары.Загрузить(ДанныеЗаполнения.Товары); 	
	НовоеРаспоряжение.Лико_Документ=ДополнительныеСвойства.Ссылка;
	
	НовоеРаспоряжение.Товары.Очистить();
	
	Для каждого СтрТовар Из ДанныеЗаполнения.Товары Цикл
		Товар= НовоеРаспоряжение.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Товар,СтрТовар);
		Товар.КоличествоУпаковок=СтрТовар.КоличествоРасходУУ;
		Товар.Количество=СтрТовар.КоличествоРасходУУ;
		Если ЗначениеЗаполнено(Товар.Номенклатура.Лико_СтатьяРасходов) Тогда
			Товар.СтатьяРасходов=Товар.Номенклатура.Лико_СтатьяРасходов;
		Иначе
			Товар.СтатьяРасходов=Справочники.Лико_МастерНастройкиСтатьиРасходаДляНоменклатуры.ОпределитьСтатьюРасходов(Товар.Номенклатура);
			Если Не ЗначениеЗаполнено(Товар.СтатьяРасходов) Тогда
				Товар.СтатьяРасходов=Справочники.Лико_ПредопределенныеЗначения.СтатьяСписанияМатериаловНеопределена.ЗначениеПараметра;  
			КонецЕсли; 				
		КонецЕсли;
		Товар.СтатьяРасходов=ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоНаименованию("1602 тестирование материалов") ;
		Товар.АналитикаРасходов=Справочники.Лико_ПредопределенныеЗначения.АналитикаРасходовСписанияМатериалов.ЗначениеПараметра;
		
	КонецЦикла;
	
	
	
	
	
	Попытка 				
		НовоеРаспоряжение.Записать(РежимЗаписиДокумента.Проведение); 	
	Исключение
		Отказ=Истина;
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Документ """ + Ссылка + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
	КонецПопытки;	
	РаспоряжениеНаОтгрузку=НовоеРаспоряжение.Ссылка;	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


