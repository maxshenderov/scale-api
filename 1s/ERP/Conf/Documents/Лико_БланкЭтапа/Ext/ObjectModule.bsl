	|ВЫБРАТЬ
	|	Вт.Ссылка КАК Ссылка,
	|	МИНИМУМ(Лико_БланкЭтапаТовары.Серия.ЯССМ_ОбъектНоменклатуры.ДатаФормирования) КАК Дата
	|ИЗ
	|	Вт КАК Вт
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
	|		ПО Вт.Ссылка = Лико_БланкЭтапаТовары.Ссылка
	|ГДЕ
	|	Лико_БланкЭтапаТовары.Списать
	|	И Лико_БланкЭтапаТовары.Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	Вт.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	Запрос.УстановитьПараметр("Ссылка",Ссылка );
	
	Запрос.УстановитьПараметр("ВидНоменклатуры",Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыДляХраненияХарактеристикНарезки.ЗначениеПараметра );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Для каждого СтрВыпуск Из Выборка.Ссылка.Выпуск  Цикл
			
			ОбъектНоменклатуры=СтрВыпуск.Серия.ЯССМ_ОбъектНоменклатуры;
			Если  ОбъектНоменклатуры.ДатаФормирования<>Выборка.Дата Тогда
				СправочникОбъект= ОбъектНоменклатуры.ПолучитьОбъект();
				СправочникОбъект.ДатаФормирования=Выборка.Дата;
				СправочникОбъект.Записать();
			КонецЕсли;
		КонецЦикла;
		
		
	КонецЦикла; 
	
КонецПроцедуры




