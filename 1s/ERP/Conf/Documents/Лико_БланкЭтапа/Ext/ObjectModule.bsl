		НовыйТовар.ДоляСтоимости=НовыйТовар.Количество*1000;
	КонецЦикла;
	НаборЗаписей = РегистрыСведений.Лико_ОшибкиЗакрытияБланков.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЗакрытиеБланка.Установить(Ссылка);
	
	НоваяЗапись=НаборЗаписей.Добавить();
	НоваяЗапись.ЗакрытиеБланка=Ссылка;
	НаборЗаписей.Записать();
	
	НовоеРаспоряжение.Записать(); 
	
	Ошибка=Неопределено;
	Попытка 				
