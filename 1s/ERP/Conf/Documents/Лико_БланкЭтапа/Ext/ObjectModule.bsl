Процедура СоздатьРедактироватьЭтап(Отказ)
	Если Отказ Тогда
		Возврат; 
	КонецЕсли;
	НовыйДокОбъект = Документы.ЭтапПроизводства2_2.СоздатьДокумент(); 
	
	
	РаспоряжениеЗаказ    	= Лико_Дополнительно.НайтиЗаказНаПроизводствоПоЗаказуКлиента(ЗаказПокупателя);
	Если РаспоряжениеЗаказ 	= Неопределено Тогда
		Отказ 				= Истина;
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не найден заказ на производство для заказа клиента """ + ЗаказПокупателя + """! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());
		Возврат ;
	КонецЕсли;
	
	ВыпускающийЭтап = Документы.ЭтапПроизводства2_2.ПустаяСсылка();
	Потребность     = Неопределено;
	
	ДанныеОснования = Документы.ЭтапПроизводства2_2.ДанныеЗаполненияДляМодификацииЦепочки(ВыпускающийЭтап, РаспоряжениеЗаказ, Потребность);
	НомерЭтапаВПартииЗапуска = ДанныеОснования.ЗначенияЗаполнения.НомерЭтапаВПартииЗапуска;
	
	ЗначенияЗаполнения = Новый Структура(ДанныеОснования.ОбщиеРеквизиты);
	ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, ДанныеОснования.ЗначенияЗаполнения);
	ЗначенияЗаполнения.Вставить("НомерЭтапа", 1);
	ЗначенияЗаполнения.Вставить("НомерСледующегоЭтапа", 0);
	ЗначенияЗаполнения.Вставить("НаименованиеЭтапа", "Печать");
	ЗначенияЗаполнения.Вставить("Подразделение",     Подразделение);
	ЗначенияЗаполнения.Вставить("СсылкаНового", Документы.ЭтапПроизводства2_2.ПолучитьСсылку());
	ЗначенияЗаполнения.Вставить("НомерПартииЗапуска", ДанныеОснования.ЗначенияЗаполнения.НомерПартииЗапуска);
	ЗначенияЗаполнения.Вставить("НомерЭтапаВПартииЗапуска", НомерЭтапаВПартииЗапуска);
	ЗначенияЗаполнения.Вставить("ВыпускающийЭтап", Документы.ЭтапПроизводства2_2.ПолучитьСсылку());
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ДанныеЗаполнения.Вставить("СпособЗаполнения", "ЗаполнитьПоДаннымПользователя");
	
	
	
	НовыйДокОбъект.Заполнить(ДанныеЗаполнения);
	НовыйДокОбъект.Дата 						=Дата;
	НовыйДокОбъект.Лико_РабочийЦентр			=РабочийЦентр;
	НовыйДокОбъект.Статус 						=Перечисления.СтатусыЭтаповПроизводства2_2.Завершен;
	НовыйДокОбъект.Выполнено 					=НовыйДокОбъект.Запланировано;
	НовыйДокОбъект.ФактическоеНачалоЭтапа 		=НовыйДокОбъект.Дата;
	НовыйДокОбъект.ФактическоеОкончаниеЭтапа 	=НовыйДокОбъект.Дата;
	НовыйДокОбъект.ДатаПроизводства 			=НовыйДокОбъект.Дата;
