Функция ПолучитьПараметрыШтампа() //+Лико m.shenderov 14.02.2021
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_ПараметрыШтампа.Номенклатура КАК Номенклатура,
		|	Лико_ПараметрыШтампа.ВидРабот КАК ВидРабот,
		|	Лико_ПараметрыШтампа.D3 КАК D3,
		|	НоменклатураДополнительныеРеквизиты.Значение КАК ОстасткаВидШтампа
		|ИЗ
		|	РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		|		ПО Лико_ПараметрыШтампа.Номенклатура = НоменклатураДополнительныеРеквизиты.Ссылка
		|			И (НоменклатураДополнительныеРеквизиты.Свойство.Имя = ""ОстасткаВидШтампа"")
		|ГДЕ
		|	Лико_ПараметрыШтампа.Номенклатура В(&Номенклатура)
		|	И Лико_ПараметрыШтампа.ВидРабот <> ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ПустаяСсылка)";
		Запрос.УстановитьПараметр("Номенклатура",Выпуск.ВыгрузитьКолонку("Номенклатура"));
		Возврат Запрос.Выполнить().Выгрузить();
		
	
