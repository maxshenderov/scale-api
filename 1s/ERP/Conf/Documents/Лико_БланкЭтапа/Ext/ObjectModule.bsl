Процедура ЗаполнитьСклады(Отказ, РежимЗаписи)

	Если Отказ 
		Или  РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда

		Возврат; 

	КонецЕсли;     




	МассивАдресов = Новый Массив(); 

	РцЯчейка = РабочийЦентр.ЛикоЯчейка;
	Обработки.ПеремещениеТоваровДоп.КорректировкаЯчейкиРабочегоЦентра(Организация, Дата,РцЯчейка); 

	МассивАдресов.Добавить(РцЯчейка); 
	МассивАдресов.Добавить(ЗонаПриемки);


	Для каждого Товар Из  Товары Цикл 

		Товар.СкладОтправитель = Неопределено;
		Товар.СкладПолучатель = Неопределено;


		Если Товар.Списать  Тогда

			Если ЗначениеЗаполнено(Товар.АдресХранения) И МассивАдресов.Найти(Товар.АдресХранения)=Неопределено Тогда
				МассивАдресов.Добавить(Товар.АдресХранения); 
			КонецЕсли;

			Если ЗначениеЗаполнено(Товар.РабочийЦентр) Тогда 

				Ячейка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Товар.РабочийЦентр,"ЛикоЯчейка");
				Обработки.ПеремещениеТоваровДоп.КорректировкаЯчейкиРабочегоЦентра(Организация, Дата,Ячейка);

				Если ЗначениеЗаполнено(Ячейка)
					И МассивАдресов.Найти(Ячейка)=Неопределено Тогда 

					МассивАдресов.Добавить(Ячейка);

				КонецЕсли;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СкладскиеЯчейки.Ссылка КАК Ссылка,
	|	СкладскиеЯчейки.Владелец КАК Владелец,
	|	СкладскиеЯчейки.Помещение КАК Помещение
	|ИЗ
	|	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
	|ГДЕ
	|	СкладскиеЯчейки.Ссылка В(&МассивАдресов)";
	Запрос.УстановитьПараметр("МассивАдресов",МассивАдресов );
	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();
	СооАдресов = Новый Соответствие;

	Пока Выборка.Следующий() Цикл

		СооАдресов.Вставить(Выборка.Ссылка,Выборка.Владелец);

	КонецЦикла; 

	ЕстьМатериалСписания = Ложь;

	МассивСкладов = Новый Массив();

	Для каждого Товар Из  Товары Цикл

		Если Товар.Списать  Тогда 

			ЕстьМатериалСписания = Истина;

			лСклад = Неопределено;

			//Ячейка = РабочийЦентр.ЛикоЯчейка;
			// Обработки.ПеремещениеТоваровДоп.КорректировкаЯчейкиРабочегоЦентра(Организация, Дата,Ячейка);

			Если ЗначениеЗаполнено(РцЯчейка) Тогда

				лСклад = СооАдресов[РцЯчейка]; 

			КонецЕсли;



			Если ЗначениеЗаполнено(Товар.РабочийЦентр) Тогда
				Ячейка = Товар.РабочийЦентр.ЛикоЯчейка;
				Обработки.ПеремещениеТоваровДоп.КорректировкаЯчейкиРабочегоЦентра(Организация, Дата,Ячейка);

				лСклад = СооАдресов[Ячейка]; 

			КонецЕсли; 

			Если ЗначениеЗаполнено(Товар.АдресХранения) Тогда

				лСклад = СооАдресов[Товар.АдресХранения]; 

			КонецЕсли;


			Если ЗначениеЗаполнено(лСклад)
				И МассивСкладов.Найти(лСклад) = Неопределено Тогда

				МассивСкладов.Добавить(лСклад); 

			КонецЕсли;



			Если  Товар.ВозвратКоличество>0 Тогда

				Если ЗначениеЗаполнено(РцЯчейка) Тогда

					Товар.СкладОтправитель = СооАдресов[РцЯчейка]; 

				КонецЕсли;

				Если ЗначениеЗаполнено(Товар.РабочийЦентр) Тогда

					Ячейка = Товар.РабочийЦентр.ЛикоЯчейка;
					Обработки.ПеремещениеТоваровДоп.КорректировкаЯчейкиРабочегоЦентра(Организация, Дата,Ячейка);

					Товар.СкладОтправитель = СооАдресов[Ячейка]; 

				КонецЕсли; 

				Если ЗначениеЗаполнено(Товар.АдресХранения) Тогда

					Товар.СкладОтправитель = СооАдресов[Товар.АдресХранения]; 

				КонецЕсли;
				Если РежимЗакрытия = Перечисления.Лико_РежимЗакрытияЗаказа.ПереместитьНаСклад 
					 И Не ОставитьНаРабочемЦентреСырье  Тогда


					Товар.СкладПолучатель = СооАдресов[ЗонаПриемки];
				Иначе

					Товар.СкладПолучатель = Товар.СкладОтправитель;

				КонецЕсли;

			КонецЕсли;
		КонецЕсли;

	КонецЦикла; 


	Структура = Новый Структура; 		
	Лико_ОбщегоНазначенияСервер.РеквизитыШапки(Структура); 
	Склад = Структура.Склад;
	Помещение = Структура.Помещение;
	Если МассивСкладов.Количество()>1 Тогда
		Отказ = Истина;
		Сообщить("Нельзя использовать материалы в одном документе, хранящиеся на разных складах.");
	ИначеЕсли МассивСкладов.Количество()=0 Тогда

		Если ЕстьМатериалСписания Тогда
			Сообщить("Склад не опрделен.");
		КонецЕсли; 

	Иначе
		Если Склад <> МассивСкладов[0] Тогда
			Склад = МассивСкладов[0];
			Помещение = Неопределено;

		КонецЕсли;

	КонецЕсли;

	СкладОтправитель = Неопределено;
	СкладПолучатель = Неопределено;

	Если ЗначениеЗаполнено(РцЯчейка) Тогда

		СкладОтправитель = СооАдресов[РцЯчейка]; 
		СкладПолучатель = СооАдресов[РцЯчейка]; 			 
	КонецЕсли;

	Если РежимЗакрытия = Перечисления.Лико_РежимЗакрытияЗаказа.ПереместитьНаСклад Тогда
		СкладПолучатель = СооАдресов[ЗонаПриемки]; 
	КонецЕсли;



	Для каждого СтрВыпуск Из Выпуск  Цикл

		СтрВыпуск.СкладОтправитель = СкладОтправитель;
		СтрВыпуск.СкладПолучатель = СкладПолучатель; 

	КонецЦикла;
	
	//Это только выпуск без расхода метериала!->
	Если МассивСкладов.Количество()=0 И  СкладПолучатель<>Склад Тогда
		
		Склад =СкладПолучатель;
		Помещение = Неопределено;
		
	КонецЕсли;
	//Это только выпуск без расхода метериала!<-

		


КонецПроцедуры


