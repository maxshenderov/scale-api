	|	РегистрНакопления.Лико_СписаниеНаЗаказ.Остатки(, ЗаказКлиента = &ЗаказКлиента) КАК Лико_СписаниеНаЗаказОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				&КонецМесяца,
	|				Склад = &Склад
	|					И (Номенклатура, Характеристика, Серия) В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							Лико_СписаниеНаЗаказОстатки.Номенклатура КАК Номенклатура,
	|							Лико_СписаниеНаЗаказОстатки.Характеристика КАК Характеристика,
	|							Лико_СписаниеНаЗаказОстатки.Серия КАК Серия
	|						ИЗ
	|							РегистрНакопления.Лико_СписаниеНаЗаказ.Остатки(, ЗаказКлиента = &ЗаказКлиента) КАК Лико_СписаниеНаЗаказОстатки)) КАК ТоварыНаСкладахОстатки
	|		ПО Лико_СписаниеНаЗаказОстатки.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
	|			И Лико_СписаниеНаЗаказОстатки.Характеристика = ТоварыНаСкладахОстатки.Характеристика
	|			И Лико_СписаниеНаЗаказОстатки.Серия = ТоварыНаСкладахОстатки.Серия
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(&Распоряжение) = ТИП(Документ.ЭтапПроизводства2_2)
	|	И ГОД(&Период) < 2020
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВтСписаниеОснастки.Ссылка,
	|	ВтСписаниеОснастки.Номенклатура,
	|	ВтСписаниеОснастки.Характеристика,
	|	ВтСписаниеОснастки.Назначение,
	|	ВтСписаниеОснастки.Серия,
	|	ВтСписаниеОснастки.СтатусУказанияСерий,
	|	ВтСписаниеОснастки.Количество,
	|	ВтСписаниеОснастки.КоличествоБУ,
	|	ВтСписаниеОснастки.МожноСписать,
	|	ВтСписаниеОснастки.ВидРабот,
	|	ИСТИНА,
	|	&НеСписыватьОснастку
	|ИЗ
	|	ВтСписаниеОснастки КАК ВтСписаниеОснастки
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(&Распоряжение) = ТИП(Документ.ЭтапПроизводства2_2)
	|	И ГОД(&Период) >= 2020";
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;



КонецФункции


Функция ТекстЗапросаВтСписаниеОснастки(Запрос, ТекстыЗапроса)
	ИмяРегистра = "ВтСписаниеОснастки";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Ссылка КАК Ссылка,
	|	втСписаниеОснастки.Номенклатура КАК Номенклатура,
	|	втСписаниеОснастки.Характеристика КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение,
	|	втСписаниеОснастки.Серия КАК Серия,
	|	ВЫБОР
	|		КОГДА втСписаниеОснастки.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.Пустаяссылка)
	|			ТОГДА 0
	|		ИНАЧЕ 8
	|	КОНЕЦ КАК СтатусУказанияСерий,
	|	втСписаниеОснастки.Количество КАК Количество,
	|	втСписаниеОснастки.Количество КАК КоличествоБУ,
	|	ВЫБОР
	|		КОГДА втСписаниеОснастки.Количество > 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК МожноСписать,
	|	втСписаниеОснастки.ВидРабот КАК ВидРабот,
	|	ИСТИНА КАК ДопРасход
	|ПОМЕСТИТЬ ВтСписаниеОснастки
	|ИЗ
	|	&ТзСписаниеОснастки КАК втСписаниеОснастки
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(&Распоряжение) = ТИП(Документ.ЭтапПроизводства2_2)";
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;
	
	
	
КонецФункции

Функция ТекстЗапросаТаблицаДвиженияЛико_РаскройМатериаловПланФакт(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "Лико_РаскройМатериаловПланФакт";
	
	Если Не ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	Лико_БланкЭтапаТовары.Ссылка.ЗаказНаРаскрой КАК Заказ,
	|	СУММА(Лико_БланкЭтапаТовары.КоличествоРасход) КАК Количество
	|ИЗ
	|	Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
	|ГДЕ
	|	Лико_БланкЭтапаТовары.Ссылка = &Ссылка
	|	И Лико_БланкЭтапаТовары.Списать
	|	И Лико_БланкЭтапаТовары.Ссылка.ЗаказНаРаскрой <> ЗНАЧЕНИЕ(Документ.Лико_ЗаказНаРаскрой.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_БланкЭтапаТовары.Ссылка.ЗаказНаРаскрой";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции



