	КонецЕсли;
	Запрос.УстановитьПараметр("ЭтоПеремотка", ЭтоПеремотка);
	
	
	// Если в соглашении указаны особые правила учета товаров к поступлению.
	Если Реквизиты.ЗакрыватьГрафикПоступления Тогда
		Если ТипЗнч(Реквизиты.Распоряжение) = Тип("СправочникСсылка.СоглашенияСПоставщиками") Тогда
			Запрос.УстановитьПараметр("РаспоряжениеДляГрафика", Справочники.СоглашенияСПоставщиками.ПолучитьДокументРегистрации(Реквизиты.Распоряжение));
		Иначе
			Запрос.УстановитьПараметр("РаспоряжениеДляГрафика", Реквизиты.Распоряжение);
		КонецЕсли;
	Иначе
		Запрос.УстановитьПараметр("РаспоряжениеДляГрафика",  Реквизиты.Распоряжение);
	КонецЕсли;
	//Распределение краски через колористическую	
	ЦеховаяКладоваяКраски=УправлениеСвойствами.ЗначениеСвойства(ДокументСсылка.Организация,"Лико_Колористическая");
	СписаниеКраскиЧерезЦеховуюКладовую=ЗначениеЗаполнено(ЦеховаяКладоваяКраски)
	и Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаСписаниеКраскиЧерезЦеховуюКладовую.ЗначениеПараметра<ДокументСсылка.Дата
	и Не ЗначениеЗаполнено(ДокументСсылка.ХозяйственнаяОперация);
	Если СписаниеКраскиЧерезЦеховуюКладовую	Тогда
		РаспоряжениеНаКраску=СоздатьПолучитьРаспоряжениеНаКраску(ДокументСсылка);
	Иначе
		РаспоряжениеНаКраску=Документы.ЗаказМатериаловВПроизводство.ПустаяСсылка();
	КонецЕсли;
	Запрос.УстановитьПараметр("СписаниеКраскиЧерезЦеховуюКладовую",СписаниеКраскиЧерезЦеховуюКладовую);
	Запрос.УстановитьПараметр("ЦеховаяКладоваяКраски",ЦеховаяКладоваяКраски);
	Запрос.УстановитьПараметр("СписаниеКраскиЧерезЦеховуюКладовую",СписаниеКраскиЧерезЦеховуюКладовую);
	Запрос.УстановитьПараметр("РаспоряжениеНаКраску",РаспоряжениеНаКраску);
	Запрос.УстановитьПараметр("ВидНоменклатурыКраска",Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыКраска.ЗначениеПараметра);
	Запрос.УстановитьПараметр("ТзСписаниеОснастки",СформироватьТзСписаниеОснастки(ДокументСсылка));
	
	
	
КонецПроцедуры



Функция ТекстЗапросаТаблицаТоварыКПоступлению(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ТоварыКПоступлению";
	
	Если Не ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ПроведениеДокументов.ЕстьТаблицаЗапроса("ВтТаблицаТовары", ТекстыЗапроса) Тогда
		ТекстЗапросаВтТаблицаТовары(Запрос, ТекстыЗапроса);
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
