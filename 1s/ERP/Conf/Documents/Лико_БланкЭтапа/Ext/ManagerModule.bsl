Процедура ЗаполнениеЗакрытияБланкаВОбъектеНоменклатуры(ЗакрытиеБланка) Экспорт 
	//ЗакрытиеБланка=Документы.Лико_БланкЭтапа.СоздатьДокумент();
	УстановитьПривилегированныйРежим(Истина);
	Для каждого Выпуск Из ЗакрытиеБланка.Выпуск Цикл
		ОбъектНоменклатуры= Выпуск.Серия.ЯССМ_ОбъектНоменклатуры;
		Если ЗакрытиеБланка.Проведен и ОбъектНоменклатуры.ЗакрытиеБланка<>ЗакрытиеБланка Тогда
			ОбъектНоменклатурыОбъект=ОбъектНоменклатуры.ПолучитьОбъект();
			ОбъектНоменклатурыОбъект.ЗакрытиеБланка=ЗакрытиеБланка;
			ОбъектНоменклатурыОбъект.НомерЗаказаКлиента=ЗакрытиеБланка.ЗаказПокупателя.НомерБезПрефикса;
			ОбъектНоменклатурыОбъект.НомерБланка=ЗакрытиеБланка.НомерБланка;
			ОбъектНоменклатурыОбъект.Ответственный=ЗакрытиеБланка.Сотрудник.ФизическоеЛицо;


			Если ЗначениеЗаполнено(ЗакрытиеБланка.ЗаказНаРаскрой) И Не ЗначениеЗаполнено(ЗакрытиеБланка.ЗаказПокупателя) Тогда
				ОбъектНоменклатурыОбъект.НомерЗаказаКлиента=Число(Прав(ЗакрытиеБланка.ЗаказНаРаскрой.Номер,6));
				Если ЗначениеЗаполнено(ЗакрытиеБланка.ЗаказНаРаскрой.ЗаказКлиента) Тогда
					ОбъектНоменклатурыОбъект.НомерЗаказаКлиента=ЗакрытиеБланка.ЗаказНаРаскрой.ЗаказКиента.НомерБезПрефикса;	
				КонецЕсли;
				
			КонецЕсли;


			ОбъектНоменклатурыОбъект.Записать();

		КонецЕсли;



	КонецЦикла;


КонецПроцедуры


Функция СоздатьОбъектыНоменклатуры(ЗаказКлиента,НомерБланка,Нарезка,Втулка,АвторДокумента,КоличествоРоликов=1,СерийныйНомер="", ПараметрыДляРоликовПослеПеремотки = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	НомерЗаказа=ЗаказКлиента.НомерБезПрефикса;
	//ЗаказКлиента=Лико_Дополнительно.НайтиДокументПоНомеру7Символов(НомерЗаказа,"ЗаказКлиента");
	МенеджерЗаказа=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ЗаказКлиента,"Менеджер");
	МассивСозданныхОбъектов = Новый Массив; 		
	// Ищем номенклатуру
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗначенияСвойствОбъектов.Объект КАК Характеристика
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЗначенияСвойствЗаказ.Объект КАК ХарактеристкиСЗаказом
	|		ИЗ
	|			РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствЗаказ
	|		ГДЕ
	|			ЗначенияСвойствЗаказ.Свойство В
	|					(ВЫБРАТЬ ПЕРВЫЕ 1
	|						СвойстваОбъектовЗаказ.Ссылка КАК Ссылка
	|					ИЗ
	|						ПланВидовХарактеристик.СвойстваОбъектов КАК СвойстваОбъектовЗаказ
	|					ГДЕ
	|						СвойстваОбъектовЗаказ.Наименование = &НаименованиеСвовоЗаказ)
	|			И ЗначенияСвойствЗаказ.Значение = &NЗаказ) КАК ВложенныйЗапрос
	|		ПО ЗначенияСвойствОбъектов.Объект = ВложенныйЗапрос.ХарактеристкиСЗаказом
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Свойство В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				СвойстваОбъектовЗаказ.Ссылка КАК Ссылка
	|			ИЗ
	|				ПланВидовХарактеристик.СвойстваОбъектов КАК СвойстваОбъектовЗаказ
	|			ГДЕ
	|				СвойстваОбъектовЗаказ.Наименование = &НаименованиеСвовоХарактеристика)
	|	И ЗначенияСвойствОбъектов.Значение = ИСТИНА
	|	И ЗначенияСвойствОбъектов.Объект.Владелец.ВидНоменклатуры = &Полуфабрикат
	|	И ЗначенияСвойствОбъектов.Объект.Владелец.Наименование ПОДОБНО &Название";
	
	Запрос.Текст ="ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
	|	ХарактеристикиНоменклатуры.Владелец КАК Номенклатура
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Лико_ЗаказНоменклатуры = &Заказ
	|	И ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры = &ВидНоменклатуры";
	
	Запрос.УстановитьПараметр("Заказ",ЗаказКлиента);
	Запрос.УстановитьПараметр("ВидНоменклатуры", Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	НоменклатураНезавершенка = Неопределено;
	ХарактеристикаНезавершенка = Неопределено;
	
	//=--------- создаем незавершенку -----
	РодительНезавершенкаНоменклатура = Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра;
	РодительНезавершенка = Справочники.Лико_ПредопределенныеЗначения.ГруппаОбъектовНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра;
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		ВыборкаЗапроса.Следующий();
		
		ХарактеристикаНезавершенка = ВыборкаЗапроса.Характеристика;
		НоменклатураНезавершенка = ХарактеристикаНезавершенка.Владелец;
	Иначе 	//запрос пуст!
		
		Если ЗначениеЗаполнено(МенеджерЗаказа) Тогда
			ФИО = МенеджерЗаказа.Наименование;
			Фамилия		= ВыделитьСлово(ФИО);
			Имя			= ВыделитьСлово(ФИО);
			Отчество	= ВыделитьСлово(ФИО);
			ФИОСтрока = Фамилия+" "+Лев(имя,1)+"."+Лев(Отчество,1)+".";
		Иначе
			ФИОСтрока = "";
		КонецЕсли;
		//---------=
		
		Номенклатура1С = Справочники.Номенклатура.СоздатьЭлемент();
		Номенклатура1С.УстановитьНовыйКод("n");
		Номенклатура1С.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра;
		Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Номенклатура1С);
		
		Номенклатура1С.Наименование = "Незавершенное производство по заказу №" + Формат(НомерЗаказа, "ЧГ=0") + " (" + ФИОСтрока + ")";
		Номенклатура1С.НаименованиеПолное = Номенклатура1С.Наименование;
		
		Если Не РодительНезавершенкаНоменклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
			Номенклатура1С.Родитель = РодительНезавершенкаНоменклатура;			
			
		Иначе
			
		КонецЕсли;
		Номенклатура1С.Записать();
		
		НоменклатураНезавершенка = Номенклатура1С.Ссылка;
		
		ХарактеристикаНезавершенкаОбъект=Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
		ХарактеристикаНезавершенкаОбъект.Владелец=НоменклатураНезавершенка;
		ХарактеристикаНезавершенкаОбъект.Лико_ЗаказНоменклатуры=ЗаказКлиента;
		ХарактеристикаНезавершенкаОбъект.Записать();
		ХарактеристикаНезавершенка=ХарактеристикаНезавершенкаОбъект.Ссылка;
	КонецЕсли;
	
	Если НоменклатураНезавершенка<>Неопределено И ХарактеристикаНезавершенка<>Неопределено Тогда
		//=--------- Создание объектов номенклатуры -----
		Для Счетчик=1 По КоличествоРоликов Цикл
			
			
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Номенклатура"			,НоменклатураНезавершенка);
			СтруктураПараметров.Вставить("Родитель"				,РодительНезавершенка);
			СтруктураПараметров.Вставить("Характеристика"		,ХарактеристикаНезавершенка);
			СтруктураПараметров.Вставить("Нарезка"				,Нарезка);
			СтруктураПараметров.Вставить("Втулка"				,Втулка);
			СтруктураПараметров.Вставить("Количество"			,0);
			СтруктураПараметров.Вставить("Упаковка"				,?(ЗначениеЗаполнено(Нарезка), Справочники.ЯССМ_Нарезки.УпаковкаПоНарезке(Нарезка), Неопределено)); // --> Начало Лико Ефимов ЕВВ 25.08.2025 дописал условие по заполненности нарезки
			СтруктураПараметров.Вставить("Уникальный"			,Истина);
			СтруктураПараметров.Вставить("НомерЗаказаКлиента"	,НомерЗаказа);
			СтруктураПараметров.Вставить("НомерБланка"			,НомерБланка);
			СтруктураПараметров.Вставить("СерийныйНомер"		,СерийныйНомер);
			СтруктураПараметров.Вставить("Комментарий"			,"");
			СтруктураПараметров.Вставить("Ответственный"			,АвторДокумента);
			СтруктураПараметров.Вставить("Рулонный"				,Истина);
			// --> Начало Лико Ефимов ЕВВ 15.12.2021
			СтруктураПараметров.Вставить("ЗаказКлиента"			,ЗаказКлиента);
			// <-- Конец Лико Ефимов ЕВВ 15.12.2021
			// --> Начало Лико Ефимов ЕВВ 25.07.2025
			Если ПараметрыДляРоликовПослеПеремотки <> Неопределено Тогда
				СтруктураПараметров.Вставить("КоличествоВРоликеПослеПеремотки", ПараметрыДляРоликовПослеПеремотки.КоличествоВРоликеПослеПеремотки);
				СтруктураПараметров.Вставить("СтатусРоликаПослеПеремотки", ПараметрыДляРоликовПослеПеремотки.СтатусРоликаПослеПеремотки);
				СтруктураПараметров.Вставить("СоставРоликаПослеПеремотки", ПараметрыДляРоликовПослеПеремотки.СоставРоликаПослеПеремотки); 
				СтруктураПараметров.Вставить("НомерСтрокиЗаказаВРоликеПослеПеремотки", ПараметрыДляРоликовПослеПеремотки.НомерСтрокиЗаказаВРоликеПослеПеремотки); 
				СтруктураПараметров.Вставить("РабочийЦентрВыпускаВРоликеПослеПеремотки", ПараметрыДляРоликовПослеПеремотки.РабочийЦентрВыпускаВРоликеПослеПеремотки); 
				СтруктураПараметров.Вставить("СтруктураРастарки", ПараметрыДляРоликовПослеПеремотки.СтруктураРастарки); 
			КонецЕсли;
			// <-- Конец Лико Ефимов ЕВВ 25.07.2025
			НовыйЭлемент=Справочники.ЯССМ_ОбъектыНоменклатуры.СоздатьОбъектНоменклатуры(СтруктураПараметров);	
			
			МассивСозданныхОбъектов.Добавить(НовыйЭлемент.Ссылка);
		КонецЦикла;
		
	Иначе
		Сообщить("Не удалось создать незавершенку!");
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);

	КоличествоРоликов = 1;
	
	Возврат МассивСозданныхОбъектов;
	
КонецФункции //СоздатьОбъектыНоменклатуры 

/// Функция выделяет первое слово в предложении
Функция ВыделитьСлово(ИсходнаяСтрока) Экспорт
	
	Буфер = СокрЛ(ИсходнаяСтрока);
	ПозицияПослПробела = Найти(Буфер, " ");
	
	Если ПозицияПослПробела = 0 Тогда
		ИсходнаяСтрока = "";
		Возврат Буфер;
	КонецЕсли;
	
	ВыделенноеСлово = СокрЛП(Лев(Буфер, ПозицияПослПробела));
	ИсходнаяСтрока = Сред(ИсходнаяСтрока, ПозицияПослПробела + 1);
	
	Возврат ВыделенноеСлово;
	
КонецФункции

Функция СоздатьПолучитьРаспоряжениеНаКраску(ДокументСсылка);
	Если ДокументСсылка.ВидОперации<>Перечисления.Лико_ВидыОперацийЗакрытияБланка.ЗакрытиеБланка Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЗаказМатериаловВПроизводство=Неопределено;	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказМатериаловВПроизводство.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказМатериаловВПроизводство КАК ЗаказМатериаловВПроизводство
	|ГДЕ
	|	ЗаказМатериаловВПроизводство.Лико_Документ = &Лико_Документ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказМатериаловВПроизводство.Дата";
	Запрос.УстановитьПараметр("Лико_Документ",ДокументСсылка);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаказМатериаловВПроизводство=Выборка.Ссылка;
	КонецЦикла;
	Колористическая=УправлениеСвойствами.ЗначениеСвойства(ДокументСсылка.Организация,"Лико_Колористическая");
	Если ЗаказМатериаловВПроизводство=Неопределено И 
		ЗначениеЗаполнено(Колористическая) Тогда
		НовоеРаспоряжение							=	Документы.ЗаказМатериаловВПроизводство.СоздатьДокумент();	
		НовоеРаспоряжение.Дата						=	ДокументСсылка.Дата;
		НовоеРаспоряжение.Организация				=	ДокументСсылка.Организация;
		НовоеРаспоряжение.Подразделение				=	ДокументСсылка.Подразделение;
		НовоеРаспоряжение.ЦеховаяКладовая			=	Колористическая;
		НовоеРаспоряжение.Склад						=	ДокументСсылка.Склад;
		НовоеРаспоряжение.ДатаОтгрузки				=	ДокументСсылка.Дата;
		НовоеРаспоряжение.УправлениеПроизводством2_2=	Истина;
		НовоеРаспоряжение.Статус					=	Перечисления.СтатусыЗаказовМатериаловВПроизводство.КВыполнению;
		НовоеРаспоряжение.ХозяйственнаяОперация		=	Перечисления.ХозяйственныеОперации.ПередачаМатериаловВКладовую; 	
		НовоеРаспоряжение.Комментарий				=	"Создан в проведении документа: "+ Выборка.Ссылка; 
		НовоеРаспоряжение.Лико_Документ				=	ДокументСсылка;
		НовоеРаспоряжение.Записать(РежимЗаписиДокумента.Запись);
		ЗаказМатериаловВПроизводство=НовоеРаспоряжение.Ссылка; 	
	КонецЕсли; 	
	Возврат ЗаказМатериаловВПроизводство;	
КонецФункции //-Лико m.shenderov 30.05.2019 


Функция СформироватьТзСписаниеОснастки(ЗакрытеБланкаСсылка)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДвижениеПродукцииИМатериалов.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ДвижениеПродукцииИМатериалов КАК ДвижениеПродукцииИМатериалов
	|ГДЕ
	|	ДвижениеПродукцииИМатериалов.Лико_Документ = &Лико_Документ";
	Запрос.УстановитьПараметр("Лико_Документ",ЗакрытеБланкаСсылка );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса .Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыНакопления.ТоварыНаСкладах.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Ссылка);		
		НаборЗаписей.Записать();

	КонецЦикла; 


	ТЗ = Новый ТаблицаЗначений;
	Тз.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Тз.Колонки.Добавить("Характеристика",Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Тз.Колонки.Добавить("Серия",Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	Тз.Колонки.Добавить("ВидРабот",Новый ОписаниеТипов("СправочникСсылка.ВидыРаботСотрудников"));

	Тз.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой)));
	Если ЗакрытеБланкаСсылка.Организация=Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра Тогда
		Возврат ТЗ;
	КонецЕсли;
	Запрос = Новый Запрос;

	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказКлиентаЦвета.Оснастка КАК Номенклатура,
	|	1 КАК Количество,
	|	ЗаказКлиентаЦвета.ВидСекции.ВидРабот КАК ВидРабот
	|ПОМЕСТИТЬ Оснастка
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	|ГДЕ
	|	ЗаказКлиентаЦвета.Оснастка <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И ЗаказКлиентаЦвета.Ссылка = &Заказ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказКлиентаЦвета.Вал,
	|	1,
	|	ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Печать)
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	|ГДЕ
	|	ЗаказКлиентаЦвета.Ссылка = &Заказ
	|	И ЗаказКлиентаЦвета.Вал <> ЗНАЧЕНИЕ(справочник.Номенклатура.Пустаяссылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Осн.Номенклатура КАК Номенклатура,
	|	Осн.Количество КАК Количество,
	|	Лико_ЗакрытиеБланка.Регистратор КАК Регистратор,
	|	Осн.ВидРабот КАК ВидРабот
	|ПОМЕСТИТЬ Оснастка2
	|ИЗ
	|	Оснастка КАК Осн
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ЗакрытиеБланка КАК Лико_ЗакрытиеБланка
	|		ПО Осн.Номенклатура = Лико_ЗакрытиеБланка.Номенклатура
	|			И (Лико_ЗакрытиеБланка.Регистратор <> &Регистратор)
	|			И (Лико_ЗакрытиеБланка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Лико_ВидОперацииЗакрытияБланка.Расход))
	|			И (ВЫБОР
	|				КОГДА Лико_ЗакрытиеБланка.Регистратор ССЫЛКА Документ.Лико_БланкЭтапа
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ Лико_ЗакрытиеБланка.Регистратор.Лико_Документ <> &Регистратор
	|			КОНЕЦ)
	|			И (Лико_ЗакрытиеБланка.Период МЕЖДУ &Дата1 И &Дата2)
	|ГДЕ
	|	Лико_ЗакрытиеБланка.Регистратор ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Ном.Ссылка) КАК Номенклатура,
	|	Оснастка2.Количество КАК Количество,
	|	Оснастка2.ВидРабот КАК ВидРабот
	|ПОМЕСТИТЬ КонтрМатрица
	|ИЗ
	|	Оснастка2 КАК Оснастка2
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Ном
	|		ПО Оснастка2.Номенклатура.Артикул = Ном.Артикул
	|			И Оснастка2.Номенклатура.Ссылка <> Ном.Ссылка
	|ГДЕ
	|	Ном.Наименование ПОДОБНО ""%контрматрица%""
	|
	|СГРУППИРОВАТЬ ПО
	|	Оснастка2.Количество,
	|	Оснастка2.ВидРабот
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(Ном.Ссылка),
	|	Оснастка2.Количество,
	|	Оснастка2.ВидРабот
	|ИЗ
	|	Оснастка2 КАК Оснастка2
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Ном
	|		ПО Оснастка2.Номенклатура.Артикул = Ном.Артикул
	|			И Оснастка2.Номенклатура.Ссылка <> Ном.Ссылка
	|ГДЕ
	|	Ном.Наименование ПОДОБНО ""%кондуктор%""
	|
	|СГРУППИРОВАТЬ ПО
	|	Оснастка2.Количество,
	|	Оснастка2.ВидРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Оснастка2.Номенклатура КАК Номенклатура,
	|	Оснастка2.Количество КАК Остаток,
	|	ТоварыНаСкладахОстатки.Серия КАК Серия,
	|	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК Количество,
	|	Оснастка2.ВидРабот КАК ВидРабот
	|ИЗ
	|	Оснастка2 КАК Оснастка2
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				&Период,
	|				Номенклатура В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							Оснастка.Номенклатура КАК Номенклатура
	|						ИЗ
	|							Оснастка КАК Оснастка)
	|					И Склад = &Склад) КАК ТоварыНаСкладахОстатки
	|		ПО Оснастка2.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтрМатрица.Номенклатура,
	|	КонтрМатрица.Количество,
	|	ТоварыНаСкладахОстатки.Серия,
	|	ТоварыНаСкладахОстатки.ВНаличииОстаток,
	|	КонтрМатрица.ВидРабот
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			&Период,
	|			Номенклатура В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						Оснастка.Номенклатура КАК Номенклатура
	|					ИЗ
	|						КонтрМатрица КАК Оснастка)
	|				И Склад = &Склад) КАК ТоварыНаСкладахОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КонтрМатрица КАК КонтрМатрица
	|		ПО (КонтрМатрица.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Оснастка2.Номенклатура,
	|	Оснастка2.Количество,
	|	ТоварыНаСкладах.Серия,
	|	ТоварыНаСкладах.ВНаличии,
	|	Оснастка2.ВидРабот
	|ИЗ
	|	Оснастка2 КАК Оснастка2
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах КАК ТоварыНаСкладах
	|		ПО Оснастка2.Номенклатура = ТоварыНаСкладах.Номенклатура
	|			И (ТоварыНаСкладах.Регистратор = &регистратор)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтрМатрица.Номенклатура,
	|	КонтрМатрица.Количество,
	|	ТоварыНаСкладах.Серия,
	|	ТоварыНаСкладах.ВНаличии,
	|	КонтрМатрица.ВидРабот
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах КАК ТоварыНаСкладах
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КонтрМатрица КАК КонтрМатрица
	|		ПО (КонтрМатрица.Номенклатура = ТоварыНаСкладах.Номенклатура)
	|			И (ТоварыНаСкладах.Регистратор = &регистратор)
	|ИТОГИ
	|	МАКСИМУМ(Остаток),
	|	СУММА(Количество)
	|ПО
	|	Номенклатура";

	Запрос.УстановитьПараметр("Период",КонецМесяца(ЗакрытеБланкаСсылка.Дата));
	Запрос.УстановитьПараметр("Дата1",НачалоМесяца(ЗакрытеБланкаСсылка.Дата));
	Запрос.УстановитьПараметр("Дата2",ЗакрытеБланкаСсылка.Дата);

	Запрос.УстановитьПараметр("Регистратор",ЗакрытеБланкаСсылка);
	Запрос.УстановитьПараметр("Заказ",ЗакрытеБланкаСсылка.ЗаказПокупателя);
	//СкладОснастки= УправлениеСвойствами.ЗначениеСвойства(ЗакрытеБланкаСсылка.Организация,"Лико_СкладОснастки");
	СкладОснастки= ЗакрытеБланкаСсылка.Склад.Лико_Площадка.СкладОснастки;
	Запрос.УстановитьПараметр("Склад",СкладОснастки);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		Если Выборка.Количество<=0 Тогда
			Продолжить;
		КонецЕсли;

		////Осталось=Выборка.Остаток;
		Осталось=Выборка.Количество;

		ДеталиВыборки = Выборка.Выбрать();
		Пока ДеталиВыборки.Следующий() Цикл
			//Списать=Мин(Осталось,ДеталиВыборки.Количество);

			Списать                         =ДеталиВыборки.Количество;


			НоваяСтрокаТз					=Тз.Добавить();
			НоваяСтрокаТз.Номенклатура		=ДеталиВыборки.Номенклатура;
			//НоваяСтрокаТз.Характеристика	=ДеталиВыборки.Характеристика;
			НоваяСтрокаТз.Серия				=ДеталиВыборки.Серия;
			НоваяСтрокаТз.Количество		=ДеталиВыборки.Количество;
			НоваяСтрокаТз.ВидРабот			=ДеталиВыборки.ВидРабот;

			Осталось=Осталось-Списать;
			Если Осталось=0 Тогда
				Прервать;
			КонецЕсли;


		КонецЦикла; 

	КонецЦикла; 

	Возврат ТЗ;	



КонецФункции

	
Функция ПолучитьНоменклатуруНезавершеннойПродукцииПоЗаказу(ЗаказКлиента) Экспорт 

	НомерЗаказа=ЗаказКлиента.НомерБезПрефикса;
	//ЗаказКлиента=Лико_Дополнительно.НайтиДокументПоНомеру7Символов(НомерЗаказа,"ЗаказКлиента");
	МенеджерЗаказа=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ЗаказКлиента,"Менеджер");


	Запрос = Новый Запрос;

	Запрос.Текст ="ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
	|	ХарактеристикиНоменклатуры.Владелец КАК Номенклатура
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Лико_ЗаказНоменклатуры = &Заказ
	|	И ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры = &ВидНоменклатуры";

	Запрос.УстановитьПараметр("Заказ",ЗаказКлиента);
	Запрос.УстановитьПараметр("ВидНоменклатуры", Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра);

	РезультатЗапроса = Запрос.Выполнить();

	НоменклатураНезавершенка = Неопределено;
	ХарактеристикаНезавершенка = Неопределено;

	//=--------- создаем незавершенку -----
	РодительНезавершенкаНоменклатура = Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра;
	РодительНезавершенка = Справочники.Лико_ПредопределенныеЗначения.ГруппаОбъектовНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра;

	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		ВыборкаЗапроса.Следующий();

		ХарактеристикаНезавершенка = ВыборкаЗапроса.Характеристика;
		НоменклатураНезавершенка = ХарактеристикаНезавершенка.Владелец;
		Возврат НоменклатураНезавершенка 
	Иначе 	//запрос пуст!

		Если ЗначениеЗаполнено(МенеджерЗаказа) Тогда
			ФИО = МенеджерЗаказа.Наименование;
			Фамилия		= ВыделитьСлово(ФИО);
			Имя			= ВыделитьСлово(ФИО);
			Отчество	= ВыделитьСлово(ФИО);
			ФИОСтрока = Фамилия+" "+Лев(имя,1)+"."+Лев(Отчество,1)+".";
		Иначе
			ФИОСтрока = "";
		КонецЕсли;
		//---------=

		Номенклатура1С = Справочники.Номенклатура.СоздатьЭлемент();
		Номенклатура1С.УстановитьНовыйКод("n");
		Номенклатура1С.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра;
		Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Номенклатура1С);

		Номенклатура1С.Наименование = "Незавершенное производство по заказу №" + Формат(НомерЗаказа, "ЧГ=0") + " (" + ФИОСтрока + ")";
		
		НоменклатураПоНаименованию= Справочники.Номенклатура.НайтиПоНаименованию(Номенклатура1С.Наименование,Истина);
		
		Если ЗначениеЗаполнено(НоменклатураПоНаименованию) Тогда
			 Возврат НоменклатураПоНаименованию;
		КонецЕсли;
		
		
		Номенклатура1С.НаименованиеПолное = Номенклатура1С.Наименование;

		Если Не РодительНезавершенкаНоменклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
			Номенклатура1С.Родитель = РодительНезавершенкаНоменклатура;			

		Иначе

		КонецЕсли;
		Номенклатура1С.Записать();  

		Возврат Номенклатура1С;
	КонецЕсли;	


КонецФункции
	
 
Процедура ОтразитьТолькоТоварыВЯчейках(ДокОбъект) Экспорт // --> Начало Лико Ефимов ЕВВ 20.05.2022

	Для Каждого НаборЗаписей Из ДокОбъект.Движения Цикл
		НаборЗаписей.Записывать = Истина;
	КонецЦикла;

	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокОбъект.Ссылка);
	ТекстыЗапроса = Новый СписокЗначений;
	Запрос.Текст = ТекстЗапросаТаблицаТоварыВЯчейках(Новый Запрос, ТекстыЗапроса, "ТоварыВЯчейках",ДокОбъект.Ссылка);
	ТаблицаТоварыВЯчейках = Запрос.Выполнить().Выгрузить();
	Если ТаблицаТоварыВЯчейках.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДокОбъект.Движения.ТоварыВЯчейках.Загрузить(ТаблицаТоварыВЯчейках);

