	//Запрос.УстановитьПараметр("Распоряжение",                        Реквизиты.Распоряжение);
	Запрос.УстановитьПараметр("Распоряжение",                        Распоряжение);
	
	Запрос.УстановитьПараметр("Помещение",                           Реквизиты.Помещение);
	Запрос.УстановитьПараметр("СкладскаяОперация",                   Перечисления.СкладскиеОперации.ПередачаВПроизводствоПриемка);
	Запрос.УстановитьПараметр("Отправитель",                         Реквизиты.Склад);
	Запрос.УстановитьПараметр("Получатель",                          Реквизиты.Склад);
	Запрос.УстановитьПараметр("ВозвратНепринятыхТоваров",            Реквизиты.ВозвратНепринятыхТоваров);
	Запрос.УстановитьПараметр("ЗакрыватьГрафикПоступления",          Истина);
	Запрос.УстановитьПараметр("ХозяйственнаяОперация",               Перечисления.ХозяйственныеОперации.ВыпускПродукции);
	Запрос.УстановитьПараметр("ЗаданиеНаПеревозку",              	 Документы.ЗаданиеНаПеревозку.ПустаяСсылка());
	Запрос.УстановитьПараметр("СкладскаяОперацияПриемкаПродукции",   Перечисления.СкладскиеОперации.ПриемкаПродукцииИзПроизводства);
	Запрос.УстановитьПараметр("Подразделение",            			 Реквизиты.Подразделение);
	Запрос.УстановитьПараметр("СкладскаяОперацияОтгрузкаНаВнутренниеНужды", Перечисления.СкладскиеОперации.ОтгрузкаНаВнутренниеНужды);
	Запрос.УстановитьПараметр("ЗаказКлиента",						 Реквизиты.ЗаказКлиента);
	Запрос.УстановитьПараметр("ВидОперацииПриход",					 Перечисления.Лико_ВидОперацииЗакрытияБланка.Выпуск);
	Запрос.УстановитьПараметр("ВидОперацииРасход",					 Перечисления.Лико_ВидОперацииЗакрытияБланка.Расход);
	Запрос.УстановитьПараметр("НомерПроката",						 Реквизиты.НомерПроката);
	Запрос.УстановитьПараметр("Сотрудник",                       	 Реквизиты.Сотрудник);
	Запрос.УстановитьПараметр("РабочийЦентр",                        Реквизиты.РабочийЦентр);
	//Запрос.УстановитьПараметр("ЕстьРаспоряжениеНаОтгрузку",          ЗначениеЗаполнено(ДокументСсылка.Распоряжение));
	Запрос.УстановитьПараметр("ЕстьРаспоряжениеНаОтгрузку",          ЗначениеЗаполнено(Распоряжение));
	
	Запрос.УстановитьПараметр("ХозяйственнаяОперацияДляСборки",      Перечисления.ХозяйственныеОперации.РазборкаТоваров);
	Запрос.УстановитьПараметр("ХозяйственнаяОперацияДляПоступления", Перечисления.ХозяйственныеОперации.ПередачаПродукцииИзПроизводства);
	Запрос.УстановитьПараметр("НачалоМесяца", 						 НачалоМесяца(Реквизиты.Период));
	Запрос.УстановитьПараметр("КонецМесяца",  						 КонецМесяца(Реквизиты.Период));
	Запрос.УстановитьПараметр("ЗаказКлиента",                        ДокументСсылка.ЗаказПокупателя);
	Запрос.УстановитьПараметр("СтатьяЗатратШтамп",                   Справочники.Лико_СтатьиЗатрат.Штампы);
	Запрос.УстановитьПараметр("ДатаПроведенияПоЗатратам",           Справочники.Лико_ПредопределенныеЗначения.ДатаПроведенияПоЗатратам.ЗначениеПараметра);
	Запрос.УстановитьПараметр("ВидЗаказаТестМатериала",           	Перечисления.Лико_ВидыЗаказов.ТестированиеМатериалов);
	//СкладОснастки= УправлениеСвойствами.ЗначениеСвойства(ДокументСсылка.Организация,"Лико_СкладОснастки");
	СкладОснастки= ДокументСсылка.Склад.Лико_Площадка.СкладОснастки;
	
	Запрос.УстановитьПараметр("СкладОснастки",           			СкладОснастки);	
	Запрос.УстановитьПараметр("НеСписыватьОснастку",           			СкладОснастки<> Реквизиты.Склад);	
	
	//Начало изменений Иванова А.В. 201904.11 
	//Параметры для определения цен по площадке
	Запрос.УстановитьПараметр("Площадка",          					Реквизиты.Организация);
	Запрос.УстановитьПараметр("ПлощадкаЛикофлекс",           		Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра);		
	//Конец изменений Иванова А.В. 201904.11 
	_УчетНЗП=УправлениеСвойствами.ЗначениеСвойства(ДокументСсылка.Организация,"Лико_УчетНаСкладеНЗПвБУ");
	Запрос.УстановитьПараметр("УчетНЗП",           					?(ЗначениеЗаполнено(_УчетНЗП),_УчетНЗП,Ложь));	
	Если ЗначениеЗаполнено(ДокументСсылка.ХозяйственнаяОперация) Тогда
		Запрос.УстановитьПараметр("ХозяйственнаяОперацияДляСборки",      ДокументСсылка.ХозяйственнаяОперация);
	Иначе
		Запрос.УстановитьПараметр("ХозяйственнаяОперацияДляСборки",      Перечисления.ХозяйственныеОперации.РазборкаТоваров);
	КонецЕсли;
	
	
	Если ДокументСсылка.СвязатьСЭтапом Тогда
		Запрос.УстановитьПараметр("ЭтапПроизводства",  	   ДокументСсылка.Распоряжение);
	Иначе 
		Запрос.УстановитьПараметр("ЭтапПроизводства",  	   Документы.ЭтапПроизводства2_2.ПустаяСсылка());
	КонецЕсли;
	Если  ТипЗнч( Реквизиты.Распоряжение)=Тип("ДокументСсылка.СборкаТоваров") ТОгда
		Если НЕ Реквизиты.Распоряжение.Проведен Тогда
			Запрос.УстановитьПараметр("ПоАктуРазборки",       Истина);
		Иначе
			Запрос.УстановитьПараметр("ПоАктуРазборки",       Ложь);
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ЭтоСборка",       Истина);
	Иначе
		Запрос.УстановитьПараметр("ЭтоСборка",       Ложь);
		Запрос.УстановитьПараметр("ПоАктуРазборки",       Ложь);
		
