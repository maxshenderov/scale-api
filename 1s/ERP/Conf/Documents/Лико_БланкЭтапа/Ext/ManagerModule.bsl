	|				ТОГДА ВЫБОР
	|						КОГДА Лико_БланкЭтапаВыпуск.Ссылка.Распоряжение.НомерСледующегоЭтапа = 0
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ ЛОЖЬ
	|					КОНЕЦ
	|			ИНАЧЕ ВЫБОР
	|					КОГДА Лико_БланкЭтапаВыпуск.Номенклатура.ВидНоменклатуры <> &Незавершенка
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ ЛОЖЬ
	|				КОНЕЦ
	|		КОНЕЦ
	|	И Лико_БланкЭтапаВыпуск.Ссылка = &Ссылка";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;	
