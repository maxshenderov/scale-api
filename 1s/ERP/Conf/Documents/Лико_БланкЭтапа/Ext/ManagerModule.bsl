Функция СоздатьСерии(ЗакрытиеБланка, СтрокаЗаказа) Экспорт 
	
	СтруктураДанных = СтруктуруДанныхДляКоробки(ЗакрытиеБланка, СтрокаЗаказа); 
	ТаблицаТовары =СтруктураДанных.Товары;
	//если это печать комплекта, тогда в таблице будет несколько записей 
	ТаблицаТовары.Свернуть("Номенклатура,Характеристика", "КоличествоРоликов,КоличествоВУпаковке");
	РоликиСтрокой = СформироватьСтрокуРоликов(СтруктураДанных.Товары);
	
	ТаблицаСерий = Новый ТаблицаЗначений;
	ТаблицаСерий.Колонки.Добавить("ИнформацияОСерии");
	
	Для сч = 1 по СтруктураДанных.КоличествоНаПечать Цикл
		Серия = СоздатьСериюИлиСерииКомплекта(ТаблицаТовары, РоликиСтрокой, СтруктураДанных);
		Если Серия = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		СтрокаСерий = ТаблицаСерий.Добавить();
		СтрокаСерий.ИнформацияОСерии = Серия;
	КонецЦикла;
	
	Возврат ТаблицаСерий;
	
КонецФункции

Функция СтруктуруДанныхДляКоробки(ЗакрытиеБланка,СтрокаЗаказа)  
	
		
	ТЗПеремотанныеРолики = ЗакрытиеБланка.Товары.Выгрузить();
	ТЗПеремотанныеРолики.Колонки.Добавить("КоличествоРоликов");
	МассивРоликовВКоробке = Новый Массив;
	Для каждого Строка из ТЗПеремотанныеРолики Цикл
		Строка.КоличествоРоликов = 1;
		Если Строка.Отметка Тогда
			Ролик = Строка.Серия.ЯССМ_ОбъектНоменклатуры;
			РоликПослеПеремоткиОбъект = Ролик.ПолучитьОбъект();
			РоликПослеПеремоткиОбъект.СтатусРоликаПослеПеремотки = 2;
			РоликПослеПеремоткиОбъект.Записать();
			МассивРоликовВКоробке.Добавить(Строка.Ролик);
		КонецЕсли;
	КонецЦикла;
	ТЗПеремотанныеРолики.Свернуть("Отметка,КоличествоШт", "КоличествоРоликов");
	Товары =Новый ТаблицаЗначений;
	Для каждого Строка из ТЗПеремотанныеРолики Цикл 
		Если НЕ Строка.Отметка Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаЗаказа.Номенклатура;
		НоваяСтрока.Характеристика = СтрокаЗаказа.Характеристика;
		НоваяСтрока.КоличествоРоликов = Строка.КоличествоРоликов;
		НоваяСтрока.КоличествоВРолике = Строка.КоличествоШт;
		НоваяСтрока.КоличествоВУпаковке = НоваяСтрока.КоличествоРоликов * НоваяСтрока.КоличествоВРолике;
	КонецЦикла;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Заказ", ЗакрытиеБланка.ЗаказПокупателя);
	СтруктураДанных.Вставить("НомерЗаказа", ЗакрытиеБланка.ЗаказКлиента.НомерБезПрефикса);
	СтруктураДанных.Вставить("Товары", Товары);
	СтруктураДанных.Вставить("КоличествоНаПечать", 1);
	СтруктураДанных.Вставить("Город", СтрокаЗаказа.Город);
	СтруктураДанных.Вставить("Втулка", СтрокаЗаказа.ВнутреннийДиаметр);
	СтруктураДанных.Вставить("Намотка", СтрокаЗаказа.Направление);
	СтруктураДанных.Вставить("NКонтракта", СтрокаЗаказа.NКонтракта);
	СтруктураДанных.Вставить("ВремяПечати", ТекущаяДата());
	СтруктураДанных.Вставить("КодЭтикеткиЗаказчика", СтрокаЗаказа.КодЭтикеткиЗаказчика);
	Этикетка = Лико_Дополнительно.ПолучитьНаименованиеКомплекта(СтруктураДанных, Ложь);
	СтруктураДанных.Вставить("Этикетка", Этикетка);
	ВесКоробки = Лико_Дополнительно.РассчитатьВесКоробки(СтрокаЗаказа.Номенклатура, Товары.Итог("КоличествоВУпаковке"),, ЗакрытиеБланка.ЗаказПокупателя);
	СтруктураДанных.Вставить("ВесКоробки", ВесКоробки);
	СтруктураДанных.Вставить("ВесНетто", 0);
	СтруктураДанных.Вставить("ДлинаРоликов", 0);
	СтруктураДанных.Вставить("ВнутренняяНамотка", Ложь);
	СтруктураДанных.Вставить("НовыеЭтикетки", Истина);
	СтруктураДанных.Вставить("НеОтображатьМатериал", Ложь);
	СтруктураДанных.Вставить("НеОтображатьПолучателя", Ложь);
	СтруктураДанных.Вставить("НеОтображатьТУ", Ложь);
	СтруктураДанных.Вставить("Оператор", ЗакрытиеБланка.Сотрудник);
	СтруктураДанных.Вставить("РабочееМесто", ПараметрыСеанса.Лико_РабочееМесто);
	СтруктураДанных.Вставить("НастройкаПечати", Ложь);
	СтруктураДанных.Вставить("ЧестныйЗнак", СтрокаЗаказа.КодЭтикеткиЗаказчика);
	СтруктураДанных.Вставить("СтруктураРастарки", Неопределено);
	СтруктураДанных.Вставить("МассивРоликовВКоробке", МассивРоликовВКоробке);
	
	Возврат СтруктураДанных;

КонецФункции

Функция СформироватьСтрокуРоликов(Таблица)
	
	СтрокаРоликов = "";
	Для сч = 1 по Таблица.Количество() Цикл
		Если сч > 3 Тогда
			Прервать;
		КонецЕсли;
		ТекущаяСтрока = Таблица[Сч-1];
		СтрокаРоликов = ?(ЗначениеЗаполнено(СтрокаРоликов), СтрокаРоликов + "; ", "")
						+ ?(ТекущаяСтрока.КоличествоРоликов = 0, "", ТекущаяСтрока.КоличествоРоликов)
						+ " * "
						+ ?(ТекущаяСтрока.КоличествоВРолике = 0, "", ТекущаяСтрока.КоличествоВРолике * 1000);
	КонецЦикла;
	
	Возврат СтрокаРоликов;
					
КонецФункции

Функция СоздатьСериюИлиСерииКомплекта(ТаблицаТовары, РоликиСтрокой, СтруктураДанных)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТаблицаТовары.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НомерКоробки = Лико_Дополнительно.ПолучитьНомерКоробкиДляНовойСерии(ТаблицаТовары.ВыгрузитьКолонку("Характеристика"));
	
	СтруктураДанныхДляПечати = Новый Структура;
	КоличествоЭтикетокВКоробке = ТаблицаТовары.Количество();
	ЭтоКомплект = КоличествоЭтикетокВКоробке > 1;
	КоличествоКоробокОсталось = 1;
	сч = 0;
	СозданныеСерии = Новый Массив;
	СерияВладелецКомплекта = Неопределено;
	СоответствиеНоменклатурыИКодовЭтикетокЗаказчика = Новый Соответствие;
	Для каждого СтрокаТЧ из ТаблицаТовары Цикл
		сч = сч + 1;
		//Создаем новую серию
		НовыйОбъект = Справочники.СерииНоменклатуры.СоздатьЭлемент();
		НовыйОбъект.ВидНоменклатуры = СтрокаТЧ.Номенклатура.ВидНоменклатуры;
		//НовыйОбъект.Номер = Формат(Число(Справочники.СерииНоменклатуры.ВычислитьМаксимальныйНомерСерии(СтрокаТЧ.Номенклатура.ВидНоменклатуры) + 1), "ЧЦ=8; ЧВН=; ЧГ=");
		НовыйОбъект.Номер = СтрокаТЧ.Характеристика; // пусть будет наименование характеристики
		НовыйОбъект.Лико_ХарактеристикаВладелец = СтрокаТЧ.Характеристика;
		НовыйОбъект.Лико_НомерКоробки = НомерКоробки;
		НовыйОбъект.Лико_Город = СтруктураДанных.Город;
		НовыйОбъект.Лико_КоличествоВУпаковке = ?(СтрокаТЧ.КоличествоВУпаковке = 0, 1, СтрокаТЧ.КоличествоВУпаковке);
		НовыйОбъект.Лико_Втулка = СтруктураДанных.Втулка;
		НовыйОбъект.Лико_НаправлениеНамотки = СтруктураДанных.Намотка;
		НовыйОбъект.Лико_ДатаУпаковки = СтруктураДанных.ВремяПечати;
		Если ЗначениеЗаполнено(СтруктураДанных.ВесКоробки) Тогда
			НовыйОбъект.Лико_ВесКоробки = СтруктураДанных.ВесКоробки / ТаблицаТовары.Количество();
		Иначе
			НовыйОбъект.Лико_ВесКоробки = Лико_Дополнительно.РассчитатьВесКоробки(СтрокаТЧ.Характеристика.Владелец, СтрокаТЧ.КоличествоВУпаковке, ТаблицаТовары.Количество(), СтрокаТЧ.Характеристика.Лико_ЗаказНоменклатуры);
		КонецЕсли;
		НовыйОбъект.Лико_ВесНетто = СтруктураДанных.ВесНетто;
		НовыйОбъект.Лико_ДлинаРоликов = СтруктураДанных.ДлинаРоликов;
		НовыйОбъект.Лико_Упаковщик = СтруктураДанных.Оператор;
		НовыйОбъект.Лико_НомерПоставки = СтруктураДанных.NКонтракта;
		НовыйОбъект.Лико_КоличествоРоликов = СтрокаТЧ.КоличествоРоликов;
		НовыйОбъект.Лико_РоликиСтрокой = РоликиСтрокой;
		НовыйОбъект.Лико_КодЭтикеткиЗаказчика = СтруктураДанных.КодЭтикеткиЗаказчика;
		НовыйОбъект.Лико_ЧестныйЗнак = СтруктураДанных.ЧестныйЗнак;
		// --> Начало Лико Ефимов ЕВВ 11.08.2020
		Если ЗначениеЗаполнено(СтруктураДанных.СтруктураРастарки) Тогда
			НовыйОбъект.Лико_РаспоряжениеНаРастарку = СтруктураДанных.СтруктураРастарки.Документ;
			НовыйОбъект.Лико_НомерЦепочкиВРаспоряженииНаРастарку = Число(СтруктураДанных.СтруктураРастарки.НомерЦепочки);
		КонецЕсли;
		// <-- Конец Лико Ефимов ЕВВ 11.08.2020
		Если сч = КоличествоЭтикетокВКоробке Тогда
			НовыйОбъект.Лико_КоличествоКоробок = КоличествоКоробокОсталось;
		Иначе
			НовыйОбъект.Лико_КоличествоКоробок = 1 / КоличествоЭтикетокВКоробке;
		КонецЕсли;
		КоличествоКоробокОсталось = КоличествоКоробокОсталось - НовыйОбъект.Лико_КоличествоКоробок;
		
		Если ЭтоКомплект И СерияВладелецКомплекта <> Неопределено Тогда
			НовыйОбъект.Лико_ВладелецКомплекта = СерияВладелецКомплекта;
			////Наименование у серий комплекта будет одинаковое (изменил агоритм - теперь наименование соответствует характеристике и номенклатуре)
			//НовыйОбъект.Наименование = СерияВладелецКомплекта.Наименование;
			////Чтобы не перезаписалось наименование, поставим признак ОбменДанными
			//НовыйОбъект.ОбменДанными.Загрузка = Истина;
		КонецЕсли; 
		
		Если СтруктураДанных.Свойство("МассивРоликовВКоробке") Тогда
			Для каждого ТекОбъектНоменклатуры из СтруктураДанных.МассивРоликовВКоробке Цикл
				НоваяСтрока = НовыйОбъект.Лико_Содержимое.Добавить();
				НоваяСтрока.ОбъектНоменклатуры = ТекОбъектНоменклатуры;
			КонецЦикла;
		КонецЕсли;
		
		Попытка
			НовыйОбъект.Записать();
			Если СерияВладелецКомплекта = Неопределено Тогда
				СерияВладелецКомплекта = НовыйОбъект.Ссылка;
			КонецЕсли;
			Если ЭтоКомплект И НЕ ЗначениеЗаполнено(НовыйОбъект.Лико_ВладелецКомплекта) Тогда
				НовыйОбъект.Лико_ВладелецКомплекта = СерияВладелецКомплекта;
				////Наименование у серий комплекта будет одинаковое (изменил агоритм - теперь наименование соответствует характеристике и номенклатуре)
				//НовыйОбъект.Наименование = СерияВладелецКомплекта.Наименование;
				////Чтобы не перезаписалось наименование, поставим признак ОбменДанными
				//НовыйОбъект.ОбменДанными.Загрузка = Истина;
				НовыйОбъект.Записать();
			КонецЕсли;
			//Создадим штрихкод. Причем он генерируется только для первой серии, а для остальных серий присваивается такой же, как у первой. (изменил алгоритм - теперь создается один штрихкод)
			Если СерияВладелецКомплекта = НовыйОбъект.Ссылка Тогда
				// Теперь штрихкод создается только для владельца комплекта
				Штрихкод = СоздатьШтрихкодСерии(НовыйОбъект.Ссылка, СтруктураДанных);
				Если Штрихкод = Неопределено Тогда
					Возврат Неопределено;
				КонецЕсли;
			КонецЕсли;
			СозданныеСерии.Добавить(НовыйОбъект.Ссылка);
		Исключение
			Сообщить("Не удалось создать серию номенклатуры """ + СтрокаТЧ.Характеристика.Владелец + """ для характеристики """ + СтрокаТЧ.Характеристика + """. " + ОписаниеОшибки());
			Возврат Неопределено;
		КонецПопытки;
		// Получим код этикетки заказчика из заказа
		//КодЭтикеткиЗаказчика = СоответствиеНоменклатурыИКодовЭтикетокЗаказчика.Получить(СтрокаТЧ.Номенклатура);
		//Если КодЭтикеткиЗаказчика = Неопределено Тогда
		//	НайденныеСтроки = СтрокаТЧ.Характеристика.Лико_ЗаказНоменклатуры.Товары.НайтиСтроки(Новый Структура("Номенклатура", СтрокаТЧ.Номенклатура));
		//	Если НайденныеСтроки.Количество() > 0 Тогда
		//		КодЭтикеткиЗаказчика = НайденныеСтроки[0].КодЭтикеткиЗаказчика;
		//	КонецЕсли;
		//	СоответствиеНоменклатурыИКодовЭтикетокЗаказчика.Вставить(СтрокаТЧ.Номенклатура, КодЭтикеткиЗаказчика);
		//КонецЕсли;
		
		// Запишем вес и код этикетки заказчика в номенклатуру
		//ВесЗаТысШт = Окр(НовыйОбъект.Лико_ВесКоробки / НовыйОбъект.Лико_КоличествоВУпаковке, 3);
		//Если СтрокаТЧ.Номенклатура.ВесЧислитель <> ВесЗаТысШт Тогда
		////Если СтрокаТЧ.Номенклатура.ВесЧислитель <> ВесЗаТысШт ИЛИ
		////	(КодЭтикеткиЗаказчика <> Неопределено И КодЭтикеткиЗаказчика <> СтрокаТЧ.Номенклатура.Лико_КодЭтикеткиЗаказчика) Тогда
		//	НоменклатураОбъект = СтрокаТЧ.Номенклатура.ПолучитьОбъект();
		//	НоменклатураОбъект.ВесЕдиницаИзмерения = Справочники.Лико_ПредопределенныеЗначения.ЕИКг.ЗначениеПараметра;
		//	НоменклатураОбъект.ВесЗнаменатель = 1;
		//	НоменклатураОбъект.ВесИспользовать = Истина;
		//	НоменклатураОбъект.ВесМожноУказыватьВДокументах = Ложь;
		//	НоменклатураОбъект.ВесЧислитель = ВесЗаТысШт;
		//	//НоменклатураОбъект.Лико_КодЭтикеткиЗаказчика = КодЭтикеткиЗаказчика;
		//	Попытка
		//		НоменклатураОбъект.Записать();
		//	Исключение
		//		Сообщить("Не удалось записать вес в номенклатуру """ + СтрокаТЧ.Номенклатура + """: " + ОписаниеОшибки());
		//	КонецПопытки;
		//КонецЕсли;			
	КонецЦикла;
	
	Возврат ЗаполнитьИнформациюОСерии(СерияВладелецКомплекта);
	
КонецФункции

Функция СоздатьШтрихкодСерии(Серия,СтруктураДанных)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		МенеджерЗаписиШтрихкода = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
		МенеджерЗаписиШтрихкода.Номенклатура = Серия.Лико_ХарактеристикаВладелец.Владелец;
		МенеджерЗаписиШтрихкода.Характеристика = Серия.Лико_ХарактеристикаВладелец;
		МенеджерЗаписиШтрихкода.Лико_Серия = Серия;
		МенеджерЗаписиШтрихкода.Штрихкод = ПодготовкаШтрихКода(Серия.Ссылка, Серия.Лико_НомерКоробки, СтруктураДанных.НомерЗаказа, МенеджерЗаписиШтрихкода.Номенклатура);
		МенеджерЗаписиШтрихкода.Записать();
	Исключение
		Сообщить("Не удалсь создать штрихкод для серии """ + Серия.Ссылка + """");
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат МенеджерЗаписиШтрихкода.Штрихкод;
	
КонецФункции

Функция ЗаполнитьИнформациюОСерии(Серия)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СерииНоменклатуры.Ссылка КАК Ссылка,
		|	СерииНоменклатуры.Наименование КАК Наименование,
		|	СерииНоменклатуры.Лико_НомерКоробки КАК НомерКоробки,
		|	СерииНоменклатуры.Лико_Город КАК Город,
		|	СУММА(ЕСТЬNULL(СерииНоменклатурыКомплекта.Лико_КоличествоВУпаковке, СерииНоменклатуры.Лико_КоличествоВУпаковке)) КАК КоличествоВУпаковке,
		|	СерииНоменклатуры.Лико_Втулка КАК Втулка,
		|	СерииНоменклатуры.Лико_НаправлениеНамотки КАК НаправлениеНамотки,
		|	СерииНоменклатуры.Лико_ДатаУпаковки КАК ДатаУпаковки,
		|	СУММА(ЕСТЬNULL(СерииНоменклатурыКомплекта.Лико_ВесКоробки, СерииНоменклатуры.Лико_ВесКоробки)) КАК ВесКоробки,
		|	СУММА(ЕСТЬNULL(СерииНоменклатурыКомплекта.Лико_ВесНетто, СерииНоменклатуры.Лико_ВесНетто)) КАК ВесНетто,
		|	СерииНоменклатуры.Лико_ДлинаРоликов КАК ДлинаРоликов,
		|	СерииНоменклатуры.Лико_Упаковщик КАК Упаковщик,
		|	СерииНоменклатуры.Лико_ВладелецКомплекта КАК ВладелецКомплекта,
		|	СерииНоменклатуры.Лико_КоличествоРоликов КАК КоличествоРоликов,
		|	СерииНоменклатуры.Лико_РоликиСтрокой КАК РоликиСтрокой,
		|	СерииНоменклатуры.Лико_НомерПоставки КАК НомерПоставки,
		|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Владелец.ЕдиницаИзмерения.Наименование КАК НаименованиеЕИ,
		|	СерииНоменклатуры.Лико_КодЭтикеткиЗаказчика КАК КодЭтикеткиЗаказчика,
		|	СерииНоменклатуры.Лико_ЧестныйЗнак КАК ЧестныйЗнак,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.ОсновнойМатериал КАК Основа,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.СрокГодности КАК СрокГодности,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец КАК Характеристика,
		|	ВЫРАЗИТЬ(СерииНоменклатуры.Лико_ХарактеристикаВладелец.Владелец КАК Справочник.Номенклатура) КАК Номенклатура,
		|	МАКСИМУМ(ВЫРАЗИТЬ(ЕСТЬNULL(ПартнерыДополнительныеРеквизиты.Значение, ЛОЖЬ) КАК БУЛЕВО)) КАК СтикерВыводитьТипЭтикеткиВПолеКод,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.ТипЗаказа КАК ТипЗаказа,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры КАК Заказ,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Организация.Наименование КАК НаименованиеПродавца,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.ДатаВыпуска КАК ДатаВыпуска,
		|	СерииНоменклатуры.Лико_ЧестныйЗнак.Gtin КАК ЧестныйЗнакGtin,
		|	СерииНоменклатуры.Лико_ЧестныйЗнак.ДатаЭмиссии КАК ЧестныйЗнакДатаЭмиссии,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Площадка.Организация КАК ПлощадкаОрганизация
		|ИЗ
		|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
		|		ПО СерииНоменклатуры.Ссылка = ШтрихкодыНоменклатуры.Лико_Серия
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры КАК СерииНоменклатурыКомплекта
		|		ПО СерииНоменклатуры.Ссылка = СерииНоменклатурыКомплекта.Лико_ВладелецКомплекта
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры.ДополнительныеРеквизиты КАК ПартнерыДополнительныеРеквизиты
		|		ПО СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Партнер = ПартнерыДополнительныеРеквизиты.Ссылка
		|			И (ПартнерыДополнительныеРеквизиты.Свойство.Имя = ""СтикерВыводитьТипЭтикеткиВПолеКод"")
		|ГДЕ
		|	СерииНоменклатуры.Ссылка = &Серия
		|
		|СГРУППИРОВАТЬ ПО
		|	СерииНоменклатуры.Ссылка,
		|	СерииНоменклатуры.Наименование,
		|	СерииНоменклатуры.Лико_НомерКоробки,
		|	СерииНоменклатуры.Лико_Город,
		|	СерииНоменклатуры.Лико_Втулка,
		|	СерииНоменклатуры.Лико_НаправлениеНамотки,
		|	СерииНоменклатуры.Лико_ДатаУпаковки,
		|	СерииНоменклатуры.Лико_Упаковщик,
		|	СерииНоменклатуры.Лико_КоличествоРоликов,
		|	СерииНоменклатуры.Лико_ВладелецКомплекта,
		|	СерииНоменклатуры.Лико_РоликиСтрокой,
		|	СерииНоменклатуры.Лико_ДлинаРоликов,
		|	СерииНоменклатуры.Лико_НомерПоставки,
		|	ШтрихкодыНоменклатуры.Штрихкод,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Владелец.ЕдиницаИзмерения.Наименование,
		|	СерииНоменклатуры.Лико_КодЭтикеткиЗаказчика,
		|	СерииНоменклатуры.Лико_ЧестныйЗнак,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.ОсновнойМатериал,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.СрокГодности,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец,
		|	ВЫРАЗИТЬ(СерииНоменклатуры.Лико_ХарактеристикаВладелец.Владелец КАК Справочник.Номенклатура),
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.ТипЗаказа,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Организация.Наименование,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.ДатаВыпуска,
		|	СерииНоменклатуры.Лико_ЧестныйЗнак.Gtin,
		|	СерииНоменклатуры.Лико_ЧестныйЗнак.ДатаЭмиссии,
		|	СерииНоменклатуры.Лико_ХарактеристикаВладелец.Лико_ЗаказНоменклатуры.Площадка.Организация";
	
	Запрос.УстановитьПараметр("Серия", Серия);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Результат = РезультатЗапроса.Выгрузить();
		Строка = Результат[0];
		Если Строка.СтикерВыводитьТипЭтикеткиВПолеКод Тогда
			Строка.КодЭтикеткиЗаказчика = "" + ?(ЗначениеЗаполнено(Строка.КодЭтикеткиЗаказчика), Строка.КодЭтикеткиЗаказчика + " ", "") + Строка.ТипЗаказа;
		КонецЕсли;
		ИнформацияОСерии = Новый Структура;
		Для каждого Колонка из Результат.Колонки Цикл
			ИнформацияОСерии.Вставить(Колонка.Имя, Строка[Колонка.Имя]);	
		КонецЦикла;
		ИнформацияОСерии.Наименование = ПолучитьНаименованиеСерии(Строка.Ссылка);
		//ИнформацияОСерии.КодЭтикеткиЗаказчика = ПолучитьКодЭтикеткиЗаказчика(Строка.Характеристика);
		ИнформацияОСерии.Вставить("Объем", Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, ИнформацияОСерии.Номенклатура, "Стикер_Объем", 0));
		
		Если НЕ ЗначениеЗаполнено(ИнформацияОСерии.ДатаВыпуска) Тогда
			ЗаказОбъект = ИнформацияОСерии.Заказ.ПолучитьОбъект();
			ЗаказОбъект.ДатаВыпуска = ИнформацияОСерии.ДатаУпаковки;
			ЗаказОбъект.ОбменДанными.Загрузка = Истина;
			ЗаказОбъект.Записать();
			ИнформацияОСерии.ДатаВыпуска = ЗаказОбъект.ДатаВыпуска;
		КонецЕсли;
		
		Возврат ИнформацияОСерии;
	КонецЕсли;	
	
КонецФункции

