Функция ПолучитьНаименованиеСерии(Серия)
	
	// Чтобы не плодить код по формированию наименования, будем использовать функцию ПолучитьНаименованиеКомплекта
	Товары = Новый ТаблицаЗначений;
	Товары.Колонки.Добавить("Номенклатура");
	Товары.Колонки.Добавить("Характеристика");
	Если ЗначениеЗаполнено(Серия.Лико_ВладелецКомплекта) Тогда
		МассивСерий = Лико_Дополнительно.НайтиСерииПоВладельцуКомплекта(Серия.Лико_ВладелецКомплекта);
		Для каждого СерияКомплекта из МассивСерий Цикл
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.Характеристика = СерияКомплекта.Лико_ХарактеристикаВладелец;
			НоваяСтрока.Номенклатура = НоваяСтрока.Характеристика.Владелец;
		КонецЦикла;
	Иначе		
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Характеристика = Серия.Лико_ХарактеристикаВладелец;
		НоваяСтрока.Номенклатура = НоваяСтрока.Характеристика.Владелец;
	КонецЕсли;
	Структура = Новый Структура("Товары,Город,КодЭтикеткиЗаказчика", Товары, Серия.Лико_Город, Серия.Лико_КодЭтикеткиЗаказчика);
	Возврат Лико_Дополнительно.ПолучитьНаименованиеКомплекта(Структура, Ложь);
	
КонецФункции

Функция ПроверитьНаличиеШтрихкода(ШтрхКодУпаковки)
	Запрос = Новый Запрос;	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Штрихкоды.Штрихкод
	               |ИЗ
	               |	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
	               |ГДЕ
	               |	Штрихкоды.Штрихкод = &Штрихкод";
	
	Запрос.УстановитьПараметр("Штрихкод", ШтрхКодУпаковки);
	
	Возврат (Запрос.Выполнить().Выбрать().Количество() > 0);
КонецФункции

