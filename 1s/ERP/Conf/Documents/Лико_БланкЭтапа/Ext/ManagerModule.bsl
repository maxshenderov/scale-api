Функция ТекстЗапросаВтТаблицаТовары(Запрос, ТекстыЗапроса)	
	ИмяРегистра = "ВтТаблицаТовары"; 	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Лико_БланкЭтапаВыпуск.Ссылка КАК Ссылка,
	|	Лико_БланкЭтапаВыпуск.Номенклатура КАК Номенклатура,
	|	Лико_БланкЭтапаВыпуск.Характеристика КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК Назначение,
	|	Лико_БланкЭтапаВыпуск.Серия КАК Серия,
	|	ВЫБОР
	|		КОГДА Лико_БланкЭтапаВыпуск.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.Пустаяссылка)
	|			ТОГДА 0
	|		ИНАЧЕ 8
	|	КОНЕЦ КАК СтатусУказанияСерий,
	|	Лико_БланкЭтапаВыпуск.КоличествоУУ КАК Количество,
