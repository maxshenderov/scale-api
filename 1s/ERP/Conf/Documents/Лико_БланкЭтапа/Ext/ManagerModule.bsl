КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗакрытиеБланкаЗаказа") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ЗакрытиеБланкаЗаказа",
		НСтр("ru = 'Закрытие бланка заказа'"),
		ПечатьЗадания(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
КонецПроцедуры

Функция ПечатьЗадания(МассивОбъектов, ОбъектыПечати)
	
	КолонкаКодов = ФормированиеПечатныхФорм.ИмяДополнительнойКолонки();
	ВыводитьКоды = ЗначениеЗаполнено(КолонкаКодов);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЗакрытиеБланкаЗаказа";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_БланкЭтапа.Ссылка КАК Ссылка,
	|	Лико_БланкЭтапа.Дата КАК Дата,
	|	Лико_БланкЭтапа.Номер КАК Номер,
	|	ПРЕДСТАВЛЕНИЕ(Лико_БланкЭтапа.Склад) КАК СкладПредставление
	|ИЗ
	|	Документ.Лико_БланкЭтапа КАК Лико_БланкЭтапа
	|ГДЕ
	|	Лико_БланкЭтапа.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_БланкЭтапаТовары.НомерСтроки КАК НомерСтроки,
	|	0 КАК Метка,
	|	Лико_БланкЭтапаТовары.Номенклатура.НаименованиеПолное КАК НоменклатураПредставление,
	|	Лико_БланкЭтапаТовары.Характеристика.НаименованиеПолное КАК ХарактеристикаПредставление,
	|	Лико_БланкЭтапаТовары.Серия.Наименование КАК СерияПредставление,
	|	Лико_БланкЭтапаТовары.Номенклатура.Код КАК Код,
	|	Лико_БланкЭтапаТовары.Номенклатура.Артикул КАК Артикул,
	|	Лико_БланкЭтапаТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
	|ГДЕ
	|	Лико_БланкЭтапаТовары.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	Метка,
	|	НомерСтроки
	|ИТОГИ ПО
	|	Ссылка";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	//Нужно напечатать номер и дату накладной, но к накладным может не быть доступа
	УстановитьПривилегированныйРежим(Истина);
	
	Результаты = Запрос.ВыполнитьПакет();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ВыборкаПоДокументам      = Результаты[0].Выбрать();
	ВыборкаПоТабличнымЧастям = Результаты[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	
