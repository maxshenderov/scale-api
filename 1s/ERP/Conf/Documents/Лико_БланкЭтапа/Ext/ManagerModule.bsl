	|	&ЗаказКлиента КАК ЗаказКлиента,
	|	&Ссылка КАК Распоряжение,
	|	&НомерПроката КАК НомерПроката,
	|	&ВидОперацииПриход КАК ВидОперации,
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДВижения,
	|	СУММА(ТаблицаТовары.Количество) КАК КоличествоЭтап,
	|	СУММА(ТаблицаТовары.Количество) КАК КоличествоДвижение,
	|	&ЭтапПроизводства КАК ЭтапПроизводства,
	|	ЛОЖЬ КАК Оснастка
	|ИЗ
	|	ВтТаблицаТовары КАК ТаблицаТовары
	|ГДЕ
	|	(&НомерПроката <> 0
	|			ИЛИ &ЭтоПеремотка)
	|	И НЕ &ЭтоСборка
	|	И НЕ &СписаниеНаРасходы
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТовары.Номенклатура,
	|	ТаблицаТовары.Характеристика
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаТоварыРасход.Номенклатура,
	|	ТаблицаТоварыРасход.Характеристика,
	|	&ЗаказКлиента,
	|	&Ссылка,
	|	&НомерПроката,
	|	&ВидОперацииРасход,
	|	&Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	СУММА(ТаблицаТоварыРасход.Количество),
	|	СУММА(ТаблицаТоварыРасход.Количество),
	|	&ЭтапПроизводства,
	|	ТаблицаТоварыРасход.ДопРасход
	|ИЗ
	|	ВтТаблицаРасход КАК ТаблицаТоварыРасход
	|ГДЕ
	|	(&НомерПроката <> 0
	|			ИЛИ &ЭтоПеремотка)
	|	И НЕ &ЭтоСборка
	|	И ТаблицаТоварыРасход.МожноСписать
	|	И НЕ &СписаниеНаРасходы
	|	И ВЫБОР
	|			КОГДА &СписаниеКраскиЧерезЦеховуюКладовую
	|				ТОГДА ТаблицаТоварыРасход.Номенклатура.ВидНоменклатуры <> &ВидНоменклатурыКраска
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТоварыРасход.Номенклатура,
	|	ТаблицаТоварыРасход.Характеристика,
	|	ТаблицаТоварыРасход.ДопРасход";
	
	
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
	
КонецФункции

Функция ТекстЗапросаТаблицаДвиженияЛикоПартииКликов(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "ЛикоПартииКликов";
	
	Если Не ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДВижения,
	|	Лико_БланкЭтапаТовары.Ссылка КАК Партия,
	|	СУММА(Лико_БланкЭтапаТовары.КоличествоРасход) КАК Количество
	|ИЗ
	|	Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
	|ГДЕ
	|	Лико_БланкЭтапаТовары.Номенклатура = &CLICKS_INDIGO
	|	И Лико_БланкЭтапаТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_БланкЭтапаТовары.Ссылка";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаДвиженияЛико_ТоварыКРаспределению(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "Лико_ТоварыКРаспределению";
	
	Если Не ПроведениеДокументов.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;
	
	
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Склад КАК Склад,
	|	Лико_БланкЭтапаТовары.Номенклатура КАК Номенклатура,
	|	Лико_БланкЭтапаТовары.Характеристика КАК Характеристика,
	|	Лико_БланкЭтапаТовары.Серия КАК Серия,
	|	&ЗаказКлиента КАК ЗаказКлиента,
	|	&РабочийЦентр КАК РабочийЦентр,
	|	&Сотрудник КАК Сотрудник,
	|	Лико_БланкЭтапаТовары.КоличествоРасход КАК Количество,
	|	Лико_БланкЭтапаТовары.КоличествоРасходУУ КАК КоличествоУУ,
	|	Лико_БланкЭтапаТовары.Ссылка.НомерБланка КАК НомерБланка,
	|	Лико_БланкЭтапаТовары.Ссылка.НомерПроката КАК НомерПроката
	|ИЗ
	|	Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
	|ГДЕ
	|	Лико_БланкЭтапаТовары.Ссылка = &Ссылка
	|	И Лико_БланкЭтапаТовары.Списать";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
