	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Документ.Дата КАК Период,
	|	Документ.Склад КАК Склад,
	|	Документ.Распоряжение КАК Распоряжение,
	|	Документ.СкладскаяОперация КАК СкладскаяОперация,
	|	Документ.ЗонаПриемки КАК ЗонаПриемки,
	|	Документ.Помещение КАК Помещение,
	|	ВЫБОР
	|		КОГДА Документ.СкладскаяОперация = ЗНАЧЕНИЕ(Перечисление.СкладскиеОперации.ВозвратНепринятыхТоваров)
	|				ИЛИ Документ.СкладскаяОперация = ЗНАЧЕНИЕ(Перечисление.СкладскиеОперации.ВозвратНепринятыхТоваровУстарел)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ВозвратНепринятыхТоваров,
	|	Документ.ЗакрыватьГрафикПоступления КАК ЗакрыватьГрафикПоступления,
	|	Документ.Подразделение КАК Отправитель,
	|	Документ.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Документ.РабочийЦентр КАК РабочийЦентр,
	|	Документ.РабочийЦентр.ЛикоЯчейка КАК Ячейка,
	|	Документ.Подразделение КАК Подразделение,
	|	Документ.ЗаказПокупателя КАК ЗаказКлиента,
	|	МИНИМУМ(Документ.НомерПроката) КАК НомерПроката,
	|	Документ.Сотрудник КАК Сотрудник,
	|	Документ.Организация КАК Организация
	|ИЗ
	|	Документ.Лико_БланкЭтапа КАК Документ
	//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	//|		ПО Документ.ЗаказПокупателя = Лико_ПараметрыПроизводстваЗаказа.Заказ
	//|			И Документ.РабочийЦентр = Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр
	|ГДЕ
	|	Документ.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Документ.Дата,
	|	Документ.Склад,
	|	Документ.Распоряжение,
	|	Документ.СкладскаяОперация,
	|	Документ.ЗонаПриемки,
	|	Документ.Помещение,
	|	ВЫБОР
	|		КОГДА Документ.СкладскаяОперация = ЗНАЧЕНИЕ(Перечисление.СкладскиеОперации.ВозвратНепринятыхТоваров)
	|				ИЛИ Документ.СкладскаяОперация = ЗНАЧЕНИЕ(Перечисление.СкладскиеОперации.ВозвратНепринятыхТоваровУстарел)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	Документ.ЗакрыватьГрафикПоступления,
	|	Документ.Подразделение,
	|	Документ.ХозяйственнаяОперация,
	|	Документ.РабочийЦентр,
	|	Документ.РабочийЦентр.ЛикоЯчейка,
	|	Документ.ЗаказПокупателя,
	|	Документ.Сотрудник,
	|	Документ.Организация,
	|	Документ.Подразделение";  
	
	Обработки.ПеремещениеТоваровДоп.КорректировкаЗапросаРегистраТоварыВЯчейках(ДокументСсылка.Организация, ДокументСсылка.Дата, Запрос.Текст); 

	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	Если ЗначениеЗаполнено(ДокументСсылка.РаспоряжениеНаОтгрузку) Тогда
		Распоряжение= ДокументСсылка.РаспоряжениеНаОтгрузку;
