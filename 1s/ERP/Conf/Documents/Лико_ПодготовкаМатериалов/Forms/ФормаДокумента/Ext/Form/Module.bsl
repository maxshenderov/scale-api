&НаСервере
Процедура ЗаполнитьСотавСмесиСервер(Номенклатура,КоличествоСмеси) //+Лико m.shenderov 11.01.2022
    УстановитьПривилегированныйРежим(Истина);
	ЦГЭтилацетат    = Справочники.ЦеновыеГруппы.Этилацетат;
	КПЭтилацетата= ПолучитьКПЭтилацетата(Объект.Организация,Объект.Дата);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ФормулыПантоновСостав.Номенклатура КАК Номенклатура,
	|	Лико_ФормулыПантоновСостав.ПроцентВСмеси КАК ПроцентВСмеси,
	|	ВЫБОР
	|		КОГДА Лико_ФормулыПантоновСостав.Номенклатура.ЦеноваяГруппа = &ЦГЭтилацетат
	|			ТОГДА Лико_ФормулыПантоновСостав.ПроцентВСмеси / 100 * &КоличествоСмеси * &КПЭтилацетата
	|		ИНАЧЕ Лико_ФормулыПантоновСостав.ПроцентВСмеси / 100 * &КоличествоСмеси
	|	КОНЕЦ КАК Количество,
	|	Лико_ФормулыПантоновСостав.Номенклатура.ЦеноваяГруппа КАК ЦеноваяГруппа
	|ПОМЕСТИТЬ Вт
	|ИЗ
	|	Справочник.Лико_ФормулыПантонов.Состав КАК Лико_ФормулыПантоновСостав
	|ГДЕ
	|	Лико_ФормулыПантоновСостав.Ссылка.Номенклатура = &Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт.Номенклатура КАК Номенклатура,
	|	Вт.ПроцентВСмеси КАК ПроцентВСмеси,
	|	Вт.Количество КАК Количество,
	|	Вт.ЦеноваяГруппа КАК ЦеноваяГруппа,
	|	Вт.Количество КАК КоличествоУпаковок
	|ИЗ
	|	Вт КАК Вт";
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура );
	Запрос.УстановитьПараметр("КоличествоСмеси",КоличествоСмеси );
	Запрос.УстановитьПараметр("ЦГЭтилацетат",ЦГЭтилацетат ); 
	Запрос.УстановитьПараметр("КПЭтилацетата",КПЭтилацетата );
	
	
	
	СоставСмесиПлан.Загрузить(Запрос.Выполнить().Выгрузить());
	   НеВыводитьОСтаткиСостава=Истина;
	
	
КонецПроцедуры  //-Лико m.shenderov 11.01.2022

&НаСервереБезКонтекста
Функция ПолучитьКПЭтилацетата(Площадка,Период) //+Лико m.shenderov 11.01.2022
    УстановитьПривилегированныйРежим(Истина);
	Результат=1; 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.Лико_ЗначенияКоэффициентовПереноса.СрезПоследних(
	|			&Период,
	|			Площадка = &Площадка
	|				И Коэффициент = &Коэффициент) КАК Лико_ЗначенияКоэффициентовПереносаСрезПоследних";
	Запрос.УстановитьПараметр("Площадка",Площадка );
	Запрос.УстановитьПараметр("Период",Период );
	Запрос.УстановитьПараметр("Коэффициент",Справочники.Лико_КоэффициентыДляРасчетов.КоэффициентПереносаЭтилацетата );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат=Выборка.Значение;
		
	КонецЦикла;  
	
	Возврат Результат;
КонецФункции  //-Лико m.shenderov 11.01.2022

&НаКлиенте
Процедура СоставСмесиПланПриАктивизацииСтроки(Элемент)

	Если НеВыводитьОСтаткиСостава Тогда 
		НеВыводитьОСтаткиСостава=ложь;
		Возврат;	
	КонецЕсли;

	ТД=Элементы.СоставСмесиПлан.ТекущиеДанные; 
	Если ТД<>Неопределено Тогда
		НоменклатураОтбор=ТД.Номенклатура;
		// <-- Начало Лико Яцун С. В. 12.03.2024
		ЗаполнитьСвойстваМатериалаВПоляОтбора();
		// <-- Конец Лико Яцун С. В. 12.03.2024
		ЦеноваяГруппаОтбор=ТД.ЦеноваяГруппа;		
		УстановитьПараметрыОстатковКлиент(); 
	КонецЕсли;
	
	
КонецПроцедуры


Процедура УстановитьЗапросОстатковЛКБезРезерваРегионов () //+Лико m.shenderov 11.06.2021
	
	ОстаткиНоменклатуры.ТекстЗапроса=
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(РабочиеЦентры.Ссылка) КАК РабочийЦентр,
	|	&Площадка КАК Площадка,
	|	РабочиеЦентры.ЛикоЯчейка КАК Ячейка,
	|	&ТекущаяДата КАК ТекущаяДата,
	|	РабочиеЦентры.Лико_НаМашине КАК НаМашине,
	|	РабочиеЦентры.Лико_ПроизводственноеПомещение КАК ПроизводственноеПомещение
	|ПОМЕСТИТЬ ВтРабочиеЦентры
	|ИЗ
	|	Справочник.РабочиеЦентры КАК РабочиеЦентры
	|ГДЕ
	|	РабочиеЦентры.ЛикоЯчейка <> ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.Пустаяссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	РабочиеЦентры.ЛикоЯчейка,
	|	РабочиеЦентры.Лико_НаМашине,
	|	РабочиеЦентры.Лико_ПроизводственноеПомещение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РабочиеЦентры.Ссылка),
	|	&Площадка,
	|	РабочиеЦентры.Лико_НаМашине,
	|	&ТекущаяДата,
	|	РабочиеЦентры.Лико_НаМашине,
	|	РабочиеЦентры.Лико_ПроизводственноеПомещение
	|ИЗ
	|	Справочник.РабочиеЦентры КАК РабочиеЦентры
	|ГДЕ
	|	РабочиеЦентры.Лико_НаМашине <> ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.Пустаяссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	РабочиеЦентры.Лико_НаМашине,
	|	РабочиеЦентры.Лико_ПроизводственноеПомещение,
	|	РабочиеЦентры.Лико_НаМашине
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.Нарезка, ЗНАЧЕНИЕ(Справочник.ЯССМ_Нарезки.Пустаяссылка)) КАК Нарезка,
	|	СУММА(ВЫБОР
	|			КОГДА ВтРабочиеЦентры.РабочийЦентр ЕСТЬ NULL
	|				ТОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0)
	|		КОНЕЦ) КАК ОстатокНаСкладе,
	|	СУММА(ВЫБОР
	|			КОГДА ВтРабочиеЦентры.РабочийЦентр ЕСТЬ NULL
	|				ТОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0) * ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 0)
	|		КОНЕЦ) КАК ОСтатокНаСкладеУУ,
	|	СУММА(ВЫБОР
	|			КОГДА НЕ ВтРабочиеЦентры.РабочийЦентр ЕСТЬ NULL
	|				ТОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0)
	|		КОНЕЦ) КАК ОстатокНаМашине,
