			Структура.Вставить("Партнер",Партнер);
		КонецЕсли;

		
        Структура.Вставить("ТипСклада",ПредопределенноеЗначение("Перечисление.Лико_ТипСклада.СИМ")); 
		Структура.Вставить("УдаленныйСклад",Истина);  
