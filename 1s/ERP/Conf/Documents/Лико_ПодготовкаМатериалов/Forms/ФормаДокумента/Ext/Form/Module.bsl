	КонецЕсли;
	Если Поле.Имя="ОстаткиНоменклатурыУдаленныйСклад" Тогда
		Структура = Новый Структура;
		Структура.Вставить("Номенклатура",Элементы.ОстаткиНоменклатуры.ТекущиеДанные.Номенклатура);
