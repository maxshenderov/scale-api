	|	Номен.Лико_ПроверенТехнологом КАК ПроверенТехнологом,
	|	МАКСИМУМ(ВтОстатки.УдаленныйСклад) КАК УдаленныйСклад,
	|	МАКСИМУМ(ВтОстатки.УдаленныйСкладУУ) КАК УдаленныйСкладУУ,
	|	ВтОстатки.К2 КАК К2,
	|	ВтОстатки.РезервПодКлиента КАК РезервПодКлиента,
	|	ВтОстатки.РезервПодКлиентаУУ КАК РезервПодКлиентаУУ,
	|	МАКСИМУМ(ВтОстатки.ОтветХранение) КАК ОтветХранение,
	|	МАКСИМУМ(ВтОстатки.ОтветХранениеУУ) КАК ОтветХранениеУУ
	|ИЗ
	|	Справочник.Номенклатура КАК Номен
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтОстатки КАК ВтОстатки
	|		ПО (ВтОстатки.Номенклатура = Номен.Ссылка)
	|			И (ВЫБОР
	|				КОГДА &ЕстьНарезка
	|					ТОГДА НЕ Номен.Ссылка ЕСТЬ NULL
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ЕстьЦеноваяГруппа
	|				ТОГДА Номен.ЦеноваяГруппа = &ЦеноваяГруппа
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьНоменклатура
	|				ТОГДА Номен.Ссылка = &Номенклатура
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьКод
	|				ТОГДА Номен.Код ПОДОБНО &Код
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьНаименование
	|				ТОГДА Номен.Наименование ПОДОБНО &Наименование
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьАртикул
	|				ТОГДА Номен.Артикул ПОДОБНО &Артикул
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьНарезка
	|				ТОГДА ЕСТЬNULL(ВтОстатки.Нарезка.Размер, 0) > 0
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &НаНастройку
	|				ТОГДА ВтОстатки.Номенклатура.Наименование ПОДОБНО ""%на настр%""
	|						ИЛИ ВтОстатки.ВидНастроечногоМатериала <> ЗНАЧЕНИЕ(Перечисление.Лико_ВидыНастроечногоМатериала.ПустаяСсылка)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЭтоОрганизацияЛикофлекс
	|					И НЕ &ЭтоПробник
	|					И Номен.Лико_МатериалВыпущенныйНаРЦ = &РЦЛаминаторИксПак
	|				ТОГДА Номен.Лико_ПроверенТехнологом <> ДАТАВРЕМЯ(1, 1, 1)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьГруппаМатериалов
	|				ТОГДА Номен.Лико_СвойстваМатериала.ГруппаМатериалов = &ГруппаМатериалов
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьПсевдоним
	|				ТОГДА Номен.Лико_СвойстваМатериала.Псевдоним = &Псевдоним
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьЛицевойМатериал
	|				ТОГДА Номен.Лико_СвойстваМатериала.ЛицевойМатериал В (&ЛицевойМатериал)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьПокрытие
	|				ТОГДА Номен.Лико_СвойстваМатериала.ПокрытиеРулонногоМатериала В (&Покрытие)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьПодложка
	|				ТОГДА Номен.Лико_СвойстваМатериала.Подложка В (&Подложка)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьВидКлея
	|				ТОГДА Номен.Лико_СвойстваМатериала.КодКлея.ВидКлея = &ВидКлея
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьТипКлея
	|				ТОГДА Номен.Лико_СвойстваМатериала.КодКлея.ТипКлея = &ТипКлея
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьНаличиеПраймера
	|				ТОГДА Номен.Лико_СвойстваМатериала.НаличиеПраймера = &НаличиеПраймера
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьКольеИлиМаленькийРадиус
	|				ТОГДА Номен.Лико_СвойстваМатериала.КольеИлиМаленькийРадиус = &КольеИлиМаленькийРадиус
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьЭтикетка
	|				ТОГДА Номен.Лико_СвойстваМатериала.Этикетка = &Этикетка
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьПЕФлакон
	|				ТОГДА Номен.Лико_СвойстваМатериала.ПЕФлакон = &ПЕФлакон
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьПослеЗаморозки
	|				ТОГДА Номен.Лико_СвойстваМатериала.ПослеЗаморозки = &ПослеЗаморозки
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьЧестныйЗнак
	|				ТОГДА Номен.Лико_СвойстваМатериала.ЧестныйЗнак = &ЧестныйЗнак
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьМинимальнаяТемператураЭтикерования
	|				ТОГДА Номен.Лико_СвойстваМатериала.КодКлея.МинимальнаяТемператураЭтикерования <= &МинимальнаяТемператураЭтикерования
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьМинимальнаяТемператураЭксплуатации
	|				ТОГДА Номен.Лико_СвойстваМатериала.КодКлея.МинимальнаяТемператураЭксплуатации <= &МинимальнаяТемператураЭксплуатации
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьМаксимальнаяТемператураЭксплуатации
	|				ТОГДА Номен.Лико_СвойстваМатериала.КодКлея.МаксимальнаяТемператураЭксплуатации >= &МаксимальнаяТемператураЭксплуатации
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	Номен.Ссылка,
	|	ВтОстатки.Нарезка,
	|	ВтОстатки.Характеристика,
	|	ВтОстатки.Категория,
	|	ВтОстатки.ВидНастроечногоМатериала,
