	|		О.Номенклатура.ВидНоменклатуры.Лико_РулонныйМатериал КАК РулонныйМатериал
	|	ИЗ
	|		ВтОстаткиРегистра КАК О
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВтРабочиеЦентры КАК ВтРЦ
	|			ПО О.Ячейка = ВтРЦ.Ячейка
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВтТоварыК2 КАК ВтК2
	|			ПО О.Серия = ВтК2.Серия
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЕСТЬNULL(О.Нарезка, ЗНАЧЕНИЕ(Справочник.ЯССМ_Нарезки.ПустаяСсылка)),
	|		О.Номенклатура,
	|		О.Характеристика,
	|		О.ВидНастроечногоМатериала,
	|		ВЫБОР
	|			КОГДА НЕ ВтК2.Серия ЕСТЬ NULL
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Данные
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Номенклатура,
	|	Данные.Нарезка,
	|	Данные.Характеристика,
	|	Данные.ВидНастроечногоМатериала,
	|	Данные.К2,
	|	Данные.РулонныйМатериал
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	ВидНастроечногоМатериала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.Номенклатура, Лико_МатериалыВРезервеОстатки.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.Нарезка, Лико_МатериалыВРезервеОстатки.Характеристика.ЯССМ_Нарезка) КАК Нарезка,
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.ОстатокНаСкладе, 0) КАК ОстатокНаСкладе,
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.ОСтатокНаСкладеУУ, 0) КАК ОстатокНаСкладеУУ,
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.ОстатокНаМашине, 0) КАК ОстатокНаМашине,
