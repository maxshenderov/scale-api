&НаСервере

Процедура ЗаполнитьТаблицуМатериалов()
	Запрос= Новый Запрос;
	Документы.Лико_ПодготовкаМатериалов.СформироватьЗапросПоМатериалуВЗаказе(Запрос);
	Запрос.УстановитьПараметр("ЗаказКлиента",Объект.ЗаказКлиента);
	Запрос.УстановитьПараметр("НомерПроката",Объект.НомерПроката);
	Объект.Материалы.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыОстатковКлиент()
	ПоНоменклатуреОтбор		=Ложь; 
	ПоЦенновойГруппеОтбор	=Ложь;
	
	Если ФильтрПоНоменклатуре() Тогда
		ПоНоменклатуреОтбор= Не ПоЦеновойГруппе; 
		ПоЦенновойГруппеОтбор= ПоЦеновойГруппе;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НарезкаОтбор) 	Или 
		ЗначениеЗаполнено(АртикулОтбор) 	Или 
		ЗначениеЗаполнено(НаименованиеОтбор) Или
		ЗначениеЗаполнено(КодНоменклатурыОтбор) Или
		ГруппаМатериаловОтборИспользовать Или
		ПсевдонимОтборИспользовать Или
		ЛицевойМатериалОтборИспользовать Или
		ПокрытиеОтборИспользовать Или
		ПодложкаОтборИспользовать Или
		//КодКлеяОтборИспользовать Или
		ВидКлеяОтборИспользовать Или
		ТипКлеяОтборИспользовать Или
		//КлейДляЛаминацииОтборИспользовать Или
		НаличиеПраймераОтборИспользовать Или
		КольеИлиМаленькийРадиусОтборИспользовать Или
		ЭтикеткаОтборИспользовать Или
		ПЕФлаконОтборИспользовать Или
		ПослеЗаморозкиОтборИспользовать Или
		ЧестныйЗнакОтборИспользовать Или
		МинимальнаяТемператураЭтикерованияОтборИспользовать Или
		МинимальнаяТемператураЭксплуатацииОтборИспользовать Или
		МаксимальнаяТемператураЭксплуатацииОтборИспользовать	
		Тогда
		ПоНоменклатуреОтбор= Ложь; 
		ПоЦенновойГруппеОтбор= Ложь;
		
	КонецЕсли;
	
	Если НаНастройку Тогда
		
		ПоНоменклатуреОтбор		= Ложь; 
		ПоЦенновойГруппеОтбор	= Ложь;
		
		
	КонецЕсли;
	
	
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Артикул","%"+АртикулОтбор+"%");
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьАртикул",ЗначениеЗаполнено(АртикулОтбор));
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Код","%"+КодНоменклатурыОтбор+"%");
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьКод",ЗначениеЗаполнено(КодНоменклатурыОтбор));
	
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Нарезка",НарезкаОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьНарезка",ЗначениеЗаполнено(НарезкаОтбор));
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ПроизводственноеПомещение",ПроизводственноеПомещениеОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьПроизводственноеПомещение",ЗначениеЗаполнено(ПроизводственноеПомещениеОтбор));
	
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Наименование","%"+НаименованиеОтбор+"%");
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьНаименование",ЗначениеЗаполнено(НаименованиеОтбор));  	
	
	// <-- Начало Лико Яцун С. В. 26.02.2024
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ГруппаМатериалов",ГруппаМатериаловОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьГруппаМатериалов",ГруппаМатериаловОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Псевдоним",ПсевдонимОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьПсевдоним",ПсевдонимОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЛицевойМатериал",ЛицевойМатериалОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьЛицевойМатериал",ЛицевойМатериалОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Покрытие",ПокрытиеОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьПокрытие",ПокрытиеОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Подложка",ПодложкаОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьПодложка",ПодложкаОтборИспользовать); 
	
	//ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("КодКлея",КодКлеяОтбор);
	//ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьКодКлея",КодКлеяОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ВидКлея",ВидКлеяОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьВидКлея",ВидКлеяОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ТипКлея",ТипКлеяОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьТипКлея",ТипКлеяОтборИспользовать);
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("МинимальнаяТемператураЭтикерования",МинимальнаяТемператураЭтикерованияОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьМинимальнаяТемператураЭтикерования",МинимальнаяТемператураЭтикерованияОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("МинимальнаяТемператураЭксплуатации",МинимальнаяТемператураЭксплуатацииОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьМинимальнаяТемператураЭксплуатации",МинимальнаяТемператураЭксплуатацииОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("МаксимальнаяТемператураЭксплуатации",МаксимальнаяТемператураЭксплуатацииОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьМаксимальнаяТемператураЭксплуатации",МаксимальнаяТемператураЭксплуатацииОтборИспользовать);
	
	//ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("КлейДляЛаминации",КлейДляЛаминацииОтбор);
	//ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьКлейДляЛаминации",КлейДляЛаминацииОтборИспользовать); 
		
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("НаличиеПраймера",НаличиеПраймераОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьНаличиеПраймера",НаличиеПраймераОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("КольеИлиМаленькийРадиус",КольеИлиМаленькийРадиусОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьКольеИлиМаленькийРадиус",КольеИлиМаленькийРадиусОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Этикетка",ЭтикеткаОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьЭтикетка",ЭтикеткаОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ПЕФлакон",ПЕФлаконОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьПЕФлакон",ПЕФлаконОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ПослеЗаморозки",ПослеЗаморозкиОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьПослеЗаморозки",ПослеЗаморозкиОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЧестныйЗнак",ЧестныйЗнакОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьЧестныйЗнак",ЧестныйЗнакОтборИспользовать); 
	// <-- Конец Лико Яцун С. В. 26.02.2024
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЦеноваяГруппа",ЦеноваяГруппаОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьЦеноваяГруппа",ПоЦенновойГруппеОтбор);
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Номенклатура",НоменклатураОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьНоменклатура",ПоНоменклатуреОтбор);
	
	//ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Склад",Объект.Склад);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Организация",лОрганизация);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Площадка",Площадка);
	
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("НаНастройку",НаНастройку);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ТекущаяДата",ТекущаяДата());
	
	Если ПодготовкаПоПлощадке Тогда 
		
		ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Лико_Площадка",Лико_Площадка);
		
	КонецЕсли;
	
	
КонецПроцедуры



&НаКлиенте
Функция ФильтрПоНоменклатуре() //+Лико m.shenderov 21.12.2017
	
	Возврат (Не ЗначениеЗаполнено(НарезкаОтбор) 
	и Не ЗначениеЗаполнено(КодНоменклатурыОтбор) 
	и Не ЗначениеЗаполнено(АртикулОтбор)
	и Не ЗначениеЗаполнено(НаименованиеОтбор))
	и Не НаНастройку;
	
	
КонецФункции //-Лико m.shenderov 21.12.2017 

&НаКлиенте
Процедура МатериалыПриАктивизацииСтроки(Элемент)
	
	ТД=Элементы.Материалы.ТекущиеДанные;
	
	Если    ТД<>Неопределено Тогда
		
		НоменклатураОтбор=ТД.Номенклатура;
		// <-- Начало Лико Яцун С. В. 12.03.2024
		ЗаполнитьСвойстваМатериалаВПоляОтбора();
		// <-- Конец Лико Яцун С. В. 12.03.2024
		Если ТипЗнч(ТД.Затрата)=Тип("СправочникСсылка.Номенклатура") ТОгда
			ЦеноваяГруппаОтбор=ТД.ЦеноваяГруппа;
			
		Иначе
			ЦеноваяГруппаОтбор=ТД.Затрата;
		КонецЕсли;
		
		Если BRC  Тогда
			
			СоставСмесиПлан.Очистить();
			
			ВидНоменклатуры= Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Номенклатура,"ВидНоменклатуры");
			ВидНоменклатурыКраска=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ПредопределенноеЗначение("Справочник.Лико_ПредопределенныеЗначения.ВидНоменклатурыКраска"),"ЗначениеПараметра");
			
			Если ВидНоменклатуры=ВидНоменклатурыКраска Тогда
				ЗаполнитьСотавСмесиСервер(ТД.Номенклатура,Тд.Количество);
				
			КонецЕсли;		
		КонецЕсли;
	КонецЕсли; 
	
	
	УстановитьПараметрыОстатковКлиент();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвойстваМатериалаВПоляОтбора() // <-- Начало Лико Яцун С. В. 12.03.2024
	
	ГруппаМатериаловОтборИспользовать = Ложь;
	ПсевдонимОтборИспользовать = Ложь;
	ЛицевойМатериалОтборИспользовать = Ложь;
	ПокрытиеОтборИспользовать = Ложь;
	ПодложкаОтборИспользовать = Ложь;
	//КодКлеяОтборИспользовать = Ложь;
	ВидКлеяОтборИспользовать = Ложь;
	ТипКлеяОтборИспользовать = Ложь;
	//КлейДляЛаминацииОтборИспользовать = Ложь;
	НаличиеПраймераОтборИспользовать = Ложь;
	КольеИлиМаленькийРадиусОтборИспользовать = Ложь;
	ЭтикеткаОтборИспользовать = Ложь;
	ПЕФлаконОтборИспользовать = Ложь;
	ПослеЗаморозкиОтборИспользовать = Ложь;
	ЧестныйЗнакОтборИспользовать = Ложь;
	МинимальнаяТемператураЭтикерованияОтборИспользовать = Ложь;
	МинимальнаяТемператураЭксплуатацииОтборИспользовать = Ложь;
	МаксимальнаяТемператураЭксплуатацииОтборИспользовать = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_СвойстваМатериала.ГруппаМатериалов КАК ГруппаМатериалов,
		|	Лико_СвойстваМатериала.Псевдоним КАК Псевдоним,
		|	Лико_СвойстваМатериала.ЛицевойМатериал КАК ЛицевойМатериал,
		|	Лико_СвойстваМатериала.КодКлея.ТипКлея КАК ТипКлея,
		|	Лико_СвойстваМатериала.КодКлея.ВидКлея КАК ВидКлея,
		|	Лико_СвойстваМатериала.КодКлея КАК КодКлея,
		|	Лико_СвойстваМатериала.КлейДляЛаминации КАК КлейДляЛаминации,
		|	Лико_СвойстваМатериала.ПокрытиеРулонногоМатериала КАК ПокрытиеРулонногоМатериала,
		|	Лико_СвойстваМатериала.НаличиеПраймера КАК НаличиеПраймера,
		|	Лико_СвойстваМатериала.КольеИлиМаленькийРадиус КАК КольеИлиМаленькийРадиус,
		|	Лико_СвойстваМатериала.Этикетка КАК Этикетка,
		|	Лико_СвойстваМатериала.ПЕФлакон КАК ПЕФлакон,
		|	Лико_СвойстваМатериала.ПослеЗаморозки КАК ПослеЗаморозки,
		|	Лико_СвойстваМатериала.ЧестныйЗнак КАК ЧестныйЗнак,
		|	Лико_СвойстваМатериала.Подложка КАК Подложка,
		|	Лико_СвойстваМатериала.КодКлея.МинимальнаяТемператураЭтикерования КАК МинимальнаяТемператураЭтикерования,
		|	Лико_СвойстваМатериала.КодКлея.МинимальнаяТемператураЭксплуатации КАК МинимальнаяТемператураЭксплуатации,
		|	Лико_СвойстваМатериала.КодКлея.МаксимальнаяТемператураЭксплуатации КАК МаксимальнаяТемператураЭксплуатации
		|ИЗ
		|	Справочник.Лико_СвойстваМатериала КАК Лико_СвойстваМатериала
		|ГДЕ
		|	Лико_СвойстваМатериала.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураОтбор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ГруппаМатериаловОтбор = ВыборкаДетальныеЗаписи.ГруппаМатериалов;
		ПсевдонимОтбор = ВыборкаДетальныеЗаписи.Псевдоним;
		ЛицевойМатериалОтбор.Очистить();
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ЛицевойМатериал) Тогда
			ЛицевойМатериалОтбор.Добавить(ВыборкаДетальныеЗаписи.ЛицевойМатериал); 
		КонецЕсли;
		ПокрытиеОтбор.Очистить();
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПокрытиеРулонногоМатериала) Тогда
