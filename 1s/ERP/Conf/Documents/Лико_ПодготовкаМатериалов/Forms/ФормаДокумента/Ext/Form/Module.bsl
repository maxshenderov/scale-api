	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьКольеИлиМаленькийРадиус",КольеИлиМаленькийРадиусОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Этикетка",ЭтикеткаОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьЭтикетка",ЭтикеткаОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ПЕФлакон",ПЕФлаконОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьПЕФлакон",ПЕФлаконОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ПослеЗаморозки",ПослеЗаморозкиОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьПослеЗаморозки",ПослеЗаморозкиОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЧестныйЗнак",ЧестныйЗнакОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьЧестныйЗнак",ЧестныйЗнакОтборИспользовать); 
