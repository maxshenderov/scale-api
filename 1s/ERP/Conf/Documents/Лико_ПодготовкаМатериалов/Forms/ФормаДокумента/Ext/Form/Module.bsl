	|						КОГДА &ЕстьНаименование
	|							ТОГДА Номенклатура.Наименование ПОДОБНО &Наименование
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьАртикул
	|							ТОГДА Номенклатура.Артикул ПОДОБНО &Артикул
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьГруппаМатериалов
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.ГруппаМатериалов = &ГруппаМатериалов
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьПсевдоним
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.Псевдоним = &Псевдоним
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьЛицевойМатериал
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.ЛицевойМатериал В (&ЛицевойМатериал)
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьПокрытие
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.ПокрытиеРулонногоМатериала В (&Покрытие)
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьПодложка
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.Подложка В (&Подложка)
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьВидКлея
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.КодКлея.ВидКлея = &ВидКлея
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьТипКлея
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.КодКлея.ТипКлея = &ТипКлея
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьНаличиеПраймера
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.НаличиеПраймера = &НаличиеПраймера
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьКольеИлиМаленькийРадиус
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.КольеИлиМаленькийРадиус = &КольеИлиМаленькийРадиус
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьЭтикетка
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.Этикетка = &Этикетка
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьПЕФлакон
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.ПЕФлакон = &ПЕФлакон
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьПослеЗаморозки
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.ПослеЗаморозки = &ПослеЗаморозки
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьЧестныйЗнак
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.ЧестныйЗнак = &ЧестныйЗнак
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьМинимальнаяТемператураЭтикерования
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.КодКлея.МинимальнаяТемператураЭтикерования <= &МинимальнаяТемператураЭтикерования
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьМинимальнаяТемператураЭксплуатации
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.КодКлея.МинимальнаяТемператураЭксплуатации <= &МинимальнаяТемператураЭксплуатации
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|					И ВЫБОР
	|						КОГДА &ЕстьМаксимальнаяТемператураЭксплуатации
	|							ТОГДА Номенклатура.Лико_СвойстваМатериала.КодКлея.МаксимальнаяТемператураЭксплуатации >= &МаксимальнаяТемператураЭксплуатации
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ) КАК Лико_МатериалыВРезервеОстатки
	|		ПО ВтТоварыНаСкладах3.Номенклатура = Лико_МатериалыВРезервеОстатки.Номенклатура
	|			И ВтТоварыНаСкладах3.Характеристика = Лико_МатериалыВРезервеОстатки.Характеристика
	|			И ВтТоварыНаСкладах3.ВидНастроечногоМатериала = Лико_МатериалыВРезервеОстатки.ВидНастроечногоМатериала
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(Лико_МатериалыВРезервеОстатки.КоличествоОстаток, 0),
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.Номенклатура, Лико_МатериалыВРезервеОстатки.Номенклатура),
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.Нарезка, Лико_МатериалыВРезервеОстатки.Характеристика.ЯССМ_Нарезка),
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.ОстатокНаСкладе, 0),
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.ОСтатокНаСкладеУУ, 0),
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.ОстатокНаМашине, 0),
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.ОстатокНаМашинеУУ, 0),
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.ОстатокНаСкладе, 0) - ЕСТЬNULL(Лико_МатериалыВРезервеОстатки.КоличествоОстаток, 0),
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.ОСтатокНаСкладеУУ, 0) - ЕСТЬNULL(Лико_МатериалыВРезервеОстатки.КоличествоОстаток, 0) * (ЕСТЬNULL(Лико_МатериалыВРезервеОстатки.Характеристика.ЯССМ_Нарезка.Размер, 0) / 1000),
	|	ЕСТЬNULL(Лико_МатериалыВРезервеОстатки.КоличествоОстаток, 0) * (ЕСТЬNULL(Лико_МатериалыВРезервеОстатки.Характеристика.ЯССМ_Нарезка.Размер, 0) / 1000),
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.Характеристика, Лико_МатериалыВРезервеОстатки.Характеристика),
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.КатегорияТовара, 0),
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.ВидНастроечногоМатериала, Лико_МатериалыВРезервеОстатки.ВидНастроечногоМатериала),
	|	ВтТоварыНаСкладах3.Карантин,
	|	ВтТоварыНаСкладах3.КарантинУУ,
	|	ВтТоварыНаСкладах3.Блокировка,
	|	ВтТоварыНаСкладах3.БлокировкаУУ,
	|	ВтТоварыНаСкладах3.УдаленныйСклад,
	|	ВтТоварыНаСкладах3.УдаленныйСкладУУ,
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.К2, ЛОЖЬ),
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.ОстатокТоваровРезерв, 0),
	|	ЕСТЬNULL(ВтТоварыНаСкладах3.ОСтатокНаСкладеУУРезерв, 0),
	|	ВтТоварыНаСкладах3.ОтветХранение,
	|	ВтТоварыНаСкладах3.ОтветХранениеУУ
	|;
