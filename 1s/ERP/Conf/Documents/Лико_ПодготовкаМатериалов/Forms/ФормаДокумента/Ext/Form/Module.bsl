	|								ТОГДА О.BRC_БлокировкаВК = ЛОЖЬ
	|										И О.ДатаФормирования <= &BRC_ДатаКАрантина
	|							ИНАЧЕ ИСТИНА
	|						КОНЕЦ
	|					ТОГДА ЕСТЬNULL(О.ВНаличииОстаток, 0)
	|			КОНЕЦ) КАК ОстатокТоваровРезерв,
	|		СУММА(ВЫБОР
	|				КОГДА НЕ О.Резерв В (&Резерв)
	|						И НЕ О.ОтветственноеХранение
	|						И ВтРЦ.РабочийЦентр ЕСТЬ NULL
	|						И ВЫБОР
	|							КОГДА &BRC
	|								ТОГДА О.BRC_БлокировкаВК = ЛОЖЬ
	|										И О.ДатаФормирования <= &BRC_ДатаКАрантина
	|							ИНАЧЕ ИСТИНА
	|						КОНЕЦ
	|					ТОГДА ЕСТЬNULL(О.ВНаличииОстаток, 0) * ЕСТЬNULL(О.Числитель, 0)
	|			КОНЕЦ) КАК ОСтатокНаСкладеУУРезерв,
	|		СУММА(ВЫБОР
	|				КОГДА О.Резерв В (&Резерв)
	|						И О.ОтветственноеХранение
	|						И НЕ О.УдаленныйСклад
	|						И ВтРЦ.РабочийЦентр ЕСТЬ NULL
	|						И ВЫБОР
	|							КОГДА &BRC
	|								ТОГДА О.BRC_БлокировкаВК = ЛОЖЬ
	|										И О.ДатаФормирования <= &BRC_ДатаКАрантина
	|							ИНАЧЕ ИСТИНА
	|						КОНЕЦ
	|					ТОГДА ЕСТЬNULL(О.ВНаличииОстаток, 0)
	|			КОНЕЦ) КАК ОтветХранение,
	|		СУММА(ВЫБОР
	|				КОГДА О.Резерв В (&Резерв)
	|						И О.ОтветственноеХранение
	|						И НЕ О.УдаленныйСклад
	|						И ВтРЦ.РабочийЦентр ЕСТЬ NULL
	|						И ВЫБОР
	|							КОГДА &BRC
	|								ТОГДА О.BRC_БлокировкаВК = ЛОЖЬ
	|										И О.ДатаФормирования <= &BRC_ДатаКАрантина
	|							ИНАЧЕ ИСТИНА
	|						КОНЕЦ
	|					ТОГДА ЕСТЬNULL(О.ВНаличииОстаток, 0) * ЕСТЬNULL(О.Числитель, 0)
