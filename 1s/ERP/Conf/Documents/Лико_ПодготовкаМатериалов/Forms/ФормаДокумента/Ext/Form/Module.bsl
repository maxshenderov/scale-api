 
 #Область ОбработчикиСобытийФормы
 &НаСервере

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РезервПодРегионы = Документы.Лико_УстановкаРезерваМатериалов.СтартРезевированияПодРегионы();
	
	УстановитьВидимостьПоказатьОстаткиСервер();
    Площадка=Объект.РабочийЦентр.Лико_Площадка.Организация;
	лОрганизация = Объект.РабочийЦентр.Лико_Площадка.Организация;
     ПодготовкаПоПлощадке();	

	ДатаНачалаПроверкиТехнологомМатериала=Справочники.Лико_ПредопределенныеЗначения.ДатаНачалаПроверкиТехнологомМатериала.ЗначениеПараметра;
	ДатаКонтроля= ?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата,ТекущаяДата());
	ОрганизацияЛикофлекс=Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра;
	РЦЛаминаторИксПак=Справочники.РабочиеЦентры.НайтиПоРеквизиту("ПорядковыйНомер",300);
	ЭтоОрганизацияЛикофлекс=лОрганизация=ОрганизацияЛикофлекс;
	ЭтоПробник=Объект.ЗаказКлиента.ВидЗаказа=Перечисления.Лико_ВидыЗаказов.Пробник;
	
	Если лОрганизация=ОрганизацияЛикофлекс И ЗначениеЗаполнено(ДатаНачалаПроверкиТехнологомМатериала) И ДатаКонтроля>ДатаНачалаПроверкиТехнологомМатериала Тогда
		ПроверкаМатериаловТехнологом=Истина; 
	КонецЕсли;
	
	Если ПроверкаМатериаловТехнологом Тогда
		Элементы.ОстаткиНоменклатурыПроверенТехнологом.Видимость=Истина; 
	Иначе
		Элементы.ОстаткиНоменклатурыПроверенТехнологом.Видимость=Ложь;
	КонецЕсли;
	
	Если ПодготовкаПоПлощадке Тогда
		
		УстановитьЗапросОстатковЛКПоПлощадке();
		
	Иначе
		УстановитьЗапросОстатковЛК();
		
	КонецЕсли;
	
	
		BRC= Ложь;
	Если ЗначениеЗаполнено(лОрганизация) Тогда 
		Если ЗначениеЗаполнено(УправлениеСвойствами.ЗначениеСвойства(лОрганизация,"Лико_УчетНаСкладеПоBRC"))  Тогда 
			BRC= УправлениеСвойствами.ЗначениеСвойства(лОрганизация,"Лико_УчетНаСкладеПоBRC");
		КонецЕсли;
	КонецЕсли;
	BRC_ДатаКарантина = ТекущаяДата();
	Если  BRC Тогда 
		Элементы.Площадка.Видимость=Истина;
		BRC_ДатаКарантина=ТекущаяДата()-Справочники.Лико_ПредопределенныеЗначения.BRC_ДлительностьКарантинаЧас.ЗначениеПараметра*60*60;
		Если ПодготовкаПоПлощадке Тогда
			УстановитьЗапросОстатковПоПлощадке();
		Иначе
			
			УстановитьЗапросОстатков();
		КонецЕсли;
		
	КонецЕсли;
	Элементы.ГруппаСмеси.Видимость=BRC;
	
	Если ПодготовкаПоПлощадке Тогда 
		Элементы.Площадка.Видимость=Ложь;
	КонецЕсли;

	
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("BRC",BRC);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("BRC_ДатаКарантина",  BRC_ДатаКарантина);
	
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Артикул","%"+АртикулОтбор+"%");
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьАртикул",ЗначениеЗаполнено(АртикулОтбор));
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Код","%"+КодНоменклатурыОтбор+"%");
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьКод",ЗначениеЗаполнено(КодНоменклатурыОтбор));
	
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Нарезка",НарезкаОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьНарезка",ЗначениеЗаполнено(НарезкаОтбор));
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ПроизводственноеПомещение",ПроизводственноеПомещениеОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьПроизводственноеПомещение",ЗначениеЗаполнено(ПроизводственноеПомещениеОтбор));

	
	
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Наименование","%"+НаименованиеОтбор+"%");
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьНаименование",ЗначениеЗаполнено(НаименованиеОтбор));  	

	// <-- Начало Лико Яцун С. В. 26.02.2024
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ГруппаМатериалов",ГруппаМатериаловОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьГруппаМатериалов",ГруппаМатериаловОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Псевдоним",ПсевдонимОтбор);
