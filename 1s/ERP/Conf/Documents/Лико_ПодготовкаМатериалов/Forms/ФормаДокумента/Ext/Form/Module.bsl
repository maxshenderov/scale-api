	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЛицевойМатериал",ЛицевойМатериалОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьЛицевойМатериал",ЛицевойМатериалОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Покрытие",ПокрытиеОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьПокрытие",ПокрытиеОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Подложка",ПодложкаОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьПодложка",ПодложкаОтборИспользовать); 
	
	//ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("КодКлея",КодКлеяОтбор);
	//ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьКодКлея",КодКлеяОтборИспользовать); 
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ВидКлея",ВидКлеяОтбор);
