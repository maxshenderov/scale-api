	                                  |				ТОГДА Номен.Лико_СвойстваМатериала.ГруппаМатериалов = &ГруппаМатериалов
	                                  |			ИНАЧЕ ИСТИНА
	                                  |		КОНЕЦ
	                                  |	И ВЫБОР
	                                  |			КОГДА &ЕстьПсевдоним
	                                  |				ТОГДА Номен.Лико_СвойстваМатериала.Псевдоним = &Псевдоним
	                                  |			ИНАЧЕ ИСТИНА
	                                  |		КОНЕЦ
	                                  |	И ВЫБОР
	                                  |			КОГДА &ЕстьЛицевойМатериал
	                                  |				ТОГДА Номен.Лико_СвойстваМатериала.ЛицевойМатериал В (&ЛицевойМатериал)
	                                  |			ИНАЧЕ ИСТИНА
	                                  |		КОНЕЦ
	                                  |	И ВЫБОР
	                                  |			КОГДА &ЕстьПокрытие
	                                  |				ТОГДА Номен.Лико_СвойстваМатериала.ПокрытиеРулонногоМатериала В (&Покрытие)
	                                  |			ИНАЧЕ ИСТИНА
	                                  |		КОНЕЦ
	                                  |	И ВЫБОР
	                                  |			КОГДА &ЕстьПодложка
	                                  |				ТОГДА Номен.Лико_СвойстваМатериала.Подложка В (&Подложка)
	                                  |			ИНАЧЕ ИСТИНА
	                                  |		КОНЕЦ
	                                  |	И ВЫБОР
	                                  |			КОГДА &ЕстьВидКлея
	                                  |				ТОГДА Номен.Лико_СвойстваМатериала.КодКлея.ВидКлея = &ВидКлея
	                                  |			ИНАЧЕ ИСТИНА
	                                  |		КОНЕЦ
	                                  |	И ВЫБОР
	                                  |			КОГДА &ЕстьТипКлея
	                                  |				ТОГДА Номен.Лико_СвойстваМатериала.КодКлея.ТипКлея = &ТипКлея
	                                  |			ИНАЧЕ ИСТИНА
	                                  |		КОНЕЦ
	                                  |	И ВЫБОР
	                                  |			КОГДА &ЕстьНаличиеПраймера
	                                  |				ТОГДА Номен.Лико_СвойстваМатериала.НаличиеПраймера = &НаличиеПраймера
	                                  |			ИНАЧЕ ИСТИНА
	                                  |		КОНЕЦ
	                                  |	И ВЫБОР
	                                  |			КОГДА &ЕстьКольеИлиМаленькийРадиус
	                                  |				ТОГДА Номен.Лико_СвойстваМатериала.КольеИлиМаленькийРадиус = &КольеИлиМаленькийРадиус
	                                  |			ИНАЧЕ ИСТИНА
	                                  |		КОНЕЦ
	                                  |	И ВЫБОР
	                                  |			КОГДА &ЕстьЭтикетка
	                                  |				ТОГДА Номен.Лико_СвойстваМатериала.Этикетка = &Этикетка
	                                  |			ИНАЧЕ ИСТИНА
	                                  |		КОНЕЦ
	                                  |	И ВЫБОР
	                                  |			КОГДА &ЕстьПЕФлакон
	                                  |				ТОГДА Номен.Лико_СвойстваМатериала.ПЕФлакон = &ПЕФлакон
