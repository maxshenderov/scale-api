Процедура УстановитьЗапросОстатков()
	
	ОстаткиНоменклатуры.ТекстЗапроса= "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                                  |	РабочиеЦентры.Ссылка КАК РабочийЦентр,
	                                  |	РабочиеЦентры.ЛикоЯчейка КАК Ячейка,
	                                  |	РабочиеЦентры.Лико_ПроизводственноеПомещение КАК ПроизводственноеПомещение
	                                  |ПОМЕСТИТЬ ВтРабочиеЦентры
	                                  |ИЗ
	                                  |	Справочник.РабочиеЦентры КАК РабочиеЦентры
	                                  |ГДЕ
	                                  |	РабочиеЦентры.ЛикоЯчейка <> ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.Пустаяссылка)
	                                  |;
	                                  |
	                                  |////////////////////////////////////////////////////////////////////////////////
	                                  |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	                                  |	ТоварыВЯчейкахОстатки.Серия КАК Серия
	                                  |ПОМЕСТИТЬ ВтТоварыК2
	                                  |ИЗ
	                                  |	РегистрНакопления.ТоварыВЯчейках.Остатки(
	                                  |			,
	                                  |			Характеристика.ЯССМ_Нарезка.Размер > 0
	                                  |				И Ячейка.Лико_Организация = &Организация
	                                  |				И НЕ Ячейка.Лико_ПомещениеБрака
	                                  |				И НЕ Ячейка.Лико_ОтветственноеХранение
	                                  |				И Ячейка.Лико_ТипСклада <> ЗНАЧЕНИЕ(Перечисление.Лико_ТипСклада.Переработка)
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьНарезка
	                                  |						ТОГДА Характеристика.ЯССМ_Нарезка = &Нарезка
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьЦеноваяГруппа
	                                  |						ТОГДА Номенклатура.ЦеноваяГруппа = &ЦеноваяГруппа
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьНоменклатура
	                                  |						ТОГДА Номенклатура = &Номенклатура
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьКод
	                                  |						ТОГДА Номенклатура.Код ПОДОБНО &Код
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьНаименование
	                                  |						ТОГДА Номенклатура.Наименование ПОДОБНО &Наименование
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьАртикул
	                                  |						ТОГДА Номенклатура.Артикул ПОДОБНО &Артикул
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьГруппаМатериалов
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.ГруппаМатериалов = &ГруппаМатериалов
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьПсевдоним
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.Псевдоним = &Псевдоним
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьЛицевойМатериал
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.ЛицевойМатериал В (&ЛицевойМатериал)
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьПокрытие
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.ПокрытиеРулонногоМатериала В (&Покрытие)
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьПодложка
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.Подложка В (&Подложка)
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьВидКлея
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.КодКлея.ВидКлея = &ВидКлея
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьТипКлея
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.КодКлея.ТипКлея = &ТипКлея
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьНаличиеПраймера
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.НаличиеПраймера = &НаличиеПраймера
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьКольеИлиМаленькийРадиус
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.КольеИлиМаленькийРадиус = &КольеИлиМаленькийРадиус
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьЭтикетка
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.Этикетка = &Этикетка
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьПЕФлакон
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.ПЕФлакон = &ПЕФлакон
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьПослеЗаморозки
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.ПослеЗаморозки = &ПослеЗаморозки
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьЧестныйЗнак
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.ЧестныйЗнак = &ЧестныйЗнак
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьМинимальнаяТемператураЭтикерования
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.КодКлея.МинимальнаяТемператураЭтикерования <= &МинимальнаяТемператураЭтикерования
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьМинимальнаяТемператураЭксплуатации
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.КодКлея.МинимальнаяТемператураЭксплуатации <= &МинимальнаяТемператураЭксплуатации
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ
	                                  |				И ВЫБОР
	                                  |					КОГДА &ЕстьМаксимальнаяТемператураЭксплуатации
	                                  |						ТОГДА Номенклатура.Лико_СвойстваМатериала.КодКлея.МаксимальнаяТемператураЭксплуатации >= &МаксимальнаяТемператураЭксплуатации
	                                  |					ИНАЧЕ ИСТИНА
	                                  |				КОНЕЦ) КАК ТоварыВЯчейкахОстатки
	                                  |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_БракСерий КАК Лико_БракСерий
	                                  |		ПО ТоварыВЯчейкахОстатки.Серия = Лико_БракСерий.Серия
	                                  |ГДЕ
	                                  |	Лико_БракСерий.Решение = ЗНАЧЕНИЕ(Справочник.Лико_РешенияПоБракуМатериалов.ПеревестиНаК2)
	                                  |
	                                  |СГРУППИРОВАТЬ ПО
	                                  |	ТоварыВЯчейкахОстатки.Серия
	                                  |;
	                                  |
	                                  |////////////////////////////////////////////////////////////////////////////////
	                                  |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                                  |	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	                                  |	ЕСТЬNULL(ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.Нарезка, ЗНАЧЕНИЕ(Справочник.ЯССМ_Нарезки.Пустаяссылка)) КАК Нарезка,
	                                  |	СУММА(ВЫБОР
	                                  |			КОГДА ВтРабочиеЦентры.РабочийЦентр ЕСТЬ NULL
	                                  |				ТОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0)
	                                  |		КОНЕЦ) КАК ОстатокНаСкладе,
	                                  |	СУММА(ВЫБОР
	                                  |			КОГДА ВтРабочиеЦентры.РабочийЦентр ЕСТЬ NULL
	                                  |				ТОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0) * ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 1)
	                                  |		КОНЕЦ) КАК ОСтатокНаСкладеУУ,
	                                  |	СУММА(ВЫБОР
	                                  |			КОГДА НЕ ВтРабочиеЦентры.РабочийЦентр ЕСТЬ NULL
	                                  |				ТОГДА ВЫБОР
	                                  |						КОГДА НЕ &ЕстьПроизводственноеПомещение
	                                  |								ИЛИ &ЕстьПроизводственноеПомещение
	                                  |									И ВтРабочиеЦентры.ПроизводственноеПомещение = &ПроизводственноеПомещение
	                                  |							ТОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0)
	                                  |					КОНЕЦ
	                                  |		КОНЕЦ) КАК ОстатокНаМашине,
	                                  |	СУММА(ВЫБОР
	                                  |			КОГДА НЕ ВтРабочиеЦентры.РабочийЦентр ЕСТЬ NULL
	                                  |				ТОГДА ВЫБОР
	                                  |						КОГДА НЕ &ЕстьПроизводственноеПомещение
	                                  |								ИЛИ &ЕстьПроизводственноеПомещение
	                                  |									И ВтРабочиеЦентры.ПроизводственноеПомещение = &ПроизводственноеПомещение
	                                  |							ТОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0) * ЕСТЬNULL(ТоварыВЯчейкахОстатки.Упаковка.Числитель, 0)
	                                  |					КОНЕЦ
