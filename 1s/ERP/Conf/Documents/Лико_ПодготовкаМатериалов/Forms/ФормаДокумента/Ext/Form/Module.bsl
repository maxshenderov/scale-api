Процедура УстановитьЗапросОстатковЛК () //+Лико m.shenderov 11.06.2021
	
	
		Если Не Документы.Лико_УстановкаРезерваМатериалов.СтартРезевированияПодРегионы() Тогда
		
		УстановитьЗапросОстатковЛКБезРезерваРегионов();
		
		Возврат;
		
	КонецЕсли;

	
	ОстаткиНоменклатуры.ТекстЗапроса=
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(РабочиеЦентры.Ссылка) КАК РабочийЦентр,
	|	&Площадка КАК Площадка,
	|	РабочиеЦентры.ЛикоЯчейка КАК Ячейка,
	|	&ТекущаяДата КАК ТекущаяДата,
	|	РабочиеЦентры.Лико_НаМашине КАК НаМашине,
	|	РабочиеЦентры.Лико_ПроизводственноеПомещение КАК ПроизводственноеПомещение
	|ПОМЕСТИТЬ ВтРабочиеЦентры
	|ИЗ
	|	Справочник.РабочиеЦентры КАК РабочиеЦентры
	|ГДЕ
	|	РабочиеЦентры.ЛикоЯчейка <> ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.Пустаяссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	РабочиеЦентры.ЛикоЯчейка,
	|	РабочиеЦентры.Лико_НаМашине,
	|	РабочиеЦентры.Лико_ПроизводственноеПомещение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РабочиеЦентры.Ссылка),
	|	&Площадка,
	|	РабочиеЦентры.Лико_НаМашине,
	|	&ТекущаяДата,
	|	РабочиеЦентры.Лико_НаМашине,
	|	РабочиеЦентры.Лико_ПроизводственноеПомещение
	|ИЗ
	|	Справочник.РабочиеЦентры КАК РабочиеЦентры
	|ГДЕ
	|	РабочиеЦентры.Лико_НаМашине <> ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.Пустаяссылка)
	|
	|СГРУППИРОВАТЬ ПО
