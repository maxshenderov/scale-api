	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЦеноваяГруппа",ЦеноваяГруппаОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьЦеноваяГруппа",Ложь);
	
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Номенклатура",НоменклатураОтбор);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("ЕстьНоменклатура",Ложь);
	
	
	//ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Склад",Объект.Склад);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Организация",лОрганизация);
	ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Площадка",Площадка); 
	
	Если ПодготовкаПоПлощадке Тогда 
		ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Лико_Площадка",Лико_Площадка); 
	КонецЕсли;
	
	
	
	
	Партнер= Объект.ЗаказКлиента.Партнер;
	Регион = Объект.ЗаказКлиента.Регион;
	Массив = Новый Массив();
	Массив.Добавить(Справочники.Партнеры.ПустаяСсылка()); 
	Массив.Добавить(Партнер); 
		
	Если Не  BRC  Тогда
		Если РезервПодРегионы Тогда
			
			Массив.Добавить(Регион);
			Массив.Добавить(Неопределено);			
			Резерв.ЗагрузитьЗначения(Массив);
			
			
		ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Резерв",Массив);
	Иначе
		ОстаткиНоменклатуры.Параметры.УстановитьЗначениеПараметра("Партнер",Массив);
