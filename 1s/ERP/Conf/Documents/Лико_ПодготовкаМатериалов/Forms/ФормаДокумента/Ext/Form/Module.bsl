&НаКлиенте  
Процедура ВыбратьРезервЗавершение2(РезультатФормы, ПараметрФормы) Экспорт
	
	Если РезультатФормы<>Неопределено Тогда
		Если  ТипЗнч(РезультатФормы)=Тип("Структура") Тогда
			// <-- Начало Лико Яцун С. В. 27.04.2024
			//Данные=Элементы.ОстаткиНоменклатуры.ТекущиеДанные;
			Если ПараметрФормы = Неопределено Тогда
				Данные = Элементы.ОстаткиНоменклатуры.ТекущиеДанные;
			Иначе
				Данные = ПараметрФормы;
			КонецЕсли;
			// <-- Конец Лико Яцун С. В. 27.04.2024
			
			НовыйРезерв						 = Объект.Резервирование.Добавить();
			НовыйРезерв.Номенклатура		 = Данные.Номенклатура;
			Если ЭтоРулонныйМатериал(Данные.Номенклатура) Тогда
				
				НовыйРезерв.Нарезка			     = РезультатФормы.Нарезка; 
				НовыйРезерв.Характеристика		 = ПолучитьХарактеристикуПоНарезкеСервер(РезультатФормы.Нарезка);
				НовыйРезерв.Нарезка				 = РезультатФормы.Нарезка;
				НовыйРезерв.Упаковка			 = ПолучитьУпаковкуПоНарезкеСервер(РезультатФормы.Нарезка);
				НовыйРезерв.КоличествоУпаковок	 = РезультатФормы.Количество; 
				НовыйРезерв.Количество			 = НовыйРезерв.КоличествоУпаковок*Лико_Дополнительно.ЗначениеРеквизитаОбъекта(НовыйРезерв.Упаковка,"Числитель");
			Иначе
				НовыйРезерв.Количество	 = РезультатФормы.Количество;
				НовыйРезерв.КоличествоУпаковок	 = РезультатФормы.Количество;
				
			КонецЕсли;
			
			
			
			
			НовыйРезерв.СтатьяЗатрат         = Элементы.Материалы.ТекущиеДанные.СтатьяЗатрат;
			НовыйРезерв.ОжидаетсяПриход		 = РезультатФормы.ОжидаетсяПриход;
			НовыйРезерв.ОжидаетсяПереработка = РезультатФормы.ОжидаетсяПереработка;
			НовыйРезерв.ВидРабот 			 = Элементы.Материалы.ТекущиеДанные.ВидРабот;
			НовыйРезерв.ВидСекции 			 = Элементы.Материалы.ТекущиеДанные.ВидСекции;

			НовыйРезерв.НомерРаботы 	     = Элементы.Материалы.ТекущиеДанные.НомерРаботы;
			НовыйРезерв.ВидНастроечногоМатериала = Данные.ВидНастроечногоМатериала;
			НовыйРезерв.Настройка = Данные.ВидНастроечногоМатериала;
			НовыйРезерв.ВидНастроечногоМатериала = Данные.ВидНастроечногоМатериала;
			Если ЭтоЛикофлексНеЦифровой() Тогда
				
				НовыйРезерв.ОжидаетсяПриход = Истина;
				НовыйРезерв.ОжидаетсяПереработка = Истина;
				
				
				
			КонецЕсли;
			
			
			
			
			
			
			ОбщегоНазначенияУТКлиент.Провести(ЭтаФорма);  
			Элементы.ОстаткиНоменклатуры.Обновить();
			Если ЭтоЛикофлексНеЦифровой() Тогда
				
				Модифицированность=Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаКлиенте  
Процедура РезервироватьСоставСмесиКлиент() 
	
	ЗаписатьРезерв=Ложь;
	
	Для каждого Смесь Из СоставСмесиПлан Цикл
		
		
		НайденныеСтроки=Объект.Резервирование.НайтиСтроки(Новый Структура("Номенклатура",Смесь.Номенклатура));
		КолСпис=0;
		Для каждого НСтр Из НайденныеСтроки Цикл
			КолСпис=КолСпис+НСтр.Количество;	
		КонецЦикла;
		Списать=Смесь.Количество-КолСпис;
		Если Списать>0 Тогда
			ЗаписатьРезерв=Истина;
			
			НовыйРезерв						 = Объект.Резервирование.Добавить();
			НовыйРезерв.Номенклатура		 = Смесь.Номенклатура;
			НовыйРезерв.Количество	         = Списать;
			НовыйРезерв.КоличествоУпаковок	 = Списать;			  
			НовыйРезерв.СтатьяЗатрат 		 = Элементы.Материалы.ТекущиеДанные.СтатьяЗатрат;
			НовыйРезерв.ВидРабот             = Элементы.Материалы.ТекущиеДанные.ВидРабот;
			НовыйРезерв.НомерРаботы 	     = Элементы.Материалы.ТекущиеДанные.НомерРаботы; 
		КонецЕсли;		
	КонецЦикла; 	
	
	Если ЗаписатьРезерв Тогда
		
		ОбщегоНазначенияУТКлиент.Провести(ЭтаФорма);  
		Элементы.ОстаткиНоменклатуры.Обновить();
		
	КонецЕсли;
	
	
КонецПроцедуры


&НаКлиенте
Процедура РасчитатьКоличество(КоличествоРезервирования,СтрДанные = Неопределено)
	Если Объект.Организация=ПолучитьОрганизациюИксПакНаСервере() Тогда
		
		Материал=Элементы.СоставСмесиПлан.ТекущиеДанные;
		
		Если Материал=Неопределено Тогда
			Материал=Элементы.Материалы.ТекущиеДанные; 
		КонецЕсли;
		Номенклатура=Материал.Номенклатура;
		Структура = Новый Структура;
		Структура.Вставить("Номенклатура",Номенклатура);
		КоличествоРезервирования=Материал.КоличествоУпаковок;
		НайденныеСтроки=Объект.Резервирование.НайтиСтроки(Структура);
		Для каждого Стр Из НайденныеСтроки Цикл
			КоличествоРезервирования=КоличествоРезервирования-Стр.КоличествоУпаковок;
			
		КонецЦикла;
		КоличествоРезервирования=Макс(КоличествоРезервирования,0);
		
		Материал=Элементы.Материалы.ТекущиеДанные;
		
		СкорректироватьКоличествоРезервирования(КоличествоРезервирования,Материал.СтатьяЗатрат);
		
		
		
	Иначе	
		
		Материал=Элементы.Материалы.ТекущиеДанные;
		СтатьяЗатрат=Материал.СтатьяЗатрат;
		Структура = Новый Структура;
		Структура.Вставить("СтатьяЗатрат",СтатьяЗатрат);
		КоличествоРезервирования=Материал.КоличествоУпаковок;
		НайденныеСтроки=Объект.Резервирование.НайтиСтроки(Структура);
		Для каждого Стр Из НайденныеСтроки Цикл
			КоличествоРезервирования=КоличествоРезервирования-Стр.КоличествоУпаковок;
			
		КонецЦикла;
		КоличествоРезервирования=Макс(КоличествоРезервирования,0);
		
		СкорректироватьКоличествоРезервирования(КоличествоРезервирования,Материал.СтатьяЗатрат); 
		
		// <-- Начало Лико Яцун С. В. 27.04.2024
		//ТД=Элементы.ОстаткиНоменклатуры.ТекущиеДанные;
		Если СтрДанные = Неопределено Тогда
			ТД = Элементы.ОстаткиНоменклатуры.ТекущиеДанные;
		Иначе
			ТД = СтрДанные;
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 27.04.2024
		
		Если ТД<>Неопределено И Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Номенклатура,"Код")="n0000165119" Тогда
			
			КоличествоРезервирования=КоличествоРезервирования/3;	
			
		КонецЕсли;
		
		
	КонецЕсли;
	
	
	
КонецПроцедуры


