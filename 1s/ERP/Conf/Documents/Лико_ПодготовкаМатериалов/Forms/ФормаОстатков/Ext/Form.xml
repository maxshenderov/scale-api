			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ТоварыВЯчейкахОстатки.Ячейка.Помещение КАК Помещение,
	ТоварыВЯчейкахОстатки.Ячейка КАК Адрес,
	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры КАК ОбъектНоменклатуры,
	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	ТоварыВЯчейкахОстатки.Характеристика КАК Характеристика,
	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК Количество,
	ТоварыВЯчейкахОстатки.ВНаличииОстаток * ТоварыВЯчейкахОстатки.Упаковка.Числитель КАК КоличествоУУ,
	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.Нарезка КАК Нарезка,
	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.НомерПоставки КАК НомерПоставки,
	МАКСИМУМ(Лико_БракСерий.Документ) КАК Документ,
	ТоварыВЯчейкахОстатки.Ячейка.Владелец КАК Склад
ПОМЕСТИТЬ Вт
ИЗ
	РегистрНакопления.ТоварыВЯчейках.Остатки(
			,
			Номенклатура = &amp;Номенклатура
				И Характеристика = &amp;Характеристика
				И Серия.ЯССМ_ОбъектНоменклатуры.ВидНастроечногоМатериала = &amp;ВидНастроечногоМатериала
				И Ячейка.Лико_ТипСклада = &amp;ТипСклада
				И НЕ Ячейка.Лико_ПомещениеБрака
				И Ячейка.Лико_Организация = &amp;Площадка
				И ВЫБОР
					КОГДА &amp;ПоказыватьВсе
						ТОГДА ИСТИНА
					ИНАЧЕ Ячейка.Лико_УдаленныйСклад = &amp;УдаленныйСклад
				КОНЕЦ
				И Ячейка.Лико_ОтветственноеХранение = &amp;ОтветХранение) КАК ТоварыВЯчейкахОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_БракСерий КАК Лико_БракСерий
		ПО ТоварыВЯчейкахОстатки.Серия = Лико_БракСерий.Серия
			И (Лико_БракСерий.Решение = ЗНАЧЕНИЕ(Справочник.Лико_РешенияПоБракуМатериалов.ПеревестиНаК2))
ГДЕ
	ВЫБОР
			КОГДА Лико_БракСерий.Серия ЕСТЬ NULL
				ТОГДА ЛОЖЬ
			ИНАЧЕ ИСТИНА
		КОНЕЦ = &amp;К2

СГРУППИРОВАТЬ ПО
	ТоварыВЯчейкахОстатки.Ячейка,
	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры,
	ТоварыВЯчейкахОстатки.Номенклатура,
	ТоварыВЯчейкахОстатки.Характеристика,
	ТоварыВЯчейкахОстатки.Ячейка.Помещение,
	ТоварыВЯчейкахОстатки.ВНаличииОстаток,
	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.Нарезка,
	ТоварыВЯчейкахОстатки.Серия.ЯССМ_ОбъектНоменклатуры.НомерПоставки,
	ТоварыВЯчейкахОстатки.ВНаличииОстаток * ТоварыВЯчейкахОстатки.Упаковка.Числитель,
	ТоварыВЯчейкахОстатки.Ячейка.Владелец
;

