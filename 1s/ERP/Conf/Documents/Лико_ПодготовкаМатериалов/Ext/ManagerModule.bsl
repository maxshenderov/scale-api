Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументОбъект)
	
	ДокументСсылка = ДокументОбъект.Ссылка;
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПодготовкаМатериалов.Дата КАК Период,
	|	Лико_ПодготовкаМатериалов.Номер КАК Номер,
	|	Лико_ПодготовкаМатериалов.ЗаказКлиента КАК ЗаказКлиента,
	|	Лико_ПодготовкаМатериалов.РабочийЦентр КАК РабочийЦентр,
	|	Лико_ПодготовкаМатериалов.Организация КАК Организация,
	|	Лико_ПодготовкаМатериалов.Склад КАК Склад,
	|	Лико_ПодготовкаМатериалов.НомерПроката КАК НомерПроката
	|ИЗ
	|	Документ.Лико_ПодготовкаМатериалов КАК Лико_ПодготовкаМатериалов
	|ГДЕ
	|	Лико_ПодготовкаМатериалов.Ссылка = &Ссылка";
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	
	Запрос.УстановитьПараметр("Склад",       				Реквизиты.Склад);
	Запрос.УстановитьПараметр("Период",      				Реквизиты.Период);
	Запрос.УстановитьПараметр("РабочийЦентр",      			Реквизиты.РабочийЦентр);
	Запрос.УстановитьПараметр("ЗаказКлиента", 				Реквизиты.ЗаказКлиента);
	Запрос.УстановитьПараметр("Организация",    			Реквизиты.Организация);
	Запрос.УстановитьПараметр("НомерПроката",    			Реквизиты.НомерПроката);
	
	Если ДокументСсылка.Организация=Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра И
		ДокументСсылка.РабочийЦентр.ВидРабочегоЦентра=Справочники.ВидыРабочихЦентров.Indigo Тогда
		Запрос.УстановитьПараметр("ЦифраЛикофлекс",    			Истина);  		
	Иначе
		Запрос.УстановитьПараметр("ЦифраЛикофлекс",    			Ложь); 		
	КонецЕсли;
	
	
	
	
КонецПроцедуры


Функция ТекстЗапросаТаблицаЛико_МатериалыВРезерве(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "Лико_МатериалыВРезерве";
	
	ТекстЗапроса = 
	//Выполнено - Приходуем всю таблицу размещения
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	Лико_ПодготовкаМатериаловРезервирование.Ссылка.ЗаказКлиента КАК ЗаказКлиента,
	|	Лико_ПодготовкаМатериаловРезервирование.Номенклатура КАК Номенклатура,
	|	Лико_ПодготовкаМатериаловРезервирование.Характеристика КАК Характеристика,
	|	&НомерПроката КАК НомерПроката,
	|	Лико_ПодготовкаМатериаловРезервирование.КоличествоУпаковок КАК Количество,
	|	&Организация КАК Организация,
	|	&Склад КАК Склад,
	|	Лико_ПодготовкаМатериаловРезервирование.ВидНастроечногоМатериала КАК ВидНастроечногоМатериала
	|ИЗ
	|	Документ.Лико_ПодготовкаМатериалов.Резервирование КАК Лико_ПодготовкаМатериаловРезервирование
	|ГДЕ
	|	Лико_ПодготовкаМатериаловРезервирование.Ссылка = &Ссылка
	|	И НЕ Лико_ПодготовкаМатериаловРезервирование.Ссылка.СнятиеРезерва
	|	И Лико_ПодготовкаМатериаловРезервирование.Ссылка.ЗаказКлиента.Состояние <> ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаказов.Закрыт)
	|	И Лико_ПодготовкаМатериаловРезервирование.Ссылка.ЗаказКлиента.Состояние <> ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаказов.Выполнен)
	|	И Лико_ПодготовкаМатериаловРезервирование.Ссылка.ЗаказКлиента.Состояние <> ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаказов.Аннулирован)
	|	И Лико_ПодготовкаМатериаловРезервирование.Ссылка.РабочийЦентр <> ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.Пустаяссылка)
	|	И НЕ &ЦифраЛикофлекс
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	ВложенныйЗапрос.ЗаказКлиента,
	|	Лико_ТоварыКРаспределению.Номенклатура,
	|	Лико_ТоварыКРаспределению.Характеристика,
	|	&НомерПроката,
	|	СУММА(ВЫБОР
	|			КОГДА ВложенныйЗапрос.КоличествоУпаковок - Лико_ТоварыКРаспределению.Количество < 0
	|				ТОГДА 0
	|			ИНАЧЕ Лико_ТоварыКРаспределению.Количество
	|		КОНЕЦ),
	|	&Организация,
	|	&Склад,
	|	ВложенныйЗапрос.ВидНастроечногоМатериала
	|ИЗ
	|	(ВЫБРАТЬ
	|		Лико_ПодготовкаМатериаловРезервирование.Ссылка.ЗаказКлиента КАК ЗаказКлиента,
	|		Лико_ПодготовкаМатериаловРезервирование.Номенклатура КАК Номенклатура,
	|		Лико_ПодготовкаМатериаловРезервирование.Характеристика КАК Характеристика,
	|		СУММА(Лико_ПодготовкаМатериаловРезервирование.КоличествоУпаковок) КАК КоличествоУпаковок,
	|		Лико_ПодготовкаМатериаловРезервирование.Ссылка КАК Ссылка,
	|		Лико_ПодготовкаМатериаловРезервирование.ВидНастроечногоМатериала КАК ВидНастроечногоМатериала
	|	ИЗ
	|		Документ.Лико_ПодготовкаМатериалов.Резервирование КАК Лико_ПодготовкаМатериаловРезервирование
	|	ГДЕ
	|		Лико_ПодготовкаМатериаловРезервирование.Ссылка = &Ссылка
	|		И НЕ Лико_ПодготовкаМатериаловРезервирование.Ссылка.СнятиеРезерва
	|		И Лико_ПодготовкаМатериаловРезервирование.Ссылка.РабочийЦентр <> ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.ПустаяСсылка)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Лико_ПодготовкаМатериаловРезервирование.Ссылка.ЗаказКлиента,
	|		Лико_ПодготовкаМатериаловРезервирование.Номенклатура,
	|		Лико_ПодготовкаМатериаловРезервирование.Характеристика,
	|		Лико_ПодготовкаМатериаловРезервирование.Ссылка,
	|		Лико_ПодготовкаМатериаловРезервирование.ВидНастроечногоМатериала) КАК ВложенныйЗапрос
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ТоварыКРаспределению КАК Лико_ТоварыКРаспределению
	|		ПО ВложенныйЗапрос.ЗаказКлиента = Лико_ТоварыКРаспределению.ЗаказКлиента
	|			И ВложенныйЗапрос.Номенклатура = Лико_ТоварыКРаспределению.Номенклатура
	|			И ВложенныйЗапрос.Характеристика = Лико_ТоварыКРаспределению.Характеристика
	|			И ВложенныйЗапрос.Ссылка.РабочийЦентр = Лико_ТоварыКРаспределению.РабочийЦентр
	|ГДЕ
	|	НЕ ВложенныйЗапрос.Ссылка.СнятиеРезерва
	|	И ВложенныйЗапрос.Ссылка.ЗаказКлиента.Состояние <> ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаказов.Закрыт)
	|	И ВложенныйЗапрос.Ссылка.ЗаказКлиента.Состояние <> ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаказов.Выполнен)
	|	И ВложенныйЗапрос.Ссылка.ЗаказКлиента.Состояние <> ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаказов.Аннулирован)
	|	И НЕ &ЦифраЛикофлекс
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ТоварыКРаспределению.Номенклатура,
	|	Лико_ТоварыКРаспределению.Характеристика,
	|	ВложенныйЗапрос.ЗаказКлиента,
	|	ВложенныйЗапрос.ВидНастроечногоМатериала
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	Лико_ПодготовкаМатериаловРезервирование.Ссылка.ЗаказКлиента,
	|	Лико_ПодготовкаМатериаловРезервирование.Номенклатура,
	|	Лико_ПодготовкаМатериаловРезервирование.Характеристика,
	|	&НомерПроката,
