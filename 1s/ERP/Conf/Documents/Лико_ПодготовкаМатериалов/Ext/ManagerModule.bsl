	|		ИНАЧЕ Лико_ПодготовкаМатериаловРезервирование.ВидРабот
	|	КОНЕЦ КАК ВидРаботы,
	|	Лико_ПодготовкаМатериаловРезервирование.НомерРаботы КАК НомерРаботы,
	|	Лико_ПодготовкаМатериаловРезервирование.СтатьяЗатрат КАК СтатьяЗатрат,
	|	Лико_ПодготовкаМатериаловРезервирование.Настройка КАК Настройка,
	|	Лико_ПодготовкаМатериаловРезервирование.Печать КАК Печать,
	|	Лико_ПодготовкаМатериаловРезервирование.ВидСекции КАК ВидСекции
	|ПОМЕСТИТЬ Вт
	|ИЗ
	|	Документ.Лико_ПодготовкаМатериалов.Резервирование КАК Лико_ПодготовкаМатериаловРезервирование
	|ГДЕ
	|	Лико_ПодготовкаМатериаловРезервирование.Номенклатура = &Номенклатура
	|	И Лико_ПодготовкаМатериаловРезервирование.Ссылка.ЗаказКлиента = &ЗаказКлиента
	|	И НЕ Лико_ПодготовкаМатериаловРезервирование.Ссылка.СнятиеРезерва
	|	И ВЫБОР
	|			КОГДА &ЕстьНарезка
	|				ТОГДА Лико_ПодготовкаМатериаловРезервирование.Нарезка = &Нарезка
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт.ВидРаботы КАК ВидРабот,
	|	ВЫБОР
	|		КОГДА Вт.ВидРаботы = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Печать)
	|				И Вт.НомерРаботы = 0
	|			ТОГДА 1
	|		ИНАЧЕ Вт.НомерРаботы
	|	КОНЕЦ КАК НомерРаботы,
	|	Вт.СтатьяЗатрат КАК СтатьяЗатрат,
	|	Вт.Настройка КАК Настройка,
	|	Вт.Печать КАК Печать,
	|	Вт.ВидСекции КАК ВидСекции
	|ИЗ
	|	Вт КАК Вт
	|
	|СГРУППИРОВАТЬ ПО
	|	Вт.ВидРаботы,
	|	Вт.СтатьяЗатрат,
	|	Вт.Настройка,
	|	Вт.Печать,
	|	ВЫБОР
	|		КОГДА Вт.ВидРаботы = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Печать)
	|				И Вт.НомерРаботы = 0
	|			ТОГДА 1
	|		ИНАЧЕ Вт.НомерРаботы
	|	КОНЕЦ,
	|	Вт.ВидСекции";
	Запрос.УстановитьПараметр("ЗаказКлиента",ЗаказКлиента );
	//Запрос.УстановитьПараметр("НомерПроката",НомерПроката );
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура );
	Запрос.УстановитьПараметр("ЕстьНарезка",ЗначениеЗаполнено(Нарезка));
	Запрос.УстановитьПараметр("Нарезка",Нарезка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Сч=0;
	Массив = Новый Массив();
	Пока Выборка.Следующий() Цикл
		Если Сч=0 Тогда 
			Структура.ВидРабот=Выборка.ВидРабот;
			Структура.НомерРаботы=Выборка.НомерРаботы;
			Структура.СтатьяЗатрат=Выборка.СтатьяЗатрат;
			Структура.Настройка=Выборка.Настройка;
			Структура.Печать=Выборка.Печать;
			Структура.ВидСекции=Выборка.ВидСекции;

		КонецЕсли;
		Сч=1;
		Структура2 = Новый Структура;
		Структура2.Вставить("ВидРабот",Выборка.ВидРабот);
		Структура2.Вставить("НомерРаботы",Выборка.НомерРаботы);
		Структура2.Вставить("СтатьяЗатрат",Выборка.СтатьяЗатрат);
		Структура2.Вставить("Настройка",Выборка.Настройка);
		Структура2.Вставить("Печать",Выборка.Печать); 
		Структура2.Вставить("ВидСекции",Выборка.ВидСекции);

		Массив.Добавить(Структура2);
	КонецЦикла; 
	Структура.СписокВидовРабот=Массив;
	Возврат Структура;
	
