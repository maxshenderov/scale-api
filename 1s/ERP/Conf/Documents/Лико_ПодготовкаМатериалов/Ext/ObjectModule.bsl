Процедура ПроверкаНаличеИндиго() //+Лико m.shenderov 20.06.2018
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПодготовкаМатериалов.НаличиеМатериала КАК НаличиеМатериала,
	|	Лико_ПодготовкаМатериалов.ДатаПриходаМатериала КАК ДатаПриходаМатериала
	|ИЗ
	|	Документ.Лико_ПодготовкаМатериалов КАК Лико_ПодготовкаМатериалов
	|ГДЕ
	|	Лико_ПодготовкаМатериалов.ЗаказКлиента = &ЗаказКлиента
	|	И Лико_ПодготовкаМатериалов.Проведен
	|	И Лико_ПодготовкаМатериалов.Ссылка <> &Ссылка
	|	И Лико_ПодготовкаМатериалов.РабочийЦентр.ВидРабочегоЦентра = &ВидРабочегоЦентра";
	Запрос.УстановитьПараметр("ЗаказКлиента",ЗаказКлиента);
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.УстановитьПараметр("ВидРабочегоЦентра",Справочники.ВидыРабочихЦентров.Indigo);
	РезультатЗапроса=Запрос.Выполнить();
	Выборка =РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаличиеМатериала			=Выборка.НаличиеМатериала;
		ДатаПриходаМатериала		=Выборка.ДатаПриходаМатериала;
		
	КонецЦикла; 
	
	
	
	
КонецПроцедуры //-Лико m.shenderov 20.06.2018

Функция ЗаполнитьМатериалСтрокой(СтатьяЗатрат)
	МатериалСтрокой="";
	//СтатьяЗатрат=Справочники.Лико_СтатьиЗатрат.ОсновнойМатериал;
	Номенклатуры=Резервирование.Выгрузить();
	Номенклатуры.Свернуть("Номенклатура");
	НетРезерва=Истина; 	
	Для каждого СтрНоменклатура Из Номенклатуры Цикл
		Структура = Новый Структура;
		Структура.Вставить("Номенклатура",СтрНоменклатура.Номенклатура);
		Структура.Вставить("СтатьяЗатрат",СтатьяЗатрат);
		СтрокиРезервирование=Резервирование.НайтиСтроки(Структура);
		Если  СтрокиРезервирование.Количество()>0 Тогда
			НетРезерва=Ложь; 			
			МатериалСтрокой=МатериалСтрокой+СтрНоменклатура.Номенклатура.Наименование+ " ("; 			
			н=0;
			Для каждого СтрРезерв  Из СтрокиРезервирование Цикл
				н=н+1;	
				МатериалСтрокой=МатериалСтрокой+?(н>1,", ","")+СтрРезерв.Нарезка.Наименование;
				Если н=СтрокиРезервирование.Количество()Тогда
					МатериалСтрокой=МатериалСтрокой+")";	
				КонецЕсли;				
			КонецЦикла;			
			МатериалСтрокой=МатериалСтрокой+"; ";			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НетРезерва Тогда 	
		
		Номенклатуры=Материалы.Выгрузить();
		Номенклатуры.Свернуть("ЦеноваяГруппа");
		
		Для каждого СтрЦеноваяГруппа Из Номенклатуры Цикл
			Структура = Новый Структура;
			Структура.Вставить("ЦеноваяГруппа",СтрЦеноваяГруппа.ЦеноваяГруппа);
			Структура.Вставить("СтатьяЗатрат",СтатьяЗатрат);
			СтрокиНоменклатура=Материалы.НайтиСтроки(Структура);
			Если  СтрокиНоменклатура.Количество()>0 Тогда
				
				МатериалСтрокой=МатериалСтрокой+СтрЦеноваяГруппа.ЦеноваяГруппа.Наименование+ " ("; 			
				н=0;
				Для каждого СтрНоменклатура  Из СтрокиНоменклатура Цикл
					н=н+1;	
					МатериалСтрокой=МатериалСтрокой+?(н>1,", ","")+СтрНоменклатура.Нарезка.Наименование;
					Если н=СтрокиНоменклатура.Количество()Тогда
						МатериалСтрокой=МатериалСтрокой+") ";	
					КонецЕсли;				
				КонецЦикла;			
				МатериалСтрокой=МатериалСтрокой+", ";	
			КонецЕсли; 		
			
		КонецЦикла;
		
		
		
		
		
	КонецЕсли;
	
	Возврат ?(ЗначениеЗаполнено(МатериалСтрокой),Лев(МатериалСтрокой,СтрДлина(МатериалСтрокой)-2),"");	
	
	
	
	
	
КонецФункции


