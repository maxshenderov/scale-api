			Иначе 				
				Документы.Лико_ПодготовкаМатериалов.СформироватьЗапросПоМатериалуВЗаказе(Запрос);
			КонецЕсли;	
		КонецЕсли;

		Запрос.УстановитьПараметр("ЗаказКлиента",ЗаказКлиента);
		Запрос.УстановитьПараметр("НомерПроката",НомерПроката);
		Запрос.УстановитьПараметр("РабочийЦентр",РабочийЦентр);
		Запрос.УстановитьПараметр("ВидРабочегоЦентра",РабочийЦентр.ВидРабочегоЦентра);
	КонецЕсли;

	Материалы.Загрузить(Запрос.Выполнить().Выгрузить());

	Структура = Новый Структура;
