	ИнициализироватьДокумент(ДанныеЗаполнения); 		
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		
	КонецЕсли;	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 	
	Если Не ДополнительныеСвойства.Свойство("НеПроверятьЗаполнениеПолейНастройкаПечать") Тогда
		
		ПроверитьЗаполнениеПолейНастройкаПечать(Отказ); 
		
	КонецЕсли;
	
	
	//ПроверкаМатериаловТехнологом(отказ);
	
		
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
	РабочийЦентр=ОпределитьРабочийЦентр();
	Если РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда 	
		ЕСли 	Резервирование.Количество()=0 и СнятиеРезерва Тогда
			СнятиеРезерва=Ложь;
		КонецЕсли;
	КонецЕсли;
	Если РежимЗаписи=РежимЗаписиДокумента.ОтменаПроведения Тогда
		//ДатаПриходаМатериала		=Неопределено;
		//ДатаПриходаМатериалаТекст	=Неопределено;
		//НаличиеМатериала			=Неопределено;
	КонецЕсли;
	
	ЗаказПоставщику=ПроверитьЕстьЗаказПоставщику();
	 //+ ---> Лико2.5 m.shenderov 30.03.2022
	ПроведениеДокументов.ПередЗаписьюДокумента(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	//- <--- Лико2.5 m.shenderov 30.03.2022 
	
	
	// --> Начало Лико Субботин 01.03.2023 	
	Если ЗначениеЗаполнено(ДатаПечатиТребования) Тогда
		
		Если ВернутьКонтрольныйХэш(Истина) <> ВернутьКонтрольныйХэш(Ложь) Тогда
			ДатаИзменения = ТекущаяДата();
		КонецЕсли;
	КонецЕсли;
    // <-- Конец Лико Субботин 01.03.2023 
	
	

	
КонецПроцедуры   

Функция ВернутьКонтрольныйХэш(ХэшССылки)
	
	СтруктураДляПроверки = новый Структура; 
	Если ХэшССылки Тогда
		СтруктураДляПроверки.Вставить("Резервирование", Ссылка.Резервирование.Выгрузить()); 
	иначе	
		СтруктураДляПроверки.Вставить("Резервирование", Резервирование.Выгрузить());
	КонецЕсли;  

	Возврат ОбщегоНазначения.КонтрольнаяСуммаСтрокой(СтруктураДляПроверки)

	
КонецФункции


Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
		Если Отказ Тогда
		Возврат;
	КонецЕсли;


	
ПроведениеДокументов.ОбработкаПроведенияДокумента(ЭтотОбъект, Отказ);
