		BRC= УправлениеСвойствами.ЗначениеСвойства(РабочийЦентр.Лико_Площадка.Организация,"Лико_УчетНаСкладеПоBRC");
		// <-- Конец Лико Ефимов ЕВВ 04.10.2024
		BRC=?(ЗначениеЗаполнено(BRC),BRC,Ложь);
