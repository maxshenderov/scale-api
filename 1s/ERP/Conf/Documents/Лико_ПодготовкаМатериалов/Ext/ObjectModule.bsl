Функция ПроверитьЕстьЗаказПоставщику() //+Лико m.shenderov 27/10/2019
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	ЗаказПоставщикуЛико_РезервПодЗаказКлиента.Ссылка КАК Распоряжение
	|ИЗ
	|	Документ.ЗаказПоставщику.Лико_РезервПодЗаказКлиента КАК ЗаказПоставщикуЛико_РезервПодЗаказКлиента
	|ГДЕ
	|	ЗаказПоставщикуЛико_РезервПодЗаказКлиента.ЗаказКлиента = &ЗаказКлиента
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПоставщикуЛико_РезервПодЗаказКлиента.Ссылка.ДатаПервогоПоступления УБЫВ";
	Запрос.УстановитьПараметр("ЗаказКлиента",ЗаказКлиента);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Возврат  Выборка.Распоряжение;
		
	КонецЦикла; 
	
	
	
КонецФункции //-Лико m.shenderov 27/10/2019 


