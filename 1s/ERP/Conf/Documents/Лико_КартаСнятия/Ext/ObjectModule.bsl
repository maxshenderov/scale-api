
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект,ДанныеЗаполнения);
	КонецЕсли; 
КонецПроцедуры


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	ПроверитьНаличиеКартыСТакимиПараметрами(РежимЗаписи, Отказ);
	
	Если НЕ Отказ И Заказ.Состояние = Перечисления.Лико_СостоянияЗаказов.Закрыт И НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Кому = "Uchet@okil-sato.ru";
		Тема = "Создана карта снятия " + Номер + " к закрытому заказу " + Заказ.НомерБезПрефикса;
		ТекстПисьма = Тема;
		Лико_Планирование.ОтправитьПисьмо(ТекстПисьма, Тема, Кому);		
	КонецЕсли;

	
КонецПроцедуры

Процедура ПроверитьНаличиеКартыСТакимиПараметрами(РежимЗаписи, Отказ)
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		 Возврат;
	КонецЕсли;
	
	КартаУжеЕсть = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_КартаСнятия.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Лико_КартаСнятия КАК Лико_КартаСнятия
		|ГДЕ
		|	Лико_КартаСнятия.Проведен
		|	И НЕ Лико_КартаСнятия.ПометкаУдаления
		|	И Лико_КартаСнятия.Заказ = &Заказ
		|	И Лико_КартаСнятия.НомерБланка = &НомерБланка
		|	И Лико_КартаСнятия.НомерПроката = &НомерПроката
		|	И Лико_КартаСнятия.Оператор = &Оператор
		|	И Лико_КартаСнятия.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);
	Запрос.УстановитьПараметр("НомерБланка", НомерБланка);
	Запрос.УстановитьПараметр("Оператор", Оператор);
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		КартаУжеЕсть = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Если КартаУжеЕсть <> Неопределено Тогда
		
		ТекстОшибки =  СтрШаблон("Карта снятия по заказу № %1, бланку № %2 , прокату № %3 по оператору: ""%4"" уже была добавлена ( %5 от %6).",
		 Заказ.НомерБезПрефикса,
		 НомерБланка,
		 НомерПроката,
		 Оператор,
		 КартаУжеЕсть.Номер,
		 КартаУжеЕсть.Дата);
		Сообщить(ТекстОшибки);
		
		Отказ = Истина;
		
	КонецЕсли;


КонецПроцедуры 