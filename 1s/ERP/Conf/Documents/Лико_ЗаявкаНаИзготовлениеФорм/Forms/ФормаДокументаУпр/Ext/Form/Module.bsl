&НаКлиенте
Процедура ЗаказПриИзменении(Элемент)
	Если Объект.Организация=ПолучитьОрганизациуЭкофлексСервер() Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьПоЗаказу();
	ЗаполнитьТаблицуФормДополнительнымиПолями();
	
КонецПроцедуры


Функция ПолучитьОрганизациуЭкофлексСервер()

	Возврат Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЭкоФлекс.ЗначениеПараметра;

КонецФункции // ПолучитьОрганизациуЭкофлексСервер()


Процедура ЗаполнитьПоЗаказу()
	Объект.Формы.Очистить();
	Заказ=Объект.ЗаказКлиента;
	Объект.ИмяФайла = Заказ.ИмяФайла;
	Объект.Партнер=Заказ.Партнер;
	Объект.Контрагент = Заказ.Контрагент;
	Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Объект.Растр = Заказ.Растр;
	
	Если Заказ.Площадка= Справочники.Лико_Площадки.Сибирь Тогда
		
		//Объект.Контрагент=Справочники.Контрагенты.НайтиПоНаименованию("ФлексоЦентр ПАРТНЁР ООО");
		Объект.Контрагент=Справочники.Лико_ПредопределенныеЗначения.ПоставщикФормЭкофлекс.ЗначениеПараметра;
		
		Объект.Партнер=Объект.Контрагент.Партнер;
	КонецЕсли;
	РазмерПолимера=Документы.Лико_ЗаявкаНаИзготовлениеФорм.ОпределениеРазмераПолимера(Заказ);
	Объект.ТолщинаПластины = Заказ.ТолщинаПластины;
	Для Каждого ТекСтрокаЦвета Из Заказ.Цвета Цикл
		Если ЗначениеЗаполнено(ТекСтрокаЦвета.Форма) и ТекСтрокаЦвета.Цветоделение и 
			ТекСтрокаЦвета.Форма.ВидПечати=Перечисления.Лико_ВидыПечати.Флексо Тогда
			
			НоваяСтрока = Объект.Формы.Добавить();
			НоваяСтрока.Форма = ТекСтрокаЦвета.Форма;
			НоваяСтрока.НоваяФорма=Истина;
			НоваяСтрока.Длина=РазмерПолимера.Длина;
			НоваяСтрока.Ширина=РазмерПолимера.Ширина;
			
			Если Не ЗначениеЗаполнено(НоваяСтрока.Форма .УголПоворотаРастра) и
				Заказ.Площадка= Справочники.Лико_Площадки.Сибирь Тогда
				
				Документы.Лико_ЗаявкаНаИзготовлениеФорм.ЗаписатьУголПоворотаРастра(НоваяСтрока.Форма);
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	//}}__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
КонецПроцедуры

