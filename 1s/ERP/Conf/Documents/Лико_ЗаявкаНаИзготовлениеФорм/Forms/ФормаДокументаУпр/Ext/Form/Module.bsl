&НаКлиенте
Процедура ПодборФорм(Команда)
	Структура = Новый Структура;
	Структура.Вставить("ЗаявкаНаИзготовлениеФорм",Истина);
	Структура.Вставить("ВидПечати",ПредопределенноеЗначение("Перечисление.Лико_ВидыПечати.Флексо"));
	Структура.Вставить("Организация",ПолучитьЗначениеДопРеквизитаСервер(Объект.Ответственный,"ОрганизацияПродавец"));
	ОписаниеОповещения= Новый ОписаниеОповещения("ПодборФормЗавершение",ЭтаФорма);
	ОткрытьФорму("Справочник.Лико_Формы.Форма.ФормаПодбораТз",Структура,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры



