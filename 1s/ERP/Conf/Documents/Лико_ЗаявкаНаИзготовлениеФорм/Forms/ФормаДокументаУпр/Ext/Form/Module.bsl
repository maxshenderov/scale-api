&НаСервере
Процедура ЗаполнитьТаблицуФормДополнительнымиПолями() //+Лико m.shenderov 14/11/2019
	
	Для каждого Форма Из Объект.Формы Цикл
		Форма.ВидПолимера			=Форма.Форма.ВидПолимера;
		Форма.УголПоворотаРастра	=Форма.Форма.УголПоворотаРастра; 
		
		Форма.КоличествоМ2 = Форма.Длина/1000 * Форма.Ширина/1000;
		
		
	КонецЦикла;
	
КонецПроцедуры  //-Лико m.shenderov 14/11/2019


&НаКлиенте
Процедура ПодборФормЗавершение(РезультатФормы,ПараметрыФормы) Экспорт  
	Если ТипЗнч(РезультатФормы)=Тип("Структура") Тогда
		РазмерПолимера=ОпределениеРазмераПолимера();
		Для каждого Форма Из РезультатФормы.Массив Цикл
			Если Объект.Формы.НайтиСтроки(Новый Структура("Форма",Форма)).количество()=0 Тогда
				НоваяФорма=Объект.Формы.Добавить();
				НоваяФорма.Форма=Форма;
				НоваяФорма.Длина=РазмерПолимера.Длина;
				НоваяФорма.Ширина=РазмерПолимера.Ширина;
				
				
			КонецЕсли;
			
			
			
		КонецЦикла;
		ЗаполнитьТаблицуФормДополнительнымиПолями();
		
	КонецЕсли;
	
КонецПроцедуры 

Функция ОпределениеРазмераПолимера() //+Лико m.shenderov 12/01/2020
	Возврат 	Документы.Лико_ЗаявкаНаИзготовлениеФорм.ОпределениеРазмераПолимера(Объект.ЗаказКлиента);	
КонецФункции //-Лико m.shenderov 12/01/2020 


