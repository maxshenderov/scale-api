Функция ПолучитьХешОбъекта(Объект) Экспорт 
	 УстановитьПривилегированныйРежим(Истина);

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML,Объект);
	ДанныеСтрока=ЗаписьXML.Закрыть();
	
	Хеш=Новый ХешированиеДанных(ХешФункция.CRC32);
	Хеш.Добавить(ДанныеСтрока);
	
	Возврат Хеш.ХешСумма;
КонецФункции 

Процедура СформироватьМассивТЗСерверАсинх(Настройка,WebSocketParam,УИД,Адрес) Экспорт  //+Лико m.shenderov 16.08.2022
	РанжироватьЗаказыПоПриоритету();
	МассивТЗ=СформироватьМассивТЗСервер(Настройка);
	
	Для каждого Структура Из  МассивТЗ Цикл
		Структура.Таблица=ОбщегоНазначения.ТаблицаЗначенийВМассив(Структура.Таблица);
	КонецЦикла;
	
	Контент = Новый Структура;
	Контент.Вставить("Type","UpdatePlan");
	Контент.Вставить("date",ТекущаяДата()); 
	Контент.Вставить("АдресВХ",ПоместитьВоВременноеХранилище(МассивТЗ,Адрес));
