////////////////////////////////////////////////////////////////////////////////
//
// Процедура РанжироватьЗадачиПоПриоритету
//
/// Описание: НужноИзменить
//
// Параметры: 
// ИмяСвойства 		   - Строка          	    - (обязательный).  Пример: "Код"    НужноИзменить 
// РабочееМесто 	   - Строка 				- (необязательный).Пример: ПараметрыСеанса.РабочееМестоКлиента  НужноИзменить 
//
Процедура РанжироватьЗаказыПоПриоритету140323(МассивРЦ=Неопределено,ДатаОперации=Неопределено) Экспорт  //+Лико m.shenderov 16.12.2021
    УстановитьПривилегированныйРежим(Истина);
	Если  ДатаОперации=Неопределено Тогда 
		ДатаОперации=ТекущаяДата();
	КонецЕсли; 
	
	//СооПК= СооПроизводственныйКалендарь(НачалоДня(ДатаОперации));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПланРаботБЭ.Заказ КАК Заказ,
	|	Лико_ПланРаботБЭ.Заказ.Статус КАК Статус,
	|	Лико_ПланРаботБЭ.Заказ.ВремяВыполненияПлан КАК Осталось,
	|	Лико_ПланРаботБЭ.Заказ.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Лико_ПланРаботБЭ.РабочийЦентр КАК РабочийЦентр,
	|	Лико_ПланРаботБЭ.Приоритет КАК Приоритет,
	|	Лико_ПланРаботБЭ.ВРаботе КАК ВРаботе,
	|	Лико_ПланРаботБЭ.ДатаНачала КАК ДатаНачала,
	|	Лико_ПланРаботБЭ.ДатаОкончания КАК ДатаОкончания,
	|	Лико_ПланРаботБЭ.Трудозатраты КАК Трудозатраты,
	|	ЕСТЬNULL(Лико_РаскройМатериаловПланФактОстатки.КоличествоОстаток, 0) КАК КоличествоОсталось,
	|	Лико_ПланРаботБЭ.КоличествоОсталось КАК КоличествоОсталосьСтарое
	|ИЗ
	|	РегистрСведений.Лико_ПланРаботБЭ КАК Лико_ПланРаботБЭ
	|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_РаскройМатериаловПланФакт.Остатки(
	|				,
	|				Заказ В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						Лико_ПланРаботБЭ.Заказ КАК Заказ
	|					ИЗ
	|						РегистрСведений.Лико_ПланРаботБЭ КАК Лико_ПланРаботБЭ)) КАК Лико_РаскройМатериаловПланФактОстатки
	|		ПО Лико_ПланРаботБЭ.Заказ = Лико_РаскройМатериаловПланФактОстатки.Заказ
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ФильтрПоРЦ
	|				ТОГДА Лико_ПланРаботБЭ.РабочийЦентр В (&МассивРЦ)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	РабочийЦентр,
	|	Приоритет
	|ИТОГИ ПО
	|	РабочийЦентр";
	
	
	
	
	Запрос.УстановитьПараметр("ФильтрПоРЦ",МассивРЦ<>Неопределено);
	
	Запрос.УстановитьПараметр("МассивРЦ",МассивРЦ); 
	Запрос.УстановитьПараметр("ТекущаяДата",НачалоДня(ТекущаяДата()));
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаРЦ = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	//УстановитьПривилегированныйРежим(Истина);
	Пока ВыборкаРЦ.Следующий()  Цикл
		Сч=1;
		Выборка= ВыборкаРЦ.Выбрать();
		Пока Выборка.Следующий() Цикл 
			ТекТрудозатраты=0;
			Если Сч=1 Тогда  	
				
				ДатаНачала=Выборка.ДатаНачала;
				
				Если Не ЗначениеЗаполнено(ДатаНачала) Или Выборка.Приоритет<>1 Тогда
					
					ДатаНачала = ДатаОперации;
					
				КонецЕсли;
				
				Трудозатраты=(ДатаОперации-ДатаНачала)/(60*60);
				
			Иначе				
				Трудозатраты=0;				
			КонецЕсли;
			Если Выборка.КоличествоОсталось=Выборка.КоличествоОсталосьСтарое Тогда
				
				Осталось=Выборка.Осталось;
			Иначе
				Осталось= Документы.Лико_ЗаказНаРаскрой.РасчитатьВремяВыполнения(Выборка.Заказ,Выборка.КоличествоОсталось).ВремяВыполненияПлан;
			КонецЕсли;
			Осталось=?(Осталось<=0,1,Осталось);
			Осталось=Осталось-Трудозатраты;
			Осталось=?(Осталось<=0,1,Осталось);			
			НаборЗаписей           = РегистрыСведений.Лико_ПланРаботБЭ.СоздатьНаборЗаписей();					
			НаборЗаписей.Отбор.Заказ.Установить(Выборка.Заказ); 
			
			Запись           		= НаборЗаписей.Добавить();
			Запись.Заказ    		= Выборка.Заказ;
			Запись.Осталось  		= Осталось;
			Запись.Трудозатраты		= Трудозатраты;
			Запись.ДатаНачала		= ДатаНачала;
			Запись.Количество		= Выборка.Заказ.КоличествоУпаковок;
			Запись.КоличествоОсталось= Выборка.КоличествоОсталось;
			
			//Запись.ДатаОкончания	= РассчитатьДатуОкончания(?(Сч=1,ДатаОперации,ДатаНачала),Выборка.Сотрудник,Осталось);  
			Запись.ДатаОкончания	= Макс(ДатаОперации,ДатаНачала+Осталось*60*60);
			
			ДатаНачала				= Запись.ДатаОкончания;
			
			Запись.РабочийЦентр =Выборка.РабочийЦентр;
			Запись.Приоритет =Сч;
			
			Если  Сч=1 И Запись.ДатаНачала<=ДатаОперации Тогда
				Запись.ВРаботе = Истина;
				лСтатус         = Перечисления.Лико_СтатусыЗаказовБЭ.ВРаботе;
			Иначе
