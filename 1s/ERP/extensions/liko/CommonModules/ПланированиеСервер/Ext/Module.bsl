
////////////////////////////////////////////////////////////////////////////////
//
// Процедура СформироватьОперацию
//
/// Описание: НужноИзменить
//
// Параметры: 
// ИмяСвойства 		   - Строка          	    - (обязательный).  Пример: "Код"    НужноИзменить 
// РабочееМесто 	   - Строка 				- (необязательный).Пример: ПараметрыСеанса.РабочееМестоКлиента  НужноИзменить 
//
Процедура СформироватьОперацию(Заказ,РабочийЦентр,Статус,Приоритет=9999,ДатаОперации=Неопределено,Сортировка=Ложь)Экспорт  //+Лико m.shenderov 16.12.2021
 УстановитьПривилегированныйРежим(Истина);
	
	Если ДатаОперации=Неопределено Тогда		
		ДатаОперации=ТекущаяДата(); 
	КонецЕсли;
	
	ЗаписатьВПлан(Заказ,РабочийЦентр,Статус,Приоритет,Сортировка);
	
	Если Не Сортировка Тогда // <-- Начало Лико Яцун С. В. 07.03.2023 добавил параметр Сортировка=Ложь, при сортировке по первому прокату ранжировка вызывается после выполнения цикла
		РанжироватьЗаказыПоПриоритету(,ДатаОперации);
	КонецЕсли; // <-- Конец Лико Яцун С. В. 07.03.2023
	
КонецПроцедуры //СформироватьОперацию -Лико m.shenderov 16.12.2021
////////////////////////////////////////////////////////////////////////////////
//
// Процедура ЗаписатьВПлан
//
/// Описание: НужноИзменить
//
// Параметры: 
// ИмяСвойства 		   - Строка          	    - (обязательный).  Пример: "Код"    НужноИзменить 
// РабочееМесто 	   - Строка 				- (необязательный).Пример: ПараметрыСеанса.РабочееМестоКлиента  НужноИзменить 
//
Процедура ЗаписатьВПлан(Заказ,РабочийЦентр,Статус,Приоритет,Сортировка=Ложь) //+Лико m.shenderov 16.12.2021
 УстановитьПривилегированныйРежим(Истина);
	
	Массив		   = Новый Массив;
	Массив.Добавить(Перечисления.Лико_СтатусыЗаказовБЭ.ВПлане);
	Массив.Добавить(Перечисления.Лико_СтатусыЗаказовБЭ.ВРаботе);
	
	
	НаборЗаписей  = РегистрыСведений.Лико_ПланРаботБЭ.СоздатьНаборЗаписей();	
	НаборЗаписей.Отбор.Заказ.Установить(Заказ);	
	Если Массив.Найти(Статус)<>Неопределено Тогда
		
		Запись           		= НаборЗаписей.Добавить();
		Запись.Заказ    		= Заказ;
		Запись.РабочийЦентр 	= РабочийЦентр;
		Запись.Приоритет 		= Приоритет;
		Запись.Количество		=Заказ.КоличествоУпаковок;
		// <-- Начало Лико Яцун С. В. 24.03.2023 
		Если Сортировка И Заказ.Статус = Перечисления.Лико_СтатусыЗаказовБЭ.ВРаботе Тогда
			ТекЗапись = РегистрыСведений.Лико_ПланРаботБЭ.Получить(Новый Структура("Заказ",Заказ));
			Запись.ДатаНачала	= ТекЗапись.ДатаНачала;
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 24.03.2023
	КонецЕсли;
	
	
	Если  Заказ.Статус<>Статус Тогда
		НачатьТранзакцию();
		ДокОбъект=Заказ.ПолучитьОбъект();
		ДокОбъект.Статус=Статус;
		ДокОбъект.СтатусДата=ТекущаяДата();
		ДокОбъект.ОбменДанными.Загрузка=Истина;
		ДокОбъект.Записать(); 
		НаборЗаписей.Записать();  
		ЗафиксироватьТранзакцию();
		
	Иначе 
		НаборЗаписей.Записать();		
	КонецЕсли;
	
	
	
	
КонецПроцедуры //ЗаписатьВПлан -Лико m.shenderov 16.12.2021

Функция ЕстьЗаказыВПлане(МассивЗаказов) Экспорт  //+Лико m.shenderov 02.02.2022
     УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПланЗаказов.Заказ КАК Заказ
	|ИЗ
	|	РегистрСведений.Лико_ПланРаботБЭ КАК ПланЗаказов
	|ГДЕ
	|	ПланЗаказов.Заказ В(&МассивЗаказов)";
	Запрос.УстановитьПараметр("МассивЗаказов",МассивЗаказов);
	Возврат Не Запрос.Выполнить().Пустой();
	
	
КонецФункции //-Лико m.shenderov 02.02.2022 

////////////////////////////////////////////////////////////////////////////////
//
// Процедура РанжироватьЗадачиПоПриоритету
//
/// Описание: НужноИзменить
//
// Параметры: 
// ИмяСвойства 		   - Строка          	    - (обязательный).  Пример: "Код"    НужноИзменить 
// РабочееМесто 	   - Строка 				- (необязательный).Пример: ПараметрыСеанса.РабочееМестоКлиента  НужноИзменить 
//
Процедура РанжироватьЗаказыПоПриоритету(МассивРЦ=Неопределено,ДатаОперации=Неопределено) Экспорт  //+Лико m.shenderov 16.12.2021
    УстановитьПривилегированныйРежим(Истина);
	Если  ДатаОперации=Неопределено Тогда 
		ДатаОперации=ТекущаяДата();
	КонецЕсли; 
	
	//СооПК= СооПроизводственныйКалендарь(НачалоДня(ДатаОперации));
	// <--  Лико Яцун С. В. 09.03.2023 добавил в запрос связь с ПооперационноеРасписание2_2, чтобы получить НачалоПервогоПроката для расчета ДатыНачала резки
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПланРаботБЭ.Заказ КАК Заказ,
	|	Лико_ПланРаботБЭ.Заказ.Статус КАК Статус,
	|	Лико_ПланРаботБЭ.Заказ.ВремяВыполненияПлан КАК Осталось,
	|	Лико_ПланРаботБЭ.Заказ.КоличествоУпаковок КАК КоличествоУпаковок,
	|	Лико_ПланРаботБЭ.РабочийЦентр КАК РабочийЦентр,
	|	Лико_ПланРаботБЭ.Приоритет КАК Приоритет,
	|	Лико_ПланРаботБЭ.ВРаботе КАК ВРаботе,
	|	Лико_ПланРаботБЭ.ДатаНачала КАК ДатаНачала,
	|	Лико_ПланРаботБЭ.ДатаОкончания КАК ДатаОкончания,
	|	Лико_ПланРаботБЭ.Трудозатраты КАК Трудозатраты,
	|	ЕСТЬNULL(Лико_РаскройМатериаловПланФактОстатки.КоличествоОстаток, 0) КАК КоличествоОсталось,
	|	Лико_ПланРаботБЭ.КоличествоОсталось КАК КоличествоОсталосьСтарое,
	|	ПооперационноеРасписание2_2.Начало КАК НачалоПервогоПроката,
	|	ПооперационноеРасписание2_2.Окончание КАК ОкончаниеПервогоПроката
	|ИЗ
	|	РегистрСведений.Лико_ПланРаботБЭ КАК Лико_ПланРаботБЭ
	|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_РаскройМатериаловПланФакт.Остатки(
	|				,
	|				Заказ В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						Лико_ПланРаботБЭ.Заказ КАК Заказ
	|					ИЗ
	|						РегистрСведений.Лико_ПланРаботБЭ КАК Лико_ПланРаботБЭ)) КАК Лико_РаскройМатериаловПланФактОстатки
	|		ПО Лико_ПланРаботБЭ.Заказ = Лико_РаскройМатериаловПланФактОстатки.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2   
	|		ПО Лико_ПланРаботБЭ.Заказ.ЗаказКлиента = ПооперационноеРасписание2_2.Этап.Лико_ЗаказКлиента
	|			И (НЕ ПооперационноеРасписание2_2.Моделирование)
	|			И (ПооперационноеРасписание2_2.Этап.НомерПроката = 1)
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ФильтрПоРЦ
	|				ТОГДА Лико_ПланРаботБЭ.РабочийЦентр В (&МассивРЦ)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	//|	И Лико_ПланРаботБЭ.Заказ.ЗаказКлиента.Состояние <> ЗНАЧЕНИЕ(Перечисление.Лико_СостоянияЗаказов.Аннулирован)
	|
	|УПОРЯДОЧИТЬ ПО
	|	РабочийЦентр,
	|	Приоритет
	|ИТОГИ ПО
	|	РабочийЦентр";
	
	
	
	
	Запрос.УстановитьПараметр("ФильтрПоРЦ",МассивРЦ<>Неопределено);
	
	Запрос.УстановитьПараметр("МассивРЦ",МассивРЦ); 
	Запрос.УстановитьПараметр("ТекущаяДата",НачалоДня(ТекущаяДата()));
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаРЦ = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	//УстановитьПривилегированныйРежим(Истина);
	Пока ВыборкаРЦ.Следующий()  Цикл
		Сч=1;
		Выборка= ВыборкаРЦ.Выбрать();
		Пока Выборка.Следующий() Цикл 
			ТекТрудозатраты=0;
			Если Сч=1 Тогда  	
				
				ДатаНачала=Выборка.ДатаНачала;
				
				Если Не ЗначениеЗаполнено(ДатаНачала) Или Выборка.Приоритет<>1 Тогда
					
					ДатаНачала = ДатаОперации;
					
				КонецЕсли;
				
				// <-- Начало Лико Яцун С. В. 06.03.2023 начало резки не может быть раньше начала первго проката печати заказа клиента
				Если ЗначениеЗаполнено(Выборка.НачалоПервогоПроката) И ДатаНачала < Выборка.НачалоПервогоПроката Тогда
					ДатаНачала = Выборка.НачалоПервогоПроката;	
				КонецЕсли;
				// <-- Конец Лико Яцун С. В. 06.03.2023
				
				Трудозатраты=(ДатаОперации-ДатаНачала)/(60*60);
				
			Иначе				
				Трудозатраты=0;				
			КонецЕсли;
			Если Выборка.КоличествоОсталось=Выборка.КоличествоОсталосьСтарое Тогда
				
				Осталось=Выборка.Осталось;
			Иначе
				Осталось= Документы.Лико_ЗаказНаРаскрой.РасчитатьВремяВыполнения(Выборка.Заказ,Выборка.КоличествоОсталось).ВремяВыполненияПлан;
			КонецЕсли;
			Осталось=?(Осталось<=0,1,Осталось);
			Осталось=Осталось-Трудозатраты;
			Осталось=?(Осталось<=0,1,Осталось);			
			НаборЗаписей           = РегистрыСведений.Лико_ПланРаботБЭ.СоздатьНаборЗаписей();					
			НаборЗаписей.Отбор.Заказ.Установить(Выборка.Заказ); 
			
			// <-- Начало Лико Яцун С. В. 06.03.2023 начало резки не может быть раньше начала первго проката печати заказа клиента	
			Если Сч = 1 Тогда
				ДатаНачалаСледующегоЗаказа = Неопределено;	
			КонецЕсли;
			Если (НЕ ЗначениеЗаполнено(Выборка.НачалоПервогоПроката) 
				ИЛИ (ЗначениеЗаполнено(Выборка.НачалоПервогоПроката) И ЗначениеЗаполнено(ДатаНачалаСледующегоЗаказа) И ДатаНачалаСледующегоЗаказа >= Выборка.НачалоПервогоПроката)) 
				И Сч > 1 Тогда
				ДатаНачала				= ДатаНачалаСледующегоЗаказа; //ДатаНачала = ДатаОкончания предыдущего заказа
			ИначеЕсли ЗначениеЗаполнено(Выборка.НачалоПервогоПроката) 
				И ЗначениеЗаполнено(ДатаНачалаСледующегоЗаказа) 
				И ДатаНачалаСледующегоЗаказа < Выборка.НачалоПервогоПроката 
				И Сч > 1 Тогда
				ДатаНачала				= Выборка.НачалоПервогоПроката; //ДатаНачала = НачалоПервогоПроката печати заказа клиента
			ИначеЕсли Сч > 1 Тогда 
				ДатаНачала				= ДатаНачалаСледующегоЗаказа; //ДатаНачала = ДатаОкончания предыдущего заказа
			КонецЕсли;
			// <-- Конец Лико Яцун С. В. 06.03.2023 
			
			Запись           		= НаборЗаписей.Добавить();
			Запись.Заказ    		= Выборка.Заказ;
			Запись.Осталось  		= Осталось;
			Запись.Трудозатраты		= Трудозатраты;
			Запись.ДатаНачала		= ДатаНачала;
			Запись.Количество		= Выборка.Заказ.КоличествоУпаковок;
			Запись.КоличествоОсталось= Выборка.КоличествоОсталось;
			
			//Запись.ДатаОкончания	= РассчитатьДатуОкончания(?(Сч=1,ДатаОперации,ДатаНачала),Выборка.Сотрудник,Осталось);  
			Запись.ДатаОкончания	= Макс(ДатаОперации,ДатаНачала+Осталось*60*60);
			
			//// <-- Начало Лико Яцун С. В. 06.03.2023 предполагаемая дата начала следующего заказа	
			//ДатаНачала				= Запись.ДатаОкончания;
			ДатаНачалаСледующегоЗаказа = Запись.ДатаОкончания;
			//// <-- Конец Лико Яцун С. В. 06.03.2023 
			
			Запись.РабочийЦентр =Выборка.РабочийЦентр;
			Запись.Приоритет =Сч;
			
			Если  Сч=1 И Запись.ДатаНачала<=ДатаОперации Тогда
				Запись.ВРаботе = Истина;
				лСтатус         = Перечисления.Лико_СтатусыЗаказовБЭ.ВРаботе;
			Иначе
				Запись.ВРаботе = Ложь;
				лСтатус         = Перечисления.Лико_СтатусыЗаказовБЭ.ВПлане;
			КонецЕсли;
			Если Выборка.Статус<>лСтатус Тогда
				ДокОбъект=Выборка.Заказ.ПолучитьОбъект();
				ДокОбъект.Статус=лСтатус; 
				ДокОбъект.СтатусДата=ДатаОперации;
				НачатьТранзакцию();
				ДокОбъект.ОбменДанными.Загрузка=Истина;
				ДокОбъект.Записать(); 
				НаборЗаписей.Записать();
				ЗафиксироватьТранзакцию();
			Иначе
				НаборЗаписей.Записать();
				
				
			КонецЕсли;
			
			
			Если Запись.ВРаботе<>Выборка.ВРаботе Тогда
				
				//ЗаписатьВЖурналОпераций(Запись.Задача,Запись.Сотрудник,Статус,ДатаОперации);
				
			КонецЕсли;
			
			Сч=Сч+1;
		КонецЦикла; 
	КонецЦикла;
	
	
	
	
КонецПроцедуры //РанжироватьЗадачиПоПриоритету -Лико m.shenderov 16.12.2021

Функция СформироватьМассивТЗСервер(Настройка=Неопределено,РабочийЦентр=Неопределено) Экспорт  //+Лико m.shenderov 27.12.2021  
	УстановитьПривилегированныйРежим(Истина);
	
	Если  Не ЗначениеЗаполнено(Настройка) Тогда
		Настройка=Справочники.Лико_НастройкиОтображенияПланаБЭ.Основная;
	КонецЕсли;
	
	
	МассивНастроек=Справочники.Лико_НастройкиОтображенияПланаБЭ.ПолучитьМассивНастроек(Настройка);
	
	Массив = Новый Массив;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РабочиеЦентры.РабочийЦентр КАК РабочийЦентр,
	|	РабочиеЦентры.НомерСтроки КАК НомерПП,
	|	Лико_РаботаНаРезакахСрезПоследних.Сотрудник КАК Сотрудник,
	|	Лико_РаботаНаРезакахСрезПоследних.Период КАК Период
	|ПОМЕСТИТЬ ВтРабочиеЦентры
	|ИЗ
	|	Справочник.Лико_НастройкиОтображенияПланаБЭ.РабочиеЦентры КАК РабочиеЦентры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_РаботаНаРезаках.СрезПоследних КАК Лико_РаботаНаРезакахСрезПоследних
	|		ПО РабочиеЦентры.РабочийЦентр = Лико_РаботаНаРезакахСрезПоследних.РабочийЦентр
	|ГДЕ
	|	РабочиеЦентры.Ссылка = &Настройка
	|	И ВЫБОР
	|			КОГДА &ФильтрПоРЦ
	|				ТОГДА РабочиеЦентры.РабочийЦентр = &РабочийЦентр
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПланРабот.Заказ КАК Заказ,
	|	РабочиеЦентры.Ссылка КАК РабочийЦентр,
	|	ПланРабот.Приоритет КАК Приоритет,
	|	ПланРабот.Заказ.Номер КАК Номер,
	|	РабочиеЦентры.ПорядковыйНомер КАК Код,
	|	ПланРабот.Осталось КАК Осталось,
	|	ПланРабот.ДатаНачала КАК ДатаНачала,
	|	ПланРабот.ДатаОкончания КАК ДатаОкончания,
	|	ПланРабот.Заказ.ВремяВыполненияПлан КАК ВремяПлан,
	|	ПланРабот.Трудозатраты КАК ВремяФакт,
	|	ПланРабот.Трудозатраты КАК Трудозатраты,
	|	ВтРабочиеЦентры.НомерПП КАК НомерПП,
	|	ПланРабот.Заказ.РаскройСтрокой КАК РаскройСтрокой,
	|	ПланРабот.Заказ.ТочныйМетражРезки КАК ТочныйМетражРезки,
	|	ПланРабот.Заказ.МатериалНаМашине КАК МатериалНаМашине,
    |	ПланРабот.Заказ.ПодрезкаКромка КАК ПодрезкаКромка,
