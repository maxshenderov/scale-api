		ТЗ.Колонки.Добавить("КоличествоОсталось" , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,2, ДопустимыйЗнак.Любой)));
		ТЗ.Колонки.Добавить("КоличествоСработано" , Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,2, ДопустимыйЗнак.Любой)));
		
		
		
		
		Выборка	=  ВыборкаРабочийцентр.Выбрать();
		
		Пока Выборка.Следующий() Цикл 
			Если ЗначениеЗаполнено(Выборка.Заказ) Тогда
				НоваяСтрокаТз= Тз.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТз,Выборка); 
				НоваяСтрокаТз.ВремяПлан=?(НоваяСтрокаТз.ВремяПлан=0,1,НоваяСтрокаТз.ВремяПлан);
				
				НоваяСтрокаТз.ВремяПлан	= ФорматироватьЧислоКакВремя(НоваяСтрокаТз.ВремяПлан);
				НоваяСтрокаТз.ВремяФакт		= ФорматироватьЧислоКакВремя(НоваяСтрокаТз.ВремяФакт);
				НоваяСтрокаТз.Осталось	= ФорматироватьЧислоКакВремя(НоваяСтрокаТз.Осталось);
				
			КонецЕсли;
		КонецЦикла;
		
		Структура.Вставить("Таблица",ТЗ);
		Структура.Вставить("МассивНастроек",МассивНастроек);
		Массив.Добавить(Структура);		
	КонецЦикла; 
	
	
	Возврат Массив;
КонецФункции  //-Лико m.shenderov 27.12.2021


 
