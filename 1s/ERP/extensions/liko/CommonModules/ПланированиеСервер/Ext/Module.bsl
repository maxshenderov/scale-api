	КонецЦикла; 
	Для каждого ЭлМассива Из МассивПодчиненныхЭлементов Цикл
		УдалитьПодчиненыеЭлеметы(Элементы,ЭлМассива);
	КонецЦикла;
	
	
	
	
	КоличествоВГруппе	= 0;
	Группа				= 1;
	КоличествоТЗВсего	= 0;	
	ПерваяГруппаТаблицы = Неопределено;
	
	Для каждого Структура Из МассивТЗ Цикл
		Тз= Структура.Таблица;	
		УИД=Структура.УИД;
		МассивИменТз.Добавить(УИД);
		Если  КоличествоТЗВсего=0 Тогда
			ИмяЭлемента= СтрШаблон("Ряд%1",Группа);
			
			
			Если  Элементы.Найти(ИмяЭлемента)<>Неопределено Тогда
				Элементы.Удалить(Элементы.Найти(ИмяЭлемента));
			КонецЕсли;
			
			
			ТекущаяГруппа						= Элементы.Добавить(СтрШаблон("Ряд%1",Группа),Тип("ГруппаФормы"),ТочкаВхода);
			ТекущаяГруппа.Вид 					= ВидГруппыФормы.ОбычнаяГруппа;
			ТекущаяГруппа.Отображение 			= ОтображениеОбычнойГруппы.Нет;
			ТекущаяГруппа.ОтображатьЗаголовок 	= ЛОЖЬ; 
			ТекущаяГруппа.Группировка			= ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
			ПоследняяГруппа						= ТекущаяГруппа;
			
		КонецЕсли;
		
		ИмяЭлемента= СтрШаблон("Группа%1",Уид);
		
		
		Если  Элементы.Найти(ИмяЭлемента)<>Неопределено Тогда
			Элементы.Удалить(Элементы.Найти(ИмяЭлемента));
		КонецЕсли;
		
		
		ГруппаРабочийцентрЭлементы  = Элементы.Добавить(СтрШаблон("Группа%1",Уид),Тип("ГруппаФормы"),ТекущаяГруппа);
		
		Если ПерваяГруппаТаблицы = Неопределено Тогда
			ПерваяГруппаТаблицы  = ГруппаРабочийцентрЭлементы;
		КонецЕсли;
		Последняятаблица                       = ГруппаРабочийцентрЭлементы;
		ГруппаРабочийцентрЭлементы.Вид         = ВидГруппыФормы.ОбычнаяГруппа;   				
		ГруппаРабочийцентрЭлементы.Заголовок   = СтрШаблон("%1.  -->  Сотрудник: %2. Дата начала: %3",Структура.Заголовок,?(ЗначениеЗаполнено(Структура.Сотрудник),Структура.Сотрудник,"Не авторизован!"),Структура.Период);
		ГруппаРабочийцентрЭлементы.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
		КоличествоТЗВсего                   = КоличествоТЗВсего+1;
		Если  КоличествоТЗВсего = КоличествоТаблицВСтроке Тогда
			КоличествоТЗВсего = 0;
			Группа            = Группа+1;
		КонецЕсли; 				
		
		ФормаЭлементыСервер.СоздатьЭлементФормыТаблица(ЭтаФорма,Тз,УИД,ГруппаРабочийцентрЭлементы);
		
		ЭлементТаблица=Элементы[УИД];
		ЭлементТаблица.ТолькоПросмотр=Истина;
		
		Если Структура.Свойство("МассивНастроек") И ТипЗнч(Структура.МассивНастроек)=Тип("Массив") Тогда
			
			
			Для каждого Колонка Из Структура.МассивНастроек Цикл
				
				ИмяКолонки=СтрШаблон("%1%2",УИД,Колонка.Имя); 
				Элементы[ИмяКолонки].Заголовок = Колонка.Заголовок;
				Элементы[ИмяКолонки].Ширина    = Колонка.Ширина;
				Элементы[ИмяКолонки].Формат    = Колонка.Шаблон;
				Элементы[ИмяКолонки].Видимость = Колонка.Видимость;
				
				Элементы.Переместить(Элементы[ИмяКолонки],ЭлементТаблица);				
				
			КонецЦикла;
			
		КонецЕсли;
		
		
		
		
		Элементы[УИД].УстановитьДействие("НачалоПеретаскивания"		, "ТаблицаРЦНачалоПеретаскивания"  );
		Элементы[УИД].УстановитьДействие("ПроверкаПеретаскивания"	, "ТаблицаРЦПроверкаПеретаскивания");
		Элементы[УИД].УстановитьДействие("Перетаскивание"			, "ТаблицаРЦПеретаскивание"        );
		Элементы[УИД].УстановитьДействие("Выбор"					, "ТаблицаВыбор"                   );
		Элементы[УИД].УстановитьДействие("ПриАктивизацииСтроки"		, "ТаблицаПриАктивизацииСтроки"    );
		Элементы[УИД].УстановитьДействие("ПриАктивизацииЯчейки"		, "ТаблицаПриАктивизацииЯчейки"   );				
		
	КонецЦикла;
	
	Если КоличествоТЗВсего<>0 Тогда 
		Тз.Очистить();
		ФормаЭлементыСервер.СоздатьЭлементФормыТаблица(ЭтаФорма,Тз,"Заглушка",ПоследняяГруппа);
		
		Элементы["Заглушка"].Доступность=Ложь; 
		Элементы["Заглушка"].Ширина=(КоличествоТаблицВСтроке-КоличествоТЗВсего)*90;
	КонецЕсли;
	
	Возврат МассивИменТз;	
	
КонецФункции  //-Лико m.shenderov 27.12.2021

Процедура УдалитьПодчиненыеЭлеметы(Элементы,Элемент) //+Лико m.shenderov 13.12.2021
	 УстановитьПривилегированныйРежим(Истина);

	Если  ТипЗнч(Элемент)=Тип("ГруппаФормы") и Элемент.ПодчиненныеЭлементы.Количество()>0 Тогда
		Для каждого ПодЭлемент Из Элемент.ПодчиненныеЭлементы Цикл
			УдалитьПодчиненыеЭлеметы(Элементы,ПодЭлемент);
			//Элементы.Удалить(ПодЭлемент);
		КонецЦикла; 
		
	КонецЕсли;
	Элементы.Удалить(Элемент);
	
	
	
КонецПроцедуры //-Лико m.shenderov 13.12.2021

