Функция HttpВернутьОшибку_WMS(КодОшибки, Сообщение)

	СтруктураОшибка = Новый Структура;
	СтруктураОшибка.Вставить("code", КодОшибки);
	СтруктураОшибка.Вставить("message", Сообщение);

	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ok", Ложь);
	СтруктураОтвет.Вставить("error", СтруктураОшибка);

	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));

КонецФункции

Функция СсылкаПоСтрокеGUID(СтрокаGUID, ИмяМетаданных)

	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаGUID);

		// Справочники
		Если ИмяМетаданных = "Справочник.Склады" Тогда
			Возврат Справочники.Склады.ПолучитьСсылку(УИД);
		ИначеЕсли ИмяМетаданных = "Справочник.Лико_Паллеты2_0" Тогда
			Возврат Справочники.Лико_Паллеты2_0.ПолучитьСсылку(УИД);
		ИначеЕсли ИмяМетаданных = "Справочник.СкладскиеЯчейки" Тогда
			Возврат Справочники.СкладскиеЯчейки.ПолучитьСсылку(УИД);
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Неопределено;
КонецФункции

