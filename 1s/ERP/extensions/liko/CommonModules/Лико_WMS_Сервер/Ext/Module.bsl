Функция СобратьТопологиюСклада(СкладСсылка)

	// Возвращает структуру { Склад, Стеллажи } — топология без HTTP-обёртки.
	// Используется WMS_GetRacks и WMS_ExportSnapshot.

	// Склад
	СтруктураСклад = Новый Структура;
	СтруктураСклад.Вставить("id", Строка(СкладСсылка.УникальныйИдентификатор()));
	СтруктураСклад.Вставить("name", СкладСсылка.Наименование);
	СтруктураСклад.Вставить("code", СкладСсылка.Наименование);

	// Запрос стеллажей
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лико_Стеллажи.Ссылка КАК id,
	|	Лико_Стеллажи.Наименование КАК name,
	|	Лико_Стеллажи.Код КАК code,
	|	Лико_Стеллажи.НомерСтеллажа КАК number,
	|	Лико_Стеллажи.Узкопроходный КАК narrowAisle,
	|	Лико_Стеллажи.МинШиринаПаллета КАК minPalletWidth,
	|	Лико_Стеллажи.МаксШиринаПаллета КАК maxPalletWidth,
	|	Лико_Стеллажи.МинГлубинаПаллета КАК minPalletDepth,
	|	Лико_Стеллажи.МаксГлубинаПаллета КАК maxPalletDepth,
	|	Лико_Стеллажи.КоличествоСекций КАК sectionsCount,
	|	3 КАК cellsPerSection,
	|	Лико_Стеллажи.КоличествоЗонПриемкиОтгрузки КАК floorZonesCount
	|ИЗ
	|	Справочник.Лико_Стеллажи КАК Лико_Стеллажи
	|ГДЕ
	|	Лико_Стеллажи.Склад = &Склад
	|
	|УПОРЯДОЧИТЬ ПО
	|	number";

	Запрос.УстановитьПараметр("Склад", СкладСсылка);
	ТЗ_Стеллажи = Запрос.Выполнить().Выгрузить();

	// Собираем стеллажи с этажами
	МассивСтеллажей = Новый Массив;

	Для Каждого СтрокаСтеллаж Из ТЗ_Стеллажи Цикл
		СтеллажСсылка = СтрокаСтеллаж.id;

		СтруктураСтеллаж = Новый Структура;
		СтруктураСтеллаж.Вставить("id", Строка(СтеллажСсылка.УникальныйИдентификатор()));
		СтруктураСтеллаж.Вставить("name", СтрокаСтеллаж.name);
		СтруктураСтеллаж.Вставить("code", СтрокаСтеллаж.code);
		СтруктураСтеллаж.Вставить("number", СтрокаСтеллаж.number);
		СтруктураСтеллаж.Вставить("narrowAisle", СтрокаСтеллаж.narrowAisle);
		СтруктураСтеллаж.Вставить("color", ЦветСтеллажа(СтрокаСтеллаж.number));
		СтруктураСтеллаж.Вставить("minPalletWidth", СтрокаСтеллаж.minPalletWidth);
		СтруктураСтеллаж.Вставить("maxPalletWidth", СтрокаСтеллаж.maxPalletWidth);
		СтруктураСтеллаж.Вставить("minPalletDepth", СтрокаСтеллаж.minPalletDepth);
		СтруктураСтеллаж.Вставить("maxPalletDepth", СтрокаСтеллаж.maxPalletDepth);
		СтруктураСтеллаж.Вставить("sectionsCount", СтрокаСтеллаж.sectionsCount);
		СтруктураСтеллаж.Вставить("cellsPerSection", 3);
		СтруктураСтеллаж.Вставить("floorZonesCount", СтрокаСтеллаж.floorZonesCount);

		// Этажи стеллажа (из ТЧ)
		МассивЭтажей = Новый Массив;
	
		Для Каждого СтрокаЭтаж Из СтеллажСсылка.Этажи Цикл

			Типоразмер = СтрокаЭтаж.Типоразмер;
			СтруктураТипоразмер = Новый Структура;
			Если ЗначениеЗаполнено(Типоразмер) Тогда
				СтруктураТипоразмер.Вставить("id", Строка(Типоразмер.УникальныйИдентификатор()));
				СтруктураТипоразмер.Вставить("height", Типоразмер.Высота);
				СтруктураТипоразмер.Вставить("width", Типоразмер.Ширина);
				СтруктураТипоразмер.Вставить("depth", Типоразмер.Глубина);
				СтруктураТипоразмер.Вставить("weight", Типоразмер.Вес);
				СтруктураТипоразмер.Вставить("unlimitedWeight", Типоразмер.НеОграниченаПоГрузоподъемности);
			Иначе
				СтруктураТипоразмер.Вставить("id", "");
				СтруктураТипоразмер.Вставить("height", 0);
				СтруктураТипоразмер.Вставить("width", 0);
				СтруктураТипоразмер.Вставить("depth", 0);
				СтруктураТипоразмер.Вставить("weight", 0);
				СтруктураТипоразмер.Вставить("unlimitedWeight", Ложь);
			КонецЕсли;

			СтруктураЭтаж = Новый Структура;
			СтруктураЭтаж.Вставить("number", СтрокаЭтаж.НомерСтроки);
			СтруктураЭтаж.Вставить("typeSize", СтруктураТипоразмер);
			СтруктураЭтаж.Вставить("minDepthUnlimited", СтрокаЭтаж.МинимальнаяГлубинаНеОграничена);
			СтруктураЭтаж.Вставить("maxDepthUnlimited", СтрокаЭтаж.МаксимальнаяГлубинаНеОграничена);
			СтруктураЭтаж.Вставить("maxLiftWeight", СтрокаЭтаж.МаксимальныйВесПодъёмаНаЭтаж);
			СтруктураЭтаж.Вставить("heightClearance", СтрокаЭтаж.Зазор);
			СтруктураЭтаж.Вставить("beamHeight", СтрокаЭтаж.ВысотаБалки);
			СтруктураЭтаж.Вставить("heightFromFloor", СтрокаЭтаж.ВысотаОтПола);
			СтруктураЭтаж.Вставить("heightFromFloorFixed", СтрокаЭтаж.ВысотаОтПолаФиксирована);
			СтруктураЭтаж.Вставить("widthClearance", СтрокаЭтаж.ЗазорПоШирине);

			МассивЭтажей.Добавить(СтруктураЭтаж);
		КонецЦикла;

		СтруктураСтеллаж.Вставить("floors", МассивЭтажей);
		МассивСтеллажей.Добавить(СтруктураСтеллаж);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Склад", СтруктураСклад);
	Результат.Вставить("Стеллажи", МассивСтеллажей);

	Возврат Результат;

КонецФункции

Функция СобратьЗанятостьСекций(СкладСсылка) Экспорт

	// Возвращает структуру { Секции, Сводка } — занятость без HTTP-обёртки.
	// Используется WMS_GetOccupancy, WMS_ExportSnapshot и WMS_PlacePallets.

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Лико_СкладскиеСекции.Ссылка КАК Секция,
	|	Лико_СкладскиеСекции.Код КАК КодСекции,
	|	Лико_СкладскиеСекции.Стеллаж КАК Стеллаж,
	|	Лико_СкладскиеСекции.Этаж КАК Этаж,
	|	Лико_СкладскиеСекции.УровеньДоступа КАК УровеньДоступа,
	|	Лико_СкладскиеСекции.ЗапретРазмещения КАК ЗапретРазмещения,
	|	Лико_СкладскиеСекции.Типоразмер КАК Типоразмер,
	|	Лико_СкладскиеСекции.Адрес1 КАК Адрес1,
	|	Лико_СкладскиеСекции.Адрес2 КАК Адрес2,
	|	Лико_СкладскиеСекции.Адрес3 КАК Адрес3,
	|	Лико_СкладскиеСекции.Стеллаж.НомерСтеллажа КАК НомерСтеллажа,
	|	Лико_СкладскиеСекции.Стеллаж.Узкопроходный КАК Узкопроходный,
	|	ЕСТЬNULL(Остатки1.Паллет, ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)) КАК Паллет1,
	|	ЕСТЬNULL(Параметры1.Типоразмер, ЗНАЧЕНИЕ(Справочник.Лико_ТипоразмерыПаллет.ПустаяСсылка)) КАК ТипоразмерПаллета1,
	|	ЕСТЬNULL(Остатки2.Паллет, ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)) КАК Паллет2,
	|	ЕСТЬNULL(Параметры2.Типоразмер, ЗНАЧЕНИЕ(Справочник.Лико_ТипоразмерыПаллет.ПустаяСсылка)) КАК ТипоразмерПаллета2,
	|	ЕСТЬNULL(Остатки3.Паллет, ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)) КАК Паллет3,
	|	ЕСТЬNULL(Параметры3.Типоразмер, ЗНАЧЕНИЕ(Справочник.Лико_ТипоразмерыПаллет.ПустаяСсылка)) КАК ТипоразмерПаллета3,
	|	Остатки1.КоличествоОстаток КАК КоличествоОстаток,
	|	Остатки1.ЗаблокированОстаток КАК ЗаблокированОстаток,
	|	Остатки2.КоличествоОстаток КАК КоличествоОстаток1,
	|	Остатки2.ЗаблокированОстаток КАК ЗаблокированОстаток1,
	|	Остатки3.КоличествоОстаток КАК КоличествоОстаток2,
	|	Остатки3.ЗаблокированОстаток КАК ЗаблокированОстаток2,
	|	Лико_СкладскиеСекции.ЗазорПоШирине КАК ЗазорПоШирине,
	|	Лико_СкладскиеСекции.МаксимальныйВесПодъёмаНаЭтаж КАК МаксимальныйВесПодъёмаНаЭтаж,
	|	Лико_СкладскиеСекции.ЗапретРазмещения КАК ЗапретРазмещения1,
	|	Лико_СкладскиеСекции.ВремяДоступа КАК ВремяДоступа,
	|	Лико_СкладскиеСекции.УровеньДоступа КАК УровеньДоступа1,
	|	Лико_СкладскиеСекции.Стеллаж.МаксШиринаПаллета КАК СтеллажМаксШиринаПаллета,
	|	Лико_СкладскиеСекции.Стеллаж.МаксГлубинаПаллета КАК СтеллажМаксГлубинаПаллета,
	|	Лико_СкладскиеСекции.Стеллаж.КоличествоЯчеекВСекции КАК СтеллажКоличествоЯчеекВСекции
	|ПОМЕСТИТЬ Вт
	|ИЗ
	|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(, ) КАК Остатки1
	|		ПО Лико_СкладскиеСекции.Адрес1 = Остатки1.Адрес
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(, ) КАК Параметры1
	|		ПО (Остатки1.Паллет = Параметры1.Паллет)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(, ) КАК Остатки2
	|		ПО Лико_СкладскиеСекции.Адрес2 = Остатки2.Адрес
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(, ) КАК Параметры2
	|		ПО (Остатки2.Паллет = Параметры2.Паллет)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(, ) КАК Остатки3
	|		ПО Лико_СкладскиеСекции.Адрес3 = Остатки3.Адрес
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(, ) КАК Параметры3
	|		ПО (Остатки3.Паллет = Параметры3.Паллет)
	|ГДЕ
	|	Лико_СкладскиеСекции.Склад = &Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Вт.Секция) КАК section_id,
	|	Вт.КодСекции КАК section_code,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Вт.Стеллаж) КАК rack_id,
	|	Вт.Этаж КАК floor,
	|	Вт.УровеньДоступа КАК accessLevel,
	|	Вт.ЗапретРазмещения КАК restricted,
	|	Вт.Типоразмер КАК typeSize,
	|	Вт.Адрес1 КАК address1,
	|	Вт.Адрес2 КАК address2,
	|	Вт.Адрес3 КАК address3,
	|	Вт.НомерСтеллажа КАК rack_code,
	|	Вт.Типоразмер.Высота КАК typeSize_height,
	|	Вт.Типоразмер.Ширина КАК typeSize_width,
	|	Вт.Типоразмер.Глубина КАК typeSize_depth,
	|	ВЫБОР
	|		КОГДА Вт.Типоразмер.Вес = 0
	|			ТОГДА 10000
	|		ИНАЧЕ Вт.Типоразмер.Вес
	|	КОНЕЦ КАК typeSize_weight,
	|	Вт.Типоразмер.НеОграниченаПоГрузоподъемности КАК typeSize_unlimitedWeight,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Вт.Паллет1) КАК pallet1_id,
	|	Вт.Паллет1.Код КАК pallet1_code,
	|	Вт.ТипоразмерПаллета1 КАК pallet1_typeSize,
	|	Вт.ТипоразмерПаллета1.Высота КАК pallet1_height,
	|	Вт.ТипоразмерПаллета1.Ширина КАК pallet1_width,
	|	Вт.ТипоразмерПаллета1.Глубина КАК pallet1_depth,
	|	Вт.ТипоразмерПаллета1.Вес КАК pallet1_weight,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Вт.Паллет2) КАК pallet2_id,
	|	Вт.Паллет2.Код КАК pallet2_code,
	|	Вт.ТипоразмерПаллета2 КАК pallet2_typeSize,
	|	Вт.ТипоразмерПаллета2.Высота КАК pallet2_height,
	|	Вт.ТипоразмерПаллета2.Ширина КАК pallet2_width,
	|	Вт.ТипоразмерПаллета2.Глубина КАК pallet2_depth,
	|	Вт.ТипоразмерПаллета2.Вес КАК pallet2_weight,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Вт.Паллет3) КАК pallet3_id,
	|	Вт.Паллет3.Код КАК pallet3_code,
	|	Вт.ТипоразмерПаллета3 КАК pallet3_typeSize,
	|	Вт.ТипоразмерПаллета3.Высота КАК pallet3_height,
	|	Вт.ТипоразмерПаллета3.Ширина КАК pallet3_width,
	|	Вт.ТипоразмерПаллета3.Глубина КАК pallet3_depth,
	|	Вт.ТипоразмерПаллета3.Вес КАК pallet3_weight,
	|	Вт.Узкопроходный КАК narrowAisle,
	|	Вт.КоличествоОстаток КАК quantity1,
	|	Вт.ЗаблокированОстаток КАК blocked1,
	|	Вт.КоличествоОстаток1 КАК quantity2,
	|	Вт.ЗаблокированОстаток1 КАК blocked2,
	|	Вт.КоличествоОстаток2 КАК quantity3,
	|	Вт.ЗаблокированОстаток2 КАК blocked3,
	|	ВЫБОР
	|		КОГДА Вт.ЗазорПоШирине = 0
	|			ТОГДА 50
	|		ИНАЧЕ Вт.ЗазорПоШирине
	|	КОНЕЦ КАК gap_width,
	|	ВЫБОР
	|		КОГДА Вт.МаксимальныйВесПодъёмаНаЭтаж = 0
	|			ТОГДА 10000
	|		ИНАЧЕ Вт.МаксимальныйВесПодъёмаНаЭтаж
	|	КОНЕЦ КАК max_lift_weight,
	|	Вт.ВремяДоступа КАК accessTime,
	|	ВЫБОР
	|		КОГДА Вт.СтеллажМаксШиринаПаллета = 0
	|			ТОГДА Вт.Типоразмер.Ширина
	|		ИНАЧЕ Вт.СтеллажМаксШиринаПаллета
	|	КОНЕЦ КАК max_widthPallet,
	|	Вт.СтеллажМаксГлубинаПаллета КАК max_depthPallet,
	|	Вт.СтеллажКоличествоЯчеекВСекции КАК max_pallets
	|ИЗ
	|	Вт КАК Вт
	|
	|УПОРЯДОЧИТЬ ПО
	|	Вт.НомерСтеллажа,
	|	Вт.Этаж,
	|	Вт.Секция.Место";

		Запрос.УстановитьПараметр("Склад", СкладСсылка);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
  
	Возврат Лико_HTTP_Сервер.ТзВМассивСтруктур(ТЗ);

КонецФункции

Функция СобратьПаллетыНаПолу(СкладСсылка)

	// Возвращает структуру { Паллеты } — паллеты на полу без HTTP-обёртки.
	// Используется WMS_GetFloor и WMS_ExportSnapshot.

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_ПараметрыПаллетСрезПоследних.Типоразмер КАК typeSize,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Лико_ПаллетыВСекцияхОстатки.Адрес) КАК adress_id,
	|	Лико_ПаллетыВСекцияхОстатки.Адрес.Код КАК adress_code,
	|	Лико_ПараметрыПаллетСрезПоследних.Типоразмер.Высота КАК height,
	|	Лико_ПараметрыПаллетСрезПоследних.Типоразмер.Ширина КАК width,
	|	Лико_ПараметрыПаллетСрезПоследних.Типоразмер.Глубина КАК depth,
	|	Лико_ПараметрыПаллетСрезПоследних.Типоразмер.Вес КАК weight,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.Стеллаж ЕСТЬ NULL
	|			ТОГДА """"
	|		ИНАЧЕ УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВложенныйЗапрос.Стеллаж)
	|	КОНЕЦ КАК pallet_id,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.Стеллаж ЕСТЬ NULL
	|			ТОГДА """"
	|		ИНАЧЕ ВложенныйЗапрос.Стеллаж.Код
	|	КОНЕЦ КАК pallet_code,
	|	ВложенныйЗапрос.Стеллаж.Ссылка КАК rack_id,
	|	Лико_ПаллетыВСекцияхОстатки.КоличествоОстаток КАК quantity,
	|	Лико_ПаллетыВСекцияхОстатки.ЗаблокированОстаток КАК blocked
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних КАК Лико_ПараметрыПаллетСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ПаллетыВСекциях.Остатки КАК Лико_ПаллетыВСекцияхОстатки
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				Лико_СтеллажиЗоныПриемкиОтгрузки.АдресХранения КАК АдресХранения,
	|				МАКСИМУМ(Лико_СтеллажиЗоныПриемкиОтгрузки.Ссылка) КАК Стеллаж
	|			ИЗ
	|				Справочник.Лико_Стеллажи.ЗоныПриемкиОтгрузки КАК Лико_СтеллажиЗоныПриемкиОтгрузки
	|			ГДЕ
	|				Лико_СтеллажиЗоныПриемкиОтгрузки.Ссылка.Склад = &Склад
	|			
	|			СГРУППИРОВАТЬ ПО
	|				Лико_СтеллажиЗоныПриемкиОтгрузки.АдресХранения) КАК ВложенныйЗапрос
	|			ПО Лико_ПаллетыВСекцияхОстатки.Адрес = ВложенныйЗапрос.АдресХранения
	|		ПО (Лико_ПаллетыВСекцияхОстатки.Паллет = Лико_ПараметрыПаллетСрезПоследних.Паллет)
	|ГДЕ
	|	Лико_ПаллетыВСекцияхОстатки.Секция = ЗНАЧЕНИЕ(Справочник.Лико_СкладскиеСекции.Пустаяссылка)
	|	И Лико_ПаллетыВСекцияхОстатки.Адрес.Владелец = &Склад";
	Запрос.УстановитьПараметр("Склад",СкладСсылка);
	
	ТЗ = Запрос.Выполнить().Выгрузить();

	
	Возврат Лико_HTTP_Сервер.ТзВМассивСтруктур(ТЗ);

КонецФункции

Функция WMS_ExportSnapshot(ПараметрыPOST) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Экспортирует ВСЕ данные склада одним вызовом: топологию + занятость + пол.
	//   Результат — автономный JSON для работы веб-приложения без 1С.
	//
	// ПАРАМЕТРЫ:
	//   warehouse — GUID склада.

	Если НЕ ПараметрыPOST.Свойство("warehouse") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM", "Не передан параметр 'warehouse'");
	КонецЕсли;

	// Валидация склада
	СкладСсылка = СсылкаПоСтрокеGUID(ПараметрыPOST.warehouse, "Справочник.Склады");
	Если НЕ ЗначениеЗаполнено(СкладСсылка) Тогда
		Возврат HttpВернутьОшибку_WMS("INVALID_PARAM", "Склад не найден");
	КонецЕсли;

	// Собираем все три компонента через внутренние хелперы
	ДанныеСклада = СобратьТопологиюСклада(СкладСсылка);
	ДанныеЗанятости = СобратьЗанятостьСекций(СкладСсылка);
	ДанныеПола = СобратьПаллетыНаПолу(СкладСсылка);

	//+Лико m.shenderov 21.07.2026 — собираем версии секций для контроля актуальности snapshot'а
	ВерсииСекций = СобратьВерсииСекций(СкладСсылка);

	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ok", Истина);
	СтруктураОтвет.Вставить("exportedAt", ТекущаяДата());
	СтруктураОтвет.Вставить("warehouse", ДанныеСклада.Склад);
	СтруктураОтвет.Вставить("racks", ДанныеСклада.Стеллажи);
	СтруктураОтвет.Вставить("sections", ДанныеЗанятости);
	СтруктураОтвет.Вставить("floorPallets", ДанныеПола);
	//+Лико m.shenderov 21.07.2026 — массив [{section, version}] вместо объекта (GUID-ключи ломают ПрочитатьJSON)
	СтруктураОтвет.Вставить("versions", _ВерсииСоответствиеВМассив(ВерсииСекций));

	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));

КонецФункции

// ============================================================================
// WMS Optimizer — 3 новые функции
// ============================================================================

//+Лико m.shenderov 19.07.2026
Функция ОптимальноеРазмещениеПаллет(Склад, МассивПаллет, МаксПерестановок = 0) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Пакетное размещение партии паллет. Использует штатную
	//   ОшибкиРазмещенияПаллетаВАдрес() для валидации каждого адреса.
	//
	// ПАРАМЕТРЫ:
	//   Склад             — СправочникСсылка.Склады
	//   МассивПаллет       — Массив ссылок Лико_Паллеты2_0
	//   МаксПерестановок   — Число (резерв, пока не используется)
	//
	// ВОЗВРАТ:
	//   Структура { Placements, Rearrangements, Unplaced, Stats }

	Результат = Новый Структура;
	Результат.Вставить("Placements", Новый Массив);
	Результат.Вставить("Rearrangements", Новый Массив);
	Результат.Вставить("Unplaced", Новый Массив);

	// --- Загрузка габаритов паллет ---
	ГабаритыПаллет = Новый Соответствие;
	ЗапросГабариты = Новый Запрос;
	ЗапросГабариты.Текст =
	"ВЫБРАТЬ
	|	Лико_ПараметрыПаллет.Паллет КАК Паллет,
	|	Лико_ПараметрыПаллет.Типоразмер.Высота КАК Высота,
	|	Лико_ПараметрыПаллет.Типоразмер.Ширина КАК Ширина,
	|	Лико_ПараметрыПаллет.Типоразмер.Глубина КАК Глубина,
	|	Лико_ПараметрыПаллет.Типоразмер.Вес КАК Вес
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних КАК Лико_ПараметрыПаллет
	|ГДЕ
	|	Лико_ПараметрыПаллет.Паллет В (&МассивПаллет)";
	ЗапросГабариты.УстановитьПараметр("МассивПаллет", МассивПаллет);
	ТЗГабариты = ЗапросГабариты.Выполнить().Выгрузить();
	Для Каждого Стр Из ТЗГабариты Цикл
		Габ = Новый Структура("Высота,Ширина,Глубина,Вес", Стр.Высота, Стр.Ширина, Стр.Глубина, Стр.Вес);
		ГабаритыПаллет.Вставить(Стр.Паллет, Габ);
	КонецЦикла;

	// --- Загрузка секций и адресов (с типоразмерами для быстрого фильтра) ---
	ЗапросСекций = Новый Запрос;
	ЗапросСекций.Текст =
	"ВЫБРАТЬ
	|	Лико_СкладскиеСекции.Ссылка КАК Секция,
	|	Лико_СкладскиеСекции.Стеллаж КАК Стеллаж,
	|	Лико_СкладскиеСекции.Этаж КАК Этаж,
	|	Лико_СкладскиеСекции.Типоразмер.Высота КАК ВысотаТС,
	|	Лико_СкладскиеСекции.Типоразмер.Ширина КАК ШиринаТС,
	|	Лико_СкладскиеСекции.Типоразмер.Вес КАК ВесТС,
	|	Лико_СкладскиеСекции.Типоразмер.НеОграниченаПоГрузоподъемности КАК БезлимВес,
	|	Лико_СкладскиеСекции.Адрес1 КАК Адрес1,
	|	Лико_СкладскиеСекции.Адрес2 КАК Адрес2,
	|	Лико_СкладскиеСекции.Адрес3 КАК Адрес3,
	|	Лико_СкладскиеСекции.ЗапретРазмещения КАК Запрет
	|ИЗ
	|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
	|ГДЕ
	|	Лико_СкладскиеСекции.Склад = &Склад";
	ЗапросСекций.УстановитьПараметр("Склад", Склад);
	ТЗСекций = ЗапросСекций.Выполнить().Выгрузить();

	// Строим массив адресов
	МассивАдресов = Новый Массив; // [{Ячейка, Секция, Стеллаж, Этаж, ВысотаТС, ШиринаТС, ВесТС, БезлимВес}]
	Для Каждого С Из ТЗСекций Цикл
		Если С.Запрет Тогда Продолжить; КонецЕсли;
		Для НомерАдреса = 1 По 3 Цикл
			ИмяАдреса = "Адрес" + НомерАдреса;
			Ячейка = С[ИмяАдреса];
			Если ЗначениеЗаполнено(Ячейка) Тогда
				Запись = Новый Структура;
				Запись.Вставить("Ячейка", Ячейка);
				Запись.Вставить("Секция", С.Секция);
				Запись.Вставить("Стеллаж", С.Стеллаж);
				Запись.Вставить("Этаж", С.Этаж);
				Запись.Вставить("ВысотаТС", С.ВысотаТС);
				Запись.Вставить("ШиринаТС", С.ШиринаТС);
				Запись.Вставить("ВесТС", С.ВесТС);
				Запись.Вставить("БезлимВес", С.БезлимВес);
				МассивАдресов.Добавить(Запись);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Сортировка адресов по высоте секции (возрастание) — first-fit найдёт самую низкую подходящую
	Для i = 0 По МассивАдресов.Количество() - 2 Цикл
		Для j = i + 1 По МассивАдресов.Количество() - 1 Цикл
			Если МассивАдресов[i].ВысотаТС > МассивАдресов[j].ВысотаТС Тогда
				Вр = МассивАдресов[i]; МассивАдресов[i] = МассивАдресов[j]; МассивАдресов[j] = Вр;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// --- Сортировка паллет по убыванию ВЫСОТЫ, затем ширины (FFD) ---
	МассивПаллетСорт = Новый Массив;
	Для Каждого Паллет Из МассивПаллет Цикл
		ГабП = ГабаритыПаллет.Получить(Паллет);
		Если ГабП <> Неопределено Тогда
			З = Новый Структура("Ссылка,Ширина,Высота,Глубина,Вес", Паллет, ГабП.Ширина, ГабП.Высота, ГабП.Глубина, ГабП.Вес);
			МассивПаллетСорт.Добавить(З);
		КонецЕсли;
	КонецЦикла;
	// Сортировка: сначала по высоте (убыв), потом по ширине (убыв)
	Для i = 0 По МассивПаллетСорт.Количество() - 2 Цикл
		Для j = i + 1 По МассивПаллетСорт.Количество() - 1 Цикл
			Если МассивПаллетСорт[i].Высота < МассивПаллетСорт[j].Высота
			   ИЛИ (МассивПаллетСорт[i].Высота = МассивПаллетСорт[j].Высота
			        И МассивПаллетСорт[i].Ширина < МассивПаллетСорт[j].Ширина) Тогда
				Вр = МассивПаллетСорт[i]; МассивПаллетСорт[i] = МассивПаллетСорт[j]; МассивПаллетСорт[j] = Вр;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// --- Инициализация ВиртуальногоСостояния текущими остатками склада ---
	// Ключ = Ячейка (СкладскиеЯчейки), Значение = ПаллетСсылка (Лико_Паллеты2_0).
	// Валидатор сначала проверяет ВиртуальноеСостояние, потом реальный регистр.
	ВиртуальноеСостояние = Новый Соответствие;

	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст =
	"ВЫБРАТЬ
	|	Лико_ПаллетыВСекцияхОстатки.Адрес КАК Адрес,
	|	Лико_ПаллетыВСекцияхОстатки.Паллет КАК Паллет
	|ИЗ
	|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки КАК Лико_ПаллетыВСекцияхОстатки
	|ГДЕ
	|	Лико_ПаллетыВСекцияхОстатки.Секция.Склад = &Склад
	|	И НЕ Лико_ПаллетыВСекцияхОстатки.Секция = ЗНАЧЕНИЕ(Справочник.Лико_СкладскиеСекции.ПустаяСсылка)";
	ЗапросОстатков.УстановитьПараметр("Склад", Склад);
	ТЗОстатков = ЗапросОстатков.Выполнить().Выгрузить();

	Для Каждого Стр Из ТЗОстатков Цикл
		// Паллеты из партии исключаем — их текущие ячейки считаются свободными
		// для оптимального переразмещения (релокации)
		Если МассивПаллет.Найти(Стр.Паллет) = Неопределено Тогда
			ВиртуальноеСостояние.Вставить(Стр.Адрес, Стр.Паллет);
		КонецЕсли;
	КонецЦикла;

	// --- ФАЗА 1: Section-level Greedy Knapsack ---
	// Группируем адреса по секциям. Для каждой секции подбираем
	// лучшую комбинацию до 3 паллет (1 на адрес).
	// "Лучшая" = максимизирует суммарную ширину.
	// Размещённые паллеты удаляются из пула. Неразмещённые — в Unplaced.

	// Копируем массив паллет (будем удалять размещённые)
	ПулПаллет = Новый Массив;
	Для Каждого П Из МассивПаллетСорт Цикл ПулПаллет.Добавить(П); КонецЦикла;

	// Группируем адреса по секциям: Соответствие(Секция -> Массив адресов)
	СекцииАдреса = Новый Соответствие;
	Для Каждого Адр Из МассивАдресов Цикл
		АдресаСекции = СекцииАдреса.Получить(Адр.Секция);
		Если АдресаСекции = Неопределено Тогда
			АдресаСекции = Новый Массив;
			СекцииАдреса.Вставить(Адр.Секция, АдресаСекции);
		КонецЕсли;
		АдресаСекции.Добавить(Адр);
	КонецЦикла;

	ЗазорШ = 50;

	// Обрабатываем секции — от самой низкой к высокой
	Для Каждого КлючС Из СекцииАдреса Цикл
		АдресаСекции = КлючС.Значение;
		Если АдресаСекции.Количество() = 0 Тогда Продолжить; КонецЕсли;

		// Данные секции из первого адреса
		ПервыйАдр = АдресаСекции[0];
		ВысотаС = ПервыйАдр.ВысотаТС;
		ШиринаС = ПервыйАдр.ШиринаТС;
		ВесС = ПервыйАдр.ВесТС;
		БезлимВесС = ПервыйАдр.БезлимВес;

		// Свободные адреса в секции
		СвобАдреса = Новый Массив;
		Для Каждого Адр Из АдресаСекции Цикл
			Если ВиртуальноеСостояние.Получить(Адр.Ячейка) = Неопределено Тогда
				СвобАдреса.Добавить(Адр);
			КонецЕсли;
		КонецЦикла;
		Если СвобАдреса.Количество() = 0 Тогда Продолжить; КонецЕсли;

		// Собрать кандидатов для этой секции
		Кандидаты = Новый Массив;
		Для Каждого П Из ПулПаллет Цикл
			Если П.Высота > ВысотаС Тогда Продолжить; КонецЕсли;
			Если П.Ширина > ШиринаС Тогда Продолжить; КонецЕсли;
			Если НЕ БезлимВесС И ВесС > 0 И П.Вес > ВесС Тогда Продолжить; КонецЕсли;
			Кандидаты.Добавить(П);
			Если Кандидаты.Количество() >= 30 Тогда Прервать; КонецЕсли;
		КонецЦикла;
		Если Кандидаты.Количество() = 0 Тогда Продолжить; КонецЕсли;

		МаксАдресов = СвобАдреса.Количество();

		// Найти лучшую комбинацию: перебор всех 1-/2-/3-паллетных наборов
		ЛучшиеИндексы = Новый Массив;
		ЛучшаяШирина = 0;
		N = Кандидаты.Количество();

		// 1 паллет
		Для i = 0 По N - 1 Цикл
			Ш1 = Кандидаты[i].Ширина + 2 * ЗазорШ;
			Если Ш1 <= ШиринаС И Кандидаты[i].Ширина > ЛучшаяШирина Тогда
				ЛучшиеИндексы = Новый Массив; ЛучшиеИндексы.Добавить(i);
				ЛучшаяШирина = Кандидаты[i].Ширина;
			КонецЕсли;
		КонецЦикла;

		// 2 паллета (если в секции ≥ 2 свободных адресов)
		Если МаксАдресов >= 2 Тогда
			Для i = 0 По N - 1 Цикл
				Для j = i + 1 По N - 1 Цикл
					Сумма2 = Кандидаты[i].Ширина + Кандидаты[j].Ширина;
					Ш2 = Сумма2 + 3 * ЗазорШ;
					Если Ш2 <= ШиринаС И Сумма2 > ЛучшаяШирина Тогда
						// Проверка суммарного веса
						Вес2 = Кандидаты[i].Вес + Кандидаты[j].Вес;
						Если БезлимВесС ИЛИ ВесС = 0 ИЛИ Вес2 <= ВесС Тогда
							ЛучшиеИндексы = Новый Массив; ЛучшиеИндексы.Добавить(i); ЛучшиеИндексы.Добавить(j);
							ЛучшаяШирина = Сумма2;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;

		// 3 паллета (если в секции 3 свободных адреса)
		Если МаксАдресов >= 3 Тогда
			Для i = 0 По N - 1 Цикл
				Для j = i + 1 По N - 1 Цикл
					Сумма2 = Кандидаты[i].Ширина + Кандидаты[j].Ширина;
					Ш2 = Сумма2 + 3 * ЗазорШ;
					Если Ш2 > ШиринаС Тогда Продолжить; КонецЕсли;
					Для k = j + 1 По N - 1 Цикл
						Сумма3 = Сумма2 + Кандидаты[k].Ширина;
						Ш3 = Сумма3 + 4 * ЗазорШ;
						Если Ш3 <= ШиринаС И Сумма3 > ЛучшаяШирина Тогда
							Вес3 = Кандидаты[i].Вес + Кандидаты[j].Вес + Кандидаты[k].Вес;
							Если БезлимВесС ИЛИ ВесС = 0 ИЛИ Вес3 <= ВесС Тогда
								ЛучшиеИндексы = Новый Массив;
								ЛучшиеИндексы.Добавить(i); ЛучшиеИндексы.Добавить(j); ЛучшиеИндексы.Добавить(k);
								ЛучшаяШирина = Сумма3;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;

		// Разместить лучшую комбинацию с валидацией через ОшибкиРазмещенияПаллетаВАдрес
		Для idx = 0 По ЛучшиеИндексы.Количество() - 1 Цикл
			П = Кандидаты[ЛучшиеИндексы[idx]];

			// Выбрать адрес внутри секции по правилам из ПодобратьЯчейку
			ЯчейкаДляРазмещения = Неопределено;
			Если П.Ширина > ПервыйАдр.ШиринаТС * 2 / 3 Тогда
				// Wide (>W*2/3): только адрес 2 (средний)
				ЯчейкаДляРазмещения = ПервыйАдр.Адрес2;
			Иначе
				// Найти первый свободный адрес из доступных
				Для аа = 0 По СвобАдреса.Количество() - 1 Цикл
					Ячейка = СвобАдреса[аа].Ячейка;
					Если ВиртуальноеСостояние.Получить(Ячейка) = Неопределено Тогда
						ЯчейкаДляРазмещения = Ячейка;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;

			Если ЯчейкаДляРазмещения = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			// КРИТИЧНО: валидировать через ОшибкиРазмещенияПаллетаВАдрес с ВиртуальнымСостоянием
			Ошибки = Справочники.Лико_СкладскиеСекции.ОшибкиРазмещенияПаллетаВАдрес(
				ЯчейкаДляРазмещения, П.Ссылка, , , ВиртуальноеСостояние);

			Если Ошибки.Количество() > 0 Тогда
				// Валидация не прошла — пропустить этот паллет
				Продолжить;
			КонецЕсли;

			// Размещение успешно валидировано — зафиксировать
			Разм = Новый Структура;
			Разм.Вставить("Паллет", П.Ссылка);

			// Найти строку адреса для получения Секции, Стеллажа, Этажа
			ЦелевойАдрЭнная = Неопределено;
			Для каждого Адр Из МассивАдресов Цикл
				Если Адр.Ячейка = ЯчейкаДляРазмещения Тогда
					ЦелевойАдрЭнная = Адр;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если ЦелевойАдрЭнная <> Неопределено Тогда
				Разм.Вставить("Адрес", Строка(ЯчейкаДляРазмещения.УникальныйИдентификатор()));
				Разм.Вставить("Секция", Строка(ЦелевойАдрЭнная.Секция.УникальныйИдентификатор()));
				Разм.Вставить("Стеллаж", Строка(ЦелевойАдрЭнная.Стеллаж.УникальныйИдентификатор()));
				Разм.Вставить("Этаж", ЦелевойАдрЭнная.Этаж);
				Результат.Placements.Добавить(Разм);
				ВиртуальноеСостояние.Вставить(ЯчейкаДляРазмещения, П.Ссылка);

				// Удалить из пула
				Для p = 0 По ПулПаллет.Количество() - 1 Цикл
					Если ПулПаллет[p].Ссылка = П.Ссылка Тогда
						ПулПаллет.Удалить(p);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// --- ФАЗА 2: Перестановки (если МаксПерестановок > 0) ---
	Если МаксПерестановок > 0 И ПулПаллет.Количество() > 0 Тогда
		ИспользованоПерестановок = 0;
		ЭтажиАдреса = Новый Соответствие;
		Для Каждого Адр Из МассивАдресов Цикл
			АдресаЭтажа = ЭтажиАдреса.Получить(Адр.Этаж);
			Если АдресаЭтажа = Неопределено Тогда
				АдресаЭтажа = Новый Массив;
				ЭтажиАдреса.Вставить(Адр.Этаж, АдресаЭтажа);
			КонецЕсли;
			АдресаЭтажа.Добавить(Адр);
		КонецЦикла;

		ЭтажиОтсорт = Новый Массив;
		Для Каждого КлючЭ Из ЭтажиАдреса Цикл
			ЭтажиОтсорт.Добавить(КлючЭ.Ключ);
		КонецЦикла;
		Для i = 0 По ЭтажиОтсорт.Количество() - 2 Цикл
			Для j = i + 1 По ЭтажиОтсорт.Количество() - 1 Цикл
				Если ЭтажиОтсорт[i] > ЭтажиОтсорт[j] Тогда
					Вр = ЭтажиОтсорт[i]; ЭтажиОтсорт[i] = ЭтажиОтсорт[j]; ЭтажиОтсорт[j] = Вр;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		ПулДляФазы2 = Новый Массив;
		Для Каждого П Из ПулПаллет Цикл
			ПулДляФазы2.Добавить(П);
		КонецЦикла;

		Для Каждого ПалletF2 Из ПулДляФазы2 Цикл
			Если ИспользованоПерестановок >= МаксПерестановок Тогда
				Прервать;
			КонецЕсли;

			РазмещеноНаФазе2 = Ложь;
			Для Каждого Этаж Из ЭтажиОтсорт Цикл
				Если РазмещеноНаФазе2 Тогда Прервать; КонецЕсли;
				АдресаЭтажа = ЭтажиАдреса.Получить(Этаж);

				Для Каждого АдрЗанят Из АдресаЭтажа Цикл
					Если ИспользованоПерестановок >= МаксПерестановок Тогда
						Прервать;
					КонецЕсли;

					ПалletВАдресе = ВиртуальноеСостояние.Получить(АдрЗанят.Ячейка);
					Если ПалletВАдресе = Неопределено Тогда
						Продолжить;
					КонецЕсли;

					Для Каждого АдрСвоб Из АдресаЭтажа Цикл
						Если ИспользованоПерестановок >= МаксПерестановок Тогда
							Прервать;
						КонецЕсли;

						Если АдрСвоб.Ячейка = АдрЗанят.Ячейка Тогда
							Продолжить;
						КонецЕсли;
						Если ВиртуальноеСостояние.Получить(АдрСвоб.Ячейка) <> Неопределено Тогда
							Продолжить;
						КонецЕсли;

						Ошибки = Справочники.Лико_СкладскиеСекции.ОшибкиРазмещенияПаллетаВАдрес(
							АдрСвоб.Ячейка, ПалletВАдресе, , , ВиртуальноеСостояние);

						Если Ошибки.Количество() = 0 Тогда
							ВиртуальноеСостояние.Удалить(АдрЗанят.Ячейка);
							ВиртуальноеСостояние.Вставить(АдрСвоб.Ячейка, ПалletВАдресе);

							Ошибки2 = Справочники.Лико_СкладскиеСекции.ОшибкиРазмещенияПаллетаВАдрес(
								АдрЗанят.Ячейка, ПалletF2.Ссылка, , , ВиртуальноеСостояние);

							Если Ошибки2.Количество() = 0 Тогда
								Перест = Новый Структура;
								Перест.Вставить("Паллет", ПалletВАдресе);
								Перест.Вставить("ОткудаАдрес", Строка(АдрЗанят.Ячейка.УникальныйИдентификатор()));
								Перест.Вставить("КудаАдрес", Строка(АдрСвоб.Ячейка.УникальныйИдентификатор()));
								Результат.Rearrangements.Добавить(Перест);

								РазмN = Новый Структура;
								РазмN.Вставить("Паллет", ПалletF2.Ссылка);
								РазмN.Вставить("Адрес", Строка(АдрЗанят.Ячейка.УникальныйИдентификатор()));
								РазмN.Вставить("Секция", Строка(АдрЗанят.Секция.УникальныйИдентификатор()));
								РазмN.Вставить("Стеллаж", Строка(АдрЗанят.Стеллаж.УникальныйИдентификатор()));
								РазмN.Вставить("Этаж", АдрЗанят.Этаж);
								Результат.Placements.Добавить(РазмN);

								ВиртуальноеСостояние.Вставить(АдрЗанят.Ячейка, ПалletF2.Ссылка);
								ИспользованоПерестановок = ИспользованоПерестановок + 1;
								РазмещеноНаФазе2 = Истина;

								Для p = 0 По ПулПаллет.Количество() - 1 Цикл
									Если ПулПаллет[p].Ссылка = ПалletF2.Ссылка Тогда
										ПулПаллет.Удалить(p);
										Прервать;
									КонецЕсли;
								КонецЦикла;
								Прервать;
							Иначе
								ВиртуальноеСостояние.Удалить(АдрСвоб.Ячейка);
								ВиртуальноеСостояние.Вставить(АдрЗанят.Ячейка, ПалletВАдресе);
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	// Остаток пула — неразмещённые
	Для Каждого П Из ПулПаллет Цикл
		Неразм = Новый Структура;
		Неразм.Вставить("Паллет", П.Ссылка);
		Неразм.Вставить("Причина", "Не найден подходящий адрес");
		Результат.Unplaced.Добавить(Неразм);
	КонецЦикла;

	// --- Статистика с плотностями и перестановками ---
	// Пересчитать плотности ПОСЛЕ всех фаз
	ОбщееКоличествоАдресов = МассивАдресов.Количество();

	// ПлотностьДо: была сохранена в ВиртуальноеСостояние в начале
	// Заново пересчитаем, исключая паллеты из МассивПаллет (они были исключены при инициализации)
	ЗанятыхДоПеред = 0;
	ЗапросОстатковДо = Новый Запрос;
	ЗапросОстатковДо.Текст =
	"ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лико_ПаллетыВСекцияхОстатки.Адрес) КАК КоличествоАдресов
	|ИЗ РегистрНакопления.Лико_ПаллетыВСекциях.Остатки КАК Лико_ПаллетыВСекцияхОстатки
	|ГДЕ Секция.Склад = &Склад
	|	И НЕ Секция = ЗНАЧЕНИЕ(Справочник.Лико_СкладскиеСекции.ПустаяСсылка)";
	ЗапросОстатковДо.УстановитьПараметр("Склад", Склад);
	ТЗОстатковДо = ЗапросОстатковДо.Выполнить().Выгрузить();
	Если ТЗОстатковДо.Количество() > 0 Тогда
		ЗанятыхДоПеред = ТЗОстатковДо[0].КоличествоАдресов;
	КонецЕсли;
	ПлотностьДо = ?(ОбщееКоличествоАдресов > 0, ЗанятыхДоПеред / ОбщееКоличествоАдресов, 0);

	// ПлотностьПосле: исходные остатки + все размещения (Фаза 1 + Фаза 2)
	ЗанятыхПосле = ЗанятыхДоПеред + Результат.Placements.Количество();
	ПлотностьПосле = ?(ОбщееКоличествоАдресов > 0, ЗанятыхПосле / ОбщееКоличествоАдресов, 0);

	// Подсчёт перестановок
	КоличествоПеремещений = Результат.Rearrangements.Количество();

	Stats = Новый Структура;
	Stats.Вставить("Всего", МассивПаллет.Количество());
	Stats.Вставить("Размещено", Результат.Placements.Количество());
	Stats.Вставить("НеРазмещено", Результат.Unplaced.Количество());
	Stats.Вставить("Перестановок", КоличествоПеремещений);
	Stats.Вставить("ПлотностьДо", Окр(ПлотностьДо, 3));
	Stats.Вставить("ПлотностьПосле", Окр(ПлотностьПосле, 3));
	Результат.Вставить("Stats", Stats);

	Возврат Результат;

КонецФункции

//+Лико m.shenderov 19.07.2026
Функция РеслотСклада(Склад, МаксПеремещений) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Поиск плана уплотнения: переставить стоящие паллеты чтобы освободить
	//   максимум секций за ≤ МаксПеремещений ходов.
	//
	// ПАРАМЕТРЫ:
	//   Склад            — СправочникСсылка.Склады
	//   МаксПеремещений   — Число
	//
	// ВОЗВРАТ:
	//   Структура { Moves, Stats }

	Результат = Новый Структура;
	Результат.Вставить("Moves", Новый Массив);

	// --- Загрузка секций ---
	СекцииДанные = СобратьЗанятостьСекций(Склад);
	Если СекцииДанные.Количество() = 0 Тогда
		Stats = Новый Структура;
		Stats.Вставить("ИспользованоПеремещений", 0);
		Stats.Вставить("ОсвобожденоСекций", 0);
		Stats.Вставить("ПриростПлотности", 0);
		Результат.Вставить("Stats", Stats);
		Возврат Результат;
	КонецЕсли;

	// --- Строим карту: секция -> список паллетов ---
	ПаллетыВСекции = Новый Соответствие; // section_id -> Массив структур {Паллет, Адрес, Ширина, Высота, Глубина, Вес}
	СекцииСДанными = Новый Соответствие;  // section_id -> Структура секции

	Для Каждого С Из СекцииДанные Цикл
		ИД = ?(С.Свойство("section_id"), С.section_id, "");
		Если НЕ ЗначениеЗаполнено(ИД) Тогда
			Продолжить;
		КонецЕсли;

		СекцииСДанными.Вставить(ИД, С);

		Паллеты = Новый Массив;
		Для Номер = 1 По 3 Цикл
			ИмяКода = "pallet" + Номер + "_code";
			Если С.Свойство(ИмяКода) И ЗначениеЗаполнено(С[ИмяКода]) И С[ИмяКода] <> "0" Тогда
				П = Новый Структура;
				П.Вставить("Паллет", С["pallet" + Номер + "_id"]);
				П.Вставить("Адрес", С["address" + Номер]);
				П.Вставить("Ширина", ?(С.Свойство("pallet" + Номер + "_width"), С["pallet" + Номер + "_width"], 0));
				П.Вставить("Высота", ?(С.Свойство("pallet" + Номер + "_height"), С["pallet" + Номер + "_height"], 0));
				П.Вставить("Глубина", ?(С.Свойство("pallet" + Номер + "_depth"), С["pallet" + Номер + "_depth"], 0));
				П.Вставить("Вес", ?(С.Свойство("pallet" + Номер + "_weight"), С["pallet" + Номер + "_weight"], 0));
				Паллеты.Добавить(П);
			КонецЕсли;
		КонецЦикла;
		ПаллетыВСекции.Вставить(ИД, Паллеты);
	КонецЦикла;

	// --- Поиск кандидатов на объединение ---
	Кандидаты = Новый Массив;

	ИдыСекций = Новый Массив;
	Для Каждого Ключ Из ПаллетыВСекции Цикл
		Если Ключ.Значение.Количество() > 0 И Ключ.Значение.Количество() < 3 Тогда
			ИдыСекций.Добавить(Ключ.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для i = 0 По ИдыСекций.Количество() - 2 Цикл
		ИдА = ИдыСекций[i];
		ПаллетыА = ПаллетыВСекции.Получить(ИдА);
		СекцияА = СекцииСДанными.Получить(ИдА);

		Для j = i + 1 По ИдыСекций.Количество() - 1 Цикл
			ИдБ = ИдыСекций[j];
			ПаллетыБ = ПаллетыВСекции.Получить(ИдБ);
			СекцияБ = СекцииСДанными.Получить(ИдБ);

			// Проверка: на одном этаже?
			ЭтажА = ?(СекцияА.Свойство("floor"), СекцияА.floor, 0);
			ЭтажБ = ?(СекцияБ.Свойство("floor"), СекцияБ.floor, 0);
			Если ЭтажА <> ЭтажБ Тогда
				Продолжить;
			КонецЕсли;

			// Проверка: можно ли ВСЕ паллеты из B в A?
			СвободныхВA = 3 - ПаллетыА.Количество();
			Если ПаллетыБ.Количество() > СвободныхВA Тогда
				Продолжить;
			КонецЕсли;

			// Проверка габаритов: сумма ширин с зазором
			СуммаШиринА = 0;
			Для Каждого П Из ПаллетыА Цикл
				СуммаШиринА = СуммаШиринА + П.Ширина;
			КонецЦикла;
			СуммаШиринБ = 0;
			Для Каждого П Из ПаллетыБ Цикл
				СуммаШиринБ = СуммаШиринБ + П.Ширина;
			КонецЦикла;

			ШиринаСекции = ?(СекцияА.Свойство("typeSize_width"), СекцияА.typeSize_width, 2700);
			Зазор = 50; // ЗазорПоШирине по умолчанию
			НовоеКолво = ПаллетыА.Количество() + ПаллетыБ.Количество();
			НужнаяШирина = СуммаШиринА + СуммаШиринБ + (НовоеКолво + 1) * Зазор;
			Если НужнаяШирина > ШиринаСекции Тогда
				Продолжить;
			КонецЕсли;

			// Проверка высоты и веса
			ВысотаСекции = ?(СекцияА.Свойство("typeSize_height"), СекцияА.typeSize_height, 2100);
			МаксВес = ?(СекцияА.Свойство("typeSize_weight"), СекцияА.typeSize_weight, 0);
			БезлимВес = ?(СекцияА.Свойство("typeSize_unlimitedWeight"), СекцияА.typeSize_unlimitedWeight, Ложь);

			ВсегоВес = 0;
			Нарушение = Ложь;
			Для Каждого П Из ПаллетыА Цикл
				Если П.Высота > ВысотаСекции Тогда
					Нарушение = Истина;
					Прервать;
				КонецЕсли;
				ВсегоВес = ВсегоВес + П.Вес;
			КонецЦикла;

			Если НЕ Нарушение Тогда
				Для Каждого П Из ПаллетыБ Цикл
					Если П.Высота > ВысотаСекции Тогда
						Нарушение = Истина;
						Прервать;
					КонецЕсли;
					ВсегоВес = ВсегоВес + П.Вес;
				КонецЦикла;
			КонецЕсли;

			Если Нарушение Тогда
				Продолжить;
			КонецЕсли;

			Если НЕ БезлимВес И МаксВес > 0 И ВсегоВес > МаксВес Тогда
				Продолжить;
			КонецЕсли;

			// Кандидат найден!
			Moves = Новый Массив;
			// Назначаем свободные адреса в A для паллетов из B
			ЗанятыеАдресаА = Новый Массив;
			Для Каждого П Из ПаллетыА Цикл
				ЗанятыеАдресаА.Добавить(П.Адрес);
			КонецЦикла;

			Счетчик = 0;
			Для Каждого П Из ПаллетыБ Цикл
				// Найти свободный адрес в A
				ЦелевойАдрес = "";
				Для Номер = 1 По 3 Цикл
					Адр = СекцияА["address" + Номер];
					Если ЗанятыеАдресаА.Найти(Адр) = Неопределено Тогда
						ЦелевойАдрес = Адр;
						ЗанятыеАдресаА.Добавить(Адр);
						Прервать;
					КонецЕсли;
				КонецЦикла;

				Ход = Новый Структура;
				Ход.Вставить("Паллет", П.Паллет);
				Ход.Вставить("ОткудаАдрес", П.Адрес);
				Ход.Вставить("КудаАдрес", ЦелевойАдрес);
				Moves.Добавить(Ход);
				Счетчик = Счетчик + 1;
			КонецЦикла;

			Канд = Новый Структура;
			Канд.Вставить("Moves", Moves);
			Канд.Вставить("Cost", Moves.Количество());
			Канд.Вставить("Gain", 1); // одна секция B освобождается
			Канд.Вставить("Efficiency", 1.0 / Moves.Количество());
			Канд.Вставить("СекцияБ", ИдБ);
			Кандидаты.Добавить(Канд);
		КонецЦикла;
	КонецЦикла;

	// --- Сортировка по эффективности ---
	Для i = 0 По Кандидаты.Количество() - 2 Цикл
		Для j = i + 1 По Кандидаты.Количество() - 1 Цикл
			Если Кандидаты[i].Efficiency < Кандидаты[j].Efficiency Тогда
				Врем = Кандидаты[i];
				Кандидаты[i] = Кандидаты[j];
				Кандидаты[j] = Врем;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// --- Жадный отбор ---
	ИспользованоПеремещений = 0;
	ИспользованныеПаллеты = Новый Соответствие;
	ОсвобожденныеСекции = Новый Массив;

	Для Каждого Канд Из Кандидаты Цикл
		Если ИспользованоПеремещений + Канд.Cost > МаксПеремещений Тогда
			Продолжить;
		КонецЕсли;

		// Проверка что паллеты не участвуют в других перемещениях
		Конфликт = Ложь;
		Для Каждого М Из Канд.Moves Цикл
			Если ИспользованныеПаллеты.Получить(М.Паллет) <> Неопределено Тогда
				Конфликт = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Конфликт Тогда
			Продолжить;
		КонецЕсли;

		// Проверка что секция Б ещё не освобождена другим кандидатом
		Если ОсвобожденныеСекции.Найти(Канд.СекцияБ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Добавляем в план
		Для Каждого М Из Канд.Moves Цикл
			Результат.Moves.Добавить(М);
			ИспользованныеПаллеты.Вставить(М.Паллет, Истина);
		КонецЦикла;
		ИспользованоПеремещений = ИспользованоПеремещений + Канд.Cost;
		ОсвобожденныеСекции.Добавить(Канд.СекцияБ);
	КонецЦикла;

	// --- Статистика ---
	Stats = Новый Структура;
	Stats.Вставить("ИспользованоПеремещений", ИспользованоПеремещений);
	Stats.Вставить("ОсвобожденоСекций", ОсвобожденныеСекции.Количество());
	Stats.Вставить("КандидатовВсего", Кандидаты.Количество());

	Результат.Вставить("Stats", Stats);

	Возврат Результат;

КонецФункции

//+Лико m.shenderov 19.07.2026
Функция ПодобратьВысотыЭтажей(Стеллаж) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Двухпроходный подбор оптимальных типоразмеров этажей стеллажа.
	//   Учитывает фиксацию (ВысотаОтПолаФиксирована) и геометрическое ограничение.
	//
	// ПАРАМЕТРЫ:
	//   Стеллаж — СправочникСсылка.Лико_Стеллажи
	//
	// ВОЗВРАТ:
	//   Структура { Floors, Summary }

	Результат = Новый Структура;
	Floors = Новый Массив;
	Результат.Вставить("Floors", Floors);

	// --- ШАГ 1: Этажи ---
	Этажи = Стеллаж.Этажи;
	Если Этажи.Количество() = 0 Тогда
		Результат.Вставить("Summary", Новый Структура);
		Возврат Результат;
	КонецЕсли;

	// --- ШАГ 2: Статистика по каждому этажу ---
	ДанныеЭтажей = Новый Соответствие; // НомерЭтажа -> Структура
	ЭтажФикс = Неопределено;
	МаксНомер = 0;

	Для Каждого СтрЭтаж Из Этажи Цикл
		НомерЭтажа = СтрЭтаж.НомерСтроки;
		Если НомерЭтажа > МаксНомер Тогда МаксНомер = НомерЭтажа; КонецЕсли;

		Типоразмер = СтрЭтаж.Типоразмер;
		ТекВысота = Типоразмер.Высота;
		ТекШирина = Типоразмер.Ширина;
		ТекГлубина = Типоразмер.Глубина;
		ТекВес = Типоразмер.Вес;
		БезлимВес = Типоразмер.НеОграниченаПоГрузоподъемности;

		// Сбор паллет на этаже
		ЗапросП = Новый Запрос;
		ЗапросП.Текст =
		"ВЫБРАТЬ
		|	Лико_ПараметрыПаллет.Типоразмер.Высота КАК Высота
		|ИЗ
		|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки КАК Остатки
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних КАК Лико_ПараметрыПаллет
		|	ПО Остатки.Паллет = Лико_ПараметрыПаллет.Паллет
		|ГДЕ
		|	Остатки.Секция.Стеллаж = &Стеллаж
		|	И Остатки.Секция.Этаж = &Этаж";
		ЗапросП.УстановитьПараметр("Стеллаж", Стеллаж);
		ЗапросП.УстановитьПараметр("Этаж", НомерЭтажа);
		ТЗП = ЗапросП.Выполнить().Выгрузить();

		// Статистика
		maxH = 0;
		p90 = 0;
		Если ТЗП.Количество() > 0 Тогда
			// Сортируем для перцентиля
			Высоты = Новый Массив;
			Для Каждого С Из ТЗП Цикл
				Высоты.Добавить(С.Высота);
				Если С.Высота > maxH Тогда maxH = С.Высота; КонецЕсли;
			КонецЦикла;
			// Пузырьковая сортировка
			Для ii = 0 По Высоты.Количество() - 2 Цикл
				Для jj = ii + 1 По Высоты.Количество() - 1 Цикл
					Если Высоты[ii] < Высоты[jj] Тогда
						Вр = Высоты[ii]; Высоты[ii] = Высоты[jj]; Высоты[jj] = Вр;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			// 90-й перцентиль
			Индекс90 = Цел((Высоты.Количество() - 1) * 0.9);
			p90 = Высоты[Индекс90];
		КонецЕсли;

		ПотериМм = ТекВысота - maxH;
		ПотериПроцент = ?(ТекВысота > 0, ПотериМм / ТекВысота * 100, 0);

		// Фиксация
		Фикс = СтрЭтаж.ВысотаОтПолаФиксирована;
		Если Фикс Тогда
			ЭтажФикс = СтрЭтаж;
		КонецЕсли;

		Данные = Новый Структура;
		Данные.Вставить("Номер", НомерЭтажа);
		Данные.Вставить("ТекВысота", ТекВысота);
		Данные.Вставить("ТекШирина", ТекШирина);
		Данные.Вставить("ТекГлубина", ТекГлубина);
		Данные.Вставить("ТекВес", ТекВес);
		Данные.Вставить("БезлимВес", БезлимВес);
		Данные.Вставить("Зазор", СтрЭтаж.Зазор);
		Данные.Вставить("ВысотаБалки", СтрЭтаж.ВысотаБалки);
		Данные.Вставить("Фикс", Фикс);
		Данные.Вставить("Паллетов", ТЗП.Количество());
		Данные.Вставить("maxH", maxH);
		Данные.Вставить("p90", p90);
		Данные.Вставить("ПотериМм", ПотериМм);
		Данные.Вставить("ПотериПроцент", ПотериПроцент);

		ДанныеЭтажей.Вставить(НомерЭтажа, Данные);
	КонецЦикла;

	// --- ШАГ 3: ПРОХОД 1 — минимально достаточные высоты ---
	Для НомерЭтажа = 1 По МаксНомер Цикл
		Данные = ДанныеЭтажей.Получить(НомерЭтажа);
		Если Данные = Неопределено Тогда Продолжить; КонецЕсли;

		Если НЕ Данные.Фикс Тогда
			МинДостаточно = ?(Данные.p90 > 0, Данные.p90, Данные.maxH);

			// Подобрать минимальный типоразмер из каталога
			ЗапросК = Новый Запрос;
			ЗапросК.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Лико_ТипоразмерыСкладскихСекций.Ссылка КАК Ссылка,
			|	Лико_ТипоразмерыСкладскихСекций.Высота КАК Высота
			|ИЗ
			|	Справочник.Лико_ТипоразмерыСкладскихСекций КАК Лико_ТипоразмерыСкладскихСекций
			|ГДЕ
			|	Лико_ТипоразмерыСкладскихСекций.Высота >= &МинВысота
			|	И Лико_ТипоразмерыСкладскихСекций.Ширина = &Ширина
			|	И Лико_ТипоразмерыСкладскихСекций.Глубина >= &Глубина
			|	И (Лико_ТипоразмерыСкладскихСекций.Вес >= &Вес
			|		ИЛИ Лико_ТипоразмерыСкладскихСекций.НеОграниченаПоГрузоподъемности)
			|УПОРЯДОЧИТЬ ПО
			|	Высота";
			ЗапросК.УстановитьПараметр("МинВысота", МинДостаточно);
			ЗапросК.УстановитьПараметр("Ширина", Данные.ТекШирина);
			ЗапросК.УстановитьПараметр("Глубина", Данные.ТекГлубина);
			ЗапросК.УстановитьПараметр("Вес", Данные.ТекВес);
			ТЗК = ЗапросК.Выполнить().Выгрузить();

			Если ТЗК.Количество() > 0 Тогда
				Данные.Вставить("РекомендуемаяВысотаДоРаспределения", ТЗК[0].Высота);
				Данные.Вставить("РекомендуемыйТипоразмерДо", ТЗК[0].Ссылка);
			Иначе
				Данные.Вставить("РекомендуемаяВысотаДоРаспределения", Данные.ТекВысота);
				Данные.Вставить("РекомендуемыйТипоразмерДо", Неопределено);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// --- ШАГ 4: Геометрическое ограничение ---
	МинСумма = 0;
	ЭтажПолучатель = 0;
	МаксЗапас = -1;
	Избыток = 0;
	ЦелеваяСумма = 0;

	Если ЭтажФикс <> Неопределено Тогда
		ЦелеваяСумма = ЭтажФикс.ВысотаОтПола;
		НомерФикс = ЭтажФикс.НомерСтроки;

		Для НомерЭтажа = 1 По НомерФикс - 1 Цикл
			Данные = ДанныеЭтажей.Получить(НомерЭтажа);
			Если Данные = Неопределено Тогда Продолжить; КонецЕсли;

			Если Данные.Фикс Тогда
				МинСумма = МинСумма + Данные.ТекВысота + Данные.Зазор + Данные.ВысотаБалки;
			Иначе
				РекВысота = ?(Данные.Свойство("РекомендуемаяВысотаДоРаспределения"),
					Данные.РекомендуемаяВысотаДоРаспределения, Данные.ТекВысота);
				МинСумма = МинСумма + РекВысота + Данные.Зазор + Данные.ВысотаБалки;

				// Определяем получателя избытка
				Запас = РекВысота - Данные.maxH;
				Если Запас > МаксЗапас Тогда
					МаксЗапас = Запас;
					ЭтажПолучатель = НомерЭтажа;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		Избыток = ЦелеваяСумма - МинСумма;
	КонецЕсли;

	// --- ШАГ 5: ПРОХОД 2 — распределение избытка ---
	ДобавкаДляПолучателя = 0;
	Если Избыток > 0 И ЭтажПолучатель > 0 Тогда
		ДанныеПолучатель = ДанныеЭтажей.Получить(ЭтажПолучатель);
		НоваяВысота = ДанныеПолучатель.РекомендуемаяВысотаДоРаспределения + Избыток;
		ДобавкаДляПолучателя = Избыток;

		// Подобрать типоразмер из каталога
		ЗапросК2 = Новый Запрос;
		ЗапросК2.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лико_ТипоразмерыСкладскихСекций.Ссылка КАК Ссылка,
		|	Лико_ТипоразмерыСкладскихСекций.Высота КАК Высота
		|ИЗ
		|	Справочник.Лико_ТипоразмерыСкладскихСекций КАК Лико_ТипоразмерыСкладскихСекций
		|ГДЕ
		|	Лико_ТипоразмерыСкладскихСекций.Высота >= &МинВысота
		|	И Лико_ТипоразмерыСкладскихСекций.Ширина = &Ширина
		|	И Лико_ТипоразмерыСкладскихСекций.Глубина >= &Глубина
		|	И (Лико_ТипоразмерыСкладскихСекций.Вес >= &Вес
		|		ИЛИ Лико_ТипоразмерыСкладскихСекций.НеОграниченаПоГрузоподъемности)
		|УПОРЯДОЧИТЬ ПО
		|	Высота";
		ЗапросК2.УстановитьПараметр("МинВысота", НоваяВысота);
		ЗапросК2.УстановитьПараметр("Ширина", ДанныеПолучатель.ТекШирина);
		ЗапросК2.УстановитьПараметр("Глубина", ДанныеПолучатель.ТекГлубина);
		ЗапросК2.УстановитьПараметр("Вес", ДанныеПолучатель.ТекВес);
		ТЗК2 = ЗапросК2.Выполнить().Выгрузить();

		Если ТЗК2.Количество() > 0 Тогда
			ДанныеПолучатель.Вставить("ФинальныйТипоразмер", ТЗК2[0].Ссылка);
			ДанныеПолучатель.Вставить("ФинальнаяВысота", ТЗК2[0].Высота);
		КонецЕсли;
	КонецЕсли;

	// --- ШАГ 6: Формирование результата ---
	ФактСумма = 0;
	Совпадение = Истина;
	ОстатокРасхождения = 0;

	Для НомерЭтажа = 1 По МаксНомер Цикл
		Данные = ДанныеЭтажей.Получить(НомерЭтажа);
		Если Данные = Неопределено Тогда Продолжить; КонецЕсли;

		ЭтажСтруктура = Новый Структура;
		ЭтажСтруктура.Вставить("Этаж", НомерЭтажа);
		ЭтажСтруктура.Вставить("Паллетов", Данные.Паллетов);
		ЭтажСтруктура.Вставить("МаксВысотаПаллета", Данные.maxH);
		ЭтажСтруктура.Вставить("ПотериМм", Данные.ПотериМм);
		ЭтажСтруктура.Вставить("ПотериПроцент", Окр(Данные.ПотериПроцент, 1));
		ЭтажСтруктура.Вставить("Фиксирован", Данные.Фикс);

		Если Данные.Фикс Тогда
			ЭтажСтруктура.Вставить("ПричинаФиксации", "ВысотаОтПолаФиксирована");
			ЭтажСтруктура.Вставить("РекомендуемыйТипоразмер", Неопределено);
			ЭтажСтруктура.Вставить("РекомендуемаяВысотаДоРаспределения", 0);
			ЭтажСтруктура.Вставить("ДобавкаМм", 0);
		Иначе
			ЭтажСтруктура.Вставить("ПричинаФиксации", "");
			РекДо = ?(Данные.Свойство("РекомендуемаяВысотаДоРаспределения"),
				Данные.РекомендуемаяВысотаДоРаспределения, Данные.ТекВысота);
			ЭтажСтруктура.Вставить("РекомендуемаяВысотаДоРаспределения", РекДо);

			Если НомерЭтажа = ЭтажПолучатель И ДобавкаДляПолучателя > 0 Тогда
				ЭтажСтруктура.Вставить("ДобавкаМм", ДобавкаДляПолучателя);
				ЭтажСтруктура.Вставить("РекомендуемыйТипоразмер",
					?(Данные.Свойство("ФинальныйТипоразмер"), Данные.ФинальныйТипоразмер, Неопределено));
			Иначе
				ЭтажСтруктура.Вставить("ДобавкаМм", 0);
				ЭтажСтруктура.Вставить("РекомендуемыйТипоразмер",
					?(Данные.Свойство("РекомендуемыйТипоразмерДо"), Данные.РекомендуемыйТипоразмерДо, Неопределено));
			КонецЕсли;
		КонецЕсли;

		Floors.Добавить(ЭтажСтруктура);

		// Подсчёт фактической суммы
		ФинВысота = ?(Данные.Свойство("ФинальнаяВысота"), Данные.ФинальнаяВысота,
			?(Данные.Свойство("РекомендуемаяВысотаДоРаспределения"),
				Данные.РекомендуемаяВысотаДоРаспределения, Данные.ТекВысота));
		ФактСумма = ФактСумма + ФинВысота + Данные.Зазор + Данные.ВысотаБалки;
	КонецЦикла;

	// --- Summary ---
	Summary = Новый Структура;
	Summary.Вставить("ЦелеваяСуммаВысот", ЦелеваяСумма);
	Summary.Вставить("ФактическаяСуммаПослеПодбора", ФактСумма);

	Если ЭтажФикс <> Неопределено Тогда
		ОстатокРасхождения = ЦелеваяСумма - ФактСумма;
		Совпадение = (ОстатокРасхождения = 0);
	КонецЕсли;
	Summary.Вставить("Совпадение", Совпадение);
	Summary.Вставить("ОстатокРасхожденияМм", ОстатокРасхождения);
	Результат.Вставить("Summary", Summary);

	Возврат Результат;

КонецФункции

//+Лико m.shenderov 19.07.2026
Функция ПодобратьВысотыЭтажейДляСклада(Склад) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Подбор оптимальных высот этажей для ВСЕХ стеллажей склада.
	//   Берёт ВСЕ паллеты склада (стеллажи + пол), распределяет по этажам
	//   оптимально (без привязки к текущей заполненности), подбирает
	//   минимально достаточные типоразмеры с двухпроходной коррекцией.
	//
	//   VNA (Узкопроходный=Истина): паллеты Ширина <= 1200 И Глубина <= 1200.
	//   Широкопроходный (Узкопроходный=Ложь): любые паллеты.
	//
	// ПАРАМЕТРЫ:
	//   Склад — СправочникСсылка.Склады
	//
	// ВОЗВРАТ:
	//   Структура { Racks, WarehouseSummary }

	РезСтруктура = Новый Структура;
	РезСтруктура.Вставить("Racks", Новый Массив);
	ВсегоПаллетПослеОптимизации = 0; // счётчик для warehouse summary

	// =========================================================================
	// ШАГ 1: Загрузка всех стеллажей склада
	// =========================================================================
	ЗапросС = Новый Запрос;
	ЗапросС.Текст =
	"ВЫБРАТЬ
	|	Лико_Стеллажи.Ссылка КАК Стеллаж,
	|	Лико_Стеллажи.Наименование КАК Имя,
	|	Лико_Стеллажи.Узкопроходный КАК VNA,
	|	Лико_Стеллажи.КоличествоСекций КАК Секций,
	|	Лико_Стеллажи.МинШиринаПаллета КАК МинШ,
	|	Лико_Стеллажи.МаксШиринаПаллета КАК МаксШ,
	|	Лико_Стеллажи.МинГлубинаПаллета КАК МинГ,
	|	Лико_Стеллажи.МаксГлубинаПаллета КАК МаксГ
	|ИЗ
	|	Справочник.Лико_Стеллажи КАК Лико_Стеллажи
	|ГДЕ
	|	Лико_Стеллажи.Склад = &Склад";
	ЗапросС.УстановитьПараметр("Склад", Склад);
	ТЗСтеллажи = ЗапросС.Выполнить().Выгрузить();

	Если ТЗСтеллажи.Количество() = 0 Тогда
		Возврат РезСтруктура;
	КонецЕсли;

	// =========================================================================
	// ШАГ 2: Сбор ВСЕХ паллет склада (секции + пол) — один запрос
	// =========================================================================
	ЗапросП = Новый Запрос;
	ЗапросП.Текст =
	"ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Лико_ПаллетыВСекцияхОстатки.Паллет) КАК GUID,
	|	Лико_ПараметрыПаллет.Типоразмер.Высота КАК Высота,
	|	Лико_ПараметрыПаллет.Типоразмер.Ширина КАК Ширина,
	|	Лико_ПараметрыПаллет.Типоразмер.Глубина КАК Глубина,
	|	Лико_ПараметрыПаллет.Типоразмер.Вес КАК Вес
	|ИЗ
	|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки КАК Лико_ПаллетыВСекцияхОстатки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних КАК Лико_ПараметрыПаллет
	|	ПО Лико_ПаллетыВСекцияхОстатки.Паллет = Лико_ПараметрыПаллет.Паллет
	|ГДЕ
	|	Лико_ПаллетыВСекцияхОстатки.Секция.Склад = &Склад
	|	И НЕ Лико_ПаллетыВСекцияхОстатки.Секция = ЗНАЧЕНИЕ(Справочник.Лико_СкладскиеСекции.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Лико_ПаллетыВСекцияхОстатки.Паллет),
	|	Лико_ПараметрыПаллет.Типоразмер.Высота,
	|	Лико_ПараметрыПаллет.Типоразмер.Ширина,
	|	Лико_ПараметрыПаллет.Типоразмер.Глубина,
	|	Лико_ПараметрыПаллет.Типоразмер.Вес
	|ИЗ
	|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки КАК Лико_ПаллетыВСекцияхОстатки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних КАК Лико_ПараметрыПаллет
	|	ПО Лико_ПаллетыВСекцияхОстатки.Паллет = Лико_ПараметрыПаллет.Паллет
	|ГДЕ
	|	Лико_ПаллетыВСекцияхОстатки.Секция = ЗНАЧЕНИЕ(Справочник.Лико_СкладскиеСекции.ПустаяСсылка)
	|	И Лико_ПаллетыВСекцияхОстатки.Адрес.Владелец = &Склад";
	ЗапросП.УстановитьПараметр("Склад", Склад);
	ТЗВсеПаллеты = ЗапросП.Выполнить().Выгрузить();

	// --- Текущее размещение (для warehouse summary) ---
	ЗапросТек = Новый Запрос;
	ЗапросТек.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Лико_ПаллетыВСекцияхОстатки.Паллет) КАК Колво
	|ИЗ
	|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки КАК Лико_ПаллетыВСекцияхОстатки
	|ГДЕ
	|	Лико_ПаллетыВСекцияхОстатки.Секция.Склад = &Склад
	|	И НЕ Лико_ПаллетыВСекцияхОстатки.Секция = ЗНАЧЕНИЕ(Справочник.Лико_СкладскиеСекции.ПустаяСсылка)";
	ЗапросТек.УстановитьПараметр("Склад", Склад);
	ТЗТек = ЗапросТек.Выполнить().Выгрузить();
	ТекущееРазмещение = ТЗТек[0].Колво;
	ВсегоПаллетНаСкладе = ТЗВсеПаллеты.Количество();

	// =========================================================================
	// ШАГ 3: Разделение на VNA и Wide пулы + сортировка
	// =========================================================================
	VNA_Паллеты = Новый Массив;
	Wide_Паллеты = Новый Массив;

	Для Каждого П Из ТЗВсеПаллеты Цикл
		Если П.Ширина <= 1200 И П.Глубина <= 1200 Тогда
			VNA_Паллеты.Добавить(П);
		Иначе
			Wide_Паллеты.Добавить(П);
		КонецЕсли;
	КонецЦикла;

	// Сортировка: highest first, будет брать с конца (pop) — или идти с начала
	// Удобнее: сортируем по убыванию, берём с начала через индекс
	СортироватьПоВысоте(VNA_Паллеты);
	СортироватьПоВысоте(Wide_Паллеты);

	// =========================================================================
	// ШАГ 4: Обработка каждого стеллажа
	// =========================================================================
	Для Каждого СтрСтеллаж Из ТЗСтеллажи Цикл
		Стеллаж = СтрСтеллаж.Стеллаж;
		VNA = СтрСтеллаж.VNA;
		Этажи = Стеллаж.Этажи;
		Секций = СтрСтеллаж.Секций;
		Если Этажи.Количество() = 0 Тогда Продолжить; КонецЕсли;

		// --- Берём паллеты из нужного пула (совместимые, по высоте убыв.) ---
		ИсходныйПул = ?(VNA, VNA_Паллеты, Wide_Паллеты);
		Совместимые = Новый Массив;
		ИндексыНаУдаление = Новый Массив; // индексы в ИсходныйПул которые забрали

		Для idx = 0 По ИсходныйПул.Количество() - 1 Цикл
			П = ИсходныйПул[idx];
			Если (СтрСтеллаж.МинШ = 0 ИЛИ П.Ширина >= СтрСтеллаж.МинШ)
			   И (СтрСтеллаж.МаксШ = 0 ИЛИ П.Ширина <= СтрСтеллаж.МаксШ)
			   И (СтрСтеллаж.МинГ = 0 ИЛИ П.Глубина >= СтрСтеллаж.МинГ)
			   И (СтрСтеллаж.МаксГ = 0 ИЛИ П.Глубина <= СтрСтеллаж.МаксГ) Тогда
				Совместимые.Добавить(П);
				ИндексыНаУдаление.Добавить(idx);
			КонецЕсли;
		КонецЦикла;

		// --- Распределение паллет по этажам (снизу вверх) ---
		МаксНомер = Этажи.Количество();
		ЁмкостьЭтажа = Секций * 3;
		Поз = 0;
		ВсегоСовместимых = Совместимые.Количество();

		ДанныеЭтажей = Новый Соответствие; // НомерЭтажа -> Структура
		ЭтажФикс = Неопределено;

		Для Каждого СтрЭтаж Из Этажи Цикл
			НомерЭтажа = СтрЭтаж.НомерСтроки;
			Типоразмер = СтрЭтаж.Типоразмер;

			Если СтрЭтаж.ВысотаОтПолаФиксирована Тогда
				ЭтажФикс = СтрЭтаж;
				// Сохранить в ДанныеЭтажей (без паллет, для геометрии)
				ДанныеФ = Новый Структура;
				ДанныеФ.Вставить("Номер", НомерЭтажа);
				ДанныеФ.Вставить("ТекВысота", Типоразмер.Высота);
				ДанныеФ.Вставить("ТекШирина", Типоразмер.Ширина);
				ДанныеФ.Вставить("ТекГлубина", Типоразмер.Глубина);
				ДанныеФ.Вставить("ТекВес", Типоразмер.Вес);
				ДанныеФ.Вставить("БезлимВес", Типоразмер.НеОграниченаПоГрузоподъемности);
				ДанныеФ.Вставить("Зазор", СтрЭтаж.Зазор);
				ДанныеФ.Вставить("ВысотаБалки", СтрЭтаж.ВысотаБалки);
				ДанныеФ.Вставить("Фикс", Истина);
				ДанныеФ.Вставить("Паллетов", 0);
				ДанныеФ.Вставить("maxH", 0);
				ДанныеФ.Вставить("p90", 0);
				ДанныеФ.Вставить("ПотериМм", 0);
				ДанныеЭтажей.Вставить(НомерЭтажа, ДанныеФ);
				Продолжить;
			КонецЕсли;

			// Взять очередные ЁмкостьЭтажа паллет из Совместимые
			ВысотыЭтажа = Новый Массив;
			maxH = 0;
			КонецПоз = Мин(Поз + ЁмкостьЭтажа, ВсегоСовместимых);
			Пока Поз < КонецПоз Цикл
				ПаллетТек = Совместимые[Поз];
				ВысотыЭтажа.Добавить(ПаллетТек.Высота);
				Если ПаллетТек.Высота > maxH Тогда maxH = ПаллетТек.Высота; КонецЕсли;
				Поз = Поз + 1;
			КонецЦикла;

			// p90 (ВысотыЭтажа уже отсортированы по убыванию — копия из Совместимые)
			p90 = 0;
			Если ВысотыЭтажа.Количество() > 0 Тогда
				Индекс90 = Цел((ВысотыЭтажа.Количество() - 1) * 0.9);
				p90 = ВысотыЭтажа[Индекс90];
			КонецЕсли;

			ТекВысота = Типоразмер.Высота;
			ПотериМм = ?(ВысотыЭтажа.Количество() > 0, ТекВысота - maxH, 0);

			Данные = Новый Структура;
			Данные.Вставить("Номер", НомерЭтажа);
			Данные.Вставить("ТекВысота", ТекВысота);
			Данные.Вставить("ТекШирина", Типоразмер.Ширина);
			Данные.Вставить("ТекГлубина", Типоразмер.Глубина);
			Данные.Вставить("ТекВес", Типоразмер.Вес);
			Данные.Вставить("БезлимВес", Типоразмер.НеОграниченаПоГрузоподъемности);
			Данные.Вставить("Зазор", СтрЭтаж.Зазор);
			Данные.Вставить("ВысотаБалки", СтрЭтаж.ВысотаБалки);
			Данные.Вставить("Фикс", СтрЭтаж.ВысотаОтПолаФиксирована);
			Данные.Вставить("Паллетов", ВысотыЭтажа.Количество());
			Данные.Вставить("maxH", maxH);
			Данные.Вставить("p90", p90);
			Данные.Вставить("ПотериМм", ПотериМм);

			ДанныеЭтажей.Вставить(НомерЭтажа, Данные);
		КонецЦикла;

		// =====================================================================
		// ПРОХОД 1: Подбор минимально достаточных типоразмеров
		// =====================================================================
		Для НомерЭтажа = 1 По МаксНомер Цикл
			Данные = ДанныеЭтажей.Получить(НомерЭтажа);
			Если Данные = Неопределено ИЛИ Данные.Фикс Тогда Продолжить; КонецЕсли;

			// Если паллетов нет — оставляем текущую высоту
			Если Данные.Паллетов = 0 Тогда
				Данные.Вставить("РекомендуемаяВысотаДоРаспределения", Данные.ТекВысота);
				Данные.Вставить("РекомендуемыйТипоразмерДо", Неопределено);
				Продолжить;
			КонецЕсли;

			МинДостаточно = ?(Данные.p90 > 0, Данные.p90, Данные.maxH);
			Если МинДостаточно < Данные.maxH Тогда
				МинДостаточно = Данные.maxH;
			КонецЕсли;

			ЗапросК = Новый Запрос;
			ЗапросК.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Лико_ТипоразмерыСкладскихСекций.Ссылка КАК Ссылка,
			|	Лико_ТипоразмерыСкладскихСекций.Высота КАК Высота
			|ИЗ
			|	Справочник.Лико_ТипоразмерыСкладскихСекций КАК Лико_ТипоразмерыСкладскихСекций
			|ГДЕ
			|	Лико_ТипоразмерыСкладскихСекций.Высота >= &МинВысота
			|	И Лико_ТипоразмерыСкладскихСекций.Ширина = &Ширина
			|	И Лико_ТипоразмерыСкладскихСекций.Глубина >= &Глубина
			|	И (Лико_ТипоразмерыСкладскихСекций.Вес >= &Вес
			|		ИЛИ Лико_ТипоразмерыСкладскихСекций.НеОграниченаПоГрузоподъемности)
			|УПОРЯДОЧИТЬ ПО
			|	Высота";
			ЗапросК.УстановитьПараметр("МинВысота", МинДостаточно);
			ЗапросК.УстановитьПараметр("Ширина", Данные.ТекШирина);
			ЗапросК.УстановитьПараметр("Глубина", Данные.ТекГлубина);
			ЗапросК.УстановитьПараметр("Вес", Данные.ТекВес);
			ТЗК = ЗапросК.Выполнить().Выгрузить();

			Если ТЗК.Количество() > 0 Тогда
				Данные.Вставить("РекомендуемаяВысотаДоРаспределения", ТЗК[0].Высота);
				Данные.Вставить("РекомендуемыйТипоразмерДо", ТЗК[0].Ссылка);
			Иначе
				Данные.Вставить("РекомендуемаяВысотаДоРаспределения", Данные.ТекВысота);
				Данные.Вставить("РекомендуемыйТипоразмерДо", Неопределено);
			КонецЕсли;
		КонецЦикла;

		// =====================================================================
		// ПРОХОД 2: Геометрическое ограничение + распределение избытка
		// =====================================================================
		МинСумма = 0;
		ЭтажПолучатель = 0;
		МаксЗапас = -1;
		Избыток = 0;
		ЦелеваяСумма = 0;
		НомерФикс = 0;

		// Если нет явно зафиксированного этажа — используем последний как якорь
		Если ЭтажФикс = Неопределено Тогда
			// Найти последний этаж
			ПоследнийЭтаж = Неопределено;
			Для Каждого СтрЭтаж Из Этажи Цикл
				ПоследнийЭтаж = СтрЭтаж;
			КонецЦикла;
			Если ПоследнийЭтаж <> Неопределено И ПоследнийЭтаж.ВысотаОтПола > 0 Тогда
				ЭтажФикс = ПоследнийЭтаж;
			КонецЕсли;
		КонецЕсли;

		Если ЭтажФикс <> Неопределено Тогда
			ЦелеваяСумма = ЭтажФикс.ВысотаОтПола;
			НомерФикс = ЭтажФикс.НомерСтроки;

			// Если последний этаж авто-определён как якорь (без явного флага),
			// помечаем его как фиксированный чтобы не менять высоту
			ДанныеФикс = ДанныеЭтажей.Получить(НомерФикс);
			Если ДанныеФикс <> Неопределено И НЕ ДанныеФикс.Фикс Тогда
				ДанныеФикс.Фикс = Истина;
			КонецЕсли;

			Для НомерЭтажа = 1 По НомерФикс - 1 Цикл
				Данные = ДанныеЭтажей.Получить(НомерЭтажа);
				Если Данные = Неопределено Тогда Продолжить; КонецЕсли;

				Если Данные.Фикс Тогда
					МинСумма = МинСумма + Данные.ТекВысота + Данные.Зазор + Данные.ВысотаБалки;
				Иначе
					// Пустой этаж не занимает места
					Если Данные.Паллетов = 0 Тогда
						Продолжить;
					КонецЕсли;
					РекВысота = ?(Данные.Свойство("РекомендуемаяВысотаДоРаспределения"),
						Данные.РекомендуемаяВысотаДоРаспределения, Данные.ТекВысота);
					МинСумма = МинСумма + РекВысота + Данные.Зазор + Данные.ВысотаБалки;

					Запас = РекВысота - Данные.maxH;
					Если Запас > МаксЗапас Тогда
						МаксЗапас = Запас;
						ЭтажПолучатель = НомерЭтажа;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;

			Избыток = ЦелеваяСумма - МинСумма;
		КонецЕсли;

		// Распределение избытка одному этажу-получателю
		ДобавкаДляПолучателя = 0;
		Если Избыток > 0 И ЭтажПолучатель > 0 Тогда
			ДанныеПолучатель = ДанныеЭтажей.Получить(ЭтажПолучатель);
			НоваяВысота = ДанныеПолучатель.РекомендуемаяВысотаДоРаспределения + Избыток;
			ДобавкаДляПолучателя = Избыток;

			ЗапросК2 = Новый Запрос;
			ЗапросК2.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Лико_ТипоразмерыСкладскихСекций.Ссылка КАК Ссылка,
			|	Лико_ТипоразмерыСкладскихСекций.Высота КАК Высота
			|ИЗ
			|	Справочник.Лико_ТипоразмерыСкладскихСекций КАК Лико_ТипоразмерыСкладскихСекций
			|ГДЕ
			|	Лико_ТипоразмерыСкладскихСекций.Высота >= &МинВысота
			|	И Лико_ТипоразмерыСкладскихСекций.Ширина = &Ширина
			|	И Лико_ТипоразмерыСкладскихСекций.Глубина >= &Глубина
			|	И (Лико_ТипоразмерыСкладскихСекций.Вес >= &Вес
			|		ИЛИ Лико_ТипоразмерыСкладскихСекций.НеОграниченаПоГрузоподъемности)
			|УПОРЯДОЧИТЬ ПО
			|	Высота";
			ЗапросК2.УстановитьПараметр("МинВысота", НоваяВысота);
			ЗапросК2.УстановитьПараметр("Ширина", ДанныеПолучатель.ТекШирина);
			ЗапросК2.УстановитьПараметр("Глубина", ДанныеПолучатель.ТекГлубина);
			ЗапросК2.УстановитьПараметр("Вес", ДанныеПолучатель.ТекВес);
			ТЗК2 = ЗапросК2.Выполнить().Выгрузить();

			Если ТЗК2.Количество() > 0 Тогда
				ДанныеПолучатель.Вставить("ФинальныйТипоразмер", ТЗК2[0].Ссылка);
				ДанныеПолучатель.Вставить("ФинальнаяВысота", ТЗК2[0].Высота);
			КонецЕсли;
		КонецЕсли;

		// =====================================================================
		// СЖАТИЕ: уменьшаем общее Поз и ПЕРЕРАСПРЕДЕЛЯЕМ по этажам
		// =====================================================================
		Если Избыток < 0 И НомерФикс > 0 Тогда
			Пока Избыток < 0 И Поз > 0 Цикл
				// Убираем одну секцию (3 паллета) из общего количества
				Поз = Поз - Мин(ЁмкостьЭтажа, Поз);

				// Перераспределить оставшиеся паллеты по этажам
				Осталось = Поз;
				Для НЭ = 1 По НомерФикс - 1 Цикл
					Д = ДанныеЭтажей.Получить(НЭ);
					Если Д = Неопределено ИЛИ Д.Фикс Тогда Продолжить; КонецЕсли;

					Старт = (НЭ - 1) * ЁмкостьЭтажа;
					НовоеКолво = Мин(ЁмкостьЭтажа, Осталось);
					Если НовоеКолво < 0 Тогда НовоеКолво = 0; КонецЕсли;

					Д.Паллетов = НовоеКолво;
					Осталось = Осталось - НовоеКолво;

					Если НовоеКолво = 0 Тогда
						Д.maxH = 0;
						Д.p90 = 0;
						Д.Вставить("РекомендуемаяВысотаДоРаспределения", Д.ТекВысота);
						Д.Вставить("РекомендуемыйТипоразмерДо", Неопределено);
					Иначе
						Д.maxH = Совместимые[Старт].Высота;
						НовИндекс90 = Старт + Цел((НовоеКолво - 1) * 0.9);
						Д.p90 = Совместимые[НовИндекс90].Высота;

						МинДост = Д.p90;
						Если МинДост < Д.maxH Тогда МинДост = Д.maxH; КонецЕсли;

						ЗапросСж = Новый Запрос;
						ЗапросСж.Текст =
						"ВЫБРАТЬ ПЕРВЫЕ 1
						|	Лико_ТипоразмерыСкладскихСекций.Ссылка КАК Ссылка,
						|	Лико_ТипоразмерыСкладскихСекций.Высота КАК Высота
						|ИЗ
						|	Справочник.Лико_ТипоразмерыСкладскихСекций КАК Лико_ТипоразмерыСкладскихСекций
						|ГДЕ
						|	Лико_ТипоразмерыСкладскихСекций.Высота >= &МинВысота
						|	И Лико_ТипоразмерыСкладскихСекций.Ширина = &Ширина
						|	И Лико_ТипоразмерыСкладскихСекций.Глубина >= &Глубина
						|	И (Лико_ТипоразмерыСкладскихСекций.Вес >= &Вес
						|		ИЛИ Лико_ТипоразмерыСкладскихСекций.НеОграниченаПоГрузоподъемности)
						|УПОРЯДОЧИТЬ ПО Высота";
						ЗапросСж.УстановитьПараметр("МинВысота", МинДост);
						ЗапросСж.УстановитьПараметр("Ширина", Д.ТекШирина);
						ЗапросСж.УстановитьПараметр("Глубина", Д.ТекГлубина);
						ЗапросСж.УстановитьПараметр("Вес", Д.ТекВес);
						ТЗСж = ЗапросСж.Выполнить().Выгрузить();
						Если ТЗСж.Количество() > 0 Тогда
							Д.Вставить("РекомендуемаяВысотаДоРаспределения", ТЗСж[0].Высота);
							Д.Вставить("РекомендуемыйТипоразмерДо", ТЗСж[0].Ссылка);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;

				// Пересчитать МинСумма и получателя избытка
				МинСумма = 0;
				ЭтажПолучатель = 0;
				МаксЗапас = -1;
				Для НЭ = 1 По НомерФикс - 1 Цикл
					Д = ДанныеЭтажей.Получить(НЭ);
					Если Д = Неопределено Тогда Продолжить; КонецЕсли;
					Если Д.Фикс Тогда
						МинСумма = МинСумма + Д.ТекВысота + Д.Зазор + Д.ВысотаБалки;
					Иначе
						Если Д.Паллетов = 0 Тогда Продолжить; КонецЕсли;
						РВ = ?(Д.Свойство("РекомендуемаяВысотаДоРаспределения"), Д.РекомендуемаяВысотаДоРаспределения, Д.ТекВысота);
						МинСумма = МинСумма + РВ + Д.Зазор + Д.ВысотаБалки;
						Запас = РВ - Д.maxH;
						Если Запас > МаксЗапас Тогда
							МаксЗапас = Запас;
							ЭтажПолучатель = НЭ;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				Избыток = ЦелеваяСумма - МинСумма;
			КонецЦикла;
		КонецЕсли;

		// =====================================================================
		// Формирование результата
		// =====================================================================
		РезультатСтеллажа = Новый Структура;
		РезультатСтеллажа.Вставить("Стеллаж", Стеллаж);
		РезультатСтеллажа.Вставить("Имя", СтрСтеллаж.Имя);
		РезультатСтеллажа.Вставить("VNA", VNA);
		РезультатСтеллажа.Вставить("Floors", Новый Массив);

		ФактСумма = 0;
		Совпадение = Истина;
		ОстатокРасхождения = 0;

		Для НомерЭтажа = 1 По МаксНомер Цикл
			Данные = ДанныеЭтажей.Получить(НомерЭтажа);
			Если Данные = Неопределено Тогда Продолжить; КонецЕсли;

			ЭтажРез = Новый Структура;
			ЭтажРез.Вставить("Этаж", НомерЭтажа);
			ЭтажРез.Вставить("Паллетов", Данные.Паллетов);
			ЭтажРез.Вставить("МаксВысотаПаллета", Данные.maxH);
			ЭтажРез.Вставить("ТекущаяВысота", Данные.ТекВысота);
			ЭтажРез.Вставить("ПотериМм", Данные.ПотериМм);
			ЭтажРез.Вставить("Фиксирован", Данные.Фикс);

			Если Данные.Фикс Тогда
				ЭтажРез.Вставить("РекомендуемаяВысота", 0);
				ЭтажРез.Вставить("РекомендуемыйТипоразмер", Неопределено);
				ЭтажРез.Вставить("ДобавкаМм", 0);
				ФинВысота = Данные.ТекВысота;
			Иначе
				РекДо = ?(Данные.Свойство("РекомендуемаяВысотаДоРаспределения"),
					Данные.РекомендуемаяВысотаДоРаспределения, Данные.ТекВысота);

				Если НомерЭтажа = ЭтажПолучатель И ДобавкаДляПолучателя > 0 Тогда
					ЭтажРез.Вставить("РекомендуемаяВысота",
						?(Данные.Свойство("ФинальнаяВысота"), Данные.ФинальнаяВысота, РекДо));
					ЭтажРез.Вставить("РекомендуемыйТипоразмер",
						?(Данные.Свойство("ФинальныйТипоразмер"), Данные.ФинальныйТипоразмер, Неопределено));
					ЭтажРез.Вставить("ДобавкаМм", ДобавкаДляПолучателя);
					ФинВысота = ?(Данные.Свойство("ФинальнаяВысота"), Данные.ФинальнаяВысота, РекДо);
				Иначе
					ЭтажРез.Вставить("РекомендуемаяВысота", РекДо);
					ЭтажРез.Вставить("РекомендуемыйТипоразмер",
						?(Данные.Свойство("РекомендуемыйТипоразмерДо"), Данные.РекомендуемыйТипоразмерДо, Неопределено));
					ЭтажРез.Вставить("ДобавкаМм", 0);
					ФинВысота = РекДо;
				КонецЕсли;
			КонецЕсли;

			РезультатСтеллажа.Floors.Добавить(ЭтажРез);
			// Пустые нефикс. этажи не входят в сумму
			Если Данные.Фикс ИЛИ Данные.Паллетов > 0 Тогда
				ФактСумма = ФактСумма + ФинВысота + Данные.Зазор + Данные.ВысотаБалки;
			КонецЕсли;
		КонецЦикла;

		// Summary
		Summary = Новый Структура;
		Summary.Вставить("ЦелеваяСуммаВысот", ЦелеваяСумма);
		Summary.Вставить("ФактическаяСуммаПослеПодбора", ФактСумма);

		Если ЭтажФикс <> Неопределено Тогда
			ОстатокРасхождения = ЦелеваяСумма - ФактСумма;
			Совпадение = (ОстатокРасхождения = 0);
		КонецЕсли;
		Summary.Вставить("Совпадение", Совпадение);
		Summary.Вставить("ОстатокРасхожденияМм", ОстатокРасхождения);

		// Предупреждение если минимальная сумма превышает целевую
		Если Избыток < 0 Тогда
			Summary.Вставить("Ошибка", "Невозможно подобрать высоты: минимальная сумма превышает ВысотаОтПола фиксированного этажа на " + Строка(-Избыток) + " мм");
		Иначе
			Summary.Вставить("Ошибка", "");
		КонецЕсли;

		РезультатСтеллажа.Вставить("Summary", Summary);
		РезСтруктура.Racks.Добавить(РезультатСтеллажа);

		// Счётчик размещённых паллет
		ВсегоПаллетПослеОптимизации = ВсегоПаллетПослеОптимизации + Поз;

		// Удалить только ИСПОЛЬЗОВАННЫЕ паллеты (первые Поз из Совместимые)
		Для i = 0 По Поз - 1 Цикл
			Если i >= ИндексыНаУдаление.Количество() Тогда Прервать; КонецЕсли;
			// Удаляем с конца среди первых Поз (чтобы индексы не сдвигались)
			РеальныйИндекс = ИндексыНаУдаление[Поз - 1 - i];
			ИсходныйПул.Удалить(РеальныйИндекс);
		КонецЦикла;
	КонецЦикла;

	// =========================================================================
	// Warehouse Summary
	// =========================================================================
	WarehouseSummary = Новый Структура;
	WarehouseSummary.Вставить("ВсегоПаллетНаСкладе", ВсегоПаллетНаСкладе);
	WarehouseSummary.Вставить("РазмещаетсяСейчас", ТекущееРазмещение);
	WarehouseSummary.Вставить("РазмещаетсяПослеОптимизации", ВсегоПаллетПослеОптимизации);
	Прирост = ВсегоПаллетПослеОптимизации - ТекущееРазмещение;
	WarehouseSummary.Вставить("Прирост", Прирост);
	WarehouseSummary.Вставить("ПриростПроцент", ?(ТекущееРазмещение > 0, Окр(Прирост / ТекущееРазмещение * 100, 1), 0));

	РезСтруктура.Вставить("WarehouseSummary", WarehouseSummary);

	Возврат РезСтруктура;

КонецФункции

// Хелпер: пузырьковая сортировка массива структур по полю Высота (убывание)
Процедура СортироватьПоВысоте(МассивПаллет)
	Для ii = 0 По МассивПаллет.Количество() - 2 Цикл
		Для jj = ii + 1 По МассивПаллет.Количество() - 1 Цикл
			Если МассивПаллет[ii].Высота < МассивПаллет[jj].Высота Тогда
				Вр = МассивПаллет[ii]; МассивПаллет[ii] = МассивПаллет[jj]; МассивПаллет[jj] = Вр;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

//+Лико m.shenderov 21.07.2026
Функция СобратьВерсииСекций(СкладСсылка)

	// НАЗНАЧЕНИЕ:
	//   Собирает версии всех секций склада для контроля актуальности snapshot'а (§15 ТЗ WMS Optimizer).
	//
	// ПАРАМЕТРЫ:
	//   СкладСсылка — СправочникСсылка.Склады
	//
	// ВОЗВРАТ:
	//   Соответствие { "секция_guid": версия_число }
	//
	// ПРИМЕЧАНИЕ:
	//   Версия секции инкрементируется при изменении критичных полей:
	//   - Типоразмер (ширина/высота/глубина/вес)
	//   - ЗапретРазмещения
	//   - МаксимальныйВесПодъёмаНаЭтаж
	//   - ЗазорПоШирине

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Секции.Ссылка) КАК СекцияGUID,
	|	Секции.Версия КАК Версия
	|ИЗ
	|	Справочник.Лико_СкладскиеСекции КАК Секции
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_Стеллажи КАК Стеллажи
	|		ПО Секции.Стеллаж = Стеллажи.Ссылка
	|ГДЕ
	|	Стеллажи.Склад = &Склад
	|	И НЕ Секции.ПометкаУдаления";

	Запрос.УстановитьПараметр("Склад", СкладСсылка);

	ТЗ = Запрос.Выполнить().Выгрузить();

	// Конвертируем в Соответствие для быстрого доступа по GUID
	Результат = Новый Соответствие;
	Для Каждого Строка Из ТЗ Цикл
		Результат.Вставить(Строка(Строка.СекцияGUID), Строка.Версия);
	КонецЦикла;

	Возврат Результат;

КонецФункции

//+Лико m.shenderov 21.07.2026
// Конвертирует Соответствие {guid: version} → Массив [{section, version}] для HTTP-ответа.
// Обратная операция к тому, что делает WMS_PlacePallets при получении versions.
// Причина: GUID-ключи с дефисами ломают ПрочитатьJSON(ЧтениеJSON) без флага Истина.
Функция _ВерсииСоответствиеВМассив(СоответствиеВерсий)

	Результат = Новый Массив;
	Для Каждого Пара Из СоответствиеВерсий Цикл
		Элемент = Новый Структура("section, version", Пара.Ключ, Пара.Значение);
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

//+Лико m.shenderov 21.07.2026
Функция WMS_PlacePallets(ПараметрыPOST) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Пакетное размещение паллет по плану от WMS Optimizer (Python).
	//   Валидирует версии секций (optimistic locking §15 ТЗ) ПЕРЕД выполнением.
	//   Если версия хотя бы одной затронутой секции изменилась — возвращает
	//   PLAN_INVALID, план считается устаревшим и требует пересчёта.
	//
	// ПАРАМЕТРЫ:
	//   ПараметрыPOST.warehouse       — GUID склада
	//   ПараметрыPOST.placements      — Массив {pallet, address, section?}
	//   ПараметрыPOST.rearrangements  — Массив {pallet, fromAddress, toAddress}
	//   ПараметрыPOST.versions        — Массив [{section: guid, version: N}]  (НЕ объект — GUID-ключи ломают ПрочитатьJSON)
	//
	//   address/fromAddress/toAddress — GUID ячейки ИЛИ код ячейки (occupancy отдаёт
	//   address1/2/3 как код, не GUID) — резолвятся через ЯчейкаПоСтрокеАдреса()
	//
	// ВОЗВРАТ:
	//   { ok, executed, warnings } — при успехе
	//   { ok: false, error: {code: "PLAN_INVALID", ...} } — если snapshot устарел

	// --- Валидация параметров ---
	Если НЕ ПараметрыPOST.Свойство("warehouse") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM", "Не передан параметр 'warehouse'");
	КонецЕсли;
	Если НЕ ПараметрыPOST.Свойство("placements") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM", "Не передан параметр 'placements'");
	КонецЕсли;
	Если НЕ ПараметрыPOST.Свойство("rearrangements") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM", "Не передан параметр 'rearrangements'");
	КонецЕсли;
	Если НЕ ПараметрыPOST.Свойство("versions") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM", "Не передан параметр 'versions' (snapshot versions)");
	КонецЕсли;

	СкладGUID = ПараметрыPOST.warehouse;
	Склад = СсылкаПоСтрокеGUID(СкладGUID, "Справочник.Склады");
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат HttpВернутьОшибку_WMS("INVALID_PARAM", "Склад не найден");
	КонецЕсли;

	МассивPlacements = ПараметрыPOST.placements;
	МассивRearrangements = ПараметрыPOST.rearrangements;
	// Конвертируем массив [{section, version}] → Соответствие для быстрого поиска по GUID
	// (объект-карта с GUID-ключами ломает ПрочитатьJSON без флага Истина)
	МассивВерсий = ПараметрыPOST.versions;
	ВерсииПлана = Новый Соответствие;
	Для Каждого Э Из МассивВерсий Цикл
		ВерсииПлана.Вставить(Э.section, Э.version);
	КонецЦикла;

	// --- Извлекаем все секции, затронутые планом ---
	ЗатронутыеСекции = Новый Соответствие; // section_guid -> Истина

	Для Каждого ЭлементМассива Из МассивPlacements Цикл
		Если ЭлементМассива.Свойство("section") И ЗначениеЗаполнено(ЭлементМассива.section) Тогда
			ЗатронутыеСекции.Вставить(ЭлементМассива.section, Истина);
		КонецЕсли;
	КонецЦикла;

	// Rearrangements: надо найти секции по fromAddress и toAddress
	// Для упрощения — соберём все адреса и запросом определим их секции
	МассивАдресовGUID = Новый Массив;
	Для Каждого R Из МассивRearrangements Цикл
		Если R.Свойство("fromAddress") Тогда МассивАдресовGUID.Добавить(R.fromAddress); КонецЕсли;
		Если R.Свойство("toAddress") Тогда МассивАдресовGUID.Добавить(R.toAddress); КонецЕсли;
	КонецЦикла;

	Если МассивАдресовGUID.Количество() > 0 Тогда
		// Запрос: адрес -> секция
		ЗапросАдреса = Новый Запрос;
		ЗапросАдреса.Текст =
		"ВЫБРАТЬ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СкладскиеЯчейки.Ссылка) КАК АдресGUID,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Секции.Ссылка) КАК СекцияGUID
		|ИЗ
		|	Справочник.СкладскиеЯчейки КАК СкладскиеЯчейки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_СкладскиеСекции КАК Секции
		|		ПО (СкладскиеЯчейки.Ссылка = Секции.Адрес1
		|			ИЛИ СкладскиеЯчейки.Ссылка = Секции.Адрес2
		|			ИЛИ СкладскиеЯчейки.Ссылка = Секции.Адрес3)
		|ГДЕ
		|	СкладскиеЯчейки.Ссылка В (&МассивАдресов)";

		// Конвертируем строки адресов в ссылки (GUID или код ячейки)
		МассивАдресовСсылки = Новый Массив;
		Для Каждого АдрGUID Из МассивАдресовGUID Цикл
			АдрСсылка = ЯчейкаПоСтрокеАдреса(АдрGUID);
			Если ЗначениеЗаполнено(АдрСсылка) Тогда
				МассивАдресовСсылки.Добавить(АдрСсылка);
			КонецЕсли;
		КонецЦикла;

		ЗапросАдреса.УстановитьПараметр("МассивАдресов", МассивАдресовСсылки);
		ТЗАдреса = ЗапросАдреса.Выполнить().Выгрузить();

		Для Каждого Стр Из ТЗАдреса Цикл
			Если ЗначениеЗаполнено(Стр.СекцияGUID) Тогда
				ЗатронутыеСекции.Вставить(Стр.СекцияGUID, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// --- Получаем текущие версии затронутых секций ---
	ТекущиеВерсии = СобратьВерсииСекций(Склад);

	// --- Валидация версий (§15 ТЗ) ---
	КонфликтыВерсий = Новый Массив;

	Для Каждого КлючСекция Из ЗатронутыеСекции Цикл
		СекцияGUID = КлючСекция.Ключ;

		ВерсияПлана = ВерсииПлана.Получить(СекцияGUID);
		ВерсияТекущая = ТекущиеВерсии.Получить(СекцияGUID);

		Если ВерсияПлана = Неопределено Тогда
			// План не содержит версии для этой секции — подозрительно, но пропускаем
			Продолжить;
		КонецЕсли;

		Если ВерсияТекущая = Неопределено Тогда
			// Секция удалена или не найдена
			Конфликт = Новый Структура;
			Конфликт.Вставить("section", СекцияGUID);
			Конфликт.Вставить("expectedVersion", ВерсияПлана);
			Конфликт.Вставить("actualVersion", Null);
			Конфликт.Вставить("reason", "Секция не найдена или удалена");
			КонфликтыВерсий.Добавить(Конфликт);
			Продолжить;
		КонецЕсли;

		Если ВерсияПлана <> ВерсияТекущая Тогда
			Конфликт = Новый Структура;
			Конфликт.Вставить("section", СекцияGUID);
			Конфликт.Вставить("expectedVersion", ВерсияПлана);
			Конфликт.Вставить("actualVersion", ВерсияТекущая);
			Конфликт.Вставить("reason", "Версия изменилась с момента snapshot'а");
			КонфликтыВерсий.Добавить(Конфликт);
		КонецЕсли;
	КонецЦикла;

	Если КонфликтыВерсий.Количество() > 0 Тогда
		// План устарел — возвращаем PLAN_INVALID
		СтруктураОшибка = Новый Структура;
		СтруктураОшибка.Вставить("code", "PLAN_INVALID");
		СтруктураОшибка.Вставить("message",
			"План устарел: версии " + Строка(КонфликтыВерсий.Количество()) + " секций изменились с момента snapshot'а");
		СтруктураОшибка.Вставить("conflicts", КонфликтыВерсий);

		СтруктураОтвет = Новый Структура;
		СтруктураОтвет.Вставить("ok", Ложь);
		СтруктураОтвет.Вставить("error", СтруктураОшибка);

		Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));
	КонецЕсли;

	// --- Валидация прошла — выполняем план ---
	ВыполненныеПеремещения = Новый Массив;
	Warnings = Новый Массив;

	// ШАГ 1: Rearrangements (освобождаем адреса)
	Для Каждого R Из МассивRearrangements Цикл
		Попытка
			ПаллетGUID = R.pallet;
			ОткудаGUID = R.fromAddress;
			КудаGUID = R.toAddress;

			Паллет = СсылкаПоСтрокеGUID(ПаллетGUID, "Справочник.Лико_Паллеты2_0");
			ЯчейкаОткуда = ЯчейкаПоСтрокеАдреса(ОткудаGUID);
			ЯчейкаКуда = ЯчейкаПоСтрокеАдреса(КудаGUID);

			Если НЕ ЗначениеЗаполнено(Паллет) ИЛИ НЕ ЗначениеЗаполнено(ЯчейкаКуда) Тогда
				Warn = Новый Структура;
				Warn.Вставить("step", "rearrangement");
				Warn.Вставить("pallet", ПаллетGUID);
				Warn.Вставить("message", "Паллет или ячейка не найдены");
				Warnings.Добавить(Warn);
				Продолжить;
			КонецЕсли;

			// Валидация через ОшибкиРазмещенияПаллетаВАдрес
			Ошибки = Справочники.Лико_СкладскиеСекции.ОшибкиРазмещенияПаллетаВАдрес(ЯчейкаКуда, Паллет);
			Если Ошибки.Количество() > 0 Тогда
				Warn = Новый Структура;
				Warn.Вставить("step", "rearrangement");
				Warn.Вставить("pallet", ПаллетGUID);
				Warn.Вставить("validationErrors", Ошибки);
				Warnings.Добавить(Warn);
				Продолжить;
			КонецЕсли;

			// Создаём документ перемещения
			Док = Документы.Лико_ПеремещениеПаллета2_0.СоздатьПеремещение(Паллет, ЯчейкаКуда);

			Результ = Новый Структура;
			Результ.Вставить("type", "rearrangement");
			Результ.Вставить("pallet", ПаллетGUID);
			Результ.Вставить("fromAddress", ОткудаGUID);
			Результ.Вставить("toAddress", КудаGUID);
			Результ.Вставить("document", Строка(Док.УникальныйИдентификатор()));
			ВыполненныеПеремещения.Добавить(Результ);

		Исключение
			Warn = Новый Структура;
			Warn.Вставить("step", "rearrangement");
			Warn.Вставить("pallet", ПаллетGUID);
			Warn.Вставить("message", ОписаниеОшибки());
			Warnings.Добавить(Warn);
		КонецПопытки;
	КонецЦикла;

	// ШАГ 2: Placements (размещаем паллеты)
	Для Каждого P Из МассивPlacements Цикл
		Попытка
			ПаллетGUID = P.pallet;
			АдресGUID = P.address;

			Паллет = СсылкаПоСтрокеGUID(ПаллетGUID, "Справочник.Лико_Паллеты2_0");
			Ячейка = ЯчейкаПоСтрокеАдреса(АдресGUID);

			Если НЕ ЗначениеЗаполнено(Паллет) ИЛИ НЕ ЗначениеЗаполнено(Ячейка) Тогда
				Warn = Новый Структура;
				Warn.Вставить("step", "placement");
				Warn.Вставить("pallet", ПаллетGUID);
				Warn.Вставить("message", "Паллет или ячейка не найдены");
				Warnings.Добавить(Warn);
				Продолжить;
			КонецЕсли;

			// Валидация
			Ошибки = Справочники.Лико_СкладскиеСекции.ОшибкиРазмещенияПаллетаВАдрес(Ячейка, Паллет);
			Если Ошибки.Количество() > 0 Тогда
				Warn = Новый Структура;
				Warn.Вставить("step", "placement");
				Warn.Вставить("pallet", ПаллетGUID);
				Warn.Вставить("validationErrors", Ошибки);
				Warnings.Добавить(Warn);
				Продолжить;
			КонецЕсли;

			// Создаём документ перемещения
			Док = Документы.Лико_ПеремещениеПаллета2_0.СоздатьПеремещение(Паллет, Ячейка);

			Результ = Новый Структура;
			Результ.Вставить("type", "placement");
			Результ.Вставить("pallet", ПаллетGUID);
			Результ.Вставить("address", АдресGUID);
			Результ.Вставить("document", Строка(Док.УникальныйИдентификатор()));
			ВыполненныеПеремещения.Добавить(Результ);

		Исключение
			Warn = Новый Структура;
			Warn.Вставить("step", "placement");
			Warn.Вставить("pallet", ПаллетGUID);
			Warn.Вставить("message", ОписаниеОшибки());
			Warnings.Добавить(Warn);
		КонецПопытки;
	КонецЦикла;

	// --- Формируем ответ ---
	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ok", Истина);
	СтруктураОтвет.Вставить("executed", ВыполненныеПеремещения);
	СтруктураОтвет.Вставить("warnings", Warnings);
	СтруктураОтвет.Вставить("totalExecuted", ВыполненныеПеремещения.Количество());
	СтруктураОтвет.Вставить("totalWarnings", Warnings.Количество());

	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));

КонецФункции


#КонецОбласти
