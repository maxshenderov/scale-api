Функция WMS_CheckConnection(ПараметрыPOST) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Проверка доступности WMS API. Возвращает версию модуля и timestamp.
	//   Используется веб-приложением для health-check при старте.
	//
	// ПАРАМЕТРЫ:
	//   ПараметрыPOST — Структура (не используется, но требуется сигнатурой Liko_Rest).
	//
	// ВОЗВРАТ:
	//   HTTP-ответ 200 с JSON: { ok: true, version: "1.0.0", timestamp: "..." }

	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ok", Истина);
	СтруктураОтвет.Вставить("version", "1.0.0");
	СтруктураОтвет.Вставить("timestamp", ТекущаяДата());

	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));

КонецФункции

Функция ЦветСтеллажа(НомерСтеллажа)

	// Фиксированная палитра из 9 цветов для стеллажей 1-9
	Цвета = Новый Соответствие;
	Цвета.Вставить(1, "#E8C98A");  // светло-жёлтый
	Цвета.Вставить(2, "#A8D8B9");  // светло-зелёный
	Цвета.Вставить(3, "#B8D4E3");  // светло-голубой
	Цвета.Вставить(4, "#F0C8C8");  // светло-розовый
	Цвета.Вставить(5, "#D5C4E1");  // светло-фиолетовый
	Цвета.Вставить(6, "#F5DEB3");  // светло-пшеничный
	Цвета.Вставить(7, "#C8E6E6");  // светло-циан
	Цвета.Вставить(8, "#E8D5B7");  // светло-коричневый
	Цвета.Вставить(9, "#D4E4C8");  // светло-оливковый

	Если Цвета.Получить(НомерСтеллажа) <> Неопределено Тогда
		Возврат Цвета.Получить(НомерСтеллажа);
	КонецЕсли;

	Возврат "#CCCCCC";  // серый для стеллажей >9

КонецФункции

Функция WMS_GetWarehouses(ПараметрыPOST) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Возвращает список складов, для которых есть хотя бы один стеллаж
	//   (Справочник.Лико_Стеллажи). Используется веб-приложением для
	//   выпадающего списка выбора склада.
	//
	// ВОЗВРАТ:
	//   { warehouses: [{ id, name, code }] }

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Склады.Ссылка) КАК id,
	|	Склады.Наименование КАК name,
	|	Склады.Наименование КАК code
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	Склады.Лико_ИспользоватьЗаданияНаОтборРазмещение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склады.Наименование";

	ТЗ = Запрос.Выполнить().Выгрузить();

	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ok", Истина);
	СтруктураОтвет.Вставить("warehouses", Лико_HTTP_Сервер.ТзВМассивСтруктур(ТЗ));
	
	
	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));

КонецФункции

Функция WMS_GetRacks(ПараметрыPOST) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Возвращает полную топологию всех стеллажей склада: этажи, типоразмеры,
	//   физические ограничения. Эти данные НЕ меняются при движении паллет —
	//   можно кэшировать на стороне веб-приложения (TTL 1 час).
	//
	// ПАРАМЕТРЫ:
	//   warehouse — строка, GUID склада (ключ в ПараметрыPOST).
	//
	// ВОЗВРАТ:
	//   { racks: [...] } — полная топология стеллажей с этажами.

	// --- Валидация параметров ---
	Если НЕ ПараметрыPOST.Свойство("warehouse") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM", "Не передан параметр 'warehouse'");
	КонецЕсли;

	Склад = СсылкаПоСтрокеGUID(ПараметрыPOST.warehouse, "Справочник.Склады");
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат HttpВернутьОшибку_WMS("INVALID_PARAM", "Склад не найден по GUID '" + ПараметрыPOST.warehouse + "'");
	КонецЕсли;

	Данные = СобратьТопологиюСклада(Склад);
	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ok", Истина);
	СтруктураОтвет.Вставить("racks", Данные.Стеллажи);

	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));

КонецФункции // WMS_GetRacks

Функция СобратьАдрес(Ячейка, Паллет, ТипоразмерПаллета)

	СтруктураАдрес = Новый Структура;
	СтруктураАдрес.Вставить("address", Строка(Ячейка.УникальныйИдентификатор()));
	СтруктураАдрес.Вставить("addressCode", Ячейка.Код);

	Если ЗначениеЗаполнено(Паллет) Тогда
		СтруктураАдрес.Вставить("pallet", Строка(Паллет.УникальныйИдентификатор()));
		СтруктураАдрес.Вставить("palletCode", Паллет.Код);
		СтруктураАдрес.Вставить("width", ТипоразмерПаллета.Ширина);
		СтруктураАдрес.Вставить("height", ТипоразмерПаллета.Высота);
		СтруктураАдрес.Вставить("depth", ТипоразмерПаллета.Глубина);
		СтруктураАдрес.Вставить("weight", ТипоразмерПаллета.Вес);
	Иначе
		СтруктураАдрес.Вставить("pallet", Null);
		СтруктураАдрес.Вставить("palletCode", Null);
		СтруктураАдрес.Вставить("width", Null);
		СтруктураАдрес.Вставить("height", Null);
		СтруктураАдрес.Вставить("depth", Null);
		СтруктураАдрес.Вставить("weight", Null);
	КонецЕсли;

	Возврат СтруктураАдрес;

КонецФункции

Функция ЗанятостьАдреса(Паллет)

	Если ЗначениеЗаполнено(Паллет) Тогда
		Возврат 1;
	КонецЕсли;
	Возврат 0;

КонецФункции

