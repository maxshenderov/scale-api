Функция СобратьТопологиюСклада(СкладСсылка)

	// Возвращает структуру { Склад, Стеллажи } — топология без HTTP-обёртки.
	// Используется WMS_GetRacks и WMS_ExportSnapshot.

	// Склад
	СтруктураСклад = Новый Структура;
	СтруктураСклад.Вставить("id", Строка(СкладСсылка.УникальныйИдентификатор()));
	СтруктураСклад.Вставить("name", СкладСсылка.Наименование);
	СтруктураСклад.Вставить("code", СкладСсылка.Код);

	// Запрос стеллажей
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лико_Стеллажи.Ссылка КАК id,
	|	Лико_Стеллажи.Наименование КАК name,
	|	Лико_Стеллажи.Код КАК code,
	|	Лико_Стеллажи.НомерСтеллажа КАК number,
	|	Лико_Стеллажи.Узкопроходный КАК narrowAisle,
	|	Лико_Стеллажи.МинШиринаПаллета КАК minPalletWidth,
	|	Лико_Стеллажи.МаксШиринаПаллета КАК maxPalletWidth,
	|	Лико_Стеллажи.МинГлубинаПаллета КАК minPalletDepth,
	|	Лико_Стеллажи.МаксГлубинаПаллета КАК maxPalletDepth,
	|	Лико_Стеллажи.КоличествоСекций КАК sectionsCount,
	|	3 КАК cellsPerSection,
	|	Лико_Стеллажи.КоличествоЗонПриёмки КАК floorZonesCount
	|ПОМЕСТИТЬ ВТ_СтеллажиТопо
	|ИЗ
	|	Справочник.Лико_Стеллажи КАК Лико_Стеллажи
	|ГДЕ
	|	Лико_Стеллажи.Склад = &Склад
	|
	|УПОРЯДОЧИТЬ ПО
	|	Лико_Стеллажи.НомерСтеллажа";

	Запрос.УстановитьПараметр("Склад", СкладСсылка);
	ТЗ_Стеллажи = Запрос.Выполнить().Выгрузить();

	// Собираем стеллажи с этажами
	МассивСтеллажей = Новый Массив;

	Для Каждого СтрокаСтеллаж Из ТЗ_Стеллажи Цикл
		СтеллажСсылка = СтрокаСтеллаж.id;

		СтруктураСтеллаж = Новый Структура;
		СтруктураСтеллаж.Вставить("id", Строка(СтеллажСсылка.УникальныйИдентификатор()));
		СтруктураСтеллаж.Вставить("name", СтрокаСтеллаж.name);
		СтруктураСтеллаж.Вставить("code", СтрокаСтеллаж.code);
		СтруктураСтеллаж.Вставить("number", СтрокаСтеллаж.number);
		СтруктураСтеллаж.Вставить("narrowAisle", СтрокаСтеллаж.narrowAisle);
		СтруктураСтеллаж.Вставить("color", ЦветСтеллажа(СтрокаСтеллаж.number));
		СтруктураСтеллаж.Вставить("minPalletWidth", СтрокаСтеллаж.minPalletWidth);
		СтруктураСтеллаж.Вставить("maxPalletWidth", СтрокаСтеллаж.maxPalletWidth);
		СтруктураСтеллаж.Вставить("minPalletDepth", СтрокаСтеллаж.minPalletDepth);
		СтруктураСтеллаж.Вставить("maxPalletDepth", СтрокаСтеллаж.maxPalletDepth);
		СтруктураСтеллаж.Вставить("sectionsCount", СтрокаСтеллаж.sectionsCount);
		СтруктураСтеллаж.Вставить("cellsPerSection", 3);
		СтруктураСтеллаж.Вставить("floorZonesCount", СтрокаСтеллаж.floorZonesCount);

		// Этажи стеллажа (из ТЧ)
		МассивЭтажей = Новый Массив;
		СтеллажОбъект = СтеллажСсылка.ПолучитьОбъект();

		Для Каждого СтрокаЭтаж Из СтеллажОбъект.Этажи Цикл

			Типоразмер = СтрокаЭтаж.Типоразмер;
			СтруктураТипоразмер = Новый Структура;
			Если ЗначениеЗаполнено(Типоразмер) Тогда
				СтруктураТипоразмер.Вставить("id", Строка(Типоразмер.УникальныйИдентификатор()));
				СтруктураТипоразмер.Вставить("height", Типоразмер.Габарит.Высота);
				СтруктураТипоразмер.Вставить("width", Типоразмер.Габарит.Ширина);
				СтруктураТипоразмер.Вставить("depth", Типоразмер.Габарит.Глубина);
				СтруктураТипоразмер.Вставить("weight", Типоразмер.Грузоподъемность);
				СтруктураТипоразмер.Вставить("unlimitedWeight", Типоразмер.НеОграниченаПоГрузоподъемности);
			Иначе
				СтруктураТипоразмер.Вставить("id", "");
				СтруктураТипоразмер.Вставить("height", 0);
				СтруктураТипоразмер.Вставить("width", 0);
				СтруктураТипоразмер.Вставить("depth", 0);
				СтруктураТипоразмер.Вставить("weight", 0);
				СтруктураТипоразмер.Вставить("unlimitedWeight", Ложь);
			КонецЕсли;

			СтруктураЭтаж = Новый Структура;
			СтруктураЭтаж.Вставить("number", СтрокаЭтаж.НомерСтроки);
			СтруктураЭтаж.Вставить("typeSize", СтруктураТипоразмер);
			СтруктураЭтаж.Вставить("minDepthUnlimited", СтрокаЭтаж.МинимальнаяГлубинаНеОграничена);
			СтруктураЭтаж.Вставить("maxDepthUnlimited", СтрокаЭтаж.МаксимальнаяГлубинаНеОграничена);
			СтруктураЭтаж.Вставить("maxLiftWeight", СтрокаЭтаж.МаксимальныйВесПодъёмаНаЭтаж);
			СтруктураЭтаж.Вставить("heightClearance", СтрокаЭтаж.Зазор);
			СтруктураЭтаж.Вставить("beamHeight", СтрокаЭтаж.ВысотаБалки);
			СтруктураЭтаж.Вставить("heightFromFloor", СтрокаЭтаж.ВысотаОтПола);
			СтруктураЭтаж.Вставить("heightFromFloorFixed", СтрокаЭтаж.ВысотаОтПолаФиксирована);
			СтруктураЭтаж.Вставить("widthClearance", СтрокаЭтаж.ЗазорПоШирине);

			МассивЭтажей.Добавить(СтруктураЭтаж);
		КонецЦикла;

		СтруктураСтеллаж.Вставить("floors", МассивЭтажей);
		МассивСтеллажей.Добавить(СтруктураСтеллаж);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Склад", СтруктураСклад);
	Результат.Вставить("Стеллажи", МассивСтеллажей);

	Возврат Результат;

КонецФункции

Функция СобратьЗанятостьСекций(СкладСсылка)

	// Возвращает структуру { Секции, Сводка } — занятость без HTTP-обёртки.
	// Используется WMS_GetOccupancy, WMS_ExportSnapshot и WMS_PlacePallets.

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Лико_СкладскиеСекции.Ссылка КАК Секция,
	|	Лико_СкладскиеСекции.Код КАК КодСекции,
	|	Лико_СкладскиеСекции.Стеллаж КАК Стеллаж,
	|	Лико_СкладскиеСекции.Этаж КАК Этаж,
	|	Лико_СкладскиеСекции.УровеньДоступа КАК УровеньДоступа,
	|	Лико_СкладскиеСекции.ЗапретРазмещения КАК ЗапретРазмещения,
	|	Лико_СкладскиеСекции.Типоразмер КАК Типоразмер,
	|	Лико_СкладскиеСекции.Адрес1 КАК Адрес1,
	|	Лико_СкладскиеСекции.Адрес2 КАК Адрес2,
	|	Лико_СкладскиеСекции.Адрес3 КАК Адрес3,
	|	Лико_СкладскиеСекции.Стеллаж.НомерСтеллажа КАК НомерСтеллажа,
	|	Лико_СкладскиеСекции.Стеллаж.Узкопроходный КАК Узкопроходный,
	|	ЕСТЬNULL(Остатки1.Паллет, ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)) КАК Паллет1,
	|	ЕСТЬNULL(Параметры1.Типоразмер, ЗНАЧЕНИЕ(Справочник.Лико_ТипоразмерыПаллет.ПустаяСсылка)) КАК ТипоразмерПаллета1,
	|	ЕСТЬNULL(Остатки2.Паллет, ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)) КАК Паллет2,
	|	ЕСТЬNULL(Параметры2.Типоразмер, ЗНАЧЕНИЕ(Справочник.Лико_ТипоразмерыПаллет.ПустаяСсылка)) КАК ТипоразмерПаллета2,
	|	ЕСТЬNULL(Остатки3.Паллет, ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)) КАК Паллет3,
	|	ЕСТЬNULL(Параметры3.Типоразмер, ЗНАЧЕНИЕ(Справочник.Лико_ТипоразмерыПаллет.ПустаяСсылка)) КАК ТипоразмерПаллета3
	|ИЗ
	|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
	|		&МоментВремени,
	|		Адрес = &Адрес1_Параметр) КАК Остатки1
	|	ПО Лико_СкладскиеСекции.Адрес1 = Остатки1.Адрес
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(&МоментВремени) КАК Параметры1
	|	ПО Остатки1.Паллет = Параметры1.Паллет
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
	|		&МоментВремени,
	|		Адрес = &Адрес2_Параметр) КАК Остатки2
	|	ПО Лико_СкладскиеСекции.Адрес2 = Остатки2.Адрес
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(&МоментВремени) КАК Параметры2
	|	ПО Остатки2.Паллет = Параметры2.Паллет
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
	|		&МоментВремени,
	|		Адрес = &Адрес3_Параметр) КАК Остатки3
	|	ПО Лико_СкладскиеСекции.Адрес3 = Остатки3.Адрес
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(&МоментВремени) КАК Параметры3
	|	ПО Остатки3.Паллет = Параметры3.Паллет
	|ГДЕ
	|	Лико_СкладскиеСекции.Склад = &Склад
	|
	|УПОРЯДОЧИТЬ ПО
	|	Лико_СкладскиеСекции.Стеллаж.НомерСтеллажа,
	|	Лико_СкладскиеСекции.Этаж,
	|	Лико_СкладскиеСекции.Ряд,
	|	Лико_СкладскиеСекции.Место";

	Момент = Новый Граница(ТекущаяДата(), ВидГраницы.Включая);
	Запрос.УстановитьПараметр("МоментВремени", Момент);
	Запрос.УстановитьПараметр("Склад", СкладСсылка);
	Запрос.УстановитьПараметр("Адрес1_Параметр", Перечисления.Лико_АдресаСекций.Адрес1);
	Запрос.УстановитьПараметр("Адрес2_Параметр", Перечисления.Лико_АдресаСекций.Адрес2);
	Запрос.УстановитьПараметр("Адрес3_Параметр", Перечисления.Лико_АдресаСекций.Адрес3);

	ТЗ = Запрос.Выполнить().Выгрузить();

	// Сборка
	МассивСекций = Новый Массив;
	ВсегоАдресов = 0;
	ЗанятоАдресов = 0;

	Для Каждого Стр Из ТЗ Цикл

		Адреса = Новый Массив;
		Адреса.Добавить(СобратьАдрес(Стр.Адрес1, Стр.Паллет1, Стр.ТипоразмерПаллета1));
		Адреса.Добавить(СобратьАдрес(Стр.Адрес2, Стр.Паллет2, Стр.ТипоразмерПаллета2));
		Адреса.Добавить(СобратьАдрес(Стр.Адрес3, Стр.Паллет3, Стр.ТипоразмерПаллета3));

		ТипоразмерСекции = Стр.Типоразмер;
		СтруктураТС = Новый Структура;
		СтруктураТС.Вставить("width", ТипоразмерСекции.Габарит.Ширина);
		СтруктураТС.Вставить("height", ТипоразмерСекции.Габарит.Высота);
		СтруктураТС.Вставить("depth", ТипоразмерСекции.Габарит.Глубина);
		СтруктураТС.Вставить("weight", ТипоразмерСекции.Грузоподъемность);
		СтруктураТС.Вставить("unlimitedWeight", ТипоразмерСекции.НеОграниченаПоГрузоподъемности);

		СтруктураСекция = Новый Структура;
		СтруктураСекция.Вставить("id", Строка(Стр.Секция.УникальныйИдентификатор()));
		СтруктураСекция.Вставить("code", Стр.КодСекции);
		СтруктураСекция.Вставить("rack", Строка(Стр.Стеллаж.УникальныйИдентификатор()));
		СтруктураСекция.Вставить("floor", Стр.Этаж);
		СтруктураСекция.Вставить("accessLevel", Стр.УровеньДоступа);
		СтруктураСекция.Вставить("restricted", Стр.ЗапретРазмещения);
		СтруктураСекция.Вставить("typeSize", СтруктураТС);
		СтруктураСекция.Вставить("addresses", Адреса);

		МассивСекций.Добавить(СтруктураСекция);

		ВсегоАдресов = ВсегоАдресов + 3;
		ЗанятоАдресов = ЗанятоАдресов + ЗанятостьАдреса(Стр.Паллет1)
		                                + ЗанятостьАдреса(Стр.Паллет2)
		                                + ЗанятостьАдреса(Стр.Паллет3);
	КонецЦикла;

	СвободноАдресов = ВсегоАдресов - ЗанятоАдресов;
	Процент = 0;
	Если ВсегоАдресов > 0 Тогда
		Процент = Окр(ЗанятоАдресов / ВсегоАдресов * 100, 1);
	КонецЕсли;

	Сводка = Новый Структура;
	Сводка.Вставить("totalSections", МассивСекций.Количество());
	Сводка.Вставить("totalAddresses", ВсегоАдресов);
	Сводка.Вставить("occupiedAddresses", ЗанятоАдресов);
	Сводка.Вставить("freeAddresses", СвободноАдресов);
	Сводка.Вставить("occupancyPercent", Процент);

	Результат = Новый Структура;
	Результат.Вставить("Секции", МассивСекций);
	Результат.Вставить("Сводка", Сводка);

	Возврат Результат;

КонецФункции

Функция СобратьПаллетыНаПолу(СкладСсылка)

	// Возвращает структуру { Паллеты } — паллеты на полу без HTTP-обёртки.
	// Используется WMS_GetFloor и WMS_ExportSnapshot.

	Момент = Новый Граница(ТекущаяДата(), ВидГраницы.Включая);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Лико_ЗоныПриёмки.Стеллаж КАК Стеллаж,
	|	Лико_ЗоныПриёмки.СкладскаяЯчейка КАК АдресПриёмки,
	|	ОстаткиПриёмка.Паллет КАК Паллет,
	|	Параметры.Типоразмер КАК ТипоразмерПаллета
	|ПОМЕСТИТЬ ВТ_ПриёмкаУСтеллажейФлор
	|ИЗ
	|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(&Момент, Склад = &Склад) КАК ОстаткиПриёмка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_Стеллажи.Лико_ЗоныПриёмки КАК Лико_ЗоныПриёмки
	|	ПО ОстаткиПриёмка.Адрес = Лико_ЗоныПриёмки.СкладскаяЯчейка
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(&Момент) КАК Параметры
	|	ПО ОстаткиПриёмка.Паллет = Параметры.Паллет
	|
	|ОБЪЕДИНИТЬ ВСЁ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.Лико_Стеллажи.ПустаяСсылка) КАК Стеллаж,
	|	ОстаткиПриёмка.Адрес КАК АдресПриёмки,
	|	ОстаткиПриёмка.Паллет,
	|	Параметры.Типоразмер
	|ИЗ
	|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(&Момент, Склад = &Склад) КАК ОстаткиПриёмка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_Стеллажи.Лико_ЗоныПриёмки КАК Лико_ЗоныПриёмки
	|	ПО ОстаткиПриёмка.Адрес = Лико_ЗоныПриёмки.СкладскаяЯчейка
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(&Момент) КАК Параметры
	|	ПО ОстаткиПриёмка.Паллет = Параметры.Паллет
	|ГДЕ
	|	Лико_ЗоныПриёмки.СкладскаяЯчейка = ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПриёмкаУСтеллажейФлор.Стеллаж КАК rack,
	|	ВТ_ПриёмкаУСтеллажейФлор.АдресПриёмки КАК address,
	|	ВТ_ПриёмкаУСтеллажейФлор.АдресПриёмки.Код КАК code,
	|	ВТ_ПриёмкаУСтеллажейФлор.Паллет.УникальныйИдентификатор КАК PalletID,
	|	ВТ_ПриёмкаУСтеллажейФлор.Паллет.Код КАК PalletCode,
	|	ВТ_ПриёмкаУСтеллажейФлор.ТипоразмерПаллета.Габарит.Ширина КАК PalletWidth,
	|	ВТ_ПриёмкаУСтеллажейФлор.ТипоразмерПаллета.Габарит.Высота КАК PalletHeight,
	|	ВТ_ПриёмкаУСтеллажейФлор.ТипоразмерПаллета.Габарит.Глубина КАК PalletDepth,
	|	ВТ_ПриёмкаУСтеллажейФлор.ТипоразмерПаллета.Вес КАК PalletWeight
	|ИЗ
	|	ВТ_ПриёмкаУСтеллажейФлор КАК ВТ_ПриёмкаУСтеллажейФлор
	|ГДЕ
	|	ВТ_ПриёмкаУСтеллажейФлор.Паллет <> ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)";

	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Склад", СкладСсылка);

	ТЗ = Запрос.Выполнить().Выгрузить();

	МассивПаллетов = Новый Массив;

	Для Каждого Стр Из ТЗ Цикл
		СтруктураПаллет = Новый Структура;
		СтруктураПаллет.Вставить("id", Строка(Стр.PalletID));
		СтруктураПаллет.Вставить("code", Стр.PalletCode);
		СтруктураПаллет.Вставить("width", Стр.PalletWidth);
		СтруктураПаллет.Вставить("height", Стр.PalletHeight);
		СтруктураПаллет.Вставить("depth", Стр.PalletDepth);
		СтруктураПаллет.Вставить("weight", Стр.PalletWeight);

		СтруктураСтрока = Новый Структура;
		СтруктураСтрока.Вставить("rack",
			?(ЗначениеЗаполнено(Стр.rack),
			  Строка(Стр.rack.УникальныйИдентификатор()),
			  Null));
		СтруктураСтрока.Вставить("address", Строка(Стр.address.УникальныйИдентификатор()));
		СтруктураСтрока.Вставить("code", Стр.code);
		СтруктураСтрока.Вставить("pallet", СтруктураПаллет);

		МассивПаллетов.Добавить(СтруктураСтрока);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Паллеты", МассивПаллетов);

	Возврат Результат;

КонецФункции

Функция WMS_ExportSnapshot(ПараметрыPOST) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Экспортирует ВСЕ данные склада одним вызовом: топологию + занятость + пол.
	//   Результат — автономный JSON для работы веб-приложения без 1С.
	//
	// ПАРАМЕТРЫ:
	//   warehouse — GUID склада.

	Если НЕ ПараметрыPOST.Свойство("warehouse") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM", "Не передан параметр 'warehouse'");
	КонецЕсли;

	// Валидация склада
	СкладСсылка = СсылкаПоСтрокеGUID(ПараметрыPOST.warehouse, "Справочник.Склады");
	Если НЕ ЗначениеЗаполнено(СкладСсылка) Тогда
		Возврат HttpВернутьОшибку_WMS("INVALID_PARAM", "Склад не найден");
	КонецЕсли;

	// Собираем все три компонента через внутренние хелперы
	ДанныеСклада = СобратьТопологиюСклада(СкладСсылка);
	ДанныеЗанятости = СобратьЗанятостьСекций(СкладСсылка);
	ДанныеПола = СобратьПаллетыНаПолу(СкладСсылка);

	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ok", Истина);
	СтруктураОтвет.Вставить("exportedAt", ТекущаяДата());
	СтруктураОтвет.Вставить("warehouse", ДанныеСклада.Склад);
	СтруктураОтвет.Вставить("racks", ДанныеСклада.Стеллажи);
	СтруктураОтвет.Вставить("sections", ДанныеЗанятости.Секции);
	СтруктураОтвет.Вставить("floorPallets", ДанныеПола.Паллеты);
	СтруктураОтвет.Вставить("summary", ДанныеЗанятости.Сводка);

	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));

КонецФункции

#КонецОбласти
