Функция СобратьТопологиюСклада(СкладСсылка)

	// Возвращает структуру { Склад, Стеллажи } — топология без HTTP-обёртки.
	// Используется WMS_GetRacks и WMS_ExportSnapshot.

	// Склад
	СтруктураСклад = Новый Структура;
	СтруктураСклад.Вставить("id", Строка(СкладСсылка.УникальныйИдентификатор()));
	СтруктураСклад.Вставить("name", СкладСсылка.Наименование);
	СтруктураСклад.Вставить("code", СкладСсылка.Код);

	// Запрос стеллажей
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лико_Стеллажи.Ссылка КАК id,
	|	Лико_Стеллажи.Наименование КАК name,
	|	Лико_Стеллажи.Код КАК code,
	|	Лико_Стеллажи.НомерСтеллажа КАК number,
	|	Лико_Стеллажи.Узкопроходный КАК narrowAisle,
	|	Лико_Стеллажи.МинШиринаПаллета КАК minPalletWidth,
	|	Лико_Стеллажи.МаксШиринаПаллета КАК maxPalletWidth,
	|	Лико_Стеллажи.МинГлубинаПаллета КАК minPalletDepth,
	|	Лико_Стеллажи.МаксГлубинаПаллета КАК maxPalletDepth,
	|	Лико_Стеллажи.КоличествоСекций КАК sectionsCount,
	|	3 КАК cellsPerSection,
	|	Лико_Стеллажи.КоличествоЗонПриёмки КАК floorZonesCount
	|ПОМЕСТИТЬ ВТ_СтеллажиТопо
	|ИЗ
	|	Справочник.Лико_Стеллажи КАК Лико_Стеллажи
	|ГДЕ
	|	Лико_Стеллажи.Склад = &Склад
	|
	|УПОРЯДОЧИТЬ ПО
	|	Лико_Стеллажи.НомерСтеллажа";

	Запрос.УстановитьПараметр("Склад", СкладСсылка);
	ТЗ_Стеллажи = Запрос.Выполнить().Выгрузить();

	// Собираем стеллажи с этажами
	МассивСтеллажей = Новый Массив;

	Для Каждого СтрокаСтеллаж Из ТЗ_Стеллажи Цикл
		СтеллажСсылка = СтрокаСтеллаж.id;

		СтруктураСтеллаж = Новый Структура;
		СтруктураСтеллаж.Вставить("id", Строка(СтеллажСсылка.УникальныйИдентификатор()));
		СтруктураСтеллаж.Вставить("name", СтрокаСтеллаж.name);
		СтруктураСтеллаж.Вставить("code", СтрокаСтеллаж.code);
		СтруктураСтеллаж.Вставить("number", СтрокаСтеллаж.number);
		СтруктураСтеллаж.Вставить("narrowAisle", СтрокаСтеллаж.narrowAisle);
		СтруктураСтеллаж.Вставить("color", ЦветСтеллажа(СтрокаСтеллаж.number));
		СтруктураСтеллаж.Вставить("minPalletWidth", СтрокаСтеллаж.minPalletWidth);
		СтруктураСтеллаж.Вставить("maxPalletWidth", СтрокаСтеллаж.maxPalletWidth);
		СтруктураСтеллаж.Вставить("minPalletDepth", СтрокаСтеллаж.minPalletDepth);
		СтруктураСтеллаж.Вставить("maxPalletDepth", СтрокаСтеллаж.maxPalletDepth);
		СтруктураСтеллаж.Вставить("sectionsCount", СтрокаСтеллаж.sectionsCount);
		СтруктураСтеллаж.Вставить("cellsPerSection", 3);
		СтруктураСтеллаж.Вставить("floorZonesCount", СтрокаСтеллаж.floorZonesCount);

		// Этажи стеллажа (из ТЧ)
		МассивЭтажей = Новый Массив;
		СтеллажОбъект = СтеллажСсылка.ПолучитьОбъект();

		Для Каждого СтрокаЭтаж Из СтеллажОбъект.Этажи Цикл

			Типоразмер = СтрокаЭтаж.Типоразмер;
			СтруктураТипоразмер = Новый Структура;
			Если ЗначениеЗаполнено(Типоразмер) Тогда
				СтруктураТипоразмер.Вставить("id", Строка(Типоразмер.УникальныйИдентификатор()));
				СтруктураТипоразмер.Вставить("height", Типоразмер.Габарит.Высота);
				СтруктураТипоразмер.Вставить("width", Типоразмер.Габарит.Ширина);
				СтруктураТипоразмер.Вставить("depth", Типоразмер.Габарит.Глубина);
				СтруктураТипоразмер.Вставить("weight", Типоразмер.Грузоподъемность);
				СтруктураТипоразмер.Вставить("unlimitedWeight", Типоразмер.НеОграниченаПоГрузоподъемности);
			Иначе
				СтруктураТипоразмер.Вставить("id", "");
				СтруктураТипоразмер.Вставить("height", 0);
				СтруктураТипоразмер.Вставить("width", 0);
				СтруктураТипоразмер.Вставить("depth", 0);
				СтруктураТипоразмер.Вставить("weight", 0);
				СтруктураТипоразмер.Вставить("unlimitedWeight", Ложь);
			КонецЕсли;

			СтруктураЭтаж = Новый Структура;
			СтруктураЭтаж.Вставить("number", СтрокаЭтаж.НомерСтроки);
			СтруктураЭтаж.Вставить("typeSize", СтруктураТипоразмер);
			СтруктураЭтаж.Вставить("minDepthUnlimited", СтрокаЭтаж.МинимальнаяГлубинаНеОграничена);
			СтруктураЭтаж.Вставить("maxDepthUnlimited", СтрокаЭтаж.МаксимальнаяГлубинаНеОграничена);
			СтруктураЭтаж.Вставить("maxLiftWeight", СтрокаЭтаж.МаксимальныйВесПодъёмаНаЭтаж);
			СтруктураЭтаж.Вставить("heightClearance", СтрокаЭтаж.Зазор);
			СтруктураЭтаж.Вставить("beamHeight", СтрокаЭтаж.ВысотаБалки);
			СтруктураЭтаж.Вставить("heightFromFloor", СтрокаЭтаж.ВысотаОтПола);
			СтруктураЭтаж.Вставить("heightFromFloorFixed", СтрокаЭтаж.ВысотаОтПолаФиксирована);
			СтруктураЭтаж.Вставить("widthClearance", СтрокаЭтаж.ЗазорПоШирине);

			МассивЭтажей.Добавить(СтруктураЭтаж);
		КонецЦикла;

		СтруктураСтеллаж.Вставить("floors", МассивЭтажей);
		МассивСтеллажей.Добавить(СтруктураСтеллаж);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Склад", СтруктураСклад);
	Результат.Вставить("Стеллажи", МассивСтеллажей);

	Возврат Результат;

КонецФункции

Функция СобратьЗанятостьСекций(СкладСсылка)

	// Возвращает структуру { Секции, Сводка } — занятость без HTTP-обёртки.
	// Используется WMS_GetOccupancy, WMS_ExportSnapshot и WMS_PlacePallets.

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Лико_СкладскиеСекции.Ссылка КАК Секция,
	|	Лико_СкладскиеСекции.Код КАК КодСекции,
	|	Лико_СкладскиеСекции.Стеллаж КАК Стеллаж,
	|	Лико_СкладскиеСекции.Этаж КАК Этаж,
	|	Лико_СкладскиеСекции.УровеньДоступа КАК УровеньДоступа,
	|	Лико_СкладскиеСекции.ЗапретРазмещения КАК ЗапретРазмещения,
	|	Лико_СкладскиеСекции.Типоразмер КАК Типоразмер,
	|	Лико_СкладскиеСекции.Адрес1 КАК Адрес1,
	|	Лико_СкладскиеСекции.Адрес2 КАК Адрес2,
	|	Лико_СкладскиеСекции.Адрес3 КАК Адрес3,
	|	Лико_СкладскиеСекции.Стеллаж.НомерСтеллажа КАК НомерСтеллажа,
	|	Лико_СкладскиеСекции.Стеллаж.Узкопроходный КАК Узкопроходный,
	|	ЕСТЬNULL(Остатки1.Паллет, ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)) КАК Паллет1,
	|	ЕСТЬNULL(Параметры1.Типоразмер, ЗНАЧЕНИЕ(Справочник.Лико_ТипоразмерыПаллет.ПустаяСсылка)) КАК ТипоразмерПаллета1,
	|	ЕСТЬNULL(Остатки2.Паллет, ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)) КАК Паллет2,
	|	ЕСТЬNULL(Параметры2.Типоразмер, ЗНАЧЕНИЕ(Справочник.Лико_ТипоразмерыПаллет.ПустаяСсылка)) КАК ТипоразмерПаллета2,
	|	ЕСТЬNULL(Остатки3.Паллет, ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)) КАК Паллет3,
	|	ЕСТЬNULL(Параметры3.Типоразмер, ЗНАЧЕНИЕ(Справочник.Лико_ТипоразмерыПаллет.ПустаяСсылка)) КАК ТипоразмерПаллета3
	|ИЗ
	|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
	|		&МоментВремени,
	|		Адрес = &Адрес1_Параметр) КАК Остатки1
	|	ПО Лико_СкладскиеСекции.Адрес1 = Остатки1.Адрес
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(&МоментВремени) КАК Параметры1
	|	ПО Остатки1.Паллет = Параметры1.Паллет
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
	|		&МоментВремени,
	|		Адрес = &Адрес2_Параметр) КАК Остатки2
	|	ПО Лико_СкладскиеСекции.Адрес2 = Остатки2.Адрес
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(&МоментВремени) КАК Параметры2
	|	ПО Остатки2.Паллет = Параметры2.Паллет
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
	|		&МоментВремени,
	|		Адрес = &Адрес3_Параметр) КАК Остатки3
	|	ПО Лико_СкладскиеСекции.Адрес3 = Остатки3.Адрес
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(&МоментВремени) КАК Параметры3
	|	ПО Остатки3.Паллет = Параметры3.Паллет
	|ГДЕ
	|	Лико_СкладскиеСекции.Склад = &Склад
	|
	|УПОРЯДОЧИТЬ ПО
	|	Лико_СкладскиеСекции.Стеллаж.НомерСтеллажа,
	|	Лико_СкладскиеСекции.Этаж,
	|	Лико_СкладскиеСекции.Ряд,
	|	Лико_СкладскиеСекции.Место";

	Момент = Новый Граница(ТекущаяДата(), ВидГраницы.Включая);
	Запрос.УстановитьПараметр("МоментВремени", Момент);
	Запрос.УстановитьПараметр("Склад", СкладСсылка);
	Запрос.УстановитьПараметр("Адрес1_Параметр", Перечисления.Лико_АдресаСекций.Адрес1);
	Запрос.УстановитьПараметр("Адрес2_Параметр", Перечисления.Лико_АдресаСекций.Адрес2);
	Запрос.УстановитьПараметр("Адрес3_Параметр", Перечисления.Лико_АдресаСекций.Адрес3);

	ТЗ = Запрос.Выполнить().Выгрузить();

	// Сборка
	МассивСекций = Новый Массив;
	ВсегоАдресов = 0;
	ЗанятоАдресов = 0;

	Для Каждого Стр Из ТЗ Цикл

		Адреса = Новый Массив;
		Адреса.Добавить(СобратьАдрес(Стр.Адрес1, Стр.Паллет1, Стр.ТипоразмерПаллета1));
		Адреса.Добавить(СобратьАдрес(Стр.Адрес2, Стр.Паллет2, Стр.ТипоразмерПаллета2));
		Адреса.Добавить(СобратьАдрес(Стр.Адрес3, Стр.Паллет3, Стр.ТипоразмерПаллета3));

		ТипоразмерСекции = Стр.Типоразмер;
		СтруктураТС = Новый Структура;
		СтруктураТС.Вставить("width", ТипоразмерСекции.Габарит.Ширина);
		СтруктураТС.Вставить("height", ТипоразмерСекции.Габарит.Высота);
		СтруктураТС.Вставить("depth", ТипоразмерСекции.Габарит.Глубина);
		СтруктураТС.Вставить("weight", ТипоразмерСекции.Грузоподъемность);
		СтруктураТС.Вставить("unlimitedWeight", ТипоразмерСекции.НеОграниченаПоГрузоподъемности);

		СтруктураСекция = Новый Структура;
		СтруктураСекция.Вставить("id", Строка(Стр.Секция.УникальныйИдентификатор()));
		СтруктураСекция.Вставить("code", Стр.КодСекции);
		СтруктураСекция.Вставить("rack", Строка(Стр.Стеллаж.УникальныйИдентификатор()));
		СтруктураСекция.Вставить("floor", Стр.Этаж);
		СтруктураСекция.Вставить("accessLevel", Стр.УровеньДоступа);
		СтруктураСекция.Вставить("restricted", Стр.ЗапретРазмещения);
		СтруктураСекция.Вставить("typeSize", СтруктураТС);
		СтруктураСекция.Вставить("addresses", Адреса);

		МассивСекций.Добавить(СтруктураСекция);

		ВсегоАдресов = ВсегоАдресов + 3;
		ЗанятоАдресов = ЗанятоАдресов + ЗанятостьАдреса(Стр.Паллет1)
		                                + ЗанятостьАдреса(Стр.Паллет2)
		                                + ЗанятостьАдреса(Стр.Паллет3);
	КонецЦикла;

	СвободноАдресов = ВсегоАдресов - ЗанятоАдресов;
	Процент = 0;
	Если ВсегоАдресов > 0 Тогда
		Процент = Окр(ЗанятоАдресов / ВсегоАдресов * 100, 1);
	КонецЕсли;

	Сводка = Новый Структура;
	Сводка.Вставить("totalSections", МассивСекций.Количество());
	Сводка.Вставить("totalAddresses", ВсегоАдресов);
	Сводка.Вставить("occupiedAddresses", ЗанятоАдресов);
	Сводка.Вставить("freeAddresses", СвободноАдресов);
	Сводка.Вставить("occupancyPercent", Процент);

	Результат = Новый Структура;
	Результат.Вставить("Секции", МассивСекций);
	Результат.Вставить("Сводка", Сводка);

	Возврат Результат;

КонецФункции

Функция СобратьПаллетыНаПолу(СкладСсылка)

	// Возвращает структуру { Паллеты } — паллеты на полу без HTTP-обёртки.
	// Используется WMS_GetFloor и WMS_ExportSnapshot.

	Момент = Новый Граница(ТекущаяДата(), ВидГраницы.Включая);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Лико_ЗоныПриёмки.Стеллаж КАК Стеллаж,
	|	Лико_ЗоныПриёмки.СкладскаяЯчейка КАК АдресПриёмки,
	|	ОстаткиПриёмка.Паллет КАК Паллет,
	|	Параметры.Типоразмер КАК ТипоразмерПаллета
	|ПОМЕСТИТЬ ВТ_ПриёмкаУСтеллажейФлор
	|ИЗ
	|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(&Момент, Склад = &Склад) КАК ОстаткиПриёмка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_Стеллажи.Лико_ЗоныПриёмки КАК Лико_ЗоныПриёмки
	|	ПО ОстаткиПриёмка.Адрес = Лико_ЗоныПриёмки.СкладскаяЯчейка
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(&Момент) КАК Параметры
	|	ПО ОстаткиПриёмка.Паллет = Параметры.Паллет
	|
	|ОБЪЕДИНИТЬ ВСЁ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.Лико_Стеллажи.ПустаяСсылка) КАК Стеллаж,
	|	ОстаткиПриёмка.Адрес КАК АдресПриёмки,
	|	ОстаткиПриёмка.Паллет,
	|	Параметры.Типоразмер
	|ИЗ
	|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(&Момент, Склад = &Склад) КАК ОстаткиПриёмка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_Стеллажи.Лико_ЗоныПриёмки КАК Лико_ЗоныПриёмки
	|	ПО ОстаткиПриёмка.Адрес = Лико_ЗоныПриёмки.СкладскаяЯчейка
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(&Момент) КАК Параметры
	|	ПО ОстаткиПриёмка.Паллет = Параметры.Паллет
	|ГДЕ
	|	Лико_ЗоныПриёмки.СкладскаяЯчейка = ЗНАЧЕНИЕ(Справочник.СкладскиеЯчейки.ПустаяСсылка)
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПриёмкаУСтеллажейФлор.Стеллаж КАК rack,
	|	ВТ_ПриёмкаУСтеллажейФлор.АдресПриёмки КАК address,
	|	ВТ_ПриёмкаУСтеллажейФлор.АдресПриёмки.Код КАК code,
	|	ВТ_ПриёмкаУСтеллажейФлор.Паллет.УникальныйИдентификатор КАК PalletID,
	|	ВТ_ПриёмкаУСтеллажейФлор.Паллет.Код КАК PalletCode,
	|	ВТ_ПриёмкаУСтеллажейФлор.ТипоразмерПаллета.Габарит.Ширина КАК PalletWidth,
	|	ВТ_ПриёмкаУСтеллажейФлор.ТипоразмерПаллета.Габарит.Высота КАК PalletHeight,
	|	ВТ_ПриёмкаУСтеллажейФлор.ТипоразмерПаллета.Габарит.Глубина КАК PalletDepth,
	|	ВТ_ПриёмкаУСтеллажейФлор.ТипоразмерПаллета.Вес КАК PalletWeight
	|ИЗ
	|	ВТ_ПриёмкаУСтеллажейФлор КАК ВТ_ПриёмкаУСтеллажейФлор
	|ГДЕ
	|	ВТ_ПриёмкаУСтеллажейФлор.Паллет <> ЗНАЧЕНИЕ(Справочник.Лико_Паллеты2_0.ПустаяСсылка)";

	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Склад", СкладСсылка);

	ТЗ = Запрос.Выполнить().Выгрузить();

	МассивПаллетов = Новый Массив;

	Для Каждого Стр Из ТЗ Цикл
		СтруктураПаллет = Новый Структура;
		СтруктураПаллет.Вставить("id", Строка(Стр.PalletID));
		СтруктураПаллет.Вставить("code", Стр.PalletCode);
		СтруктураПаллет.Вставить("width", Стр.PalletWidth);
		СтруктураПаллет.Вставить("height", Стр.PalletHeight);
		СтруктураПаллет.Вставить("depth", Стр.PalletDepth);
		СтруктураПаллет.Вставить("weight", Стр.PalletWeight);

		СтруктураСтрока = Новый Структура;
		СтруктураСтрока.Вставить("rack",
			?(ЗначениеЗаполнено(Стр.rack),
			  Строка(Стр.rack.УникальныйИдентификатор()),
			  Null));
		СтруктураСтрока.Вставить("address", Строка(Стр.address.УникальныйИдентификатор()));
		СтруктураСтрока.Вставить("code", Стр.code);
		СтруктураСтрока.Вставить("pallet", СтруктураПаллет);

		МассивПаллетов.Добавить(СтруктураСтрока);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Паллеты", МассивПаллетов);

	Возврат Результат;

КонецФункции

Функция WMS_ExportSnapshot(ПараметрыPOST) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Экспортирует ВСЕ данные склада одним вызовом: топологию + занятость + пол.
	//   Результат — автономный JSON для работы веб-приложения без 1С.
	//
	// ПАРАМЕТРЫ:
	//   warehouse — GUID склада.

	Если НЕ ПараметрыPOST.Свойство("warehouse") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM", "Не передан параметр 'warehouse'");
	КонецЕсли;

	// Валидация склада
	СкладСсылка = СсылкаПоСтрокеGUID(ПараметрыPOST.warehouse, "Справочник.Склады");
	Если НЕ ЗначениеЗаполнено(СкладСсылка) Тогда
		Возврат HttpВернутьОшибку_WMS("INVALID_PARAM", "Склад не найден");
	КонецЕсли;

	// Собираем все три компонента через внутренние хелперы
	ДанныеСклада = СобратьТопологиюСклада(СкладСсылка);
	ДанныеЗанятости = СобратьЗанятостьСекций(СкладСсылка);
	ДанныеПола = СобратьПаллетыНаПолу(СкладСсылка);

	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ok", Истина);
	СтруктураОтвет.Вставить("exportedAt", ТекущаяДата());
	СтруктураОтвет.Вставить("warehouse", ДанныеСклада.Склад);
	СтруктураОтвет.Вставить("racks", ДанныеСклада.Стеллажи);
	СтруктураОтвет.Вставить("sections", ДанныеЗанятости.Секции);
	СтруктураОтвет.Вставить("floorPallets", ДанныеПола.Паллеты);
	СтруктураОтвет.Вставить("summary", ДанныеЗанятости.Сводка);

	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));

КонецФункции

// ============================================================================
// Хелперы — greedy планировщик
// ============================================================================

Функция МожетРазместить(Состояние, Паллет, ЦелевоеКоличество)

	ШиринаСекции = Состояние.максШирина;
	ЗазорПоШирине = 50;  // дефолт — в реальном коде брать из этажа

	// Проверка структуры адресов
	ШиринаПаллета = Паллет.width;
	Если ШиринаПаллета > ШиринаСекции * 2 / 3 Тогда
		Если Состояние.количествоПаллет > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли ШиринаПаллета > ШиринаСекции / 3 Тогда
		Если Состояние.количествоПаллет >= 2 Тогда
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Если Состояние.количествоПаллет >= 3 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	// Проверка суммы ширин + зазор
	ОбщаяШирина = Состояние.текШирина + Паллет.width;
	Зазор = (ЦелевоеКоличество + 1) * ЗазорПоШирине;
	Если ОбщаяШирина + Зазор > ШиринаСекции Тогда
		Возврат Ложь;
	КонецЕсли;

	// Проверка веса
	Если НЕ Состояние.безлимитныйВес Тогда
		Если Состояние.текВес + Паллет.weight > Состояние.максВес Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	// Проверка высоты (паллет ≤ габарит.высота)
	Если Паллет.Свойство("height") И Паллет.height > 0 Тогда
		ВысотаСекции = Состояние.Секция.typeSize.height;
		Если Паллет.height > ВысотаСекции Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция СоздатьРазмещение(Паллет, Состояние, FillLevel)

	// Найти первый свободный адрес в секции
	АдресРазмещения = "";
	КодАдреса = "";
	Для Каждого Адрес Из Состояние.Секция.addresses Цикл
		Занят = Ложь;
		Для Каждого Занятый Из Состояние.занятые Цикл
			Если Занятый.address = Адрес.address Тогда
				Занят = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Занят Тогда
			АдресРазмещения = Адрес.address;
			КодАдреса = Адрес.addressCode;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	СтруктураРез = Новый Структура;
	СтруктураРез.Вставить("pallet", Паллет.id);
	СтруктураРез.Вставить("section", Состояние.Секция.id);
	СтруктураРез.Вставить("sectionCode", Состояние.Секция.code);
	СтруктураРез.Вставить("address", АдресРазмещения);
	СтруктураРез.Вставить("addressCode", КодАдреса);
	СтруктураРез.Вставить("action", "place");
	СтруктураРез.Вставить("fillLevel", FillLevel);

	Возврат СтруктураРез;

КонецФункции

Процедура ОбновитьСостояние(Состояние, Паллет)

	СтруктураЗанят = Новый Структура;
	СтруктураЗанят.Вставить("address", "");
	СтруктураЗанят.Вставить("addressCode", "");
	СтруктураЗанят.Вставить("width", Паллет.width);
	СтруктураЗанят.Вставить("weight", ?(Паллет.Свойство("weight"), Паллет.weight, 0));

	Состояние.занятые.Добавить(СтруктураЗанят);
	Состояние.текШирина = Состояние.текШирина + Паллет.width;
	Состояние.текВес = Состояние.текВес + ?(Паллет.Свойство("weight"), Паллет.weight, 0);
	Состояние.количествоПаллет = Состояние.количествоПаллет + 1;

КонецПроцедуры

Функция WMS_PlacePallets(ПараметрыPOST) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Принимает список паллет (с габаритами) и возвращает план размещения.
	//   MVP: greedy с сортировкой по убыванию ширины, приоритет добивки
	//   частично занятых секций. НЕ создаёт документов — только расчёт.
	//
	//   Алгоритм:
	//   1. Загрузить состояние склада
	//   2. Отсортировать паллеты по убыванию ширины
	//   3. Для каждого: Фаза А — добить существующую секцию (2→3, 1→2)
	//                   Фаза Б — лучший кандидат из новых секций
	//   4. Статистика
	//
	// ПАРАМЕТРЫ:
	//   warehouse — GUID склада
	//   pallets   — Массив структур [{ id, width, height, depth, weight }]
	//   options   — Структура { mode, fillExistingFirst, maxPalletsPerSection }

	Если НЕ ПараметрыPOST.Свойство("warehouse")
	   ИЛИ НЕ ПараметрыPOST.Свойство("pallets") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM",
			"Необходимы параметры: warehouse, pallets");
	КонецЕсли;

	Склад = СсылкаПоСтрокеGUID(ПараметрыPOST.warehouse, "Справочник.Склады");
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат HttpВернутьОшибку_WMS("INVALID_PARAM", "Склад не найден");
	КонецЕсли;

	// Параметры options с умолчаниями
	ДобиватьСуществующие = Истина;
	МаксПаллетВСекции = 3;

	Если ПараметрыPOST.Свойство("options") Тогда
		Опции = ПараметрыPOST.options;
		Если Опции.Свойство("fillExistingFirst") Тогда
			ДобиватьСуществующие = Опции.fillExistingFirst;
		КонецЕсли;
		Если Опции.Свойство("maxPalletsPerSection") Тогда
			МаксПаллетВСекции = Опции.maxPalletsPerSection;
		КонецЕсли;
	КонецЕсли;

	// --- Шаг 1: загрузить состояние склада ---
	Данные = СобратьЗанятостьСекций(Склад);

	// Построить индекс секций: Map<sectionID → { занятые адреса, остаток ширины, остаток веса }
	СостояниеСекций = Новый Соответствие;
	Для Каждого Секция Из Данные.Секции Цикл

		Занятые = Новый Массив;
		ТекШирина = 0;
		ТекВес = 0;

		Для Каждого Адрес Из Секция.addresses Цикл
			Если Адрес.pallet <> Null Тогда
				СтруктураЗанят = Новый Структура;
				СтруктураЗанят.Вставить("address", Адрес.address);
				СтруктураЗанят.Вставить("addressCode", Адрес.addressCode);
				СтруктураЗанят.Вставить("width", Адрес.width);
				СтруктураЗанят.Вставить("weight", Адрес.weight);
				Занятые.Добавить(СтруктураЗанят);
				ТекШирина = ТекШирина + Адрес.width;
				ТекВес = ТекВес + Адрес.weight;
			КонецЕсли;
		КонецЦикла;

		СтруктураСостояние = Новый Структура;
		СтруктураСостояние.Вставить("section", Секция);
		СтруктураСостояние.Вставить("занятые", Занятые);
		СтруктураСостояние.Вставить("текШирина", ТекШирина);
		СтруктураСостояние.Вставить("текВес", ТекВес);
		СтруктураСостояние.Вставить("количествоПаллет", Занятые.Количество());
		СтруктураСостояние.Вставить("максШирина", Секция.typeSize.width);
		СтруктураСостояние.Вставить("максВес", Секция.typeSize.weight);
		СтруктураСостояние.Вставить("безлимитныйВес", Секция.typeSize.unlimitedWeight);

		СостояниеСекций.Вставить(Секция.id, СтруктураСостояние);
	КонецЦикла;

	// --- Шаг 2: сортировка паллет ---
	МассивПаллет = Новый Массив;
	Для Каждого Паллет Из ПараметрыPOST.pallets Цикл
		МассивПаллет.Добавить(Паллет);
	КонецЦикла;

	// Сортировка по убыванию ширины (пузырьком — для простоты)
	Для i = 0 По МассивПаллет.Количество() - 2 Цикл
		Для j = i + 1 По МассивПаллет.Количество() - 1 Цикл
			Если МассивПаллет[i].width < МассивПаллет[j].width Тогда
				Врем = МассивПаллет[i];
				МассивПаллет[i] = МассивПаллет[j];
				МассивПаллет[j] = Врем;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// --- Шаг 3: размещение ---
	Размещения = Новый Массив;
	Неразмещённые = Новый Массив;

	Для Каждого Паллет Из МассивПаллет Цикл
		Размещён = Ложь;

		Если ДобиватьСуществующие Тогда

			// Приоритет 1: секции с 2 паллетами → добить до 3
			Для Каждого КлючСекции Из СостояниеСекций Цикл
				Состояние = СостояниеСекций.Получить(КлючСекции);
				Если Состояние.количествоПаллет = 2 Тогда
					Если МожетРазместить(Состояние, Паллет, 3) Тогда
						Размещения.Добавить(СоздатьРазмещение(Паллет, Состояние, 1));
						ОбновитьСостояние(Состояние, Паллет);
						Размещён = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;

			// Приоритет 2: секции с 1 паллетом → добить до 2
			Если НЕ Размещён Тогда
				Для Каждого КлючСекции Из СостояниеСекций Цикл
					Состояние = СостояниеСекций.Получить(КлючСекции);
					Если Состояние.количествоПаллет = 1 Тогда
						Если МожетРазместить(Состояние, Паллет, 2) Тогда
							Размещения.Добавить(СоздатьРазмещение(Паллет, Состояние, 2));
							ОбновитьСостояние(Состояние, Паллет);
							Размещён = Истина;
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;

		// Фаза Б: пустые секции
		Если НЕ Размещён Тогда
			Для Каждого КлючСекции Из СостояниеСекций Цикл
				Состояние = СостояниеСекций.Получить(КлючСекции);
				Если Состояние.количествоПаллет = 0
				   И НЕ Состояние.Секция.restricted Тогда
					Если МожетРазместить(Состояние, Паллет, 1) Тогда
						Размещения.Добавить(СоздатьРазмещение(Паллет, Состояние, 4));
						ОбновитьСостояние(Состояние, Паллет);
						Размещён = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если НЕ Размещён Тогда
			СтруктураНеразм = Новый Структура;
			СтруктураНеразм.Вставить("id", Паллет.id);
			СтруктураНеразм.Вставить("reason", "Нет подходящей секции");
			Неразмещённые.Добавить(СтруктураНеразм);
		КонецЕсли;
	КонецЦикла;

	// --- Шаг 4: статистика ---
	ИдеальныхСекций = 0;
	ИспользованоСекций = 0;

	Для Каждого КлючСекции Из СостояниеСекций Цикл
		Состояние = СостояниеСекций.Получить(КлючСекции);
		Если Состояние.количествоПаллет > 0 Тогда
			ИспользованоСекций = ИспользованоСекций + 1;
		КонецЕсли;
		Если Состояние.количествоПаллет = 3 Тогда
			ИдеальныхСекций = ИдеальныхСекций + 1;
		КонецЕсли;
	КонецЦикла;

	Статистика = Новый Структура;
	Статистика.Вставить("total", МассивПаллет.Количество());
	Статистика.Вставить("placed", Размещения.Количество());
	Статистика.Вставить("perfectSections", ИдеальныхСекций);
	Статистика.Вставить("sectionsUsed", ИспользованоСекций);
	Статистика.Вставить("movesRequired", 0);

	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ok", Истина);
	СтруктураОтвет.Вставить("placements", Размещения);
	СтруктураОтвет.Вставить("unplaced", Неразмещённые);
	СтруктураОтвет.Вставить("stats", Статистика);

	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));

КонецФункции

Функция WMS_GenerateMockData(ПараметрыPOST) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Генерирует синтетический склад с заданными параметрами и случайным
	//   распределением паллет. Только для разработки/тестирования.
	//   Не требует подключения к реальной базе склада.
	//
	// ПАРАМЕТРЫ (все опциональные, с умолчаниями):
	//   racksCount:     9
	//   sectionsPerRack: 17
	//   floorsPerRack:  9
	//   palletCount:    500
	//   palletWidths:   [700, 750, 800, 850, 900]
	//   seed:           42

	RacksCount = 9;
	SectionsPerRack = 17;
	FloorsPerRack = 9;
	PalletCount = 500;
	PalletWidths = Новый Массив;
	PalletWidths.Добавить(700);
	PalletWidths.Добавить(750);
	PalletWidths.Добавить(800);
	PalletWidths.Добавить(850);
	PalletWidths.Добавить(900);
	Seed = 42;

	Если ПараметрыPOST.Свойство("racksCount") Тогда RacksCount = ПараметрыPOST.racksCount; КонецЕсли;
	Если ПараметрыPOST.Свойство("sectionsPerRack") Тогда SectionsPerRack = ПараметрыPOST.sectionsPerRack; КонецЕсли;
	Если ПараметрыPOST.Свойство("floorsPerRack") Тогда FloorsPerRack = ПараметрыPOST.floorsPerRack; КонецЕсли;
	Если ПараметрыPOST.Свойство("palletCount") Тогда PalletCount = ПараметрыPOST.palletCount; КонецЕсли;
	Если ПараметрыPOST.Свойство("palletWidths") Тогда PalletWidths = ПараметрыPOST.palletWidths; КонецЕсли;
	Если ПараметрыPOST.Свойство("seed") Тогда Seed = ПараметрыPOST.seed; КонецЕсли;

	// Инициализация ГСЧ
	ГСЧ = Новый ГенераторСлучайныхЧисел(Seed);

	// Генерация стеллажей
	МассивСтеллажей = Новый Массив;
	Цвета = Новый Массив;
	Цвета.Добавить("#E8C98A"); Цвета.Добавить("#A8D8B9"); Цвета.Добавить("#B8D4E3");
	Цвета.Добавить("#F0C8C8"); Цвета.Добавить("#D5C4E1"); Цвета.Добавить("#F5DEB3");
	Цвета.Добавить("#C8E6E6"); Цвета.Добавить("#E8D5B7"); Цвета.Добавить("#D4E4C8");

	Для НомерСтеллажа = 1 По RacksCount Цикл
		МассивЭтажей = Новый Массив;
		Для НомерЭтажа = 1 По FloorsPerRack Цикл
			СтруктураЭтаж = Новый Структура;
			СтруктураЭтаж.Вставить("number", НомерЭтажа);
			СтруктураЭтаж.Вставить("typeSize", Новый Структура);
			СтруктураЭтаж.typeSize.Вставить("id", "mock-type-" + НомерЭтажа);
			СтруктураЭтаж.typeSize.Вставить("height", 2340);
			СтруктураЭтаж.typeSize.Вставить("width", 2700);
			СтруктураЭтаж.typeSize.Вставить("depth", 1100);
			СтруктураЭтаж.typeSize.Вставить("weight", 6000);
			СтруктураЭтаж.typeSize.Вставить("unlimitedWeight", Истина);
			СтруктураЭтаж.Вставить("minDepthUnlimited", Истина);
			СтруктураЭтаж.Вставить("maxDepthUnlimited", Истина);
			СтруктураЭтаж.Вставить("maxLiftWeight", 2000);
			СтруктураЭтаж.Вставить("heightClearance", 100);
			СтруктураЭтаж.Вставить("beamHeight", 120);
			СтруктураЭтаж.Вставить("heightFromFloor", 200);
			СтруктураЭтаж.Вставить("heightFromFloorFixed", НомерЭтажа = 1);
			СтруктураЭтаж.Вставить("widthClearance", 50);
			МассивЭтажей.Добавить(СтруктураЭтаж);
		КонецЦикла;

		ИндексЦвета = (НомерСтеллажа - 1) % Цвета.Количество();
		СтруктураСтеллаж = Новый Структура;
		СтруктураСтеллаж.Вставить("id", "mock-rack-" + НомерСтеллажа);
		СтруктураСтеллаж.Вставить("name", "Стеллаж " + НомерСтеллажа);
		СтруктураСтеллаж.Вставить("code", "" + НомерСтеллажа);
		СтруктураСтеллаж.Вставить("number", НомерСтеллажа);
		СтруктураСтеллаж.Вставить("narrowAisle", Ложь);
		СтруктураСтеллаж.Вставить("color", Цвета[ИндексЦвета]);
		СтруктураСтеллаж.Вставить("minPalletWidth", 0);
		СтруктураСтеллаж.Вставить("maxPalletWidth", 1350);
		СтруктураСтеллаж.Вставить("minPalletDepth", 0);
		СтруктураСтеллаж.Вставить("maxPalletDepth", 0);
		СтруктураСтеллаж.Вставить("sectionsCount", SectionsPerRack);
		СтруктураСтеллаж.Вставить("cellsPerSection", 3);
		СтруктураСтеллаж.Вставить("floorZonesCount", 5);
		СтруктураСтеллаж.Вставить("accessTime", 120);
		СтруктураСтеллаж.Вставить("floors", МассивЭтажей);
		МассивСтеллажей.Добавить(СтруктураСтеллаж);
	КонецЦикла;

	// Генерация секций с паллетами
	МассивСекций = Новый Массив;
	ВсегоАдресов = 0;
	ЗанятоАдресов = 0;
	СчётчикПаллет = 0;

	Для НомерСтеллажа = 1 По RacksCount Цикл
		Для НомерЭтажа = 1 По FloorsPerRack Цикл
			Для НомерСекции = 1 По SectionsPerRack Цикл
				КодСекции = "Р" + НомерСтеллажа + "-М("
					+ ((НомерСекции-1)*3+1) + "-"
					+ ((НомерСекции-1)*3+2) + "-"
					+ ((НомерСекции-1)*3+3) + ")-Э" + НомерЭтажа;

				Адреса = Новый Массив;
				Занято = 0;

				Для НомерАдреса = 1 По 3 Цикл
					КодАдреса = "Р" + НомерСтеллажа + "М"
						+ ((НомерСекции-1)*3+НомерАдреса) + "Э" + НомерЭтажа;

					СтруктураАдрес = Новый Структура;
					СтруктураАдрес.Вставить("address", "mock-addr-" + КодАдреса);
					СтруктураАдрес.Вставить("addressCode", КодАдреса);

					// Случайно: разместить паллет или оставить пустым
					Если СчётчикПаллет < PalletCount И ГСЧ.СлучайноеЧисло(0, 100) < 65 Тогда
						ИндексШирины = ГСЧ.СлучайноеЧисло(0, PalletWidths.Количество() - 1);
						Ширина = PalletWidths[ИндексШирины];
						КодПаллета = "MOCK-P-" + (СчётчикПаллет + 1);

						СтруктураАдрес.Вставить("pallet", "mock-pallet-" + КодПаллета);
						СтруктураАдрес.Вставить("palletCode", КодПаллета);
						СтруктураАдрес.Вставить("width", Ширина);
						СтруктураАдрес.Вставить("height", 1200);
						СтруктураАдрес.Вставить("depth", 1100);
						СтруктураАдрес.Вставить("weight", 500);

						СчётчикПаллет = СчётчикПаллет + 1;
						Занято = Занято + 1;
					Иначе
						СтруктураАдрес.Вставить("pallet", Null);
						СтруктураАдрес.Вставить("palletCode", Null);
						СтруктураАдрес.Вставить("width", Null);
						СтруктураАдрес.Вставить("height", Null);
						СтруктураАдрес.Вставить("depth", Null);
						СтруктураАдрес.Вставить("weight", Null);
					КонецЕсли;

					Адреса.Добавить(СтруктураАдрес);
				КонецЦикла;

				ВсегоАдресов = ВсегоАдресов + 3;
				ЗанятоАдресов = ЗанятоАдресов + Занято;

				СтруктураТС = Новый Структура;
				СтруктураТС.Вставить("width", 2700);
				СтруктураТС.Вставить("height", 2340);
				СтруктураТС.Вставить("depth", 1100);
				СтруктураТС.Вставить("weight", 6000);
				СтруктураТС.Вставить("unlimitedWeight", Истина);

				СтруктураСекция = Новый Структура;
				СтруктураСекция.Вставить("id", "mock-section-" + КодСекции);
				СтруктураСекция.Вставить("code", КодСекции);
				СтруктураСекция.Вставить("rack", "mock-rack-" + НомерСтеллажа);
				СтруктураСекция.Вставить("floor", НомерЭтажа);
				СтруктураСекция.Вставить("accessLevel", ?(НомерСекции <= SectionsPerRack/2, 1, 2));
				СтруктураСекция.Вставить("restricted", Ложь);
				СтруктураСекция.Вставить("typeSize", СтруктураТС);
				СтруктураСекция.Вставить("addresses", Адреса);
				МассивСекций.Добавить(СтруктураСекция);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	// Сводка
	Сводка = Новый Структура;
	Сводка.Вставить("racksCount", RacksCount);
	Сводка.Вставить("totalSections", МассивСекций.Количество());
	Сводка.Вставить("totalAddresses", ВсегоАдресов);
	Сводка.Вставить("occupiedAddresses", ЗанятоАдресов);
	Сводка.Вставить("occupancyPercent",
		?(ВсегоАдресов > 0, Окр(ЗанятоАдресов / ВсегоАдресов * 100, 1), 0));

	// Снимок
	Снимок = Новый Структура;
	Снимок.Вставить("exportedAt", ТекущаяДата());
	Снимок.Вставить("warehouse", Новый Структура);
	Снимок.warehouse.Вставить("id", "mock-warehouse");
	Снимок.warehouse.Вставить("name", "Синтетический склад");
	Снимок.warehouse.Вставить("code", "MOCK");
	Снимок.Вставить("racks", МассивСтеллажей);
	Снимок.Вставить("sections", МассивСекций);
	Снимок.Вставить("floorPallets", Новый Массив);
	Снимок.Вставить("summary", Сводка);

	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ok", Истина);
	СтруктураОтвет.Вставить("snapshot", Снимок);

	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));

КонецФункции

#КонецОбласти
