//+Лико m.shenderov 19.07.2026
Функция ОптимальноеРазмещениеПаллет(Склад, МассивПаллет, МаксПерестановок = 0) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Пакетное размещение партии паллет с возможностью перестановки уже стоящих.
	//   НЕ использует ПодобратьЯчейку — своя логика через прямой перебор секций.
	//
	// ПАРАМЕТРЫ:
	//   Склад             — СправочникСсылка.Склады
	//   МассивПаллет       — Массив ссылок Лико_Паллеты2_0
	//   МаксПерестановок   — Число (0 = без перестановок)
	//
	// ВОЗВРАТ:
	//   Структура { Placements, Rearrangements, Unplaced, Stats }

	Результат = Новый Структура;
	Результат.Вставить("Placements", Новый Массив);
	Результат.Вставить("Rearrangements", Новый Массив);
	Результат.Вставить("Unplaced", Новый Массив);

	// --- Загрузка габаритов паллет ---
	ГабаритыПаллет = Новый Соответствие; // ПаллетСсылка -> Структура(Высота,Ширина,Глубина,Вес)

	ЗапросГабариты = Новый Запрос;
	ЗапросГабариты.Текст =
	"ВЫБРАТЬ
	|	Лико_ПараметрыПаллет.Паллет КАК Паллет,
	|	Лико_ПараметрыПаллет.Типоразмер.Высота КАК Высота,
	|	Лико_ПараметрыПаллет.Типоразмер.Ширина КАК Ширина,
	|	Лико_ПараметрыПаллет.Типоразмер.Глубина КАК Глубина,
	|	Лико_ПараметрыПаллет.Типоразмер.Вес КАК Вес
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних КАК Лико_ПараметрыПаллет
	|ГДЕ
	|	Лико_ПараметрыПаллет.Паллет В (&МассивПаллет)";
	ЗапросГабариты.УстановитьПараметр("МассивПаллет", МассивПаллет);
	ТЗГабариты = ЗапросГабариты.Выполнить().Выгрузить();

	Для Каждого Стр Из ТЗГабариты Цикл
		Габ = Новый Структура("Высота,Ширина,Глубина,Вес", Стр.Высота, Стр.Ширина, Стр.Глубина, Стр.Вес);
		ГабаритыПаллет.Вставить(Стр.Паллет, Габ);
	КонецЦикла;

	// --- Загрузка текущего состояния склада ---
	// Секции с адресами и стоящими паллетами
	СекцииДанные = СобратьЗанятостьСекций(Склад);

	// --- Сортировка партии по убыванию ширины (BFD) ---
	МассивПаллетСорт = Новый Массив;
	Для Каждого Паллет Из МассивПаллет Цикл
		ГабП = ГабаритыПаллет.Получить(Паллет);
		Если ГабП <> Неопределено Тогда
			Запись = Новый Структура("Ссылка,Ширина,Высота,Глубина,Вес", Паллет, ГабП.Ширина, ГабП.Высота, ГабП.Глубина, ГабП.Вес);
			МассивПаллетСорт.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	// Сортировка пузырьком по убыванию ширины
	Для i = 0 По МассивПаллетСорт.Количество() - 2 Цикл
		Для j = i + 1 По МассивПаллетСорт.Количество() - 1 Цикл
			Если МассивПаллетСорт[i].Ширина < МассивПаллетСорт[j].Ширина Тогда
				Врем = МассивПаллетСорт[i];
				МассивПаллетСорт[i] = МассивПаллетСорт[j];
				МассивПаллетСорт[j] = Врем;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// --- Определение ширины секции для категоризации ---
	ШиринаСекции = 2700; // по умолчанию
	Если СекцииДанные.Количество() > 0 Тогда
		ПерваяСекция = СекцииДанные[0];
		Если ПерваяСекция.Свойство("typeSize_width") Тогда
			ШиринаСекции = ПерваяСекция.typeSize_width;
		КонецЕсли;
	КонецЕсли;

	// --- ВиртуальноеСостояние ---
	ВиртуальноеСостояние = Новый Соответствие;
	// Заполняем текущими остатками
	Для Каждого Секция Из СекцииДанные Цикл
		Для НомерАдреса = 1 По 3 Цикл
			ИмяПаллета = "pallet" + НомерАдреса + "_id";
			Если Секция.Свойство(ИмяПаллета)
				 И ЗначениеЗаполнено(Секция[ИмяПаллета])
				 И НЕ ПустаяСтрока(Секция[ИмяПаллета])
				 И Секция[ИмяПаллета] <> "00000000-0000-0000-0000-000000000000" Тогда
				ИмяАдреса = "address" + НомерАдреса;
				Если Секция.Свойство(ИмяАдреса) Тогда
					ВиртуальноеСостояние.Вставить(Секция[ИмяАдреса], Секция[ИмяПаллета]);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// --- ФАЗА 1: Прямое размещение ---
	ОчередьНаФазу2 = Новый Массив;
	ИспользованоПерестановок = 0;

	Для Каждого ПаллетДанные Из МассивПаллетСорт Цикл
		Размещён = Ложь;

		// Категория паллета
		Кат = "narrow";
		Если ПаллетДанные.Ширина > ШиринаСекции * 2 / 3 Тогда
			Кат = "wide";
		ИначеЕсли ПаллетДанные.Ширина > ШиринаСекции / 3 Тогда
			Кат = "medium";
		КонецЕсли;

		ЛучшаяСекция = Неопределено;
		ЛучшийАдрес = "";
		ЛучшаяРазницаВысот = 999999;

		Для Каждого Секция Из СекцииДанные Цикл
			Если Секция.Свойство("restricted") И Секция.restricted Тогда
				Продолжить;
			КонецЕсли;

			ВысотаСекции = ?(Секция.Свойство("typeSize_height"), Секция.typeSize_height, 2100);

			// Проверяем каждый адрес
			Для НомерАдреса = 1 По 3 Цикл
				ИмяАдреса = "address" + НомерАдреса;
				Если НЕ Секция.Свойство(ИмяАдреса) Тогда
					Продолжить;
				КонецЕсли;
				АдресЯчейки = Секция[ИмяАдреса];

				// Проверка занятости через ВиртуальноеСостояние
				Если ВиртуальноеСостояние.Получить(АдресЯчейки) <> Неопределено Тогда
					Продолжить; // адрес занят
				КонецЕсли;

				// Категорийные проверки
				Если Кат = "wide" Тогда
					// Нужны все 3 адреса свободны
					ВсеСвободны = Истина;
					Для НомерПров = 1 По 3 Цикл
						ИмяПр = "address" + НомерПров;
						Если Секция.Свойство(ИмяПр) И ВиртуальноеСостояние.Получить(Секция[ИмяПр]) <> Неопределено Тогда
							ВсеСвободны = Ложь;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если НЕ ВсеСвободны Тогда
						Продолжить;
					КонецЕсли;
				ИначеЕсли Кат = "medium" Тогда
					// Нужен Адрес2 + крайний свободны
					Если НомерАдреса <> 2 Тогда
						Продолжить; // medium только в Адрес2
					КонецЕсли;
				КонецЕсли;

				// Проверка габаритов
				Если ПаллетДанные.Высота > ВысотаСекции Тогда
					Продолжить;
				КонецЕсли;

				// Best-fit по высоте
				Разница = ВысотаСекции - ПаллетДанные.Высота;
				Если Разница < ЛучшаяРазницаВысот Тогда
					ЛучшаяРазницаВысот = Разница;
					ЛучшаяСекция = Секция;
					ЛучшийАдрес = АдресЯчейки;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;

		Если ЛучшаяСекция <> Неопределено Тогда
			// Размещаем
			Размещение = Новый Структура;
			Размещение.Вставить("Паллет", ПаллетДанные.Ссылка);
			Размещение.Вставить("Адрес", ЛучшийАдрес);
			Размещение.Вставить("Секция", ?(ЛучшаяСекция.Свойство("section_id"), ЛучшаяСекция.section_id, ""));
			Размещение.Вставить("Стеллаж", ?(ЛучшаяСекция.Свойство("rack_id"), ЛучшаяСекция.rack_id, ""));
			Размещение.Вставить("Этаж", ?(ЛучшаяСекция.Свойство("floor"), ЛучшаяСекция.floor, 0));
			Результат.Placements.Добавить(Размещение);

			ВиртуальноеСостояние.Вставить(ЛучшийАдрес, ПаллетДанные.Ссылка);
		Иначе
			ОчередьНаФазу2.Добавить(ПаллетДанные);
		КонецЕсли;
	КонецЦикла;

	// --- ФАЗА 2: Размещение с перестановками ---
	Для Каждого ПаллетДанные Из ОчередьНаФазу2 Цикл
		Если МаксПерестановок <= 0 ИЛИ ИспользованоПерестановок >= МаксПерестановок Тогда
			Неразм = Новый Структура;
			Неразм.Вставить("Паллет", ПаллетДанные.Ссылка);
			Неразм.Вставить("Причина", "Нет места, лимит перестановок исчерпан");
			Результат.Unplaced.Добавить(Неразм);
			Продолжить;
		КонецЕсли;

		НайденоРешение = Ложь;

		// Перебор этажей снизу вверх
		Для Этаж = 1 По 10 Цикл
			Если НайденоРешение Тогда
				Прервать;
			КонецЕсли;

			Для Каждого Секция Из СекцииДанные Цикл
				Если НайденоРешение Тогда
					Прервать;
				КонецЕсли;

				НомерЭтажа = ?(Секция.Свойство("floor"), Секция.floor, 0);
				Если НомерЭтажа <> Этаж Тогда
					Продолжить;
				КонецЕсли;

				ВысотаСекции = ?(Секция.Свойство("typeSize_height"), Секция.typeSize_height, 2100);

				Если ПаллетДанные.Высота > ВысотаСекции Тогда
					Продолжить;
				КонецЕсли;

				// Ищем стоящий паллет в этой секции который можно переместить
				Для НомерАдреса = 1 По 3 Цикл
					Если НайденоРешение Тогда
						Прервать;
					КонецЕсли;

					ИмяАдреса = "address" + НомерАдреса;
					Если НЕ Секция.Свойство(ИмяАдреса) Тогда
						Продолжить;
					КонецЕсли;
					АдресЗанятый = Секция[ИмяАдреса];
					ПаллетСтоящий = ВиртуальноеСостояние.Получить(АдресЗанятый);

					Если ПаллетСтоящий = Неопределено Тогда
						Продолжить; // адрес и так свободен
					КонецЕсли;

					// Ищем куда переместить стоящий паллет на этом же этаже
					Для Каждого СекцияЦель Из СекцииДанные Цикл
						Если НайденоРешение Тогда
							Прервать;
						КонецЕсли;

						Если СекцияЦель = Секция Тогда
							Продолжить;
						КонецЕсли;

						НомерЭтажаЦель = ?(СекцияЦель.Свойство("floor"), СекцияЦель.floor, 0);
						Если НомерЭтажаЦель <> Этаж Тогда
							Продолжить;
						КонецЕсли;

						Для НомерЦель = 1 По 3 Цикл
							ИмяЦель = "address" + НомерЦель;
							Если НЕ СекцияЦель.Свойство(ИмяЦель) Тогда
								Продолжить;
							КонецЕсли;
							АдресЦель = СекцияЦель[ИмяЦель];

							Если ВиртуальноеСостояние.Получить(АдресЦель) <> Неопределено Тогда
								Продолжить; // занят
							КонецЕсли;

							// Нашли! Перемещаем стоящий, ставим новый
							ВиртуальноеСостояние.Вставить(АдресЦель, ПаллетСтоящий);
							ВиртуальноеСостояние.Вставить(АдресЗанятый, ПаллетДанные.Ссылка);

							Перест = Новый Структура;
							Перест.Вставить("Паллет", ПаллетСтоящий);
							Перест.Вставить("ОткудаАдрес", АдресЗанятый);
							Перест.Вставить("КудаАдрес", АдресЦель);
							Результат.Rearrangements.Добавить(Перест);

							Размещение = Новый Структура;
							Размещение.Вставить("Паллет", ПаллетДанные.Ссылка);
							Размещение.Вставить("Адрес", АдресЗанятый);
							Размещение.Вставить("Секция", ?(Секция.Свойство("section_id"), Секция.section_id, ""));
							Размещение.Вставить("Стеллаж", ?(Секция.Свойство("rack_id"), Секция.rack_id, ""));
							Размещение.Вставить("Этаж", НомерЭтажа);
							Результат.Placements.Добавить(Размещение);

							ИспользованоПерестановок = ИспользованоПерестановок + 1;
							НайденоРешение = Истина;
							Прервать;
						КонецЦикла;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;

		Если НЕ НайденоРешение Тогда
			Неразм = Новый Структура;
			Неразм.Вставить("Паллет", ПаллетДанные.Ссылка);
			Неразм.Вставить("Причина", "Не удалось найти место даже с перестановками");
			Результат.Unplaced.Добавить(Неразм);
		КонецЕсли;
	КонецЦикла;

	// --- Статистика ---
	Stats = Новый Структура;
	Stats.Вставить("Всего", МассивПаллет.Количество());
	Stats.Вставить("Размещено", Результат.Placements.Количество());
	Stats.Вставить("Перестановок", Результат.Rearrangements.Количество());

	Результат.Вставить("Stats", Stats);

	// Преобразуем GUID в строки для возврата
	Возврат Результат;

КонецФункции

//+Лико m.shenderov 19.07.2026
Функция РеслотСклада(Склад, МаксПеремещений) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Поиск плана уплотнения: переставить стоящие паллеты чтобы освободить
	//   максимум секций за ≤ МаксПеремещений ходов.
	//
	// ПАРАМЕТРЫ:
	//   Склад            — СправочникСсылка.Склады
	//   МаксПеремещений   — Число
	//
	// ВОЗВРАТ:
	//   Структура { Moves, Stats }

	Результат = Новый Структура;
	Результат.Вставить("Moves", Новый Массив);

	// --- Загрузка секций ---
	СекцииДанные = СобратьЗанятостьСекций(Склад);
	Если СекцииДанные.Количество() = 0 Тогда
		Stats = Новый Структура;
		Stats.Вставить("ИспользованоПеремещений", 0);
		Stats.Вставить("ОсвобожденоСекций", 0);
		Stats.Вставить("ПриростПлотности", 0);
		Результат.Вставить("Stats", Stats);
		Возврат Результат;
	КонецЕсли;

	// --- Строим карту: секция -> список паллетов ---
	ПаллетыВСекции = Новый Соответствие; // section_id -> Массив структур {Паллет, Адрес, Ширина, Высота, Глубина, Вес}
	СекцииСДанными = Новый Соответствие;  // section_id -> Структура секции

	Для Каждого С Из СекцииДанные Цикл
		ИД = ?(С.Свойство("section_id"), С.section_id, "");
		Если НЕ ЗначениеЗаполнено(ИД) Тогда
			Продолжить;
		КонецЕсли;

		СекцииСДанными.Вставить(ИД, С);

		Паллеты = Новый Массив;
		Для Номер = 1 По 3 Цикл
			ИмяКода = "pallet" + Номер + "_code";
			Если С.Свойство(ИмяКода) И ЗначениеЗаполнено(С[ИмяКода]) И С[ИмяКода] <> "0" Тогда
				П = Новый Структура;
				П.Вставить("Паллет", С["pallet" + Номер + "_id"]);
				П.Вставить("Адрес", С["address" + Номер]);
				П.Вставить("Ширина", ?(С.Свойство("pallet" + Номер + "_width"), С["pallet" + Номер + "_width"], 0));
				П.Вставить("Высота", ?(С.Свойство("pallet" + Номер + "_height"), С["pallet" + Номер + "_height"], 0));
				П.Вставить("Глубина", ?(С.Свойство("pallet" + Номер + "_depth"), С["pallet" + Номер + "_depth"], 0));
				П.Вставить("Вес", ?(С.Свойство("pallet" + Номер + "_weight"), С["pallet" + Номер + "_weight"], 0));
				Паллеты.Добавить(П);
			КонецЕсли;
		КонецЦикла;
		ПаллетыВСекции.Вставить(ИД, Паллеты);
	КонецЦикла;

	// --- Поиск кандидатов на объединение ---
	Кандидаты = Новый Массив;

	ИдыСекций = Новый Массив;
	Для Каждого Ключ Из ПаллетыВСекции Цикл
		Если Ключ.Значение.Количество() > 0 И Ключ.Значение.Количество() < 3 Тогда
			ИдыСекций.Добавить(Ключ.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для i = 0 По ИдыСекций.Количество() - 2 Цикл
		ИдА = ИдыСекций[i];
		ПаллетыА = ПаллетыВСекции.Получить(ИдА);
		СекцияА = СекцииСДанными.Получить(ИдА);

		Для j = i + 1 По ИдыСекций.Количество() - 1 Цикл
			ИдБ = ИдыСекций[j];
			ПаллетыБ = ПаллетыВСекции.Получить(ИдБ);
			СекцияБ = СекцииСДанными.Получить(ИдБ);

			// Проверка: на одном этаже?
			ЭтажА = ?(СекцияА.Свойство("floor"), СекцияА.floor, 0);
			ЭтажБ = ?(СекцияБ.Свойство("floor"), СекцияБ.floor, 0);
			Если ЭтажА <> ЭтажБ Тогда
				Продолжить;
			КонецЕсли;

			// Проверка: можно ли ВСЕ паллеты из B в A?
			СвободныхВA = 3 - ПаллетыА.Количество();
			Если ПаллетыБ.Количество() > СвободныхВA Тогда
				Продолжить;
			КонецЕсли;

			// Проверка габаритов: сумма ширин с зазором
			СуммаШиринА = 0;
			Для Каждого П Из ПаллетыА Цикл
				СуммаШиринА = СуммаШиринА + П.Ширина;
			КонецЦикла;
			СуммаШиринБ = 0;
			Для Каждого П Из ПаллетыБ Цикл
				СуммаШиринБ = СуммаШиринБ + П.Ширина;
			КонецЦикла;

			ШиринаСекции = ?(СекцияА.Свойство("typeSize_width"), СекцияА.typeSize_width, 2700);
			Зазор = 50; // ЗазорПоШирине по умолчанию
			НовоеКолво = ПаллетыА.Количество() + ПаллетыБ.Количество();
			НужнаяШирина = СуммаШиринА + СуммаШиринБ + (НовоеКолво + 1) * Зазор;
			Если НужнаяШирина > ШиринаСекции Тогда
				Продолжить;
			КонецЕсли;

			// Проверка высоты и веса
			ВысотаСекции = ?(СекцияА.Свойство("typeSize_height"), СекцияА.typeSize_height, 2100);
			МаксВес = ?(СекцияА.Свойство("typeSize_weight"), СекцияА.typeSize_weight, 0);
			БезлимВес = ?(СекцияА.Свойство("typeSize_unlimitedWeight"), СекцияА.typeSize_unlimitedWeight, Ложь);

			ВсегоВес = 0;
			Нарушение = Ложь;
			Для Каждого П Из ПаллетыА Цикл
				Если П.Высота > ВысотаСекции Тогда
					Нарушение = Истина;
					Прервать;
				КонецЕсли;
				ВсегоВес = ВсегоВес + П.Вес;
			КонецЦикла;

			Если НЕ Нарушение Тогда
				Для Каждого П Из ПаллетыБ Цикл
					Если П.Высота > ВысотаСекции Тогда
						Нарушение = Истина;
						Прервать;
					КонецЕсли;
					ВсегоВес = ВсегоВес + П.Вес;
				КонецЦикла;
			КонецЕсли;

			Если Нарушение Тогда
				Продолжить;
			КонецЕсли;

			Если НЕ БезлимВес И МаксВес > 0 И ВсегоВес > МаксВес Тогда
				Продолжить;
			КонецЕсли;

			// Кандидат найден!
			Moves = Новый Массив;
			// Назначаем свободные адреса в A для паллетов из B
			ЗанятыеАдресаА = Новый Массив;
			Для Каждого П Из ПаллетыА Цикл
				ЗанятыеАдресаА.Добавить(П.Адрес);
			КонецЦикла;

			Счетчик = 0;
			Для Каждого П Из ПаллетыБ Цикл
				// Найти свободный адрес в A
				ЦелевойАдрес = "";
				Для Номер = 1 По 3 Цикл
					Адр = СекцияА["address" + Номер];
					Если ЗанятыеАдресаА.Найти(Адр) = Неопределено Тогда
						ЦелевойАдрес = Адр;
						ЗанятыеАдресаА.Добавить(Адр);
						Прервать;
					КонецЕсли;
				КонецЦикла;

				Ход = Новый Структура;
				Ход.Вставить("Паллет", П.Паллет);
				Ход.Вставить("ОткудаАдрес", П.Адрес);
				Ход.Вставить("КудаАдрес", ЦелевойАдрес);
				Moves.Добавить(Ход);
				Счетчик = Счетчик + 1;
			КонецЦикла;

			Канд = Новый Структура;
			Канд.Вставить("Moves", Moves);
			Канд.Вставить("Cost", Moves.Количество());
			Канд.Вставить("Gain", 1); // одна секция B освобождается
			Канд.Вставить("Efficiency", 1.0 / Moves.Количество());
			Канд.Вставить("СекцияБ", ИдБ);
			Кандидаты.Добавить(Канд);
		КонецЦикла;
	КонецЦикла;

	// --- Сортировка по эффективности ---
	Для i = 0 По Кандидаты.Количество() - 2 Цикл
		Для j = i + 1 По Кандидаты.Количество() - 1 Цикл
			Если Кандидаты[i].Efficiency < Кандидаты[j].Efficiency Тогда
				Врем = Кандидаты[i];
				Кандидаты[i] = Кандидаты[j];
				Кандидаты[j] = Врем;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// --- Жадный отбор ---
	ИспользованоПеремещений = 0;
	ИспользованныеПаллеты = Новый Соответствие;
	ОсвобожденныеСекции = Новый Массив;

	Для Каждого Канд Из Кандидаты Цикл
		Если ИспользованоПеремещений + Канд.Cost > МаксПеремещений Тогда
			Продолжить;
		КонецЕсли;

		// Проверка что паллеты не участвуют в других перемещениях
		Конфликт = Ложь;
		Для Каждого М Из Канд.Moves Цикл
			Если ИспользованныеПаллеты.Получить(М.Паллет) <> Неопределено Тогда
				Конфликт = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Конфликт Тогда
			Продолжить;
		КонецЕсли;

		// Проверка что секция Б ещё не освобождена другим кандидатом
		Если ОсвобожденныеСекции.Найти(Канд.СекцияБ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Добавляем в план
		Для Каждого М Из Канд.Moves Цикл
			Результат.Moves.Добавить(М);
			ИспользованныеПаллеты.Вставить(М.Паллет, Истина);
		КонецЦикла;
		ИспользованоПеремещений = ИспользованоПеремещений + Канд.Cost;
		ОсвобожденныеСекции.Добавить(Канд.СекцияБ);
	КонецЦикла;

	// --- Статистика ---
	Stats = Новый Структура;
	Stats.Вставить("ИспользованоПеремещений", ИспользованоПеремещений);
	Stats.Вставить("ОсвобожденоСекций", ОсвобожденныеСекции.Количество());
	Stats.Вставить("КандидатовВсего", Кандидаты.Количество());

	Результат.Вставить("Stats", Stats);

	Возврат Результат;

КонецФункции


#КонецОбласти
