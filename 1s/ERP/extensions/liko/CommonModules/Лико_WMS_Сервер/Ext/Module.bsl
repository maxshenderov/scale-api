Функция WMS_FindCell(ПараметрыPOST) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Обёртка над существующей Лико_СкладскиеСекции.ПодобратьЯчейку(Все=Истина).
	//   Возвращает ВСЕ подходящие адреса для паллета с сортировкой по 13 приоритетам.
	//   Габариты паллета извлекаются из РегистрСведений.Лико_ПараметрыПаллет.
	//
	// ПАРАМЕТРЫ:
	//   warehouse — GUID склада
	//   pallet    — GUID паллета

	Если НЕ ПараметрыPOST.Свойство("warehouse") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM", "Не передан параметр 'warehouse'");
	КонецЕсли;
	Если НЕ ПараметрыPOST.Свойство("pallet") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM", "Не передан параметр 'pallet'");
	КонецЕсли;

	Склад = СсылкаПоСтрокеGUID(ПараметрыPOST.warehouse, "Справочник.Склады");
	Паллет = СсылкаПоСтрокеGUID(ПараметрыPOST.pallet, "Справочник.Лико_Паллеты2_0");

	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат HttpВернутьОшибку_WMS("INVALID_PARAM", "Склад не найден");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Паллет) Тогда
		Возврат HttpВернутьОшибку_WMS("INVALID_PARAM", "Паллет не найден");
	КонецЕсли;

	// Извлекаем габариты паллета через ПодобратьЯчейкуПоПаллету
	ТЗ = Лико_СкладскиеСекции.ПодобратьЯчейкуПоПаллету(Склад, Паллет, , , Истина);

	МассивКандидатов = Новый Массив;

	Для Каждого Стр Из ТЗ Цикл
		СтруктураКандидат = Новый Структура;
		СтруктураКандидат.Вставить("section", Строка(Стр.Секция.УникальныйИдентификатор()));
		СтруктураКандидат.Вставить("sectionCode", Стр.Код);
		СтруктураКандидат.Вставить("address", Строка(Стр.Адрес.УникальныйИдентификатор()));
		СтруктураКандидат.Вставить("addressCode", Стр.Адрес.Код);
		СтруктураКандидат.Вставить("rack", Строка(Стр.Стеллаж.УникальныйИдентификатор()));
		СтруктураКандидат.Вставить("floor", Стр.Этаж);
		СтруктураКандидат.Вставить("remainingHeight", Стр.ОстатокВысота);
		СтруктураКандидат.Вставить("remainingWidth", Стр.ОстатокШирина);
		СтруктураКандидат.Вставить("sectionPotential", Стр.ПотенциалСекции);
		СтруктураКандидат.Вставить("accessLevel", Стр.УровеньДоступа);
		СтруктураКандидат.Вставить("accessTime", Стр.ВремяДоступа);

		МассивКандидатов.Добавить(СтруктураКандидат);
	КонецЦикла;

	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ok", Истина);
	СтруктураОтвет.Вставить("candidates", МассивКандидатов);
	СтруктураОтвет.Вставить("totalCandidates", МассивКандидатов.Количество());

	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));

КонецФункции

Функция WMS_ValidatePlacement(ПараметрыPOST) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Проверяет можно ли поставить конкретный паллет в конкретную ячейку.
	//   Обёртка над Лико_СкладскиеСекции.ОшибкиРазмещенияПаллетаВАдрес().
	//   Используется при drag-and-drop для серверной валидации на drop.
	//
	// ПАРАМЕТРЫ:
	//   warehouse — GUID склада (для контекста, резерв)
	//   cell      — GUID ячейки (СкладскиеЯчейки)
	//   pallet    — GUID паллета

	Если НЕ ПараметрыPOST.Свойство("cell") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM", "Не передан параметр 'cell'");
	КонецЕсли;
	Если НЕ ПараметрыPOST.Свойство("pallet") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM", "Не передан параметр 'pallet'");
	КонецЕсли;

	Ячейка = СсылкаПоСтрокеGUID(ПараметрыPOST.cell, "Справочник.СкладскиеЯчейки");
	Паллет = СсылкаПоСтрокеGUID(ПараметрыPOST.pallet, "Справочник.Лико_Паллеты2_0");

	Если НЕ ЗначениеЗаполнено(Ячейка) Тогда
		Возврат HttpВернутьОшибку_WMS("INVALID_PARAM", "Ячейка не найдена");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Паллет) Тогда
		Возврат HttpВернутьОшибку_WMS("INVALID_PARAM", "Паллет не найден");
	КонецЕсли;

	Попытка
		МассивОшибок = Лико_СкладскиеСекции.ОшибкиРазмещенияПаллетаВАдрес(Ячейка, Паллет);
	Исключение
		Возврат HttpВернутьОшибку_WMS("VALIDATION_ERROR",
			"Ошибка при вызове ОшибкиРазмещенияПаллетаВАдрес: " + ОписаниеОшибки());
	КонецПопытки;

	Валидно = (МассивОшибок.Количество() = 0);

	// Форматируем ошибки в контракт { code, message }
	МассивОшибокФормат = Новый Массив;
	Для Каждого ТекстОшибки Из МассивОшибок Цикл
		СтруктураОшибка = Новый Структура;
		СтруктураОшибка.Вставить("code", "VALIDATION_RULE");
		СтруктураОшибка.Вставить("message", ТекстОшибки);
		МассивОшибокФормат.Добавить(СтруктураОшибка);
	КонецЦикла;

	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("ok", Истина);
	СтруктураОтвет.Вставить("valid", Валидно);
	СтруктураОтвет.Вставить("errors", МассивОшибокФормат);

	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));

КонецФункции

Функция WMS_MovePallet(ПараметрыPOST) Экспорт

	// НАЗНАЧЕНИЕ:
	//   Создаёт документ Лико_ПеремещениеПаллета2_0 для физического
	//   перемещения паллета в целевую ячейку. Проводит документ.
	//
	// ПАРАМЕТРЫ:
	//   warehouse  — GUID склада
	//   pallet     — GUID паллета
	//   targetCell — GUID целевой ячейки

	Если НЕ ПараметрыPOST.Свойство("warehouse")
	   ИЛИ НЕ ПараметрыPOST.Свойство("pallet")
	   ИЛИ НЕ ПараметрыPOST.Свойство("targetCell") Тогда
		Возврат HttpВернутьОшибку_WMS("MISSING_PARAM",
			"Необходимы параметры: warehouse, pallet, targetCell");
	КонецЕсли;

	Склад = СсылкаПоСтрокеGUID(ПараметрыPOST.warehouse, "Справочник.Склады");
	Паллет = СсылкаПоСтрокеGUID(ПараметрыPOST.pallet, "Справочник.Лико_Паллеты2_0");
	ЦелеваяЯчейка = СсылкаПоСтрокеGUID(ПараметрыPOST.targetCell, "Справочник.СкладскиеЯчейки");

	Если НЕ ЗначениеЗаполнено(Склад)
	   ИЛИ НЕ ЗначениеЗаполнено(Паллет)
	   ИЛИ НЕ ЗначениеЗаполнено(ЦелеваяЯчейка) Тогда
		Возврат HttpВернутьОшибку_WMS("INVALID_PARAM",
			"Не удалось найти склад/паллет/ячейку по переданным GUID");
	КонецЕсли;

	Попытка
		Док = Документы.Лико_ПеремещениеПаллета2_0.СоздатьДокумент();
		Док.Дата = ТекущаяДата();
		Док.Склад = Склад;
		Док.Паллет = Паллет;
		Док.ЦелеваяЯчейка = ЦелеваяЯчейка;
		Док.Записать(РежимЗаписиДокумента.Проведение);

		СтруктураОтвет = Новый Структура;
		СтруктураОтвет.Вставить("ok", Истина);
		СтруктураОтвет.Вставить("document", Строка(Док.УникальныйИдентификатор()));
		СтруктураОтвет.Вставить("message",
			"Паллет " + Паллет.Код + " → " + ЦелеваяЯчейка.Код);

		Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));

	Исключение
		Возврат HttpВернутьОшибку_WMS("MOVE_ERROR",
			"Ошибка при создании документа перемещения: " + ОписаниеОшибки());
	КонецПопытки;

КонецФункции

