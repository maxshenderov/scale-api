#Область LLM_Сообщения

&НаСервере
Процедура ДобавитьСообщение(Сообщения, Роль, Текст) Экспорт
    Сообщения.Добавить(Новый Структура("role, content", Роль, Текст));
КонецПроцедуры

// Возвращает в историю сообщение ассистента вместе с tool_calls.
// Без этого модель теряет связь между вызовом инструмента и его результатом.
&НаСервере
Процедура ДобавитьСообщениеАссистентаСВызовами(Сообщения, СообщениеИзОтвета) Экспорт
    Сообщение = Новый Структура;
    Сообщение.Вставить("role",    "assistant");
    // content может быть Null при чистом tool_calls — приводим к пустой строке.
    Содержимое = СообщениеИзОтвета["content"];
    Сообщение.Вставить("content", ?(Содержимое = Неопределено, "", Содержимое));
    Сообщение.Вставить("tool_calls", СообщениеИзОтвета["tool_calls"]);
    Сообщения.Добавить(Сообщение);
КонецПроцедуры

// Результат выполнения инструмента. content — всегда строка.
&НаСервере
Процедура ДобавитьРезультатИнструмента(Сообщения, IDВызова, РезультатСтрока) Экспорт
    Сообщение = Новый Структура;
    Сообщение.Вставить("role",         "tool");
    Сообщение.Вставить("tool_call_id", IDВызова);
    Сообщение.Вставить("content",      Строка(РезультатСтрока));
    Сообщения.Добавить(Сообщение);
КонецПроцедуры

#КонецОбласти



#Область LLM_JSON

&НаСервере
Функция СериализоватьJSON(Объект)
    З = Новый ЗаписьJSON;
    З.УстановитьСтроку();
    // НастройкиСериализацииJSON по умолчанию корректно обрабатывают
    // вложенные Структура / Массив / Соответствие.
    ЗаписатьJSON(З, Объект);
    Возврат З.Закрыть();
КонецФункции

&НаСервере
Функция ДесериализоватьJSON(Строка)
    Ч = Новый ЧтениеJSON;
    Ч.УстановитьСтроку(Строка);
    // ПрочитатьJSON(Ч, Ложь) → объекты как Структура (а не Соответствие),
    // что удобнее для доступа через точку и Свойство().
    Возврат ПрочитатьJSON(Ч, Ложь);
КонецФункции

&НаСервере
Функция РазобратьJSON(Строка)
    Если НЕ ЗначениеЗаполнено(Строка) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Попытка
        Возврат ДесериализоватьJSON2(Строка);
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

#КонецОбласти



#Область LLM_Оркестратор

// Основная точка входа. Сама прогоняет цикл tool_calls.
&НаСервере
Функция СпроситьLLM(Вопрос, Знач Параметры, Инструменты = Неопределено,
                    ФорматОтвета = "text", СистемныйПромпт = "", Контекст = Неопределено) Экспорт

    МаксИтераций = ПолучитьПараметр(Параметры, "МаксИтерацийИнструментов", 5);

    Сообщения = Новый Массив;

    // Системный промпт + инструкция по формату.
    ТекстСистемы = СистемныйПромпт + ИнструкцияФормата(ФорматОтвета);
    Если ЗначениеЗаполнено(ТекстСистемы) Тогда
        ДобавитьСообщение(Сообщения, "system", ТекстСистемы);
    КонецЕсли;

    ДобавитьСообщение(Сообщения, "user", СформироватьВопрос(Вопрос, Контекст));

    Для Итерация = 1 По МаксИтераций Цикл

        Тело = СформироватьТелоЗапроса(Сообщения, Инструменты, Параметры, ФорматОтвета);

        ОтветТранспорта = ОтправитьHTTP(
            Параметры.URLСервера, Параметры.Путь, Параметры.КлючAPI,
            Тело, ПолучитьПараметр(Параметры, "Таймаут", 120));

        Если НЕ ОтветТранспорта.Успех Тогда
            Результат = НовыйРезультатLLM();
            Результат.ОписаниеОшибки = ОтветТранспорта.ОписаниеОшибки;
            Возврат Результат;
        КонецЕсли;

        Результат = НормализоватьОтвет(ОтветТранспорта.Данные, ФорматОтвета);

        // Нет вызовов инструментов — финальный ответ.
        Если Результат.ВызовыИнструментов.Количество() = 0 Тогда
            Возврат Результат;
        КонецЕсли;

        // Есть tool_calls: возвращаем сообщение ассистента в историю,
        // затем выполняем каждый инструмент и добавляем его результат.
        СообщениеАссистента = ОтветТранспорта.Данные["choices"][0]["message"];
        ДобавитьСообщениеАссистентаСВызовами(Сообщения, СообщениеАссистента);

        Для Каждого Вызов Из Результат.ВызовыИнструментов Цикл
            РезультатИнструмента = ВыполнитьИнструмент(Вызов.Имя, Вызов.Аргументы);
            ДобавитьРезультатИнструмента(Сообщения, Вызов.ID, РезультатИнструмента);
        КонецЦикла;

        // Переходим к следующей итерации — модель получит результаты.
    КонецЦикла;

    // Превышен лимит итераций.
    Результат = НовыйРезультатLLM();
    Результат.ОписаниеОшибки = "Превышен лимит итераций инструментов ("
        + МаксИтераций + "). Возможна циклическая вызов-зависимость.";
    Возврат Результат;
КонецФункции

