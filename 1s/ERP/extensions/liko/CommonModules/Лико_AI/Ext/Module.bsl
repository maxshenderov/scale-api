#Область LLM_Внутренние

&НаСервере
Функция СформироватьТелоЗапроса(ИсторияСообщений, Инструменты, Параметры, ФорматОтвета)
    Тело = Новый Структура;
    Тело.Вставить("model",       Параметры.МодельID);
    Тело.Вставить("messages",    ИсторияСообщений);
    Тело.Вставить("temperature", ПолучитьПараметр(Параметры, "Температура", 0.1));
    Тело.Вставить("max_tokens",  ПолучитьПараметр(Параметры, "МаксТокенов", 4096));

    Если Инструменты <> Неопределено И Инструменты.Количество() > 0 Тогда
        // Инструменты имеют приоритет — несовместимы с response_format
        Тело.Вставить("tools",       Инструменты);
        Тело.Вставить("tool_choice", "auto");
    ИначеЕсли ФорматОтвета = "json" Тогда
        РФ = Новый Структура("type", "json_object");
        Тело.Вставить("response_format", РФ);
    КонецЕсли;
    // markdown / html / text — инструкция уже добавлена в system через ИнструкцияФормата()

    Возврат Тело;
КонецФункции

&НаСервере
Функция НормализоватьОтвет2(Данные, ФорматОтвета)
    Результат = НовыйРезультатLLM();
    Выбор     = Данные["choices"][0];
    Сообщение = Выбор["message"];

    Результат.Успех        = Истина;
    Результат.Роль         = Сообщение["role"];
    Результат.Причина      = Выбор["finish_reason"];
    Результат.ФорматОтвета = ФорматОтвета;
    Результат.Текст        = Сообщение["content"];

    // Для JSON дополнительно разбираем в структуру 1С
    Если ФорматОтвета = "json" И ЗначениеЗаполнено(Результат.Текст) Тогда
        Результат.Данные = РазобратьJSON(Результат.Текст);
    КонецЕсли;

    // Tool calls
    ВызовыИнструментов = Сообщение["tool_calls"];
    Если ВызовыИнструментов <> Неопределено Тогда
        Для Каждого ВызовИнструмента Из ВызовыИнструментов Цикл
            Элемент = Новый Структура;
            Элемент.Вставить("ID",        ВызовИнструмента["id"]);
            Элемент.Вставить("Имя",       ВызовИнструмента["function"]["name"]);
            Элемент.Вставить("Аргументы", РазобратьJSON(ВызовИнструмента["function"]["arguments"]));
            Результат.ВызовыИнструментов.Добавить(Элемент);
        КонецЦикла;
    КонецЕсли;

    // Токены
    Использование = Данные["usage"];
    Если Использование <> Неопределено Тогда
        Результат.ТокеныВход  = Использование["prompt_tokens"];
        Результат.ТокеныВыход = Использование["completion_tokens"];
    КонецЕсли;

    Возврат Результат;
КонецФункции

&НаСервере
Функция НормализоватьОтвет(Данные, ФорматОтвета)
    Результат = НовыйРезультатLLM();

    Выборы = Данные["choices"];
    Если Выборы = Неопределено ИЛИ Выборы.Количество() = 0 Тогда
        Результат.ОписаниеОшибки = "В ответе LLM отсутствует массив choices.";
        Возврат Результат;
    КонецЕсли;

    Выбор     = Выборы[0];
    Сообщение = Выбор["message"];

    Результат.Успех        = Истина;
    Результат.Роль         = Сообщение["role"];
    Результат.Причина      = Выбор["finish_reason"];
    Результат.ФорматОтвета = ФорматОтвета;
    Результат.Текст        = Сообщение["content"];

    Если ФорматОтвета = "json" И ЗначениеЗаполнено(Результат.Текст) Тогда
        Результат.Данные = РазобратьJSON(Результат.Текст);
    КонецЕсли;

    ВызовыИнструментов = Сообщение["tool_calls"];
    Если ВызовыИнструментов <> Неопределено Тогда
        Для Каждого ВызовИнструмента Из ВызовыИнструментов Цикл
            Элемент = Новый Структура;
            Элемент.Вставить("ID",        ВызовИнструмента["id"]);
            Элемент.Вставить("Имя",       ВызовИнструмента["function"]["name"]);
            Элемент.Вставить("Аргументы",
                РазобратьJSON(ВызовИнструмента["function"]["arguments"]));
            Результат.ВызовыИнструментов.Добавить(Элемент);
        КонецЦикла;
    КонецЕсли;

    Использование = Данные["usage"];
    Если Использование <> Неопределено Тогда
        Результат.ТокеныВход  = Использование["prompt_tokens"];
        Результат.ТокеныВыход = Использование["completion_tokens"];
    КонецЕсли;

    Возврат Результат;
КонецФункции


&НаСервере
Функция НовыйРезультатLLM()
    Р = Новый Структура;
    Р.Вставить("Успех",              Ложь);
    Р.Вставить("Роль",               "");
    Р.Вставить("Текст",              Неопределено); // сырая строка ответа
    Р.Вставить("Данные",             Неопределено); // разобранный JSON → структура 1С
    Р.Вставить("ФорматОтвета",       "text");
    Р.Вставить("ВызовыИнструментов", Новый Массив);
    Р.Вставить("Причина",            "");           // stop | tool_calls | length
    Р.Вставить("ТокеныВход",         0);
    Р.Вставить("ТокеныВыход",        0);
    Р.Вставить("ОписаниеОшибки",     "");
    Возврат Р;
КонецФункции

&НаСервере
Функция ИнструкцияФормата(ФорматОтвета)
    Если ФорматОтвета = "json" Тогда
        Возврат Символы.ПС + Символы.ПС
            + "Отвечай ТОЛЬКО валидным JSON без пояснений и markdown-блоков.";
    ИначеЕсли ФорматОтвета = "markdown" Тогда
        Возврат Символы.ПС + Символы.ПС
            + "Отвечай в формате Markdown: используй заголовки, списки, таблицы где уместно.";
    ИначеЕсли ФорматОтвета = "html" Тогда
        Возврат Символы.ПС + Символы.ПС
            + "Отвечай в формате HTML. Только содержимое <body>, без внешних тегов.";
    Иначе
        Возврат ""; // text — без инструкции
    КонецЕсли;
КонецФункции

&НаСервере
Функция СформироватьВопрос(Вопрос, Контекст)
    Если Контекст = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Контекст) Тогда
        Возврат Вопрос;
    КонецЕсли;
    Возврат Вопрос
        + Символы.ПС + Символы.ПС
        + "=== ДАННЫЕ ===" + Символы.ПС
        + Контекст;
КонецФункции

&НаСервере
Процедура ДобавитьСообщение2(Сообщения, Роль, Текст)
    Сообщения.Добавить(Новый Структура("role, content", Роль, Текст));
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметр(Параметры, Имя, ЗначениеПоУмолчанию)
    Если Параметры.Свойство(Имя) И ЗначениеЗаполнено(Параметры[Имя]) Тогда
        Возврат Параметры[Имя];
    КонецЕсли;
    Возврат ЗначениеПоУмолчанию;
КонецФункции

&НаСервере
Функция СериализоватьJSON2(Объект)
    З = Новый ЗаписьJSON;
    З.УстановитьСтроку();
    ЗаписатьJSON(З, Объект);
    Возврат З.Закрыть();
КонецФункции

&НаСервере
Функция ДесериализоватьJSON2(Строка)
    Ч = Новый ЧтениеJSON;
    Ч.УстановитьСтроку(Строка);
    Возврат ПрочитатьJSON(Ч);
КонецФункции

&НаСервере
Функция РазобратьJSON2(Строка)
