// =============================================================
// МОДУЛЬ: LLM_Клиент
// Универсальный клиент для работы с LLM через OpenAI-совместимый роутер
// =============================================================

#Область LLM_ТочкаВхода

// -------------------------------------------------------------
// Основной запрос к LLM
// Параметры:
//   ИсторияСообщений — Массив структур {role, content}
//   Инструменты      — Массив инструментов или Неопределено
//   ПараметрыПровайдера:
//     .URLСервера  — хост роутера
//     .ПутьКAPI    — путь, например /v1/chat/completions
//     .КлючAPI     — Bearer-токен
//     .МодельID    — идентификатор модели
//     .Температура — (опц.) 0..1, по умолчанию 0.1
//     .МаксТокенов — (опц.) по умолчанию 4096
//     .Таймаут     — (опц.) секунды, по умолчанию 120
//   ФорматОтвета   — "text" | "json" | "markdown" | "html"
// Возвращает: см. НовыйРезультатLLM()
// -------------------------------------------------------------
&НаСервере
Функция ЗапросLLM(ИсторияСообщений, Инструменты, ПараметрыПровайдера, ФорматОтвета = "text") Экспорт
    Результат = НовыйРезультатLLM();
    Попытка
        Тело = СформироватьТелоЗапроса(ИсторияСообщений, Инструменты, ПараметрыПровайдера, ФорматОтвета);

        ОтветHTTP = ОтправитьHTTP(
            ПараметрыПровайдера.URLСервера,
            ПараметрыПровайдера.ПутьКAPI,
            ПараметрыПровайдера.КлючAPI,
            Тело,
            ПолучитьПараметр(ПараметрыПровайдера, "Таймаут", 120)
        );

        Если НЕ ОтветHTTP.Успех Тогда
            Результат.ОписаниеОшибки = ОтветHTTP.ОписаниеОшибки;
            Возврат Результат;
        КонецЕсли;

        Результат = НормализоватьОтвет(ОтветHTTP.Данные, ФорматОтвета);

    Исключение
        Результат.ОписаниеОшибки = ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("LLM.Ошибка", УровеньЖурналаРегистрации.Ошибка, , , Результат.ОписаниеОшибки);
    КонецПопытки;
    Возврат Результат;
КонецФункции

// -------------------------------------------------------------
// Цикл запросов с автоматическим выполнением инструментов
// ДиспетчерИнструментов — имя экспортной функции которая
//   принимает (Имя, Аргументы) и возвращает строку результата
// -------------------------------------------------------------
&НаСервере
Функция ВыполнитьЦиклLLM(Сообщения, Инструменты, ПараметрыПровайдера, ФорматОтвета = "text") Экспорт
    МаксИтераций = 10; // защита от бесконечного цикла
    Итерация = 0;

    Пока Итерация < МаксИтераций Цикл
        Итерация = Итерация + 1;

        Результат = ЗапросLLM(Сообщения, Инструменты, ПараметрыПровайдера, ФорматОтвета);

        Если НЕ Результат.Успех Тогда
            Возврат Результат;
        КонецЕсли;

        // LLM ответила текстом — готово
        Если Результат.ВызовыИнструментов.Количество() = 0 Тогда
            Возврат Результат;
        КонецЕсли;

        // LLM просит инструменты — выполняем
        ДобавитьСообщение(Сообщения, "assistant", Результат.Текст);

        Для Каждого Вызов Из Результат.ВызовыИнструментов Цикл
            РезультатИнструмента = ВыполнитьИнструмент(Вызов.Имя, Вызов.Аргументы);

            ToolResult = Новый Структура;
            ToolResult.Вставить("role",        "tool");
            ToolResult.Вставить("tool_call_id", Вызов.ID);
            ToolResult.Вставить("content",      РезультатИнструмента);
            Сообщения.Добавить(ToolResult);
        КонецЦикла;

    КонецЦикла;

    Результат.ОписаниеОшибки = "Превышено максимальное количество итераций инструментов";
    Возврат Результат;
КонецФункции

#КонецОбласти

#Область LLM_Компоновка

// -------------------------------------------------------------
// Компоновка массива messages для LLM
// Параметры:
//   Задача        — строка, системная инструкция (role: system)
//   Память        — строка, контекст сессии (статика или динамика)
//                   Неопределено — не добавляется
//   История       — Массив структур {Роль, Текст} накопленный диалог
//                   Неопределено — не добавляется
//   Вопрос        — строка, текущий вопрос пользователя
//   Контекст      — строка, данные из БД к текущему вопросу
//                   Неопределено — не добавляется
//   ФорматОтвета  — "text" | "json" | "markdown" | "html"
// -------------------------------------------------------------
&НаСервере
Функция СкомпоноватьСообщения(Задача, Память, История, Вопрос,
                               Контекст = Неопределено,
                               ФорматОтвета = "text") Экспорт
    Сообщения = Новый Массив;

    // 1. SYSTEM — инструкция + формат ответа
    ДобавитьСообщение(Сообщения, "system", Задача + ИнструкцияФормата(ФорматОтвета));

    // 2. ПАМЯТЬ — отдельной парой до истории
    //    user/assistant чтобы соблюсти чередование ролей
    Если Память <> Неопределено И ЗначениеЗаполнено(Память) Тогда
        ДобавитьСообщение(Сообщения, "user",      "=== ПАМЯТЬ ===" + Символы.ПС + Память);
        ДобавитьСообщение(Сообщения, "assistant", "Контекст принят.");
    КонецЕсли;

    // 3. ИСТОРИЯ — накопленные пары предыдущего диалога
    Если История <> Неопределено Тогда
        Для Каждого Сообщение Из История Цикл
            ДобавитьСообщение(Сообщения, Сообщение.Роль, Сообщение.Текст);
        КонецЦикла;
    КонецЕсли;

    // 4. ВОПРОС + КОНТЕКСТ из БД — всегда последним
    ДобавитьСообщение(Сообщения, "user", СформироватьВопрос(Вопрос, Контекст));

    Возврат Сообщения;
КонецФункции

// Добавить пару user+assistant в историю после ответа LLM
&НаСервере
Процедура ЗаписатьВИсторию(История, ВопросПользователя, ОтветLLM) Экспорт
    История.Добавить(Новый Структура("Роль, Текст", "user",      ВопросПользователя));
    История.Добавить(Новый Структура("Роль, Текст", "assistant", ОтветLLM));
КонецПроцедуры

#КонецОбласти

#Область LLM_Инструменты

// -------------------------------------------------------------
// Создать новый инструмент (функцию для LLM)
// Параметры:
//   Имя       — техническое имя функции (snake_case)
//   Описание  — что делает и что ВОЗВРАЩАЕТ функция
// -------------------------------------------------------------
&НаСервере
Функция НовыйИнструмент(Имя, Описание) Экспорт
    Параметры = Новый Структура;
    Параметры.Вставить("type",       "object");
    Параметры.Вставить("properties", Новый Структура);
    Параметры.Вставить("required",   Новый Массив);

    Функция_ = Новый Структура;
    Функция_.Вставить("name",        Имя);
    Функция_.Вставить("description", Описание);
    Функция_.Вставить("parameters",  Параметры);

    Инструмент = Новый Структура;
    Инструмент.Вставить("type",     "function");
    Инструмент.Вставить("function", Функция_);
    Возврат Инструмент;
КонецФункции

// -------------------------------------------------------------
// Добавить параметр к инструменту
// Типы: "string" | "integer" | "number" | "boolean" | "date" | "datetime"
// -------------------------------------------------------------
&НаСервере
Процедура ДобавитьПараметр(Инструмент, Имя, Тип, Описание, Обязательный = Истина) Экспорт
    Свойство = Новый Структура;

    Если Тип = "string" Тогда
        Свойство.Вставить("type",        "string");
        Свойство.Вставить("description", Описание);

    ИначеЕсли Тип = "integer" Тогда
        Свойство.Вставить("type",        "integer");
        Свойство.Вставить("description", Описание);

    ИначеЕсли Тип = "number" Тогда
        Свойство.Вставить("type",        "number");
        Свойство.Вставить("description", Описание);

    ИначеЕсли Тип = "boolean" Тогда
        Свойство.Вставить("type",        "boolean");
        Свойство.Вставить("description", Описание);

    ИначеЕсли Тип = "date" Тогда
        Свойство.Вставить("type",        "string");
        Свойство.Вставить("format",      "date");
        Свойство.Вставить("description", Описание + " (формат YYYY-MM-DD)");

    ИначеЕсли Тип = "datetime" Тогда
        Свойство.Вставить("type",        "string");
        Свойство.Вставить("format",      "date-time");
        Свойство.Вставить("description", Описание + " (формат YYYY-MM-DDTHH:MM:SS)");

    Иначе
        ВызватьИсключение "ДобавитьПараметр: неизвестный тип """ + Тип + """";
    КонецЕсли;

    Инструмент.function.parameters.properties.Вставить(Имя, Свойство);
    Если Обязательный Тогда
        Инструмент.function.parameters.required.Добавить(Имя);
    КонецЕсли;
КонецПроцедуры

// -------------------------------------------------------------
// Добавить параметр-перечисление
// ДопустимыеЗначения — Массив строк, например ["A", "B", "C"]
// -------------------------------------------------------------
&НаСервере
Процедура ДобавитьПараметрEnum(Инструмент, Имя, Описание, ДопустимыеЗначения, Обязательный = Истина) Экспорт
    Свойство = Новый Структура;
    Свойство.Вставить("type",        "string");
    Свойство.Вставить("description", Описание);
    Свойство.Вставить("enum",        ДопустимыеЗначения);

    Инструмент.function.parameters.properties.Вставить(Имя, Свойство);
    Если Обязательный Тогда
        Инструмент.function.parameters.required.Добавить(Имя);
    КонецЕсли;
КонецПроцедуры

// -------------------------------------------------------------
// Добавить параметр-массив
// ТипЭлементов — тип элементов массива: "string" | "integer" и т.д.
// -------------------------------------------------------------
&НаСервере
Процедура ДобавитьПараметрМассив(Инструмент, Имя, Описание, ТипЭлементов = "string", Обязательный = Истина) Экспорт
    Свойство = Новый Структура;
    Свойство.Вставить("type",        "array");
    Свойство.Вставить("description", Описание);
    Свойство.Вставить("items",       Новый Структура("type", ТипЭлементов));

    Инструмент.function.parameters.properties.Вставить(Имя, Свойство);
    Если Обязательный Тогда
        Инструмент.function.parameters.required.Добавить(Имя);
    КонецЕсли;
КонецПроцедуры


