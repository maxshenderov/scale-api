// -------------------------------------------------------------
// Конвертация ТаблицыЗначений в строку для передачи в LLM
// Формат: "markdown" (по умолчанию) | "json"
// Markdown — меньше токенов, лучше для рассуждений
// JSON     — лучше если данные нужны для дальнейшей обработки
// -------------------------------------------------------------
&НаСервере
Функция ТаблицаДляLLM2(ТаблицаЗначений, Формат = "markdown") Экспорт
    Если ТаблицаЗначений.Количество() = 0 Тогда
        Возврат "Данные не найдены.";
    КонецЕсли;

    Если Формат = "json" Тогда
        Возврат ТаблицаВJSON(ТаблицаЗначений);
    Иначе
        Возврат ТаблицаВМаркдаун(ТаблицаЗначений);
    КонецЕсли;
КонецФункции

&НаСервере
Функция ТаблицаВМаркдаун2(ТаблицаЗначений)
    Заголовки  = Новый Массив;
    Разделители = Новый Массив;
    Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
        Заголовки.Добавить(Колонка.Имя);
        Разделители.Добавить("---");
    КонецЦикла;

    Строки = Новый Массив;
    Строки.Добавить("| " + СтрСоединить(Заголовки,    " | ") + " |");
    Строки.Добавить("| " + СтрСоединить(Разделители,  " | ") + " |");

    Для Каждого Строка Из ТаблицаЗначений Цикл
        Ячейки = Новый Массив;
        Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
            Ячейки.Добавить(Строка[Колонка.Имя]);
        КонецЦикла;
        Строки.Добавить("| " + СтрСоединить(Ячейки, " | ") + " |");
    КонецЦикла;

    Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

&НаСервере
Функция ТаблицаВJSON2(ТаблицаЗначений)
    Массив = Новый Массив;
    Для Каждого Строка Из ТаблицаЗначений Цикл
        Элемент = Новый Структура;
        Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
            Элемент.Вставить(Колонка.Имя, Строка[Колонка.Имя]);
        КонецЦикла;
        Массив.Добавить(Элемент);
    КонецЦикла;
    Возврат СериализоватьJSON(Массив);
КонецФункции

#КонецОбласти 


#Область LLM_ФорматыДанных

&НаСервере
Функция ТаблицаДляLLM(ТаблицаЗначений, Формат = "markdown") Экспорт
    Если ТаблицаЗначений.Количество() = 0 Тогда
        Возврат "Данные не найдены.";
    КонецЕсли;
    Если Формат = "json" Тогда
        Возврат ТаблицаВJSON(ТаблицаЗначений);
    Иначе
        Возврат ТаблицаВМаркдаун(ТаблицаЗначений);
    КонецЕсли;
КонецФункции

&НаСервере
Функция ЗначениеВТекст(Значение)
    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Текст = Строка(Значение);
    // Экранируем символы, ломающие markdown-таблицу, и переносы строк.
    Текст = СтрЗаменить(Текст, "|", "\|");
    Текст = СтрЗаменить(Текст, Символы.ПС, " ");
    Текст = СтрЗаменить(Текст, Символы.ВК, "");
    Возврат СокрЛП(Текст);
КонецФункции

&НаСервере
Функция ТаблицаВМаркдаун(ТаблицаЗначений)
    Заголовки   = Новый Массив;
    Разделители = Новый Массив;
    Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
        Заголовки.Добавить(Колонка.Имя);
        Разделители.Добавить("---");
    КонецЦикла;

    Строки = Новый Массив;
    Строки.Добавить("| " + СтрСоединить(Заголовки,   " | ") + " |");
    Строки.Добавить("| " + СтрСоединить(Разделители, " | ") + " |");

    Для Каждого Строка Из ТаблицаЗначений Цикл
        Ячейки = Новый Массив;
        Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
            Ячейки.Добавить(ЗначениеВТекст(Строка[Колонка.Имя]));
        КонецЦикла;
        Строки.Добавить("| " + СтрСоединить(Ячейки, " | ") + " |");
    КонецЦикла;

    Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

&НаСервере
Функция ТаблицаВJSON(ТаблицаЗначений)
    Массив = Новый Массив;
    Для Каждого Строка Из ТаблицаЗначений Цикл
        Элемент = Новый Структура;
        Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
            Значение = Строка[Колонка.Имя];
            // Даты приводим к ISO-строке, иначе сериализуются неоднозначно.
            Если ТипЗнч(Значение) = Тип("Дата") Тогда
                Значение = ?(ЗначениеЗаполнено(Значение),
                    Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss"), "");
            КонецЕсли;
            Элемент.Вставить(Колонка.Имя, Значение);
        КонецЦикла;
        Массив.Добавить(Элемент);
    КонецЦикла;
    Возврат СериализоватьJSON(Массив);
КонецФункции

#КонецОбласти

#Область LLM_Транспорт2

&НаСервере
Функция ОтправитьHTTP2(URLСервера, Путь, КлючAPI, Тело, Таймаут)
    Результат = Новый Структура("Успех, Данные, ОписаниеОшибки", Ложь, Неопределено, "");
    Попытка
        Заголовки = Новый Соответствие;
        Заголовки.Вставить("Content-Type",  "application/json");
        Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);

        HTTPСоединение = Новый HTTPСоединение(
            URLСервера, 443, , , , Таймаут, Новый ЗащищенноеСоединениеOpenSSL());

        HTTPЗапрос = Новый HTTPЗапрос(Путь, Заголовки);
        HTTPЗапрос.УстановитьТелоИзСтроки(СериализоватьJSON(Тело), "UTF-8");

        ОтветHTTP  = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
        ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");

        Если ОтветHTTP.КодСостояния < 200 ИЛИ ОтветHTTP.КодСостояния >= 300 Тогда
            Результат.ОписаниеОшибки = "HTTP " + ОтветHTTP.КодСостояния + ": " + ТелоОтвета;
            ЗаписьЖурналаРегистрации("LLM.Ошибка", УровеньЖурналаРегистрации.Ошибка, , , Результат.ОписаниеОшибки);
            Возврат Результат;
        КонецЕсли;

        Результат.Данные = ДесериализоватьJSON(ТелоОтвета);
        Результат.Успех  = Истина;
    Исключение
        Результат.ОписаниеОшибки = ОписаниеОшибки();
    КонецПопытки;
    Возврат Результат;
КонецФункции

#Область LLM_Транспорт

&НаСервере
Функция ОтправитьHTTP(URLСервера, Путь, КлючAPI, Тело, Таймаут)
    Результат = Новый Структура("Успех, Данные, ОписаниеОшибки", Ложь, Неопределено, "");

    // --- Защита от двойной сериализации ---
    // В ОтправитьHTTP ВСЕГДА должна приходить Структура, а не готовая JSON-строка.
    Если ТипЗнч(Тело) = Тип("Строка") Тогда
        Результат.ОписаниеОшибки =
            "ОтправитьHTTP: в параметр Тело передана Строка вместо Структуры."
            + " Уберите повторный вызов СериализоватьJSON выше по стеку.";
        Возврат Результат;
    КонецЕсли;

    Попытка
        Заголовки = Новый Соответствие;
        Заголовки.Вставить("Content-Type",  "application/json");
        Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);

        HTTPСоединение = Новый HTTPСоединение(
            URLСервера, 443, , , , Таймаут, Новый ЗащищенноеСоединениеOpenSSL());

        HTTPЗапрос = Новый HTTPЗапрос(Путь, Заголовки);
        // Сериализация выполняется РОВНО ОДИН РАЗ — здесь.
        HTTPЗапрос.УстановитьТелоИзСтроки(СериализоватьJSON(Тело), "UTF-8");

        ОтветHTTP  = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
        ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");

        Если ОтветHTTP.КодСостояния < 200 ИЛИ ОтветHTTP.КодСостояния >= 300 Тогда
            Результат.ОписаниеОшибки = "HTTP " + ОтветHTTP.КодСостояния + ": " + ТелоОтвета;
            ЗаписьЖурналаРегистрации("LLM.Ошибка",
                УровеньЖурналаРегистрации.Ошибка, , , Результат.ОписаниеОшибки);
            Возврат Результат;
        КонецЕсли;

        Результат.Данные = ДесериализоватьJSON(ТелоОтвета);
        Результат.Успех  = Истина;
    Исключение
        Результат.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ЗаписьЖурналаРегистрации("LLM.Исключение",
            УровеньЖурналаРегистрации.Ошибка, , , Результат.ОписаниеОшибки);
    КонецПопытки;

    Возврат Результат;
КонецФункции

