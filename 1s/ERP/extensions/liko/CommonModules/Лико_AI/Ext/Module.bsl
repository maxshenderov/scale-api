   Возврат Провайдеры;

КонецФункции 

Функция СписокМоделей(Провайдер) Экспорт 
		
	Провайдеры=Провайдеры();
	
	ПараметрыПровайдера=Провайдеры[Провайдер];
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	
	URLСервера = ПараметрыПровайдера.URLСервера;
	Порт = 443;
	КлючAPI = ПараметрыПровайдера.КлючAPI;

	
	// Создаём HTTP-соединение
	Соединение = Новый HTTPСоединение(
	URLСервера,
	Порт,
	,       // Пользователь
	,       // Пароль
	,       // Прокси
	30,     // Таймаут
	ЗащищенноеСоединение // HTTPS
	);
	
	// Создаём запрос
	Запрос = Новый HTTPЗапрос("/api/v1/models");
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	
	// Выполняем GET-запрос
	Ответ = Соединение.Получить(Запрос);
	
	// Разбираем ответ
	Если Ответ.КодСостояния = 200 Тогда
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
		Данные = ПрочитатьJSON(ЧтениеJSON);
		
		// Данные.data — массив моделей 
		Возврат Данные.data;
	КонецЕсли;
КонецФункции  

Функция ПараметрыПровайдера( ПровайдерИмя = Неопределено, МодельИмя = Неопределено) Экспорт
    
        ПровайдерПоУмолчанию = ПровайдерПоУмолчанию();   
        // Получаем параметры провайдера и модели
        ПровайдерыВсе = Провайдеры();
        Если ПровайдерИмя = Неопределено ИЛИ НЕ ПровайдерыВсе.Свойство(ПровайдерИмя) Тогда
            ПровайдерИмя = ПровайдерПоУмолчанию.Имя; // по умолчанию
        КонецЕсли;
        ПараметрыПровайдера = ПровайдерыВсе[ПровайдерИмя];
        
        // МодельID
        СтруктураМоделей = МоделиLLM(ПровайдерИмя);
        МодельID = ПровайдерПоУмолчанию.МодельID; // по умолчанию
        Если МодельИмя <> Неопределено Тогда
            ДанныеМодели =ПровайдерПоУмолчанию;
            Если ДанныеМодели <> Неопределено Тогда
                МодельID = ДанныеМодели.МодельID;
            КонецЕсли;
        КонецЕсли;
        ПараметрыПровайдера.Вставить("МодельID", МодельID);
        
    Возврат ПараметрыПровайдера;             
КонецФункции 

Функция МоделиLLM(Провайдер) Экспорт
	
	Соответствие = Новый Соответствие; 
	
	// OpenAI модели 
	
	
	
	МассивМоделей=СписокМоделей(Провайдер);
	
	Для каждого ПараметрыМодели  Из МассивМоделей Цикл
		
		Соответствие.Вставить(ПараметрыМодели.name, Новый Структура("МодельID,Описание", ПараметрыМодели.id, ПараметрыМодели.description));
		
	КонецЦикла; 
	
	Возврат Соответствие;

КонецФункции  

