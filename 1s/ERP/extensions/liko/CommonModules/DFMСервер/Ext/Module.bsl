Функция ПолучитьТехнологиюПечати(Объект) Экспорт//+Лико m.shenderov 14.06.2021
	Если Объект.Площадка=Справочники.Лико_ПредопределенныеЗначения.ОрганизацияИксПак.ЗначениеПараметра Тогда
		Для каждого РабочийЦентр Из Объект.РабочиеЦентры Цикл
			
			Если РабочийЦентр.ВидРабочегоЦентра= Справочники.ВидыРабочихЦентров.Comexi Тогда 
				Возврат ПолучитьТехнологиюПечатиComexi(Объект.ВидыПечати);			
			КонецЕсли;
		КонецЦикла; 
		Возврат  Справочники.Лико_ТехнологияПечати.ПустаяСсылка(); 
	КонецЕсли;
	
	Возврат Объект.РабочийЦентр.ВидРабочегоЦентра.лкТехнологияПечати; 
КонецФункции  //-Лико m.shenderov 14.06.2021

Функция ПолучитьТехнологиюПечатиComexi(ВидыПечати) Экспорт  //+Лико m.shenderov 15.03.2022
	Глубокая	= Ложь;
	Офсет		= Ложь;
	Флексо		= Ложь;   
	Для каждого ВидПечати Из ВидыПечати Цикл  
		Если ВидПечати=Перечисления.Лико_ВидыПечати.Глубокая Тогда
			Глубокая=Истина;
		ИначеЕсли  ВидПечати=Перечисления.Лико_ВидыПечати.Офсет Тогда
			Офсет = Истина;
		ИначеЕсли  ВидПечати=Перечисления.Лико_ВидыПечати.Флексо Тогда
			Флексо = Истина; 
		КонецЕсли;	
	КонецЦикла; 
	
	Если Глубокая И Офсет И Флексо Тогда 
		Возврат Справочники.Лико_ТехнологияПечати.Офсет_Флексо_Глубокая;
	ИначеЕсли Глубокая И Офсет  Тогда 
		Возврат Справочники.Лико_ТехнологияПечати.Офсет_Глубокая; 
	ИначеЕсли Глубокая И Флексо  Тогда 
		Возврат Справочники.Лико_ТехнологияПечати.Флексо_Глубокая;
	ИначеЕсли Офсет И Флексо  Тогда 
		Возврат Справочники.Лико_ТехнологияПечати.Офсет_Флексо;
	ИначеЕсли  Офсет  Тогда 
		Возврат Справочники.Лико_ТехнологияПечати.Офсет;
	ИначеЕсли  Глубокая  Тогда 
		Возврат Справочники.Лико_ТехнологияПечати.Глубокая;
	КонецЕсли;

	Возврат Справочники.Лико_ТехнологияПечати.ПустаяСсылка();
	
КонецФункции //-Лико m.shenderov 15.03.2022 


Функция СоздатьНоменклатуру(Параметры) Экспорт //+Лико m.shenderov 14.06.2021
	Возврат Справочники.Лико_ВерсииНоменклатуры.СоздатьНоменклатуру(
				Параметры.Товар.Номенклатура.Наименование,
				Параметры.Товар.Номенклатура.Лико_ТипЭтикетки,
				//Параметры.ТехнологияПечати,
				Параметры.Товар.ВерсияНоменклатуры.Версия,
				Параметры.Регион,
				Параметры.Партнер,
				Параметры.Менеджер,
				?(Параметры.Товар.УведомитьДизайнера,Параметры.Товар.Дизайнер,Неопределено),
				Истина,
				Параметры.Товар.Номенклатура,
				,
				,
				Параметры.Заказ,
				Параметры.Комментарий
				);
	
КонецФункции //-Лико m.shenderov 14.06.2021 

Процедура УстановитьВидимость300125(Форма,Группа="DFMGroupButtons") Экспорт //+Лико m.shenderov 14.06.2021
	Форма.Элементы.НоменклатураDFM.Видимость = Ложь;
	////КонецЕсли;
	
	Если Форма.ДатаНачалаСозданияНоменклатурыDFM И Форма.Объект.НоменклатураDFM Или Форма.ПоказатьDFM Тогда 
		Форма.Элементы[Группа].Видимость=Истина;
		Форма.Элементы.УведомитьДизайнераDFM2.Доступность=Ложь;
		форма.Элементы.ТоварыАртикул.ТолькоПросмотр=Ложь;
 
		Для каждого Товар Из Форма.Объект.Товары Цикл
			Если ЗначениеЗаполнено(Товар.ВерсияНоменклатуры) Тогда
				Форма.Элементы.УведомитьДизайнераDFM2.Доступность=Истина;
			КонецЕсли; 		
			
		КонецЦикла;
		Если Форма.Объект.Площадка<>Справочники.Лико_Площадки.Линкс 
			И  Форма.Объект.ВидЗаказа=Перечисления.Лико_ВидыЗаказов.ПолныйПовтор Тогда 
			//Форма.Элементы[Группа].Доступность      =Ложь;
			Форма.Элементы.СоздатьНоменклатуруDFM2.Доступность=Ложь;
			Форма.Элементы.СоздатьВерсиюDFM2.Доступность=Ложь; 		
			форма.Элементы.ТоварыАртикул.ТолькоПросмотр=Истина;
			
		КонецЕсли;
		
		Если  Форма.ПоказатьDFM Тогда
			Форма.Элементы.УведомитьДизайнераDFM2.Доступность=Истина;
			Форма.Элементы.СоздатьВерсиюDFM2.Доступность=Истина; 		
			форма.Элементы.ТоварыАртикул.ТолькоПросмотр=Ложь; 
			Форма.Элементы.СоздатьНоменклатуруDFM2.Доступность=Истина;
			
		КонецЕсли; 	
		
	Иначе
		Форма.Элементы[Группа].Видимость=Ложь;
	КонецЕсли;	
	
КонецПроцедуры //-Лико m.shenderov 14.06.2021

