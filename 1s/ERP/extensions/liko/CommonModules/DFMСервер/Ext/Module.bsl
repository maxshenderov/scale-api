Функция ВерсияНоменклатурыСтруктура(ВерсияНоменклатуры) Экспорт  //+Лико m.shenderov 09.12.2025
  Структура = Новый Структура;
  Структура.Вставить("ФайлСогласования");
  Структура.Вставить("Согласовано");
   Структура.Вставить("Артикул");
