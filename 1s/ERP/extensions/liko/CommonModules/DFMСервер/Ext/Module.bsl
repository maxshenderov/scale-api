Процедура УстановитьВидимостьСтар(Форма,Группа="DFMGroupButtons") Экспорт //+Лико m.shenderov 14.06.2021
	Форма.Элементы.НоменклатураDFM.Видимость = Ложь;
	////КонецЕсли;
	
	Если Форма.ДатаНачалаСозданияНоменклатурыDFM И Форма.Объект.НоменклатураDFM Тогда 
		Форма.Элементы[Группа].Видимость=Истина;
		Форма.Элементы.УведомитьДизайнераDFM2.Доступность=Ложь;
		форма.Элементы.ТоварыАртикул.ТолькоПросмотр=Ложь;
 
		Для каждого Товар Из Форма.Объект.Товары Цикл
			Если ЗначениеЗаполнено(Товар.ВерсияНоменклатуры) Тогда
				Форма.Элементы.УведомитьДизайнераDFM2.Доступность=Истина;
			КонецЕсли; 		
			
		КонецЦикла;
		Если Форма.Объект.ВидЗаказа=Перечисления.Лико_ВидыЗаказов.ПолныйПовтор Тогда 
			//Форма.Элементы[Группа].Доступность      =Ложь;
			Форма.Элементы.СоздатьНоменклатуруDFM2.Доступность=Ложь;
			Форма.Элементы.СоздатьВерсиюDFM2.Доступность=Ложь; 		
			форма.Элементы.ТоварыАртикул.ТолькоПросмотр=Истина;
			
		КонецЕсли;
		
	Иначе
		Форма.Элементы[Группа].Видимость=Ложь;
	КонецЕсли;	
	
КонецПроцедуры //-Лико m.shenderov 14.06.2021

