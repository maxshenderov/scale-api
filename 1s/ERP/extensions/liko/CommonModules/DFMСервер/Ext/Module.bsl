Процедура СоздатьВерсиюНоменклатурыДляТехнологииАвто(Форма,Массив) Экспорт //+Лико m.shenderov 28.05.2021
        
	Если Не DFMСервер.ПроверкаЗаполненияПолей(Форма) Тогда
		Возврат
	КонецЕсли;
		ТехнологияПечати=Форма.Объект.РабочийЦентр.ВидРабочегоЦентра.лкТехнологияПечати;

	
	     Для Каждого Товар Из Массив Цикл
			
			
				
				СтруктураНоменклатуры=Справочники.Лико_ВерсииНоменклатуры.СоздатьНоменклатуру(
				Товар.Номенклатура.Наименование,
				Товар.Номенклатура.Лико_ТипЭтикетки,
				ТехнологияПечати,
				Товар.ВерсияНоменклатуры.Версия,
				Форма.Объект.Регион,
				Форма.Объект.Партнер,
				Форма.Объект.Менеджер,
				?(Товар.УведомитьДизайнера,Товар.Дизайнер,Неопределено),
				Истина,
				Товар.Номенклатура,
				Товар.Объект.Ссылка,
				Товар.Комментарий
);
				
				НайденныеСтроки = Форма.Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура",Товар.Номенклатура));
				Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					
				
				НайденнаяСтрока.Артикул =СтруктураНоменклатуры.ВерсияНоменклатуры.Артикул;
				НайденнаяСтрока.Версия  =СтруктураНоменклатуры.Версия;
				НайденнаяСтрока.ВерсияНоменклатуры=СтруктураНоменклатуры.ВерсияНоменклатуры;
				КонецЦикла;

			//КонецЕсли;
			
				
		КонецЦикла;


		
КонецПроцедуры //-Лико m.shenderov 28.05.2021

Функция ВыполнитьПроверкуТехнологииПродукта(Форма) Экспорт 
	
	РЦ=Форма.Объект.РабочийЦентр;
	Отказ=Ложь;
	Массив = Новый Массив();
	ТехнологияПечати=РЦ.ВидРабочегоЦентра.лкТехнологияПечати;  
	Форма.Объект.НоменклатураDFM=DFMСервер.ЭтоНоменклатураDFM(Форма.Объект.РабочийЦентр,Форма.Объект.ТипЗаказа,Форма.ДатаНачалаСозданияНоменклатурыDFM И Форма.Объект.Цвета.Количество()>0,Форма.Объект.ДатаПервойОтправкиВРаботу);

	Если Форма.ДатаНачалаСозданияНоменклатурыDFM И Форма.Объект.НоменклатураDFM Тогда
		НомерСтроки=0;
		Для Каждого Товар Из Форма.Объект.Товары Цикл
			
			Если Товар.ВерсияНоменклатуры.ТехнологияПечати<>ТехнологияПечати Тогда
				Если Форма.Объект.ВидЗаказа=Перечисления.Лико_ВидыЗаказов.ПолныйПовтор Тогда
				СтруктураНоменклатуры=Справочники.Лико_ВерсииНоменклатуры.СоздатьНоменклатуру(Товар.Номенклатура.Наименование,
				Товар.Номенклатура.Лико_ТипЭтикетки,ТехнологияПечати,Неопределено,
				Форма.Объект.Регион,Форма.Объект.Партнер,Форма.Объект.Менеджер,Форма.Объект.Дизайнер,Истина,Товар.Номенклатура,,,Форма.Объект.Заказ);	
				
				Товар.Артикул=СтруктураНоменклатуры.ВерсияНоменклатуры.Артикул;
				Товар.Версия=СтруктураНоменклатуры.Версия;
				Товар.ВерсияНоменклатуры=СтруктураНоменклатуры.ВерсияНоменклатуры;
				
				
			Иначе
				Структура = Новый Структура;
				Структура.Вставить("Номенклатура",Товар.Номенклатура);
				Структура.Вставить("ВерсияНоменклатуры",Товар.ВерсияНоменклатуры);
               Массив.Добавить(Структура); 
				
				Отказ=Истина;
				//Сообщение = Новый СообщениеПользователю;
				//Сообщение.Текст = СтрШаблон("Продукт: %1 не соответсвует технологии! Создатйте версиию продукта с технологией:%2.",Товар.Номенклатура,ТехнологияПечати);
				//Сообщение.Поле = "Объект.Товары["+НомерСтроки+"].Номенклатура"; //имя реквизита 
				//Сообщение.УстановитьДанные(Объект);
				//Сообщение.Сообщить();
			КонецЕсли;
			
			КонецЕсли;
			НомерСтроки=НомерСтроки+1;	
		КонецЦикла;
		
			
	КонецЕсли;
Возврат Массив;
