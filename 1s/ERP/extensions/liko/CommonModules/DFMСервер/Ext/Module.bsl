			Форма.Элементы.СоздатьВерсиюDFM2.Доступность=Ложь; 		
			форма.Элементы.ТоварыАртикул.ТолькоПросмотр=Истина;
			
		КонецЕсли;
		
		Если  Форма.ПоказатьDFM Тогда
			Форма.Элементы.УведомитьДизайнераDFM2.Доступность=Истина;
			Форма.Элементы.СоздатьВерсиюDFM2.Доступность=Истина; 		
			форма.Элементы.ТоварыАртикул.ТолькоПросмотр=Ложь; 
			Форма.Элементы.СоздатьНоменклатуруDFM2.Доступность=Истина;
			
		КонецЕсли; 
		Если Форма.Объект.Площадка = Справочники.Лико_Площадки.Линкс Тогда
			Форма.Элементы.НайтиПродуктDFM2.Доступность=Истина;
		Иначе
			Форма.Элементы.НайтиПродуктDFM2.Доступность=Ложь;
		КонецЕсли;
		
		
	Иначе
		Форма.Элементы[Группа].Видимость=Ложь;
	КонецЕсли;	
	
КонецПроцедуры //-Лико m.shenderov 14.06.2021


Функция ЭтоНоменклатураDFM(РЦ,ТипЗаказа,ДатаНачалаУчетаDFM,ДатаПервойОтправкиВРаботу = Неопределено, Товары=Неопределено) Экспорт  //+Лико m.shenderov 15.06.2021
	Результат=Ложь;
	Если ЗначениеЗаполнено(Товары)   Тогда
		
		Для Каждого Товар Из Товары Цикл 		
			
			Если ТипЗнч(Товары)=Тип("Массив") Тогда
				
				Если Товар.Лико_DFM Тогда
					
					Возврат  Истина;
					
				КонецЕсли;
				
				
			Иначе
				
				Если Товар.Номенклатура.Лико_DFM Тогда
					
					Возврат  Истина;
					
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		
	КонецЕсли;
	
	Если  РЦ.Лико_Площадка = Справочники.Лико_Площадки.Линкс
		Или РЦ.ВидРабочегоЦентра.лкТехнологияПечати = Справочники.Лико_ТехнологияПечати.GallusInkjet		
		//Или  (ДатаНачалаУчетаDFM и РЦ.ВидРабочегоЦентра.лкТехнологияПечати = Справочники.Лико_ТехнологияПечати.Comexi)
		Или  (ДатаНачалаУчетаDFM и ТипЗаказа = Перечисления.Лико_ТипыЗаказов.ВплавляемаяЭтикетка) 
		Или  (ДатаНачалаУчетаDFM и ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Термоусадка) 

		Тогда		
		Результат = Истина;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 24.11.2025
	Если НЕ Результат
		И РЦ.Лико_Площадка = Справочники.Лико_Площадки.Ликофлекс 
		И (РЦ.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.MPSOfset
		ИЛИ РЦ.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.Drent
		ИЛИ РЦ.ВидРабочегоЦентра = Справочники.ВидыРабочихЦентров.MO3300)
		Тогда
		ДатаПереходаНаDFMНовыхЗаказов = Справочники.Лико_ПредопределенныеЗначения.ДатаПереходаНаDFMНовыхЗаказов.ЗначениеПараметра;
		Если ДатаПервойОтправкиВРаботу <> Неопределено 
			И (ДатаПервойОтправкиВРаботу = Дата(1,1,1) И ЗначениеЗаполнено(ДатаПереходаНаDFMНовыхЗаказов) ИЛИ ЗначениеЗаполнено(ДатаПереходаНаDFMНовыхЗаказов) И ДатаПервойОтправкиВРаботу > ДатаПереходаНаDFMНовыхЗаказов) Тогда 
			Результат = Истина; 
		КонецЕсли;
	КонецЕсли;
	// <-- Начало Лико Яцун С. В. 24.11.2025
	
	Возврат Результат;
	
КонецФункции //-Лико m.shenderov 15.06.2021 

