			Этап.Организация = ЗаказПр.Организация;
			Этап.ВыпускПодДеятельность = ЗаказПр.ЗаказПодДеятельность;
			Этап.ВыпускПодДеятельность =Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
			Этап.Ответственный = ЗаказПр.Ответственный;
			Этап.НаименованиеЭтапа = Выборка.ВидЭтапаНаименование + " "+Прав(Заказ.Номер,7); 
			Этап.КоличествоУпаковокПлан = 1;
			Этап.НомерЭтапа = сч;
			Этап.Валюта = Справочники.Валюты.НайтиПоКоду("978");
				
			Если ТипЗнч(ЗаказПр.ДокументОснование) = Тип("ДокументСсылка.ЗаказДавальца") Тогда 
				Этап.Партнер = ЗаказПр.ДокументОснование.Партнер;
				Этап.Договор = ЗаказПр.ДокументОснование.Договор;
				Этап.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПроизводствоИзДавальческогоСырья;
			Иначе
				Этап.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СобственноеПроизводство;
			КонецЕсли;	
			Этап.ПроизводствоОднойДатой = Истина;
			Этап.ВидЭтапа = Выборка.ВидЭтапа;
			Этап.ДлительностьЭтапа = Выборка.Длительность;
			Этап.ЕдиницаИзмеренияДлительностиЭтапа =  Перечисления.ЕдиницыИзмеренияВремени.Минута;
			Этап.НомерПартииЗапуска = 1;
			Этап.НомерЭтапаВПартииЗапуска = Этап.НомерЭтапа; 
			Этап.ВариантПриемкиТоваров = Константы.ВариантПриемкиТоваров.Получить();
			Если Выборка.ВидЭтапа = Справочники.Лико_ВидыЭтаповПроизводства.Упаковка Тогда 
				Этап.МаршрутнаяКарта = Справочники.Лико_ПредопределенныеЗначения.МаршрутнаяКартаУпаковка.ЗначениеПараметра;
			Иначе
				Этап.МаршрутнаяКарта = Справочники.Лико_ПредопределенныеЗначения.МаршрутнаяКартаПечать.ЗначениеПараметра;
			КонецЕсли;
			Этап.ТипПроизводственногоПроцесса = Перечисления.ТипыПроизводственныхПроцессов.Сборка;
			Этап.КоэффициентМаршрутнойКарты = 1;

			Если Выборка.ВидЭтапа = Справочники.Лико_ВидыЭтаповПроизводства.Прокат Тогда 
				Этап.НомерПроката = Выборка.НомерПроката;
						
			КонецЕсли;	
			
			Номер = Заказ.НомерБезПрефикса
			+ "."
			+ Формат(Этап.НомерПартииЗапуска, "ЧГ=0")
			+ "."
			+ Формат(Этап.НомерЭтапаВПартииЗапуска, "ЧГ=0");
			Этап.Номер = Номер;
			Этап.СпособРаспределенияЗатратНаВыходныеИзделия = Перечисления.СпособыРаспределенияЗатратНаВыходныеИзделия.ПоДолямСтоимости;
			
			Если сч  = ВсегоЭтапов Тогда 
				Этап.ЯвляетсяНазначениемПродукции = Истина;
				Для каждого стртовары из Заказ.товары Цикл
					стр = Этап.ВыходныеИзделия.Добавить();
					ЗаполнитьЗначенияСвойств(стр, стртовары, , "кодстроки");
					стр.СтатьяРасходов = Справочники.СтатьиКалькуляции.НайтиПонаименованию("Печать");
					стр.Получатель = Заказ.Склад;
					стр.ДоляСтоимости = 1;        
					стр.Подразделение = Этап.Подразделение;
				КонецЦикла;	
				
				Попытка 
					Этап.записать();
					ВыпускающийЭтап =  Этап.Ссылка;
					Этап.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось создать этапы заказа. Заказ не отправлен в работу. " + ОписаниеОшибки());
					ОтменитьТранзакцию();
					Отказ = Истина;
					Возврат;
				КонецПопытки;
			Иначе 
				стрпоследователи = Этап.Последователи.Добавить() ;
				стрпоследователи.Этап =ЭтапСледующий; 
				Этап.НомерСледующегоЭтапа =сч+1;
				Попытка 
					Этап.записать();
					Этап.записать(РежимЗаписиДокумента.Проведение);
				Исключение
					Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Не удалось создать этапы заказа. Заказ не отправлен в работу. " + ОписаниеОшибки());
					ОтменитьТранзакцию();
					Отказ = Истина;
					Возврат;
				КонецПопытки;	
			КонецЕсли;
	
			ЭтапСледующий = Этап.Ссылка;
			сч = сч-1;   
			
	КонецЦикла;
	


КонецПроцедуры

&Вместо("ПолучитьСтоимостьКраскиЛаков")
