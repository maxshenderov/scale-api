	|		ПО (ЭтапПроизводства2_2.Распоряжение.ДокументОснование = &Заказ
	|				ИЛИ ЭтапПроизводства2_2.Распоряжение.ДокументОснование.Лико_ЗаказКлиента = &Заказ)
	|			И ВТСхема.ВидЭтапа = ЭтапПроизводства2_2.ВидЭтапа
	|			И (ВЫБОР
	|				КОГДА ВТСхема.ВидЭтапа = ЗНАЧЕНИЕ(Справочник.Лико_ВидыЭтаповПроизводства.Прокат)
	|					ТОГДА ВТСхема.НомерПроката = ЭтапПроизводства2_2.НомерПроката
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|			И (ЭтапПроизводства2_2.Распоряжение = &ЗаказНаПроизводство)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
