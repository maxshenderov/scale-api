	|					И ЗаказКлиентаВидыРабот.КоличествоКодовНаЛисте > 0
	|				ТОГДА ЗаказКлиентаВидыРабот.КоличествоКодовНаЛисте / ЗаказКлиентаВидыРабот.Ссылка.ЭтикетокНаЛистеПечати
	|			ИНАЧЕ 1
	|		КОНЕЦ / 1000) КАК Количество,
	|	СУММА(Лико_ТипыНумераторовРасходЧернил.Расход) КАК КоэффициентПереноса,
	|	ЗаказКлиентаВидыРабот.НомерПроката КАК НомерПроката
	|ПОМЕСТИТЬ ВТЧернила
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаВидыРабот
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ТипыНумераторов.РасходЧернил КАК Лико_ТипыНумераторовРасходЧернил
	|		ПО ЗаказКлиентаВидыРабот.ТипНумератора = Лико_ТипыНумераторовРасходЧернил.Ссылка
	|			И ЗаказКлиентаВидыРабот.ТипКода = Лико_ТипыНумераторовРасходЧернил.ТипКода
	|ГДЕ
	|	(ВЫРАЗИТЬ(ЗаказКлиентаВидыРабот.Ссылка КАК Документ.ЗаказКлиента)) = &Ссылка
	|	И ЗаказКлиентаВидыРабот.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Нумератор)
	|	И ЗаказКлиентаВидыРабот.НомерВарианта = &НомерВарианта
	|	И ВЫБОР
	|			КОГДА &НомерПроката = 0
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЗаказКлиентаВидыРабот.НомерПроката = &НомерПроката
	|		КОНЕЦ
	|	И НЕ Лико_ТипыНумераторовРасходЧернил.Ссылка.РасчетПоМетрам
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаВидыРабот.ВидСекции,
	|	ЗаказКлиентаВидыРабот.НомерРаботы,
	|	ЗаказКлиентаВидыРабот.НомерПроката,
	|	ЗаказКлиентаВидыРабот.ТипКраски
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.Чернила)),
	|	Лико_СпецификацииВидыРабот.ВидСекции,
	|	Лико_СпецификацииВидыРабот.НомерРаботы,
	|	Лико_СпецификацииВидыРабот.ТипКраски,
	|	СУММА(Лико_ТипыНумераторовРасходЧернил.Расход * &Тираж * ВЫБОР
	|			КОГДА Лико_СпецификацииВидыРабот.Ссылка.ЭтикетокНаЛистеПечати > 0
	|					И Лико_СпецификацииВидыРабот.КоличествоКодовНаЛисте > 0
	|				ТОГДА Лико_СпецификацииВидыРабот.КоличествоКодовНаЛисте / Лико_СпецификацииВидыРабот.Ссылка.ЭтикетокНаЛистеПечати
	|			ИНАЧЕ 1
	|		КОНЕЦ / 1000),
	|	СУММА(Лико_ТипыНумераторовРасходЧернил.Расход),
	|	Лико_СпецификацииВидыРабот.НомерПроката
	|ИЗ
	|	Справочник.Лико_Спецификации.Цвета КАК Лико_СпецификацииВидыРабот
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ТипыНумераторов.РасходЧернил КАК Лико_ТипыНумераторовРасходЧернил
	|		ПО Лико_СпецификацииВидыРабот.ТипНумератора = Лико_ТипыНумераторовРасходЧернил.Ссылка
	|			И Лико_СпецификацииВидыРабот.ТипКода = Лико_ТипыНумераторовРасходЧернил.ТипКода
	|ГДЕ
	|	(ВЫРАЗИТЬ(Лико_СпецификацииВидыРабот.Ссылка КАК Справочник.Лико_Спецификации)) = &Ссылка
	|	И Лико_СпецификацииВидыРабот.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Нумератор)
	|	И Лико_СпецификацииВидыРабот.НомерВарианта = &НомерВарианта
	|	И НЕ Лико_ТипыНумераторовРасходЧернил.Ссылка.РасчетПоМетрам
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_СпецификацииВидыРабот.ВидСекции,
	|	Лико_СпецификацииВидыРабот.НомерРаботы,
	|	Лико_СпецификацииВидыРабот.ТипКраски,
	|	Лико_СпецификацииВидыРабот.НомерПроката
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЧернила.СтатьяЗатрат КАК СтатьяЗатрат,
	|	ВТЧернила.ВидСекции КАК ВидСекции,
	|	ВТЧернила.НомерРаботы КАК НомерРаботы,
	|	ВТЧернила.НомерПроката КАК НомерПроката,
	|	ВТЧернила.Затрата КАК Затрата,
	|	ВТЧернила.Количество КАК Количество,
	|	ВТЧернила.КоэффициентПереноса КАК КоэффициентПереноса,
	|	ВТЧернила.Количество * ЕСТЬNULL(Лико_ЦеныГруппНоменклатурыСрезПоследних.Цена, 0) КАК Сумма,
	|	ВТЧернила.Количество * ЕСТЬNULL(Лико_ЦеныГруппНоменклатурыСрезПоследних1.Цена, 0) КАК СуммаФакт
	|ИЗ
	|	ВТЧернила КАК ВТЧернила
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
	|				&Дата,
	|				Площадка = &Площадка
	|					И ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ОсновнаяЕвро)) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних
	|		ПО ВТЧернила.Затрата = Лико_ЦеныГруппНоменклатурыСрезПоследних.ЦеноваяГруппа
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
	|				&Дата,
	|				Площадка = &Площадка
	|					И ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ТабашФакт)) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних1
	|		ПО ВТЧернила.Затрата = Лико_ЦеныГруппНоменклатурыСрезПоследних1.ЦеноваяГруппа";

	Если РасчетФакта Тогда 
		Запрос.УстановитьПараметр("Тираж", Расч_Квм * 0.001 * Ссылка.ШтКВМ);
	Иначе
		Запрос.УстановитьПараметр("Тираж", Тираж);
	КонецЕсли;
	ВыборкаЧернила= Запрос.Выполнить().Выбрать();
	Пока  ВыборкаЧернила.Следующий() Цикл
		стр = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(стр, ВыборкаЧернила);	
	КонецЦикла;  

	#Конецобласти

#Область Праймер 

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаЦвета.ВидСекции КАК ВидСекции,
		|	ТаблицаЦвета.НомерРаботы КАК НомерРаботы,
		|	ТаблицаЦвета.РабочийЦентр КАК РабочийЦентр,
		|	ТаблицаЦвета.Ссылка.Праймер.ЦеноваяГруппа КАК Затрата,
		|	ТаблицаЦвета.НомерПроката КАК НомерПроката
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	"+ИмяТаблицы+".Цвета КАК ТаблицаЦвета
		|ГДЕ
		|	ТаблицаЦвета.Ссылка = &Ссылка
		|	И ТаблицаЦвета.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.indigo)
		|	И НЕ ТаблицаЦвета.Ссылка.Праймер В (ЗНАЧЕНИЕ(Справочник.Лико_праймеры.ПустаяСсылка), ЗНАЧЕНИЕ(Справочник.Лико_праймеры.БезПраймера))
		|	И ТаблицаЦвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.Цифровая)
		|	И ВЫБОР
		|			КОГДА &НомерПроката = 0
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ТаблицаЦвета.НомерПроката = &НомерПроката
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗНАЧЕНИЕ(Справочник.Лико_СтатьиЗатрат.Праймер) КАК СтатьяЗатрат,
		|	ВТ.ВидСекции КАК ВидСекции,
		|	ВТ.НомерРаботы КАК НомерРаботы,
		|	ВТ.РабочийЦентр КАК РабочийЦентр,
		|	ВТ.Затрата КАК Затрата,
		|	ВТ.НомерПроката КАК НомерПроката,
		|	Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение КАК КоэффициентПереноса,
		|	&Расч_Квм * Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение / 1000 * Лико_ЦеныГруппНоменклатурыСрезПоследних.Цена КАК Сумма,
		|	&Расч_Квм * Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение / 1000 * Лико_ЦеныГруппНоменклатурыСрезПоследних1.Цена КАК СуммаФакт,
		|	&Расч_Квм * Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение / 1000 КАК Количество,
		|	Лико_ЦеныГруппНоменклатурыСрезПоследних.Цена КАК ЦенаПлан,
		|	Лико_ЦеныГруппНоменклатурыСрезПоследних1.Цена КАК Цена,
		|	&Расч_КВМ КАК Метраж,
		|	Лико_ЗначенияКоэффициентовПереносаСрезПоследних.Значение КАК КоэффициентКМетражу
		|ИЗ
		|	РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
		|			&Дата,
		|			Площадка = &Площадка
		|				И ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ТабашФакт)) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних1
		|		ПРАВОЕ СОЕДИНЕНИЕ ВТ КАК ВТ
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЦеныГруппНоменклатуры.СрезПоследних(
		|					&Дата,
		|					Площадка = &Площадка
		|						И ТипЦен = ЗНАЧЕНИЕ(Перечисление.Лико_ТипЦен.ОсновнаяЕвро)) КАК Лико_ЦеныГруппНоменклатурыСрезПоследних
		|			ПО ВТ.Затрата = Лико_ЦеныГруппНоменклатурыСрезПоследних.ЦеноваяГруппа
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ЗначенияКоэффициентовПереноса.СрезПоследних(
		|					&Дата,
		|					Площадка = &Площадка
		|						И Коэффициент = ЗНАЧЕНИЕ(Справочник.Лико_КоэффициентыДляРасчетов.КоэффициентПереносаПраймераЦифры)) КАК Лико_ЗначенияКоэффициентовПереносаСрезПоследних
		|			ПО ВТ.Затрата = Лико_ЗначенияКоэффициентовПереносаСрезПоследних.ЦеноваяГруппа
		|		ПО (ВТ.Затрата = Лико_ЦеныГруппНоменклатурыСрезПоследних1.ЦеноваяГруппа)";
	
	
	ВыборкаПраймер = Запрос.Выполнить().Выбрать();

	Пока  ВыборкаПраймер.Следующий() Цикл
		стр = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(стр, ВыборкаПраймер);	
	КонецЦикла;  
		
#Конецобласти

Возврат ТЗ;	

	


КонецФункции



