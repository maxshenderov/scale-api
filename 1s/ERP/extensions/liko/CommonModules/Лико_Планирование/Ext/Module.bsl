&Вместо("СоздатьДобавитьЭтапыПроизводства")
Процедура Лико_СоздатьДобавитьЭтапыПроизводства(Заказ, ЗаказПр, Площадка, Отказ)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаВидыРабот.Ссылка КАК Заказ,
	|	ЗаказКлиентаВидыРабот.НомерПроката КАК НомерПроката
	|ПОМЕСТИТЬ Прокаты
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаВидыРабот.НомерПроката,
	|	ЗаказКлиентаВидыРабот.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_ПараметрыПроизводстваЗаказа.НомерПроката КАК НомерПроката,
	|	МАКСИМУМ(Лико_ПараметрыПроизводстваЗаказа.ВремяПечати + Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку) КАК Время
	|ПОМЕСТИТЬ ВТ_Время
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|ГДЕ
	|	Лико_ПараметрыПроизводстваЗаказа.Заказ = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ПараметрыПроизводстваЗаказа.НомерПроката
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_СхемыПроизводстваЭтапы.ВидЭтапа КАК ВидЭтапа,
	|	Лико_СхемыПроизводстваЭтапы.ВидЭтапа.Наименование КАК ВидЭтапаНаименование,
	|	Прокаты.НомерПроката КАК НомерПроката,
	|	ЕСТЬNULL(ВТ_Время.Время, Лико_СхемыПроизводстваЭтапы.ВидЭтапа.ДлительностьЭтапа) КАК Длительность,
	|	Лико_СхемыПроизводстваЭтапы.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТСхема
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
