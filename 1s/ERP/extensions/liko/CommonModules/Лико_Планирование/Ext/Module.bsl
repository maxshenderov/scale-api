	Выборка = Запрос.Выполнить().Выбрать();
	ВсегоЭтапов = Выборка.Количество();
	СписокЭтапов = Новый СписокЗначений;
	сч = ВсегоЭтапов;
	ЭтапСледующий = Документы.ЭтапПроизводства2_2.ПустаяСсылка();
	ВыпускающийЭтап =  Документы.ЭтапПроизводства2_2.ПустаяСсылка();
	ПартияПроизводства = НайтиСоздатьПартиюПроизводства(ЗаказПР);
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ДокЭтап) Тогда 
			Этап = Выборка.ДокЭтап.ПолучитьОбъект();
			Этап.ПометкаУдаления = Ложь;
			Этап.Последователи.Очистить();
			Этап.НомерСледующегоЭтапа =0;
			Этап.ЯвляетсяНазначениемПродукции = Ложь;
			Этап.ВыходныеИзделия.Очистить();  
		Иначе	
			Этап = Документы.ЭтапПроизводства2_2.СоздатьДокумент();
