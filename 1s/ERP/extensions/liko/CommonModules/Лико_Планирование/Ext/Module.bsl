&Вместо("ДанныеПоРоликам")
Функция Лико_ДанныеПоРоликам(Заказ, ИмяТаблицы, КодЦГ, НомерПроката, НомерВарианта, РабочийЦентр, Метраж)
		ДанныеПоРоликам = Новый Структура();
	ДанныеПоРоликам.Вставить("ВремяНаСменуРоликов", 0);
	ДанныеПоРоликам.Вставить("ДлинаРолика", 0);
	
	Запрос = Новый Запрос;	
	#Область ДанныеПоРоликам   
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиентаВидыРабот.ВидСекции КАК ВидРабот,
	|	ЗаказКлиентаВидыРабот.КоличествоРучьевМатериала КАК КоличествоМатериалов
	|ПОМЕСТИТЬ ВТМатериалы
	|ИЗ
	|	"+ИмяТаблицы+".Цвета КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ
	|	И ЗаказКлиентаВидыРабот.НомерПроката = &НомерПроката
	|	И ЗаказКлиентаВидыРабот.Материал <> ЗНАЧЕНИЕ(Справочник.ЦеновыеГруппы.ПустаяСсылка)
	|	И ЗаказКлиентаВидыРабот.Материал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И ЗаказКлиентаВидыРабот.Материал <> НЕОПРЕДЕЛЕНО
	|	И ЗаказКлиентаВидыРабот.НомерВарианта = &НомерВарианта
	|	И НЕ ЗаказКлиентаВидыРабот.ВидСекции В (ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ГорячееТиснениеПлоское), ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ГорячееТиснениеВРегистрПлоское))
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаВидыРабот.ВидСекции,
	|	ЗаказКлиентаВидыРабот.КоличествоРучьевМатериала
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Основной материал"",
	|	1
	|ИЗ
	|	"+ИмяТаблицы+" КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Ссылка = &Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТМатериалы.КоличествоМатериалов) КАК КоличествоМатериалов
	|ПОМЕСТИТЬ ВТКоличествоМатериалов
	|ИЗ
	|	ВТМатериалы КАК ВТМатериалы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.НомерВарианта, Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.НомерВарианта) КАК НомерВарианта,
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.Ссылка, Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.Ссылка) КАК Ссылка
	|ПОМЕСТИТЬ ВТНормативы
	|ИЗ
	|	Справочник.РабочиеЦентры КАК РабочиеЦентры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.РабочиеЦентры КАК Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры
	|		ПО РабочиеЦентры.Ссылка = Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.РабочийЦентр
	|			И (Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры.Ссылка = ЗНАЧЕНИЕ(Справочник.Лико_ТаблицыДляРасчетаНормативов.ДлинаРолика))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.РабочиеЦентры КАК Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1
	|		ПО РабочиеЦентры.ВидРабочегоЦентра = Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.РабочийЦентр
	|			И (Лико_ТаблицыДляРасчетаНормативовРабочиеЦентры1.Ссылка = ЗНАЧЕНИЕ(Справочник.Лико_ТаблицыДляРасчетаНормативов.ДлинаРолика))
	|ГДЕ
	|	РабочиеЦентры.Ссылка = &РабочийЦентр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ЗначениеПоказателя КАК ДлинаРолика
	|ПОМЕСТИТЬ ВТПоУмолчанию
	|ИЗ
	|	ВТНормативы КАК ВТНормативы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.ТаблицаПоказателей КАК Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей
	|		ПО ВТНормативы.Ссылка = Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Ссылка
	|			И ВТНормативы.НомерВарианта = Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.НомерВарианта
	|			И (Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.Показатель = ЗНАЧЕНИЕ(Справочник.Лико_ПараметрыРасчетаНормативов.Поправка1С))
	|			И (Лико_ТаблицыДляРасчетаНормативовТаблицаПоказателей.ВариантРасчета = 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&КодЦГ КАК КодЦГ,
	|	ВТКоличествоМатериалов.КоличествоМатериалов КАК КоличествоМатериалов,
	|	ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.ЗначениеПоказателя, ВТПОУмолчанию.ДлинаРолика) КАК ДлинаРолика,
	|	5 * ЕСТЬNULL(ВТКоличествоМатериалов.КоличествоМатериалов, 0) * (ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА &Метраж / ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.ЗначениеПоказателя, ВТПОУмолчанию.ДлинаРолика) > 1
	|				ТОГДА &Метраж / ЕСТЬNULL(Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.ЗначениеПоказателя, ВТПОУмолчанию.ДлинаРолика)
	|			ИНАЧЕ 0
	|		КОНЕЦ + 0.4999 КАК ЧИСЛО(15, 0))) КАК ВремяНаСменуРоликов
	|ИЗ
	|	ВТКоличествоМатериалов КАК ВТКоличествоМатериалов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПоУмолчанию КАК ВТПОУмолчанию
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТаблицыДляРасчетаНормативов.ТаблицаЦветов КАК Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов
	|		ПО (Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.НомерВарианта В
	|				(ВЫБРАТЬ
	|					ВТНормативы.НомерВарианта КАК НомерВарианта
	|				ИЗ
	|					ВТНормативы КАК ВТНормативы))
	|			И (Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.Ссылка = ЗНАЧЕНИЕ(Справочник.Лико_ТаблицыДляРасчетаНормативов.ДлинаРолика))
	|			И (Лико_ТаблицыДляРасчетаНормативовТаблицаЦветов.КоличествоЦветов = &КодЦГ)";
	
	#КонецОбласти
	
	
	
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("КодЦГ", КодЦГ);
	Запрос.УстановитьПараметр("НомерВарианта", НомерВарианта);
	Запрос.УстановитьПараметр("НомерПроката", НомерПроката);
	Запрос.УстановитьПараметр("РабочийЦентр", РабочийЦентр);
	Запрос.УстановитьПараметр("Метраж", Метраж);
	РезультатЗапроса  = Запрос.Выполнить();	
	Если Не РезультатЗапроса.Пустой() Тогда
		//Результат = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Общие");
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		//Если ЗначениеЗаполнено(Результат.ВремяНаСменуРоликов) Тогда 
			ДанныеПоРоликам.ВремяНаСменуРоликов = Результат.ВремяНаСменуРоликов;
			ДанныеПоРоликам.ДлинаРолика = Результат.ДлинаРолика;
		//КонецЕсли;	
	КонецЕсли;
	Возврат ДанныеПоРоликам;

КонецФункции


&Вместо("НаправитьВРаботуЗаказОснастки")
Процедура Лико_НаправитьВРаботуЗаказОснастки(Заказ)
	//Проверяем  есть ли Заказы на производство по организациям - площадкам из рабочих центров
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказКлиента.Площадка КАК Площадка,
	|	МАКСИМУМ(ЕСТЬNULL(ЗаказНаПроизводство2_2.Ссылка, ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство2_2.ПустаяСсылка))) КАК ЗаказНаПроизводство
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2 КАК ЗаказНаПроизводство2_2
	|		ПО (ЗаказКлиента.Площадка.Организация = ЗаказНаПроизводство2_2.Организация)
	|			И (ЗаказКлиента.Ссылка = ЗаказНаПроизводство2_2.ДокументОснование)
	|ГДЕ
	|	ЗаказКлиента.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиента.Площадка";

	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если  ЗначениеЗаполнено(Выборка.ЗаказНаПроизводство) Тогда 
			ЗаказПрОбъект = Выборка.ЗаказНаПроизводство.ПолучитьОбъект();
		Иначе
			ЗаказПРОбъект = Документы.ЗаказНаПроизводство2_2.СоздатьДокумент();
			ЗаказПРОбъект.Организация  = Выборка.Площадка.Организация;  
		КонецЕсли;	
		ЗаполнитьПоЗаказуКлиента(ЗаказПрОбъект, Заказ);	
		ЗаказПр = ЗаказПрОбъект.Ссылка;
		Отказ = Ложь;
		СоздатьДобавитьЭтапыПроизводства(Заказ, ЗаказПр, Выборка.Площадка, Отказ);
		Если Отказ Тогда 
			Возврат;
		КонецЕсли;
	КонецЦикла;


	ЗаказОбъект = Заказ.ПолучитьОбъект();
	ЗаказОбъект.ДатаОтправкиВРаботу = ТекущаяДата();
	ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);


КонецПроцедуры

&Вместо("РассчитатьКомбинированныйЗаказПоРЦ")
Процедура Лико_РассчитатьКомбинированныйЗаказПоРЦ(Заказ, Выборка, Отказ)
	
	МетровВсегоОсн=0;
	//Стоимость новых штампов и клише
	Ст_Шт_Клише =Выборка.СтоимостьОснастки;
	ТаблицаРЦ = ПолучитьРЦПоПеределам(Заказ, Выборка.РабочийЦентр);	
	МетрыНаБрак = 0;
	МетрыНаНастройку = 0; 
	МойкаСекций = 0;
	ОбщееВремяВыполненияЗаказа =0;
	ВремяЗаказаДляДоходности = 0;
	ЗатратыНаМатериалы = 0;
	ЗатратыНаОснастку = 0;
	ВсегоКликов = 0;
	Если Заказ.ЕдиницаИзмеренияЗаказа = Справочники.Лико_ПредопределенныеЗначения.ЕИТысШт.ЗначениеПараметра Тогда 
		КоэффициентЕдИзм = 1000;
	Иначе
		КоэффициентЕдИзм = 1;
	КонецЕсли;
	//		ПоказателиПоЗаказу = Новый Соответствие; //собираем показатели по всем машинам
	Для каждого ТекРЦ из ТаблицаРЦ Цикл 
		НормативыДляРЦ= РассчитатьНормативыДляРЦ(Заказ, Выборка.ПогонныйМетраж, ТекРЦ.РЦ, МетрыНаБрак, МетрыНаНастройку, текРЦ.НомерПроката, Выборка.Количество);
		Если ТипЗнч(НормативыДляРЦ) <>Тип("Строка") Тогда
			//				ЗаполнитьПоказателиПоЗаказу(ПоказателиПоЗаказу, НормативыДляРЦ.ПоказателиДляТаблиц);
			стрНормативы =РегистрыСведений.Лико_ПараметрыПроизводстваЗаказа.СоздатьМенеджерЗаписи();
			стрНормативы.Заказ = Заказ;
			стрНормативы.НомерПроката = текРЦ.НомерПроката;
			стрНормативы.РабочийЦентр = ТекРЦ.РЦ;
			стрНормативы.Нарезка = Выборка.Нарезка;
			//				
			МетрыНаБрак = МетрыНаБрак +НормативыДляРЦ.МетрыНаБрак;
			МетрыНаНастройку = МетрыНаНастройку+НормативыДляРЦ.МетрыНаНастройку;
			МойкаСекций = МойкаСекций+НормативыДляРЦ.МойкаСекций;
			Если  текРЦ.НомерПроката>1 Тогда 
				ВремяЗаказаДляДоходности =ВремяЗаказаДляДоходности+НормативыДляРЦ.ВремяВыполненияЗаказа*ТекРЦ.РЦ.Лико_КоэффициентВремениДоходности;
			Иначе
				ВремяЗаказаДляДоходности =ВремяЗаказаДляДоходности+НормативыДляРЦ.ВремяВыполненияЗаказа;
			КонецЕсли;	
			стрНормативы.МетрыНаНастройку = НормативыДляРЦ.МетрыНаНастройку;
			стрНормативы.МетрыНаБрак = НормативыДляРЦ.МетрыНаБрак;
			стрНормативы.ВремяПечати = НормативыДляРЦ.ВремяПечати;
			стрНормативы.ВремяНаНастройку = НормативыДляРЦ.ВремяНаНастройку;
			стрНормативы.ВремяНаСменуРоликов = НормативыДляРЦ.ВремяНаСменуРоликов;
			стрНормативы.СкоростьПечати = НормативыДляРЦ.СкоростьПечати;
			стрНормативы.МетражДляРЦ = Выборка.ПогонныйМетраж+ МетрыНаБрак+МетрыНаНастройку;
			Если текРЦ.РЦ.ВидРабочегоЦентра= Справочники.ВидыРабочихЦентров.Indigo Тогда 
				ВсегоКликов  =  НормативыДляРЦ.ВсегоКликов;
				стрНормативы.КоличествоКликов = НормативыДляРЦ.ВсегоКликов;
			КонецЕсли; 
			//				//	ВремяВыполненияЗаказаВЧасах = ВремяВыполненияЗаказаВЧасах+НормативыДляРЦ.ВремяПечати+НормативыДляРЦ.ВремяНаНастройку;
			стрНормативы.ПроцентНаБрак = НормативыДляРЦ.ПроцентНаБрак;
			стрНормативы.Штампы = ШтампыСтрокойПоПрокату(Заказ,текРЦ.НомерПроката); 
			стрНормативы.Записать();
			//Определим и запишем в затраты на материалы по РЦ 
			//Для Комбинированного заказа необходимо предварительно уточнить количество этикеток в заказе материала и пересчитать его себестоимость
			ЗапросЗаказыМатериалов = Новый Запрос;
			ЗапросЗаказыМатериалов.текст = 
			"ВЫБРАТЬ
			|	ЗаказКлиентаЦвета.ЗаказМатериала КАК ЗаказМатериала
			|ИЗ
			|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
			|ГДЕ
			|	ЗаказКлиентаЦвета.Ссылка = &Заказ
			|	И ЗаказКлиентаЦвета.НомерПроката = &НомерПроката
			|	И ЗаказКлиентаЦвета.ЗаказМатериала <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)";
			ЗапросЗаказыМатериалов.УстановитьПараметр("Заказ", Заказ);
			ЗапросЗаказыМатериалов.УстановитьПараметр("НомерПроката", ТекРЦ.НомерПроката);

			ВыборкаЗаказыМатериалов = ЗапросЗаказыМатериалов.Выполнить().Выбрать();
			
			//20201222 - если явно не указано, что пересчитывать не надо
			Если Не Заказ.НеПересчитыватьПФ  Тогда 
				Пока ВыборкаЗаказыМатериалов.Следующий() Цикл
					ТиражДляМатериала =   (Выборка.Количество*(1+(МетрыНаБрак+МетрыНаНастройку)/Выборка.ПогонныйМетраж))/КоэффициентЕдИзм ;
					УточнитьКоличествоЭтикетокЗаказа(ВыборкаЗаказыМатериалов.ЗаказМатериала, ТиражДляМатериала);
					РассчитатьСебестоимость_НормативыЗаказа(ВыборкаЗаказыМатериалов.ЗаказМатериала);
				КонецЦикла;
			КонецЕсли;
			ЗатратыНаМатериалыПоРЦ = РассчитатьЗатратыНаМатериалыПоРЦ(Заказ, ТекРЦ.НомерПроката, Выборка.Количество, Выборка.ПогонныйМетраж, МетрыНаБрак, МетрыНаНастройку, Выборка.РабочийЦентр, Заказ);
			ЗатратыНаМатериалы = ЗатратыНаМатериалы +  ЗатратыНаМатериалыПоРЦ;
			
		Иначе Сообщить(НормативыДляРЦ);;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	

	МетровВсего = (МетрыНаБрак+МетрыНаНастройку+Выборка.ПогонныйМетраж )*Выборка.НарезкаРазмер/1000;
	
	//Если заказ комбинированный, необходимо определить количество этикеток для заказа основы
				 //Выборка.Количество*(1+(МетрыНаБрак+МетрыНаНастройку)/Выборка.ПогонныйМетраж);

	ТиражВсего =  (Выборка.Количество*(1+(МетрыНаБрак+МетрыНаНастройку)/Выборка.ПогонныйМетраж))/КоэффициентЕдИзм ;


	
	//20200810 - Иванова Пока убираем
	Если ЗначениеЗаполнено(Заказ.ЗаказОсновногоМатериала) И Не Заказ.НеПересчитыватьПФ Тогда 
	
		УточнитьКоличествоЭтикетокЗаказа(Заказ.ЗаказОсновногоМатериала, ТиражВсего);
		
		Если ЗначениеЗаполнено(Заказ.ЗаказОсновногоМатериала) Тогда 
			РассчитатьСебестоимость_НормативыЗаказа(Заказ.ЗаказОсновногоМатериала);
	    КонецЕсли;
	КонецЕсли;

	//Добавляем Расчет Доходности
	Затраты = РассчитатьЗатратыПоРЦ(Заказ,Выборка.РабочийЦентр, Выборка.Количество, МетровВсего,Выборка.СуммаЗаказаРасчет , ВсегоКликов, МойкаСекций,ЗатратыНаОснастку, Заказ );
	
	//			Затраты = РассчитатьЗатратыПоРЦ(Заказ,ВыбСпецификация.Спецификация,ВыборкаВариант.НомерВарианта, Выборка,НормативыДляРЦ.ПоказателиДляТаблиц,  Количество, МетровВсего,МойкаСекций, ЗатратыНаОснастку);
	//Затраты = Затраты+ЗатратыНаМатериалы;     Затраты на материалы уже включены
	К_Дох = ПолучитьКоэффициентНалоговВДоходности(ТекущаяДата(), Заказ.Площадка);
				
	Доход = К_Дох*Выборка.СуммаЗаказаРасчет-Затраты;
	//Расчет доходности в час
	Если  НормативыДляРЦ.ВремяВыполненияЗаказа>0 Тогда
		Если ВремяЗаказаДляДоходности>0  Тогда 
			Доходность = Окр(Доход/(ВремяЗаказаДляДоходности)*60); //Т.к. время выпонения в минутах
		//Иначе
		//	Доходность =Доход;	
		//КонецЕсли;
		КонецЕсли;
	Иначе
		Доходность = 0;
	КонецЕсли;
	
	ПарамПервогоРЦ =РегистрыСведений.Лико_ПараметрыПроизводстваЗаказа.СоздатьМенеджерЗаписи();
	ПарамПервогоРЦ.Заказ = Заказ;
	ПарамПервогоРЦ.НомерПроката = 1;
	ПарамПервогоРЦ.РабочийЦентр = Выборка.РабочийЦентр;
	ПарамПервогоРЦ.Прочитать();
	ПарамПервогоРЦ.Доходность = Доходность;
	ПарамПервогоРЦ.Доход = Доход;
	Если ЗначениеЗаполнено(Выборка.СуммаЗаказаРасчет) Тогда 
		ПарамПервогоРЦ.Рентабельность = Окр(Доход/Выборка.СуммаЗаказаРасчет*100,2);
	КонецЕсли;	
	ПарамПервогоРЦ.Стоимость =Выборка.СуммаЗаказаРасчет;
	ПарамПервогоРЦ.СебеСтоимость =Затраты;
	ПарамПервогоРЦ.Тираж = Выборка.количество/1000;
	ПарамПервогоРЦ.МетражКвМ = Выборка.КвадратныйМетраж;
	ПарамПервогоРЦ.Цена = Выборка.Цена;
	ПарамПервогоРЦ.ЗатратыНаОснастку = ЗатратыНаОснастку;
	ПарамПервогоРЦ.ДатаОценки = ТекущаяДата();
	ПарамПервогоРЦ.Записать();				
	//		КонецЦикла;
	//		//Записшем данные по основному материалу
	//		Если МетровВсегоОсн< МетровВсего Тогда
	//			МетровВсегоОсн=МетровВсего;
	//			НарезкаОснМат =ВыборкаВариант.ШиринаРулона; 
	//		КонецЕсли;	
	Отказ = Ложь;

КонецПроцедуры

&Вместо("ПолучитьНомерДляЗаказа")
Функция Лико_ПолучитьНомерДляЗаказа(Организация, типЗаказа, видЗаказа, Регион)


	УстановитьПривилегированныйРежим(Истина);

	КодРегиона = Регион.КодРегиона;
	ПерваяЦифра = СокрЛП(КодРегиона);
	// <-- Начало Лико Яцун С. В. 26.12.2024 
	Если Регион = Справочники.БизнесРегионы.Линкс Тогда
		ПерваяЦифра = Сред(СокрЛП(КодРегиона),1,1);
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 26.12.2024
	ВтораяЦифра = Сред(Строка(ТекущаяДата()), 10,1);
	Если ЗначениеЗаполнено(ТипЗаказа) Тогда
		Если типЗаказа = Перечисления.Лико_ТипыЗаказов.ПолуфабрикатПодАппликатор Тогда
			ТретьяЦифра = "5"; // Такая же, как у обычного полуфабриката
		Иначе
			ТретьяЦифра = Строка(Перечисления.Лико_ТипыЗаказов.Индекс(ТипЗаказа));
		КонецЕсли;
	Иначе 	
		ТретьяЦифра = "1";
	КонецЕсли; 

	//Если (ПерваяЦифра = "1"  ) И ТретьяЦифра = "1" Тогда    // ИЛИ ПерваяЦифра = "7" ИЛИ ПерваяЦифра = "9" 
	//	ТретьяЦифра = "6";
	//КонецЕсли;
	
	// --> Начало Лико Ефимов ЕВВ 29.11.2024
	// У Сибири кончились номера для самоклейки
	//Если ПерваяЦифра = "9" И ТретьяЦифра = "1" Тогда  
	//	ТретьяЦифра = "6";
	//КонецЕсли;
	// <-- Конец Лико Ефимов ЕВВ 29.11.2024

	Если ЗначениеЗаполнено(ВидЗаказа) Тогда 
		Если ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Пробник Тогда 
			ТретьяЦифра = "9";
		ИначеЕсли 	ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПричинаРекламация Тогда 
			ТретьяЦифра = "7";
		ИначеЕсли 	ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка Тогда 
			ТретьяЦифра = "8";
		КонецЕсли;
	КонецЕсли;


	ПервыеЦифры = "00"+ Перваяцифра+ВтораяЦифра+ТретьяЦифра;


	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПОДСТРОКА(ЗаказКлиента.Номер, 5, 7) КАК Номер
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ПОДСТРОКА(ЗаказКлиента.Номер, 3, 5) = &ПрефиксСтарый
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер УБЫВ";
	
	// <-- Начало Лико Яцун С. В. 16.12.2024
	РегионЛинкс = Ложь;	
	Если Регион = Справочники.БизнесРегионы.Линкс Тогда
		РегионЛинкс = Истина;
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ПОДСТРОКА(ЗаказКлиента.Номер, 3, 5) = &ПрефиксСтарый","ПОДСТРОКА(ЗаказКлиента.Номер, 3, 5) = &ПрефиксСтарый И ПОДСТРОКА(ЗаказКлиента.Номер, 5, 7) ПОДОБНО ""___[2-9]___""");
		//ЧетвертаяЦифраМинимум = "2";
		//ПервыеЦифры	= ПервыеЦифры + ЧетвертаяЦифраМинимум;
	ИначеЕсли Регион = Справочники.БизнесРегионы.ВеликийНовгород Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ПОДСТРОКА(ЗаказКлиента.Номер, 3, 5) = &ПрефиксСтарый","ПОДСТРОКА(ЗаказКлиента.Номер, 3, 5) = &ПрефиксСтарый И НЕ ПОДСТРОКА(ЗаказКлиента.Номер, 5, 7) ПОДОБНО ""___[2-9]___""");
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 16.12.2024
	
	Запрос.УстановитьПараметр("ПрефиксСтарый", ПервыеЦифры);

	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	Если ЗначениеЗаполнено(Результат.Номер) Тогда 
		Номер = Организация.Префикс+"00"+Строка(Формат(Число(Результат.Номер ) +1, "ЧГ=0") );
	Иначе
		// <-- Начало Лико Яцун С. В. 16.12.2024
		//Номер = Организация.Префикс+ПервыеЦифры+"0001";
		Если РегионЛинкс Тогда
			Номер = Организация.Префикс+ПервыеЦифры+"2001";
		Иначе
			Номер = Организация.Префикс+ПервыеЦифры+"0001";
		КонецЕсли;
		// <-- Конец Лико Яцун С. В. 16.12.2024
	КонецЕсли;

	Возврат Номер;

КонецФункции



&Вместо("ПередЗаписьюДокументов_ЗаказКлиента")
Процедура Лико_ПередЗаписьюДокументов_ЗаказКлиента(Источник, Отказ, РежимЗаписи, РежимПроведения)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Источник.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.Оснастка Тогда 
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;
	КонецЕсли;

	
	
	Если Источник.Товары.Количество() >0 Тогда
		Если ЗначениеЗаполнено(Источник.Товары[0].Номенклатура) Тогда 
			Источник.ЕдиницаИзмеренияЗаказа =  Источник.Товары[0].Номенклатура.ЕдиницаИзмерения;
		КонецЕсли; 
		Если ЗначениеЗаполнено(Источник.Товары[0].ВнутреннийДиаметр) Тогда 
			Источник.Втулка =  Источник.Товары[0].ВнутреннийДиаметр;
		КонецЕсли;

	КонецЕсли;
	
		
	// --> Начало Лико Митюшин МФМ 15.06.2021
	//Лико_ТиражМетраж.РасчитатьТиражМетраж(Источник) ;
	Если ЗначениеЗаполнено(Источник.ДатаОтправкиВРаботу) И (Источник.МетражКВМ = 0 Или Источник.ШтКВМ = 0) Тогда
		Сообщить("Метраж или Шт КВМ равны 0, проверьте и укажите правильные парамметры штампа.");
		Отказ = Истина;	
		Возврат;
	КонецЕсли;
	// <-- Конец Лико Митюшин МФМ 15.06.2021
	ПоперечнаяРезка = Ложь;
	Если Источник.Товары.Найти(Истина, "ПоперечнаяРезка") <>Неопределено Тогда 
		ПоперечнаяРезка = Истина;
	КонецЕсли;
    Источник.ПоперечнаяРезка = ПоперечнаяРезка;
	
	
	//Заполним Этикетки	
	Этикетки = "";
	Если Источник.ТИпЗаказа = Перечисления.Лико_ТипыЗаказов.Полуфабрикат Тогда 
		Таб = Источник.Товары.Выгрузить();
		Таб.Свернуть("Номенклатура,КодЭтикеткиЗаказчика");
		Для каждого стр из Таб Цикл
			Если ЗначениеЗаполнено(стр.Номенклатура.ЦеноваяГруппа) Тогда 
				Этикетки = Этикетки + "("+СокрЛП(стр.Номенклатура.ЦеноваяГруппа.Код)+")"+" "+СокрЛП(стр.Номенклатура.Наименование);
			Иначе
				Этикетки = Этикетки + " "+СокрЛП(стр.Номенклатура.Наименование);
			КонецЕсли;
			Если ЗначениеЗаполнено(стр.КодЭтикеткиЗаказчика)Тогда
				Этикетки = Этикетки +" * "+ стр.КодЭтикеткиЗаказчика;
			КонецЕсли;	
		КонецЦикла;	 
	Иначе	
		Таб = Источник.Товары.Выгрузить();
		Таб.Свернуть("Номенклатура,КодЭтикеткиЗаказчика");
		Для каждого стр из Таб Цикл
			Этикетки = Этикетки + стр.Номенклатура.Лико_ТипЭтикетки+" "+СокрЛП(стр.Номенклатура.Наименование);
			Если ЗначениеЗаполнено(стр.КодЭтикеткиЗаказчика)Тогда
				Этикетки = Этикетки +" * "+ стр.КодЭтикеткиЗаказчика;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Источник.ОтгрузкаСНастройкой) И Источник.ОтгрузкаСНастройкой<> Неопределено Тогда 
		Источник.ОтгрузкаСНастройкой = Неопределено;
	КонецЕсли;
	Источник.Этикетки  = Этикетки;
	НомераКонтрактов = "";
	Таб = Источник.Товары.Выгрузить();
	Таб.Свернуть("NКонтракта");
	Для каждого стр из Таб Цикл
		Если ЗначениеЗаполнено(стр.NКонтракта) Тогда 
			НомераКонтрактов = НомераКонтрактов+ ?(ЗначениеЗаполнено(НомераКонтрактов)," * ", "") + стр.NКонтракта;	
		КонецЕсли;	
	КонецЦикла;
	Источник.НомераКонтрактов =НомераКонтрактов;
	
	Артикулы = "";
	Таб = Источник.Товары.Выгрузить();
	Таб.Свернуть("Номенклатура,ВерсияНоменклатуры");
	Для каждого стр из Таб Цикл
		Если ЗначениеЗаполнено(стр.Номенклатура) Тогда 
			Если стр.Номенклатура.Лико_DFM Тогда 
				Артикулы = Артикулы+ ?(ЗначениеЗаполнено(Артикулы)," * ", "") + стр.ВерсияНоменклатуры.Артикул;
			Иначе	
				Артикулы = Артикулы+ ?(ЗначениеЗаполнено(Артикулы)," * ", "") + стр.Номенклатура.Артикул;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	Источник.Артикулы =Артикулы;
	
	//Заполним договор
	Если Не ЗначениеЗаполнено(Источник.Договор) Тогда 
		Если ЗначениеЗаполнено(Источник.Партнер) И ЗначениеЗаполнено(Источник.Контрагент) Тогда 
			Источник.Договор = ЗаполнитьДоговорНаСервере(Источник.Партнер,Источник.Контрагент, Источник.Менеджер);
		КонецЕсли;	
	КонецЕсли;

	
	
	ОригиналМакет = Ложь;
	Таб = Источник.Товары.Выгрузить();
	Таб.Свернуть("ОригиналМакет");
	Для каждого стр из Таб Цикл
		Если ЗначениеЗаполнено(стр.ОригиналМакет) Тогда 
			ОригиналМакет = Истина;
		КонецЕсли;	
	КонецЦикла;
	Источник.ОригиналМакет =ОригиналМакет;
	

	ШтампыСтрокой = "";
	ДопМатериалыСтрокой = "";	
	ВидСекцииТрафарет =  Справочники.Лико_ВидыСекций.ТрафаретнаяПечать;
    ВидСекцииНумератор = Справочники.Лико_ВидыСекций.Нумератор; 
	ВидСекцииКонгрев =    Справочники.Лико_ВидыСекций.Конгрев;
	ВидСекцииГорячееТиснениеСНумератором = Справочники.Лико_ВидыСекций.ГорячееТиснениеСНумератором;
	ВидСекцииКнижка = Справочники.Лико_ВидыСекций.Книжка;
	ВидРЦNewFoil = Справочники.ВидыРабочихЦентров.NewFoil;
	ВидРЦIndigo = Справочники.ВидыРабочихЦентров.Indigo;
	 
	ЭтоЦифровой = Ложь;
	ЭтоНФ = ЛОжь;
	ЭтоКнижка = Ложь;
	ЭтоТрафарет = Ложь;
	ЭтоФлексо = Ложь;
	ЭтоТиснение = Ложь;
	ЭтоЛаминация = Ложь;    
	ЭтоКонгрев = Ложь;  
	ЭтоНумератор = Ложь;
	ЛейблШифтер = Ложь;	
		 
	//Если Не Источник.РучнойВводПрокатов Тогда
	//	ЗаполнитьНомерПроката(Источник, Источник.Цифровой) ;
	//КонецЕсли;

//	ПроставитьНомераРабот(Источник);
	Для каждого стр из Источник.Цвета Цикл
		Если Не стр.номерварианта =1 Тогда 
			стр.номерварианта = 1;
		КонецЕсли;
			 
		Если стр.ВидСекции = ВидСекцииТрафарет И Не ЭтоТрафарет Тогда 
			ЭтоТрафарет = Истина;
		//ИначеЕсли  стр.ВидСекции.Родитель = Справочники.Лико_ВидыСекций.Флексо Тогда
		//	 ЭтоФлексо = Истина; 
		ИначеЕсли стр.ВидСекции.Тиснение И Не ЭтоТиснение Тогда  
				ЭтоТиснение = Истина;
	    ИначеЕсли стр.ВидСекции.Ламинация И Не ЭтоЛаминация Тогда  
				ЭтоЛаминация = Истина; 
		ИначеЕсли (стр.ВидСекции = ВидСекцииНумератор ИЛИ   стр.ВидСекции = ВидСекцииГорячееТиснениеСНумератором) И Не ЭтоНумератор Тогда  
				ЭтоНумератор = Истина;	
		ИначеЕсли стр.ВидСекции = ВидСекцииКонгрев И Не ЭтоКонгрев Тогда  
				ЭтоКонгрев = Истина;						 
		ИначеЕсли  стр.ВидСекции = ВидСекцииКнижка  И Не ЭтоКнижка Тогда
            ЭтоКнижка = Истина;
		КонецЕсли;
		
		// --> Начало Лико Ефимов ЕВВ 04.08.2025
		Если Стр.ВидСекции = Справочники.Лико_ВидыСекций.ЛейблШифтер Тогда
			ЛейблШифтер = Истина;
		КонецЕсли;
		// <-- Конец Лико Ефимов ЕВВ 04.08.2025

		Если ЗначениеЗаполнено(стр.РабочийЦентр) Тогда 
			Если Стр.РабочийЦентр.ВидРабочегоЦентра  = ВидРЦNewFoil и Не ЭтоНФ Тогда  
				ЭтоНФНФ = Истина;
			ИначеЕсли Стр.РабочийЦентр.ВидРабочегоЦентра  = ВидРЦIndigo и Не ЭтоЦифровой Тогда  
				ЭтоЦифровой = Истина;	
			КонецЕсли;			
		КонецЕсли;
		
		//20231011
		//Переносим из Видов Работ в Цвета 
	    Если ЗначениеЗаполнено(стр.Оснастка) Тогда 
			ШтампыСтрокой = ШтампыСтрокой+ ?(ЗначениеЗаполнено(ШтампыСтрокой)," * ", "") + стр.Оснастка.Артикул;	
		КонецЕсли;
		Если ЗначениеЗаполнено(стр.Материал) Тогда
			Если стрНайти(ДопМатериалыСтрокой,стр.Материал.Наименование)=0 Тогда  
				ДопМатериалыСтрокой = ДопМатериалыСтрокой+?(ЗначениеЗаполнено(ДопМатериалыСтрокой)," * ", "") +стр.Нарезка+" "+ стр.Материал.Наименование;
			КонецЕсли;	
		КонецЕсли;

		
	КонецЦикла;	
	
	Если Источник.Трафарет <> ЭтоТрафарет Тогда 
		Источник.Трафарет = ЭтоТрафарет;
	КонецЕсли;
	
	Если Источник.Тиснение <> ЭтоТиснение Тогда 
		Источник.Тиснение = ЭтоТиснение;
	КонецЕсли; 
	
	Если Источник.Ламинация <> ЭтоЛаминация Тогда 
		Источник.Ламинация = ЭтоЛаминация ;
	КонецЕсли;   
	
	Если Источник.Нумератор <> ЭтоНумератор Тогда 
		Источник.Нумератор = ЭтоНумератор ;
	КонецЕсли;
	
	Если Источник.Конгрев <> ЭтоКонгрев Тогда 
		Источник.Конгрев = ЭтоКонгрев ;
	КонецЕсли; 
	
	Если Источник.Цифровой <> ЭтоЦифровой Тогда 
		Источник.Цифровой = ЭтоЦифровой ;
	КонецЕсли;
	
	Если Источник.НФ <> ЭтоНФ Тогда 
		Источник.НФ = ЭтоНФ ;
	КонецЕсли; 
	
	Если Не Источник.Цифровой Тогда 
		Источник.КоличествоКликов = 0;
	КонецЕсли;   
	
	Если Источник.КнижныйМодуль <> ЭтоКнижка Тогда 
		 Источник.КнижныйМодуль = ЭтоКнижка;
	КонецЕсли;  
	Если НЕ Источник.Книжка И ЭтоКнижка Тогда 
		 Источник.Книжка = ЭтоКнижка;
	КонецЕсли;  
	
	Источник.ЛейблШифтер = ЛейблШифтер;
	
	Источник.ШтампыСтрокой =ШтампыСтрокой;
	Источник.ДопМатериалыСтрокой =ДопМатериалыСтрокой;
	СтруктураЦены = ПолучитьСреднююЦену(Источник.Ссылка);
	Если  Источник.Товары.Итог("Количество")>0 Тогда
		Источник.ЦенаСредняя =  Источник.Товары.Итог("Сумма")/Источник.Товары.Итог("Количество");
	КонецЕсли;
	Источник.ЦенаДляДокументовСредняя = СтруктураЦены.ЦенаДляДокументовСредняя;
	Источник.СуммаДокумента = Источник.Товары.Итог("СуммаСНДС")+Источник.СтоимостьОснастки;
	
	//Заполним Цвета
	Источник.ЦветаСтрокой = ПолучитьСтрокуЦветов(Источник.Ссылка);
	Если Источник.Цифровой Тогда
		Источник.ЦветаСтрокойЦифра = СтрокаЛакиПоЗаказу(Источник.Ссылка, Истина);
	КонецЕсли;
	Источник.ФормыСтрокой =ПолучитьСтрокуФорм(Источник.Ссылка);
	// --> Начало Лико Ефимов ЕВВ 18.08.2021 
	Источник.GtinСтрокой = ПолучитьGtinСтрокой(Источник);
	// <-- Конец Лико Ефимов ЕВВ 18.08.2021 
	//Первый Рабочий Центр
	//Если Заказ отправлен в работу, то рабочий центр не меняем
	Если Не ЗначениеЗаполнено(Источник.ДатаОтправкиВРаботу) Тогда 
		стр = Источник.ВидыРабот.Найти(1, "НомерПроката");
		Если стр<>Неопределено Тогда 
			Источник.РабочийЦентр = стр.РабочийЦентр;
		КонецЕсли;
	КонецЕсли;  
	
	Если Источник.РабочийЦентр.ПорядковыйНомер = 300 И Источник.Площадка = Справочники.Лико_Площадки.Ликофлекс Тогда 
		Источник.ГруппировкаДляОтчетов = Справочники.Лико_ГруппировкиОтчетовНаСайте.ИксПакДляЛикофлекс;
	ИначеЕсли Источник.Площадка = Справочники.Лико_Площадки.Ликофлекс И Источник.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Термоусадка Тогда 
		Источник.ГруппировкаДляОтчетов = Справочники.Лико_ГруппировкиОтчетовНаСайте.ЛикофлексТУ;    
	Иначе
		Источник.ГруппировкаДляОтчетов = Источник.Площадка.ГруппировкаДляОтчетов;
    КонецЕсли;
	
	
	// --> Начало Лико Ефимов ЕВВ 02.09.2024
	Источник.ЕстьНезаполненныеФормы = Ложь;
	Для каждого Строка из Источник.Цвета Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Форма)
			И ЗначениеЗаполнено(Строка.ВидТМЦ)
			И НЕ ВРег(СокрЛП(Строка.Название)) = ВРег("Полоса")
			И (Строка.ВидЗаливки = Перечисления.Лико_ВидЗаливки.НеСплошная
				ИЛИ Строка.ВидТМЦ = Справочники.Лико_ВидыТМЦ.Краска) 
			И НЕ (Строка.ВидСекции = Справочники.Лико_ВидыСекций.ЦифровойЛак
				ИЛИ Строка.ВидСекции = Справочники.Лико_ВидыСекций.Инкджет
				ИЛИ Строка.ВидСекции = Справочники.Лико_ВидыСекций.ЦифровоеТиснение
				ИЛИ Строка.ВидСекции = Справочники.Лико_ВидыСекций.Нумератор)
			И Строка.РабочийЦентр.ВидРабочегоЦентра <> Справочники.ВидыРабочихЦентров.СклейкаТермоусадки
			Тогда
			Источник.ЕстьНезаполненныеФормы = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	// <-- Конец Лико Ефимов ЕВВ 02.09.2024
		
	УстановитьПривилегированныйРежим(Ложь);
	


КонецПроцедуры


&Вместо("ПроверкаЗаполненияЗаказа")
Функция Лико_ПроверкаЗаполненияЗаказа(Заказ)
	Если Заказ.Площадка <> Справочники.Лико_Площадки.Линкс Тогда 
		Если  Заказ.ВидЗаказа= Перечисления.Лико_ВидыЗаказов.ПолныйПовтор ИЛИ Заказ.ВидЗаказа= Перечисления.Лико_ВидыЗаказов.ПовторСИзменением ИЛИ  Заказ.ВидЗаказа= Перечисления.Лико_ВидыЗаказов.ПовторСНовымОбъединением  ИЛИ  Заказ.ВидЗаказа=Перечисления.Лико_ВидыЗаказов.ПолныйповторСПеревыводом Тогда
			Если Не ЗначениеЗаполнено(Заказ.ПовторЗаказа) Тогда
				Возврат "Необходимо указать номер повторяемого заказа!";
			КонецЕсли;
		КонецЕсли; 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка КАК Ссылка,
		|	ЗаказКлиента.ОсновнойМатериал.Код КАК ОсновнойМатериалКод
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Ссылка = &Заказ
		|	И ЗаказКлиента.ВидЗаказа <> ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.Пробник)
		|			И ЗаказКлиента.ВидЗаказа <> ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.ЦифроваяПроба)
		|			И ЗаказКлиента.ВидЗаказа <> ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.ТестированиеМатериалов)
		|	И ВЫБОР
		|			КОГДА ЗаказКлиента.ОсновнойМатериал ССЫЛКА Справочник.Номенклатура
		|				ТОГДА ПОДСТРОКА(ЗаказКлиента.ОсновнойМатериал.ЦеноваяГруппа.Код, 1, 1) = ""9""
		|						ИЛИ ПОДСТРОКА(ЗаказКлиента.ОсновнойМатериал.ЦеноваяГруппа.Код, 1, 3) = ""598""
		|			ИНАЧЕ ПОДСТРОКА(ЗаказКлиента.ОсновнойМатериал.Код, 1, 1) = ""9""
		|					ИЛИ ПОДСТРОКА(ЗаказКлиента.ОсновнойМатериал.Код, 1, 3) = ""598""
		|		КОНЕЦ";
		Запрос.УстановитьПараметр("Заказ", Заказ);		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда 
			Результат = РезультатЗапроса.Выбрать();
			Результат.Следующий();
			Если ЗначениеЗаполнено(Результат.ОсновнойМатериалКод) Тогда 
				Возврат "Выбранный основной материал применяется только для пробников!!!";
			КонецЕсли;	
		КонецЕсли;	

		
		
	КонецЕсли;	

	
	Если не (РольДоступна("ПолныеПрава") или РОльДоступна("Лико_ЗакрытиеОтгрузки") ) Тогда 
		Если Заказ.ВидЗаказа = Перечисления.Лико_ВидыЗаказов.ПолныйПовтор Тогда 
			Если Заказ.ОбразецЦвета = Перечисления.Лико_ОбразцыЦвета.УтверждениеОбразцаПриПечати Тогда 
				 Возврат "Не корректно указан образец цвета для Полного повтора! ";
			КонецЕсли;
			Если Заказ.ЧестныйЗнак Тогда 
				 Возврат "Честный знак не может быть Полным повтором! ";
			КонецЕсли;

			
			Если Заказ.Площадка = Справочники.Лико_Площадки.Ликофлекс Тогда 
				ОбъектКопирования = Заказ.ПовторЗаказа;
				Если ЗначениеЗаполнено(ОбъектКопирования) Тогда 
					ВидРЦПервогоПрокатаЗаказа = ПолучитьРЦПервогоПроката(Заказ);
					ВидРЦПервогоПрокатаОК = ПолучитьРЦПервогоПроката(ОбъектКопирования);
					МассивРЦРавны = Новый Массив;
					МассивРЦРавны.Добавить(Справочники.ВидыРабочихЦентров.GallusGranitic);
					МассивРЦРавны.Добавить(Справочники.ВидыРабочихЦентров.Omet);
					МассивРЦРавны.Добавить(Справочники.ВидыРабочихЦентров.MPS);   
					МассивРЦРавны.Добавить(Справочники.ВидыРабочихЦентров.Flexo);

					Если ВидРЦПервогоПрокатаЗаказа <> ВидРЦПервогоПрокатаОК Тогда
						// <-- Начало Лико Яцун С. В. 19.06.2024
						Если ВидРЦПервогоПрокатаЗаказа = Справочники.ВидыРабочихЦентров.GallusInkjet 
							И Заказ.Цвета.НайтиСтроки(Новый Структура("ВидСекции",Справочники.Лико_ВидыСекций.Инкджет)).Количество() = 0 
							И Заказ.Цвета.НайтиСтроки(Новый Структура("ВидСекции",Справочники.Лико_ВидыСекций.ЦифровойЛак)).Количество() = 0 Тогда
							МассивРЦРавны.Добавить(Справочники.ВидыРабочихЦентров.GallusInkjet);	 	
						ИначеЕсли ВидРЦПервогоПрокатаОК = Справочники.ВидыРабочихЦентров.GallusInkjet 
							И ОбъектКопирования.Цвета.НайтиСтроки(Новый Структура("ВидСекции",Справочники.Лико_ВидыСекций.Инкджет)).Количество() = 0 
							И ОбъектКопирования.Цвета.НайтиСтроки(Новый Структура("ВидСекции",Справочники.Лико_ВидыСекций.ЦифровойЛак)).Количество() = 0 Тогда
							МассивРЦРавны.Добавить(Справочники.ВидыРабочихЦентров.GallusInkjet);
						ИначеЕсли ВидРЦПервогоПрокатаЗаказа = Справочники.ВидыРабочихЦентров.Bobst ИЛИ ВидРЦПервогоПрокатаЗаказа = Справочники.ВидыРабочихЦентров.Rotomec Тогда
							МассивРЦРавны.Добавить(Справочники.ВидыРабочихЦентров.Rotomec);
							МассивРЦРавны.Добавить(Справочники.ВидыРабочихЦентров.Bobst);
						КонецЕсли;
						// <-- Конец Лико Яцун С. В. 19.06.2024
						Если МассивРЦРавны.Найти(ВидРЦПервогоПрокатаЗаказа) = Неопределено ИЛИ МассивРЦРавны.Найти(ВидРЦПервогоПрокатаОК) = Неопределено Тогда
							Возврат "Вид РЦ заказа и Вид РЦ объекта копирования не совпадают! ";
						КонецЕсли;
					КонецЕсли;
				КонецЕсли; 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
		
	Если Заказ.Товары.Количество()= 0 Тогда 
		Возврат "В заказе не указано, что необходимо выполнить!";	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Заказ.Соглашение)  Тогда 
		Возврат "В заказе не указано соглашение!";	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Заказ.ВалютаДляДокументов)  Тогда 
		Возврат "В заказе не указана валюта для документов!";	
	КонецЕсли;

	
	Если Заказ.ОбразцыЦвета.Количество() = 0 Тогда 
		Возврат "Не указан образец цвета!";
	КонецЕсли;
	
	Если Заказ.ОбразцыЦвета.Найти(Перечисления.Лико_ОбразцыЦвета.ВнутреннийОбразец) <> Неопределено Тогда 
		Возврат "Данное определение образца цвета больше не используется, укажите образец цвета!";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Заказ.ОсновнойМатериал) Тогда 
		Возврат "Не указан основной материал";
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Заказ.СпособНаклейки) Тогда 
		Возврат "Не указан способ наклейки";
	КонецЕсли;

	
	Если Заказ.Площадка = Справочники.Лико_Площадки.ИксПак Тогда 
		Если  Не ЗначениеЗаполнено(Заказ.ВидКонтактаСПищевойПродукцией)  Тогда 
			Возврат "В заказе не указан вид контакта с пищевой продукцией!";	
		КонецЕсли;
		Если Заказ.ВидКонтактаСПищевойПродукцией = Справочники.Лико_ВидыКонтактовСПищевойПродукцией.ПрямойКонтакт Тогда 
			КонтактныйСлой = Заказ.ОсновнойМатериалКонтактныйСлой;
			Для Каждого стр из Заказ.ВидыРабот Цикл
				Если стр.КонтактныйСлой Тогда
					КонтактныйСлой = стр.КонтактныйСлой;
				КонецЕсли;
			КонецЦикла;
			Если  Не КонтактныйСлой  Тогда 
				Возврат "В заказе не указан контактный слой с пищевой продукцией!";	
			КонецЕсли;
		КонецЕсли;
			
	КонецЕсли;



	


	
	Если Заказ.ВидЗаказа<>Перечисления.Лико_ВидыЗаказов.Пробник И  Заказ.ВидЗаказа<>Перечисления.Лико_ВидыЗаказов.ЦифроваяПроба И Заказ.ТипЗаказа <> Перечисления.Лико_ТипыЗаказов.Полуфабрикат Тогда 
		Если Не ЗначениеЗаполнено(Заказ.ВидУпаковки) Тогда 
			Возврат "Не указан вид упаковки!";
		КонецЕсли;	
	КонецЕсли;

	
	//Если в вырубном штампе только 1 ручей, то в намотке не должно быть продольной резки
	Если Заказ.Ручьи = 1 Тогда 
		Отбор = Новый Структура("ПродольнаяРезка", Истина);
		Резка = Заказ.Товары.НайтиСтроки(Отбор);
		Если Резка.Количество() >0 Тогда 
			Возврат "В заказе указан 1 ручей, продольная резка не возможна!";
		КонецЕсли;
	КонецЕсли;	
	
	Если Заказ.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Термоусадка Тогда 
		Если (Заказ.ШиринаРукаваТУ*2+6)<>Заказ.ШиринаЭтикетки Тогда 
			Если (Заказ.ШиринаРукаваТУ*2+7)<>Заказ.ШиринаЭтикетки Тогда 
				Возврат "Не корректно указана ширина этикетки или ширина рукава!";
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;

	Для каждого стр из Заказ.Товары Цикл
		Если стр.Количество = 0 Тогда 
			Возврат "В строке №"+стр.номерстроки+" указано нулевое количество";		
		КонецЕсли;
		Если Заказ.ТипЗаказа <> Перечисления.Лико_ТипыЗаказов.Полуфабрикат Тогда 
			Если Заказ.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.Пробник И  Заказ.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ЦифроваяПроба и Заказ.ВидЗаказа <> Перечисления.Лико_ВидыЗаказов.ВнутренниеНужды Тогда
				Если стр.Сумма = 0 Тогда 
					Возврат "В строке №"+стр.номерстроки+" указана нулевая сумма";	
				КонецЕсли;

				Если ЗначениеЗаполнено(стр.кромка) ТОгда
					Если Не ЗначениеЗаполнено(стр.КоличествоЭтикетокВРолике) И Не ЗначениеЗаполнено(стр.МаксимальныйДиаметрРулона) Тогда
						Возврат "В строке №"+стр.номерстроки+" не указано количество эт. в ролике/пачке или макс. диаметр!";
					КонецЕсли;
				КонецЕсли;	
				Если Заказ.ТипЗаказа <>Перечисления.Лико_ТипыЗаказов.ВплавляемаяЭтикетка И Заказ.ТипЗаказа <>Перечисления.Лико_ТипыЗаказов.Термоусадка И Заказ.ТипЗаказа <>Перечисления.Лико_ТипыЗаказов.Упаковка Тогда 
					Если стр.БезКромки = Ложь и Не ЗначениеЗаполнено(стр.Кромка) Тогда 
						Возврат "В строке №"+стр.номерстроки+" не указан размер кромки";
					КонецЕсли;
					Если Не стр.ПоперечнаяРезка Тогда 
