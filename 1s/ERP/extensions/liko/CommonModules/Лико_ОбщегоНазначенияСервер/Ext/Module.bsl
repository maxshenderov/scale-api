  
//&Вместо("СоздатьРедактироватьВозвратСырьяДавальцу")
Процедура Лико_СоздатьРедактироватьВозвратСырьяДавальцу2(Документ, ЗаказКлиента, Заказчик, Знач Выпуск, Отказ)

	ДокументСсылка=НайтиДокумент("ВозвратСырьяДавальцу","Лико_Документ",Документ);

	Если  ДокументСсылка<>Неопределено Тогда
		ДокументОбъект=ДокументСсылка.ПолучитьОбъект();
	Иначе
		ДокументОбъект= Документы.ВозвратСырьяДавальцу.СоздатьДокумент();
	КонецЕсли;       


	ЗаказДавальца=НайтиДокумент("ЗаказДавальца","Лико_ЗаказКлиента",ЗаказКлиента);

	Если ЗаказДавальца=Неопределено Тогда
		Отказ=Истина;
		Возврат;
	КонецЕсли;


	ВалютаРуб = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаЕвр = Константы.ВалютаУправленческогоУчета.Получить();


	Если ЗначениеЗаполнено(ЗаказДавальца) Тогда          

		//Массив = Новый Массив();
		//Массив.Добавить(ЗаказДавальца);
		//Структура = Новый Структура;
		//Структура.Вставить("МассивЗаказов",Массив);
		ДокументОбъект.Заполнить(ЗаказДавальца);
		//ЗаполнитьЗначенияСвойств(ДокументОбъект,ЗаказДавальца,,"Номер,Дата,Ссылка");
		//ДокументОбъект.ЗаказДавальца=ЗаказДавальца;                   
	КонецЕсли;
	ДокументОбъект.Лико_Документ=Документ;
	ДокументОбъект.Лико_НеНужныДвиженияОрдерныхСкладов=Истина;
	Тз=Выпуск;
	Если ЗначениеЗаполнено(ЗаказДавальца) Тогда
		Тз.Колонки.Добавить("ЗаказДавальца");
	КонецЕсли;
	Для каждого СтрТЗ Из Тз Цикл
		Если ЗначениеЗаполнено(ЗаказДавальца) Тогда
			СтрТЗ.ЗаказДавальца= ЗаказДавальца;
		КонецЕсли;                                         
	КонецЦикла;
	//НовоеРаспоряжение.Валюта=Валюта;
	ДокументОбъект.Комментарий = ""  + "Создан автоматически на основании документа """ + Документ + """";
	ДокументОбъект.Дата=Документ.Дата;

	ФизЛицо = Документ.АвторДокумента; 
	//ФизЛицо = УправлениеСвойствами.ЗначениеСвойства(ДокументОбъект.Организация,"Лико_ФизЛицоПриПередачеВЭксплуатацию");

	ДокументОбъект.Отпустил = ФизЛицо;
	ДокументОбъект.ОтпустилДолжность = Лико_Дополнительно.НайтиДолжностьФизЛица(ДокументОбъект.Отпустил, ДокументОбъект.Организация, ДокументОбъект.Дата);
	Если НЕ ЗначениеЗаполнено(ДокументОбъект.ОтпустилДолжность) Тогда
		ДокументОбъект.ОтпустилДолжность = "Кладовщик";
	КонецЕсли;
	ДокументОбъект.ПометкаУдаления=Ложь;
	ДокументОбъект.Менеджер = ПараметрыСеанса.ТекущийПользователь;
	ДокументОбъект.Руководитель = Лико_Дополнительно.НайтиЛицоСПравомПодписи(ДокументОбъект.Организация, Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ФизЛицо, ДокументОбъект.Дата); 
	ДокументОбъект.ГлавныйБухгалтер = Лико_Дополнительно.НайтиЛицоСПравомПодписи(ДокументОбъект.Организация, Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, ФизЛицо, ДокументОбъект.Дата); 

	//ДокументОбъект.ГлавныйБухгалтер = Лико_Дополнительно.НайтиЛицоСПравомПодписи(ДокументОбъект.Организация, Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, ДокументОбъект.Отпустил, ДокументОбъект.Дата); 
	//ДляДокумента=ПолучитьСтруктуруДляЗаполненияТиповыхДокументов();
	//НовоеРаспоряжение.Договор       =ДляДокумента.Договор;              
	//НовоеРаспоряжение.Основание                      =НовоеРаспоряжение.Договор.Наименование;
	//НовоеРаспоряжение.ОснованиеДата            =НовоеРаспоряжение.Договор.Дата;
	//НовоеРаспоряжение.ОснованиеНомер=НовоеРаспоряжение.Договор.Номер;


	ДокументОбъект.Основание="Возврат неиспользованного давальческого сырья по заказу № "+ЗаказКлиента.НомерБезПрефикса+". Договор №"+СокрЛП(ДокументОбъект.Договор.Номер)+" от " +Формат(ДокументОбъект.Договор.Дата,"ДЛФ=D")+"г." ;
	Если ЗначениеЗаполнено(ЗаказДавальца) Тогда
		Тз.Свернуть("Номенклатура,Характеристика,ЗаказДавальца","Количество,КоличествоУпаковок");
	Иначе
		Тз.Свернуть("Номенклатура,Характеристика","Количество,КоличествоУпаковок"); 
	КонецЕсли;
	ДокументОбъект.Валюта=ВалютаРуб;


	//+ Лико m.shenderov 15.09.2019
	Тз=Документ.Товары.Выгрузить(,"Номенклатура,Характеристика,Серия,Количество,Цена");

	Для каждого СтрТз Из Тз Цикл
		ЗаказДавальцаПоступление=ЗаказДавальца;

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|              Лико_ПередачаТоваровТовары.Ссылка.ЗаказКлиента КАК ЗаказКлиента,
		|              ПередачаСырьяПереработчику.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ Вт
		|ИЗ
		|              Документ.ПоступлениеСырьяОтДавальца КАК ПередачаСырьяПереработчику
		|                             ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
		|                             ПО (Лико_ПередачаТоваровТовары.Ссылка = ПередачаСырьяПереработчику.Лико_Документ)
		|ГДЕ
		|              Лико_ПередачаТоваровТовары.Ссылка.ВидОперации = &ВидОперации
		|              И Лико_ПередачаТоваровТовары.Серия = &Серия
		|              И Лико_ПередачаТоваровТовары.Ссылка.Проведен
		|              И Лико_ПередачаТоваровТовары.Ссылка.Дата < &Дата
		|              И НЕ Лико_ПередачаТоваровТовары.Ссылка.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|              Лико_ПередачаТоваровТовары.Ссылка.Дата УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|              ЗаказДавальца.Ссылка КАК ЗаказДавальца,
		|              Вт.Ссылка КАК Ссылка
		|ИЗ
		|              Вт КАК Вт
		|                             ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказДавальца КАК ЗаказДавальца
		|                             ПО Вт.ЗаказКлиента = ЗаказДавальца.Лико_ЗаказКлиента
		|ГДЕ
		|              ЗаказДавальца.Проведен
		|              И НЕ ЗаказДавальца.ПометкаУдаления";
		Запрос.УстановитьПараметр("ВидОперации",Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаВПереработку);
		Запрос.УстановитьПараметр("Серия",СтрТЗ.Серия);
		Запрос.УстановитьПараметр("Дата",Документ.Дата);

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		ПоступлениеСырьяОтДавальца=Неопределено;
		Пока Выборка.Следующий() Цикл                       
			ЗаказДавальцаПоступление=Выборка.ЗаказДавальца; 
			ПоступлениеСырьяОтДавальца=Выборка.Ссылка;
		КонецЦикла; 

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|              ПередачаСырьяПереработчикуТовары.Цена КАК Цена
		|ИЗ
		|              Документ.ПоступлениеСырьяОтДавальца.Товары КАК ПередачаСырьяПереработчикуТовары
		|ГДЕ
		|              ПередачаСырьяПереработчикуТовары.Номенклатура = &Номенклатура
		|              И ВЫБОР
		|                                             КОГДА &ПоПоступлениюСырьяОтДавальца
		|                                                             ТОГДА ПередачаСырьяПереработчикуТовары.Ссылка = &ПоступлениеСырьяОтДавальца
		|                                             ИНАЧЕ ПередачаСырьяПереработчикуТовары.ЗаказДавальца = &ЗаказДавальца
		|                             КОНЕЦ";
		Запрос.УстановитьПараметр("Номенклатура",СтрТЗ.Номенклатура);
		Запрос.УстановитьПараметр("ЗаказДавальца",ЗаказДавальцаПоступление);
		Запрос.УстановитьПараметр("ПоПоступлениюСырьяОтДавальца",ЗначениеЗаполнено(ПоступлениеСырьяОтДавальца));
		Запрос.УстановитьПараметр("ПоступлениеСырьяОтДавальца",ПоступлениеСырьяОтДавальца);

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрТЗ.Цена=Выборка.Цена;
		КонецЦикла;    
	КонецЦикла;

	Тз.Свернуть("Номенклатура,Характеристика,Цена","Количество");

	//- Лико m.shenderov 15.09.2019


	ДокументОбъект.Товары.Загрузить(Тз); 
	Для каждого СтрокаТовары Из ДокументОбъект.Товары Цикл            

		СтрокаТовары.ЗаказДавальца=ЗаказДавальца;
		СтрокаТовары.КоличествоУпаковок=СтрокаТовары.Количество;






		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСумму");
		//СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", ДокументОбъект.НалогообложениеНДС);
		//СтруктураДействий.Вставить("ПересчитатьСуммуНДС", Новый Структура("ЦенаВключаетНДС,СтавкаНДС", ЗаказДавальца.ЦенаВключаетНДС, ЗаказДавальца.СтавкаНДС));
		//СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураДействий.ПересчитатьСуммуНДС);
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, Неопределено);

	КонецЦикла;

	ДокументОбъект.Товары.Сортировать("Номенклатура,Характеристика"); 
	ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьКонтрольПриПроведении",Истина); 
	Попытка                                                             
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);                                                  
	Исключение
		Отказ = Истина;
		Сообщить("Документ """ + ДокументОбъект + """ не удалось провести! Транзакция по созданию типовых документов отменена. " + ОписаниеОшибки());

	КонецПопытки;



КонецПроцедуры

&Вместо("ПроверкаСвойствТМЦ")
Функция Лико_ПроверкаСвойствТМЦ(НоменклатураПроверки, ВидТМЦ, ВидСекции, ЦеноваяГруппа)


	Результат				=	"";

	ЦеноваяГруппаПроверки	=	НоменклатураПроверки.ЦеноваяГруппа; 	
	ВидТМЦПроверки			=	НоменклатураПроверки.Лико_видТМЦ;  

	Если ЦеноваяГруппаПроверки=ЦеноваяГруппа Тогда

		Возврат Результат;

	КонецЕсли;


	Если  ВидТМЦПроверки<>ВидТМЦ Тогда

		Результат=Результат+СтрШаблон("Не соответствует вид ТМЦ, требуется : ""%1"". ",ВидТМЦ);

	КонецЕсли;	

	Если  ЦеноваяГруппа.Лико_ВидыСекций.Найти(ВидСекции)=Неопределено Тогда

		Результат=Результат+СтрШаблон("Не соответствует вид работ (для вида секции)  требуется : ""%1"". ",ВидСекции);

	КонецЕсли;

	Если ЗначениеЗаполнено(ЦеноваяГруппа.Лико_Глянцевость) и  ЦеноваяГруппа.Лико_Глянцевость<>ЦеноваяГруппаПроверки.Лико_Глянцевость Тогда

		Результат=Результат+СтрШаблон("Не соответствует Глянцевость, требуется:""%1"". ",ЦеноваяГруппа.Лико_Глянцевость);

	КонецЕсли;

	Если ЗначениеЗаполнено(ЦеноваяГруппа.Лико_Основа) и  ЦеноваяГруппа.Лико_Основа<>ЦеноваяГруппаПроверки.Лико_Основа Тогда

		Результат=Результат+СтрШаблон("Не соответствует Основа,  требуется : ""%1"". ",ЦеноваяГруппа.Лико_Основа);

	КонецЕсли;   

	Если  ЦеноваяГруппа.Лико_ТУ<>ЦеноваяГруппаПроверки.Лико_ТУ Тогда

		Результат=Результат+СтрШаблон("Не соответствует применение, %1 ""ТУ"". ",?(ЦеноваяГруппа.Лико_ТУ,"требуется","не требуется"))  ;

	КонецЕсли;

	Возврат Результат;

КонецФункции

&Вместо("ПланРаботЗпПериод")
Функция Лико_ПланРаботЗпПериод(НачалоПериода, КонецПериода, СписокМашин)
	
	УстановитьПривилегированныйРежим(Истина);
	СписокНомеровМашин= Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(СписокМашин) Тогда
		ОтображениеРабочихЦентров=СписокМашин;
	Иначе
		ОтображениеРабочихЦентров=УправлениеСвойствами.ЗначениеСвойства(ПараметрыСеанса.ТекущийПользователь,Справочники.Лико_ПредопределенныеЗначения.ДопРеквизитПользователяОтображениеРабочихЦентров.ЗначениеПараметра);
	КонецЕсли;
	
	СписокНомеровМашин= Новый СписокЗначений;
	//ОтображениеРабочихЦентров=УправлениеСвойствами.ЗначениеСвойства(ПараметрыСеанса.ТекущийПользователь,Справочники.Лико_ПредопределенныеЗначения.ДопРеквизитПользователяОтображениеРабочихЦентров.ЗначениеПараметра);
	Если ЗначениеЗаполнено(ОтображениеРабочихЦентров) Тогда
		Для каждого РЦ Из ОтображениеРабочихЦентров.РабочиеЦентры Цикл
			СписокНомеровМашин.Добавить(Рц.РабочийЦентр.ПорядковыйНомер);
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|             ЗаказКлиента.НомерБезПрефикса КАК НомерЗаказа
	|ИЗ
	|             РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2
	|                             ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
	|                             ПО ПооперационноеРасписание2_2.Этап.Распоряжение.ДокументОснование = ЗаказКлиента.Ссылка
	|                             ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ОтображениеРабочихЦентров.РабочиеЦентры КАК Лико_ОтображениеРабочихЦентровРабочиеЦентры
	|                             ПО ПооперационноеРасписание2_2.РабочийЦентр = Лико_ОтображениеРабочихЦентровРабочиеЦентры.РабочийЦентр
	|ГДЕ
	|             Лико_ОтображениеРабочихЦентровРабочиеЦентры.Ссылка = &ОтображениеРабочихЦентров
	|И          ПооперационноеРасписание2_2.Выполнено = 0
	|И НЕ ПооперационноеРасписание2_2.Моделирование 
	//|         И НЕ(ПооперационноеРасписание2_2.Начало > &Дата2
	|             И                                            ПооперационноеРасписание2_2.Окончание < &Дата1";
	Запрос.УстановитьПараметр("Дата1",НачалоПериода );
	Запрос.УстановитьПараметр("Дата2",КонецПериода+20*24*60*60 );
	Запрос.УстановитьПараметр("ОтображениеРабочихЦентров",ОтображениеРабочихЦентров);
	
	
	НомераЗаказов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НомерЗаказа");
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|             ТССтатистикаСкорости.РабочийЦентр КАК РабочийЦентр,
	|             МАКСИМУМ(ТССтатистикаСкорости.ДатаНачала) КАК ДатаНачала
	|ПОМЕСТИТЬ ВТ_ДатыПоследнихЗаписейМашин
	|ИЗ
	|             РегистрСведений.ТССтатистикаСкорости КАК ТССтатистикаСкорости
	|ГДЕ
	|             ТССтатистикаСкорости.РабочийЦентр <> ЗНАЧЕНИЕ(Справочник.РабочиеЦентры.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|             ТССтатистикаСкорости.РабочийЦентр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|             ТССтатистикаСкорости.РабочийЦентр КАК РабочийЦентр,
