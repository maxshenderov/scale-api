	Иначе
		
		ТекстЗапроса= "ВЫБРАТЬ
		              |	Остатки.Ячейка КАК Ячейка
		              |ИЗ
		              |	РегистрНакопления.ТоварыВЯчейках.Остатки(, Серия = &Серия) КАК Остатки
		              |ГДЕ
		              |	Остатки.Серия = &Серия
		              |	И (Остатки.Ячейка.Лико_Организация = &Организация
		              |			ИЛИ Остатки.Ячейка.Лико_ОрганизацияОтветственногоХранения = &Организация)"; 
	КонецЕсли;        

	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;  

	Запрос.УстановитьПараметр("Серия",Серия );
	Запрос.УстановитьПараметр("Дата",Дата );
	Запрос.УстановитьПараметр("Организация",Организация);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Массив = Новый Массив();
	Пока Выборка.Следующий() Цикл                       
		Массив.Добавить(Выборка.Ячейка);  
	КонецЦикла;  


	Возврат Массив;             
КонецФункции
