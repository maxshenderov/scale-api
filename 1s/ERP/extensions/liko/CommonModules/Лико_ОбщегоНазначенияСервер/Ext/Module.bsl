	|	И НЕ ЗаказКлиентаЦвета.РабочийЦентр.ВидРабочегоЦентра В (ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.Cartes), ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.NewFoil))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиентаЦвета.Вал КАК Оснастка,
	|	ВТ.Заказ КАК Заказ,
	|	ЗаказКлиентаЦвета.НомерПроката КАК НомерПередела
	|ПОМЕСТИТЬ ВтЗаказНоменклатураВалы
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	|		ПО ВТ.Заказ = ЗаказКлиентаЦвета.Ссылка
	|			И ВТ.НомерВарианта = ЗаказКлиентаЦвета.НомерВарианта
	|ГДЕ
	|	ЗаказКлиентаЦвета.Вал <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И НЕ ЗаказКлиентаЦвета.РабочийЦентр.ВидРабочегоЦентра В (ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.Cartes), ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.NewFoil))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтЗаказНоменклатура.Заказ КАК Заказ,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0) > 0
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Количество,
	|	МИНИМУМ(ТоварыВЯчейкахОстатки.ВНаличииОстаток) КАК КоличествоОстаток,
	|	ВтЗаказНоменклатура.НомерПередела КАК НомерПередела
	|ПОМЕСТИТЬ ВтНоменклатураРЦ
	|ИЗ
	|	ВтЗаказНоменклатура КАК ВтЗаказНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
	|				,
	|				Ячейка.Помещение = &ПомещениеПроизводство
	|					И Номенклатура В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							ВтЗаказНоменклатура.Оснастка
	|						ИЗ
	|							ВтЗаказНоменклатура КАК ВтЗаказНоменклатура)) КАК ТоварыВЯчейкахОстатки
	|		ПО ВтЗаказНоменклатура.Оснастка = ТоварыВЯчейкахОстатки.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтЗаказНоменклатура.Заказ,
	|	ВтЗаказНоменклатура.НомерПередела
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтЗаказНоменклатураВалы.Заказ КАК Заказ,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0) > 0
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Количество,
	|	ВтЗаказНоменклатураВалы.НомерПередела КАК НомерПередела
	|ПОМЕСТИТЬ ВтНоменклатураРЦВалы
	|ИЗ
	|	ВтЗаказНоменклатураВалы КАК ВтЗаказНоменклатураВалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
	|				,
	|				Ячейка.Помещение = &ПомещениеПроизводство
	|					И Номенклатура В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							ВтЗаказНоменклатура.Оснастка
	|						ИЗ
	|							ВтЗаказНоменклатураВалы КАК ВтЗаказНоменклатура)) КАК ТоварыВЯчейкахОстатки
	|		ПО ВтЗаказНоменклатураВалы.Оснастка = ТоварыВЯчейкахОстатки.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтЗаказНоменклатураВалы.Заказ,
	|	ВтЗаказНоменклатураВалы.НомерПередела
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ТССтатистикаСкорости.МетражОборот) КАК МетражФакт,
	|	СУММА(ТССтатистикаСкорости.Длительность) КАК ВремяФакт,
	|	ВтЗаказ.РабочийЦентр КАК РабочийЦентр,
	|	ВтЗаказ.Заказ КАК Заказ,
	|	СУММА(Лико_ПараметрыПроизводстваЗаказа.МетражДляРЦ) КАК МетражПлан,
	|	СУММА(Лико_ПараметрыПроизводстваЗаказа.ВремяПечати + Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку) КАК ВремяПлан
	|ПОМЕСТИТЬ ВтСтатистика
	|ИЗ
	|	ТССтатистикаСкорости КАК ТССтатистикаСкорости
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтЗаказ КАК ВтЗаказ
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|			ПО ВтЗаказ.Заказ = Лико_ПараметрыПроизводстваЗаказа.Заказ
	|				И ВтЗаказ.РабочийЦентр = Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр
	|		ПО ТССтатистикаСкорости.Заказ = ВтЗаказ.Заказ.НомерБезПрефикса
	|			И ТССтатистикаСкорости.РабочийЦентр = ВтЗаказ.РабочийЦентр.ПорядковыйНомер
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтЗаказ.РабочийЦентр,
	|	ВтЗаказ.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВтЗаказ.Заказ КАК Заказ,
	|	Лико_ПередачаТоваровФормы.Форма КАК Форма,
	|	МАКСИМУМ(Лико_ПередачаТоваровФормы.Ссылка.Дата) КАК Дата
	|ПОМЕСТИТЬ ВтФормы
	|ИЗ
	|	ВтЗаказ КАК ВтЗаказ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_ПередачаТоваров.Формы КАК Лико_ПередачаТоваровФормы
	|		ПО ВтЗаказ.Заказ = Лико_ПередачаТоваровФормы.Ссылка.ЗаказКлиента
	|			И (Лико_ПередачаТоваровФормы.Ссылка.ВидОперации = &ВидОперации)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтЗаказ.Заказ,
	|	Лико_ПередачаТоваровФормы.Форма
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ИСТИНА) КАК ЕстьФорма,
	|	ВтФормы.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВтВозвратФормЗаказ
	|ИЗ
	|	Документ.Лико_ВозвратТоваров.Формы КАК Лико_ВозвратТоваровФормы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтФормы КАК ВтФормы
	|		ПО Лико_ВозвратТоваровФормы.Форма = ВтФормы.Форма
	|			И (Лико_ВозвратТоваровФормы.Ссылка.ВидОперации = &ВидОперацииВозврат)
	|			И Лико_ВозвратТоваровФормы.Ссылка.Дата > ВтФормы.Дата
	|ГДЕ
	|	Лико_ВозвратТоваровФормы.Ссылка.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтФормы.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтФормы.Заказ КАК Заказ
	|ПОМЕСТИТЬ ВтФормыЗаказ
	|ИЗ
	|	ВтФормы КАК ВтФормы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтФормы.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтЗаказ.Заказ КАК Заказ,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ИСТИНА) КАК ЕстьФлексоФорма,
	|	ЗаказКлиентаЦвета.НомерПроката КАК НомерПередела
	|ПОМЕСТИТЬ ВтЗакзыСФлексоФормами
	|ИЗ
	|	ВтЗаказ КАК ВтЗаказ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	|		ПО ВтЗаказ.Заказ = ЗаказКлиентаЦвета.Ссылка
	|ГДЕ
	|	ЗаказКлиентаЦвета.ВидСекции.ВидПечати = ЗНАЧЕНИЕ(Справочник.Лико_ВидыПечати.Флексо)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтЗаказ.Заказ,
	|	ЗаказКлиентаЦвета.НомерПроката
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтЗаказ.Заказ КАК Заказ,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВтНоменклатураРЦ.Количество, 1) > 0
	|				И ЕСТЬNULL(ВтНоменклатураРЦВалы.Количество, 1) > 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Оснастка,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВтЗакзыСФлексоФормами.ЕстьФлексоФорма, ЛОЖЬ) = ЛОЖЬ
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ВтВозвратФормЗаказ.ЕстьФорма ЕСТЬ NULL
	|						И НЕ ВтФормыЗаказ.Заказ ЕСТЬ NULL
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|	КОНЕЦ КАК Форма,
	|	ВтЗаказ.РабочийЦентр КАК РабочийЦентр,
	|	ВтЗаказ.ДатаНачала КАК ДатаНачала,
	|	ВтЗаказ.НомерЗаказа КАК НомерЗаказа,
	|	ВтЗаказ.ДатаОкончания КАК ДатаОкончания,
	|	ВтЗаказ.РабочийЦентрНомер КАК РабочийЦентрНомер,
	|	ВтЗаказ.НомерСтроки КАК НомерСтроки,
	|	ВтСтатистика.МетражФакт КАК МетражФакт,
	|	ВтСтатистика.МетражПлан КАК МетражПлан,
	|	ВтСтатистика.ВремяПлан КАК ВремяПлан,
	|	ВЫБОР
	|		КОГДА ВтСтатистика.МетражПлан = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВтСтатистика.МетражФакт / ВтСтатистика.МетражПлан * 100
	|	КОНЕЦ КАК ПроцентВыполнения,
	|	ВтСтатистика.ВремяФакт КАК ВремяФакт
	|ПОМЕСТИТЬ ВтИтог
	|ИЗ
	|	ВтЗаказ КАК ВтЗаказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтНоменклатураРЦ КАК ВтНоменклатураРЦ
	|		ПО ВтЗаказ.Заказ = ВтНоменклатураРЦ.Заказ
	|			И ВтЗаказ.НомерПередела = ВтНоменклатураРЦ.НомерПередела
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Лико_ПередачаТоваров КАК Лико_ПередачаТоваров
	|		ПО ВтЗаказ.Заказ = Лико_ПередачаТоваров.ЗаказКлиента
	|			И (Лико_ПередачаТоваров.ВидОперации = &ВидОперации)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтСтатистика КАК ВтСтатистика
	|		ПО ВтЗаказ.Заказ = ВтСтатистика.Заказ
	|			И ВтЗаказ.РабочийЦентр = ВтСтатистика.РабочийЦентр
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтНоменклатураРЦВалы КАК ВтНоменклатураРЦВалы
	|		ПО ВтЗаказ.Заказ = ВтНоменклатураРЦВалы.Заказ
	|			И ВтЗаказ.НомерПередела = ВтНоменклатураРЦВалы.НомерПередела
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтВозвратФормЗаказ КАК ВтВозвратФормЗаказ
	|		ПО ВтЗаказ.Заказ = ВтВозвратФормЗаказ.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтФормыЗаказ КАК ВтФормыЗаказ
	|		ПО ВтЗаказ.Заказ = ВтФормыЗаказ.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтЗакзыСФлексоФормами КАК ВтЗакзыСФлексоФормами
	|		ПО ВтЗаказ.Заказ = ВтЗакзыСФлексоФормами.Заказ
	|			И ВтЗаказ.НомерПередела = ВтЗакзыСФлексоФормами.НомерПередела
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтЗаказ.Заказ,
	|	ВтЗаказ.РабочийЦентр,
	|	ВтЗаказ.ДатаНачала,
	|	ВтЗаказ.НомерЗаказа,
	|	ВтЗаказ.ДатаОкончания,
	|	ВтЗаказ.РабочийЦентрНомер,
	|	ВтЗаказ.НомерСтроки,
	|	ВтСтатистика.МетражФакт,
	|	ВтСтатистика.МетражПлан,
	|	ВтСтатистика.ВремяПлан,
	|	ВЫБОР
	|		КОГДА ВтСтатистика.МетражПлан = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВтСтатистика.МетражФакт / ВтСтатистика.МетражПлан * 100
	|	КОНЕЦ,
	|	ВтСтатистика.ВремяФакт,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВтНоменклатураРЦ.Количество, 1) > 0
	|				И ЕСТЬNULL(ВтНоменклатураРЦВалы.Количество, 1) > 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВтЗакзыСФлексоФормами.ЕстьФлексоФорма, ЛОЖЬ) = ЛОЖЬ
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ВтВозвратФормЗаказ.ЕстьФорма ЕСТЬ NULL
	|						И НЕ ВтФормыЗаказ.Заказ ЕСТЬ NULL
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтИтог.Заказ КАК Заказ,
	|	ЕСТЬNULL(ОснасткаКорр.Наличие, ВтИтог.Оснастка) КАК Оснастка,
	|	ЕСТЬNULL(ФормаКорр.Наличие, ВтИтог.Форма) КАК Форма,
	|	ВтИтог.РабочийЦентр КАК РабочийЦентр,
	|	ВтИтог.ДатаНачала КАК ДатаНачала,
	|	ВтИтог.НомерЗаказа КАК НомерЗаказа,
	|	ВтИтог.ДатаОкончания КАК ДатаОкончания,
	|	ВтИтог.РабочийЦентрНомер КАК РабочийЦентрНомер,
	|	ВтИтог.НомерСтроки КАК НомерСтроки,
	|	ВтИтог.МетражФакт КАК МетражФакт,
	|	ВтИтог.МетражПлан КАК МетражПлан,
	|	ВтИтог.ВремяПлан КАК ВремяПлан,
	|	ЕСТЬNULL(ВтИтог.ПроцентВыполнения, 0) КАК ПроцентВыполнения,
	|	ЕСТЬNULL(ВтИтог.ВремяФакт, 0) КАК ВремяФакт,
	|	ТС_ЗагрузкаРЦКомментарииСрезПоследних.Автор КАК Автор,
	|	ТС_ЗагрузкаРЦКомментарииСрезПоследних.Комментарий КАК Комментарий
	|ИЗ
	|	ВтИтог КАК ВтИтог
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТС_ЗагрузкаРЦКомментарии.СрезПоследних КАК ТС_ЗагрузкаРЦКомментарииСрезПоследних
	|		ПО ВтИтог.Заказ = ТС_ЗагрузкаРЦКомментарииСрезПоследних.ЗаказПокупателя
	|			И ВтИтог.РабочийЦентр = ТС_ЗагрузкаРЦКомментарииСрезПоследних.РабочийЦентр
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТС_НаличееФормОснастки.СрезПоследних(, ТипМатериала = ЗНАЧЕНИЕ(Перечисление.Тс_ТипМатериалаИК.Форма)) КАК ФормаКорр
	|		ПО ВтИтог.Заказ = ФормаКорр.ЗаказПокупателя
	|			И ВтИтог.РабочийЦентр = ФормаКорр.РабочийЦентр
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТС_НаличееФормОснастки.СрезПоследних(, ТипМатериала = ЗНАЧЕНИЕ(Перечисление.Тс_ТипМатериалаИК.Оснастка)) КАК ОснасткаКорр
	|		ПО ВтИтог.Заказ = ОснасткаКорр.ЗаказПокупателя
	|			И ВтИтог.РабочийЦентр = ОснасткаКорр.РабочийЦентр
	|
	|УПОРЯДОЧИТЬ ПО
	|	РабочийЦентрНомер,
	|	ДатаНачала";
	//Запрос.УстановитьПараметр("Владелец", Справочники.Пользователи.НайтиПоНаименованию("ТсМонитор"));
	Запрос.УстановитьПараметр("Владелец", ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("ТССтатистикаСкорости",СтатистикаСкорости);
	Запрос.УстановитьПараметр("ОтображениеРабочихЦентров",ОтображениеРабочихЦентров);        
	Запрос.УстановитьПараметр("Дата1", НачалоПериода);
	Запрос.УстановитьПараметр("Дата2", КонецПериода+20*24*60*60);
	Запрос.УстановитьПараметр("ПомещениеПроизводство",Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ПомещениеПроизводство"));
	Запрос.УстановитьПараметр("ВидОперации",Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПередачаФорм);
	Запрос.УстановитьПараметр("ВидОперацииВозврат",Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ПриходФорм);

	 
	
	
	
	Возврат  Запрос.Выполнить().Выгрузить();
	
	
КонецФункции

&Вместо("ФормыПечатьСкладскойОперации")
Функция Лико_ФормыПечатьСкладскойОперации(Ссылка, ПараметрыПечати, ПечататьОтправителя, КоличествоКопий, СразуНаПринтер)
    УстановитьПривилегированныйРежим(Истина);
	Формы= Ссылка.Формы.Выгрузить();
	Если Ссылка.ВидОперации=Перечисления.Лико_ВидыОпераций_ПередачаСоСклада.ПеремещениеФорм Тогда
		ПечататьОтправителя=Истина;
		Формы.Колонки["Конверт"].Имя = "КонвертОтправитель";
		Формы.Колонки["КонвертПолучатель"].Имя = "Конверт";

	КонецЕсли;


	ТабДок = Новый ТабличныйДокумент;             
	Запрос = Новый Запрос;
	Если ПечататьОтправителя Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|              ВнешнийИсточник.Конверт,
		|              ВнешнийИсточник.КонвертОтправитель КАК КонвертОтправитель,
		|              ВнешнийИсточник.Форма
		|ПОМЕСТИТЬ Формы
		|ИЗ
		|              &ВнешнийИсточник КАК ВнешнийИсточник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|              Формы.Конверт КАК Конверт,
		|              Формы.КонвертОтправитель КАК КонвертОтправитель,
		|              ПОДСТРОКА(Формы.Форма.Код, 1, 7) КАК ОбщийКод,
		|              1 КАК КоличествоФорм,
		|              Формы.Форма
		|ИЗ
		|              Формы КАК Формы
		|ИТОГИ
		|              СУММА(КоличествоФорм)
		|ПО
		|              Конверт,
		|              КонвертОтправитель,
		|              ОбщийКод";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		|              ВнешнийИсточник.Конверт,
		|              Значение(Справочник.Лико_Конверты.ПустаяСсылка) КАК КонвертОтправитель,
		|              ВнешнийИсточник.Форма
		|ПОМЕСТИТЬ Формы
		|ИЗ
		|              &ВнешнийИсточник КАК ВнешнийИсточник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|              Формы.Конверт КАК Конверт,
		|              Формы.КонвертОтправитель КАК КонвертОтправитель,
		|              ПОДСТРОКА(Формы.Форма.Код, 1, 7) КАК ОбщийКод,
		|              1 КАК КоличествоФорм,
		|              Формы.Форма
		|ИЗ
		|              Формы КАК Формы
		|ИТОГИ
		|              СУММА(КоличествоФорм)
		|ПО
		|              Конверт,
		|              КонвертОтправитель,
		|              ОбщийКод";
	КонецЕсли;

	Запрос.УстановитьПараметр("ВнешнийИсточник", Формы);
	Запрос.УстановитьПараметр("ПечататьОтправителя", ПечататьОтправителя);

	ИмяПринтера = СокрЛП(Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ИмяПринтераЭтикеток", ""));
	Макет = ПолучитьОбщийМакет("Лико_ФормыКарточкаСкладскойОперации");
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");

	ВыборкаПоКонверту = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоКонверту.Следующий() Цикл

		ВыборкаПоКонвертуОтправителю = ВыборкаПоКонверту.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоКонвертуОтправителю.Следующий() Цикл

			ВыборкаПоГруппеФорм = ВыборкаПоКонвертуОтправителю.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			НомерКонверта=0;
			Пока ВыборкаПоГруппеФорм.Следующий() Цикл

				// параметры
				ПараметрыПечати.Вставить("КоличествоЕдиницаИзмерения", " " + ВыборкаПоГруппеФорм.КоличествоФорм + " форм.");
				ПараметрыПечати.Вставить("КодФормы", ВыборкаПоГруппеФорм.ОбщийКод);
				ПараметрыПечати.Вставить("Контрагент", Документы.ЗаказКлиента.НайтиПоРеквизиту("НомерБезПрефикса", ВыборкаПоГруппеФорм.ОбщийКод).Контрагент);
				//ПараметрыПечати.Вставить("Получатель", ?(ЗначениеЗаполнено(ПредопределенныйПолучатель), ПредопределенныйПолучатель, ВыборкаПоГруппеФорм.Конверт));
				Если ПараметрыПечати.Свойство("ОбщийПолучатель") Тогда
					ПараметрыПечати.Вставить("Получатель", "" + ПараметрыПечати.ОбщийПолучатель);
				Иначе
					ПараметрыПечати.Вставить("Получатель", "" + ВыборкаПоГруппеФорм.Конверт);
				КонецЕсли;
				Если ЗначениеЗаполнено(ВыборкаПоГруппеФорм.КонвертОтправитель) Тогда
					ПараметрыПечати.Вставить("Получатель", Строка(ВыборкаПоГруппеФорм.Конверт) + " << "+ВыборкаПоГруппеФорм.КонвертОтправитель);
				КонецЕсли;
				ПараметрыПечати.Вставить("Дополнительное", "");

				// название всех форм общего кода одной строкой
				НазванияФормСтрокой = "";
				Выборка = ВыборкаПоГруппеФорм.Выбрать(ОбходРезультатаЗапроса.Прямой);
				Пока Выборка.Следующий() Цикл
					НазванияФормСтрокой = НазванияФормСтрокой + ", " + СокрЛП(Выборка.Форма.Наименование);
				КонецЦикла;
				НазванияФормСтрокой = Сред(НазванияФормСтрокой, 3);
				ПараметрыПечати.Вставить("Формы", НазванияФормСтрокой);

				// формирование печати
				Если НомерКонверта>0 Тогда
					ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
				КонецЕсли;


				ТабДокумент =ТабДок;
				ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Лико_ФормыКарточкаСкладскойОперации";

				ОбластьШапка.Параметры.Заполнить(ПараметрыПечати);
				ТабДокумент.Вывести(ОбластьШапка);

				ТабДокумент.АвтоМасштаб = Истина;
				ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
				ТабДокумент.ПолеСлева = 1;
				ТабДокумент.ПолеСправа = 0;
				ТабДокумент.ПолеСнизу = 0;
				ТабДокумент.ПолеСверху = 1;

				ТабДокумент.ИмяПринтера = ИмяПринтера;

				НомерКонверта=НомерКонверта+1;

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;
	Возврат ТабДокумент; 
КонецФункции

&Вместо("ПолучитьАдресХраненияПоСерии")
Функция Лико_ПолучитьАдресХраненияПоСерии(Серия, Дата, СкладСИМ)
	Если СкладСИМ=Неопределено Тогда
		СкладСИМ=ПараметрыСеанса.Лико_РабочееМесто.СкладСИМ;
	КонецЕсли;
	Организация =СкладСИМ.Лико_Площадка.Организация; 

	Ячейка=Неопределено;
	Если не ЗначениеЗаполнено(Серия) Тогда
		Возврат Ячейка;
	КонецЕсли;
	//ОбъектыНоменклатуры= Серия.ОбъектНоменклатуры;
	Если ЗначениеЗаполнено(Дата) Тогда
		ТекстЗапроса= "ВЫБРАТЬ
		              |	Остатки.Ячейка КАК Ячейка
		              |ИЗ
		              |	РегистрНакопления.ТоварыВЯчейках.Остатки(&Дата, Серия = &Серия) КАК Остатки
		              |ГДЕ
		              |	Остатки.Серия = &Серия";
					  //|	И (Остатки.Ячейка.Лико_Организация = &Организация
					  //|			ИЛИ Остатки.Ячейка.Лико_ОрганизацияОтветственногоХранения = &Организация)";
	Иначе
		
		ТекстЗапроса= "ВЫБРАТЬ
		              |	Остатки.Ячейка КАК Ячейка
		              |ИЗ
		              |	РегистрНакопления.ТоварыВЯчейках.Остатки(, Серия = &Серия) КАК Остатки
		              |ГДЕ
		              |	Остатки.Серия = &Серия";
					  //|	И (Остатки.Ячейка.Лико_Организация = &Организация
					  //|			ИЛИ Остатки.Ячейка.Лико_ОрганизацияОтветственногоХранения = &Организация)"; 
	КонецЕсли;        
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;  

	Запрос.УстановитьПараметр("Серия",Серия );
	Запрос.УстановитьПараметр("Дата",Дата );
	Запрос.УстановитьПараметр("Организация",Организация);


	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл                       
		//Возврат Выборка.Ячейка;
		Ячейка= Выборка.Ячейка;
		Прервать;
	КонецЦикла;  
	Если Выборка.Количество()<>1 ТОгда
		Ячейка=Неопределено;             
	КонецЕсли;


	Возврат Ячейка;             
КонецФункции

&Вместо("ПолучитьАдресХраненияПоСерииМассив")
