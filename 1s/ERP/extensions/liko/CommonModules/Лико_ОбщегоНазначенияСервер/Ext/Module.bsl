    	Организация =СкладСИМ.Лико_Площадка.Организация;

	Ячейка=Неопределено;
	Если не ЗначениеЗаполнено(Серия) Тогда
		Возврат Ячейка;
	КонецЕсли;
	//ОбъектыНоменклатуры= Серия.ОбъектНоменклатуры;
	//Если ЗначениеЗаполнено(Дата) Тогда
	//	ТекстЗапроса= "ВЫБРАТЬ Остатки.Ячейка КАК Ячейка ИЗ РегистрНакопления.ТоварыВЯчейках.Остатки(&Дата, Серия = &Серия) КАК Остатки
	//	|ГДЕ      Остатки.Серия = &Серия  И Остатки.Ячейка.Владелец=&Склад ";
	//Иначе
	//	ТекстЗапроса= "ВЫБРАТЬ Остатки.Ячейка КАК Ячейка ИЗ РегистрНакопления.ТоварыВЯчейках.Остатки(, Серия = &Серия) КАК Остатки
	//	|ГДЕ      Остатки.Серия = &Серия И Остатки.Ячейка.Владелец=&Склад "; 
	//КонецЕсли; 
	
	
	Если ЗначениеЗаполнено(Дата) Тогда
