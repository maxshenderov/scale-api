
&Вместо("ОтветственныеЛицаДокументаОбработкаЗаполнения")
Процедура Лико_ОтветственныеЛицаДокументаОбработкаЗаполнения(Источник, ДанныеЗаполнения, СтандартнаяОбработка)

	Если НЕ ОтветственныеЛицаПовтИсп.ЕстьРеквизитыОтветственныхЛицДокумента(Источник.Метаданные().Имя) Тогда
		Возврат;
	КонецЕсли; 
	
	//+ ---> Лико m.shenderov 03.02.2026
	
	
	Если ТипЗнч(Источник)= Тип("ДокументОбъект.Лико_ПередачаТоваров") Тогда
		Возврат;
	КонецЕсли;
	
	//- <--- Лико m.shenderov 03.02.2026

	ЗаполнитьОтветственныхЛицДокумента(Источник, ДанныеЗаполнения);

КонецПроцедуры
