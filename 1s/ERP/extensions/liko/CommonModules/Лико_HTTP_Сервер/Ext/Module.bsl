Функция Settings(HTTPСервис=Неопределено) Экспорт //+Лико m.shenderov 07.12.2021
	УстановитьПривилегированныйРежим(Истина);
	Структура = Новый Структура;
	
	Если HTTPСервис=Неопределено Тогда 
		HTTPСервис=Справочники.HTTPСервисы.INT;
	КонецЕсли;
	DEV=Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	HTTPConnections.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.HTTPConnections КАК HTTPConnections
	|ГДЕ
	|	HTTPConnections.Сервис = &Сервис
	|	И HTTPConnections.DEV = &DEV";
	Запрос.УстановитьПараметр("Сервис",HTTPСервис );
	Запрос.УстановитьПараметр("DEV",DEV );
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		HTTPConnection=Выборка.Ссылка;  	
		Для каждого Парам Из HTTPConnection.Параметры Цикл
			Структура.Вставить(Парам.Ключ,Парам.Значение);
		КонецЦикла; 		
	Структура.Вставить("username",HTTPConnection.Пользователь); 
	Структура.Вставить("password",HTTPConnection.Пароль);
	
	КонецЦикла; 
	
	
	Возврат Структура; 	
	
КонецФункции //-Лико m.shenderov 07.12.2021 

Функция HttpRecuest1с(host,slug,json,login,password,ssl=Неопределено,port="",header="") Экспорт  //+Лико m.shenderov 07.05.2021
	
	СоединениеHTTP=Неопределено;	
	СтрКоманда=СтрШаблон("СоединениеHTTP = новый HTTPСоединение(%1,%2,%3,%4,,%5)",
    "host",
	port,
	"login",
	"password",
	?(ssl=Неопределено,"","ssl"));
	Выполнить(СтрКоманда); 	
		
		HTTPЗапрос = Новый HTTPЗапрос(slug);
		HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json; charset=utf-8");
		Если ТипЗнч(header)=Тип("Массив") Тогда
			 Для каждого Структура Из header Цикл 			
				   Для каждого Ключ Из  Структура Цикл
				   	     HTTPЗапрос.Заголовки.Вставить(Ключ.Ключ, Ключ.Значение);
				   КонецЦикла;
			   КонецЦикла;
		КонецЕсли;	   
		HTTPЗапрос.УстановитьТелоИзСтроки(json);		
	 Возврат СоединениеHTTP.ОтправитьДляОбработки(HTTPЗапрос);
 КонецФункции //-Лико m.shenderov 07.05.2021     
 
 
 Функция Запрос1с(ТексЗапроса,ПараметрыСтруктура=Неопределено,HTTPСервис) Экспорт  //+Лико m.shenderov 19.01.2024
	 
	 Если ТипЗнч(HTTPСервис)=Тип("Строка") Тогда
		 
		 HTTPСервис=Справочники.HTTPСервисы.НайтиПоНаименованию(HTTPСервис);
		 
	 КонецЕсли;
	 
	 
	 ПараметрыСтруктура=?(ПараметрыСтруктура=Неопределено,Новый Структура,ПараметрыСтруктура);
	 
	 Структура = Новый Структура;
	 Структура.Вставить("ProcName","QueryFree");
	 Структура.Вставить("TextQuery",ТексЗапроса);
	 Структура.Вставить("ParamsQuery",ПараметрыСтруктура);
	 
	 Возврат Лико_HTTP_Сервер.ОтправитьПоHttp1с(Структура,,HTTPСервис);  
	 
	 
 КонецФункции //-Лико m.shenderov 19.01.2024 
 
 