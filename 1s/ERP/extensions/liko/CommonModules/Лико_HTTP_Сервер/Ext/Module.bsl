Функция HttpResponsPost(host,slug,json,ssl=Неопределено,port="",header="") Экспорт //+Лико m.shenderov 07.05.2021
	Если ТипЗнч(ssl)=Тип("ЗащищенноеСоединениеOpenSSL") Тогда
		СоединениеHTTP = Новый HTTPСоединение(host,port,,,,,ssl);
	Иначе
		СоединениеHTTP = Новый HTTPСоединение(host,port);
	КонецЕсли;
	
		HTTPЗапрос = Новый HTTPЗапрос(slug);
		HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json; charset=utf-8");
		Если ТипЗнч(header)=Тип("Массив") Тогда
			 Для каждого Структура Из header Цикл 			
				   Для каждого Ключ Из  Структура Цикл
				   	     HTTPЗапрос.Заголовки.Вставить(Ключ.Ключ, Ключ.Значение);
				   КонецЦикла;
			   КонецЦикла;
		КонецЕсли;	   
		HTTPЗапрос.УстановитьТелоИзСтроки(json);		
	 Возврат СоединениеHTTP.ОтправитьДляОбработки(HTTPЗапрос);
