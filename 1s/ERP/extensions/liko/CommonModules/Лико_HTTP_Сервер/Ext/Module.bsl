Процедура ПриведениеТЗКСтандартнымТипам(ТЗ) Экспорт //+Лико m.shenderov 14.09.2021
	
	// Обработаем полученный запрос: приведем все к стандартным типам, уберем данные по недоступным заказам
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТЗКопияПриведенная = ТЗ.Скопировать(Новый Структура());
	МассивСтруктурКолонокКПриведению = Новый Массив;
	Для каждого Колонка из ТЗКопияПриведенная.Колонки Цикл
		Если НЕ (Колонка.ТипЗначения.СодержитТип(Тип("Строка"))
			ИЛИ Колонка.ТипЗначения.СодержитТип(Тип("Число"))
			ИЛИ Колонка.ТипЗначения.СодержитТип(Тип("Дата"))
			ИЛИ Колонка.ТипЗначения.СодержитТип(Тип("Булево"))
			)
			ИЛИ Колонка.ТипЗначения.СодержитТип(Тип("Строка"))
			Тогда
			МассивСтруктурКолонокКПриведению.Добавить(Новый Структура("ИмяКолонки,Тип", Колонка.Имя, ТипСтрока));
		ИначеЕсли Колонка.ТипЗначения.СодержитТип(Тип("NULL")) Тогда
			МассивСтруктурКолонокКПриведению.Добавить(Новый Структура("ИмяКолонки,Тип", Колонка.Имя, Новый ОписаниеТипов(Колонка.ТипЗначения,, "Null")));
		КонецЕсли;
	КонецЦикла;
	
	Для каждого СтруктураКолонки из МассивСтруктурКолонокКПриведению Цикл
		ТЗКопияПриведенная.Колонки.Удалить(СтруктураКолонки.ИмяКолонки);
	КонецЦикла;
	Для каждого СтруктураКолонки из МассивСтруктурКолонокКПриведению Цикл
		ТЗКопияПриведенная.Колонки.Добавить(СтруктураКолонки.ИмяКолонки, СтруктураКолонки.Тип);
	КонецЦикла;
	
	Для каждого Строка из ТЗ Цикл
		НоваяСтрока = ТЗКопияПриведенная.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	ТЗ = ТЗКопияПриведенная;
	
КонецПроцедуры //-Лико m.shenderov 14.09.2021 

Функция ВернутьТзКакJSON(ТЗ) Экспорт //+Лико m.shenderov 14.09.2021
	
