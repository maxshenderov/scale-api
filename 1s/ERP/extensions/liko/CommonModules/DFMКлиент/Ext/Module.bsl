&НаКлиенте
Процедура СоздатьНоменклатуруDFMЗавершение(Результат, Параметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		Форма=Параметры.Форма;
		Элементы=Форма.Элементы;
		Тд                     =Элементы.Товары.ТекущиеДанные;
		Тд.ВерсияНоменклатуры  =Результат.ВерсияНоменклатуры;
		Тд.Номенклатура        =Результат.Номенклатура;
		Тд.Версия              =Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Результат.ВерсияНоменклатуры,"Версия");
		Форма.ТаблицаТоварыПриИзменении();
		Тд.Артикул             =Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Результат.ВерсияНоменклатуры,"Артикул");
		Тд.АртикулСтарый       =Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Тд.Номенклатура,"Лико_АртикулСтарый");


	    Форма.Модифицированность=Истина;
		
		УстановитьВидимость(Форма);
		
		//Элементы.Товары.Обновить();
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость(Форма,Группа="DFMGroupButtons") Экспорт //+Лико m.shenderov 14.06.2021
	Форма.Элементы.НоменклатураDFM.Видимость = Ложь;
	////КонецЕсли;
	
	Если Форма.ДатаНачалаСозданияНоменклатурыDFM  И Форма.Объект.НоменклатураDFM Тогда 
		Форма.Элементы[Группа].Видимость=Истина;
		Форма.Элементы.УведомитьДизайнераDFM2.Доступность=Ложь;
		
		Для каждого Товар Из Форма.Объект.Товары Цикл
			Если ЗначениеЗаполнено(Товар.ВерсияНоменклатуры) Тогда
				Форма.Элементы.УведомитьДизайнераDFM2.Доступность=Истина;
			КонецЕсли; 		
			
		КонецЦикла;
		
		Если Форма.Объект.Площадка<>ПредопределенноеЗначение("Справочник.Лико_Площадки.Линкс")
			И  Форма.Объект.ВидЗаказа=ПредопределенноеЗначение("Перечисление.Лико_ВидыЗаказов.ПолныйПовтор") ТОгда
			Форма.Элементы.СоздатьНоменклатуруDFM2.Доступность=Ложь;
			Форма.Элементы.СоздатьВерсиюDFM2.Доступность=Ложь; 		
			форма.Элементы.ТоварыАртикул.ТолькоПросмотр=Истина;
		
		КонецЕсли;
		
	Иначе
		Форма.Элементы[Группа].Видимость=Ложь;
	КонецЕсли;	
	
КонецПроцедуры //-Лико m.shenderov 14.06.2021

&НаКлиенте
Процедура УведомитьДизайнера(Форма) Экспорт  
	Массив = Новый Массив();
	Объект=Форма.Объект;
	
	НомерСтроки=0;
	Для Каждого Товар Из Объект.Товары Цикл
		
		Если ЗначениеЗаполнено( Товар.ВерсияНоменклатуры) ТОгда
			Структура = Новый Структура;
			Структура.Вставить("Номенклатура",Товар.Номенклатура);
			Структура.Вставить("ВерсияНоменклатуры",Товар.ВерсияНоменклатуры);
			Массив.Добавить(Структура);	
		КонецЕсли;	
	КонецЦикла;
	Если Массив.Количество()=0 Тогда
		ПоказатьПредупреждение(,"В заказе нет продукта с созданной версией. Создайте версию продукта!");
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Форма",Форма);
	ОО  =Новый ОписаниеОповещения("УведомитьДизайнераЗавершение",DFMКлиент,ПараметрыФормы);
	Структура = Новый Структура;
	СТруктура.Вставить("Дизайнер",Объект.Дизайнер);
	Структура.Вставить("Товары",Массив);
	ОткрытьФорму("Справочник.Лико_ВерсииНоменклатуры.Форма.ФормаВопросаОтправкиУведомления",Структура,,,,,
	ОО,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 	
КонецПроцедуры

&НаКлиенте
Процедура УведомитьДизайнераЗавершение(Результат,Параметры)  Экспорт //+Лико m.shenderov 10.06.2021
	
	ЕСли  ТипЗнч(Результат)=Тип("Структура") И Результат.МассивВерсий.Количество()>0 Тогда
		
		DFMСервер.ОтправитьУведомлениеВDFMНаСервере(Результат.МассивВерсий,Результат.Дизайнер,Параметры.Форма.Объект.Ссылка,Результат.Комментарий);

				
	КонецЕсли;
	
КонецПроцедуры //-Лико m.shenderov 10.06.2021

&НаКлиенте
Процедура ПередЗаписью(Форма,Отказ) Экспорт
	
	//Устарела
	//Возврат; 
	Для каждого Товар Из Форма.Объект.Товары Цикл
		
		Если ЗначениеЗаполнено(Товар.ВерсияНоменклатуры) Тогда
			
			Если  Не ЭтоВерсияНоменклатуры(Товар.ВерсияНоменклатуры,Товар.Номенклатура) Тогда
				
				Товар.ВерсияНоменклатуры=Неопределено;
				
			КонецЕсли;
			
			
		КонецЕсли;
		
		
	КонецЦикла;
	
	НеСоответсвуетТехнологии=ВыполнитьПроверкуТехнологииПродукта(Форма);
	Если НеСоответсвуетТехнологии.Количество()>0  Тогда
		Отказ=Истина;
	ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьВерсиюНоменклатурыАвтоЗавершение", DFMКлиент,Новый Структура("Форма",Форма));
	
	Структура = Новый Структура;
	Структура.Вставить("Технология",DFMСервер.ПолучитьТехнологиюПечати(ПолучитьСтруктуруЗаказа(Форма)));
	СТруктура.Вставить("Дизайнер",Форма.Объект.Дизайнер);
	Структура.Вставить("Товары",НеСоответсвуетТехнологии);
	ОткрытьФорму("Справочник.Лико_ВерсииНоменклатуры.Форма.ФормаВопросаИзмененияТехнологии",Структура,,,,,
	ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	КонецЕсли;	

КонецПроцедуры  

  
&НаКлиенте
Асинх Процедура СоздатьВерсиюНоменклатурыАвтоЗавершение(Результат, ДополнительныеПараметры) Экспорт
		
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		СоздатьВерсиюНоменклатурыДляТехнологииАвто(ДополнительныеПараметры.Форма,Результат);	

	КонецЕсли;
	
		
КонецПроцедуры	

&НаКлиенте
Процедура СоздатьВерсиюНоменклатурыДляТехнологииАвто(Форма,Массив) Экспорт //+Лико m.shenderov 28.05.2021
        
	Если Не ПроверкаЗаполненияПолей(Форма) Тогда
		Возврат
	КонецЕсли;
		ТехнологияПечати=DFMСервер.ПолучитьТехнологиюПечати(ПолучитьСтруктуруЗаказа(Форма));

	
	     Для Каждого Товар Из Массив Цикл
			
			      Структура = Новый Структура;
				  Структура.Вставить("Товар",Товар);
				  Структура.Вставить("ТехнологияПечати",ТехнологияПечати);
				  Структура.Вставить("Регион",Форма.Объект.Регион);
				  Структура.Вставить("Партнер",Форма.Объект.Партнер);
                  Структура.Вставить("Менеджер",Форма.Объект.Менеджер);
				  Структура.Вставить("Заказ",Форма.Объект.Ссылка);
				   Структура.Вставить("Комментарий",Товар.Комментарий);

				  
				  
                  СтруктураНоменклатуры=DFMСервер.СоздатьНоменклатуру(Структура);
                                       
				
								
				  НайденныеСтроки = Форма.Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура",Товар.Номенклатура));
				  
				  Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл 					  
					  НайденнаяСтрока.Артикул =Лико_Дополнительно.ЗначениеРеквизитаОбъекта(СтруктураНоменклатуры.ВерсияНоменклатуры,"Артикул");
					  НайденнаяСтрока.Версия  =СтруктураНоменклатуры.Версия;
					  НайденнаяСтрока.ВерсияНоменклатуры=СтруктураНоменклатуры.ВерсияНоменклатуры;
					  НайденнаяСтрока.АртикулСтарый =Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Товар.Номенклатура,"Лико_АртикулСтарый");
				  КонецЦикла;

						
				
			КонецЦикла;
		Форма.Модифицированность=Истина;	
       УстановитьВидимость(Форма);

		
КонецПроцедуры //-Лико m.shenderov 28.05.2021

&НаКлиенте
Функция ПолучитьСтруктуруЗаказа(Форма) //+Лико m.shenderov 15.03.2022
	
	Структура=Новый Структура;
	Структура.Вставить("Площадка",Форма.Объект.Площадка);
	Структура.Вставить("РабочийЦентр",Форма.Объект.РабочийЦентр); 
	МассивВидПечати = Новый Массив(); 
	
	Для каждого Цвет Из Форма.Объект.Цвета Цикл 
		МассивВидПечати.Добавить(Цвет.ВидПечати);		
	КонецЦикла;
	
	Структура.Вставить("ВидыПечати",МассивВидПечати);  
	
	
	МассивРабочиеЦентры = Новый Массив(); 
	
	Для каждого ВидРабот Из Форма.Объект.ВидыРабот Цикл 
		МассивРабочиеЦентры.Добавить(ВидРабот.РабочийЦентр);
		
	КонецЦикла;
	
	Структура.Вставить("РабочиеЦентры",МассивРабочиеЦентры);
	
	Возврат Структура;	
	
КонецФункции  //-Лико m.shenderov 15.03.2022



