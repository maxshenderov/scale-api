КонецПроцедуры


&НаКлиенте
Асинх Процедура СоздатьНоменклатуруВерсиюАсинх2(Форма,СоздатьВерсию,НоменклатураНаименование)
	Объект=Форма.Объект;
	Тд=Форма.Элементы.Товары.ТекущиеДанные;
	Если Тд=Неопределено Тогда
		Сообщить("Не выбран продукт!");
	КонецЕсли;
	
	Если СоздатьВерсию И  Не Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Тд.Номенклатура,"Лико_DFM") Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Ждать ВопросАсинх(НСтр("ru = 'Необходимо создать номенклатуру и версию в DFM. Создать?'"), Режим, 0);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	
	Структура = Новый Структура;
	Если СоздатьВерсию И  Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Тд.Номенклатура,"Лико_DFM") Тогда
		Структура.Вставить("Номенклатура",Тд.Номенклатура);	
	КонецЕсли;
	
	Структура.Вставить("Клиент",Объект.Партнер);
	Структура.Вставить("НаименованиеНоменклатуры",НоменклатураНаименование);
	Структура.Вставить("Контрагент",Объект.Контрагент);
	Структура.Вставить("ТипЭтикетки",Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Тд.Номенклатура,"Лико_ТипЭтикетки"));
	Структура.Вставить("Клиент",Объект.Партнер);
	Структура.Вставить("Менеджер",Объект.Менеджер);
	Структура.Вставить("Дизайнер",Объект.Дизайнер);
	Структура.Вставить("Регион",Объект.Регион);
	Структура.Вставить("ВерсияНоменклатуры",Тд.ВерсияНоменклатуры);
	Структура.Вставить("Заказ",Объект.ссылка);

	
	
	Структура.Вставить("Версия",Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Тд.ВерсияНоменклатуры,"Версия"));
	ВидРЦ=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Объект.РабочийЦентр,"ВидРабочегоЦентра");
	Технология=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ВидРЦ,"лкТехнологияПечати");
	Структура.Вставить("Технология",Технология);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Форма",Форма);
	ОписаниеОповещение= Новый ОписаниеОповещения("СоздатьНоменклатуруDFMЗавершение",DFMКлиент,ПараметрыФормы);
	ОткрытьФорму("Справочник.Лико_ВерсииНоменклатуры.Форма.ФормаСозданияНоменклатуры",
	Структура,,,,,ОписаниеОповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры



