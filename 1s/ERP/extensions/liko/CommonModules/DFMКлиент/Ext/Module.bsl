&НаКлиенте
Процедура ЗаблокироватьНоменклатуру(Форма,ОставитьНоменклатуру) Экспорт
	
   _ВидРабочегоЦентра=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Форма.Объект.РабочийЦентр,"ВидРабочегоЦентра");
   
   Если _ВидРабочегоЦентра = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.GallusInkjet")	   
		//Или (ОставитьНоменклатуру И _ВидРабочегоЦентра = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.Comexi"))
	    Или (ОставитьНоменклатуру И Форма.Объект.ТипЗаказа = ПредопределенноеЗначение("Перечисление.Лико_ТипыЗаказов.ВплавляемаяЭтикетка"))
	    Или (ОставитьНоменклатуру И Форма.Объект.ТипЗаказа = ПредопределенноеЗначение("Перечисление.Лико_ТипыЗаказов.Термоусадка")) Тогда  
		
		Форма.Объект.НоменклатураDFM = Истина;
	Иначе
		Форма.Объект.НоменклатураDFM = Ложь;
	КонецЕсли;
	// <-- Конец Лико Яцун С. В. 24.11.2025
	Если НЕ Форма.Объект.НоменклатураDFM
		И Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Форма.Объект.РабочийЦентр,"Лико_Площадка") = ПредопределенноеЗначение("Справочник.Лико_Площадки.Ликофлекс") 
		И (_ВидРабочегоЦентра = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.MPSOfset")
		ИЛИ _ВидРабочегоЦентра = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.Drent")
		ИЛИ _ВидРабочегоЦентра = ПредопределенноеЗначение("Справочник.ВидыРабочихЦентров.MO3300"))
		Тогда
		ДатаПереходаНаDFMНовыхЗаказов = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ПредопределенноеЗначение("Справочник.Лико_ПредопределенныеЗначения.ДатаПереходаНаDFMНовыхЗаказов"),"ЗначениеПараметра");
		Если Форма.Объект.ДатаПервойОтправкиВРаботу = Дата(1,1,1) И ЗначениеЗаполнено(ДатаПереходаНаDFMНовыхЗаказов) ИЛИ ЗначениеЗаполнено(ДатаПереходаНаDFMНовыхЗаказов) И Форма.Объект.ДатаПервойОтправкиВРаботу > ДатаПереходаНаDFMНовыхЗаказов Тогда 
			Форма.Объект.НоменклатураDFM = Истина; 
		КонецЕсли;
	КонецЕсли;
	// <-- Начало Лико Яцун С. В. 24.11.2025
	
	Если Форма.Объект.НоменклатураDFM = Ложь Тогда
		Массив = Новый Массив(); 
		Для каждого Товар Из Форма.Объект.Товары Цикл
			 Массив.Добавить(Товар.Номенклатура);
		КонецЦикла;
		
		НоменклатураDFM = DFMСервер.ЭтоНоменклатураDFM(
		Форма.Объект.РабочийЦентр,
		Форма.Объект.ТипЗаказа,
		Форма.ДатаНачалаСозданияНоменклатурыDFM,
		Неопределено,
		Массив);	
		Если НоменклатураDFM Тогда
			
		Форма.Объект.НоменклатураDFM = Истина
		
		КонецЕсли;	
	КонецЕсли;
	

	
	Если Форма.Объект.НоменклатураDFM Тогда
		
		Форма.Элементы.ТоварыНоменклатура.ТолькоПросмотр = Истина;
		
		Если Не ОставитьНоменклатуру ТОгда
			Для каждого Товар Из Форма.Объект.Товары Цикл		
				Товар.Номенклатура = Неопределено;							
			КонецЦикла;
			Форма.ТаблицаТоварыПриИзменении();
		КонецЕсли;
	Иначе
		Форма.Элементы.ТоварыНоменклатура.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	УстановитьВидимость(Форма);
	
КонецПроцедуры

