&НаКлиенте
Процедура ОригиналМакет(Форма) Экспорт  //+--->Лико m.shenderov 10.12.2025
	текстр = Форма.Элементы.Товары.ТекущиеДанные;
	Если текстр<> Неопределено Тогда
		Форма.ВерсияНоменклатуры = текстр.ВерсияНоменклатуры;
		
		ВерсияНоменклатурыСтруктура=ВерсияНоменклатурыСтруктура(Форма.ВерсияНоменклатуры);	
	Иначе
		Форма.ВерсияНоменклатуры =Неопределено;
		
	КонецЕсли;
	
	
	
	Если Форма.ДатаНачалаСозданияНоменклатурыDFM И Форма.Объект.НоменклатураDFM Или Форма.ПоказатьDFM Тогда
		Если текстр= Неопределено
			Или Не ЗначениеЗаполнено(Форма.ВерсияНоменклатуры)
			ИЛи Не ВерсияНоменклатурыСтруктура.ФайлСогласования Тогда
			Форма.Элементы.ОригиналМакетDFM2.Доступность=Ложь;
			Форма.Элементы.ОригиналМакетDFM2.ЦветФона= Форма.Элементы.НайтиПродуктDFM2.ЦветФона;
		Иначе
			Форма.Элементы.ОригиналМакетDFM2.Доступность=Истина;
			Если ЗначениеЗаполнено(ВерсияНоменклатурыСтруктура.Согласовано) Тогда
				
				Форма.Элементы.ОригиналМакетDFM2.ЦветФона= Новый Цвет(200, 255, 200);
			Иначе
				//Форма.Элементы.ОригиналМакетDFM2.ЦветФона= Новый Цвет(255, 200, 200); 
				Форма.Элементы.ОригиналМакетDFM2.ЦветФона= WebЦвета.СветлоКоралловый; 

			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры //-<---Лико m.shenderov 10.12.2025

&НаКлиенте
Процедура ПоказатьОригиналМакет(Форма) Экспорт
	ОригиналМакет(Форма);
	Если Форма.Элементы.ОригиналМакетDFM2.Доступность Тогда 
		
		ВерсияНоменклатурыСтруктура=ВерсияНоменклатурыСтруктура(Форма.ВерсияНоменклатуры);
		
		УРЛ = УРЛОригналМакет()+ВерсияНоменклатурыСтруктура.Артикул;
		
	ЗапуститьПриложение(УРЛ);
	
	КонецЕсли;

 КонецПроцедуры

