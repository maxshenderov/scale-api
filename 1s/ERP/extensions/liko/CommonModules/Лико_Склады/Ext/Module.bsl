Процедура ЗакрытьЗаказНаСервере(ЗаказПоставщику) Экспорт  
	УстановитьПривилегированныйРежим(Истина);
		
	НаборЗаписей = РегистрыНакопления.РасчетыСПоставщиками.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЗаказПоставщику);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Записать(Истина); 	
	
		
	НаборЗаписей = РегистрыНакопления.ТоварыКПоступлению.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЗаказПоставщику);
	НаборЗаписей.Прочитать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыКПоступлениюОстатки.ДокументПоступления КАК ДокументПоступления,
	|	ТоварыКПоступлениюОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыКПоступлениюОстатки.Характеристика КАК Характеристика,
	|	ТоварыКПоступлениюОстатки.Назначение КАК Назначение,
	|	ТоварыКПоступлениюОстатки.Склад КАК Склад,
	|	ТоварыКПоступлениюОстатки.Отправитель КАК Отправитель,
	|	ТоварыКПоступлениюОстатки.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	ТоварыКПоступлениюОстатки.Серия КАК Серия,
	|	ТоварыКПоступлениюОстатки.КОформлениюНакладныхПоРаспоряжениюОстаток * -1 КАК КОформлениюНакладныхПоРаспоряжению,
	|	ТоварыКПоступлениюОстатки.КОформлениюПоступленийПоРаспоряжениюОстаток * -1 КАК КОформлениюПоступленийПоРаспоряжению,
	|	ТоварыКПоступлениюОстатки.КОформлениюПоступленийПоНакладнымОстаток * -1 КАК КОформлениюПоступленийПоНакладным,
	|	ТоварыКПоступлениюОстатки.КОформлениюПоступленийПоОрдерамОстаток * -1 КАК КОформлениюПоступленийПоОрдерам,
	|	ТоварыКПоступлениюОстатки.КОформлениюОрдеровОстаток * -1 КАК КОформлениюОрдеров,
	|	ТоварыКПоступлениюОстатки.ПринимаетсяОстаток * -1 КАК ПринимаетсяОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыКПоступлению.Остатки(, ДокументПоступления = &Распоряжение) КАК ТоварыКПоступлениюОстатки";
	Запрос.УстановитьПараметр("Распоряжение",ЗаказПоставщику );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяЗапись=НаборЗаписей.Добавить();
		НоваяЗапись.Период=ЗаказПоставщику.Дата;
		НоваяЗапись.ВидДвижения=ВидДвиженияНакопления.Приход;
		ЗаполнитьЗначенияСвойств(НоваяЗапись,Выборка); 		
	КонецЦикла;	
	НаборЗаписей.Записать(Истина);
	
	
	НаборЗаписей = РегистрыНакопления.ЗаказыПоставщикам.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ЗаказПоставщику);
	НаборЗаписей.Прочитать();
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказыПоставщикамОстатки.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ЗаказыПоставщикамОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыПоставщикамОстатки.Характеристика КАК Характеристика,
	|	ЗаказыПоставщикамОстатки.КодСтроки КАК КодСтроки,
	|	ЗаказыПоставщикамОстатки.Склад КАК Склад,
	|	ЗаказыПоставщикамОстатки.ЗаказаноОстаток * -1 КАК Заказано,
	|	ЗаказыПоставщикамОстатки.КОформлениюОстаток * -1 КАК КОформлению
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки(, ЗаказПоставщику = &Распоряжение) КАК ЗаказыПоставщикамОстатки";
	Запрос.УстановитьПараметр("Распоряжение",ЗаказПоставщику );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяЗапись=НаборЗаписей.Добавить();
		НоваяЗапись.Период=ЗаказПоставщику.Дата;
		НоваяЗапись.ВидДвижения=ВидДвиженияНакопления.Приход;
		ЗаполнитьЗначенияСвойств(НоваяЗапись,Выборка); 		
	КонецЦикла;	
	НаборЗаписей.Записать(Истина);
	
	
	
	ЗаказыПоставщику = Новый Массив;
	ЗаказыПоставщику.Добавить(ЗаказПоставщику);
	РегистрыСведений.СостоянияЗаказовПоставщикам.ОтразитьСостоянияЗаказов(ЗаказыПоставщику);
	//
	//РегистрыСведений.СостоянияЗаказовПоставщикам.ОтразитьСостояниеЗаказа(ЗаказПоставщику, Ложь);
	
	
	Набор = РегистрыСведений.СостоянияЗаказовПоставщикам.СоздатьНаборЗаписей();
	Набор.Отбор.Заказ.Установить(ЗаказПоставщику);
	НоваяЗапись =   Набор.Добавить();
	НоваяЗапись.Заказ =ЗаказПоставщику;
	НоваяЗапись.Состояние = Перечисления.СостоянияЗаказовПоставщикам.Закрыт;
	НоваяЗапись.ДатаСобытия = ТекущаяДата();
	
	Набор.Записать();

	
	
КонецПроцедуры


