Функция ПараметрыДляПроведенияДокумента(Документ, Свойства) Экспорт
	Параметры = ПроведениеДокументов.ПараметрыУчетногоМеханизма();
	ТипДокумента = ТипЗнч(Документ);
	
	// Проведение
	Если Свойства.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если ТипДокумента = Тип("ДокументОбъект.Лико_БланкЭтапа") Тогда
			
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_ТоварыКРаспределению);
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.ЛикоПартииКликов);
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_ЗакрытиеБланка);
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_ПромежуточныйВыпуск);
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.ДвиженияСерийТоваров);
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_РаскройМатериаловПланФакт);

		ИначеЕсли ТипДокумента = Тип("ДокументОбъект.Лико_ПодготовкаМатериалов") Тогда
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_МатериалыВРезерве);
		ИначеЕсли ТипДокумента = Тип("ДокументОбъект.ЭтапПроизводства2_2") Или ТипДокумента = Тип("ДокументОбъект.ДвижениеПродукцииИМатериалов") Тогда
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_ЗакрытиеБланка);
		ИначеЕсли ТипДокумента = Тип("ДокументОбъект.ПриобретениеТоваровУслуг") Или
			ТипДокумента = Тип("ДокументОбъект.ПриходныйОрдерНаТовары") Или  
			ТипДокумента = Тип("ДокументОбъект.ВозвратСырьяОтПереработчика") Или 
			ТипДокумента = Тип("ДокументОбъект.ПоступлениеОтПереработчика")  
			Тогда 	
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_ТоварыКПоступлению); 
		ИначеЕсли ТипДокумента = Тип("ДокументОбъект.Лико_ПередачаТоваров") Тогда 	
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_ТоварыНаОтветственномХранении);
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.ДвиженияСерийТоваров);
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыСведений.Лико_ОснасткаПоЗаказу);
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_СписаниеНаЗаказ);
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_КонтрольВозвратовПоставщику);  		
		ИначеЕсли ТипДокумента = Тип("ДокументОбъект.ЛикоРаспределениеРасходовПоЭтапам") Тогда 	
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_РаспределениеМатериалов);  		
			
			
		ИначеЕсли ТипДокумента = Тип("ДокументОбъект.Лико_ВыполненныеРаботы") Тогда 	
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_ВыполненныеРаботы);
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_ЗатратыПоЗаказу); 
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_ЗатратыПоЗаказуДляОтгрузки);
		ИначеЕсли ТипДокумента = Тип("ДокументОбъект.ВозвратТоваровПоставщику") Тогда 	
			Параметры.ПодчиненныеРегистры.Добавить(Метаданные.РегистрыНакопления.Лико_КонтрольВозвратовПоставщику); 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Параметры;
КонецФункции

 Процедура ОтразитьДвижения(ТаблицыДляДвижений, Движения, Отказ) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
    ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_МатериалыВРезерве");
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_ТоварыКПоступлению");
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_ТоварыКРаспределению");
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "ЛикоПартииКликов");
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_ЗакрытиеБланка"); 
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_РаспределениеМатериалов"); 
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_ПромежуточныйВыпуск"); 
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "ДвиженияСерийТоваров");
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "СвободныеОстатки");
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "СерийТоваров");  
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_ТоварыНаОтветственномХранении");  	
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_ОснасткаПоЗаказу");  	
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_СписаниеНаЗаказ");  	
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_КонтрольВозвратовПоставщику"); 
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_ВыполненныеРаботы"); 
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_ЗатратыПоЗаказу"); 
	ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_ЗатратыПоЗаказуДляОтгрузки");
    ПроведениеДокументов.ОтразитьДвижения(ТаблицыДляДвижений, Движения, "Лико_РаскройМатериаловПланФакт");
	
КонецПроцедуры                    

