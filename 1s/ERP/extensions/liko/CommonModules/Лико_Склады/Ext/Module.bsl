

Функция ОстаткиПоСкладу(РабочийЦентрЯчейкаМассивРЦМассивЯчеек,НаДату, СписокВидовНОменклатуры = Неопределено) Экспорт  //+Лико m.shenderov 12.09.2017
	
	Дата=?(ЗначениеЗаполнено(НаДату),НаДату, Дата(3999, 12, 31, 23, 59, 59));	
	
	МассивЯчеек = Новый Массив;
	ТипРеквизита = ТипЗнч(РабочийЦентрЯчейкаМассивРЦМассивЯчеек);
	Если ТипРеквизита = Тип("СправочникСсылка.РабочиеЦентры") Тогда
		МассивЯчеек.Добавить(РабочийЦентрЯчейкаМассивРЦМассивЯчеек.ЛикоЯчейка);
	ИначеЕсли ТипРеквизита = Тип("СправочникСсылка.СкладскиеЯчейки") Тогда
		МассивЯчеек.Добавить(РабочийЦентрЯчейкаМассивРЦМассивЯчеек);
	ИначеЕсли ТипРеквизита = Тип("Массив") Тогда
		Для каждого ЭлементМассива из РабочийЦентрЯчейкаМассивРЦМассивЯчеек Цикл
			Если ТипЗнч(ЭлементМассива) = Тип("СправочникСсылка.РабочиеЦентры") Тогда
				МассивЯчеек.Добавить(ЭлементМассива.ЛикоЯчейка);
			ИначеЕсли ТипЗнч(ЭлементМассива) = Тип("СправочникСсылка.СкладскиеЯчейки") Тогда
				МассивЯчеек.Добавить(ЭлементМассива);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Ячейка КАК Ячейка,
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.Характеристика КАК Характеристика,
	|	ТоварыВЯчейкахОстатки.Упаковка КАК Упаковка,
	|	ТоварыВЯчейкахОстатки.Серия КАК Серия,
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК Количество,
	|	ТоварыВЯчейкахОстатки.Упаковка.Числитель * ТоварыВЯчейкахОстатки.ВНаличииОстаток КАК КоличествоУУ
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(&Дата, Ячейка В (&МассивЯчеек)) КАК ТоварыВЯчейкахОстатки
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ФильтрПоВидамНоменклатуры
	|				ТОГДА ТоварыВЯчейкахОстатки.Номенклатура.ВидНоменклатуры В (&СписокВидовНОменклатуры)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("МассивЯчеек", МассивЯчеек); 	
	Запрос.УстановитьПараметр("Дата", Дата); 	
	
	Если СписокВидовНОменклатуры <> Неопределено И ТипЗнч(СписокВидовНОменклатуры) = Тип("Массив") И СписокВидовНОменклатуры.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("ФильтрПоВидамНоменклатуры", Истина); 	
		Запрос.УстановитьПараметр("СписокВидовНОменклатуры", СписокВидовНОменклатуры);
	Иначе
		ФильтрПоВидамНоменклатуры=ПолучитьФильтрПоВидамНоменклатуры();
		Запрос.УстановитьПараметр("ФильтрПоВидамНоменклатуры",ФильтрПоВидамНоменклатуры.ФильтрПоВидамНоменклатуры ); 	
		Запрос.УстановитьПараметр("СписокВидовНОменклатуры",ФильтрПоВидамНоменклатуры.СписокВидовНОменклатуры ); 	
	КонецЕсли;

	Возврат Запрос.Выполнить(); 
	
КонецФункции //ОстаткиПоРабочемуЦентру -Лико m.shenderov 12.09.2017


Функция ПолучитьФильтрПоВидамНоменклатуры() Экспорт //+Лико m.shenderov 27.01.2018  
	СписокЗначений= Новый Массив;
	ФилтьрПоВидамНоменклатуры= Справочники.Лико_РабочиеМеста.ПолучитьСвойство("УстанавливатьФильтрПоВидамНменклатуры",Ложь);
	Если  ФилтьрПоВидамНоменклатуры Тогда
		Для каждого ОтборВида Из ПараметрыСеанса.Лико_РабочееМесто.ВидыНаоменклатурыДляФильтра	 Цикл
			
			СписокЗначений.Добавить(ОтборВида.ВидНоменклатуры);
		КонецЦикла;
		
		
	КонецЕсли;
	
	Структура = Новый Структура;
	Структура.Вставить("ФильтрПоВидамНоменклатуры",ФилтьрПоВидамНоменклатуры);
	Структура.Вставить("СписокВидовНОменклатуры",СписокЗначений);
	
	Возврат Структура;	
	
КонецФункции  //-Лико m.shenderov 27.01.2018

