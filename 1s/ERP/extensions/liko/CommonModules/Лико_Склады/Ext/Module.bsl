Процедура ЗаполнитьЭтапыГрафикаОплаты(ДокументОбъект,Заказ,Сумма,ВариантОплаты=Неопределено)Экспорт 
	Если ВариантОплаты=Неопределено Тогда
	   ВариантОплаты=Перечисления.ВариантыКонтроляОплатыКлиентом.КредитПослеОтгрузки;	
	КонецЕсли;
	
	
	Если ДокументОбъект.ЭтапыГрафикаОплаты.Количество()=0 Тогда
		НовыйЭтапГрафикаОплаты= ДокументОбъект.ЭтапыГрафикаОплаты.Добавить();
	    НовыйЭтапГрафикаОплаты.Заказ=Заказ; 
		НовыйЭтапГрафикаОплаты.ВариантОплаты=ВариантОплаты; 
		НовыйЭтапГрафикаОплаты.ДатаПлатежа=ДокументОбъект.Дата;
		НовыйЭтапГрафикаОплаты.СуммаПлатежа=Сумма;
		НовыйЭтапГрафикаОплаты.ПроцентПлатежа=100;
		НовыйЭтапГрафикаОплаты.СуммаВзаиморасчетов=НовыйЭтапГрафикаОплаты.СуммаПлатежа;
		НовыйЭтапГрафикаОплаты.ОбъектРасчетов=ДокументОбъект.Договор;
		НовыйЭтапГрафикаОплаты.ВариантОтсчета=Перечисления.ВариантыОтсчетаДатыПлатежа.ОтДатыОтгрузки;
	КонецЕсли;
	
	

КонецПроцедуры

Процедура ПроверитьСостояниеЗаказаПоставщику(Заказы) Экспорт //+Лико m.shenderov 23.03.2023
	УстановитьПривилегированныйРежим(истина);	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СостоянияЗаказовПоставщикам.Заказ КАК Заказ
	|ИЗ
	|	РегистрСведений.СостоянияЗаказовПоставщикам КАК СостоянияЗаказовПоставщикам
	|ГДЕ
	|	СостоянияЗаказовПоставщикам.Заказ В(&Заказы)
	|	И СостоянияЗаказовПоставщикам.Состояние = &Состояние";
	Запрос.УстановитьПараметр("Заказы",Заказы );
	Запрос.УстановитьПараметр("Состояние",Перечисления.СостоянияЗаказовПоставщикам.ОжидаетсяПоступление);
	МассивЗаказов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Заказ");
	
	
	Если Не ЗначениеЗаполнено(МассивЗаказов) Тогда
		Возврат;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПоставщикуТовары.Ссылка КАК ЗаказПоставщику,
	|	СУММА(ЗаказПоставщикуТовары.Количество) КАК КоличествоПлан,
	|	0 КАК КоличествоФакт
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовПоставщикам КАК СостоянияЗаказовПоставщикам
	|		ПО (ЗаказПоставщикуТовары.Ссылка = СостоянияЗаказовПоставщикам.Заказ)
	|ГДЕ
	|	ЗаказПоставщикуТовары.Ссылка В(&Заказы)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказПоставщикуТовары.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПриходныйОрдерНаТоварыТовары.Ссылка.Распоряжение,
	|	0,
	|	СУММА(ПриходныйОрдерНаТоварыТовары.Количество)
	|ИЗ
	|	Документ.ПриходныйОрдерНаТовары.Товары КАК ПриходныйОрдерНаТоварыТовары
	|ГДЕ
	|	ПриходныйОрдерНаТоварыТовары.Ссылка.Распоряжение В(&Заказы)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПриходныйОрдерНаТоварыТовары.Ссылка.Распоряжение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблица.ЗаказПоставщику КАК ЗаказПоставщику,
	|	СУММА(ВременнаяТаблица.КоличествоПлан) КАК КоличествоПлан,
	|	СУММА(ВременнаяТаблица.КоличествоФакт) КАК КоличествоФакт,
	|	(СУММА(ВременнаяТаблица.КоличествоПлан)-СУММА(ВременнаяТаблица.КоличествоФакт))/ СУММА(ВременнаяТаблица.КоличествоПлан) Как Остаток
	|ИЗ
	|	ВременнаяТаблица КАК ВременнаяТаблица
	|
	|СГРУППИРОВАТЬ ПО
	|	ВременнаяТаблица.ЗаказПоставщику
	|	имеющие   
	|	(СУММА(ВременнаяТаблица.КоличествоПлан)-СУММА(ВременнаяТаблица.КоличествоФакт))/ СУММА(ВременнаяТаблица.КоличествоПлан)<0.07";
	Запрос.УстановитьПараметр("Заказы",МассивЗаказов );
	РезультатЗапроса = Запрос.Выполнить();   
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл 
		
		Набор = РегистрыСведений.СостоянияЗаказовПоставщикам.СоздатьНаборЗаписей();
		Набор.Отбор.Заказ.Установить(Выборка.ЗаказПоставщику);
		
		НоваяЗапись			=	Набор.Добавить();
		НоваяЗапись.Заказ			=	Выборка.ЗаказПоставщику;
		НоваяЗапись.Состояние		=	Перечисления.СостоянияЗаказовПоставщикам.ОжидаетсяОплатаПослеПоступления;
		
		Набор.Записать(Истина);
		
		
	КонецЦикла; 
	
	
	
	
	
	
КонецПроцедуры //-Лико m.shenderov 23.03.2023



