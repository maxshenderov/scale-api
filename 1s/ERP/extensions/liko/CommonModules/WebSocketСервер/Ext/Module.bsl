Функция ПолучитьКодРабочегоМеста() Экспорт //+Лико m.shenderov 04.04.2021
	
	РМ            = ПараметрыСеанса.Лико_РабочееМесто;
	ИмяКомпьютера = ПараметрыСеанса.РабочееМестоКлиента.ИмяКомпьютера;
	Если Не ЗначениеЗаполнено(РМ.ИмяКомпьютера) Тогда 
		Если  ЗначениеЗаполнено(ИмяКомпьютера) Тогда 
			Возврат СтрШаблон("%1(%2)",РМ,ИмяКомпьютера);
			
		Иначе
			
			Возврат Неопределено;
		КонецЕсли;
	Иначе 
		Возврат  ПараметрыСеанса.Лико_РабочееМесто.Наименование;
	КонецЕсли;	
	
КонецФункции  //-Лико m.shenderov 04.04.2021

Процедура ОтправитьСообщение(Форма,Контент) Экспорт  //+Лико m.shenderov 17.06.2021
	Token=ПолучитьToken();
	Если Не ЗначениеЗаполнено(Token) Тогда 		
		Возврат ; 		
	КонецЕсли;
	
	Settings=Settings();
	Контент.Вставить("FormGUID",Форма.FormGUID);
	Контент.Вставить("DateTime",ТекущаяДата());
	Структура = Новый Структура;
	Структура.Вставить("talk_uuid", Форма.WebSocketUUID);	
	Структура.Вставить("content", СтруктураВJSON(Контент)); 	
	ТелоЗапроса=СтруктураВJSON(Структура);	
	ssl = Новый ЗащищенноеСоединениеOpenSSL(); 	
	Попытка		
		Массив = Новый Массив();
		Массив.Добавить(Новый Структура("Authorization", СтрШаблон("Bearer %1",Token)));		
		HttpRespons=HttpRequest(Settings.Domain,Settings.ApiEndPoint_Send,ТелоЗапроса,ssl,,Массив); 		
	Исключение
		Сообщить(ОписаниеОшибки());		
		
	КонецПопытки;	
	
	
	
	
КонецПроцедуры //-Лико m.shenderov 17.06.2021

Функция ПолучитьToken(Settings=Неопределено) Экспорт  //+Лико m.shenderov 07.05.2021
	//ЗаполнитьЗначенияСвойств(Структура,СоздаваемыйКонтрагент);
	Если Settings=Неопределено Тогда
	Settings=Settings();
	КонецЕсли;

	
	Структура = Новый Структура;
