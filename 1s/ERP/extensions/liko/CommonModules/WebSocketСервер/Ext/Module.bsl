Процедура ИнициализацияПопытка(Форма, 
	WebSocketПоказыватьQRCode = Ложь,
	Группа    = "GroupWebSocket",
	Settings = Неопределено,
	url = Неопределено,
	payload=Неопределено,
	КодРабочегоМеста=Неопределено,
	Оператор = Неопределено,
	ТабельныйНомер = неопределено) Экспорт  //+Лико m.shenderov 19.06.2021
	
	ВключитьWebSocket=Справочники.Лико_ПредопределенныеЗначения.ВключитьWebSocket.ЗначениеПараметра;
	
	Если НЕ (ТипЗнч(ВключитьWebSocket)=Тип("Булево") И 
		ВключитьWebSocket И 
		ПараметрыСеанса.Лико_РабочееМесто.WebSocket) Тогда
		Возврат;
	КонецЕсли;
	
	
	Если Форма.Элементы.Найти(Группа)=Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если КодРабочегоМеста=Неопределено Тогда
		КодРабочегоМеста=ПолучитьКодРабочегоМеста();
	КонецЕсли;
	
	Если Оператор=Неопределено Тогда
		Оператор=Строка(ПараметрыСеанса.Лико_РабочееМесто.СотрудникПоF2);
	КонецЕсли;
	
	
	
	
	Если Не ЗначениеЗаполнено(КодРабочегоМеста) Тогда
		Возврат;
	КонецЕсли;
	
	Если Settings=Неопределено Тогда
		Settings=Settings();
	КонецЕсли;
	
	////+AttachFiles
	action= "attach-files";
	
	//Если  ЭтоИнфопад() Тогда
	Если payload=Неопределено Тогда
		payload = Новый Структура;
		payload.Вставить("workplace",КодРабочегоМеста);    
		payload.Вставить("fullName", СтрШаблон("%1", Оператор));
		payload.Вставить("personNumber", СтрШаблон("%1", ТабельныйНомер));
		action= "infopad";
	КонецЕсли; 
	
	Структура = Новый Структура;
	Структура.Вставить("action",action);
	Структура.Вставить("payload",payload);
	Структура.Вставить("ttl",720); 
	Структура.Вставить("refresh",Ложь);
	
	
	//Иначе 
	//               
	//               Если payload=Неопределено Тогда
	//                               payload = Новый Структура;
	//                               payload.Вставить("handler","SendTo1C");
	//                               payload.Вставить("workplace",КодРабочегоМеста);
	//                               //payload.Вставить("fullName",Оператор);
	//                               //payload.Вставить("personNumber",ТабельныйНомер);
	//                               
	//                               action= "barcode-scanner";
	//               КонецЕсли; 
	//               
	//               Структура = Новый Структура;
	//               Структура.Вставить("action",action);
	//               Структура.Вставить("payload",payload);
	//               Структура.Вставить("ttl",30); 
	//               Структура.Вставить("refresh",Истина); 
	//               
	//КонецЕсли;
	
	
	
	Json    = WebSocketСервер.СтруктураВJSON(Структура);                           
	Settings= WebSocketСервер.SettingsTest();
	Token   = WebSocketСервер.ПолучитьToken(Settings);  
	
	ssl      = Новый ЗащищенноеСоединениеOpenSSL();
	
	Массив = Новый Массив();
	Массив.Добавить(Новый Структура("Authorization", СтрШаблон("Bearer %1",Token)));
	
	HttpRespons     = WebSocketСервер.HttpRequest(Settings.domain,Settings.ApiEndPoint_AttachFiles,Json,ssl,,Массив);
	ОтветПотокаJSON = WebSocketСервер.ПолучитьОтветJSON(HttpRespons);                     
	
	Если ОтветПотокаJSON.Свойство("uuid") Тогда 
		uuid_=ОтветПотокаJSON.uuid;
		//КодРабочегоМеста=WebSocketСервер.ПолучитьКодРабочегоМеста();
		
		url=WebSocketСервер.url(WebSocketСервер.settingsTest(),Новый Структура("ext,subject",uuid_,КодРабочегоМеста));    
	КонецЕсли;
	
	
	
	
	
	////-AttachFiles
	ДобавляемыеРеквизиты           = Новый Массив;
	
	Если не  ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "WebSocketПоказыватьQRCode")Тогда 
		
		
		ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("WebSocketПоказыватьQRCode",Новый ОписаниеТипов("Строка", ,
		Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)),, "WebSocketПоказыватьQRCode"));
		
		
		
		ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("WebSocketURL",Новый ОписаниеТипов("Строка", ,
		Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)),, "WebSocketURL"));
		
		ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("WebSocketSubject",Новый ОписаниеТипов("Строка", ,
		Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)),, "WebSocketSubject"));
		
		ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("WebSocketUUID",Новый ОписаниеТипов("Строка", ,
		Новый КвалификаторыСтроки(36, ДопустимаяДлина.Переменная)),, "WebSocketUUID"));
		
		ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("FormGUID",Новый ОписаниеТипов("Строка", ,
		Новый КвалификаторыСтроки(36, ДопустимаяДлина.Переменная)),, "FormGUID"));
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	КонецЕсли;
	
	
	Форма.WebSocketSubject=КодРабочегоМеста;
	Форма.FormGUID=Строка(Новый УникальныйИдентификатор);
	Форма.WebSocketПоказыватьQRCode=WebSocketПоказыватьQRCode;
	
	Если url=Неопределено Тогда
		url =СтрШаблон("%1?username=%2&password=%3&subject=%4",Settings.WebSocketURL,Settings.username,Settings.password,Форма.WebSocketSubject);
	КонецЕсли;
	
	
	Форма.WebSocketURL=url;
	
	Если  Форма.Элементы.Найти("WebSocketURL") = неопределено Тогда
		
		Элемент                        = Форма.Элементы.Добавить("WebSocketURL", Тип("ПолеФормы"),Форма.Элементы[Группа]); 
		Элемент.Вид                    = ВидПоляФормы.ПолеHTMLДокумента;
		Элемент.ПутьКДанным            = "WebSocketURL";
		Элемент.АвтоМаксимальнаяВысота = Ложь;
		Элемент.АвтоМаксимальнаяШирина = Ложь;
		Элемент.Ширина                 = 1;
		Элемент.Высота                 = 1;
		Элемент.Доступность            = WebSocketПоказыватьQRCode;
		Элемент.ПоложениеЗаголовка     = ПоложениеЗаголовкаЭлементаФормы.Нет;
		Элемент.ЦветРамки              = ЦветаСтиля.ЦветФонаФормы;
		Элемент.УстановитьДействие("ПриНажатии","WebSocketURLПриНажатии");
		Элемент.УстановитьДействие("ДокументСформирован","WebSocketДокументСформирован");
		
	КонецЕсли;
	//Док = Форма.Элементы.WebSocketURL.Документ; 
	//Док.forms["form"].subject.Value  = Форма.WebSocketSubject; 
	//Док.forms["form"].username.Value = Settings.username;
	//Док.forms["form"].password.Value = Settings.password;
	
	
	
	
	
КонецПроцедуры //-Лико m.shenderov 19.06.2021

Функция ЕстьРеквизитИлиСвойствоОбъекта(Объект, ИмяРеквизита) 
    
    КлючУникальности   = Новый УникальныйИдентификатор;
    СтруктураРеквизита = Новый Структура(ИмяРеквизита, КлючУникальности);
    ЗаполнитьЗначенияСвойств(СтруктураРеквизита, Объект);
    
    Возврат СтруктураРеквизита[ИмяРеквизита] <> КлючУникальности;
    
КонецФункции



