  Функция ОрганизацияЛикофлексСервер() //+Лико m.shenderov 27.03.2024
	  
	  Возврат Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра;
  	
  КонецФункции  //-Лико m.shenderov 27.03.2024
  
  &НаСервереБезКонтекста
  Функция УказыватьДопРасходы(ХозяйственнаяОперация)
	  
	  Массив = РегистрыСведений.Лико_АвтоРасчетЦенЦГ.ХозяйственныеОперации();
	  Индекс = Массив.Найти(Перечисления.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭС);
	  
	  Если Индекс<>Неопределено Тогда 
		  Массив.Удалить(Индекс);
	  КонецЕсли;
	  
	  
	  Возврат Массив.Найти(ХозяйственнаяОперация)<>Неопределено;
	  
  КонецФункции 
  
  
  
  &НаКлиенте
  Процедура Лико_ПередЗаписьюПеред(Отказ, ПараметрыЗаписи)
	  
	  Если НЕ Объект.Лико_Предзаказ 
		  И УказыватьДопРасходы(Объект.ХозяйственнаяОперация) 
		  И Объект.Организация=ОрганизацияЛикофлексСервер()
		  И Объект.Лико_ДопРасходы.Итог("Сумма")=0 Тогда 
		  
		  Для каждого Товар Из Объект.Товары Цикл 
			  
			  Если Не АвтоРасчетЦеныСервер(Товар.Номенклатура) Тогда
				  Продолжить;
			  КонецЕсли;
			  
			  Отказ=Истина;
			  Сообщить("Не заведены доп. расходы!"); 
			  Возврат;
			  
			  
		  КонецЦикла;
		  
	  КонецЕсли;
	  
	  
	  Если НЕ Объект.Лико_Предзаказ И
		  //Объект.Лико_УстановкаЦен И 
		  Не Лико_РазрешениеЗаписи Тогда
		  
		  ЗаполнитьВалютуЦГВтоварахСервер();
		  Для каждого Товар Из Объект.Товары Цикл 
			  
			  Если Не АвтоРасчетЦеныСервер(Товар.Номенклатура) Тогда
				  Продолжить;
			  КонецЕсли;
			  
			  Если  Товар.Лико_ВалютаЦГ<>Объект.Лико_ВалютаРасчета Тогда
				  Отказ=Истина;
				  
				  Если Не ЗначениеЗаполнено(Товар.Лико_ВалютаЦГ) Тогда
					  
					  Текст=СтрШаблон("Не установлена валюта учета для ценовой группы: ""(%1) %2"".",Товар.Лико_КодЦГ,Товар.Лико_ЦеноваяГруппа);
					  
				  Иначе
					  Текст=СтрШаблон(" Валюта расчета в документе - ""%3"", не соответсвует валюте - ""%4"", установленной  для ценовой группы ""(%1) %2""."
					  ,СокрЛП(Товар.Лико_КодЦГ)
					  ,Товар.Лико_ЦеноваяГруппа
					  ,Объект.Лико_ВалютаРасчета
					  ,Товар.Лико_ВалютаЦГ);
					  
				  КонецЕсли;
				  
				  
				  Сообщить(Текст);
				  
				  
			  КонецЕсли;
			  
			  
		  КонецЦикла;
		  
		  Если Отказ Тогда 
			  ПолучитьРазрешениеНаЗапись(ПараметрыЗаписи);
			  Возврат; 
		  КонецЕсли;
		  
		  
	  КонецЕсли;  
	  
	  
	  	  
	  Если НЕ Объект.Лико_Предзаказ 
		  И Не Лико_ЦеныПроверены 
		  И Не Отказ Тогда 
			
			ПоказатьРазницуВЦенеСЦеновойГрупой(Отказ,ПараметрыЗаписи);
		
		Если Отказ Тогда 
			
			ПолучитьРазрешениеНаЗаписьПроверкаЦен(ПараметрыЗаписи);

			
		КонецЕсли;
		
		
	    КонецЕсли;


	  
	  
  КонецПроцедуры
  
  
    &НаСервере
  Процедура ПоказатьРазницуВЦенеСЦеновойГрупой(Отказ,ПараметрыЗаписи) //+Лико m.shenderov 14.08.2024
   ТаблицаЦен= РегистрыСведений.Лико_СтоимостьЦеновыхГрупп.ПоказатьРазницуВЦенеСЦеновойГрупой(Объект.Организация,
		  Объект.Дата,
		  Объект.Лико_ВалютаРасчета,
		  Объект.Товары.Выгрузить()); 
		  
		  Если ТаблицаЦен.Количество()>0 Тогда
			Отказ = Истина;
						
			Для каждого СтрЦен Из ТаблицаЦен  Цикл 
		НомерСтроки = СтрЦен.НомерСтроки-1;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(" Цена номенклатуры:""%1"" отличается на: %2%% (текущая цена:%3 %4.)",СтрЦен.Номенклатура,СтрЦен.РазницаПроцент,СтрЦен.ЦенаЦГ,СтрЦен.ВалютаЦГ);
		Сообщение.Поле = "Объект.Товары["+НомерСтроки+"].Номенклатура"; //имя реквизита 
		Сообщение.УстановитьДанные(Объект); //Ссылка на объект ИБ
		Сообщение.Сообщить();
	 	
	 КонецЦикла;

			
		  КонецЕсли;
		  
  	
  КонецПроцедуры  //-Лико m.shenderov 14.08.2024
  

  
  
  
  &НаКлиенте
  Асинх Процедура ПолучитьРазрешениеНаЗапись(ПараметрыЗаписи) //+Лико m.shenderov 18.12.2023
  		  
	 Режим = РежимДиалогаВопрос.ДаНет;
    Ответ = Ждать ВопросАсинх(СтрШаблон
	  ("Валюта расчета в документе - ""%1"" -  не соответсвует установленной валюте для ценовой группы.",Объект.Лико_ВалютаРасчета), Режим, 0);
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	Лико_РазрешениеЗаписи=Истина;
	Записать(ПараметрыЗаписи);
	  
  КонецПроцедуры //-Лико m.shenderov 18.12.2023
  
  &НаКлиенте
Асинх Процедура ПолучитьРазрешениеНаЗаписьПроверкаЦен(ПараметрыЗаписи)
	
		
	  Режим = РежимДиалогаВопрос.ДаНет;
	  Ответ = Ждать ВопросАсинх(СтрШаблон
	  ("Есть отличие от текущих цен!"), Режим, 0);
	  
	  Если Ответ = КодВозвратаДиалога.Нет Тогда
		  
		  Возврат;
		  
	  КонецЕсли;
	  
	  Лико_ЦеныПроверены	=	Истина;
	  Записать(ПараметрыЗаписи);   
	  
	  
КонецПроцедуры 


  
  
