&НаКлиенте
Процедура ПроставитьПМ()
	Для каждого Товар Из Объект.Товары  Цикл
		Нарезка=ПолучитьНарезкуСервер(Товар.Характеристика);
		Если  Нарезка<>0 Тогда 
			Товар.КоличествоПМ=Товар.КоличествоУпаковок/(Нарезка/1000);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьНарезкуСервер(Характеристика) //+Лико m.shenderov 11.12.2017
	Если ЗначениеЗаполнено(Характеристика.ЯССМ_Нарезка.Размер) Тогда
		Возврат Характеристика.ЯССМ_Нарезка.Размер;
	КонецЕсли;
	Возврат 0;
КонецФункции  //-Лико m.shenderov 11.12.2017

&НаКлиенте
Функция ПриВвводеРоликов() //+Лико m.shenderov 14.12.2017 
	
	Нарезка=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Элементы.Товары.ТекущиеДанные.Характеристика,"ЯССМ_Нарезка");
	
	//Если Нарезка <> ПредопределенноеЗначение("Справочник.ЯССМ_Нарезки.ПустаяСсылка") Тогда
		
		Если ЗначениеЗаполнено(Нарезка) Тогда

		
		Если Не ЗначениеЗаполнено(Элементы.Товары.ТекущиеДанные.Лико_Втулка) Тогда
			Элементы.Товары.ТекущиеДанные.Лико_Втулка=ВтулкаСервер76();
		КонецЕсли;
		
		
		КоличествоПГ = 0;
		КоличествоКВ = (Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Нарезка,"Размер")/1000) *
		Элементы.Товары.ТекущиеДанные.Лико_Намотка * 
		Элементы.Товары.ТекущиеДанные.Лико_КолРоликов;
		
		Элементы.Товары.ТекущиеДанные.КоличествоУпаковок = КоличествоКВ;
		КоличествоУпаковокПриИзменении("ПриВвводеРоликов");	
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции  //-Лико m.shenderov 14.12.2017

