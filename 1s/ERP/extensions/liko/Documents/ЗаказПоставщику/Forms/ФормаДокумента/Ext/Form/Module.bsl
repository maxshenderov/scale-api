&НаСервере
Процедура РасчетЦенПоКурсуДопРасходовСервер() //+Лико m.shenderov 15.11.2023
	
	
	
	Для каждого Расход Из Объект.Лико_ДопРасходы Цикл
		    Если Не Расход.РучнойВводКурса Тогда
			Расход.КросКурс=0; 
			КонецЕсли;
			
			Расход.СуммаВВалютеДокумента=0;

		
			Если Не ЗначениеЗаполнено(Объект.Лико_ВалютаРасчета) 
				Или Не ЗначениеЗаполнено(Расход.Валюта) 
				Или Не ЗначениеЗаполнено(Расход.Сумма) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если Расход.Валюта=Объект.Лико_ВалютаРасчета Тогда 
			Расход.КросКурс=1;
			Расход.СуммаВВалютеДокумента=Расход.Сумма;
			
		Иначе 
			
					
			Если Не Расход.РучнойВводКурса Тогда
				
				Расход.СуммаВВалютеДокумента
				=	РаботаСКурсамиВалют.ПересчитатьВВалюту(Расход.Сумма, Расход.Валюта,Объект.Лико_ВалютаРасчета, ?(ЗначениеЗаполнено(Объект.Лико_ДатаКурса),Объект.Лико_ДатаКурса,ТекущаяДата()));
				
				Если Расход.Валюта.Лико_Рейтинг>=Объект.Лико_ВалютаРасчета.Лико_Рейтинг Тогда
					Расход.КросКурс=Расход.Сумма/Расход.СуммаВВалютеДокумента;
				Иначе
					Расход.КросКурс=Расход.СуммаВВалютеДокумента/Расход.Сумма;	
				КонецЕсли;  
			Иначе
								
				Если Расход.Валюта.Лико_Рейтинг>=Объект.Лико_ВалютаРасчета.Лико_Рейтинг Тогда
					Расход.СуммаВВалютеДокумента=Расход.Сумма/Расход.КросКурс;
				Иначе
					Расход.СуммаВВалютеДокумента=Расход.КросКурс*Расход.Сумма;	
				КонецЕсли; 
				

				
			КонецЕсли;
		
			
		КонецЕсли;
		
			
		
	КонецЦикла;
	
КонецПроцедуры  //-Лико m.shenderov 15.11.2023

&НаСервере
Процедура РасчетЦеныПолныйСервер() //+Лико m.shenderov 15.11.2023
	//Если Не Объект.Лико_УстановкаЦен Тогда
	//	   Возврат;
	//КонецЕсли;
	

	СуммаДоп=Объект.Лико_ДопРасходы.Итог("СуммаВВалютеДокумента");
	ОбщиеДопРасходы=0;
	ОбщиеДопРасходыДляНДС=0; 
	СуммаИтог=Объект.Товары.Итог("Сумма"); 
	Если СуммаИтог=0 Тогда
		Возврат;
	КонецЕсли;
	
	
	Для каждого Расход Из Объект.Лико_ДопРасходы Цикл
		
		Если Расход.Расход.БазаДляНДС Тогда
			ОбщиеДопРасходыДляНДС=ОбщиеДопРасходыДляНДС+Расход.СуммаВВалютеДокумента;
		Иначе
			ОбщиеДопРасходы=ОбщиеДопРасходы+Расход.СуммаВВалютеДокумента;
		КонецЕсли;
		
	КонецЦикла;
	ОбщиеДопРасходыОстаток=ОбщиеДопРасходы;
	ОбщиеДопРасходыДляНДСОстаток=ОбщиеДопРасходыДляНДС;
	сч=Объект.Товары.Количество();
	ДатаРасчета = ?(ЗначениеЗаполнено(Объект.Лико_ДатаКурса),Объект.Лико_ДатаКурса,Объект.Дата);
	РазнаяВалютаУчета = Объект.Валюта
	<>?(ЗначениеЗаполнено(Объект.Лико_ВалютаРасчета),Объект.Лико_ВалютаРасчета,Объект.Валюта);
	
	Для каждого Товар Из Объект.Товары  Цикл
		Если Товар.Количество=0 Тогда
			Продолжить;
		КонецЕсли;
		
		сч=сч-1;
		
		
		
		Коэффициент=Товар.Сумма/СуммаИтог;
		Если сч<>0 Тогда
			
			ДопРасходы=ОбщиеДопРасходы*Коэффициент;
			ДопРасходыДляНДС=ОбщиеДопРасходыДляНДС*Коэффициент;
			
			ОбщиеДопРасходыОстаток=ОбщиеДопРасходыОстаток-ДопРасходы;
			ОбщиеДопРасходыДляНДСОстаток=ОбщиеДопРасходыДляНДСОстаток-ДопРасходыДляНДС;
		Иначе
			ДопРасходы=ОбщиеДопРасходыОстаток;
			ДопРасходыДляНДС=ОбщиеДопРасходыДляНДСОстаток;
			
			ОбщиеДопРасходыОстаток=0;
			ОбщиеДопРасходыДляНДСОстаток=0;		
			
		КонецЕсли;
		ТаможеннаяПошлина=?(Товар.Лико_ТаможеннаяПошлина=0,1,Товар.Лико_ТаможеннаяПошлина);
		НДС=1+Число(Товар.Лико_СтавкаНДС)/100;
		ТоварЦена = ?(Объект.ЦенаВключаетНДС,Товар.Цена/НДС,Товар.Цена); 
		
		Если РазнаяВалютаУчета Тогда		
			Товар.Лико_ЦенаВВалютеРасчета = РаботаСКурсамиВалют.ПересчитатьВВалюту(Товар.цена,Объект.Валюта, Объект.Лико_ВалютаРасчета, ДатаРасчета); 
		Иначе
			Товар.Лико_ЦенаВВалютеРасчета = Товар.Цена;
		КонецЕсли;
		Товар.Лико_СуммаВВалютеРасчета=Товар.Лико_ЦенаВВалютеРасчета*Товар.Количество;
		
		ТоварЦена = ?(Объект.ЦенаВключаетНДС,Товар.Лико_ЦенаВВалютеРасчета/НДС,Товар.Лико_ЦенаВВалютеРасчета);

		
		Товар.Лико_ДопЦена=ДопРасходы/Товар.Количество;
		Товар.Лико_ЦенаИтого
		=(ТоварЦена+ДопРасходыДляНДС/Товар.Количество)
		*ТаможеннаяПошлина
		*НДС
		+ТоварЦена*Товар.Лико_КонвертацияВалюты
		+Товар.Лико_ДопЦена;
		Товар.Лико_СуммаИтого=Товар.Лико_ЦенаИтого*Товар.Количество;
		
		ВалютаУУ=Константы.ВалютаУправленческогоУчета.Получить();
		
		Товар.Лико_ЦенаВВалютеУУ
		=	РаботаСКурсамиВалют.ПересчитатьВВалюту(Товар.Лико_ЦенаИтого, Объект.Лико_ВалютаРасчета,ВалютаУУ, ДатаРасчета);
		Товар.Лико_СуммаВВалютеУУ=Товар.Лико_ЦенаВВалютеУУ*Товар.Количество;
		
		
		
		
	КонецЦикла;
	
КонецПроцедуры  //-Лико m.shenderov 15.11.2023




