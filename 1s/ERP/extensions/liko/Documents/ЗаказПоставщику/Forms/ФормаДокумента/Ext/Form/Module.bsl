&НаСервереБезКонтекста
Функция ВтулкаСервер76() //+Лико m.shenderov 15.12.2017
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_Втулки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Лико_Втулки КАК Лико_Втулки
	|ГДЕ
	|	Лико_Втулки.Размер = 76";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла; 
	
КонецФункции  //-Лико m.shenderov 15.12.2017


&НаСервере
Процедура Лико_Лико_Цена1ПослеНаСервере()
	Индекс =0;

	Для каждого Товар Из Объект.Товары Цикл
		
		
		СтруктураЦены=Лико_ОбщегоНазначенияСервер.СтруктураЦеныПоЦенновойГрупе(Товар.Номенклатура.ЦеноваяГруппа,Объект.Организация);
		
		Если Не ЗначениеЗаполнено(СтруктураЦены.ВалюТаЦеныПоставщика) Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Цена поставщика ЦГ номенклатуры: ""(%1) %2"" не установлена!",
			Товар.Номенклатура.Код,
			Товар.Номенклатура);
			Сообщение.Поле = СтрШаблон("Объект.Товары[%1].Номенклатура",Индекс); //имя реквизита 

			
	ИначеЕсли Объект.Валюта<>СтруктураЦены.ВалюТаЦеныПоставщика Тогда 
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Валюта документа :%1 не соответсвует валюте ЦГ: %2 (номенклатура: ""(%3)%4"")!",
			Объект.Валюта,
			СтруктураЦены.ВалюТаЦеныПоставщика,
			Товар.Номенклатура.Код,
			Товар.Номенклатура);
			Сообщение.Поле = СтрШаблон("Объект.Товары[%1].Номенклатура",Индекс); //имя реквизита 
			//Сообщение.УстановитьДанные(); //Ссылка на объект ИБ
			Сообщение.Сообщить();
		Иначе
			Товар.Цена=СтруктураЦены.ЦенаПоставщика;
			СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);	
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСумму");
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
		СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(Товар, СтруктураДействий, Неопределено);
        РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);

			
			
		КонецЕсли;
		
		 Индекс = Индекс+1;
				
		
	КонецЦикла;
	Объект.РегистрироватьЦеныПоставщика=Ложь;	
КонецПроцедуры


