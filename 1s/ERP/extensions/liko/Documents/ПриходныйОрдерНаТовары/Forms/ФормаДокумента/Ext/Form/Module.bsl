&НаКлиенте
Асинх Процедура Лико_ЗарезервироватьПодКлиентаПосле(Команда)
	
	Если Не ЗначениеЗаполнено(ГлЛико_Оператор) Тогда
		ГлЛико_Оператор=СотрудникПоF2НаСервере();		
	КонецЕсли;

	
	Если Не Объект.Проведен Тогда
		
		ПоказатьПредупреждение(,"Документ должен быть проведен!");		
		Возврат; 	
		
	КонецЕсли; 
	
	 		
	Партнер = Объект.Отправитель;
	
	Если ТипЗнч(Партнер)<> Тип("СправочникСсылка.Партнеры") Тогда
		
		Партнер=Неопределено;
		
		Партнер =Ждать ВвестиЗначениеАсинх(ПредопределенноеЗначение("Справочник.Партнеры.ПустаяСсылка"),"Укажите клиента");
		
	КонецЕсли;
	
	Если  Не ЗначениеЗаполнено(Партнер) Тогда
		Возврат;
	КонецЕсли;
	
	 Режим = РежимДиалогаВопрос.ДаНет;
    Ответ = Ждать ВопросАсинх(НСтр("ru = 'Зарезервировать материал?';"
         + " en = 'Do you want to continue?'"), Режим, 0);
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Партнер",Партнер);
	ПараметрыЗаполнения.Вставить("Сотрудник",ГлЛико_Оператор);
	
	
	ПодготовитьМассивСерийСервер(ПараметрыЗаполнения);
	
		ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",ПараметрыЗаполнения);
		
	
	
	ОписаниеОповещение= Новый ОписаниеОповещения("ЗарезервироватьПодКлиентаЗавершение",ЭтаФорма);
	ОткрытьФорму("Документ.Лико_УстановкаРезерваМатериалов.Форма.ФормаДокумента",ПараметрыФормы,,,,,ОписаниеОповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	

КонецПроцедуры 

&НаСервере
Процедура ПодготовитьМассивСерийСервер(ПараметрыЗаполнения) //+Лико m.shenderov 16.01.2023
    МассивСерий= Новый Массив;
	Для каждого Данные Из Объект.Товары Цикл
		
		ОбъектНоменклатуры=Данные.Серия.Яссм_ОбъектНоменклатуры;  
		
		Если Не  ОбъектНоменклатуры.Уникальный  Тогда
			Продолжить;
		КонецЕсли;
		
		Структура = Новый Структура;
		Структура.Вставить("Номенклатура",ОбъектНоменклатуры.Номенклатура);
		Структура.Вставить("Характеристика",ОбъектНоменклатуры.Характеристика);
		Структура.Вставить("Упаковка",ОбъектНоменклатуры.БазоваяЕдиницаИзмерения);
		Структура.Вставить("Серия",ОбъектНоменклатуры.Серия); 
		Структура.Вставить("СтатусУказанияСерий",8);
		Структура.Вставить("КоличествоУпаковок",ОбъектНоменклатуры.Количество);
		Структура.Вставить("Количество",ОбъектНоменклатуры.Количество*ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель);
		Структура.Вставить("АдресХранения",Объект.ЗонаПриемки);
		Структура.Вставить("ВидНастроечногоМатериала",ОбъектНоменклатуры.ВидНастроечногоМатериала); 		
		МассивСерий.Добавить(Структура);
		
	КонецЦикла; 
	ПараметрыЗаполнения.Вставить("МассивСерий",МассивСерий);
	

	
КонецПроцедуры  //-Лико m.shenderov 16.01.2023


