&НаСервере
Процедура Лико_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("BRC_Подпись") Тогда
		BRC_Подпись=Истина;
	КонецЕсли;
	
	ТиповыеДокументы.Параметры.УстановитьЗначениеПараметра("Ссылка", Объект.Ссылка);
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка)  Тогда
		Объект.Лико_Организация=
		Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитПользователяОрганизация", Параметрысеанса.ТекущийПользователь); 			
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Склад) Тогда
		Если Объект.Склад.Лико_ТипСклада=Перечисления.Лико_ТипСклада.СИМ Тогда
			Элементы.ТоварыСерияОбъектНоменклатуры.Видимость=Истина;
			Элементы.ТоварыСерия.Видимость=Ложь;
			
		Иначе
			Элементы.ТоварыСерияОбъектНоменклатуры.Видимость=Ложь;
			Элементы.ТоварыСерия.Видимость=Истина; 
		КонецЕсли;
		
	КонецЕсли;
	СразуНаПринтер=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ПечатьСразуНаПринтер",Ложь);	
	ПечатьПриходногоОрдера=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ПечатьПриходногоОрдера",Ложь);	
	Если  РольДоступна("АдминистраторСистемы") Тогда
		
		Элементы.АвторДокумента.Вид=ВидПоляФормы.ПолеВвода;
		Элементы.РабочееМесто.Вид=ВидПоляФормы.ПолеВвода;
	Иначе
		Элементы.АвторДокумента.Вид=ВидПоляФормы.ПолеНадписи;
		Элементы.РабочееМесто.Вид=ВидПоляФормы.ПолеНадписи;
		
		
	КонецЕсли;
	//
	Если ТипЗнч(Объект.Распоряжение)=Тип("ДокументСсылка.ЗаказПоставщику") ТОгда
		
		Объект.Лико_Интеркампани=Лико_Дополнительно.ПриходПоИнтеркампани(Объект.Распоряжение.Организация,Объект.Распоряжение.Контрагент);
		Если Объект.Лико_Интеркампани и Объект.Лико_ОтражатьВБухгалтерскомУчете тогда
			Объект.Лико_ОтражатьВБухгалтерскомУчете=Ложь;
		КонецЕсли;
	КонецЕсли;
	
	//Организация=УправлениеСвойствами.ЗначениеСвойства(ПараметрыСеанса.ТекущийПользователь,"Организация_e4c9d825676549a1a5c19972efa7da0b");
	Организация=Объект.Распоряжение.Организация;
	BRC=?(ЗначениеЗаполнено(Организация),УправлениеСвойствами.ЗначениеСвойства(Организация,"Лико_УчетНаСкладеПоBRC"),Ложь);	
	Если Объект.Склад.Лико_ТипСклада<>Перечисления.Лико_ТипСклада.СИМ ТОгда 
		BRC=Ложь;		
	КонецЕсли;
	
	Если BRC Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Лико_ВидКонтактаСПищевойПродукцией)и ТипЗнч(Объект.Распоряжение)=Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			Объект.Лико_ВидКонтактаСПищевойПродукцией=Объект.Распоряжение.Лико_ВидКонтактаСПищевойПродукцией;
		КонецЕсли;
		Если Объект.Товары.Количество()>0 и   
			Объект.Лико_ВидКонтактаСПищевойПродукцией<>Объект.Товары[0].Номенклатура.Лико_ВидКонтактаСПищевойПродукцией Тогда
			Объект.Лико_ВидКонтактаСПищевойПродукцией=Объект.Товары[0].Номенклатура.Лико_ВидКонтактаСПищевойПродукцией;
		КонецЕсли;
		СформироватьТаблицуУпаковокBRC();
		
		Если BRC_Подпись Тогда
			Элементы.BRCТоварыBRC_РешениеОПриемке.ТолькоПросмотр=Ложь;
			Элементы.BRC_РешениеОПриемке.ТолькоПросмотр=Ложь;
			Элементы.Лико_ПараметрыВходногоКонтроля.ТолькоПросмотр=Истина;
			
		Иначе
			Элементы.BRCТоварыBRC_РешениеОПриемке.ТолькоПросмотр=Истина;
			Элементы.BRC_РешениеОПриемке.ТолькоПросмотр=Истина;
			Если РольДоступна("ПолныеПрава") или РольДоступна("Лико_ВходнойКонтроль") Тогда
				
				Элементы.Лико_ПараметрыВходногоКонтроля.ТолькоПросмотр=Ложь;
			Иначе
				Элементы.Лико_ПараметрыВходногоКонтроля.ТолькоПросмотр=Истина;
			КонецЕсли;
			
			
		КонецЕсли;
		
		
		Элементы.Лико_ВидКонтактаСПищевойПродукцией.Видимость=Истина;
		Если  Объект.Склад.Лико_ТипСклада=Перечисления.Лико_ТипСклада.СИМ Тогда
			Элементы.ГруппаBRC.Видимость=Истина;
			
		КонецЕсли;
		АктБрака=ПолучитьАктзабраковки();
		ЗаполнитьКритерииДляВходногоКонтроля();	
	Иначе
		Элементы.ГруппаBRC.Видимость=Ложь;
		Элементы.Лико_ВидКонтактаСПищевойПродукцией.Видимость=Ложь;
		
	КонецЕсли; 
	
	Лико_ТоварыВПути = Объект.Склад.Лико_ТипСклада = Перечисления.Лико_ТипСклада.ТоварыВПути;
	
КонецПроцедуры

&НаКлиенте
Процедура Лико_ПриОткрытииПеред(Отказ)
	Если Не ЗначениеЗаполнено(ГлЛико_Оператор) и НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		//ОчиститьСообщения(); 	
		//ТекстПредупреждения = НСтр("ru = 'Пользователь не авторизован, пожалуйста, отсканируйте ваш пропуск!'");		
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПредупреждения);
		Структура = Новый Структура;
		Структура.Вставить("ИмяДокумента","ПриходныйОрдерНаТовары");
		ОткрытьФорму("ОбщаяФорма.Лико_ФормаАвторизацииСклада",Структура,,,,,,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
		Отказ=Истина;
	КонецЕсли; 
	
	
	Если Не ЗначениеЗаполнено(ГлЛико_Оператор) и  ЗначениеЗаполнено(Объект.Ссылка) и НЕ ЗначениеЗаполнено(Объект.Лико_АвторДокумента) Тогда
		//ОчиститьСообщения(); 	
		//ТекстПредупреждения = НСтр("ru = 'Пользователь не авторизован, пожалуйста, отсканируйте ваш пропуск!'");		
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПредупреждения);
		Структура = Новый Структура;
		Структура.Вставить("ИмяДокумента","ПриходныйОрдерНаТовары");
		Структура.Вставить("Ключ",Объект.Ссылка);
		
		ОткрытьФорму("ОбщаяФорма.Лико_ФормаАвторизацииСклада",Структура,,,,,,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
		Отказ=Истина;
	КонецЕсли; 
	
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		Объект.Лико_АвторДокумента=ГлЛико_Оператор;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(	Объект.Лико_АвторДокумента) Тогда 
		Объект.Лико_АвторДокумента=ГлЛико_Оператор;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(	Объект.Лико_РабочееМесто) Тогда 
		Объект.Лико_РабочееМесто=ПолучитьРабочееМестоНаСервере();
	КонецЕсли;
	
	
	ЕСли 	Объект.Лико_СтатусОбмена=2 Тогда
		Объект.Лико_СтатусОбмена=1;
	КонецЕсли;
	Если Объект.Лико_СтатусОбмена=2 Тогда
		Объект.Лико_СтатусОбмена=1;
	КонецЕсли;
	
	ПоказатьКартинкуКритерия();
	
	УстановитьВидимость();
КонецПроцедуры

&НаСервере
