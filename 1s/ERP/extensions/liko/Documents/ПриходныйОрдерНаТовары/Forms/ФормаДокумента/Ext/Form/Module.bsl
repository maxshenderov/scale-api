&НаСервере
Процедура УдалитьКритерииНеКонтакта() //+Лико m.shenderov 23.06.2020
	
	Массив = Новый Массив();
	Для каждого ПараметрВК Из Объект.Лико_ПараметрыВходногоКонтроля Цикл
		Если  ПараметрВК.Критерий.ДляУпаковки Тогда 
			//Или Объект.Лико_ВидКонтактаСПищевойПродукцией<>ПараметрВК.Критерий.ВидКонтакта ТОгда
			
			Массив.Добавить(ПараметрВК);
		КонецЕсли;	  
		
		
	КонецЦикла;
	
	Для каждого Индекс Из Массив Цикл
		Объект.Лико_ПараметрыВходногоКонтроля.Удалить(Индекс);
		
	КонецЦикла;
	
КонецПроцедуры  //-Лико m.shenderov 23.06.2020

Процедура ДобавитьКритерииКонтакта() //+Лико m.shenderov 23.06.2020
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_КритерииВходногоКонтроля.Ссылка КАК Критерий
	|ИЗ
	|	Справочник.Лико_КритерииВходногоКонтроля.ВидыКонтактов КАК Лико_КритерииВходногоКонтроля
	|ГДЕ
	|	НЕ Лико_КритерииВходногоКонтроля.Ссылка.ДляУпаковки
	| И Лико_КритерииВходногоКонтроля.ВидКонтакта=&ВидКонтакта";
	Запрос.УстановитьПараметр("ВидКонтакта",Объект.Лико_ВидКонтактаСПищевойПродукцией);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Структура = Новый Структура;
		Структура.Вставить("Критерий",Выборка.Критерий);
		Если Объект.Лико_ПараметрыВходногоКонтроля.НайтиСтроки(Структура).Количество()=0 Тогда
			НовыйЭлемент=Объект.Лико_ПараметрыВходногоКонтроля.Добавить();
			НовыйЭлемент.Критерий=Выборка.Критерий;
		КонецЕсли;
		
	КонецЦикла; 
	ТзКритерии=РезультатЗапроса.Выгрузить();
	Массив = Новый Массив();
	Для каждого СтрКритерий Из Объект.Лико_ПараметрыВходногоКонтроля Цикл
		
		Если ТзКритерии.Найти(СтрКритерий.Критерий,"Критерий")=Неопределено Тогда
			Массив.Добавить(СтрКритерий);
		КонецЕсли; 		
	КонецЦикла;
	
	Для каждого Индекс Из Массив  Цикл
		    Объект.Лико_ПараметрыВходногоКонтроля.Удалить(Индекс);
	КонецЦикла;
	
	
	
КонецПроцедуры //-Лико m.shenderov 23.06.2020

