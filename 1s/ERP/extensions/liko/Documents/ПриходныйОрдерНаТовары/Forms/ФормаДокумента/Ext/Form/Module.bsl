Процедура СформироватьТаблицуУпаковокBRC() //+Лико m.shenderov 16.07.2020
	
	
	РезультатЗапроса = КритерииДляУпаковки();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл  
		Реквизит="BRC"+Выборка.Код;
		нРеквизиты = Новый Массив;
		нРеквизиты.Добавить(Новый РеквизитФормы("BRC"+Выборка.Код, Новый ОписаниеТипов("Булево"), "Объект.Товары",Выборка.Наименование));
		ИзменитьРеквизиты(нРеквизиты);
		
		нЭлемент = Элементы.Добавить(Реквизит, Тип("ПолеФормы"), Элементы.BRCТовары); 
		нЭлемент.Вид = ВидПоляФормы.ПолеФлажка; 
		нЭлемент.ПутьКДанным = "Объект.Товары."+Реквизит;
		нЭлемент.УстановитьДействие("ПриИзменении", "ИзменениеТаблицыBRC");
		Если BRC_Подпись Тогда
			нЭлемент.ТолькоПросмотр=Истина;
		Иначе
			Если РольДоступна("ПолныеПрава") или РольДоступна("Лико_ВходнойКонтроль") Тогда
				нЭлемент.ТолькоПросмотр=Ложь;
			Иначе
				нЭлемент.ТолькоПросмотр=Истина;
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла; 
	
	ЗаполнитьЗначенияВходногоКонтроляBRCТаблицы();
	
КонецПроцедуры //-Лико m.shenderov 16.07.2020

