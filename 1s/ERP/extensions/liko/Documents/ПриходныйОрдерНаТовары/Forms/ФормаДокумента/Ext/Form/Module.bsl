Процедура ИзменениеТаблицыBRCНаСервере(Код,Серия,Значение) //+Лико m.shenderov 16.07.2020
	Критерий=Справочники.Лико_КритерииВходногоКонтроля.НайтиПоКоду(Код);
	ОбъектОбъектНоменклатуры=Серия.ЯССМ_ОбъектНоменклатуры.ПолучитьОбъект();
	СтруктураПоиска = Новый Структура;
	
	СтруктураПоиска.Вставить("Критерий",Критерий);
	НайденныеСтроки=ОбъектОбъектНоменклатуры.Лико_ПараметрыВходногоКонтроля.НайтиСтроки(СтруктураПоиска);
	Если  НайденныеСтроки.Количество()=0 Тогда
		НовыйКритерий=ОбъектОбъектНоменклатуры.Лико_ПараметрыВходногоКонтроля.Добавить();
		НовыйКритерий.Критерий=Критерий;
		НовыйКритерий.НесоответствиеНеВыявлено=Значение;
		
	Иначе
		НайденныеСтроки[0].НесоответствиеНеВыявлено=Значение;
	КонецЕсли;	
	ОбъектОбъектНоменклатуры.Записать();
	
	
