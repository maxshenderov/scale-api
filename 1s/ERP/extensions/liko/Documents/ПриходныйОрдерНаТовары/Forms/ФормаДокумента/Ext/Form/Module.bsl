&НаКлиенте
Процедура Лико_ПодписатьДокументПосле(Команда)
	Отказ=Ложь;
	Для каждого Товар Из Объект.Товары Цикл
		Если Не Товар.BRC_Соответствует и НЕ ЗначениеЗаполнено(Товар.BRC_РешениеОПриемке) Тогда
			Отказ=Истина;
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Необходимо указать решение о приемке!";
			Сообщение.Поле = "Объект.Товары["+Товар.ПолучитьИдентификатор()+"].BRC_РешениеОПриемке"; //имя реквизита 
			Сообщение.УстановитьДанные(Объект); //Ссылка на объект ИБ
			Сообщение.Сообщить();
			
			
		КонецЕсли;
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("НесоответствиеНеВыявлено",Ложь);
		
	КонецЦикла;	
	
	Если   Объект.Лико_ПараметрыВходногоКонтроля.НайтиСтроки(СтруктураПоиска).Количество()>0 И
		Не ЗначениеЗаполнено(Объект.BRC_РешениеОПриемке)Тогда
		Отказ=Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Необходимо указать решение о приемке!";
		Сообщение.Поле = "Объект.BRC_РешениеОПриемке"; //имя реквизита 
		Сообщение.УстановитьДанные(Объект); //Ссылка на объект ИБ
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	
	
	Если Не Отказ Тогда	
		ПодписатьДокументНаСервере();
		Закрыть(Истина);
	КонецЕсли;
	
КонецПроцедуры

