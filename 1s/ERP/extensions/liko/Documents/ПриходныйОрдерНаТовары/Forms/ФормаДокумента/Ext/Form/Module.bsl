Процедура УстановитьЗначениеНедастающихКритерив(Серия,КритерииДляУпаковки) //+Лико m.shenderov 16.07.2020
	
	ОбъектОбъектНоменклатуры=Серия.ЯССМ_ОбъектНоменклатуры.ПолучитьОбъект();	
	
	РезультатЗапроса = КритерииДляУпаковки;
	Выборка = РезультатЗапроса.Выбрать();
	ЗаписатьОбъект=ЛОжь;
	Пока Выборка.Следующий() Цикл
		
		Структура = Новый Структура;
		Структура.Вставить("Критерий",Выборка.Критерий);
		Если  ОбъектОбъектНоменклатуры.Лико_ПараметрыВходногоКонтроля.НайтиСтроки(Структура).Количество()=0 ТОгда
			
			НовыйКритерий= ОбъектОбъектНоменклатуры.Лико_ПараметрыВходногоКонтроля.Добавить();
			
			НовыйКритерий.Критерий=Выборка.Критерий;
			
			ЗаписатьОбъект=Истина;
		КонецЕсли;
		
		
	КонецЦикла;
	
	ТзКритериев=РезультатЗапроса.Выгрузить();
	Массив = Новый Массив();
	Для каждого СтрКВК Из ОбъектОбъектНоменклатуры.Лико_ПараметрыВходногоКонтроля Цикл
		Если   ТзКритериев.Найти(СтрКВК.Критерий,"Критерий")=Неопределено Тогда
			ЗаписатьОбъект=Истина;
			Массив.Добавить(СтрКВК);
		КонецЕсли; 	
	КонецЦикла;
	Для каждого Индекс Из Массив Цикл
		ОбъектОбъектНоменклатуры.Лико_ПараметрыВходногоКонтроля.Удалить(Индекс);
	КонецЦикла;
	
	Если ЗаписатьОбъект Тогда
		ОбъектОбъектНоменклатуры.Записать();
	КонецЕсли;
	
	
	
КонецПроцедуры  //-Лико m.shenderov 16.07

