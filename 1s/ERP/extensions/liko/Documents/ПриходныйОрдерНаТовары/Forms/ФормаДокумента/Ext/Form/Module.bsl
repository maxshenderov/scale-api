&НаКлиенте
Процедура Лико_ПересчитатьСуммуИЦену(Тип)
	ТД = Элементы.Товары.ТекущиеДанные;
	
	Если Тип ="Цена" Или Тип ="Количество"  Тогда
		ТД.Лико_Сумма =  ТД.Лико_Цена*Тд.Количество;
	КонецЕсли;
	
	Если Тип ="Сумма" Тогда
		ТД.Лико_Цена =  ТД.Лико_Сумма/Тд.Количество;
	КонецЕсли; 	
	
КонецПроцедуры



