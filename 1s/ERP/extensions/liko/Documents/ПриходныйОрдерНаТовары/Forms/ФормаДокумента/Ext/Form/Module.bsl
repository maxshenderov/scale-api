
&НаКлиенте
Процедура Лико_ТоварыХарактеристикаПриИзмененииПосле(Элемент)
	
	Элементы.Товары.ТекущиеДанные.Серия=Неопределено;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокШтрихКодов,
	"Характеристика",
	Элементы.Товары.ТекущиеДанные.Характеристика,
	ВидСравненияКомпоновкиДанных.Равно,
	,
	Истина);
	
	//+m.shenderov 10.07.2017 
	Лико_СкладыКлиент.ЗаполнениеУпаковкиПоХарактеристики (ЭтаФорма,Элемент);
	КоличествоУпаковокПриИзменении(Элемент);
	//-m.shenderov 10.07.2017	
КонецПроцедуры

&НаКлиенте
Процедура Лико_ТоварыПриНачалеРедактированияПеред(Элемент, НоваяСтрока, Копирование)
	//+m.shenderov 10.07.2017
	//Убиваем серию при коприовании
	Если Копирование Тогда
		Элементы.Товары.ТекущиеДанные.Серия=Неопределено;
		Если   Элементы.Товары.ТекущиеДанные.СтатусУказанияСерий=8 Тогда
			Элементы.Товары.ТекущиеДанные.СтатусУказанияСерий=7;
		КонецЕсли;
		
		
	КонецЕсли;
	//-m.shenderov 10.07.2017
	
	
КонецПроцедуры

&НаКлиенте
&После("ОткрытьПодборСерийЗавершение")
Процедура Лико_ОткрытьПодборСерийЗавершение(Результат, ДополнительныеПараметры)
	
	//+m.shenderov 10.07.2017
	Для каждого Товар Из Объект.Товары Цикл
		Элементы.Товары.ТекущаяСтрока = Товар.ПолучитьИдентификатор();		
		Характеристика=Товар.Характеристика;
		Нарезка=ПолучитьНарезку(Характеристика);
		Если ЗначениеЗаполнено(Нарезка) Тогда
			Упаковка=ПолучитьУпаковку(Нарезка);
			Если ЗначениеЗаполнено(Упаковка) и Элементы.Товары.ТекущиеДанные.Упаковка<>Упаковка Тогда 
				Элементы.Товары.ТекущиеДанные.Упаковка=Упаковка;
				Элементы.Товары.ТекущиеДанные.Количество=0;
				КоличествоУпаковокПриИзменении(Элементы.Товары.ТекущиеДанные);
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 	
	//-m.shenderov 10.07.2017
	
КонецПроцедуры

