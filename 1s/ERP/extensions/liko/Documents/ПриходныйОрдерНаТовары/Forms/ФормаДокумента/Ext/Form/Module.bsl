&НаСервереБезКонтекста
Функция ПолучитьПодборДоговоровСервер(Текст,Распоряжение) //+Лико m.shenderov 18.04.2023
     Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ ПЕРВЫЕ 10
	 |	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	 |ИЗ
	 |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	 |ГДЕ
	 |	ДоговорыКонтрагентов.Контрагент = &Контрагент
	 |	И ДоговорыКонтрагентов.Наименование ПОДОБНО &Наименование
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	ДоговорыКонтрагентов.Дата УБЫВ";
	 Запрос.УстановитьПараметр("Контрагент",Распоряжение.Контрагент );
	 Запрос.УстановитьПараметр("Наименование","%"+Текст+"%" );
	 
Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	 
	    
	
