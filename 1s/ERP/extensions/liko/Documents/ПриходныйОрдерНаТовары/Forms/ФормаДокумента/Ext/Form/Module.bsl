&НаКлиенте
Процедура УстановитьВидимость() //+Лико m.shenderov 05.03.2018
	Если Объект.Лико_Интеркампани Тогда
		Элементы.Лико_ОтражатьВБухгалтерскомУчете.Видимость	=Ложь;
		Элементы.Лико_Интеркампани.Видимость				=Истина;
		Элементы.Лико_РаспоряжениеИнтеркампани.Видимость	=Истина;
	Иначе
		Элементы.Лико_ОтражатьВБухгалтерскомУчете.Видимость	=Истина;
		Элементы.Лико_Интеркампани.Видимость				=Ложь;
		Элементы.Лико_РаспоряжениеИнтеркампани.Видимость	=Ложь;
		
	КонецЕсли; 
	
	Если Лико_ТоварыВПути Тогда
		Элементы.ТоварыГруппаЛикоЦены.Видимость = Истина;
		Элементы.Лико_ВалютаТоваровВПути.Видимость = Истина;
	Иначе
	    Элементы.ТоварыГруппаЛикоЦены.Видимость = Ложь;	
		Элементы.Лико_ВалютаТоваровВПути.Видимость = Ложь;

	КонецЕсли;
	
	
	
	Если Объект.Лико_ОтражатьВБухгалтерскомУчете Тогда
		Элементы.ГруппаЛикоБУ.Видимость=Истина;
	Иначе
		Элементы.ГруппаЛикоБУ.Видимость=Ложь;
	КонецЕсли;
	
	Если BRC Тогда
		Если Объект.Лико_ВидКонтактаСПищевойПродукцией=ПредопределенноеЗначение("Справочник.Лико_ВидыКонтактовСПищевойПродукцией.НетКонтакта") Тогда
			Элементы.BRC_СанитарноеСостояниеТранспорта.Видимость	=Ложь;
			Элементы.BRC_ЗагрязненияВнешнейУпаковки.Видимость		=Ложь;
			Элементы.BRC_ПаллетСоответствуетТребованиям.Видимость	=Ложь; 			
			//ИначеЕсли Объект.Лико_ВидКонтактаСПищевойПродукцией=Справочники.Лико_ВидыКонтактовСПищевойПродукцией.НепрямойКонтакт Тогда
			//ИначеЕсли Объект.Лико_ВидКонтактаСПищевойПродукцией=Справочники.Лико_ВидыКонтактовСПищевойПродукцией.ПрямойКонтакт Тогда
		КонецЕсли; 		
	КонецЕсли;
	Если BRC_Подпись ТОгда
		Элементы.ФормаПровестиИЗакрыть.Видимость=Ложь;
		Элементы.ФормаЗаписать.Видимость=Ложь;
		Элементы.ФормаПровести.Видимость=Ложь;
		Элементы.ФормаПодписатьДокумент.Видимость=Истина;
		Элементы.ФормаПодписатьДокумент.КнопкаПоУмолчанию=Истина;
		Элементы.ГруппаСтраницы.ТекущаяСтраница=Элементы.ГруппаBRC;
		
	Иначе
		
		Элементы.ФормаПровестиИЗакрыть.Видимость=Истина;
		Элементы.ФормаЗаписать.Видимость=Истина;
		Элементы.ФормаПровести.Видимость=Истина;
		Элементы.ФормаПодписатьДокумент.Видимость=Ложь;
		
		
	КонецЕсли;
	
	
КонецПроцедуры //-Лико m.shenderov 05.03.2018

