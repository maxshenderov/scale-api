
&НаСервере
Процедура Лико_ПриСозданииНаСервереВместо(Отказ, СтандартнаяОбработка)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

	Если Объект.ВидОперации  = Перечисления.Лико_ВидыОперацийЗаказОснастки.Перезаказ  И НЕ Лико_Дополнительно.РольДоступнаНаСервере("Лико_ИнженерОснастки")Тогда 
		    
		УстановитьВидимостьПараметров(Ложь,Ложь);
	Иначе
		УстановитьВидимостьПараметров(Истина,Истина);
	КонецЕсли;
	//Если ТипЗнч(ЭтаФорма.Параметры.Основание) = Тип("ДокументСсылка.ЗаказКлиента") И Параметры.Ключ.Пустая() И НЕ Лико_Дополнительно.РольДоступнаНаСервере("Лико_ИнженерОснастки") Тогда
	//	Элементы.ВидОперации.Доступность = Ложь;
	//КонецЕсли;
	
	Если ЗначениеЗаполнено(параметры.ЗначениеКопирования) Тогда 
		Для каждого стр из Объект.Оснастка Цикл
			стр.статус = Перечисления.Лико_СтатусыЗаказовНаОснастку.Создан;	
		КонецЦикла;
	КонецЕсли;	
	Если Не (РольДоступна("ПолныеПрава") ИЛИ  РольДоступна("Лико_ДобавлениеИзменениеЗаказовПоПлощадке") ИЛИ  Лико_Дополнительно.РольДоступнаНаСервере("Лико_ИнженерОснастки")) Тогда 
		Элементы.Комментарий.Доступность = Ложь;
	КонецЕсли;
	Если Не РольДоступна("ПолныеПрава") Тогда
		Элементы.Номер.Доступность = Ложь;
	КонецЕсли;
	
	Если   Не РольДоступна("ПолныеПрава") И  УправлениеДоступом.ЕстьРоль("Лико_Разработчик3dМоделей") Тогда
		 УстановитьВидемостьДляРазработчика3dМоделей();
	КонецЕсли;
	
	
	ДобавитьУсловноеОформление();
	ОбновитьЗаголовокДлинаШирина();

КонецПроцедуры

