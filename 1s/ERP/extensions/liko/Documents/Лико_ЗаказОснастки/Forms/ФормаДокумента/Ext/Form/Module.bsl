&НаСервере
Функция СформироватьПараметрыОткрытияДляПечатнойФормыВБЗ(Заказ)
	
	Обработка = Лико_Дополнительно.НайтиДополнительнуюОбработкуПоИмениОбъекта("ВнутреннийБланкЗаказаЕРП");
	Если НЕ ЗначениеЗаполнено(Обработка) Тогда
		Сообщить("В системе не зарегистрирована печатная форма с именем объекта ""ВнутреннийБланкЗаказаЕРП""");
		Возврат Неопределено;
	КонецЕсли;
	Если Обработка.Команды.Количество() = 0 Тогда
		Сообщить("В печатной форме ""ВнутреннийБланкЗаказаЕРП"" не найдено команд печати.");
		Возврат Неопределено;
	КонецЕсли;
	
	//Команда = Обработка.Команды.Найти(Перечисления.СпособыВызоваДополнительныхОбработок.ВызовСерверногоМетода, "ВариантЗапуска");
	//Если Команда = Неопределено Тогда
	
	ИдентификаторКоманды = Обработка.Команды[0].Идентификатор;
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Заказ);
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ИсточникДанных", Обработка);
	ПараметрыОткрытия.Вставить("ПараметрыИсточника", Новый Структура("ИдентификаторКоманды,ОбъектыНазначения,НеПечататьСразуНаПринтер", ИдентификаторКоманды, МассивОбъектов,Истина));
	ПараметрыОткрытия.Вставить("ПараметрыПечати", Неопределено);

	Возврат ПараметрыОткрытия;	
	
КонецФункции

