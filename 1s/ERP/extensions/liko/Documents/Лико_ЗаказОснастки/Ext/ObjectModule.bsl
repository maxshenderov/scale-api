			|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
			|		ЛЕВОЕ СОЕДИНЕНИЕ ТабЦветов КАК ТабЦветов
			|		ПО ЗаказКлиентаВидыРабот.Ссылка = ТабЦветов.Заказ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Ном
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыШтампа КАК Лико_ПараметрыШтампа
			|			ПО Ном.Ссылка = Лико_ПараметрыШтампа.Номенклатура
			|		ПО ЗаказКлиентаВидыРабот.Оснастка.Артикул = Ном.Артикул
			|			И (ЗаказКлиентаВидыРабот.Оснастка.Артикул = Ном.Артикул)
			|			И (Ном.Наименование ПОДОБНО ""%Контрматрица%"")
			|ГДЕ
			|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ
			|	И (ЗаказКлиентаВидыРабот.Оснастка <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
			|			ИЛИ ЗаказКлиентаВидыРабот.ЗаказНовойОснастки = ИСТИНА)";
			

			
			Запрос.УстановитьПараметр("Заказ", Заказ);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				стр = Оснастка.Добавить();
				стр.Статус = Перечисления.Лико_СтатусыЗаказовНаОснастку.Создан;
				ЗаполнитьЗначенияСвойств(стр, Выборка);
				стр.количество = 1;
				стр.ВидШтампа = Выборка.ВидРабот;
				КлючСтроки = Новый УникальныйИдентификатор;
				стр.ключстроки = КлючСтроки;
				Для каждого стрНом Из ТЗНом Цикл
					стрЭт = Этикетки.Добавить();
					стрЭт.Этикетка = СтрНом.Номенклатура;
					стрЭт.КлючСтроки = стр.ключСтроки;
				КонецЦикла;
				
				Если Выборка.ЗаказНовойОснастки Тогда 
					ВидОперации = Перечисления.Лико_ВидыОперацийЗаказОснастки.Новый;
				ИначеЕсли ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
					ВидОперации = Перечисления.Лико_ВидыОперацийЗаказОснастки.Перезаказ;
				КонецЕсли;
				
				Если Выборка.Количество()>1 Тогда
					ВидОперации = Перечисления.Лико_ВидыОперацийЗаказОснастки.Перезаказ;
				КонецЕсли;
			КонецЦикла;	
