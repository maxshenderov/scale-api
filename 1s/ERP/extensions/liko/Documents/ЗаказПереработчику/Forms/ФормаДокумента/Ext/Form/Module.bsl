&НаКлиенте
Функция ПриВвводеРоликовПродукция(Таблица) //+Лико m.shenderov 14.12.2017 
	
	Нарезка=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Элементы[Таблица].ТекущиеДанные.Характеристика,"ЯССМ_Нарезка");
	
	Если Нарезка <> ПредопределенноеЗначение("Справочник.ЯССМ_Нарезки.ПустаяСсылка") Тогда
		
		Если Не ЗначениеЗаполнено(Элементы[Таблица].ТекущиеДанные.Лико_Втулка) Тогда
			 Элементы[Таблица].ТекущиеДанные.Лико_Втулка=ВтулкаСервер76();
		КонецЕсли;
		
		
		КоличествоПГ = 0;
		КоличествоКВ = (Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Нарезка,"Размер")/1000) *
		Элементы[Таблица].ТекущиеДанные.Лико_Намотка * 
		Элементы[Таблица].ТекущиеДанные.Лико_КолРоликов;
		
		Элементы[Таблица].ТекущиеДанные.КоличествоУпаковок = КоличествоКВ; 	
		Если Таблица="Продукция" Тогда
		ПродукцияКоличествоУпаковокПриИзменении("ПриВвводеРоликов");
			Иначе
		 МатериалыКоличествоУпаковокПриИзменении("ПриВвводеРоликов"); 

		КонецЕсли;
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции  //-Лико m.shenderov 14.12.2017

