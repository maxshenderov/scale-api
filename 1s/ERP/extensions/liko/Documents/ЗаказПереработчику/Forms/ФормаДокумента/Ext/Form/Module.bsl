&НаСервереБезКонтекста
Функция ВтулкаСервер76() //+Лико m.shenderov 15.12.2017
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Лико_Втулки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Лико_Втулки КАК Лико_Втулки
	|ГДЕ
	|	Лико_Втулки.Размер = 76";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	 Выборка = РезультатЗапроса.Выбрать();
	 Пока Выборка.Следующий() Цикл
	     Возврат Выборка.Ссылка;
	 КонецЦикла; 
	
КонецФункции  //-Лико m.shenderov 15.12.2017

