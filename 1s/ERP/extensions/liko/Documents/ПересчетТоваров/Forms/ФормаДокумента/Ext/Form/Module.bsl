Процедура ЗаполнитьТоварыПоОбъектНоменклатурыНаСервере() //+Лико m.shenderov 15.05.2020
	Для каждого Товар Из Объект.Товары Цикл
		
		
		Товар.BRC_ВидКонтактаСПищевойПродукцией=Товар.Серия.ЯССМ_ОбъектНоменклатуры.ВидКонтактаСПищевойПродукцией;
		Товар.BRC_НомерПартииИзготовления=Товар.Серия.ЯССМ_ОбъектНоменклатуры.НомерПартииИзготовления;;
		Товар.BRC_ДатаПроизводства=Товар.Серия.ЯССМ_ОбъектНоменклатуры.ДатаПроизводства;;
		Товар.BRC_УпотребитьДо=Товар.Серия.ЯССМ_ОбъектНоменклатуры.УпотребитьДо;;
		
	КонецЦикла;
	
КонецПроцедуры  //-Лико m.shenderov 15.05.2020

&НаКлиенте
Процедура Лико_ТоварыBRC_ДатаПроизводстваПриИзмененииПосле(Элемент)
	ТН=Элементы.Товары.ТекущиеДанные;
	СрокКодности=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Элементы.Товары.ТекущиеДанные.Номенклатура,"Лико_СрокГодности");
	Если   ЗначениеЗаполнено(СрокКодности) Тогда
		ТН.BRC_УпотребитьДо=ТН.BRC_ДатаПроизводства+СрокКодности*24*60*60;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Лико_ТоварыКоличествоУпаковокФактПриИзмененииВместо(Элемент)
	ТД=Элементы.Товары.ТекущиеДанные;
	ТД.КоличествоФакт=ТД.КоличествоУпаковокФакт*Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТД.Упаковка,"Числитель");
КонецПроцедуры

&НаКлиенте
Процедура Лико_ТоварыВыборПосле(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
		ТД = Элементы.Товары.ТекущиеДанные;

	Если Поле.Имя="ТоварыПартияПроизводства" Тогда
		Структура=ЗаполнитьСтруктуруДляПартииПроизводстваСервер(ТД.Серия);
		
		Если ЗначениеЗаполнено(Структура) Тогда
			ОписаниеОповещения= Новый ОписаниеОповещения("ТоварыПартияПроизводстваЗавершение",ЭтаФорма);
			ОткрытьФорму("Справочник.ЯССМ_ОбъектыНоменклатуры.Форма.ФормаЭлементаПрослеживаемость",Структура,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

 &НаКлиенте
Процедура ТоварыПартияПроизводстваЗавершение(Результат,Параметры)Экспорт  //+Лико m.shenderov 27.03.2023
	
	ТД=Элементы.Товары.ТекущиеДанные;
	
	ТД.ПартияПроизводства=СформироватьИмяПартииСервер(Тд.Номенклатура,Тд.Серия,ПрослеживаемостьТоваров);
	
КонецПроцедуры //-Лико m.shenderov 27.03.2023

&НаСервереБезКонтекста
Функция СформироватьИмяПартииСервер(Номенклатура,Серия,ПрослеживаемостьТоваров) //+Лико m.shenderov 27.03.2023
		Возврат  Справочники.Лико_КонтрольПартийПоризводстваНоменклатуры.СформироватьИмяПартии(Номенклатура,Серия,ПрослеживаемостьТоваров);	
КонецФункции  //-Лико m.shenderov 27.03.2023

 &НаСервереБезКонтекста
Функция ЗаполнитьСтруктуруДляПартииПроизводстваСервер(Серия) //+Лико m.shenderov 27.03.2023
	
	Если ЗначениеЗаполнено(Серия) Тогда
		
		ОН=Серия.ЯССМ_ОбъектНоменклатуры;
		
		Если ОН.Уникальный И ОН.Номенклатура.Лико_КонтрольПартииПроизводстваТовара  Тогда 
			
		Структура = Новый Структура;
		Структура.Вставить("Ключ",Он);
			
		 Возврат Структура;
		
		КонецЕсли;
		
		
	КонецЕсли;
	
	
	
КонецФункции  //-Лико m.shenderov 27.03.2023


&НаСервере
&После("ЗаполнитьСлужебныеРеквизитыПоНоменклатуре")
Процедура Лико_ЗаполнитьСлужебныеРеквизитыПоНоменклатуре()
	Лико_ЗаполнитьРеквизитыПрослеживаемости();
КонецПроцедуры

&НаСервере
Процедура Лико_ЗаполнитьРеквизитыПрослеживаемости() //+Лико m.shenderov 29.03.2023
	
	Если Не ПрослеживаемостьТоваров Тогда
		Возврат;
	КонецЕсли;
	
	Возврат;
	
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		
			
			СтрокаТЧ.ПартияПроизводства=СформироватьИмяПартииСервер(СтрокаТЧ.Номенклатура,СтрокаТЧ.Серия,ПрослеживаемостьТоваров);
			
				
	КонецЦикла;

	
КонецПроцедуры  //-Лико m.shenderov 29.03.2023


&НаКлиенте
Процедура Лико_ПередЗаписьюВместо(Отказ, ПараметрыЗаписи)
	//+ ---> Лико m.shenderov 29.04.2022
	Если Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Объект.Склад,"Лико_ТипСклада")=ПредопределенноеЗначение("Перечисление.Лико_ТипСклада.СИМ")
		Или Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Объект.Склад,"Лико_ТипСклада")=ПредопределенноеЗначение("Перечисление.Лико_ТипСклада.Производство")Тогда
		ВыполняетсяЗапись = Истина;
	КонецЕсли;

	//- <--- Лико m.shenderov 29.04.2022
	
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Не Объект.УчетныеДанныеЗаполнены 
		И Объект.Товары.Количество() > 0
		И Не Отказ
		И НЕ ВыполняетсяЗапись Тогда
		
		ТекстВопроса = НСтр("ru = 'При проведении будет перезаполнено учетное количество во всех строках табличной части. Продолжить?';
							|en = 'Accounting quantity will be refilled in all rows of the table while posting. Continue?'");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗаписьюЗавершение", ЭтотОбъект), 
			ТекстВопроса,
			РежимДиалогаВопрос.ОКОтмена,
			,
			КодВозвратаДиалога.ОК);
		Отказ = Истина;
		
	КонецЕсли;
	

КонецПроцедуры


&НаКлиенте
&Вместо("Лико_ПечатьЭтикетокБирок")
Процедура Лико_Лико_ПечатьЭтикетокБирок(Команда)

		
	Для каждого Данные Из ЭтаФорма.Элементы.Товары.ВыделенныеСтроки Цикл 
		ТекДанные = Объект.Товары.НайтиПоИдентификатору(Данные);
		Лико_ДополнительноКлиент.ПечатьЯрлыкаОбъектаНоменклатуры(Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ТекДанные.Серия,"ЯССМ_ОбъектНоменклатуры"));
		
	КонецЦикла;

	

КонецПроцедуры

