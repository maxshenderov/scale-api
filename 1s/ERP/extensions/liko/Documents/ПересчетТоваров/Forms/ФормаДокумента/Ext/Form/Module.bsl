Процедура ДобавитьРедактироватьСерию(ОбъектНоменклатуры,Количество) //+Лико m.shenderov 10.01.2018
	//ДокументОбъект=ДокументИнвентаризации.ПолучитьОбъект();
	//ДокТовары=ДокументОбъект.Товары;
	//Для каждого Товар Из Товары Цикл
	Структура = Новый Структура;
	Структура.Вставить("Номенклатура",ОбъектНоменклатуры.Номенклатура);
	Структура.Вставить("Характеристика",ОбъектНоменклатуры.Характеристика);
	Структура.Вставить("Серия",ОбъектНоменклатуры.Серия);
	Структура.Вставить("КоличествоУпаковок",0);
	НайденныеСтроки=Объект.Товары.НайтиСтроки(Структура);
	Для каждого НСтр Из  НайденныеСтроки Цикл
		Объект.Товары.Удалить(НСтр);			
	КонецЦикла;
	
	
	Если  ОбъектНоменклатуры.Уникальный Тогда	
		Структура = Новый Структура;
		Структура.Вставить("Номенклатура",ОбъектНоменклатуры.Номенклатура);
		Структура.Вставить("Характеристика",ОбъектНоменклатуры.Характеристика);
		Структура.Вставить("Серия",ОбъектНоменклатуры.Серия);
		//Структура.Вставить("Ячейка",Товар.Ячейка);
		
		НайденныеСтроки=Объект.Товары.НайтиСтроки(Структура);
		Если  НайденныеСтроки.Количество()>0 Тогда
			СтрокаРедактирования=НайденныеСтроки[0];
			
			СтрокаРедактирования.КоличествоУпаковокФакт	=ОбъектНоменклатуры.Количество; 
			СтрокаРедактирования.КоличествоФакт			=ОбъектНоменклатуры.Количество*ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель;
			СтрокаРедактирования.Лико_ЯчейкаФакт		=ТекущаяЯчейка;
			
			
		Иначе
			СтрокаРедактирования					=Объект.Добавить();
			СтрокаРедактирования.Номенклатура		=ОбъектНоменклатуры.Номенклатура;
			СтрокаРедактирования.Характеристика		=ОбъектНоменклатуры.Характеристика;
			СтрокаРедактирования.Серия				=ОбъектНоменклатуры.Серия;
			СтрокаРедактирования.Упаковка			=ОбъектНоменклатуры.БазоваяЕдиницаИзмерения;
			СтрокаРедактирования.Лико_ЯчейкаФакт	=ТекущаяЯчейка;
			СтрокаРедактирования.СтатусУказанияСерий=8;
			СтрокаРедактирования.Ячейка         		=ПолучитьАдресХранения(Объект.Дата,Структура);
			
			
			СтрокаРедактирования.КоличествоУпаковокФакт	=ОбъектНоменклатуры.Количество; 
			СтрокаРедактирования.КоличествоФакт			=ОбъектНоменклатуры.Количество*ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель;
			
			СтрокаРедактирования.КоличествоУпаковок	=СтрокаРедактирования.КоличествоУпаковокФакт; 
			СтрокаРедактирования.Количество			=СтрокаРедактирования.КоличествоФакт; 
		КонецЕсли;	
		СтруктураДействий = Новый Структура;
		
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокФакт(СтруктураДействий);
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаРедактирования, СтруктураДействий, Неопределено);
	Иначе
		
		
		
		
		Структура = Новый Структура;
		Структура.Вставить("Номенклатура",ОбъектНоменклатуры.Номенклатура);
		Структура.Вставить("Характеристика",ОбъектНоменклатуры.Характеристика);
		Структура.Вставить("Серия",ОбъектНоменклатуры.Серия);
		Структура.Вставить("Ячейка",ТекущаяЯчейка);
		
		НайденныеСтроки=Объект.Товары.НайтиСтроки(Структура);
		Если  НайденныеСтроки.Количество()>0 Тогда
			СтрокаРедактирования=НайденныеСтроки[0];
			
			СтрокаРедактирования.КоличествоУпаковокФакт	=Количество; 
			СтрокаРедактирования.КоличествоФакт			=Количество*ОбъектНоменклатуры.БазоваяЕдиницаИзмерения.Числитель;
			СтрокаРедактирования.Лико_ЯчейкаФакт	    =ТекущаяЯчейка;
			
			
			
		Иначе
			СтрокаРедактирования					=Объект.Товары.Добавить();
			СтрокаРедактирования.Номенклатура		=ОбъектНоменклатуры.Номенклатура;
			СтрокаРедактирования.Характеристика		=ОбъектНоменклатуры.Характеристика;
			СтрокаРедактирования.Серия				=ОбъектНоменклатуры.Серия;
			СтрокаРедактирования.Упаковка			=ОбъектНоменклатуры.БазоваяЕдиницаИзмерения;
			СтрокаРедактирования.Лико_ЯчейкаФакт	=ТекущаяЯчейка;
			СтрокаРедактирования.СтатусУказанияСерий=8;									
			СтрокаРедактирования.КоличествоУпаковокФакт	=0; 
			СтрокаРедактирования.КоличествоФакт			=0;
			
		КонецЕсли;
		
		
		СтруктураДействий = Новый Структура;
		
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокФакт(СтруктураДействий);
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаРедактирования, СтруктураДействий, Неопределено);
		
		
	КонецЕсли;	
	
	
	
	
	
КонецПроцедуры //-Лико m.shenderov 10.01.2018

&НаКлиенте
Процедура вводКоличестваЗавершение(Число,Параметры) Экспорт //+Лико m.shenderov 23/01/2020
	Если Число<>Неопределено ТОгда
		ДобавитьРедактироватьСерию(Параметры,Число);
		
		
	КонецЕсли;
	
	
КонецПроцедуры //-Лико m.shenderov 23/01/2020



&НаСервере
Функция ПолучитьАдресХранения(Дата,Структура) //+Лико m.shenderov 26.12.2018  
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварыВЯчейкахОстатки.Ячейка КАК Ячейка
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			&Период,
	|			Номенклатура = &Номенклатура
	|				И Характеристика = &Характеристика
	|				И Серия = &Серия) КАК ТоварыВЯчейкахОстатки";
	Запрос.УстановитьПараметр("Период",Дата);
	Запрос.УстановитьПараметр("Номенклатура",Структура.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика",Структура.Характеристика);
	Запрос.УстановитьПараметр("Серия",Структура.Серия);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ячейка;
	КонецЦикла; 
	
КонецФункции  //-Лико m.shenderov 26.12.2018

