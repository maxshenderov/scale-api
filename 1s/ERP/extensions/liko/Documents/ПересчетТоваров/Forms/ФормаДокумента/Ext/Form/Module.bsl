Процедура Расш_Л_ОбработатьШтрихкоды(ДанныеШтрихкода)
	//Элементы.ТекстСообщения.Заголовок="";
	//Если ТекущаяСтрока = Неопределено Тогда
	//	ТекущиеДанные = Неопределено;
	//Иначе
	//	ТекущиеДанные = Объект.Товары.НайтиПоИдентификатору(ТекущаяСтрока);
	//КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяЯчейка) Тогда
		Сообщить("Не заполнена ячейка!");
		
		Возврат;
	КонецЕсли;
	
	Результат = Лико_ДополнительноКлиент.ОбработатьШтрихКодНеТовара(ДанныеШтрихкода[0].Штрихкод);
	Если Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Адреса")
		ИЛИ Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Адреса_Короткий") Тогда
		//Это ячейка
		ТекущаяЯчейка = Результат.АдресаХранения;
	ИначеЕсли Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры_Короткий") Или 
		Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры") Тогда
		
		Если Не ЗначениеЗаполнено(ТекущаяЯчейка) Тогда
			Сообщить("Не заполнена ячейка!");
			Возврат;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Результат.ОбъектНоменклатуры) Тогда
			
			Сообщить("Штрих код не найден! "+ Результат.ШК);
			Возврат;	
		КонецЕсли;
		
		ОбработатьНоменклатуру(Результат);
		
	ИначеЕсли Результат.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Сотрудника") Тогда
		//Это физ. лицо
		АвторДокумента = Результат.Сотрудник;
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраница1;
	Иначе
		
		Сообщить("Штрих код не найден! ");
		
	КонецЕсли;
	
КонецПроцедуры

