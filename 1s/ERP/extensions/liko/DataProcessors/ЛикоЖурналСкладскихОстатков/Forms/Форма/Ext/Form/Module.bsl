
&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные=Элементы.Список.ТекущиеДанные;
	Если ТекДанные<> Неопределено Тогда
		Регистратор=ТекДанные.Регистратор;
		
		Если ЗначениеЗаполнено(Регистратор) Тогда
			ИмяДокумента= ВернутьИмяРегистратораСервер(Регистратор) ;
			Структура = Новый Структура;
			Структура.Вставить("Ключ",Регистратор);
			ОткрытьФорму("Документ."+ИмяДокумента+".Форма.ФормаДокумента",Структура,,,,,,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			
		КонецЕсли;
		
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВернутьИмяРегистратораСервер(Регистратор) //+Лико m.shenderov 17.12.2017  
	//Регистратор=Документы.ПриходныйКассовыйОрдер.НайтиПоНомеру();
	Возврат Регистратор.Метаданные().Имя;
	
КонецФункции  //-Лико m.shenderov 17.12.2017



&НаСервере
Процедура СформироватьНаСервере() //+Лико m.shenderov 17.12.2017
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыВЯчейкахОбороты.Регистратор КАК Регистратор,
	|	ВЫБОР
	|		КОГДА ТоварыВЯчейкахОбороты.Регистратор ССЫЛКА Документ.ПриходныйОрдерНаТовары
	|			ТОГДА ""Поступление товаров""
	|		КОГДА ТоварыВЯчейкахОбороты.Регистратор ССЫЛКА Документ.Лико_БланкЭтапа
	|			ТОГДА ""Закрытие заказа""
	|		КОГДА ТоварыВЯчейкахОбороты.Регистратор ССЫЛКА Документ.Лико_ПередачаТоваров
	|			ТОГДА ТоварыВЯчейкахОбороты.Регистратор.ВидОперации
	|		КОГДА ТоварыВЯчейкахОбороты.Регистратор ССЫЛКА Документ.Лико_ВозвратТоваров
	|			ТОГДА ТоварыВЯчейкахОбороты.Регистратор.ВидОперации
	|		КОГДА ТоварыВЯчейкахОбороты.Регистратор ССЫЛКА Документ.РасходныйОрдерНаТовары
	|			ТОГДА ""Расход товаров""
	|		КОГДА ТоварыВЯчейкахОбороты.Регистратор ССЫЛКА Документ.ПересчетТоваров
	|			ТОГДА ""Пересчет товаров""
	|		КОГДА ТоварыВЯчейкахОбороты.Регистратор ССЫЛКА Документ.ОтборРазмещениеТоваров
	|			ТОГДА ""Перемещение товаров""
	|	КОНЕЦ КАК ВидОперации,
	|	ТоварыВЯчейкахОбороты.Регистратор.Дата КАК Дата,
	|	ТоварыВЯчейкахОбороты.Регистратор.Номер КАК Номер,
	|	ТоварыВЯчейкахОбороты.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОбороты.Упаковка КАК ЕдИзм,
	|	ВЫБОР
	|		КОГДА ТоварыВЯчейкахОбороты.ВНаличииРасход = 0
	|			ТОГДА ТоварыВЯчейкахОбороты.ВНаличииПриход
	|		КОГДА ТоварыВЯчейкахОбороты.ВНаличииПриход = 0
	|			ТОГДА ТоварыВЯчейкахОбороты.ВНаличииРасход
	|		КОГДА ТоварыВЯчейкахОбороты.ВНаличииПриход = ТоварыВЯчейкахОбороты.ВНаличииРасход
	|			ТОГДА ТоварыВЯчейкахОбороты.ВНаличииПриход
	|		ИНАЧЕ -99999
	|	КОНЕЦ КАК Количество,
	|	ТоварыВЯчейкахОбороты.Номенклатура.ЕдиницаИзмерения КАК ЕдИзмУУ,
	|	ВЫБОР
	|		КОГДА ТоварыВЯчейкахОбороты.ВНаличииРасход = 0
	|			ТОГДА ТоварыВЯчейкахОбороты.ВНаличииПриход * ТоварыВЯчейкахОбороты.Упаковка.Числитель
	|		КОГДА ТоварыВЯчейкахОбороты.ВНаличииПриход = 0
	|			ТОГДА ТоварыВЯчейкахОбороты.ВНаличииРасход * ТоварыВЯчейкахОбороты.Упаковка.Числитель
	|		КОГДА ТоварыВЯчейкахОбороты.ВНаличииПриход = ТоварыВЯчейкахОбороты.ВНаличииРасход
	|			ТОГДА ТоварыВЯчейкахОбороты.ВНаличииПриход * ТоварыВЯчейкахОбороты.Упаковка.Числитель
	|		ИНАЧЕ -99999
	|	КОНЕЦ КАК КоличествоУУ,
	|	ТоварыВЯчейкахОбороты.Серия.ЯССМ_ОбъектНоменклатуры.Нарезка КАК Нарезка,
	|	ТоварыВЯчейкахОбороты.Серия.ЯССМ_ОбъектНоменклатуры.Втулка КАК Втулка,
	|	ТоварыВЯчейкахОбороты.Серия.ЯССМ_ОбъектНоменклатуры.НомерПоставки КАК НомерПоставки,
	|	ТоварыВЯчейкахОбороты.Номенклатура.Наименование КАК Наименование,
	|	ТоварыВЯчейкахОбороты.Номенклатура.Артикул КАК Артикул,
	|	ТоварыВЯчейкахОбороты.Номенклатура.Код КАК Код,
	|	ВЫБОР
	|		КОГДА ТоварыВЯчейкахОбороты.Регистратор ССЫЛКА Документ.Лико_БланкЭтапа
	|			ТОГДА ТоварыВЯчейкахОбороты.Регистратор.ЗаказПокупателя
	|		КОГДА ТоварыВЯчейкахОбороты.Регистратор ССЫЛКА Документ.Лико_ПередачаТоваров
	|			ТОГДА ТоварыВЯчейкахОбороты.Регистратор.ЗаказКлиента
	|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ЗаказКлиента.Пустаяссылка)
	|	КОНЕЦ КАК Заказ,
	|	ТоварыВЯчейкахОбороты.Регистратор.АвторДокумента КАК АвторДокумента,
	|	ТоварыВЯчейкахОбороты.Регистратор.Сотрудник КАК Сотрудник
	|ПОМЕСТИТЬ Вт
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Обороты(&ДатаНачала, &ДатаОкончания, Запись, ) КАК ТоварыВЯчейкахОбороты
	|ГДЕ
	|	ТоварыВЯчейкахОбороты.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ВЫБОР
	|			КОГДА &ФильтрПоНоменклатуре
	|				ТОГДА ТоварыВЯчейкахОбороты.Номенклатура = &Номенклатура
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ФильтрПоНомеруПоставки
	|				ТОГДА ТоварыВЯчейкахОбороты.Серия.ЯССМ_ОбъектНоменклатуры.НомерПоставки = &НомерПоставки
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ФильтрПоНарезке
	|				ТОГДА ТоварыВЯчейкахОбороты.Серия.ЯССМ_ОбъектНоменклатуры.Нарезка = &Нарезка
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ФильтрПоВтулки
	|				ТОГДА ТоварыВЯчейкахОбороты.Серия.ЯССМ_ОбъектНоменклатуры.Втулка = &Втулка
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ФильтрПоРабочемуЦентру
	|				ТОГДА ТоварыВЯчейкахОбороты.Ячейка = &РабочийЦентр
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И (ТоварыВЯчейкахОбороты.Ячейка.Помещение.Лико_Организация = &Организация
	|			ИЛИ ТоварыВЯчейкахОбороты.Ячейка.Помещение = ЗНАЧЕНИЕ(Справочник.СкладскиеПомещения.Пустаяссылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Вт.Регистратор КАК Регистратор,
	|	Вт.ВидОперации КАК ВидОперации,
	|	Вт.Дата КАК Дата,
	|	Вт.Номер КАК Номер,
	|	Вт.Номенклатура КАК Номенклатура,
	|	Вт.ЕдИзм КАК ЕдИзм,
	|	Вт.Количество КАК Количество,
	|	Вт.ЕдИзмУУ КАК ЕдИзмУУ,
	|	Вт.КоличествоУУ КАК КоличествоУУ,
	|	Вт.Нарезка КАК Нарезка,
	|	Вт.Втулка КАК Втулка,
	|	Вт.НомерПоставки КАК НомерПоставки,
	|	Вт.Наименование КАК Наименование,
	|	Вт.Артикул КАК Артикул,
	|	Вт.Код КАК Код,
	|	Вт.Заказ КАК Заказ,
	|	Вт.АвторДокумента КАК АвторДокумента,
	|	Вт.Сотрудник КАК Сотрудник
	|ИЗ
	|	Вт КАК Вт
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ФильтрПоЗаказу
	|				ТОГДА Вт.Заказ = &НомерЗаказаКлиента
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	Запрос.УстановитьПараметр("ДатаНачала",ДатаНачала );
	Запрос.УстановитьПараметр("ДатаОкончания",КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ФильтрПоНоменклатуре",ЗначениеЗаполнено(Номенклатура));
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	
	Запрос.УстановитьПараметр("ФильтрПоНомеруПоставки",ЗначениеЗаполнено(НомерПоставки));
	Запрос.УстановитьПараметр("НомерПоставки",НомерПоставки);
	
	
	Запрос.УстановитьПараметр("ФильтрПоНарезке",ЗначениеЗаполнено(Нарезка));
	Запрос.УстановитьПараметр("Нарезка",Нарезка);  	
	
	Запрос.УстановитьПараметр("ФильтрПоВтулки",ЗначениеЗаполнено(Втулка));
	Запрос.УстановитьПараметр("Втулка",Втулка);
	
	Запрос.УстановитьПараметр("ФильтрПоРабочемуЦентру",ЗначениеЗаполнено(РабочийЦентр));
	Запрос.УстановитьПараметр("РабочийЦентр",РабочийЦентр.ЛикоЯчейка);
	
	Запрос.УстановитьПараметр("ФильтрПоЗаказу",ЗначениеЗаполнено(ЗаказКлиента));
	Запрос.УстановитьПараметр("НомерЗаказаКлиента",ЗаказКлиента);
	Запрос.УстановитьПараметр("Организация",Организация);

	
	
	
	Список.Загрузить( Запрос.Выполнить().Выгрузить());
	
	КоличествоСписок=Список.Количество();

	СписокПартии.Очистить();  
	КоличествоПартии=0;
	Если ЗначениеЗаполнено(НомерПоставки) Тогда
		 СформироватьПартииСервер()
	КонецЕсли;
	
КонецПроцедуры  //-Лико m.shenderov 17.12.2017

&НаСервере
Процедура СформироватьПартииСервер() //+Лико m.shenderov 29.05.2023
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЯССМ_ОбъектыНоменклатуры.Ссылка КАК ОбъектНоменклатуры,
	|	ЯССМ_ОбъектыНоменклатуры.НомерПартииИзготовления КАК НомерПартииИзготовления,
	|	ЯССМ_ОбъектыНоменклатуры.ПричинаОтсутствияНомераПартииИзготовления КАК ПричинаОтсутствияНомераПартииИзготовления,
	|	ЯССМ_ОбъектыНоменклатуры.ПричинаОтсутствияДатыИзготовления КАК ПричинаОтсутствияДатыИзготовления,
	|	ЯССМ_ОбъектыНоменклатуры.УпотребитьДо КАК УпотребитьДо,
	|	ЯССМ_ОбъектыНоменклатуры.ДатаПроизводства КАК ДатаПроизводства,
	|	ЯССМ_ОбъектыНоменклатуры.ПриходныйОрдер КАК ПриходныйОрдер,
	|	ЯССМ_ОбъектыНоменклатуры.ЗакрытиеБланка КАК ЗакрытиеБланка
	|ИЗ
	|	Справочник.ЯССМ_ОбъектыНоменклатуры КАК ЯССМ_ОбъектыНоменклатуры
	|ГДЕ
	|	ЯССМ_ОбъектыНоменклатуры.НомерПоставки = &НомерПоставки
	|	И ЯССМ_ОбъектыНоменклатуры.Номенклатура = &Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Лико_ПартииПроизводства.ПартияОбъектНоменклатуры,
	|	Лико_ПартииПроизводства.ПартияОбъектНоменклатуры.НомерПартииИзготовления,
	|	Лико_ПартииПроизводства.ПартияОбъектНоменклатуры.ПричинаОтсутствияНомераПартииИзготовления,
	|	Лико_ПартииПроизводства.ПартияОбъектНоменклатуры.ПричинаОтсутствияДатыИзготовления,
	|	Лико_ПартииПроизводства.ПартияОбъектНоменклатуры.УпотребитьДо,
	|	Лико_ПартииПроизводства.ПартияОбъектНоменклатуры.ДатаПроизводства,
	|	Лико_ПартииПроизводства.ПартияОбъектНоменклатуры.ПриходныйОрдер,
	|	Лико_ПартииПроизводства.ПартияОбъектНоменклатуры.ЗакрытиеБланка
	|ИЗ
	|	РегистрСведений.Лико_ПартииПроизводства КАК Лико_ПартииПроизводства
	|ГДЕ
	|	Лико_ПартииПроизводства.Серия.ЯССМ_ОбъектНоменклатуры.Номенклатура = &Номенклатура
	|	И Лико_ПартииПроизводства.Серия.ЯССМ_ОбъектНоменклатуры.НомерПоставки = &НомерПоставки";
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура );
	Запрос.УстановитьПараметр("НомерПоставки",НомерПоставки ); 
	
	СписокПартии.Загрузить(Запрос.Выполнить().Выгрузить());
	КоличествоПартии=СписокПартии.Количество();
КонецПроцедуры  //-Лико m.shenderov 29.05.2023



&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма); 
	ДатаНачала=НачалоГода(ТекущаяДата());
	ДатаОкончания=КонецДня(КонецГода(ТекущаяДата()));
	Структура = Новый Структура;
	Лико_ОбщегоНазначенияСервер.РеквизитыШапки(Структура);
	ЗаполнитьЗначенияСвойств(ЭтаФорма,Структура);
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
	МенеджерОборудованияКлиентПереопределяемый.НачатьПодключениеОборудованиеПриОткрытииФормы(ЭтаФорма, "СканерШтрихкода");
	
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	// ПодключаемоеОборудование
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" Тогда
			ОбработатьШтрихкоды(ПодключаемоеОборудованиеУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр));
		КонецЕсли;
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
	
КонецПроцедуры


