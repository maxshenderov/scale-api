&НаСервереБезКонтекста
Процедура СоздатьРедактироватьДокументПодготовки(Знач Структура)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Лико_ПодготовкаМатериалов.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лико_ПодготовкаМатериалов КАК Лико_ПодготовкаМатериалов
	|ГДЕ
	|	Лико_ПодготовкаМатериалов.ЗаказКлиента = &ЗаказКлиента
	|	И Лико_ПодготовкаМатериалов.НомерПроката = &НомерПроката";
	Запрос.УстановитьПараметр("ЗаказКлиента",Структура.ЗаказКлиента );
	Запрос.УстановитьПараметр("НомерПроката",Структура.НомерПроката );
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Документ=Документы.Лико_ПодготовкаМатериалов.СоздатьДокумент();
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий(); 		
		Документ=Выборка.Ссылка.ПолучитьОбъект();
		Документ.ПометкаУдаления=Ложь;  
	КонецЕсли;  
	
	
	
	Документ.Дата=ТекущаяДата();
	Документ.Заполнить(Структура);
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

