&НаСервере
Процедура ЕстьФорма(Док) //+Лико m.shenderov 18.05.2018
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лико_ПодготовкаМатериалов.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Лико_ПодготовкаМатериалов КАК Лико_ПодготовкаМатериалов
	|ГДЕ
	|	Лико_ПодготовкаМатериалов.ЗаказКлиента = &ЗаказКлиента";
	Запрос.УстановитьПараметр("ЗаказКлиента",Док.ЗаказКлиента );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДокументОбъект=Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.ЕстьФормы=Не ДокументОбъект.ЕстьФормы;
		ДокументОбъект.Записать();
		
		
	КонецЦикла; 
	
