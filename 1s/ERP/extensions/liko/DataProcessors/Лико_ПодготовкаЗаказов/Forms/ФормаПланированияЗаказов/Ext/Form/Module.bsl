&НаСервереБезКонтекста
Функция ПоступившиеЗаказыПоРЦ() //+Лико m.shenderov 22.12.2017
	НФ_Количество=0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПооперационноеРасписание2_2.РабочийЦентр КАК РабочийЦентр,
	|	ПооперационноеРасписание2_2.Этап КАК Этап,
	|	ПооперационноеРасписание2_2.Этап.Распоряжение КАК ЗаказНаПроизводство,
	|	ВЫБОР
	|		КОГДА ПооперационноеРасписание2_2.Этап.Распоряжение.ДокументОснование ССЫЛКА Документ.ЗаказКлиента
	|			ТОГДА ПооперационноеРасписание2_2.Этап.Распоряжение.ДокументОснование
	|		ИНАЧЕ ПооперационноеРасписание2_2.Этап.Распоряжение.ДокументОснование.Лико_ЗаказКлиента
	|	КОНЕЦ КАК ЗаказКлиента,
	|	ПооперационноеРасписание2_2.Этап.НомерПроката КАК НомерПроката,
	|	ПооперационноеРасписание2_2.Начало КАК Начало,
	|	ПооперационноеРасписание2_2.Этап.ВидЭтапа КАК ВидЭтапа,
	|	ПооперационноеРасписание2_2.Окончание КАК Окончание,
	|	ВЫБОР
	|		КОГДА ПооперационноеРасписание2_2.Выполняется = 1
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НаПроизводстве
	|ПОМЕСТИТЬ ВТ_ЗагрузкаРЦ
	|ИЗ
	|	РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2
	|ГДЕ
	|	ПооперационноеРасписание2_2.Выполнено = 0
	|	И НЕ ПооперационноеРасписание2_2.Моделирование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(1) КАК Количество,
	|	ВТ_ЗагрузкаРЦ.РабочийЦентр.ПорядковыйНомер КАК РабочийЦентр,
	|	ВТ_ЗагрузкаРЦ.РабочийЦентр КАК РЦ
	|ИЗ
	|	ВТ_ЗагрузкаРЦ КАК ВТ_ЗагрузкаРЦ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК Заказ
	|		ПО ВТ_ЗагрузкаРЦ.ЗаказКлиента = Заказ.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПодготовленныеМатериалы КАК Лико_ПодготовленныеМатериалы
	|		ПО ВТ_ЗагрузкаРЦ.ЗаказКлиента = Лико_ПодготовленныеМатериалы.ЗаказКлиента
	|			И ВТ_ЗагрузкаРЦ.НомерПроката = Лико_ПодготовленныеМатериалы.НомерПроката
	|ГДЕ
	|	Лико_ПодготовленныеМатериалы.Регистратор ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ЗагрузкаРЦ.РабочийЦентр.ПорядковыйНомер,
	|	ВТ_ЗагрузкаРЦ.РабочийЦентр";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Структура = Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.РЦ.ВидРабочегоЦентра=Справочники.ВидыРабочихЦентров.NewFoil Тогда
			НФ_Количество=  НФ_Количество+Выборка.Количество;
		Иначе
			Структура.Вставить("РЦ"+Формат(Выборка.РабочийЦентр,"ЧГ=0"),Выборка.Количество);
		КонецЕсли;
	КонецЦикла; 
	Если НФ_Количество>0 Тогда
		Структура.Вставить("РЦNF",НФ_Количество);
	КонецЕсли;
	Возврат Структура;
	
КонецФункции  //-Лико m.shenderov 22.12.2017

