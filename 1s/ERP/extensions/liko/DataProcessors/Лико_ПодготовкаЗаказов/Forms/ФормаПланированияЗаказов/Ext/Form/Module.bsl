&НаСервереБезКонтекста
Процедура СкопироватьРезервСервер(База,Приемник,Знач Основнойматериал) //+Лико m.shenderov 22.12.2017
	ДокументОбъект=Приемник.ПолучитьОбъект();
	Структура = Новый Структура;
	
	Если Основнойматериал Тогда
		Структура.Вставить("СтатьяЗатрат",Справочники.Лико_СтатьиЗатрат.ОсновнойМатериал);
	Иначе
		Структура.Вставить("СтатьяЗатрат",Справочники.Лико_СтатьиЗатрат.ДополнительныеМатериалы);
	КонецЕсли;
	
	НайденныеСтроки=База.Резервирование.НайтиСтроки(Структура);
	
	
	//ДокументОбъект.Резервирование.Загрузить(База.Резервирование.Выгрузить(НайденныеСтроки));
	
	Для каждого Стр Из НайденныеСтроки Цикл
		НоваяСтрокаРезервирования=ДокументОбъект.Резервирование.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРезервирования,Стр);
		
		
		НайденныеСтроки=Приемник.Материалы.НайтиСтроки(Структура);
		Количество=0;
		КоличествоУпаковок=0;
		Если НайденныеСтроки.Количество()>0 Тогда
			Количество=НайденныеСтроки[0].Количество;
			КоличествоУпаковок=НайденныеСтроки[0].КоличествоУпаковок;			
			НоваяСтрокаРезервирования.Количество= Количество;			
			НоваяСтрокаРезервирования.КоличествоУпаковок= КоличествоУпаковок;
			
		КонецЕсли;
		
		
		
	КонецЦикла;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры  //-Лико m.shenderov 22.12.2017


&НаКлиенте
Процедура ПланированиеЗаказовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	Ключ=Поле.Имя;
	Если Поле.Имя="ПланированиеЗаказовНаличиеМатериала" Или Поле.Имя="ПланированиеЗаказовДатаПриходаМатериала"  Тогда
		
		Структура = Новый Структура;
		Структура.Вставить("Ключ",Ключ); 
		Если    Поле.Имя="ПланированиеЗаказовНаличиеМатериала" Тогда
			Реквизит="НаличиеМатериала";
			Подсказака="Введите наличие материала."
		ИначеЕсли   Поле.Имя="ПланированиеЗаказовДатаПриходаМатериала"  Тогда
			Реквизит="ДатаПриходаМатериалаТекст";
			Подсказака="Введите дату прихода материала."
			
		КонецЕсли;
		
		Структура = Новый Структура;
		Структура.Вставить("Ключ",Реквизит); 
		
		ТекущееЗначение=ПолучитьЗначениеСервер(Элементы.ПланированиеЗаказов.ТекущаяСтрока,Реквизит); 
		
		ОписаниеОповещения= Новый ОписаниеОповещения("РедактированиеРеквизитаЗавершение",ЭтаФорма,Структура);
		ПоказатьВводСтроки(ОписаниеОповещения,ТекущееЗначение,Подсказака);
	ИначеЕсли Поле.Имя="ПланированиеЗаказовНомерЗаказа" Тогда
		
		//+ Лико m.shenderov 07.05.2018
		//СтандартнаяОбработка = Ложь;
		
		//ПараметрыОткрытия = СформироватьПараметрыОткрытияДляПечатнойФормыОБЗ(Элементы.ПланированиеЗаказов.ТекущиеДанные.Заказ);
		ПараметрыОткрытия = СформироватьПараметрыОткрытияДляПечатнойФормыВБЗ(Элементы.ПланированиеЗаказов.ТекущиеДанные.Заказ);

		
		Если ПараметрыОткрытия = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыОткрытия, ЭтаФорма, Строка(Новый УникальныйИдентификатор));
		
		//- Лико m.shenderov 07.05.2018
		
		
		//
		//Структура = Новый Структура;
		//Структура.Вставить("Ключ",Элементы.ПланированиеЗаказов.ТекущиеДанные.Заказ);
		//
		//ОткрытьФорму("Документ.ЗаказКлиента.ФормаОбъекта",СТруктура,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли Поле.Имя="ПланированиеЗаказовЕстьФормы" 	Тогда
		
		ЕстьФорма(Элементы.ПланированиеЗаказов.ТекущаяСтрока);
		Элементы.ПланированиеЗаказов.Обновить();
		
		
	Иначе
		
		ОписаниеОповещения= Новый ОписаниеОповещения("ПланированиеЗаказовВыборЗавершение",ЭтаФорма);
		Структура = Новый Структура;
		Структура.Вставить("Ключ",Элементы.ПланированиеЗаказов.ТекущаяСтрока);
		ОткрытьФорму("Документ.Лико_ПодготовкаМатериалов.ФормаОбъекта",Структура,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
	КонецЕсли;
	
КонецПроцедуры


