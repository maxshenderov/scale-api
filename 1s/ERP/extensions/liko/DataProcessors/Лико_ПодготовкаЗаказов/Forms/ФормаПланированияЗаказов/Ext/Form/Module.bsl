	|	ЕСТЬNULL(ВтЗаказыПечатьСКлеящегоСлоя.ЕстьПечатьСКлеящегоСлоя, ЛОЖЬ) КАК ЕстьПечатьСКлеящегоСлоя
	|ИЗ
	|	Вт_Итог КАК Вт_Итог
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Лико_ПодготовкаМатериалов КАК Лико_ПодготовкаМатериалов
	|		ПО Вт_Итог.Ссылка = Лико_ПодготовкаМатериалов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтЗаказыПечатьСКлеящегоСлоя КАК ВтЗаказыПечатьСКлеящегоСлоя
	|		ПО Вт_Итог.Заказ = ВтЗаказыПечатьСКлеящегоСлоя.ЗаказКлиента
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ФильтрПоВидуЗаказа
	|				ТОГДА Лико_ПодготовкаМатериалов.ЗаказКлиента.ВидЗаказа = &ВидЗаказа
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И Лико_ПодготовкаМатериалов.ЗаказКлиента.Площадка В(&Площадка)";
		
КонецПроцедуры //-Лико m.shenderov 09.04.2021

&НаКлиенте
Асинх Процедура РезервироватьПоШаблону(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Ответ = Ждать ВопросАсинх(НСтр("ru = 'Резервировать по шаблону?';"
	+ " en = 'Reserve by template?'"), Режим, 0);
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;	РезервироватьПоШаблонуСервер(Элементы.ПланированиеЗаказов.ВыделенныеСтроки); 
	
	Элементы.ПланированиеЗаказов.Обновить();
	
КонецПроцедуры

Процедура РезервироватьПоШаблонуСервер(Знач Массив) //+Лико m.shenderov 08.02.2023
	
	Шаблон=НайтиШаблонРезервированияСервер(Массив);
	
	Если Не ЗначениеЗаполнено(Шаблон) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Для каждого Док Из Массив Цикл
		
		УстановитьРезервПоШаблонуСервер(Док,Шаблон);
		
	КонецЦикла;
	
			
КонецПроцедуры //-Лико m.shenderov 08.02.2023


Функция НайтиШаблонРезервированияСервер(Массив) //+Лико m.shenderov 08.02.2023
	
	Индекс=0;
	
	Шаблон=Неопределено;
	
	Для каждого Док Из Массив Цикл
		
		Если Док.Резервирование.Количество()>0 Тогда
			
			Шаблон=Док;
			Прервать;
		КонецЕсли;
		
		Индекс=Индекс+1;	
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Шаблон) Тогда
		
		Массив.Удалить(Индекс);
		
		Возврат Шаблон; 
		
	КонецЕсли;
	
	
	
КонецФункции //-Лико m.shenderov 08.02.2023 

Процедура УстановитьРезервПоШаблонуСервер(Док,Шаблон) //+Лико m.shenderov 08.02.2023

	Если Док.Резервирование.Количество()>0 Тогда
		Возврат;
	КонецЕсли;
	 ДокОбъект=Док.ПолучитьОбъект();
	 ДокОбъект.НаличиеМатериала=Шаблон.НаличиеМатериала;
	 ДокОбъект.ДатаПриходаМатериала=Шаблон.ДатаПриходаМатериала;
	 
	 Для каждого СтрШаблона Из Шаблон.Резервирование Цикл
        НоваяСтрРезерва=ДокОбъект.Резервирование.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрРезерва,СтрШаблона); 
		КоличествоРезервирования=0;
		РасчитатьКоличество(КоличествоРезервирования,Док,НоваяСтрРезерва.СтатьяЗатрат,НоваяСтрРезерва.НомерРаботы);
        НоваяСтрРезерва.КоличествоУпаковок	 = КоличествоРезервирования; 
		НоваяСтрРезерва.Количество			 = НоваяСтрРезерва.КоличествоУпаковок*НоваяСтрРезерва.Упаковка.Числитель;
		
	КонецЦикла;
	
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	

		
КонецПроцедуры //-Лико m.shenderov 08.02.2023


Процедура РасчитатьКоличество(КоличествоРезервирования,Документ,СтатьяЗатрат,НомерРаботы)
	
	Структура = Новый Структура;
	Структура.Вставить("СтатьяЗатрат",СтатьяЗатрат);
	Структура.Вставить("НомерРаботы",НомерРаботы);
	
	НайденныеСтроки=Документ.Материалы.НайтиСтроки(Структура);
	Для каждого Стр Из НайденныеСтроки Цикл
		КоличествоРезервирования=КоличествоРезервирования+Стр.КоличествоУпаковок;
		
		Если  Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Стр.Номенклатура,"Код")="n0000165119" Тогда
			
			КоличествоРезервирования=КоличествоРезервирования/3;	
			
		КонецЕсли;

		
	КонецЦикла;	
	
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформлениеНарезка() // <-- Начало Лико Яцун С. В. 19.02.2024	
	
	Возврат; 
	
	МассивУсловногоОформленияНарезка = Новый Массив();	
	Для каждого Элемент Из УсловноеОформление.Элементы Цикл
		Если Строка(Элемент.Поля) = "ПланированиеЗаказовНарезка" Тогда
			МассивУсловногоОформленияНарезка.Добавить(Элемент);	
		КонецЕсли;
	КонецЦикла;
	Для каждого ЭлементМассива Из МассивУсловногоОформленияНарезка Цикл
		УсловноеОформление.Элементы.Удалить(ЭлементМассива);	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Если Найти(ПланированиеЗаказов.ТекстЗапроса,"втПодготовка") = 0 Тогда
		Запрос.Текст = ПланированиеЗаказов.ТекстЗапроса + " И ВЫРАЗИТЬ(Вт_Итог.Заказ КАК Документ.ЗаказКлиента).Цвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ПечатьСКлеящегоСлоя)"; 
	Иначе
		Запрос.Текст = ПланированиеЗаказов.ТекстЗапроса + " И ВЫРАЗИТЬ(втПодготовка.Заказ КАК Документ.ЗаказКлиента).Цвета.ВидСекции = ЗНАЧЕНИЕ(Справочник.Лико_ВидыСекций.ПечатьСКлеящегоСлоя)"; 
	КонецЕсли;
	Для каждого Парам Из ПланированиеЗаказов.Параметры.Элементы Цикл
		Запрос.УстановитьПараметр(Парам.Параметр, Парам.Значение);
	КонецЦикла;
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
		ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ПланированиеЗаказовНарезка");
		ЭлементОтбора = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПланированиеЗаказов.Заказ");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ВыборкаДетальныеЗаписи.Заказ;
		ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.НейтральноКоричневый);
	КонецЦикла;

КонецПроцедуры // <-- Конец Лико Яцун С. В. 19.02.2024


