&НаКлиенте
Процедура ПланированиеЗаказовПриАктивизацииСтроки(Элемент)
	Метраж=0;
	МетражОбщий=0;
	Для каждого СтрокаЗаказа Из Элементы.ПланированиеЗаказов.ВыделенныеСтроки Цикл
		Данные= Элементы.ПланированиеЗаказов.ДанныеСтроки(СтрокаЗаказа);
		Метраж=Метраж+Данные.МетражПМ;
		МетражОбщий=МетражОбщий+Данные.МетражОбщий;
	КонецЦикла;
	ТекСтрока=Элементы.ПланированиеЗаказов.ТекущиеДанные;
	Если  ТекСтрока<>Неопределено Тогда
		Комментарий=ПолучитьКомментарийПоЗаказу(ТекСтрока.Заказ);
	КонецЕсли;
	
	
КонецПроцедуры


&НаКлиенте
Процедура ТребованиеНакладная(Команда)
	ВыполняемаяОбработка=НайтиПФ("Печатная форма документа ""Требование накладная подготовка""");
	Если ВыполняемаяОбработка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ОбъектыНазначения=Новый Массив;
	ОбъектыНазначения.Добавить(Элементы.ПланированиеЗаказов.ТекущаяСтрока);
	//Если УправлениеПечатьюКлиент.ПроверитьДокументыПроведены(ОбъектыНазначения) Тогда
	ПараметрыОткрытия=Новый Структура("ИсточникДанных, ПараметрыИсточника");
	ПараметрыОткрытия.ИсточникДанных=ВыполняемаяОбработка;
	ПараметрыОткрытия.ПараметрыИсточника=Новый Структура("ИдентификаторКоманды, ОбъектыНазначения");
	ПараметрыОткрытия.ПараметрыИсточника.ИдентификаторКоманды="ТребованиеНакладная_Подготовка";
	ПараметрыОткрытия.ПараметрыИсточника.ОбъектыНазначения=ОбъектыНазначения;
	
	ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыОткрытия,ЭтаФорма); 
	
КонецПроцедуры

