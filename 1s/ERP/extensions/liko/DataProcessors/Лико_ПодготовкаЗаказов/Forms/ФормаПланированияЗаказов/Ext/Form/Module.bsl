
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Площадка=ПараметрыСеанса.ТекущийПользователь.Лико_Площадки.ВыгрузитьКолонку("Площадка");	
	УстановитьТекстЗапросаПланированиеЗаказов();
	
	НовыеЗаказы.Параметры.УстановитьЗначениеПараметра("РабочийЦентр",РабочийЦентр);
	НовыеЗаказы.Параметры.УстановитьЗначениеПараметра("НФ",Ложь);
	НовыеЗаказы.Параметры.УстановитьЗначениеПараметра("ФильтрПоВидуЗаказа",ЗначениеЗаполнено(ВидЗаказа));
	НовыеЗаказы.Параметры.УстановитьЗначениеПараметра("ВидЗаказа",ВидЗаказа);
	НовыеЗаказы.Параметры.УстановитьЗначениеПараметра("Площадка",Площадка);
	
	
	ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("СВОДНО",Ложь);
	ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("СводноВсеРЦ",СводноВсеРЦ);	
	ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("РабочийЦентр",РабочийЦентр);
	ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("НФ",Ложь);
	ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("ДатаКонтроляМатериала",ТекущаяДата()-48*3600);
	ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("ФильтрПоВидуЗаказа",ЗначениеЗаполнено(ВидЗаказа));
	ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("ВидЗаказа",ВидЗаказа);
	ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("Площадка",Площадка);
	
	
	
	Если  Параметры.Свойство("ПотребностиМатериалов") Тогда 
		НовыеЗаказы.ТекстЗапроса=НовыеЗаказыТекстЗапросаПотребностиМатериалов();
		ПланированиеЗаказов.ТекстЗапроса=ПланированиеЗаказовТекстЗапросаПотребностиМатериалов();
		ПотребностиМатериалов=Истина;
		
		//НовыеЗаказы.Параметры.УстановитьЗначениеПараметра("ПотребностиМатериалов"			,Истина);
		НовыеЗаказы.Параметры.УстановитьЗначениеПараметра("ПотребностьНоменклатура"			,Параметры.ПотребностьНоменклатура); 
		НовыеЗаказы.Параметры.УстановитьЗначениеПараметра("ПотребностьНарезка"				,Параметры.ПотребностьНарезка);
		НовыеЗаказы.Параметры.УстановитьЗначениеПараметра("ПотребностьЕстьНарезка"			,Параметры.ПотребностьЕстьНарезка);
		НовыеЗаказы.Параметры.УстановитьЗначениеПараметра("Организация"				        ,Параметры.Организация);		
		
		//ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("ПотребностиМатериалов"	,Истина);
		ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("ПотребностьНоменклатура"			,Параметры.ПотребностьНоменклатура); 
		ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("ПотребностьНарезка"				,Параметры.ПотребностьНарезка);
		ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("ПотребностьЕстьНарезка"			,Параметры.ПотребностьЕстьНарезка);
		ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("Организация"				        ,Параметры.Организация); 		
	КонецЕсли;
	ПолучитьРабочиеЦентры();
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьРабочиеЦентры() //+Лико m.shenderov 19.12.2017
	УстановитьПривилегированныйРежим(Истина);
	Если ПотребностиМатериалов Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(Лико_ОтображениеРабочихЦентровРабочиеЦентры.НомерСтроки) КАК НомерСтроки,
	|	Лико_ОтображениеРабочихЦентровРабочиеЦентры.РабочийЦентр КАК РабочийЦентр,
	|	Лико_ОтображениеРабочихЦентровРабочиеЦентры.РабочийЦентр.ПорядковыйНомер КАК Номер
	|ИЗ
	|	Справочник.Лико_ОтображениеРабочихЦентров.РабочиеЦентры КАК Лико_ОтображениеРабочихЦентровРабочиеЦентры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ОтображениеРабочихЦентров КАК Лико_ОтображениеРабочихЦентров
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи.ДополнительныеРеквизиты КАК ПользователиДополнительныеРеквизиты
	|			ПО Лико_ОтображениеРабочихЦентров.Ссылка = ПользователиДополнительныеРеквизиты.Значение
	|				И (ПользователиДополнительныеРеквизиты.Свойство = &ПредопределенноеСвойство)
	|		ПО Лико_ОтображениеРабочихЦентровРабочиеЦентры.Ссылка = Лико_ОтображениеРабочихЦентров.Ссылка
	|ГДЕ
	|	ПользователиДополнительныеРеквизиты.Ссылка = &Пользователь
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_ОтображениеРабочихЦентровРабочиеЦентры.РабочийЦентр,
	|	Лико_ОтображениеРабочихЦентровРабочиеЦентры.РабочийЦентр.ПорядковыйНомер
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Пользователь",ПараметрыСеанса.ТекущийПользователь );
	Запрос.УстановитьПараметр("ПредопределенноеСвойство",Справочники.Лико_ПредопределенныеЗначения.ДопРеквизитПользователяОтображениеРабочихЦентров.ЗначениеПараметра );
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивРЦ=Новый СписокЗначений;
	МассивКнопок=Новый СписокЗначений;
	
	ИмяРЦ="РЦСВОДНО";
	КомандаФормы  = Команды.Добавить(ИмяРЦ);
	КомандаФормы.Действие = "ПроцедураОбработкиНажатия";
	Элементы.Добавить(ИмяРЦ,Тип("КнопкаФормы"), Элементы.ГруппаРЦ);
	Элементы[ИмяРЦ].Заголовок =  "СВОДНО";
	Элементы[ИмяРЦ].ИмяКоманды = ИмяРЦ;
	Элементы[ИмяРЦ].Ширина = 19;
	Элементы[ИмяРЦ].Высота = 2;
	
	Н=0;
	Пока Выборка.Следующий() Цикл
		Если Выборка.РабочийЦентр.ВидРабочегоЦентра=Справочники.ВидыРабочихЦентров.NewFoil Тогда
			Продолжить;
		КонецЕсли;
		Н=Н+1;	
		ИмяРЦ="РЦ"+Формат(Выборка.Номер,"ЧГ=0");
		КомандаФормы  = Команды.Добавить(ИмяРЦ);
		КомандаФормы.Действие = "ПроцедураОбработкиНажатия";
		Если Н<15 Тогда	
			Элементы.Добавить(ИмяРЦ,Тип("КнопкаФормы"), Элементы.ГруппаРЦ);
		Иначе
			Элементы.Добавить(ИмяРЦ,Тип("КнопкаФормы"), Элементы.ГруппаРЦ2);
			
		КонецЕсли;
		
		Элементы[ИмяРЦ].Заголовок =  Строка(Выборка.Номер);
		Элементы[ИмяРЦ].ИмяКоманды = ИмяРЦ;
		Элементы[ИмяРЦ].Ширина = 8;
		Элементы[ИмяРЦ].Высота = 2;
		//Если ПоступившиеРц.Свойство(ИмяРЦ) Тогда
		//	Количество= ПоступившиеРц[ИмяРЦ];
		//	Если Количество>0 Тогда
		//		
		//		
		//		Элементы[ИмяРЦ].Шрифт=Новый Шрифт(Элементы[ИмяРЦ].Шрифт,,,Истина); 
		//		Элементы[ИмяРЦ].ЦветТекста= WebЦвета.Красный;		
		//		
		//		//	Элементы[ИмяРЦ].Шрифт=Новый Шрифт(Кнопка.Шрифт,,,Истина); 
		//		//Элементы[ИмяРЦ].ЦветТекстаКнопки= WebЦвета.Красный;		
		//		
		//		
		//	КонецЕсли;
		//	
		//	
		//КонецЕсли;
		
		
		МассивРЦ.Добавить(Выборка.РабочийЦентр);
		МассивКнопок.Добавить(ИмяРЦ);
		
		
		
	КонецЦикла;
	
	ИмяРЦ="РЦNF";
	КомандаФормы  = Команды.Добавить(ИмяРЦ);
	КомандаФормы.Действие = "ПроцедураОбработкиНажатия";
	Элементы.Добавить(ИмяРЦ,Тип("КнопкаФормы"), Элементы.ГруппаРЦ);
	Элементы[ИмяРЦ].Заголовок =  "NF";
	Элементы[ИмяРЦ].ИмяКоманды = ИмяРЦ;
	Элементы[ИмяРЦ].Ширина = 8;
	Элементы[ИмяРЦ].Высота = 2;
	МассивКнопок.Добавить(ИмяРЦ);
	
	
	
	МассивРабочихЦентров=МассивРЦ;
	МассивКнопокРЦ=МассивКнопок;
	ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("РабочиеЦентры",МассивРабочихЦентров);	
	
КонецПроцедуры  //-Лико m.shenderov 19.12.2017

&НаКлиенте
Процедура УстановкаЦветаКнопокРЦ() //+Лико m.shenderov 22.12.2017
	Если ПотребностиМатериалов Тогда
		Возврат;
	КонецЕсли;
	
	ПоступившиеРц=ПоступившиеЗаказыПоРЦ();
	Для каждого ИмяРЦ Из МассивКнопокРЦ Цикл
		Заголовок=  Сред(ИмяРЦ,3,СтрДлина(ИмяРЦ));
		
		
		Если ПоступившиеРц.Свойство(Строка(ИмяРЦ)) Тогда
			Количество= ПоступившиеРц[Строка(ИмяРЦ)];
			Если Количество>0 Тогда 				
				
				Элементы[Строка(ИмяРЦ)].Шрифт=Новый Шрифт(Элементы[Строка(ИмяРЦ)].Шрифт,,,ложь); 
				Элементы[Строка(ИмяРЦ)].ЦветТекста= WebЦвета.Красный;		
				Элементы[Строка(ИмяРЦ)].Заголовок= Заголовок+"("+Строка(Количество)+")";
			КонецЕсли;
			
		Иначе
			Элементы[Строка(ИмяРЦ)].Шрифт=Новый Шрифт(Элементы[Строка(ИмяРЦ)].Шрифт,,,Ложь);
			Элементы[Строка(ИмяРЦ)].ЦветТекста= WebЦвета.Черный;
			Элементы[Строка(ИмяРЦ)].Заголовок= Заголовок;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры //-Лико m.shenderov 22.12.2017



&НаКлиенте
Процедура ПроцедураОбработкиНажатия(Элемент)
	Если ЗначениеЗаполнено(ТекущаяКнопка) Тогда
		Элементы[ТекущаяКнопка].ЦветФона=	Элементы[Элемент.Имя].ЦветФона;
	КонецЕсли;
	ТекущаяКнопка=Элемент.Имя;
	Заголовок=  Сред(Элемент.Имя,3,СтрДлина(Элемент.Имя));
	Элементы[Элемент.Имя].ЦветФона =   Новый Цвет(200, 200, 255);
	Если Заголовок="СВОДНО" Тогда
		
		ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("СВОДНО",Истина);
		Сводно=Истина;
		//Элементы.ПланированиеЗаказовМетрыТиснения.Видимость=Истина;
		
	ИначеЕсли Заголовок="NF" Тогда
		ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("СВОДНО",Ложь);
		ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("НФ",Истина);
		НовыеЗаказы.Параметры.УстановитьЗначениеПараметра("НФ",Истина);
		Сводно=Ложь;
		//Элементы.ПланированиеЗаказовМетрыТиснения.Видимость=Истина;
		РабочийЦентр=Неопределено;
	Иначе
		ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("СВОДНО",Ложь);
		ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("НФ",Ложь);
		НовыеЗаказы.Параметры.УстановитьЗначениеПараметра("НФ",Ложь);
		//Элементы.ПланированиеЗаказовМетрыТиснения.Видимость=Ложь;
		
		Сводно=Ложь;	
		
		РабочийЦентр=ПолучитьСсылкуСправочника(Заголовок);
	КонецЕсли;
	НовыеЗаказы.Параметры.УстановитьЗначениеПараметра("РабочийЦентр",РабочийЦентр);
	ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("РабочийЦентр",РабочийЦентр);
	ПланированиеЗаказов.Параметры.УстановитьЗначениеПараметра("ДатаКонтроляМатериала",ТекущаяДата()-48*3600);
	
	Элементы.НовыеЗаказы.Видимость= Не Сводно;
	// <-- Начало Лико Яцун С. В. 20.02.2024
	ДобавитьУсловноеОформлениеНарезка();
	// <-- Конец Лико Яцун С. В. 20.02.2024
КонецПроцедуры

