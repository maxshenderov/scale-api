	Иначе
		НоваяСтрока= ТоварыДляСканирования.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Структура);
		НоваяСтрока.Ячейка=Ячейка;
		НоваяСтрока.НоменклатураИмя=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Структура.Серия,"Наименование");
		
