&НаКлиенте
Перем КэшированныеЗначения; //используется механизмом обработки изменения реквизитов ТЧ



#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	
	
	Если Параметры.Свойство("ДокументОсонвание") Тогда
		ДокументОснование=Параметры.ДокументОснование;
	КонецЕсли;	
	Организация = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента("ДопРеквизитПользователяОрганизация", ПараметрыСеанса.ТекущийПользователь);
	ИндексТекущейСтраницы=0;
	Структура = Новый Структура;
	Структура.Вставить("МестоХранения","Необходимо указать место хранения!");
	Структура.Вставить("ОтсутствиеТовара","На складе: %Склад% товара: %товар% нет в наличии! ");
	СоответствиеСсобщений=Структура;	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// МеханизмВнешнегоОборудования
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(
	Новый ОписаниеОповещения("НачатьПодключениеОборудованиеПриОткрытииФормыЗавершение", ЭтотОбъект),
	ЭтотОбъект,
	"СканерШтрихкода");	
	ИндексТекущейСтраницы=0;
	ОтобразитьСтраницу("");
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ПодключаемоеОборудование
	
	Если Источник = "ПодключаемоеОборудование" И ВводДоступен() Тогда
		Если ИмяСобытия = "ScanData" Тогда
			СтруктураШтрихКода= ПодключаемоеОборудованиеУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр);
			
			ДокОснование=ПолучитьСсылкуПоШтрихкодуТабличногоДокументаСервер(СтруктураШтрихКода.Штрихкод);
			Если ДокОснование<>Неопределено Тогда
				ДокументОснование=ДокОснование;
				ЗаполнитьПоДокументу();
				ИндексТекущейСтраницы=1;
				ОтобразитьСтраницу("");				
				Возврат;
			КонецЕсли; 
			Если ИндексТекущейСтраницы<>0 Тогда
				ОбработатьШтрихкоды(СтруктураШтрихКода);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
КонецПроцедуры


#КонецОбласти

#Область КомандыФормы
&НаКлиенте
Процедура ЗакрытьИПровести(Команда)
	ЗакрытьИПровестиНаСервере();
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	Если ИндексТекущейСтраницы=0 Тогда
		Закрыть();
	Иначе
		ИндексТекущейСтраницы=0;
		ОтобразитьСтраницу(""); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СканированиеДалее(Команда)
	ОтобразитьСтраницу("Далее");
КонецПроцедуры


&НаКлиенте
Процедура СканированиеНазад(Команда)
	ОтобразитьСтраницу( "Назад")
КонецПроцедуры



&НаКлиенте
Процедура Старт(Команда)
	ОтобразитьСтраницу("Далее");	
КонецПроцедуры



#КонецОбласти

#Область СлужебныеПроцедурыИФункции


&НаКлиенте
Процедура ОбработатьШтрихкоды(ДанныеШтрихкода) 	
	ТипОперацииСервер();
	Результат = Лико_ДополнительноКлиент.ОбработатьШтрихКодНеТовара(ДанныеШтрихкода.Штрихкод);
	Если Результат.Ошибка <> "" Тогда
		Сообщить(Результат.Ошибка);
	Иначе
		Если Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Сотрудника") Тогда
			//Это физ. лицо
			Оператор = Результат.Сотрудник;
			Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаШапка;
			ОтобразитьСтраницу("");
		ИначеЕсли Результат.ВидШК =  ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Адреса")
			ИЛИ Результат.ВидШК =  ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Адреса_Короткий") Тогда
			//Это ячейка
			Ячейка = Результат.АдресаХранения;
			Склад = Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Результат.АдресаХранения,"Владелец");
			Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаШапка;
			ОтобразитьСтраницу(""); 
		ИначеЕсли Результат.ВидШК =  ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры") 
			Или Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры_Короткий")   Тогда
			
			ОбработатьШтрихкодыНоменклатуры(Результат,ТипОперации);
			
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры

#Область ШтрихкодНоменклатуры


&НаКлиенте
Процедура ОбработатьШтрихкодыНоменклатуры(Знач Результат,ТипОперации)
	Если ТипОперации="" Тогда 
		Возврат;
	КонецЕсли;
	
	
	Если ТипОперации="Перемещение" Тогда 	
		ОбработатьШтрихкодыНоменклатурыПеремещение(Результат);
	КонецЕсли;
	
	Если ТипОперации="Отбор" Тогда 	
		ОбработатьШтрихкодыНоменклатурыОтбор(Результат);
	КонецЕсли;
	
	Если ТипОперации="Инвентаризация" Тогда 	
		ОбработатьШтрихкодыНоменклатурыПеремещение(Результат);
	КонецЕсли; 	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШтрихкодыНоменклатурыПеремещение(Знач Результат)	
	
	Если Не ЗначениеЗаполнено(Ячейка) Тогда		
		ВывестиОшибку(СоответствиеСсобщений["МестоХранения"]);
		Возврат;
	КонецЕсли;
	
	
	
	Структура = Новый Структура;
	Структура.Вставить("Номенклатура",Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Результат.ОбъектНоменклатуры,"Номенклатура"));
	Структура.Вставить("Серия",Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Результат.ОбъектНоменклатуры,"Серия"));
	Структура.Вставить("Упаковка",Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Результат.ОбъектНоменклатуры,"БазоваяЕдиницаИзмерения"));
	Структура.Вставить("Характеристика",Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Результат.ОбъектНоменклатуры,"Характеристика"));
	//Структура.Вставить("НомерПоставки",Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Результат.ОбъектНоменклатуры,"НомерПоставки"));
	Структура.Вставить("КоличествоУпаковок",Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Результат.ОбъектНоменклатуры,"Количество"));
	ТекстОшибки=ЕстьНаСкладе(Структура,Склад);
	
	Если ТекстОшибки<>"" Тогда
		
		ВывестиОшибку(ТекстОшибки); 		
		Возврат;
	КонецЕсли;
	
	
	
	НайденныеСтроки=ТоварыДляСканирования.НайтиСтроки(Структура);
	Если НайденныеСтроки.Количество()>0 Тогда
		Для каждого НайденаяСтрока Из НайденныеСтроки  Цикл 	
			НайденаяСтрока.Ячейка=Ячейка; 						
		КонецЦикла;
	Иначе
		НоваяСтрока= ТоварыДляСканирования.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Структура);
		НоваяСтрока.Ячейка=Ячейка;
		НоваяСтрока.НоменклатураИмя=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Структура.Серия,"Наименование");
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
		СтруктураДействий.Вставить("ПересчитатьВесОбъем");
		
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ЗаполнитьВесУпаковки",Новый Структура("Номенклатура, Упаковка", "ВесУпаковки"));
		СтруктураДействий.Вставить("ЗаполнитьОбъемУпаковки",Новый Структура("Номенклатура, Упаковка", "ОбъемУпаковки"));
		СтруктураДействий.Вставить("ЗаполнитьЕдиницуИзмеренияВеса",Новый Структура("Номенклатура, Упаковка", "ЕдиницаИзмеренияВеса"));
		СтруктураДействий.Вставить("ЗаполнитьЕдиницуИзмеренияОбъема",Новый Структура("Номенклатура, Упаковка", "ЕдиницаИзмеренияОбъема"));
		Суффикс = "";
		
		СтруктураДействий.Вставить("ПересчитатьВесОбъем", Суффикс);
		//СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
		
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс","Отобрано");
		
		//СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", Новый Структура("Склад, ПараметрыУказанияСерий", Объект.Склад, ПараметрыУказанияСерий.Отбор));
		
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиницСуффикс","Размещено"); 				
		
		ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
		
		НоваяСтрока.КоличествоРазмещено=НоваяСтрока.Количество;	
		НоваяСтрока.КоличествоОтобрано=НоваяСтрока.Количество;	
		
		НоваяСтрока.КоличествоУпаковокРазмещено=НоваяСтрока.КоличествоУпаковок;	
		НоваяСтрока.КоличествоУпаковокОтобрано=НоваяСтрока.КоличествоУпаковок;	
		НоваяСтрока.СтатусУказанияСерий=8;	
	КонецЕсли;
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаТовары;
	ОтобразитьСтраницу("");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШтрихкодыНоменклатурыОтбор(Знач Результат)	
	
	//Если Не ЗначениеЗаполнено(Ячейка) Тогда		
	//	ВывестиОшибку(СоответствиеСсобщений["МестоХранения"]);
	//	Возврат;
	//КонецЕсли;
	
	
	
	Структура = Новый Структура;
	Структура.Вставить("Номенклатура",Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Результат.ОбъектНоменклатуры,"Номенклатура"));
