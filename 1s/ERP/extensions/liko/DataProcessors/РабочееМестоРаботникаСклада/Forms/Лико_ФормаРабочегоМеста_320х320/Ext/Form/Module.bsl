	Структура.Вставить("КоличествоУпаковок",Лико_Дополнительно.ЗначениеРеквизитаОбъекта(Результат.ОбъектНоменклатуры,"Количество"));
	
	ДанныеПоСкладу=ЕстьНаСкладе(Структура,Склад);
		
