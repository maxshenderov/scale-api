&НаКлиенте
Процедура ВывестиОшибку(Сообщение)
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСообщения;
	Элементы.ТекстСообщения.Заголовок=Сообщение ;
	Если ИндексТекущейСтраницы<>4 Тогда
		ИндексПердыдущейСтраницы=ИндексТекущейСтраницы;			
	КонецЕсли;
	ОтобразитьСтраницу(""); 	
	Возврат;
	
КонецПроцедуры



#КонецОбласти

#Область Проведение


&НаСервере
Процедура ЗакрытьИПровестиНаСервере()
	
	ПровестиДокументОтборРазмещение_Перемещение();
	
	ПровестиДокументОтборРазмещение_Отбор();
	
КонецПроцедуры

&НаСервере
Процедура ПровестиДокументОтборРазмещение_Перемещение()
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	Отказ=Ложь;	
	
	
	РезультатЗапроса = ТекущееМестоХранениеТоваров(); 
	
	
	ТЗ = РезультатЗапроса.Выгрузить();
	Для каждого Товар Из ТоварыДляСканирования  Цикл
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Номенклатура",Товар.Номенклатура);
		СтруктураПоиска.Вставить("Характеристика",Товар.Характеристика);
		СтруктураПоиска.Вставить("Серия",Товар.Серия); 		
		НайДенныеСтрокиТЗ= ТЗ.НайтиСтроки(СтруктураПоиска);		
		Если  НайденныеСтрокиТЗ.Количество()>0 тогда 			
			Для каждого НайденаяСтрока Из НайДенныеСтрокиТЗ  Цикл
				Товар.ЯчейкаТекущееХранение=НайденаяСтрока.Ячейка; 			
