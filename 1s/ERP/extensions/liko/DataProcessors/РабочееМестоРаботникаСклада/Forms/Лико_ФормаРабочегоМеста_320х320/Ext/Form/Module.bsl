&НаСервереБезКонтекста
Функция ЕстьНаСкладе(Структура,Склад) 
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ТекстСообщения","");
	Массив = Новый Массив();
	
	
	
	ТекстСообщения="";	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.Характеристика КАК Характеристика,
	|	ТоварыВЯчейкахОстатки.Упаковка КАК Упаковка,
	|	ТоварыВЯчейкахОстатки.Серия КАК Серия,
	|	ТоварыВЯчейкахОстатки.Ячейка КАК Ячейка
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|				И Характеристика = &Характеристика
	|				И Серия = &Серия
	|				И Ячейка.Владелец = &Склад) КАК ТоварыВЯчейкахОстатки
	|ГДЕ
	|	ТоварыВЯчейкахОстатки.ВНаличииОстаток >= &Количество";
	Запрос.УстановитьПараметр("Склад",Склад);
	Запрос.УстановитьПараметр("Номенклатура",Структура.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика",Структура.Характеристика);
	Запрос.УстановитьПараметр("Серия",Структура.Серия);
	Запрос.УстановитьПараметр("Количество",Структура.КоличествоУпаковок);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	Если    РезультатЗапроса.Пустой() Тогда 		
		
		СтруктураДанных.ТекстСообщения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru ='Товар %1 %2 %3 в количестве %4 не найден на складе!' "),Структура.Номенклатура,Структура.Характеристика,Структура.Серия,Структура.КоличествоУпаковок); 	
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл  			
			СтруктураВыборка = Новый Структура;	
			СтруктураВыборка.Вставить("Номенклатура",	Выборка.Номенклатура);
			СтруктураВыборка.Вставить("Характеристика",	Выборка.Характеристика);
			СтруктураВыборка.Вставить("Серия",			Выборка.Серия);
			СтруктураВыборка.Вставить("Упаковка",		Выборка.Упаковка);
			СтруктураВыборка.Вставить("Ячейка",			Выборка.Ячейка);
			Массив.Добавить(СтруктураВыборка);				
		КонецЦикла; 		
	КонецЕсли;
	СтруктураДанных.Вставить("Таблица",Массив);

	Возврат СтруктураДанных;	
	
КонецФункции 

&НаСервере
