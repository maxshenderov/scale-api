&НаСервере
Функция ТекущееМестоХранениеТоваров()
	
	Запрос = Новый Запрос; 
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Серия КАК Серия
	|ПОМЕСТИТЬ ВтТовары
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыВЯчейкахОстатки.Характеристика КАК Характеристика,
	|	ТоварыВЯчейкахОстатки.Серия КАК Серия,
	|	МАКСИМУМ(ТоварыВЯчейкахОстатки.Ячейка) КАК Ячейка,
	|	СУММА(ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0)) КАК ВНаличии,
	|	СУММА(1) КАК КоличествоЯчеек
	|ИЗ
	|	ВтТовары КАК ВтТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
	|				,
	|				Ячейка.Владелец = &Склад
	|					И (Номенклатура, Серия, Характеристика) В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							ВтТовары.Номенклатура КАК Номенклатура,
	|							ВтТовары.Серия КАК Серия,
	|							ВтТовары.Характеристика КАК Характеристика
	|						ИЗ
	|							ВтТовары КАК ВтТовары)) КАК ТоварыВЯчейкахОстатки
	|		ПО ВтТовары.Номенклатура = ТоварыВЯчейкахОстатки.Номенклатура
	|			И ВтТовары.Характеристика = ТоварыВЯчейкахОстатки.Характеристика
	|			И ВтТовары.Серия = ТоварыВЯчейкахОстатки.Серия
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВЯчейкахОстатки.Номенклатура,
	|	ТоварыВЯчейкахОстатки.Характеристика,
	|	ТоварыВЯчейкахОстатки.Серия";
	Запрос.УстановитьПараметр("Товары",ТоварыДляСканирования.Выгрузить(,"Номенклатура,Серия,Характеристика") );
	Запрос.УстановитьПараметр("Склад",Склад);
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса;
	
КонецФункции



&НаКлиенте
Процедура ОтобразитьСтраницу( Действие) //+Лико m.shenderov 05.10.2017
	
	
	ИндексСтраницы = Новый Структура;
	ИндексСтраницы.Вставить("СтраницаСтарт",0);
	ИндексСтраницы.Вставить("СтраницаШапка",1);
	ИндексСтраницы.Вставить("СтраницаТовары",2);
	ИндексСтраницы.Вставить("СтраницаЗавершение",3);
	ИндексСтраницы.Вставить("СтраницаСообщения",4);	
	НаименованиеСтраницы = Новый Соответствие;
	НаименованиеСтраницы.Вставить(0,"СтраницаСтарт");
	НаименованиеСтраницы.Вставить(1,"СтраницаШапка");
	НаименованиеСтраницы.Вставить(2,"СтраницаТовары");
	НаименованиеСтраницы.Вставить(3,"СтраницаЗавершение");
	НаименованиеСтраницы.Вставить(4,"СтраницаСообщения");
	
	
	Если Действие="Далее" Тогда
		ИндексТекущейСтраницы=ИндексТекущейСтраницы+1;		
	ИначеЕсли Действие="Назад" и ИндексТекущейСтраницы<>4 Тогда
		ИндексТекущейСтраницы=ИндексТекущейСтраницы-1;	
	ИначеЕсли ИндексТекущейСтраницы=4 И Действие="Назад" Тогда
		ИндексТекущейСтраницы=ИндексПердыдущейСтраницы;
	ИначеЕсли ИндексСтраницы[Элементы.Страницы.ТекущаяСтраница.Имя]<>0 И ИндексТекущейСтраницы<>0 Тогда
		ИндексТекущейСтраницы=ИндексСтраницы[Элементы.Страницы.ТекущаяСтраница.Имя];
	КонецЕсли;
	
	Элементы.Страницы.ТекущаяСтраница=Элементы[НаименованиеСтраницы[ИндексТекущейСтраницы]];
	
	Если   ИндексТекущейСтраницы=3 Или ИндексТекущейСтраницы=4 Тогда
		Элементы.СканированиеДалее.Видимость=Ложь; 
	Иначе
		Элементы.СканированиеДалее.Видимость=Истина; 
	КонецЕсли;
	
	Если   ИндексТекущейСтраницы=1 Тогда 
		Элементы.СканированиеНазад.Видимость=Ложь; 
	Иначе
		Элементы.СканированиеНазад.Видимость=Истина; 
	КонецЕсли;
	
	Если  ИндексТекущейСтраницы=0 Тогда
		Элементы.ГруппаКонпокПеремещенияПоСтраницам.Видимость=Ложь;
	Иначе
		Элементы.ГруппаКонпокПеремещенияПоСтраницам.Видимость=Истина;
	КонецЕсли;
	
	
	
	
	
КонецПроцедуры //-Лико m.shenderov 05.10.2017


&НаСервереБезКонтекста
Функция ПолучитьСсылкуПоШтрихкодуТабличногоДокументаСервер(Штрихкод) //+Лико m.shenderov 05.10.2017
	
	Менеджеры = Новый Массив;	
	Менеджеры.Добавить(Документы.ОтборРазмещениеТоваров.ПустаяСсылка());  	
	Массив= ШтрихкодированиеПечатныхФорм.ПолучитьСсылкуПоШтрихкодуТабличногоДокумента(Штрихкод,Менеджеры);
	
	Если Массив.Количество()=0 или Не ОбщегоНазначения.ЭтоДокумент(Массив[0].Метаданные()) Тогда
		Возврат Неопределено;
	Иначе
		Возврат Массив[0]; 
	КонецЕсли;
	
	
	
	
КонецФункции  //-Лико m.shenderov 05.10.2017

