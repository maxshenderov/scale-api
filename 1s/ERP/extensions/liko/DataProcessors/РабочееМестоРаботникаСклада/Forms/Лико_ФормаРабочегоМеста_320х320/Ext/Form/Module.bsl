	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		ТипОперации= "Перемещение";
	ИначеЕсли  ТипЗнч(ДокументОснование)=Тип("ДокументСсылка.ОтборРазмещениеТоваров") И 
		ДокументОснование.ВидОперации=Перечисления.ВидыОперацийОтбораРазмещенияТоваров.Отбор Тогда
		ТипОперации= "Отбор";	
	КонецЕсли;
	
