&НаКлиенте
Процедура Лико_ЗаменитьСчетФактуруНаРеализациюПосле(Команда)

	ЗаменитьСчетФактуруВыданный();
	ОбновитьДоступностьКнопок();

КонецПроцедуры 


&НаКлиенте
Процедура ЗаменитьСчетФактуруВыданный() //+Лико m.shenderov 22.02.2018
	Для каждого Образ Из Объект.Образы  Цикл
		Если ЭтоСчетФактураВсе(Образ.Объект) Тогда	
			//Образ.ОБъект=Неопределено;
			
			 Образ.ОБъект=Лико_Дополнительно.ЗначениеРеквизитаОбъекта( Образ.ОБъект,"ДокументОснование");
			 Образ.ДокументОтображение=Образ.ОБъект;
			 //Образ.ТипПечатнойФормы=Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //-Лико m.shenderov 22.02.2018


