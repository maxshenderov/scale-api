Процедура ТипЦветаФормы01ПриИзменении(Элемент)
	ЕстьФорма=ЭтаФорма["ЕстьФорма"+Прав(Элемент.Имя,2)];
	ТипЦветаФормы=ЭтаФорма["ТипЦветаФормы"+Прав(Элемент.Имя,2)];
	ДополнениеФорма=ЭтаФорма["ДополнениеФорма"+Прав(Элемент.Имя,2)];
    

	
	Если Лев(Элемент.Имя,15)="ДополнениеФорма" Тогда
		ЕстьФорма = Истина;
	КонецЕсли;
	Если Лев(Элемент.Имя,13)="ТипЦветаФормы" Тогда
		ЕстьФорма = Истина;
	КонецЕсли;
	ЭтаФорма["ПредставлениеФорма"+Прав(Элемент.Имя,2)]= ?(ЕстьФорма, ""+ТипЦветаФормы+" "+ДополнениеФорма, "");
ОбновлениеОтображенияУПП();
	

