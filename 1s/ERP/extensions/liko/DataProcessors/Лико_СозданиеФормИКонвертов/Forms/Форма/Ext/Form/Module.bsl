&НаКлиенте
Процедура ОбработатьШтрихкоды(ДанныеШтрихкода)
	
	
	
	Результат = Лико_ДополнительноКлиент.ОбработатьШтрихКодНеТовара(ДанныеШтрихкода.Штрихкод);
	Если Результат.Ошибка <> "" Тогда
		Сообщить(Результат.Ошибка);
	Иначе
		Если Результат.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Конверта") Тогда
			//Это физ. лицо  			
			Конверт= Результат.Конверт;
			Если ЗначениеЗаполнено(Конверт) Тогда
				ТекущийКонверт = Конверт;

			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	     ОбновлениеОтображенияУПП();

КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ЗапросКонверты = Новый Запрос;
	ЗапросКонверты.Текст = 
	"ВЫБРАТЬ
	|	Лико_Конверты.Ссылка
	|ИЗ
	|	Справочник.Лико_Конверты КАК Лико_Конверты
	|ГДЕ
	|	Лико_Конверты.ЭтоГруппа
	|	И Лико_Конверты.ОрганизацияГруппы = &Организация ";
	ЗапросКонверты.УстановитьПараметр("Организация",Объект.Организация);
	РезультатЗапросаКонверты = ЗапросКонверты.Выполнить();
	Если Не РезультатЗапросаКонверты.Пустой() Тогда
		ВыборкаЗапросаКонверты = РезультатЗапросаКонверты.Выбрать();
		ВыборкаЗапросаКонверты.Следующий();
		
		ГруппаКонвертов = ВыборкаЗапросаКонверты.Ссылка;
		
	Иначе 	//запрос пуст!
	КонецЕсли;
	

КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОрганизацияПриИзмененииНаСервере();
	
	ОбновлениеОтображенияУПП();
	
КонецПроцедуры


&НаСервере
