&НаСервере
Функция СоздатьФормуСПривязкойККонверту(КодНаРельсе, НомерЗаказа, ПредставлениеФормы, ТипЦвета, Конверт,АвторДокумента) Экспорт
	
	
	
	Если Не ЗначениеЗаполнено(Объект.ДокументВвода) Тогда
		
		ОбъектДокументаВвода = Документы.Лико_ВозвратТоваров.СоздатьДокумент();
		ОбъектДокументаВвода.Дата = ТекущаяДата();
		ОбъектДокументаВвода.ВидОперации = Перечисления.Лико_ВидыОпераций_ВозвратНаСклад.ВводНачальныхОстатковФорм;
		ОбъектДокументаВвода.Дата          = ТекущаяДатаСеанса();
		//ОбъектДокументаВвода.Ответственный = Пользователи.ТекущийПользователь();
		Структура = Новый Структура;
		Лико_ОбщегоНазначенияСервер.РеквизитыШапки(Структура);
		ЗаполнитьЗначенияСвойств(ОбъектДокументаВвода,Структура);
        ОбъектДокументаВвода.АвторДокумента=АвторДокумента;
		
		//ОбъектДокументаВвода.Заполнить(Неопределено);
		//ОбъектДокументаВвода.АвторДокумента = ЯС_Общие.ПолучитьОбщееЗначение("ЯС_Оператор");
		//ОбъектДокументаВвода.РабочееМесто = ЯС_Общие.ПолучитьРабочееМесто();
		
		//ОбъектДокументаВвода.Организация = Организация;
		ОбъектДокументаВвода.Записать(РежимЗаписиДокумента.Запись);
		Объект.ДокументВвода = ОбъектДокументаВвода.Ссылка;
	Иначе
		ОбъектДокументаВвода = Объект.ДокументВвода.ПолучитьОбъект();
	КонецЕсли;
	
	КодНового = ОпределитьКодДляНового(КодНаРельсе);
	
	НоваяФорма = Справочники.Лико_Формы.СоздатьЭлемент();
	НоваяФорма.Код = КодНового;
	НоваяФорма.ВидПечати = Перечисления.Лико_ВидыПечати.Флексо;
	
	НоваяФорма.Заказ = Документы.ЗаказКлиента.НайтиПоРеквизиту("НомерБезПрефикса",НомерЗаказа);
	
	//Если Не ЗначениеЗаполнено(НоваяФорма.Заказ) Тогда
	//	НоваяФорма.Заказ = Лико_Общее.ПроверитьЗаполнитьЗаказ(НомерЗаказа);
	//КонецЕсли;
	
	
	НоваяФорма.Контрагент = НоваяФорма.Заказ.Контрагент;
	НоваяФорма.Наименование = ПредставлениеФормы;
	
	ТЧТовары = НоваяФорма.Заказ.Товары.Выгрузить();
	ТЧТовары.Свернуть("Номенклатура");
	Если ТЧТовары.Количество()=1 Тогда
		НоваяФорма.Номенклатура = ТЧТовары[0].Номенклатура;
	КонецЕсли;
	  НоваяФорма.Этикетки.Загрузить(НоваяФорма.Заказ.Товары.Выгрузить());
	
		
	//НоваяФорма.ТипКраски =  // это ценовые группы
	НоваяФорма.ТипЦвета = ТипЦвета;
	
	НоваяФорма.Записать();
	
	НоваяСтрока = ОбъектДокументаВвода.Формы.Добавить();
	НоваяСтрока.Конверт = Конверт;
	НоваяСтрока.Форма = НоваяФорма.Ссылка;
	
	ОбъектДокументаВвода.Записать(РежимЗаписиДокумента.Проведение);
	
	//МЗ = РегистрыСведений.Лико_ИсторияДвиженийФорм.СоздатьМенеджерЗаписи();
	//МЗ.Организация = Организация;
	//МЗ.Период = ТекущаяДата();
	//МЗ.Расположение = Конверт;
	//МЗ.Форма = НоваяФорма.Ссылка;
	//МЗ.Записать();
	
	Возврат НоваяФорма.Ссылка;
	
КонецФункции //СоздатьФормуСПривязкойККонверту Экспорт

&НаСервере 
Функция ОпределитьКодДляНового(КодНаРельсе)
	
	ЗапросКод = Новый Запрос;
	ЗапросКод.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(Лико_Формы.Код) КАК Код
	|ИЗ
	|	Справочник.Лико_Формы КАК Лико_Формы
	|ГДЕ
	|	Лико_Формы.Код ПОДОБНО &Код";
	ЗапросКод.УстановитьПараметр("Код", ""+КодНаРельсе+"%");
	РезультатЗапросаКод = ЗапросКод.Выполнить();
	Если Не РезультатЗапросаКод.Пустой() Тогда
		ВыборкаЗапросаКод = РезультатЗапросаКод.Выбрать();
		ВыборкаЗапросаКод.Следующий();
		
		Если ВыборкаЗапросаКод.Код<>NULL Тогда
			Код = Формат(Число(ВыборкаЗапросаКод.Код)+1, "ЧГ=0");
		Иначе
			Код = ""+КодНаРельсе+"01";
		КонецЕсли;
		
	Иначе 	//запрос пуст!
		Код = ""+КодНаРельсе+"01";
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции //ОпределитьКодДляНового

