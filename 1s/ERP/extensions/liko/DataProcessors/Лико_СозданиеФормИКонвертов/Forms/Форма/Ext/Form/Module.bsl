&НаСервере
Процедура СоздатьРаспечататьКонверт(ГруппаКонвертов, Тип, Индекс, НаПечать,ТабличныйДокумент) Экспорт
	
	Префикс = ГруппаКонвертов.ПрефиксГруппы;
	
	ПолныйКод = "" + СокрЛП(Префикс) + Формат(Индекс, "ЧЦ=7; ЧН=0000000; ЧВН=; ЧГ=0") + "/" + Формат(Тип, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");
	
	Конверт = Справочники.Лико_Конверты.НайтиПоКоду(ПолныйКод);
	
	Если Не ЗначениеЗаполнено(Конверт) Тогда
		НовыйКонверт = Справочники.Лико_Конверты.СоздатьЭлемент();
		НовыйКонверт.Код = ПолныйКод;
		НовыйКонверт.Наименование = ПолучитьБезПрефикса(ПолныйКод);
		НовыйКонверт.ТипКонверта = Тип;
		НовыйКонверт.Родитель = ГруппаКонвертов;
		НовыйКонверт.Организация = Объект.Организация;
		НовыйКонверт.Площадка = Объект.Площадка;
		НовыйКонверт.Записать();
		
		КонвертОбъект = НовыйКонверт;
		Конверт = НовыйКонверт.Ссылка;
		
	Иначе
		
		КонвертОбъект = Конверт.ПолучитьОбъект();
		
	КонецЕсли;
	
	КоличествоКопий = 1;
	ПечатьКонверта(Конверт, ТабличныйДокумент);
	
	
	
КонецПроцедуры //СоздатьРаспечататьКонверт


Процедура ПечатьКонверта(Конверт,ТабличныйДокумент)
	
	КолонкаКодов = ФормированиеПечатныхФорм.ДополнительнаяКолонкаПечатныхФормДокументов().ИмяКолонки;

	ВыводитьКоды = ЗначениеЗаполнено(КолонкаКодов);
	
	
	
	
	ТабличныйДокумент.ИмяПараметровПечати = "Лико_ПАРАМЕТРЫ_ПЕЧАТИ_Конверт";
	
		
	Макет = Справочники.Лико_Конверты.ПолучитьМакет("ПФ_MXL_СтикерКонверта");
	
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	
	
	//ПервыйДокумент = Истина;	
	//Для Каждого Объект Из МассивОбъектов Цикл 		
	//	Если Не ПервыйДокумент Тогда
	//		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	//	КонецЕсли; 		
	//	ПервыйДокумент = Ложь;
	//	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
	ШКСТрокой = "";
	
	
	ШК = Справочники.Лико_Конверты.ПолучитьШтрихКод(Конверт,ШКСтрокой); //длина штрихкода - 13 (Расшифровка символов в ОбработкаШК)
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("Наименование", Конверт.Наименование);
	
	
	// Выводим шапку
	
	ОбластьШапка.Параметры.ШтрихКодСтрокой = ШКСТрокой;
	
	
		Эталон = Обработки.ПечатьЭтикетокИЦенников.ПолучитьМакет("Эталон");
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
	
	ПараметрыШтрихкода = Новый Структура;
	ПараметрыШтрихкода.Вставить("Ширина",          Окр(ОбластьШапка.Рисунки.КартинкаШтрихкода.Ширина / КоличествоМиллиметровВПикселе));
	ПараметрыШтрихкода.Вставить("Высота",          Окр(ОбластьШапка.Рисунки.КартинкаШтрихкода.Высота / КоличествоМиллиметровВПикселе));
	ПараметрыШтрихкода.Вставить("Штрихкод",        СокрЛП(ШК));
	ПараметрыШтрихкода.Вставить("ТипКода",         4); // Code128
	ПараметрыШтрихкода.Вставить("ОтображатьТекст", Ложь);
	ПараметрыШтрихкода.Вставить("РазмерШрифта",    6);
	
	ОбластьШапка.Рисунки.КартинкаШтрихкода.Картинка = МенеджерОборудованияВызовСервера.ПолучитьКартинкуШтрихкода(ПараметрыШтрихкода);
	

	
	
	
	ОбластьШапка.Параметры.Заполнить(ПараметрыПечати);
	ТабличныйДокумент.Вывести(ОбластьШапка);
 	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ПолеСлева 	= 1;
	ТабличныйДокумент.ПолеСправа	= 0;
	ТабличныйДокумент.ПолеСнизу 	= 0;
	ТабличныйДокумент.ПолеСверху 	= 1;
	
	ИмяПринтера = СокрЛП(Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ИмяПринтераЭтикеток", ""));
	ТабличныйДокумент.ИмяПринтера = ИмяПринтера; 	
	ТабличныйДокумент.АвтоМасштаб = Истина; 	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьБезПрефикса(Знач КодНомер, УдалятьВедущиеНули=Истина) Экспорт
	
	КодНомер = СокрЛП(КодНомер);
	
	// удаление ведущих букв
	Завершили = Ложь;
	Пока Не Завершили Цикл
		
		Если СтрДлина(КодНомер)=0 Тогда
			Завершили = Истина;
		КонецЕсли;
		
		Символ1 = Лев(КодНомер, 1);
		Если Символ1="0" Или Символ1="1" Или Символ1="2" Или Символ1="3" Или Символ1="4"
			Или Символ1="5"Или Символ1="6" Или Символ1="7" Или Символ1="8" Или Символ1="9" Тогда
			Завершили = Истина;
		КонецЕсли;
		
		Если Не Завершили Тогда
			КодНомер = Сред(КодНомер, 2);
		КонецЕсли;
		
	КонецЦикла;
	
	// удаление ведущих нулей
	Если УдалятьВедущиеНули Тогда
		
		Пока Лев(КодНомер, 1)="0" Цикл
			КодНомер = Сред(КодНомер, 2);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат КодНомер;

КонецФункции // ПолучитьБезПрефиксов()

