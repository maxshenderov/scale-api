Функция КоличествоФормВКонверте(ТекущийКонверт) Экспорт
	
	КоличествоФорм = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВложенныйЗапрос.Форма) КАК КоличествоФорм
	|ИЗ
	|	(ВЫБРАТЬ
	|		Лико_ИсторияДвиженийФормСрезПоследних.Период КАК Период,
	|		Лико_ИсторияДвиженийФормСрезПоследних.Регистратор КАК Регистратор,
	|		Лико_ИсторияДвиженийФормСрезПоследних.НомерСтроки КАК НомерСтроки,
	|		Лико_ИсторияДвиженийФормСрезПоследних.Активность КАК Активность,
	|		Лико_ИсторияДвиженийФормСрезПоследних.Организация КАК Организация,
	|		Лико_ИсторияДвиженийФормСрезПоследних.Форма КАК Форма,
	|		Лико_ИсторияДвиженийФормСрезПоследних.Расположение КАК Расположение,
	|		Лико_ИсторияДвиженийФормСрезПоследних.Ответственный КАК Ответственный
	|	ИЗ
	|		РегистрСведений.Лико_ИсторияДвиженийФорм.СрезПоследних КАК Лико_ИсторияДвиженийФормСрезПоследних
	|	ГДЕ
	|		Лико_ИсторияДвиженийФормСрезПоследних.Расположение = &Конверт) КАК ВложенныйЗапрос";
	Запрос.УстановитьПараметр("Конверт", ТекущийКонверт);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаЗапроса = РезультатЗапроса.Выбрать();
		ВыборкаЗапроса.Следующий();
		
		КоличествоФорм = ВыборкаЗапроса.КоличествоФорм;
	Иначе 	//запрос пуст!
	КонецЕсли;
	
	
	Возврат КоличествоФорм;
	
КонецФункции //КоличествоФормВКонверте Экспорт

