		ВыборкаЗапросаКонверты.Следующий();
		
		ГруппаКонвертов = ВыборкаЗапросаКонверты.Ссылка;
		
	Иначе 	//запрос пуст!
	КонецЕсли;
	

КонецПроцедуры

&НаКлиенте
Процедура ПлощадкаПриИзменении(Элемент)
	ПлощадкаПриИзмененииНаСервере();
	
	ОбновлениеОтображенияУПП();

КонецПроцедуры



