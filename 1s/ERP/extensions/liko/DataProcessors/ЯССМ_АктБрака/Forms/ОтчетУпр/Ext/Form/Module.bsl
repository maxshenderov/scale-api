		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.ОписаниеНедостатков) Тогда
	 		Объект.ОписаниеНедостатков = "" + Объект.СсылкаНаОбъект.Дефект + ?(ЗначениеЗаполнено(Объект.СсылкаНаОбъект.ОписаниеДефекта), " (" + Объект.СсылкаНаОбъект.ОписаниеДефекта + ")", "");
		КонецЕсли;
		
		Если Объект.СсылкаНаОбъект.Организация = Справочники.Лико_ПредопределенныеЗначения.ОрганизацияЛикофлекс.ЗначениеПараметра Тогда
			Если НЕ ЗначениеЗаполнено(Объект.ПредседательКомисии) Тогда
				Объект.ПредседательКомисии = Справочники.ФизическиеЛица.НайтиПоНаименованию("Лещев Алексей Анатольевич");
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Объект.НачальникОтделаЗакупок) Тогда
				Объект.НачальникОтделаЗакупок = Справочники.ФизическиеЛица.НайтиПоНаименованию("Буянов Максим Александрович");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	// <-- Конец Лико Ефимов ЕВВ 01.12.2021 
	
КонецПроцедуры


