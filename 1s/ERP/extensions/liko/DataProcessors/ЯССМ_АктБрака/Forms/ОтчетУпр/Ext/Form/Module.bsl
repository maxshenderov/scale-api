	|	Вт.ДатаПриход КАК ДатаПриход,
	|	СУММА(Вт.Количество) КАК Количество,
	|	СУММА(Вт.КоличествоУУ) КАК КоличествоУУ,
	|	СУММА(Вт.КоличествоПриход) КАК КоличествоПриход,
	|	СУММА(Вт.КоличествоПриходУу) КАК КоличествоУУПриход,
	|	Вт.СсылкаПриход КАК СсылкаПриход,
	|	Вт.ВалютаДокумента КАК ВалютаДокумента,
	|	Вт.Лико_ЦенаВключаетНДС КАК Лико_ЦенаВключаетНДС,
	|	СУММА(Вт.СуммаСНДСПриход) КАК СуммаСНДСПриход,
	|	СУММА(Вт.СуммаСНДС) КАК СуммаСНДС,
	|	Вт.ОбъектНоменклатуры.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Вт.Цена КАК Цена
	|ИЗ
	|	Вт КАК Вт
	|
	|СГРУППИРОВАТЬ ПО
	|	Вт.ОбъектНоменклатуры.Номенклатура,
	|	Вт.ОбъектНоменклатуры.Нарезка,
	|	Вт.ОбъектНоменклатуры.Втулка,
	|	Вт.ДатаПриход,
	|	Вт.НомерПриход,
	|	Вт.СсылкаПриход,
	|	Вт.ОбъектНоменклатуры.БазоваяЕдиницаИзмерения,
	|	Вт.ВалютаДокумента,
	|	Вт.Лико_ЦенаВключаетНДС,
	|	Вт.Цена
	|ИТОГИ ПО
	|	ВалютаДокумента";
	
	
	Запрос.УстановитьПараметр("тз", Тз);
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаТТН = РезультатЗапроса.Выгрузить();
	
	ВыборкаВалютаДокумента = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ВозвратТоваровПоставщику_АктПриемкиПоКачеству";
	ТабДокумент.ЭкземпляровНаСтранице=1;
	ТабДокумент.МасштабПечати=89;
	
	ПредседательКомисии=Объект.ПредседательКомисии;
	ГлавныйТехнолог=Объект.ГлавныйТехнолог;
	НачальникОтделаЗакупок=Объект.НачальникОтделаЗакупок;
	
	// Выводим шапку накладной
	
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	//ОбластьМакета.Параметры.Заполнить(Объект.СсылкаНаОбъект);
	ОбластьМакета.Параметры.Организация = Организация;
	
	ФИО			= ПредседательКомисии.Наименование;
	Фамилия		= ВыделитьСлово(ФИО);
	Имя			= ВыделитьСлово(ФИО);
	Отчество	= ВыделитьСлово(ФИО);
	Председатель= Фамилия+" "+Лев(имя,1)+"."+Лев(Отчество,1)+".";
	
	ФИО			=ГлавныйТехнолог.Наименование;
	Фамилия		= ВыделитьСлово(ФИО);
	Имя			= ВыделитьСлово(ФИО);
	Отчество	= ВыделитьСлово(ФИО);
	Технолог    = Фамилия+" "+Лев(имя,1)+"."+Лев(Отчество,1)+".";
	
	ФИО=НачальникОтделаЗакупок.Наименование;
	Фамилия		= ВыделитьСлово(ФИО);
	Имя			= ВыделитьСлово(ФИО);
	Отчество	= ВыделитьСлово(ФИО);
	НачальникОтдела=Фамилия+" "+Лев(имя,1)+"."+Лев(Отчество,1)+".";
	
	ОбластьМакета.Параметры.ПредседательКомиссии=Председатель;
	ОбластьМакета.Параметры.ГлавныйТехнолог=Технолог;
	ОбластьМакета.Параметры.НачальникОтдела=НачальникОтдела;
	
	Руководители = ОтветственныеЛицаБП.ОтветственныеЛица(Организация, Дата);
	Руководитель = Руководители.Руководитель;
	ПредставлениеОтправителя = ФормированиеПечатныхФорм.ОписаниеОрганизации(ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Контрагент, Дата), "ПолноеНаименование, ЮридическийАдрес");
	ПредставлениеОрганизации  = ФормированиеПечатныхФорм.ОписаниеОрганизации(ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Организация, Дата), "ИНН,ЮридическийАдрес,КПП");
	
	ОбластьМакета.Параметры.ПредставлениеОрганизации = ПредставлениеОрганизации;
	ОбластьМакета.Параметры.ПредставлениеОтправителя = ПредставлениеОтправителя;
	ОбластьМакета.Параметры.Заголовок =  "Акт № " + ПолучитьНомерНаПечать(Объект.СсылкаНаОбъект) + " от " + Формат(ДатаФормированияАктаБрака, "ДФ='дд ММММ гггг'");
	ОбластьМакета.Параметры.НомерФормы = НомерФормы;
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	// Вывести табличную часть ТТН
	ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТТН");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТТН");
	
	// ТТН
	ТаблицаТТН.Свернуть("СсылкаПриход, НомерПриход, ДатаПриход");
	
	Для Каждого СтрокаТТН Из ТаблицаТТН Цикл
		Если ЗначениеЗаполнено(СтрокаТТН.ДатаПриход) Тогда
			ОбластьМакета.Параметры.НомерДата = "" + СтрокаТТН.НомерПриход + " от " + Формат(СтрокаТТН.ДатаПриход,"ДЛФ=Д");
			ОбластьМакета.Параметры.СсылкаПриход = СтрокаТТН.СсылкаПриход;
			ТабДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
	КонецЦикла;
	
	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаТаблицы");
	ИтогоСумма = 0;
	ИтогоКоличество = 0;
	Ном      = 0;
	
	// Товары
	Пока ВыборкаВалютаДокумента.Следующий() Цикл
		
		// Вывести табличную часть  возврата
		ОбластьШапкиТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
		ОбластьШапкиТаблицы.Параметры.Валюта = ВыборкаВалютаДокумента.ВалютаДокумента;
		ТабДокумент.Вывести(ОбластьШапкиТаблицы);
		
		ИтогоКоличество = 0;
		ВыборкаСтрокТовары = ВыборкаВалютаДокумента.Выбрать();
		
		Пока ВыборкаСтрокТовары.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(ВыборкаСтрокТовары.Номенклатура) Тогда
				Сообщить("В одной из строк не заполнено значение номенклатуры - строка при печати пропущена.", СтатусСообщения.Важное);
				Продолжить;
			КонецЕсли;
			
			Ном = Ном + 1;
			
			ОбластьМакета.Параметры.Заполнить(ВыборкаСтрокТовары);
			
			ОбластьМакета.Параметры.НомерСтроки = Ном;
			ОбластьМакета.Параметры.Товар       = СокрЛП(ВыборкаСтрокТовары.Номенклатура.НаименованиеПолное) + " (" + ВыборкаСтрокТовары.Номенклатура.Артикул + ")";
			
			ТабДокумент.Вывести(ОбластьМакета);
			ИтогоСумма = ИтогоСумма + ВыборкаСтрокТовары.СуммаСНДС;
			ИтогоКоличество = ИтогоКоличество + ВыборкаСтрокТовары.Количество;
		КонецЦикла;
		
	КонецЦикла;	
	
	ОбластьМакета = Макет.ПолучитьОбласть("Итого");
	ОбластьМакета.Параметры.ИтогоКоличество = ИтогоКоличество;
	ОбластьМакета.Параметры.ИтогоСумма = ИтогоСумма;
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	// Вывести подписи
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьМакета.Параметры.ОписаниеНедостатков=Объект.ОписаниеНедостатков;
	ОбластьМакета.Параметры.ПредседательКомиссии=Председатель;
	ОбластьМакета.Параметры.ГлавныйТехнолог=Технолог;
	ОбластьМакета.Параметры.НачальникОтдела=НачальникОтдела;
	
	ТабДокумент.Вывести(ОбластьМакета);
	
КонецФункции

// Функция выделяет первое слово в предложении
Функция ВыделитьСлово(ИсходнаяСтрока) Экспорт
	
	Буфер = СокрЛ(ИсходнаяСтрока);
	ПозицияПослПробела = Найти(Буфер, " ");
	
	Если ПозицияПослПробела = 0 Тогда
		ИсходнаяСтрока = "";
		Возврат Буфер;
	КонецЕсли;
	
	ВыделенноеСлово = СокрЛП(Лев(Буфер, ПозицияПослПробела));
	ИсходнаяСтрока = Сред(ИсходнаяСтрока, ПозицияПослПробела + 1);
	
	Возврат ВыделенноеСлово;
	
КонецФункции



// Процедура предназначена для преобразования номера документа.
//
// Параметры:
//  Документ - (ДокументСсылка), документ, чей номер надо получить для печати.
//
// Возвращаемое значение.
//  Строка - номер документа для печати
//
Функция ПолучитьНомерНаПечать(Документ, МассивПрефиксов = Неопределено) Экспорт
	
	Если Документ = Неопределено Тогда 
		Возврат 0;
	КонецЕсли;
	
	Номер   = СокрЛП(Документ.Номер);
	Префикс = "";
	Если МассивПрефиксов = Неопределено Тогда
		
		Организация = Неопределено;
		
		Если ТипЗнч(Документ) = Тип("ВыборкаИзРезультатаЗапроса")
			ИЛИ ТипЗнч(Документ) = Тип("Структура") Тогда
			
			Организация = Документ.Организация;
			
		Иначе
			
			МетаданныеДокумента = Документ.Метаданные();
			
			Если МетаданныеДокумента.Реквизиты.Найти("Организация") <> Неопределено Тогда
				
				Организация = Документ.Организация;
				
			КонецЕсли;
			
		КонецЕсли;
		
		МассивПрефиксовДляОбхода = СформироватьМассивПрефиксовДляРИБИОрганизации(Организация)
		
	Иначе
		
		МассивПрефиксовДляОбхода = МассивПрефиксов;
		
	КонецЕсли;
	
	Для Каждого ТекущийПрефикс ИЗ МассивПрефиксовДляОбхода Цикл
		
		// удаление префикса из номера документа
		Если Найти(Номер, ТекущийПрефикс)=1 Тогда 
			Номер = Сред(Номер, СтрДлина(ТекущийПрефикс)+1);
		КонецЕсли;
		
		// так же, может остаться "минус" впереди
		Если Лев(Номер, 1) = "-" Тогда
			Номер = Сред(Номер, 2);
		КонецЕсли;
		
		// удаление ведущих нулей
		Пока Лев(Номер, 1)="0" Цикл
			Номер = Сред(Номер, 2);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Номер;
	
КонецФункции // ПолучитьНомерНаПечать()


Функция СформироватьМассивПрефиксовДляРИБИОрганизации(Организация) Экспорт
	
	МассивПрефиксов = ПолучитьМассивПрефиксовРИБ();	
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		Префикс = СокрЛП(Организация.Префикс);
		
		Если Префикс <> "" Тогда
			МассивПрефиксов.Добавить(Префикс);
		КонецЕсли;
		
	КонецЕсли;
	
	Если МассивПрефиксов.Количество() = 0 Тогда
		МассивПрефиксов.Добавить("");
	КонецЕсли;
	
	Возврат МассивПрефиксов;
	
КонецФункции


Функция ПолучитьМассивПрефиксовРИБ()
	
	МассивПрефиксов = Новый Массив();
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ Различные
	|	ПрефиксыИнформационныхБаз.Префикс КАК Префикс
	|ИЗ
	|	Справочник.Организации КАК ПрефиксыИнформационныхБаз";
	
	ВыборкаУзлов = Запрос.Выполнить().Выбрать();
	Пока ВыборкаУзлов.Следующий() Цикл
		
		Если Не ПустаяСтрока(ВыборкаУзлов.Префикс) Тогда
			
			МассивПрефиксов.Добавить(ВыборкаУзлов.Префикс);
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат МассивПрефиксов;
	
КонецФункции

&НаСервере
