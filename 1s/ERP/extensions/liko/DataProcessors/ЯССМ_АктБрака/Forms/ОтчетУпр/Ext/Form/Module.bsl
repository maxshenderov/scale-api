&НаСервере
Функция НайтиПриходныйОрдер(Серия) //+Лико m.shenderov 14.02.2019  
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТоварыВЯчейках.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках КАК ТоварыВЯчейках
	|ГДЕ
	|	ТоварыВЯчейках.Серия = &Серия
	|	И (ТоварыВЯчейках.Регистратор.Распоряжение ССЫЛКА Документ.ЗаказПоставщику
	|			ИЛИ ТоварыВЯчейках.Регистратор.Распоряжение ССЫЛКА Документ.ПриобретениеТоваровУслуг
	|			ИЛИ ТоварыВЯчейках.Регистратор ССЫЛКА Документ.Лико_БланкЭтапа)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыВЯчейках.Период";
	Запрос.УстановитьПараметр("Серия",Серия );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.Регистратор)=Тип("ДокументСсылка.ПриходныйОрдерНаТовары") и 
			(ТипЗнч(Выборка.Регистратор.Распоряжение)=Тип("ДокументСсылка.ЗаказПоставщику")
			Или ТипЗнч(Выборка.Регистратор.Распоряжение)=Тип("ДокументСсылка.ПриобретениеТоваровУслуг")) Тогда
			Возврат Выборка.Регистратор;			
		ИначеЕсли   ТипЗнч(Выборка.Регистратор)=Тип("ДокументСсылка.Лико_БланкЭтапа") Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Лико_БланкЭтапаТовары.Серия КАК Серия
			|ИЗ
			|	Документ.Лико_БланкЭтапа.Товары КАК Лико_БланкЭтапаТовары
			|ГДЕ
			|	Лико_БланкЭтапаТовары.Списать
			|	И Лико_БланкЭтапаТовары.Ссылка = &Ссылка
			|	И Лико_БланкЭтапаТовары.Номенклатура = &Номенклатура";
			Запрос.УстановитьПараметр("Ссылка",Выборка.Регистратор );
			Запрос.УстановитьПараметр("Номенклатура",Серия.ЯССМ_ОбъектНоменклатуры.Номенклатура);
			
			РезультатЗапроса2 = Запрос.Выполнить();
			Выборка2 = РезультатЗапроса2.Выбрать();
			Пока Выборка2.Следующий() Цикл
				Если Серия=Выборка2.Серия Тогда
					Возврат Неопределено;
				КонецЕсли;
				Возврат	НайтиПриходныйОрдер(Выборка2.Серия);
			КонецЦикла;			
		КонецЕсли;		
	КонецЦикла; 	
КонецФункции  //-Лико m.shenderov 14.02.2019

&НаСервере
Функция ПолучитьПоступлениеТоваров(СтрокаТз,ПриходныйОрдер);   //+Лико m.shenderov 14.02.2019
	Структура = Новый Структура;
	Структура.Вставить("Цена");
	Структура.Вставить("НомерПриход");
	Структура.Вставить("ДатаПриход");
	Структура.Вставить("Валюта");
	Структура.Вставить("ЦенаВключаетНДС");
	
	
	
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Лико_ТоварыКПоступлению.Регистратор КАК ДокументПоступления
	|ПОМЕСТИТЬ ВтПоступление
	|ИЗ
	|	РегистрНакопления.Лико_ТоварыКПоступлению КАК Лико_ТоварыКПоступлению
	|ГДЕ
	|	Лико_ТоварыКПоступлению.ПриходныйОрдер = &ПриходныйОрдер
	|	И Лико_ТоварыКПоступлению.Номенклатура = &Номенклатура
	|	И Лико_ТоварыКПоступлению.Регистратор ССЫЛКА Документ.ПриобретениеТоваровУслуг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПриобретениеТоваровУслугТовары.Цена КАК Цена,
	|	ПриобретениеТоваровУслугТовары.Ссылка.ДатаВходящегоДокумента КАК ДатаПриход,
	|	ПриобретениеТоваровУслугТовары.Ссылка.НомерВходящегоДокумента КАК НомерПриход,
	|	ПриобретениеТоваровУслугТовары.Ссылка.Валюта КАК Валюта,
	|	ПриобретениеТоваровУслугТовары.Ссылка.ЦенаВключаетНДС КАК ЦенаВключаетНДС
	|ИЗ
	|	ВтПоступление КАК ВтПоступление
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
	|		ПО ВтПоступление.ДокументПоступления = ПриобретениеТоваровУслугТовары.Ссылка";
	Запрос.УстановитьПараметр("ПриходныйОрдер",ПриходныйОрдер );
	Запрос.УстановитьПараметр("Номенклатура",СтрокаТз.Номенклатура );
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(Структура,Выборка);	
		
		
	КонецЦикла; 
	
	Возврат Структура;	
	
	
КонецФункции  //-Лико m.shenderov 14.02.2019






&НаСервере
Процедура ЗаполнитьЦенуПоПоступлению(СтрокаТз,ПриходныйОрдер=Неопределено) //+Лико m.shenderov 13.02.2019
	Если Не ЗначениеЗаполнено(ПриходныйОрдер) Тогда
		ПриходныйОрдер=НайтиПриходныйОрдер(СтрокаТз.Серия);
		Если ЗначениеЗаполнено(ПриходныйОрдер) Тогда  	
			ЗаполнитьЦенуПоПоступлению(СтрокаТз,ПриходныйОрдер);  			
		КонецЕсли;
	Иначе
		ЗаполнитьЗначенияСвойств(СтрокаТз,ПолучитьПоступлениеТоваров(СтрокаТз,ПриходныйОрдер));		
	КонецЕсли;
	
	
	
КонецПроцедуры  //-Лико m.shenderov 13.02.2019



Функция ПечатьАкта(ТабДокумент) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Если ЕстьПодпись Тогда
		Макет = ОбработкаОбъект.ПолучитьМакет("МакетСПодисью");
	Иначе
		Макет = ОбработкаОбъект.ПолучитьМакет("Макет");
	КонецЕсли;
	
	НомерФормы = "";
	Если ТипЗнч(Объект.СсылкаНаОбъект) = Тип("ДокументСсылка.Лико_ПередачаТоваров") Тогда
		Тз=Объект.СсылкаНаОбъект.Товары.Выгрузить();
		Организация = Объект.СсылкаНаОбъект.Организация;
		Дата = Объект.СсылкаНаОбъект.Дата;
		ДатаФормированияАктаБрака = Объект.СсылкаНаОбъект.ДатаФормированияАктаБрака;
		Контрагент = Объект.СсылкаНаОбъект.Контрагент;
	ИначеЕсли ТипЗнч(Объект.СсылкаНаОбъект) = Тип("ДокументСсылка.Лико_ЗабраковкаМатериалов") Тогда
		Тз=Объект.СсылкаНаОбъект.Материалы.Выгрузить();
		Тз.Колонки.Добавить("КоличествоУпаковок", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,3)));
		//Тз.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15,2)));
		Для каждого Строка из ТЗ Цикл
			Строка.КоличествоУпаковок = Строка.Количество;
			Строка.Количество = Строка.МетражКВМ;
			Строка.Цена = 0;
		КонецЦикла;		
		НомерФормы = "Ф-07";
		Организация = Объект.СсылкаНаОбъект.Организация;
		Дата = Объект.СсылкаНаОбъект.Дата;
		ДатаФормированияАктаБрака = Объект.СсылкаНаОбъект.ДатаВыставленияПретензии;
		Контрагент = Объект.СсылкаНаОбъект.Поставщик;
	Иначе
		Сообщить("Тип документа """ + ТипЗнч(Объект.СсылкаНаОбъект) + """ не предусмотрен разработчиками");
		Возврат Неопределено;
	КонецЕсли;
	
	
	
	
	Запрос = Новый Запрос;
	
	Тз.Колонки.Добавить("НомерПриход",Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(15, ДопустимаяДлина.Переменная)));
	Тз.Колонки.Добавить("ДатаПриход",Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Тз.Колонки.Добавить("Валюта",Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	Тз.Колонки.Добавить("ЦенаВключаетНДС",Новый ОписаниеТипов("Булево"));
	
	Для каждого СтрокаТз Из Тз Цикл
		ЗаполнитьЦенуПоПоступлению(СтрокаТз);
	КонецЦикла;
	
	Запрос.Текст = 
	//"ВЫБРАТЬ
	//|	Тз_Цены.НомерПриход КАК НомерПриход,
	//|	Тз_Цены.Серия КАК Серия,
	//|	Тз_Цены.ДатаПриход КАК ДатаПриход,
	//|	Тз_Цены.Цена КАК Цена,
	//|	Тз_Цены.Валюта КАК Валюта,
	//|	Тз_Цены.ЦенаВключаетНДС КАК ЦенаВключаетНДС
	//|ПОМЕСТИТЬ ВтЦены
	//|ИЗ
	//|	&Тз КАК Тз_Цены
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	Лико_ПередачаТоваровТовары.Серия КАК Серия,
	//|	Лико_ПередачаТоваровТовары.Серия.ЯССМ_ОбъектНоменклатуры КАК ОбъектНоменклатуры,
	//|	Лико_ПередачаТоваровТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	//|	Лико_ПередачаТоваровТовары.Количество КАК Количество
	//|ПОМЕСТИТЬ ВтТовар
	//|ИЗ
	//|	Документ.Лико_ПередачаТоваров.Товары КАК Лико_ПередачаТоваровТовары
	//|ГДЕ
	//|	Лико_ПередачаТоваровТовары.Ссылка = &ТекущийДокумент
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	ВтТовар.ОбъектНоменклатуры КАК ОбъектНоменклатуры,
	//|	ВтТовар.КоличествоУпаковок КАК Количество,
	//|	ВтТовар.Количество КАК КоличествоУУ,
	//|	ПриходныйОрдерНаТоварыТовары.КоличествоУпаковок КАК КоличествоПриход,
	//|	ПриходныйОрдерНаТоварыТовары.Количество КАК КоличествоПриходУу,
	//|	ВтЦены.НомерПриход КАК НомерПриход,
	//|	ВтЦены.ДатаПриход КАК ДатаПриход,
	//|	ПриходныйОрдерНаТоварыТовары.Ссылка КАК СсылкаПриход,
	//|	ВтЦены.Валюта КАК ВалютаДокумента,
	//|	ВтЦены.ЦенаВключаетНДС КАК Лико_ЦенаВключаетНДС,
