
&НаКлиенте
Процедура ВыполнитьИнфо(Команда)
	   Структура = Новый Структура;
	   Структура.Вставить("РабочийЦентр",Объект.РабочийЦентр);
	    Структура.Вставить("Заказ",Объект.Заказ);
	ОткрытьФорму("ВнешняяОбработка.ЛикоЗаказИнфо.Форма.Форма",Структура,,,,,,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры
