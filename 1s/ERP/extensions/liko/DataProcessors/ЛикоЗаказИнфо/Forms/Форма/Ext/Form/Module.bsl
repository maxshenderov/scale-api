Функция ДанныеПоРЦ(РабочийЦентр,Заказ)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
|	ЗаказКлиента.НомерБезПрефикса КАК Номер,
|	ЗаказКлиента.Контрагент КАК Контрагент,
|	Лико_ПараметрыПроизводстваЗаказа.НомерВарианта КАК НомерВарианта,
|	ЗаказКлиента.Z КАК Z,
|	ЗаказКлиента.Нарезка КАК Нарезка,
|	ЗаказКлиента.ШтампВырубной.Артикул КАК Оснастка,
|	ЗаказКлиента.МетражПМ КАК Метраж,
|	Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр КАК РабочийЦентр,
|	ЗаказКлиента.ДатаОтгрузки КАК СрокСдачи,
|	ПооперационноеРасписание2_2.Начало КАК ДатаНачала,
|	ПооперационноеРасписание2_2.Окончание КАК ДатаОкончания,
|	ЗаказКлиента.Ссылка КАК Заказ,
|	Лико_ПараметрыПроизводстваЗаказа.НомерПроката КАК НомерПередела,
|	Лико_ПараметрыПроизводстваЗаказа.ВремяПечати + Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку+Лико_ПараметрыПроизводстваЗаказа.ВремяНаСменуРоликов КАК ВремяИзготовления,
|	ВЫБОР
|		КОГДА ПооперационноеРасписание2_2.Выполняется > 0
|			ТОГДА ИСТИНА
|		ИНАЧЕ ЛОЖЬ
|	КОНЕЦ КАК Выполняется,
|	ЗаказКлиента.Трафарет КАК Тр,
|	Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр.ВидРабочегоЦентра КАК ТипРЦ,
|	ЗаказКлиента.Этикетки КАК Этикетки1,
|	ЗаказКлиента.ШагПечати КАК ШагПечати,
|	Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку КАК ВремяНаНастройку
|ИЗ
|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
|		ПО Лико_ПараметрыПроизводстваЗаказа.Заказ = ЗаказКлиента.Ссылка
|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПооперационноеРасписание2_2 КАК ПооперационноеРасписание2_2
|		ПО Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр.ВидРабочегоЦентра = ПооперационноеРасписание2_2.РабочийЦентр.ВидРабочегоЦентра
|			И Лико_ПараметрыПроизводстваЗаказа.Заказ = ПооперационноеРасписание2_2.Этап.Распоряжение.ДокументОснование
|ГДЕ
|	Лико_ПараметрыПроизводстваЗаказа.Заказ = &Заказ
|	И Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр.ВидРабочегоЦентра = &ВидРабочегоЦентра";
		
			
	Запрос.УстановитьПараметр("РабочийЦентр",РабочийЦентр );
	Запрос.УстановитьПараметр("ВидРабочегоЦентра",РабочийЦентр.ВидРабочегоЦентра );

	Запрос.УстановитьПараметр("Заказ",Заказ );
    Запрос.УстановитьПараметр("ДатаКонтроляМатериала",ТекущаяДата());

	                          
	Возврат Запрос.Выполнить().Выгрузить();

	
	
	
	
	
	
	
	
