&НаСервере
Процедура НомерВариантаПриИзменении(Элемент)
	Спецификация		=Объект.Спецификация;
	НомерВарианта		=Объект.НомерВарианта;
	НомерПередела		=Объект.НомерПередела;
	Заказ				=Объект.Заказ;
	Вариант				=Объект.Вариант;

	Если Значениезаполнено(Элемент.Значение) Тогда
		Если Элемент.Значение>Вариант Тогда
			НомерВарианта = Вариант;
		Иначе
			НомерВарианта = Элемент.Значение;
		КонецЕсли;
		ПоказатьЦветаРаботы();
        ЗаполнитьРасчетныеПараметры();

	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура  ЗаполнитьРасчетныеПараметры()
	Спецификация		=Объект.Спецификация;
	НомерВарианта		=Объект.НомерВарианта;
	НомерПередела		=Объект.НомерПередела;
	Заказ				=Объект.Заказ;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(СпецификацииНоменклатурыПараметрыШтампа.ШтампВырубной.Артикул, """") КАК ШтампВырубной,
	|	ЕСТЬNULL(СпецификацииНоменклатурыПараметрыШтампа.ШиринаРулона, ЗНАЧЕНИЕ(справочник.ЯССМ_Нарезки.пустаяссылка)) КАК Нарезка,
	|	ЕСТЬNULL(СпецификацииНоменклатурыПараметрыШтампа.Z, ЗНАЧЕНИЕ(Справочник.Лико_ZКоличествоЗубьев.ПустаяСсылка)) КАК Z,
	|	ЕСТЬNULL(СпецификацииНоменклатурыПараметрыШтампа.ШагПечати, 0) КАК ШагПечати,
	|	ЕСТЬNULL(СпецификацииНоменклатурыПараметрыШтампа.ШтампВырубной, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Оснастка
	|ИЗ
	|	Справочник.СпецификацииНоменклатуры.ПараметрыШтампа КАК СпецификацииНоменклатурыПараметрыШтампа
	|ГДЕ
	|	СпецификацииНоменклатурыПараметрыШтампа.Ссылка = &спецификация
	|	И СпецификацииНоменклатурыПараметрыШтампа.НомерВарианта = &номерварианта";
	Запрос.УстановитьПараметр("Спецификация", Спецификация);
	Запрос.УстановитьПараметр("НомерВарианта", НомерВарианта);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	ШтампВырубной = Результат.ШтампВырубной;
	Z = Результат.Z;
	ШагПечати = Результат.ШагПечати;
	Нарезка = Результат.Нарезка;
	Оснастка = Результат.Оснастка;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(Лико_ПараметрыПроизводстваЗаказа.МетрыНаНастройку) КАК МетрыНаНастройку,
		|	МАКСИМУМ(Лико_ПараметрыПроизводстваЗаказа.МетрыНаБрак) КАК МетрыНаБрак,
		|	МАКСИМУМ(Лико_ПараметрыПроизводстваЗаказа.ВремяПечати) КАК ВремяПечати,
		|	МАКСИМУМ(Лико_ПараметрыПроизводстваЗаказа.ВремяНаНастройку) КАК ВремяНаНастройку,
		|	МАКСИМУМ(Лико_ПараметрыПроизводстваЗаказа.СкоростьПечати) КАК СкоростьПечати,
		|	МАКСИМУМ(Лико_ПараметрыПроизводстваЗаказа.МетражДляРЦ) КАК МетражДляРЦ
		|ИЗ
		|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
		|ГДЕ
		|	Лико_ПараметрыПроизводстваЗаказа.Заказ = &Заказ
		|	И Лико_ПараметрыПроизводстваЗаказа.Спецификация = &Спецификация
		|	И Лико_ПараметрыПроизводстваЗаказа.НомерПередела = 1
		|	И Лико_ПараметрыПроизводстваЗаказа.НомерВарианта = &НомерВарианта";	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Спецификация", Спецификация);
	Запрос.УстановитьПараметр("НомерВарианта", НомерВарианта);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий(); 
	
	ВремяНанастройкуЧас = Цел(Результат.ВремяНанастройку/60); 
	ВремяНанастройкуМин =  Результат.ВремяНанастройку-ВремяНанастройкуЧас*60; 
    ВремяНанастройку = Строка(ВремяНанастройкуЧас)+ " ч. "+Строка(ВремяНанастройкуМин)+ " мин.";


	ВремяПечатиЧас = Цел(Результат.ВремяПечати/60); 
	ВремяПечатиМин =  Результат.ВремяПечати-ВремяПечатиЧас*60; 
    ВремяПечати = Строка(ВремяПечатиЧас)+ " ч. "+Строка(ВремяПечатиМин)+ " мин.";

	ВремяИзготовления = Результат.ВремяПечати+Результат.ВремяНаНастройку;
	ВремяВыпЗаказаЧас = Цел(ВремяИзготовления/60); 
	ВремяВыпЗаказаМин = ВремяИзготовления-ВремяВыпЗаказаЧас*60; 
    ВремяИзготовления = Строка(ВремяВыпЗаказаЧас)+ " ч. "+Строка(ВремяВыпЗаказаМин)+ " мин.";
    

	
КонецПроцедуры	

