&НаКлиенте
Процедура НомерВариантаПриИзменении1(Элемент)
		Если Значениезаполнено(Элемент.Значение) Тогда
		Если Элемент.Значение>Объект.Вариант Тогда
			НомерВарианта = Объект.Вариант;
		Иначе
			НомерВарианта = Элемент.Значение;
		КонецЕсли;
		ПоказатьЦветаРаботы();
        ЗаполнитьРасчетныеПараметры();

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НомерВариантаНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	Список = Новый СписокЗначений();
    сч = 1;
	Пока сч <= Объект.вариант Цикл
		Список.Добавить(сч);
		сч =сч+1;
	КонецЦикла;

	РезультатВыбора = ВыбратьИзСписка(Список, Элементы.НомерВарианта);
                                                                                              
	Если РезультатВыбора <> Неопределено Тогда

		НомерВарианта                          = РезультатВыбора.Значение;
        ПоказатьЦветаРаботы();
        ЗаполнитьРасчетныеПараметры();
	КонецЕсли;

КонецПроцедуры







