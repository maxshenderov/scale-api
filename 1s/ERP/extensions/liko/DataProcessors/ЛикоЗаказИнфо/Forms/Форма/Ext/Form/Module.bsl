&НаСервере
Процедура Заполнить(ТекСтрока) Экспорт
	Заказ = Текстрока.Заказ;
	Объект.Заказ = текСтрока.Заказ;
	Объект.НомерЗаказа  = Прав(Заказ.Номер,7);
	//Объект.Спецификация = текСтрока.Спецификация;
	Объект.НомерПередела = текСтрока.НомерПередела;
    Объект.РабочийЦентр = текСтрока.РабочийЦентр;

	Если ЗначениеЗаполнено(текСтрока.НомерВарианта) Тогда
		Объект.НомерВарианта = текСтрока.НомерВарианта;
	Иначе
		Объект.НомерВарианта = 1;
	КонецЕсли;
	
	Запрос = новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ  РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(Лико_ЗагрузкаРабочихЦентров.ВремяНаНастройку, 0) КАК ВремяНаНастройку
	|ИЗ
	|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ЗагрузкаРабочихЦентров
	|ГДЕ
	|	Лико_ЗагрузкаРабочихЦентров.Заказ = &Заказ
	|	И Лико_ЗагрузкаРабочихЦентров.НомерПроката = &НомерПередела";
	
	Запрос.УстановитьПараметр("Заказ", ТекСтрока.Заказ);
	Запрос.УстановитьПараметр("НомерПередела", ТекСтрока.НомерВарианта);
	
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();

	
	
	Объект.СрокСдачи = текСтрока.СрокСдачи;
	Если  Текстрока.НомерПередела = 1 Тогда
		Объект.ТехнологическаяОперация = "ПервыйПрокат";
	ИначеЕсли Текстрока.НомерПередела = 2 Тогда
		Объект.ТехнологическаяОперация = "ВторойПрокат2";
	КонецЕсли;
	Объект.Контрагент = ТекСтрока.контрагент;
	Объект.Менеджер = Заказ.Ответственный;
	ФизЛицо = Заказ.Ответственный.ФизическоеЛицо;
	//Если ЗначениеЗаполнено(ФизЛицо) Тогда
	//	Объект.Регион =Лико_Планирование.ПолучитьРегион(ФизЛицо) ;
	//КонецЕсли;
    Объект.ВидЗаказа = Заказ.ВидЗаказа;
    ВремяВыпЗаказаЧас = Цел(ТекСтрока.ВремяИзготовления/60); 
	ВремяВыпЗаказаМин =  ТекСтрока.ВремяИзготовления-ВремяВыпЗаказаЧас*60; 
    Объект.ВремяИзготовления = Строка(ВремяВыпЗаказаЧас)+ " ч. "+Строка(ВремяВыпЗаказаМин)+ " мин.";
    
	ВремяНанастройкуЧас = Цел(ТекСтрока.ВремяНанастройку/60); 
	ВремяНанастройкуМин =  ТекСтрока.ВремяНанастройку-ВремяНанастройкуЧас*60; 
    Объект.ВремяНанастройку = Строка(ВремяНанастройкуЧас)+ " ч. "+Строка(ВремяНанастройкуМин)+ " мин.";

	ВремяПечати = ТекСтрока.ВремяИзготовления- ТекСтрока.ВремяНанастройку;
	ВремяПечатиЧас = Цел(ВремяПечати/60); 
	ВремяПечатиМин =  ВремяПечати-ВремяПечатиЧас*60; 
    Объект.ВремяПечати = Строка(ВремяПечатиЧас)+ " ч. "+Строка(ВремяПечатиМин)+ " мин.";
	
	Объект.Метраж =  ТекСтрока.Метраж;
	Объект.Z =  ТекСтрока.Z;
    Объект.Нарезка =  ТекСтрока.Нарезка;
	//Объект.Шагпечати =  ТекСтрока.Метраж;
	Объект.Штампвырубной =  ТекСтрока.Оснастка;

	//Объект.ОсновнойМатериал =  ТекСтрока.Спецификация.ОсновнойМатериал; 
	
	
