&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("РабочийЦентр") Тогда
		Объект.РабочийЦентр=Параметры.РабочийЦентр;
	КонецЕсли;
	
	Если Параметры.Свойство("Заказ") Тогда
		Объект.Заказ=Параметры.Заказ;
	КонецЕсли;

	
	
	Данные= ДанныеПоРЦ(Объект.РабочийЦентр,Объект.Заказ)[0];
     	Заполнить(Данные);

	
	ПоказатьЦветаРаботы();
	Объект.Вариант = КоличествоВариантов(Объект.Спецификация);
	Если ЗначениеЗаполнено(Объект.Заказ) Тогда 
		Объект.Повтор = Объект.Заказ.ПовторЗаказа.НомерБезПрефикса;
	КонецЕсли;	

			
	
КонецПроцедуры  



&НаСервере 
Процедура ПоказатьЦветаРаботы()
	Спецификация		=Объект.Спецификация;
	НомерВарианта		=Объект.НомерВарианта;
	НомерПередела		=Объект.НомерПередела;
	Заказ				=Объект.Заказ;
	
	Запрос = Новый Запрос;
	Запрос.Текст=
	 "ВЫБРАТЬ
	 |	ВЫБОР
	 |		КОГДА ЗаказКлиентаЦвета.НомерСтроки = ВложенныйЗапрос.НомерСтроки
	 |			ТОГДА 1
	 |		ИНАЧЕ ЗаказКлиентаЦвета.НомерСтроки - ВложенныйЗапрос.НомерСтроки + 1
	 |	КОНЕЦ КАК Номер,
	 |	ЗаказКлиентаЦвета.ВидПечати КАК ВидПечати,
	 |	ЗаказКлиентаЦвета.ТипЦвета1 КАК ТипЦвета,
	 |	ЗаказКлиентаЦвета.ТипКраски КАК ТипКраски,
	 |	ЗаказКлиентаЦвета.Название КАК Название,
	 |	ЗаказКлиентаЦвета.ПроцентЗаливки КАК ПроцентЗаливки,
	 |	ЗаказКлиентаЦвета.Грамматура КАК Грамматура,
	 |	ЗаказКлиентаЦвета.ЗапечатываемыйМатериал КАК ЗапечатываемыйМатериал,
	 |	ЗаказКлиентаЦвета.Цветоделение КАК Цветоделение,
	 |	ЗаказКлиентаЦвета.Форма.Код КАК Форма
	 |ИЗ
	 |	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	 |			МИНИМУМ(ЗаказКлиентаЦвета.НомерСтроки) КАК НомерСтроки,
	 |			ЗаказКлиентаЦвета.Ссылка КАК Заказ,
	 |			ЗаказКлиентаЦвета.НомерВарианта КАК НомерВарианта
	 |		ИЗ
	 |			Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	 |		ГДЕ
	 |			ЗаказКлиентаЦвета.Ссылка = &Заказ
	 |		
	 |		СГРУППИРОВАТЬ ПО
	 |			ЗаказКлиентаЦвета.Ссылка,
	 |			ЗаказКлиентаЦвета.НомерВарианта) КАК ВложенныйЗапрос
	 |		ПО ЗаказКлиентаЦвета.Ссылка = ВложенныйЗапрос.Заказ
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	ЗаказКлиентаЦвета.НомерСтроки";
	Запрос.УстановитьПараметр("Заказ", Заказ);

	Объект.Цвета.Загрузить(Запрос.Выполнить().Выгрузить());

	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ВЫБОР
	             |		КОГДА ЗаказКлиентаВидыРабот.НомерСтроки = ВложенныйЗапрос.НомерСтроки
	             |			ТОГДА 1
	             |		ИНАЧЕ ЗаказКлиентаВидыРабот.НомерСтроки - ВложенныйЗапрос.НомерСтроки + 1
	             |	КОНЕЦ КАК Ном,
	             |	ЗаказКлиентаВидыРабот.ВидРабот КАК ВидРабот,
	             |	ЗаказКлиентаВидыРабот.РабочийЦентр КАК РабочийЦентр,
	             |	ЗаказКлиентаВидыРабот.Оснастка КАК Оснастка,
	             |	ЗаказКлиентаВидыРабот.Оснастка.Артикул КАК Артикул,
	             |	ЗаказКлиентаВидыРабот.Материал КАК Материал,
	             |	ЗаказКлиентаВидыРабот.Нарезка КАК Нарезка,
	             |	ЗаказКлиентаВидыРабот.Клей КАК Клей,
	             |	ЗаказКлиентаВидыРабот.ПроцентЗаливки КАК Процент,
	             |	ЗаказКлиентаВидыРабот.Дополнительно КАК Дополнительно,
	             |	ЗаказКлиентаВидыРабот.НомерСтроки КАК НомерСтроки
	             |ИЗ
	             |	(ВЫБРАТЬ
	             |		МИНИМУМ(ЗаказКлиентаВидыРабот.НомерСтроки) КАК НомерСтроки,
	             |		ЗаказКлиентаВидыРабот.Ссылка КАК Заказ
	             |	ИЗ
	             |		Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	             |	ГДЕ
	             |		ЗаказКлиентаВидыРабот.Ссылка = &Заказ
	             |	
	             |	СГРУППИРОВАТЬ ПО
	             |		ЗаказКлиентаВидыРабот.Ссылка) КАК ВложенныйЗапрос
	             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	             |		ПО ВложенныйЗапрос.Заказ = ЗаказКлиентаВидыРабот.Ссылка" ;
	
				Запрос.УстановитьПараметр("Заказ", Заказ);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Для каждого колонка из ТЗ.Колонки Цикл
		колонка.Ширина = 15;
	Конеццикла;
	ТЗ.Колонки.Ном.Ширина = 2;
	
	ТЗ.Колонки.Вставить(4, "Машины",, , 40);
	Для каждого стр из ТЗ Цикл
		ЗапросМашины = Новый Запрос;
		ЗапросМашины.Текст = 
			"ВЫБРАТЬ Различные
		|	СпецификацииНоменклатурыМашины.РабочийЦентр.Наименование КАК Наименование,
		|	СпецификацииНоменклатурыМашины.РабочийЦентр.ПорядковыйНомер КАК ПорядковыйНомер
		|ИЗ
		|	Документ.ЗаказКлиента.ВидыРабот КАК СпецификацииНоменклатурыМашины
		|ГДЕ
		|	СпецификацииНоменклатурыМашины.Ссылка = &Ссылка";

		ЗапросМашины.УстановитьПараметр("Ссылка",Спецификация);
	
		ВыборкаМашины = ЗапросМашины.Выполнить().Выбрать();
		стрМашины = "";
		сч = 0;
		Пока ВыборкаМашины.Следующий() Цикл
			Если сч = 0 Тогда 
				стрМашины = стрМашины+ВыборкаМашины.Наименование +"; ";
			Иначе	
				стрМашины = стрМашины+Строка(ВыборкаМашины.ПорядковыйНомер)+"; ";
			КонецЕсли;
			сч = сч+1;
		КонецЦикла;
		
		стр.Машины =стрМашины;
	КонецЦикла;
	

	Объект.ВидыРабот.Загрузить(ТЗ);

	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателяТовары.Номенклатура,
	|	ЗаказПокупателяТовары.ОригиналМакет,
	|	ЗаказПокупателяТовары.Количество,
	|	ЗаказПокупателяТовары.НомерСтроки
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказПокупателяТовары
	|ГДЕ
	|	ЗаказПокупателяТовары.Ссылка = &Заказ";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	Объект.Этикетки.Загрузить(Запрос.Выполнить().Выгрузить());

		
	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СпецификацииНоменклатурыПараметрыШтампа.ШтампВырубной КАК ШтампВырубной,
	|	СпецификацииНоменклатурыПараметрыШтампа.ЭтикетокНаЛисте КАК ЭтикетокНаЛисте,
	|	СпецификацииНоменклатурыПараметрыШтампа.ШиринаРукаваТУ КАК ШиринаРулона,
	|	СпецификацииНоменклатурыПараметрыШтампа.Ручьи КАК Ручьи,
	|	СпецификацииНоменклатурыПараметрыШтампа.Z КАК Z,
	|	СпецификацииНоменклатурыПараметрыШтампа.ШагПечати КАК ШагПечати,
	|	СпецификацииНоменклатурыПараметрыШтампа.ДлинаЭтикетки КАК ДлинаЭтикетки,
	|	СпецификацииНоменклатурыПараметрыШтампа.ШиринаЭтикетки КАК ШиринаЭтикетки,
	|	СпецификацииНоменклатурыПараметрыШтампа.ШтампВырубной.Артикул КАК Артикул
	|ИЗ
	|	Документ.ЗаказКлиента КАК СпецификацииНоменклатурыПараметрыШтампа
	|ГДЕ
	|	СпецификацииНоменклатурыПараметрыШтампа.Ссылка = &Заказ" ;
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	Объект.ПараметрыШтампа.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

