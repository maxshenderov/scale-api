&НаКлиенте
Процедура ДобавитьВДокумент(Команда)
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ПриходныйОрдер=Неопределено;
		Товар=Элементы.Товары.ТекущиеДанные;
		Если Товар<>Неопределено Тогда
			ПриходныйОрдер=Товар.ПриходныйОрдер;
		КонецЕсли;
		Закрыть(ПриходныйОрдер);
	Иначе
		Массив= Новый Массив;
		Для каждого Товар Из Товары Цикл
			Если Товар.Выбрать Тогда
				Структура = Новый Структура;
				Структура.Вставить("Номенклатура",		Товар.Номенклатура);
				Структура.Вставить("Характеристика",	Товар.Характеристика);
				Структура.Вставить("Количество",		Товар.Количество);
				Структура.Вставить("ПриходныйОрдер",		Товар.ПриходныйОрдер);
				Массив.Добавить(Структура);  
				
				
			КонецЕсли;
			
			
			
			
			
		КонецЦикла;
		
		Закрыть(Массив);
	КонецЕсли;
КонецПроцедуры

