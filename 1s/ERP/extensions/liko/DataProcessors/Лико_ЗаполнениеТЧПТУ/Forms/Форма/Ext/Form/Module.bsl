
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Партнер") Тогда
		Партнер=Параметры.Партнер;
	Иначе
		Отказ=Истина;
	КонецЕсли;
	Если Параметры.Свойство("Склад") Тогда
		Склад=Параметры.Склад;
	Иначе
		Отказ=Истина;
	КонецЕсли;

	Если Параметры.Свойство("НоменклатураДокумента") Тогда
		ТоварыДокумента.Очистить();
		МассивНоменклатуры=Параметры.НоменклатураДокумента;
		Для каждого ТоварНоменклатура Из МассивНоменклатуры Цикл
			НовыйТоварДокумента=ТоварыДокумента.Добавить();
			НовыйТоварДокумента.Номенклатура=ТоварНоменклатура.Номенклатура;
			НовыйТоварДокумента.Характеристика=ТоварНоменклатура.Характеристика;			
		КонецЦикла;		
	КонецЕсли;
	Если Параметры.Свойство("Номенклатура") Тогда
		Номенклатура=Параметры.Номенклатура;
	КонецЕсли;
	Если Параметры.Свойство("Характеристика") Тогда
		Характеристика=Параметры.Характеристика;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		
		Элементы.ГруппаНоменклатура.Видимость=Истина;
		Элементы.ГруппаФильтр.Видимость=Ложь;
		Элементы.ТоварыВыбрать.Видимость=Ложь;
		
	Иначе
		Элементы.ГруппаФильтр.Видимость=Истина;
		Элементы.ГруппаНоменклатура.Видимость=Ложь;
		Элементы.ТоварыВыбрать.Видимость=Истина;
		
	КонецЕсли;
	
	ЗаполнитьТаблицуТоваров();	
КонецПроцедуры


