
&НаКлиенте
Процедура ОК(Команда)
	
	
	Структура = Новый Структура;
	Структура.Вставить("НомерПартииИзготовления",НомерПартииИзготовления); 
	Структура.Вставить("ДатаПроизводства",ДатаПроизводства);
	Структура.Вставить("УпотребитьДо",УпотребитьДо);
	Структура.Вставить("ПричинаОтсутствияНомераПартииИзготовления",ПричинаОтсутствияНомераПартииИзготовления);
	Структура.Вставить("ПричинаОтсутствияДатыИзготовления",ПричинаОтсутствияДатыИзготовления);
	
	
	Закрыть(Структура);
	
	
КонецПроцедуры
