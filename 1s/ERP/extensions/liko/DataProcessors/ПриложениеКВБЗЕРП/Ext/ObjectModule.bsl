Функция ПолучитьТабДокЦвета()
	ТабДокумент = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("Макет");
	ОбластьПустая =  Макет.ПолучитьОбласть("ПраваяЧасть|ПустаяСтрЦвета");

	Запрос = новый запрос;
	Запрос.Текст=
			"ВЫБРАТЬ ПЕРВЫЕ 16
			|	ЗаказКлиентаЦвета.ВидПечати КАК ВидПечати,
			|	ЗаказКлиентаЦвета.ТипКраски.Код КАК ТипКраски,
			|	ЗаказКлиентаЦвета.Название КАК Название,
			|	ЗаказКлиентаЦвета.ПроцентЗаливки КАК ПроцентЗаливки,
			|	ЗаказКлиентаЦвета.Грамматура КАК Грамматура,
			|	ВЫБОР
			|		КОГДА ЗаказКлиентаЦвета.Цветоделение = ИСТИНА
			|				ИЛИ ЗаказКлиентаЦвета.Перегравировка = ИСТИНА
			|			ТОГДА ""V""
			|		ИНАЧЕ """"
			|	КОНЕЦ КАК Цветоделение,
			|	ЗаказКлиентаЦвета.ЗапечатываемыйМатериал КАК ЗапечатываемыйМатериал,
			|	ВЫБОР
			|		КОГДА ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.PmcПоФотону)
			|			ТОГДА ""Pmc по фот""
			|		КОГДА ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.PmcПоОбразцу)
			|			ТОГДА ""Pmc по обр""
			|		КОГДА ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.ХолодноеТиснение)
			|			ТОГДА ""Хол тисн""
			|		КОГДА ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.ЛакРазделительный)
			|			ТОГДА ""Лак разд""
			|		КОГДА ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.ВыборочныйЛак)
			|			ТОГДА ""Выб лак""
			|		КОГДА ЗаказКлиентаЦвета.ТипЦвета = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЦвета.РотационныйКонгрев)
			|			ТОГДА ""Рот конгр""
			|		ИНАЧЕ ЗаказКлиентаЦвета.ТипЦвета
			|	КОНЕЦ КАК ТипЦвета,
			|	ЗаказКлиентаЦвета.НомерПроката КАК НомерПроката,
			|	ЗаказКлиентаЦвета.Вал.Артикул КАК Вал,
			|	ЗаказКлиентаЦвета.Форма.Код КАК Форма
			|ИЗ
			|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
			|ГДЕ
			|	ЗаказКлиентаЦвета.Ссылка = &Заказ
			|
			|УПОРЯДОЧИТЬ ПО
			|	ЗаказКлиентаЦвета.НомерСтроки";

	Запрос.УстановитьПараметр("Заказ", Заказ);
   // ТабДокумент.Вывести(ОбластьЗаголовок);
     Выборка = Запрос.Выполнить().Выбрать();
	Сч=0;
	Пока выборка.Следующий() Цикл
		Если Заказ.Цифровой И (Выборка.ВидПечати = Перечисления.Лико_ВидыПечати.Флексо ИЛИ Выборка.ВидПечати = Перечисления.Лико_ВидыПечати.Траф) Тогда  
			ОбластьСтр = Макет.ПолучитьОбласть("ПраваяЧасть|стрЦветаФлексоНаИндиге");
		Иначе
			ОбластьСтр = Макет.ПолучитьОбласть("ПраваяЧасть|СтрЦвета");
		КонецЕсли;	

		//ОбластьСтр = Макет.ПолучитьОбласть("ПраваяЧасть|СтрЦвета");

		ОбластьСтр.Параметры.НомерСтроки = Сч+1;
		ОбластьСтр.Параметры.Заполнить(Выборка);
		Если ТипЗнч(Выборка.Название) <> Тип("ПеречислениеСсылка.Лико_ТипыЦвета") Тогда
			ОбластьСтр.Параметры.Название = Строка(Выборка.ТипЦвета)+" "+Выборка.Название;	
		КонецЕсли;
		ОбластьСтр.Параметры.ТипКраски =СокрЛП(Строка(Выборка.ТипКраски));	

		
		ТабДокумент.Вывести(ОбластьСтр);
		Сч=Сч+1;
	КонецЦикла;
	Пока сч<12 Цикл
		ТабДокумент.Вывести(ОбластьПустая);
		Сч=Сч+1;
	КонецЦикла;
	
	//ТабДокумент.Показать();
    Возврат ТабДокумент;

КонецФункции

Функция ПолучитьКодПостПечатныхработ(Заказ)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЗаказКлиентаВидыРабот.ВидРабот = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.ПечатьСклеящегоСлоя)
	|				ТОГДА 10
	|			КОГДА ЗаказКлиентаВидыРабот.ВидРабот = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Книжка)
	|				ТОГДА 14
	|			КОГДА ЗаказКлиентаВидыРабот.ВидРабот.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Нумерация)
	|				ТОГДА 80
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КодПостпечатныхРабот
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ";
	Запрос.УстановитьПараметр("Заказ",Заказ);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	возврат Результат.Кодпостпечатныхработ;
КонецФункции

Функция ПолучитьТабДокПеремотка(Заказ)
	ТабДокумент = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("Макет");
	ОбластьЗаголовокПеремотка = Макет.ПолучитьОбласть("Заголовок_Перемотка|ПраваяЧасть");
	ОбластьЗаголовокПеремотка.Параметры.ТипВыладки = Заказ.СпособНаклейки;
	ТабДокумент.Вывести(ОбластьЗаголовокПеремотка);
	
	Выборка = ВыборкаПеремотка();	
	сч = 0;
	МаксимальныйДиаметр = 1000000000;
	Пока Выборка.Следующий() Цикл
		ОбластьСтрПеремотка = Макет.ПолучитьОбласть("СтрПеремотка|ПраваяЧасть");
		ОбластьСтрПеремотка.Параметры.Заполнить(Выборка);
		Если МаксимальныйДиаметр>Выборка.МаксимальныйДиаметр Тогда
			МаксимальныйДиаметр = выборка.МаксимальныйДиаметр;			
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Направление) Тогда
			Если ЗначениеЗаполнено(Выборка.Направление.ФайлКартинки) Тогда 
				// Вывод картинки
				//	ОбластьОписаниеКартинка = Макет.ПолучитьОбласть("ОписаниеНамотка");
				Попытка
					УстановитьПривилегированныйРежим(Истина);
					Картинка = РаботаСФайлами.ДвоичныеДанныеФайла(Выборка.Направление.ФайлКартинки);
					УстановитьПривилегированныйРежим(Ложь);
				Исключение
					Картинка = Неопределено; 
				КонецПопытки;
				
				Если ЗначениеЗаполнено(Картинка) Тогда
					Если НЕ Картинка = Неопределено Тогда
						ФотоТовара = ОбластьСтрПеремотка.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
						ФотоТовара.Верх = 0;
						ФотоТовара.Лево = 0;
						ФотоТовара.РазмерКартинки = РазмерКартинки.Пропорционально;
						Если ТипЗнч(Картинка) = Тип("Картинка") Тогда
							ФотоТовара.Картинка = Картинка;
						ИначеЕсли ТипЗнч(Картинка) = Тип("ДвоичныеДанные") Тогда
							ФотоТовара.Картинка =Новый Картинка(Картинка);
						КонецЕсли;
						
						
						ФотоТовара.Расположить(ОбластьСтрПеремотка.Область(1, 24, 2, 28));               
					КонецЕсли;					
				КонецЕсли;	
				
			КонецЕсли;	
		КонецЕсли;
		ТабДокумент.Вывести(ОбластьСтрПеремотка);	
		сч = сч+1;
	КонецЦикла;
	ОбластьПустаяСтрПеремотка = Макет.ПолучитьОбласть("ПустаяСтрПеремотка|ПраваяЧасть");
	
	Возврат ТабДокумент;
	
КонецФункции	

Функция ОпределитьКоличествоКлея(Клей)
	
	Если Клей = "453      " ИЛИ Клей = "454      " Или  Клей = "458      "   ИЛИ Клей = "455      "   ИЛИ  Клей = "457      " ИЛИ Клей = "491      "  Тогда 
		Возврат 18;
	ИначеЕсли Клей = "401      " Тогда 
		Возврат  4;
	ИначеЕсли Клей = "432      "  Тогда
		Возврат  4.5;
	Иначе
		Возврат неопределено;
	КонецЕсли;
		
КонецФункции

