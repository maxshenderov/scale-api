	|	ВЫБОР
	|		КОГДА ЗаказПокупателяТовары.ПродольнаяРезка = ИСТИНА
	|			ТОГДА ""V""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ПродольнаяРезка,
	|	ВЫБОР
	|		КОГДА ЗаказПокупателяТовары.ПоперечнаяРезка = ИСТИНА
	|			ТОГДА ""V""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ПоперечнаяРезка,
	|	ЗаказПокупателяТовары.Кромка КАК Кромка,
	|	ВЫБОР
	|		КОГДА ЗаказПокупателяТовары.ПодрезкаКромки = ИСТИНА
	|			ТОГДА ""V""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ПодрезкаКромки,
	|	ЗаказПокупателяТовары.Направление КАК Направление,
	|	ЗаказПокупателяТовары.Город КАК Город,
	|	ЗаказПокупателяТовары.Номенклатура.Лико_ТипЭтикетки КАК ТипЭтикетки
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказПокупателяТовары
	|ГДЕ
	|	ЗаказПокупателяТовары.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказПокупателяТовары.МаксимальныйДиаметрРулона,
	|	ЗаказПокупателяТовары.ВнутреннийДиаметр,
	|	ВЫБОР
	|		КОГДА ЗаказПокупателяТовары.ПродольнаяРезка = ИСТИНА
	|			ТОГДА ""V""
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЗаказПокупателяТовары.ПоперечнаяРезка = ИСТИНА
	|			ТОГДА ""V""
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ЗаказПокупателяТовары.Кромка,
	|	ВЫБОР
	|		КОГДА ЗаказПокупателяТовары.ПодрезкаКромки = ИСТИНА
	|			ТОГДА ""V""
	|		ИНАЧЕ """"
	|	КОНЕЦ,
	|	ЗаказПокупателяТовары.Направление,
	|	ЗаказПокупателяТовары.Город,
	|	ЗаказПокупателяТовары.КоличествоЭтикетокВРолике + ЗаказПокупателяТовары.ДопЭтикетокВРолике,
	|	ЗаказПокупателяТовары.Номенклатура.Лико_ТипЭтикетки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Количество УБЫВ,
	|	ТипЭтикетки";	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
    Возврат Выборка;
