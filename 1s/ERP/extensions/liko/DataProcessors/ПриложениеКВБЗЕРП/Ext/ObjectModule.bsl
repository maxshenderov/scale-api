Перем Единицы, МаксимальныйДиаметр;

Функция ПечатьПриложениеВБЗ() Экспорт
	
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПечатнаяФормаВнутреннийБланкЗаказа";
	ТабДокумент.ОриентацияСтраницы=ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб=Истина;
	
	Эталон = Обработки.ПечатьЭтикетокИЦенников.ПолучитьМакет("Эталон");
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
	
	Если Заказ.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Термоусадка Тогда 
		Макет = ПолучитьМакет("Макет1");
	Иначе
		Макет = ПолучитьМакет("Макет");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказ", Заказ);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Ссылка КАК Заказ,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиентаТовары.Номенклатура) КАК КоличествоНаименований,
	|	СУММА(ЗаказКлиентаТовары.ДопЭтикетокВРолике) КАК ДопЭтикетокВРолике,
	|	СУММА(ЗаказКлиентаТовары.КоличествоЭтикетокВРолике) КАК КоличествоЭтикетокВРолике
	|ПОМЕСТИТЬ ВТКоличествоНаименований
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиентаВидыРабот.Ссылка КАК Заказ
	|ПОМЕСТИТЬ ВТЦифра
	|ИЗ
	|	Документ.ЗаказКлиента.ВидыРабот КАК ЗаказКлиентаВидыРабот
	|ГДЕ
	|	ЗаказКлиентаВидыРабот.Ссылка = &Заказ
	|	И ЗаказКлиентаВидыРабот.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.indigo)
	|	И ЗаказКлиентаВидыРабот.ВидРабот = ЗНАЧЕНИЕ(Справочник.ВидыРаботСотрудников.Печать)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиента.Дата КАК Дата,
	|	ЗаказКлиента.НомерБезПрефикса КАК НомерЗаказа,
	|	ЗаказКлиента.Версия КАК Версия,
	|	ЗаказКлиента.ТипЗаказа КАК ТипЗаказа,
	|	ЗаказКлиента.ВидЗаказа КАК ВидЗаказа,
	|	ЗаказКлиента.Партнер КАК Партнер,
	|	ЗаказКлиента.Менеджер КАК Менеджер,
	|	ЗаказКлиента.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ЗаказКлиента.Площадка КАК Площадка,
	|	ЗаказКлиента.ПовторЗаказа.НомерБезПрефикса КАК НомерПовторЗаказа,
	|	ЗаказКлиента.НомерЗаказаЭтикеток КАК НомерЗаказаЭтикеток,
	|	ЗаказКлиента.НомерЗаказаКонтрэтикеток КАК НомерЗаказаКонтрэтикеток,
	|	ЗаказКлиента.НомерЗаказаКольереток КАК НомерЗаказаКольереток,
	|	ЗаказКлиента.Тираж * 1000 КАК ТиражШт,
	|	ЗаказКлиента.МетражКВМ КАК МетражКВМ,
	|	ЗаказКлиента.МетражПМ КАК МетражПМ,
	|	ВЫБОР
	|		КОГДА ЗаказКлиента.ОсновнойМатериал ССЫЛКА Справочник.ЦеновыеГруппы
	|			ТОГДА ЗаказКлиента.ОсновнойМатериал.Код
	|		ИНАЧЕ ЗаказКлиента.ОсновнойМатериал.ЦеноваяГруппа.Код
	|	КОНЕЦ КАК ЦГКод,
	|	ВЫБОР
	|		КОГДА ЗаказКлиента.ОсновнойМатериал ССЫЛКА Справочник.ЦеновыеГруппы
	|			ТОГДА ЗаказКлиента.ОсновнойМатериал.Наименование
	|		ИНАЧЕ ЗаказКлиента.ОсновнойМатериал.НаименованиеПолное
	|	КОНЕЦ КАК Материал,
	|	ЗаказКлиента.Ссылка КАК Заказ,
	|	ВТКоличествоНаименований.КоличествоНаименований КАК КоличествоНаименований,
	|	ВЫБОР
	|		КОГДА ЗаказКлиента.БезЛака = ИСТИНА
	|			ТОГДА ""V""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК БезЛака,
	|	ВЫБОР
	|		КОГДА ЗаказКлиента.БезЛака = ИСТИНА
	|			ТОГДА ""Без лака""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НадписьБезЛака,
	|	ЗаказКлиента.Ручьи КАК Ручьи,
	|	ЗаказКлиента.Z КАК Z,
	|	ЗаказКлиента.ШагПечати КАК ШагПечати,
	|	ЗаказКлиента.ДлинаЭтикетки КАК Длина,
	|	ЗаказКлиента.ШиринаЭтикетки КАК Ширина,
	|	ЗаказКлиента.ЭтикетокНаЛисте КАК ЭтикетокНаЛисте,
	|	ЗаказКлиента.Нарезка.Размер / 1000 КАК ШиринаРулона,
	|	ЗаказКлиента.Дизайнер КАК Дизайнер,
	|	ЗаказКлиента.ПоперечнаяРезкаТУ КАК ПоперечнаяРезкаТУ,
	|	ЗаказКлиента.КоличествоЭтикетокВСтопеТУ КАК КоличествоЭтикетокВСтопеТУ,
	|	ЗаказКлиента.ШиринаРукаваТУ КАК ШиринаРукаваТУ,
	|	ЗаказКлиента.ВертикальнаяПерфорацияТУ КАК ВертикальнаяПерфорацияТУ,
	|	ЗаказКлиента.ПоперечнаяПерфорацияТУ КАК ПоперечнаяПерфорацияТУ,
	|	ЗаказКлиента.СуммаДокумента КАК СуммаДокумента,
	|	ЗаказКлиента.ЦветаСтрокой КАК ЦветаСтрокой,
	|	ЗаказКлиента.СтоимостьОснастки КАК СтоимостьОснастки,
	|	ЗаказКлиента.Комментарий КАК Комментарий,
	|	ЗаказКлиента.ВидУпаковки КАК ВидУпаковки,
	|	ЗаказКлиента.КомментарийТехнолога КАК КомментарийТехнолога,
	|	ЗаказКлиента.ШтампВырубной КАК ШтампВырубной,
	|	ЗаказКлиента.ШтампВырубной.Артикул КАК ШтампВырубнойАртикул,
	|	ЗаказКлиента.Регион КАК Регион,
	|	ВЫБОР
	|		КОГДА ЗаказКлиента.ПроверкаШК = ИСТИНА
	|			ТОГДА ""V""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ПроверкаШК,
	|	ВТКоличествоНаименований.ДопЭтикетокВРолике КАК ДопЭтикетокВРолике,
	|	ВТКоличествоНаименований.КоличествоЭтикетокВРолике КАК КоличествоЭтикетокВРолике,
	|	ЗаказКлиента.ХолостойХод КАК ХолостойХод,
	|	ВЫБОР
	|		КОГДА ВТЦифра.Заказ ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК НаличиеЦифры,
	|	ЗаказКлиента.КоличествоКликов КАК КоличествоКликов,
	|	ЗаказКлиента.ДлинаПечати КАК ДлинаПечати,
	|	ЗаказКлиента.ЭтикетокВПлощадиПечати КАК ЭтикетокВПлощадиПечати,
	|	ЗаказКлиента.ОбразецЦвета КАК ОбразецЦвета,
	|	ЗаказКлиента.КонтрольОТК КАК КонтрольОТК
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКоличествоНаименований КАК ВТКоличествоНаименований
	|		ПО ЗаказКлиента.Ссылка = ВТКоличествоНаименований.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦифра КАК ВТЦифра
	|		ПО ЗаказКлиента.Ссылка = ВТЦифра.Заказ
	|ГДЕ
	|	ЗаказКлиента.Ссылка = &Заказ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Заказ = Выборка.Заказ;
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Заполнить(Выборка);
	ОбластьШапка.Параметры.НомерБланка = НомерБланка;
	ОбластьШапка.Параметры.НомерЗаказа = Выборка.НомерЗаказа+" / "+строка(Выборка.Версия);
	ОбластьШапка.Параметры.НомерПриложения = НомерПриложения;


	
	ЗапросЭт  = Новый Запрос;
	ЗапросЭт.Текст = 	
	"ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество,
	|	ЗаказКлиентаТовары.КодЭтикеткиЗаказчика КАК КодЭтикеткиЗаказчика,
	|	ЗаказКлиентаТовары.Номенклатура.Лико_ТипЭтикетки КАК ТипЭтикетки,
	|	ЗаказКлиентаТовары.Номенклатура.Артикул КАК Артикул
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Номенклатура,
	|	ЗаказКлиентаТовары.КодЭтикеткиЗаказчика,
	|	ЗаказКлиентаТовары.Номенклатура.Лико_ТипЭтикетки,
	|	ЗаказКлиентаТовары.Номенклатура.Артикул";
				          //	|	МАКСИМУМ(ЗаказПокупателяТовары.ОригиналМакет) КАК ОригиналМакет

	ЗапросЭт.УстановитьПараметр("Заказ", Заказ);
	
				
		
    ВыборкаНом = ЗапросЭт.Выполнить().Выбрать();

	НазваниеЭтикетки = "";
	Единицы = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	Пока выборкаНом.Следующий() Цикл
		Единицы = выборкаНом.Номенклатура.ЕдиницаИзмерения;
		ВидНом = "";
		Если выборкаНом.ТипЭтикетки = Перечисления.Лико_ТипыЭтикеток.ЭТ Тогда
			ВидНом = " (Эт)";
		ИначеЕсли выборкаНом.ТипЭтикетки = Перечисления.Лико_ТипыЭтикеток.КЭ Тогда
			ВидНом = " (КЭ)";
        ИначеЕсли выборкаНом.ТипЭтикетки = Перечисления.Лико_ТипыЭтикеток.Кльр Тогда
			ВидНом = " (Кл)";				 	
		КонецЕсли;
		Артикул =выборкаНом.Номенклатура.Артикул+" ";

		Если ЗначениеЗаполнено(ВыборкаНом.КодЭтикеткиЗаказчика) Тогда 
			НазваниеЭтикетки = НазваниеЭтикетки+ Артикул+выборкаНом.Номенклатура.Наименование+видном+" * "+выборкаНом.КодЭтикеткиЗаказчика+" * "+ВыборкаНом.Количество*1000+" * " ;
		Иначе
			НазваниеЭтикетки = НазваниеЭтикетки+Артикул+выборкаНом.Номенклатура.Наименование+видном+" * "+ВыборкаНом.Количество*1000+" * " ;
			
		КонецЕсли;
		//+?(ЗначениеЗаполнено(НазваниеЭтикетки), ", ","")
	КонецЦикла;	
	ОбластьШапка.Параметры.НазваниеЭтикетки = НазваниеЭтикетки;
	
	Количество = Выборка.ТиражШт;
	МетражПМ = Выборка.МетражПМ;
	МетражКВМ = Выборка.МетражКВМ;
		
	//Если Выборка.ХолостойХод Тогда 
	//	Если ЗначениеЗаполнено(Выборка.КоличествоЭтикетокВРолике) Тогда 
	//		КоличествоРоликов = Выборка.ТиражШт/Выборка.КоличествоЭтикетокВРолике;
	//		ДопЭтикеток = Выборка.ДопЭтикетокВРолике*КоличествоРоликов;
	//		Количество = Количество+ДопЭтикеток;
	//		МетражПМ =  Лико_Планирование.РассчитатьМетраж(количество,выборка.ЭтикетокНаЛисте, выборка.ШагПечати, выборка.Z);
	//		МетражКВМ =МетражПМ*Выборка.ШиринаРулона;
	//		//СуммаЗаказа_Расчет = Количество/1000*Цена+ Ст_Шт_Клише;				
	//	КонецЕсли;
	//КонецЕсли;	

	
	ОбластьШапка.Параметры.ТиражШт = Количество;
	ОбластьШапка.Параметры.МетражПМ =МетражПМ;
	ОбластьШапка.Параметры.МетражКвМ =МетражКВМ ;
		
		
		
	Если Заказ.ТипЗаказа = Перечисления.Лико_ТипыЗаказов.Термоусадка Тогда 
		ВыборкаПеремотка = ВыборкаПеремотка();
		ВыборкаПеремотка.Следующий();
		МаксимальныйДиаметр = выборкаПеремотка.МаксимальныйДиаметр;	
		
		КоээфициентПеремотки = ПолучитьКоэффициентПеремотки();
		Если ЗначениеЗаполнено(КоээфициентПеремотки) Тогда
			ОбластьШапка.Параметры.КоэффициентПеремотки = КоээфициентПеремотки;
		КонецЕсли;
		ЗапросПараметры = Новый Запрос;
		ЗапросПараметры.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр.Лико_Обозначение = """"
		|			ТОГДА Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр.ВидРабочегоЦентра
		|		ИНАЧЕ Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр.Лико_Обозначение
		|	КОНЕЦ КАК РабочийЦентр,
		|	Лико_ПараметрыПроизводстваЗаказа.НомерПроката КАК НомерПроката,
		|	Лико_ПараметрыПроизводстваЗаказа.МетрыНаНастройку КАК МетрыНаНастройку,
		|	Лико_ПараметрыПроизводстваЗаказа.МетрыНаБрак КАК МетрыНаБрак,
		|	Лико_ПараметрыПроизводстваЗаказа.ПроцентНаБрак * 100 КАК ПроцентНаБрак
		|ИЗ
		|	РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
		|ГДЕ
		|	Лико_ПараметрыПроизводстваЗаказа.Заказ = &Заказ
		|	И ВЫБОР
		|			КОГДА Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1
		|				ТОГДА Лико_ПараметрыПроизводстваЗаказа.РабочийЦентр = &РабочийЦентр
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерПроката";
		ЗапросПараметры.УстановитьПараметр("Заказ", Заказ);
		ЗапросПараметры.УстановитьПараметр("Рабочийцентр", Заказ.РабочийЦентр);
		сч = 1;
		ВыборкаПараметры = ЗапросПараметры.Выполнить().Выбрать();
		Пока ВыборкаПараметры.Следующий() Цикл
			ОбластьШапка.Параметры["МетрыНаНастройку"+строка(сч)]  = ВыборкаПараметры.МетрыНаНастройку;
			ОбластьШапка.Параметры["МетрыНаБрак"+строка(сч)]  = ВыборкаПараметры.МетрыНаБрак;
			ОбластьШапка.Параметры["ПроцентНаБрак"+строка(сч)]  = ВыборкаПараметры.ПроцентНаБрак;
			ОбластьШапка.Параметры["РЦ"+строка(сч)]  = ВыборкаПараметры.РабочийЦентр;
			сч = сч+1;
		КонецЦикла;
		
		
		
		ТабДокумент.Вывести(ОбластьШапка);
		
		
		ОбластьШтамп = Макет.ПолучитьОбласть("Штамп");
		ОбластьШтамп.Параметры.Заполнить(Выборка);
		
		
		ОбластьШтамп.Параметры.Заполнить(ВыборкаПеремотка);
		
		Если ЗначениеЗаполнено(ВыборкаПеремотка.Направление.ФайлКартинки) Тогда 
			Попытка
				УстановитьПривилегированныйРежим(Истина);
				Картинка = РаботаСФайлами.ДвоичныеДанныеФайла(ВыборкаПеремотка.Направление.ФайлКартинки);
				УстановитьПривилегированныйРежим(Ложь);
			Исключение
				Картинка = Неопределено; 
			КонецПопытки;
			
			Если ЗначениеЗаполнено(Картинка) Тогда
				Если НЕ Картинка = Неопределено Тогда
					ФотоТовара = ОбластьШтамп.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
					ФотоТовара.Верх = 0;
					ФотоТовара.Лево = 0;
					ФотоТовара.РазмерКартинки = РазмерКартинки.Пропорционально;
					Если ТипЗнч(Картинка) = Тип("Картинка") Тогда
						ФотоТовара.Картинка = Картинка;
					ИначеЕсли ТипЗнч(Картинка) = Тип("ДвоичныеДанные") Тогда
						ФотоТовара.Картинка =Новый Картинка(Картинка);
					КонецЕсли;
					
					
					ФотоТовара.Расположить(ОбластьШтамп.Область(5, 46, 6, 50));                
				КонецЕсли;					
			КонецЕсли;	
			
		КонецЕсли;
