
&НаКлиенте
Процедура НоменклатураОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	СписокНоменклатуры=Лико_ОбщегоНазначенияСервер.ПоискНоменклатурыПоСодержаниюТекста(Текст);
	
	Если СписокНоменклатуры.Количество()>0 Тогда
		// если 1 результат, то автоматом установим. Если больше - тогда интерактивный выбор. 
		Если СписокНоменклатуры.Количество()=1 Тогда
			Номенклатура = СписокНоменклатуры[0].Значение;
		Иначе
			Номенклатура = ЭтаФорма.ВыбратьИзСписка(СписокНоменклатуры, Элемент).Значение;
		КонецЕсли;
		
		СтандартнаяОбработка = Ложь;
	Иначе 	//запрос пуст!
		
		СтандартнаяОбработка = Истина;
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьИРаспечататьОбъектНоменклатуры(Команда)
	ПроверитьНаличиеУпаковки();
	Если Не ПроверитьЗаполнениеРеквизитов() Тогда
		Возврат;
	КонецЕсли;
	Массив = Новый Массив();
	Для Сч=1 По КоличествоЭтикеток Цикл 
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Номенклатура",Номенклатура);
		СтруктураПараметров.Вставить("Характеристика",ХарактеристикаНоменклатуры);
		СтруктураПараметров.Вставить("Нарезка",Нарезка);
		СтруктураПараметров.Вставить("Втулка",Втулка);
		СтруктураПараметров.Вставить("Количество",Количество);
		СтруктураПараметров.Вставить("Упаковка",БазоваяЕдиницаИзмерения);
		СтруктураПараметров.Вставить("СерийныйНомер",СерийныйНомер);
		СтруктураПараметров.Вставить("Комментарий",Комментарий);
		СтруктураПараметров.Вставить("Рулонный",Рулонный);
		СтруктураПараметров.Вставить("Уникальный",Уникальный);
		СтруктураПараметров.Вставить("УпотребитьДо",УпотребитьДо);
		СтруктураПараметров.Вставить("ДатаПроизводства",ДатаПроизводства);
		СтруктураПараметров.Вставить("ВидКонтактаСПищевойПродукцией",ВидКонтактаСПищевойПродукцией);
		СтруктураПараметров.Вставить("НомерПартииИзготовления",НомерПартииИзготовления);
		СтруктураПараметров.Вставить("ПричинаОтсутствияНомераПартииИзготовления",ПричинаОтсутствияНомераПартииИзготовления);
		СтруктураПараметров.Вставить("ПричинаОтсутствияДатыИзготовления",ПричинаОтсутствияДатыИзготовления);
		
		
		
		СправочникОбъект=СоздатьОбъектНаСервере(СтруктураПараметров);
		//И ПараметрыВходногоКонтроля.НайтиСтроки(НОвый Структура("НесоответствиеВыявлено",Истина)).Количество()>0
		Если BRC  ТОгда
		ЗаписатьКритерииВОбъектНоменклатуры(СправочникОбъект);	
		КонецЕсли;
		Печать=Истина;	
		Если ВидОперации="ДобавитьВОрдер" и ПечататьБиркиПриСозданииВПриходномОрдереСервер() Тогда	
			Печать=Ложь;		
		КонецЕсли; 	
		Если  Не СразуНаПринтер Тогда
			Печать=Ложь;
		КонецЕсли;
		
		Если Печать Тогда
			Лико_ДополнительноКлиент.ПечатьЯрлыкаОбъектаНоменклатуры(СправочникОбъект,,СразуНаПринтер); 
		КонецЕсли; 		
		Серия=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(СправочникОбъект,"Серия");
		Массив.Добавить(Серия); 
		ДобавитьВТаблицуТоваров(СправочникОбъект);
	КонецЦикла;
	
	Если ВидОперации="ДобавитьВОрдер" Тогда 		
		//Закрыть(Массив);
	КонецЕсли;
	
	КоличествоЭтикеток=1;
	Если ЗначениеЗаполнено(Тара) Тогда
		
	    ЗаписатьТаруВОбъектНоменклатуры(СправочникОбъект);
	КонецЕсли;	

	Если СозданиеЕдиничнойБирки Тогда
		Закрыть(СправочникОбъект);
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ЗаписатьКритерииВОбъектНоменклатуры(СправочникОбъект) //+Лико m.shenderov 25.06.2020
СправочникОбъектОбъект=СправочникОбъект.ПолучитьОбъект();

Для каждого ПФ Из ПараметрыВходногоКонтроля Цикл
				//Если  ПФ.НесоответствиеВыявлено ТОгда
					  НоваяСтр=СправочникОбъектОбъект.Лико_ПараметрыВходногоКонтроля.Добавить();
					  ЗаполнитьЗначенияСвойств(НоваяСтр,ПФ);
				//КонецЕсли;
				
				
КонецЦикла;
			СправочникОбъектОбъект.Записать();


		
КонецПроцедуры //-Лико m.shenderov 25.06.2020


Процедура ЗаписатьТаруВОбъектНоменклатуры(СправочникОбъект) //+Лико m.shenderov 25.06.2020
СправочникОбъектОбъект=СправочникОбъект.ПолучитьОбъект();

СправочникОбъектОбъект.Тара=Тара;
СправочникОбъектОбъект.ВесТары=Тара.Вес;
				

			СправочникОбъектОбъект.Записать();


		
КонецПроцедуры //-Лико m.shenderov 25.06.2020




&НаСервере
Процедура ДобавитьВТаблицуТоваров(СправочникОбъект) //+Лико m.shenderov 12.12.2017
	//Серия=Справочники.СерииНоменклатуры.СоздатьЭлемент();	
	Товар=Объект.Товары.Добавить();
	Товар.Номенклатура=СправочникОбъект;
	Товар.Количество=СправочникОбъект.Количество;
	Если Не СправочникОбъект.Уникальный Тогда
		Товар.Количество=1;
	КонецЕсли;
	
	Товар.КоличествоУУ=Товар.Количество*СправочникОбъект.БазоваяЕдиницаИзмерения.Числитель;
	
	
	
КонецПроцедуры  //-Лико m.shenderov 12.12.2017



