&НаКлиенте
Процедура СоздатьРолики(Команда)
	Если Не ЗначениеЗаполнено(СотрудникНЗП) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст ="Не заполнен автор документа!";
		Сообщение.Поле = "СотрудникНЗП";
		Сообщение.УстановитьДанные(СотрудникНЗП);
		Сообщение.Сообщить();		
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НомерЗаказаНЗП) Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст ="Не заполнен номер заказа!";
		Сообщение.Поле = "НомерЗаказаНЗП";
		Сообщение.УстановитьДанные(НомерЗаказаНЗП);
		Сообщение.Сообщить();		
		Возврат;
		
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НарезкаНЗП) Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст ="Не заполнена нарезка!";
		Сообщение.Поле = "НарезкаНЗП";
		Сообщение.УстановитьДанные(НарезкаНЗП);
		Сообщение.Сообщить();		
		
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВтулкаНЗП) Тогда
		
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст ="Не заполнена втулка!";
		Сообщение.Поле = "ВтулкаНЗП";
		Сообщение.УстановитьДанные(ВтулкаНЗП);
		Сообщение.Сообщить();	
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(КоличествоЭтикетокНЗП) Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст ="Не указано количество этикеток!";
		Сообщение.Поле = "КоличествоРоликов";
		Сообщение.УстановитьДанные(КоличествоЭтикетокНЗП);
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	МассивОбъектов = СоздатьОбъектыНоменклатуры();
	Для каждого ОБъектНоменклатуры Из МассивОбъектов  Цикл
		Лико_ДополнительноКлиент.ПечатьЯрлыкаОбъектаНоменклатуры(ОБъектНоменклатуры,,СразуНаПринтер); 
		
	КонецЦикла;
	
	Если ВидОперации="ДобавитьВОрдер" Тогда 		
		ЭтаФорма.Закрыть(МассивОбъектов);
	КонецЕсли;
	
	
КонецПроцедуры


