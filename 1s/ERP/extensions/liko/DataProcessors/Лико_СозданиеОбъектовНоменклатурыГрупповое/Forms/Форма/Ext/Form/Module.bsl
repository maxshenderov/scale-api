&НаСервере
Процедура ЗаполнитьДанныеПоНоменклатуре() //+Лико m.shenderov 18.09.2017
	Родитель					=Номенклатура.ВидНоменклатуры;
	ЕдиницаИзмеренияУУ			=Номенклатура.ЕдиницаИзмерения;
	КодНоменклатуры				=Номенклатура.Код;
	//БазоваяЕдиницаИзмерения 	=Справочники.ЯССМ_Нарезки.УпаковкаПоНарезке(Нарезка);
	//ВидУпаковки					=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(БазоваяЕдиницаИзмерения,"Владелец");
	ХарактеристикаНоменклатуры	=Справочники.ЯССМ_Нарезки.ХарактеристикаПоНарезке(Нарезка);
	//Рулонный                    =Лико_Дополнительно.ПроверкаЗначенияСвойстваУРодителей(Номенклатура.ВидНоменклатуры,"Лико_РулонныйМатериал");
	Рулонный                    =Номенклатура.ВидНоменклатуры.Лико_РулонныйМатериал;
	
	//Если Номенклатура.ВидНоменклатуры.ИспользоватьСерии Тогда
	//	Уникальный=Истина;
	//Иначе
	//	Уникальный=Ложь;
	//КонецЕсли;
	
	
	Если Не ЗначениеЗаполнено(Втулка) Тогда		
		Втулка=Номенклатура.Лико_Втулка;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Втулка) Тогда		
		Втулка=Номенклатура.ВидНоменклатуры.Лико_Втулка;
	КонецЕсли;
	Если Не Рулонный И НЕ ЗначениеЗаполнено(ВидУпаковки) Тогда
		Если ЗначениеЗаполнено(Номенклатура.ВидНоменклатуры.Лико_УпаковкаПоУмолчанию) Тогда
			ВидУпаковки=Номенклатура.ВидНоменклатуры.Лико_УпаковкаПоУмолчанию;
		Иначе
			ВидУпаковки=Номенклатура.ЕдиницаИзмерения;
		КонецЕсли;
		//ВидУпаковки=Справочники.Лико_ПредопределенныеЗначения.УпаковкаПоУмолчанию.ЗначениеПараметра;
	КонецЕсли;
	
	
	НовоеНаименование				 = СокрЛП(Номенклатура.Наименование)
	+ ?(ЗначениеЗаполнено(Номенклатура.Артикул), ", ("+Номенклатура.Артикул+")", "")
	+ ?(ЗначениеЗаполнено(Нарезка), ", Ø"+Нарезка+" ", "")
	+ ?(ЗначениеЗаполнено(Втулка), ?(ЗначениеЗаполнено(Нарезка), "", ", ")+"("+Втулка+")", "")
	+ ?(СокрЛП(Комментарий)="", "", ", " + СокрЛП(Комментарий))
	+ ?(Уникальный И ЗначениеЗаполнено(Нарезка) И Количество<>0, ", "+Количество+" "+БазоваяЕдиницаИзмерения, "");
	
	Если СокрЛП(Наименование)<>СокрЛП(НовоеНаименование) Тогда
		Наименование = НовоеНаименование;
	КонецЕсли;
	
	УстановкаУникальности();	
	
КонецПроцедуры //-Лико m.shenderov 18.09.2017

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	ХарактеристикаНоменклатуры	=Неопределено;
	Нарезка						=Неопределено;
	ВидУпаковки					=Неопределено;
	Количество					=Неопределено;
	КоличествоВУпаковке			=Неопределено;
	Втулка						=Неопределено;
	ЗаполнитьДанныеПоНоменклатуре();
	УстановитьПрослеживаемостьСервер();
	УстановитьСрокГодностиСервер();
	УстановитьВидимость();
	Если BRC Тогда
		ПоказатьКартинкуНоменклатуры();
	КонецЕсли;
КонецПроцедуры


