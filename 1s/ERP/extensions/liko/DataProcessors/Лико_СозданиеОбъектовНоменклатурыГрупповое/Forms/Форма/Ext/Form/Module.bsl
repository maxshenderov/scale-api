&НаКлиенте
Процедура РасчитатьДлинуРолика(Команда)
	
	Структура = Новый Структура;
	Структура.Вставить("Номенклатура",Номенклатура);
	Структура.Вставить("НачальныйДиаметр",ПолучитьРазмерНаружногоДиаметра(Втулка));
	
	ОписаниеОповещения= Новый ОписаниеОповещения("РассчитатьДлиннуРоликаЗавершение",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.Лико_РасчетДлиныРолика",Структура,,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

