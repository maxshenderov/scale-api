Процедура ВыводШКТипоразмерПаллета() Экспорт
	
	ТипоРазмерПаллетаШК.Очистить();
	
	Если Не ЗначениеЗаполнено(ТипоразмерПаллета) Тогда
		Возврат;
	КонецЕсли;
	
	
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	
	МакетОбработки = ОбъектОбработки.ПолучитьМакет("ПФ_MXL_БиркаТипоразмераПаллета");   
	
	СсылкаНаОбъект = ТипоразмерПаллета;
	
	НомерДокумента = 0;
	
	
	
	ТабДокумент = ТипоРазмерПаллетаШК;
	
	Макет = МакетОбработки;
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	//ОбластьШК = Макет.ПолучитьОбласть("ШК");
	
	
	//ОбластьШапка.Параметры.Наименование = СсылкаНаОбъект.Наименование;
	
	
	// {{ DGavrilov
	
	ШК = Справочники.Лико_ТипоразмерыПаллет.ШтрихКод(СсылкаНаОбъект);		
	
	ОбластьШапка.Параметры.ШтрихКодСтрокой=Справочники.Лико_ТипоразмерыПаллет.ШтрихКодСтрокой(СсылкаНаОбъект);
	
	
	
	Рисунок = ОбластьШапка.Рисунки.Штрихкод;
	ПараметрыШтрихкода = Новый Структура;
	
	ПараметрыШтрихкода.Вставить("Ширина",          ОбластьШапка.Рисунки.Штрихкод.Ширина);
	ПараметрыШтрихкода.Вставить("Высота",          ОбластьШапка.Рисунки.Штрихкод.Высота);
	ПараметрыШтрихкода.Вставить("ТипКода",         4);
	ПараметрыШтрихкода.Вставить("ОтображатьТекст", Ложь);
	ПараметрыШтрихкода.Вставить("РазмерШрифта",    18);
	ПараметрыШтрихкода.Вставить("Штрихкод",        ШК);
	Рисунок.Картинка = МенеджерОборудованияВызовСервера.ПолучитьКартинкуШтрихкода(ПараметрыШтрихкода);	
	//ТабДокумент.Вывести(ОбластьШК);
	ТабДокумент.Вывести(ОбластьШапка);
	
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.ПолеСлева = 1;
	ТабДокумент.ПолеСправа = 0;
	ТабДокумент.ПолеСнизу = 0;
	ТабДокумент.ПолеСверху = 1;
	
	
	ИмяПринтера=Справочники.Лико_РабочиеМеста.ПолучитьСвойство("ИмяПринтераЭтикеток","");	
	ТабДокумент.ИмяПринтера = ИмяПринтера;	
	
	
		
КонецПроцедуры


