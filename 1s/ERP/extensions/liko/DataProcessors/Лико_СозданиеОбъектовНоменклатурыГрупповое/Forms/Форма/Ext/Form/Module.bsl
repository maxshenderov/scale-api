&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Организация=УправлениеСвойствами.ЗначениеСвойства(ПараметрыСеанса.ТекущийПользователь,"Организация_e4c9d825676549a1a5c19972efa7da0b");
	Площадка = Справочники.Лико_Площадки.ПлощадкаПоОрганизации(Организация);
	Если Параметры.Свойство("ВидОперации") Тогда
		ВидОперации=Параметры.ВидОперации;
	КонецЕсли;
	
		Если Параметры.Свойство("ЗакрытиеБланка") Тогда
		ЗакрытиеБланка=Параметры.ЗакрытиеБланка;
	КонецЕсли;

	Если Параметры.Свойство("BRC") Тогда 
		BRC = Параметры.BRC;
	Иначе
		//BRC=?(ЗначениеЗаполнено(Организация)и  не Параметры.Свойство("BRC") ,УправлениеСвойствами.ЗначениеСвойства(Организация,"Лико_УчетНаСкладеПоBRC"),Ложь);	
	    BRC=?(ЗначениеЗаполнено(Организация),УправлениеСвойствами.ЗначениеСвойства(Организация,"Лико_УчетНаСкладеПоBRC"),Ложь);	
	КонецЕсли;	
	
	
	КоличествоЭтикеток 		= 1;
	КоличествоЭтикетокПФ 	= 1;
	КоличествоЭтикетокНЗП 	= 1;
	//Количество=1;
	//КоличествоВУпаковке=1;
	Уникальный = Истина;
	Объект.Товары.Очистить();	
	СразуНаПринтер=Лико_Дополнительно.ПолучитьСвойство("ПечатьСразуНаПринтер",Ложь);
	
	Если Параметры.Свойство("Упаковка") и ЗначениеЗаполнено(Параметры.Упаковка) Тогда	
		Если Рулонный Тогда
			
		Иначе
			
			БазоваяЕдиницаИзмерения=Параметры.Упаковка;
		КонецЕсли;
		
	КонецЕсли;
	
	
	
		
	Если Параметры.Свойство("Номенклатура") Тогда
		Номенклатура=Параметры.Номенклатура;
	КонецЕсли;
	Если Параметры.Свойство("Характеристика") Тогда  		
		Нарезка=Параметры.Характеристика.ЯССМ_Нарезка;
		БазоваяЕдиницаИзмерения 	=УпаковкаПоНарезкеСервер(Нарезка);	
		Если ЗначениеЗаполнено(Нарезка) Тогда
			Рулонный=Истина;
		КонецЕсли;
		
		
	КонецЕсли;
	
	Если Параметры.Свойство("Количество")И Рулонный Тогда	
		
		Количество=Параметры.Количество;
		
		КоличествоВУпаковке=Параметры.Количество;
		
	КонецЕсли;
	
	Если Параметры.Свойство("КоличествоУпаковок")И Не Рулонный Тогда	
		
		
		
		КоличествоВУпаковке=Параметры.КоличествоУпаковок;
		Если Не ЗначениеЗаполнено(КоличествоВУпаковке) Тогда
			КоличествоВУпаковке=1;
		КонецЕсли;
		
		
	КонецЕсли;
	
	
	
	Если	 ВидОперации="ДобавитьВОрдер" Тогда
		Элементы.СтраницаПечатьШКНезавершеннойПродукции.Видимость=Ложь;
		Элементы.ГруппаТовары.Видимость=Истина;
	Иначе
		Элементы.ГруппаТовары.Видимость=Истина;
		Элементы.ДобавитьВДокумент.Видимость=Ложь;
		
	КонецЕсли;
Если Параметры.Свойство("СозданиеЕдиничнойБирки") Тогда	
	СозданиеЕдиничнойБирки=Истина;
	СразуНаПринтер=Ложь;
КонецЕсли;

	Если СозданиеЕдиничнойБирки Тогда
		Элементы.Товары.Видимость=Ложь;
		Элементы.ГруппаТоварыИтоги.Видимость=Ложь;
		Элементы.КоличествоВУпаковке.Заголовок="Нетто";
		Элементы.ВидУпаковки.Видимость=Ложь;
		Элементы.Тара.Видимость=Истина;
		Элементы.Группа1.Доступность=Ложь;
		Элементы.Весы.Видимость=Истина;

	КонецЕсли;
  УстановитьПрослеживаемостьСервер();	
	
КонецПроцедуры

