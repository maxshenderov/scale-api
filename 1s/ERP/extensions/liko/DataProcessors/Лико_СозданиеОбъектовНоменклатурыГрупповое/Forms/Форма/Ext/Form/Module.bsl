&НаКлиенте
Процедура УстановитьВидимость() //+Лико m.shenderov 24.10.2017
	Если Рулонный Тогда
		Элементы.ГруппаНароезкаВтулка.Видимость			=Истина;
		Элементы.ГруппаЕдиницаИзмеренеия.Видимость		=Истина;
		Элементы.ГруппаВидУпаковки.Видимость			=Ложь;
		Элементы.ГруппаНароезкаВтулка.Видимость			=Истина;
	Иначе
		Элементы.ГруппаНароезкаВтулка.Видимость			=Ложь;
		Элементы.ГруппаЕдиницаИзмеренеия.Видимость		=Ложь;
		Элементы.ГруппаВидУпаковки.Видимость			=Истина;
		Элементы.ГруппаНароезкаВтулка.Видимость			=Ложь;
		
	КонецЕсли;
	
	Если Не Уникальный Тогда
		Кол=Неопределено;
		ПолучитьКоличествоНеУникального(Номенклатура,Кол);
		Если Кол=Неопределено Тогда
			Элементы.ВидУпаковки.ТолькоПросмотр=Ложь;
			Элементы.КоличествоВУпаковке.ТолькоПросмотр=Ложь;
			КоличествоВУпаковке=Кол;  			
		Иначе
			Элементы.ВидУпаковки.ТолькоПросмотр=Истина;
			Элементы.КоличествоВУпаковке.ТолькоПросмотр=Истина;
			КоличествоВУпаковке=1;
		КонецЕсли;
		
		Количество=1;
		
	Иначе
		Элементы.ВидУпаковки.ТолькоПросмотр=Ложь;
		Элементы.КоличествоВУпаковке.ТолькоПросмотр=Ложь;
	КонецЕсли;
	
	Если BRC Тогда
		Элементы.ГруппаBRC.Видимость=Истина;
		Элементы.ГруппаBRC2.Видимость=Истина;
		//ЗаполнитьКритерииДляВходногоКонтроля();	
	Иначе
		Элементы.ГруппаBRC.Видимость=Ложь;
		Элементы.ГруппаBRC2.Видимость=Ложь;
		
		
	КонецЕсли; 
	
	Если Прослеживаемость Тогда
		Элементы.ГруппаПрослеживаемость.Видимость=Истина;	
	Иначе
		Элементы.ГруппаПрослеживаемость.Видимость=Ложь;	
	КонецЕсли; 
	
	Если СрокГодности<>0 Тогда
		Элементы.ГруппаСрокиГодности.Видимость=Истина;
		Уникальный = Истина;
		Элементы.Уникальный.Доступность=Ложь;
	Иначе
		Элементы.ГруппаСрокиГодности.Видимость = Ложь;
		Элементы.Уникальный.Доступность = Истина;
	КонецЕсли;

	
	
	
КонецПроцедуры //-Лико m.shenderov 24.10.2017

