		|ГДЕ
		|	ХарактеристикиНоменклатуры.Лико_ЗаказНоменклатуры = &Заказ
		|	И ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры = &ВидНоменклатуры";
		
		Запрос.УстановитьПараметр("Заказ",ЗаказКлиента);
		Запрос.УстановитьПараметр("ВидНоменклатуры", Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыПробник.ЗначениеПараметра);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		НоменклатураПробник = Неопределено;
		ХарактеристикаПробник = Неопределено;
		
		//=--------- создаем незавершенку -----
		РодительПробникНоменклатура = Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыПробник.ЗначениеПараметра;
		РодительНезавершенка = Справочники.Лико_ПредопределенныеЗначения.ГруппаОбъектовНоменклатурыНезавершеннаяПродукция.ЗначениеПараметра;
		
		Если Не РезультатЗапроса.Пустой() Тогда
			ВыборкаЗапроса = РезультатЗапроса.Выбрать();
			ВыборкаЗапроса.Следующий();
			
			ХарактеристикаПробник = ВыборкаЗапроса.Характеристика;
			НоменклатураПробник = ХарактеристикаПробник.Владелец;
		Иначе 	//запрос пуст!
			
			//Если Не ЗначениеЗаполнено(РодительНезавершенкаНоменклатура) Тогда
			//	Сообщить("Не найдена группа полуфабрикатов!");
			//	Возврат Неопределено;
			//КонецЕсли;
			
			Если ЗначениеЗаполнено(МенеджерЗаказа) Тогда
				ФИО = МенеджерЗаказа.Наименование;
				Фамилия		= ВыделитьСлово(ФИО);
				Имя			= ВыделитьСлово(ФИО);
				Отчество	= ВыделитьСлово(ФИО);
				ФИОСтрока = Фамилия+" "+Лев(имя,1)+"."+Лев(Отчество,1)+".";
			Иначе
				ФИОСтрока = "";
			КонецЕсли;
			//---------=
			
			Номенклатура1С = Справочники.Номенклатура.СоздатьЭлемент();
			Номенклатура1С.УстановитьНовыйКод("n");
			Номенклатура1С.ВидНоменклатуры=Справочники.Лико_ПредопределенныеЗначения.ВидНоменклатурыПробник.ЗначениеПараметра;
			Справочники.Номенклатура.ЗаполнитьРеквизитыПоВидуНоменклатуры(Номенклатура1С);
			
			Номенклатура1С.Наименование = "Пробник по заказу №" + Формат(НомерЗаказаПробник, "ЧГ=0") + " (" + ФИОСтрока + ")";
			Номенклатура1С.НаименованиеПолное = Номенклатура1С.Наименование;
						
			Номенклатура1С.Записать();
			
			НоменклатураПробник = Номенклатура1С.Ссылка;
			
			//=--------- создаем ему характеристику -----
			ХарактеристикаПробник							= Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
			ХарактеристикаПробник.Владелец					= НоменклатураПробник;
			ХарактеристикаПробник.Лико_ЗаказНоменклатуры	= ЗаказКлиента;
			ХарактеристикаПробник.Записать();
			
		КонецЕсли;
		
		Если НоменклатураПробник<>Неопределено И ХарактеристикаПробник<>Неопределено Тогда
			//=--------- находим или создаем ед. изм. УУ -----
			
						//
			//=--------- Создание объектов номенклатуры -----
			Для Счетчик=1 По КоличествоЭтикетокПробников Цикл
				
				
				
				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Номенклатура"			,НоменклатураПробник);
				//СтруктураПараметров.Вставить("Родитель"				,РодительНезавершенка);
				СтруктураПараметров.Вставить("Характеристика"		,ХарактеристикаПробник);
				//СтруктураПараметров.Вставить("Нарезка"				,Нарезка);
				//СтруктураПараметров.Вставить("Втулка"				,Втулка);
				СтруктураПараметров.Вставить("Количество"			,1);
				СтруктураПараметров.Вставить("Упаковка"				,Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("796"));
				СтруктураПараметров.Вставить("Уникальный"			,Истина);
				СтруктураПараметров.Вставить("НомерЗаказаКлиента"	,НомерЗаказаПробник);
				СтруктураПараметров.Вставить("НомерБланка"			,0);
				//СтруктураПараметров.Вставить("СерийныйНомер"		,СерийныйНомер);
				//СтруктураПараметров.Вставить("Комментарий"			,"");
				СтруктураПараметров.Вставить("Ответсвенный"			,СотрудникПробник);
				СтруктураПараметров.Вставить("Рулонный"				,Ложь); 
				НовыйЭлемент=Справочники.ЯССМ_ОбъектыНоменклатуры.СоздатьОбъектНоменклатуры(СтруктураПараметров);	
				
				МассивСозданныхОбъектов.Добавить(НовыйЭлемент.Ссылка);
				
			КонецЦикла;
			
		Иначе
			Сообщить("Не удалось создать пробник!");
		КонецЕсли;
		
		
	КоличествоРоликов = 1;
	
	Возврат МассивСозданныхОбъектов;
	
КонецФункции //СоздатьОбъектыНоменклатуры


/// Функция выделяет первое слово в предложении
&НаСервере
Функция ВыделитьСлово(ИсходнаяСтрока) Экспорт
	
	Буфер = СокрЛ(ИсходнаяСтрока);
	ПозицияПослПробела = Найти(Буфер, " ");
	
	Если ПозицияПослПробела = 0 Тогда
		ИсходнаяСтрока = "";
		Возврат Буфер;
	КонецЕсли;
	
	ВыделенноеСлово = СокрЛП(Лев(Буфер, ПозицияПослПробела));
	ИсходнаяСтрока = Сред(ИсходнаяСтрока, ПозицияПослПробела + 1);
	
	Возврат ВыделенноеСлово;
	
КонецФункции


&НаКлиенте
Функция ПроверитьЗаполнениеРеквизитов() //+Лико m.shenderov 10.11.2017
	ОчиститьСообщения();	
	
	Результат=Истина;
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Результат=Ложь;		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не выбрана номенклатура.'"), ,
		"Номенклатура");
	КонецЕсли;
	Если Рулонный И Не ЗначениеЗаполнено(Нарезка)  Тогда 
		Результат=Ложь;		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не выбрана нарезка.'"), ,
		"Нарезка");
	КонецЕсли;
	
	
	Если Рулонный и Количество=0 Тогда 		
		Результат=Ложь;		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнено количество.'"), ,
		"Количество");		
	КонецЕсли;  
	
	Если Не Рулонный и КоличествоВУпаковке=0 Тогда 		
		Результат=Ложь;		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнено количество.'"), ,
		"КоличествоВУпаковке");		
	КонецЕсли;   
	
	
	Если BRC 
		И НЕ ЗначениеЗаполнено(ДатаПроизводства) 
		И ЗначениеЗаполнено(ВидКонтактаСПищевойПродукцией) 
		И ВидКонтактаСПищевойПродукцией<>ПредопределенноеЗначение("Справочник.Лико_ВидыКонтактовСПищевойПродукцией.НетКонтакта")
		И ВидКонтактаСПищевойПродукцией<>ПредопределенноеЗначение("Справочник.Лико_ВидыКонтактовСПищевойПродукцией.НетКонтактаСКонтролемСрокаГодности") Тогда
		Результат=Ложь;		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнена дата изготовления.'"), ,
		"ДатаПроизводства");	
	КонецЕсли;
	
	Если BRC 
		И НЕ ЗначениеЗаполнено(УпотребитьДо) 
		И ЗначениеЗаполнено(ВидКонтактаСПищевойПродукцией)
		И ВидКонтактаСПищевойПродукцией<>ПредопределенноеЗначение("Справочник.Лико_ВидыКонтактовСПищевойПродукцией.НетКонтакта") Тогда
		Результат=Ложь;		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнена дата возможного употребления.'"), ,
		"УпотребитьДо");	
	КонецЕсли;
	
	Если BRC И НЕ ЗначениеЗаполнено(ВидКонтактаСПищевойПродукцией) Тогда
		Результат=Ложь;		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнен вид контакта с пищевой продукцией.'"), ,
		"ВидКонтактаСПищевойПродукцией");	
	КонецЕсли;
	
	Если BRC 
		И НЕ ЗначениеЗаполнено(НомерПартииИзготовления) 
		И ЗначениеЗаполнено(ВидКонтактаСПищевойПродукцией)
		И ВидКонтактаСПищевойПродукцией<>ПредопределенноеЗначение("Справочник.Лико_ВидыКонтактовСПищевойПродукцией.НетКонтакта")
		И ВидКонтактаСПищевойПродукцией<>ПредопределенноеЗначение("Справочник.Лико_ВидыКонтактовСПищевойПродукцией.НетКонтактаСКонтролемСрокаГодности") Тогда
		Результат=Ложь;		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнен номер партии изготовления.'"), ,
		"НомерПартииИзготовления");	
	КонецЕсли;
	
	//Если Прослеживаемость И НЕ ЗначениеЗаполнено(ДатаПроизводства)  Тогда
	//	//Результат=Ложь;		
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнена дата изготовления.'"), ,
	//	"ДатаПроизводства");	
	//КонецЕсли;
	//
	//Если  Прослеживаемость И НЕ ЗначениеЗаполнено(УпотребитьДо)  Тогда
	//	//Результат=Ложь;		
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнена дата возможного употребления.'"), ,
	//	"УпотребитьДо");	
	//КонецЕсли;
	//
	//Если Прослеживаемость И НЕ ЗначениеЗаполнено(НомерПартииИзготовления) Тогда
	//	//Результат=Ложь;		
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнен номер партии изготовления.'"), ,
	//	"НомерПартииИзготовления");	
	//КонецЕсли;
	
	Если Прослеживаемость Тогда
		ЕстьПартия=(ЗначениеЗаполнено(НомерПартииИзготовления) Или ЗначениеЗаполнено(ПричинаОтсутствияНомераПартииИзготовления)) И
		(ЗначениеЗаполнено(ДатаПроизводства) Или ЗначениеЗаполнено(ПричинаОтсутствияДатыИзготовления));
		
		Если Не ЕстьПартия Тогда
			Если КонтрольПартийПоризводстваНоменклатуры Тогда 
				Результат=Ложь;
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не корректно заполнены  реквизиты ""Номер партии изготовления"" и ""Дата изготовления"".'"), ,
			"НомерПартииИзготовления");				
		КонецЕсли; 	
	КонецЕсли;
	
	Если СрокГодности<>0 Тогда
		ЕстьЗаполнение=ЗначениеЗаполнено(ДатаПроизводства) И ЗначениеЗаполнено(УпотребитьДо);
		
		Если Не ЕстьЗаполнение Тогда
			
			Результат=Ложь;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не корректно заполнены  реквизиты ""Дата изготовления"" и ""Дата возможного употребления"".'"), ,
			"НомерПартииИзготовления");				
			
		КонецЕсли;
	КонецЕсли;

	
	Возврат Результат;
КонецФункции  //-Лико m.shenderov 10.11.2017

