Процедура УстановкаУникальности() //+Лико m.shenderov 05.01.2018
	Элементы.Уникальный.ТолькоПросмотр	=Ложь;
	
	Возврат ;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЯССМ_ОбъектыНоменклатуры.Уникальный КАК Уникальный
	|ИЗ
	|	Справочник.ЯССМ_ОбъектыНоменклатуры КАК ЯССМ_ОбъектыНоменклатуры
	|ГДЕ
	|	ЯССМ_ОбъектыНоменклатуры.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Уникальный							=Выборка.Уникальный;
		Элементы.Уникальный.ТолькоПросмотр	=Ложь;
		
		//Элементы.Уникальный.ТолькоПросмотр	=Истина;
		Возврат;
	КонецЦикла;
	
	Уникальный							=Истина;
	
	
	Элементы.Уникальный.ТолькоПросмотр	=Ложь;
	
	
	
	
КонецПроцедуры  //-Лико m.shenderov 05.01.2018



