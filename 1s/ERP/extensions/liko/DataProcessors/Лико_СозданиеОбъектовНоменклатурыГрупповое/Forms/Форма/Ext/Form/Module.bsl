&НаСервере
Функция СоздатьОбъектыНоменклатуры()
	ЗаказКлиента=Лико_Дополнительно.НайтиДокументПоНомеру7Символов(НомерЗаказаНЗП,"ЗаказКлиента");
	МенеджерЗаказа=Лико_Дополнительно.ЗначениеРеквизитаОбъекта(ЗаказКлиента,"Менеджер");
	МассивСозданныхОбъектов = Новый Массив;
	
	Если Не ЗначениеЗаполнено(ОбъектНоменклатураAmcor) Тогда
		
		// Ищем номенклатуру
		Запрос = Новый Запрос;
