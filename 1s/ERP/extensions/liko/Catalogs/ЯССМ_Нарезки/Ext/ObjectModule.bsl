
&Вместо("ПередЗаписью")
Процедура Лико_ПередЗаписью(Отказ)

	ЭтотОбъект.Наименование = ""+Формат(ЭтотОбъект.Размер,"ЧГ=");
	Если Не ЗначениеЗаполнено(Код) Тогда
		Код=Наименование;
	КонецЕсли;
	Если ЗначениеЗаполнено(Ссылка) И НЕ РольДоступна("ПолныеПрава") Тогда
		Отказ=Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Отказано в доступе!";
		Сообщение.Сообщить();
	КонецЕсли;
	

КонецПроцедуры
