&НаСервере
Процедура ВывестиСекцию3(Табл, ОбластьТабл)
	Перем ЭтоВывод;
	
	Если НЕ Табл.ПроверитьВывод(ОбластьТабл) Тогда
		//Табл.ВывестиВертикальныйРазделительСтраниц();
		//Табл = Табл.ПолучитьОбласть("R1C"+(Табл.ШиринаТаблицы+1));
		
		МассивКолонок.Добавить(Табл);
		Табл = Новый ТабличныйДокумент;
		УстановитьПараметрыПечатиСтолбца(Табл);
		ВывестиШапку(Табл);
		
		ЭтоВывод = Ложь;
	Иначе
		ЭтоВывод = Истина;
	КонецЕсли;
	
	
	Если ЭтоВывод Тогда
		Табл.Вывести(ОбластьТабл);
	Иначе
		Табл.Присоединить(ОбластьТабл);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере

Процедура ВывестиШапку(ТабДокумент)
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");  	
	Макет = ОтчетОбъект.ПолучитьМакет("ОстаткиДляПроизводства_МакетТаблицы");
	
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	ВывестиСекцию3(ТабДокумент, ОбластьШапка);
	
КонецПроцедуры


