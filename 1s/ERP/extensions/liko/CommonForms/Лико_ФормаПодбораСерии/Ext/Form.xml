				<Field>СерииСписок.Наименование</Field>
				<Field>СерииСписок.Нарезка</Field>
				<Field>СерииСписок.НомерПоставки</Field>
				<Field>СерииСписок.ОбъектНоменклатуры</Field>
				<Field>СерииСписок.Остаток</Field>
				<Field>СерииСписок.Рулонный</Field>
				<Field>СерииСписок.Серия</Field>
				<Field>СерииСписок.Ссылка</Field>
				<Field>СерииСписок.Уникальный</Field>
				<Field>СерииСписок.Упаковка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ЕСТЬNULL(ОбъектНоменклатуры.Серия, ТоварыВЯчейкахОстатки.Серия) КАК Ссылка,
	ОбъектНоменклатуры.Ссылка КАК ОбъектНоменклатуры,
	ОбъектНоменклатуры.Наименование КАК Наименование,
	ОбъектНоменклатуры.Втулка КАК Втулка,
	ОбъектНоменклатуры.Нарезка КАК Нарезка,
	ОбъектНоменклатуры.Рулонный КАК Рулонный,
	ОбъектНоменклатуры.Уникальный КАК Уникальный,
	ЕСТЬNULL(ОбъектНоменклатуры.БазоваяЕдиницаИзмерения, ТоварыВЯчейкахОстатки.Упаковка) КАК Упаковка,
	ОбъектНоменклатуры.ЕдиницаИзмеренияУУ КАК ЕдИзм,
	ОбъектНоменклатуры.Количество КАК Количество,
	ТоварыВЯчейкахОстатки.Ячейка КАК АдресХранения,
	ТоварыВЯчейкахОстатки.Серия КАК Серия,
	ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0) КАК Остаток,
	ТоварыВЯчейкахОстатки.КОтборуОстаток КАК КОтбору,
	ТоварыВЯчейкахОстатки.КРазмещениюОстаток КАК КРазмещению,
	ОбъектНоменклатуры.НомерПоставки КАК НомерПоставки,
	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура
ИЗ
	Справочник.ЯССМ_ОбъектыНоменклатуры КАК ОбъектНоменклатуры
		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
				,
				Номенклатура = &amp;Номенклатура
					И Характеристика = &amp;Характеристика
					И Ячейка.Владелец = &amp;Склад) КАК ТоварыВЯчейкахОстатки
		ПО (ТоварыВЯчейкахОстатки.Серия = ОбъектНоменклатуры.Серия)
			И (ТоварыВЯчейкахОстатки.Номенклатура = ОбъектНоменклатуры.Номенклатура)
ГДЕ
	ВЫБОР
			КОГДА &amp;ТолькоОСтатки
				ТОГДА ЕСТЬNULL(ТоварыВЯчейкахОстатки.ВНаличииОстаток, 0) &gt; 0
			ИНАЧЕ ОбъектНоменклатуры.Номенклатура = &amp;Номенклатура
					И ОбъектНоменклатуры.Характеристика = &amp;Характеристика
		КОНЕЦ</QueryText>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
