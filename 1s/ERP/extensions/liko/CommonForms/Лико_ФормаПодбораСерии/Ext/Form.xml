			</Type>
			<UseAlways>
				<Field>~СерииСписок.Ячейка</Field>
				<Field>СерииСписок.АдресХранения</Field>
				<Field>СерииСписок.Втулка</Field>
				<Field>СерииСписок.ЕдИзм</Field>
				<Field>СерииСписок.КОтбору</Field>
