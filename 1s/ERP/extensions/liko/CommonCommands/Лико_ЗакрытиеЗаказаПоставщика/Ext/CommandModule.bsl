&НаКлиенте
Процедура ЗакрытьЗаказЗавершение(РезультатКоманды,ПараметрыКоманды) Экспорт //+Лико m.shenderov 22.05.2018
	    Если РезультатКоманды = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	Для каждого ЗаказПоставщику Из ПараметрыКоманды.ПараметрКоманды Цикл
		ЗакрытьЗаказНаСервере(ЗаказПоставщику);		
	КонецЦикла;
	
	//Попытка
	Если ПараметрыКоманды.ПараметрыВыполненияКоманды.Источник.ИмяФормы="Документ.ЗаказПоставщику.Форма.ФормаСпискаДокументов" Тогда
		ПараметрыКоманды.ПараметрыВыполненияКоманды.Источник.Элементы.Список.Обновить();
		
	ИначеЕсли ПараметрыКоманды.ПараметрыВыполненияКоманды.Источник.ИмяФормы="Документ.ЗаказПоставщику.Форма.ФормаДокумента" Тогда
		Структура = Новый Структура;
		Структура.Вставить("Состояние");
		Для каждого ЗаказПоставщику Из ПараметрыКоманды.ПараметрКоманды Цикл
			ОбновитьСостояниеСервер(ЗаказПоставщику,Структура);
		 ПараметрыКоманды.ПараметрыВыполненияКоманды.Источник.Состояние=Структура.Состояние;	
		КонецЦикла;		
		
		//Исключение
		//ОписаниеОшибки()
		//КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры //-Лико m.shenderov 22.05.2018



