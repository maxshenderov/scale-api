		Если  Не ЗначениеЗаполнено(стрТЗ.Manager) Тогда
			стрТЗ.Manager="";
		КонецЕсли;
		
		
	КонецЦикла;
	Тз.Колонки.Удалить(0);
	
	
	Возврат HttpВернутьТзКакJSON(ТЗ);
