Функция Shipments(ПараметрыPOST)
	
		// Проверка необходимых параметров и возврат сообщения об ошибке
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "DateStart, DateEnd, SiteInn, UserOS");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	// Найдем пользователя 1с
	UserOS = ПараметрыPOST.UserOS;
	Если НЕ ЗначениеЗаполнено(UserOS) Тогда
		Возврат HttpВернутьОшибку(424, "Не передан UserOS");
	КонецЕсли;
	
	Пользователь=ПолучитьПользователя(UserOS);
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Возврат HttpВернутьОшибку(424, "В 1С не найден пользователь с вашим UserOS");
	Иначе
		Если Пользователь.Лико_Площадки.Количество() =0  Тогда
			Возврат HttpВернутьОшибку(403, "В 1С для вашего пользователя не заданы доступные площадки");		
		КонецЕсли;	
	КонецЕсли;
	
	DateStart 	= ПараметрыPOST.DateStart;
	DateEnd 	= ПараметрыPOST.DateEnd;
	Если Не ПараметрыPOST.Свойство("SiteInn") Тогда
		SiteInn="";
	Иначе
		SiteInn    = ПараметрыPOST.SiteInn;
	КонецЕсли;
	
	//
	//Если Пользователь.Лико_Площадки.Количество() <3  Тогда
	//	Если  SiteInn="" ИЛИ SiteInn= Пользователь.Лико_Площадки[0].Организация.ИНН Тогда 
	//		SiteInn= Пользователь.Лико_Площадки[0].Организация.ИНН;
	//	Иначе  SiteInn= "20202020";
	//	КонецЕсли;
	//КонецЕсли;  
	
	
		Если ЗначениеЗаполнено(SiteInn) Тогда
		Лико_Площадка = Справочники.Лико_Площадки.ПолучитьСсылку(Новый УникальныйИдентификатор(SiteInn));
	Иначе
		Лико_Площадка = "";
	КонецЕсли;
    	
	Если Пользователь.Лико_Площадки.Количество() <3  Тогда
		Если Лико_Площадка="" Или  Лико_Площадка= Пользователь.Лико_Площадки[0].Площадка Тогда 
			Лико_Площадка= Пользователь.Лико_Площадки[0].Площадка;			
		Иначе  Лико_Площадка= "20202020";					
		КонецЕсли;
	КонецЕсли;

	

#Область Отгрузки

//С 2020 - только ЕРП    
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лико_Отгрузки.Заказ.Партнер.Код КАК ПартнерКод,
	|	Лико_Отгрузки.Заказ.Партнер.Наименование КАК ПартнерНаименование,
	|	СУММА(Лико_Отгрузки.МетражКВМ) КАК МетражКВМ,
	|	СУММА(Лико_Отгрузки.Стоимость) КАК Сумма,
	|	NULL КАК СтоимостьУслугОборот,
	|	NULL КАК СтоимостьОборот
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.Лико_Отгрузки КАК Лико_Отгрузки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры.ДополнительныеРеквизиты КАК ПартнерыДополнительныеРеквизиты
	|		ПО Лико_Отгрузки.Заказ.Партнер = ПартнерыДополнительныеРеквизиты.Ссылка
	|			И (ПартнерыДополнительныеРеквизиты.Свойство.Имя = ""Лико_СобственнаяОрганизация"")
	|ГДЕ
	|	Лико_Отгрузки.ДатаОтгрузки МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ВЫБОР
	//|			КОГДА &SiteInn = ""7817314085""
	|			КОГДА &Лико_Площадка = Значение(Справочник.Лико_Площадки.ИксПак)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ПартнерыДополнительныеРеквизиты.Ссылка ЕСТЬ NULL
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Лико_Площадка = """"
	|				ТОГДА ИСТИНА
	//|			ИНАЧЕ Лико_Отгрузки.Заказ.Площадка.Организация.ИНН = &SiteInn
	|			ИНАЧЕ Лико_Отгрузки.Заказ.Площадка = &Лико_Площадка
	|		КОНЕЦ
	|	И Лико_Отгрузки.Заказ.Площадка В
	|			(ВЫБРАТЬ
	|				ПользователиЛико_Площадки.Площадка КАК Площадка
	|			ИЗ
	|				Справочник.Пользователи.Лико_Площадки КАК ПользователиЛико_Площадки
	|			ГДЕ
	|				ПользователиЛико_Площадки.Ссылка = &ТекущийПользователь)
	|	И ВЫБОР
	|			КОГДА Лико_Отгрузки.Заказ.Площадка.Наименование <> ""ОКИЛ-САТО Икс-Пак ООО""
	|				ТОГДА Лико_Отгрузки.ДатаОтгрузки < ДАТАВРЕМЯ(2020, 1, 1)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	Лико_Отгрузки.Заказ.Партнер.Код,
	|	Лико_Отгрузки.Заказ.Партнер.Наименование
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕСТЬNULL(Лико_Отгрузки2Обороты.Заказ.Партнер.Код, Лико_Отгрузки2Обороты.ДокументОтгрузки.Партнер.Код),
	|	ЕСТЬNULL(Лико_Отгрузки2Обороты.Заказ.Партнер.Наименование, Лико_Отгрузки2Обороты.ДокументОтгрузки.Партнер.Наименование),
	|	ВЫБОР
	|		КОГДА Лико_Отгрузки2Обороты.Заказ.Ф1
	|				И Лико_Отгрузки2Обороты.МетражКВМОборот = 0
	|			ТОГДА Лико_Отгрузки2Обороты.МетражКВМСписаноОборот
	|		ИНАЧЕ Лико_Отгрузки2Обороты.МетражКВМОборот
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Лико_Отгрузки2Обороты.Заказ.Ф1
	|				И Лико_Отгрузки2Обороты.КоличествоСписаноОборот <> 0
	|			ТОГДА Лико_Отгрузки2Обороты.КоличествоСписаноОборот * Лико_Отгрузки2Обороты.Заказ.ЦенаСредняя
	|		ИНАЧЕ Лико_Отгрузки2Обороты.СтоимостьОборот + Лико_Отгрузки2Обороты.СтоимостьУслугОборот
	|	КОНЕЦ,
	|	Лико_Отгрузки2Обороты.СтоимостьУслугОборот,
	|	Лико_Отгрузки2Обороты.СтоимостьОборот
	|ИЗ
	|	РегистрНакопления.Лико_Отгрузки2.Обороты(
	|			&ДатаНачала,
	|			&ДатаОкончания,
	|			,
	|			Заказ.Площадка В
	|					(ВЫБРАТЬ
	|						ПользователиЛико_Площадки.Площадка КАК Площадка
	|					ИЗ
	|						Справочник.Пользователи.Лико_Площадки КАК ПользователиЛико_Площадки
	|					ГДЕ
	|						ПользователиЛико_Площадки.Ссылка = &ТекущийПользователь)
	|				ИЛИ ДокументОтгрузки.Договор.Лико_Площадка В
	|					(ВЫБРАТЬ
	|						ПользователиЛико_Площадки.Площадка КАК Площадка
	|					ИЗ
	|						Справочник.Пользователи.Лико_Площадки КАК ПользователиЛико_Площадки
	|					ГДЕ
	|						ПользователиЛико_Площадки.Ссылка = &ТекущийПользователь)) КАК Лико_Отгрузки2Обороты
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Лико_Площадка = """"
	|				ТОГДА ИСТИНА
	//|			ИНАЧЕ Лико_Отгрузки2Обороты.Заказ.Площадка.Организация.ИНН = &SiteInn
	|			ИНАЧЕ Лико_Отгрузки2Обороты.Заказ.Площадка = &Лико_Площадка
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ВТ.ПартнерКод, """") КАК PartnerCode,
	|	ЕСТЬNULL(ВТ.ПартнерНаименование, """") КАК PartnerName,
	|	СУММА(ЕСТЬNULL(ВТ.МетражКВМ, 0)) КАК Square,
	|	СУММА(ЕСТЬNULL(ВТ.Сумма, 0)) КАК Cost
	|ИЗ
	|	ВТ КАК ВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(ВТ.ПартнерКод, """"),
	|	ЕСТЬNULL(ВТ.ПартнерНаименование, """")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Cost УБЫВ";


	
#КонецОбласти

		
	
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Дата(DateStart)));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Дата(DateEnd)));
	Запрос.УстановитьПараметр("ТекущийПользователь",Пользователь);
	
	//Запрос.УстановитьПараметр("SiteInn", SiteInn); 
	Запрос.УстановитьПараметр("Лико_Площадка", Лико_Площадка);

	
	
	Тз = Запрос.Выполнить().Выгрузить();
	
	
	Возврат HttpВернутьТзКакJSON(Тз);
	
	
	
КонецФункции

Функция ShipmentsPlan(ПараметрыPOST)
	
	// Проверка необходимых параметров и возврат сообщения об ошибке
	//ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "DateStart, DateEnd, SiteInn, UserOS");   
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "DateStart, DateEnd, SiteInn");
	
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	
	DateStart 	= ПараметрыPOST.DateStart;
	DateEnd 	= ПараметрыPOST.DateEnd;
	Если Не ПараметрыPOST.Свойство("SiteInn") Тогда
		SiteInn="";
	Иначе
		SiteInn    = ПараметрыPOST.SiteInn;
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(SiteInn) Тогда
		Лико_Площадка = Справочники.Лико_Площадки.ПолучитьСсылку(Новый УникальныйИдентификатор(SiteInn));
	Иначе
		Лико_Площадка = "";
	КонецЕсли;

		
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗаявкиОстатки.ДокументОприходования.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ЕСТЬNULL(Лико_ПараметрыОтрузки.Контрагент, ЗаявкиОстатки.ЗаказКлиента.Контрагент) КАК Контрагент,
	|	ЗаявкиОстатки.ЗаказКлиента.Партнер КАК Партнер,
	|	СУММА(ЗаявкиОстатки.КоличествоКонечныйОстаток * ЕСТЬNULL(Лико_ПараметрыОтрузки.Цена, 0)) КАК Сумма,
	|	ЕСТЬNULL(Лико_ПараметрыОтрузки.Валюта, &ВалютаУпр) КАК Валюта
	|ПОМЕСТИТЬ ВТ_ОстаткиПоОтгрузкамСвернуто
	|ИЗ
	|	РегистрНакопления.Лико_ЗаявкиНаОтгрузку.ОстаткиИОбороты(
	|			ДАТАВРЕМЯ(3999, 12, 31),
	|			,
	|			День,
	|			ДвиженияИГраницыПериода,
	//|			ДокументОприходования.Организация = &Площадка
	|			ЗаказКлиента.Площадка = &Лико_Площадка
	|				И (ДокументОприходования.ДатаОтгрузки МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|				И НЕ ДокументОприходования.ТипОтгрузки В (ЗНАЧЕНИЕ(Перечисление.Лико_ТипыОтгрузкиГотовойПродукции.СписаниеСОрганизацииПроизводителя), ЗНАЧЕНИЕ(Перечисление.Лико_ТипыОтгрузкиГотовойПродукции.ПеремещениеКлиентуСоСкладаХранения), ЗНАЧЕНИЕ(Перечисление.Лико_ТипыОтгрузкиГотовойПродукции.СписаниеСоСкладаХранения))) КАК ЗаявкиОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыОтрузки КАК Лико_ПараметрыОтрузки
	|		ПО ЗаявкиОстатки.ЗаказКлиента = Лико_ПараметрыОтрузки.ЗаказКлиента
	|			И ЗаявкиОстатки.Номенклатура = Лико_ПараметрыОтрузки.Номенклатура
	|			И ЗаявкиОстатки.Характеристика = Лико_ПараметрыОтрузки.Характеристика
	|			И ЗаявкиОстатки.ДокументОприходования = Лико_ПараметрыОтрузки.Регистратор
	|			И ЗаявкиОстатки.Город = Лико_ПараметрыОтрузки.Город
	|			И ЗаявкиОстатки.Намотка = Лико_ПараметрыОтрузки.Намотка
	|			И ЗаявкиОстатки.Грузополучатель = Лико_ПараметрыОтрузки.Грузополучатель
	|			И ЗаявкиОстатки.НомерПоставки = Лико_ПараметрыОтрузки.НомерПоставки
	|			И ЗаявкиОстатки.КодЭтикеткиЗаказчика = Лико_ПараметрыОтрузки.КодЭтикеткиЗаказчика
	|			И ЗаявкиОстатки.ЧестныйЗнак = Лико_ПараметрыОтрузки.ЧестныйЗнак
	|ГДЕ
	|	ЗаявкиОстатки.КоличествоКонечныйОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаявкиОстатки.ДокументОприходования.ДатаОтгрузки,
	|	ЕСТЬNULL(Лико_ПараметрыОтрузки.Контрагент, ЗаявкиОстатки.ЗаказКлиента.Контрагент),
	|	ЗаявкиОстатки.ЗаказКлиента.Партнер,
	|	ЕСТЬNULL(Лико_ПараметрыОтрузки.Валюта, &ВалютаУпр)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КурсыВалютСрезПоследних.Валюта КАК Валюта,
	|	КурсыВалютСрезПоследних.Курс КАК Курс,
	|	КурсыВалютСрезПоследних.Кратность КАК Кратность
	|ПОМЕСТИТЬ ВТ_КурсыВалют
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(
	|			,
	|			Валюта В
	|				(ВЫБРАТЬ
	|					Т.Валюта
	|				ИЗ
	|					ВТ_ОстаткиПоОтгрузкамСвернуто КАК Т
	|				ГДЕ
	|					Т.Валюта <> &ВалютаРегл
	|				СГРУППИРОВАТЬ ПО
	|					Т.Валюта)) КАК КурсыВалютСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_КурсыВалют.Курс КАК Курс
	|ПОМЕСТИТЬ ВТ_КурсЕвро
	|ИЗ
	|	ВТ_КурсыВалют КАК ВТ_КурсыВалют
	|ГДЕ
	|	ВТ_КурсыВалют.Валюта = &ВалютаУпр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ОстаткиПоОтгрузкамСвернуто.Партнер КАК Партнер,
	|	ВТ_ОстаткиПоОтгрузкамСвернуто.Партнер.Наименование КАК PartnerName,
	|	ВТ_ОстаткиПоОтгрузкамСвернуто.Партнер.Код КАК PartnerCode,
	|	ВТ_ОстаткиПоОтгрузкамСвернуто.Контрагент.Наименование КАК contractorname,
	|	ВТ_ОстаткиПоОтгрузкамСвернуто.Контрагент.ИНН КАК contractorcode,
	|	ВТ_ОстаткиПоОтгрузкамСвернуто.ДатаОтгрузки КАК ShipmentDate,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_ОстаткиПоОтгрузкамСвернуто.Валюта = &ВалютаУпр
	|				ТОГДА ВТ_ОстаткиПоОтгрузкамСвернуто.Сумма
	|			КОГДА ВТ_ОстаткиПоОтгрузкамСвернуто.Валюта = &ВалютаРегл
	|				ТОГДА ВТ_ОстаткиПоОтгрузкамСвернуто.Сумма / ВТ_КурсЕвро.Курс
	|			ИНАЧЕ ВТ_ОстаткиПоОтгрузкамСвернуто.Сумма * ВТ_КурсыВалют.Курс / ВТ_КурсЕвро.Курс
	|		КОНЕЦ) КАК Sum,
	|	ЛОЖЬ КАК Overdue
	|ИЗ
	|	ВТ_ОстаткиПоОтгрузкамСвернуто КАК ВТ_ОстаткиПоОтгрузкамСвернуто
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КурсыВалют КАК ВТ_КурсыВалют
	|		ПО ВТ_ОстаткиПоОтгрузкамСвернуто.Валюта = ВТ_КурсыВалют.Валюта,
	|	ВТ_КурсЕвро КАК ВТ_КурсЕвро
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ОстаткиПоОтгрузкамСвернуто.Партнер,
	|	ВТ_ОстаткиПоОтгрузкамСвернуто.ДатаОтгрузки,
	|	ВТ_ОстаткиПоОтгрузкамСвернуто.Партнер.Наименование,
	|	ВТ_ОстаткиПоОтгрузкамСвернуто.Контрагент.Наименование,
	|	ВТ_ОстаткиПоОтгрузкамСвернуто.Партнер.Код,
	|	ВТ_ОстаткиПоОтгрузкамСвернуто.Контрагент.ИНН";
	
	Запрос.УстановитьПараметр("ВалютаРегл", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("ВалютаУпр", Константы.ВалютаУправленческогоУчета.Получить()); 
	
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(DateStart));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(DateEnd));
	//Запрос.УстановитьПараметр("Площадка", Справочники.Организации.НайтиПоРеквизиту("ИНН", SiteInn));
	Запрос.УстановитьПараметр("Лико_Площадка", Лико_Площадка);
	ТЗОтгрузки = Запрос.Выполнить().Выгрузить();
	
	МассивПартнеров = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ТЗОтгрузки.ВыгрузитьКолонку("Партнер"));
	ЗапросДолгов = Новый Запрос;
	ЗапросДолгов.Текст = Лико_Дополнительно.ПолучитьТекстЗапросаДолгиПоПартнерам();
	ЗапросДолгов.УстановитьПараметр("МассивПартнеров", МассивПартнеров);
	ЗапросДолгов.УстановитьПараметр("ТекДата", КонецДня(ТекущаяДата()));
	ЗапросДолгов.УстановитьПараметр("ВалютаРегл", Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросДолгов.УстановитьПараметр("ВалютаУпр", Константы.ВалютаУправленческогоУчета.Получить());
	ВыборкаДолгов = ЗапросДолгов.Выполнить().Выбрать();
	СоответствиеПарнеровИДолгов = Новый Соответствие;
	Пока ВыборкаДолгов.Следующий() Цикл
		СоответствиеПарнеровИДолгов.Вставить(ВыборкаДолгов.Партнер, ВыборкаДолгов.СуммаУпрДолгСУчетомПредоплаты);
	КонецЦикла;
	
	Для каждого Строка из ТЗОтгрузки Цикл
		ДолгПартнера = СоответствиеПарнеровИДолгов.Получить(Строка.Партнер); 
		Строка.Overdue = ЗначениеЗаполнено(ДолгПартнера) И ДолгПартнера > 0;
	КонецЦикла;
	
	
	Тз = ТЗОтгрузки;
	
	
	//Возврат HttpВернутьТзКакJSON(Тз); 
	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.ТPJSON(Тз));
	
	
	
КонецФункции


Функция Production(ПараметрыPOST)

	// Проверка необходимых параметров и возврат сообщения об ошибке
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "DateStart, DateEnd");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	
	DateStart 	= ПараметрыPOST.DateStart;
	DateEnd 	= ПараметрыPOST.DateEnd;
	
	Если Не ПараметрыPOST.Свойство("SiteInn") Тогда
		SiteInn="";
	Иначе
		SiteInn    = ПараметрыPOST.SiteInn;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(SiteInn) Тогда
		Лико_Площадка = Справочники.Лико_Площадки.ПолучитьСсылку(Новый УникальныйИдентификатор(SiteInn));
	Иначе
		Лико_Площадка = "";
	КонецЕсли;

	
	Запрос = Новый Запрос;
	
//Выпуск по клиентам из РезультатЗаказа	
#Область Выпуск_ПоКлиентам_ИзРезультатаЗаказа
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(Лико_ВыпускГПОбороты.Период) КАК Период,
		|	МАКСИМУМ(Лико_ВыпускГПОбороты.РабочийЦентр) КАК РабочийЦентр,
		|	Лико_ВыпускГПОбороты.Заказ КАК Заказ,
		|	Лико_ВыпускГПОбороты.Заказ.Менеджер КАК Менеджер,
		|	Лико_ВыпускГПОбороты.Заказ.Партнер КАК Партнер,
		|	СУММА(Лико_ВыпускГПОбороты.КоличествоОборот) КАК Количество,
		|	СУММА(Лико_ВыпускГПОбороты.МетражКВМОборот) КАК МетражКВМ,
		|	СУММА(Лико_ВыпускГПОбороты.МетражПМОборот) КАК МетражПМ,
		|	СУММА(Лико_ВыпускГПОбороты.СебестоимостьОборот) КАК лкСебестоимость,
		|	СУММА(Лико_ВыпускГПОбороты.СебестоимостьПланОборот) КАК лкСебестоимостьПлан,
		|	СУММА(ВЫБОР
		|			КОГДА Лико_ВыпускГПОбороты.Регистратор.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПроизводствоИзДавальческогоСырья)
