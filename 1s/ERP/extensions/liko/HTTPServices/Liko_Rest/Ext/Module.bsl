	|
	|СГРУППИРОВАТЬ ПО
	|	СебестоимостьТоваровОбороты.Регистратор,
	|	СебестоимостьТоваровОбороты.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры,
	|	СебестоимостьТоваровОбороты.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры.Менеджер,
	|	СебестоимостьТоваровОбороты.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры.Партнер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТДанные.Менеджер КАК Менеджер,
	|	ВТДанные.Партнер КАК Партнер,
	|	ВТДанные.Заказ.РабочийЦентр КАК РабочийЦентр,
	|	СУММА(ВЫРАЗИТЬ(ВТДанные.Выручка КАК ЧИСЛО(15, 0))) КАК Выручка,
	|	СУММА(ВЫРАЗИТЬ(ВТДанные.ВыручкаБезНДС КАК ЧИСЛО(15, 0))) КАК ВыручкаБезНДС,
	|	СУММА((ВЫРАЗИТЬ(0.87 * ВТДанные.Выручка КАК ЧИСЛО(15, 0))) - (ВЫРАЗИТЬ(ЕСТЬNULL(ВЫБОР
	|					КОГДА ВТДанные.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|						ТОГДА Лико_СебестоимостьЗаказовОбороты.СуммаПланРасход
	|					ИНАЧЕ -1 * Лико_СебестоимостьЗаказовОбороты.СуммаПланОборот
	|				КОНЕЦ, 0) КАК ЧИСЛО(15, 0)))) КАК ДоходПлан,
	|	СУММА((ВЫРАЗИТЬ(ВТДанные.ВыручкаБезНДС КАК ЧИСЛО(15, 0))) - (ВЫРАЗИТЬ(ЕСТЬNULL(ВЫБОР
	|					КОГДА ВТДанные.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|						ТОГДА Лико_СебестоимостьЗаказовОбороты.СуммаРасход
	|					ИНАЧЕ -1 * Лико_СебестоимостьЗаказовОбороты.СуммаОборот
	|				КОНЕЦ, 0) КАК ЧИСЛО(15, 0)))) КАК Доход,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТДанные.Регистратор) КАК КоличествоДокументов,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТДанные.Заказ) КАК КоличествоЗаказов
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	ВТДанные КАК ВТДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Лико_СебестоимостьЗаказов.Обороты(, , Регистратор, ) КАК Лико_СебестоимостьЗаказовОбороты
	|		ПО ВТДанные.Регистратор = Лико_СебестоимостьЗаказовОбороты.Регистратор
	|			И ВТДанные.Заказ = Лико_СебестоимостьЗаказовОбороты.Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТДанные.Менеджер,
	|	ВТДанные.Партнер,
	|	ВТДанные.Заказ.РабочийЦентр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ВТ.Менеджер.Наименование, """") КАК Manager,
	|	ЕСТЬNULL(ВТ.Партнер.Код, """") КАК PartnerCode,
	|	ЕСТЬNULL(ВТ.Партнер.Наименование, """") КАК PartnerName,
	|	ЕСТЬNULL(ВТ.РабочийЦентр.ПорядковыйНомер, 0) КАК WorkCenterNumber,
	|	ЕСТЬNULL(ВТ.РабочийЦентр.Наименование, """") КАК WorkCenterName,
	|	ЕСТЬNULL(ВТ.Выручка, 0) КАК Cost,
	|	ЕСТЬNULL(ВТ.ВыручкаБезНДС, 0) КАК CostNoTax,
	|	ЕСТЬNULL(ВТ.Доход, 0) КАК EstimatedGrossProfit,
	|	ЕСТЬNULL(ВТ.ДоходПлан, 0) КАК EstimatedGrossProfitPlan,
	|	ВТ.КоличествоДокументов КАК DocsQt,
	|	ВТ.КоличествоЗаказов КАК OrdersQt
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	ВТ.Выручка > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Cost УБЫВ";
	
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Дата(DateStart)));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Дата(DateEnd)));
	Запрос.УстановитьПараметр("ТекущийПользователь",Пользователь);	
	//Запрос.УстановитьПараметр("SiteInn", SiteInn);  
	Запрос.УстановитьПараметр("Лико_Площадка", Лико_Площадка);
	Запрос.УстановитьПараметр("Manager", Manager);
	
	
	Тз = Запрос.Выполнить().Выгрузить();
	
	
	Возврат HttpВернутьТзКакJSON(Тз);
	
	
КонецФункции


Функция SalesStatistics(ПараметрыPOST)
	
	// Проверка необходимых параметров и возврат сообщения об ошибке
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "DateStart, DateEnd, SiteInn ");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
		
	DateStart 	= ПараметрыPOST.DateStart;
	DateEnd 	= ПараметрыPOST.DateEnd;
	
	Если Не ПараметрыPOST.Свойство("SiteInn") Тогда
		SiteInn="";
	Иначе
		SiteInn    = ПараметрыPOST.SiteInn;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(SiteInn) Тогда
		Лико_Площадка = Справочники.Лико_Площадки.ПолучитьСсылку(Новый УникальныйИдентификатор(SiteInn));
	Иначе
		Лико_Площадка = "";
	КонецЕсли;

	
	#Область Статистика
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВыручкаИСебестоимостьПродажОбороты.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	НАЧАЛОПЕРИОДА(ВыручкаИСебестоимостьПродажОбороты.Период, МЕСЯЦ) КАК Период,
	|	ВЫБОР
	|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.ПриобретениеУслугПрочихАктивов
	|				ИЛИ ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.КорректировкаРегистров
	|			ТОГДА ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента
	|		ИНАЧЕ ВыручкаИСебестоимостьПродажОбороты.Регистратор
	|	КОНЕЦ КАК Регистратор,
	|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
	|	ЕСТЬNULL(ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры, ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)) КАК Заказ,
	|	СУММА(ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиОборот) КАК ВыручкаПоПродажеЗаказа,
	|	СУММА(ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиБезНДСОборот) КАК ВыручкаПоПродажеЗаказаБезНДС,
	|	СУММА(ВыручкаИСебестоимостьПродажОбороты.КоличествоОборот) КАК Количество,
	|	СУММА(ВЫРАЗИТЬ(ВыручкаИСебестоимостьПродажОбороты.КоличествоОборот * ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура.ПлощадьЧислитель КАК ЧИСЛО(15, 0))) КАК Площадь
	|ПОМЕСТИТЬ ВТПродажиПоЗаказу
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			&ДатаНачала,
	|			&ДатаОкончания,
	|			Регистратор,
	|			ВЫБОР
	|					КОГДА &Лико_Площадка = """"
	|						ТОГДА ИСТИНА
	//|					ИНАЧЕ АналитикаУчетаПоПартнерам.Договор.Лико_Площадка.Организация.ИНН = &SiteInn 
	|					ИНАЧЕ АналитикаУчетаПоПартнерам.Договор.Лико_Площадка = &Лико_Площадка
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА АналитикаУчетаНоменклатуры.Номенклатура.ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|						ТОГДА АналитикаУчетаНоменклатуры.Номенклатура.ГруппаФинансовогоУчета.Наименование = ""90 услуги прочее""
	|					ИНАЧЕ АналитикаУчетаНоменклатуры.Номенклатура.ВидНоменклатуры.Лико_НоменклатураЭтикеток = ИСТИНА
	|				КОНЕЦ
	|				И НЕ ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияТоваровВДругуюОрганизацию)
	|				И ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияКлиенту)) КАК ВыручкаИСебестоимостьПродажОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры.ДополнительныеРеквизиты КАК ПартнерыДополнительныеРеквизиты
	|		ПО ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаПоПартнерам.Партнер = ПартнерыДополнительныеРеквизиты.Ссылка
	|			И (ПартнерыДополнительныеРеквизиты.Свойство.Имя = ""Лико_СобственнаяОрганизация"")
	|ГДЕ
	|	ПартнерыДополнительныеРеквизиты.Значение ЕСТЬ NULL
	|	И ВЫБОР
	|			КОГДА ВыручкаИСебестоимостьПродажОбороты.Период < ДАТАВРЕМЯ(2020, 1, 1, 0, 0, 0)
	|				ТОГДА ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаПоПартнерам.Договор.Лико_Площадка.Наименование = "" Ликофлекс""
	|						ИЛИ ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаПоПартнерам.Договор.Лико_Площадка.Наименование = ""ОКИЛ-САТО Икс-Пак ООО""
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыручкаИСебестоимостьПродажОбороты.ХозяйственнаяОперация,
	|	ЕСТЬNULL(ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры, ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)),
	|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаПоПартнерам,
	|	НАЧАЛОПЕРИОДА(ВыручкаИСебестоимостьПродажОбороты.Период, МЕСЯЦ),
	|	ВЫБОР
	|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.ПриобретениеУслугПрочихАктивов
	|				ИЛИ ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.КорректировкаРегистров
	|			ТОГДА ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента
	|		ИНАЧЕ ВыручкаИСебестоимостьПродажОбороты.Регистратор
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПродажиПоЗаказу.Регистратор КАК Регистратор,
	|	ВТПродажиПоЗаказу.Заказ КАК Заказ,
	|	СУММА(ВыручкаИСебестоимостьПродажОбороты.КоличествоОборот) КАК КоличествоВозврат,
	|	ВТПродажиПоЗаказу.Количество КАК Количество
	|ПОМЕСТИТЬ ВТВозвраты
	|ИЗ
	|	ВТПродажиПоЗаказу КАК ВТПродажиПоЗаказу
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(, , Регистратор, ) КАК ВыручкаИСебестоимостьПродажОбороты
	|		ПО ВТПродажиПоЗаказу.Регистратор = ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента
	|			И ВТПродажиПоЗаказу.Заказ = ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Характеристика.Лико_ЗаказНоменклатуры
	|			И ВТПродажиПоЗаказу.АналитикаУчетаПоПартнерам = ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаПоПартнерам
	|ГДЕ
	|	(ВЫРАЗИТЬ(ВыручкаИСебестоимостьПродажОбороты.Регистратор КАК Документ.ВозвратТоваровОтКлиента) ССЫЛКА Документ.ВозвратТоваровОтКлиента
	|			ИЛИ ВЫРАЗИТЬ(ВыручкаИСебестоимостьПродажОбороты.Регистратор КАК Документ.КорректировкаРеализации) ССЫЛКА Документ.КорректировкаРеализации)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТПродажиПоЗаказу.Заказ,
	|	ВТПродажиПоЗаказу.Регистратор,
	|	ВТПродажиПоЗаказу.Количество
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТВозвраты.Регистратор КАК Регистратор,
	|	ВТВозвраты.Заказ КАК Заказ,
	|	(ВТВозвраты.Количество + ВТВозвраты.КоличествоВозврат) / ВТВозвраты.Количество КАК КоэффициентВозврата
	|ПОМЕСТИТЬ Возвраты
	|ИЗ
	|	ВТВозвраты КАК ВТВозвраты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПродажиПоЗаказу.Регистратор КАК Регистратор,
	|	ВТПродажиПоЗаказу.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	СУММА(ВТПродажиПоЗаказу.ВыручкаПоПродажеЗаказа) КАК ВыручкаПоПродаже,
	|	СУММА(ВТПродажиПоЗаказу.ВыручкаПоПродажеЗаказаБезНДС) КАК ВыручкаПоПродажеБезНДС
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	ВТПродажиПоЗаказу КАК ВТПродажиПоЗаказу
	|ГДЕ
	|	ВТПродажиПоЗаказу.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияКлиенту)
	|	И ВТПродажиПоЗаказу.ВыручкаПоПродажеЗаказа <> 0
	|	И НЕ ВТПродажиПоЗаказу.Регистратор ССЫЛКА Документ.КорректировкаРеализации
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТПродажиПоЗаказу.Регистратор,
	|	ВТПродажиПоЗаказу.ХозяйственнаяОперация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПродажи.Регистратор КАК Регистратор,
	|	СУММА(ЕСТЬNULL(РасчетыСКлиентамиПоСрокамОстатки.ДолгУпрОстаток, 0)) КАК ОстатокРасчетов
	|ПОМЕСТИТЬ ПродажиСОстаткамиРасчетов
	|ИЗ
	|	ВТПродажи КАК ВТПродажи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки КАК РасчетыСКлиентамиПоСрокамОстатки
	|		ПО ВТПродажи.Регистратор = РасчетыСКлиентамиПоСрокамОстатки.РасчетныйДокумент
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТПродажи.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПродажи.Регистратор КАК Регистратор,
	|	СУММА(ЕСТЬNULL(РасчетыСКлиентамиПоСрокам.ДолгУпр, 0)) КАК Оплата
	|ПОМЕСТИТЬ ВТОплаты
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам КАК РасчетыСКлиентамиПоСрокам
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПродажи КАК ВТПродажи
	|		ПО (ВТПродажи.Регистратор = РасчетыСКлиентамиПоСрокам.РасчетныйДокумент)
