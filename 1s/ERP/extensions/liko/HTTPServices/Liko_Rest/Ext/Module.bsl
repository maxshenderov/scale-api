// Проверка наличия набора параметров в POST-запросе и возврат сообщения об ошибке
Функция ПроверитьОбязательныеПараметры(Структура, ПараметрыОднойСтрокойЧерезЗапятую)
	МассивПараметров = СтрРазделить(ПараметрыОднойСтрокойЧерезЗапятую, ",", Ложь);
	МассивОтсутствующихПараметров = Новый Массив;
	
	Для Каждого Параметр Из МассивПараметров Цикл
		Параметр = СокрЛП(Параметр);
		Если Не ЕстьСвойство(Структура, Параметр) Тогда
			МассивОтсутствующихПараметров.Добавить(Параметр)
		КонецЕсли;
	КонецЦикла;
	
	Если МассивОтсутствующихПараметров.Количество() = 0 Тогда
		Возврат 0;
	Иначе
		СообщениеОбОшибке = "Необходимо передать следующие обязательные параметры: ";
		
		Первый = Истина;
		Для Каждого Параметр Из МассивОтсутствующихПараметров Цикл
			Если Не Первый Тогда
				СообщениеОбОшибке = СообщениеОбОшибке + ", ";
			КонецЕсли;
			СообщениеОбОшибке = СообщениеОбОшибке + "'" + Параметр + "'";
			Первый = Ложь;
		КонецЦикла;
		
		Возврат HttpВернутьОшибку(400, СообщениеОбОшибке);
	КонецЕсли
	
КонецФункции

