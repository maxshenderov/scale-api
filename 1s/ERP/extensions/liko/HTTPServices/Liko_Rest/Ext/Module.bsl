	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	|	ЗаказКлиентаТовары.Номенклатура.Артикул КАК Артикул,
	|	ЗаказКлиентаТовары.Номенклатура.Наименование КАК Наименование
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка.Номер = &Номер
	|	И ЗаказКлиентаТовары.Ссылка.Дата = &Дата
	|	И ЗаказКлиентаТовары.ОригиналМакет <> """"";
	Запрос.УстановитьПараметр("Номер",OrderNum );
	Запрос.УстановитьПараметр("Дата",OrderDate );
	
	Массив = Новый Массив();
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл 
		ОМ=Выборка.ОригиналМакет;
		Для каждого Файл Из ОМ.файлы Цикл
			
			
			ДД=ПолучитьДвоичныеДанныеОригиналМакета(ОМ,Файл.ИдентификаторФайла);
			Base64 = Base64Строка(ДД); 
			Если ДД<>Неопределено Тогда
				Структура = Новый Структура;
				Структура.Вставить("article",Выборка.Артикул);
				Структура.Вставить("name",Выборка.Наименование);
				Структура.Вставить("filename",Файл.ИмяФайла);
				Структура.Вставить("content",Base64);
				
				Массив.Добавить(Структура);
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла; 
	
	
	
	Возврат HttpВернутьСтруктуруКакJSON(Массив);
	
