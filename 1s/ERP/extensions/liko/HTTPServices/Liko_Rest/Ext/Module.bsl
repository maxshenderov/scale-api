	ДатаЗаказа= Дата(СтрЗаменить(СтрЗаменить(СтрЗаменить(ПараметрыPOST.ЗаказДата,"T",""),":",""),"-",""));
	
	Параметры = Новый Структура;
	
	Параметры.Вставить("Дата", ТекущаяДата());
	Параметры.Вставить("Заказ", Документы.ЗаказКлиента.НайтиПоНомеру(ПараметрыPOST.Заказ,ДатаЗаказа)); 
	Параметры.Вставить("НомерБланка",ПараметрыPOST.НомерБланка);
	Параметры.Вставить("НомерПроката",ПараметрыPOST.НомерПроката);
	Параметры.Вставить("Причина",ПараметрыPOST.Причина);
	Параметры.Вставить("Статус",Перечисления.ТССтатусыЗаказов[ПараметрыPOST.Статус]); 	
	Параметры.Вставить("КоличествоЗаявлено",?(ПараметрыPOST.Свойство("КоличествоЗаявлено"),ПараметрыPOST.КоличествоЗаявлено,0));
	Параметры.Вставить("КоличествоПодтверждено",?(ПараметрыPOST.Свойство("КоличествоПодтверждено"),ПараметрыPOST.КоличествоЗаявлено,0));	
	Параметры.Вставить("Материал",?(ПараметрыPOST.Свойство("Материал"),Справочники.Номенклатура.НайтиПоКоду(ПараметрыPOST.Материал),Неопределено));
	Параметры.Вставить("Оператор",Справочники.ФизическиеЛица.НайтиПоНаименованию(ПараметрыPOST.Оператор));	
	Параметры.Вставить("РабочийЦентр",РабочееМесто.ТСРабочийЦентр);
	
	
	
	
	
	Если НЕ ЗначениеЗаполнено(РабочееМесто) Тогда
		
		Возврат HttpВернутьОшибку(424, "Не найдено рабочее место");
		
	КонецЕсли; 	
	
	ДокОбъект = Документы.Лико_КартаПерерасхода.СоздатьДокумент(); 
	ДокОбъект.Заполнить(Параметры);
	
	Если Не ДокОбъект.ПроверитьЗаполнение() Тогда
		
		МассивОшибок = ПолучитьСообщенияПользователю();
		МассивОшибок = УдалениеДублейВМассивеОшибок(МассивОшибок);	
		ТекстСообщений ="";
		
		Для каждого ОШ Из МассивОшибок Цикл
			
			ТекстСообщений= ТекстСообщений+ОШ;	
			
		КонецЦикла;
		
		Ошибка =  СтрШаблон(
		НСтр("ru = 'Не удалось создать карту перерасхода по заказу: %1
		|%2'"),
		ПараметрыPOST.Заказ,
		ТекстСообщений
		);
		Результат = Новый Структура;		
		Результат.Вставить("status", "error");
		Результат.Вставить("error", Ошибка);
		
	Иначе
		
	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
        Результат = Новый Структура;		
		Результат.Вставить("status", "success");
		Результат.Вставить("message", "Карта перерасхода успешно создана");
		Результат.Вставить("documentNumber", ДокОбъект.Номер);
		Результат.Вставить("documentDate", ДокОбъект.Дата);			
		
	Исключение
		
		МассивОшибок = ПолучитьСообщенияПользователю();
		МассивОшибок = УдалениеДублейВМассивеОшибок(МассивОшибок);		
				
		ТекстСообщений ="";
		
		Для каждого ОШ Из МассивОшибок Цикл
			
			ТекстСообщений= ТекстСообщений+ОШ;	
			
		КонецЦикла;
		
		Ошибка =  СтрШаблон(
		НСтр("ru = 'Не удалось создать карту перерасхода по заказу: %1
		|%2'"),
		ПараметрыPOST.Заказ,
		ТекстСообщений
		);
		Результат = Новый Структура;		
		Результат.Вставить("status", "error");
		Результат.Вставить("error", Ошибка);
		
		КонецПопытки;	
				
	КонецЕсли;	
	
	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(Результат));
	
