Процедура ПолучитьСсылкуИзШтрихКода(Ссылка,ПараметрыPOST)
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли; 
	
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST,"Barcode");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат;
	КонецЕсли;  
	
	ШтрихКод=ПараметрыPOST.Barcode;
	
	СтруктураШК=Лико_Дополнительно.ОбработатьШтрихКодНеТовараСервер(ШтрихКод); 
	
	Если СтруктураШК.ВидШК=Перечисления.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры_Короткий Тогда 
		
		Ссылка=СтруктураШК.ОбъектНоменклатуры ;
		
	ИначеЕсли  СтруктураШК.ВидШК=Перечисления.ЯС_ВидыШК.ШК_Сотрудника Тогда
		
		Ссылка=СтруктураШК.Сотрудник;
		
	ИначеЕсли  СтруктураШК.ВидШК=Перечисления.ЯС_ВидыШК.ШК_Заказа Тогда
		
		Ссылка =Документы.ЗаказКлиента.НайтиПоРеквизиту("НомерБезПрефикса",СтруктураШК.НомерЗаказа); 		
		
	ИначеЕсли СтруктураШК.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_Конверта") Тогда
		
		Ссылка= СтруктураШК.Конверт; 	
		
	ИначеЕсли СтруктураШК.ВидШК = ПредопределенноеЗначение("Перечисление.ЯС_ВидыШК.ШК_РабочегоЦентра") Тогда
		
		Ссылка=СтруктураШК.РабочийЦентр;		
		
	ИначеЕсли СтруктураШК.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Адреса")
		ИЛИ СтруктураШК.ВидШК = Лико_Дополнительно.ПолучитьЗначениеПредопределенныхДанных("Перечисления.ЯС_ВидыШК.ШК_Адреса_Короткий") Тогда
		//Это ячейка
		Ссылка=СтруктураШК.АдресаХранения;
		
	КонецЕсли;
	
	
	
КонецПроцедуры

