Функция ProfitabilityReport(ПараметрыPOST)
	// Проверка необходимых параметров и возврат сообщения об ошибке
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "DateStart, DateEnd, UserOS");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	// Найдем пользователя 1с
	UserOS = ПараметрыPOST.UserOS;
	Если НЕ ЗначениеЗаполнено(UserOS) Тогда
		Возврат HttpВернутьОшибку(424, "Не передан UserOS");
	КонецЕсли;
	
	Пользователь=ПолучитьПользователя(UserOS);
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Возврат HttpВернутьОшибку(424, "В 1С не найден пользователь с вашим UserOS");
	Иначе
		Если Пользователь.Лико_Площадки.Количество() =0  Тогда
			Возврат HttpВернутьОшибку(403, "В 1С для вашего пользователя не заданы доступные площадки");		
		КонецЕсли;	
	КонецЕсли;
	
	DateStart 	= ПараметрыPOST.DateStart;
	DateEnd 	= ПараметрыPOST.DateEnd;
	
	Если Не ПараметрыPOST.Свойство("SiteInn") Тогда
		SiteInn="";
	Иначе
		SiteInn    = ПараметрыPOST.SiteInn;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(SiteInn) Тогда
		Лико_Площадка = Справочники.Лико_Площадки.ПолучитьСсылку(Новый УникальныйИдентификатор(SiteInn));
	Иначе
		Лико_Площадка = "";
	КонецЕсли;

	
	//Если Пользователь.Лико_Площадки.Количество() <3  Тогда
	//	Если  SiteInn="" ИЛИ SiteInn= Пользователь.Лико_Площадки[0].Организация.ИНН Тогда 
	//		SiteInn= Пользователь.Лико_Площадки[0].Организация.ИНН;
	//	Иначе  SiteInn= "20202020";
	//	КонецЕсли;
	//КонецЕсли; 
	
	Если Пользователь.Лико_Площадки.Количество() <3  Тогда
		Если Лико_Площадка="" Или  Лико_Площадка= Пользователь.Лико_Площадки[0].Площадка Тогда 
			Лико_Площадка= Пользователь.Лико_Площадки[0].Площадка;			
		Иначе  Лико_Площадка= "20202020";					
		КонецЕсли;
	КонецЕсли; 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА ЗаказКлиента.Площадка.Организация.Наименование = "" Ликофлекс""
	|			ТОГДА 1
	|		КОГДА ЗаказКлиента.Площадка.Организация.Наименование = ""ОКИЛ-САТО Икс-Пак ООО""
	|			ТОГДА 2
	|		КОГДА ЗаказКлиента.Площадка.Организация.Наименование = "" ОКИЛ-САТО Урал ООО""
	|			ТОГДА 3
	|		ИНАЧЕ 4
	|	КОНЕЦ КАК Issue,
	|	ЗаказКлиента.Площадка.Организация.Наименование КАК OrganizationName,
	|	ЗаказКлиента.Площадка.Организация.ИНН КАК OrganizationCode,
	|	ВЫБОР
	|		КОГДА ЗаказКлиента.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.indigo)
	|				ИЛИ ЗаказКлиента.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.Cartes)
	|				ИЛИ ЗаказКлиента.РабочийЦентр.ВидРабочегоЦентра = ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.Omega)
	|					И ЗаказКлиента.РабочийЦентр.ПорядковыйНомер <> 18
	|			ТОГДА ""2 Цифровой участок""
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЗаказКлиента.ТипЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЗаказов.ВплавляемаяЭтикетка)
	|					ТОГДА ""3 In-Mold""
	|				КОГДА ЗаказКлиента.ТипЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЗаказов.Термоусадка)
	|					ТОГДА ""4 Термоусадка""
	|				КОГДА ЗаказКлиента.ТипЗаказа = ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЗаказов.Полуфабрикат)
	|					ТОГДА ""5 Полуфабрикат""
	|				ИНАЧЕ ""1 Основное пр-во""
	|			КОНЕЦ
