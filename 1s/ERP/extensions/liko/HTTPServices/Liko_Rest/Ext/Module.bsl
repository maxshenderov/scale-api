	ОтображениеРазделовСайта=УправлениеСвойствами.ЗначениеСвойства(Пользователь,"Лико_ОтображениеРазделовСайта");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Лико_ОтображениеРазделовСайтаРазделы.Раздел.Наименование КАК SectionName,
