	КонецЕсли;
	
	OrderNum  = ПараметрыPOST.OrderNum;
	OrderDate = ПараметрыPOST.OrderDate;
	Если ПараметрыPOST.Свойство("OrderDate") Тогда
		OrderDate = Дата(ПараметрыPOST.OrderDate);
	Иначе
		OrderDate = '00010101';
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
