Функция TouchPad_SetColor(ПараметрыPOST) 	 
	
	Отказ = Ложь;
	
	error="";
	
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "TPID,ЗаказНомер,КлючСтроки,ШтрихКод");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	TPID = ПараметрыPOST.TPID;
	РабочееМесто=Справочники.Лико_РабочиеМеста.НайтиПоКоду(TPID);
	ЗаказНомер = ПараметрыPOST.ЗаказНомер;
	КлючСтроки = Новый УникальныйИдентификатор(ПараметрыPOST.КлючСтроки);
	ШтрихКод = ПараметрыPOST.ШтрихКод;
	ЦеноваяГруппа=Неопределено;
	Номенклатура=Неопределено;
	
	СтруктураШК=Лико_Дополнительно.ОбработатьШтрихКодНеТовараСервер(ШтрихКод);
	Если СтруктураШК.ВидШК=Перечисления.ЯС_ВидыШК.ШК_ОбъектаНоменклатуры_Короткий Тогда 
		ОбъектНоменклатуры=СтруктураШК.ОбъектНоменклатуры ;
		ЦеноваяГруппа=ОбъектНоменклатуры.Номенклатура.ЦеноваяГруппа;
		Номенклатура=ОбъектНоменклатуры.Номенклатура;
	КонецЕсли;
	
	
	
	ЗаказКлиента=Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказКлиентаЦвета.КлючСтроки КАК КлючСтроки,
	|	ЗаказКлиентаЦвета.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказКлиента.Цвета КАК ЗаказКлиентаЦвета
	|ГДЕ
	|	ЗаказКлиентаЦвета.КлючСтроки = &КлючСтроки
	|	И ЗаказКлиентаЦвета.Ссылка.Номер = &Номер";
	Запрос.УстановитьПараметр("КлючСтроки",КлючСтроки );
	Запрос.УстановитьПараметр("Номер",ЗаказНомер );
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаказКлиента=Выборка.Ссылка;
	КонецЦикла; 
	
	ready=Ложь;	
	
	Если ЗначениеЗаполнено(ЗаказКлиента) И ЗначениеЗаполнено(ЦеноваяГруппа) Тогда
		УстановитьПривилегированныйРежим(Истина);	
		ДокОбъект=ЗаказКлиента.ПолучитьОбъект();
		//ДокОбъект=Документы.ЗаказКлиента.СоздатьДокумент();
		ДокОбъект.ОбменДанными.Загрузка=Истина;
		НайденныеСтроки=ДокОбъект.Цвета.НайтиСтроки(Новый Структура("КлючСтроки",КлючСтроки));
		
		
		Для каждого СтрТЗ Из НайденныеСтроки Цикл
			
			СообщениеОбОшибке=Лико_ОбщегоНазначенияСервер.ПроверкаСвойствТМЦ(Номенклатура
			,СтрТЗ.ВидТМЦ
			,СтрТЗ.ВидСекции
			,СтрТЗ.ТипКраски);
			
			Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда 
				Отказ	=	Истина;	
				error 	=	СообщениеОбОшибке;				
				ready	=	ложь;
				
				Прервать;
				
			КонецЕсли;			
			
			СтрТЗ.ТипКраски=ЦеноваяГруппа;
			
			Если ЗначениеЗаполнено(Номенклатура) Тогда
				СтрТЗ.Номенклатура= Номенклатура;
				СтрТЗ.УтвердилОператор=Лико_Дополнительно.ОпределитьРаботникаПоТабНомеру(ПараметрыPOST.UserNumber,ДокОбъект.ДатаУтвержденияОператором); 			
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Не Отказ Тогда	   
		Если ПараметрыPOST.Свойство("UserNumber") Тогда 
			
			//ДокОбъект.ДатаУтвержденияОператором=ТекущаяДата();
			//ДокОбъект.УтвердилОператор=Лико_Дополнительно.ОпределитьРаботникаПоТабНомеру(ПараметрыPOST.UserNumber,ДокОбъект.ДатаУтвержденияОператором);
			
		КонецЕсли;
		
		ДокОбъект.Записать();		
		ready=Истина;
	КонецЕсли;
	
	
	Структура = Новый Структура;
	Структура.Вставить("ready", ready);
	Структура.Вставить("error", error);
	
	
	Возврат HttpВернутьСтруктуруКакJSON(Структура);
	
	
	
КонецФункции 

Функция TouchPad_GetWorkplaceParams (ПараметрыPOST) 	 
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "WPID");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	TPID = ПараметрыPOST.WPID ;
	РабочееМесто=Справочники.Лико_РабочиеМеста.НайтиПоКоду(TPID);
	
	functions= Новый Массив;
	Для каждого СтрФункционал Из РабочееМесто.ФункционалДляВебТерминала Цикл
		Структура = Новый Структура;
		Структура.Вставить("code",СтрФункционал.Сервис.Код); 
		Структура.Вставить("name",СтрФункционал.Сервис.Наименование); 
		functions.Добавить(Структура);		
	КонецЦикла;
	
	Структура = Новый Структура;
	Структура.Вставить("workplace",РабочееМесто.Код);
	Структура.Вставить("touchpad",РабочееМесто.ТипРабочегоМеста=Перечисления.Лико_ТипыРабочегоМеста.Инфопад);
	Структура.Вставить("functions",functions);	
	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(Структура));	
	
	
КонецФункции 

Функция TouchPad_WriteОffМaterials (ПараметрыPOST) 	 
	
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "WPID,UserNumber,Мaterials");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	TPID = ПараметрыPOST.WPID ;
	РабочееМесто=Справочники.Лико_РабочиеМеста.НайтиПоКоду(TPID);	
	
	Мaterials=ПараметрыPOST.Мaterials; 
	UserNumber=ПараметрыPOST.UserNumber;
	
	
	МассивСерий = Новый Массив(); 
	МассивОбъектов = Новый Массив();
	
	
	Для каждого Мaterial Из Мaterials Цикл
		//СтруктураШК=Лико_Дополнительно.ОбработатьШтрихКодНеТовараСервер(ШтрихКод); 
		СтруктураОбъектов = Новый Структура;
		
		СтруктураОбъектов.Вставить("ОбъектНоменклатуры", Справочники.ЯССМ_ОбъектыНоменклатуры.ПолучитьСсылку( Новый УникальныйИдентификатор(Мaterial.Материал)));
		СтруктураОбъектов.Вставить("Адрес", Справочники.СкладскиеЯчейки.ПолучитьСсылку(Новый УникальныйИдентификатор(Мaterial.Адрес)));
		СтруктураОбъектов.Вставить("Количество",Число(Мaterial.Количество)); 
		СтруктураОбъектов.Вставить("Серия",СтруктураОбъектов.ОбъектНоменклатуры.Серия);
		Если ЗначениеЗаполнено(СтруктураОбъектов.ОбъектНоменклатуры) И СтруктураОбъектов.ОбъектНоменклатуры.Уникальный Тогда 
			
			МассивСерий.Добавить(СтруктураОбъектов.Серия) ;
			
		Иначе
			
			МассивОбъектов.Добавить(СтруктураОбъектов) ; 
			
		КонецЕсли;		
	КонецЦикла;		
	
	Сотрудник=Лико_Дополнительно.ОпределитьРаботникаПоТабНомеру(UserNumber,ТекущаяДата());
	
	Структура = Новый Структура;
	Структура.Вставить("РабочееМесто",РабочееМесто);
	Структура.Вставить("Организация",УправлениеСвойствами.ЗначениеСвойства(РабочееМесто.Пользователь,"Организация_e4c9d825676549a1a5c19972efa7da0b"));
	Структура.Вставить("Подразделение",РабочееМесто.Пользователь.Подразделение);
	Структура.Вставить("Склад",РабочееМесто.СкладСИМ);
	Структура.Вставить("АвторДокумента",?(ЗначениеЗаполнено(Сотрудник),Сотрудник,РабочееМесто.СотрудникПоF2));
	Структура.Вставить("Сотрудник",?(ЗначениеЗаполнено(Сотрудник),Сотрудник,РабочееМесто.СотрудникПоF2));
	
	Структура.Вставить("МассивСерий",МассивСерий);
	Структура.Вставить("МассивОбъектов",МассивОбъектов);
	
	
	Результат=Лико_ОбщегоНазначенияСервер.СписаниеОбъектовНоменклатурыСоСклада(Структура);
	
	
	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("result",Число(ЗначениеЗаполнено(Результат)));
	
	Если ЗначениеЗаполнено(Результат) Тогда
		СтруктураОтвет.Вставить("DocDate",Результат.Дата);
		СтруктураОтвет.Вставить("DocNumber",Результат.Номер);		
	КонецЕсли;
	
	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));	
	
	
КонецФункции 

Функция TouchPad_MovingМaterials (ПараметрыPOST) 	 
	
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "WPID,UserNumber,Мaterials,Address");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	TPID 			= ПараметрыPOST.WPID ;
	РабочееМесто	= Справочники.Лико_РабочиеМеста.НайтиПоКоду(TPID);	
	Мaterials		= ПараметрыPOST.Мaterials; 
	UserNumber		= ПараметрыPOST.UserNumber; 
	Address			= ПараметрыPOST.Address; 	
	
	МассивСерий 	= Новый Массив(); 
	МассивОбъектов 	= Новый Массив();	
	
	Для каждого Мaterial Из Мaterials Цикл
		
		СтруктураОбъектов = Новый Структура;		
		СтруктураОбъектов.Вставить("ОбъектНоменклатуры", Справочники.ЯССМ_ОбъектыНоменклатуры.ПолучитьСсылку( Новый УникальныйИдентификатор(Мaterial.Материал)));
		СтруктураОбъектов.Вставить("Адрес", Справочники.СкладскиеЯчейки.ПолучитьСсылку(Новый УникальныйИдентификатор(Мaterial.Адрес)));
		СтруктураОбъектов.Вставить("Количество",Число(Мaterial.Количество)); 
		СтруктураОбъектов.Вставить("Серия",СтруктураОбъектов.ОбъектНоменклатуры.Серия);
		
		Если ЗначениеЗаполнено(СтруктураОбъектов.ОбъектНоменклатуры) И СтруктураОбъектов.ОбъектНоменклатуры.Уникальный Тогда
			МассивСерий.Добавить(СтруктураОбъектов.Серия) ;
		Иначе
			МассивОбъектов.Добавить(СтруктураОбъектов) ;  			 
		КонецЕсли;
		
	КонецЦикла;	
	
	АдресаХранения= Справочники.СкладскиеЯчейки.ПолучитьСсылку( Новый УникальныйИдентификатор(Address)); 	
	Сотрудник=Лико_Дополнительно.ОпределитьРаботникаПоТабНомеру(UserNumber,ТекущаяДата());
	
	Структура = Новый Структура;
	Структура.Вставить("РабочееМесто",РабочееМесто);
	Структура.Вставить("Организация",УправлениеСвойствами.ЗначениеСвойства(РабочееМесто.Пользователь,"Организация_e4c9d825676549a1a5c19972efa7da0b"));
	Структура.Вставить("Подразделение",РабочееМесто.Пользователь.Подразделение);
	Структура.Вставить("Склад",РабочееМесто.СкладСИМ);
	Структура.Вставить("АвторДокумента",?(ЗначениеЗаполнено(Сотрудник),Сотрудник,РабочееМесто.СотрудникПоF2));
	Структура.Вставить("Сотрудник",?(ЗначениеЗаполнено(Сотрудник),Сотрудник,РабочееМесто.СотрудникПоF2));
	
	Структура.Вставить("МассивСерий",МассивСерий);
	Структура.Вставить("МассивОбъектов",МассивОбъектов);	
	Структура.Вставить("АдресХранения",АдресаХранения); 
	
	Результат=Лико_ОбщегоНазначенияСервер.ПеремещениеОбъектовНоменклатуры(Структура);	
	
	СтруктураОтвет = Новый Структура;
	СтруктураОтвет.Вставить("result",Число(ЗначениеЗаполнено(Результат)И ТипЗнч(Результат)=Тип("ДокументСсылка.Лико_ПередачаТоваров")));
	
	Если ЗначениеЗаполнено(Результат)  Тогда 
		Если ТипЗнч(Результат)=Тип("ДокументСсылка.Лико_ПередачаТоваров") Тогда
			СтруктураОтвет.Вставить("DocDate",Результат.Дата);
			СтруктураОтвет.Вставить("DocNumber",Результат.Номер);
		Иначе
			СтруктураОтвет.Вставить("message",Результат);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураОтвет));	
	
КонецФункции 




