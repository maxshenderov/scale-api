	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "DateStart, DateEnd,PartnerCode ");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
		
	DateStart 	= ПараметрыPOST.DateStart;
	DateEnd 	= ПараметрыPOST.DateEnd;
	
	Если Не ПараметрыPOST.Свойство("SiteInn") Тогда
		SiteInn="";
	Иначе
		SiteInn    = ПараметрыPOST.SiteInn;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(SiteInn) Тогда
		Лико_Площадка = Справочники.Лико_Площадки.ПолучитьСсылку(Новый УникальныйИдентификатор(SiteInn));
	Иначе
		Лико_Площадка = "";
	КонецЕсли;
	
	
		
	Если ЕстьСвойство(ПараметрыPOST, "PartnerCode") Тогда 
		PartnerCode = ПараметрыPOST.PartnerCode;
	КонецЕсли;
	
	Если ЕстьСвойство(ПараметрыPOST, "WorkCenterNumber") Тогда 
		WorkCenterNumber = Число(ПараметрыPOST.WorkCenterNumber);  
	Иначе
		WorkCenterNumber = 0;
	КонецЕсли;  
	
	Если ЕстьСвойство(ПараметрыPOST, "Manager") Тогда 
		Manager = ПараметрыPOST.Manager;  
	Иначе
		Manager = "";
	КонецЕсли;
	
	
