Функция CreateProduct(ПараметрыPOST)
	
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST,
	"UserOS ");
	
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	Если ПараметрыPOST.Свойство("PartnerCode") Тогда 
		PartnerCode          = ПараметрыPOST.PartnerCode;
	КонецЕсли;
	
	ArticleNumber=Неопределено;
	Если ПараметрыPOST.Свойство("ArticleNumber") Тогда 
		ArticleNumber        = ПараметрыPOST.ArticleNumber;
	КонецЕсли;
	
	Если ПараметрыPOST.Свойство("ProductName") Тогда 
		
		ProductName          = ПараметрыPOST.ProductName;
	КонецЕсли;
	
	Если ПараметрыPOST.Свойство("ProductType") Тогда 
