Функция WRM(ПараметрыPOST)
		
	Запрос = Новый Запрос;
	//Запрос.УстановитьПараметр("SiteInn", SiteInn);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	//Запрос.УстановитьПараметр("Manager",Manager);
	
		
//Остатки на складах Материалы
#Область  Остатки_На_складах_Материалы
	Запрос.Текст =   
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Лико_ОстаткиМатериаловДляСайта.Организация.Наименование, """") КАК OrganizationName,
	|	ЕСТЬNULL(Лико_ОстаткиМатериаловДляСайта.Организация.ИНН, """") КАК OrganizationCode,
	|	ЕСТЬNULL(Лико_ОстаткиМатериаловДляСайта.Вид, """") КАК kind,
	|	ЕСТЬNULL(Лико_ОстаткиМатериаловДляСайта.Тип, """") КАК Group,
	|	СУММА(ВЫРАЗИТЬ(Лико_ОстаткиМатериаловДляСайта.Количество КАК ЧИСЛО(15, 0))) КАК quantity,
	|	СУММА(ВЫРАЗИТЬ(Лико_ОстаткиМатериаловДляСайта.Стоимость КАК ЧИСЛО(15, 0))) КАК Cost,
	|	СУММА(ЕСТЬNULL(Лико_ОстаткиМатериаловДляСайта.Аванс, 0)) КАК Advance
	|ИЗ
	|	РегистрСведений.Лико_ОстаткиМатериаловДляСайта КАК Лико_ОстаткиМатериаловДляСайта
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(Лико_ОстаткиМатериаловДляСайта.Организация.Наименование, """"),
	|	ЕСТЬNULL(Лико_ОстаткиМатериаловДляСайта.Организация.ИНН, """"),
	|	ЕСТЬNULL(Лико_ОстаткиМатериаловДляСайта.Вид, """"),
	|	ЕСТЬNULL(Лико_ОстаткиМатериаловДляСайта.Тип, """")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Cost УБЫВ";

	
#КонецОбласти

	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат HttpВернутьТзКакJSON(ТЗ);
	
	
