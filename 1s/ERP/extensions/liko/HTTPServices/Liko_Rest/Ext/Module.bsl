	текДата = ТекущаяДата();
	Если текТЗ.Количество() > 0  Тогда
		//Получение данных из Полученной таблицы из ЗУП
		текМассивТЗ = Новый Массив;
		Для текНомер = 1 По 4 Цикл
			текОтбор = Новый Структура();
			текОтбор.Вставить("НомерТаблицы", текНомер);
			текМассивТЗ.Добавить(текТЗ.НайтиСтроки(текОтбор));
		КонецЦикла;
		текМассивРезультатов = текМассивТЗ;
		//Заполнение Табличного документа 
		текТабДок = Новый ТабличныйДокумент;
		
		текОбработкаСсылка =  Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", "Лико_ДляПечатников");
		ХранилищеОбработки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(текОбработкаСсылка, "ХранилищеОбработки");
		ДвоичныеДанные     = ХранилищеОбработки.Получить();
		АдресХранилища     = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		ИмяВнОбработки     = ВнешниеОбработки.Подключить(АдресХранилища, , Ложь);
		ОбработкаОбъект    = ВнешниеОбработки.Создать(ИмяВнОбработки);
		
		текМакет              = ОбработкаОбъект.ПолучитьМакет("МакетВыработкиСотрудников");
		текОбласть = текМакет.ПолучитьОбласть("ОбластьПараметрыПечати");
		текОбласть.Параметры.ДатаДень 		= Формат(текДата, "ДЛФ=D");
		текОбласть.Параметры.ДатаВремя		= Формат(текДата, "ДЛФ=T");
		текТабДок.Вывести(текОбласть);		//Выведена шапка
		
		//Заполнение Табличного документа по 1му пакету запроса
		текОбласть = текМакет.ПолучитьОбласть("Лико_Сделка");
		
		//УстановитьПривилегированныйРежим(Истина);
		
		//УстановитьПривилегированныйРежим(Ложь);	
		Если текМассивРезультатов[0].Количество() > 0  Тогда
			//заполнение параметров области из строки табличной части
			текОбласть.Параметры.Заполнить(текМассивРезультатов[0][0]);
			//Корректировка вывода % Премии
			текПрПремии = текОбласть.Параметры.ПроцентПремии;
			текОбласть.Параметры.ПроцентПремии = ?(ЗначениеЗаполнено(текПрПремии), Строка(текПрПремии * 100) + " %", "");
			//вывод сформированной области в табличный документ
			текТабДок.Вывести(текОбласть);			
		КонецЕсли;
		//Заполнение Табличного документа по 2му пакету запроса
		ЗаполнитьТаблицуМакетаЗП("Лико_ВыработкаПечатников", 1, текМакет, текТабДок, текМассивРезультатов[1]);
		//Заполнение Табличного документа по 3му пакету запроса
		ЗаполнитьТаблицуМакетаЗП("Лико_ВыработкаПеремотчиков", 2, текМакет, текТабДок,текМассивРезультатов[2]);
		
		ЗаполнитьТаблицуМакетаЗП("Лико_Депремирование", 3, текМакет, текТабДок,текМассивРезультатов[3]);
		
		текТабличныйДокумент = текТабДок;
	Иначе
