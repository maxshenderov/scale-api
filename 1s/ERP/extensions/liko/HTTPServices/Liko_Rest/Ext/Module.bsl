	КонецЕсли;
	
	Если ПараметрыPOST.Свойство("RegionCode") Тогда
		RegionCode           = ПараметрыPOST.RegionCode;
	КонецЕсли;
	
	UserOS         		 = ПараметрыPOST.UserOS;	
	//ArticleProduct     = ПараметрыPOST.ArticleProduct;	
	
	//Если ПараметрыPOST.Свойство("TechnologyNumber") Тогда
	//	TechnologyNumber     = Число(ПараметрыPOST.TechnologyNumber);
	//Иначе
	//	TechnologyNumber     = 0;
	//КонецЕсли;
	НоменклатураDFM = Неопределено;
	
	Если ПараметрыPOST.Свойство("ProductCode") И ЗначениеЗаполнено(ПараметрыPOST.ProductCode) Тогда
		ProductCode= ПараметрыPOST.ProductCode;
		НоменклатураDFM     = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ProductCode));
	Иначе
		НоменклатураDFM     = Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	
	Если ПараметрыPOST.Свойство("VersionNumber") Тогда
		Version        		= Число(ПараметрыPOST.VersionNumber);
		
	Иначе
		Version=Неопределено;
	КонецЕсли;
	
	
	//ТехнологияПечати	= Справочники.Лико_ТехнологияПечати.НайтиПоКоду(Число(TechnologyNumber));
	
	Пользователь    = ПолучитьПользователя(UserOS);
	Структура       = Новый Структура;
	Если ПараметрыPOST.Свойство("ProductType") Тогда
		
		ТипЭтикетки     = Перечисления.Лико_ТипыЭтикеток.Получить(Число(ProductType)-1);
	КонецЕсли;
	
	Если ПараметрыPOST.Свойство("PartnerCode") Тогда
		
		Партнер         = Справочники.Партнеры.НайтиПоКоду(PartnerCode);
	КонецЕсли;
	
	Если ПараметрыPOST.Свойство("RegionCode") Тогда
		
		Регион          = Справочники.БизнесРегионы.НайтиПоРеквизиту("КодРегиона",Число(RegionCode));
	КонецЕсли;
	
	
	
	
	Попытка		
		Если ЗначениеЗаполнено(НоменклатураDFM) Тогда
			СтруктураНоменклатуры=Справочники.Лико_ВерсииНоменклатуры.СоздатьНоменклатуру
			(Неопределено,Неопределено,Version,Неопределено,Неопределено,Неопределено,Неопределено,Истина,НоменклатураDFM,,Ложь,Документы.ЗаказКлиента.ПустаяСсылка());
		Иначе
			СтруктураНоменклатуры=Справочники.Лико_ВерсииНоменклатуры.СоздатьНоменклатуру
			(ProductName,ТипЭтикетки,Version,Регион,Партнер,Неопределено,Неопределено,Истина,,ArticleNumber,Ложь,Документы.ЗаказКлиента.ПустаяСсылка());	
		КонецЕсли; 		
		Структура.Вставить("result",1); 
