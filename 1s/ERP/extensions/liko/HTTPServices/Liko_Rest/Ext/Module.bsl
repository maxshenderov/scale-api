Функция PlanWorkCenters(ПараметрыPOST)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Найдем пользователя 1с
	UserOS = ПараметрыPOST.UserOS;
	Если НЕ ЗначениеЗаполнено(UserOS) Тогда
		Возврат HttpВернутьОшибку(424, "Не передан UserOS");
	КонецЕсли;
	Пользователь=ПолучитьПользователя(UserOS);
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Возврат HttpВернутьОшибку(424, "В 1С не найден пользователь с вашим UserOS");
	КонецЕсли;
	// Проверим доступ к сайту
	ДоступКСайту = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Пользователь, "Лико_ДоступКСайту", Ложь);
	Если НЕ ДоступКСайту Тогда
		Возврат HttpВернутьОшибку(424, "В 1С для вашего пользователя не разрешен доступ к сайту");
	КонецЕсли;
	//+ Лико m.shenderov 14.09.2021
	//Значения DataType
	//•	1 – печать
	//•	2 – гравировка 	
	Если  ПараметрыPOST.Свойство("DataType") Тогда
		DataType=Число(ПараметрыPOST.DataType);
	Иначе
		DataType=1;
	КонецЕсли;
	//- Лико m.shenderov 14.09.2021
	
	
	// Проверим доступ к заказам
	ТипПрав = "НеВидитНичего";
	Если Лико_ДополнительноКлиентСервер.КонкретнаяРольДоступна("ПолныеПрава", Пользователь) Тогда
		ТипПрав = "ВидитВсе";
	ИначеЕсли Лико_ДополнительноКлиентСервер.КонкретнаяРольДоступна("Лико_ДобавлениеИзменениеЗаказовПоПлощадке", Пользователь) И Лико_ДополнительноКлиентСервер.КонкретнаяРольДоступна("Лико_ЗаказыКлиентов", Пользователь) Тогда
		ТипПрав = "ВидитВсеЗаказыПоПлощадкеИСвоиЗаказы";	
	ИначеЕсли Лико_ДополнительноКлиентСервер.КонкретнаяРольДоступна("Лико_ДобавлениеИзменениеЗаказовПоПлощадке", Пользователь) Тогда
		ТипПрав = "ВидитВсеЗаказыПоПлощадке";	
	ИначеЕсли Лико_ДополнительноКлиентСервер.КонкретнаяРольДоступна("Лико_ЗаказыКлиентов", Пользователь) Тогда
		ТипПрав = "ВидитТолькоСвоиЗаказы";
	КонецЕсли;
	Если ТипПрав = "НеВидитНичего" Тогда
		Возврат HttpВернутьОшибку(403, "В 1С для вашего пользователя нет прав на просмотр плана");
	КонецЕсли;
	// Найдем настройку отображения РЦ
	Если DataType=2 Тогда
		//гравировка 
		ОтображениеРЦ = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Пользователь, "Лико_ОтображениеРабочихЦентровГравировка");
	Иначе
		ОтображениеРЦ = Лико_Дополнительно.ПолучитьЗначениеДопРеквизитаЭлемента(, Пользователь, "ОтображениеРабочихЦентров_3aa9d025140f45bc8a59ec155d871714");
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОтображениеРЦ) Тогда
		Возврат HttpВернутьОшибку(403, "В 1С для вашего пользователя не заполена настройка отображения РЦ");
	КонецЕсли;
	
	МассивПлощадок = Новый Массив;
	Если ТипПрав = "ВидитВсеЗаказыПоПлощадке" ИЛИ ТипПрав = "ВидитВсеЗаказыПоПлощадкеИСвоиЗаказы" Тогда
		// Определим доступные площадки
		МассивПлощадок = Пользователь.Лико_Площадки.ВыгрузитьКолонку("Площадка");
		//МассивПлощадок.Добавить(Пользователь.Лико_Площадка);
		МассивПлощадок = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивПлощадок);
		ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(МассивПлощадок, Справочники.Организации.ПустаяСсылка());
		Если МассивПлощадок.Количество() = 0 Тогда
			Возврат HttpВернутьОшибку(403, "В 1С для вашего пользователя не заданы доступные площадки");
		КонецЕсли;
	КонецЕсли;	
	
	// Получим текст запроса из обработки планирования
	ИмяФайла = ПолучитьИмяВременногоФайла();
	ВнОбработка = Справочники.Лико_ПредопределенныеЗначения.ВнешняяОбработкаПланированиеРЦ.ЗначениеПараметра;
	Если НЕ ЗначениеЗаполнено(ВнОбработка) Тогда
		Возврат HttpВернутьОшибку(424, "В 1С в справочнике предопределенных значений не найдена обработка планирования РЦ. Обратитесь к программистам");
	КонецЕсли;
	ДвоичныеДанные = ВнОбработка.ХранилищеОбработки.Получить();
	ДвоичныеДанные.Записать(ИмяФайла);
	ВнешняяОбработкаПлан = ВнешниеОбработки.Создать(ИмяФайла, Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ВнешняяОбработкаПлан.ТекстЗапросаЗаполненияТаблицРЦ();
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
	КонецПопытки;
	
	МассивВыбранныхРЦ = ОтображениеРЦ.РабочиеЦентры.ВыгрузитьКолонку("РабочийЦентр");
	ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(МассивВыбранныхРЦ, Справочники.РабочиеЦентры.ПустаяСсылка());
	
	Условие = 	"ПооперационноеРасписание2_2.РабочийЦентр В(&МассивВыбранныхРЦ)
	|	И ПооперационноеРасписание2_2.Выполнено = 0
	|	И НЕ ПооперационноеРасписание2_2.Моделирование";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", Условие);
	Запрос.УстановитьПараметр("СлужебнаяТекущийДень", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("МассивВыбранныхРЦ", МассивВыбранныхРЦ);
	Запрос.УстановитьПараметр("ВидЭтаповПланирования", ОтображениеРЦ.ВидЭтаповПланирования);
	
	// Получим все данные (без проверки прав) по выбранным в отображении РЦ
	ТЗДанныхИзРегистра = Запрос.Выполнить().Выгрузить();
	
	// Получим массив доступных заказов
	МассивВсехЗаказов = ТЗДанныхИзРегистра.ВыгрузитьКолонку("Заказ");
	МассивВсехЗаказов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивВсехЗаказов);
	МассивДоступныхЗаказов = Новый Массив;
	Если ТипПрав = "ВидитТолькоСвоиЗаказы" Тогда
		МассивДоступныхЗаказов = Лико_Дополнительно.ПолучитьМассивДоступныхЗаказовПользователя(МассивВсехЗаказов, Пользователь);
	ИначеЕсли ТипПрав = "ВидитВсеЗаказыПоПлощадке" Тогда
		МассивДоступныхЗаказов = Лико_Дополнительно.ПолучитьМассивДоступныхЗаказовПользователя(МассивВсехЗаказов,, МассивПлощадок);
	ИначеЕсли ТипПрав = "ВидитВсеЗаказыПоПлощадкеИСвоиЗаказы" Тогда
		МассивДоступныхЗаказов = Лико_Дополнительно.ПолучитьМассивДоступныхЗаказовПользователя(МассивВсехЗаказов,, МассивПлощадок);
		МассивДоступныхЗаказовСвои = Лико_Дополнительно.ПолучитьМассивДоступныхЗаказовПользователя(МассивВсехЗаказов, Пользователь);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивДоступныхЗаказов, МассивДоступныхЗаказовСвои, Истина);		
	КонецЕсли;
	
	// Обработаем полученный запрос: приведем все к стандартным типам, уберем данные по недоступным заказам
	ТЗКопияПриведенная = ТЗДанныхИзРегистра.Скопировать(Новый Структура());
	ТЗКопияПриведенная.Колонки.Добавить("ДоступнаКОтображению", Новый ОписаниеТипов("Булево"));
	ТЗКопияПриведенная.Колонки.Добавить("ПорядокРЦ", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(4, 0)));
	ТЗКопияПриведенная.Колонки.Добавить("_uniq_id", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
	
	Лико_HTTP_Сервер.ПриведениеТЗКСтандартнымТипам(ТЗКопияПриведенная);
	
	Для каждого Строка из ТЗДанныхИзРегистра Цикл
		
		НоваяСтрока = ТЗКопияПриведенная.Добавить();
		НоваяСтрока.ПорядокРЦ = МассивВыбранныхРЦ.Найти(Строка.РабочийЦентр);
		НоваяСтрока._uniq_id = Новый УникальныйИдентификатор;
		
		Если ТипПрав <> "ВидитВсе" И МассивДоступныхЗаказов.Найти(Строка.Заказ) = Неопределено Тогда
			// Строка недоступна для пользователя
			НоваяСтрока.ДоступнаКОтображению = Ложь;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "Начало,Окончание,ВремяПлан,ДобавленоСекунд,РабочийЦентр,Площадка");
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока.ДоступнаКОтображению = Истина;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	ТЗКопияПриведенная.Сортировать("ПорядокРЦ,Начало");
	
	Возврат HttpВернутьТзКакJSON(ТЗКопияПриведенная);
	
КонецФункции

