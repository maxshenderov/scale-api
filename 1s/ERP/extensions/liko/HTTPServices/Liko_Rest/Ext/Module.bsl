	Структура = Новый Структура;
	ТипЭтикетки=Перечисления.Лико_ТипыЭтикеток.Получить(Число(ProductType)-1);
	Партнер=Справочники.Партнеры.НайтиПоКоду(PartnerCode);
	Регион=Справочники.БизнесРегионы.НайтиПоРеквизиту("КодРегиона",RegionCode);
	Попытка
		Лико_Планирование.СоздатьНоменклатуруНаСервере(ProductName,ТипЭтикетки,Регион,Партнер,ArticleNumber,Истина);
		Структура.Вставить("result",1); 
