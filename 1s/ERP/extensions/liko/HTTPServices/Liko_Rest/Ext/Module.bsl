Функция GetCatalogItemsByProps(ПараметрыPOST) // --> Начало Лико Ефимов ЕВВ 11.04.2023 получить элементы справочника с УИДами по отбору

	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "CatalogName,Filter,RequestedProps");
	
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыPOST.CatalogName) Тогда
		Возврат HttpВернутьОшибку(424, "Не указано имя справочника");
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыPOST.RequestedProps) <> Тип("Массив") Тогда
		Возврат HttpВернутьОшибку(424, "Не передан массив необходимых полей");
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыPOST.Filter) <> Тип("Структура") Тогда
		Возврат HttpВернутьОшибку(424, "Не передана структура фильтров");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Таблица.Ссылка КАК Ссылка";
	Для каждого ИмяРеквизита из ПараметрыPOST.RequestedProps Цикл
		Если ВРег(ИмяРеквизита) = "UUID" Тогда
			// Ид добавим в конце, т.к. запросом его не вытащить (платформа 8.3.21)
			Продолжить;
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + ", Таблица." + ИмяРеквизита + " КАК " + ИмяРеквизита;
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + " ИЗ Справочник." + ПараметрыPOST.CatalogName + " КАК Таблица ГДЕ";
	
	ПервоеУсловие = Истина;
	ФильтрПоИд = Ложь;
	Для каждого ТекУсловие из ПараметрыPOST.Filter Цикл
		Если ТекУсловие.Ключ = "UUID" Тогда
			ФильтрПоИд = Истина;
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ТекУсловие.Значение) = Тип("Число") Тогда
			Запрос.Текст = Запрос.Текст + ?(ПервоеУсловие, " ", " И ") + "Таблица." + ТекУсловие.Ключ + " = " + Формат(ТекУсловие.Значение, "ЧРД=.; ЧГ=0");
		ИначеЕсли ТипЗнч(ТекУсловие.Значение) = Тип("Булево") Тогда
			Запрос.Текст = Запрос.Текст + ?(ПервоеУсловие, " ", " И ") + "Таблица." + ТекУсловие.Ключ + " = " + ?(ТекУсловие.Значение, "ИСТИНА", "ЛОЖЬ");
		Иначе
			Запрос.Текст = Запрос.Текст + ?(ПервоеУсловие, " ", " И ") + "Таблица." + ТекУсловие.Ключ + " ПОДОБНО " + """%" + ТекУсловие.Значение + "%""";
		КонецЕсли;
		ПервоеУсловие = Ложь;
	КонецЦикла;

	Если ФильтрПоИд Тогда
		Ссылка = XMLЗначение(Тип("СправочникСсылка." + ПараметрыPOST.CatalogName), ПараметрыPOST.Filter.UUID);
		Если НЕ ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
			Возврат HttpВернутьОшибку(424, "Не найдена ссылка в справочнике """ + ПараметрыPOST.CatalogName + """ с заданным идентификатором");
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + ?(ПервоеУсловие, " ", " И ") + "Таблица.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
	КонецЕсли;

	Попытка
		ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	Исключение
		Возврат HttpВернутьОшибку(424, "Не удалось выполнить запрос");
	КонецПопытки;		
		
	ТаблицаРезультат.Колонки.Добавить("UUID", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36)));
	
	Для каждого Строка из ТаблицаРезультат Цикл
		Строка.UUID = XMLСтрока(Строка.Ссылка);
	КонецЦикла;
	
	ТаблицаРезультат.Колонки.Удалить("Ссылка");
	
	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.ТPJSON(ТаблицаРезультат));
	
КонецФункции

