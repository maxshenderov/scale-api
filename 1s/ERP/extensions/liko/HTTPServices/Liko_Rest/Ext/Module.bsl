	|	ВЫБОР
	|		КОГДА Лико_ПараметрыПроизводстваЗаказа.МетражКвМ > 0
	|			ТОГДА ВЫРАЗИТЬ(ЗаказКлиента.СуммаДокумента / Лико_ПараметрыПроизводстваЗаказа.МетражКвМ КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК PriceSqM,
	|	ЗаказКлиента.Номер КАК _order_num,
	|	ЗаказКлиента.Дата КАК _order_date,
	|	ЗаказКлиента.Этикетки КАК Labels
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПроизводстваЗаказа КАК Лико_ПараметрыПроизводстваЗаказа
	|		ПО ЗаказКлиента.Ссылка = Лико_ПараметрыПроизводстваЗаказа.Заказ
	|			И (Лико_ПараметрыПроизводстваЗаказа.НомерПроката = 1)
	|ГДЕ
	|	ЗаказКлиента.ДатаОтправкиВРаботу МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ЗаказКлиента.Площадка В
	|			(ВЫБРАТЬ
	|				ПользователиЛико_Площадки.Площадка КАК Площадка
	|			ИЗ
	|				Справочник.Пользователи.Лико_Площадки КАК ПользователиЛико_Площадки
	|			ГДЕ
	|				ПользователиЛико_Площадки.Ссылка = &ТекущийПользователь)
	|	И ВЫБОР
	|			КОГДА ЗаказКлиента.Площадка.Организация.ИНН = ""7817314085""
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЗаказКлиента.ТипЗаказа <> ЗНАЧЕНИЕ(Перечисление.Лико_ТипыЗаказов.Полуфабрикат)
	|		КОНЕЦ
	|	И НЕ ЗаказКлиента.ВидЗаказа В (ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.ЦифроваяПроба), ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.Пробник), ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.Оснастка), ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.Техобслуживание), ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.ТестированиеМатериалов), ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.ПеределЗаказаПереборкаПереупаковка), ЗНАЧЕНИЕ(Перечисление.Лико_ВидыЗаказов.ПеределЗаказаПричинаРекламация))
	|	И ЗаказКлиента.Партнер.Код <> ""00-00000006""
	|	И ВЫБОР
	|			КОГДА &Лико_Площадка = """"
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЗаказКлиента.Площадка = &Лико_Площадка
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Issue,
	|	Type,
	|	Profitability УБЫВ"  ;
	
	
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Дата(DateStart)));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Дата(DateEnd)));
	Запрос.УстановитьПараметр("ТекущийПользователь",Пользователь);
	
	//Запрос.УстановитьПараметр("SiteInn", SiteInn); 
	Запрос.УстановитьПараметр("Лико_Площадка", Лико_Площадка);

	
	
	Тз = Запрос.Выполнить().Выгрузить();
	
	
	Возврат HttpВернутьТзКакJSON(Тз);
	
КонецФункции



