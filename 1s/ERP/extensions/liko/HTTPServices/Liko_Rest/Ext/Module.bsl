Функция GetDocsPackets(ПараметрыPOST) // --> Начало Лико Ефимов ЕВВ 11.04.2023 Список текущих пакетов
	
	ДатаНачала = ?(ПараметрыPOST.Свойство("DateStart"), Дата(ПараметрыPOST.DateStart), Дата('00010101'));	
	ДатаОкончания = ?(ПараметрыPOST.Свойство("DateEnd"), Дата(ПараметрыPOST.DateEnd), Дата('00010101'));	
	СписокСтатусов = Новый СписокЗначений;
	Если ПараметрыPOST.Свойство("States") Тогда
		Для каждого ТекСтатус из ПараметрыPOST.States Цикл
			Попытка
				ТекСтатусСсылка = XMLЗначение(Тип("ПеречислениеСсылка.Лико_СтатусыОтправкиДокументов"), ТекСтатус);
			Исключение
				Возврат HttpВернутьОшибку(424, "Не найден статус с именем """ + ТекСтатус + """");
			КонецПопытки;
			Если ТекСтатусСсылка = Неопределено Тогда	
				Возврат HttpВернутьОшибку(424, "Не найден статус с именем """ + ТекСтатус + """");
			КонецЕсли;
			СписокСтатусов.Добавить(ТекСтатусСсылка);
		КонецЦикла;
	КонецЕсли;
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	Если ПараметрыPOST.Свойство("CounteragentUUID") Тогда
		Контрагент = XMLЗначение(Тип("СправочникСсылка.Контрагенты"), ПараметрыPOST.CounteragentUUID);
		Если НЕ ОбщегоНазначения.СсылкаСуществует(Контрагент) Тогда
			Возврат HttpВернутьОшибку(424, "Не найден контрагент с заданным идентификатором");
		КонецЕсли;
	КонецЕсли;

	СтруктураДляВозврата = Новый Структура;
	
	КоличествоЗаписей = 0;
	Если ПараметрыPOST.Свойство("Limit") Тогда
		КоличествоЗаписей = ПараметрыPOST.Limit;
		СтруктураДляВозврата.Вставить("Limit", ПараметрыPOST.Limit);
	КонецЕсли;
	
	НачитатьСЗаписи = 0;     
	Если ПараметрыPOST.Свойство("Offset") Тогда
		НачитатьСЗаписи = ПараметрыPOST.Offset;
		СтруктураДляВозврата.Вставить("Offset", ПараметрыPOST.Offset);
	КонецЕсли;
	
	СтруктураСортировки = Неопределено;
	Если ПараметрыPOST.Свойство("SortBy")
		И ТипЗнч(ПараметрыPOST.SortBy) = Тип("Структура")
		И ПараметрыPOST.SortBy.Свойство("Name")
		И ЗначениеЗаполнено(ПараметрыPOST.SortBy.Name)
		И ПараметрыPOST.SortBy.Свойство("Direction")
		И ЗначениеЗаполнено(ПараметрыPOST.SortBy.Direction)
		Тогда
		СтруктураСортировки = ПараметрыPOST.SortBy;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	
		"ВЫБРАТЬ
		|	Лико_РегистрацияОтправкиДокументов.Пакет КАК Пакет,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент) = ТИП(Документ.РеализацияТоваровУслуг)
		|				ТОГДА ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК Документ.РеализацияТоваровУслуг).Номер
		|			ИНАЧЕ """"
		|		КОНЕЦ) КАК РеализацияТоваровУслугНомер,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент) = ТИП(Документ.ТранспортнаяНакладная)
		|				ТОГДА ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК Документ.ТранспортнаяНакладная).Номер
		|			ИНАЧЕ """"
		|		КОНЕЦ) КАК ТранспортнаяНакладнаяНомер,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент) = ТИП(Документ.СчетФактураВыданный)
		|				ТОГДА ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК Документ.СчетФактураВыданный).Номер
		|			ИНАЧЕ """"
		|		КОНЕЦ) КАК СчетФактураВыданныйНомер,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент) = ТИП(Документ.СчетНаОплатуКлиенту)
		|				ТОГДА ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК Документ.СчетНаОплатуКлиенту).Номер
		|			ИНАЧЕ """"
		|		КОНЕЦ) КАК СчетНаОплатуКлиентуНомер,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент) = ТИП(Документ.ПриемкаТоваровНаХранение)
		|				ТОГДА ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК Документ.ПриемкаТоваровНаХранение).Номер
		|			ИНАЧЕ """"
		|		КОНЕЦ) КАК ПриемкаТоваровНаХранениеНомер,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент) = ТИП(Документ.ОтгрузкаТоваровСХранения)
		|				ТОГДА ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.ТиповойДокумент КАК Документ.ОтгрузкаТоваровСХранения).Номер
		|			ИНАЧЕ """"
		|		КОНЕЦ) КАК ОтгрузкаТоваровСХраненияНомер
		|ПОМЕСТИТЬ ВТ_ПакетыЗаданногоКонтрагента
		|ИЗ
		|	РегистрСведений.Лико_РегистрацияОтправкиДокументов КАК Лико_РегистрацияОтправкиДокументов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_СвязиСТиповымиДокументами КАК Лико_СвязиСТиповымиДокументами
		|		ПО (Лико_РегистрацияОтправкиДокументов.Пакет = (ВЫРАЗИТЬ(Лико_СвязиСТиповымиДокументами.Документ КАК Документ.Лико_ЗаявкаНаТранспортировку)))
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ Лико_РегистрацияОтправкиДокументов.Контрагент = &Контрагент
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	Лико_РегистрацияОтправкиДокументов.Пакет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Лико_РегистрацияОтправкиДокументовСрезПоследних.Период КАК Период,
		|	ВТ_ПакетыЗаданногоКонтрагента.Пакет.Номер КАК ПакетНомер,
		|	ВТ_ПакетыЗаданногоКонтрагента.Пакет.Дата КАК ПакетДата,
		|	Лико_РегистрацияОтправкиДокументовСрезПоследних.Статус КАК СтатусСсылка,
		|	ПРЕДСТАВЛЕНИЕ(Лико_РегистрацияОтправкиДокументовСрезПоследних.Статус) КАК Статус,
		|	Лико_РегистрацияОтправкиДокументовСрезПоследних.Контрагент КАК КонтрагентСсылка,
		|	ЕСТЬNULL(Лико_РегистрацияОтправкиДокументовСрезПоследних.Контрагент.НаименованиеПолное, """") КАК Контрагент,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Лико_РегистрацияОтправкиДокументовСрезПоследних.Ответственный) = ТИП(СТРОКА)
		|			ТОГДА Лико_РегистрацияОтправкиДокументовСрезПоследних.Ответственный
		|		ИНАЧЕ Лико_РегистрацияОтправкиДокументовСрезПоследних.Ответственный.Наименование
		|	КОНЕЦ КАК Ответственный,
		|	Лико_РегистрацияОтправкиДокументовСрезПоследних.Комментарий КАК Комментарий,
		|	ЕСТЬNULL(Лико_РегистрацияОтправкиДокументовСрезПоследних.Перевозчик.НаименованиеПолное, """") КАК Перевозчик,
		|	Лико_РегистрацияОтправкиДокументовСрезПоследних.НомерОтправления КАК НомерОтправления,
		|	ВТ_ПакетыЗаданногоКонтрагента.РеализацияТоваровУслугНомер КАК РеализацияТоваровУслугНомер,
		|	ВТ_ПакетыЗаданногоКонтрагента.ТранспортнаяНакладнаяНомер КАК ТранспортнаяНакладнаяНомер,
		|	ВТ_ПакетыЗаданногоКонтрагента.СчетФактураВыданныйНомер КАК СчетФактураВыданныйНомер,
		|	ВТ_ПакетыЗаданногоКонтрагента.СчетНаОплатуКлиентуНомер КАК СчетНаОплатуКлиентуНомер,
		|	ВТ_ПакетыЗаданногоКонтрагента.ПриемкаТоваровНаХранениеНомер КАК ПриемкаТоваровНаХранениеНомер,
		|	ВТ_ПакетыЗаданногоКонтрагента.ОтгрузкаТоваровСХраненияНомер КАК ОтгрузкаТоваровСХраненияНомер,
		|	ВТ_ПакетыЗаданногоКонтрагента.Пакет.ДатаОтгрузки КАК ДатаОтгрузки
		|ИЗ
		|	ВТ_ПакетыЗаданногоКонтрагента КАК ВТ_ПакетыЗаданногоКонтрагента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_РегистрацияОтправкиДокументов.СрезПоследних КАК Лико_РегистрацияОтправкиДокументовСрезПоследних
		|		ПО ВТ_ПакетыЗаданногоКонтрагента.Пакет = Лико_РегистрацияОтправкиДокументовСрезПоследних.Пакет
		|			И (ВЫБОР
		|				КОГДА &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ Лико_РегистрацияОтправкиДокументовСрезПоследних.Период >= &ДатаНачала
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ Лико_РегистрацияОтправкиДокументовСрезПоследних.Период <= &ДатаОкончания
		|			КОНЕЦ)
		|			И (ВЫБОР
		|				КОГДА &СписокСтатусовЗаполнен
		|					ТОГДА Лико_РегистрацияОтправкиДокументовСрезПоследних.Статус В (&СписокСтатусов)
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПакетДата"; 
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("СписокСтатусовЗаполнен", СписокСтатусов.Количество() > 0);
	Запрос.УстановитьПараметр("СписокСтатусов", СписокСтатусов);
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	ТаблицаРезультат.Колонки.Добавить("КонтрагентИд", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36)));
	ТаблицаРезультат.Колонки.Добавить("СтатусИмя", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));

	КопияТаблицы = ТаблицаРезультат.Скопировать(Новый Структура);
	
	СоответствиеКонтрагентов = Новый Соответствие;
	СоответствиеСтатусов = Новый Соответствие;
	сч = 0;
	КоличествоПодобранныхЗаписей = 0;
	Для каждого Строка из ТаблицаРезультат Цикл
		сч = сч + 1;
		Если сч <= НачитатьСЗаписи Тогда
			Продолжить;
		КонецЕсли;
		Если КоличествоЗаписей <> 0 И КоличествоПодобранныхЗаписей >= КоличествоЗаписей Тогда
			Прервать;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.КонтрагентСсылка) Тогда
			ЗначениеСоответствия = СоответствиеКонтрагентов.Получить(Строка.КонтрагентСсылка);
			Если ЗначениеСоответствия = Неопределено Тогда
				ЗначениеСоответствия = XMLСтрока(Строка.КонтрагентСсылка);
				СоответствиеКонтрагентов.Вставить(Строка.КонтрагентСсылка, ЗначениеСоответствия);
			КонецЕсли;
			Строка.КонтрагентИд = ЗначениеСоответствия;
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.СтатусСсылка) Тогда
			ЗначениеСоответствия = СоответствиеСтатусов.Получить(Строка.СтатусСсылка);
			Если ЗначениеСоответствия = Неопределено Тогда
				ЗначениеСоответствия = XMLСтрока(Строка.СтатусСсылка);
				СоответствиеСтатусов.Вставить(Строка.СтатусСсылка, ЗначениеСоответствия);
			КонецЕсли;
			Строка.СтатусИмя = ЗначениеСоответствия;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(КопияТаблицы.Добавить(), Строка);
		КоличествоПодобранныхЗаписей = КоличествоПодобранныхЗаписей + 1;
		
	КонецЦикла;
	КопияТаблицы.Колонки.Удалить("КонтрагентСсылка");
	КопияТаблицы.Колонки.Удалить("СтатусСсылка");

	Если СтруктураСортировки <> Неопределено Тогда
		Если КопияТаблицы.Колонки.Найти(СтруктураСортировки.Name) = Неопределено Тогда
			Возврат HttpВернутьОшибку(424, "Не найден контрагент с заданным идентификатором");
		КонецЕсли;
		//Запрос.Текст = Запрос.Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО " + СтруктураСортировки.Name + ?(СтруктураСортировки.Direction = "desc", " УБЫВ", ""); 
		КопияТаблицы.Сортировать(СтруктураСортировки.Name +  ?(СтруктураСортировки.Direction = "desc", " Убыв", ""));
	КонецЕсли;

	СтруктураДляВозврата.Вставить("ОбщееКоличествоЗаписей", ТаблицаРезультат.Количество());

	//Если ТаблицаРезультат.Количество() = 0 Тогда
	//	ТЗКопияПриведенная = ТаблицаРезультат;
	//Иначе
	//	ТЗКопияПриведенная = Лико_HTTP_Сервер.КопияТЗПриведеннаяКТипамJSON(КопияТаблицы);
	//КонецЕсли;
	МассивСтруктур = Новый Массив();
	Для каждого Строка из КопияТаблицы Цикл 		
		МассивСтруктур.Добавить(ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Строка));		
	КонецЦикла;   	
	
	СтруктураДляВозврата.Вставить("ТаблицаРезультат", МассивСтруктур);
	
	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(СтруктураДляВозврата));
	
КонецФункции

Функция SetDocsPacketState(ПараметрыPOST) // --> Начало Лико Ефимов ЕВВ 11.04.2023 установить пакету новый статус
	
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "DocNumber,DocDate,State,CounteragentUUID,UserName");
	
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	Попытка
		ДатаДокумента = Дата(ПараметрыPOST.DocDate);
	Исключение
		Возврат HttpВернутьОшибку(424, "Не удалось получить дату");
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
		Возврат HttpВернутьОшибку(424, "Не указана дата пакета");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыPOST.DocNumber) Тогда
		Возврат HttpВернутьОшибку(424, "Не указан номер пакета");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыPOST.UserName) Тогда
		Возврат HttpВернутьОшибку(424, "Не указан пользователь");
	КонецЕсли;
	
	Попытка
		НовыйСтатус = XMLЗначение(Тип("ПеречислениеСсылка.Лико_СтатусыОтправкиДокументов"), ПараметрыPOST.State);
	Исключение
		Возврат HttpВернутьОшибку(424, "Не найден статус с именем """ + ПараметрыPOST.State + """");
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(НовыйСтатус) Тогда	
		Возврат HttpВернутьОшибку(424, "Не найден статус с именем """ + ПараметрыPOST.State + """");
	КонецЕсли;

	Контрагент = XMLЗначение(Тип("СправочникСсылка.Контрагенты"), ПараметрыPOST.CounteragentUUID);
	Если НЕ ОбщегоНазначения.СсылкаСуществует(Контрагент) Тогда
		Возврат HttpВернутьОшибку(424, "Не найден контрагент с заданным идентификатором");
	КонецЕсли;
	
	Пакет = Документы.Лико_ЗаявкаНаТранспортировку.НайтиПоНомеру(ПараметрыPOST.DocNumber, ДатаДокумента); 
	
	Если НЕ ЗначениеЗаполнено(Пакет) Тогда
		Возврат HttpВернутьОшибку(424, "Не удалось найти пакет по номеру и дате");
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.Лико_РегистрацияОтправкиДокументов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДата();
	МенеджерЗаписи.Пакет = Пакет;
	МенеджерЗаписи.Статус = НовыйСтатус;
	МенеджерЗаписи.Контрагент = Контрагент;
	МенеджерЗаписи.Ответственный = ПараметрыPOST.UserName;
	Если ПараметрыPOST.Свойство("Comment") Тогда 
		МенеджерЗаписи.Комментарий = ПараметрыPOST.Comment;
	КонецЕсли;
	Попытка
		МенеджерЗаписи.Записать(Ложь);
	Исключение
		Возврат HttpВернутьОшибку(424, "Не удалось добавить новый статус");
	КонецПопытки;
	
	Возврат GetDocsPacketInfo(ПараметрыPOST);
	
КонецФункции

Функция GetDocsPacketInfo(ПараметрыPOST) // --> Начало Лико Ефимов ЕВВ 11.04.2023 получить информацию об одном пакете

	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "DocNumber,DocDate");
	
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	Попытка
		ДатаДокумента = Дата(ПараметрыPOST.DocDate);
	Исключение
		Возврат HttpВернутьОшибку(424, "Не удалось получить дату");
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
		Возврат HttpВернутьОшибку(424, "Не указана дата пакета");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыPOST.DocNumber) Тогда
		Возврат HttpВернутьОшибку(424, "Не указан номер пакета");
	КонецЕсли;

	Пакет = Документы.Лико_ЗаявкаНаТранспортировку.НайтиПоНомеру(ПараметрыPOST.DocNumber, ДатаДокумента); 
	
	Если НЕ ЗначениеЗаполнено(Пакет) Тогда
		Возврат HttpВернутьОшибку(424, "Не удалось найти пакет по номеру и дате");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	
		"ВЫБРАТЬ
		|	Лико_РегистрацияОтправкиДокументов.Период КАК Период,
		|	Лико_РегистрацияОтправкиДокументов.Пакет.Номер КАК ПакетНомер,
		|	Лико_РегистрацияОтправкиДокументов.Пакет.Дата КАК ПакетДата,
		|	ПРЕДСТАВЛЕНИЕ(Лико_РегистрацияОтправкиДокументов.Статус) КАК Статус,
		|	ЕСТЬNULL(Лико_РегистрацияОтправкиДокументов.Контрагент.НаименованиеПолное, """") КАК Контрагент,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Лико_РегистрацияОтправкиДокументов.Ответственный) = ТИП(СТРОКА)
		|			ТОГДА Лико_РегистрацияОтправкиДокументов.Ответственный
		|		ИНАЧЕ Лико_РегистрацияОтправкиДокументов.Ответственный.Наименование
		|	КОНЕЦ КАК Ответственный,
		|	Лико_РегистрацияОтправкиДокументов.Комментарий КАК Комментарий,
		|	ЕСТЬNULL(Лико_РегистрацияОтправкиДокументов.Перевозчик.НаименованиеПолное, """") КАК Перевозчик,
		|	Лико_РегистрацияОтправкиДокументов.НомерОтправления КАК НомерОтправления
		|ИЗ
		|	РегистрСведений.Лико_РегистрацияОтправкиДокументов КАК Лико_РегистрацияОтправкиДокументов
		|ГДЕ
		|	Лико_РегистрацияОтправкиДокументов.Пакет = &Пакет
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	
	Запрос.УстановитьПараметр("Пакет", Пакет);
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.ТPJSON(ТаблицаРезультат));
	
КонецФункции

