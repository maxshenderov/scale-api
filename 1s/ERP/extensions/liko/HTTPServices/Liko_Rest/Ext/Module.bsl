Функция PrintReport(ПараметрыPOST)
	УстановитьПривилегированныйРежим(Истина);
	// Проверка необходимых параметров и возврат сообщения об ошибке
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "DocType, DocNum, PrintName");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	Если ПараметрыPOST.PrintName="OrderStages" Тогда 
		Возврат OrderStages(ПараметрыPOST);
	КонецЕсли;
	
	
	DocType = ПараметрыPOST.DocType;
	DocNum = ПараметрыPOST.DocNum;
	Если ПараметрыPOST.Свойство("DocDate") Тогда
		DocDate = Дата(ПараметрыPOST.DocDate);
	Иначе
		DocDate = '00010101';
	КонецЕсли;
	
	DocDate 	= ПараметрыPOST.DocDate;
	PrintName 	= ПараметрыPOST.PrintName;
	
	ПечатнаяФорма = Справочники.ДополнительныеОтчетыИОбработки.НайтиПоРеквизиту("ИмяОбъекта", PrintName);
	КоллекцияПечатныхФорм	= Новый ТаблицаЗначений;
	ОбъектыПечати 			= Новый СписокЗначений;
	ПараметрыПечати			= Неопределено;
	Документ = НайтиДокумент(DocType, DocNum, DocDate);
	Парам = новый структура;
	Парам.Вставить("ИдентификаторКоманды", ПечатнаяФорма.Команды[0].Идентификатор);
	ОбъектыНазначения = новый массив;
	ОбъектыНазначения.Добавить(Документ);
	Парам.Вставить("ОбъектыНазначения", ОбъектыНазначения);
	ДополнительныеОтчетыИОбработки.ПечатьПоВнешнемуИсточнику(ПечатнаяФорма, Парам, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыПечати);
	Для каждого Стр Из КоллекцияПечатныхФорм Цикл
		ТабДокумент = стр.ТабличныйДокумент;
		ВременныйФайл = ПолучитьИмяВременногоФайла("pdf");
		ТабДокумент.Записать(ВременныйФайл, ТипФайлаТабличногоДокумента.PDF); 			
		ДвДанные = Новый ДвоичныеДанные(ВременныйФайл);
		Base64 = Base64Строка(ДвДанные);  			
		Прервать;			
	КонецЦикла;
	
	Структура = Новый Структура;
	Структура.Вставить("Content", Base64);
	Возврат HttpВернутьСтруктуруКакJSON(Структура);
	
КонецФункции

