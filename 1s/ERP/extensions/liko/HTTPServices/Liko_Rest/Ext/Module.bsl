			Возврат HttpВернутьОшибку(403, "Данные по площадке не доступны");						
		КонецЕсли;
	КонецЕсли;
	
	
	
	#Область Запрос_остатков_СГП_по_отдельному_клиенту_и_периоду
	Если ЕстьСвойство(ПараметрыPOST, "PartnerCode") Тогда 
		
		PartnerCode = ПараметрыPOST.PartnerCode;
		
