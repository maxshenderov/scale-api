// Вызов метода имя которого передано через 
// параметр (POST-запроса) ProcName
Функция ВызовМетода(Метод, Параметры)
	Попытка
		// код, приводящий к вызову исключения
		Возврат Вычислить(Метод+"(Параметры)");
		
	Исключение
		// Запись события в журнал регистрации для системного администратора.
		ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Liko_Rest: ВызовМетода'"),
		УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат HttpВернутьОшибку(405, "Метод '" + Метод + "' не определен");
	КонецПопытки;
КонецФункции

// Возврат web-клиенту ответа с сообщением об ошибке
Функция HttpВернутьОшибку(КодОшибки, Сообщение)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	
	ЗаписьJSON.ЗаписатьИмяСвойства("message");
	ЗаписьJSON.ЗаписатьЗначение(Сообщение);
	
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	СтрокаДляОтвета = ЗаписьJSON.Закрыть();
	
	Ответ = Новый HTTPСервисОтвет(КодОшибки);
	Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8"); 	
	Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

