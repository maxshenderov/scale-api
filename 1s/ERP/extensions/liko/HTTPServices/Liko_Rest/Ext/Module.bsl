Функция GetOM(ПараметрыPOST)
	
	// Проверка необходимых параметров и возврат сообщения об ошибке
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "OrderNum, OrderDate");
