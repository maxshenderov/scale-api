Функция UserAccess(ПараметрыPOST)
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "UserOS");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	UserOS = ПараметрыPOST.UserOS;		
	Пользователь=ПолучитьПользователя(UserOS);
	ДоступКСайту=УправлениеСвойствами.ЗначениеСвойства(Пользователь,"Лико_ДоступКСайту");
	ТЗ = Новый ТаблицаЗначений;
	Тз.Колонки.Добавить("Access", Новый ОписаниеТипов("Булево"));
	СтрТз=Тз.Добавить();
	СтрТз.Access=ЗначениеЗаполнено(ДоступКСайту);
	Возврат HttpВернутьТзКакJSON(ТЗ);	
КонецФункции

Функция GetToken(ПараметрыPOST)
	
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "UserOS");
	
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	UserOS 			= ПараметрыPOST.UserOS;		
	Пользователь	= ПолучитьПользователя(UserOS);
	
	Структура = Новый Структура;
	Структура.Вставить("Token",Лико_HTTP_Сервер.GetToken(Пользователь));
	
	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(Структура));
	
КонецФункции

