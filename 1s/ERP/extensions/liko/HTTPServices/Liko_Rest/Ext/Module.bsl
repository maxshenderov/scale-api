Функция WRMDetailПлощадка(ПараметрыPOST)
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "OrganizationCode, Kind, Group");
	Лико_Площадка = Справочники.Лико_Площадки.ПолучитьСсылку(Новый УникальныйИдентификатор(ПараметрыPOST.OrganizationCode));

	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	//Запрос.УстановитьПараметр("OrganizationCode", ПараметрыPOST.OrganizationCode);
	Запрос.УстановитьПараметр("Лико_Площадка", Лико_Площадка);
    Запрос.УстановитьПараметр("Kind", ПараметрыPOST.Kind);
	Запрос.УстановитьПараметр("Group",ПараметрыPOST.Group); 
	
	
	
		
//Остатки на складах Материалы расшифровка
#Область  Остатки_На_складах_Материалы_Расшифровка
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыВЯчейкахОстатки.Ячейка.Лико_Организация КАК Организация,
	|	ТоварыВЯчейкахОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(ТоварыВЯчейкахОстатки.ВНаличииОстаток * ТоварыВЯчейкахОстатки.Упаковка.Числитель / ТоварыВЯчейкахОстатки.Упаковка.Знаменатель) КАК ОстатокВЯчейках
	|ПОМЕСТИТЬ ВТОстаткиВЯчейках
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки(
	|			&Дата,
	|			ВЫБОР
	|					КОГДА &kind = ""Рулонные материалы""
	|						ТОГДА Номенклатура.ВидНоменклатуры.Наименование В (&kind, ""Переработка"", ""Полуфабрикаты"")
	|					ИНАЧЕ Номенклатура.ВидНоменклатуры.Наименование = &kind
	|				КОНЕЦ
	|				И &kind В (""Рулонные материалы"", ""Краска"")
	|				И НЕ Ячейка.Лико_ПомещениеБрака
	|				И ВЫБОР
	|					КОГДА &Лико_Площадка = """"
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ Ячейка.Лико_Площадка = &Лико_Площадка
	|				КОНЕЦ) КАК ТоварыВЯчейкахОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
	|		ПО ТоварыВЯчейкахОстатки.Номенклатура = НоменклатураДополнительныеРеквизиты.Ссылка
