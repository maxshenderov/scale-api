Функция Post(Запрос)
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;      
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ПараметрыPOST = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат HttpВернутьОшибку(400, "Необходимо передать параметр 'ProcName'");
	КонецПопытки;
	
	Если ЕстьСвойство(ПараметрыPOST, "Debug") И ПараметрыPOST.Debug = 1 Тогда
		ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Liko_Rest: Post'"),
		УровеньЖурналаРегистрации.Предупреждение,,,
		"Тело запроса: " + ТелоЗапроса);
	КонецЕсли;
	
	Если ЕстьСвойство(ПараметрыPOST, "ProcName") Тогда
		Возврат ВызовМетода(ПараметрыPOST.ProcName, ПараметрыPOST);
	КонецЕсли;
	
	Возврат HttpВернутьОшибку(400, "Необходимо передать параметр 'ProcName'");
КонецФункции

