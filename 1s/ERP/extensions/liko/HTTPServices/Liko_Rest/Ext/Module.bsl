	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Price
	|ИЗ
	|	ВТ КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Period,
	|	Cost УБЫВ";
	
	
#КонецОбласти
	
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Дата(DateStart)));
