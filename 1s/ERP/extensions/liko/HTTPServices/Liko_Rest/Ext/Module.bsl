Функция ПолучитьПользователя(UserOS) //+Лико m.shenderov 26.09.2019
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи.ДополнительныеРеквизиты КАК Пользователи
	|ГДЕ
	|	Пользователи.Значение = &Значение
	|	И Пользователи.Свойство.Имя = &Имя";
	Запрос.УстановитьПараметр("Имя","Лико_СертификатSSL");
	Запрос.УстановитьПараметр("Значение",UserOS);
	РезультатЗапроса = Запрос.Выполнить();	
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Возврат Выборка.Ссылка;
		
	КонецЦикла; 
	
КонецФункции //-Лико m.shenderov 26.09.2019 

Функция ПолучитьДоступныеОтчеты(Пользователь) //+Лико m.shenderov 26.09.2019
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Лико_ДоступКОтчетамНаСайте.Отчет КАК Отчет,
