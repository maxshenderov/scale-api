Функция WssSСMobyleClient(ПараметрыPOST)
	УстановитьПривилегированныйРежим(истина);
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST,"KeyCollaboration,Data");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	KeyCollaboration = ПараметрыPOST.keyCollaboration;
	Data             = ПараметрыPOST.Data;
	
	
	FormGUID=Строка( Новый УникальныйИдентификатор);
	
	Если ЗначениеЗаполнено(KeyCollaboration) Тогда
		Структура = Новый Структура;
		Структура.Вставить("FormGUID",FormGUID);
		Структура.Вставить("WebSocketUUID",KeyCollaboration);
		Контент = Новый Структура;
		Контент.Вставить("WSMobyleClient",ПараметрыPOST.Data);
		
		WebSocketСервер.ОтправитьСообщение(Структура,Контент);
		
	КонецЕсли;
	ДатаКонтроля=ТекущаяДата()+10;
	Структура = Новый Структура;
	
	Пока ДатаКонтроля> ТекущаяДата() Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Лико_WSСообщения.Данные КАК Данные
		|ИЗ
		|	РегистрСведений.Лико_WSСообщения КАК Лико_WSСообщения
		|ГДЕ
		|	Лико_WSСообщения.Гуид = &Гуид";
		Запрос.УстановитьПараметр("Гуид",FormGUID);
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Структура=Выборка.Данные.Получить();
			Прервать;
		КонецЦикла; 
		Если Не РезультатЗапроса.Пустой() Тогда
			Прервать;
		КонецЕсли; 	
	КонецЦикла;
	
	НаборЗаписей = РегистрыСведений.Лико_WSСообщения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Гуид.Установить(FormGUID);
	НаборЗаписей.Записать(Истина);
	
	
	Ответ = Новый Структура;
	Ответ.Вставить("data", Структура); 	
	Возврат HttpВернутьСтруктуруКакJSON(Ответ);	
КонецФункции





