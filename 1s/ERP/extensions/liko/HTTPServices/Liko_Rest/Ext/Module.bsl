Функция SettlementsWithClientsDetail(ПараметрыPOST)
	// Проверка необходимых параметров и возврат сообщения об ошибке
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "PartnerCode");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;  
	
	PartnerCode = ПараметрыPOST.PartnerCode;
	
	
	Запрос = Новый Запрос; 
	#Область Расчеты_С_Клиентами_Расшифровка   
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасчетыСКлиентамиПоСрокамОстатки.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
	|	СУММА(ВЫБОР
	|			КОГДА РасчетыСКлиентамиПоСрокамОстатки.ДолгУпрОстаток > 0
	|				ТОГДА РасчетыСКлиентамиПоСрокамОстатки.ДолгУпрОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ДолгУпрОстаток,
	|	СУММА(ВЫБОР
	|			КОГДА РасчетыСКлиентамиПоСрокамОстатки.ДолгУпрОстаток < 0
	|				ТОГДА РасчетыСКлиентамиПоСрокамОстатки.ДолгУпрОстаток
	|			ИНАЧЕ РасчетыСКлиентамиПоСрокамОстатки.ПредоплатаУпрОстаток
	|		КОНЕЦ) КАК ПредоплатаУпр,
	|	СУММА(ВЫБОР
	|			КОГДА РасчетыСКлиентамиПоСрокамОстатки.ДолгОстаток > 0
	|				ТОГДА РасчетыСКлиентамиПоСрокамОстатки.ДолгОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ДолгОстаток,
	|	СУММА(ВЫБОР
	|			КОГДА РасчетыСКлиентамиПоСрокамОстатки.ДолгОстаток < 0
	|				ТОГДА РасчетыСКлиентамиПоСрокамОстатки.ДолгОстаток
	|			ИНАЧЕ РасчетыСКлиентамиПоСрокамОстатки.ПредоплатаОстаток
	|		КОНЕЦ) КАК Предоплата
	|ПОМЕСТИТЬ ВТПоДок
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки(
	|			,
	|			НЕ АналитикаУчетаПоПартнерам.Партнер В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							ПартнерыДополнительныеРеквизиты.Ссылка КАК Ссылка
	|						ИЗ
	|							Справочник.Партнеры.ДополнительныеРеквизиты КАК ПартнерыДополнительныеРеквизиты
	|						ГДЕ
	|							ПартнерыДополнительныеРеквизиты.Свойство.Имя = ""Лико_СобственнаяОрганизация""
	|			
	|						ОБЪЕДИНИТЬ ВСЕ
	|			
	|						ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							Партнеры.Ссылка
	|						ИЗ
	|							Справочник.Партнеры КАК Партнеры
	|						ГДЕ
	|							Партнеры.Лико_ПлатежнаяДисциплина.Наименование ПОДОБНО ""%Плохой долг%"")
	|				И НЕ ЕСТЬNULL(АналитикаУчетаПоПартнерам.Контрагент.Лико_ПлатежнаяДисциплина.Наименование, """") ПОДОБНО ""%Плохой долг%""
	|				И НЕ АналитикаУчетаПоПартнерам.Договор.СтатьяДвиженияДенежныхСредств.ПометкаУдаления
	|				И НЕ АналитикаУчетаПоПартнерам.Партнер.ОсновнойМенеджер.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|				И НЕ АналитикаУчетаПоПартнерам.Партнер.ОсновнойМенеджер = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|				И ВЫБОР
	|					КОГДА &PartnerCode = """"
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ АналитикаУчетаПоПартнерам.Партнер.Код = &PartnerCode
	|				КОНЕЦ) КАК РасчетыСКлиентамиПоСрокамОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	РасчетыСКлиентамиПоСрокамОстатки.АналитикаУчетаПоПартнерам
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПоДок.АналитикаУчетаПоПартнерам.Партнер КАК Партнер,
	|	СУММА(ВТПоДок.ДолгУпрОстаток) КАК ДолгУпрОстаток,
	|	СУММА(ВТПоДок.ПредоплатаУпр) КАК ПредоплатаУпр,
	|	СУММА(ВТПоДок.ДолгУпрОстаток - ВТПоДок.ПредоплатаУпр) КАК ДолгПлюсПредоплатаУпр
	|ПОМЕСТИТЬ ВТПарнетры
	|ИЗ
	|	ВТПоДок КАК ВТПоДок
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТПоДок.АналитикаУчетаПоПартнерам.Партнер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПоДок.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
