Функция OrderStages(ПараметрыPOST) 	 
	
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "DocNum,DocDate,UserOS");
	
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	
	// Найдем пользователя 1с
	UserOS = ПараметрыPOST.UserOS;
	Если НЕ ЗначениеЗаполнено(UserOS) Тогда
		Возврат HttpВернутьОшибку(424, "Не передан UserOS");
	КонецЕсли;
	Пользователь=ПолучитьПользователя(UserOS);
	
	DocNum  = ПараметрыPOST.DocNum;
	DocDate =  Дата(ПараметрыPOST.DocDate);
	Заказ=Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказКлиента.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Дата = &Дата
	|	И ЗаказКлиента.Номер = &Номер";
	Запрос.УстановитьПараметр("Дата",DocDate);
	Запрос.УстановитьПараметр("Номер",DocNum);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Заказ=Выборка.Ссылка;
	КонецЦикла; 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВариантыОтчетовРазмещение.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВариантыОтчетов.Размещение КАК ВариантыОтчетовРазмещение
	|ГДЕ
	|	ВариантыОтчетовРазмещение.Ссылка.Наименование = &НаименованиеОтчета";
	Запрос.УстановитьПараметр("НаименованиеОтчета","лк Состояние заказа" );
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ВариантОтчета= Выборка.Ссылка;
	КонецЦикла;  
	Структура = Новый Структура;
	Структура.Вставить("ЗаказКлиента",Заказ); 
	ТабДокумент=Лико_Дополнительно.ПолучитьТабличныйДокументВариантаОтчета(ВариантОтчета, Структура);
	
	
	Report=Неопределено;
	ВременныйФайл = ПолучитьИмяВременногоФайла("pdf");
	ТабДокумент.Записать(ВременныйФайл, ТипФайлаТабличногоДокумента.PDF);
	
	ДвДанные = Новый ДвоичныеДанные(ВременныйФайл);
	Base64 = Base64Строка(ДвДанные);  			
	
	Структура = Новый Структура;
	Структура.Вставить("Content", Base64);
	//Структура.Вставить("Type", "PDF");
	
	
	УдалитьФайлы(ВременныйФайл);
	Возврат HttpВернутьСтруктуруКакJSON(Структура); 
	
	
