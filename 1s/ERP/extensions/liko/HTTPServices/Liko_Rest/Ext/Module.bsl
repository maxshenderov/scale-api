Функция SectionsAccess(ПараметрыPOST)
	
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "UserOS");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	UserOS = ПараметрыPOST.UserOS;		
	Пользователь = ПолучитьПользователя(UserOS);
	ТЗ = Новый ТаблицаЗначений; 
	Тз.Колонки.Добавить("Access", Новый ОписаниеТипов("Булево"));
	Тз.Колонки.Добавить("Section", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(30, ДопустимаяДлина.Переменная)));
	
	СвойстваПользователя	=	ПолучитьСписокРолей(Пользователь);	
	
	Если Не ЗначениеЗаполнено(СвойстваПользователя) Тогда		
		Возврат HttpВернутьТзКакJSON(ТЗ); 		
	КонецЕсли;
	
	СтрТз=Тз.Добавить();
	СтрТз.Section="Показатели";
	СтрТз.Access=СвойстваПользователя.Найти("Лико_ДоступКРазделуСайтаПоказатели")<>Неопределено;
	
	СтрТз=Тз.Добавить();
	СтрТз.Section="ПланированиеРЦ";
	СтрТз.Access=СвойстваПользователя.Найти("Лико_ДоступКРазделуСайтаПланированиеРЦ")<>Неопределено;
	
	СтрТз=Тз.Добавить();
	СтрТз.Section="СостояниеМашин";
	СтрТз.Access=СвойстваПользователя.Найти("Лико_ДоступКРазделуСайтаСостояниеМашин")<>Неопределено;
	
	СтрТз=Тз.Добавить();
	СтрТз.Section="ОстаткиСГП";
	СтрТз.Access=СвойстваПользователя.Найти("Лико_ДоступКРазделуСайтаОстакткиСГП")<>Неопределено;
	
	СтрТз=Тз.Добавить();
	СтрТз.Section="Продажи";
	СтрТз.Access=СвойстваПользователя.Найти("Лико_ДоступКРазделуСайтаПродажи")<>Неопределено;
	
	СтрТз=Тз.Добавить();
	СтрТз.Section="Отгрузки";
	СтрТз.Access=СвойстваПользователя.Найти("Лико_ДоступКРазделуСайтаОтгрузки")<>Неопределено;
	
	СтрТз=Тз.Добавить();
	СтрТз.Section="Отчеты";
	СтрТз.Access=СвойстваПользователя.Найти("Лико_ДоступКРазделуСайтаОтчеты")<>Неопределено;
	
	
	
	Возврат HttpВернутьТзКакJSON(ТЗ);
	
	
КонецФункции

Функция ReportAccess(ПараметрыPOST)
	
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "UserOS");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	UserOS = ПараметрыPOST.UserOS;		
	Пользователь=ПолучитьПользователя(UserOS);
	Если Пользователь=Неопределено Тогда
		Пользователь=Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	
	ТЗ =ПолучитьДоступныеОтчеты(Пользователь);	
	Возврат HttpВернутьТзКакJSON(ТЗ);
	
	
КонецФункции



Функция WRP(ПараметрыPOST)
	Если Не ПараметрыPOST.Свойство("SiteInn") Тогда
		SiteInn="";
	Иначе
		SiteInn    = ПараметрыPOST.SiteInn;
	КонецЕсли;
	
	// Найдем пользователя 1с
	UserOS = ПараметрыPOST.UserOS;
	Если НЕ ЗначениеЗаполнено(UserOS) Тогда
		Возврат HttpВернутьОшибку(424, "Не передан UserOS");
	КонецЕсли;
	Пользователь=ПолучитьПользователя(UserOS);
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Возврат HttpВернутьОшибку(424, "В 1С не найден пользователь с вашим UserOS");
	Иначе
		Если Пользователь.Лико_Площадки.Количество() =0  Тогда
			Возврат HttpВернутьОшибку(403, "В 1С для вашего пользователя не заданы доступные площадки");		
		КонецЕсли;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(SiteInn) Тогда
		Лико_Площадка = Справочники.Лико_Площадки.ПолучитьСсылку(Новый УникальныйИдентификатор(SiteInn));
	Иначе
		Лико_Площадка = "";
	КонецЕсли;
	

	
	Если Пользователь.Лико_Площадки.Количество() <3  Тогда
		Если SiteInn="" Тогда 
			//SiteInn= Пользователь.Лико_Площадки[0].Организация.ИНН;
			Лико_Площадка= Пользователь.Лико_Площадки[0].Площадка;
			
		//ИначеЕсли SiteInn<> Пользователь.Лико_Площадки[0].Организация.ИНН Тогда 
			ИначеЕсли Лико_Площадка<> Пользователь.Лико_Площадки[0].Площадка Тогда 
			Возврат HttpВернутьОшибку(403, "Данные по площадке не доступны");						
		КонецЕсли;
	КонецЕсли;
	
	Если Не ПараметрыPOST.Свойство("Manager") Тогда
		Manager="";
	Иначе
		Manager    = ПараметрыPOST.Manager;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	//Запрос.УстановитьПараметр("SiteInn", SiteInn);
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Manager",Manager);
	Запрос.УстановитьПараметр("Лико_Площадка", Лико_Площадка);
	Если ЕстьСвойство(ПараметрыPOST, "PartnerCode") Тогда 
		
		PartnerCode = ПараметрыPOST.PartnerCode;
		
		Если Не ЕстьСвойство(ПараметрыPOST, "Period") Тогда
			Period=1;
		Иначе
			Period=Число(ПараметрыPOST.Period);
		КонецЕсли;
		
		#Область Запрос_остатков_СГП_по_отдельному_клиенту_и_периоду
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(ТоварыНаСкладахОстатки.Серия.Лико_ДатаВыпуска) КАК ДатаВыпуска,
		|	ТоварыНаСкладахОстатки.Характеристика.Лико_ЗаказНоменклатуры КАК Заказ,
		|	СУММА(ТоварыНаСкладахОстатки.ВНаличииОстаток) КАК Количество,
		|	ТоварыНаСкладахОстатки.Склад КАК Склад,
		|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТоварыНаСкладахОстатки.Серия) КАК КоличествоКоробок
		|ПОМЕСТИТЬ ВТОстатки
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			,
		|			Характеристика.Лико_ЗаказНоменклатуры <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
		|				И Номенклатура.ВидНоменклатуры.Лико_НоменклатураЭтикеток = ИСТИНА
		|				И Характеристика.Лико_ЗаказНоменклатуры.Партнер.Код = &ПартнерКод
		|				И Склад.ИспользоватьОрдернуюСхемуПриОтгрузке
		|				И Склад.Лико_ТипСкладаГотовойПродукции <> ЗНАЧЕНИЕ(Перечисление.Лико_ТипыСкладовГотовойПродукции.ОтветственноеХранениеТовараКлиентаУНас)
		|				И Склад.Лико_ТипСкладаГотовойПродукции <> ЗНАЧЕНИЕ(Перечисление.Лико_ТипыСкладовГотовойПродукции.Брак)
		|				И Склад.Наименование <> ""Не ордерный""
		|				И ВЫБОР
		|					КОГДА &Лико_Площадка = """"
		|						ТОГДА ИСТИНА
		//|					ИНАЧЕ Характеристика.Лико_ЗаказНоменклатуры.Площадка.Организация.ИНН = &SiteInn
		|					ИНАЧЕ Характеристика.Лико_ЗаказНоменклатуры.Площадка = &Лико_Площадка
		|				КОНЕЦ
		|				И ВЫБОР
		|					КОГДА &Manager = """"
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ Характеристика.Лико_ЗаказНоменклатуры.Менеджер.Наименование = &Manager
		|				КОНЕЦ) КАК ТоварыНаСкладахОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВЯчейках.Остатки(
		|				,
		|				Ячейка В
		|					(ВЫБРАТЬ
		|						СкладыДополнительныеРеквизиты.Значение КАК Ячейка
		|					ИЗ
		|						Справочник.Склады.ДополнительныеРеквизиты КАК СкладыДополнительныеРеквизиты
		|					ГДЕ
		|						СкладыДополнительныеРеквизиты.Свойство.Имя = ""ЯчейкаРастарка""
		|					СГРУППИРОВАТЬ ПО
