Процедура ПолучитьТабличныйДокументВариантаОтчета(КлючВариантаОтчета, НаименованиеОтчета, ТабДок,DateStart=Неопределено, DateEnd=Неопределено,User,Report=Неопределено,ДопПараметры)
	УстановитьПривилегированныйРежим(Истина); 
	Если ДопПараметры=Неопределено ТОгда
		ДопПараметры= Новый Структура;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВариантыОтчетовРазмещение.Ссылка.КлючВарианта КАК ReportKey,
	|	ВЫБОР
	|		КОГДА ВариантыОтчетовРазмещение.Ссылка.Лико_НаименованиеДляСайта = """"
	|			ТОГДА ВариантыОтчетовРазмещение.Ссылка.Наименование
	|		ИНАЧЕ ВариантыОтчетовРазмещение.Ссылка.Лико_НаименованиеДляСайта
	|	КОНЕЦ КАК ReportName,
	|	ВариантыОтчетовРазмещение.Подсистема.Синоним КАК ReportGroup,
	|	ВариантыОтчетовРазмещение.Ссылка КАК Ref,
	|	""PDF"" КАК Type
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	Справочник.ВариантыОтчетов.Размещение КАК ВариантыОтчетовРазмещение
	|ГДЕ
	|	ВариантыОтчетовРазмещение.Ссылка.Лико_ДляСайта
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ 
	|	ПредопределенныеВариантыОтчетовРазмещение.Ссылка.КлючВарианта,
	|	ВЫБОР
	|		КОГДА ВариантыОтчетов.Лико_НаименованиеДляСайта = """"
	|			ТОГДА ВариантыОтчетов.Наименование
	|		ИНАЧЕ ВариантыОтчетов.Лико_НаименованиеДляСайта
	|	КОНЕЦ,
	|	ПредопределенныеВариантыОтчетовРазмещение.Подсистема.Синоним,
	|	ПредопределенныеВариантыОтчетовРазмещение.Ссылка,
	|	""PDF""
	|ИЗ
	|	Справочник.ПредопределенныеВариантыОтчетов.Размещение КАК ПредопределенныеВариантыОтчетовРазмещение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВариантыОтчетов КАК ВариантыОтчетов
	|		ПО ПредопределенныеВариантыОтчетовРазмещение.Ссылка = ВариантыОтчетов.ПредопределенныйВариант
	|ГДЕ
	|	ВариантыОтчетов.Лико_ДляСайта
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ 
	|	ПредопределенныеВариантыОтчетовРасширенийРазмещение.Ссылка.КлючВарианта,
	|	ВЫБОР
	|		КОГДА ВариантыОтчетов.Лико_НаименованиеДляСайта = """"
	|			ТОГДА ВариантыОтчетов.Наименование
	|		ИНАЧЕ ВариантыОтчетов.Лико_НаименованиеДляСайта
	|	КОНЕЦ,
	|	ПредопределенныеВариантыОтчетовРасширенийРазмещение.Подсистема.Синоним,
	|	ПредопределенныеВариантыОтчетовРасширенийРазмещение.Ссылка,
	|	""PDF""
	|ИЗ
	|	Справочник.ПредопределенныеВариантыОтчетовРасширений.Размещение КАК ПредопределенныеВариантыОтчетовРасширенийРазмещение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВариантыОтчетов КАК ВариантыОтчетов
	|		ПО ПредопределенныеВариантыОтчетовРасширенийРазмещение.Ссылка = ВариантыОтчетов.ПредопределенныйВариант
	|ГДЕ
	|	ВариантыОтчетов.Лико_ДляСайта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВременнаяТаблица.ReportKey КАК ReportKey,
	|	ВременнаяТаблица.ReportName КАК ReportName,
	|	ВременнаяТаблица.ReportGroup КАК ReportGroup,
	|	ВременнаяТаблица.Type КАК Type,
	|	ВременнаяТаблица.Ref КАК Ref
	|ИЗ
	|	ВременнаяТаблица КАК ВременнаяТаблица
	|ГДЕ
	|   ВременнаяТаблица.Ref.Наименование = &НаименованиеОтчета
	|	И ВременнаяТаблица.ReportKey = &ReportKey";
	Запрос.УстановитьПараметр("ReportKey",КлючВариантаОтчета);
	Запрос.УстановитьПараметр("НаименованиеОтчета",НаименованиеОтчета);
	
	
	РезультатЗапроса=Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл 
		Report=Выборка.Ref;  
		Период=Неопределено;
		Если Выборка.Ref.Лико_УстанавливатьПериодНаСайте Тогда
			Попытка
				Период=Выборка.Ref.Настройки.Получить().ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));	
			Исключение
				//ОписаниеОшибки()
			КонецПопытки;
		КонецЕсли;
		
		ОтборНастройки= Новый КомпоновщикНастроекКомпоновкиДанных;
		ОтборНастройки.ЗагрузитьНастройки(Выборка.Ref.Настройки.Получить());
		
		Структура = Новый Структура;
		Структура.Вставить("СсылкаВарианта",Выборка.Ref); 
		Структура.Вставить("СсылкаОтчета",Выборка.Ref.Отчет);
		Структура.Вставить("КлючВарианта",Выборка.Ref.КлючВарианта);    				  
		Структура.Вставить("СхемаМодифицирована",Истина);
		Структура.Вставить("НастройкиКД",ОтборНастройки.Настройки);
		Структура.Вставить("ПользовательскиеНастройкиКД",ОтборНастройки.ПользовательскиеНастройки);
		Структура.Вставить("Лико_Пользователь",User);
		Структура.Вставить("Лико_ДопПараметры",ДопПараметры);
		
		Если ЗначениеЗаполнено(DateStart) и ЗначениеЗаполнено(DateEnd) Тогда
			Лико_Период = Новый Структура;
			Лико_Период.Вставить("Вариант",ВариантСтандартногоПериода.ПроизвольныйПериод);
			Лико_Период.Вставить("ДатаНачала",DateStart);
			Лико_Период.Вставить("ДатаОкончания",DateEnd);
			
			Структура.Вставить("Лико_Период",Лико_Период); 
			
		ИначеЕсли Период<>Неопределено Тогда
			Попытка
				DateStart=Период.Значение.ДатаНачала;
				DateEnd=Период.Значение.ДатаОкончания;
			Исключение
				//ОписаниеОшибки()
			КонецПопытки;
			
		КонецЕсли;
		
		Отчет1=ВариантыОтчетов.СформироватьОтчет(Структура,Ложь,Ложь);  	
		ТабДок= ОТчет1.ТабличныйДокумент;
	КонецЦикла; 
	
КонецПроцедуры

Функция ПолучитьСписокРолей(Пользователь) //+Лико m.shenderov 27.09.2019
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрофилиГруппДоступаРоли.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Профили
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
	|ГДЕ
	|	ПрофилиГруппДоступаРоли.Роль.Имя В(&Роль)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрофилиГруппДоступаРоли.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ГруппыДоступа.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Группы
	|ИЗ
	|	Справочник.ГруппыДоступа КАК ГруппыДоступа
	|ГДЕ
	|	ГруппыДоступа.Профиль В
	|			(ВЫБРАТЬ
	|				ВТ_Профили.Ссылка
	|			ИЗ
	|				ВТ_Профили)
	|
	|СГРУППИРОВАТЬ ПО
	|	ГруппыДоступа.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрофилиГруппДоступаРоли.Роль.Имя КАК Роль
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	|		ПО (ГруппыДоступаПользователи.Ссылка.Профиль = ПрофилиГруппДоступаРоли.Ссылка)
	|ГДЕ
	|	ГруппыДоступаПользователи.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_Группы.Ссылка
	|			ИЗ
	|				ВТ_Группы)
	|	И ГруппыДоступаПользователи.Пользователь = &Пользователь
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрофилиГруппДоступаРоли.Роль.Имя";
	Запрос.УстановитьПараметр("Пользователь",Пользователь );
	Массив = Новый Массив();
	Массив.Добавить("Лико_ДоступКРазделуСайтаПоказатели");
	Массив.Добавить("Лико_ДоступКРазделуСайтаПланированиеРЦ");
	Массив.Добавить("Лико_ДоступКРазделуСайтаСостояниеМашин");
	Массив.Добавить("Лико_ДоступКРазделуСайтаОстакткиСГП");
	Массив.Добавить("Лико_ДоступКРазделуСайтаПродажи");
	Массив.Добавить("Лико_ДоступКРазделуСайтаОтгрузки");
	Массив.Добавить("Лико_ДоступКРазделуСайтаОтчеты");
	Запрос.УстановитьПараметр("Роль",Массив );
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Роль");
	
	
КонецФункции //-Лико m.shenderov 27.09.2019 

Функция ПолучитьДоступныеРазделы(Пользователь) //+Лико m.shenderov 26.09.2019
