		текТекстОшибки = "По сотруднику " + ТабНомер + " записи не найдены!";
		Возврат HttpВернутьОшибку(400, текТекстОшибки);
	КонецЕсли;  
	//Установка параметров печати
	текТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	текТабличныйДокумент.ПолеСлева 		= 0;
	текТабличныйДокумент.ПолеСправа 	= 0;
	текТабличныйДокумент.ПолеСнизу 		= 0;
	текТабличныйДокумент.ПолеСверху 	= 0;
	текТабличныйДокумент.РазмерСтраницы = "Custom";
	текТабличныйДокумент.ШиринаСтраницы = 77;
	// С ITs в конец Таб Док добавляем картинку и узнаём её высоту, так получаем высоту Таб Док
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Вывести(текТабличныйДокумент);
	Надпись = ТабличныйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);    
	Надпись.Расположить(ТабличныйДокумент.Область(1,1,ТабличныйДокумент.ВысотаТаблицы,1));    
	текВысота = Цел(Надпись.Высота) + 3;
	текТабличныйДокумент.ВысотаСтраницы = текВысота;
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("pdf");
	текТабличныйДокумент.Записать(ВременныйФайл, ТипФайлаТабличногоДокумента.PDF); 
	
	ДвДанные = Новый ДвоичныеДанные(ВременныйФайл);
	Base64 = Base64Строка(ДвДанные); 
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Content", Base64);
	Возврат HttpВернутьСтруктуруКакJSON(СтруктураВозврата);
	
КонецФункции

Процедура ЗаполнитьТаблицуМакетаЗП(пИмяТаблицы, пНомерПакета, текМакет, текТабДок, текМассивРезультатов)
	
	//Таблица по сотруднику пуста
	Если текМассивРезультатов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//Заполнение Табличного документа по пакету запроса
	текОбласть = текМакет.ПолучитьОбласть(пИмяТаблицы + "_Шапка");
	текТабДок.Вывести(текОбласть);		//Выведена шапка таблицы 
	
	текОбласть = текМакет.ПолучитьОбласть(пИмяТаблицы + "_Строка");
	Для каждого текЭллемент из текМассивРезультатов Цикл
		//заполнение параметров области из строки табличной части
		текОбласть.Параметры.Заполнить(текЭллемент);
		Если пНомерПакета = 1 Тогда
			Если текЭллемент.КоэффПерем <> "" И текЭллемент.КоэффПерем <> "0" Тогда 
				текОбласть.Параметры.ДатаРаботы = текЭллемент.КоэффПерем;
			Иначе 
				текОбласть.Параметры.ДатаРаботы = Формат(ПрочитатьДатуJSON(текЭллемент.ДатаРаботы, ФорматДатыJSON.ISO), "ДЛФ=D");
			КонецЕсли;
		КонецЕсли;
		//вывод сформированной области в табличный документ
		текТабДок.Вывести(текОбласть);			
	КонецЦикла;
	
КонецПроцедуры


