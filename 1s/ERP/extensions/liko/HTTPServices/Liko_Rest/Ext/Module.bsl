	Структура = Новый Структура;
	Структура.Вставить("result",0);
	Структура.Вставить("ProductCode","");
	Структура.Вставить("ProductName","");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Наименование КАК ProductName
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул = &ProductArticle
	|	И Номенклатура.Лико_ТипЭтикетки= &ProductType";
	Запрос.УстановитьПараметр("ProductArticle",ProductArticle );
	Запрос.УстановитьПараметр("ProductType",Перечисления.Лико_ТипыЭтикеток.Получить(Число(ProductType)-1) );
	
	РезультатЗапроса = Запрос.Выполнить();
