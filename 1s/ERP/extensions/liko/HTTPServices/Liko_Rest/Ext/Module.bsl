		Структура.result=1;
		Структура.ProductCode=Строка(Выборка.Ссылка.УникальныйИдентификатор());
		Структура.ProductName=Выборка.ProductName;
		Возврат Структура;
		
	КонецЦикла; 
	
	
	
	
