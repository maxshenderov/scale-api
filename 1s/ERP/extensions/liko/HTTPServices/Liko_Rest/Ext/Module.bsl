Функция StagesControl(ПараметрыPOST) 	 
	
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "OrderNum,OrderDate,ArrayStageCode,UserOS");
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли;
	
	
	// Найдем пользователя 1с
	UserOS = ПараметрыPOST.UserOS;
	Если НЕ ЗначениеЗаполнено(UserOS) Тогда
		Возврат HttpВернутьОшибку(424, "Не передан UserOS");
	КонецЕсли;
	Пользователь=ПолучитьПользователя(UserOS);
	
	OrderNum  = ПараметрыPOST.OrderNum;
	OrderDate =  Дата(ПараметрыPOST.OrderDate);
	ArrayStageCode = ПараметрыPOST.ArrayStageCode;
	Заказ=Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказКлиента.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Дата = &Дата
	|	И ЗаказКлиента.Номер = &Номер";
	Запрос.УстановитьПараметр("Дата",OrderDate);
	Запрос.УстановитьПараметр("Номер",OrderNum);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Заказ=Выборка.Ссылка;
	КонецЦикла; 
	
	
	НачатьТранзакцию();	
	
	НаборЗаписей = РегистрыСведений.Лико_НастройкиОпововещенияОбЭтапахЗаказа.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Заказ.Установить(Заказ);	
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	
	
	Для каждого Код Из ArrayStageCode Цикл
		
		Этап= Справочники.Лико_ЭтапыВыполненияЗаказа.НайтиПоКоду(Код);
		Если ЗначениеЗаполнено(Этап) И ЗначениеЗаполнено(Заказ) Тогда
			
			Запись=НаборЗаписей.Добавить();
			Запись.Заказ=Заказ;
			Запись.Этап=Этап;
			Запись.Пользователь=Пользователь;
		КонецЕсли;
	КонецЦикла;
	
	
	НаборЗаписей.Записать(Истина); 
	ДокОбъект=Заказ.ПолучитьОбъект();
	ДокОбъект.КонтрольЭтапов=Истина;
	ДокОбъект.ОбменДанными.Загрузка =истина;			
	ДокОбъект.Записать();
	ЗафиксироватьТранзакцию();	
	
	
	Структура = Новый Структура;   	
	Структура.Вставить("result",1); 
	Возврат HttpВернутьСтруктуруКакJSON(Структура);
	
	
