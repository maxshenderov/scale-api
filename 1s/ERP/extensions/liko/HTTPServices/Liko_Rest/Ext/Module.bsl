Функция UpdateAppFileInfo(ПараметрыPOST) 
	
	ОшибкаВПараметрах = ПроверитьОбязательныеПараметры(ПараметрыPOST, "Артикул");
	
	Если ОшибкаВПараметрах <> 0 Тогда
		Возврат	ОшибкаВПараметрах;
	КонецЕсли; 
	  ФайлСогласования=Неопределено;
	  Согласовано = Неопределено;
	  Артикул = ПараметрыPOST.Артикул;
	  Если  ПараметрыPOST.Свойство("ФайлСогласования") Тогда
		     ФайлСогласования =  ПараметрыPOST.ФайлСогласования;
		 КонецЕсли; 
		 
		   Если  ПараметрыPOST.Свойство("Согласовано") Тогда
		     Согласовано =  ПараметрыPOST.Согласовано;
		 КонецЕсли; 
		 
		ВерсияНоменклатуры = Справочники.Лико_ВерсииНоменклатуры.НайтиПоРеквизиту("Артикул",Артикул);
		Структура = Новый Структура;
		Структура.Вставить("Результат",Ложь);
		Структура.Вставить("ОписаниеОшибки","Не найден артикул");
		
		Если ЗначениеЗаполнено( ВерсияНоменклатуры) Тогда
			СпроОбъект = ВерсияНоменклатуры.ПолучитьОбъект();
			Если ФайлСогласования<> Неопределено Тогда
			СпроОбъект.ФайлСогласования = ФайлСогласования=1; 
		КонецЕсли;
		
		Если Согласовано<>Неопределено Тогда
			СпроОбъект.Согласовано = 	Дата(СтрЗаменить(СтрЗаменить(СтрЗаменить(Согласовано,"T",""),":",""),"-",""));
;
		КонецЕсли;
		
        СпроОбъект.Записать();
		
		Структура.Результат= Истина;
		Структура.ОписаниеОшибки = "";
		
		КонецЕсли;
	
	  
	
	
	Возврат Лико_HTTP_Сервер.Ответ(Лико_HTTP_Сервер.СтруктураВJSON(Структура));
	
