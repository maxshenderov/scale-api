Процедура ДобавитьИнструменты(Инструменты) Экспорт

	ДобавитьИнструментСписокМетаданных(Инструменты);
	ДобавитьИнструментСтруктураОбъекта(Инструменты);
	ДобавитьИнструментВыполнитьBSL(Инструменты);

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

    Если ИмяИнструмента = "list_metadata_objects" Тогда
        Возврат СписокМетаданных(Аргументы);
    ИначеЕсли ИмяИнструмента = "get_metadata_structure" Тогда
        Возврат СтруктураОбъектаМетаданных(Аргументы);
    ИначеЕсли ИмяИнструмента = "execute_bsl" Тогда
        Возврат ВыполнитьBSL(Аргументы);
    Иначе
        ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
    КонецЕсли;

КонецФункции

#Область ИнструментСписокМетаданных

Процедура ДобавитьИнструментСписокМетаданных(Инструменты)

	// Создаем описания параметров для инструмента list_metadata_objects
	МассивПараметров = Новый Массив;
	
	// Параметр metaType - тип объекта метаданных
	СписокТиповМетаданных = "Catalogs,Documents,InformationRegisters,AccumulationRegisters,AccountingRegisters,CalculationRegisters,ChartsOfCharacteristicTypes,ChartsOfAccounts,ChartsOfCalculationTypes,BusinessProcesses,Tasks,ExchangePlans,FilterCriteria,Reports,DataProcessors,Enums,CommonModules,SessionParameters,CommonTemplates,CommonPictures,XDTOPackages,WebServices,HTTPServices,WSReferences,Styles,Languages,FunctionalOptions,FunctionalOptionsParameters,DefinedTypes,CommonAttributes,CommonCommands,CommandGroups,Constants,CommonForms,Roles,Subsystems,EventSubscriptions,ScheduledJobs,SettingsStorages,Sequences,DocumentJournals,ExternalDataSources,Interfaces";
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType",
		"string",
		"Тип объекта метаданных",
		,
		Истина,
		СписокТиповМетаданных
	));
	
	// Параметр nameMask - маска имени в формате регулярного выражения
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"nameMask",
		"string",
		"Маска имени объекта. Проверяется на вхождение подстроки в имя или синоним объекта."
	));
	
	// Параметр maxItems - максимальное количество возвращаемых результатов
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxItems",
		"number",
		"Максимальное количество возвращаемых результатов",
		100
	));
	
	// Создаем JSON-схему параметров
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	// Добавляем инструмент в таблицу
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"list_metadata_objects",
		"Получение списка объектов метаданных конфигурации с возможностью фильтрации по типу и имени",
		СхемаПараметров
	);

КонецПроцедуры

Функция СписокМетаданных(Аргументы)

	// Значения по умолчанию
	МетаТип     = Аргументы.metaType;
	МаскаИмени  = ?(Аргументы.Свойство("nameMask"), Аргументы.nameMask, "");
	Лимит       = ?(Аргументы.Свойство("maxItems"), Аргументы.maxItems, 100);

	МаскаИмениВРег = ВРег(МаскаИмени);

	// Получаем коллекцию нужного типа
	Попытка
		КоллекцияМД = Метаданные[МетаТип];
	Исключение
		ВызватьИсключение "Неизвестный тип метаданных в metaType: " + МетаТип;
	КонецПопытки;

	МассивСтрок = Новый Массив;
	Счетчик = 0;

	Для Каждого Элемент Из КоллекцияМД Цикл
		// Проверяем маску имени, если она задана
		Если ЗначениеЗаполнено(МаскаИмени) Тогда
			// Простая проверка на вхождение подстроки
			Если СтрНайти(ВРег(Элемент.Имя), МаскаИмениВРег) = 0 
				И СтрНайти(ВРег(Элемент.Синоним), МаскаИмениВРег) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		// Формируем строку в формате "ПолноеИмя (Синоним)"
		СтрокаРезультата = Элемент.ПолноеИмя() + " (" + Элемент.Синоним + ")";
		МассивСтрок.Добавить(СтрокаРезультата);
		
		Счетчик = Счетчик + 1;
		Если Счетчик >= Лимит Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Объединяем строки через символ перевода строки
	Результат = СтрСоединить(МассивСтрок, Символы.ПС);
	
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ИнструментExecuteBSL

Процедура ДобавитьИнструментВыполнитьBSL(Инструменты)

	// Универсальный инструмент: выполнение BSL-кода на стороне сервера 1С.
	//
	// ВАЖНО: Это по сути удаленное выполнение кода. Используйте отдельного пользователя с минимальными правами.

	МассивПараметров = Новый Массив;

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"code",
		"string",
		"BSL-код для выполнения. Контекст: доступна переменная MCP_Params (Структура). Чтобы вернуть результат, присвойте MCP_Result любое значение.",
		,
		Истина
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"params",
		"object",
		"Произвольные параметры (JSON-object), будут доступны в коде как MCP_Params (Структура)."
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"transaction",
		"boolean",
		"Выполнять в транзакции. Если Истина, то при commit=Ложь изменения будут откатаны.",
		Истина
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"commit",
		"boolean",
		"Фиксировать изменения (только при transaction=Истина). По умолчанию Ложь (безопасно).",
		Ложь
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"resultExpression",
		"string",
		"Опционально: BSL-выражение, которое будет вычислено в том же контексте, что и code, и использовано как результат, если MCP_Result не задан."
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"returnJson",
		"boolean",
		"Если Истина, вернет JSON-строку вида {ok, committed, result}. Если Ложь - строковое представление результата.",
		Истина
	));

	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);

	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"execute_bsl",
		"Выполнение произвольного BSL-кода на стороне 1С (универсальный инструмент).",
		СхемаПараметров
	);

КонецПроцедуры

Функция ВыполнитьBSL(Аргументы)

	Код = Аргументы.code;
	Параметры = ?(Аргументы.Свойство("params"), Аргументы.params, Новый Структура);

	ИспользоватьТранзакцию = ?(Аргументы.Свойство("transaction"), Аргументы.transaction, Истина);
	Зафиксировать = ?(Аргументы.Свойство("commit"), Аргументы.commit, Ложь);
	ВыражениеРезультата = ?(Аргументы.Свойство("resultExpression"), Аргументы.resultExpression, "");
	ВозвращатьJSON = ?(Аргументы.Свойство("returnJson"), Аргументы.returnJson, Истина);

	Если НЕ ИспользоватьТранзакцию И Зафиксировать Тогда
		ВызватьИсключение "commit=Истина возможно только при transaction=Истина";
	КонецЕсли;

	// Локальные переменные контекста выполнения.
	// В коде доступны:
	//   MCP_Params  - Структура входных параметров
	//   MCP_Result  - произвольный результат (присвойте в BSL-коде)
	MCP_Params = Параметры;
	MCP_Result = Неопределено;

	ТранзакцияНачата = Ложь;
	КоммитСделан = Ложь;

	Попытка
		Если ИспользоватьТранзакцию Тогда
			НачатьТранзакцию();
			ТранзакцияНачата = Истина;
		КонецЕсли;

		КодКВыполнению = Код;
		Если ЗначениеЗаполнено(ВыражениеРезультата) Тогда
			// Важно: вычисляем выражение в том же контексте, что и основной код,
			// чтобы выражение могло ссылаться на переменные, объявленные в code.
			КодКВыполнению = КодКВыполнению + Символы.ПС
				+ "Если MCP_Result = Неопределено Тогда MCP_Result = (" + ВыражениеРезультата + "); КонецЕсли;";
		КонецЕсли;

		// Выполняем произвольный код. Он может присвоить MCP_Result.
		Выполнить(КодКВыполнению);

		Если ИспользоватьТранзакцию Тогда
			Если Зафиксировать Тогда
				ЗафиксироватьТранзакцию();
				КоммитСделан = Истина;
			Иначе
				ОтменитьТранзакцию();
			КонецЕсли;
		КонецЕсли;

	Исключение
		Если ТранзакцияНачата Тогда
			Попытка
				ОтменитьТранзакцию();
			Исключение
				// Игнорируем ошибку отката, чтобы вернуть исходную причину
			КонецПопытки;
		КонецЕсли;

		Инфо = ИнформацияОбОшибке();
		ВызватьИсключение ПодробноеПредставлениеОшибки(Инфо);
	КонецПопытки;

	Если ВозвращатьJSON Тогда
		Ответ = Новый Структура;
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("committed", КоммитСделан);
		Ответ.Вставить("result", MCP_Result);

		Возврат СериализоватьВJSONБезопасно(Ответ);
	Иначе
		Возврат Строка(MCP_Result);
	КонецЕсли;

КонецФункции

Функция СериализоватьВJSONБезопасно(Знач Значение)
	Попытка
		Нормализованное = НормализоватьДляJSON(Значение);
		Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Нормализованное);
	Исключение
		// Если не сериализуется (например, объект БД), возвращаем строковое представление
		Запасной = Новый Структура;
		Запасной.Вставить("ok", Истина);
		Запасной.Вставить("resultText", Строка(Значение));
		Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Запасной);
	КонецПопытки;
КонецФункции

Функция НормализоватьДляJSON(Знач Значение)
	// Преобразует типы, которые ЗаписатьJSON не умеет (например, ТаблицаЗначений),
	// в примитивы/структуры/массивы. Для "сложных" значений возвращает строку.

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Т = ТипЗнч(Значение);

	Если Т = Тип("Массив") Тогда
		М = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			М.Добавить(НормализоватьДляJSON(Элемент));
		КонецЦикла;
		Возврат М;
	КонецЕсли;

	Если Т = Тип("Структура") Тогда
		С = Новый Структура;
		Для Каждого П Из Значение Цикл
			С.Вставить(П.Ключ, НормализоватьДляJSON(П.Значение));
		КонецЦикла;
		Возврат С;
	КонецЕсли;

	Если Т = Тип("Соответствие") Тогда
		С = Новый Структура;
		Для Каждого П Из Значение Цикл
			С.Вставить(Строка(П.Ключ), НормализоватьДляJSON(П.Значение));
		КонецЦикла;
		Возврат С;
	КонецЕсли;

	Если Т = Тип("ТаблицаЗначений") Тогда
		М = Новый Массив;
		Для Каждого Стр Из Значение Цикл
			С = Новый Структура;
			Для Каждого Кол Из Значение.Колонки Цикл
				С.Вставить(Кол.Имя, НормализоватьДляJSON(Стр[Кол.Имя]));
			КонецЦикла;
			М.Добавить(С);
		КонецЦикла;
		Возврат М;
	КонецЕсли;

	Если Т = Тип("ТабличныйДокумент") Тогда
		// Для табличных документов возвращаем текстовое представление.
		Возврат Строка(Значение);
	КонецЕсли;

	Если Т = Тип("Дата") Тогда
		// ISO-ish, чтобы LLM было проще парсить.
		Возврат Формат(Значение, "ДФ=yyyy-MM-dd'T'HH:mm:ss");
	КонецЕсли;

	// Примитивы и значения, которые JSON-писатель обычно понимает (строка/число/булево/null)
	Если Т = Тип("Строка")
		Или Т = Тип("Число")
		Или Т = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	// Ссылки/объекты БД, UUID и прочее - как строка.
	Возврат Строка(Значение);

КонецФункции

#КонецОбласти

#Область ИнструментСтруктураОбъекта

Процедура ДобавитьИнструментСтруктураОбъекта(Инструменты)

	// Создаем описания параметров для инструмента get_metadata_structure
	МассивПараметров = Новый Массив;
	
	// Параметр metaType - тип объекта метаданных (только те, у которых есть структура)
	СписокТиповМетаданных = "Catalogs,Documents,InformationRegisters,AccumulationRegisters,AccountingRegisters,CalculationRegisters,Reports,DataProcessors,ChartsOfCharacteristicTypes,ChartsOfAccounts,ChartsOfCalculationTypes,BusinessProcesses,Tasks,ExchangePlans";
	
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType",
		"string",
		"Тип объекта метаданных",
		,
		Истина,
		СписокТиповМетаданных
	));
	
	// Параметр name - точное имя объекта (не зависимое от регистра)
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name",
		"string",
		"Точное имя объекта метаданных (без учета регистра)",
		,
		Истина
	));
	
	// Создаем JSON-схему параметров
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);
	
	// Добавляем инструмент в таблицу
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_metadata_structure",
		"Получение структуры объекта метаданных (реквизиты, табличные части, измерения, ресурсы)",
		СхемаПараметров
	);

КонецПроцедуры

Функция СтруктураОбъектаМетаданных(Аргументы)

	МетаТип = Аргументы.metaType;
	ИмяОбъекта = Аргументы.name;
	
	// Получаем коллекцию нужного типа
	Попытка
		КоллекцияМД = Метаданные[МетаТип];
	Исключение
		ВызватьИсключение "Неизвестный тип метаданных в metaType: " + МетаТип;
	КонецПопытки;
	
	// Ищем объект метаданных по имени (без учета регистра)
	МетаданныеОбъекта = КоллекцияМД.Найти(ИмяОбъекта);
	Если МетаданныеОбъекта = Неопределено Тогда
		ВызватьИсключение "Объект метаданных не найден: " + МетаТип + "." + ИмяОбъекта;
	КонецЕсли;
	
	ОбработкаОбъект = Создать();
	
	Возврат ОбработкаОбъект.ОписаниеСтруктурыОбъектаМетаданных(МетаданныеОбъекта);
	
КонецФункции

#КонецОбласти


