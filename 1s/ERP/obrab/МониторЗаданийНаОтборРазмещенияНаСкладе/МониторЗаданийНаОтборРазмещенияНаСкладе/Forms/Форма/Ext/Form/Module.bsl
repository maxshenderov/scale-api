//+Лико 09.06.2026 HTML-вывод

Функция ЦветВHex(Цвет)
	hexChars = "0123456789ABCDEF";
	Если Цвет = Неопределено Тогда
		Возврат "#FFFFFF";
	КонецЕсли;
	к = Цвет.Красный;
	з = Цвет.Зеленый;
	с = Цвет.Синий;
	Результат = "#"
		+ Сред(hexChars, Цел(к / 16) + 1, 1) + Сред(hexChars, к % 16 + 1, 1)
		+ Сред(hexChars, Цел(з / 16) + 1, 1) + Сред(hexChars, з % 16 + 1, 1)
		+ Сред(hexChars, Цел(с / 16) + 1, 1) + Сред(hexChars, с % 16 + 1, 1);
	Возврат Результат;
КонецФункции

Функция ЭкранироватьТекст(Знач Текст)
	амп = "&";
	Текст = СтрЗаменить(Текст, амп, амп + "amp;");
	Текст = СтрЗаменить(Текст, "<", амп + "lt;");
	Текст = СтрЗаменить(Текст, ">", амп + "gt;");
	Текст = СтрЗаменить(Текст, """", амп + "quot;");
	Возврат Текст;
КонецФункции

Функция ПолучитьЦветФонаHTML(СтрокаТаблицы, СооСтелажей)
	Если СтрокаТаблицы.Стеллаж = Неопределено ИЛИ СтрокаТаблицы.Стеллаж = Null Тогда
		Возврат "#FFFFFF";
	КонецЕсли;
	Цвет = СооСтелажей.Получить(СтрокаТаблицы.Стеллаж);
	Если Цвет = Неопределено Тогда
		Возврат "#FFFFFF";
	КонецЕсли;
	Возврат ЦветВHex(Цвет);
КонецФункции

