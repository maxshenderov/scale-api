Процедура УсловноеОформление()
	
	// Очищаем предыдущие оформления
	УсловноеОформление.Элементы.Очистить();
	
	// Получаем список всех стеллажей на складе
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Лико_Стеллажи.Ссылка КАК Стеллаж
	|ИЗ
	|	Справочник.Лико_Стеллажи КАК Лико_Стеллажи
	|ГДЕ
	|	Лико_Стеллажи.Склад = &Склад
	|	И НЕ Лико_Стеллажи.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	СооСтелажей=Справочники.Лико_Стеллажи.ЦветаСтелажей(Склад);

	// Для каждого стеллажа создаем отдельный отбор с условным оформлением
	Для каждого СтрокаСтеллажа Из РезультатЗапроса Цикл
		Цвет = СооСтелажей[СтрокаСтеллажа.Стеллаж];
		ДобавитьЭлементУсловногоОформления(СтрокаСтеллажа.Стеллаж,"СписокРазмещение", Цвет);
		ДобавитьЭлементУсловногоОформления(СтрокаСтеллажа.Стеллаж,"СписокОтбор", Цвет);
		ДобавитьЭлементУсловногоОформления(СтрокаСтеллажа.Стеллаж,"СписокПеремещение", Цвет);
		
	КонецЦикла;
	
КонецПроцедуры 


