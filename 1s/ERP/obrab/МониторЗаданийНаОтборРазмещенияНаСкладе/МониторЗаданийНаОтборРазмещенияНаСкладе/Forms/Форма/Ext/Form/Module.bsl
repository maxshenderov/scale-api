Функция ЦветВHex2(ЦветПараметр) Экспорт
	Попытка
		Если ЦветПараметр = Неопределено ИЛИ ЦветПараметр = Null Тогда
			Возврат "#E0E0E0";
		КонецЕсли;
		Если ТипЗнч(ЦветПараметр) <> Тип("Цвет") Тогда
			Возврат "#E0E0E0";
		КонецЕсли;
		к = ЦветПараметр.Красный;
		з = ЦветПараметр.Зеленый;
		с = ЦветПараметр.Синий;
		hexChars = "0123456789ABCDEF";
		Результат = "#"
			+ Сред(hexChars, Цел(к / 16) + 1, 1) + Сред(hexChars, (к % 16) + 1, 1)
			+ Сред(hexChars, Цел(з / 16) + 1, 1) + Сред(hexChars, (з % 16) + 1, 1)
			+ Сред(hexChars, Цел(с / 16) + 1, 1) + Сред(hexChars, (с % 16) + 1, 1);
		Возврат Результат;
	Исключение
		Возврат "#E0E0E0";
	КонецПопытки;
КонецФункции

Функция ЦветВHex1(ЦветПараметр) Экспорт
    Попытка
        Если ЦветПараметр = Неопределено ИЛИ ЦветПараметр = Null Тогда
            Возврат "#E0E0E0";
        КонецЕсли;
        Если ТипЗнч(ЦветПараметр) <> Тип("Цвет") Тогда
            Возврат "#E0E0E0";
        КонецЕсли;
        
        // +++ Проверка на стилевой/автоматический цвет (RGB = 0,0,0 но это не чёрный)
        Если ЦветПараметр.Красный = 0 
            И ЦветПараметр.Зеленый = 0 
            И ЦветПараметр.Синий = 0 Тогда
            // Настоящий чёрный #000000 — тоже нежелателен для фона таблицы
            // Возвращаем серый как fallback
            Возврат "#E0E0E0";
        КонецЕсли;
        
        к = ЦветПараметр.Красный;
        з = ЦветПараметр.Зеленый;
        с = ЦветПараметр.Синий;
        hexChars = "0123456789ABCDEF";
        Результат = "#"
            + Сред(hexChars, Цел(к / 16) + 1, 1) + Сред(hexChars, (к % 16) + 1, 1)
            + Сред(hexChars, Цел(з / 16) + 1, 1) + Сред(hexChars, (з % 16) + 1, 1)
            + Сред(hexChars, Цел(с / 16) + 1, 1) + Сред(hexChars, (с % 16) + 1, 1);
        Возврат Результат;
    Исключение
        Возврат "#E0E0E0";
    КонецПопытки;
КонецФункции

Функция ЦветВHex3(ЦветПараметр) Экспорт
    Попытка
        Если ЦветПараметр = Неопределено ИЛИ ЦветПараметр = Null Тогда
            Возврат "#E0E0E0";
        КонецЕсли;
        Если ТипЗнч(ЦветПараметр) <> Тип("Цвет") Тогда
            Возврат "#E0E0E0";
        КонецЕсли;
        
        // Стилевой цвет — получаем реальный RGB
        РеальныйЦвет = ЦветПараметр.ПолучитьЦвет();
        
        к = РеальныйЦвет.Красный;
        з = РеальныйЦвет.Зеленый;
        с = РеальныйЦвет.Синий;
        
        hexChars = "0123456789ABCDEF";
        Результат = "#"
            + Сред(hexChars, Цел(к / 16) + 1, 1) + Сред(hexChars, (к % 16) + 1, 1)
            + Сред(hexChars, Цел(з / 16) + 1, 1) + Сред(hexChars, (з % 16) + 1, 1)
            + Сред(hexChars, Цел(с / 16) + 1, 1) + Сред(hexChars, (с % 16) + 1, 1);
        Возврат Результат;
    Исключение
        Возврат "#E0E0E0";
    КонецПопытки;
КонецФункции

Функция ЦветВHex(ЦветПараметр) Экспорт
    Попытка
        Если ЦветПараметр = Неопределено ИЛИ ЦветПараметр = Null Тогда
            Возврат "#E0E0E0";
        КонецЕсли;
        Если ТипЗнч(ЦветПараметр) <> Тип("Цвет") Тогда
            Возврат "#E0E0E0";
        КонецЕсли;
        
        СтрЦвет = XMLСтрока(ЦветПараметр);
              
        // Если уже hex типа #RRGGBB или RRGGBB
        Если СтрНачинаетсяС(СтрЦвет, "#") Тогда
            Возврат СтрЦвет;
        КонецЕсли;
        
        Возврат "#E0E0E0";
    Исключение
        Возврат "#E0E0E0";
    КонецПопытки;
КонецФункции

Функция ЭкранироватьТекст(Знач Текст)
	амп = "&";
	Текст = СтрЗаменить(Текст, амп, амп + "amp;");
	Текст = СтрЗаменить(Текст, "<", амп + "lt;");
	Текст = СтрЗаменить(Текст, ">", амп + "gt;");
	Текст = СтрЗаменить(Текст, """", амп + "quot;");
	Возврат Текст;
КонецФункции

Функция ПолучитьЦветФонаHTML(СтрокаТаблицы, СооСтелажей)
	Попытка
		Если СтрокаТаблицы.Стеллаж = Неопределено ИЛИ СтрокаТаблицы.Стеллаж = Null Тогда
			Возврат "#E0E0E0";
		КонецЕсли;
		Цвет = СооСтелажей.Получить(СтрокаТаблицы.Стеллаж); 
			Если Цвет = Неопределено Тогда
			Возврат "#E0E0E0";
		КонецЕсли;
		Возврат ЦветВHex(Цвет);
	Исключение
		Возврат "#E0E0E0";
	КонецПопытки;
КонецФункции

