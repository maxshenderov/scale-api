// На клиенте
&НаКлиенте
Процедура СформироватьHTML2()
    СооСтелажейHex = Новый Соответствие;
    
    // Получаем цвета на клиенте - здесь стилевые цвета работают
    СооСтелажей =СооСтелажейСервер(); 
	

    
    Для Каждого КЗ Из СооСтелажей Цикл
        Цвет = КЗ.Значение;
        Если ТипЗнч(Цвет) = Тип("Цвет") Тогда
            к = Цвет.Красный;
            з = Цвет.Зеленый;
            с = Цвет.Синий;
            hexChars = "0123456789ABCDEF";
            Hex = "#"
                + Сред(hexChars, Цел(к / 16) + 1, 1) + Сред(hexChars, (к % 16) + 1, 1)
                + Сред(hexChars, Цел(з / 16) + 1, 1) + Сред(hexChars, (з % 16) + 1, 1)
                + Сред(hexChars, Цел(с / 16) + 1, 1) + Сред(hexChars, (с % 16) + 1, 1);
            СооСтелажейHex.Вставить(КЗ.Ключ, Hex);
        КонецЕсли;
    КонецЦикла;
    
    // Передаём hex-соответствие на сервер
    СформироватьHTMLНаСервереСЦветами(СооСтелажейHex);
КонецПроцедуры 
 &НаКлиенте
Процедура СформироватьHTML()
    Если НЕ ВыводВHTML Тогда
        Возврат;
    КонецЕсли;
    СооСтелажейHex = ПолучитьЦветаСтелажейHexНаСервере();
    СформироватьHTMLНаСервереСЦветами(СооСтелажейHex);
КонецПроцедуры
