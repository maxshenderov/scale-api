// Получает данные затрат из регистра
&НаСервере
Функция ПолучитьДанныеЗатрат(ДокументСсылка)
    
    ЗатратыМассив = Новый Массив;
    
    Попытка
        Запрос = Новый Запрос;
        Запрос.Текст = "
        |ВЫБРАТЬ
        |    Затрата, СтатьяЗатрат, РабочийЦентр, НомерПроката, ВидРабот,
        |    Количество, Сумма, КоличествоШт, Метраж, ПроцентЗаливки, Грамматура,
        |    РасходКраски, КоличествоЦветов, МетражПМ, Цена
        |ИЗ РегистрСведений.Лико_Затраты
        |ГДЕ ЗаказКлиента = &ЗаказКлиента
        |УПОРЯДОЧИТЬ ПО НомерПроката";
        
        Запрос.УстановитьПараметр("ЗаказКлиента", ДокументСсылка);
        Результат = Запрос.Выполнить();
        Выборка = Результат.Выбрать();
        
        Пока Выборка.Следующий() Цикл
            ЗатратаСтруктура = Новый Структура;
            ЗатратаСтруктура.Вставить("cost_item", Строка(Выборка.Затрата));
            ЗатратаСтруктура.Вставить("cost_article", Строка(Выборка.СтатьяЗатрат));
            ЗатратаСтруктура.Вставить("work_center", Строка(Выборка.РабочийЦентр));
            ЗатратаСтруктура.Вставить("run_number", Выборка.НомерПроката);
            ЗатратаСтруктура.Вставить("work_type", Строка(Выборка.ВидРабот));
            ЗатратаСтруктура.Вставить("quantity", Выборка.Количество);
            ЗатратаСтруктура.Вставить("amount", Выборка.Сумма);
            ЗатратаСтруктура.Вставить("quantity_pcs", Выборка.КоличествоШт);
            ЗатратаСтруктура.Вставить("meterage", Выборка.Метраж);
            ЗатратаСтруктура.Вставить("fill_percent", Выборка.ПроцентЗаливки);
            ЗатратаСтруктура.Вставить("grammage", Выборка.Грамматура);
            ЗатратаСтруктура.Вставить("ink_consumption", Выборка.РасходКраски);
            ЗатратаСтруктура.Вставить("color_count", Выборка.КоличествоЦветов);
            ЗатратаСтруктура.Вставить("linear_meters", Выборка.МетражПМ);
            ЗатратаСтруктура.Вставить("price", Выборка.Цена);
            
            ЗатратыМассив.Добавить(ЗатратаСтруктура);
        КонецЦикла;
        
    Исключение
        // Если регистр недоступен, возвращаем пустой массив
    КонецПопытки;
    
    Возврат ЗатратыМассив;
    
КонецФункции

