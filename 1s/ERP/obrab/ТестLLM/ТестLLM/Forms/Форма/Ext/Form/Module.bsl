// Функция для отправки запроса к LLM и получения ответа
//
// Параметры:
//  ТекстЗапроса - Строка - Текст пользовательского запроса к LLM
//  НастройкиЗапроса - Структура - Дополнительные настройки (необязательный):
//    * КлючAPI - Строка - API ключ (если не указан, используется значение по умолчанию)
//    * МодельID - Строка - ID модели (по умолчанию "anthropic/claude-haiku-4.5")
//    * СистемноеСообщение - Строка - Системный промпт (по умолчанию "Вы — полезный ассистент")
//    * Температура - Число - Значение temperature (по умолчанию 0.7)
//    * МаксТокенов - Число - Значение max_tokens (по умолчанию 1000)
//
// Возвращаемое значение:
//  Структура - Результат запроса с полями:
//    * Успех - Булево - Флаг успешного выполнения запроса
//    * Ответ - Строка - Текст ответа от модели (если Успех = Истина)
//    * ПолныйОтвет - Строка - Полный ответ API (если Успех = Истина)
//    * ОписаниеОшибки - Строка - Описание ошибки (если Успех = Ложь)
&НаКлиенте
Функция ОтправитьЗапросКLLM2(ТекстЗапроса, НастройкиЗапроса = Неопределено) Экспорт
    // Инициализация результата
    Результат = Новый Структура;
    Результат.Вставить("Успех", Ложь);
    Результат.Вставить("Ответ", "");
    Результат.Вставить("ПолныйОтвет", "");
    Результат.Вставить("ОписаниеОшибки", "");
    
    // Настройки по умолчанию
    БазовыйURL = "https://aichat-okil-sato.kartochka.tech/api/v1";
    КлючAPI = "sk-5ad444531ffa461a92ea0ddcd4f92a02"; // Замените на ключ из настроек ИИ-чата
    МодельID = "anthropic/claude-haiku-4.5";
    СистемноеСообщение = "Вы — полезный ассистент.";
    Температура = 0.7;
    МаксТокенов = 4000;
    
    // Применяем пользовательские настройки, если они переданы
    Если НастройкиЗапроса <> Неопределено Тогда
        Если НастройкиЗапроса.Свойство("КлючAPI") И ЗначениеЗаполнено(НастройкиЗапроса.КлючAPI) Тогда
            КлючAPI = НастройкиЗапроса.КлючAPI;
        КонецЕсли;
        
        Если НастройкиЗапроса.Свойство("МодельID") И ЗначениеЗаполнено(НастройкиЗапроса.МодельID) Тогда
            МодельID = НастройкиЗапроса.МодельID;
        КонецЕсли;
        
        Если НастройкиЗапроса.Свойство("СистемноеСообщение") И ЗначениеЗаполнено(НастройкиЗапроса.СистемноеСообщение) Тогда
            СистемноеСообщение = НастройкиЗапроса.СистемноеСообщение;
        КонецЕсли;
        
        Если НастройкиЗапроса.Свойство("Температура") Тогда
            Температура = НастройкиЗапроса.Температура;
        КонецЕсли;
        
        Если НастройкиЗапроса.Свойство("МаксТокенов") Тогда
            МаксТокенов = НастройкиЗапроса.МаксТокенов;
        КонецЕсли;
    КонецЕсли;
    
    // Создаем HTTP-соединение
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Content-Type", "application/json");
    Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);
    
    // Подготовка JSON для запроса
    ТелоЗапроса = "{
    |  ""model"": """ + МодельID + """,
    |  ""messages"": [
    |    {""role"": ""system"", ""content"": """ + ЗаменитьСпецСимволыJSON(СистемноеСообщение) + """},
    |    {""role"": ""user"", ""content"": """ + ЗаменитьСпецСимволыJSON(ТекстЗапроса) + """}
    |  ],
    |  ""temperature"": " + Формат(Температура, "ЧРГ=.; ЧГ=0") + ",
    |  ""max_tokens"": " + Формат(МаксТокенов, "ЧГ=0") + "
    |}";
    
    Попытка
        // Создаем HTTP-запрос
        HTTPСоединение = Новый HTTPСоединение(БазовыйURL,,,,,, Новый ЗащищенноеСоединениеOpenSSL());
        Запрос = Новый HTTPЗапрос("/chat/completions", Заголовки);
        Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);
        
        // Отправка запроса
        Ответ = HTTPСоединение.ОтправитьДляОбработки(Запрос);
        
        // Получение и обработка ответа
        ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
        
        // Парсинг JSON и извлечение ответа модели
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
        ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
        
        ТекстОтвета = ДанныеОтвета["choices"][0]["message"]["content"];
        
        // Заполнение результата
        Результат.Успех = Истина;
        Результат.Ответ = ТекстОтвета;
        Результат.ПолныйОтвет = ТелоОтвета;
        
    Исключение
        Результат.ОписаниеОшибки = ОписаниеОшибки();
    КонецПопытки;
    
    Возврат Результат;
КонецФункции

// Функция для отправки запроса к LLM и получения ответа
//
// Параметры:
//  ТекстЗапроса - Строка - Текст запроса пользователя
//  НастройкиЗапроса - Структура - Дополнительные настройки (необязательный):
//    * КлючAPI - Строка - Ключ API (если не указан, используется значение по умолчанию)
//    * МодельID - Строка - ID модели (по умолчанию "anthropic/claude-haiku-4.5")
//    * СистемноеСообщение - Строка - Инструкция для модели (по умолчанию "Вы — полезный ассистент")
//    * Температура - Число - Значение temperature (по умолчанию 0.7)
//    * МаксТокенов - Число - Значение max_tokens (по умолчанию 1000)
//
// Возвращаемое значение:
//  Структура - Результат запроса с полями:
//    * Успех - Булево - Признак успешного выполнения запроса
//    * Ответ - Строка - Текст ответа от модели (если Успех = Истина)
//    * ПолныйОтвет - Соответствие - Полный ответ API в виде объекта (если Успех = Истина)
//    * ОписаниеОшибки - Строка - Описание ошибки (если Успех = Ложь)
&НаСервере
Функция ОтправитьЗапросКLLM(ТекстЗапроса, НастройкиЗапроса = Неопределено) Экспорт
    // Инициализация результата
    Результат = Новый Структура;
    Результат.Вставить("Успех", Ложь);
    Результат.Вставить("Ответ", "");
    Результат.Вставить("ПолныйОтвет", Неопределено);
    Результат.Вставить("ОписаниеОшибки", "");
	
	
	    // Настройки по умолчанию
    URLСервера = "aichat-okil-sato.kartochka.tech"; // Имя сервера без https://
    Порт = 443; // Стандартный порт для HTTPS
    ПутьКAPI = "/api/v1/chat/completions"; // Полный путь к API-методу
    
    КлючAPI = "sk-5ad444531ffa461a92ea0ddcd4f92a02"; // Замените на свой ключ из настроек ИИ-чата
    МодельID = "anthropic/claude-haiku-4.5";

    СистемноеСообщение = "Вы — полезный ассистент.";
    Температура = 0.7;
    МаксТокенов = 4000;
    
    // Применяем пользовательские настройки, если они переданы
    Если НастройкиЗапроса <> Неопределено Тогда
        Если НастройкиЗапроса.Свойство("КлючAPI") И ЗначениеЗаполнено(НастройкиЗапроса.КлючAPI) Тогда
            КлючAPI = НастройкиЗапроса.КлючAPI;
        КонецЕсли;
        
        Если НастройкиЗапроса.Свойство("МодельID") И ЗначениеЗаполнено(НастройкиЗапроса.МодельID) Тогда
            МодельID = НастройкиЗапроса.МодельID;
        КонецЕсли;
        
        Если НастройкиЗапроса.Свойство("СистемноеСообщение") И ЗначениеЗаполнено(НастройкиЗапроса.СистемноеСообщение) Тогда
            СистемноеСообщение = НастройкиЗапроса.СистемноеСообщение;
        КонецЕсли;
        
        Если НастройкиЗапроса.Свойство("Температура") Тогда
            Температура = НастройкиЗапроса.Температура;
        КонецЕсли;
        
        Если НастройкиЗапроса.Свойство("МаксТокенов") Тогда
            МаксТокенов = НастройкиЗапроса.МаксТокенов;
        КонецЕсли;
    КонецЕсли;
    
    // Создаем HTTP-соединение
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Content-Type", "application/json");
    Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);
    
    // Используем объекты для формирования JSON
    Сообщения = Новый Массив;
    
    СистемноеСообщениеОбъект = Новый Структура;
    СистемноеСообщениеОбъект.Вставить("role", "system");
    СистемноеСообщениеОбъект.Вставить("content", СистемноеСообщение);
    Сообщения.Добавить(СистемноеСообщениеОбъект);
    
    ПользовательскоеСообщениеОбъект = Новый Структура;
    ПользовательскоеСообщениеОбъект.Вставить("role", "user");
    ПользовательскоеСообщениеОбъект.Вставить("content", ТекстЗапроса);
    Сообщения.Добавить(ПользовательскоеСообщениеОбъект);
    
    ЗапросОбъект = Новый Структура;
    ЗапросОбъект.Вставить("model", МодельID);
    ЗапросОбъект.Вставить("messages", Сообщения);
    ЗапросОбъект.Вставить("temperature", Температура);
    ЗапросОбъект.Вставить("max_tokens", МаксТокенов);
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ЗапросОбъект);
    ТелоЗапроса = ЗаписьJSON.Закрыть();
    
    Попытка
        // Создаем защищенное соединение
        ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
        
        // Создаем HTTP-соединение явно указывая параметры
        HTTPСоединение = Новый HTTPСоединение(URLСервера, Порт, , , , , ЗащищенноеСоединение);
        Запрос = Новый HTTPЗапрос(ПутьКAPI, Заголовки);
        Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);
        
        // Отправка запроса
        Ответ = HTTPСоединение.ОтправитьДляОбработки(Запрос);
        
        // Получение и обработка ответа
        ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
        
        // Парсинг JSON и извлечение ответа модели
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
        ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
        
        ТекстОтвета = ДанныеОтвета["choices"][0]["message"]["content"];
        
        // Заполнение результата
        Результат.Успех = Истина;
        Результат.Ответ = ТекстОтвета;
        Результат.ПолныйОтвет = ДанныеОтвета;
        
    Исключение
        Результат.ОписаниеОшибки = ОписаниеОшибки();
    КонецПопытки;
    
    Возврат Результат;
КонецФункции
// Вспомогательная функция для экранирования спецсимволов в JSON
&НаКлиенте
Функция ЗаменитьСпецСимволыJSON(Строка)
    Результат = СтрЗаменить(Строка, "\", "\\");
    Результат = СтрЗаменить(Результат, """", "\""");
    Результат = СтрЗаменить(Результат, Символы.ВК, "\\r");
    Результат = СтрЗаменить(Результат, Символы.ПС, "\\n");
    Результат = СтрЗаменить(Результат, Символы.Таб, "\\t");
    Возврат Результат;
КонецФункции       

