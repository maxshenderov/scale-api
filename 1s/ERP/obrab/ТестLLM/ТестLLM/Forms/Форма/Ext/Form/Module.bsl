// Отправляет запрос анализа заказа в LLM и возвращает HTML-результат
&НаСервере
Функция ОтправитьЗапросАнализаЗаказа(ДокументСсылка, ТипАнализа = "Полный") Экспорт
    
    Попытка
        // Проверка входных параметров
        Если ТипЗнч(ДокументСсылка) <> Тип("ДокументСсылка.ЗаказКлиента") Тогда
            Возврат ПолучитьОшибкуHTML("Ошибка: передана некорректная ссылка на заказ");
        КонецЕсли;
        
        Если ДокументСсылка.Пустая() Тогда
            Возврат ПолучитьОшибкуHTML("Ошибка: заказ не выбран");
        КонецЕсли;
        
        // Получаем JSON заказа
        ДанныеЗаказаJSON = ПолучитьДанныеЗаказаДляАИ(ДокументСсылка);
        
        Если ПустаяСтрока(ДанныеЗаказаJSON) Тогда
            Возврат ПолучитьОшибкуHTML("Ошибка: не удалось получить данные заказа");
        КонецЕсли;
        
        // Формируем системный промпт в зависимости от типа анализа
        СистемныйПромпт = ПолучитьСистемныйПромпт(ТипАнализа, ДанныеЗаказаJSON);
        
        // Отправляем запрос в LLM
        РезультатLLM = ОтправитьЗапросКLLM(СистемныйПромпт);
        
        Если НЕ РезультатLLM.Успех Тогда
            Возврат ПолучитьОшибкуHTML("Ошибка LLM: " + РезультатLLM.ОписаниеОшибки);
        КонецЕсли;
        
        // Обрабатываем результат
        РезультатHTML = ОбработатьРезультатLLM(РезультатLLM.Ответ, ТипАнализа);
        
        Возврат РезультатHTML;
        
    Исключение
        ОписаниеОшибки = ОписаниеОшибки();
        Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Ошибка при анализе заказа: " + ОписаниеОшибки);
        Возврат ПолучитьОшибкуHTML("Ошибка при анализе заказа: " + ОписаниеОшибки);
    КонецПопытки;
    
КонецФункции

