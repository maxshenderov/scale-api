    // Серверный хелпер: получить ВСЕ файлы из ВСЕХ ОригиналМакетов заказа
    // Возвращает: Массив из Структура {СсылкаМакет, ИдентификаторФайла, ИмяФайла, GUID_Объекта, GUID_Строки}
    &НаСервере
    Функция ПолучитьВсеФайлыМакетовИзЗаказаСервер(СсылкаЗаказ)
    
    	МассивФайлов = Новый Массив;
    
    	Если НЕ ЗначениеЗаполнено(СсылкаЗаказ) Тогда
    		Возврат МассивФайлов;
    	КонецЕсли;
    
    	ДокументЗаказ = СсылкаЗаказ.ПолучитьОбъект();
    
    	// Перебираем все строки Товары с заполненным ОригиналМакетом
    	Для Каждого СтрокаТовары Из ДокументЗаказ.Товары Цикл
    		Если НЕ ЗначениеЗаполнено(СтрокаТовары.ОригиналМакет) Тогда
    			Продолжить;
    		КонецЕсли;
    
    		СсылкаМакет = СтрокаТовары.ОригиналМакет;
    		GUID_Объекта = ЗначениеВСтрокуВнутр(СсылкаМакет);
    
    		// Перебираем ВСЕ файлы этого макета из ТЧ Файлы
    		Запрос = Новый Запрос;
    		Запрос.Текст = "ВЫБРАТЬ
    		|	Файлы.ИдентификаторФайла КАК ИдентификаторФайла,
    		|	Файлы.ИмяФайла КАК ИмяФайла
    		|ИЗ
    		|	Справочник.Лико_ОригиналМакеты.Файлы КАК Файлы
    		|ГДЕ
    		|	Файлы.Ссылка = &СсылкаМакет";
    		Запрос.УстановитьПараметр("СсылкаМакет", СсылкаМакет);
    		Рез = Запрос.Выполнить().Выбрать();
    
    		Пока Рез.Следующий() Цикл
    			ИнфоФайла = Новый Структура;
    			ИнфоФайла.Вставить("СсылкаМакет", СсылкаМакет);
    			ИнфоФайла.Вставить("ИдентификаторФайла", Рез.ИдентификаторФайла);
    			ИнфоФайла.Вставить("ИмяФайла", Рез.ИмяФайла);
    			ИнфоФайла.Вставить("GUID_Объекта", GUID_Объекта);
    			ИнфоФайла.Вставить("GUID_Строки", ЗначениеВСтрокуВнутр(Рез.ИдентификаторФайла));
    			МассивФайлов.Добавить(ИнфоФайла);
    		КонецЦикла;
    	КонецЦикла;
    
    	Возврат МассивФайлов;
    
    КонецФункции
    
    //+Лико m.shenderov 08.05.2026
    // PoC: Извлечение параметров макета — поддерживает:
    //   1. Несколько файлов из папок (множественный выбор)
    //   2. ВСЕ файлы из ВСЕХ ОригиналМакетов заказа
    //   3. Анализирует каждый файл → выводит сводный HTML
    &НаКлиенте
    Процедура ИзвлечьПараметрыМакета(Команда) Экспорт
    
    	МассивФайлов = Новый Массив;
    
    	Если ЗначениеЗаполнено(МассивПутейМакетов) И МассивПутейМакетов.Количество() > 0 Тогда
    		// Способ 1: несколько файлов с диска
    		Для Каждого Путь Из МассивПутейМакетов Цикл
    			ИнфоФайла = Новый Структура;
    			ИнфоФайла.Вставить("Способ", "Папка");
    			ИнфоФайла.Вставить("ПутьКФайлу", Путь);
    			МассивФайлов.Добавить(ИнфоФайла);
    		КонецЦикла;
    	ИначеЕсли ЗначениеЗаполнено(Заказ) Тогда
    		// Способ 2: все файлы из заказа
    		СписокФайлов = ПолучитьВсеФайлыМакетовИзЗаказаСервер(Заказ);
    
    		Если СписокФайлов.Количество() = 0 Тогда
    			Сообщить("В заказе нет файлов макетов");
    			Возврат;
    		КонецЕсли;
    
    		Для Каждого Инфо Из СписокФайлов Цикл
    			ИнфоФайла = Новый Структура;
    			ИнфоФайла.Вставить("Способ", "FileStore");
    			ИнфоФайла.Вставить("ИмяФайлаИсточник", Инфо.ИмяФайла);
    			ИнфоФайла.Вставить("GUID_Объекта", Инфо.GUID_Объекта);
    			ИнфоФайла.Вставить("GUID_Строки", Инфо.GUID_Строки);
    			МассивФайлов.Добавить(ИнфоФайла);
    		КонецЦикла;
    	Иначе
    		Сообщить("Укажите файлы макетов (кнопка ""..."" справа) ИЛИ выберите заказ");
    		Возврат;
    	КонецЕсли;
    
    	// Анализируем каждый файл
    	СуммарнаяСтоимость = 0;
    	HTML = Новый Массив;
    	HTML.Добавить("<html><head><style>
    	|body { font-family: 'Segoe UI', sans-serif; margin: 10px; background: #1e1e1e; color: #d4d4d4; }
    	|h2 { color: #569cd6; margin-top: 15px; }
    	|.header { color: #4ec9b0; font-size: 16px; margin-bottom: 10px; }
    	|.json-block { background: #2d2d2d; border: 1px solid #3e3e3e; border-radius: 6px; padding: 12px; margin: 10px 0; font-family: 'Consolas', monospace; font-size: 12px; white-space: pre-wrap; word-break: break-all; max-height: 400px; overflow: auto; }
    	|.info { color: #ce9178; font-size: 13px; }
    	|.success { color: #6a9955; }
    	|.error { color: #f44747; }
    	|.file-header { color: #dcdcaa; font-size: 15px; margin-top: 20px; }
    	|</style></head><body>");
    
    	HTML.Добавить("<div class='header'>🎨 Анализ макетов (" + МассивФайлов.Количество() + " файлов)</div>");
    	HTML.Добавить("<div class='info'>🤖 Модель: " + ПолучитьIDМоделиVL() + "</div>");
    
    	МодельVisionID = ПолучитьIDМоделиVL();
    
    	Для НомерФайла = 0 По МассивФайлов.Количество() - 1 Цикл
    		Инфо = МассивФайлов[НомерФайла];
    		НомерДляПользователя = НомерФайла + 1;
    
    		// Формируем параметры для получения двоичных данных
    		ПараметрыФайла = Новый Структура;
    		Если Инфо.Способ = "Папка" Тогда
    			ПараметрыФайла.Вставить("Способ", "Папка");
    			ПараметрыФайла.Вставить("ПутьКФайлу", Инфо.ПутьКФайлу);
    		Иначе
    			ПараметрыФайла.Вставить("Способ", "FileStore");
    			ПараметрыФайла.Вставить("ИмяФайлаИсточник", Инфо.ИмяФайлаИсточник);
    			ПараметрыФайла.Вставить("GUID_Объекта", Инфо.GUID_Объекта);
    			ПараметрыФайла.Вставить("GUID_Строки", Инфо.GUID_Строки);
    		КонецЕсли;
    
    		РезультатФайл = ПолучитьДвоичныеДанныеФайлаМакетаДваСпособа(ПараметрыФайла);
    
    		Если НЕ ЗначениеЗаполнено(РезультатФайл.ДвоичныеДанные) Тогда
    			HTML.Добавить("<div class='file-header'>⚠️ Файл #" + НомерДляПользователя + ": " + РезультатФайл.Ошибка + "</div>");
    			Продолжить;
    		КонецЕсли;
    
    		// Отправляем в Vision LLM
    		// Параметры провайдера для Vision LLM
    		Провайдеры = Провайдеры();
    		ПараметрыПровайдера = Провайдеры[Провайдер];
    
    		// Если задан известный размер — вычисляем второй в 1С (пиксели → мм)
    		ДополнительныйПромпт = "";
    		Если ЗначениеЗаполнено(ИзвестныйРазмерММ) И ИзвестныйРазмерММ > 0 Тогда
    			Попытка
    				Картинка = Новый Картинка(РезультатФайл.ДвоичныеДанные);
    				ПиксШирина = Картинка.Ширина;
    				ПиксВысота = Картинка.Высота;
    				
    				Если ИзвестныйРазмерЭтоШирина Тогда
    					ВычисленнаяВысота = Окр(ИзвестныйРазмерММ * ПиксВысота / ПиксШирина, 1);
    					ДополнительныйПромпт = "
    					|ГАРАНТИРОВАННЫЕ РАЗМЕРЫ (вычислены по пикселям):
    					|  label.width_mm = " + Строка(ИзвестныйРазмерММ) + "
    					|  label.height_mm = " + Строка(ВычисленнаяВысота) + "
    					|  (пиксели изображения: " + ПиксШирина + "×" + ПиксВысота + ")";
    				Иначе
    					ВычисленнаяШирина = Окр(ИзвестныйРазмерММ * ПиксШирина / ПиксВысота, 1);
    					ДополнительныйПромпт = "
    					|ГАРАНТИРОВАННЫЕ РАЗМЕРЫ (вычислены по пикселям):
    					|  label.width_mm = " + Строка(ВычисленнаяШирина) + "
    					|  label.height_mm = " + Строка(ИзвестныйРазмерММ) + "
    					|  (пиксели изображения: " + ПиксШирина + "×" + ПиксВысота + ")";
    				КонецЕсли;
    			Исключение
    				// Не удалось прочитать картинку — передаём как есть
    				РазмерТекст = ?(ИзвестныйРазмерЭтоШирина, "ширина", "высота");
    				ДополнительныйПромпт = "
    				|Известный размер: " + РазмерТекст + " = " + Строка(ИзвестныйРазмерММ) + " мм.";
    			КонецПопытки;
    		КонецЕсли;
 
    		//+Лико m.shenderov 13.05.2026
    		// Передаём имя файла макета как контекст для Vision LLM (подсказка для label_text)
    		ИмяФайлаМакета = "";
    		Если Инфо.Способ = "Папка" И ЗначениеЗаполнено(Инфо.ПутьКФайлу) Тогда
    			ИмяФайлаМакета = Инфо.ПутьКФайлу;
    		ИначеЕсли Инфо.Способ = "FileStore" И ЗначениеЗаполнено(Инфо.ИмяФайлаИсточник) Тогда
    			ИмяФайлаМакета = Инфо.ИмяФайлаИсточник;
    		КонецЕсли;
    		Если ЗначениеЗаполнено(ИмяФайлаМакета) Тогда
    			ДополнительныйПромпт = ДополнительныйПромпт + "
    			|КОНТЕКСТ: имя файла макета = """ + ИмяФайлаМакета + """
    			|Используй как ПОДСКАЗКУ для label_text — приоритет тому что ВИДИШЬ на изображении.";
    		КонецЕсли;
 
    		Настройки = Новый Структура;
    		Настройки.Вставить("МодельID", МодельVisionID);
    		Настройки.Вставить("ДополнительныйПромпт", ДополнительныйПромпт);
    		Настройки.Вставить("URLСервера", ПараметрыПровайдера.URLСервера);
    		Настройки.Вставить("КлючAPI", ПараметрыПровайдера.КлючAPI);
    		Настройки.Вставить("ПутьКAPI", ПараметрыПровайдера.ПутьКAPI);
    
    		РезультатVision = ОтправитьИзображениеВVisionLLM(РезультатФайл.ДвоичныеДанные, РезультатФайл.Расширение, Настройки);
    
    		Если РезультатVision.Успех Тогда
    			СуммарнаяСтоимость = СуммарнаяСтоимость + РезультатVision.Стоимость;
    
    			HTML.Добавить("<div class='file-header'>📄 Файл #" + НомерДляПользователя + ": " + РезультатФайл.ИмяФайла + " (." + РезультатФайл.Расширение + ") — $" + Формат(РезультатVision.Стоимость, "ЧДЦ=4; ЧРД=.") + "</div>");
    
    			// Парсим и красиво выводим JSON
    			Попытка
    				ЧтениеJSON = Новый ЧтениеJSON;
    				ЧтениеJSON.УстановитьСтроку(РезультатVision.Ответ);
    				ДанныеJSON = ПрочитатьJSON(ЧтениеJSON);
    				HTML.Добавить("<div class='json-block'>");
    				HTML.Добавить("  Размер: " + ?(ДанныеJSON.label.Свойство("width_mm"), ДанныеJSON.label.width_mm, "?") + "×" + ?(ДанныеJSON.label.Свойство("height_mm"), ДанныеJSON.label.height_mm, "?") + " мм | Форма: " + ?(ДанныеJSON.label.Свойство("shape"), ДанныеJSON.label.shape, "?"));
    				Если ДанныеJSON.Свойство("layout") Тогда
    					Раскладка = "  Раскладка: ";
    					Если ДанныеJSON.layout.Свойство("across") И ЗначениеЗаполнено(ДанныеJSON.layout.across) Тогда
    						Раскладка = Раскладка + ДанныеJSON.layout.across + " ручьёв";
    					КонецЕсли;
    					Если ДанныеJSON.layout.Свойство("along") И ЗначениеЗаполнено(ДанныеJSON.layout.along) Тогда
    						Раскладка = Раскладка + " × " + ДанныеJSON.layout.along + " по длине";
    					КонецЕсли;
    					Если ДанныеJSON.layout.Свойство("total_per_sheet") И ЗначениеЗаполнено(ДанныеJSON.layout.total_per_sheet) Тогда
    						Раскладка = Раскладка + " = " + ДанныеJSON.layout.total_per_sheet + " на листе";
    					КонецЕсли;
    					HTML.Добавить(Раскладка);
    				КонецЕсли;
    				HTML.Добавить("  Цветов: " + ?(ДанныеJSON.colors.Свойство("count"), ДанныеJSON.colors.count, "?") + " | " + ?(ДанныеJSON.colors.Свойство("list"), СтрСоединить(ДанныеJSON.colors.list, ", "), "?"));
    				HTML.Добавить("  Тип: " + ?(ДанныеJSON.Свойство("label_type"), ДанныеJSON.label_type, "?") + " | Технология: " + ?(ДанныеJSON.Свойство("technology"), ДанныеJSON.technology, "?"));
    				HTML.Добавить("  Материал: " + ?(ДанныеJSON.Свойство("material_hint"), ДанныеJSON.material_hint, "?") + " | Confidence: " + ?(ДанныеJSON.Свойство("confidence"), Формат(ДанныеJSON.confidence, "ЧДЦ=2; ЧРД=."), "?"));
    				HTML.Добавить("  Отделка: лак=" + ?(ДанныеJSON.finishing.Свойство("varnish"), Строка(ДанныеJSON.finishing.varnish), "-") + " фольга=" + ?(ДанныеJSON.finishing.Свойство("foil"), Строка(ДанныеJSON.finishing.foil), "-"));
    				//+Лико m.shenderov 13.05.2026
    				// Отображение текста этикетки из макета
    				Если ДанныеJSON.Свойство("label_text") И ТипЗнч(ДанныеJSON.label_text) = Тип("Структура") Тогда
    					ТекстМакетаЛт = ДанныеJSON.label_text;
    					БрендЛт  = ?(ТекстМакетаЛт.Свойство("brand") И ЗначениеЗаполнено(ТекстМакетаЛт.brand), Строка(ТекстМакетаЛт.brand), "-");
    					ПродуктЛт = ?(ТекстМакетаЛт.Свойство("product_name") И ЗначениеЗаполнено(ТекстМакетаЛт.product_name), Строка(ТекстМакетаЛт.product_name), "-");
    					ОбъёмЛт  = ?(ТекстМакетаЛт.Свойство("volume_weight") И ЗначениеЗаполнено(ТекстМакетаЛт.volume_weight), Строка(ТекстМакетаЛт.volume_weight), "-");
    					HTML.Добавить("  <b style='color:#4ec9b0'>📝 Текст этикетки:</b> " + БрендЛт + " | " + ПродуктЛт + " | " + ОбъёмЛт);
    					Если ТекстМакетаЛт.Свойство("full_text") И ЗначениеЗаполнено(ТекстМакетаЛт.full_text) Тогда
    						HTML.Добавить("  <div style='color:#ce9178;font-size:11px;margin-top:3px;max-height:80px;overflow:auto'>" + Строка(ТекстМакетаЛт.full_text) + "</div>");
    					КонецЕсли;
    				КонецЕсли;
    				HTML.Добавить("</div>");
    			Исключение
    				HTML.Добавить("<div class='json-block'>" + РезультатVision.Ответ + "</div>");
    			КонецПопытки;
    		Иначе
    			HTML.Добавить("<div class='file-header'><span class='error'>❌ Файл #" + НомерДляПользователя + ": " + РезультатVision.ОписаниеОшибки + "</span></div>");
    		КонецЕсли;
    	КонецЦикла;
    
    	Окончание = ?(МассивФайлов.Количество() = 1, "файл", "файлов");
    	Если СуммарнаяСтоимость > 0 Тогда
    		HTML.Добавить("<div class='info' style='margin-top:15px'>💰 Суммарная стоимость: $" + Формат(СуммарнаяСтоимость, "ЧДЦ=4; ЧРД=.") + " за " + МассивФайлов.Количество() + " " + Окончание + "</div>");
    	Иначе
    		HTML.Добавить("<div class='info' style='margin-top:15px'>📊 Обработано " + МассивФайлов.Количество() + " " + Окончание + " (стоимость не указана провайдером)</div>");
    	КонецЕсли;
    	HTML.Добавить("</body></html>");
    	htmlЗаказ = СтрСоединить(HTML, "");
    
    КонецПроцедуры
    
    &НаКлиенте
    Процедура ПровайдерПриИзменении(Элемент)
 Если ЗначениеЗаполнено(Провайдер) Тогда
  СписокМоделейСтруктура = МоделиLLM(Провайдер);
  ЗаполнитьСписокВыбораМодели(СоздатьСписокЗначенийИзКлючейСтруктуры(СписокМоделейСтруктура));
  ЗаполнитьСписокВыбораМоделиVL(СоздатьСписокЗначенийИзКлючейСтруктуры(СписокМоделейСтруктура));
 КонецЕсли;

КонецПроцедуры

#Область Qdrant_Индексация

//+Лико m.shenderov 12.05.2026
// Кнопка "Индексировать в Qdrant":
//   1. Сначала анализирует первый файл макета через Vision LLM (если есть)
//   2. Передаёт JSON-ответ Vision в серверную функцию
//   3. Сервер вызывает Лико_QdrantИндексация.СформироватьДанныеДляИндексации
//   4. Показывает результат в htmlЗаказ
&НаКлиенте
Процедура ИндексироватьЗаказQdrant(Команда)
	Если Заказ.Пустая() Тогда
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Выберите заказ для индексации");
		Возврат;
	КонецЕсли;

	// ── Шаг 1: Vision-анализ первого файла макета (если доступен) ─────────
	ПараметрыМакетаJSON = "";

	МассивФайловДляАнализа = Новый Массив;
	Если ЗначениеЗаполнено(МассивПутейМакетов) И МассивПутейМакетов.Количество() > 0 Тогда
		ИнфоФайла = Новый Структура("Способ,ПутьКФайлу", "Папка", МассивПутейМакетов[0]);
		МассивФайловДляАнализа.Добавить(ИнфоФайла);
	ИначеЕсли ЗначениеЗаполнено(Заказ) Тогда
		СписокФайлов = ПолучитьВсеФайлыМакетовИзЗаказаСервер(Заказ);
		Если СписокФайлов.Количество() > 0 Тогда
			Инфо = СписокФайлов[0];
			ИнфоФайла = Новый Структура("Способ,ИмяФайлаИсточник,GUID_Объекта,GUID_Строки",
				"FileStore", Инфо.ИмяФайла, Инфо.GUID_Объекта, Инфо.GUID_Строки);
			МассивФайловДляАнализа.Добавить(ИнфоФайла);
		КонецЕсли;
	КонецЕсли;

	Если МассивФайловДляАнализа.Количество() > 0 Тогда
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Vision-анализ файла макета...");

		ИнфоФайла = МассивФайловДляАнализа[0];
		ПараметрыФайла = Новый Структура;
		Если ИнфоФайла.Способ = "Папка" Тогда
			ПараметрыФайла.Вставить("Способ",      "Папка");
			ПараметрыФайла.Вставить("ПутьКФайлу",  ИнфоФайла.ПутьКФайлу);
		Иначе
			ПараметрыФайла.Вставить("Способ",            "FileStore");
			ПараметрыФайла.Вставить("ИмяФайлаИсточник",  ИнфоФайла.ИмяФайлаИсточник);
			ПараметрыФайла.Вставить("GUID_Объекта",       ИнфоФайла.GUID_Объекта);
			ПараметрыФайла.Вставить("GUID_Строки",        ИнфоФайла.GUID_Строки);
		КонецЕсли;

		РезультатФайл = ПолучитьДвоичныеДанныеФайлаМакетаДваСпособа(ПараметрыФайла);

		Если ЗначениеЗаполнено(РезультатФайл.ДвоичныеДанные) Тогда
			Провайдеры = Провайдеры();
			ПараметрыПровайдера = Провайдеры[Провайдер];

			//+Лико m.shenderov 13.05.2026
			// Добавляем имя файла как контекст для label_text
			ИмяФайлаКонтекст = "";
			Если ИнфоФайла.Способ = "Папка" И ЗначениеЗаполнено(ИнфоФайла.ПутьКФайлу) Тогда
				ИмяФайлаКонтекст = ИнфоФайла.ПутьКФайлу;
			ИначеЕсли ИнфоФайла.Способ = "FileStore" И ЗначениеЗаполнено(ИнфоФайла.ИмяФайлаИсточник) Тогда
				ИмяФайлаКонтекст = ИнфоФайла.ИмяФайлаИсточник;
			КонецЕсли;

			ДопПромптQdrant = "";
			Если ЗначениеЗаполнено(ИмяФайлаКонтекст) Тогда
				ДопПромптQdrant = "
				|КОНТЕКСТ: имя файла макета = """ + ИмяФайлаКонтекст + """
				|Используй как ПОДСКАЗКУ для label_text — приоритет тому что ВИДИШЬ на изображении.";
			КонецЕсли;

			НастройкиVision = Новый Структура;
			НастройкиVision.Вставить("МодельID",   ПолучитьIDМоделиVL());
			НастройкиVision.Вставить("URLСервера", ПараметрыПровайдера.URLСервера);
			НастройкиVision.Вставить("КлючAPI",    ПараметрыПровайдера.КлючAPI);
			НастройкиVision.Вставить("ПутьКAPI",   ПараметрыПровайдера.ПутьКAPI);
			НастройкиVision.Вставить("ДополнительныйПромпт", ДопПромптQdrant);

			РезультатVision = ОтправитьИзображениеВVisionLLM(
				РезультатФайл.ДвоичныеДанные, РезультатФайл.Расширение, НастройкиVision);

			Если РезультатVision.Успех Тогда
				ПараметрыМакетаJSON = РезультатVision.Ответ;
				Лико_ДополнительноКлиентСервер.СообщитьДляКлиента(
					"Макет проанализирован (~$" + Формат(РезультатVision.Стоимость, "ЧДЦ=4; ЧРД=.") + ")");
			Иначе
				Лико_ДополнительноКлиентСервер.СообщитьДляКлиента(
					"Vision-анализ не удался: " + РезультатVision.ОписаниеОшибки + " — продолжаем без макета");
			КонецЕсли;
		Иначе
			Лико_ДополнительноКлиентСервер.СообщитьДляКлиента(
				"Не удалось получить файл макета: " + РезультатФайл.Ошибка + " — продолжаем без макета");
		КонецЕсли;
	КонецЕсли;

	// ── Шаг 2: Формирование данных для Qdrant ─────────────────────────────
	Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Формирование данных для Qdrant...");
	Данные = ИндексироватьЗаказСервер(Заказ, ПараметрыМакетаJSON);

	Если НЕ Данные.success Тогда
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Ошибка: " + Данные.error);
		Возврат;
	КонецЕсли;

	// ── Шаг 3: Отображение результата ─────────────────────────────────────
	HTML = Новый Массив;
	HTML.Добавить("<html><body style='font-family:Consolas,monospace;padding:10px;background:#1e1e1e;color:#ccc'>");
	HTML.Добавить("<h2 style='color:#58a6ff'>Индексация Qdrant — Заказ " + Данные.order_id + "</h2>");

	// Флаг Vision-анализа
	Если Данные.payload.Свойство("vision_analyzed") И Данные.payload.vision_analyzed Тогда
