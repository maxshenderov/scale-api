//+Лико m.shenderov 06.05.2026
&НаСервере
Функция ПреобразоватьЗначениеВСтроку(Значение)
    // Преобразовать любое значение в строку для HTML
    Если Значение = Неопределено Тогда
        Возврат "";
    ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
        // Для структур показать количество полей
        Возврат "[Структура с " + Строка(Значение.Количество()) + " полями]";
    ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
        // Для массивов показать количество элементов
        Возврат "[Массив с " + Строка(Значение.Количество()) + " элементами]";
    ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
        Возврат ?(Значение, "Да", "Нет");
    Иначе
        Возврат Строка(Значение);
    КонецЕсли;
КонецФункции

//+Лико m.shenderov 07.05.2026
// Определяет HEX-код цвета по названию
&НаСервере
Функция ОпределитьЦветПоНазванию(ЦветНазвание)
    НРегЦвет = НРег(СокрЛП(ЦветНазвание));
    
    // Cyan (C), Cyan, голубой
    Если Найти(НРегЦвет, "cyan") > 0 ИЛИ Найти(НРегЦвет, "голуб") > 0 ИЛИ НРегЦвет = "c" Тогда
        Возврат "#00bcd4";
    // Magenta (M), Magenta, пурпурный
    ИначеЕсли Найти(НРегЦвет, "magenta") > 0 ИЛИ Найти(НРегЦвет, "пурпур") > 0 ИЛИ НРегЦвет = "m" Тогда
        Возврат "#e91e63";
    // Yellow (Y), Yellow, жёлтый
    ИначеЕсли Найти(НРегЦвет, "yellow") > 0 ИЛИ Найти(НРегЦвет, "желт") > 0 ИЛИ НРегЦвет = "y" Тогда
        Возврат "#ffeb3b";
    // Black 1 (K), Black 2, Black, чёрный
    ИначеЕсли Найти(НРегЦвет, "black") > 0 ИЛИ Найти(НРегЦвет, "черн") > 0 ИЛИ НРегЦвет = "k" Тогда
        Возврат "#333333";
    // White (W), белый
    ИначеЕсли Найти(НРегЦвет, "white") > 0 ИЛИ Найти(НРегЦвет, "бел") > 0 ИЛИ НРегЦвет = "w" Тогда
        Возврат "#e0e0e0";
    // Process Blue, синий
    ИначеЕсли Найти(НРегЦвет, "process blue") > 0 ИЛИ Найти(НРегЦвет, "синий") > 0 Тогда
        Возврат "#1565c0";
    // 485 ext FL-F (красный), красный
    ИначеЕсли Найти(НРегЦвет, "485") > 0 ИЛИ Найти(НРегЦвет, "красн") > 0 Тогда
        Возврат "#d32f2f";
    // 401 ext FL-F (серый), серый
    ИначеЕсли Найти(НРегЦвет, "401") > 0 ИЛИ Найти(НРегЦвет, "сер") > 0 Тогда
        Возврат "#757575";
    // Pantone, PMS, пантон
    ИначеЕсли Найти(НРегЦвет, "pantone") > 0 ИЛИ Найти(НРегЦвет, "pms") > 0 ИЛИ Найти(НРегЦвет, "пантон") > 0 Тогда
        Возврат "#9c27b0";
    // Лак, varnish
    ИначеЕсли Найти(НРегЦвет, "лак") > 0 ИЛИ Найти(НРегЦвет, "varnish") > 0 Тогда
        Возврат "#90a4ae";
    // Зелёный
    ИначеЕсли Найти(НРегЦвет, "green") > 0 ИЛИ Найти(НРегЦвет, "зелен") > 0 Тогда
        Возврат "#388e3c";
    Иначе
        Возврат "#607d8b";
    КонецЕсли;
КонецФункции

