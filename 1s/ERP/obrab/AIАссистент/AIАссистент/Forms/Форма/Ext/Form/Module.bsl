&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьСписокВыбораПровайдеров();
	ЗаполнитьСписокВыбораЗадач();
	
	Если НЕ ЗначениеЗаполнено(Задача) Тогда
		Задача = "full";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Провайдер) Тогда
		СписокМоделейСтруктура = МоделиLLM(Провайдер);
		ЗаполнитьСписокВыбораМодели(СоздатьСписокЗначенийИзКлючейСтруктуры(СписокМоделейСтруктура));
		ЗаполнитьСписокВыбораМоделиVL(СоздатьСписокЗначенийИзКлючейСтруктуры(СписокМоделейСтруктура));
	КонецЕсли;
	
	// Установить заголовок по умолчанию
	ОбновитьЗаголовокHTML();
КонецПроцедуры

