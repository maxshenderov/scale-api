&НаКлиенте
Процедура ОбновитьЗаголовокHTML()
	// Получить название задачи из списка
	СписокЗадач = Элементы.Задача.СписокВыбора;
	ЭлементСписка = СписокЗадач.НайтиПоЗначению(Задача);
	Если ЭлементСписка <> Неопределено Тогда
		ЗаголовокЗадачи = ЭлементСписка.Представление;
	Иначе
		ЗаголовокЗадачи = "Анализ заказа";
	КонецЕсли;
	
	// Обновить h1 в HTML-документе (с проверкой загрузки)
	Попытка
		Если Элементы.htmlЗаказ.Документ <> Неопределено Тогда
			ТекстJS = "var h1 = document.querySelector('h1'); if(h1) h1.textContent = '" + ЗаголовокЗадачи + "';";
			Элементы.htmlЗаказ.Документ.defaultView.eval(ТекстJS);
		КонецЕсли;
	Исключение
		// Игнорируем ошибки - HTML может быть ещё не загружен
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовокHTMLПослеЗагрузки()
	ОтключитьОбработчикОжидания("ОбновитьЗаголовокHTMLПослеЗагрузки");
	ОбновитьЗаголовокHTML();
КонецПроцедуры

&НаКлиенте
Процедура АнализЗаказа(Команда)
     
    Попытка
        // Проверка: заказ выбран?
        Если Заказ.Пустая() Тогда
            Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Пожалуйста, выберите заказ для анализа");
            Возврат;
        КонецЕсли;
        
        // Информирование пользователя о начале анализа
        Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Анализ заказа " + Заказ + " в процессе...");
        
        // Вызов функции анализа с передачей выбранных провайдера, модели и задачи
        КодЗадачи = ?(ЗначениеЗаполнено(Задача), Задача, "full");
        РезультатHTML = ОтправитьЗапросАнализаЗаказа(Заказ, КодЗадачи, Провайдер, Модель);

        // Отображение результата в поле htmlЗаказ
        htmlЗаказ = РезультатHTML;
        
        // Обновить заголовок после загрузки HTML (с задержкой)
        ПодключитьОбработчикОжидания("ОбновитьЗаголовокHTMLПослеЗагрузки", 0.5, Истина);
        
        // Информирование пользователя об успехе
        Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Анализ заказа " + Заказ + " завершён успешно");
        
    Исключение
        ОписаниеОшибки = ОписаниеОшибки();
        Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Ошибка при анализе заказа: " + ОписаниеОшибки);
    КонецПопытки;
    
КонецПроцедуры

//+Лико m.shenderov 05.05.2026
// Получает тип анализа из параметров сеанса или возвращает значение по умолчанию
Функция ПолучитьТипАнализаИзПараметров()
    
    // Проверяем, есть ли параметр сеанса для типа анализа
    Если ПараметрыСеанса.Свойство("Лико_ТипАнализаЗаказа") Тогда
        ТипАнализа = ПараметрыСеанса.Лико_ТипАнализаЗаказа;
        Если НЕ ПустаяСтрока(ТипАнализа) Тогда
            Возврат ТипАнализа;
        КонецЕсли;
    КонецЕсли;
    
    // Значение по умолчанию
    Возврат "Полный";
    
КонецФункции

//+Лико m.shenderov 05.05.2026, обновлена 06.05.2026
// Отправляет запрос анализа заказа в LLM через AgentLoop и возвращает HTML-результат
&НаСервере
Функция ОтправитьЗапросАнализаЗаказа(ДокументСсылка, ТипАнализа = "full", ПровайдерИмя = Неопределено, МодельИмя = Неопределено) Экспорт
    
    Попытка
        Если ТипЗнч(ДокументСсылка) <> Тип("ДокументСсылка.ЗаказКлиента") Тогда
            Возврат ПолучитьОшибкуHTML("Ошибка: передана некорректная ссылка на заказ");
        КонецЕсли;
        
        Если ДокументСсылка.Пустая() Тогда
            Возврат ПолучитьОшибкуHTML("Ошибка: заказ не выбран");
        КонецЕсли;
        
        // Получаем параметры провайдера и модели
        ПровайдерыВсе = Провайдеры();
        Если ПровайдерИмя = Неопределено ИЛИ НЕ ПровайдерыВсе.Свойство(ПровайдерИмя) Тогда
            ПровайдерИмя = "Омниум"; // по умолчанию
        КонецЕсли;
        ПараметрыПровайдера = ПровайдерыВсе[ПровайдерИмя];
        
        // МодельID
        СтруктураМоделей = МоделиLLM(ПровайдерИмя);
        МодельID = "anthropic/claude-haiku-4.5"; // по умолчанию
        Если МодельИмя <> Неопределено Тогда
            ДанныеМодели = СтруктураМоделей.Получить(МодельИмя);
            Если ДанныеМодели <> Неопределено Тогда
                МодельID = ДанныеМодели.МодельID;
            КонецЕсли;
        КонецЕсли;
        ПараметрыПровайдера.Вставить("МодельID", МодельID);
        
        // Запускаем Agent Loop
        РезультатHTML = AgentLoop(ДокументСсылка, ТипАнализа, ПараметрыПровайдера);
        
        Возврат РезультатHTML;
        
    Исключение
        ОписаниеОшибки = ОписаниеОшибки();
        Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Ошибка при анализе заказа: " + ОписаниеОшибки);
        Возврат ПолучитьОшибкуHTML("Ошибка при анализе заказа: " + ОписаниеОшибки);
    КонецПопытки;
    
КонецФункции

