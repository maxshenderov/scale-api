// Рендерит секцию "Общая оценка": вердикт + полнота данных
&НаСервере
Функция СекцияОбщейОценки(Данные)
    Результат = "<h2>Общая оценка</h2>";
    
    // Вердикт — ключевой вывод с цветовой индикацией
    Если Данные.Свойство("verdict") Тогда
        КлассCSS = "verdict-conditional";
        Если Найти(НРег(Данные.verdict), "рентабел") > 0
           ИЛИ Найти(НРег(Данные.verdict), "эффектив") > 0
           ИЛИ Найти(НРег(Данные.verdict), "выполним") > 0 Тогда
            КлассCSS = "verdict-accept";
        ИначеЕсли Найти(НРег(Данные.verdict), "нерекоменд") > 0
                ИЛИ Найти(НРег(Данные.verdict), "отклон") > 0
                ИЛИ Найти(НРег(Данные.verdict), "невыполним") > 0 Тогда
            КлассCSS = "verdict-reject";
        КонецЕсли;
