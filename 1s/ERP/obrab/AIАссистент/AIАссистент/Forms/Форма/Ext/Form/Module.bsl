// Получает данные заказа для анализа в LLM
&НаСервере
Функция ПолучитьДанныеЗаказаДляАИ(ДокументСсылка) Экспорт
    
    Попытка
        // Получаем объект документа
        ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
        
        Если ДокументОбъект = Неопределено Тогда
            Возврат "";
        КонецЕсли;
        
        // Создаём структуру результата
        РезультатСтруктура = Новый Структура;
        РезультатСтруктура.Вставить("header", ПолучитьДанныеШапки(ДокументОбъект));
        РезультатСтруктура.Вставить("label", ПолучитьДанныеЭтикетки(ДокументОбъект));
        РезультатСтруктура.Вставить("production", ПолучитьДанныеПроизводства(ДокументОбъект));
        РезультатСтруктура.Вставить("colors", ПолучитьДанныеЦветов(ДокументСсылка));
        РезультатСтруктура.Вставить("costs", ПолучитьДанныеЗатрат(ДокументСсылка));
        РезультатСтруктура.Вставить("prod_params", ПолучитьДанныеПараметровПроизводства(ДокументСсылка));
        РезультатСтруктура.Вставить("metrics", ПолучитьДанныеМетрик(ДокументОбъект));
        РезультатСтруктура.Вставить("economics", ПолучитьДанныеЭкономики(ДокументОбъект));
        РезультатСтруктура.Вставить("quality", ПолучитьДанныеКачества(ДокументОбъект));
        
        // Очищаем структуру от несериализуемых типов и преобразуем в JSON
        ОчищеннаяСтруктура = ОчиститьСтруктуруДляJSON(РезультатСтруктура);
        
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, ОчищеннаяСтруктура);
        Возврат ЗаписьJSON.Закрыть();
        
    Исключение
        ОписаниеОшибки = ОписаниеОшибки();
        Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Ошибка при создании JSON: " + ОписаниеОшибки);
        Возврат "";
    КонецПопытки;
    
КонецФункции

//+Лико m.shenderov 05.05.2026
// Рекурсивно очищает значение от несериализуемых типов (ссылки, даты, УИД)
// для корректного преобразования в JSON
Функция ОчиститьСтруктуруДляJSON(Значение)
    
    Если ТипЗнч(Значение) = Тип("Структура") Тогда
        Результат = Новый Структура;
        Для Каждого КлючЗначение Из Значение Цикл
            Результат.Вставить(КлючЗначение.Ключ, ОчиститьСтруктуруДляJSON(КлючЗначение.Значение));
        КонецЦикла;
        Возврат Результат;
        
    ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
        Результат = Новый Массив;
        Для Каждого Элемент Из Значение Цикл
            Результат.Добавить(ОчиститьСтруктуруДляJSON(Элемент));
        КонецЦикла;
        Возврат Результат;
        
    ИначеЕсли ТипЗнч(Значение) = Тип("Строка") 
        ИЛИ ТипЗнч(Значение) = Тип("Число") 
        ИЛИ ТипЗнч(Значение) = Тип("Булево") 
        ИЛИ ТипЗнч(Значение) = Тип("Неопределено") Тогда
        Возврат Значение;
        
    ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
        Возврат Формат(Значение, "ДФ=ГГГГ-ММ-ДДЧЧ:мм:сс");
        
    Иначе
        // Любой другой тип (ссылки, УИД и т.д.) - преобразуем в строку
        Возврат Строка(Значение);
        
    КонецЕсли;
    
КонецФункции

