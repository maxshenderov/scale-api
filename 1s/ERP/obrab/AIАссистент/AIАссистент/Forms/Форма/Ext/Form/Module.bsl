		ИсточникЦветов = ?(Данные.payload.Свойство("colors_from_vision") И Данные.payload.colors_from_vision,
			" <span style='color:#58a6ff'>[из макета]</span>", "");
		HTML.Добавить("<h3 style='color:#a371f7'>Цвета (" + Данные.payload.colors_count + ")" + ИсточникЦветов + ":</h3>");
		HTML.Добавить("<table style='border-collapse:collapse;font-size:11px'>");
		HTML.Добавить("<tr style='background:#333'><th>#</th><th>Название</th><th>Тип</th><th>Краска</th><th>%</th><th>г/м2</th></tr>");
		Для Номер = 0 По Данные.payload.colors.Количество() - 1 Цикл
			Цвет = Данные.payload.colors[Номер];
			HTML.Добавить(СтрШаблон("<tr><td>%1</td><td>%2</td><td>%3</td><td>%4</td><td>%5</td><td>%6</td></tr>",
				Номер + 1, Цвет.name, Цвет.type, Цвет.ink_type, Цвет.fill_pct, Цвет.gsm));
		КонецЦикла;
		HTML.Добавить("</table>");
	КонецЕсли;

	// Основные параметры
	HTML.Добавить("<h3 style='color:#3fb950'>Параметры:</h3>");
	HTML.Добавить("<table style='border-collapse:collapse;font-size:11px'>");
	ПараметрыHTML = Новый Массив;

	// Вспомогательная функция получения значения с меткой источника
	ПолучитьЗначениеСИсточником = Новый Структура; // заглушка — ниже inline
	ПараметрыHTML.Добавить(СтрШаблон("<tr><td style='padding:2px 8px'>Тип заказа</td><td><b>%1</b></td></tr>",
		?(Данные.payload.Свойство("order_type") И ЗначениеЗаполнено(Данные.payload.order_type), Данные.payload.order_type, "-")));
	ПараметрыHTML.Добавить(СтрШаблон("<tr><td style='padding:2px 8px'>Тип этикетки</td><td><b>%1</b> %2</td></tr>",
		?(Данные.payload.Свойство("label_type") И ЗначениеЗаполнено(Данные.payload.label_type), Данные.payload.label_type, "-"),
		?(Данные.payload.Свойство("label_type_source") И Данные.payload.label_type_source = "vision", "<span style='color:#58a6ff'>[Vision]</span>", "")));
	//+Лико m.shenderov 13.05.2026
	// Текст этикетки из Vision
	Если Данные.payload.Свойство("label_text_source") И Данные.payload.label_text_source = "vision" Тогда
		БрендПл = ?(Данные.payload.Свойство("label_text_brand") И ЗначениеЗаполнено(Данные.payload.label_text_brand), Данные.payload.label_text_brand, "");
		ПродуктПл = ?(Данные.payload.Свойство("label_text_product") И ЗначениеЗаполнено(Данные.payload.label_text_product), Данные.payload.label_text_product, "");
		ОбъёмПл = ?(Данные.payload.Свойство("label_text_volume") И ЗначениеЗаполнено(Данные.payload.label_text_volume), Данные.payload.label_text_volume, "");
		ТекстЭтикеткиПл = СокрЛП(БрендПл + " " + ПродуктПл + " " + ОбъёмПл);
		ПараметрыHTML.Добавить(СтрШаблон("<tr><td style='padding:2px 8px'>📝 Текст этикетки</td><td><b>%1</b> <span style='color:#58a6ff'>[Vision]</span></td></tr>", ТекстЭтикеткиПл));
		Если Данные.payload.Свойство("label_text_full") И ЗначениеЗаполнено(Данные.payload.label_text_full) Тогда
			ПараметрыHTML.Добавить(СтрШаблон("<tr><td style='padding:2px 8px'>Full Text</td><td style='font-size:10px;color:#ce9178'>%1</td></tr>", Лев(Данные.payload.label_text_full, 300)));
		КонецЕсли;
	КонецЕсли;

	ПараметрыHTML.Добавить(СтрШаблон("<tr><td style='padding:2px 8px'>Категория</td><td><b>%1</b></td></tr>",
		?(Данные.payload.Свойство("product_category"), Данные.payload.product_category, "-")));
	ПараметрыHTML.Добавить(СтрШаблон("<tr><td style='padding:2px 8px'>Размер</td><td><b>%1×%2 мм</b> %3</td></tr>",
		Данные.payload.size_width_mm, Данные.payload.size_height_mm,
		?(Данные.payload.Свойство("size_source") И Данные.payload.size_source = "vision", "<span style='color:#58a6ff'>[Vision]</span>", "")));
	ПараметрыHTML.Добавить(СтрШаблон("<tr><td style='padding:2px 8px'>Форма</td><td><b>%1</b></td></tr>",
		?(Данные.payload.Свойство("label_shape") И ЗначениеЗаполнено(Данные.payload.label_shape), Данные.payload.label_shape, "-")));
	ПараметрыHTML.Добавить(СтрШаблон("<tr><td style='padding:2px 8px'>Технология</td><td><b>%1</b> %2</td></tr>",
		?(Данные.payload.Свойство("technology") И ЗначениеЗаполнено(Данные.payload.technology), Данные.payload.technology, "-"),
		?(Данные.payload.Свойство("technology_source") И Данные.payload.technology_source = "vision", "<span style='color:#58a6ff'>[Vision]</span>", "")));
	ПараметрыHTML.Добавить(СтрШаблон("<tr><td style='padding:2px 8px'>Материал</td><td><b>%1</b> %2</td></tr>",
		?(Данные.payload.Свойство("material") И ЗначениеЗаполнено(Данные.payload.material), Данные.payload.material, "-"),
		?(Данные.payload.Свойство("material_source") И Данные.payload.material_source = "vision", "<span style='color:#58a6ff'>[Vision]</span>", "")));
	ПараметрыHTML.Добавить(СтрШаблон("<tr><td style='padding:2px 8px'>Раскладка</td><td><b>%1×%2</b> (итого %3) %4</td></tr>",
		?(Данные.payload.Свойство("lanes_print"), Данные.payload.lanes_print, 0),
		?(Данные.payload.Свойство("labels_per_lane"), Данные.payload.labels_per_lane, 0),
		?(Данные.payload.Свойство("labels_per_sheet"), Данные.payload.labels_per_sheet, 0),
		?(Данные.payload.Свойство("layout_source") И Данные.payload.layout_source = "vision", "<span style='color:#58a6ff'>[Vision]</span>", "")));
	ПараметрыHTML.Добавить(СтрШаблон("<tr><td style='padding:2px 8px'>Рабочий центр</td><td><b>%1</b></td></tr>",
		?(Данные.payload.Свойство("work_center") И ЗначениеЗаполнено(Данные.payload.work_center), Данные.payload.work_center, "-")));
	ПараметрыHTML.Добавить(СтрШаблон("<tr><td style='padding:2px 8px'>Тираж</td><td><b>%1K шт</b></td></tr>",
		Данные.payload.circulation_thousands));
	ПараметрыHTML.Добавить(СтрШаблон("<tr><td style='padding:2px 8px'>Отделка</td><td>Лам=%1 Тисн=%2 Трафар=%3 Лак=%4 Фольга=%5</td></tr>",
		Данные.payload.has_lamination, Данные.payload.has_embossing,
		Данные.payload.has_screen,
		?(Данные.payload.Свойство("has_varnish"), Данные.payload.has_varnish, "-"),
		?(Данные.payload.Свойство("has_foil"), Данные.payload.has_foil, "-")));
	HTML.Добавить(СтрСоединить(ПараметрыHTML, ""));
	HTML.Добавить("</table>");
	HTML.Добавить("</body></html>");
	htmlЗаказ = СтрСоединить(HTML, "");

	Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Данные индексации сформированы");
КонецПроцедуры

