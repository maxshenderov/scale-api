// Рендерит структурированный JSON анализа в HTML
&НаСервере
Функция JSON_Анализа_в_HTML(ДанныеJSON, КодЗадачи) Экспорт
    Если КодЗадачи = "educational" Тогда
        Возврат JSON_Обучения_в_HTML(ДанныеJSON);
    КонецЕсли;

    // Если JSON имеет структуру {order_analysis: {...}}, извлечём order_analysis
    Анализ = ДанныеJSON;
    Если ДанныеJSON.Свойство("order_analysis") Тогда
        Анализ = ДанныеJSON.order_analysis;
    КонецЕсли;

    HTML = Новый Массив;
    HTML.Добавить(СтилиHTML());
    
    // === ЗАГОЛОВОК С ЛОГОТИПОМ ОКИЛ ===
    ЗаголовокЗадачи = "Комплексный анализ";
    Если ДанныеJSON.Свойство("task_name") Тогда
        ЗаголовокЗадачи = ДанныеJSON.task_name;
    ИначеЕсли ДанныеJSON.Свойство("order_analysis") И ДанныеJSON.order_analysis.Свойство("task_name") Тогда
        ЗаголовокЗадачи = ДанныеJSON.order_analysis.task_name;
    КонецЕсли;
    
    HTML.Добавить("<div style='display: flex; justify-content: flex-end; align-items: center; margin-bottom: 20px; padding-right: 20px;'>");
    HTML.Добавить("<img src='https://okil.ru/assets/images/des/okil-sato-rus-2.svg' alt='ОКИЛ-САТО' style='height: 20px;'>");
    HTML.Добавить("</div>");
    HTML.Добавить("<div style='margin-bottom: 30px;'>");
    HTML.Добавить("<h1 style='background: transparent; font-size: 24px; margin: 0;'>" + ЗаголовокЗадачи + "</h1>");
    HTML.Добавить("</div>");

    // === АНАЛИТИКА ===
    Если Анализ.Свойство("verdict") Тогда
        HTML.Добавить(СекцияВердикта(Анализ.verdict));
    КонецЕсли;
    Если Анализ.Свойство("risks") Тогда
        HTML.Добавить(СекцияРисков(Анализ.risks));
    КонецЕсли;
    Если Анализ.Свойство("technology") Тогда
        HTML.Добавить(СекцияТехнологии(Анализ.technology));
    КонецЕсли;
    Если Анализ.Свойство("timeline") Тогда
        HTML.Добавить(СекцияТаймлайна(Анализ.timeline));
    КонецЕсли;
    Если Анализ.Свойство("economics") Тогда
        HTML.Добавить(СекцияЭкономики(Анализ.economics));
    КонецЕсли;
    Если Анализ.Свойство("economics_analysis") Тогда
        HTML.Добавить(СекцияЭкономическогоАнализа(Анализ.economics_analysis));
    КонецЕсли;
    Если Анализ.Свойство("technology_analysis") Тогда
        HTML.Добавить(СекцияТехнологическогоАнализа(Анализ.technology_analysis));
    КонецЕсли;
    Если Анализ.Свойство("overall_assessment") Тогда
        HTML.Добавить(СекцияОбщейОценки(Анализ.overall_assessment));
    КонецЕсли;
    Если Анализ.Свойство("resources") Тогда
        HTML.Добавить(СекцияРесурсов(Анализ.resources));
    КонецЕсли;
    Если Анализ.Свойство("quality_checkpoints") Тогда
        HTML.Добавить(СекцияКачества(Анализ.quality_checkpoints));
    КонецЕсли;

    // Добавить все остальные секции универсально (кроме исходных данных)
    HTML.Добавить(РендеритьВсеДанные(Анализ));

    // === СХЕМА МАШИНЫ С СЕКЦИЯМИ ===
    Если Анализ.Свойство("technology") Тогда
        HTML.Добавить(СекцияСхемыМашины(Анализ.technology));
    КонецЕсли;

    // === ИСХОДНЫЕ ДАННЫЕ ИЗ 1С (в конце, компактно) ===
    Если Анализ.Свойство("исходные_данные") Тогда
        ИсхДанные = Анализ.исходные_данные;
        HTML.Добавить("<hr style='margin: 30px 0 20px; border: 1px solid #d6e8f5;'>");
        HTML.Добавить("<h2>Исходные данные заказа</h2>");
        HTML.Добавить("<p style='color: #5a7a95; font-size: 13px; margin-bottom: 12px;'>Эти данные уже есть в 1С — приведены для справки.</p>");
        Если ТипЗнч(ИсхДанные) = Тип("Структура") Тогда
            HTML.Добавить(РендеритьСтруктуруКакТаблицу(ИсхДанные));
        Иначе
            HTML.Добавить(РендеритьЗначениеРекурсивно(ИсхДанные));
        КонецЕсли;
    КонецЕсли;

    HTML.Добавить("</body></html>");
    Возврат СтрСоединить(HTML, "");
КонецФункции

//+Лико m.shenderov 06.05.2026
&НаСервере
Функция РендеритьВсеДанные(Анализ)
    // Универсальный рендерер для всех данных структуры Анализ
    Результат = "";
    
    // Список известных секций (уже обработаны выше)
    ОбработанныеСекции = Новый Соответствие;
    ОбработанныеСекции.Вставить("verdict", Истина);
    ОбработанныеСекции.Вставить("risks", Истина);
    ОбработанныеСекции.Вставить("technology", Истина);
    ОбработанныеСекции.Вставить("timeline", Истина);
    ОбработанныеСекции.Вставить("economics", Истина);
    ОбработанныеСекции.Вставить("economics_analysis", Истина);
    ОбработанныеСекции.Вставить("technology_analysis", Истина);
    ОбработанныеСекции.Вставить("overall_assessment", Истина);
    ОбработанныеСекции.Вставить("resources", Истина);
    ОбработанныеСекции.Вставить("quality_checkpoints", Истина);
    ОбработанныеСекции.Вставить("исходные_данные", Истина);
    ОбработанныеСекции.Вставить("order_analysis", Истина);
    
    // Получить все свойства структуры
    Для Каждого Свойство Из Анализ Цикл
        Ключ = Свойство.Ключ;
        Значение = Свойство.Значение;
        
        // Пропустить уже обработанные секции
        Если ОбработанныеСекции.Получить(Ключ) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        
        // Рендерить оставшиеся данные
        Результат = Результат + РендеритьСекцию(Ключ, Значение);
    КонецЦикла;
    
    Возврат Результат;
КонецФункции

//+Лико m.shenderov 06.05.2026
&НаСервере
Функция РендеритьСекцию(НазваниеСекции, Данные)
    // Универсальный рекурсивный рендерер для любой секции
    Результат = "";
    
    // Преобразовать название в русский
    РусскоеНазвание = ПреобразоватьНазваниеВРусский(НазваниеСекции);
    
    // Заменяем подчёркивания на пробелы (на случай если ключ не в маппинге)
    РусскоеНазвание = СтрЗаменить(РусскоеНазвание, "_", " ");
    
    // Сначала рендерим заголовок
    Результат = "<h2>" + РусскоеНазвание + "</h2>";
    
    Если ТипЗнч(Данные) = Тип("Структура") Тогда
        // Это структура - рендерить как таблицу с рекурсивной обработкой значений
        Результат = Результат + РендеритьСтруктуруКакТаблицу(Данные);
    ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
        // Это массив - проверить, из чего он состоит
        Если Данные.Количество() > 0 Тогда
            ПервыйЭлемент = Данные[0];
            Если ТипЗнч(ПервыйЭлемент) = Тип("Структура") Тогда
                // Массив структур - рендерить как таблицу с заголовками из ключей
                Результат = Результат + РендеритьМассивСтруктурКакТаблицу(Данные);
            Иначе
                // Массив простых значений - рендерить как список
                Результат = Результат + "<ul>";
                Для Каждого Элемент Из Данные Цикл
                    ЗначениеСтр = РендеритьЗначениеРекурсивно(Элемент);
                    Результат = Результат + "<li>" + ЗначениеСтр + "</li>";
                КонецЦикла;
                Результат = Результат + "</ul>";
            КонецЕсли;
        КонецЕсли;
    Иначе
        // Это простое значение - рендерить как параграф
        ЗначениеСтр = ПреобразоватьЗначениеВСтроку(Данные);
        Результат = Результат + "<p>" + ЗначениеСтр + "</p>";
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

//+Лико m.shenderov 06.05.2026, обновлена 07.05.2026
// Рендерит структуру как карточки (kv-card) для простых значений + вложенные подсекции для сложных
&НаСервере
Функция РендеритьСтруктуруКакТаблицу(Данные, Отступ = 0)
    // Разделяем простые и сложные значения
    Простые = Новый Соответствие;
    Сложные = Новый Соответствие;
    
    Для Каждого Пара Из Данные Цикл
        Ключ = Пара.Ключ;
        Значение = Пара.Значение;
        
        Если Значение = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        
        ТипЗн = ТипЗнч(Значение);
        Если ТипЗн = Тип("Структура") ИЛИ ТипЗн = Тип("Массив") Тогда
            Сложные.Вставить(Ключ, Значение);
        Иначе
            Простые.Вставить(Ключ, Значение);
        КонецЕсли;
    КонецЦикла;
    
    Результат = "";
    
    // Простые значения — стильная карточка-грид
    Если Простые.Количество() > 0 Тогда
        КлассКарточки = ?(Отступ > 0, "kv-card nested-card", "kv-card");
        Результат = Результат + "<div class='" + КлассКарточки + "'>";
        Для Каждого Пара Из Простые Цикл
            Ключ = Пара.Ключ;
            Значение = Пара.Значение;
            РусскийКлюч = ПреобразоватьНазваниеВРусский(Ключ);
            ЗначениеСтр = ПреобразоватьЗначениеВСтроку(Значение);
            КлассЗнач = ?(ТипЗнч(Значение) = Тип("Число"), "kv-value number", "kv-value");
            Результат = Результат + "<div class='kv-row'><span class='kv-key'>" + РусскийКлюч + "</span><span class='" + КлассЗнач + "'>" + ЗначениеСтр + "</span></div>";
        КонецЦикла;
        Результат = Результат + "</div>";
    КонецЕсли;
    
    // Сложные значения — каждая со своим подзаголовком
    Для Каждого Пара Из Сложные Цикл
        Ключ = Пара.Ключ;
        Значение = Пара.Значение;
        РусскийКлюч = ПреобразоватьНазваниеВРусский(Ключ);
        Результат = Результат + "<h4>" + РусскийКлюч + "</h4>";
        Результат = Результат + РендеритьЗначениеРекурсивно(Значение);
    КонецЦикла;
    
    Возврат Результат;
КонецФункции

//+Лико m.shenderov 06.05.2026
// Рендерит массив структур как HTML-таблицу с авто-заголовками
&НаСервере
Функция РендеритьМассивСтруктурКакТаблицу(Данные)
    Если Данные.Количество() = 0 Тогда
        Возврат "";
    КонецЕсли;
    
    // Собрать все уникальные ключи из всех элементов
    ВсеКлючи = Новый Массив;
    КлючиУже = Новый Соответствие;
    Для Каждого Элемент Из Данные Цикл
        Если ТипЗнч(Элемент) = Тип("Структура") Тогда
            Для Каждого Пара Из Элемент Цикл
                Если КлючиУже.Получить(Пара.Ключ) = Неопределено Тогда
                    ВсеКлючи.Добавить(Пара.Ключ);
                    КлючиУже.Вставить(Пара.Ключ, Истина);
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    
    // Рендерить заголовки таблицы
    Результат = "<table><tr>";
    Для Каждого Ключ Из ВсеКлючи Цикл
        РусскийКлюч = ПреобразоватьНазваниеВРусский(Ключ);
        Результат = Результат + "<th>" + РусскийКлюч + "</th>";
    КонецЦикла;
    Результат = Результат + "</tr>";
    
    // Рендерить строки
    Для Каждого Элемент Из Данные Цикл
        Если ТипЗнч(Элемент) = Тип("Структура") Тогда
            Результат = Результат + "<tr>";
            Для Каждого Ключ Из ВсеКлючи Цикл
                Если Элемент.Свойство(Ключ) Тогда
                    ЗначениеHTML = РендеритьЗначениеРекурсивно(Элемент[Ключ]);
                    // Цветной фон для колонки "Цвет"
                    РусскийКлюч = ПреобразоватьНазваниеВРусский(Ключ);
                    Если РусскийКлюч = "Цвет" ИЛИ Ключ = "color" ИЛИ Ключ = "цвет" Тогда
                        ЦветКод = ОпределитьЦветПоНазванию(Элемент[Ключ]);
                        ЦветТекста = ОпределитьКонтрастныйЦвет(ЦветКод);
                        Результат = Результат + "<td style='background-color: " + ЦветКод + "; color: " + ЦветТекста + "; font-weight: 600;'>" + ЗначениеHTML + "</td>";
                    Иначе
                        Результат = Результат + "<td>" + ЗначениеHTML + "</td>";
                    КонецЕсли;
                Иначе
                    Результат = Результат + "<td></td>";
                КонецЕсли;
            КонецЦикла;
            Результат = Результат + "</tr>";
        КонецЕсли;
    КонецЦикла;
    
    Результат = Результат + "</table>";
    Возврат Результат;
КонецФункции

//+Лико m.shenderov 06.05.2026, обновлена 07.05.2026
// Рекурсивно рендерит любое значение (строку, число, булево, структуру, массив) в HTML
&НаСервере
Функция РендеритьЗначениеРекурсивно(Значение)
    Если Значение = Неопределено Тогда
        Возврат "";
    ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
        // Вложенная структура — разложить на карточки
        Возврат РендеритьСтруктуруКакТаблицу(Значение, 1);
    ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
        Если Значение.Количество() = 0 Тогда
            Возврат "<span class='badge badge-info'>пусто</span>";
        КонецЕсли;
        ПервыйЭлемент = Значение[0];
        Если ТипЗнч(ПервыйЭлемент) = Тип("Структура") Тогда
            // Массив структур — стильная таблица
            Возврат РендеритьМассивСтруктурКакТаблицу(Значение);
        ИначеЕсли ТипЗнч(ПервыйЭлемент) = Тип("Массив") ИЛИ ТипЗнч(ПервыйЭлемент) = Тип("Строка") Тогда
            // Массив строк — маркированный список
            Результат = "<ul>";
            Для Каждого Элемент Из Значение Цикл
                Результат = Результат + "<li>" + РендеритьЗначениеРекурсивно(Элемент) + "</li>";
            КонецЦикла;
            Результат = Результат + "</ul>";
            Возврат Результат;
        ИначеЕсли ТипЗнч(ПервыйЭлемент) = Тип("Число") Тогда
            // Массив чисел — через запятую
            Числа = Новый Массив;
            Для Каждого Ч Из Значение Цикл
                Числа.Добавить(Формат(Ч, "ЧЦ=15; ЧДЦ=2; ЧРГ='.'"));
            КонецЦикла;
            Возврат "<span class='num'>" + СтрСоединить(Числа, ", ") + "</span>";
        ИначеЕсли ТипЗнч(ПервыйЭлемент) = Тип("Булево") Тогда
            Значки = Новый Массив;
            Для Каждого Б Из Значение Цикл
                Значки.Добавить(?(Б, "✅ Да", "❌ Нет"));
            КонецЦикла;
            Возврат СтрСоединить(Значки, ", ");
        Иначе
            // Смешанный массив — маркированный список
            Результат = "<ul>";
            Для Каждого Элемент Из Значение Цикл
                Результат = Результат + "<li>" + РендеритьЗначениеРекурсивно(Элемент) + "</li>";
            КонецЦикла;
            Результат = Результат + "</ul>";
            Возврат Результат;
        КонецЕсли;
    ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
        Возврат ?(Значение, "<span class='badge badge-success'>Да</span>", "<span class='badge badge-warning'>Нет</span>");
    ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
        Возврат "<span class='num'>" + Формат(Значение, "ЧЦ=15; ЧДЦ=2; ЧРГ='.'") + "</span>";
    Иначе
        // Строка или другое простое значение
        Возврат ПреобразоватьЗначениеВСтроку(Значение);
    КонецЕсли;
КонецФункции

//+Лико m.shenderov 06.05.2026
&НаСервере
