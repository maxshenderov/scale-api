// Простая кнопка для тестирования Phase1 - читает файл на клиенте, отправляет на Docling через сервер
&НаКлиенте
Процедура ПроверитьPhase1(Команда) Экспорт

	МассивФайлов = Новый Массив;

	Если ЗначениеЗаполнено(МассивПутейМакетов) И МассивПутейМакетов.Количество() > 0 Тогда
		Для Каждого Путь Из МассивПутейМакетов Цикл
			ИнфоФайла = Новый Структура;
			ИнфоФайла.Вставить("ПутьКФайлу", Путь);
			МассивФайлов.Добавить(ИнфоФайла);
		КонецЦикла;
	Иначе
		Сообщить("Укажите файлы макетов (кнопка ""..."" справа)");
		Возврат;
	КонецЕсли;

	// Формируем HTML-ответ (единый формат с ИзвлечьПараметрыМакета и PyMuPDF)
	HTML = Новый Массив;
	HTML.Добавить("<html><head><style>
	|body { font-family: 'Segoe UI', sans-serif; margin: 10px; background: #1e1e1e; color: #d4d4d4; }
	|h2 { color: #569cd6; margin-top: 15px; }
	|.header { color: #4ec9b0; font-size: 16px; margin-bottom: 10px; }
	|.json-block { background: #2d2d2d; border: 1px solid #3e3e3e; border-radius: 6px; padding: 12px; margin: 10px 0; font-family: 'Consolas', monospace; font-size: 12px; white-space: pre-wrap; word-break: break-all; max-height: 400px; overflow: auto; }
	|.info { color: #ce9178; font-size: 13px; }
	|.success { color: #6a9955; }
	|.error { color: #f44747; }
	|.file-header { color: #dcdcaa; font-size: 15px; margin-top: 20px; }
	|.text-block { background: #2d2d2d; border: 1px solid #3e3e3e; border-radius: 6px; padding: 12px; margin: 10px 0; font-family: 'Consolas', monospace; font-size: 11px; white-space: pre-wrap; word-break: break-all; max-height: 300px; overflow: auto; color: #ce9178; }
	|</style></head><body>");

	HTML.Добавить("<div class='header'>📋 Анализ Docling Phase1 (" + МассивФайлов.Количество() + " файлов)</div>");
	HTML.Добавить("<div class='info'>⚙️ Движок: Docling — парсинг PDF/DOCX/изображений</div>");

	Для НомерФайла = 0 По МассивФайлов.Количество() - 1 Цикл
		Инфо = МассивФайлов[НомерФайла];
		НомерДляПользователя = НомерФайла + 1;
		ПутьКФайлу = Инфо.ПутьКФайлу;

		Попытка
			// Inline-разбор пути (ИзвлечьИмяИРасширение — серверная, XDTO не проходит кириллицу)
			ИмяФайлаКлиент = "";
			РасширениеФайлаКлиент = "";
			ПозСлеш = СтрНайти(ПутьКФайлу, "\", НаправлениеПоиска.СКонца);
			Если ПозСлеш = 0 Тогда
				ПозСлеш = СтрНайти(ПутьКФайлу, "/", НаправлениеПоиска.СКонца);
			КонецЕсли;
			Если ПозСлеш > 0 Тогда
				ИмяСРасширением = Сред(ПутьКФайлу, ПозСлеш + 1);
			Иначе
				ИмяСРасширением = ПутьКФайлу;
			КонецЕсли;
			ПозТочка = СтрНайти(ИмяСРасширением, ".", НаправлениеПоиска.СКонца);
			Если ПозТочка > 0 Тогда
				ИмяФайлаКлиент = Лев(ИмяСРасширением, ПозТочка - 1);
				РасширениеФайлаКлиент = НРег(Сред(ИмяСРасширением, ПозТочка + 1));
			Иначе
				ИмяФайлаКлиент = ИмяСРасширением;
			КонецЕсли;

			Если НЕ ЗначениеЗаполнено(РасширениеФайлаКлиент) Тогда
				HTML.Добавить("<div class='file-header'>⚠️ Файл #" + НомерДляПользователя + ": без расширения или папка</div>");
				Продолжить;
			КонецЕсли;

			// Проверяем расширение
			ДопустимыеРасширения = "pdf,jpg,jpeg,png,docx,txt";
			Если Найти(ДопустимыеРасширения, РасширениеФайлаКлиент) = 0 Тогда
				HTML.Добавить("<div class='file-header'><span class='error'>❌ Файл #" + НомерДляПользователя + ": недопустимый тип '" + РасширениеФайлаКлиент + "'</span></div>");
				Продолжить;
			КонецЕсли;

			// Читаем двоичные данные на клиенте
			ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПутьКФайлу);
			РазмерФайла = ДвоичныеДанныеФайла.Размер();

			// Передаём на сервер для обработки Docling Phase1
			Результат = ПроверитьPhase1НаСервере(ДвоичныеДанныеФайла, ИмяФайлаКлиент, РасширениеФайлаКлиент);

			Если НЕ Результат.Успех Тогда
				HTML.Добавить("<div class='file-header'><span class='error'>❌ Файл #" + НомерДляПользователя + ": " + Результат.ОписаниеОшибки + "</span></div>");
				Продолжить;
			КонецЕсли;

			// Заголовок файла
			HTML.Добавить("<div class='file-header'>📄 Файл #" + НомерДляПользователя + ": " + Результат.ИмяФайла + " (." + Результат.ТипФайла + ", " + Формат(РазмерФайла, "ЧГ=0") + " байт)</div>");

			// Блок с метаданными
			HTML.Добавить("<div class='json-block'>");
			HTML.Добавить("  Движок: Docling (Phase1)");
			HTML.Добавить("  Тип файла: " + Результат.ТипФайла);
			HTML.Добавить("  Confidence: " + Формат(Результат.Confidence * 100, "ЧЦ=0") + "%");
			HTML.Добавить("  Размер текста: " + Формат(СтрДлина(Результат.Текст), "ЧГ=0") + " символов");
			HTML.Добавить("</div>");

			// Блок с текстом
			Если ЗначениеЗаполнено(Результат.Текст) Тогда
				HTML.Добавить("<div style='color:#4ec9b0;font-size:13px;margin-top:8px'>📝 Извлечённый текст:</div>");
				ТекстДляHTML = Результат.Текст;
				ТекстДляHTML = СтрЗаменить(ТекстДляHTML, "<", "&" + "lt;");
				ТекстДляHTML = СтрЗаменить(ТекстДляHTML, ">", "&" + "gt;");
				HTML.Добавить("<div class='text-block'>" + ТекстДляHTML + "</div>");
			Иначе
				HTML.Добавить("<div class='info'>⚠️ Текст не извлечён</div>");
			КонецЕсли;

			// Таблицы
			Если Результат.Таблицы.Количество() > 0 Тогда
				HTML.Добавить("<div style='color:#4ec9b0;font-size:13px;margin-top:8px'>📊 Найдено таблиц: " + Результат.Таблицы.Количество() + "</div>");
				Для ИндТаблицы = 0 По Результат.Таблицы.Количество() - 1 Цикл
					Таблица = Результат.Таблицы[ИндТаблицы];
					HTML.Добавить("<div class='json-block'>Таблица #" + (ИндТаблицы + 1) + ":");
					Если Таблица.Свойство("content") Тогда
						Содержимое = Таблица["content"];
						Содержимое = СтрЗаменить(Содержимое, "<", "&" + "lt;");
						Содержимое = СтрЗаменить(Содержимое, ">", "&" + "gt;");
						HTML.Добавить(Содержимое);
					КонецЕсли;
					HTML.Добавить("</div>");
				КонецЦикла;
			КонецЕсли;

			// Изображения
			Если Результат.Изображения.Количество() > 0 Тогда
				HTML.Добавить("<div style='color:#4ec9b0;font-size:13px;margin-top:8px'>🖼️ Найдено изображений: " + Результат.Изображения.Количество() + "</div>");
			КонецЕсли;

		Исключение
			HTML.Добавить("<div class='file-header'><span class='error'>❌ Файл #" + НомерДляПользователя + ": " + ОписаниеОшибки() + "</span></div>");
		КонецПопытки;
	КонецЦикла;

	Окончание = ?(МассивФайлов.Количество() = 1, "файл", "файлов");
	HTML.Добавить("<div class='info' style='margin-top:15px'>📊 Обработано " + МассивФайлов.Количество() + " " + Окончание + " (Docling Phase1)</div>");
	HTML.Добавить("</body></html>");
	htmlЗаказ = СтрСоединить(HTML, "");

КонецПроцедуры

//+Лико m.shenderov 13.05.2026
// Серверная функция: принимает ДВОИЧНЫЕ ДАННЫЕ (файл уже прочитан на клиенте)
&НаКлиенте
Функция ПроверитьPhase1НаСервере(ДвоичныеДанныеФайла, ИмяФайла, РасширениеФайла)
	
	Результат = Новый Структура("Успех,ОписаниеОшибки,ИмяФайла,ТипФайла,Confidence,Текст,Таблицы,Изображения", Ложь, "", "", "", 0, "", Новый Массив, Новый Массив);
	
	Попытка
		// Вызываем Phase1
		РезультатPhase1 = Фаза1ИзвлечьТекстМакеты(ДвоичныеДанныеФайла, РасширениеФайла, ИмяФайла);
		
		Если НЕ РезультатPhase1.Успех Тогда
			Результат.ОписаниеОшибки = РезультатPhase1.ОписаниеОшибки;
			Возврат Результат;
		КонецЕсли;
		
		Результат.Успех = Истина;
		Результат.ИмяФайла = ИмяФайла;
		Результат.ТипФайла = РезультатPhase1.ТипФайла;
		Результат.Confidence = РезультатPhase1.Confidence;
		Результат.Текст = РезультатPhase1.Текст;
		Результат.Таблицы = РезультатPhase1.Таблицы;
		Результат.Изображения = РезультатPhase1.Изображения;
		
	Исключение
		Результат.ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Вспомогательная функция: преобразование бинарных данных в текст
Функция ПолучитьТекстИзДвоичныхДанных(ДвоичныеДанные, Кодировка = "UTF-8")

	ПотокДанных = Новый ПотокВПамяти(ДвоичныеДанные);
	ЧтениеТекста = Новый ЧтениеТекста(ПотокДанных, Кодировка);
	Текст = ЧтениеТекста.ПрочитатьВсе();
	ЧтениеТекста.Закрыть();

	Возврат Текст;

КонецФункции

//+Лико m.shenderov 13.05.2026
// Кнопка для тестирования PyMuPDF+EasyOCR парсера (порт 8002) - для сравнения с Docling
//+Лико m.shenderov 13.05.2026
// Тест PyMuPDF+EasyOCR — выводит HTML в htmlЗаказ (единый формат с ИзвлечьПараметрыМакета)
&НаКлиенте
Процедура ПроверитьPyMuPDF(Команда) Экспорт

	МассивФайлов = Новый Массив;

	Если ЗначениеЗаполнено(МассивПутейМакетов) И МассивПутейМакетов.Количество() > 0 Тогда
		Для Каждого Путь Из МассивПутейМакетов Цикл
			ИнфоФайла = Новый Структура;
			ИнфоФайла.Вставить("ПутьКФайлу", Путь);
			МассивФайлов.Добавить(ИнфоФайла);
		КонецЦикла;
	Иначе
		Сообщить("Укажите файлы макетов (кнопка ""..."" справа)");
		Возврат;
	КонецЕсли;

	// Формируем HTML-ответ (единый формат с ИзвлечьПараметрыМакета)
	HTML = Новый Массив;
	HTML.Добавить("<html><head><style>
	|body { font-family: 'Segoe UI', sans-serif; margin: 10px; background: #1e1e1e; color: #d4d4d4; }
	|h2 { color: #569cd6; margin-top: 15px; }
	|.header { color: #4ec9b0; font-size: 16px; margin-bottom: 10px; }
	|.json-block { background: #2d2d2d; border: 1px solid #3e3e3e; border-radius: 6px; padding: 12px; margin: 10px 0; font-family: 'Consolas', monospace; font-size: 12px; white-space: pre-wrap; word-break: break-all; max-height: 400px; overflow: auto; }
	|.info { color: #ce9178; font-size: 13px; }
	|.success { color: #6a9955; }
	|.error { color: #f44747; }
	|.file-header { color: #dcdcaa; font-size: 15px; margin-top: 20px; }
	|.text-block { background: #2d2d2d; border: 1px solid #3e3e3e; border-radius: 6px; padding: 12px; margin: 10px 0; font-family: 'Consolas', monospace; font-size: 11px; white-space: pre-wrap; word-break: break-all; max-height: 300px; overflow: auto; color: #ce9178; }
	|</style></head><body>");

	HTML.Добавить("<div class='header'>🔬 Анализ PyMuPDF+EasyOCR (" + МассивФайлов.Количество() + " файлов)</div>");
	HTML.Добавить("<div class='info'>⚙️ Движок: PyMuPDF (PDF) + EasyOCR (JPG/PNG) — локально, бесплатно</div>");

	Для НомерФайла = 0 По МассивФайлов.Количество() - 1 Цикл
		Инфо = МассивФайлов[НомерФайла];
		НомерДляПользователя = НомерФайла + 1;
		ПутьКФайлу = Инфо.ПутьКФайлу;

		Попытка
			// Inline-разбор пути (ИзвлечьИмяИРасширение — серверная, XDTO не проходит кириллицу)
			ИмяФайлаКлиент = "";
			РасширениеФайлаКлиент = "";
			ПозСлеш = СтрНайти(ПутьКФайлу, "\", НаправлениеПоиска.СКонца);
			Если ПозСлеш = 0 Тогда
				ПозСлеш = СтрНайти(ПутьКФайлу, "/", НаправлениеПоиска.СКонца);
			КонецЕсли;
			Если ПозСлеш > 0 Тогда
				ИмяСРасширением = Сред(ПутьКФайлу, ПозСлеш + 1);
			Иначе
				ИмяСРасширением = ПутьКФайлу;
			КонецЕсли;
			ПозТочка = СтрНайти(ИмяСРасширением, ".", НаправлениеПоиска.СКонца);
			Если ПозТочка > 0 Тогда
				ИмяФайлаКлиент = Лев(ИмяСРасширением, ПозТочка - 1);
				РасширениеФайлаКлиент = НРег(Сред(ИмяСРасширением, ПозТочка + 1));
			Иначе
				ИмяФайлаКлиент = ИмяСРасширением;
			КонецЕсли;

			Если НЕ ЗначениеЗаполнено(РасширениеФайлаКлиент) Тогда
				HTML.Добавить("<div class='file-header'>⚠️ Файл #" + НомерДляПользователя + ": без расширения или папка</div>");
				Продолжить;
			КонецЕсли;

			// Проверяем расширение
			ДопустимыеРасширения = "pdf,jpg,jpeg,png,docx,txt";
			Если Найти(ДопустимыеРасширения, РасширениеФайлаКлиент) = 0 Тогда
				HTML.Добавить("<div class='file-header'><span class='error'>❌ Файл #" + НомерДляПользователя + ": недопустимый тип '" + РасширениеФайлаКлиент + "'</span></div>");
				Продолжить;
			КонецЕсли;

			// Читаем двоичные данные на клиенте
			ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПутьКФайлу);
			РазмерФайла = ДвоичныеДанныеФайла.Размер();

			// Передаём на сервер для обработки PyMuPDF+EasyOCR
			Результат = ПроверитьPyMuPDFНаСервере(ДвоичныеДанныеФайла, ИмяФайлаКлиент, РасширениеФайлаКлиент);

			Если НЕ Результат.Успех Тогда
				HTML.Добавить("<div class='file-header'><span class='error'>❌ Файл #" + НомерДляПользователя + ": " + Результат.ОписаниеОшибки + "</span></div>");
				Продолжить;
			КонецЕсли;

			// Заголовок файла
			HTML.Добавить("<div class='file-header'>📄 Файл #" + НомерДляПользователя + ": " + Результат.ИмяФайла + " (." + Результат.ТипФайла + ", " + Формат(РазмерФайла, "ЧГ=0") + " байт)</div>");

			// Блок с метаданными (единый формат)
			HTML.Добавить("<div class='json-block'>");
			HTML.Добавить("  Движок: " + Результат.Движок);
			HTML.Добавить("  Тип файла: " + Результат.ТипФайла);
			HTML.Добавить("  Confidence: " + Формат(Результат.Confidence * 100, "ЧЦ=0") + "%");
			HTML.Добавить("  Размер текста: " + Формат(СтрДлина(Результат.Текст), "ЧГ=0") + " символов");
			HTML.Добавить("</div>");

			// Блок с текстом
			Если ЗначениеЗаполнено(Результат.Текст) Тогда
				HTML.Добавить("<div style='color:#4ec9b0;font-size:13px;margin-top:8px'>📝 Извлечённый текст:</div>");
				// Экранируем HTML-сущности чтобы текст не ломал разметку
				ТекстДляHTML = Результат.Текст;
				ТекстДляHTML = СтрЗаменить(ТекстДляHTML, "<", "&" + "lt;");
				ТекстДляHTML = СтрЗаменить(ТекстДляHTML, ">", "&" + "gt;");
				HTML.Добавить("<div class='text-block'>" + ТекстДляHTML + "</div>");
			Иначе
				HTML.Добавить("<div class='info'>⚠️ Текст не извлечён</div>");
			КонецЕсли;

		Исключение
			HTML.Добавить("<div class='file-header'><span class='error'>❌ Файл #" + НомерДляПользователя + ": " + ОписаниеОшибки() + "</span></div>");
		КонецПопытки;
	КонецЦикла;

	Окончание = ?(МассивФайлов.Количество() = 1, "файл", "файлов");
	HTML.Добавить("<div class='info' style='margin-top:15px'>📊 Обработано " + МассивФайлов.Количество() + " " + Окончание + " (PyMuPDF+EasyOCR, бесплатно)</div>");
	HTML.Добавить("</body></html>");
	htmlЗаказ = СтрСоединить(HTML, "");

КонецПроцедуры

//+Лико m.shenderov 13.05.2026
// Серверная функция: отправляет файл на PyMuPDF+EasyOCR парсер (порт 8002)
&НаСервере
Функция ПроверитьPyMuPDFНаСервере(ДвоичныеДанныеФайла, ИмяФайла, РасширениеФайла)

	Результат = Новый Структура("Успех,ОписаниеОшибки,ИмяФайла,ТипФайла,Confidence,Текст,Движок", Ложь, "", "", "", 0, "", "");

	Если НЕ ЗначениеЗаполнено(ДвоичныеДанныеФайла) Тогда
		Результат.ОписаниеОшибки = "Бинарные данные не переданы";
		Возврат Результат;
	КонецЕсли;

	// Нормализация расширения файла
	РасширениеФайла = НРег(СокрЛ(РасширениеФайла));
	Если СтрНачинаетсяС(РасширениеФайла, ".") Тогда
		РасширениеФайла = Сред(РасширениеФайла, 2);
	КонецЕсли;

	Результат.ТипФайла = РасширениеФайла;
	Результат.ИмяФайла = ИмяФайла;

	Попытка

		// Конфигурация PyMuPDF+EasyOCR сервиса
		АдресСервиса = "it-programmer3";
		ПортСервиса = 8002;
		ПутьКAPI = "/api/parse-base64";
		ТаймаутСекунд = 120; // EasyOCR может работать медленно

		// Для TXT — простое чтение текста локально
		Если РасширениеФайла = "txt" Тогда
			Текст = ПолучитьТекстИзДвоичныхДанных(ДвоичныеДанныеФайла, "UTF-8");
			Результат.Успех = Истина;
			Результат.Текст = Текст;
			Результат.Confidence = 1.0;
			Результат.Движок = "txt-local";
			Возврат Результат;
		КонецЕсли;

		// Для DOCX — сообщение о необходимости парсера
		Если РасширениеФайла = "docx" Тогда
			Результат.ОписаниеОшибки = "DOCX пока не поддерживается PyMuPDF+EasyOCR парсером";
			Возврат Результат;
		КонецЕсли;

		// Проверяем доступность сервиса
		Попытка
			ПроверкаСоединения = Новый HTTPСоединение(АдресСервиса, ПортСервиса, , , , 5);
			ЗапросПроверки = Новый HTTPЗапрос("/health");
			ОтветПроверки = ПроверкаСоединения.ОтправитьДляОбработки(ЗапросПроверки);
		Исключение
			Результат.ОписаниеОшибки = СтрШаблон(
				"PyMuPDF+EasyOCR сервис недоступен на %1:%2. Ошибка: %3",
				АдресСервиса, ПортСервиса, ОписаниеОшибки()
			);
			Возврат Результат;
		КонецПопытки;

		// Формируем JSON с base64-кодированным файлом
		Base64Данные = Base64Строка(ДвоичныеДанныеФайла);

		ЗапросОбъект = Новый Структура;
		ЗапросОбъект.Вставить("file_base64", Base64Данные);
		ЗапросОбъект.Вставить("file_type", РасширениеФайла);
		ЗапросОбъект.Вставить("filename", ИмяФайла);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ЗапросОбъект);
		ТелоЗапроса = ЗаписьJSON.Закрыть();

		// Отправляем запрос
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json");

		HTTPСоединение = Новый HTTPСоединение(АдресСервиса, ПортСервиса, , , , ТаймаутСекунд);
		Запрос = Новый HTTPЗапрос(ПутьКAPI, Заголовки);
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);

		Ответ = HTTPСоединение.ОтправитьДляОбработки(Запрос);

		// Проверяем статус ответа
		Если Ответ.КодСостояния <> 200 Тогда
			ТелоОшибки = Ответ.ПолучитьТелоКакСтроку();
			Результат.ОписаниеОшибки = СтрШаблон(
				"PyMuPDF+EasyOCR вернул ошибку (код %1): %2",
				Ответ.КодСостояния,
				ТелоОшибки
			);
			Возврат Результат;
		КонецЕсли;

		// Парсим ответ JSON
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);

		// Извлекаем текст
		Если ДанныеОтвета.Свойство("text") Тогда
			ТекстИзФайла = ДанныеОтвета["text"];
			// Очистка от символов, недопустимых в XML (0x00-0x08, 0x0B, 0x0C, 0x0E-0x1F)
			// — иначе XDTO-сериализация падает при передаче на клиент
			ОчищенныйТекст = "";
			Для Поз = 1 По СтрДлина(ТекстИзФайла) Цикл
				КодСим = КодСимвола(ТекстИзФайла, Поз);
				// Разрешаем: табуляцию (9), перевод строки (13,10), все печатные (>31)
				Если КодСим = 9 ИЛИ КодСим = 10 ИЛИ КодСим = 13 ИЛИ КодСим > 31 Тогда
					ОчищенныйТекст = ОчищенныйТекст + Сред(ТекстИзФайла, Поз, 1);
				КонецЕсли;
			КонецЦикла;
			Результат.Текст = ОчищенныйТекст;
		КонецЕсли;

		// Confidence
		Если ДанныеОтвета.Свойство("confidence") Тогда
			Результат.Confidence = ДанныеОтвета["confidence"];
		Иначе
			Результат.Confidence = 0.85;
		КонецЕсли;

		// Движок
		ДанныеМета = Неопределено;
		Если ДанныеОтвета.Свойство("metadata", ДанныеМета) Тогда
			ДвижокЗнач = Неопределено;
			Если ДанныеМета.Свойство("engine", ДвижокЗнач) Тогда
				Результат.Движок = ДвижокЗнач;
			Иначе
				Результат.Движок = "unknown";
			КонецЕсли;
		Иначе
			Результат.Движок = "unknown";
		КонецЕсли;

		Результат.Успех = Истина;

	Исключение
		Результат.ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции
