// Вспомогательная функция: получить расширение файла
Функция ПолучитьРасширениеФайла(ПолноеИмя)
	ДлинаСтроки = СтрДлина(ПолноеИмя);
	Точка = 0;
	Для инд = ДлинаСтроки По 1 Цикл
		Если Сред(ПолноеИмя, инд, 1) = "." Тогда
			Точка = инд;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Точка > 0 Тогда
		Возврат Сред(ПолноеИмя, Точка + 1);
	КонецЕсли;
	Возврат "";
КонецФункции

//+Лико m.shenderov 13.05.2026
// Вспомогательная функция: получить имя файла (без пути)
Функция ПолучитьИмяФайла(ПолноеИмя)
	ДлинаСтроки = СтрДлина(ПолноеИмя);
	SlashПозиция = 0;
	
	Для инд = ДлинаСтроки По 1 Цикл
		ТекСимвол = Сред(ПолноеИмя, инд, 1);
		Если ТекСимвол = "\" ИЛИ ТекСимвол = "/" Тогда
			SlashПозиция = инд;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если SlashПозиция > 0 Тогда
		Возврат Сред(ПолноеИмя, SlashПозиция + 1);
	КонецЕсли;
	Возврат ПолноеИмя;
КонецФункции
// +Лико m.shenderov 13.05.2026
// ФАЗА 1: Извлечение текста из макета через Docling
// Отправляет PDF/JPG/PNG на локальный Docling сервис для парсинга текста
&НаСервере
Функция Фаза1ИзвлечьТекстМакеты(ДвоичныеДанные, РасширениеФайла, ИмяФайла = "") Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Текст", "");
	Результат.Вставить("Confidence", 0);
	Результат.Вставить("Изображения", Новый Массив);
	Результат.Вставить("Таблицы", Новый Массив);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("ТипФайла", "");

	Если НЕ ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		Результат.ОписаниеОшибки = "Бинарные данные не переданы";
		Возврат Результат;
	КонецЕсли;

	// Нормализация расширения файла
	РасширениеФайла = НРег(СокрЛ(РасширениеФайла));
	Если СтрНачинаетсяС(РасширениеФайла, ".") Тогда
		РасширениеФайла = Сред(РасширениеФайла, 2);
	КонецЕсли;

	// Поддерживаемые форматы
	ПоддерживаемыеФорматы = Новый Массив;
	ПоддерживаемыеФорматы.Добавить("pdf");
	ПоддерживаемыеФорматы.Добавить("jpg");
	ПоддерживаемыеФорматы.Добавить("jpeg");
	ПоддерживаемыеФорматы.Добавить("png");
	ПоддерживаемыеФорматы.Добавить("docx");
	ПоддерживаемыеФорматы.Добавить("txt");

	Если ПоддерживаемыеФорматы.Найти(РасширениеФайла) = Неопределено Тогда
		Результат.ОписаниеОшибки = СтрШаблон(
			"Неподдерживаемый формат файла: %1. Поддерживаемые: %2",
			РасширениеФайла,
			СтрСоединить(ПоддерживаемыеФорматы, ", ")
		);
		Возврат Результат;
	КонецЕсли;

	Результат.ТипФайла = РасширениеФайла;

	Попытка

		// Конфигурация Docling сервиса
		URLДокlingа = "http://it-programmer3:8001";
		ПутьКAPI = "/api/parse-base64";
		ТаймаутСекунд = 30;

		// Для TXT, DOCX — простое чтение текста локально
		Если РасширениеФайла = "txt" Тогда
			Текст = ПолучитьТекстИзДвоичныхДанных(ДвоичныеДанные, "UTF-8");
			Результат.Успех = Истина;
			Результат.Текст = Текст;
			Результат.Confidence = 1.0; // TXT всегда парсится идеально
			Возврат Результат;
		КонецЕсли;

		// Для DOCX — попытка простого извлечения (без полного парсинга)
		Если РасширениеФайла = "docx" Тогда
			// DOCX это ZIP — можно попытаться извлечь document.xml
			// Для простоты пока вернём сообщение о необходимости Docling сервиса
			Результат.ОписаниеОшибки = "DOCX требует Docling сервис (http://it-programmer3:8001)";
			Возврат Результат;
		КонецЕсли;

		// Для PDF/JPG/PNG — отправляем на Docling сервис
		// Проверяем доступность сервиса
		Попытка
			ПроверкаСоединения = Новый HTTPСоединение("it-programmer3", 8001, , , , , );
			Запрос = Новый HTTPЗапрос("/health");
			Ответ = ПроверкаСоединения.ОтправитьДляОбработки(Запрос);
		Исключение
			Результат.ОписаниеОшибки = СтрШаблон(
				"Docling сервис недоступен на %1:%2. Ошибка: %3",
				"it-programmer3", 8001, ОписаниеОшибки()
			);
			Возврат Результат;
		КонецПопытки;

		// Подготовка multipart/form-data запроса
		// 1С не имеет встроенной поддержки multipart, поэтому используем base64
		Base64Данные = Base64Строка(ДвоичныеДанные);

		// Формируем JSON с base64-кодированным файлом
		ЗапросОбъект = Новый Структура;
		ЗапросОбъект.Вставить("file_base64", Base64Данные);
		ЗапросОбъект.Вставить("file_type", РасширениеФайла);
		ЗапросОбъект.Вставить("filename", ИмяФайла);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ЗапросОбъект);
		ТелоЗапроса = ЗаписьJSON.Закрыть();

		// Отправляем запрос на Docling
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json");

		HTTPСоединение = Новый HTTPСоединение("it-programmer3", 8001, , , , ТаймаутСекунд);
		Запрос = Новый HTTPЗапрос(ПутьКAPI, Заголовки);
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);

		ОтветДокlings = HTTPСоединение.ОтправитьДляОбработки(Запрос);

		// Проверяем статус ответа
		Если ОтветДокlings.КодСостояния <> 200 Тогда
			ТелоОшибки = ОтветДокlings.ПолучитьТелоКакСтроку();
			Результат.ОписаниеОшибки = СтрШаблон(
				"Docling вернул ошибку (код %1): %2",
				ОтветДокlings.КодСостояния,
				ТелоОшибки
			);
			Возврат Результат;
		КонецЕсли;

		// Парсим ответ JSON
		ТелоОтвета = ОтветДокlings.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);

		// Извлекаем текст
		Если ДанныеОтвета.Свойство("text") Тогда
			Результат.Текст = ДанныеОтвета["text"];
		КонецЕсли;

		// Confidence
		Если ДанныеОтвета.Свойство("confidence") Тогда
			Результат.Confidence = ДанныеОтвета["confidence"];
		Иначе
			Результат.Confidence = 0.85; // Дефолт если не указан
		КонецЕсли;

		// Изображения (если есть)
		Если ДанныеОтвета.Свойство("images") И ТипЗнч(ДанныеОтвета["images"]) = Тип("Массив") Тогда
			Результат.Изображения = ДанныеОтвета["images"];
		КонецЕсли;

		// Таблицы (если есть)
		Если ДанныеОтвета.Свойство("tables") И ТипЗнч(ДанныеОтвета["tables"]) = Тип("Массив") Тогда
			Результат.Таблицы = ДанныеОтвета["tables"];
		КонецЕсли;

		Результат.Успех = Истина;

	Исключение

		Результат.ОписаниеОшибки = ОписаниеОшибки();

	КонецПопытки;

	Возврат Результат;

КонецФункции

