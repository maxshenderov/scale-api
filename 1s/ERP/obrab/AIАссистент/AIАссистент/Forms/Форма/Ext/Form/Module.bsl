    // PoC: Получение двоичных данных файла макета двумя способами
    //   Вариант 1 (из 1С): ADODB → SQL FileStore (как в ПоказатьКартинку)
    //   Вариант 2 (из папки): прямой путь к файлу
    //
    // Параметры (Структура):
    //   Способ - "FileStore" или "Папка"
    //   Для "FileStore": GUID_Объекта, GUID_Строки
    //   Для "Папка": ПутьКФайлу
    // Возвращает:
    //   Структура: ДвоичныеДанные, Расширение, ИмяФайла, Ошибка
    &НаКлиенте
    Функция ПолучитьДвоичныеДанныеФайлаМакетаДваСпособа(Параметры) Экспорт
    
    	Результат = Новый Структура;
    	Результат.Вставить("ДвоичныеДанные", Неопределено);
    	Результат.Вставить("Расширение", "");
    	Результат.Вставить("ИмяФайла", "");
    	Результат.Вставить("Ошибка", "");
    
    	Способ = "";
    	Если Параметры.Свойство("Способ") Тогда
    		Способ = Параметры.Способ;
    	КонецЕсли;
    
    	Если Способ = "Папка" Тогда
    		// Вариант 2: напрямую из файла на диске
    		Если НЕ Параметры.Свойство("ПутьКФайлу") ИЛИ НЕ ЗначениеЗаполнено(Параметры.ПутьКФайлу) Тогда
    			Результат.Ошибка = "Не указан путь к файлу";
    			Возврат Результат;
    		КонецЕсли;
    
    		Попытка
    			ИзвлечьИмяИРасширение(Параметры.ПутьКФайлу, Результат.ИмяФайла, Результат.Расширение);
    			Результат.ДвоичныеДанные = Новый ДвоичныеДанные(Параметры.ПутьКФайлу);
    			Возврат Результат;
    		Исключение
    			Результат.Ошибка = "Ошибка чтения файла: " + ОписаниеОшибки();
    			Возврат Результат;
    		КонецПопытки;
    
    	ИначеЕсли Способ = "FileStore" Тогда
    		// Вариант 1: ADODB → SQL FileStore
    		Если НЕ Параметры.Свойство("GUID_Объекта") ИЛИ НЕ Параметры.Свойство("GUID_Строки") Тогда
    			Результат.Ошибка = "Не указаны GUID_Объекта и/или GUID_Строки";
    			Возврат Результат;
    		КонецЕсли;
    
    		Если НЕ ЗначениеЗаполнено(Параметры.GUID_Объекта) ИЛИ НЕ ЗначениеЗаполнено(Параметры.GUID_Строки) Тогда
    			Результат.Ошибка = "GUID_Объекта или GUID_Строки пустые";
    			Возврат Результат;
    		КонецЕсли;
    
    		Если Параметры.Свойство("ИмяФайлаИсточник") И ЗначениеЗаполнено(Параметры.ИмяФайлаИсточник) Тогда
    			ИзвлечьИмяИРасширение(Параметры.ИмяФайлаИсточник, Результат.ИмяФайла, Результат.Расширение);
    		КонецЕсли;
    
    		Попытка
    			ПараметрыСоединения = Лико_ДополнительноКлиент.УстановитьСоединениеССервером();
    			Подключение = ПараметрыСоединения.ADOConnection;
    
    			Если Подключение = Неопределено Тогда
    				Результат.Ошибка = "Отсутствует подключение к SQL серверу";
    				Возврат Результат;
    			КонецЕсли;
    
    			Stream = Новый COMОбъект("ADODB.Stream");
    			Stream.Type = 1;  // binary
    			Stream.Open();
    
    			RecordSet = Новый COMОбъект("ADODB.RecordSet");
    			RecordSet.CursorLocation = 3;
    			RecordSet.LockType = 2;
    
    			ЗапросSQL = "SELECT Data FROM FileStore WHERE GUIDOM = '" + Параметры.GUID_Объекта + "' AND GUIDRow = '" + Параметры.GUID_Строки + "'";
    			RecordSet.Open(ЗапросSQL, Подключение);
    
    			Если RecordSet.RecordCount > 0 Тогда
    				RecordSet.MoveFirst();
    				Stream.Write(RecordSet.Fields("Data").Value);
    
    				ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
    				Stream.SaveToFile(ИмяВременногоФайла);
    
    				Stream.Close();
    				RecordSet.Close();
    				Лико_ДополнительноКлиент.ЗакрытьСоединениеССервером(ПараметрыСоединения);
    
    				Результат.ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
    
    				// Определяем расширение если ещё не определили
    				Если НЕ ЗначениеЗаполнено(Результат.Расширение) И Параметры.Свойство("ИмяФайлаИсточник") Тогда
    					ИзвлечьИмяИРасширение(Параметры.ИмяФайлаИсточник, Результат.ИмяФайла, Результат.Расширение);
    				КонецЕсли;
    
    				// Удаляем временный файл
    				Попытка
    					УдалитьФайлы(ИмяВременногоФайла);
    				Исключение
    				КонецПопытки;
    
    				Возврат Результат;
    			Иначе
    				Stream.Close();
    				RecordSet.Close();
    				Лико_ДополнительноКлиент.ЗакрытьСоединениеССервером(ПараметрыСоединения);
    				Результат.Ошибка = "Файл не найден в FileStore";
    				Возврат Результат;
    			КонецЕсли;
    
    		Исключение
    		Попытка
    		Если Stream <> Неопределено Тогда
    		Stream.Close();
    		КонецЕсли;
    		Если RecordSet <> Неопределено Тогда
    		RecordSet.Close();
    		КонецЕсли;
    		Лико_ДополнительноКлиент.ЗакрытьСоединениеССервером(ПараметрыСоединения);
    		Исключение
    		КонецПопытки;
    		
    		Результат.Ошибка = "Ошибка ADODB: " + ОписаниеОшибки();
    		Возврат Результат;
    		КонецПопытки;
    
    	Иначе
    		Результат.Ошибка = "Неверный способ. Допустимые: ""FileStore"" или ""Папка""";
    		Возврат Результат;
    	КонецЕсли;
    
    КонецФункции
    
