	Иначе
		HTML.Добавить("<div style='color:#888;margin-bottom:8px'>ℹ️ Индексация по данным документа (без Vision-анализа макета)</div>");
	КонецЕсли;

	HTML.Добавить("<h3 style='color:#d2991d'>Текст для эмбеддинга:</h3>");
	HTML.Добавить("<pre style='background:#2d2d2d;padding:10px;border-radius:5px;white-space:pre-wrap;font-size:11px'>" + Данные.text_for_embedding + "</pre>");

	// Цвета
	Если Данные.payload.Свойство("colors") И ТипЗнч(Данные.payload.colors) = Тип("Массив")
