    	Результат.Вставить("Стоимость", 0);
    
    	// Настройки по умолчанию
    	URLСервера = "aichat-okil-sato.kartochka.tech";
    	Порт = 443;
    	ПутьКAPI = "/api/v1/chat/completions";
    	КлючAPI = "sk-5ad444531ffa461a92ea0ddcd4f92a02";
    	МодельID = "openai/gpt-4o-mini";
    	МаксТокенов = 2000;
    	Температура = 0.1;
    
    	// Промпт по умолчанию — извлечение параметров макета
    	Промпт = "Ты — инженер-технолог типографии. Проанализируй изображение оригинал-макета этикетки и верни ТОЛЬКО JSON (без markdown, без комментариев, без обрамляющих ```).
    	|
    	|Извлеки параметры в строгой JSON-схеме:
    	|{
    	|  ""label"": {""width_mm"": null, ""height_mm"": null, ""shape"": null},
    	|  ""layout"": {""across"": null, ""along"": null, ""total_per_sheet"": null},
    	|  ""colors"": {""count"": null, ""list"": []},
    	|  ""finishing"": {""varnish"": null, ""foil"": null, ""embossing"": false},
    	|  ""content"": {""has_barcode"": false, ""barcode_type"": null, ""languages"": []},
    	|  ""label_text"": {""brand"": null, ""product_name"": null, ""volume_weight"": null, ""full_text"": null},
    	|  ""label_type"": null,
    	|  ""technology"": null,
    	|  ""material_hint"": null,
    	|  ""confidence"": 0.0
    	|}
    	|
    	|Правила:
    	|- label_type ОДИН из: ""СамоклеящаясяЭтикетка"", ""Термоусадка"", ""Упаковка"", ""Пакеты"", ""ВплавляемаяЭтикетка""
    	|- technology ОДИН из: ""Флексо"", ""Офсет"", ""Цифра"", ""Глубокая""
    	|- shape ОДИН из: ""rectangle"", ""rounded_rectangle"", ""circle"", ""oval""
    	|- varnish ОДИН из: ""glossy"", ""matte"" или null (если нет лака)
    	|- foil ОДИН из: ""gold"", ""silver"", ""holographic"" или null
    	|- layout.across = сколько этикеток в РЯДУ (ручьёв). Если видишь 2 одинаковые этикетки рядом — across=2
    	|- layout.along = сколько этикеток по ДЛИНЕ раппорта
    	|- layout.total_per_sheet = across × along (всего на листе)
    	|- Размеры в МИЛЛИМЕТРАХ. Если видишь размерную рамку с цифрами — это мм.
    	|- Если нет размерной рамки, НО задан ""known_size_mm"": используй его как референс. Вычисли второй размер по пропорциям изображения.
    	|- Если нет ни размерной рамки, ни known_size_mm — ищи штрих-код EAN-13 (37,3×25,9 мм) или QR как масштабную линейку.
    	|- Если всё равно не можешь определить размеры — ставь null и снижай confidence.
    	|- Pantone-коды в формате ""PANTONE 485 C"" или ""PMS 485""
    	|- НЕ придумывай — если не видишь/не уверен, ставь null и снижай confidence
    	|- label_text.brand: торговая марка/бренд этикетки (напр. ""Ceresit"", ""Pantene"", ""Henkel"")
    	|- label_text.product_name: название продукта (напр. ""CS 25 07 Gray"", ""Pro-V Объём и сила"")
    	|- label_text.volume_weight: объём/вес/количество на этикетке (напр. ""280 ml"", ""1 кг"", ""500 шт"")
    	|- label_text.full_text: ВЕСЬ видимый читаемый текст этикетки через "" | "" (не более 400 символов). Включи бренд, название, объём, назначение, состав если виден
    	|- Если в КОНТЕКСТЕ указано имя файла — используй его как ПОДСКАЗКУ для label_text, НО приоритет тому что ВИДИШЬ на изображении";
    
    	// Применяем пользовательские настройки
    	Если НастройкиЗапроса <> Неопределено Тогда
    		Если НастройкиЗапроса.Свойство("КлючAPI") И ЗначениеЗаполнено(НастройкиЗапроса.КлючAPI) Тогда
    			КлючAPI = НастройкиЗапроса.КлючAPI;
    		КонецЕсли;
    		Если НастройкиЗапроса.Свойство("МодельID") И ЗначениеЗаполнено(НастройкиЗапроса.МодельID) Тогда
    			МодельID = НастройкиЗапроса.МодельID;
    		КонецЕсли;
    		Если НастройкиЗапроса.Свойство("Промпт") И ЗначениеЗаполнено(НастройкиЗапроса.Промпт) Тогда
    			Промпт = НастройкиЗапроса.Промпт;
    		КонецЕсли;
    		// Дополнительный промпт — добавляется к основному (например, известный размер)
    		Если НастройкиЗапроса.Свойство("ДополнительныйПромпт") И ЗначениеЗаполнено(НастройкиЗапроса.ДополнительныйПромпт) Тогда
    			Промпт = Промпт + НастройкиЗапроса.ДополнительныйПромпт;
    		КонецЕсли;
    		Если НастройкиЗапроса.Свойство("МаксТокенов") Тогда
    			МаксТокенов = НастройкиЗапроса.МаксТокенов;
    		КонецЕсли;
    		Если НастройкиЗапроса.Свойство("Температура") Тогда
    			Температура = НастройкиЗапроса.Температура;
    		КонецЕсли;
    		Если НастройкиЗапроса.Свойство("URLСервера") И ЗначениеЗаполнено(НастройкиЗапроса.URLСервера) Тогда
    			URLСервера = НастройкиЗапроса.URLСервера;
    		КонецЕсли;
    		Если НастройкиЗапроса.Свойство("ПутьКAPI") И ЗначениеЗаполнено(НастройкиЗапроса.ПутьКAPI) Тогда
    			ПутьКAPI = НастройкиЗапроса.ПутьКAPI;
    		КонецЕсли;
    	КонецЕсли;
    
    	// Определяем MIME-тип: поддерживаем PDF, PNG, JPEG
    	// Gemini и Qwen VL работают с PDF напрямую
    	Если НРег(Расширение) = "pdf" Тогда
    		MIME = "application/pdf";
    	ИначеЕсли НРег(Расширение) = "png" Тогда
    		MIME = "image/png";
    	ИначеЕсли НРег(Расширение) = "jpg" ИЛИ НРег(Расширение) = "jpeg" Тогда
    		MIME = "image/jpeg";
    	Иначе
