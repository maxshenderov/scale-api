// Собирает системный промпт из параметров задачи
&НаСервере
Функция СобратьСистемныйПромпт(ПараметрыЗадачи, ДокументСсылка) Экспорт
    Персона = ПараметрыЗадачи.Персона;

    Инструкция =
        "|ИНСТРУКЦИЯ:
        |1. ДЛЯ ПОЛУЧЕНИЯ ДАННЫХ ВЫЗЫВАЙ ИНСТРУМЕНТЫ (function calling). Без данных из 1С анализ невозможен.
        |2. Вызови ВСЕ нужные инструменты за ОДИН шаг (можно несколько сразу), чтобы получить все необходимые данные.
        |3. Не запрашивай инструменты, данные которых тебе не нужны для анализа.
        |4. Когда все данные получены — предоставь ИТОГОВЫЙ анализ в JSON-формате.
        |5. Верни ТОЛЬКО валидный JSON, без ```json, без markdown, без пояснений до или после JSON.
        |6. Все числа должны быть числами (не строками). Проценты — дробные (47.46, не ""47.46%"").
        |7. Если данных недостаточно — отметь это в анализе, но не запрашивай бесконечно.
        |8. ВСЕ ключи в JSON должны быть на русском языке. Не использовать английские названия полей.
        |
        |СТРУКТУРА JSON:
        |{
        |  ""вердикт"": { ... },
        |  ""риски"": [ ... ],
        |  ""технология"": { ... },
        |  ""таймлайн"": { ... },
        |  ""экономика"": { ... },
        |  ""цвета_и_краски"": { ... },
        |  ""контроль_качества"": { ... },
        |  ""ресурсы"": { ... },
        |  ""итоговый_вердикт"": ""..."",
        |  ""исходные_данные"": {
        |    ""номер_заказа"": ""..."" ,
        |    ""дата_создания"": ""..."" ,
        |    ""клиент"": ""..."" ,
        |    ""менеджер"": ""..."" ,
        |    ""статус"": ""..."" ,
        |    ""тип_продукта"": ""..."" ,
        |    ""номенклатура"": ""..."" ,
        |    ""тираж_штук"": ...
        |  }
        |}
        |
        |ВАЖНО О ПОРЯДКЕ:
        |   - СНАЧАЛА идёт твоя аналитика и объяснения (вердикт, риски, технология, экономика, таймлайн...) — это НОВАЯ информация.
        |   - В КОНЦЕ компактно укажи ""исходные_данные"" — ТОЛЬКО те данные, которые уже были в 1С и не требуют анализа.
        |     Это: номер заказа, дата, клиент, менеджер, статус, номенклатура, тираж, тип продукта.
        |     Не дублируй эту информацию в других секциях!
        |
        |ЗАКАЗ ДЛЯ АНАЛИЗА: " + Строка(ДокументСсылка);

    Возврат Персона + Инструкция;
КонецФункции

//+Лико m.shenderov 06.05.2026
// Основной цикл взаимодействия с LLM через function calling
&НаСервере
Функция AgentLoop(ДокументСсылка, КодЗадачи = "full", ПараметрыПровайдера = Неопределено) Экспорт
    // 1. Получаем параметры задачи
    ВсеЗадачи = ЗадачиАнализа();
    ПараметрыЗадачи = ВсеЗадачи.Получить(КодЗадачи);
    Если ПараметрыЗадачи = Неопределено Тогда
        Возврат ПолучитьОшибкуHTML("Неизвестная задача: " + КодЗадачи);
    КонецЕсли;

    // 2. Сборка системного промпта
    СистемныйПромпт = СобратьСистемныйПромпт(ПараметрыЗадачи, ДокументСсылка);

    // 3. Инициализация истории
    История = Новый Массив;
    История.Добавить(Сообщение("system", СистемныйПромпт));
    История.Добавить(Сообщение("user",
        "Проанализируй заказ. Получи данные через инструменты.
        |Когда данных достаточно — верни ИТОГОВЫЙ JSON-анализ.
        |ПОМНИ: сначала аналитика (вердикт, риски, технология, экономика...),
        |в конце компактно — ""исходные_данные"" (номер заказа, дата, клиент, тираж...).
        |ВСЕ ключи на русском языке."));

    // 4. Инструменты
    Инструменты = ОписаниеИнструментов();

    // 5. Agent Loop
    МаксИтераций = 10;
    Для Итерация = 1 По МаксИтераций Цикл
        РезультатLLM = ОтправитьЗапросКLLM_сИнструментами(История, Инструменты, ПараметрыПровайдера);

        Если НЕ РезультатLLM.Успех Тогда
            Возврат ПолучитьОшибкуHTML("Ошибка LLM (итерация " + Итерация + "): "
                + РезультатLLM.ОписаниеОшибки);
        КонецЕсли;

        СообщениеLLM = РезультатLLM.Сообщение;

        // Проверяем: tool_calls или финальный ответ?
        Если СообщениеLLM.Свойство("tool_calls")
           И ТипЗнч(СообщениеLLM.tool_calls) = Тип("Массив")
           И СообщениеLLM.tool_calls.Количество() > 0 Тогда

            // Добавляем assistant message с tool_calls в историю
            История.Добавить(СообщениеLLM);

            // Выполняем инструменты
            РезультатыИнстр = ВыполнитьИнструменты(СообщениеLLM.tool_calls, ДокументСсылка);
            Для Каждого Рез Из РезультатыИнстр Цикл
                История.Добавить(Рез);
            КонецЦикла;

        ИначеЕсли СообщениеLLM.Свойство("content")
                 И ЗначениеЗаполнено(СообщениеLLM.content) Тогда

            // Попытка 1: парсим JSON напрямую
            ДанныеJSON = ИзвлечьJSONИзОтвета(СообщениеLLM.content);
            Если ДанныеJSON <> Неопределено Тогда
                Возврат JSON_Анализа_в_HTML(ДанныеJSON, КодЗадачи);
            КонецЕсли;

            // Попытка 2: фаза 2 — просим модель переформатировать в JSON
            История.Добавить(СообщениеLLM);
            История.Добавить(Сообщение("user",
                "Оформи свой предыдущий анализ как единый JSON-объект согласно схеме. Без markdown и пояснений."));
            
            РезультатФаза2 = ОтправитьЗапросКLLM_сИнструментами(История, Неопределено, ПараметрыПровайдера);
            
            Если РезультатФаза2.Успех И РезультатФаза2.Сообщение.Свойство("content") Тогда
                ДанныеJSON = ИзвлечьJSONИзОтвета(РезультатФаза2.Сообщение.content);
                Если ДанныеJSON <> Неопределено Тогда
                    Возврат JSON_Анализа_в_HTML(ДанныеJSON, КодЗадачи);
                КонецЕсли;
            КонецЕсли;

            // Попытка 3: fallback — показываем как есть
            Если СтрНайти(СообщениеLLM.content, "<html") > 0 Тогда
                Возврат СообщениеLLM.content;
            КонецЕсли;
            Возврат ОборнутьВHTML(СообщениеLLM.content, КодЗадачи);

        Иначе
            Возврат ПолучитьОшибкуHTML("Неожиданный формат ответа на итерации " + Итерация);
        КонецЕсли;

    КонецЦикла;

    Возврат ПолучитьОшибкуHTML("Превышено максимальное количество итераций (" + МаксИтераций + ")");
КонецФункции

//+Лико m.shenderov 06.05.2026
// Обрабатывает финальный JSON-ответ от LLM
&НаСервере
Функция ОбработатьФинальныйОтвет(ОтветJSON, КодЗадачи) Экспорт
    ДанныеJSON = ИзвлечьJSONИзОтвета(ОтветJSON);

    Если ДанныеJSON = Неопределено Тогда
        // Не смогли распарсить — показываем как есть
        Если СтрНайти(ОтветJSON, "<html") > 0 Тогда
            Возврат ОтветJSON;
        КонецЕсли;
        Возврат ОборнутьВHTML(ОтветJSON, КодЗадачи);
    КонецЕсли;

    // Успешно — рендерим JSON в HTML
    Возврат JSON_Анализа_в_HTML(ДанныеJSON, КодЗадачи);
КонецФункции

