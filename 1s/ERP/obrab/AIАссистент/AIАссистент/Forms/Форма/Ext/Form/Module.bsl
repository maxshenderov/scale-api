//+Лико m.shenderov 07.05.2026
// Универсальный рендерер для любой структуры JSON — использует стильные карточки
&НаСервере
Функция РендеритьУниверсальныйJSON(ДанныеJSON, УровеньГлубины = 0)
    Результат = "";
    МаксГлубина = 5;
    
    Если УровеньГлубины > МаксГлубина Тогда
        Возврат "<p>⚠️ Слишком глубокая вложенность</p>";
    КонецЕсли;
    
    Если ТипЗнч(ДанныеJSON) = Тип("Структура") Тогда
        // Группируем: сначала простые значения в одну карточку, затем сложные секции
        Простые = Новый Соответствие;
        Сложные = Новый Соответствие;
        МассивыСтруктур = Новый Соответствие;
        
        Для Каждого КлючЗнач Из ДанныеJSON Цикл
            Ключ = КлючЗнач.Ключ;
            Значение = КлючЗнач.Значение;
            
            Если Значение = Неопределено ИЛИ Значение = "" Тогда
                Продолжить;
            КонецЕсли;
            
            ТипЗн = ТипЗнч(Значение);
            Если ТипЗн = Тип("Массив") Тогда
                Если Значение.Количество() > 0 И ТипЗнч(Значение[0]) = Тип("Структура") Тогда
                    МассивыСтруктур.Вставить(Ключ, Значение);
                Иначе
                    Сложные.Вставить(Ключ, Значение);
                КонецЕсли;
            ИначеЕсли ТипЗн = Тип("Структура") Тогда
                Сложные.Вставить(Ключ, Значение);
            Иначе
                Простые.Вставить(Ключ, Значение);
            КонецЕсли;
        КонецЦикла;
        
        // Простые значения — одна карточка
        Если Простые.Количество() > 0 Тогда
            Результат = Результат + "<div class='kv-card'>";
            Для Каждого Пара Из Простые Цикл
                Ключ = Пара.Ключ;
                Значение = Пара.Значение;
                РусскийКлюч = ПреобразоватьНазваниеВРусский(Ключ);
                ЗначениеСтр = ПреобразоватьЗначениеВСтроку(Значение);
                КлассЗнач = ?(ТипЗнч(Значение) = Тип("Число"), "kv-value number", "kv-value");
                Результат = Результат + "<div class='kv-row'><span class='kv-key'>" + РусскийКлюч + "</span><span class='" + КлассЗнач + "'>" + ЗначениеСтр + "</span></div>";
            КонецЦикла;
            Результат = Результат + "</div>";
        КонецЕсли;
        
        // Массивы структур — стильные таблицы с подзаголовком
        Для Каждого Пара Из МассивыСтруктур Цикл
            Ключ = Пара.Ключ;
            Значение = Пара.Значение;
            РусскийКлюч = ПреобразоватьНазваниеВРусский(Ключ);
            Результат = Результат + "<h3>" + РусскийКлюч + "</h3>";
            Результат = Результат + РендеритьМассивСтруктурКакТаблицу(Значение);
        КонецЦикла;
        
        // Вложенные структуры и массивы — с подзаголовками
        Для Каждого Пара Из Сложные Цикл
            Ключ = Пара.Ключ;
            Значение = Пара.Значение;
            РусскийКлюч = ПреобразоватьНазваниеВРусский(Ключ);
            Результат = Результат + "<h3>" + РусскийКлюч + "</h3>";
            Результат = Результат + РендеритьЗначениеРекурсивно(Значение);
        КонецЦикла;
        
    ИначеЕсли ТипЗнч(ДанныеJSON) = Тип("Массив") Тогда
        Если ДанныеJSON.Количество() > 0 И ТипЗнч(ДанныеJSON[0]) = Тип("Структура") Тогда
            Результат = РендеритьМассивСтруктурКакТаблицу(ДанныеJSON);
        Иначе
            Результат = "<ul>";
            Для Каждого Элемент Из ДанныеJSON Цикл
                Результат = Результат + "<li>" + РендеритьЗначениеРекурсивно(Элемент) + "</li>";
            КонецЦикла;
            Результат = Результат + "</ul>";
        КонецЕсли;
    Иначе
        Результат = "<p>" + ПреобразоватьЗначениеВСтроку(ДанныеJSON) + "</p>";
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

