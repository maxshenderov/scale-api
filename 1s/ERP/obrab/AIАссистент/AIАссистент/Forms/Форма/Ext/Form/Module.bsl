// Оборачивает простой текст в HTML
Функция ОборнутьВHTML(ПростойТекст, ТипАнализа)
    
    ТекстHTML = "<html><head><meta charset='utf-8'><style>
    |body { font-family: Arial, sans-serif; margin: 20px; line-height: 1.6; }
    |h2 { color: #333; border-bottom: 2px solid #007bff; padding-bottom: 10px; }
    |h3 { color: #555; margin-top: 15px; }
    |.analysis-type { background-color: #e7f3ff; padding: 10px; border-left: 4px solid #007bff; margin-bottom: 20px; }
    |.content { white-space: pre-wrap; word-wrap: break-word; }
    |</style></head><body>";
    
    ТекстHTML = ТекстHTML + "<div class='analysis-type'><strong>Тип анализа:</strong> " + ТипАнализа + "</div>";
    ТекстHTML = ТекстHTML + "<div class='content'>" + ПростойТекст + "</div>";
    ТекстHTML = ТекстHTML + "</body></html>";
    
    Возврат ТекстHTML;
    
