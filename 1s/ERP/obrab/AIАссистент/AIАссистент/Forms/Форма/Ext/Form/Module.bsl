    		Результат.Успех = Истина;
    		Результат.Ответ = ТекстОтвета;
    		Результат.ПолныйОтвет = ДанныеОтвета;
    
    		// Стоимость: пробуем разные пути (OpenRouter, Gemini, etc.)
    		Если ДанныеОтвета.Свойство("usage") Тогда
    			Если ДанныеОтвета.usage.Свойство("cost") Тогда
    				Результат.Стоимость = ДанныеОтвета.usage.cost;
    			ИначеЕсли ДанныеОтвета.usage.Свойство("total_tokens") Тогда
    				// Грубая оценка если cost отсутствует
    				Результат.Стоимость = 0;
    			КонецЕсли;
    		КонецЕсли;
    
    	Исключение
    		Результат.ОписаниеОшибки = ОписаниеОшибки();
    	КонецПопытки;
    
    	Возврат Результат;
    
    КонецФункции
    
