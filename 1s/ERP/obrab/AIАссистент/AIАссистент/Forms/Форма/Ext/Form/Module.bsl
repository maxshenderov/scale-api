    // Вспомогательная: разделение полного пути на имя файла и расширение
    Процедура ИзвлечьИмяИРасширение(ПутьКФайлу, ИмяФайла, Расширение)
    	
    	ИмяФайла = "";
    	Расширение = "";
    	
    	// Находим последний слеш
    	ПозСлеш = СтрНайти(ПутьКФайлу, "\", НаправлениеПоиска.СКонца);
    	Если ПозСлеш = 0 Тогда
    		ПозСлеш = СтрНайти(ПутьКФайлу, "/", НаправлениеПоиска.СКонца);
    	КонецЕсли;
    	
    	Если ПозСлеш > 0 Тогда
    		ИмяСРасширением = Сред(ПутьКФайлу, ПозСлеш + 1);
    	Иначе
    		ИмяСРасширением = ПутьКФайлу;
    	КонецЕсли;
    	
    	// Находим последнюю точку
    	ПозТочка = СтрНайти(ИмяСРасширением, ".", НаправлениеПоиска.СКонца);
    	Если ПозТочка > 0 Тогда
    		ИмяФайла = Лев(ИмяСРасширением, ПозТочка - 1);
    		Расширение = НРег(Сред(ИмяСРасширением, ПозТочка + 1));
    	Иначе
    		ИмяФайла = ИмяСРасширением;
    	КонецЕсли;
    	
