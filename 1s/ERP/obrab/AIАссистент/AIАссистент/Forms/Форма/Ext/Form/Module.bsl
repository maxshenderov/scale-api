//+Лико m.shenderov 13.05.2026
// Анализирует загруженный макет: Phase0 (Vision) + Phase1 (Docling) + RAG + LLM
&НаСервере
Функция АнализироватьМакетФаза1Сервер(ПутьКФайлу) Экспорт

Результат = Новый Структура;
Результат.Вставить("Успех", Ложь);
Результат.Вставить("ПараметрыЗаказа", Неопределено);
Результат.Вставить("ТребуютУточнения", Новый Массив);
Результат.Вставить("РАГКонтекст", Новый Массив);
Результат.Вставить("Ошибка", "");

Попытка
	
	// ─────────────────────────────────────────────────────────────────────
	// ШАГ 1: ФАЗА 1 - Парсинг текста из макета (Docling)
	// ─────────────────────────────────────────────────────────────────────
	
	Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("📄 Фаза 1: Парсинг текста макета...");
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКФайлу);
	РасширениеФайла = ПолучитьРасширениеФайла(ПутьКФайлу);
	ИмяФайла = ПолучитьИмяФайла(ПутьКФайлу);
	
	// Вызываем Phase 1 функцию
	РезультатФаза1 = Фаза1ИзвлечьТекстМакеты(ДвоичныеДанные, РасширениеФайла, ИмяФайла);
	
	Если НЕ РезультатФаза1.Успех Тогда
		Результат.Ошибка = "Фаза 1 ошибка: " + РезультатФаза1.ОписаниеОшибки;
		Возврат Результат;
	КонецЕсли;
	
	ТекстМакета = РезультатФаза1.Текст;
	ConfidenceФаза1 = РезультатФаза1.Confidence;
	
	Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("✅ Фаза 1: Извлечено " + Строка(СтрДлина(ТекстМакета)) + " символов");
	
	// ─────────────────────────────────────────────────────────────────────
	// ШАГ 2: ФАЗА 0 - Vision анализ (если макет подходит для анализа)
	// ─────────────────────────────────────────────────────────────────────
	
	// TODO: Добавить Vision анализ для полученного PDF/JPG
	
	// ─────────────────────────────────────────────────────────────────────
	// ШАГ 3: RAG + LLM - Генерирование параметров
	// ─────────────────────────────────────────────────────────────────────
	
	Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("🤖 RAG LLM: Анализ и генерирование параметров...");
	
	// Формируем request для RAG LLM сервиса
	Phase0Параметры = Новый Структура;
	Phase0Параметры.Вставить("label_width", 50);  // TODO: получить из Vision
	Phase0Параметры.Вставить("label_height", 100); // TODO: получить из Vision
	Phase0Параметры.Вставить("orientation", "portrait");
	Phase0Параметры.Вставить("print_type", "");
	Phase0Параметры.Вставить("estimated_colors", 0);
	Phase0Параметры.Вставить("confidence", 0.5);
	
	Phase1Данные = Новый Структура;
	Phase1Данные.Вставить("text", ТекстМакета);
	Phase1Данные.Вставить("confidence", ConfidenceФаза1);
	Phase1Данные.Вставить("additional_files", Новый Массив);
	Phase1Данные.Вставить("manager_notes", "");
	
	// Вызываем RAG LLM сервис
	РезультатРАГ = ВызватьРАГЛЛМСервис(Phase0Параметры, Phase1Данные);
	
	Если НЕ РезультатРАГ.success Тогда
		Результат.Ошибка = "RAG LLM ошибка: " + РезультатРАГ.error;
		Возврат Результат;
	КонецЕсли;
	
	Результат.ПараметрыЗаказа = РезультатРАГ.parameters;
	Результат.ТребуютУточнения = РезультатРАГ.uncertain_parameters;
	Результат.РАГКонтекст = РезультатРАГ.rag_context;
	Результат.Успех = Истина;
	
	Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("✅ Анализ завершен");
	
Исключение
	Результат.Ошибка = ОписаниеОшибки();
	Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("❌ Ошибка: " + Результат.Ошибка);
КонецПопытки;

Возврат Результат;

КонецФункции

//+Лико m.shenderov 13.05.2026
