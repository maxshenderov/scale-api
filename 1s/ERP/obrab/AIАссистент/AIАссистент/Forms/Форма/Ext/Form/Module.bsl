    	КонецЕсли;
    
    	// Base64: используем Base64Строка с очисткой переносов строк
    	Base64Изображения = Base64Строка(ДвоичныеДанные);
    	// Убираем ВСЕ переносы строк (1С добавляет \r\n каждые 76 символов)
    	Base64Изображения = СтрЗаменить(Base64Изображения, Символы.ВК, "");
    	Base64Изображения = СтрЗаменить(Base64Изображения, Символы.ПС, "");
    	DataURL = "data:" + MIME + ";base64," + Base64Изображения;
    
    	// Формируем content как массив (текст + изображение)
    	Содержимое = Новый Массив;
    
    	ТекстоваяЧасть = Новый Структура;
    	ТекстоваяЧасть.Вставить("type", "text");
    	ТекстоваяЧасть.Вставить("text", Промпт);
