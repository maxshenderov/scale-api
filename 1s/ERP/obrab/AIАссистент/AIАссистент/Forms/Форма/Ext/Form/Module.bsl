//+Лико m.shenderov 06.05.2026
// Диспетчер инструментов: выполняет запрошенные LLM tool_calls
// Параметры:
//   ToolCalls - Массив структур tool_call из ответа LLM
//   ДокументСсылка - ссылка на ЗаказКлиента
// Возвращает массив сообщений role="tool" для добавления в историю
&НаСервере
Функция ВыполнитьИнструменты(ToolCalls, ДокументСсылка) Экспорт
    Результаты = Новый Массив;
    
    Для Каждого ToolCall Из ToolCalls Цикл
        ИмяФункции = ToolCall.function.name;
        IDВызова = ToolCall.id;
        
        РезультатJSON = "";
        Попытка
            Если ИмяФункции = "get_order_header" Тогда
                РезультатJSON = ВыполнитьИнструмент_get_order_header(ДокументСсылка);
            ИначеЕсли ИмяФункции = "get_label_params" Тогда
                РезультатJSON = ВыполнитьИнструмент_get_label_params(ДокументСсылка);
            ИначеЕсли ИмяФункции = "get_production_flags" Тогда
                РезультатJSON = ВыполнитьИнструмент_get_production_flags(ДокументСсылка);
            ИначеЕсли ИмяФункции = "get_colors" Тогда
                РезультатJSON = ВыполнитьИнструмент_get_colors(ДокументСсылка);
            ИначеЕсли ИмяФункции = "get_costs" Тогда
                РезультатJSON = ВыполнитьИнструмент_get_costs(ДокументСсылка);
            ИначеЕсли ИмяФункции = "get_production_params" Тогда
                РезультатJSON = ВыполнитьИнструмент_get_production_params(ДокументСсылка);
            ИначеЕсли ИмяФункции = "get_metrics" Тогда
                РезультатJSON = ВыполнитьИнструмент_get_metrics(ДокументСсылка);
            ИначеЕсли ИмяФункции = "get_economics" Тогда
                РезультатJSON = ВыполнитьИнструмент_get_economics(ДокументСсылка);
            ИначеЕсли ИмяФункции = "get_quality" Тогда
                РезультатJSON = ВыполнитьИнструмент_get_quality(ДокументСсылка);
            ИначеЕсли ИмяФункции = "get_order_items" Тогда
                РезультатJSON = ВыполнитьИнструмент_get_order_items(ДокументСсылка);
            ИначеЕсли ИмяФункции = "get_sections" Тогда
                РезультатJSON = ВыполнитьИнструмент_get_sections(ДокументСсылка);
            Иначе
                РезультатJSON = "{""error"": ""Неизвестный инструмент: " + ИмяФункции + """}";
            КонецЕсли;
        Исключение
            РезультатJSON = "{""error"": ""Ошибка выполнения: " + ОписаниеОшибки() + """}";
        КонецПопытки;
        
        // Формируем tool-сообщение
        СообщениеИнструмент = Новый Структура;
        СообщениеИнструмент.Вставить("role", "tool");
        СообщениеИнструмент.Вставить("tool_call_id", IDВызова);
        СообщениеИнструмент.Вставить("content", РезультатJSON);
        
        Результаты.Добавить(СообщениеИнструмент);
    КонецЦикла;
    
    Возврат Результаты;
КонецФункции

//+Лико m.shenderov 06.05.2026
// Извлекает JSON из ответа LLM с тройной защитой
//+Лико m.shenderov 06.05.2026
// Извлекает JSON из ответа LLM с четырёхуровневой защитой
&НаСервере
Функция ИзвлечьJSONИзОтвета(СыройОтвет) Экспорт
    // Попытка 1: прямой парсинг
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(СыройОтвет);
        Результат = ПрочитатьJSON(ЧтениеJSON);
        Возврат Результат;
    Исключение
    КонецПопытки;

    // Попытка 2: убираем ```json ... ``` и другие markdown-блоки
    Очищенный = СыройОтвет;
    
    // Удаляем ```json в начале (с пробелами)
    Очищенный = СтрЗаменить(Очищенный, "```json", "");
    Очищенный = СтрЗаменить(Очищенный, "``` json", "");
    
    // Удаляем ``` в конце (с пробелами)
    Очищенный = СтрЗаменить(Очищенный, "```", "");
    
    // Удаляем пробелы и переносы строк в начале/конце
    Очищенный = СокрЛП(Очищенный);

    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Очищенный);
        Результат = ПрочитатьJSON(ЧтениеJSON);
        Возврат Результат;
    Исключение
    КонецПопытки;

    // Попытка 3: ищем первую { и последнюю } и извлекаем JSON
    Поз1 = СтрНайти(Очищенный, "{");
    Поз2 = СтрНайти(Очищенный, "}", НаправлениеПоиска.СКонца);
    Если Поз1 > 0 И Поз2 > Поз1 Тогда
        Фрагмент = Сред(Очищенный, Поз1, Поз2 - Поз1 + 1);
        Попытка
            ЧтениеJSON = Новый ЧтениеJSON;
            ЧтениеJSON.УстановитьСтроку(Фрагмент);
            Результат = ПрочитатьJSON(ЧтениеJSON);
            Возврат Результат;
        Исключение
        КонецПопытки;
    КонецЕсли;

    // Попытка 4: если всё ещё не получилось, логируем и возвращаем Неопределено
    Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Ошибка парсинга JSON. Первые 300 символов: " + Сред(СыройОтвет, 1, 300));
    Возврат Неопределено;
КонецФункции

//+Лико m.shenderov 06.05.2026
// Вспомогательная функция для создания сообщения
&НаСервере
Функция Сообщение(Роль, Контент, ДопПоля = Неопределено)
    Сообщ = Новый Структура;
    Сообщ.Вставить("role", Роль);
    Сообщ.Вставить("content", Контент);
    Если ДопПоля <> Неопределено Тогда
        Для Каждого КлючЗначение Из ДопПоля Цикл
            Сообщ.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
        КонецЦикла;
    КонецЕсли;
    Возврат Сообщ;
КонецФункции

