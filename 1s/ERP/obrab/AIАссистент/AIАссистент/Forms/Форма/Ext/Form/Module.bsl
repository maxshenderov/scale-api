// Отправляет запрос к LLM с поддержкой инструментов (tools) и response_format
&НаСервере
Функция ОтправитьЗапросКLLM_сИнструментами(ИсторияСообщений, Инструменты, ПараметрыПровайдера) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("Успех", Ложь);
    Результат.Вставить("Сообщение", Неопределено);
    Результат.Вставить("ПолныйОтвет", Неопределено);
    Результат.Вставить("ОписаниеОшибки", "");

    Попытка
        URLСервера = ПараметрыПровайдера.URLСервера;
        КлючAPI = ПараметрыПровайдера.КлючAPI;
        ПутьКAPI = ПараметрыПровайдера.ПутьКAPI;

        Заголовки = Новый Соответствие;
        Заголовки.Вставить("Content-Type", "application/json");
        Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);

        // Тело запроса
        ЗапросОбъект = Новый Структура;
        ЗапросОбъект.Вставить("model", ПараметрыПровайдера.МодельID);
        ЗапросОбъект.Вставить("messages", ИсторияСообщений);
        ЗапросОбъект.Вставить("temperature", 0.1);
        ЗапросОбъект.Вставить("max_tokens", 100000);

        // Добавляем инструменты если есть
        Если Инструменты <> Неопределено И Инструменты.Количество() > 0 Тогда
            ЗапросОбъект.Вставить("tools", Инструменты);
            ЗапросОбъект.Вставить("tool_choice", "auto");
        Иначе
            // response_format: json_object — ТОЛЬКО когда нет инструментов (фаза 2: форматирование)
            РеспонсФормат = Новый Структура;
            РеспонсФормат.Вставить("type", "json_object");
            ЗапросОбъект.Вставить("response_format", РеспонсФормат);
        КонецЕсли;

        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, ЗапросОбъект);
        ТелоЗапроса = ЗаписьJSON.Закрыть();

        ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
        HTTPСоединение = Новый HTTPСоединение(URLСервера, 443, , , , , ЗащищенноеСоединение);
        HTTPЗапросОбъект = Новый HTTPЗапрос(ПутьКAPI, Заголовки);
        HTTPЗапросОбъект.УстановитьТелоИзСтроки(ТелоЗапроса);

        ОтветHTTP = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапросОбъект);
        ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();

        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
        ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);

        СообщениеLLM = ДанныеОтвета["choices"][0]["message"];

        Результат.Успех = Истина;
        Результат.Сообщение = СообщениеLLM;
        Результат.ПолныйОтвет = ДанныеОтвета;

    Исключение
        Результат.ОписаниеОшибки = ОписаниеОшибки();
    КонецПопытки;

    Возврат Результат;
КонецФункции

