// Универсальный HTTP-вызов
&НаСервере
Функция ВыполнитьHTTPНаСервере(ПарамHTTP)
	ЛокальныйОтвет = "";
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ПарамHTTP);
		СтрокаТела = ЗаписьJSON.Закрыть();

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json");
		Заголовки.Вставить("Authorization", "Basic " + ПолучитьBase64ИзСтроки(Login + ":" + Password));

		HTTP = Новый HTTPСоединение("it-mshenderov", 80);
		HTTPЗапрос = Новый HTTPЗапрос("/1ctesterp5/hs/LikoRest/API", Заголовки);
		HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаТела, КодировкаТекста.UTF8);

		ОтветHTTP = HTTP.ОтправитьДляОбработки(HTTPЗапрос);
		ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();

		// Форматируем JSON
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();

		ЗаписьJSON2 = Новый ЗаписьJSON;
		ЗаписьJSON2.УстановитьСтроку();
		ЗаписьJSON2.ПроверятьСтруктуру = Ложь;
		ЗаписатьJSON(ЗаписьJSON2, Результат);
		ЛокальныйОтвет = "OK " + Строка(ОтветHTTP.КодСостояния) + Символы.ПС + ЗаписьJSON2.Закрыть();
	Исключение
		ЛокальныйОтвет = "ERROR: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат ЛокальныйОтвет;
КонецФункции

// Хелпер: GUID из ссылки
&НаСервере
Функция ГуидСсылки(Ссылка)
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Строка(Ссылка.УникальныйИдентификатор());
	КонецЕсли;
	Возврат "";
КонецФункции

// Хелпер: добавить в структуру если заполнено
&НаСервере
Процедура ДобавитьЕсли(Структура, Ключ, Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Структура.Вставить(Ключ, Значение);
	КонецЕсли;
КонецПроцедуры

