// ====================================================================
// Сборка параметров (серверная — имеет доступ к ссылкам)
// ====================================================================

&НаСервере
Функция СобратьПараметрыНаСервере(ProcName, НуженСклад, НуженПаллет, НужнаЯчейка)
	Парам = Новый Структура;
	Парам.Вставить("ProcName", ProcName);
	
	Если НуженСклад И ЗначениеЗаполнено(Склад) Тогда
		Парам.Вставить("warehouse", ГуидСсылки(Склад));
	КонецЕсли;
	
	Если НуженПаллет И ЗначениеЗаполнено(Паллет) Тогда
		Парам.Вставить("pallet", ГуидСсылки(Паллет));
	КонецЕсли;
	
	Если НужнаЯчейка И ЗначениеЗаполнено(Ячейка) Тогда
		Парам.Вставить("cell", ГуидСсылки(Ячейка));
		Парам.Вставить("targetCell", ГуидСсылки(Ячейка));
	КонецЕсли;
	
	Возврат Парам;
КонецФункции

&НаСервере
Функция ПолучитьBase64ИзСтроки(ИсходнаяСтрока)
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ИсходнаяСтрока, КодировкаТекста.UTF8);
	Возврат Base64Строка(ДвоичныеДанные);
КонецФункции