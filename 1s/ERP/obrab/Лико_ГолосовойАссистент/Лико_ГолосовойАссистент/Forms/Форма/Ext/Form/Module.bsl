&НаСервере
Функция ИнструментыСклада()

	tools = Новый Массив;

	tool1 = Новый Структура;
	tool1.Вставить("name", "get_cell_sections");
	tool1.Вставить("description", "Получить список всех складских секций с их типами, размерами и загруженностью");
	tool1.Вставить("parameters", Новый Структура(
		"type", "object",
		"properties", Новый Структура,
		"required", Новый Массив
	));
	tools.Добавить(tool1);

	// tool2
	req2 = Новый Массив;
	req2.Добавить("pallet_id");

	tool2 = Новый Структура;
	tool2.Вставить("name", "find_cell_for_placement");
	tool2.Вставить("description", "Найти оптимальную ячейку для размещения паллеты по алгоритму Лико. Учитывает: тип секции, характеристики паллеты, совместимость, загруженность.");
	tool2.Вставить("parameters", Новый Структура(
		"type", "object",
		"properties", Новый Структура(
			"pallet_id", Новый Структура("type", "string", "description", "ID паллеты для размещения"),
			"nomenclature", Новый Структура("type", "string", "description", "Наименование номенклатуры на паллете"),
			"characteristic", Новый Структура("type", "string", "description", "Характеристика номенклатуры (опционально)")
		),
		"required", req2
	));
	tools.Добавить(tool2);

	// tool3
	req3 = Новый Массив;
	req3.Добавить("cell_id");
	req3.Добавить("pallet_id");

	tool3 = Новый Структура;
	tool3.Вставить("name", "explain_cell_choice");
	tool3.Вставить("description", "Объяснить, почему алгоритм выбрал конкретную ячейку для паллеты. Возвращает логику подбора: правила совместимости, загруженность, FIFO.");
	tool3.Вставить("parameters", Новый Структура(
		"type", "object",
		"properties", Новый Структура(
			"cell_id", Новый Структура("type", "string", "description", "ID ячейки, для которой нужно объяснение"),
			"pallet_id", Новый Структура("type", "string", "description", "ID паллеты")
		),
		"required", req3
	));
	tools.Добавить(tool3);

	Возврат tools;

КонецФункции


&НаСервере
Функция ПолучитьКонтекстАссистента(ТипАссистента)

	Если ТипАссистента = "Склад" Тогда
		system_prompt = "Ты ассистент склада типографии Лико. Твоя задача — помогать оператору склада
		|размещать паллеты и подбирать ячейки. Ты знаешь топологию склада и алгоритмы подбора.
		|Отвечай кратко, по-русски. Если нужны данные — вызывай инструменты.
		|Объясняй, ПОЧЕМУ предложена та или иная ячейка, а не просто называй её.";
		tools = ИнструментыСклада();
		Возврат Новый Структура("system_prompt,tools", system_prompt, tools);

	ИначеЕсли ТипАссистента = "Заказы" Тогда
		system_prompt = "Ты ассистент по заказам типографии Лико. Помогаешь с информацией по заказу,
		|его статусу, этапам выполнения.";
		tools = Новый Массив;
		Возврат Новый Структура("system_prompt,tools", system_prompt, tools);

	Иначе
		system_prompt = "Ты универсальный ассистент типографии Лико. Отвечай кратко и по делу.";
		tools = Новый Массив;
		Возврат Новый Структура("system_prompt,tools", system_prompt, tools);
	КонецЕсли;

КонецФункции


// Вспомогательная: построить HTML-строку для ПолеHTML
&НаСервере
Функция ПостроитьHTMLДляФормы(Знач КонтекстJSON = "")

	URL = "http://localhost:8004";

	Результат = "<html><body style='font-family:sans-serif;font-size:16px;padding:15px;color:#333'>
	|<div id='status'>Нажми «Спросить AI» и говори в Telegram</div>
	|<div id='text'></div>
	|<script>
	|var URL = '" + URL + "';
	|var lastText = '';
	|var CTX = " + ?(КонтекстJSON = "", "null", "'" + КонтекстJSON + "'") + ";
	|function sendCtx() {
	|    if (!CTX) return;
	|    var x = new XMLHttpRequest();
	|    x.open('POST', URL + '/context', true);
	|    x.setRequestHeader('Content-Type', 'application/json; charset=utf-8');
	|    x.onload = function() {
	|        if (x.status === 200) {
	|            document.getElementById('status').innerText = 'Контекст отправлен. Говорите в Telegram...';
	|        } else {
	|            document.getElementById('status').innerText = 'Ошибка: HTTP ' + x.status;
	|        }
	|    };
	|    x.onerror = function() { document.getElementById('status').innerText = 'Ошибка соединения'; };
	|    x.send(CTX);
	|    CTX = null;
	|}
	|function pollLatest() {
	|    var x = new XMLHttpRequest();
	|    x.open('GET', URL + '/latest', true);
	|    x.onload = function() {
	|        if (x.status === 200) {
	|            try {
	|                var d = JSON.parse(x.responseText);
	|                if (d.text && d.text !== lastText) {
	|                    lastText = d.text;
	|                    var label = d.type === 'ai_response' ? 'Ответ AI' : 'Текст';
	|                    document.getElementById('status').innerText = label + ': ' + d.text;
	|                    document.getElementById('text').innerHTML = d.text.replace(/\\n/g,'<br>');
	|                }
	|            } catch(e) { document.getElementById('status').innerText = 'JSON error: ' + e.message; }
	|        }
	|    };
	|    x.send();
	|}
	|sendCtx();
	|setInterval(function() { pollLatest(); }, 1000);
	|</script>
	|</body></html>";

	Возврат Результат;

КонецФункции


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТипАссистента = "Склад";
	ЧатID = 0;

	// Реквизиты
	Если ЭтаФорма.Элементы.Найти("АссистентDisplayHTML") = Неопределено Тогда

		ДобавляемыеРеквизиты = Новый Массив;

		РеквизитDisplay = Новый РеквизитФормы("АссистентDisplayHTML",
			Новый ОписаниеТипов("Строка", ,
				Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)),
			, "АссистентDisplayHTML");
		ДобавляемыеРеквизиты.Добавить(РеквизитDisplay);

		РеквизитSessionID = Новый РеквизитФормы("АссистентSessionID",
			Новый ОписаниеТипов("Строка", ,
				Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)),
			, "АссистентSessionID");
		ДобавляемыеРеквизиты.Добавить(РеквизитSessionID);

		РеквизитТип = Новый РеквизитФормы("ТипАссистента",
			Новый ОписаниеТипов("Строка", ,
				Новый КвалификаторыСтроки(50, ДопустимаяДлина.Переменная)),
			, "ТипАссистента");
		ДобавляемыеРеквизиты.Добавить(РеквизитТип);

		РеквизитЧат = Новый РеквизитФормы("ЧатIDАссистента",
			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)),
			, "ЧатIDАссистента");
		ДобавляемыеРеквизиты.Добавить(РеквизитЧат);

		ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		ЭтаФорма.АссистентSessionID = Строка(Новый УникальныйИдентификатор);

	КонецЕсли;

	ЭтаФорма.ТипАссистента = ТипАссистента;
	ЭтаФорма.ЧатIDАссистента = ЧатID;

	// Кнопка
	Если ЭтаФорма.Элементы.Найти("СпроситьАссистентаButton") = Неопределено Тогда
		Команда = ЭтаФорма.Команды.Добавить("СпроситьАссистента");
		Команда.Действие = "СпроситьАссистента";
		Команда.Заголовок = "Спросить AI";

		Кнопка = ЭтаФорма.Элементы.Добавить("СпроситьАссистентаButton", Тип("КнопкаФормы"),
			ЭтаФорма.Элементы.ФормаКоманднаяПанель);
		Кнопка.ИмяКоманды = "СпроситьАссистента";
		Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КонецЕсли;

	// ПолеHTML
	Если ЭтаФорма.Элементы.Найти("АссистентDisplayHTML") = Неопределено Тогда
		DisplayField = ЭтаФорма.Элементы.Добавить("АссистентDisplayHTML", Тип("ПолеФормы"),
			ЭтаФорма.Элементы.ГруппаАссистент);
		DisplayField.Вид = ВидПоляФормы.ПолеHTMLДокумента;
		DisplayField.ПутьКДанным = "АссистентDisplayHTML";
		DisplayField.АвтоМаксимальнаяВысота = Истина;
		DisplayField.АвтоМаксимальнаяШирина = Истина;
		DisplayField.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	КонецЕсли;

	// Начальный HTML: без контекста
	ЭтаФорма.АссистентDisplayHTML = ПостроитьHTMLДляФормы("");

КонецПроцедуры //-Лико m.shenderov 01.06.2026


// ═══════════════════════════════════════════════════════
// Клиент: кнопка «Спросить AI»
// ═══════════════════════════════════════════════════════

&НаКлиенте
Процедура СпроситьАссистента(Команда)

	// Собираем контекст — JSON через серверный вызов
	КонтекстJSON = ПодготовитьКонтекстНаСервере(
		ЭтаФорма.ТипАссистента,
		ЭтаФорма.АссистентSessionID,
		ЭтаФорма.ЧатIDАссистента,
		ЭтаФорма.ИмяФормы);

	// Строим новый HTML с контекстом в JS-переменной — JS отправит сразу
	ЭтаФорма.АссистентDisplayHTML = ПостроитьHTMLСКонтекстомНаСервере(КонтекстJSON);

КонецПроцедуры


&НаСервере
Функция ПостроитьHTMLСКонтекстомНаСервере(КонтекстJSON)

	Возврат ПостроитьHTMLДляФормы(КонтекстJSON);

КонецФункции


&НаСервере
Функция ПодготовитьКонтекстНаСервере(ТипАссистента, SessionID, ChatID, ИмяФормы)

	КонтекстАссистента = ПолучитьКонтекстАссистента(ТипАссистента);

	Данные = Новый Структура;
	Данные.Вставить("session_id", SessionID);
	Данные.Вставить("chat_id", ChatID);
	Данные.Вставить("form_name", ИмяФормы);
	Данные.Вставить("assistant_type", ТипАссистента);
	Данные.Вставить("form_context", Новый Структура);
	Данные.Вставить("tools", КонтекстАссистента.tools);
	Данные.Вставить("system_prompt", КонтекстАссистента.system_prompt);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);

	// Экранируем кавычки для вставки в JavaScript
	Результат = СтрЗаменить(ЗаписьJSON.Закрыть(), "'", "\'");
	Возврат Результат;

КонецФункции

