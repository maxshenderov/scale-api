&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//+Лико m.shenderov 15.05.2026
	ДинамическиеЭлементы = Новый СписокЗначений;
	ТекущийСтеллажИмяКнопки = "";
