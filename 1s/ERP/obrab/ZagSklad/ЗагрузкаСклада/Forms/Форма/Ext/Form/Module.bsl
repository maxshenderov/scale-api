	КонецЕсли;

	Если Ссылка = "zagsklad://clear-files" Тогда
		// Крестик: отвязываем файлы и перерисовываем чат без пузыря.
		СтандартнаяОбработка = Ложь;
		ВыбранныеФайлы = "";
