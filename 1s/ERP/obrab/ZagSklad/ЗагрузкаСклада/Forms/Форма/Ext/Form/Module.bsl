Процедура УдалитьДинамическиеЭлементы()
	//+Лико m.shenderov 15.05.2026
	Для Каждого ЭлементСписка Из ДинамическиеЭлементы Цикл
		ИмяЭлемента = ЭлементСписка.Значение;
		Попытка
			УдаляемыйЭлемент = Элементы.Найти(ИмяЭлемента);
			Если УдаляемыйЭлемент <> Неопределено Тогда
				Элементы.Удалить(УдаляемыйЭлемент);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
