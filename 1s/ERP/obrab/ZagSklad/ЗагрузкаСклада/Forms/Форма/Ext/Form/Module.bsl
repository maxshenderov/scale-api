		НомераЭтажейСписок.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	НомераЭтажейСписок.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	НомераЭтажей = НомераЭтажейСписок.ВыгрузитьЗначения();
	
