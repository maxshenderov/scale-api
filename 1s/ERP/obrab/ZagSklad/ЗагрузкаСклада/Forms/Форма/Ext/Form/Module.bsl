&НаКлиенте
Процедура ЗагрузитьИзExcel(Команда)

    Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
        Сообщить("Укажите путь к файлу Excel.");
        Возврат;
    КонецЕсли;

    ЗагрузитьИзExcelНаСервере(ПутьКФайлу);

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзExcelНаСервере(ПутьКФайлу)

    ТабДок = Новый ТабличныйДокумент;
    Попытка
        ТабДок.Прочитать(ПутьКФайлу);
    Исключение
        Сообщить("Ошибка чтения файла Excel: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    // Извлекаем строки и заполняем ТЧ
    Паллеты.Очистить();
    НомерСтроки = НачалоСтрокиExcel;
    Пока Истина Цикл
        Область = ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C1");
        Если ПустаяСтрока(Область.Текст) Тогда
            Прервать;
        КонецЕсли;

        НоваяСтрока = Паллеты.Добавить();
        НоваяСтрока.ГлубинаПлан = Число(ТабДок.Область("R" + НомерСтроки + "C1").Текст);
        НоваяСтрока.ШиринаПлан  = Число(ТабДок.Область("R" + НомерСтроки + "C2").Текст);
        НоваяСтрока.Высота      = Число(ТабДок.Область("R" + НомерСтроки + "C3").Текст);
        НоваяСтрока.Вес         = Число(ТабДок.Область("R" + НомерСтроки + "C4").Текст);
        НоваяСтрока.Количество  = Число(ТабДок.Область("R" + НомерСтроки + "C5").Текст);

        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;

    Сообщить("Загружено строк: " + Паллеты.Количество());

КонецПроцедуры

#КонецОбласти


