			КонецЕсли;
			
			HTML = HTML + "<div class=""" + КлассСекции + """ style="""
				+ "width:" + ФорматЧислоHTML(ШиринаСекцииPx) + "px;"
				+ "height:" + ФорматЧислоHTML(ВысотаЭтажаPx) + "px;"">";
			
			// Имя секции
			HTML = HTML + "<div class=""section-name"">" + СекцияДанные.Наименование + "</div>";
			
			// Контейнер ячеек (пунктирное разделение)
			HTML = HTML + "<div class=""cells-container"">";
			
			// Переменные для free-space (заполняются в цикле ячеек)
			РасстЛевоСтр = "";
			РасстПравоСтр = "";
			
			// Ячейки секции (Адрес1, Адрес2, Адрес3)
			Для ИндексАдреса = 0 По КоличествоАдресов - 1 Цикл
				АдресЯчейки = Адреса[ИндексАдреса];
				ДанныеПаллетаВЯчейке = КартаАдресов.Получить(АдресЯчейки);
				
				// Класс ячейки: занята / физически перекрыта паллетом (белая) / свободна (зелёная)
				ДопАтрибутыЯчейки = "";
				Если ДанныеПаллетаВЯчейке <> Неопределено Тогда
					КлассЯчейки = "cell"; // паллет стоит
				ИначеЕсли ЯчейкаПерекрыта[ИндексАдреса] Тогда
					КлассЯчейки = "cell"; // физически наезжает соседний паллет — белая, недоступна
				Иначе
					КлассЯчейки = "cell cell-free"; // полностью свободна — зелёная + hover
					// Двойной клик по свободной ячейке — открыть карточку ячейки склада
					ГУИДЯчейки = Строка(АдресЯчейки.УникальныйИдентификатор());
					ДопАтрибутыЯчейки = " ondblclick=""openItem(event,'cell','" + ГУИДЯчейки + "')""";
				КонецЕсли;
				HTML = HTML + "<div class=""" + КлассЯчейки + """" + ДопАтрибутыЯчейки + ">";
				
				// Имя ячейки
				ИмяЯчейкиСтр = "";
				Если ИндексАдреса = 0 Тогда
					ИмяЯчейкиСтр = Строка(СекцияДанные.Адрес1);
				ИначеЕсли ИндексАдреса = 1 Тогда
					ИмяЯчейкиСтр = Строка(СекцияДанные.Адрес2);
				Иначе
					ИмяЯчейкиСтр = Строка(СекцияДанные.Адрес3);
				КонецЕсли;
				HTML = HTML + "<div class=""cell-name"">" + ИмяЯчейкиСтр + "</div>";
				
				Если ДанныеПаллетаВЯчейке <> Неопределено Тогда
					ПараметрыП = ПараметрыПаллетКэш.Получить(ДанныеПаллетаВЯчейке.ПаллетСсылка);
					ШиринаПаллетаМм = 0;
					ВысотаПаллетаМм = 0;
					ВесПаллета = 0;
					Если ПараметрыП <> Неопределено Тогда
						ШиринаПаллетаМм = ПараметрыП.Ширина;
						ВысотаПаллетаМм = ПараметрыП.Высота;
						ВесПаллета = ПараметрыП.Вес;
					КонецЕсли;
					
					// Паллет: реальная ширина
					ШиринаЯчейкиМм = ШиринаСекцииМм / КоличествоАдресов;
					ШиринаЯчейкиPx = ШиринаСекцииPx / КоличествоАдресов;
					ШиринаПаллетаPx = Окр(ШиринаПаллетаМм * КоэфМасштаба, 1);
					ВысотаПаллетаPx = Окр(ВысотаПаллетаМм * КоэфМасштаба, 1);
					Если ВысотаПаллетаPx > ВысотаЭтажаPx Тогда
						ВысотаПаллетаPx = ВысотаЭтажаPx;
					КонецЕсли;
					
					// Позиционирование: 1 адрес → центр; крайние → к ближнему краю; средний → центр секции
					Если КоличествоАдресов = 1 Тогда
						// Единственный адрес: паллет по центру всей секции
						СмещениеПаллетаPx = (ШиринаСекцииPx - ШиринаПаллетаPx) / 2;
					ИначеЕсли ИндексАдреса = 0 Тогда
						// Левый адрес: прижат к левому краю
						СмещениеПаллетаPx = 0;
					ИначеЕсли ИндексАдреса = КоличествоАдресов - 1 Тогда
						// Правый адрес: прижат к правому краю ячейки
						СмещениеПаллетаPx = ШиринаЯчейкиPx - ШиринаПаллетаPx;
					Иначе
						// Средний адрес (только для 3+): центр секции
						СмещениеПаллетаPx = (ШиринаСекцииPx - ШиринаПаллетаPx) / 2 - ИндексАдреса * ШиринаЯчейкиPx;
					КонецЕсли;
					
					Заблокирован = ДанныеПаллетаВЯчейке.Заблокирован;
					КоличествоПаллета = ДанныеПаллетаВЯчейке.Количество;
					
					// Определяем стиль: зарезервирован / занят
					Если Заблокирован > 0 И КоличествоПаллета = 0 Тогда
						КлассПаллета = "pallet-reserved";
						СтатусТекст = " [резерв]";
					Иначе
						КлассПаллета = "pallet-occupied";
						СтатусТекст = "";
					КонецЕсли;
					
					// Номер паллета
					НомерСтрока = Формат(ДанныеПаллетаВЯчейке.НомерПаллета, "ЧН=—; ЧГ=0");
					
					// Глубина паллета
					ГлубинаПаллетаМм = 0;
					Если ПараметрыП <> Неопределено Тогда
						ГлубинаПаллетаМм = ПараметрыП.Глубина;
					КонецЕсли;
					
					// Двойной клик на паллете — открыть карточку паллета
					ГУИДПаллета = Строка(ДанныеПаллетаВЯчейке.ПаллетСсылка.УникальныйИдентификатор());
					HTML = HTML + "<div class=""pallet " + КлассПаллета + """ ondblclick=""openItem(event,'pallet','" + ГУИДПаллета + "')"" style="""
						+ "left:" + ФорматЧислоHTML(СмещениеПаллетаPx) + "px;"
						+ "width:" + ФорматЧислоHTML(ШиринаПаллетаPx) + "px;"
						+ "height:" + ФорматЧислоHTML(ВысотаПаллетаPx) + "px;"">"
						+ "<div class=""pallet-label"">П" + НомерСтрока + СтатусТекст + "</div>"
						+ "<div class=""pallet-size"">"
						+ Формат(ГлубинаПаллетаМм, "ЧН=0; ЧГ=0") + "×"
						+ Формат(ШиринаПаллетаМм, "ЧН=0; ЧГ=0") + "×"
						+ Формат(ВысотаПаллетаМм, "ЧН=0; ЧГ=0")
						+ "</div></div>";
					
					// Свободное пространство — сохраняем для вывода в section
					Если КоличествоАдресов = 1 Тогда
						// Центральное размещение — свободно с обеих сторон
						РасстЛевоСтр = Формат(Окр((ШиринаСекцииМм - ШиринаПаллетаМм) / 2, 0), "ЧН=0; ЧГ=0");
						РасстПравоСтр = РасстЛевоСтр;
					ИначеЕсли ИндексАдреса = 0 Тогда
						// Левый — свободно только справа
						РасстЛевоСтр = "";
						РасстПравоСтр = Формат(Окр(ШиринаСекцииМм - ШиринаПаллетаМм, 0), "ЧН=0; ЧГ=0");
					ИначеЕсли ИндексАдреса = КоличествоАдресов - 1 Тогда
						// Правый — свободно только слева
						РасстЛевоСтр = Формат(Окр(ШиринаСекцииМм - ШиринаПаллетаМм, 0), "ЧН=0; ЧГ=0");
						РасстПравоСтр = "";
					Иначе
						// Средний (3 адреса) — свободно с обеих сторон
						РасстЛевоСтр = Формат(Окр((ШиринаСекцииМм - ШиринаПаллетаМм) / 2, 0), "ЧН=0; ЧГ=0");
						РасстПравоСтр = РасстЛевоСтр;
					КонецЕсли;
				КонецЕсли;
				
				HTML = HTML + "</div>"; // конец cell
			КонецЦикла;
			
			HTML = HTML + "</div>"; // конец cells-container
			
			// Свободное пространство — два блока от краёв паллета
			Если РасстЛевоСтр <> "" Тогда
				HTML = HTML + "<div class=""free-space-left"">← " + РасстЛевоСтр + " мм</div>";
			КонецЕсли;
			Если РасстПравоСтр <> "" Тогда
				HTML = HTML + "<div class=""free-space-right"">" + РасстПравоСтр + " мм →</div>";
			КонецЕсли;
			
			// Остаточный вес (если есть грузоподъемность)
			Если ВесогрузкаЭтажа > 0 Тогда
				ВесПаллетовВСекции = 0;
				Для ИндексАдреса = 0 По КоличествоАдресов - 1 Цикл
					ДанныеПВЯ = КартаАдресов.Получить(Адреса[ИндексАдреса]);
					Если ДанныеПВЯ <> Неопределено Тогда
						ПараметрыПВес = ПараметрыПаллетКэш.Получить(ДанныеПВЯ.ПаллетСсылка);
						Если ПараметрыПВес <> Неопределено Тогда
							ВесПаллетовВСекции = ВесПаллетовВСекции + ПараметрыПВес.Вес;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				ОстатокВеса = ВесогрузкаЭтажа - ВесПаллетовВСекции;
				HTML = HTML + "<div class=""weight-remaining"">ост: " + Формат(ОстатокВеса, "ЧН=0; ЧГ=0") + " кг</div>";
			КонецЕсли;
			
			HTML = HTML + "</div>"; // конец section
		КонецЦикла;
		
		HTML = HTML + "</div>"; // конец sections-row
		
		// Подпись ширины — только под нижним этажом (минимальный номер)
		ПервыйЭтажНомер = 99999;
		Для Каждого КлючЗначение Из СекцииПоЭтажам Цикл
			Если КлючЗначение.Ключ < ПервыйЭтажНомер Тогда
				ПервыйЭтажНомер = КлючЗначение.Ключ;
			КонецЕсли;
		КонецЦикла;
		Если НомерЭтажа = ПервыйЭтажНомер Тогда
			HTML = HTML + "<div class=""floor-width"" style=""display:flex;"">";
			Для Каждого СекцияДанныеШ Из МассивЭтажа Цикл
				HTML = HTML + "<div style=""flex:0 0 " + ФорматЧислоHTML(ШиринаСекцииPx) + "px;text-align:center;font-size:10px;color:#333;font-weight:bold;padding-top:2px;"">"
					+ Формат(ШиринаСекцииМм, "ЧН=0; ЧГ=0") + " мм</div>";
			КонецЦикла;
			HTML = HTML + "</div>";
		КонецЕсли;
		
		HTML = HTML + "</div>"; // конец floor
	КонецЦикла;
	
	// === Зоны приёмки/отгрузки ===
	ЗоныСтеллажа = СтеллажОбъект.ЗоныПриемкиОтгрузки;
	Если ЗоныСтеллажа.Количество() > 0 Тогда
		
		// --- Пакетный запрос для всех зон (вместо N+1) ---
		МассивАдресовЗон = Новый Массив;
		Для Каждого СтрокаЗоны Из ЗоныСтеллажа Цикл
			МассивАдресовЗон.Добавить(СтрокаЗоны.АдресХранения);
		КонецЦикла;
		
		ЗапросЗон = Новый Запрос;
		ЗапросЗон.Текст =
			"ВЫБРАТЬ
			|	Лико_ПаллетыВСекцияхОстатки.Адрес КАК Адрес,
			|	Лико_ПаллетыВСекцияхОстатки.Паллет КАК ПаллетСсылка,
			|	Лико_ПаллетыВСекцияхОстатки.КоличествоОстаток КАК Количество,
			|	Лико_ПаллетыВСекцияхОстатки.ЗаблокированОстаток КАК Заблокирован,
			|	Лико_Паллеты2_0.Код КАК НомерПаллета
			|ИЗ
			|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
			|		,
			|		Адрес В (&МассивАдресов)
			|	) КАК Лико_ПаллетыВСекцияхОстатки
			|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_Паллеты2_0 КАК Лико_Паллеты2_0
			|	ПО Лико_ПаллетыВСекцияхОстатки.Паллет = Лико_Паллеты2_0.Ссылка
			|ГДЕ
			|	Лико_ПаллетыВСекцияхОстатки.КоличествоОстаток > 0
			|	ИЛИ Лико_ПаллетыВСекцияхОстатки.ЗаблокированОстаток > 0";
		ЗапросЗон.УстановитьПараметр("МассивАдресов", МассивАдресовЗон);
		РезультатЗон = ЗапросЗон.Выполнить();
		
		// Индекс: Адрес -> Массив структур паллетов
		ИндексЗон = Новый Соответствие;
		Если НЕ РезультатЗон.Пустой() Тогда
			ВыборкаЗон = РезультатЗон.Выбрать();
			Пока ВыборкаЗон.Следующий() Цикл
				МассивПаллетЗоны = ИндексЗон.Получить(ВыборкаЗон.Адрес);
				Если МассивПаллетЗоны = Неопределено Тогда
					МассивПаллетЗоны = Новый Массив;
					ИндексЗон.Вставить(ВыборкаЗон.Адрес, МассивПаллетЗоны);
				КонецЕсли;
				МассивПаллетЗоны.Добавить(Новый Структура(
					"НомерПаллета, Количество, Заблокирован, ПаллетСсылка",
					ВыборкаЗон.НомерПаллета, ВыборкаЗон.Количество, ВыборкаЗон.Заблокирован, ВыборкаЗон.ПаллетСсылка));
			КонецЦикла;
		КонецЕсли;
		
		// --- Вывод зон (без запросов в цикле) ---
		HTML = HTML + "<div class=""zones-title"">Зоны приёмки/отгрузки:</div>";
		HTML = HTML + "<div class=""zones-row"">";
		
		Для Каждого СтрокаЗоны Из ЗоныСтеллажа Цикл
			ИмяЗоны = Строка(СтрокаЗоны.АдресХранения);
			МассивПаллетЗоны = ИндексЗон.Получить(СтрокаЗоны.АдресХранения);
			
			// Двойной клик на zone-box — открыть карточку ячейки зоны
			ГУИДЗоны = Строка(СтрокаЗоны.АдресХранения.УникальныйИдентификатор());
			ЗонаDblClick = " ondblclick=""openItem(event,'cell','" + ГУИДЗоны + "')""";
			
			HTML = HTML + "<div class=""zone-box""" + ЗонаDblClick + ">";
			HTML = HTML + "<div class=""zone-name"">" + ИмяЗоны + "</div>";
			
			Если МассивПаллетЗоны <> Неопределено Тогда
				// Авто-высота: все паллеты должны визуально влезать в ячейку зоны
				КоличествоПаллетЗоны = МассивПаллетЗоны.Количество();
				ВысотаПЗ = Макс(14, Цел(60 / КоличествоПаллетЗоны));
				
				Для Каждого ДанныеПЗ Из МассивПаллетЗоны Цикл
					НомерП = Формат(ДанныеПЗ.НомерПаллета, "ЧН=—; ЧГ=0");
					КлассПЗ = "pallet-occupied";
					СтатусЗ = "";
					Если ДанныеПЗ.Заблокирован > 0 И ДанныеПЗ.Количество = 0 Тогда
						КлассПЗ = "pallet-reserved";
						СтатусЗ = " [резерв]";
					КонецЕсли;
					// Двойной клик на паллете в зоне — открыть карточку паллета
					ГУИДПЗоны = Строка(ДанныеПЗ.ПаллетСсылка.УникальныйИдентификатор());
					ПаллетDblClick = " ondblclick=""openItem(event,'pallet','" + ГУИДПЗоны + "')""";
					HTML = HTML + "<div class=""pallet " + КлассПЗ + """" + ПаллетDblClick
						+ " style=""position:relative;width:100%;height:" + Формат(ВысотаПЗ, "ЧН=0; ЧГ=0") + "px;margin-bottom:2px;"">"
						+ "<div class=""pallet-label"">П" + НомерП + СтатусЗ + "</div>"
						+ "</div>";
				КонецЦикла;
			КонецЕсли;
			
			HTML = HTML + "</div>"; // конец zone-box
		КонецЦикла;
		
		HTML = HTML + "</div>"; // конец zones-row
	КонецЕсли;
	
	// === Легенда ===
	HTML = HTML + "<div class=""legend"">"
		+ "<b>Обозначения:</b><br>"
		+ "<div class=""legend-item""><span class=""legend-color"" style=""background:rgba(255,255,200,0.7);border:2px solid #888""></span> Занят паллет</div>"
		+ "<div class=""legend-item""><span class=""legend-color"" style=""background:rgba(255,255,220,0.5);border:2px dashed #888""></span> Зарезервирован (заблокирован, не стоит)</div>"
		+ "</div>";
	
	// === Правила размещения ===
	HTML = HTML + "<div class=""rules"">"
		+ "<b>Правила размещения паллет в секции:</b><br>"
		+ "1. Если ширина паллета > ⅔ ширины секции → 1 паллет, только в средний адрес<br>"
		+ "2. Если ширина паллета > ⅓ ширины секции → 2 паллета в крайние адреса (1 и 3)<br>"
		+ "3. Если ширина паллета ≤ ⅓ ширины секции → 3 паллета в три адреса"
		+ "</div>";
	
	HTML = HTML + "</div>"; // конец racking
	HTML = HTML + "</div>"; // конец #sc
	HTML = HTML + "</body></html>";
	
	html = HTML;
КонецПроцедуры

// ============================================================
// === Вспомогательные функции ================================
// ============================================================

&НаСервере
Функция ФорматЧислоHTML(Число)
	//+Лико m.shenderov 15.05.2026
	// Форматирует число для HTML (точка как разделитель дробной части)
	Возврат Формат(Число, "ЧРД=.; ЧН=0; ЧГ=0");
КонецФункции

&НаСервере
Функция ЦветВHex(Цвет)
	//+Лико m.shenderov 15.05.2026
	Если Цвет = Неопределено Тогда
		Возврат "#808080";
	КонецЕсли;
	
	Возврат "#" + ВРег(ПривестиЦветКHex(Цвет.Красный))
		+ ВРег(ПривестиЦветКHex(Цвет.Зеленый))
		+ ВРег(ПривестиЦветКHex(Цвет.Синий));
КонецФункции

&НаСервере
Функция ПривестиЦветКHex(ЗначениеЦвета)
	//+Лико m.shenderov 15.05.2026
	Результат = ВРег(ПолучитьHexСтроку(Цел(ЗначениеЦвета / 16)))
		+ ВРег(ПолучитьHexСтроку(ЗначениеЦвета % 16));
	Возврат Результат;
КонецФункции

&НаСервере
Функция ПолучитьHexСтроку(Значение)
	//+Лико m.shenderov 15.05.2026
	Если Значение < 10 Тогда
		Возврат Строка(Значение);
	ИначеЕсли Значение = 10 Тогда
		Возврат "A";
	ИначеЕсли Значение = 11 Тогда
		Возврат "B";
	ИначеЕсли Значение = 12 Тогда
		Возврат "C";
	ИначеЕсли Значение = 13 Тогда
		Возврат "D";
	ИначеЕсли Значение = 14 Тогда
		Возврат "E";
	Иначе
		Возврат "F";
	КонецЕсли;
КонецФункции

&НаСервере
Функция ПолучитьСсылкуПоГУИД(ТипОбъекта, ГУИДСтрока)
	//+Лико m.shenderov 20.05.2026
	// Возвращает ссылку на объект 1С по типу ("pallet"/"cell") и GUID-строке из HTML
	Попытка
		Если ГУИДСтрока = "00000000-0000-0000-0000-000000000000" Тогда
			Возврат Неопределено;
		КонецЕсли;
		ГУИД = Новый УникальныйИдентификатор(ГУИДСтрока);
		Если ТипОбъекта = "pallet" Тогда
			Возврат Справочники.Лико_Паллеты2_0.ПолучитьСсылку(ГУИД);
		ИначеЕсли ТипОбъекта = "cell" Тогда
			Возврат Справочники.СкладскиеЯчейки.ПолучитьСсылку(ГУИД);
		КонецЕсли;
	Исключение
		Лико_ДополнительноКлиентСервер.СообщитьДляКлиента("Ошибка получения ссылки: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

#КонецОбласти
