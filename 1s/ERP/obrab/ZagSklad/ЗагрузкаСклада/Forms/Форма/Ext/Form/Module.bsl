//+Лико m.shenderov 26.06.2026 — In-memory версия ПодобратьЯчейку на предзагруженной ТЗ
&НаСервере
Функция ПодобратьЯчейкуВПамяти(Склад, Высота, Ширина, Глубина, Вес,
	ОбратныйПорядокВремени = Ложь, Все = Ложь,
	СекцииСОстатки) Экспорт

	ШиринаЯчейки = Справочники.Лико_ПредопределенныеЗначения.ШиринаСкладскойСекции.ЗначениеПараметра / 3;
	Потенциал3ПаллетаВСекции = (Ширина <= ШиринаЯчейки);

	// Создаём ТЗ кандидатов: 12 колонок
	СекцииКандидаты = Новый ТаблицаЗначений;
	СекцииКандидаты.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.Лико_СкладскиеСекции"));
	СекцииКандидаты.Колонки.Добавить("Адрес", Новый ОписаниеТипов("СправочникСсылка.СкладскиеЯчейки"));
	СекцииКандидаты.Колонки.Добавить("Приоритет0", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0)));
	СекцииКандидаты.Колонки.Добавить("Приоритет1", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0)));
	СекцииКандидаты.Колонки.Добавить("Приоритет2", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0)));
	СекцииКандидаты.Колонки.Добавить("Приоритет3", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0)));
	СекцииКандидаты.Колонки.Добавить("Приоритет4", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0)));
	СекцииКандидаты.Колонки.Добавить("Приоритет5", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0)));
	СекцииКандидаты.Колонки.Добавить("Приоритет6", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0)));
	СекцииКандидаты.Колонки.Добавить("Приоритет7", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0)));
	СекцииКандидаты.Колонки.Добавить("Приоритет8", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0)));
	СекцииКандидаты.Колонки.Добавить("Приоритет9", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0)));
	СекцииКандидаты.Колонки.Добавить("Приоритет10", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0)));

	ПустаяСсылкаПаллет = Справочники.Лико_Паллеты2_0.ПустаяСсылка();
	ПустаяСсылкаЯчейка = Справочники.СкладскиеЯчейки.ПустаяСсылка();

	Для Каждого СтрокаСекции Из СекцииСОстатки Цикл

		// === WHERE-1: size/dimension filters (из ВТСекции WHERE) ===

		Если СтрокаСекции.ТР_Глубина < Глубина Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаСекции.ТР_Высота < Высота Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ СтрокаСекции.ТР_НеОграниченаПоГрузоподъемности
			И СтрокаСекции.ТР_Вес < Вес Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаСекции.МаксимальныйВесПодъёмаНаЭтаж <> 0
			И СтрокаСекции.МаксимальныйВесПодъёмаНаЭтаж < Вес Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаСекции.ЗапретРазмещения Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаСекции.МинШиринаПаллета <> 0
			И СтрокаСекции.МинШиринаПаллета > Ширина Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаСекции.МаксШиринаПаллета <> 0
			И СтрокаСекции.МаксШиринаПаллета < Ширина Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ СтрокаСекции.МинимальнаяГлубинаНеОграничена
			И СтрокаСекции.МинГлубинаПаллета <> 0
			И СтрокаСекции.МинГлубинаПаллета > Глубина Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ СтрокаСекции.МаксимальнаяГлубинаНеОграничена
			И СтрокаСекции.МаксГлубинаПаллета <> 0
			И СтрокаСекции.МаксГлубинаПаллета < Глубина Тогда
			Продолжить;
		КонецЕсли;

		// === WHERE-2: physical constraints ===

		// At least one free address
		Если ЗначениеЗаполнено(СтрокаСекции.Паллет1)
			И ЗначениеЗаполнено(СтрокаСекции.Паллет2)
			И ЗначениеЗаполнено(СтрокаСекции.Паллет3) Тогда
			Продолжить;
		КонецЕсли;

		// ОстатокШирина >= ТР_Ширина / 3
		ОстатокШирина = СтрокаСекции.ТР_Ширина
			- (СтрокаСекции.ТРП1_Ширина + СтрокаСекции.ТРП2_Ширина + СтрокаСекции.ТРП3_Ширина);
		Если ОстатокШирина < СтрокаСекции.ТР_Ширина / 3 Тогда
			Продолжить;
		КонецЕсли;

		// Вес <= ОстатокВес (or unlimited)
		ОстатокВес = СтрокаСекции.ТР_Вес
			- (СтрокаСекции.ТРП1_Вес + СтрокаСекции.ТРП2_Вес + СтрокаСекции.ТРП3_Вес);
		Если НЕ СтрокаСекции.ТР_НеОграниченаПоГрузоподъемности
			И Вес > ОстатокВес Тогда
			Продолжить;
		КонецЕсли;

		// If Паллет2 occupied → ТРП2_Ширина < ТР_Ширина / 3
		Если ЗначениеЗаполнено(СтрокаСекции.Паллет2)
			И СтрокаСекции.ТРП2_Ширина >= СтрокаСекции.ТР_Ширина / 3 Тогда
			Продолжить;
		КонецЕсли;

		// Width-based vacancy check
		Если Ширина > СтрокаСекции.ТР_Ширина / 2 Тогда
			// Need all 3 addresses empty
			Если ЗначениеЗаполнено(СтрокаСекции.Паллет1)
				Или ЗначениеЗаполнено(СтрокаСекции.Паллет2)
				Или ЗначениеЗаполнено(СтрокаСекции.Паллет3) Тогда
				Продолжить;
			КонецЕсли;
		ИначеЕсли Ширина > СтрокаСекции.ТР_Ширина / 3 Тогда
			// Адрес2 empty + (Адрес1 empty OR Адрес3 empty)
			Если ЗначениеЗаполнено(СтрокаСекции.Паллет2)
				Или (ЗначениеЗаполнено(СтрокаСекции.Паллет1)
					И ЗначениеЗаполнено(СтрокаСекции.Паллет3)) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		// === Address computation (ВЫБОР КОГДА) ===
		Адрес = ПустаяСсылкаЯчейка;

		Если Ширина > СтрокаСекции.ТР_Ширина / 2 Тогда
			Адрес = СтрокаСекции.Адрес2;
		ИначеЕсли Ширина > СтрокаСекции.ТР_Ширина / 3 Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаСекции.Паллет1) Тогда
				Адрес = СтрокаСекции.Адрес1;
			Иначе
				Адрес = СтрокаСекции.Адрес3;
			КонецЕсли;
		Иначе
			Если НЕ ЗначениеЗаполнено(СтрокаСекции.Паллет1) Тогда
				Адрес = СтрокаСекции.Адрес1;
			ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаСекции.Паллет2)
					И СтрокаСекции.ТРП1_Ширина <= СтрокаСекции.ТР_Ширина / 3
					И (НЕ ЗначениеЗаполнено(СтрокаСекции.Паллет3)
						Или СтрокаСекции.ТРП3_Ширина <= СтрокаСекции.ТР_Ширина / 3) Тогда
				Адрес = СтрокаСекции.Адрес2;
			ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаСекции.Паллет3) Тогда
				Адрес = СтрокаСекции.Адрес3;
			КонецЕсли;
		КонецЕсли;

		// Address must be non-empty (replicates final WHERE condition lines 422)
		Если НЕ ЗначениеЗаполнено(Адрес) Тогда
			Продолжить;
		КонецЕсли;

		// === Compute 11 priorities ===

		// Приоритет0: Узкопроходный (1 = VNA, 0 = wide)
		Приоритет0 = ?(СтрокаСекции.Узкопроходный, 1, 0);

		// Приоритет1: ДельтаГрузоподъемности (999999 if unlimited, else ТР_Вес - Вес)
		Приоритет1 = ?(СтрокаСекции.ТР_НеОграниченаПоГрузоподъемности,
			999999,
			СтрокаСекции.ТР_Вес - Вес);

		// Приоритет2: МинимальнаяГлубинаНеОграничена (0 = limited first, 1 = unlimited)
		Приоритет2 = ?(СтрокаСекции.МинимальнаяГлубинаНеОграничена, 1, 0);

		// Приоритет3: ОстатокВысота (ТР_Высота - Высота)
		Приоритет3 = СтрокаСекции.ТР_Высота - Высота;

		// Потенциал секции (from _Приоритет4_ПотенцилаСекции_Убыв, lines 344-359)
		Паллет1Заполнен = ЗначениеЗаполнено(СтрокаСекции.Паллет1);
		Паллет3Заполнен = ЗначениеЗаполнено(СтрокаСекции.Паллет3);

		Если Паллет1Заполнен
			И СтрокаСекции.ТРП1_Ширина > СтрокаСекции.ТР_Ширина / 3
			И НЕ Паллет3Заполнен Тогда
			Потенциал = 2;
		ИначеЕсли Паллет3Заполнен
			И СтрокаСекции.ТРП3_Ширина > СтрокаСекции.ТР_Ширина / 3
			И НЕ Паллет1Заполнен Тогда
			Потенциал = 2;
		ИначеЕсли (НЕ Паллет1Заполнен Или СтрокаСекции.ТРП1_Ширина <= СтрокаСекции.ТР_Ширина / 3)
			И (НЕ Паллет3Заполнен Или СтрокаСекции.ТРП3_Ширина <= СтрокаСекции.ТР_Ширина / 3) Тогда
			Потенциал = 3;
		Иначе
			Потенциал = 0;
		КонецЕсли;

		// Приоритет4: keep positive if Потенциал3 (sort УБЫВ puts 3 first),
		//             negate if not Потенциал3 (sort УБЫВ puts 0 first = ASC equivalent)
		Если Потенциал3ПаллетаВСекции Тогда
			Приоритет4 = Потенциал;
		Иначе
			Приоритет4 = -Потенциал;
		КонецЕсли;

		// Приоритет5: ОстатокВесЯчейка
		МаксКолПаллетов = Цел(СтрокаСекции.ШиринаСекции / Ширина);
		Если МаксКолПаллетов < 1 Тогда
			МаксКолПаллетов = 1;
		КонецЕсли;
		Приоритет5 = СтрокаСекции.ТР_Вес / МаксКолПаллетов - Вес;

		// Приоритет6: ТР_Вес (full section weight capacity)
		Приоритет6 = СтрокаСекции.ТР_Вес;

		// Приоритет7: ОстатокШирина
		Приоритет7 = ОстатокШирина;

		// Приоритет8: ОстатокВес
		Приоритет8 = ОстатокВес;

		// Приоритет9: УровеньДоступа (negate if ОбратныйПорядокВремени)
		Если ОбратныйПорядокВремени Тогда
			Приоритет9 = -СтрокаСекции.УровеньДоступа;
		Иначе
			Приоритет9 = СтрокаСекции.УровеньДоступа;
		КонецЕсли;

		// Приоритет10: ВремяДоступа (negate if ОбратныйПорядокВремени)
		Если ОбратныйПорядокВремени Тогда
			Приоритет10 = -СтрокаСекции.ВремяДоступа;
		Иначе
			Приоритет10 = СтрокаСекции.ВремяДоступа;
		КонецЕсли;

		// Add to candidates
		НоваяСтрока = СекцииКандидаты.Добавить();
		НоваяСтрока.Ссылка = СтрокаСекции.Ссылка;
		НоваяСтрока.Адрес = Адрес;
		НоваяСтрока.Приоритет0 = Приоритет0;
		НоваяСтрока.Приоритет1 = Приоритет1;
		НоваяСтрока.Приоритет2 = Приоритет2;
		НоваяСтрока.Приоритет3 = Приоритет3;
		НоваяСтрока.Приоритет4 = Приоритет4;
		НоваяСтрока.Приоритет5 = Приоритет5;
		НоваяСтрока.Приоритет6 = Приоритет6;
		НоваяСтрока.Приоритет7 = Приоритет7;
		НоваяСтрока.Приоритет8 = Приоритет8;
		НоваяСтрока.Приоритет9 = Приоритет9;
		НоваяСтрока.Приоритет10 = Приоритет10;

	КонецЦикла;

	// Sort candidates
	СекцииКандидаты.Сортировать("Приоритет0 УБЫВ, Приоритет1, Приоритет2, Приоритет3, "
		+ "Приоритет4 УБЫВ, Приоритет5, Приоритет6, Приоритет7, Приоритет8, "
		+ "Приоритет9, Приоритет10");

	// Return
	Если Все Тогда
		Возврат СекцииКандидаты;
	Иначе
		Если СекцииКандидаты.Количество() > 0 Тогда
			Возврат СекцииКандидаты[0].Адрес;
		Иначе
			Возврат ПустаяСсылкаЯчейка;
		КонецЕсли;
	КонецЕсли;

КонецФункции

//+Лико m.shenderov 26.06.2026 — Главный цикл симуляции размещения паллет
&НаСервере
Процедура РазместитьПаллетыНаСервере()

	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Сообщить("Выберите склад");
		Возврат;
	КонецЕсли;

	Если Паллеты.Количество() = 0 Тогда
		Сообщить("Нет данных в таблице Паллеты. Сначала загрузите из Excel.");
		Возврат;
	КонецЕсли;

	// 1. Загружаем секции с текущими остатками из БД
	СекцииСОстатки = ЗагрузитьСекцииСОстатки(Склад);

	Если СекцииСОстатки.Количество() = 0 Тогда
		Сообщить("На складе нет секций. Размещение невозможно.");
		Возврат;
	КонецЕсли;

	// 2. Расширяем тип колонок Паллет1/2/3, чтобы принимать строки (виртуальные коды "В001")
	//    В запросе эти колонки — CatalogRef.Лико_Паллеты2_0; после расширения — CatalogRef + Строка
	ОТ_Паллет = Новый ОписаниеТипов("Строка, СправочникСсылка.Лико_Паллеты2_0");
	СекцииСОстатки.Колонки.Паллет1.ТипЗначения = ОТ_Паллет;
	СекцииСОстатки.Колонки.Паллет2.ТипЗначения = ОТ_Паллет;
	СекцииСОстатки.Колонки.Паллет3.ТипЗначения = ОТ_Паллет;

	// 3. Симуляция: перебираем типоразмеры из Паллеты, пытаемся разместить
	НомерВиртуальногоПаллета = 0;
	РазмещеноВсего = 0;
	ВсегоПаллет = 0;

	Для Каждого СтрокаПаллеты Из Паллеты Цикл

		ВсегоПаллет = ВсегоПаллет + СтрокаПаллеты.Количество;
		РазмещеноЭтогоТипа = 0;
		ПервыйАдрес = "";

		Для Сч = 1 По СтрокаПаллеты.Количество Цикл

			АдресЯчейки = ПодобратьЯчейкуВПамяти(Склад,
				СтрокаПаллеты.Высота,
				СтрокаПаллеты.Ширина,
				СтрокаПаллеты.Глубина,
				СтрокаПаллеты.Вес,
				Ложь, Ложь,
				СекцииСОстатки);

			Если НЕ ЗначениеЗаполнено(АдресЯчейки) Тогда
				Прервать; // для этого типоразмера места больше нет
			КонецЕсли;

			НомерВиртуальногоПаллета = НомерВиртуальногоПаллета + 1;
			РазмещеноЭтогоТипа = РазмещеноЭтогоТипа + 1;

			Если ПервыйАдрес = "" Тогда
				ПервыйАдрес = Строка(АдресЯчейки.Наименование);
			КонецЕсли;

			// Найти строку секции и записать виртуальный паллет
			ТекСтрока = НайтиСтрокуСекцииПоАдресу(АдресЯчейки, СекцииСОстатки);
			Если ТекСтрока <> Неопределено Тогда
				ЗаписатьПаллетВСекцию(ТекСтрока, АдресЯчейки,
					НомерВиртуальногоПаллета,
					СтрокаПаллеты.Типоразмер,
					СтрокаПаллеты.Ширина,
					СтрокаПаллеты.Вес);
			КонецЕсли;

		КонецЦикла;

		РазмещеноВсего = РазмещеноВсего + РазмещеноЭтогоТипа;

		// Выставляем Адрес в строке Паллеты (первый адрес размещения)
		Если ПервыйАдрес <> "" Тогда
			СтрокаПаллеты.Адрес = ПервыйАдрес;
		КонецЕсли;

	КонецЦикла;

	// 4. Статистика
	НеРазмещено = ВсегоПаллет - РазмещеноВсего;
	Сообщить("Размещено виртуальных паллет: " + Строка(РазмещеноВсего)
		+ " из " + Строка(ВсегоПаллет)
		+ ". Не размещено: " + Строка(НеРазмещено));

КонецПроцедуры

//+Лико m.shenderov 26.06.2026 — Поиск строки секции по адресу ячейки (Адрес1/Адрес2/Адрес3)
&НаСервере
Функция НайтиСтрокуСекцииПоАдресу(Адрес, СекцииСОстатки)

	Для Каждого Стр Из СекцииСОстатки Цикл
		Если Стр.Адрес1 = Адрес
			Или Стр.Адрес2 = Адрес
			Или Стр.Адрес3 = Адрес Тогда
			Возврат Стр;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

//+Лико m.shenderov 26.06.2026 — Запись виртуального паллета в строку секции (в нужный слот 1/2/3)
&НаСервере
Процедура ЗаписатьПаллетВСекцию(СтрокаСекции, Адрес, НомерПаллета, Типоразмер, Ширина, Вес)

	КодПаллета = "В" + Формат(НомерПаллета, "ЧЦ=3; ЧВН=; ЧГ=");

	Если СтрокаСекции.Адрес1 = Адрес Тогда
		СтрокаСекции.Паллет1 = КодПаллета;
		СтрокаСекции.ТипоразмерПаллета1 = Типоразмер;
		СтрокаСекции.ТРП1_Ширина = Ширина;
		СтрокаСекции.ТРП1_Вес = Вес;
	ИначеЕсли СтрокаСекции.Адрес2 = Адрес Тогда
		СтрокаСекции.Паллет2 = КодПаллета;
		СтрокаСекции.ТипоразмерПаллета2 = Типоразмер;
		СтрокаСекции.ТРП2_Ширина = Ширина;
		СтрокаСекции.ТРП2_Вес = Вес;
	ИначеЕсли СтрокаСекции.Адрес3 = Адрес Тогда
		СтрокаСекции.Паллет3 = КодПаллета;
		СтрокаСекции.ТипоразмерПаллета3 = Типоразмер;
		СтрокаСекции.ТРП3_Ширина = Ширина;
		СтрокаСекции.ТРП3_Вес = Вес;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
