#Область LLM

 ////////////////////////////////////////////////////////////////////////////////
// МОДУЛЬ РАБОТЫ С LLM (OpenAI-совместимый API)
// Инструменты, форматы данных, транспорт, история диалога, оркестратор, тесты.
// ВНИМАНИЕ: имя "Параметры" зарезервировано формой — везде используется НастройкиLLM.
////////////////////////////////////////////////////////////////////////////////

#Область LLM_ФорматыДанных

// Конвертация ТаблицыЗначений в строку для LLM. Формат: "markdown" | "json".
&НаСервере
Функция ТаблицаДляLLM(ТаблицаЗначений, Формат = "markdown") Экспорт
    Если ТаблицаЗначений.Количество() = 0 Тогда
        Возврат "Данные не найдены.";
    КонецЕсли;
    Если Формат = "json" Тогда
        Возврат ТаблицаВJSON(ТаблицаЗначений);
    Иначе
        Возврат ТаблицаВМаркдаун(ТаблицаЗначений);
    КонецЕсли;
КонецФункции

&НаСервере
Функция ЗначениеВТекст(Значение)
    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Текст = Строка(Значение);
    Текст = СтрЗаменить(Текст, "|", "\|");
    Текст = СтрЗаменить(Текст, Символы.ПС, " ");
    Текст = СтрЗаменить(Текст, Символы.ВК, "");
    Возврат СокрЛП(Текст);
КонецФункции

&НаСервере
Функция ТаблицаВМаркдаун(ТаблицаЗначений)
    Заголовки   = Новый Массив;
    Разделители = Новый Массив;
    Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
        Заголовки.Добавить(Колонка.Имя);
        Разделители.Добавить("---");
    КонецЦикла;

    Строки = Новый Массив;
    Строки.Добавить("| " + СтрСоединить(Заголовки,   " | ") + " |");
    Строки.Добавить("| " + СтрСоединить(Разделители, " | ") + " |");

    Для Каждого Строка Из ТаблицаЗначений Цикл
        Ячейки = Новый Массив;
        Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
            Ячейки.Добавить(ЗначениеВТекст(Строка[Колонка.Имя]));
        КонецЦикла;
        Строки.Добавить("| " + СтрСоединить(Ячейки, " | ") + " |");
    КонецЦикла;

    Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

&НаСервере
Функция ТаблицаВJSON(ТаблицаЗначений)
    Массив = Новый Массив;
    Для Каждого Строка Из ТаблицаЗначений Цикл
        Элемент = Новый Структура;
        Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
            Значение = Строка[Колонка.Имя];
            Если ТипЗнч(Значение) = Тип("Дата") Тогда
                Значение = ?(ЗначениеЗаполнено(Значение),
                    Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss"), "");
            КонецЕсли;
            Элемент.Вставить(Колонка.Имя, Значение);
        КонецЦикла;
        Массив.Добавить(Элемент);
    КонецЦикла;
    Возврат СериализоватьJSON(Массив);
КонецФункции

#КонецОбласти

#Область LLM_Транспорт

&НаСервере
Функция ОтправитьHTTP(URLСервера, Путь, КлючAPI, Тело, Таймаут, Порт = 443, ИспользоватьSSL = Истина)
    Результат = Новый Структура("Успех, Данные, ОписаниеОшибки", Ложь, Неопределено, "");

    // Защита от двойной сериализации: сюда должна приходить Структура, не Строка.
    Если ТипЗнч(Тело) = Тип("Строка") Тогда
        Результат.ОписаниеОшибки =
            "ОтправитьHTTP: в параметр Тело передана Строка вместо Структуры."
            + " Уберите повторный вызов СериализоватьJSON выше по стеку.";
        Возврат Результат;
    КонецЕсли;

    Попытка
        Заголовки = Новый Соответствие;
        Заголовки.Вставить("Content-Type",  "application/json");
        Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);

        Защита = ?(ИспользоватьSSL, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
        HTTPСоединение = Новый HTTPСоединение(
            URLСервера, Порт, , , , Таймаут, Защита);

        HTTPЗапрос = Новый HTTPЗапрос(Путь, Заголовки);
        HTTPЗапрос.УстановитьТелоИзСтроки(СериализоватьJSON(Тело), "UTF-8");

        ОтветHTTP  = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
        ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8");

        Если ОтветHTTP.КодСостояния < 200 ИЛИ ОтветHTTP.КодСостояния >= 300 Тогда
            Результат.ОписаниеОшибки = "HTTP " + ОтветHTTP.КодСостояния + ": " + ТелоОтвета;
            ЗаписьЖурналаРегистрации("LLM.Ошибка",
                УровеньЖурналаРегистрации.Ошибка, , , Результат.ОписаниеОшибки);
            Возврат Результат;
        КонецЕсли;

        Результат.Данные = ДесериализоватьJSON(ТелоОтвета);
        Результат.Успех  = Истина;
    Исключение
        Результат.ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        ЗаписьЖурналаРегистрации("LLM.Исключение",
            УровеньЖурналаРегистрации.Ошибка, , , Результат.ОписаниеОшибки);
    КонецПопытки;

    Возврат Результат;
КонецФункции

// Развилка транспорта: реальный API или заглушка (для тестов).
&НаСервере
Функция ОтправитьЗапросТранспорт(НастройкиLLM, Тело)
    Если ПолучитьНастройку(НастройкиLLM, "РежимЗаглушки", Ложь) Тогда
        Возврат ЗаглушкаОтвета(НастройкиLLM, Тело);
    Иначе
        Возврат ОтправитьHTTP(
            НастройкиLLM.URLСервера, НастройкиLLM.Путь, НастройкиLLM.КлючAPI,
            Тело, ПолучитьНастройку(НастройкиLLM, "Таймаут", 240),
            ПолучитьНастройку(НастройкиLLM, "Порт", 443),
            ПолучитьНастройку(НастройкиLLM, "ИспользоватьSSL", Истина));
    КонецЕсли;
КонецФункции

#КонецОбласти

#Область LLM_История

&НаСервере
Функция НоваяИсторияДиалога(СистемныйПромпт = "", ФорматОтвета = "text", ПостоянныйКонтекст = "") Экспорт
    История = Новый Массив;
    Текст   = СистемныйПромпт + ИнструкцияФормата(ФорматОтвета);

    Если ЗначениеЗаполнено(ПостоянныйКонтекст) Тогда
        Текст = Текст + Символы.ПС + Символы.ПС
            + "=== СПРАВОЧНЫЕ ДАННЫЕ ===" + Символы.ПС + ПостоянныйКонтекст;
    КонецЕсли;

    //+Лико m.shenderov 15.06.2026 — Анти-галлюцинационные ограничения
    Текст = Текст + Символы.ПС + Символы.ПС
        + "=== ЖЁСТКИЕ ОГРАНИЧЕНИЯ ===" + Символы.ПС
        + "1. НЕ ВЫДУМЫВАТЬ поля, приоритеты, правила, которых нет в СПРАВОЧНЫХ ДАННЫХ. "
        + "Если информации недостаточно — напиши «В документации этого нет» и остановись." + Символы.ПС
        + "2. При перечислении элементов (ORDER BY, проверки, поля) — КОПИРУЙ дословно из СПРАВОЧНЫХ ДАННЫХ. "
        + "Не добавляй пункты. Не меняй порядок. Не перефразируй названия." + Символы.ПС
        + "3. Любое утверждение о логике работы должно сопровождаться цитатой из кода или документации выше. "
        + "Не можешь найти цитату — не пиши утверждение." + Символы.ПС
        + "4. Перед ответом пересчитай количество пунктов в своём списке и сравни с оригиналом. "
        + "Не сошлось — удали лишнее." + Символы.ПС
        + "5. НЕ интерпретируй SQL/код «как тебе кажется». "
        + "Смысл правил описан в КОММЕНТАРИЯХ и тексте, а не в названиях полей." + Символы.ПС
        + "6. Узкопроходный = Истина → стеллаж узкопроходный (VNA), приоритет в ORDER BY. "
        + "Узкопроходный = Ложь → широкопроходный, заполняется после узкопроходных. "
        + "Узкопроходные стеллажи: 1, 2, 3, 4, 5, 6, 7, 10. "
        + "Широкопроходные стеллажи: 8А, 9. "
        + "МаксШиринаПаллета, МинШиринаПаллета, МаксГлубинаПаллета, МинГлубинаПаллета — "
        + "это жёсткие ФИЛЬТРЫ в WHERE (паллет не влез → ОТСЕЯН). "
        + "МинимальнаяГлубинаНеОграничена / МаксимальнаяГлубинаНеОграничена — "
        + "отменяют проверку глубины стеллажа для конкретной секции. "
        + "МаксимальныйВесПодъёмаНаЭтаж — максимальный вес ОДНОГО паллета на этаже (0 = без ограничения).";

    Если ЗначениеЗаполнено(Текст) Тогда
        ДобавитьСообщение(История, "system", Текст);
    КонецЕсли;
    Возврат История;
КонецФункции

&НаСервере
Процедура ДобавитьСообщение(Сообщения, Роль, Текст) Экспорт
    Сообщения.Добавить(Новый Структура("role, content", Роль, Текст));
КонецПроцедуры

// Сообщение ассистента вместе с tool_calls — обязательно для function calling.
&НаСервере
Процедура ДобавитьСообщениеАссистентаСВызовами(Сообщения, СообщениеИзОтвета) Экспорт
    Сообщение = Новый Структура;
    Сообщение.Вставить("role", "assistant");

    // content может ОТСУТСТВОВАТЬ в Структуре при чистом tool_calls.
    Если СообщениеИзОтвета.Свойство("content") Тогда
        Содержимое = СообщениеИзОтвета["content"];
        Если ЗначениеЗаполнено(Содержимое) Тогда
            Сообщение.Вставить("content", Содержимое);
        КонецЕсли;
    КонецЕсли;

    // tool_calls тоже проверяем на наличие.
    Если СообщениеИзОтвета.Свойство("tool_calls") Тогда
        Сообщение.Вставить("tool_calls", СообщениеИзОтвета["tool_calls"]);
    КонецЕсли;

    Сообщения.Добавить(Сообщение);
КонецПроцедуры

// Результат выполнения инструмента (роль tool). content — всегда строка.
&НаСервере
Процедура ДобавитьРезультатИнструмента(Сообщения, IDВызова, РезультатСтрока) Экспорт
    Сообщение = Новый Структура;
    Сообщение.Вставить("role",         "tool");
    Сообщение.Вставить("tool_call_id", IDВызова);
    Сообщение.Вставить("content",      Строка(РезультатСтрока));
    Сообщения.Добавить(Сообщение);
КонецПроцедуры

#КонецОбласти

#Область LLM_Оркестратор

// Основная точка входа. ИсторияДиалога передаётся ПО ССЫЛКЕ и накапливается.
// НастройкиLLM передаются БЕЗ Знач — заглушка хранит шаг в массиве-состоянии.
// КонтекстВопроса — данные ТОЛЬКО для текущей реплики (постоянный контекст — в system).
&НаСервере
Функция СпроситьLLM(ИсторияДиалога, Вопрос, НастройкиLLM,
                    Инструменты = Неопределено, ФорматОтвета = "text",
                    КонтекстВопроса = Неопределено) Экспорт

    МаксИтераций = ПолучитьНастройку(НастройкиLLM, "МаксИтерацийИнструментов", 5);

    ДобавитьСообщение(ИсторияДиалога, "user", СформироватьВопрос(Вопрос, КонтекстВопроса));

    Для Итерация = 1 По МаксИтераций Цикл

        Тело = СформироватьТелоЗапроса(ИсторияДиалога, Инструменты, НастройкиLLM, ФорматОтвета);

        ОтветТранспорта = ОтправитьЗапросТранспорт(НастройкиLLM, Тело);

        Если НЕ ОтветТранспорта.Успех Тогда
            Результат = НовыйРезультатLLM();
            Результат.ОписаниеОшибки = ОтветТранспорта.ОписаниеОшибки;
            Возврат Результат;
        КонецЕсли;

        Результат           = НормализоватьОтвет(ОтветТранспорта.Данные, ФорматОтвета);
        СообщениеАссистента = ОтветТранспорта.Данные["choices"][0]["message"];

        Если Результат.ВызовыИнструментов.Количество() = 0 Тогда
            ДобавитьСообщение(ИсторияДиалога, "assistant", Результат.Текст);
            Возврат Результат;
        КонецЕсли;

               ДобавитьСообщениеАссистентаПоВызовам(ИсторияДиалога, Результат.ВызовыИнструментов);
        Для Каждого Вызов Из Результат.ВызовыИнструментов Цикл
            РезультатИнструмента = ВыполнитьИнструмент(Вызов.Имя, Вызов.Аргументы);
            ДобавитьРезультатИнструмента(ИсторияДиалога, Вызов.ID, РезультатИнструмента);
        КонецЦикла;

        // Диагностика: размер контекста после инструментов
        РазмерИстории = 0;
        Для Каждого Сообщение Из ИсторияДиалога Цикл
            РазмерИстории = РазмерИстории + СтрДлина(СериализоватьJSON(Сообщение));
        КонецЦикла;
        Сообщить("LLM: итерация " + Итерация + " из " + МаксИтераций
            + ", сообщений=" + ИсторияДиалога.Количество()
            + ", ~символов=" + РазмерИстории);
    КонецЦикла;

    Результат = НовыйРезультатLLM();
    Результат.ОписаниеОшибки = "Превышен лимит итераций инструментов (" + МаксИтераций + ").";
    Возврат Результат;
КонецФункции

#КонецОбласти

#Область LLM_Внутренние

&НаСервере
Функция СформироватьТелоЗапроса(ИсторияСообщений, Инструменты, НастройкиLLM, ФорматОтвета)
    Тело = Новый Структура;
    Тело.Вставить("model",       НастройкиLLM.МодельID);
    Тело.Вставить("messages",    ИсторияСообщений);
    Тело.Вставить("temperature", ПолучитьНастройку(НастройкиLLM, "Температура", 0.1));
    Тело.Вставить("max_tokens",  ПолучитьНастройку(НастройкиLLM, "МаксТокенов", 4096));

    Если Инструменты <> Неопределено И Инструменты.Количество() > 0 Тогда
        Тело.Вставить("tools",       Инструменты);
        Тело.Вставить("tool_choice", "auto");
    ИначеЕсли ФорматОтвета = "json" Тогда
        Тело.Вставить("response_format", Новый Структура("type", "json_object"));
    КонецЕсли;
    Возврат Тело;
КонецФункции


&НаСервере
Функция НормализоватьОтвет(Данные, ФорматОтвета)
    Результат = НовыйРезультатLLM();

    // choices
    Выборы = ?(Данные.Свойство("choices"), Данные["choices"], Неопределено);
    Если Выборы = Неопределено ИЛИ Выборы.Количество() = 0 Тогда
        Результат.ОписаниеОшибки = "В ответе LLM отсутствует массив choices.";
        Возврат Результат;
    КонецЕсли;

    Выбор     = Выборы[0];
    Сообщение = ?(Выбор.Свойство("message"), Выбор["message"], Неопределено);
    Если Сообщение = Неопределено Тогда
        Результат.ОписаниеОшибки = "В choices[0] отсутствует message.";
        Возврат Результат;
    КонецЕсли;

    Результат.Успех        = Истина;
    Результат.ФорматОтвета = ФорматОтвета;
    Результат.Роль     = ?(Сообщение.Свойство("role"),          Сообщение["role"],          "");
    Результат.Причина  = ?(Выбор.Свойство("finish_reason"),     Выбор["finish_reason"],     "");
    Результат.Текст    = ?(Сообщение.Свойство("content"),       Сообщение["content"],       Неопределено);

    Если ФорматОтвета = "json" И ЗначениеЗаполнено(Результат.Текст) Тогда
        Результат.Данные = РазобратьJSON(Результат.Текст);
    КонецЕсли;

    // tool_calls — может отсутствовать при обычном текстовом ответе.
    ВызовыИнструментов = ?(Сообщение.Свойство("tool_calls"), Сообщение["tool_calls"], Неопределено);
    Если ВызовыИнструментов <> Неопределено Тогда
        Для Каждого ВызовИнструмента Из ВызовыИнструментов Цикл
            Функция_ = ВызовИнструмента["function"];
            Элемент = Новый Структура;
            Элемент.Вставить("ID",        ВызовИнструмента["id"]);
            Элемент.Вставить("Имя",       Функция_["name"]);
            Элемент.Вставить("Аргументы", РазобратьАргументыИнструмента(Функция_["arguments"]));
            Результат.ВызовыИнструментов.Добавить(Элемент);
        КонецЦикла;
    КонецЕсли;

    // usage — тоже опционально.
    Использование = ?(Данные.Свойство("usage"), Данные["usage"], Неопределено);
    Если Использование <> Неопределено Тогда
        Результат.ТокеныВход  = ?(Использование.Свойство("prompt_tokens"),     Использование["prompt_tokens"],     0);
        Результат.ТокеныВыход = ?(Использование.Свойство("completion_tokens"), Использование["completion_tokens"], 0);
    КонецЕсли;

    Возврат Результат;
КонецФункции

&НаСервере
Функция НовыйРезультатLLM()
    Р = Новый Структура;
    Р.Вставить("Успех",              Ложь);
    Р.Вставить("Роль",               "");
    Р.Вставить("Текст",              Неопределено);
    Р.Вставить("Данные",             Неопределено);
    Р.Вставить("ФорматОтвета",       "text");
    Р.Вставить("ВызовыИнструментов", Новый Массив);
    Р.Вставить("Причина",            "");
    Р.Вставить("ТокеныВход",         0);
    Р.Вставить("ТокеныВыход",        0);
    Р.Вставить("ОписаниеОшибки",     "");
    Возврат Р;
КонецФункции

&НаСервере
Функция ИнструкцияФормата(ФорматОтвета)
	Если ФорматОтвета = "json" Тогда
		Возврат Символы.ПС + Символы.ПС
		+ "Отвечай ТОЛЬКО валидным JSON без пояснений и markdown-блоков.";
	ИначеЕсли ФорматОтвета = "markdown" Тогда
		Возврат Символы.ПС + Символы.ПС
			+ "Отвечай в формате Markdown."
			+ " СТРУКТУРА:"
			+ " — Заголовки ## для разделов, ### для подразделов (не используй # первого уровня)."
			+ " — **Жирный** для ключевых терминов и акцентов."
			+ " — Маркированные списки через - для перечислений."
			+ " — Таблицы | col | col | для сравнений и данных."
			+ " — Обратный апостроф `код` для названий полей/значений."
			+ " — Разделяй параграфы ПУСТОЙ строкой (двойной перенос)."
			+ " — Блоки кода через ``` для примеров.";
	ИначеЕсли ФорматОтвета = "html" Тогда
		Возврат Символы.ПС + Символы.ПС
			+ "Отвечай в формате HTML."
			+ " 1. Только содержимое body — без тегов <html>,<head>,<body>."
			+ " 2. Чистый HTML, без Markdown."
			+ " 3. Используй inline CSS (style="""""") для стилей — без <style>-блоков."
			+ " 4. Разумные отступы: margin-bottom:6-12px на блочных элементах."
			+ " 5. Шрифт наследуется от контейнера (14px Arial)."
			+ " 6. Таблицы: border-collapse:collapse, ячейки с padding:4px 8px."
			+ " ПРИМЕР:"
			+ " <h2 style=""font-size:18px;color:#1a3c5e;margin:0 0 8px 0;"">Заголовок</h2>"
			+ " <p style=""margin:0 0 6px 0;line-height:1.5;"">Текст параграфа.</p>";
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

&НаСервере
Функция СформироватьВопрос(Вопрос, Контекст)
    Если Контекст = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Контекст) Тогда
        Возврат Вопрос;
    КонецЕсли;
    Возврат Вопрос + Символы.ПС + Символы.ПС
        + "=== ДАННЫЕ ===" + Символы.ПС + Контекст;
КонецФункции

// Безопасное чтение настройки из структуры НастройкиLLM.
&НаСервере
Функция ПолучитьНастройку(НастройкиLLM, Имя, ЗначениеПоУмолчанию)
    Если НастройкиLLM.Свойство(Имя) И ЗначениеЗаполнено(НастройкиLLM[Имя]) Тогда
        Возврат НастройкиLLM[Имя];
    КонецЕсли;
    Возврат ЗначениеПоУмолчанию;
КонецФункции

&НаСервере
Функция СериализоватьJSON(Объект)
    З = Новый ЗаписьJSON;
    З.УстановитьСтроку();
    ЗаписатьJSON(З, Объект);
    Возврат З.Закрыть();
КонецФункции

&НаСервере
Функция ДесериализоватьJSON(Строка)
    Ч = Новый ЧтениеJSON;
    Ч.УстановитьСтроку(Строка);
    Возврат ПрочитатьJSON(Ч, Ложь);
КонецФункции

&НаСервере
Функция РазобратьJSON(Строка)
    Если НЕ ЗначениеЗаполнено(Строка) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Попытка
        Возврат ДесериализоватьJSON(Строка);
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

#КонецОбласти

#Область LLM_Заглушка

// Возвращает заранее заданный ответ вместо обращения к сети.
// Шаг сценария хранится в массиве НастройкиLLM.СценарийСостояние[0],
// чтобы не писать в саму структуру (Знач/системные ограничения).
&НаСервере
Функция ЗаглушкаОтвета(НастройкиLLM, Тело)
    Результат = Новый Структура("Успех, Данные, ОписаниеОшибки", Истина, , "");

    Сценарий = ПолучитьНастройку(НастройкиLLM, "Сценарий", Новый Массив);

    Если НастройкиLLM.Свойство("СценарийСостояние") Тогда
        Состояние = НастройкиLLM.СценарийСостояние;
    Иначе
        Состояние = Новый Массив;
        Состояние.Добавить(0);
    КонецЕсли;

    Шаг = Состояние[0];

    Если Шаг < Сценарий.Количество() Тогда
        ТекущийОтвет = Сценарий[Шаг];
        Состояние[0] = Шаг + 1;   // меняем элемент массива — это разрешено
    Иначе
        ТекущийОтвет = ОтветТекстом("Заглушка: ответ по умолчанию.");
    КонецЕсли;

    Результат.Данные = ТекущийОтвет;
    Возврат Результат;
КонецФункции

// Конструктор фейкового текстового ответа в формате API.
&НаСервере
Функция ОтветТекстом(Текст, Причина = "stop") Экспорт
    Сообщение = Новый Структура("role, content, tool_calls", "assistant", Текст, Неопределено);
    Выбор     = Новый Структура("message, finish_reason", Сообщение, Причина);
    Выборы    = Новый Массив; Выборы.Добавить(Выбор);
    Использование = Новый Структура("prompt_tokens, completion_tokens", 10, 20);
    Возврат Новый Структура("choices, usage", Выборы, Использование);
КонецФункции

// Конструктор фейкового ответа с вызовом инструмента.
&НаСервере
Функция ОтветВызовИнструмента(IDВызова, ИмяФункции, АргументыСтрока) Экспорт
    Функция_ = Новый Структура("name, arguments", ИмяФункции, АргументыСтрока);
    Вызов    = Новый Структура("id, type, function", IDВызова, "function", Функция_);
    Вызовы   = Новый Массив; Вызовы.Добавить(Вызов);
    Сообщение = Новый Структура("role, content, tool_calls", "assistant", "", Вызовы);
    Выбор     = Новый Структура("message, finish_reason", Сообщение, "tool_calls");
    Выборы    = Новый Массив; Выборы.Добавить(Выбор);
    Использование = Новый Структура("prompt_tokens, completion_tokens", 15, 25);
    Возврат Новый Структура("choices, usage", Выборы, Использование);
КонецФункции

#КонецОбласти

#Область LLM_Тесты

&НаСервере
Функция НастройкиЗаглушки(Сценарий)
    Состояние = Новый Массив;
    Состояние.Добавить(0);   // указатель шага

    Н = Новый Структура;
    Н.Вставить("РежимЗаглушки",     Истина);
    Н.Вставить("Сценарий",          Сценарий);
    Н.Вставить("СценарийСостояние", Состояние);
    Н.Вставить("МодельID",          "test-model");
    Возврат Н;
КонецФункции

&НаСервере
Процедура Утверждать(Условие, Сообщение)
    Если НЕ Условие Тогда
        ВызватьИсключение "ТЕСТ ПРОВАЛЕН: " + Сообщение;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура Тест_ПростойОтвет()
    Сценарий = Новый Массив;
    Сценарий.Добавить(ОтветТекстом("За март 12 заказов."));
    Настройки = НастройкиЗаглушки(Сценарий);

    История   = НоваяИсторияДиалога("Ты — аналитик 1С.", "text");
    Результат = СпроситьLLM(История, "Сколько заказов за март?", Настройки);

    Утверждать(Результат.Успех, "Должен быть успех");
    Утверждать(Результат.Текст = "За март 12 заказов.", "Неверный текст ответа");
    Утверждать(История.Количество() = 3, "Ожидалось 3 сообщения");
    Сообщить("Тест 1 (простой ответ) — ОК");
КонецПроцедуры

&НаСервере
Процедура Тест_ЦиклИнструмента()
    Сценарий = Новый Массив;
    Сценарий.Добавить(ОтветВызовИнструмента("call_1", "get_orders", "{""date_from"":""2026-03-01""}"));
    Сценарий.Добавить(ОтветТекстом("Найдено 12 заказов на 540 000 руб."));
    Настройки = НастройкиЗаглушки(Сценарий);

    История   = НоваяИсторияДиалога("Ты — аналитик 1С.", "text");
    Результат = СпроситьLLM(История, "Покажи заказы за март", Настройки);

    Утверждать(Результат.Успех, "Должен быть успех");
    Утверждать(Результат.Текст = "Найдено 12 заказов на 540 000 руб.", "Неверный финал");
