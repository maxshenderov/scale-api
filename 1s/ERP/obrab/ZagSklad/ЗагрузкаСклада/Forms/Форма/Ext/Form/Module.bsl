			ВысотаЭтажаМм = ДанныеЭтажа.Высота;
			ШиринаСекцииМм = ДанныеЭтажа.Ширина;
			ВесогрузкаЭтажа = ДанныеЭтажа.Вес;
		КонецЕсли;
		
		ВысотаЭтажаPx = Окр(ВысотаЭтажаМм * КоэфМасштаба, 1);
		ШиринаСекцииPx = Окр(ШиринаСекцииМм * КоэфМасштаба, 1);
		
		HTML = HTML + "<div class=""floor"">";
		
		// Метка высоты (слева, вертикально)
		HTML = HTML + "<div class=""height-info"">"
			+ Формат(ВысотаЭтажаМм, "ЧН=0; ЧГ=0") + " мм</div>";
		
		// Метка этажа
		HTML = HTML + "<div class=""floor-header""><span class=""floor-label"">Э"
			+ Формат(НомерЭтажа, "ЧН=0; ЧГ=0") + "</span></div>";
		
		// Ряд секций
		HTML = HTML + "<div class=""sections-row"">";
		
		Для Каждого СекцияДанные Из МассивЭтажа Цикл
			КартаАдресов = ДанныеПаллет.Получить(СекцияДанные.Ссылка);
			Если КартаАдресов = Неопределено Тогда
				КартаАдресов = Новый Соответствие;
			КонецЕсли;
			
			КоличествоАдресов = СекцияДанные.КоличествоАдресов;
			Если КоличествоАдресов = 0 Тогда
				КоличествоАдресов = 3;
			КонецЕсли;
			
			// Строим массив только из фактически используемых адресов
			ЕстьПаллетВСекции = Ложь;
			Все3Адреса = Новый Массив;
			Все3Адреса.Добавить(СекцияДанные.Адрес1);
			Все3Адреса.Добавить(СекцияДанные.Адрес2);
			Все3Адреса.Добавить(СекцияДанные.Адрес3);
			Адреса = Новый Массив;
			Для ИА = 0 По КоличествоАдресов - 1 Цикл
				Адреса.Добавить(Все3Адреса[ИА]);
			КонецЦикла;
			Для ИндексАдреса = 0 По КоличествоАдресов - 1 Цикл
				ДанныеП = КартаАдресов.Получить(Адреса[ИндексАдреса]);
				Если ДанныеП <> Неопределено Тогда
					ЕстьПаллетВСекции = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			// Вычисляем какие пустые ячейки физически перекрыты паллетами из соседних адресов
			// Массив булево по индексу ячейки: Истина = перекрыта паллетом (белая, недоступна)
			ЯчейкаПерекрыта = Новый Массив;
			Для ИА = 0 По КоличествоАдресов - 1 Цикл
				ЯчейкаПерекрыта.Добавить(Ложь);
			КонецЦикла;
			
			ШиринаЯчейкиМм_Расч = ?(КоличествоАдресов > 0, ШиринаСекцииМм / КоличествоАдресов, ШиринаСекцииМм);
			
			Для ИА = 0 По КоличествоАдресов - 1 Цикл
				ДанныеПалл = КартаАдресов.Получить(Адреса[ИА]);
				Если ДанныеПалл = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ПараметрыП2 = ПараметрыПаллетКэш.Получить(ДанныеПалл.ПаллетСсылка);
				ШиринаПалл = 0;
				Если ПараметрыП2 <> Неопределено Тогда
					ШиринаПалл = ПараметрыП2.Ширина;
				КонецЕсли;
				
				// Левая граница паллета в мм от левого края секции
				Если КоличествоАдресов = 1 Тогда
					ЛевыйПалл = (ШиринаСекцииМм - ШиринаПалл) / 2;
				ИначеЕсли ИА = 0 Тогда
					ЛевыйПалл = 0;
				ИначеЕсли ИА = КоличествоАдресов - 1 Тогда
					ЛевыйПалл = ШиринаСекцииМм - ШиринаПалл;
				Иначе // средний адрес
					ЛевыйПалл = (ШиринаСекцииМм - ШиринаПалл) / 2;
				КонецЕсли;
				ПравыйПалл = ЛевыйПалл + ШиринаПалл;
				
				// Отмечаем соседние ячейки, которые перекрывает этот паллет
				Для ИА2 = 0 По КоличествоАдресов - 1 Цикл
					Если ИА2 = ИА Тогда
						Продолжить; // собственную ячейку не трогаем
					КонецЕсли;
					ЛевааяЯчейки = ИА2 * ШиринаЯчейкиМм_Расч;
					ПравааяЯчейки = (ИА2 + 1) * ШиринаЯчейкиМм_Расч;
					// Пересечение диапазонов: A<D и C<B
					Если ЛевыйПалл < ПравааяЯчейки И ПравыйПалл > ЛевааяЯчейки Тогда
						ЯчейкаПерекрыта[ИА2] = Истина;
