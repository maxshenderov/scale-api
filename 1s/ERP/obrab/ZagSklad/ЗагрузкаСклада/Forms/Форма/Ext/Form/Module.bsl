&НаКлиенте
Процедура ПодсветитьТекущийСтеллаж()
	//+Лико m.shenderov 02.06.2026
	// Подсвечиваем кнопку текущего стеллажа жирным шрифтом
	// Снимаем подсветку с предыдущего
	Если ЗначениеЗаполнено(ТекущийСтеллажИмяКнопки) Тогда
		ПредыдущаяКнопка = Элементы.Найти(ТекущийСтеллажИмяКнопки);
		Если ПредыдущаяКнопка <> Неопределено Тогда
			ПредыдущаяКнопка.ЦветФона = WebЦвета.Белый;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущийСтеллаж) Тогда
		КодПолный = ПолучитьКодПолныйСтеллажаНаСервере(ТекущийСтеллаж);
		ИмяКнопки = "Стеллаж_" + Формат(КодПолный, "ЧН=0; ЧГ=0");
		Кнопка = Элементы.Найти(ИмяКнопки);
		Если Кнопка <> Неопределено Тогда
			Кнопка.ЦветФона = WebЦвета.СветлоЖелтый;
			// фон установлен выше
		КонецЕсли;
		ТекущийСтеллажИмяКнопки = ИмяКнопки;
	Иначе
		ТекущийСтеллажИмяКнопки = "";
	КонецЕсли;
КонецПроцедуры

