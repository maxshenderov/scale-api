//+Лико m.shenderov 05.06.2026 — Выбор файлов для отправки в LLM
&НаКлиенте
Процедура ВыбратьФайлы(Команда)
	// Если файлы уже выбраны — сначала очищаем старый выбор, затем открываем диалог
	Если ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		ВыбранныеФайлы = "";
		ВыбранныеФайлыИмена = "";
		ДобавитьСистемныйПузырьНаСервере("Файлы откреплены. Выберите новые или закройте диалог.");
	КонецЕсли;
	
	// Диалог выбора файлов на клиенте
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файлы для отправки в LLM";
	Диалог.МножественныйВыбор = Истина;
	Диалог.Фильтр =
		"Все поддерживаемые файлы (*.pdf, *.jpg, *.jpeg, *.png, *.txt, *.docx, *.xlsx, *.csv)"
		+ "|*.pdf;*.jpg;*.jpeg;*.png;*.txt;*.docx;*.xlsx;*.csv"
		+ "|Изображения (*.jpg, *.jpeg, *.png)"
		+ "|*.jpg;*.jpeg;*.png"
		+ "|PDF (*.pdf)"
		+ "|*.pdf"
		+ "|Текстовые файлы (*.txt)"
		+ "|*.txt"
		+ "|Все файлы (*.*)"
		+ "|*.*";
	
	Если Диалог.Выбрать() Тогда
		МассивФайлов = Диалог.ВыбранныеФайлы;
		Если МассивФайлов.Количество() > 0 Тогда
			// Ограничение: максимум 5 файлов
			Если МассивФайлов.Количество() > 5 Тогда
				Пока МассивФайлов.Количество() > 5 Цикл
					МассивФайлов.Удалить(МассивФайлов.Количество() - 1);
				КонецЦикла;
				Лико_ДополнительноКлиентСервер.СообщитьДляКлиента(
					"Можно прикрепить не более 5 файлов. Выбраны первые 5.");
			КонецЕсли;
			
			// Сохраняем пути к файлам как JSON и имена для отображения
			ВыбранныеФайлы = СериализоватьJSON(МассивФайлов);
			
			// Формируем строку с именами файлов для отображения
			ИменаФайлов = Новый Массив;
			Для Каждого ПутьФайла Из МассивФайлов Цикл
				ИмяФайла = ПолучитьИмяФайла(ПутьФайла);
				ИменаФайлов.Добавить(ИмяФайла);
			КонецЦикла;
			ВыбранныеФайлыИмена = СтрСоединить(ИменаФайлов, ", ");
			
			// Показываем в чате системное сообщение о прикреплённых файлах с крестиком
			ТекстСообщения = "📎 Прикреплены файлы: " + ВыбранныеФайлыИмена;
			ДобавитьСистемныйПузырьНаСервере(ТекстСообщения, Истина);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры //-<---Лико m.shenderov 05.06.2026

//+Лико m.shenderov 05.06.2026 — Чат-интерфейс LLM (модифицирован для поддержки файлов)
&НаКлиенте
Процедура ОтпрвитьВLLM(Команда)
	ТекстВопроса = СокрЛП(ВопросКLLM);
	
	// Если нет ни текста, ни файлов — выходим
	Если НЕ ЗначениеЗаполнено(ТекстВопроса) И НЕ ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	КонецЕсли;
	
	// Определяем массив файлов для отправки
	МассивФайлов = Неопределено;
	Если ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		МассивФайлов = ДесериализоватьJSON(ВыбранныеФайлы);
	КонецЕсли;
	
	// 1. Показываем сообщение пользователя с вопросом (и файлами если есть)
	ТекстДляОтображения = ТекстВопроса;
	Если ЗначениеЗаполнено(ВыбранныеФайлыИмена) Тогда
		ТекстДляОтображения = ТекстДляОтображения + Символы.ПС + "📎 " + ВыбранныеФайлыИмена;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		ДобавитьПользовательскийПузырьНаСервере(ТекстДляОтображения);
	КонецЕсли;
		
	// 2. Блокируем кнопку
	Элементы.ОтпрвитьВLLM.Доступность = Ложь;

	// 3. Показываем индикатор «LLM думает…» в чате (три мигающие точки)
	ДобавитьИндикаторОжиданияНаСервере();

	// 4. Запоминаем текст и файлы для запроса
	ТекстВопросаДляLLM = ТекстВопроса;

	// 5. Отправляем LLM-запрос через обработчик ожидания (после обновления HTML)
	ПодключитьОбработчикОжидания("ВыполнитьЗапросКLLМ", 0.1, Истина);
КонецПроцедуры //-<---Лико m.shenderov 05.06.2026

//+Лико m.shenderov 05.06.2026 — Обработчик ожидания: запрос к LLM (модифицирован для файлов)
&НаКлиенте
Процедура ВыполнитьЗапросКLLМ() Экспорт
	ИсторияДляЗапроса = ?(ЗначениеЗаполнено(Кэш), Кэш, "");

	// На КЛИЕНТЕ читаем выбранные файлы и готовим base64 + метаданные.
	// На сервер передаём уже готовый массив структур — без обращения к файловой системе сервера.
	МассивФайловДляСервера = Неопределено;
	Если ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		МассивФайловДляСервера = ПрочитатьФайлыНаКлиенте(ДесериализоватьJSON(ВыбранныеФайлы));
	КонецЕсли;
	СистемныйПромпт="";
	Контекст="";
	ИменаИнструментов = Новый Массив;
	Если ЗначениеЗаполнено(Задача) Тогда
		ЗадачиLLM=ЗадачиДляLLM();
		ЗадачаLLM = ЗадачиLLM[Задача];

		Если  ТипЗнч(ЗадачаLLM)=Тип("Структура") И ЗадачаLLM.Свойство("СистемныйПромпт") Тогда

			СистемныйПромпт=ЗадачаLLM.СистемныйПромпт;
			Контекст = ЗадачаLLM.Контекст;
			Если ЗадачаLLM.Свойство("Инструменты") Тогда
				ИменаИнструментов = ЗадачаLLM.Инструменты;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СистемныйПромпт) Тогда	
		СистемныйПромпт = "Вы — полезный ассистент. Отвечай кратко и по делу.";
		
	КонецЕсли;
	
	ОтветСтруктура = ОтправитьЗапросLLMНаСервере(СистемныйПромпт,ВопросКLLM, ИсторияДляЗапроса, МассивФайловДляСервера,ФорматОтветаLLM,Контекст,ИменаИнструментов);

	// Накапливаем токены по всей беседе
	СуммаТокеновВход  = СуммаТокеновВход  + ОтветСтруктура.ТокеныВход;
	СуммаТокеновВыход = СуммаТокеновВыход + ОтветСтруктура.ТокеныВыход;

	// Удаляем индикатор «думает...» и добавляем ответ LLM
	УдалитьИндикаторОжиданияНаСервере();
	ДобавитьПузырьLLMНаСервере(ОтветСтруктура.Ответ, ОтветСтруктура.ТокеныВход, ОтветСтруктура.ТокеныВыход, ОтветСтруктура.Модель, ФорматОтветаLLM);

	// Сохраняем историю
	Если ЗначениеЗаполнено(ОтветСтруктура.История) Тогда
		Кэш = ОтветСтруктура.История;
	КонецЕсли;
	ВопросКLLM = "";

	// Очищаем выбранные файлы после отправки
	ВыбранныеФайлы = "";
	ВыбранныеФайлыИмена = "";

	Элементы.ОтпрвитьВLLM.Доступность = Истина;

	// Обновляем счётчики токенов в HTML (маркеры в хедере чата)
	ОбновитьСчетчикиТокеновВHTMLНаСервере();
КонецПроцедуры //-<---Лико m.shenderov 05.06.2026

//+Лико m.shenderov 05.06.2026 — Серверная обёртка для LLM-запроса (модифицирована для файлов)
&НаСервере
Функция ОтправитьЗапросLLMНаСервере(СистемныйПромпт,ТекстВопроса, ИсторияJSON, МассивФайлов = Неопределено,ФорматОтвета="text",Контекст="", ИменаИнструментов = Неопределено)
	// Восстанавливаем историю
	Если ЗначениеЗаполнено(ИсторияJSON) Тогда
		ИсторияЧата = ДесериализоватьJSON(ИсторияJSON);
	Иначе
		ИсторияЧата = Неопределено;
	КонецЕсли;

	Настройки = ПараметрыПровайдера(Провайдер,Модель);
	Если ИсторияЧата = Неопределено ИЛИ ИсторияЧата.Количество() = 0 Тогда
		//СистемныйПромпт = "Вы — полезный ассистент по складскому учёту. Отвечай кратко и по делу.";
		Если МассивФайлов <> Неопределено И МассивФайлов.Количество() > 0 Тогда
			СистемныйПромпт = СистемныйПромпт + Символы.ПС
				+ "Пользователь прикрепил файлы.  Проанализируй их содержимое.";
		КонецЕсли;
		ИсторияЧата = НоваяИсторияДиалога(СистемныйПромпт, ФорматОтвета,Контекст);
	КонецЕсли;

	// МассивФайлов теперь — массив СТРУКТУР: {ИмяФайла, Расширение, MIME, Тип, Данные}.
	// Тип: "image" / "text" / "binary" — Данные содержат base64 или текст.
	КонтекстФайлов = "";
	Если МассивФайлов <> Неопределено И МассивФайлов.Количество() > 0 Тогда
		Для Каждого ДанныеФайла Из МассивФайлов Цикл
			Если ДанныеФайла = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ИмяФайла   = Строка(ДанныеФайла.ИмяФайла);
			MIME       = Строка(ДанныеФайла.MIME);
			ТипФайла   = Строка(ДанныеФайла.Тип);
			Содержимое = Строка(ДанныеФайла.Данные);

			Если ЗначениеЗаполнено(КонтекстФайлов) Тогда
				КонтекстФайлов = КонтекстФайлов + Символы.ПС;
			КонецЕсли;
			КонтекстФайлов = КонтекстФайлов
				+ "=== ФАЙЛ: " + ИмяФайла + " ===" + Символы.ПС
				+ "Тип: " + MIME + Символы.ПС;
			Если ТипФайла = "text" Тогда
				КонтекстФайлов = КонтекстФайлов + "Содержимое:" + Символы.ПС + Содержимое;
			Иначе
				// image / binary — base64 data URL
				КонтекстФайлов = КонтекстФайлов + "data:" + MIME + ";base64," + Содержимое;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	//+Лико m.shenderov 13.06.2026 — резолвинг инструментов задачи
	Инструменты = ПолучитьОпределенияИнструментов(ИменаИнструментов);
	РезультатLLM = СпроситьLLM(ИсторияЧата, ТекстВопроса, Настройки, Инструменты,ФорматОтвета, КонтекстФайлов);

	Результат = Новый Структура("Ответ, История, ТокеныВход, ТокеныВыход, Модель");
	Если РезультатLLM.Успех Тогда
		Результат.Ответ = РезультатLLM.Текст;
		Результат.История = СериализоватьJSON(ИсторияЧата);
		Результат.ТокеныВход  = РезультатLLM.ТокеныВход;
		Результат.ТокеныВыход = РезультатLLM.ТокеныВыход;
		Результат.Модель = Настройки.МодельID;
	Иначе
		Результат.Ответ = "Ошибка: " + РезультатLLM.ОписаниеОшибки;
		Результат.История = СериализоватьJSON(ИсторияЧата);
		Результат.ТокеныВход  = 0;
		Результат.ТокеныВыход = 0;
		Результат.Модель = Настройки.МодельID;
	КонецЕсли;

	Возврат Результат;
КонецФункции //-<---Лико m.shenderov 05.06.2026

//+Лико m.shenderov 05.06.2026 — Чтение файлов на КЛИЕНТЕ и подготовка для сервера
//
// ВАЖНО: чтение файлов с диска ДОЛЖНО быть на клиенте, потому что на сервере 1С
// путь к файлу пользователя обычно недоступен (другая машина, нет сетевого доступа).
// Здесь читаем файл → base64 (или текст) → возвращаем массив структур.
// На сервере работаем ТОЛЬКО с этими готовыми данными — без обращения к диску.
&НаКлиенте
Функция ПрочитатьФайлыНаКлиенте(МассивПутей) Экспорт
	РезультатМассив = Новый Массив;
	Если МассивПутей = Неопределено Тогда
		Возврат РезультатМассив;
	КонецЕсли;

	Для Каждого ПутьФайла Из МассивПутей Цикл
		Если НЕ ЗначениеЗаполнено(ПутьФайла) Тогда
			Продолжить;
		КонецЕсли;

		СтруктураФайла = Новый Структура;

		// Получаем имя файла и расширение
		ЧастиПути = СтрРазделить(ПутьФайла, "\");
		ИмяФайла = ?(ЧастиПути.Количество() > 0, ЧастиПути[ЧастиПути.Количество() - 1], "");
		ЧастиИмени = СтрРазделить(ИмяФайла, ".");
		Расширение = ?(ЧастиИмени.Количество() > 1, ВРег(ЧастиИмени[ЧастиИмени.Количество() - 1]), "");
		СтруктураФайла.Вставить("ИмяФайла",   ИмяФайла);
		СтруктураФайла.Вставить("Расширение", Расширение);

		Попытка
			Если Расширение = "TXT" ИЛИ Расширение = "CSV" ИЛИ Расширение = "JSON" ИЛИ Расширение = "LOG" Тогда
				// Текстовые форматы — читаем как UTF-8
				Чтение = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
				Содержимое = Чтение.Прочитать();
				Чтение.Закрыть();
				СтруктураФайла.Вставить("Тип",   "text");
				СтруктураФайла.Вставить("MIME",  "text/plain");
				СтруктураФайла.Вставить("Данные", Содержимое);
			Иначе
				// Бинарные форматы — читаем в base64
				ДвоичныеДанные = Новый ДвоичныеДанные(ПутьФайла);
				Base64Строка = Base64Строка(ДвоичныеДанные);
				// Простое определение MIME по расширению (без серверного вызова)
				MIME = "application/octet-stream";
				Если Расширение = "JPG" ИЛИ Расширение = "JPEG" Тогда
					MIME = "image/jpeg";
					СтруктураФайла.Вставить("Тип", "image");
				ИначеЕсли Расширение = "PNG" Тогда
					MIME = "image/png";
					СтруктураФайла.Вставить("Тип", "image");
				ИначеЕсли Расширение = "PDF" Тогда
					MIME = "application/pdf";
					СтруктураФайла.Вставить("Тип", "binary");
				ИначеЕсли Расширение = "DOCX" Тогда
					MIME = "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
					СтруктураФайла.Вставить("Тип", "binary");
				ИначеЕсли Расширение = "XLSX" Тогда
					MIME = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
					СтруктураФайла.Вставить("Тип", "binary");
				Иначе
					СтруктураФайла.Вставить("Тип", "binary");
				КонецЕсли;
				СтруктураФайла.Вставить("MIME",  MIME);
				СтруктураФайла.Вставить("Данные", Base64Строка);
			КонецЕсли;
		Исключение
			// Файл не удалось прочитать — записываем ошибку
			СтруктураФайла.Вставить("Тип",   "text");
			СтруктураФайла.Вставить("MIME",  "text/plain");
			СтруктураФайла.Вставить("Данные", "Ошибка чтения файла: " + ОписаниеОшибки());
		КонецПопытки;

		РезультатМассив.Добавить(СтруктураФайла);
	КонецЦикла;
	Возврат РезультатМассив;
КонецФункции //-<---Лико m.shenderov 05.06.2026

//+Лико m.shenderov 05.06.2026 — Получение MIME-типа по расширению
&НаСервере
Функция ПолучитьMIME(Расширение)
	MIMETипы = Новый Соответствие;
	MIMETипы.Вставить("JPG",  "image/jpeg");
	MIMETипы.Вставить("JPEG", "image/jpeg");
	MIMETипы.Вставить("PNG",  "image/png");
	MIMETипы.Вставить("PDF",  "application/pdf");
	MIMETипы.Вставить("TXT",  "text/plain");
	MIMETипы.Вставить("DOCX", "application/vnd.openxmlformats-officedocument.wordprocessingml.document");
	MIMETипы.Вставить("XLSX", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
	MIMETипы.Вставить("CSV",  "text/csv");
	
	Результат = MIMETипы.Получить(Расширение);
	Если Результат = Неопределено Тогда
		Возврат "application/octet-stream";
	КонецЕсли;
	Возврат Результат;
КонецФункции //-<---Лико m.shenderov 05.06.2026

//+Лико m.shenderov 05.06.2026 — Base64 из буфера
&НаСервере
Функция Base64СтрокаИзБуфера(Буфер)
	Попытка
		Возврат Base64Строка(Буфер);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции //-<---Лико m.shenderov 05.06.2026

//+Лико m.shenderov 05.06.2026 — Получение имени файла из полного пути
&НаСервере
Функция ПолучитьИмяФайла(ПутьФайла)
	Части = СтрРазделить(ПутьФайла, "\\");
	Возврат Части[Части.Количество() - 1];
КонецФункции //-<---Лико m.shenderov 05.06.2026

