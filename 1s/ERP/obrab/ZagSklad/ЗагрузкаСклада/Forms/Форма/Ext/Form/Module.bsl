//+Лико m.shenderov 16.06.2026 — Бизнес-функция: пошаговый расчёт времени доступа по кодам ячеек/секций
&НаСервере
Функция ВремяДоступаБизнес(МассивКодов) Экспорт

	Результаты = Новый Массив;

	Для Каждого Код Из МассивКодов Цикл
		Результат = Новый Структура;
		Результат.Вставить("code",  Код);
		Результат.Вставить("found", Ложь);
		Результат.Вставить("error", "");

		// 1. Найти объект: ячейка → секция или сразу секция
		Секция   = Неопределено;
		Тип      = "";
		КодЯчейки = "";

		// Пробуем как ячейку
		Ячейка = Справочники.СкладскиеЯчейки.НайтиПоКоду(Код);
		Если Не ЗначениеЗаполнено(Ячейка) Тогда
			Ячейка = Справочники.СкладскиеЯчейки.НайтиПоНаименованию(Код);
		КонецЕсли;

		Если ЗначениеЗаполнено(Ячейка) Тогда
			Тип      = "cell";
			КодЯчейки = Ячейка.Код;
			Секция    = Ячейка.Лико_Секция;
		КонецЕсли;

		// Не ячейка — пробуем как секцию
		Если Не ЗначениеЗаполнено(Секция) Тогда
			СекцияПоиск = Справочники.Лико_СкладскиеСекции.НайтиПоКоду(Код);
			Если Не ЗначениеЗаполнено(СекцияПоиск) Тогда
				СекцияПоиск = Справочники.Лико_СкладскиеСекции.НайтиПоНаименованию(Код);
			КонецЕсли;
			Если ЗначениеЗаполнено(СекцияПоиск) Тогда
				Тип    = "section";
				Секция = СекцияПоиск;
			КонецЕсли;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Секция) Тогда
			Результат.Вставить("error", "Не найдена ячейка или секция: """ + Код + """");
			Результаты.Добавить(Результат);
			Продолжить;
		КонецЕсли;

		Результат.Вставить("found", Истина);
		Результат.Вставить("type",  Тип);
		Если Тип = "cell" Тогда
			Результат.Вставить("cellCode", КодЯчейки);
		КонецЕсли;

		// 2. Стеллаж и Склад
		Стеллаж = Секция.Стеллаж;
		Склад   = Секция.Склад;

		Результат.Вставить("sectionCode", Секция.Код);
		Результат.Вставить("rack",        Строка(Стеллаж));
		Результат.Вставить("place",       Секция.Место);
		Результат.Вставить("floor",       Секция.Этаж);

		// 3. Найти НомерСтроки стеллажа в ТЧ склада
		НомерСтроки = 0;
		Номер       = 1;
		Для каждого СтрТЧ Из Склад.Лико_Стеллажи Цикл
			Если СтрТЧ.Стеллаж = Стеллаж Тогда
				НомерСтроки = Номер;
				Прервать;
			КонецЕсли;
			Номер = Номер + 1;
		КонецЦикла;

		Результат.Вставить("rackRowNumber", НомерСтроки);

		// 4. Параметры склада
		ВремяСтеллажа = Склад.Лико_ВремяСтеллажа;
		ВремяМеста    = Склад.Лико_ВремяМеста;
		ВремяЭтажа    = Склад.Лико_ВремяЭтажа;

		Результат.Вставить("warehouseRackTime",  ВремяСтеллажа);
		Результат.Вставить("warehousePlaceTime", ВремяМеста);
		Результат.Вставить("warehouseFloorTime", ВремяЭтажа);

		// 5. Компоненты
		КомпонентСтеллажа = ВремяСтеллажа * НомерСтроки;
		КомпонентМеста    = Секция.Место * ВремяМеста;
		КомпонентЭтажа    = Секция.Этаж * ВремяЭтажа;
		Итог              = КомпонентСтеллажа + КомпонентМеста + КомпонентЭтажа;

		Результат.Вставить("rackTimeComponent",  КомпонентСтеллажа);
		Результат.Вставить("placeTimeComponent", КомпонентМеста);
		Результат.Вставить("floorTimeComponent", КомпонентЭтажа);
		Результат.Вставить("totalTime",          Итог);

		// 6. Формула в читаемом виде
		Формула = СтрШаблон("R(%1×%2) + M(%3×%4) + F(%5×%6) = %7+%8+%9 = %10",
			ВремяСтеллажа, НомерСтроки,
			Секция.Место, ВремяМеста,
			Секция.Этаж, ВремяЭтажа,
			КомпонентСтеллажа, КомпонентМеста, КомпонентЭтажа, Итог);
		Результат.Вставить("formula", Формула);

		Результаты.Добавить(Результат);
	КонецЦикла;

	Возврат Результаты;

КонецФункции //-<---Лико m.shenderov 16.06.2026

