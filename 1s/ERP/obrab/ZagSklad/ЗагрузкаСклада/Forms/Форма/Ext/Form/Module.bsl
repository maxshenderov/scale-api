					|             ВариантыОтчетов.Ссылка КАК ВариантСсылка,
					|             ВариантыОтчетов.ПредопределенныйВариант.КлючЗамеров КАК КлючЗамеров,
					|             ВариантыОтчетов.ПредопределенныйВариант КАК ПредопределенныйСсылка,
					|             ВЫБОР
					|                             КОГДА ВариантыОтчетов.Пользовательский
					|                                                            ИЛИ ВариантыОтчетов.Родитель.КлючВарианта ЕСТЬ NULL 
					|                                             ТОГДА ВариантыОтчетов.КлючВарианта
					|                             ИНАЧЕ ВариантыОтчетов.Родитель.КлючВарианта
					|             КОНЕЦ КАК ИмяИсходногоВарианта,
					|             ВариантыОтчетов.Пользовательский КАК Пользовательский
					|ИЗ
					|             Справочник.ВариантыОтчетов КАК ВариантыОтчетов
					|ГДЕ
					|             ВариантыОтчетов.Отчет = &Отчет";
					Запрос.УстановитьПараметр("Отчет", Параметры.Отчет);
					Выборка = Запрос.Выполнить().Выбрать();
					
					Если Выборка.Следующий() Тогда
						ВариантСсылка=Выборка.ВариантСсылка;
						НавигационнаяСсылка = "";
						НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ВариантСсылка); 
					Иначе
						АвтоНавигационнаяСсылка=Истина;
						//Сообщить("АвтоНавигационнаяСсылка1");
					КонецЕсли;       
				Иначе
					АвтоНавигационнаяСсылка=Истина;
					//Сообщить("АвтоНавигационнаяСсылка2");                 
				КонецЕсли;
УровеньДоступа=1;				
				
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	//+Лико m.shenderov 15.05.2026
	html = ПустойHTML();
	ТекущийСтеллаж = Неопределено;
	ТекущийСтеллажИмяКнопки = "";
	ЗаполнитьГруппуСтеллажейНаСервере();
	ПаллетПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура htmlПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	//+Лико m.shenderov 20.05.2026
	// Обработка клика из HTMLDocumentField — открываем форму объекта по zagsklad://type/guid
	// В HTML элементам с dblclick назначен data-атрибут data-zs-href="zagsklad://type/guid"
	// При дабл-клике JS вызывает openItem(), который устанавливает <a id="_zs_nav_" href="..."> и кликает по нему
	// OnClick в 1С возвращает href кликнутой ссылки в ДанныеСобытия.href
	
	Ссылка = "";
	Если ДанныеСобытия.Свойство("href") И ЗначениеЗаполнено(ДанныеСобытия.href) Тогда
		Ссылка = СокрЛП(ДанныеСобытия.href);
	КонецЕсли;
	
	Если НЕ СтрНачинаетсяС(Ссылка, "zagsklad://") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	Части = СтрРазделить(Ссылка, "/");
	Если Части.Количество() < 4 Тогда
		Возврат;
	КонецЕсли;

	// Обработка масштаба: zagsklad://scale/NNN
	Если Части[2] = "scale" Тогда
		МасштабПроцентов = Число(Части[3]);
		Возврат;
	КонецЕсли;
		
		// Обработка зума: zagsklad://zoom/in, zagsklad://zoom/out
		Если Части[2] = "zoom" Тогда
			Если Части[3] = "in" Тогда
				МасштабПроцентов = Мин(300, МасштабПроцентов + 10);
			ИначеЕсли Части[3] = "out" Тогда
				МасштабПроцентов = Макс(20, МасштабПроцентов - 10);
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекущийСтеллаж) Тогда
				РендерЗагрузкиСтеллажаНаСервере(ТекущийСтеллаж);
			ДобавитьПаллетыНаПолуВHTML();
			КонецЕсли;
			Возврат;
		КонецЕсли;
	
	ТипОбъекта = Части[2]; // "pallet" или "cell"
	ГУИДСтрока  = Части[3];
	
	СсылкаВладелец = ПолучитьСсылкуПоГУИД(ТипОбъекта, ГУИДСтрока);
	Если СсылкаВладелец = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("СсылкаВладелец", СсылкаВладелец);
	// Путь к ФормаОбъекта в том же внешнем отчёте
	МассивЧастейПути = СтрРазделить(ЭтаФорма.ИмяФормы, ".");
	МассивЧастейПути[МассивЧастейПути.Количество() - 1] = "ФормаОбъекта";
	ПутьФормы = СтрСоединить(МассивЧастейПути, ".");
	ОткрытьФорму(ПутьФормы, ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьФорму(Команда)
	//+Лико m.shenderov 15.05.2026
	ЗаполнитьГруппуСтеллажейНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСтеллаж(Команда)
	//+Лико m.shenderov 15.05.2026
	ИмяЭлемента = "";
	Если ТекущийЭлемент <> Неопределено Тогда
		ИмяЭлемента = ТекущийЭлемент.Имя;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		Возврат;
	КонецЕсли;
	
	ПрефиксКнопки = "Стеллаж_";
	Если СтрНачинаетсяС(ИмяЭлемента, ПрефиксКнопки) Тогда
		КодПолныйСтрока = Сред(ИмяЭлемента, СтрДлина(ПрефиксКнопки) + 1);
		КодПолныйЧисло = Число(КодПолныйСтрока);
		
		СтеллажСсылка = НайтиСтеллажПоКодуНаСервере(КодПолныйЧисло);
		Если ЗначениеЗаполнено(СтеллажСсылка) Тогда
			ТекущийСтеллаж = СтеллажСсылка;
			РендерЗагрузкиСтеллажаНаСервере(СтеллажСсылка);
			ДобавитьПаллетыНаПолуВHTML();
			ПодсветитьТекущийСтеллаж();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ============================================================
// === Серверные процедуры =====================================
// ============================================================

&НаСервере
Процедура ЗаполнитьГруппуСтеллажейНаСервере()

	//+Лико m.shenderov 15.05.2026
	УстановитьПривилегированныйРежим(Истина);
	УдалитьДинамическиеЭлементы();
	ДинамическиеЭлементы.Очистить();

	// Всегда очищаем HTML и сбрасываем текущий стеллаж
	html = ПустойHTMLСервер();
	//ТекущийСтеллаж = Неопределено;

	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат;
	КонецЕсли;

	// === Флаг: активен ли фильтр по паллету ===
	ФильтрАктивен = ФилтрПоПаллету И ЗначениеЗаполнено(Паллет) И АдресаХранения.Количество() > 0;

	// === Данные для кнопок ===
	КоличествоАдресовПоСтеллажам = Новый Соответствие;
	ПроцентПоСтеллажам = Новый Соответствие;

	Если ФильтрАктивен Тогда
		// Собираем адреса из АдресаХранения
		МассивАдресовФильтра = Новый Массив;
		Для Каждого СтрокаТЗ Из АдресаХранения Цикл
			МассивАдресовФильтра.Добавить(СтрокаТЗ.Адрес);
		КонецЦикла;

		// UNION-запрос: каждая строка = ОДИН АДРЕС, совпавший с ячейкой секции
		// Секция с 3 совпавшими адресами = 3 строки, секция с 1 адресом = 1 строка
		// Суммируем строки по стеллажам → получаем количество АДРЕСОВ (не секций!)
		ЗапросАдресов = Новый Запрос;
		ЗапросАдресов.Текст =
		"ВЫБРАТЬ
		|	Лико_СкладскиеСекции.Стеллаж КАК Стеллаж
		|ИЗ
		|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
		|ГДЕ
		|	Лико_СкладскиеСекции.Стеллаж.Склад = &Склад
		|	И НЕ Лико_СкладскиеСекции.ПометкаУдаления
		|	И Лико_СкладскиеСекции.Адрес1 В (&МассивАдресов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Лико_СкладскиеСекции.Стеллаж
		|ИЗ
		|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
		|ГДЕ
		|	Лико_СкладскиеСекции.Стеллаж.Склад = &Склад
		|	И НЕ Лико_СкладскиеСекции.ПометкаУдаления
		|	И Лико_СкладскиеСекции.Адрес2 В (&МассивАдресов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Лико_СкладскиеСекции.Стеллаж
		|ИЗ
		|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
		|ГДЕ
		|	Лико_СкладскиеСекции.Стеллаж.Склад = &Склад
		|	И НЕ Лико_СкладскиеСекции.ПометкаУдаления
		|	И Лико_СкладскиеСекции.Адрес3 В (&МассивАдресов)";
		ЗапросАдресов.УстановитьПараметр("Склад", Склад);
		ЗапросАдресов.УстановитьПараметр("МассивАдресов", МассивАдресовФильтра);
		РезультатАдресов = ЗапросАдресов.Выполнить();

		// Суммируем строки по стеллажам — каждая строка = один адрес
		Если НЕ РезультатАдресов.Пустой() Тогда
			ВыборкаАдресов = РезультатАдресов.Выбрать();
			Пока ВыборкаАдресов.Следующий() Цикл
				Тек = КоличествоАдресовПоСтеллажам.Получить(ВыборкаАдресов.Стеллаж);
				Если Тек = Неопределено Тогда
					Тек = 0;
				КонецЕсли;
				КоличествоАдресовПоСтеллажам.Вставить(ВыборкаАдресов.Стеллаж, Тек + 1);
			КонецЦикла;
		КонецЕсли;
	Иначе
		// Без фильтра: считаем процент загрузки для каждого стеллажа
		ЗапросСтеллажей = Новый Запрос;
		ЗапросСтеллажей.Текст =
		"ВЫБРАТЬ
		|	Лико_Стеллажи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Лико_Стеллажи КАК Лико_Стеллажи
		|ГДЕ
		|	Лико_Стеллажи.Склад = &Склад
		|	И НЕ Лико_Стеллажи.ПометкаУдаления";
		ЗапросСтеллажей.УстановитьПараметр("Склад", Склад);
		РезСтеллажей = ЗапросСтеллажей.Выполнить();

		Если НЕ РезСтеллажей.Пустой() Тогда
			МассивСтеллажей = Новый Массив;
			Выб = РезСтеллажей.Выбрать();
			Пока Выб.Следующий() Цикл
				МассивСтеллажей.Добавить(Выб.Ссылка);
			КонецЦикла;
			ПроцентПоСтеллажам = РассчитатьПроцентыЗагрузкиСтеллажей(МассивСтеллажей);
		КонецЕсли;
	КонецЕсли;

	// === Перебор стеллажей и создание кнопок ===
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Лико_Стеллажи.Ссылка КАК Ссылка,
		|	Лико_Стеллажи.КодПолный КАК КодПолный,
		|	Лико_Стеллажи.Наименование КАК Наименование,
		|	Лико_Стеллажи.ДопНастройки КАК ДопНастройки
		|ИЗ
		|	Справочник.Лико_Стеллажи КАК Лико_Стеллажи
		|ГДЕ
		|	Лико_Стеллажи.Склад = &Склад
		|	И НЕ Лико_Стеллажи.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Лико_Стеллажи.КодПолный";
	Запрос.УстановитьПараметр("Склад", Склад);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;

	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл
		// === Цвет стеллажа: с фильтром — из настроек, без фильтра — по проценту ===
		ЦветСтеллажа = ЦветСтеллажаИзДопНастроек(Выборка.ДопНастройки);
		Если Не ФильтрАктивен Тогда
			ДанныеЗагр = ПроцентПоСтеллажам.Получить(Выборка.Ссылка);
			Если ДанныеЗагр = Неопределено Тогда
				Процент = 0;
			Иначе
				Процент = ДанныеЗагр.Процент;
			КонецЕсли;
		КонецЕсли;

		// === Текст кнопки ===
		Если ФильтрАктивен Тогда
			КолАдресов = КоличествоАдресовПоСтеллажам.Получить(Выборка.Ссылка);
			Если КолАдресов = Неопределено Тогда
				КолАдресов = 0;
			КонецЕсли;
			ТекстКнопки = Выборка.Наименование + " (" + Формат(КолАдресов, "ЧН=0; ЧГ=0") + ")";
		Иначе
			ДанныеЗагр = ПроцентПоСтеллажам.Получить(Выборка.Ссылка);
			Если ДанныеЗагр = Неопределено Тогда
				Процент = 0;
				Свободных = 0;
			Иначе
				Процент = ДанныеЗагр.Процент;
				Свободных = ДанныеЗагр.СвободныхЯчеек;
			КонецЕсли;
			ТекстКнопки = Выборка.Наименование + " (" + Формат(Процент, "ЧН=0; ЧГ=0") + "% св. " + Формат(Свободных, "ЧН=0; ЧГ=0") + ")";
		КонецЕсли;

		// === Элементы формы ===
		ИмяГруппы = "ГруппаСтеллаж_" + Формат(Выборка.КодПолный, "ЧН=0; ЧГ=0");
		ГруппаФормы = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Элементы.ГруппаСтеллажи);
		ГруппаФормы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаФормы.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаФормы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		ГруппаФормы.ОтображатьЗаголовок = Ложь;
		ДинамическиеЭлементы.Добавить(ИмяГруппы);

		ИмяДекорации = "ДекорацияЦвет_" + Формат(Выборка.КодПолный, "ЧН=0; ЧГ=0");
		Декорация = Элементы.Добавить(ИмяДекорации, Тип("ДекорацияФормы"), ГруппаФормы);
		Декорация.Вид = ВидДекорацииФормы.Надпись;
		Декорация.Заголовок = "";
		Декорация.Ширина = 1;
		Декорация.Высота = 1;
		Декорация.АвтоМаксимальнаяШирина = Ложь;
		Декорация.АвтоМаксимальнаяВысота = Ложь;
		Декорация.ЦветФона = ЦветСтеллажа;
		ДинамическиеЭлементы.Добавить(ИмяДекорации);

		ИмяКнопки = "Стеллаж_" + Формат(Выборка.КодПолный, "ЧН=0; ЧГ=0");
		Кнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), ГруппаФормы);
		Кнопка.ИмяКоманды = "ВыбратьСтеллаж";
		Кнопка.Заголовок = ТекстКнопки;
		Кнопка.ЦветТекста = WebЦвета.Черный;
		Кнопка.ЦветРамки = WebЦвета.Черный;
		Кнопка.ОтображениеФигуры = ОтображениеФигурыКнопки.Нет;
		Кнопка.Высота = 1;
		ДинамическиеЭлементы.Добавить(ИмяКнопки);

		// Подсветка текущего стеллажа фоном
		Если ЗначениеЗаполнено(ТекущийСтеллаж) И Выборка.Ссылка = ТекущийСтеллаж Тогда
			Кнопка.ЦветФона = WebЦвета.СветлоЖелтый;
		КонецЕсли;
	КонецЦикла;

	//+Лико m.shenderov 22.06.2026 — общий процент загрузки склада
	Если НЕ ФильтрАктивен Тогда
		ОбщийПроцентСумма = 0;
		КоличествоСтеллажейСч = 0;
		ВсегоСвободных = 0;
		Для Каждого Эл Из ПроцентПоСтеллажам Цикл
			Данные = Эл.Значение;
			ОбщийПроцентСумма = ОбщийПроцентСумма + Данные.Процент;
			ВсегоСвободных = ВсегоСвободных + Данные.СвободныхЯчеек;
			КоличествоСтеллажейСч = КоличествоСтеллажейСч + 1;
		КонецЦикла;
		ОбщийПроцент = ?(КоличествоСтеллажейСч > 0, Окр(ОбщийПроцентСумма / КоличествоСтеллажейСч, 0), 0);
		Элементы.ГруппаСтеллажи.Заголовок = "Общ. " + Формат(ОбщийПроцент, "ЧН=0; ЧГ=0") + "% св. " + Формат(ВсегоСвободных, "ЧН=0; ЧГ=0");
	КонецЕсли;
КонецПроцедуры

