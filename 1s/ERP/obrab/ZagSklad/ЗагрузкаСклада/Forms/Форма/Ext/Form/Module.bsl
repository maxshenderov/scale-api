Функция НайтиСтеллажПоКодуНаСервере(КодПолный)
      УстановитьПривилегированныйРежим(Истина);
	//+Лико m.shenderov 15.05.2026
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лико_Стеллажи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Лико_Стеллажи КАК Лико_Стеллажи
		|ГДЕ
		|	Лико_Стеллажи.КодПолный = &КодПолный
		|	И НЕ Лико_Стеллажи.ПометкаУдаления";
	Запрос.УстановитьПараметр("КодПолный", КодПолный);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции


&НаСервере
Функция РассчитатьПроцентыЗагрузкиСтеллажей(МассивСтеллажей)
	//+Лико m.shenderov 22.06.2026
	// Батч-вариант ПолучитьПроцентЗагрузкиСтеллажаПоЯчейкам — 4 запроса вместо 4N.
	// Возвращает Соответствие: СтеллажСсылка -> Число (процент 0..100)
	УстановитьПривилегированныйРежим(Истина);

	Результат = Новый Соответствие;
	Если МассивСтеллажей.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// === Шаг 1. Все секции всех стеллажей ===
	ЗапросСекций = Новый Запрос;
	ЗапросСекций.Текст =
	"ВЫБРАТЬ
	|	Лико_СкладскиеСекции.Ссылка КАК Ссылка,
	|	Лико_СкладскиеСекции.Стеллаж КАК Стеллаж,
	|	Лико_СкладскиеСекции.Адрес1 КАК Адрес1,
	|	Лико_СкладскиеСекции.Адрес2 КАК Адрес2,
	|	Лико_СкладскиеСекции.Адрес3 КАК Адрес3,
	|	Лико_СкладскиеСекции.КоличествоАдресов КАК КоличествоАдресов,
	|	Лико_СкладскиеСекции.ЗапретРазмещения КАК ЗапретРазмещения,
	|	Лико_СкладскиеСекции.Этаж КАК Этаж
	|ИЗ
	|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
	|ГДЕ
	|	Лико_СкладскиеСекции.Стеллаж В (&МассивСтеллажей)
	|	И НЕ Лико_СкладскиеСекции.ПометкаУдаления";
	ЗапросСекций.УстановитьПараметр("МассивСтеллажей", МассивСтеллажей);
	РезультатСекций = ЗапросСекций.Выполнить();

	СекцииПоСтеллажам = Новый Соответствие;
	МассивВсехСекций = Новый Массив;
	Если НЕ РезультатСекций.Пустой() Тогда
		ВыборкаСекций = РезультатСекций.Выбрать();
		Пока ВыборкаСекций.Следующий() Цикл
			МассивВсехСекций.Добавить(ВыборкаСекций.Ссылка);
			МассивС = СекцииПоСтеллажам.Получить(ВыборкаСекций.Стеллаж);
			Если МассивС = Неопределено Тогда
				МассивС = Новый Массив;
				СекцииПоСтеллажам.Вставить(ВыборкаСекций.Стеллаж, МассивС);
			КонецЕсли;
			КолАдр = ВыборкаСекций.КоличествоАдресов;
			Если КолАдр = 0 Тогда
				КолАдр = 3;
			КонецЕсли;
			МассивС.Добавить(
				Новый Структура("Ссылка,КоличествоАдресов,Адрес1,Адрес2,Адрес3,ЗапретРазмещения,Этаж",
					ВыборкаСекций.Ссылка, КолАдр, ВыборкаСекций.Адрес1, ВыборкаСекций.Адрес2,
					ВыборкаСекций.Адрес3, ВыборкаСекций.ЗапретРазмещения, ВыборкаСекций.Этаж));
		КонецЦикла;
	КонецЕсли;

	// === Шаг 2. Табличная часть Этажи всех стеллажей (замена ПолучитьОбъект в цикле) ===
	ЗапросЭтажей = Новый Запрос;
	ЗапросЭтажей.Текст =
	"ВЫБРАТЬ
	|	Лико_СтеллажиЭтажи.Ссылка КАК Стеллаж,
	|	Лико_СтеллажиЭтажи.НомерСтроки КАК НомерСтроки,
	|	Лико_СтеллажиЭтажи.Типоразмер КАК Типоразмер
	|ИЗ
	|	Справочник.Лико_Стеллажи.Этажи КАК Лико_СтеллажиЭтажи
	|ГДЕ
	|	Лико_СтеллажиЭтажи.Ссылка В (&МассивСтеллажей)";
	ЗапросЭтажей.УстановитьПараметр("МассивСтеллажей", МассивСтеллажей);
	РезЭтажи = ЗапросЭтажей.Выполнить();

	// Собираем все уникальные типоразмеры
	ВсеТипоразмеры = Новый Массив;
	Если НЕ РезЭтажи.Пустой() Тогда
		ВыборкаЭт = РезЭтажи.Выбрать();
		Пока ВыборкаЭт.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаЭт.Типоразмер)
				И ВсеТипоразмеры.Найти(ВыборкаЭт.Типоразмер) = Неопределено Тогда
				ВсеТипоразмеры.Добавить(ВыборкаЭт.Типоразмер);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ДанныеТипоразмеров = Новый Соответствие;
	Если ВсеТипоразмеры.Количество() > 0 Тогда
		ДанныеТипоразмеров = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ВсеТипоразмеры, "Ширина");
	КонецЕсли;

	// Строим карту: Стеллаж -> Соответствие(НомерСтроки -> ШиринаМм)
	ШиринаПоЭтажамПоСтеллажам = Новый Соответствие;
	Если НЕ РезЭтажи.Пустой() Тогда
		ВыборкаЭт = РезЭтажи.Выбрать();
		Пока ВыборкаЭт.Следующий() Цикл
			КартаШир = ШиринаПоЭтажамПоСтеллажам.Получить(ВыборкаЭт.Стеллаж);
			Если КартаШир = Неопределено Тогда
				КартаШир = Новый Соответствие;
				ШиринаПоЭтажамПоСтеллажам.Вставить(ВыборкаЭт.Стеллаж, КартаШир);
			КонецЕсли;
			Если ЗначениеЗаполнено(ВыборкаЭт.Типоразмер) Тогда
				ДанныеТип = ДанныеТипоразмеров.Получить(ВыборкаЭт.Типоразмер);
				Если ДанныеТип <> Неопределено Тогда
					КартаШир.Вставить(ВыборкаЭт.НомерСтроки, ДанныеТип.Ширина);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// === Шаг 3. Паллеты во всех секциях ===
	ЗанятыеАдресаПоСекциям = Новый Соответствие;
	МассивПаллетСсылки = Новый Массив;
	Если МассивВсехСекций.Количество() > 0 Тогда
		ЗапросПаллет = Новый Запрос;
		ЗапросПаллет.Текст =
		"ВЫБРАТЬ
		|	Лико_ПаллетыВСекцияхОстатки.Секция КАК Секция,
		|	Лико_ПаллетыВСекцияхОстатки.Адрес КАК Адрес,
		|	Лико_ПаллетыВСекцияхОстатки.Паллет КАК Паллет
		|ИЗ
		|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(, Секция В (&МассивСекций)) КАК Лико_ПаллетыВСекцияхОстатки";
		ЗапросПаллет.УстановитьПараметр("МассивСекций", МассивВсехСекций);
		РезПалл = ЗапросПаллет.Выполнить();
		Если НЕ РезПалл.Пустой() Тогда
			ВыборкаП = РезПалл.Выбрать();
			Пока ВыборкаП.Следующий() Цикл
				КартаАдр = ЗанятыеАдресаПоСекциям.Получить(ВыборкаП.Секция);
				Если КартаАдр = Неопределено Тогда
					КартаАдр = Новый Соответствие;
					ЗанятыеАдресаПоСекциям.Вставить(ВыборкаП.Секция, КартаАдр);
				КонецЕсли;
				КартаАдр.Вставить(ВыборкаП.Адрес, ВыборкаП.Паллет);
				Если МассивПаллетСсылки.Найти(ВыборкаП.Паллет) = Неопределено Тогда
					МассивПаллетСсылки.Добавить(ВыборкаП.Паллет);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	// === Шаг 4. Ширина всех паллет ===
	ШиринаПаллет = Новый Соответствие;
	Если МассивПаллетСсылки.Количество() > 0 Тогда
		ЗапросШир = Новый Запрос;
		ЗапросШир.Текст =
		"ВЫБРАТЬ
		|	Лико_ПараметрыПаллетСрезПоследних.Паллет КАК Паллет,
		|	Лико_ТипоразмерыПаллет.Ширина КАК Ширина
		|ИЗ
		|	РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(, Паллет В (&МассивПаллет))
		|		КАК Лико_ПараметрыПаллетСрезПоследних
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТипоразмерыПаллет КАК Лико_ТипоразмерыПаллет
		|	ПО Лико_ПараметрыПаллетСрезПоследних.Типоразмер = Лико_ТипоразмерыПаллет.Ссылка";
		ЗапросШир.УстановитьПараметр("МассивПаллет", МассивПаллетСсылки);
		РезШир = ЗапросШир.Выполнить();
		Если НЕ РезШир.Пустой() Тогда
			ВыбШир = РезШир.Выбрать();
			Пока ВыбШир.Следующий() Цикл
				ШиринаПаллет.Вставить(ВыбШир.Паллет, ВыбШир.Ширина);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	// === Шаг 5. Подсчёт процентов в памяти ===
	Для Каждого Стеллаж Из МассивСтеллажей Цикл
		МассивС = СекцииПоСтеллажам.Получить(Стеллаж);
		Если МассивС = Неопределено Тогда
			Результат.Вставить(Стеллаж, Новый Структура("Процент, СвободныхЯчеек", 0, 0));
			Продолжить;
		КонецЕсли;

		ШиринаПоЭтажам = ШиринаПоЭтажамПоСтеллажам.Получить(Стеллаж);
		Если ШиринаПоЭтажам = Неопределено Тогда
			ШиринаПоЭтажам = Новый Соответствие;
		КонецЕсли;

		ВсегоЯчеек = 0;
		ЗеленыхЯчеек = 0;
		Для Каждого ДанныеС Из МассивС Цикл
			КартаАдресов = ЗанятыеАдресаПоСекциям.Получить(ДанныеС.Ссылка);
			Если КартаАдресов = Неопределено Тогда
				КартаАдресов = Новый Соответствие;
			КонецЕсли;
			ВсеАдреса = Новый Массив;
			ВсеАдреса.Добавить(ДанныеС.Адрес1);
			ВсеАдреса.Добавить(ДанныеС.Адрес2);
			ВсеАдреса.Добавить(ДанныеС.Адрес3);
			ШиринаСекцииМм = 0;
			Если ДанныеС.Этаж <> Неопределено Тогда
				Ш = ШиринаПоЭтажам.Получить(ДанныеС.Этаж);
				Если Ш <> Неопределено Тогда
					ШиринаСекцииМм = Ш;
				КонецЕсли;
			КонецЕсли;
			// Перекрытие паллетами
			ЯчейкаПерекрыта = Новый Массив;
			Для ИА = 0 По ДанныеС.КоличествоАдресов - 1 Цикл
				ЯчейкаПерекрыта.Добавить(Ложь);
			КонецЦикла;
			Если ШиринаСекцииМм > 0 И ДанныеС.КоличествоАдресов > 1 Тогда
				ШиринаЯчейкиМм = ШиринаСекцииМм / ДанныеС.КоличествоАдресов;
				Для ИА = 0 По ДанныеС.КоличествоАдресов - 1 Цикл
					ПаллетСсылка = КартаАдресов.Получить(ВсеАдреса[ИА]);
					Если ПаллетСсылка = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					ЗначШир = ШиринаПаллет.Получить(ПаллетСсылка);
					ШиринаПалл = ?(ЗначШир <> Неопределено, ЗначШир, 0);
					Если ДанныеС.КоличествоАдресов = 1 Тогда
						ЛевыйПалл = (ШиринаСекцииМм - ШиринаПалл) / 2;
					ИначеЕсли ИА = 0 Тогда
						ЛевыйПалл = 0;
					ИначеЕсли ИА = ДанныеС.КоличествоАдресов - 1 Тогда
						ЛевыйПалл = ШиринаСекцииМм - ШиринаПалл;
					Иначе
						ЛевыйПалл = (ШиринаСекцииМм - ШиринаПалл) / 2;
					КонецЕсли;
					ПравыйПалл = ЛевыйПалл + ШиринаПалл;
					Для ИА2 = 0 По ДанныеС.КоличествоАдресов - 1 Цикл
						Если ИА2 = ИА Тогда Продолжить; КонецЕсли;
						ЛеваяЯчейки = ИА2 * ШиринаЯчейкиМм;
						ПраваяЯчейки = (ИА2 + 1) * ШиринаЯчейкиМм;
						Если ЛевыйПалл < ПраваяЯчейки И ПравыйПалл > ЛеваяЯчейки Тогда
							ЯчейкаПерекрыта[ИА2] = Истина;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
			Для ИА = 0 По ДанныеС.КоличествоАдресов - 1 Цикл
				ВсегоЯчеек = ВсегоЯчеек + 1;
				ЕстьПаллет = КартаАдресов.Получить(ВсеАдреса[ИА]) <> Неопределено;
				ЕстьПерекрытие = ЯчейкаПерекрыта[ИА];
				ЕстьЗапрет = ДанныеС.ЗапретРазмещения;
				Если НЕ ЕстьПаллет И НЕ ЕстьПерекрытие И НЕ ЕстьЗапрет Тогда
					ЗеленыхЯчеек = ЗеленыхЯчеек + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если ВсегоЯчеек = 0 Тогда
			Результат.Вставить(Стеллаж, Новый Структура("Процент, СвободныхЯчеек", 0, 0));
		Иначе
			Процент = Окр((ВсегоЯчеек - ЗеленыхЯчеек) / ВсегоЯчеек * 100, 0);
			Результат.Вставить(Стеллаж, Новый Структура("Процент, СвободныхЯчеек", Мин(Процент, 100), ЗеленыхЯчеек));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции


&НаСервере
Функция ПолучитьПроцентЗагрузкиСтеллажаПоЯчейкам(СтеллажСсылка)
	//+Лико m.shenderov 22.06.2026
	// Считает процент занятости по ячейкам (консистентно с HTML-визуализацией)
	// Учитывает: КоличествоАдресов=0→3, занятые адреса, ЗапретРазмещения, перекрытие паллетами
	УстановитьПривилегированныйРежим(Истина);
	// 1. Все секции стеллажа (с этажом для поиска ширины секции)
	ЗапросСекций = Новый Запрос;
	ЗапросСекций.Текст =
		"ВЫБРАТЬ
		|	Лико_СкладскиеСекции.Ссылка КАК Ссылка,
		|	Лико_СкладскиеСекции.Адрес1 КАК Адрес1,
		|	Лико_СкладскиеСекции.Адрес2 КАК Адрес2,
		|	Лико_СкладскиеСекции.Адрес3 КАК Адрес3,
		|	Лико_СкладскиеСекции.КоличествоАдресов КАК КоличествоАдресов,
		|	Лико_СкладскиеСекции.ЗапретРазмещения КАК ЗапретРазмещения,
		|	Лико_СкладскиеСекции.Этаж КАК Этаж
		|ИЗ
		|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
		|ГДЕ
		|	Лико_СкладскиеСекции.Стеллаж = &Стеллаж
		|	И НЕ Лико_СкладскиеСекции.ПометкаУдаления";
	ЗапросСекций.УстановитьПараметр("Стеллаж", СтеллажСсылка);
	РезультатСекций = ЗапросСекций.Выполнить();
	Если РезультатСекций.Пустой() Тогда
		Возврат 0;
	КонецЕсли;
	// Собираем ссылки секций и данные
	МассивСекций = Новый Массив;
	ДанныеСекций = Новый Соответствие;
	ВыборкаСекций = РезультатСекций.Выбрать();
	Пока ВыборкаСекций.Следующий() Цикл
		МассивСекций.Добавить(ВыборкаСекций.Ссылка);
		КолАдр = ВыборкаСекций.КоличествоАдресов;
		Если КолАдр = 0 Тогда
			КолАдр = 3;
		КонецЕсли;
		ДанныеСекций.Вставить(ВыборкаСекций.Ссылка,
			Новый Структура("КоличествоАдресов, Адрес1, Адрес2, Адрес3, ЗапретРазмещения, Этаж",
				КолАдр, ВыборкаСекций.Адрес1, ВыборкаСекций.Адрес2, ВыборкаСекций.Адрес3,
				ВыборкаСекций.ЗапретРазмещения, ВыборкаСекций.Этаж));
	КонецЦикла;
	// 2. Ширина секций по этажам (из типоразмера этажа стеллажа)
	СтеллажОбъект = СтеллажСсылка.ПолучитьОбъект();
	ЭтажиТЧ = СтеллажОбъект.Этажи;
	МассивТипоразмеров = Новый Массив;
	Для Каждого СтрЭтажа Из ЭтажиТЧ Цикл
		Если ЗначениеЗаполнено(СтрЭтажа.Типоразмер) Тогда
			МассивТипоразмеров.Добавить(СтрЭтажа.Типоразмер);
		КонецЕсли;
	КонецЦикла;
	ШиринаПоЭтажам = Новый Соответствие;
	Если МассивТипоразмеров.Количество() > 0 Тогда
		ДанныеТипоразмеров = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивТипоразмеров, "Ширина");
		Для Каждого СтрЭтажа Из ЭтажиТЧ Цикл
			Если ЗначениеЗаполнено(СтрЭтажа.Типоразмер) Тогда
				ДанныеТип = ДанныеТипоразмеров.Получить(СтрЭтажа.Типоразмер);
				Если ДанныеТип <> Неопределено Тогда
					ШиринаПоЭтажам.Вставить(СтрЭтажа.НомерСтроки, ДанныеТип.Ширина);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// 3. Паллеты в секциях (с ссылкой на паллет)
	ЗапросПаллет = Новый Запрос;
	ЗапросПаллет.Текст =
		"ВЫБРАТЬ
		|	Лико_ПаллетыВСекцияхОстатки.Секция КАК Секция,
		|	Лико_ПаллетыВСекцияхОстатки.Адрес КАК Адрес,
		|	Лико_ПаллетыВСекцияхОстатки.Паллет КАК Паллет
		|ИЗ
		|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
		|		,
		|		Секция В (&МассивСекций)
		|	) КАК Лико_ПаллетыВСекцияхОстатки
		|ГДЕ
		|	Лико_ПаллетыВСекцияхОстатки.КоличествоОстаток > 0";
	ЗапросПаллет.УстановитьПараметр("МассивСекций", МассивСекций);
	РезультатПаллет = ЗапросПаллет.Выполнить();
	// Индекс: Секция → Адрес → ПаллетСсылка
	ЗанятыеАдреса = Новый Соответствие;
	МассивПаллетСсылки = Новый Массив;
	Если НЕ РезультатПаллет.Пустой() Тогда
		ВыборкаПаллет = РезультатПаллет.Выбрать();
		Пока ВыборкаПаллет.Следующий() Цикл
			КартаАдресов = ЗанятыеАдреса.Получить(ВыборкаПаллет.Секция);
			Если КартаАдресов = Неопределено Тогда
				КартаАдресов = Новый Соответствие;
				ЗанятыеАдреса.Вставить(ВыборкаПаллет.Секция, КартаАдресов);
			КонецЕсли;
			КартаАдресов.Вставить(ВыборкаПаллет.Адрес, ВыборкаПаллет.Паллет);
			Если МассивПаллетСсылки.Найти(ВыборкаПаллет.Паллет) = Неопределено Тогда
				МассивПаллетСсылки.Добавить(ВыборкаПаллет.Паллет);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// 4. Ширина паллет
	ШиринаПаллет = Новый Соответствие;
	Если МассивПаллетСсылки.Количество() > 0 Тогда
		ЗапросШир = Новый Запрос;
		ЗапросШир.Текст =
			"ВЫБРАТЬ
			|	Лико_ПараметрыПаллетСрезПоследних.Паллет КАК Паллет,
			|	Лико_ТипоразмерыПаллет.Ширина КАК Ширина
			|ИЗ
			|	РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(, Паллет В (&МассивПаллет))
			|	КАК Лико_ПараметрыПаллетСрезПоследних
			|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТипоразмерыПаллет КАК Лико_ТипоразмерыПаллет
			|	ПО Лико_ПараметрыПаллетСрезПоследних.Типоразмер = Лико_ТипоразмерыПаллет.Ссылка";
		ЗапросШир.УстановитьПараметр("МассивПаллет", МассивПаллетСсылки);
		РезШир = ЗапросШир.Выполнить();
		Если НЕ РезШир.Пустой() Тогда
			ВыбШир = РезШир.Выбрать();
			Пока ВыбШир.Следующий() Цикл
				ШиринаПаллет.Вставить(ВыбШир.Паллет, ВыбШир.Ширина);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	// 5. Подсчёт ячеек (с перекрытием)
	ВсегоЯчеек = 0;
	ЗеленыхЯчеек = 0;
	Для Каждого ЭлСекции Из ДанныеСекций Цикл
		ДанныеС = ЭлСекции.Значение;
		КартаАдресов = ЗанятыеАдреса.Получить(ЭлСекции.Ключ);
		Если КартаАдресов = Неопределено Тогда
			КартаАдресов = Новый Соответствие;
		КонецЕсли;
		ВсеАдреса = Новый Массив;
		ВсеАдреса.Добавить(ДанныеС.Адрес1);
		ВсеАдреса.Добавить(ДанныеС.Адрес2);
		ВсеАдреса.Добавить(ДанныеС.Адрес3);
		ШиринаСекцииМм = 0;
		Если ДанныеС.Этаж <> Неопределено Тогда
			Ш = ШиринаПоЭтажам.Получить(ДанныеС.Этаж);
			Если Ш <> Неопределено Тогда
				ШиринаСекцииМм = Ш;
			КонецЕсли;
		КонецЕсли;
		// Перекрытие паллетами
		ЯчейкаПерекрыта = Новый Массив;
		Для ИА = 0 По ДанныеС.КоличествоАдресов - 1 Цикл
			ЯчейкаПерекрыта.Добавить(Ложь);
		КонецЦикла;
		Если ШиринаСекцииМм > 0 И ДанныеС.КоличествоАдресов > 1 Тогда
			ШиринаЯчейкиМм = ШиринаСекцииМм / ДанныеС.КоличествоАдресов;
			Для ИА = 0 По ДанныеС.КоличествоАдресов - 1 Цикл
				ПаллетСсылка = КартаАдресов.Получить(ВсеАдреса[ИА]);
				Если ПаллетСсылка = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ЗначШир = ШиринаПаллет.Получить(ПаллетСсылка);
				ШиринаПалл = ?(ЗначШир <> Неопределено, ЗначШир, 0);
				Если ДанныеС.КоличествоАдресов = 1 Тогда
					ЛевыйПалл = (ШиринаСекцииМм - ШиринаПалл) / 2;
				ИначеЕсли ИА = 0 Тогда
					ЛевыйПалл = 0;
				ИначеЕсли ИА = ДанныеС.КоличествоАдресов - 1 Тогда
					ЛевыйПалл = ШиринаСекцииМм - ШиринаПалл;
				Иначе
					ЛевыйПалл = (ШиринаСекцииМм - ШиринаПалл) / 2;
				КонецЕсли;
				ПравыйПалл = ЛевыйПалл + ШиринаПалл;
				Для ИА2 = 0 По ДанныеС.КоличествоАдресов - 1 Цикл
					Если ИА2 = ИА Тогда Продолжить; КонецЕсли;
					ЛеваяЯчейки = ИА2 * ШиринаЯчейкиМм;
					ПраваяЯчейки = (ИА2 + 1) * ШиринаЯчейкиМм;
					Если ЛевыйПалл < ПраваяЯчейки И ПравыйПалл > ЛеваяЯчейки Тогда
						ЯчейкаПерекрыта[ИА2] = Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		Для ИА = 0 По ДанныеС.КоличествоАдресов - 1 Цикл
			ВсегоЯчеек = ВсегоЯчеек + 1;
			ЕстьПаллет = КартаАдресов.Получить(ВсеАдреса[ИА]) <> Неопределено;
			ЕстьПерекрытие = ЯчейкаПерекрыта[ИА];
			ЕстьЗапрет = ДанныеС.ЗапретРазмещения;
			Если НЕ ЕстьПаллет И НЕ ЕстьПерекрытие И НЕ ЕстьЗапрет Тогда
				ЗеленыхЯчеек = ЗеленыхЯчеек + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если ВсегоЯчеек = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Процент = Окр((ВсегоЯчеек - ЗеленыхЯчеек) / ВсегоЯчеек * 100, 0);
	Возврат Мин(Процент, 100);
КонецФункции
&НаСервере
Функция ПолучитьПроцентЗагрузкиСтеллажа(СтеллажСсылка)
	
	//+Лико m.shenderov 15.05.2026 
	  УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
			|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Лико_СкладскиеСекции.КоличествоАдресов = 0 ТОГДА 3 ИНАЧЕ Лико_СкладскиеСекции.КоличествоАдресов КОНЕЦ), 0) КАК ВсегоАдресов
		|ИЗ
		|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
		|ГДЕ
		|	Лико_СкладскиеСекции.Стеллаж = &Стеллаж
		|	И НЕ Лико_СкладскиеСекции.ПометкаУдаления";
	Запрос.УстановитьПараметр("Стеллаж", СтеллажСсылка);
	РезультатСекций = Запрос.Выполнить();
	
	Если РезультатСекций.Пустой() Тогда
		Возврат 0;
	КонецЕсли;
	
	ВыборкаСекций = РезультатСекций.Выбрать();
	ВыборкаСекций.Следующий();
	ВсегоАдресов = ВыборкаСекций.ВсегоАдресов;
	
	Если ВсегоАдресов = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Лико_ПаллетыВСекцияхОстатки.Адрес КАК Адрес
		|ИЗ
		|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
		|		,
		|		Секция В (
		|			ВЫБРАТЬ
		|				Лико_СкладскиеСекции.Ссылка
		|			ИЗ
		|				Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
		|			ГДЕ
		|				Лико_СкладскиеСекции.Стеллаж = &Стеллаж
		|				И НЕ Лико_СкладскиеСекции.ПометкаУдаления
		|		)
		|	) КАК Лико_ПаллетыВСекцияхОстатки
		|ГДЕ
		|	Лико_ПаллетыВСекцияхОстатки.КоличествоОстаток > 0";
	ЗапросОстатков.УстановитьПараметр("Стеллаж", СтеллажСсылка);
	РезультатОстатков = ЗапросОстатков.Выполнить();
	
	ЗанятоАдресов = РезультатОстатков.Выбрать().Количество();
	Процент = Окр(ЗанятоАдресов / ВсегоАдресов * 100, 0);
	Возврат Мин(Процент, 100);
КонецФункции

&НаСервере
Функция ЦветЗагрузкиПроцент(ПроцентЗагрузки)
	//+Лико m.shenderov 15.05.2026
	  УстановитьПривилегированныйРежим(Истина);
	Если ПроцентЗагрузки < 50 Тогда
		Возврат WebЦвета.Зеленый;
	ИначеЕсли ПроцентЗагрузки <= 89 Тогда
		Возврат WebЦвета.Синий;
	ИначеЕсли ПроцентЗагрузки <= 99 Тогда
		Возврат WebЦвета.Оранжевый;
	Иначе
		Возврат WebЦвета.Красный;
	КонецЕсли;
КонецФункции

//+Лико m.shenderov 23.06.2026 — hex цвета по проценту загрузки (этажи, общая загрузка)
&НаСервере
Функция ЦветЗагрузкиHex(Процент)
	Если Процент < 50 Тогда
		Возврат "#228B22";
	ИначеЕсли Процент <= 89 Тогда
		Возврат "#0000FF";
	ИначеЕсли Процент <= 99 Тогда
		Возврат "#FFA500";
	Иначе
		Возврат "#FF0000";
	КонецЕсли;
КонецФункции

&НаСервере
Функция ПолучитьЦветаСтелажейHexНаСервере()
	//+Лико m.shenderov 23.06.2026 — цвета стеллажей из ДопНастройки.ЦветСтеллажа → hex
	УстановитьПривилегированныйРежим(Истина);
	СооСтелажей = Справочники.Лико_Стеллажи.ЦветаСтелажей(Склад);
	СооHex = Новый Соответствие;
	hexChars = "0123456789ABCDEF";
	Для Каждого КЗ Из СооСтелажей Цикл
		Цвет = КЗ.Значение;
		Если ТипЗнч(Цвет) <> Тип("Цвет") Тогда
			Продолжить;
		КонецЕсли;
		к = Цвет.Красный;
		з = Цвет.Зеленый;
		с = Цвет.Синий;
		Hex = "#"
			+ Сред(hexChars, Цел(к / 16) + 1, 1) + Сред(hexChars, (к % 16) + 1, 1)
			+ Сред(hexChars, Цел(з / 16) + 1, 1) + Сред(hexChars, (з % 16) + 1, 1)
			+ Сред(hexChars, Цел(с / 16) + 1, 1) + Сред(hexChars, (с % 16) + 1, 1);
		СооHex.Вставить(КЗ.Ключ, Hex);
	КонецЦикла;
	Возврат СооHex;
КонецФункции

