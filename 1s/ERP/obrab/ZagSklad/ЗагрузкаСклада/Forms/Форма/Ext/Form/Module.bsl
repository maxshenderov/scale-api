	КонецПопытки;
КонецФункции

&НаСервере
Функция ПолучитьSystemPromptWMS(Склад) Экспорт
	Результат = ПолучитьТекстМакета("WMS_ПодобратьЯчейку") + Символы.ПС + Символы.ПС
		+ ПолучитьТекстМакета("WMS_ОшибкиРазмещения") + Символы.ПС + Символы.ПС
		+ ПолучитьТекстМакета("WMS_ВремяДоступа");

	СоответствиеСкладТопология = Новый Соответствие;
	СоответствиеСкладТопология.Вставить("ЛК Высотный Новый", "WMS_Топология_ЛК_Высотный");

	Если ЗначениеЗаполнено(Склад) Тогда
		КлючСклада = СокрЛП(Склад.Наименование);
		ИмяМакетаТопологии = СоответствиеСкладТопология.Получить(КлючСклада);
		Если ИмяМакетаТопологии <> Неопределено Тогда
			Результат = Результат + Символы.ПС + Символы.ПС
				+ ПолучитьТекстМакета(ИмяМакетаТопологии);
		Иначе
			Результат = Результат + Символы.ПС + Символы.ПС
				+ ПолучитьКраткуюТопологию(Склад);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаСервере
Функция ПолучитьКраткуюТопологию(Склад) Экспорт
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Лико_Стеллажи.Наименование КАК Стеллаж,
		|	Лико_Стеллажи.КоличествоСекций КАК КоличествоСекций,
		|	Лико_Стеллажи.КоличествоЯчеекВСекции КАК КоличествоАдресов,
		|	Лико_Стеллажи.МинШиринаПаллета КАК МинШирина,
		|	Лико_Стеллажи.МаксШиринаПаллета КАК МаксШирина,
		|	Лико_Стеллажи.МинГлубинаПаллета КАК МинГлубина,
		|	Лико_Стеллажи.МаксГлубинаПаллета КАК МаксГлубина,
			|	Лико_Стеллажи.Узкопроходный КАК Узкопроходный
		|ИЗ
		|	Справочник.Лико_Стеллажи КАК Лико_Стеллажи
		|ГДЕ
		|	Лико_Стеллажи.Склад = &Склад";
		Запрос.УстановитьПараметр("Склад", Склад);
		РезультатЗапроса = Запрос.Выполнить();

		Топология = "## Топология склада: " + Склад.Наименование + Символы.ПС + Символы.ПС;
		Топология = Топология + "| Стеллаж | Секций | Адресов | Ширина мин | Ширина макс | Глубина мин | Глубина макс | Узкопроходный |" + Символы.ПС;
		Топология = Топология + "|---------|--------|---------|------------|-------------|-------------|-------------|-------------|" + Символы.ПС;

		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Топология = Топология + СтрШаблон("| %1 | %2 | %3 | %4 | %5 | %6 | %7 | %8 |",
				Выборка.Стеллаж, Выборка.КоличествоСекций, Выборка.КоличествоАдресов,
				Выборка.МинШирина, Выборка.МаксШирина,
				Выборка.МинГлубина, Выборка.МаксГлубина, Выборка.Узкопроходный) + Символы.ПС;
		КонецЦикла;

		Если РезультатЗапроса.Пустой() Тогда
			Топология = Топология + "> Данные о топологии для данного склада не загружены.";
		КонецЕсли;

		Возврат Топология;
	Исключение
		Возврат "> Не удалось загрузить топологию склада.";
	КонецПопытки;
КонецФункции


&НаСервере
Функция СформироватьТЗНаСервере() Экспорт
	Если Не ЗначениеЗаполнено(Требования) Тогда
		Возврат "Ошибка: поле Требования пусто.";
	КонецЕсли;

	WMS_SP = ПолучитьSystemPromptWMS(Склад);
	СистемныйПромпт = "Ты — WMS-эксперт. Сформируй техническое задание в формате Markdown. "
		+ "Используй разделы: 1.Цель 2.Требования 3.Объекты 4.Алгоритмы 5.Риски 6.Тест-кейсы.";

	Настройки = ПараметрыПровайдера(Провайдер, Модель);
	История = НоваяИсторияДиалога(СистемныйПромпт, "markdown", WMS_SP);
	РезультатLLM = СпроситьLLM(История, Требования, Настройки, , "markdown");

	Если РезультатLLM.Успех Тогда
		ЧерновикТЗ = РезультатLLM.Текст;
		Возврат "ТЗ сформировано. Проверьте вкладку Черновик (тех. задание).";
	Иначе
		Возврат "Ошибка формирования ТЗ: " + РезультатLLM.ОписаниеОшибки;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ЭкспертизаНаСервере() Экспорт
	Если Не ЗначениеЗаполнено(ЧерновикТЗ) Тогда
		Если Не ЗначениеЗаполнено(Требования) Тогда
			Возврат "Ошибка: введите требования или сформируйте черновик ТЗ.";
		КонецЕсли;
		СформироватьТЗНаСервере();
	КонецЕсли;

	WMS_SP = ПолучитьSystemPromptWMS(Склад);
	Настройки = ПараметрыПровайдера(Провайдер, Модель);

	// Агент Критик
	СП_Критик = "Ты — WMS-эксперт-КРИТИК. Найди противоречия, ошибки, риски в ТЗ. "
		+ "Формат: ## Противоречия, ## Ошибки, ## Риски, ## Неучтённые сценарии.";
	ИстК = НоваяИсторияДиалога(СП_Критик, "markdown", WMS_SP);
	ОтвК = СпроситьLLM(ИстК, "Проанализируй ТЗ:" + Символы.ПС + ЧерновикТЗ, Настройки, , "markdown");
	ТекстК = ?(ОтвК.Успех, ОтвК.Текст, "Ошибка: " + ОтвК.ОписаниеОшибки);

	// Агент Адвокат
	СП_Адв = "Ты — WMS-эксперт-АДВОКАТ. Защити решение, объясни бизнес-логику. "
		+ "Формат: ## Обоснование, ## Бизнес-логика, ## Аргументы, ## Соответствие WMS.";
	ИстА = НоваяИсторияДиалога(СП_Адв, "markdown", WMS_SP);
	ОтвА = СпроситьLLM(ИстА, "Защити ТЗ:" + Символы.ПС + ЧерновикТЗ, Настройки, , "markdown");
	ТекстА = ?(ОтвА.Успех, ОтвА.Текст, "Ошибка: " + ОтвА.ОписаниеОшибки);

	// Агент Судья
	СП_Суд = "Ты — WMS-эксперт-СУДЬЯ. Проанализируй аргументы и вынеси вердикт: "
		+ "ПРИНЯТО / ТРЕБУЕТ ДОРАБОТКИ / ОТКЛОНЕНО. "
		+ "Формат: ## Вердикт, ## Анализ, ## Вопросы, ## Рекомендация.";
	ИстС = НоваяИсторияДиалога(СП_Суд, "markdown", WMS_SP);
	Сооб = "## ТЗ" + Символы.ПС + ЧерновикТЗ + Символы.ПС + Символы.ПС
		+ "## КРИТИК" + Символы.ПС + ТекстК + Символы.ПС + Символы.ПС
		+ "## АДВОКАТ" + Символы.ПС + ТекстА;
	ОтвС = СпроситьLLM(ИстС, Сооб, Настройки, , "markdown");

	Если ОтвС.Успех Тогда
		Если Найти(ОтвС.Текст, "ПРИНЯТО") > 0 Тогда
			ТехническоеЗадание = ЧерновикТЗ;
		КонецЕсли;
		Возврат ОтвС.Текст;
	Иначе
		Возврат "Ошибка Судьи: " + ОтвС.ОписаниеОшибки;
	КонецЕсли;
КонецФункции


