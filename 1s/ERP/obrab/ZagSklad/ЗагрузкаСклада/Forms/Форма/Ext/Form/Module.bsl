&НаСервере
Функция ПолучитьОпределенияИнструментов(Имена) Экспорт
	Если Имена = Неопределено Или Имена.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Массив = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Если Имя = "validate_pallet_placement" Тогда
			Опр = ИнструментОшибкиРазмещения();
			Для Каждого Инстр Из Опр Цикл
				Массив.Добавить(Инстр);
			КонецЦикла;
		ИначеЕсли Имя = "find_cell_for_pallet" Тогда
				Опр = ИнструментПодбораЯчейки();
				Для Каждого Инстр Из Опр Цикл
					Массив.Добавить(Инстр);
				КонецЦикла;
		ИначеЕсли Имя = "explain_access_time" Тогда
				Опр = ИнструментВремениДоступа();
				Для Каждого Инстр Из Опр Цикл
					Массив.Добавить(Инстр);
				КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Массив;
КонецФункции //-<---Лико m.shenderov 13.06.2026

