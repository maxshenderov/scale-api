		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		Диалог.Заголовок = "Сохранить визуализацию склада";
		Диалог.Фильтр = "HTML файлы (*.html)|*.html";
		Диалог.Расширение = "html";
		Диалог.ПолноеИмяФайла = "Загрузка_склада_" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd_HHmm") + ".html";
		Если Диалог.Выбрать() Тогда
			СгенерироватьHTMLНаСервере();
			ЗаписьТекста = Новый ЗаписьТекста(Диалог.ПолноеИмяФайла, КодировкаТекста.UTF8);
			ЗаписьТекста.Записать(ПолныйHTMLСтрока);
			ЗаписьТекста.Закрыть();
			Сообщить("Сохранено: " + Диалог.ПолноеИмяФайла);
		КонецЕсли;
	КонецПроцедуры

	&НаСервере
	Процедура СгенерироватьHTMLНаСервере()
		ПолныйHTMLСтрока = СформироватьПолныйHTMLСохранить();
	КонецПроцедуры


&НаКлиенте
Процедура ИспользоватьАсистентаAIПриИзменении(Элемент)
	УстановитьВидимость();
КонецПроцедуры


