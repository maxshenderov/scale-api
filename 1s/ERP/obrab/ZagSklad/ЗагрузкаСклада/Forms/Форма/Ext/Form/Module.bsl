			Продолжить;
		КонецЕсли;
		
		ДанныеЭтажа = ДанныеЭтажей.Получить(НомерЭтажа);
		ВысотаЭтажаМм = 0;
		ШиринаСекцииМм = 0;
		ВесогрузкаЭтажа = 0;
