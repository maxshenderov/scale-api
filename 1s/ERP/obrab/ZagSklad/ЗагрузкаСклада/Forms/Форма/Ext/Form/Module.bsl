#Область LLM_Инструменты

// Создать новый инструмент (функцию для LLM).
&НаСервере
Функция НовыйИнструмент(Имя, Описание) Экспорт
    СхемаПараметров = Новый Структура;
    СхемаПараметров.Вставить("type",       "object");
    СхемаПараметров.Вставить("properties", Новый Структура);
    СхемаПараметров.Вставить("required",   Новый Массив);

    Функция_ = Новый Структура;
    Функция_.Вставить("name",        Имя);
    Функция_.Вставить("description", Описание);
    Функция_.Вставить("parameters",  СхемаПараметров);

    Инструмент = Новый Структура;
    Инструмент.Вставить("type",     "function");
    Инструмент.Вставить("function", Функция_);
    Возврат Инструмент;
КонецФункции

&НаСервере
Процедура ДобавитьПараметр(Инструмент, Имя, Тип, Описание, Обязательный = Истина) Экспорт
    Свойство = Новый Структура;
    Если Тип = "string" Тогда
        Свойство.Вставить("type", "string");  Свойство.Вставить("description", Описание);
    ИначеЕсли Тип = "integer" Тогда
        Свойство.Вставить("type", "integer"); Свойство.Вставить("description", Описание);
    ИначеЕсли Тип = "number" Тогда
        Свойство.Вставить("type", "number");  Свойство.Вставить("description", Описание);
    ИначеЕсли Тип = "boolean" Тогда
        Свойство.Вставить("type", "boolean"); Свойство.Вставить("description", Описание);
    ИначеЕсли Тип = "date" Тогда
        Свойство.Вставить("type", "string");  Свойство.Вставить("format", "date");
        Свойство.Вставить("description", Описание + " (формат YYYY-MM-DD)");
    ИначеЕсли Тип = "datetime" Тогда
        Свойство.Вставить("type", "string");  Свойство.Вставить("format", "date-time");
        Свойство.Вставить("description", Описание + " (формат YYYY-MM-DDTHH:MM:SS)");
    Иначе
        ВызватьИсключение "ДобавитьПараметр: неизвестный тип """ + Тип + """";
    КонецЕсли;

    Инструмент.function.parameters.properties.Вставить(Имя, Свойство);
    Если Обязательный Тогда
        Инструмент.function.parameters.required.Добавить(Имя);
    КонецЕсли;
КонецПроцедуры


&НаСервере
Функция РазобратьАргументыИнструмента(Сырые)

    // Если провайдер уже отдал объект — возвращаем как есть.
    Если ТипЗнч(Сырые) = Тип("Структура") Тогда
        Возврат Сырые;
    КонецЕсли;

    Если ТипЗнч(Сырые) <> Тип("Строка") Тогда
        Возврат Новый Структура;
    КонецЕсли;

    Текст = СокрЛП(Сырые);

    // 1) Обычная попытка.
    Результат = РазобратьJSON(Текст);
    Если ТипЗнч(Результат) = Тип("Структура") И Результат.Количество() > 0 Тогда
        Возврат Результат;
    КонецЕсли;

    // 2) Чистим артефакты вида "{}{...}" — берём ПОСЛЕДНИЙ объект.
    //    Ищем последнюю открывающую { и парсим хвост.
    ПозицияПоследней = СтрНайти(Текст, "{", НаправлениеПоиска.СКонца);
    Если ПозицияПоследней > 0 Тогда
        Хвост = Сред(Текст, ПозицияПоследней);
        Результат = РазобратьJSON(Хвост);
        Если ТипЗнч(Результат) = Тип("Структура") Тогда
            Возврат Результат;
        КонецЕсли;
    КонецЕсли;

    // 3) Не удалось — пустая структура.
    Возврат Новый Структура;
КонецФункции


&НаСервере
Процедура ДобавитьПараметрEnum(Инструмент, Имя, Описание, ДопустимыеЗначения, Обязательный = Истина) Экспорт
    Свойство = Новый Структура;
    Свойство.Вставить("type",        "string");
    Свойство.Вставить("description", Описание);
    Свойство.Вставить("enum",        ДопустимыеЗначения);
    Инструмент.function.parameters.properties.Вставить(Имя, Свойство);
    Если Обязательный Тогда
        Инструмент.function.parameters.required.Добавить(Имя);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДобавитьПараметрМассив(Инструмент, Имя, Описание, ТипЭлементов = "string", Обязательный = Истина) Экспорт
    Свойство = Новый Структура;
    Свойство.Вставить("type",        "array");
    Свойство.Вставить("description", Описание);
    Свойство.Вставить("items",       Новый Структура("type", ТипЭлементов));
    Инструмент.function.parameters.properties.Вставить(Имя, Свойство);
    Если Обязательный Тогда
        Инструмент.function.parameters.required.Добавить(Имя);
    КонецЕсли;
КонецПроцедуры

// ----------------------------------------------------------------------------
// ДИСПЕТЧЕР-АДАПТЕР: единственная точка стыка бизнес-логики и LLM.
// Здесь данные 1С → JSON, и здесь же "нет данных" переводится на язык модели.
// ----------------------------------------------------------------------------
&НаСервере
Функция ВыполнитьИнструмент(Имя, Аргументы) Экспорт
    Попытка
        Если Имя = "get_football_champion" Тогда
            Возврат Адаптер_ЧемпионПоФутболу(Аргументы);
        ИначеЕсли Имя = "validate_pallet_placement" Тогда
            Возврат Адаптер_ОшибкиРазмещенияПаллета(Аргументы);
        ИначеЕсли Имя = "find_cell_for_pallet" Тогда
            Возврат Адаптер_ПодобратьЯчейкуПоПаллету(Аргументы);
        ИначеЕсли Имя = "explain_access_time" Тогда
            Возврат Адаптер_ВремяДоступа(Аргументы);
        Иначе
            Возврат СериализоватьJSON(
                Новый Структура("error", "Неизвестный инструмент: " + Имя));
        КонецЕсли;
    Исключение
        Возврат СериализоватьJSON(Новый Структура("error",
            "Ошибка инструмента """ + Имя + """: "
            + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
    КонецПопытки;
КонецФункции

// Адаптер: достаёт аргументы LLM → вызывает чистую бизнес-функцию →
// упаковывает результат (или "нет данных") в JSON для модели.

&НаСервере
Функция Адаптер_ЧемпионПоФутболу(Аргументы)
    // Аргументы могут быть Неопределено (если JSON не разобрался) или Структурой.
    Страна = "";
    Год    = "";
    Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
        Если Аргументы.Свойство("country") Тогда Страна = Аргументы.country; КонецЕсли;
        Если Аргументы.Свойство("year")    Тогда Год    = Аргументы.year;    КонецЕсли;
    КонецЕсли;

    Данные = ЧемпионСтраныПоФутболу(Страна, Год);

    Если Данные = Неопределено Тогда
        Возврат СериализоватьJSON(Новый Структура("error",
            "Нет данных: страна=" + Строка(Страна) + ", год=" + Строка(Год)));
    КонецЕсли;

    Ответ = Новый Структура;
    Ответ.Вставить("country",  Данные.Страна);
    Ответ.Вставить("year",     Данные.Год);
    Ответ.Вставить("champion", Данные.Чемпион);
    Возврат СериализоватьJSON(Ответ);
КонецФункции

//+Лико m.shenderov 13.06.2026 — Адаптер: аргументы LLM → ОшибкиРазмещенияПаллета → JSON
&НаСервере
Функция Адаптер_ОшибкиРазмещенияПаллета(Аргументы)
	КодЯчейки  = "";
	КодПаллета = "";
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Если Аргументы.Свойство("cell")   Тогда КодЯчейки  = Аргументы.cell;   КонецЕсли;
		Если Аргументы.Свойство("pallet") Тогда КодПаллета = Аргументы.pallet; КонецЕсли;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(КодЯчейки) Или Не ЗначениеЗаполнено(КодПаллета) Тогда
		Возврат СериализоватьJSON(Новый Структура("error",
			"Не указаны обязательные параметры: cell и pallet"));
	КонецЕсли;

	Данные = ОшибкиРазмещенияПаллета(КодЯчейки, КодПаллета, Неопределено, Истина);

	Ответ = Новый Структура;
	Ответ.Вставить("valid",     Данные.Валидно);
	Ответ.Вставить("cell",      Строка(Данные.Ячейка));
	Ответ.Вставить("pallet",    Строка(Данные.Паллет));
	Ответ.Вставить("errors",    Данные.Ошибки);
	Ответ.Вставить("cellFound", ЗначениеЗаполнено(Данные.Ячейка));
	Ответ.Вставить("palletFound", ЗначениеЗаполнено(Данные.Паллет));

	Если Данные.Валидно Тогда
		Ответ.Вставить("message", "Размещение валидно. Паллет " + КодПаллета
			+ " можно разместить в ячейку " + КодЯчейки + ".");
	ИначеЕсли Данные.Ошибки.Количество() > 0 Тогда
		Ответ.Вставить("message", СтрСоединить(Данные.Ошибки, "; "));
	КонецЕсли;

	Возврат СериализоватьJSON(Ответ);
КонецФункции //-<---Лико m.shenderov 13.06.2026

//+Лико m.shenderov 13.06.2026 — Адаптер: аргументы LLM → ПодобратьЯчейкуПоПаллету → JSON
&НаСервере
Функция Адаптер_ПодобратьЯчейкуПоПаллету(Аргументы)
	//+Лико m.shenderov 16.06.2026 — фильтры + лимит + массивы
	КодПаллета   = "";
	ФильтрСтеллаж = Новый Массив;
	ФильтрЭтаж    = 0;
	ФильтрСекция  = Новый Массив;
	ФильтрЯчейка  = Новый Массив;
	Лимит         = 0;

	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Если Аргументы.Свойство("pallet")  Тогда КодПаллета   = Аргументы.pallet;  КонецЕсли;
		Если Аргументы.Свойство("rack")    Тогда ФильтрСтеллаж = НормализоватьВМассив(Аргументы.rack);    КонецЕсли;
		Если Аргументы.Свойство("floor")   Тогда ФильтрЭтаж    = Аргументы.floor;   КонецЕсли;
		Если Аргументы.Свойство("section") Тогда ФильтрСекция  = НормализоватьВМассив(Аргументы.section); КонецЕсли;
		Если Аргументы.Свойство("cell")    Тогда ФильтрЯчейка  = НормализоватьВМассив(Аргументы.cell);    КонецЕсли;
		Если Аргументы.Свойство("limit")   Тогда Лимит         = Аргументы.limit;   КонецЕсли;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(КодПаллета) Тогда
		Возврат СериализоватьJSON(Новый Структура("error",
			"Не указан обязательный параметр: pallet"));
	КонецЕсли;

	Данные = ПодобратьЯчейкуПоПаллетуБизнес(КодПаллета);

	Если ЗначениеЗаполнено(Данные.Ошибка) Тогда
		Возврат СериализоватьJSON(Новый Структура("error", Данные.Ошибка));
	КонецЕсли;

	Таблица       = Данные.Таблица;
	ВсегоДо       = Таблица.Количество();
	ЕстьФильтр    = ФильтрСтеллаж.Количество() > 0 ИЛИ ФильтрСекция.Количество() > 0
	                ИЛИ ФильтрЭтаж > 0 ИЛИ ФильтрЯчейка.Количество() > 0;

	Если Лимит = 0 Тогда
		Если НЕ ЕстьФильтр Тогда
			Лимит = 20;
		КонецЕсли;
	КонецЕсли;

	МассивСтрок = Новый Массив;
	Номер       = 0;
	Для Каждого Стр Из Таблица Цикл
		Если ФильтрСтеллаж.Количество() > 0 Тогда
			Если НЕ СовпадаетПоСтроке(Стр.Стеллаж, ФильтрСтеллаж) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если ФильтрЭтаж > 0 Тогда
			Если Стр.Этаж <> ФильтрЭтаж Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если ФильтрСекция.Количество() > 0 Тогда
			Если НЕ СовпадаетПоСтроке(Стр.СекцияКод, ФильтрСекция) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если ФильтрЯчейка.Количество() > 0 Тогда
			Если НЕ СовпадаетПоСтроке(Стр.Адрес, ФильтрЯчейка) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Номер = Номер + 1;
		Если Лимит > 0 И Номер > Лимит Тогда
			Прервать;
		КонецЕсли;

		СтрокаJSON = Новый Структура;
		Для Каждого Кол Из Таблица.Колонки Цикл
			СтрокаJSON.Вставить(Кол.Имя, Стр[Кол.Имя]);
		КонецЦикла;
		МассивСтрок.Добавить(СтрокаJSON);
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("pallet",            КодПаллета);
	Ответ.Вставить("totalCandidates",   ВсегоДо);
	Ответ.Вставить("filteredCandidates", МассивСтрок.Количество());
	Если ЕстьФильтр Тогда
		СтруктураФильтров = Новый Структура;
		СтруктураФильтров.Вставить("rack",    ФильтрСтеллаж);
		СтруктураФильтров.Вставить("floor",   ФильтрЭтаж);
		СтруктураФильтров.Вставить("section", ФильтрСекция);
		СтруктураФильтров.Вставить("cell",    ФильтрЯчейка);
		Ответ.Вставить("filters", СтруктураФильтров);
	КонецЕсли;
	Ответ.Вставить("candidates", МассивСтрок);

	Возврат СериализоватьJSON(Ответ);
КонецФункции //-<---Лико m.shenderov 16.06.2026

