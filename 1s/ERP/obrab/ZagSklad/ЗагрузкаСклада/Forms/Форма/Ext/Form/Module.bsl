// Вспомогательная: найти первый занятый адрес в секции по коду
&НаСервере
Функция НайтиАдресПоКодуСекции(Данные, КодСекции)
	Для Каждого КлючС Из Данные.Секции Цикл
		Секция = КлючС.Значение;
		Если Секция.Код = КодСекции Тогда
			Если Данные.ПаллетыВСекциях.Получить(Секция.Адрес1) <> Неопределено Тогда
				Возврат Секция.Адрес1;
			ИначеЕсли Данные.ПаллетыВСекциях.Получить(Секция.Адрес2) <> Неопределено Тогда
				Возврат Секция.Адрес2;
			ИначеЕсли Данные.ПаллетыВСекциях.Получить(Секция.Адрес3) <> Неопределено Тогда
				Возврат Секция.Адрес3;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

