&НаСервере
Процедура ПоказатьИсторию(История)
    Сообщить("--- История (" + История.Количество() + " сообщ.) ---");
    Для Каждого Сообщение Из История Цикл
        Роль = Сообщение["role"];
        ЕстьВызовы = Сообщение.Свойство("tool_calls") И Сообщение["tool_calls"] <> Неопределено;
        Если Роль = "tool" Тогда
            Сообщить("[tool результат] " + Сообщение["content"]);
        ИначеЕсли Роль = "assistant" И ЕстьВызовы Тогда
            Сообщить("[assistant → вызов инструмента]");
        Иначе
            Текст = ?(Сообщение.Свойство("content"), Строка(Сообщение["content"]), "");
            Сообщить("[" + Роль + "] " + Текст);
        КонецЕсли;
    КонецЦикла;
