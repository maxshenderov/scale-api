				КонецЦикла;
			КонецЦикла;
			
			// === Фильтр по паллету: проверяем, подходит ли секция ===
			СекцияПодходит = Истина;
			Если ФилтрПоПаллету И ЗначениеЗаполнено(Паллет) И АдресаХранения.Количество() > 0 Тогда
				СекцияПодходит = (АдресаФильтраHTML.Получить(СекцияДанные.Адрес1) <> Неопределено)
					ИЛИ (АдресаФильтраHTML.Получить(СекцияДанные.Адрес2) <> Неопределено)
					ИЛИ (АдресаФильтраHTML.Получить(СекцияДанные.Адрес3) <> Неопределено);
			КонецЕсли;
			КлассСекции = "section";
