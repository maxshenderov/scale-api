Процедура ДобавитьСообщениеАссистентаПоВызовам(Сообщения, ВызовыИнструментов) Экспорт
    МассивToolCalls = Новый Массив;
    Для Каждого Вызов Из ВызовыИнструментов Цикл
        АргументыСтрока = СериализоватьJSON(
            ?(ТипЗнч(Вызов.Аргументы) = Тип("Структура"), Вызов.Аргументы, Новый Структура));
        Функция_ = Новый Структура;
        Функция_.Вставить("name",      Вызов.Имя);
        Функция_.Вставить("arguments", АргументыСтрока);
        ToolCall = Новый Структура;
        ToolCall.Вставить("id",       Вызов.ID);
        ToolCall.Вставить("type",     "function");
        ToolCall.Вставить("function", Функция_);
        МассивToolCalls.Добавить(ToolCall);
    КонецЦикла;
    Сообщение = Новый Структура;
    Сообщение.Вставить("role",       "assistant");
    Сообщение.Вставить("content",    "");
    Сообщение.Вставить("tool_calls", МассивToolCalls);
    Сообщения.Добавить(Сообщение);
