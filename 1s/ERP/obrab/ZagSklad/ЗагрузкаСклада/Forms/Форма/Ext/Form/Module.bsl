//+Лико m.shenderov 13.06.2026 — LLM: таблица кандидатов с полями приоритетов
&НаСервере
Функция ПодобратьЯчейкуПоПаллетуДляLLM(Паллет)

	АдресПаллета = РегистрыНакопления.Лико_ПаллетыВСекциях.ПолучитьАдрес(Паллет);
	Если Не ЗначениеЗаполнено(АдресПаллета) Тогда
		ТаблицаОшибка = Новый ТаблицаЗначений;
		ТаблицаОшибка.Колонки.Добавить("error");
		ТаблицаОшибка.Добавить().error = "Паллет не найден в остатках — невозможно определить склад";
		Возврат ТаблицаОшибка;
	КонецЕсли;
	//Склад = АдресПаллета.Владелец;

	Структура = Справочники.Лико_Паллеты2_0.ТипоразмерПаллета(Паллет);
	Высота  = Структура.Высота;
	Ширина  = Структура.Ширина;
	Глубина = Структура.Глубина;
	Вес     = Структура.Вес;

	ТаблицаВсе = Справочники.Лико_СкладскиеСекции.ПодобратьЯчейку(Склад, Высота, Ширина, Глубина, Вес, Ложь, Истина);
		Результат = Новый ТаблицаЗначений;
		Результат.Колонки.Добавить("Приоритет_Номер",              Новый ОписаниеТипов("Число"));
		Результат.Колонки.Добавить("СекцияКод",                    Новый ОписаниеТипов("Строка"));
		Результат.Колонки.Добавить("Адрес",                        Новый ОписаниеТипов("Строка"));
		Результат.Колонки.Добавить("Стеллаж",                      Новый ОписаниеТипов("Строка"));
		Результат.Колонки.Добавить("Ряд",                          Новый ОписаниеТипов("Число"));
		Результат.Колонки.Добавить("Место",                        Новый ОписаниеТипов("Число"));
		Результат.Колонки.Добавить("Этаж",                         Новый ОписаниеТипов("Число"));
		Результат.Колонки.Добавить("ШиринаСекции",                 Новый ОписаниеТипов("Число"));
		Результат.Колонки.Добавить("ВысотаСекции",                 Новый ОписаниеТипов("Число"));
		Результат.Колонки.Добавить("ОстатокВысота",                Новый ОписаниеТипов("Число"));
		Результат.Колонки.Добавить("ОстатокШирина",                Новый ОписаниеТипов("Число"));
		Результат.Колонки.Добавить("ПотенциалСекции",             Новый ОписаниеТипов("Число"));
		Результат.Колонки.Добавить("УровеньДоступа",              Новый ОписаниеТипов("Число"));
		Результат.Колонки.Добавить("ВремяДоступа",                Новый ОписаниеТипов("Число"));

		Номер = 0;
		Для Каждого Стр Из ТаблицаВсе Цикл
			Номер = Номер + 1;
			НовСтр = Результат.Добавить();
			НовСтр.Приоритет_Номер         = Номер;
			НовСтр.СекцияКод               = Строка(Стр.Код);
			НовСтр.Адрес                   = Строка(Стр.Адрес);
			НовСтр.Стеллаж                 = Строка(Стр.Стеллаж);
			НовСтр.Ряд                     = Стр.Ряд;
			НовСтр.Место                   = Стр.Место;
			НовСтр.Этаж                    = Стр.Этаж;
			НовСтр.ШиринаСекции            = Стр.Типоразмер.Ширина;
			НовСтр.ВысотаСекции            = Стр.Типоразмер.Высота;
			НовСтр.ОстатокВысота           = Стр.ОстатокВысота;
			НовСтр.ОстатокШирина           = Стр.ОстатокШирина;
			НовСтр.ПотенциалСекции         = Стр.ПотенциалСекции;
			НовСтр.УровеньДоступа          = Стр.УровеньДоступа;
			НовСтр.ВремяДоступа            = Стр.ВремяДоступа;
		КонецЦикла;


	Возврат Результат;

КонецФункции //-<---Лико m.shenderov 13.06.2026

Функция ПодобратьЯчейкуПоПаллетуБизнес(КодПаллета) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Паллет", Неопределено);
	Результат.Вставить("Таблица", Неопределено);
	Результат.Вставить("Ошибка", "");

	Паллет = Справочники.Лико_Паллеты2_0.НайтиПоКоду(КодПаллета);
	Если Не ЗначениеЗаполнено(Паллет) Тогда
		Паллет = Справочники.Лико_Паллеты2_0.НайтиПоНаименованию(КодПаллета);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Паллет) Тогда
		Результат.Ошибка = "Паллет не найден: """ + КодПаллета + """";
		Возврат Результат;
	КонецЕсли;
	Результат.Паллет = Паллет;

	Результат.Таблица = ПодобратьЯчейкуПоПаллетуДляLLM(Паллет);

	Если Результат.Таблица.Колонки.Найти("error") <> Неопределено Тогда
		Результат.Ошибка = Результат.Таблица[0].error;
		Результат.Таблица = Неопределено;
	КонецЕсли;

	Возврат Результат;

