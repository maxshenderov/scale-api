				Возврат Секция.Адрес1;
			ИначеЕсли ВиртуальноеСостояние.Получить(Секция.Адрес2) = Неопределено Тогда
				Возврат Секция.Адрес2;
			ИначеЕсли ВиртуальноеСостояние.Получить(Секция.Адрес3) = Неопределено Тогда
				Возврат Секция.Адрес3;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

//+Лико m.shenderov 24.06.2026
// Точка входа: выполняет быструю дефрагментацию и возвращает результат
&НаСервере
Функция ВыполнитьБыструюДефрагментацию(Склад) Экспорт

	// Шаг 1: Сбор данных
	Данные = СобратьДанныеДляДефрагментации(Склад);

	Если Данные.ПаллетыВСекциях.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Инициализация виртуального состояния (копия БД)
	ВиртуальноеСостояние = Новый Соответствие;
	Для Каждого Ключ Из Данные.ПаллетыВСекциях Цикл
		ВиртуальноеСостояние.Вставить(Ключ.Ключ, Ключ.Значение);
	КонецЦикла;

	// Шаг 2: Построить граф
	Граф = ПостроитьГрафПерестановок(Данные, ВиртуальноеСостояние);

	// Шаг 3: Найти воздушные секции
	Воздушные = НайтиВоздушныеСекции(Данные, ВиртуальноеСостояние);

	Если Воздушные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Шаг 4: Паросочетание
	Паросочетание = НайтиПаросочетание(Граф, Воздушные);

	Если Паросочетание.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Шаг 5: Посчитать результат
	Результат = ПосчитатьРезультат(Паросочетание, Данные, ВиртуальноеСостояние);

	// Сохраняем доп. данные для HTML
	Результат.Вставить("Граф", Граф);
	Результат.Вставить("Воздушные", Воздушные);
	Результат.Вставить("Данные", Данные);

	Возврат Результат;

КонецФункции

//+Лико m.shenderov 24.06.2026
// HTML визуализация дефрагментации — вставляется в текущий HTML
&НаСервере
Функция СформироватьHTMLДефрагментацииНаСервере(Результат) Экспорт

	Если Результат = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	HTML = "";

	// Сводка
	ЗагрДо = Результат.Мета.ЗанятоСекцийДо;
	Всего = Результат.Мета.ВсегоСекций;
	ПроцДо = Окр(ЗагрДо / Всего * 100, 0);
	ПроцПосле = Окр((ЗагрДо + Результат.РеальноРазместится) / Всего * 100, 0);

	HTML = HTML + "<div class=""defrag-summary"">";
	HTML = HTML + "<b>Быстрая дефрагментация:</b> ";
	HTML = HTML + "до " + ПроцДо + "% (" + Формат(ЗагрДо, "ЧН=0; ЧГ=0") + "/" + Формат(Всего, "ЧН=0; ЧГ=0") + ")";
	HTML = HTML + " &rarr; после " + ПроцПосле + "% ";
	HTML = HTML + "(+" + Формат(Результат.ОсвобождённыхЯчеек, "ЧН=0; ЧГ=0") + " ячеек, ";
	HTML = HTML + "+" + Формат(Результат.РеальноРазместится, "ЧН=0; ЧГ=0") + " паллетов с пола)";
	HTML = HTML + "</div>";

	// Таблица перестановок
	Если Результат.Перемещения.Количество() > 0 Тогда
		HTML = HTML + "<div class=""defrag-plan"">";
		HTML = HTML + "<b>План перестановок (" + Формат(Результат.Перемещения.Количество(), "ЧН=0; ЧГ=0") + "):</b>";
		HTML = HTML + "<table><tr><th>№</th><th>Паллет</th><th>Откуда</th><th>Куда</th></tr>";

		Ном = 0;
		Для Каждого Пер Из Результат.Перемещения Цикл
			Ном = Ном + 1;
			HTML = HTML + "<tr>";
			HTML = HTML + "<td>" + Формат(Ном, "ЧН=0; ЧГ=0") + "</td>";
			HTML = HTML + "<td>" + Строка(Пер.Паллет) + "</td>";
			HTML = HTML + "<td>" + Пер.Откуда + "</td>";
			HTML = HTML + "<td>" + Пер.Куда + "</td>";
			HTML = HTML + "</tr>";
		КонецЦикла;

		HTML = HTML + "</table></div>";
	КонецЕсли;

	// CSS подсветки секций
	HTML = HTML + "<style>";
	HTML = HTML + ".defrag-will-be-free { background: #2196F3 !important; }";
	HTML = HTML + ".defrag-moved { border: 2px solid #FF9800 !important; }";
	HTML = HTML + ".defrag-summary { background: #e8f5e9; padding: 8px; border-radius: 4px; margin: 8px 0; font-size: 13px; }";
	HTML = HTML + ".defrag-plan { margin-top: 10px; font-size: 13px; }";
	HTML = HTML + ".defrag-plan table { border-collapse: collapse; width: 100%; font-size: 12px; }";
	HTML = HTML + ".defrag-plan th, .defrag-plan td { border: 1px solid #ccc; padding: 4px 8px; }";
	HTML = HTML + ".defrag-plan th { background: #f5f5f5; }";
	HTML = HTML + "</style>";

	// JS для подсветки секций (запускается после загрузки)
	HTML = HTML + "<script>";
	HTML = HTML + "var defrag_freed = [];";
	// Подставка кодов освобождённых секций
	Для Каждого Пер Из Результат.Перемещения Цикл
		HTML = HTML + "defrag_freed.push('" + Пер.Откуда + "');";
		HTML = HTML + "defrag_freed.push('section-" + Пер.Куда + "');";
	КонецЦикла;
	HTML = HTML + "(function(){";
	HTML = HTML + "setTimeout(function(){";
	HTML = HTML + "var i, el;";
	HTML = HTML + "for(i=0;i<defrag_freed.length;i++){";
	HTML = HTML + "el=document.getElementById(defrag_freed[i]);";
	HTML = HTML + "if(el){el.classList.add('defrag-will-be-free');}";
	HTML = HTML + "}";
	HTML = HTML + "},100);";
	HTML = HTML + "})();";
	HTML = HTML + "</script>";

	Возврат HTML;

КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ОбновитьHTMLСДефрагментацией()
	Если ДефрагментацияРезультат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийСтеллаж) Тогда
		Возврат;
	КонецЕсли;

	РендерЗагрузкиСтеллажаНаСервере(ТекущийСтеллаж);

	Если Дефрагментация Тогда
		HTMLДефраг = СформироватьHTMLДефрагментацииНаСервере(ДефрагментацияРезультат);
		Поз = СтрНайти(html, "</body>");
		Если Поз > 0 Тогда
			html = Лев(html, Поз - 1) + HTMLДефраг + Сред(html, Поз);
		КонецЕсли;
	КонецЕсли;

	ДобавитьПаллетыНаПолуВHTML();
КонецПроцедуры

&НаКлиенте
Процедура ДефрагментацияПриИзменении(Элемент)
	ОбновитьHTMLСДефрагментацией();
КонецПроцедуры

&НаКлиенте
Процедура БыстраяДефрагментация(Команда)
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Сообщить("Выберите склад");
		Возврат;
	КонецЕсли;

	Результат = ВыполнитьБыструюДефрагментацию(Склад);
	ДефрагментацияРезультат = Результат;

	Если Результат = Неопределено Тогда
		Сообщить("Нечего дефрагментировать — все паллеты стоят оптимально");
		Возврат;
	КонецЕсли;

	Если Дефрагментация Тогда
		ОбновитьHTMLСДефрагментацией();
	КонецЕсли;

	Сообщить("Готово. Освобождено ячеек: " + Результат.ОсвобождённыхЯчеек
		+ ". Паллетов с пола разместится: " + Результат.РеальноРазместится);
КонецПроцедуры

&НаКлиенте
Процедура РазместитьПаллеты(Команда)
	РазместитьПаллетыНаСервере();
КонецПроцедуры


