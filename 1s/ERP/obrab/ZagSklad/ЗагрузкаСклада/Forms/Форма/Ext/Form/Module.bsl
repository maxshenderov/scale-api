//+Лико m.shenderov 05.06.2026 — Добавление пузыря LLM в HTML (с кнопкой копирования и токенами)
//+Лико m.shenderov 15.06.2026 — добавлен ФорматОтвета: html/markdown рендерятся без экранирования
&НаСервере
Процедура ДобавитьПузырьLLMНаСервере(Текст, ТокеныВход = 0, ТокеныВыход = 0, Модель = "", ФорматОтвета = "text")
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;

	// Готовим контент в зависимости от формата
	Если ФорматОтвета = "html" Тогда
		// HTML от LLM — вставляем как есть, без экранирования
		Контент = Текст;
		СтильБаббла = "white-space:normal;overflow-wrap:break-word;";
	ИначеЕсли ФорматОтвета = "markdown" Тогда
		// Markdown — преобразуем в HTML, не экранируем
		Контент = ПреобразоватьMarkdownВHTML(Текст);
		СтильБаббла = "white-space:normal;overflow-wrap:break-word;";
	Иначе
		// text / json — экранируем HTML-спецсимволы, сохраняем переносы строк
		Контент = ЭкранироватьHTML(Текст);
		СтильБаббла = "white-space:pre-wrap;word-break:break-word;";
	КонецЕсли;

	ТокеныСтрока = "";
	Если ЗначениеЗаполнено(Модель) Тогда
		ТокеныСтрока = Модель;
	КонецЕсли;
	Если ТокеныВход > 0 ИЛИ ТокеныВыход > 0 Тогда
		ТокеныСтрока = ТокеныСтрока + ?(ЗначениеЗаполнено(ТокеныСтрока), " ", "") + "in:" + Строка(ТокеныВход) + " out:" + Строка(ТокеныВыход);
	КонецЕсли;

	Пузырь = "<div data-zs-role=""answer"" style=""display:flex;flex-direction:column;align-items:flex-start;"">"
		// Сам баббл с текстом ответа
		+ "<div class=""zs-answer-text"" style=""max-width:75%;padding:10px 14px;border-radius:14px 14px 14px 4px;"
		+ "background:#f3f4f6;border:0.5px solid #d1d5db;color:#111827;"
		+ "font-size:14px;line-height:1.6;" + СтильБаббла + """>"
		+ Контент + "</div>"
		// Строка с кнопкой копирования и токенами
		+ "<div style=""display:flex;align-items:center;gap:10px;margin-top:4px;margin-left:2px;"">"
		+   "<a href=""#"" class=""zs-copy-btn"" onclick=""zsCopy(this);return false;"" title=""Копировать ответ"">📋 Копировать</a>"
		+   "<span class=""zs-copy-ok"">✓ Скопировано</span>";
	Если ЗначениеЗаполнено(ТокеныСтрока) Тогда
		Пузырь = Пузырь
		+   "<span style=""font-size:10px;color:#9ca3af;margin-left:2px;"">" + ТокеныСтрока + "</span>";
	КонецЕсли;
	Пузырь = Пузырь
		+ "</div></div>";
	ДобавитьПузырьВЧат(Пузырь);
КонецПроцедуры //-<---Лико m.shenderov 15.06.2026


//+Лико m.shenderov 05.06.2026 — Общая процедура добавления пузыря
//
// Структура чата (см. СформироватьHTMLЧата):
//   <div id="zs-shell">
//     <div id="zs-scroll">
//       <div class="chat-container">
//         ...пузыри...
//       <!--ZS_CHAT_END--></div>
//     </div>
//     <a id="zs-fab">
//   </div>
//
// Вставка: APPEND в конец chat-container — перед маркером <!--ZS_CHAT_END-->.
//   Новые сообщения добавляются ВНИЗ: вопрос → индикатор → ответ.
&НаСервере
Процедура ДобавитьПузырьВЧат(HTMLПузыря)
	ТекущийHTML = ОтветLLMHTML;
	Если НЕ ЗначениеЗаполнено(ТекущийHTML) Тогда
		ОтветLLMHTML = СформироватьHTMLЧата(HTMLПузыря);
		Возврат;
	КонецЕсли;

	// Способ 1 (основной): вставка ПЕРЕД маркером <!--ZS_CHAT_END--> — APPEND в конец чата
	ПозМаркера = СтрНайти(ТекущийHTML, "<!--ZS_CHAT_END-->");
	Если ПозМаркера > 0 Тогда
		ЛеваяЧасть  = Лев(ТекущийHTML, ПозМаркера - 1);
		ПраваяЧасть = Сред(ТекущийHTML, ПозМаркера);
		ОтветLLMHTML = ЛеваяЧасть + HTMLПузыря + ПраваяЧасть;
		Возврат;
	КонецЕсли;

	// Способ 2 (фолбэк): вставка перед <script> — для совместимости со старым HTML без маркера
	ПозицияСкрипта = СтрНайти(ТекущийHTML, "<script>");
	Если ПозицияСкрипта > 0 Тогда
		ПозицияЗакрытияКонтейнера = 0;
		Поз = ПозицияСкрипта - 1;
		Пока Поз >= 1 Цикл
			ПодстрокаПоиска = Сред(ТекущийHTML, Поз, 6);
			Если ПодстрокаПоиска = "</div>" Тогда
				ПозицияЗакрытияКонтейнера = Поз;
				Прервать;
			КонецЕсли;
			Поз = Поз - 1;
		КонецЦикла;
		Если ПозицияЗакрытияКонтейнера > 0 Тогда
			ЛеваяЧасть  = Лев(ТекущийHTML,  ПозицияЗакрытияКонтейнера - 1);
			ПраваяЧасть = Сред(ТекущийHTML, ПозицияЗакрытияКонтейнера);
			ОтветLLMHTML = ЛеваяЧасть + HTMLПузыря + ПраваяЧасть;
		Иначе
			ОтветLLMHTML = СформироватьHTMLЧата(ТекущийHTML + HTMLПузыря);
		КонецЕсли;
	Иначе
		ОтветLLMHTML = СформироватьHTMLЧата(ТекущийHTML + HTMLПузыря);
	КонецЕсли;
КонецПроцедуры //-<---Лико m.shenderov 05.06.2026

//+Лико m.shenderov 05.06.2026 — Обновление маркеров токенов в HTML-хедере чата
&НаСервере
Процедура ОбновитьСчетчикиТокеновВHTMLНаСервере()
	ТекущийHTML = ОтветLLMHTML;
	Если НЕ ЗначениеЗаполнено(ТекущийHTML) Тогда
		Возврат;
	КонецЕсли;

	// Обновляем маркер токенов входа: <!--ZS_TIN-->ЗНАЧЕНИЕ<!--ZS_TIN_END-->
	ПозТВхНачало = СтрНайти(ТекущийHTML, "<!--ZS_TIN-->");
	ПозТВхКонец  = СтрНайти(ТекущийHTML, "<!--ZS_TIN_END-->");
	Если ПозТВхНачало > 0 И ПозТВхКонец > ПозТВхНачало Тогда
		СтароеНачало = ПозТВхНачало + СтрДлина("<!--ZS_TIN-->");
		СтарыйКусок  = Сред(ТекущийHTML, ПозТВхНачало, ПозТВхКонец - ПозТВхНачало + СтрДлина("<!--ZS_TIN_END-->"));
		НовыйКусок   = "<!--ZS_TIN-->" + Строка(СуммаТокеновВход) + "<!--ZS_TIN_END-->";
		ТекущийHTML   = СтрЗаменить(ТекущийHTML, СтарыйКусок, НовыйКусок);
	КонецЕсли;

	// Обновляем маркер токенов выхода: <!--ZS_TOUT-->ЗНАЧЕНИЕ<!--ZS_TOUT_END-->
	ПозТВыхНачало = СтрНайти(ТекущийHTML, "<!--ZS_TOUT-->");
	ПозТВыхКонец  = СтрНайти(ТекущийHTML, "<!--ZS_TOUT_END-->");
	Если ПозТВыхНачало > 0 И ПозТВыхКонец > ПозТВыхНачало Тогда
		СтароеНачало = ПозТВыхНачало + СтрДлина("<!--ZS_TOUT-->");
		СтарыйКусок  = Сред(ТекущийHTML, ПозТВыхНачало, ПозТВыхКонец - ПозТВыхНачало + СтрДлина("<!--ZS_TOUT_END-->"));
		НовыйКусок   = "<!--ZS_TOUT-->" + Строка(СуммаТокеновВыход) + "<!--ZS_TOUT_END-->";
		ТекущийHTML   = СтрЗаменить(ТекущийHTML, СтарыйКусок, НовыйКусок);
	КонецЕсли;

	ОтветLLMHTML = ТекущийHTML;
КонецПроцедуры //-<---Лико m.shenderov 05.06.2026

//+Лико m.shenderov 05.06.2026 — Добавить индикатор «LLM думает…» (три мигающие точки + текст)
&НаСервере
Процедура ДобавитьИндикаторОжиданияНаСервере()
	Индикатор = "<div id=""_zs_typing_"" style=""display:flex;justify-content:flex-start;"">"
		+ "<div style=""max-width:75%;padding:10px 16px;border-radius:14px 14px 14px 4px;"
		+ "background:#f3f4f6;border:0.5px solid #d1d5db;"
		+ "display:flex;gap:6px;align-items:center;"">"
		+ "<span class=""zs-dot""></span>"
		+ "<span class=""zs-dot""></span>"
		+ "<span class=""zs-dot""></span>"
		+ "<span class=""typing-label"">Ассистент думает...</span>"
		+ "</div></div>";
	ДобавитьПузырьВЧат(Индикатор);
КонецПроцедуры //-<---Лико m.shenderov 05.06.2026

//+Лико m.shenderov 05.06.2026 — Убрать индикатор «LLM думает…» из чата
&НаСервере
Процедура УдалитьИндикаторОжиданияНаСервере()
	ТекущийHTML = ОтветLLMHTML;
	Если НЕ ЗначениеЗаполнено(ТекущийHTML) Тогда
		Возврат;
	КонецЕсли;
	// Удаляем блок индикатора по его id
	ПозНачало = СтрНайти(ТекущийHTML, "<div id=""_zs_typing_""");
	Если ПозНачало = 0 Тогда
		Возврат;
	КонецЕсли;
	// Удаляем блок от <div id="_zs_typing_" до ближайшего "</div></div>"
	ПозОткр = СтрНайти(ТекущийHTML, "<div", НаправлениеПоиска.СНачала, ПозНачало);
	ПозЗакрытия = СтрНайти(ТекущийHTML, "</div></div>", , ПозОткр);
	Если ПозЗакрытия = 0 Тогда
		Возврат;
	КонецЕсли;
	ЛеваяЧасть  = Лев(ТекущийHTML, ПозОткр - 1);
	ПраваяЧасть = Сред(ТекущийHTML, ПозЗакрытия + 12);
	ОтветLLMHTML = ЛеваяЧасть + ПраваяЧасть;
КонецПроцедуры //-<---Лико m.shenderov 05.06.2026

//+Лико m.shenderov 05.06.2026 — Формирование HTML-обёртки чата
//
// Структура:
//   #zs-shell     — внешний контейнер (занимает всю высоту родителя)
//   .zs-scroll    — зона скролла, в ней лежит chat-container
//   .chat-container — собственно лента пузырей
//   #zs-fab       — плавающая кнопка «↓ к новым» (появляется когда мы НЕ внизу)
//   .zs-bottom    — sticky «Ассистент думает…» + кнопки
//
// Логика прокрутки (JS):
//   * По умолчанию — автопрокрутка к низу при добавлении пузыря.
//   * Если пользователь прокрутил вверх, автопрокрутка отключается до тех пор,
//     пока он не вернётся вниз (или не нажмёт кнопку «↓»).
//   * В момент отправки вопроса курсор ВСЕГДА принудительно опускается вниз —
//     чтобы пользователь видел индикатор «Ассистент думает…».
&НаСервере
Функция СформироватьHTMLЧата(Содержимое)
	Возврат
		"<!DOCTYPE html><html><head><meta charset=""utf-8""><style>"
		// body: прозрачный фон, без скролла
		+ "html,body{margin:0;padding:0;height:100%;background:#fafafa;font-family:Arial,sans-serif;}"
		+ "body{display:flex;flex-direction:column;}"
		// shell — внешний контейнер чата, занимает всю высоту родителя
		+ "#zs-shell{flex:1;display:flex;flex-direction:column;min-height:0;position:relative;}"
		// scroll — зона прокрутки пузырей
		+ ".zs-scroll{flex:1;overflow-y:auto;overflow-x:hidden;padding:12px 16px;min-height:0;}"
		// container — лента пузырей
		+ ".chat-container{display:flex;flex-direction:column;gap:10px;min-height:100%;}"
		// typing-индикатор (точки анимируются через JS — setInterval + синусоида)
		+ ".zs-dot{width:14px;height:14px;border-radius:50%;background:#2563eb;display:inline-block;margin:0 5px;opacity:1;}"
		+ ".typing-label{font-size:13px;color:#2563eb;margin-left:6px;font-weight:500;}"
		// FAB (плавающая кнопка вниз)
		+ "#zs-fab{position:absolute;right:14px;bottom:14px;width:36px;height:36px;border-radius:50%;"
		+          "background:#2563eb;color:#fff;display:none;align-items:center;justify-content:center;"
		+          "font-size:18px;cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,0.25);z-index:10;"
		+          "text-decoration:none;line-height:1;}"
		+ "#zs-fab.show{display:flex;}"
		+ "#zs-fab:hover{background:#1d4ed8;}"
		// Scrollbar
		+ ".zs-scroll::-webkit-scrollbar{width:8px;}"
		+ ".zs-scroll::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:4px;}"
		+ ".zs-scroll::-webkit-scrollbar-thumb:hover{background:#94a3b8;}"
		// Chat header with total tokens (top-left, компактно как в сообщениях)
		+ ".zs-chat-header{font-size:10px;color:#9ca3af;padding:4px 16px;"
		+            "background:#f1f5f9;border-bottom:1px solid #e2e8f0;"
		+            "flex-shrink:0;border-radius:4px 4px 0 0;}"
		// Copy button + feedback
		+ ".zs-copy-btn{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;"
		+               "border-radius:6px;background:#e5e7eb;color:#4b5563;font-size:11px;"
		+               "text-decoration:none;cursor:pointer;border:none;transition:background 0.15s;}"
		+ ".zs-copy-btn:hover{background:#d1d5db;color:#1f2937;}"
		+ ".zs-copy-ok{display:none;font-size:11px;color:#059669;}"
		// Blinking cursor for typing effect
		+ "@keyframes zs-cursor-blink{0%,100%{opacity:1}50%{opacity:0}}"
		+ ".zs-answer-text.typing::after{content:'▌';animation:zs-cursor-blink 0.8s infinite;color:#2563eb;}"
		// Стили для markdown/HTML-контента внутри пузырей
		+ ".zs-answer-text h2{font-size:18px;color:#1a3c5e;margin:12px 0 6px 0;padding:0;font-weight:700;line-height:1.3;}"
		+ ".zs-answer-text h3{font-size:16px;color:#1a3c5e;margin:10px 0 4px 0;padding:0;font-weight:600;line-height:1.3;}"
		+ ".zs-answer-text h4{font-size:15px;color:#1a3c5e;margin:8px 0 4px 0;padding:0;font-weight:600;line-height:1.3;}"
		+ ".zs-answer-text h5{font-size:14px;color:#1a3c5e;margin:6px 0 3px 0;padding:0;font-weight:600;line-height:1.3;}"
		+ ".zs-answer-text p{margin:0 0 6px 0;padding:0;font-size:14px;line-height:1.6;}"
		+ ".zs-answer-text ul,.zs-answer-text ol{margin:0 0 8px 0;padding-left:20px;}"
		+ ".zs-answer-text li{margin:0 0 2px 0;padding:0;font-size:14px;line-height:1.5;}"
		+ ".zs-answer-text strong{font-weight:600;color:#0f172a;}"
		+ ".zs-answer-text code{background:#e2e8f0;padding:1px 4px;border-radius:3px;font-size:13px;font-family:Consolas,monospace;color:#1e293b;}"
		+ ".zs-answer-text pre{margin:0 0 8px 0;padding:8px 12px;background:#f1f5f9;border-radius:6px;font-size:13px;overflow-x:auto;}"
		+ ".zs-answer-text pre code{background:transparent;padding:0;font-size:13px;}"
		+ ".zs-answer-text table{width:100%;border-collapse:collapse;margin:0 0 8px 0;font-size:13px;}"
		+ ".zs-answer-text td,.zs-answer-text th{padding:4px 8px;border:1px solid #d1d5db;text-align:left;}"
		+ ".zs-answer-text th{background:#f1f5f9;font-weight:600;}"
		+ ".zs-answer-text hr{border:none;border-top:1px solid #e2e8f0;margin:10px 0;}"
		+ ".zs-answer-text a{color:#2563eb;text-decoration:underline;}"
		+ ".zs-answer-text blockquote{margin:0 0 8px 0;padding:4px 12px;border-left:3px solid #93c5fd;background:#f8fafc;color:#475569;}"
		+ "</style></head><body>"
		+ "<div id=""zs-shell"">"
		// Хедер с суммарными токенами (левый верхний угол)
		+   "<div class=""zs-chat-header"">in:<!--ZS_TIN-->0<!--ZS_TIN_END--> out:<!--ZS_TOUT-->0<!--ZS_TOUT_END--></div>"
		+   "<div class=""zs-scroll"" id=""zs-scroll"">"
		+     "<div class=""chat-container"">"
		+       Содержимое
		+     "<!--ZS_CHAT_END--></div>"
		+   "</div>"
		+   "<a id=""zs-fab"" title=""К новым сообщениям"">↓</a>"
		+ "</div>"
	// Скрипт: прокрутка + рестарт анимации + копирование ответа
		+ "<script>(function(){"
		+ "var scroll=document.getElementById('zs-scroll');"
		+ "var fab=document.getElementById('zs-fab');"
		+ "if(!scroll)return;"
		+ "function isAtBottom(){return scroll.scrollHeight-scroll.scrollTop-scroll.clientHeight<30;}"
		+ "function updateFab(){if(isAtBottom())fab.classList.remove('show');else fab.classList.add('show');}"
		+ "function scrollToBottom(){scroll.scrollTop=scroll.scrollHeight;updateFab();}"
		+ "scrollToBottom();setTimeout(scrollToBottom,60);setTimeout(scrollToBottom,200);"
		+ "scroll.onscroll=function(){updateFab();};"
		+ "fab.onclick=function(e){e.preventDefault();scrollToBottom();};"
		// Копирование ответа в буфер обмена (DOM-подход)
		+ "window.zsCopy=function(btn){"
		+   "var answer=btn.closest('[data-zs-role=""answer""]');"
		+   "if(!answer)return;"
		+   "var textEl=answer.querySelector('.zs-answer-text');"
		+   "var text=textEl?textEl.textContent:'';"
		+   "if(!text)return;"
		+   "var ok=btn.parentNode.querySelector('.zs-copy-ok');"
		+   "if(navigator.clipboard&&navigator.clipboard.writeText){"
		+     "navigator.clipboard.writeText(text).then(function(){"
		+       "if(ok){ok.style.display='inline';btn.style.display='none';setTimeout(function(){ok.style.display='none';btn.style.display='inline-flex';},2000);}"
		+     "}).catch(function(){});"
		+   "}else{"
		// fallback для старых браузеров / WebView
		+     "try{var ta=document.createElement('textarea');ta.value=text;"
		+       "ta.style.position='fixed';ta.style.left='-9999px';document.body.appendChild(ta);"
		+       "ta.select();document.execCommand('copy');document.body.removeChild(ta);"
		+       "if(ok){ok.style.display='inline';btn.style.display='none';setTimeout(function(){ok.style.display='none';btn.style.display='inline-flex';},2000);}"
		+     "}catch(e){}"
		+   "}"
		+ "};"
		// Постоянные watcher'ы — скрипт в 1C WebView выполняется ОДИН раз, не перезапускается при innerHTML
		+ "(function(){"
		// 1) Анимация точек (30ms) — ищет #_zs_typing_ каждый тик
		+   "var _zsPhases=[0,0.4,0.8],_zsDur=1200,_zsStart=Date.now();"
		+   "setInterval(function(){"
		+     "var dots=document.querySelectorAll('#_zs_typing_ .zs-dot');"
		+     "if(!dots.length)return;"
		+     "var now=Date.now();"
		+     "for(var i=0;i<dots.length;i++){"
		+       "var t=((now-_zsStart+_zsPhases[i]*1000)%_zsDur)/_zsDur;"
		+       "var op=0.5-0.5*Math.cos(t*2*Math.PI);"
		+       "dots[i].style.opacity=(0.15+op*0.85).toFixed(2);"
		+     "}"
		+   "},30);"
		// 2) Эффект печати (200ms) — следит за появлением новых ответов
		+   "var _zsSeen=document.querySelectorAll('[data-zs-role=""answer""]').length;"
		+   "setInterval(function(){"
		+     "var answers=document.querySelectorAll('[data-zs-role=""answer""]');"
		+     "if(answers.length<=_zsSeen)return;"
		+     "_zsSeen=answers.length;"
		+     "var last=answers[answers.length-1];"
		+     "var tar=last.querySelector('.zs-answer-text');"
		+     "if(!tar)return;"
		+     "var text=tar.textContent;"
		+     "if(!text)return;"
		+     "tar.classList.add('typing');"
		+     "var total=text.length;"
		+     "var perChar=total>0?Math.max(5,Math.min(50,Math.floor(2800/total))):10;"
		+     "tar.textContent='';"
		+     "var i=0;"
		+     "function type(){"
		+       "if(i<total){"
		+         "tar.textContent+=text.charAt(i);"
		+         "i++;"
		+         "setTimeout(type,perChar-Math.floor(perChar*0.3)+Math.floor(Math.random()*perChar*0.6));"
		+       "}else{"
		+         "tar.classList.remove('typing');"
		+         "setTimeout(function(){scrollToBottom();},60);"
		+       "}"
		+     "}"
		+     "type();"
		+   "},200);"
		+ "})();"
		+ "})();</script>"
		+ "</body></html>";
КонецФункции //-<---Лико m.shenderov 05.06.2026

//+Лико m.shenderov 05.06.2026 — Экранирование HTML-спецсимволов
&НаСервере
Функция ЭкранироватьHTML(Текст)
	Результат = СтрЗаменить(Текст, "&", "&");
	Результат = СтрЗаменить(Результат, "<", "<");
	Результат = СтрЗаменить(Результат, ">", ">");
	Результат = СтрЗаменить(Результат, Символы.ПС, "<br>");
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Возврат Результат;
КонецФункции //-<---Лико m.shenderov 05.06.2026

//+Лико m.shenderov 15.06.2026 — Преобразование Markdown в HTML для рендеринга в чате
// Поддерживает: # заголовки, **жирный**, `код`, - списки, таблицы, параграфы
&НаСервере
Функция ПреобразоватьMarkdownВHTML(Знач Текст)
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	ПС = Символы.ПС;

	// 1. Экранируем HTML-спецсимволы в тексте (кроме тех что мы сами добавим)
	Текст = СтрЗаменить(Текст, "&", "&");
	Текст = СтрЗаменить(Текст, "<", "<");
	Текст = СтрЗаменить(Текст, ">", ">");

	// 2. Кодовые блоки (``` ... ```) — сохраняем как <pre><code>
	// Ищем и заменяем тройные бэктики
	Пока СтрНайти(Текст, "```") > 0 Цикл
		ПозНачало = СтрНайти(Текст, "```");
		ПослеНачала = Сред(Текст, ПозНачало + 3);
		ПозКонец = СтрНайти(ПослеНачала, "```");
		Если ПозКонец = 0 Тогда
			// Нет закрывающих — заменяем открывающие на <pre><code>
			Текст = Лев(Текст, ПозНачало - 1) + "<pre style=""margin:0 0 8px 0;padding:8px 12px;background:#f1f5f9;border-radius:6px;font-size:13px;overflow-x:auto;""><code>" + ПослеНачала;
			Прервать;
		КонецЕсли;
		Код = Лев(ПослеНачала, ПозКонец - 1);
		Остаток = Сред(ПослеНачала, ПозКонец + 3);
		Текст = Лев(Текст, ПозНачало - 1)
			+ "<pre style=""margin:0 0 8px 0;padding:8px 12px;background:#f1f5f9;border-radius:6px;font-size:13px;overflow-x:auto;""><code>"
			+ Код + "</code></pre>" + Остаток;
	КонецЦикла;

	// 3. Инлайн-код: `текст` → <code>текст</code>
	Пока СтрНайти(Текст, "`") > 0 Цикл
		ПозНачало = СтрНайти(Текст, "`");
		ПослеНачала = Сред(Текст, ПозНачало + 1);
		ПозКонец = СтрНайти(ПослеНачала, "`");
		Если ПозКонец = 0 Тогда
			Прервать;
		КонецЕсли;
		Код = Лев(ПослеНачала, ПозКонец - 1);
		Остаток = Сред(ПослеНачала, ПозКонец + 1);
		Текст = Лев(Текст, ПозНачало - 1)
			+ "<code style=""background:#f1f5f9;padding:1px 4px;border-radius:3px;font-size:13px;font-family:Consolas,monospace;"">"
			+ Код + "</code>" + Остаток;
	КонецЦикла;

	// 4. Жирный: **текст** → <strong>текст</strong>
	Пока СтрНайти(Текст, "**") > 0 Цикл
		ПозНачало = СтрНайти(Текст, "**");
		ПослеНачала = Сред(Текст, ПозНачало + 2);
		ПозКонец = СтрНайти(ПослеНачала, "**");
		Если ПозКонец = 0 Тогда
			Прервать;
		КонецЕсли;
		Жирный = Лев(ПослеНачала, ПозКонец - 1);
		Остаток = Сред(ПослеНачала, ПозКонец + 2);
		Текст = Лев(Текст, ПозНачало - 1) + "<strong>" + Жирный + "</strong>" + Остаток;
	КонецЦикла;

	// 5. Разбиваем на строки и обрабатываем построчно
	МассивСтрок = СтрРазделить(Текст, ПС);
	Результат = "";
	ВСписке = Ложь;
	ВТаблице = Ложь;
	ПредыдущаяПустая = Ложь;

	Для Инд = 0 По МассивСтрок.ВГраница() Цикл
		СтрокаТекст = СокрП(МассивСтрок[Инд]);

		// Пустая строка — конец списка/параграфа
		Если НЕ ЗначениеЗаполнено(СтрокаТекст) Тогда
			Если ВСписке Тогда
				Результат = Результат + "</ul>";
				ВСписке = Ложь;
			КонецЕсли;
			Если ВТаблице Тогда
				Результат = Результат + "</tbody></table>";
				ВТаблице = Ложь;
			КонецЕсли;
			ПредыдущаяПустая = Истина;
			Продолжить;
		КонецЕсли;

		// Таблицы: | col1 | col2 | ... |
		Если Лев(СтрокаТекст, 1) = "|" Тогда
			Если НЕ ВТаблице Тогда
				Результат = Результат + "<table style=""width:100%;border-collapse:collapse;margin:0 0 8px 0;font-size:13px;"">";
				ВТаблице = Истина;
			КонецЕсли;
			Ячейки = СтрРазделить(СтрокаТекст, "|");
			Результат = Результат + "<tr>";
			Для Каждого Ячейка Из Ячейки Цикл
				СодержимоеЯчейки = СокрП(Ячейка);
				Если СодержимоеЯчейки = "" Тогда
					Продолжить;
				КонецЕсли;
				Результат = Результат + "<td style=""padding:4px 8px;margin:0;border:1px solid #d1d5db;"">"
					+ СодержимоеЯчейки + "</td>";
			КонецЦикла;
			Результат = Результат + "</tr>";
			Продолжить;
		КонецЕсли;

		Если ВТаблице Тогда
			Результат = Результат + "</tbody></table>";
			ВТаблице = Ложь;
		КонецЕсли;

		// Заголовки: ### / ## / #
		Если Лев(СтрокаТекст, 4) = "####" Тогда
			Результат = Результат + "<h5 style=""font-size:14px;color:#1a3c5e;margin:8px 0 4px 0;padding:0;font-weight:600;"">"
				+ СокрП(Сред(СтрокаТекст, 5)) + "</h5>";
			ПредыдущаяПустая = Ложь;
			Продолжить;
		ИначеЕсли Лев(СтрокаТекст, 3) = "###" Тогда
			Результат = Результат + "<h4 style=""font-size:15px;color:#1a3c5e;margin:10px 0 4px 0;padding:0;font-weight:600;"">"
				+ СокрП(Сред(СтрокаТекст, 4)) + "</h4>";
			ПредыдущаяПустая = Ложь;
			Продолжить;
		ИначеЕсли Лев(СтрокаТекст, 2) = "##" Тогда
			Результат = Результат + "<h3 style=""font-size:17px;color:#1a3c5e;margin:12px 0 6px 0;padding:0;font-weight:600;"">"
				+ СокрП(Сред(СтрокаТекст, 3)) + "</h3>";
			ПредыдущаяПустая = Ложь;
			Продолжить;
		ИначеЕсли Лев(СтрокаТекст, 1) = "#" Тогда
			Результат = Результат + "<h2 style=""font-size:19px;color:#0f2b47;margin:14px 0 6px 0;padding:0;font-weight:700;"">"
				+ СокрП(Сред(СтрокаТекст, 2)) + "</h2>";
			ПредыдущаяПустая = Ложь;
			Продолжить;
		КонецЕсли;

		// Маркированный список: - или *
		Если (Лев(СтрокаТекст, 2) = "- ") ИЛИ (Лев(СтрокаТекст, 2) = "* ") Тогда
			Если НЕ ВСписке Тогда
				Результат = Результат + "<ul style=""margin:0 0 8px 0;padding-left:20px;"">";
				ВСписке = Истина;
			КонецЕсли;
			Результат = Результат + "<li style=""margin:0 0 2px 0;padding:0;"">"
				+ Сред(СтрокаТекст, 3) + "</li>";
			ПредыдущаяПустая = Ложь;
			Продолжить;
		КонецЕсли;

		Если ВСписке Тогда
			Результат = Результат + "</ul>";
			ВСписке = Ложь;
		КонецЕсли;

		// Обычный параграф
		Результат = Результат
			+ "<p style=""margin:0 0 6px 0;padding:0;font-size:14px;line-height:1.6;"">"
			+ СтрокаТекст + "</p>";
		ПредыдущаяПустая = Ложь;
	КонецЦикла;

	// Закрываем открытые теги
	Если ВСписке Тогда
		Результат = Результат + "</ul>";
	КонецЕсли;
	Если ВТаблице Тогда
		Результат = Результат + "</tbody></table>";
	КонецЕсли;

	Возврат Результат;
КонецФункции //-<---Лико m.shenderov 15.06.2026


