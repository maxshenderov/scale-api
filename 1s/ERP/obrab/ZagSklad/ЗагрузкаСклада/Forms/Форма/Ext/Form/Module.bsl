//+Лико m.shenderov 24.06.2026
// Сбор всех данных для дефрагментации
&НаСервере
Функция СобратьДанныеДляДефрагментации(Склад) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Результат = Новый Структура;
	Результат.Вставить("Секции", Новый Соответствие);
	Результат.Вставить("ПаллетыВСекциях", Новый Соответствие);
	Результат.Вставить("ПаллетыНаПолу", Неопределено);
	Результат.Вставить("ТипоразмерыПаллет", Новый Соответствие);
	Результат.Вставить("Стеллажи", Новый Соответствие);

	// 1. Все секции склада
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Лико_СкладскиеСекции.Ссылка КАК Ссылка,
	|	Лико_СкладскиеСекции.Код КАК Код,
	|	Лико_СкладскиеСекции.Стеллаж КАК Стеллаж,
	|	Лико_СкладскиеСекции.Этаж КАК Этаж,
	|	Лико_СкладскиеСекции.Ряд КАК Ряд,
	|	Лико_СкладскиеСекции.Место КАК Место,
	|	Лико_СкладскиеСекции.Адрес1 КАК Адрес1,
	|	Лико_СкладскиеСекции.Адрес2 КАК Адрес2,
	|	Лико_СкладскиеСекции.Адрес3 КАК Адрес3,
	|	Лико_СкладскиеСекции.Типоразмер КАК Типоразмер,
	|	Лико_СкладскиеСекции.ЗапретРазмещения КАК ЗапретРазмещения,
	|	Лико_СкладскиеСекции.МинимальнаяГлубинаНеОграничена КАК МинГлубинаНеОграничена,
	|	Лико_СкладскиеСекции.МаксимальнаяГлубинаНеОграничена КАК МаксГлубинаНеОграничена,
	|	Лико_СкладскиеСекции.МаксимальныйВесПодъёмаНаЭтаж КАК МаксВесПодъёма
	|ИЗ
	|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
	|ГДЕ
	|	Лико_СкладскиеСекции.Склад = &Склад
	|	И НЕ Лико_СкладскиеСекции.ПометкаУдаления";
	Запрос.УстановитьПараметр("Склад", Склад);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		ДанныеСекции = Новый Структура;
		ДанныеСекции.Вставить("Ссылка", Выборка.Ссылка);
		ДанныеСекции.Вставить("Код", Выборка.Код);
		ДанныеСекции.Вставить("Стеллаж", Выборка.Стеллаж);
		ДанныеСекции.Вставить("Этаж", Выборка.Этаж);
		ДанныеСекции.Вставить("Ряд", Выборка.Ряд);
		ДанныеСекции.Вставить("Место", Выборка.Место);
		ДанныеСекции.Вставить("Адрес1", Выборка.Адрес1);
		ДанныеСекции.Вставить("Адрес2", Выборка.Адрес2);
		ДанныеСекции.Вставить("Адрес3", Выборка.Адрес3);
		ДанныеСекции.Вставить("Типоразмер", Выборка.Типоразмер);
		ДанныеСекции.Вставить("ЗапретРазмещения", Выборка.ЗапретРазмещения);
		ДанныеСекции.Вставить("МинГлубинаНеОграничена", Выборка.МинГлубинаНеОграничена);
		ДанныеСекции.Вставить("МаксГлубинаНеОграничена", Выборка.МаксГлубинаНеОграничена);
		ДанныеСекции.Вставить("МаксВесПодъёма", Выборка.МаксВесПодъёма);
		Результат.Секции.Вставить(Выборка.Ссылка, ДанныеСекции);
	КонецЦикла;

	// 2. Паллеты в секциях (виртуальное состояние = текущее из БД)
	ЗапросПаллет = Новый Запрос;
	ЗапросПаллет.Текст =
	"ВЫБРАТЬ
	|	Лико_ПаллетыВСекцияхОстатки.Адрес КАК Адрес,
	|	Лико_ПаллетыВСекцияхОстатки.Паллет КАК Паллет,
	|	Лико_ПаллетыВСекцияхОстатки.Секция КАК Секция,
	|	Лико_ПараметрыПаллетСрезПоследних.Типоразмер КАК Типоразмер
	|ИЗ
	|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
	|			,
	|			Секция В
	|				(ВЫБРАТЬ
	|					Лико_СкладскиеСекции.Ссылка
	|				ИЗ
	|					Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
	|				ГДЕ
	|					Лико_СкладскиеСекции.Склад = &Склад)) КАК Лико_ПаллетыВСекцияхОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних КАК Лико_ПараметрыПаллетСрезПоследних
	|		ПО Лико_ПаллетыВСекцияхОстатки.Паллет = Лико_ПараметрыПаллетСрезПоследних.Паллет
	|ГДЕ
	|	Лико_ПаллетыВСекцияхОстатки.КоличествоОстаток > 0";
	ЗапросПаллет.УстановитьПараметр("Склад", Склад);
	ВыборкаП = ЗапросПаллет.Выполнить().Выбрать();

	Пока ВыборкаП.Следующий() Цикл
		Результат.ПаллетыВСекциях.Вставить(ВыборкаП.Адрес, ВыборкаП.Паллет);
		Результат.ТипоразмерыПаллет.Вставить(ВыборкаП.Паллет, ВыборкаП.Типоразмер);
	КонецЦикла;

	// 3. Паллеты на полу
	Результат.ПаллетыНаПолу = ПаллетыНаПолу(Склад);

	// 4. Ограничения стеллажей
	ЗапросСтл = Новый Запрос;
	ЗапросСтл.Текст =
	"ВЫБРАТЬ
	|	Лико_Стеллажи.Ссылка КАК Ссылка,
	|	Лико_Стеллажи.Код КАК Код,
	|	Лико_Стеллажи.МинШиринаПаллета КАК МинШирина,
	|	Лико_Стеллажи.МаксШиринаПаллета КАК МаксШирина,
	|	Лико_Стеллажи.МинГлубинаПаллета КАК МинГлубина,
	|	Лико_Стеллажи.МаксГлубинаПаллета КАК МаксГлубина,
	|	Лико_Стеллажи.ШиринаСекции КАК ШиринаСекции,
	|	Лико_Стеллажи.Узкопроходный КАК Узкопроходный
	|ИЗ
	|	Справочник.Лико_Стеллажи КАК Лико_Стеллажи
	|ГДЕ
	|	Лико_Стеллажи.Склад = &Склад
	|	И НЕ Лико_Стеллажи.ПометкаУдаления";
	ЗапросСтл.УстановитьПараметр("Склад", Склад);
	ВыборкаСтл = ЗапросСтл.Выполнить().Выбрать();

	Пока ВыборкаСтл.Следующий() Цикл
		ДанныеСтл = Новый Структура;
		ДанныеСтл.Вставить("Код", ВыборкаСтл.Код);
		ДанныеСтл.Вставить("МинШирина", ВыборкаСтл.МинШирина);
		ДанныеСтл.Вставить("МаксШирина", ВыборкаСтл.МаксШирина);
		ДанныеСтл.Вставить("МинГлубина", ВыборкаСтл.МинГлубина);
		ДанныеСтл.Вставить("МаксГлубина", ВыборкаСтл.МаксГлубина);
		ДанныеСтл.Вставить("ШиринаСекции", ВыборкаСтл.ШиринаСекции);
		ДанныеСтл.Вставить("Узкопроходный", ВыборкаСтл.Узкопроходный);
		Результат.Стеллажи.Вставить(ВыборкаСтл.Ссылка, ДанныеСтл);
	КонецЦикла;

	Возврат Результат;

КонецФункции

//+Лико m.shenderov 24.06.2026
// Построение графа совместимости: для каждой занятой секции -> список секций куда можно переставить паллет
&НаСервере
Функция ПостроитьГрафПерестановок(Данные, ВиртуальноеСостояние) Экспорт

	Граф = Новый Соответствие; // КодСекции -> Массив(КодСекции)

	// Перебираем все занятые секции
	Для Каждого КлючА Из Данные.ПаллетыВСекциях Цикл
		АдресА = КлючА.Ключ;
		ПаллетА = КлючА.Значение;
		СекцияА = АдресА.Лико_Секция;

		Если Граф.Получить(СекцияА.Код) <> Неопределено Тогда
			Продолжить; // уже обработали эту секцию
		КонецЕсли;

		Граф.Вставить(СекцияА.Код, Новый Массив);

		// Пробуем переставить паллет А в каждую другую секцию
		Для Каждого КлючБ Из Данные.Секции Цикл
			СекцияБ = КлючБ.Значение;

			Если СекцияБ.Ссылка = СекцияА Тогда
				Продолжить;
			КонецЕсли;

			Если СекцияБ.ЗапретРазмещения Тогда
				Продолжить;
			КонецЕсли;

			// Выбираем адрес в секции Б (предпочитаем свободные)
			ЦелевойАдрес = Неопределено;
			Если ВиртуальноеСостояние.Получить(СекцияБ.Адрес1) = Неопределено Тогда
				ЦелевойАдрес = СекцияБ.Адрес1;
			ИначеЕсли ВиртуальноеСостояние.Получить(СекцияБ.Адрес3) = Неопределено Тогда
				ЦелевойАдрес = СекцияБ.Адрес3;
			ИначеЕсли ВиртуальноеСостояние.Получить(СекцияБ.Адрес2) = Неопределено Тогда
				ЦелевойАдрес = СекцияБ.Адрес2;
			КонецЕсли;

			Если ЦелевойАдрес = Неопределено Тогда
				Продолжить; // все адреса заняты
			КонецЕсли;

			// Проверяем через ОшибкиРазмещения с виртуальным состоянием
			Ошибки = Справочники.Лико_СкладскиеСекции.ОшибкиРазмещенияПаллетаВАдрес(
				ЦелевойАдрес, ПаллетА, Неопределено, Истина, ВиртуальноеСостояние);

			Если Ошибки.Количество() = 0 Тогда
				Граф[СекцияА.Код].Добавить(СекцияБ.Код);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Граф;

КонецФункции

//+Лико m.shenderov 24.06.2026
// Поиск секций с потенциалом >= 2 (можно добавить ещё паллеты)
&НаСервере
Функция НайтиВоздушныеСекции(Данные, ВиртуальноеСостояние) Экспорт

	Воздушные = Новый Массив;

	Для Каждого КлючС Из Данные.Секции Цикл
		Секция = КлючС.Значение;

		// Секция должна быть занята (хотя бы 1 адрес)
		ЕстьПаллет1 = ВиртуальноеСостояние.Получить(Секция.Адрес1) <> Неопределено;
		ЕстьПаллет2 = ВиртуальноеСостояние.Получить(Секция.Адрес2) <> Неопределено;
		ЕстьПаллет3 = ВиртуальноеСостояние.Получить(Секция.Адрес3) <> Неопределено;

		Если НЕ ЕстьПаллет1 И НЕ ЕстьПаллет2 И НЕ ЕстьПаллет3 Тогда
			Продолжить; // секция пустая
		КонецЕсли;

		// Оцениваем потенциал: сколько свободных адресов
		Свободных = 0;
		Если НЕ ЕстьПаллет1 Тогда Свободных = Свободных + 1; КонецЕсли;
		Если НЕ ЕстьПаллет2 Тогда Свободных = Свободных + 1; КонецЕсли;
		Если НЕ ЕстьПаллет3 Тогда Свободных = Свободных + 1; КонецЕсли;

		Если Свободных >= 1 Тогда
			ДанныеВоздуха = Новый Структура;
			ДанныеВоздуха.Вставить("Код", Секция.Код);
			ДанныеВоздуха.Вставить("Ссылка", Секция.Ссылка);
			ДанныеВоздуха.Вставить("Потенциал", Свободных);
			Воздушные.Добавить(ДанныеВоздуха);
		КонецЕсли;
	КонецЦикла;

	// Сортируем по убыванию потенциала
	Воздушные.Сортировать("Потенциал УБЫВ");

	Возврат Воздушные;

КонецФункции

//+Лико m.shenderov 24.06.2026
// Жадное паросочетание: найти максимальное кол-во независимых перестановок
&НаСервере
Функция НайтиПаросочетание(Граф, Воздушные) Экспорт

	Перемещения = Новый Массив;
	Использованные = Новый Соответствие; // КодСекции -> Истина

	Для Каждого Воздух Из Воздушные Цикл
		КодВоздуха = Воздух.Код;

		Если Использованные.Получить(КодВоздуха) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Соседи = Граф.Получить(КодВоздуха);
		Если Соседи = Неопределено Или Соседи.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Ищем первую неиспользованную секцию-назначение
		Для Каждого КодСоседа Из Соседи Цикл
			Если Использованные.Получить(КодСоседа) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			// Нашли!
			Перест = Новый Структура;
			Перест.Вставить("Откуда", КодВоздуха);
			Перест.Вставить("Куда", КодСоседа);
			Перемещения.Добавить(Перест);

			Использованные.Вставить(КодВоздуха, Истина);
			Использованные.Вставить(КодСоседа, Истина);
			Прервать;
		КонецЦикла;
	КонецЦикла;

	Возврат Перемещения;

КонецФункции

//+Лико m.shenderov 24.06.2026
// Подсчёт результата: сколько ячеек освобождено, сколько паллетов разместится
&НаСервере
Функция ПосчитатьРезультат(Паросочетание, Данные, ВиртуальноеСостояние) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ОсвобождённыхЯчеек", 0);
	Результат.Вставить("РеальноРазместится", 0);
	Результат.Вставить("Перемещения", Новый Массив);
	Результат.Вставить("Мета", Новый Структура);

	Результат.Мета.Вставить("ВсегоСекций", Данные.Секции.Количество());

	// Считаем занятые секции
	Занятых = 0;
	Для каждого Ключ Из Данные.ПаллетыВСекциях Цикл
		Занятых = Занятых + 1;
	КонецЦикла;
	Результат.Мета.Вставить("ЗанятоСекцийДо", Занятых);

	// Применяем паросочетание
	Для Каждого Пер Из Паросочетание Цикл
		АдресОткуда = НайтиАдресПоКодуСекции(Данные, Пер.Откуда);
		АдресКуда = НайтиПервыйСвободныйАдрес(Данные, Пер.Куда, ВиртуальноеСостояние);

		Если АдресОткуда = Неопределено Или АдресКуда = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Паллет = ВиртуальноеСостояние.Получить(АдресОткуда);
		Если Паллет = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Виртуально перемещаем
		ВиртуальноеСостояние.Удалить(АдресОткуда);
		ВиртуальноеСостояние.Вставить(АдресКуда, Паллет);

		Результат.ОсвобождённыхЯчеек = Результат.ОсвобождённыхЯчеек + 1;

		Запись = Новый Структура;
		Запись.Вставить("Паллет", Паллет);
		Запись.Вставить("Откуда", Пер.Откуда);
		Запись.Вставить("Куда", Пер.Куда);
		Результат.Перемещения.Добавить(Запись);
	КонецЦикла;

	// Считаем сколько паллетов с пола реально разместится в освобождённых ячейках
	Если Данные.ПаллетыНаПолу.Количество() > 0 Тогда
		ТЗПол = Данные.ПаллетыНаПолу;
		ПаллетыНаПолуСписок = Новый Массив;
		Для Каждого СтрП Из ТЗПол Цикл
			ТипоразмерПол = СтрП.Типоразмер;
			Кол = СтрП.Количество;
			Для Инд = 1 По Кол Цикл
				ПаллетыНаПолуСписок.Добавить(ТипоразмерПол);
			КонецЦикла;
		КонецЦикла;

		Для Каждого ТипП Из ПаллетыНаПолуСписок Цикл
			// Ищем свободную секцию куда влезет этот типоразмер
			Для Каждого КлючС Из Данные.Секции Цикл
				Секция = КлючС.Значение;

				// Проверяем есть ли свободный адрес в секции
				СвАдрес = НайтиПервыйСвободныйАдрес(Данные, Секция.Код, ВиртуальноеСостояние);
				Если СвАдрес = Неопределено Тогда
					Продолжить;
				КонецЕсли;

				// Проверяем габариты
				Если ТипП.Высота <= Секция.Типоразмер.Высота
					И ТипП.Глубина <= Секция.Типоразмер.Глубина Тогда

					ВиртуальноеСостояние.Вставить(СвАдрес, Неопределено); // заглушка — считаем размещённым
					Результат.РеальноРазместится = Результат.РеальноРазместится + 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Результат.Мета.Вставить("ЗанятоСекцийПосле", Результат.ОсвобождённыхЯчеек + Результат.РеальноРазместится);

	Возврат Результат;

КонецФункции

