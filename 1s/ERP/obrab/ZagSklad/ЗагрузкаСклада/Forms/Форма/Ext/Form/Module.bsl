&НаСервере
Процедура ДобавитьПаллетыНаПолуВHTML()
	//+Лико m.shenderov 23.06.2026 — добавляет таблицу паллет на полу в html
	ТЗ = ПаллетыНаПолу(Склад);
	Если ТЗ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТабHTML = "<div class=""pallet-summary""><b>Паллеты на полу:</b><table class=""sortable"" data-table-id=""floor""><thead><tr>"
		+ "<th onclick=""sortTable(this,0)"">№</th>"
		+ "<th onclick=""sortTable(this,1)"">Типоразмер</th>"
		+ "<th onclick=""sortTable(this,2)"">Адрес</th>"
		+ "<th onclick=""sortTable(this,3)"">Количество</th>"
		+ "</tr></thead><tbody>";
	Ном = 0;
	Для Каждого Стр Из ТЗ Цикл
		Ном = Ном + 1;
		ТабHTML = ТабHTML + "<tr>"
			+ "<td>" + Формат(Ном, "ЧН=0; ЧГ=0") + "</td>"
			+ "<td>" + Строка(Стр.Типоразмер) + "</td>"
			+ "<td>" + Строка(Стр.Адрес) + "</td>"
			+ "<td>" + Формат(Стр.Количество, "ЧН=0; ЧГ=0") + "</td>"
			+ "</tr>";
	КонецЦикла;
	ТабHTML = ТабHTML + "</tbody><tfoot><tr>"
		+ "<td></td><td></td><td><b>Итого:</b></td>"
		+ "<td><b>" + Формат(ТЗ.Итог("Количество"), "ЧН=0; ЧГ=0") + "</b></td>"
		+ "</tr></tfoot></table></div>";
	
	// Вставить перед </body>
	Поз = СтрНайти(html, "</body>");
	Если Поз > 0 Тогда
		html = Лев(html, Поз - 1) + ТабHTML + Сред(html, Поз);
	КонецЕсли;
КонецПроцедуры
Процедура РендерЗагрузкиСтеллажаНаСервере(СтеллажСсылка, ПроцентЗагрузки = -1)
	//+Лико m.shenderov 15.05.2026
	// Визуализация поперечного сечения стеллажа с пропорциональными паллетами
	// Масштаб: берётся из атрибута формы МасштабМм (по умолчанию 0.05 px/мм)
  УстановитьПривилегированныйРежим(Истина);	
	КоэфМасштаба = МасштабМм;
	Если КоэфМасштаба <= 0 Тогда
		КоэфМасштаба = 0.05;
	КонецЕсли;
	Если МасштабПроцентов <= 0 Тогда
		МасштабПроцентов = 100;
	КонецЕсли;
	
	// === 1. Данные стеллажа ===
	СтеллажДанные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтеллажСсылка,
		"Наименование, КодПолный");
	
	Если ПроцентЗагрузки = -1 Тогда
		// Пересчитываем только если не передан снаружи
		ПроцентЗагрузки = ПолучитьПроцентЗагрузкиСтеллажа(СтеллажСсылка);
	КонецЕсли;
	ЦветЗагрузкиHex = ЦветЗагрузкиHex(ПроцентЗагрузки);
	
	// === 2. Этажи стеллажа ===
	СтеллажОбъект = СтеллажСсылка.ПолучитьОбъект();
	ЭтажиТЧ = СтеллажОбъект.Этажи;
	
	МассивТипоразмеровЭтажей = Новый Массив;
	Для Каждого СтрокаЭтажа Из ЭтажиТЧ Цикл
		Если ЗначениеЗаполнено(СтрокаЭтажа.Типоразмер) Тогда
			МассивТипоразмеровЭтажей.Добавить(СтрокаЭтажа.Типоразмер);
		КонецЕсли;
	КонецЦикла;
	
	ТипоразмерыЭтажейКэш = Новый Соответствие;
	Если МассивТипоразмеровЭтажей.Количество() > 0 Тогда
		ТипоразмерыЭтажейКэш = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
			МассивТипоразмеровЭтажей, "Ширина, Высота, Вес");
	КонецЕсли;
	
	// Соответствие: НомерЭтажа -> Структура(Ширина, Высота, Вес)
	ДанныеЭтажей = Новый Соответствие;
	Для Каждого СтрокаЭтажа Из ЭтажиТЧ Цикл
		Если ЗначениеЗаполнено(СтрокаЭтажа.Типоразмер) Тогда
			ДанныеЭтажей.Вставить(СтрокаЭтажа.НомерСтроки,
				ТипоразмерыЭтажейКэш.Получить(СтрокаЭтажа.Типоразмер));
		КонецЕсли;
	КонецЦикла;
	
	// === 3. Секции стеллажа ===
	ЗапросСекций = Новый Запрос;
	ЗапросСекций.Текст = 
		"ВЫБРАТЬ
		|	Лико_СкладскиеСекции.Ссылка КАК Ссылка,
		|	Лико_СкладскиеСекции.Наименование КАК Наименование,
		|	Лико_СкладскиеСекции.Место КАК Место,
		|	Лико_СкладскиеСекции.Этаж КАК Этаж,
			|	Лико_СкладскиеСекции.Ряд КАК Ряд,
		|	Лико_СкладскиеСекции.Адрес1 КАК Адрес1,
		|	Лико_СкладскиеСекции.Адрес2 КАК Адрес2,
		|	Лико_СкладскиеСекции.Адрес3 КАК Адрес3,
		|	Лико_СкладскиеСекции.КоличествоАдресов КАК КоличествоАдресов,
		|	Лико_СкладскиеСекции.ЗапретРазмещения КАК ЗапретРазмещения,
		|	Лико_СкладскиеСекции.МаксимальныйВесПодъёмаНаЭтаж КАК МаксВесПодъёмаНаЭтаж
		|ИЗ
		|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
		|ГДЕ
		|	Лико_СкладскиеСекции.Стеллаж = &Стеллаж
		|	И НЕ Лико_СкладскиеСекции.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Лико_СкладскиеСекции.Этаж УБЫВ,
		|	Лико_СкладскиеСекции.Место";
	ЗапросСекций.УстановитьПараметр("Стеллаж", СтеллажСсылка);
	РезультатСекций = ЗапросСекций.Выполнить();
	
	СекцииПоЭтажам = Новый Соответствие;
	МаксВесПоЭтажам = Новый Соответствие; // НомерЭтажа → максимальный вес подъёма
	МассивСекцийСсылки = Новый Массив;
	
	Если НЕ РезультатСекций.Пустой() Тогда
		ВыборкаСекций = РезультатСекций.Выбрать();
		Пока ВыборкаСекций.Следующий() Цикл
			СтруктураСекции = Новый Структура(
				"Ссылка, Наименование, Место, Этаж, Ряд, Адрес1, Адрес2, Адрес3, КоличествоАдресов, ЗапретРазмещения, МаксВесПодъёмаНаЭтаж",
				ВыборкаСекций.Ссылка, ВыборкаСекций.Наименование, ВыборкаСекций.Место,
				ВыборкаСекций.Этаж, ВыборкаСекций.Ряд, ВыборкаСекций.Адрес1, ВыборкаСекций.Адрес2,
				ВыборкаСекций.Адрес3, ВыборкаСекций.КоличествоАдресов, ВыборкаСекций.ЗапретРазмещения, ВыборкаСекций.МаксВесПодъёмаНаЭтаж);
			МассивСекцийСсылки.Добавить(ВыборкаСекций.Ссылка);
			
			НомерЭтажа = ВыборкаСекций.Этаж;
			МассивЭтажа = СекцииПоЭтажам.Получить(НомерЭтажа);
			Если МассивЭтажа = Неопределено Тогда
				МассивЭтажа = Новый Массив;
				СекцииПоЭтажам.Вставить(НомерЭтажа, МассивЭтажа);
			КонецЕсли;
			МассивЭтажа.Добавить(СтруктураСекции);
			// Запоминаем макс. вес подъёма на этаж (берём мин. ненулевой по секциям)
			Если СтруктураСекции.МаксВесПодъёмаНаЭтаж > 0 Тогда
				ТекМаксВес = МаксВесПоЭтажам.Получить(НомерЭтажа);
				Если ТекМаксВес = Неопределено ИЛИ СтруктураСекции.МаксВесПодъёмаНаЭтаж < ТекМаксВес Тогда
					МаксВесПоЭтажам.Вставить(НомерЭтажа, СтруктураСекции.МаксВесПодъёмаНаЭтаж);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// === 4. Паллеты в секциях (включая зарезервированные) ===
	ЗапросПаллет = Новый Запрос;
	ЗапросПаллет.Текст = 
		"ВЫБРАТЬ
		|	Лико_ПаллетыВСекцияхОстатки.Секция КАК Секция,
		|	Лико_ПаллетыВСекцияхОстатки.Паллет КАК Паллет,
		|	Лико_ПаллетыВСекцияхОстатки.Адрес КАК Адрес,
		|	Лико_ПаллетыВСекцияхОстатки.КоличествоОстаток КАК Количество,
		|	Лико_ПаллетыВСекцияхОстатки.ЗаблокированОстаток КАК Заблокирован,
		|	Лико_Паллеты2_0.Код КАК НомерПаллета
		|ИЗ
		|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
		|		,
		|		Секция В (&МассивСекций)
		|	) КАК Лико_ПаллетыВСекцияхОстатки
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_Паллеты2_0 КАК Лико_Паллеты2_0
		|	ПО Лико_ПаллетыВСекцияхОстатки.Паллет = Лико_Паллеты2_0.Ссылка
		|ГДЕ
		|	Лико_ПаллетыВСекцияхОстатки.КоличествоОстаток > 0
		|	ИЛИ Лико_ПаллетыВСекцияхОстатки.ЗаблокированОстаток > 0";
	ЗапросПаллет.УстановитьПараметр("МассивСекций", МассивСекцийСсылки);
	РезультатПаллет = ЗапросПаллет.Выполнить();
	
	// Индекс: Секция -> Адрес -> Структура(НомерПаллета, Количество, Заблокирован, ПаллетСсылка)
	ДанныеПаллет = Новый Соответствие;
	МассивПаллетСсылки = Новый Массив;
	
	Если НЕ РезультатПаллет.Пустой() Тогда
		ВыборкаПаллет = РезультатПаллет.Выбрать();
		Пока ВыборкаПаллет.Следующий() Цикл
			КартаАдресов = ДанныеПаллет.Получить(ВыборкаПаллет.Секция);
			Если КартаАдресов = Неопределено Тогда
				КартаАдресов = Новый Соответствие;
				ДанныеПаллет.Вставить(ВыборкаПаллет.Секция, КартаАдресов);
			КонецЕсли;
			
			ДанныеАдреса = Новый Структура(
				"НомерПаллета, Количество, Заблокирован, ПаллетСсылка",
				ВыборкаПаллет.НомерПаллета, ВыборкаПаллет.Количество,
				ВыборкаПаллет.Заблокирован, ВыборкаПаллет.Паллет);
			КартаАдресов.Вставить(ВыборкаПаллет.Адрес, ДанныеАдреса);
			
			Если МассивПаллетСсылки.Найти(ВыборкаПаллет.Паллет) = Неопределено Тогда
				МассивПаллетСсылки.Добавить(ВыборкаПаллет.Паллет);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// === 5. Типоразмеры паллет (Лико_ПараметрыПаллет) ===
	ПараметрыПаллетКэш = Новый Соответствие;
	Если МассивПаллетСсылки.Количество() > 0 Тогда
		ЗапросПараметров = Новый Запрос;
		ЗапросПараметров.Текст = 
			"ВЫБРАТЬ
			|	Лико_ПараметрыПаллетСрезПоследних.Паллет КАК Паллет,
			|	Лико_ТипоразмерыПаллет.Ширина КАК Ширина,
			|	Лико_ТипоразмерыПаллет.Высота КАК Высота,
			|	Лико_ТипоразмерыПаллет.Глубина КАК Глубина,
			|	Лико_ТипоразмерыПаллет.Вес КАК Вес
			|ИЗ
			|	РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних(
			|		,
			|		Паллет В (&МассивПаллет)
			|	) КАК Лико_ПараметрыПаллетСрезПоследних
			|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лико_ТипоразмерыПаллет КАК Лико_ТипоразмерыПаллет
			|	ПО Лико_ПараметрыПаллетСрезПоследних.Типоразмер = Лико_ТипоразмерыПаллет.Ссылка";
		ЗапросПараметров.УстановитьПараметр("МассивПаллет", МассивПаллетСсылки);
		РезультатПараметров = ЗапросПараметров.Выполнить();
		
		Если НЕ РезультатПараметров.Пустой() Тогда
			ВыборкаПараметров = РезультатПараметров.Выбрать();
			Пока ВыборкаПараметров.Следующий() Цикл
				ПараметрыПаллетКэш.Вставить(ВыборкаПараметров.Паллет,
					Новый Структура("Ширина, Высота, Глубина, Вес",
						ВыборкаПараметров.Ширина, ВыборкаПараметров.Высота,
						ВыборкаПараметров.Глубина, ВыборкаПараметров.Вес));
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
		//+Лико m.shenderov 22.06.2026 — сводная таблица типоразмеров по стеллажам
		// 1. Батч-запрос: паллеты по всем стеллажам склада, группировка (Стеллаж, Типоразмер)
		ЗапросСводки = Новый Запрос;
		ЗапросСводки.Текст =
		"ВЫБРАТЬ
		|	Лико_СкладскиеСекции.Стеллаж КАК Стеллаж,
		|	Лико_СкладскиеСекции.Стеллаж.КодПолный КАК КодСтеллажа,
		|	Лико_СкладскиеСекции.Стеллаж.Наименование КАК ИмяСтеллажа,
		|	Лико_ТипоразмерыПаллет.Высота КАК Высота,
		|	Лико_ТипоразмерыПаллет.Ширина КАК Ширина,
		|	Лико_ТипоразмерыПаллет.Глубина КАК Глубина,
		|	Лико_ТипоразмерыПаллет.Вес КАК Вес,
		|	СУММА(Лико_ПаллетыВСекцияхОстатки.КоличествоОстаток) КАК Количество
		|ИЗ
		|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки КАК Лико_ПаллетыВСекцияхОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
		|		ПО Лико_ПаллетыВСекцияхОстатки.Секция = Лико_СкладскиеСекции.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних КАК ПараметрыПаллет
		|		ПО Лико_ПаллетыВСекцияхОстатки.Паллет = ПараметрыПаллет.Паллет
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лико_ТипоразмерыПаллет КАК Лико_ТипоразмерыПаллет
		|		ПО ПараметрыПаллет.Типоразмер = Лико_ТипоразмерыПаллет.Ссылка
		|ГДЕ
		|	Лико_СкладскиеСекции.Стеллаж.Склад = &Склад
		|	И НЕ Лико_СкладскиеСекции.ПометкаУдаления
		|	И Лико_ПаллетыВСекцияхОстатки.КоличествоОстаток > 0
		|СГРУППИРОВАТЬ ПО
		|	Лико_СкладскиеСекции.Стеллаж,
		|	Лико_СкладскиеСекции.Стеллаж.КодПолный,
		|	Лико_СкладскиеСекции.Стеллаж.Наименование,
		|	Лико_ТипоразмерыПаллет.Высота,
		|	Лико_ТипоразмерыПаллет.Ширина,
		|	Лико_ТипоразмерыПаллет.Глубина,
		|	Лико_ТипоразмерыПаллет.Вес";
		ЗапросСводки.УстановитьПараметр("Склад", Склад);
		РезСводки = ЗапросСводки.Выполнить();

		// 2. Строим: СводкаТипоразмеров[КлючТипа][СтеллажСсылка] = Кол
		СводкаТипоразмеров = Новый Соответствие;
		ИндексСтеллажей = Новый Соответствие; // СтеллажСсылка -> Структура(Код, Имя)
		Если НЕ РезСводки.Пустой() Тогда
			ВыборкаС = РезСводки.Выбрать();
			Пока ВыборкаС.Следующий() Цикл
				КлючТипа = Строка(ВыборкаС.Высота) + "~" + Строка(ВыборкаС.Ширина) + "~" + Строка(ВыборкаС.Глубина) + "~" + Строка(ВыборкаС.Вес);
				КартаСтеллажей = СводкаТипоразмеров.Получить(КлючТипа);
				Если КартаСтеллажей = Неопределено Тогда
					КартаСтеллажей = Новый Соответствие;
					СводкаТипоразмеров.Вставить(КлючТипа, КартаСтеллажей);
					КартаСтеллажей.Вставить("__params__",
						Новый Структура("Высота, Ширина, Глубина, Вес",
							ВыборкаС.Высота, ВыборкаС.Ширина, ВыборкаС.Глубина, ВыборкаС.Вес));
				КонецЕсли;
				КартаСтеллажей.Вставить(ВыборкаС.Стеллаж, ВыборкаС.Количество);
				// Запомнить стеллаж
				Если ИндексСтеллажей.Получить(ВыборкаС.Стеллаж) = Неопределено Тогда
					ИндексСтеллажей.Вставить(ВыборкаС.Стеллаж,
						Новый Структура("Код, Имя", ВыборкаС.КодСтеллажа, ВыборкаС.ИмяСтеллажа));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// 3. Список и цвета стеллажей (из ИндексСтеллажей + запрос загрузки)
		СписокСтеллажей = Новый Массив;
		ЦветаСтеллажей = Новый Соответствие;
		Для Каждого Пара Из ИндексСтеллажей Цикл
			СтлСсылка = Пара.Ключ;
			СписокСтеллажей.Добавить(СтлСсылка);
		КонецЦикла;
		// Сортируем по коду стеллажа
		// Запрос % загрузки по стеллажам для цветов
		ЗапросЦветов = Новый Запрос;
		ЗапросЦветов.Текст =
		"ВЫБРАТЬ
		|	Лико_СкладскиеСекции.Стеллаж КАК Стеллаж,
		|	СУММА(ВЫБОР КОГДА Лико_СкладскиеСекции.КоличествоАдресов = 0 ТОГДА 3
		|		ИНАЧЕ Лико_СкладскиеСекции.КоличествоАдресов КОНЕЦ) КАК ВсегоАдресов
		|ИЗ
		|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
		|ГДЕ
		|	Лико_СкладскиеСекции.Стеллаж.Склад = &Склад
		|	И НЕ Лико_СкладскиеСекции.ПометкаУдаления
		|СГРУППИРОВАТЬ ПО
		|	Лико_СкладскиеСекции.Стеллаж";
		ЗапросЦветов.УстановитьПараметр("Склад", Склад);
		РезЦветов = ЗапросЦветов.Выполнить();
		// Всего адресов по стеллажам
		АдресаПоСтеллажам = Новый Соответствие;
		Если НЕ РезЦветов.Пустой() Тогда
			ВыборкаЦв = РезЦветов.Выбрать();
			Пока ВыборкаЦв.Следующий() Цикл
				АдресаПоСтеллажам.Вставить(ВыборкаЦв.Стеллаж, ВыборкаЦв.ВсегоАдресов);
			КонецЦикла;
		КонецЕсли;
		// Цвета стеллажей — пользовательские из ДопНастройки.ЦветСтеллажа
		ЦветаСтеллажей = ПолучитьЦветаСтелажейHexНаСервере();

		// Сортируем по коду стеллажа
			СписокСтеллажейСЗ = Новый СписокЗначений;
			Для Каждого Стл Из СписокСтеллажей Цикл
				ДанныеСтл = ИндексСтеллажей.Получить(Стл);
				ИмяСтл = ?(ДанныеСтл <> Неопределено, ДанныеСтл.Код, Строка(Стл));
				СписокСтеллажейСЗ.Добавить(Стл, ИмяСтл);
			КонецЦикла;
			СписокСтеллажейСЗ.СортироватьПоПредставлению();
		СписокСтеллажей = Новый Массив;
		Для Каждого Эл Из СписокСтеллажейСЗ Цикл
			СписокСтеллажей.Добавить(Эл.Значение);
		КонецЦикла;


	// === 6. Генерация HTML ===
	HTML = "<!DOCTYPE html><html><head><meta charset=""utf-8"">"
		+ "<style>"
		+ "body { font-family: Arial, sans-serif; margin: 10px; font-size: 12px; background: #fff; scrollbar-width: thin; overflow: auto; }"
