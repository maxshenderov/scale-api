Функция СписокМоделей(Провайдер) Экспорт
	
ПараметрыПровайдера = Провайдеры()[Провайдер];
	
Попытка
	
	
Порт = ?(ПараметрыПровайдера.Свойство("Порт"), ПараметрыПровайдера.Порт, 443);
	
	
ИспользоватьSSL = ?(ПараметрыПровайдера.Свойство("ИспользоватьSSL"), ПараметрыПровайдера.ИспользоватьSSL, Истина);
	
	
Защита = ?(ИспользоватьSSL, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
	
	
Соединение = Новый HTTPСоединение(
	
	
ПараметрыПровайдера.URLСервера, Порт, , , , 30, Защита);
	
	

	
	
Запрос = Новый HTTPЗапрос("/api/v1/models");
	
	
Запрос.Заголовки.Вставить("Authorization", "Bearer " + ПараметрыПровайдера.КлючAPI);
	
	
Запрос.Заголовки.Вставить("Content-Type",  "application/json");
	
	
Ответ = Соединение.Получить(Запрос);
	
	

	
	
Если Ответ.КодСостояния = 200 Тогда
	
	
	
Чтение = Новый ЧтениеJSON;
	
	
	
Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	
	
	
Данные = ПрочитатьJSON(Чтение);
	
	
	
Возврат Данные.data;
	
	
Иначе
	
	
	
ВызватьИсключение "СписокМоделей: HTTP " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку();
	
	
КонецЕсли;
	
Исключение
	
	
Возврат Новый Массив();
	
КонецПопытки;
КонецФункции

// Возвращает НастройкиLLM, готовые для передачи в СпроситьLLM.
Функция ПараметрыПровайдера(ПровайдерИмя = Неопределено, МодельИмя = Неопределено) Экспорт
    ПоУмолчанию  = ПровайдерПоУмолчанию();
    ПровайдерыВсе = Провайдеры();

    Если ПровайдерИмя = Неопределено ИЛИ НЕ ПровайдерыВсе.Свойство(ПровайдерИмя) Тогда
        ПровайдерИмя = ПоУмолчанию.Имя;
    КонецЕсли;

    // Копируем, чтобы не мутировать кэш провайдеров.
    Исходные = ПровайдерыВсе[ПровайдерИмя];
    Настройки = Новый Структура;
    Для Каждого КЗ Из Исходные Цикл
        Настройки.Вставить(КЗ.Ключ, КЗ.Значение);
    КонецЦикла;

    // Определяем МодельID.
    МодельID = ПоУмолчанию.МодельID;
    Если МодельИмя <> Неопределено Тогда
        СтруктураМоделей = МоделиLLM(ПровайдерИмя);
        Если СтруктураМоделей.Получить(МодельИмя) <> Неопределено Тогда
            МодельID = СтруктураМоделей.Получить(МодельИмя).МодельID;  // ← реальный поиск
        КонецЕсли;
    КонецЕсли;
    Настройки.Вставить("МодельID", МодельID);

    Возврат Настройки;
КонецФункции

Функция МоделиLLM(Провайдер) Экспорт
    Соответствие = Новый Соответствие;
    Для Каждого ПараметрыМодели Из СписокМоделей(Провайдер) Цикл
        Соответствие.Вставить(ПараметрыМодели.name,
            Новый Структура("МодельID, Описание",
                ПараметрыМодели.id, ПараметрыМодели.description));
    КонецЦикла;
    Возврат Соответствие;
КонецФункции

Функция ПровайдерПоУмолчанию()
    Структура = Новый Структура;
    Структура.Вставить("Имя",     "RouterAI");
    Структура.Вставить("МодельID","deepseek/deepseek-v4-pro");
    Возврат Структура;
КонецФункции





