// Возвращает чемпиона страны по футболу за год.
// Возврат: Структура("Страна, Год, Чемпион") или Неопределено, если данных нет.
&НаСервере
Функция ЧемпионСтраныПоФутболу(Страна, Год) Экспорт

    База = Новый Соответствие;

    Россия = Новый Соответствие;
    Россия.Вставить("2025", "ФК Краснодар");
    Россия.Вставить("2026", "Зенит");
    База.Вставить("Россия", Россия);

    ПоГодам = База.Получить(Страна);
    Если ПоГодам = Неопределено Тогда
        Возврат Неопределено;              // нет такой страны
    КонецЕсли;

    Клуб = ПоГодам.Получить(Строка(Год));
    Если Клуб = Неопределено Тогда
        Возврат Неопределено;              // нет данных за этот год
    КонецЕсли;

    Возврат Новый Структура("Страна, Год, Чемпион", Страна, Год, Клуб);
КонецФункции

