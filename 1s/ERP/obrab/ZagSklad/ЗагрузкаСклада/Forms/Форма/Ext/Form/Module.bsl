	КонецЕсли;

	Если Не ЗначениеЗаполнено(Паллет) Тогда
		Результат.Ошибки.Добавить("Паллет не найден: """ + КодПаллета + """");
		Возврат Результат;
	КонецЕсли;
	Результат.Паллет = Паллет;

	Результат.Ошибки = Справочники.Лико_СкладскиеСекции.ОшибкиРазмещенияПаллетаВАдрес(Ячейка, Паллет, Типоразмер, ПолныйОтвет);
	Результат.Валидно = (Результат.Ошибки.Количество() = 0);

	Возврат Результат;

