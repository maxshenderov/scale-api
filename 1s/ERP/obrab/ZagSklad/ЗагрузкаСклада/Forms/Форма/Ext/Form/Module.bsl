&НаКлиенте
Процедура ПриОткрытииLLM() 	

	ЗаполнитьСписокВыбораПровайдеров(); 
	ЗаполнитьСписокВыбораЗадач();
	Если ЗначениеЗаполнено(Провайдер) Тогда
	ЗаполнитьСписокВыбораМодели(СоздатьСписокЗначенийИзКлючейСтруктуры(МоделиLLM(Провайдер)));
	КонецЕсли;



КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьСписокВыбораМодели(СписокЗначенийИсточник) Экспорт
    
    // Очищаем текущий список
    Элементы.Модель.СписокВыбора.Очистить();
    ОписаниеМодели="";
    // Проверка
    Если СписокЗначенийИсточник = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Заполняем список выбора
    Для Каждого ЭлементСписка Из СписокЗначенийИсточник Цикл
        
        Элементы.Модель.СписокВыбора.Добавить(
            ЭлементСписка.Значение,
            ЭлементСписка.Представление
        );
        
    КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСписокВыбораПровайдеров() Экспорт
    
    // Очищаем текущий список
    Элементы.Провайдер.СписокВыбора.Очистить();
	
	Провайдеры = Провайдеры();
		
	

	
  
    Для Каждого ПараметрыПровайдера Из Провайдеры Цикл
        
        Элементы.Провайдер.СписокВыбора.Добавить(
            ПараметрыПровайдера.Ключ,
             ПараметрыПровайдера.Ключ
        );
        
    КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСписокВыбораЗадач() Экспорт
    
    // Очищаем текущий список
    Элементы.Задача.СписокВыбора.Очистить();
	
	ЗадачиLLM = ЗадачиДляLLM();
		
	

	
  
    Для Каждого ПараметрыЗадачи Из ЗадачиLLM Цикл
        
        Элементы.Задача.СписокВыбора.Добавить(
            ПараметрыЗадачи.Ключ,
             ПараметрыЗадачи.Значение.Описание
        );
        
    КонецЦикла;

КонецПроцедуры


Функция СоздатьСписокЗначенийИзКлючейСтруктуры(Структура)
    
    СписокЗначений = Новый СписокЗначений;
    
    Для Каждого ЭлементСтруктуры Из Структура Цикл
        СписокЗначений.Добавить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Ключ);
    КонецЦикла;
    
    Возврат СписокЗначений;
    
КонецФункции

