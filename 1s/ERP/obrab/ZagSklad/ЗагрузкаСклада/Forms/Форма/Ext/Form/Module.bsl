#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	//+Лико m.shenderov 15.05.2026
	ЗаполнитьГруппуСтеллажейНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура htmlПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	//+Лико m.shenderov 20.05.2026
	// Обработка клика из HTMLDocumentField — открываем форму объекта по zagsklad://type/guid
	// В HTML элементам с dblclick назначен data-атрибут data-zs-href="zagsklad://type/guid"
	// При дабл-клике JS вызывает openItem(), который устанавливает <a id="_zs_nav_" href="..."> и кликает по нему
	// OnClick в 1С возвращает href кликнутой ссылки в ДанныеСобытия.href
	
	Ссылка = "";
	Если ДанныеСобытия.Свойство("href") И ЗначениеЗаполнено(ДанныеСобытия.href) Тогда
		Ссылка = СокрЛП(ДанныеСобытия.href);
	КонецЕсли;
	
	Если НЕ СтрНачинаетсяС(Ссылка, "zagsklad://") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	Части = СтрРазделить(Ссылка, "/");
	Если Части.Количество() < 4 Тогда
		Возврат;
	КонецЕсли;
	
	ТипОбъекта = Части[2]; // "pallet" или "cell"
	ГУИДСтрока  = Части[3];
	
	СсылкаВладелец = ПолучитьСсылкуПоГУИД(ТипОбъекта, ГУИДСтрока);
	Если СсылкаВладелец = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("СсылкаВладелец", СсылкаВладелец);
	// Путь к ФормаОбъекта в том же внешнем отчёте
	МассивЧастейПути = СтрРазделить(ЭтаФорма.ИмяФормы, ".");
	МассивЧастейПути[МассивЧастейПути.Количество() - 1] = "ФормаОбъекта";
	ПутьФормы = СтрСоединить(МассивЧастейПути, ".");
	ОткрытьФорму(ПутьФормы, ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьФорму(Команда)
	//+Лико m.shenderov 15.05.2026
	ЗаполнитьГруппуСтеллажейНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСтеллаж(Команда)
	//+Лико m.shenderov 15.05.2026
	ИмяЭлемента = "";
	Если ТекущийЭлемент <> Неопределено Тогда
		ИмяЭлемента = ТекущийЭлемент.Имя;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИмяЭлемента) Тогда
		Возврат;
	КонецЕсли;
	
	ПрефиксКнопки = "Стеллаж_";
	Если СтрНачинаетсяС(ИмяЭлемента, ПрефиксКнопки) Тогда
		КодПолныйСтрока = Сред(ИмяЭлемента, СтрДлина(ПрефиксКнопки) + 1);
		КодПолныйЧисло = Число(КодПолныйСтрока);
		
		СтеллажСсылка = НайтиСтеллажПоКодуНаСервере(КодПолныйЧисло);
		Если ЗначениеЗаполнено(СтеллажСсылка) Тогда
			ТекущийСтеллаж = СтеллажСсылка;
			РендерЗагрузкиСтеллажаНаСервере(СтеллажСсылка);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ============================================================
// === Серверные процедуры =====================================
// ============================================================

&НаСервере
Процедура ЗаполнитьГруппуСтеллажейНаСервере()
	//+Лико m.shenderov 15.05.2026
	УдалитьДинамическиеЭлементы();
	ДинамическиеЭлементы.Очистить();
	
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Лико_Стеллажи.Ссылка КАК Ссылка,
		|	Лико_Стеллажи.КодПолный КАК КодПолный,
		|	Лико_Стеллажи.Наименование КАК Наименование,
		|	Лико_Стеллажи.ДопНастройки КАК ДопНастройки
		|ИЗ
		|	Справочник.Лико_Стеллажи КАК Лико_Стеллажи
		|ГДЕ
		|	Лико_Стеллажи.Склад = &Склад
		|	И НЕ Лико_Стеллажи.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Лико_Стеллажи.КодПолный";
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПроцентЗагрузки = ПолучитьПроцентЗагрузкиСтеллажа(Выборка.Ссылка);
		ЦветСтеллажа = ЦветСтеллажаИзДопНастроек(Выборка.ДопНастройки);
		ЦветТекста = ЦветЗагрузкиПроцент(ПроцентЗагрузки);
		
		ИмяГруппы = "ГруппаСтеллаж_" + Формат(Выборка.КодПолный, "ЧН=0; ЧГ=0");
		ГруппаФормы = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Элементы.ГруппаСтеллажи);
		ГруппаФормы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаФормы.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаФормы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		ГруппаФормы.ОтображатьЗаголовок = Ложь;
		ДинамическиеЭлементы.Добавить(ИмяГруппы);
		
		ИмяДекорации = "ДекорацияЦвет_" + Формат(Выборка.КодПолный, "ЧН=0; ЧГ=0");
		Декорация = Элементы.Добавить(ИмяДекорации, Тип("ДекорацияФормы"), ГруппаФормы);
		Декорация.Вид = ВидДекорацииФормы.Надпись;
		Декорация.Заголовок = "";
		Декорация.Ширина = 1;
		Декорация.Высота = 1;
		Декорация.АвтоМаксимальнаяШирина = Ложь;
		Декорация.АвтоМаксимальнаяВысота = Ложь;
		Декорация.ЦветФона = ЦветСтеллажа;
		ДинамическиеЭлементы.Добавить(ИмяДекорации);
		
		ИмяКнопки = "Стеллаж_" + Формат(Выборка.КодПолный, "ЧН=0; ЧГ=0");
		Кнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), ГруппаФормы);
		Кнопка.ИмяКоманды = "ВыбратьСтеллаж";
		Кнопка.Заголовок = Выборка.Наименование + " (" + Формат(ПроцентЗагрузки, "ЧН=0; ЧГ=0") + "%)";
		Кнопка.ЦветТекста = ЦветТекста;
		Кнопка.ЦветРамки = ЦветТекста;
		Кнопка.ОтображениеФигуры = ОтображениеФигурыКнопки.Нет;
		Кнопка.Высота = 1;
		ДинамическиеЭлементы.Добавить(ИмяКнопки);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УдалитьДинамическиеЭлементы()
	//+Лико m.shenderov 15.05.2026
	Для Каждого ЭлементСписка Из ДинамическиеЭлементы Цикл
		ИмяЭлемента = ЭлементСписка.Значение;
		Попытка
			УдаляемыйЭлемент = Элементы.Найти(ИмяЭлемента);
			Если УдаляемыйЭлемент <> Неопределено Тогда
				Элементы.Удалить(УдаляемыйЭлемент);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция НайтиСтеллажПоКодуНаСервере(КодПолный)
	//+Лико m.shenderov 15.05.2026
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лико_Стеллажи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Лико_Стеллажи КАК Лико_Стеллажи
		|ГДЕ
		|	Лико_Стеллажи.КодПолный = &КодПолный
		|	И НЕ Лико_Стеллажи.ПометкаУдаления";
	Запрос.УстановитьПараметр("КодПолный", КодПолный);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции

&НаСервере
Функция ПолучитьПроцентЗагрузкиСтеллажа(СтеллажСсылка)
	//+Лико m.shenderov 15.05.2026
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Лико_СкладскиеСекции.КоличествоАдресов), 0) КАК ВсегоАдресов
		|ИЗ
		|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
		|ГДЕ
		|	Лико_СкладскиеСекции.Стеллаж = &Стеллаж
		|	И НЕ Лико_СкладскиеСекции.ПометкаУдаления";
	Запрос.УстановитьПараметр("Стеллаж", СтеллажСсылка);
	РезультатСекций = Запрос.Выполнить();
	
	Если РезультатСекций.Пустой() Тогда
		Возврат 0;
	КонецЕсли;
	
	ВыборкаСекций = РезультатСекций.Выбрать();
	ВыборкаСекций.Следующий();
	ВсегоАдресов = ВыборкаСекций.ВсегоАдресов;
	
	Если ВсегоАдресов = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Лико_ПаллетыВСекцияхОстатки.Адрес КАК Адрес
		|ИЗ
		|	РегистрНакопления.Лико_ПаллетыВСекциях.Остатки(
		|		,
		|		Секция В (
		|			ВЫБРАТЬ
		|				Лико_СкладскиеСекции.Ссылка
		|			ИЗ
		|				Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
		|			ГДЕ
		|				Лико_СкладскиеСекции.Стеллаж = &Стеллаж
		|				И НЕ Лико_СкладскиеСекции.ПометкаУдаления
		|		)
		|	) КАК Лико_ПаллетыВСекцияхОстатки
		|ГДЕ
		|	Лико_ПаллетыВСекцияхОстатки.КоличествоОстаток > 0";
	ЗапросОстатков.УстановитьПараметр("Стеллаж", СтеллажСсылка);
	РезультатОстатков = ЗапросОстатков.Выполнить();
	
	ЗанятоАдресов = РезультатОстатков.Выбрать().Количество();
	Процент = Окр(ЗанятоАдресов / ВсегоАдресов * 100, 0);
	Возврат Мин(Процент, 100);
КонецФункции

&НаСервере
Функция ЦветЗагрузкиПроцент(ПроцентЗагрузки)
	//+Лико m.shenderov 15.05.2026
	Если ПроцентЗагрузки < 50 Тогда
		Возврат WebЦвета.Зеленый;
	ИначеЕсли ПроцентЗагрузки <= 89 Тогда
		Возврат WebЦвета.Синий;
	ИначеЕсли ПроцентЗагрузки <= 99 Тогда
		Возврат WebЦвета.Оранжевый;
	Иначе
		Возврат WebЦвета.Красный;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ЦветСтеллажаИзДопНастроек(ДопНастройкиХранилище)
	//+Лико m.shenderov 15.05.2026
	Если НЕ ЗначениеЗаполнено(ДопНастройкиХранилище) Тогда
		Возврат WebЦвета.Серый;
	КонецЕсли;
	
	Попытка
		ДопНастройки = ДопНастройкиХранилище.Получить();
		Если ТипЗнч(ДопНастройки) = Тип("Структура") Тогда
			ЦветСтеллажа = Неопределено;
			Если ДопНастройки.Свойство("ЦветСтеллажа", ЦветСтеллажа) Тогда
				Если ЦветСтеллажа <> Неопределено Тогда
					Возврат ЦветСтеллажа;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат WebЦвета.Серый;
КонецФункции

// ============================================================
// === Рендеринг визуализации стеллажа ========================
// ============================================================

&НаСервере
Процедура РендерЗагрузкиСтеллажаНаСервере(СтеллажСсылка, ПроцентЗагрузки = -1)
	//+Лико m.shenderov 15.05.2026
	// Визуализация поперечного сечения стеллажа с пропорциональными паллетами
	// Масштаб: берётся из атрибута формы МасштабМм (по умолчанию 0.05 px/мм)
	
	КоэфМасштаба = МасштабМм;
	Если КоэфМасштаба <= 0 Тогда
		КоэфМасштаба = 0.05;
	КонецЕсли;
	
	// === 1. Данные стеллажа ===
	СтеллажДанные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтеллажСсылка,
		"Наименование, КодПолный");
	
	Если ПроцентЗагрузки = -1 Тогда
		// Пересчитываем только если не передан снаружи
		ПроцентЗагрузки = ПолучитьПроцентЗагрузкиСтеллажа(СтеллажСсылка);
	КонецЕсли;
	ЦветЗагрузкиHex = ЦветВHex(ЦветЗагрузкиПроцент(ПроцентЗагрузки));
	
	// === 2. Этажи стеллажа ===
	СтеллажОбъект = СтеллажСсылка.ПолучитьОбъект();
	ЭтажиТЧ = СтеллажОбъект.Этажи;
	
	МассивТипоразмеровЭтажей = Новый Массив;
	Для Каждого СтрокаЭтажа Из ЭтажиТЧ Цикл
		Если ЗначениеЗаполнено(СтрокаЭтажа.Типоразмер) Тогда
			МассивТипоразмеровЭтажей.Добавить(СтрокаЭтажа.Типоразмер);
		КонецЕсли;
	КонецЦикла;
	
	ТипоразмерыЭтажейКэш = Новый Соответствие;
	Если МассивТипоразмеровЭтажей.Количество() > 0 Тогда
		ТипоразмерыЭтажейКэш = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
			МассивТипоразмеровЭтажей, "Ширина, Высота, Вес");
	КонецЕсли;
	
	// Соответствие: НомерЭтажа -> Структура(Ширина, Высота, Вес)
	ДанныеЭтажей = Новый Соответствие;
	Для Каждого СтрокаЭтажа Из ЭтажиТЧ Цикл
		Если ЗначениеЗаполнено(СтрокаЭтажа.Типоразмер) Тогда
			ДанныеЭтажей.Вставить(СтрокаЭтажа.НомерСтроки,
				ТипоразмерыЭтажейКэш.Получить(СтрокаЭтажа.Типоразмер));
		КонецЕсли;
	КонецЦикла;
	
	// === 3. Секции стеллажа ===
	ЗапросСекций = Новый Запрос;
	ЗапросСекций.Текст = 
		"ВЫБРАТЬ
		|	Лико_СкладскиеСекции.Ссылка КАК Ссылка,
		|	Лико_СкладскиеСекции.Наименование КАК Наименование,
		|	Лико_СкладскиеСекции.Место КАК Место,
		|	Лико_СкладскиеСекции.Этаж КАК Этаж,
		|	Лико_СкладскиеСекции.Адрес1 КАК Адрес1,
		|	Лико_СкладскиеСекции.Адрес2 КАК Адрес2,
		|	Лико_СкладскиеСекции.Адрес3 КАК Адрес3,
		|	Лико_СкладскиеСекции.КоличествоАдресов КАК КоличествоАдресов
		|ИЗ
		|	Справочник.Лико_СкладскиеСекции КАК Лико_СкладскиеСекции
		|ГДЕ
		|	Лико_СкладскиеСекции.Стеллаж = &Стеллаж
		|	И НЕ Лико_СкладскиеСекции.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Лико_СкладскиеСекции.Этаж УБЫВ,
		|	Лико_СкладскиеСекции.Место";
	ЗапросСекций.УстановитьПараметр("Стеллаж", СтеллажСсылка);
	РезультатСекций = ЗапросСекций.Выполнить();
	
	СекцииПоЭтажам = Новый Соответствие;
	МассивСекцийСсылки = Новый Массив;
	
	Если НЕ РезультатСекций.Пустой() Тогда
		ВыборкаСекций = РезультатСекций.Выбрать();
		Пока ВыборкаСекций.Следующий() Цикл
			СтруктураСекции = Новый Структура(
				"Ссылка, Наименование, Место, Этаж, Адрес1, Адрес2, Адрес3, КоличествоАдресов",
				ВыборкаСекций.Ссылка, ВыборкаСекций.Наименование, ВыборкаСекций.Место,
				ВыборкаСекций.Этаж, ВыборкаСекций.Адрес1, ВыборкаСекций.Адрес2,
				ВыборкаСекций.Адрес3, ВыборкаСекций.КоличествоАдресов);
