#Область СлужебныеПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если НачалоСтрокиExcel = 0 Тогда
        НачалоСтрокиExcel = 2;
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаИзExcel

&НаКлиенте
Процедура ЗагрузитьИзExcel(Команда)

    Если Не ЗначениеЗаполнено(ПутьКФайлу) Тогда
        Сообщить("Укажите путь к файлу Excel.");
        Возврат;
    КонецЕсли;

    // Передаём файл с клиента на сервер (асинхронно, неинтерактивно)
    НачатьПомещениеФайла(
        Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтаФорма),
        ПутьКФайлу,
        Ложь,
        УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайла(Результат, АдресВХ, ВыбранноеИмяФайла, ДопПараметры) Экспорт

    Если Не Результат Тогда
        Сообщить("Не удалось загрузить файл на сервер.");
        Возврат;
    КонецЕсли;

    ЗагрузитьИзExcelНаСервере(АдресВХ);

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзExcelНаСервере(АдресВХ)

    // Получаем двоичные данные из временного хранилища
    ДД = ПолучитьИзВременногоХранилища(АдресВХ);
    Если ДД = Неопределено Тогда
        Сообщить("Не удалось получить файл из временного хранилища.");
        Возврат;
    КонецЕсли;

    // Записываем во временный файл на сервере
    ИмяВремФайла = ПолучитьИмяВременногоФайла("xlsx");
    Попытка
        ДД.Записать(ИмяВремФайла);
    Исключение
        Сообщить("Ошибка записи временного файла на сервере: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    // Читаем ТабличныйДокумент на сервере
    ТабДок = Новый ТабличныйДокумент;
    Попытка
        ТабДок.Прочитать(ИмяВремФайла);
    Исключение
        Сообщить("Ошибка чтения файла Excel: " + ОписаниеОшибки());
        Попытка
            УдалитьФайлы(ИмяВремФайла);
        Исключение
        КонецПопытки;
        Возврат;
    КонецПопытки;

    // Удаляем временный файл
    Попытка
        УдалитьФайлы(ИмяВремФайла);
    Исключение
    КонецПопытки;

    // Извлекаем строки и заполняем ТЧ
    Паллеты.Очистить();
    НомерСтроки = НачалоСтрокиExcel;
    Пока Истина Цикл
        Область = ТабДок.Область("R" + Формат(НомерСтроки, "ЧГ=0") + "C1");
        Если ПустаяСтрока(Область.Текст) Тогда
            Прервать;
        КонецЕсли;

        НоваяСтрока = Паллеты.Добавить();
        НоваяСтрока.ГлубинаПлан = Число(ТабДок.Область("R" + НомерСтроки + "C1").Текст);
        НоваяСтрока.ШиринаПлан  = Число(ТабДок.Область("R" + НомерСтроки + "C2").Текст);
        НоваяСтрока.Высота      = Число(ТабДок.Область("R" + НомерСтроки + "C3").Текст);
        НоваяСтрока.Вес         = Число(ТабДок.Область("R" + НомерСтроки + "C4").Текст);
        НоваяСтрока.Количество  = Число(ТабДок.Область("R" + НомерСтроки + "C5").Текст);

        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;

    Сообщить("Загружено строк: " + Паллеты.Количество());

КонецПроцедуры

#КонецОбласти

#Область СозданиеТипоразмеров

&НаКлиенте
Процедура СозатьТипоразмеры(Команда)

    Если Паллеты.Количество() = 0 Тогда
        Сообщить("Нет данных в таблице Паллеты. Сначала загрузите из Excel.");
        Возврат;
    КонецЕсли;

    СозатьТипоразмерыНаСервере();

КонецПроцедуры

&НаСервере
Процедура СозатьТипоразмерыНаСервере()

    // Шаг 1: Нормализация и создание типоразмеров
    Для Каждого СтрокаПаллеты Из Паллеты Цикл

        // Нормализация ГлубинаПлан/ШиринаПлан → Глубина/Ширина
        Макс = Макс(СтрокаПаллеты.ГлубинаПлан, СтрокаПаллеты.ШиринаПлан);
        Мин = Мин(СтрокаПаллеты.ГлубинаПлан, СтрокаПаллеты.ШиринаПлан);

        Если Макс <= 1200 Тогда
            СтрокаПаллеты.Глубина = Макс;
            СтрокаПаллеты.Ширина = Мин;
        Иначе
            СтрокаПаллеты.Глубина = СтрокаПаллеты.ГлубинаПлан;
            СтрокаПаллеты.Ширина = СтрокаПаллеты.ШиринаПлан;
        КонецЕсли;

        // Создание/поиск типоразмера
        Попытка
            СтрокаПаллеты.Типоразмер = Справочники.Лико_ТипоразмерыПаллет.НайтиСоздатьТипоразмер(
                СтрокаПаллеты.Высота,
                СтрокаПаллеты.Ширина,
                СтрокаПаллеты.Глубина,
                СтрокаПаллеты.Вес);
        Исключение
            Сообщить("Ошибка создания типоразмера: " + ОписаниеОшибки());
        КонецПопытки;

    КонецЦикла;

    // Шаг 2: Схлопывание строк с одинаковым Типоразмером
    // Строим соответствие: Типоразмер → сумма Количества
    Соответствие = Новый Соответствие;
    Для Каждого СтрокаПаллеты Из Паллеты Цикл
        Если Не ЗначениеЗаполнено(СтрокаПаллеты.Типоразмер) Тогда
            Продолжить;
        КонецЕсли;
        ТекКоличество = Соответствие.Получить(СтрокаПаллеты.Типоразмер);
        Если ТекКоличество = Неопределено Тогда
            ТекКоличество = 0;
        КонецЕсли;
        Соответствие.Вставить(СтрокаПаллеты.Типоразмер, ТекКоличество + СтрокаПаллеты.Количество);
    КонецЦикла;

    // Находим эталонную строку для каждого Типоразмера
    Эталоны = Новый Соответствие; // Типоразмер → строка для копирования
    Для Каждого СтрокаПаллеты Из Паллеты Цикл
        Если ЗначениеЗаполнено(СтрокаПаллеты.Типоразмер)
           И Эталоны.Получить(СтрокаПаллеты.Типоразмер) = Неопределено Тогда
            Эталоны.Вставить(СтрокаПаллеты.Типоразмер, СтрокаПаллеты);
        КонецЕсли;
    КонецЦикла;

    Паллеты.Очистить();
    Для Каждого КлючЗначение Из Соответствие Цикл
        Типоразмер = КлючЗначение.Ключ;
        СуммаКоличество = КлючЗначение.Значение;
        Эталон = Эталоны.Получить(Типоразмер);

        НоваяСтрока = Паллеты.Добавить();
        НоваяСтрока.Высота      = Эталон.Высота;
        НоваяСтрока.Ширина      = Эталон.Ширина;
        НоваяСтрока.Глубина     = Эталон.Глубина;
        НоваяСтрока.Вес         = Эталон.Вес;
        НоваяСтрока.ШиринаПлан  = Эталон.ШиринаПлан;
        НоваяСтрока.ГлубинаПлан = Эталон.ГлубинаПлан;
        НоваяСтрока.Типоразмер  = Типоразмер;
        НоваяСтрока.Количество  = СуммаКоличество;
    КонецЦикла;

    Сообщить("Типоразмеров создано: " + Паллеты.Количество());

КонецПроцедуры

#КонецОбласти

#Область ФормированияПаллета

&НаКлиенте
Процедура СоздатьДокументыФормированияПаллет(Команда)

    Если Паллеты.Количество() = 0 Тогда
        Сообщить("Нет данных в таблице Паллеты.");
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Адрес) Тогда
        Сообщить("Укажите Адрес хранения.");
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ОбъектНоменклатурыБазовый) Тогда
        Сообщить("Укажите Объект номенклатуры базовый.");
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(АвторДокумента) Тогда
        Сообщить("Укажите Автора документа.");
        Возврат;
    КонецЕсли;

    СоздатьДокументыФормированияПаллетНаСервере();

КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыФормированияПаллетНаСервере()

    Создано = 0;
    Ошибок = 0;

    Для Каждого СтрокаПаллеты Из Паллеты Цикл

        Если Не ЗначениеЗаполнено(СтрокаПаллеты.Типоразмер) Тогда
            Продолжить;
        КонецЕсли;

        Для Сч = 1 По СтрокаПаллеты.Количество Цикл

            Попытка

                // 1. Создать виртуальный паллет
                ПаллетОбъект = Справочники.Лико_Паллеты2_0.СоздатьЭлемент();
                ПаллетОбъект.Заполнить(Истина);
                ПаллетОбъект.Виртуальный = Истина;
                Попытка
                    ПаллетОбъект.Записать();
                Исключение
                    Сообщить("Ошибка записи паллета: " + ОписаниеОшибки());
                    Ошибок = Ошибок + 1;
                    Продолжить;
                КонецПопытки;

                // 2. Создать документ
                Док = Документы.Лико_ФормированиеПаллета2_0.СоздатьДокумент();
                Док.Паллет         = ПаллетОбъект.Ссылка;
                Док.Типоразмер     = СтрокаПаллеты.Типоразмер;
                Док.АдресХранения  = Адрес;
                Док.АвторДокумента = АвторДокумента;

                // 3. ТЧ Товары: одна строка, только Серия
                СтрокаТовары = Док.Товары.Добавить();
                СтрокаТовары.Серия = ОбъектНоменклатурыБазовый.Серия;

                // 4. Записать и провести
                Док.Записать(РежимЗаписиДокумента.Проведение);

                // 5. Добавить в ТЧ ФормированияПаллет
                СтрокаТЧ = ФормированияПаллет.Добавить();
                СтрокаТЧ.ФормированиеПаллета = Док.Ссылка;
                СтрокаТЧ.Типоразмер = СтрокаПаллеты.Типоразмер;

                Создано = Создано + 1;

            Исключение
                Сообщить("Ошибка создания документа формирования: " + ОписаниеОшибки());
                Ошибок = Ошибок + 1;
            КонецПопытки;

        КонецЦикла;

    КонецЦикла;

    Сообщить("Создано формирований: " + Создано + ", ошибок: " + Ошибок);

КонецПроцедуры

#КонецОбласти

#Область ПеремещенияПаллет

&НаКлиенте
Процедура СоздатьДокументыПеремещенияПаллет(Команда)

    Если ФормированияПаллет.Количество() = 0 Тогда
        Сообщить("Нет документов формирования. Сначала создайте формирования.");
        Возврат;
    КонецЕсли;

    СоздатьДокументыПеремещенияПаллетНаСервере();

КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыПеремещенияПаллетНаСервере()

    Создано = 0;
    Проведено = 0;
    Ошибок = 0;

    Для Каждого СтрокаТЧ Из ФормированияПаллет Цикл

        Попытка

            ДокФормирования = СтрокаТЧ.ФормированиеПаллета.ПолучитьОбъект();

            Док = Документы.Лико_ПеремещениеПаллета2_0.СоздатьДокумент();
            Док.Склад          = ДокФормирования.Склад;
            Док.Паллет         = ДокФормирования.Паллет;
            Док.АвторДокумента = ДокФормирования.АвторДокумента;

            // Подбор ячейки
            НовыйАдрес = Неопределено;
            Попытка
                НовыйАдрес = Справочники.Лико_СкладскиеСекции.ПодобратьЯчейкуПоПаллету(
                    ДокФормирования.Склад,
                    ДокФормирования.Паллет);
            Исключение
                // Адрес не найден — остаётся пустым
            КонецПопытки;

            Док.АдресХранения = НовыйАдрес;

            Если ЗначениеЗаполнено(НовыйАдрес) Тогда
                Попытка
                    Док.Записать(РежимЗаписиДокумента.Проведение);
                    Проведено = Проведено + 1;
                Исключение
                    Сообщить("Ошибка проведения перемещения: " + ОписаниеОшибки());
                    Док.Записать(РежимЗаписиДокумента.Запись);
                КонецПопытки;
            Иначе
                Док.Записать(РежимЗаписиДокумента.Запись);
            КонецЕсли;

            // Добавить в ТЧ ПеремещенияПаллет
            СтрокаТЧПер = ПеремещенияПаллет.Добавить();
            СтрокаТЧПер.Перемещениепаллета = Док.Ссылка;
            СтрокаТЧПер.Типоразмер = ДокФормирования.Типоразмер;

            Создано = Создано + 1;

        Исключение
            Сообщить("Ошибка создания документа перемещения: " + ОписаниеОшибки());
            Ошибок = Ошибок + 1;
        КонецПопытки;

    КонецЦикла;

    Сообщить("Создано перемещений: " + Создано + " (проведено: " + Проведено + "), ошибок: " + Ошибок);

КонецПроцедуры

#КонецОбласти

#Область Статистика

&НаКлиенте
Процедура ЗаполнитьСтатистику(Команда)

    Если Не ЗначениеЗаполнено(Склад) Тогда
        Сообщить("Укажите Склад.");
        Возврат;
    КонецЕсли;

    ЗаполнитьСтатистикуНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтатистикуНаСервере()

    // Шаг 1: Очистить ТЧ
    ФормированияПаллет.Очистить();
    ПеремещенияПаллет.Очистить();

    // Очистить статистику в Паллетах
    Для Каждого СтрокаПаллеты Из Паллеты Цикл
        СтрокаПаллеты.КоличествоСозданныхФормированийПаллет = 0;
        СтрокаПаллеты.НеСозданныеФормированияПаллет = 0;
        СтрокаПаллеты.КоличествоСозданныхПеремещенийПаллет = 0;
        СтрокаПаллеты.НеСозданныеПеремещенияПаллет = 0;
    КонецЦикла;

    // Шаг 2: Запрос документов формирований
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Лико_ФормированиеПаллета2_0.Ссылка КАК Ссылка,
    |    Лико_ФормированиеПаллета2_0.Проведен КАК Проведен,
    |    Лико_ФормированиеПаллета2_0.Типоразмер КАК Типоразмер
    |ИЗ
    |    Документ.Лико_ФормированиеПаллета2_0 КАК Лико_ФормированиеПаллета2_0
    |ГДЕ
    |    Лико_ФормированиеПаллета2_0.Паллет.Виртуальный = ИСТИНА
    |    И Лико_ФормированиеПаллета2_0.Склад = &Склад";

    Запрос.УстановитьПараметр("Склад", Склад);
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();

    Пока Выборка.Следующий() Цикл
        // Добавить в ТЧ ФормированияПаллет
        СтрокаТЧ = ФормированияПаллет.Добавить();
        СтрокаТЧ.ФормированиеПаллета = Выборка.Ссылка;
        СтрокаТЧ.Типоразмер = Выборка.Типоразмер;

        // Обновить статистику в Паллетах
        Для Каждого СтрокаПаллеты Из Паллеты Цикл
            Если СтрокаПаллеты.Типоразмер = Выборка.Типоразмер Тогда
                Если Выборка.Проведен Тогда
                    СтрокаПаллеты.КоличествоСозданныхФормированийПаллет =
                        СтрокаПаллеты.КоличествоСозданныхФормированийПаллет + 1;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    // Шаг 3: Запрос документов перемещений
    Запрос2 = Новый Запрос;
    Запрос2.Текст =
    "ВЫБРАТЬ
    |    Лико_ПеремещениеПаллета2_0.Ссылка КАК Ссылка,
    |    Лико_ПеремещениеПаллета2_0.Проведен КАК Проведен,
    |    Лико_ПараметрыПаллетСрезПоследних.Типоразмер КАК Типоразмер
    |ИЗ
    |    Документ.Лико_ПеремещениеПаллета2_0 КАК Лико_ПеремещениеПаллета2_0
    |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Лико_ПараметрыПаллет.СрезПоследних КАК Лико_ПараметрыПаллетСрезПоследних
    |        ПО Лико_ПеремещениеПаллета2_0.Паллет = Лико_ПараметрыПаллетСрезПоследних.Паллет
    |ГДЕ
    |    Лико_ПеремещениеПаллета2_0.Паллет.Виртуальный = ИСТИНА
    |    И Лико_ПеремещениеПаллета2_0.Склад = &Склад";

    Запрос2.УстановитьПараметр("Склад", Склад);
    Результат2 = Запрос2.Выполнить();
    Выборка2 = Результат2.Выбрать();

    Пока Выборка2.Следующий() Цикл
        // Добавить в ТЧ ПеремещенияПаллет
        СтрокаТЧ = ПеремещенияПаллет.Добавить();
        СтрокаТЧ.Перемещениепаллета = Выборка2.Ссылка;
        СтрокаТЧ.Типоразмер = Выборка2.Типоразмер;

        // Обновить статистику
        Для Каждого СтрокаПаллеты Из Паллеты Цикл
            Если СтрокаПаллеты.Типоразмер = Выборка2.Типоразмер Тогда
                Если Выборка2.Проведен Тогда
                    СтрокаПаллеты.КоличествоСозданныхПеремещенийПаллет =
                        СтрокаПаллеты.КоличествоСозданныхПеремещенийПаллет + 1;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    // Шаг 4: Рассчитать НеСозданные*
    Для Каждого СтрокаПаллеты Из Паллеты Цикл
        СтрокаПаллеты.НеСозданныеФормированияПаллет =
            СтрокаПаллеты.Количество - СтрокаПаллеты.КоличествоСозданныхФормированийПаллет;
        СтрокаПаллеты.НеСозданныеПеремещенияПаллет =
            СтрокаПаллеты.Количество - СтрокаПаллеты.КоличествоСозданныхПеремещенийПаллет;
    КонецЦикла;

    Сообщить("Статистика заполнена. Формирований: " + ФормированияПаллет.Количество()
        + ", Перемещений: " + ПеремещенияПаллет.Количество());

КонецПроцедуры

#КонецОбласти

