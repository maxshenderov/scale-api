              continue\n                    if p_a.id == pal_b.id:\n                        continue\n                    remaining_b = [p for p in state_b.placed_pallets if p.id != pal_b.id]\n                    if not section_fits_pallet(state_b.section, remaining_b, p_a, strict_narrow):\n                        continue\n                    for sec_c_id in self.compatible.get(pal_b.id, []):\n                        if sec_c_id in (sec_a_id, sec_b_id):\n                            continue\n                        state_c = self.section_states[sec_c_id]\n                        if state_c.free_count <= 0:\n                            continue\n                        if state_c.free_width >= pal_b.width + state_c.gap_width:\n                            if section_fits_pallet(state_c.section, state_c.placed_pallets, pal_b, strict_narrow):\n                                return [("remove", p_a.id, sec_a_id), ("remove", pal_b.id, sec_b_id), ("place", leftover.id, sec_a_id), ("place", p_a.id, sec_b_id), ("place", pal_b.id, sec_c_id)]\n        return None\n\n    def _execute_multi_hop(self, chain: List[Tuple[str, str, str]]):\n        old_sections = {}\n        for action, p_id, sec_id in chain:\n            if action == "remove" and p_id in self.movable_existing_ids:\n                old_sections[p_id] = sec_id\n        for action, p_id, sec_id in chain:\n            if action == "remove":\n                self._do_remove(p_id, sec_id)\n        for action, p_id, sec_id in chain:\n            if action == "place":\n                self._do_place(p_id, sec_id)\n                if p_id in old_sections and sec_id != old_sections[p_id]:\n                    self.moved_existing_ids.add(p_id)\n'
    
