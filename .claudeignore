# .claudeignore — исключения для проекта OKIL
# После этих исключений Claude работает только с реальным BSL/Python кодом

# ═══════════════════════════════════════════════════════════
# КРУПНЫЕ ФАЙЛЫ — убирают ~95% объёма
# ═══════════════════════════════════════════════════════════

# Типовая конфигурация — бинарник 2 ГБ
1s/ERP/Conf/Ext/ParentConfigurations/*.cf
1s/ERP/Conf/Ext/ParentConfigurations.bin

# Служебный файл дампа — 44 МБ
1s/ERP/Conf/ConfigDumpInfo.xml

# Регламентированная отчётность — ~3 ГБ классификаторов
1s/ERP/Conf/Reports/РегламентированныйОтчет*/**/Templates/**
1s/ERP/Conf/Reports/БухгалтерскаяОтчетность*/**/Templates/**
1s/ERP/Conf/Reports/РегламентированныйОтчет*/Templates/**

# Драйверы оборудования — ~700 МБ бинарников
1s/ERP/Conf/CommonTemplates/Драйвер*
1s/ERP/Conf/CommonTemplates/Компонента*

# ═══════════════════════════════════════════════════════════
# ФОРМЫ И МАКЕТЫ
# ═══════════════════════════════════════════════════════════
**/Form/**
**/Forms/**
**/*.mxlx
**/*.mxl
**/Template/**
**/Templates/**
**/*.html
**/*.htm

# ═══════════════════════════════════════════════════════════
# МЕДИА
# ═══════════════════════════════════════════════════════════
**/*.png
**/*.jpg
**/*.jpeg
**/*.ico
**/*.bmp
**/*.gif
**/Picture/**
**/Pictures/**

# ═══════════════════════════════════════════════════════════
# ПРАВА ДОСТУПА
# ═══════════════════════════════════════════════════════════
**/Rights/**
**/Role/**
**/Roles/**

# ═══════════════════════════════════════════════════════════
# ИНТЕРФЕЙСЫ
# ═══════════════════════════════════════════════════════════
**/CommandInterface/**
**/Interface/**
**/Help/**

# ═══════════════════════════════════════════════════════════
# БИНАРНЫЕ ФАЙЛЫ 1С
# ═══════════════════════════════════════════════════════════
**/*.cf
**/*.cfe
**/*.dt
**/*.bin
**/*.epf
**/*.erf

# ═══════════════════════════════════════════════════════════
# СЛУЖЕБНЫЕ ФАЙЛЫ EDT
# ═══════════════════════════════════════════════════════════
**/.project
**/.classpath
**/.settings/**
**/MANIFEST.MF

# ═══════════════════════════════════════════════════════════
# PYTHON — выключено по умолчанию
# Раскомментируй нужный сервис когда работаешь с Python
# ═══════════════════════════════════════════════════════════
services/
# services/rag_llm/
# services/batch_indexer/
# services/parser/
# services/docling/

# ═══════════════════════════════════════════════════════════
# ПРОЧЕЕ
# ═══════════════════════════════════════════════════════════
qdrant_storage/
build/
excel/
jpg/
PDF/
MD/

# plans/ — НЕ игнорировать! Claude читает планы для контекста
# ТЗ/    — НЕ игнорировать! Техническое задание
# 1s/ERP/extensions/ — НЕ игнорировать! Исходники расширений EDT
